@* ========================================
   Block: dialog-cookie-settings
   Title: Dialog Cookie Settings
   Description: Cookie settings dialog with granular preferences, category toggles, and GDPR-compliant consent management
   Dependencies: AccordionCn, AccordionContentCn, AccordionItemCn, AccordionTriggerCn, BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideChartBarCn, LucideCookieCn, LucideExternalLinkCn, LucideMegaphoneCn, LucideSettings2Cn, LucideShieldCn, SeparatorCn, SwitchCn
   Source: original/blocks/dialog/dialog-cookie-settings.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideCookieCn Class="mr-2 h-4 w-4" Size="16" />
                Cookie Settings
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-lg">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideCookieCn Class="h-5 w-5" Size="20" />
                Cookie Preferences
            </DialogTitleCn>
            <DialogDescriptionCn>
                Manage how we use cookies to improve your experience.
            </DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            @* Quick Actions *@
            <div class="flex gap-2">
                <ButtonCn Class="flex-1" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="HandleRejectAll">
                    Reject All
                </ButtonCn>
                <ButtonCn Class="flex-1" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="HandleAcceptAll">
                    Accept All
                </ButtonCn>
            </div>

            <SeparatorCn />

            @* Cookie Categories *@
            <AccordionCn>
                @foreach (var category in _cookieCategories)
                {
                    var cat = category;
                    <AccordionItemCn Value="@cat.Id">
                        <div class="flex items-center gap-3 py-2">
                            @cat.IconFragment
                            <div class="flex-1 min-w-0">
                                <AccordionTriggerCn Class="py-0 hover:no-underline">
                                    <div class="flex items-center gap-2 text-left">
                                        <span class="font-medium">@cat.Name</span>
                                        @if (cat.Required)
                                        {
                                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">Required</BadgeCn>
                                        }
                                    </div>
                                </AccordionTriggerCn>
                                <p class="text-xs text-muted-foreground mt-0.5">@cat.Description</p>
                            </div>
                            <SwitchCn
                                Checked="@cat.Enabled"
                                CheckedChanged="@((bool v) => { if (!cat.Required) cat.Enabled = v; })"
                                Disabled="@cat.Required" />
                        </div>
                        <AccordionContentCn>
                            <div class="pl-7 space-y-3">
                                <p class="text-sm text-muted-foreground">@cat.Details</p>
                                <div class="rounded-lg border">
                                    <div class="grid grid-cols-3 gap-2 p-2 text-xs font-medium border-b">
                                        <span>Cookie</span>
                                        <span>Purpose</span>
                                        <span>Expiry</span>
                                    </div>
                                    @for (var i = 0; i < cat.Cookies.Length; i++)
                                    {
                                        var cookie = cat.Cookies[i];
                                        <div class="@Cn.Merge("grid grid-cols-3 gap-2 p-2 text-xs", i != cat.Cookies.Length - 1 ? "border-b" : "")">
                                            <span class="font-mono">@cookie.Name</span>
                                            <span class="text-muted-foreground">@cookie.Purpose</span>
                                            <span class="text-muted-foreground">@cookie.Expiry</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </AccordionContentCn>
                    </AccordionItemCn>
                }
            </AccordionCn>

            @* Summary *@
            <div class="flex items-center justify-between text-sm text-muted-foreground">
                <span>@_enabledCount of @_cookieCategories.Length categories enabled</span>
                <ButtonCn Class="h-auto p-0 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Link">
                    Privacy Policy
                    <LucideExternalLinkCn Class="ml-1 h-3 w-3" Size="12" />
                </ButtonCn>
            </div>
        </div>

        <DialogFooterCn>
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">Cancel</ButtonCn>
            <ButtonCn @onclick="HandleSave">
                <LucideCookieCn Class="mr-2 h-4 w-4" Size="16" />
                Save Preferences
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;

    private int _enabledCount => _cookieCategories.Count(c => c.Enabled);

    private record CookieInfo(string Name, string Purpose, string Expiry);

    private class CookieCategoryInfo
    {
        public string Id { get; init; } = "";
        public string Name { get; init; } = "";
        public string Description { get; init; } = "";
        public string Details { get; init; } = "";
        public RenderFragment? IconFragment { get; init; }
        public bool Required { get; init; }
        public bool Enabled { get; set; }
        public CookieInfo[] Cookies { get; init; } = [];
    }

    private readonly CookieCategoryInfo[] _cookieCategories;

    public DialogCookieSettings()
    {
        _cookieCategories =
        [
            new()
            {
                Id = "necessary", Name = "Strictly Necessary", Description = "Essential for the website to function properly",
                Details = "These cookies are required for basic site functionality and cannot be disabled.",
                IconFragment = @<LucideShieldCn Class="h-4 w-4 text-muted-foreground shrink-0" Size="16" />,
                Required = true, Enabled = true,
                Cookies = [new("session_id", "Session management", "Session"), new("csrf_token", "Security protection", "Session"), new("cookie_consent", "Store your preferences", "1 year")],
            },
            new()
            {
                Id = "functional", Name = "Functional", Description = "Enhanced features and personalization",
                Details = "These cookies enable enhanced functionality like remembering your preferences.",
                IconFragment = @<LucideSettings2Cn Class="h-4 w-4 text-muted-foreground shrink-0" Size="16" />,
                Required = false, Enabled = false,
                Cookies = [new("language", "Language preference", "1 year"), new("theme", "Display preferences", "1 year"), new("recent_items", "Recently viewed", "30 days")],
            },
            new()
            {
                Id = "analytics", Name = "Analytics", Description = "Help us understand how you use our site",
                Details = "These cookies collect information about how you interact with our website.",
                IconFragment = @<LucideChartBarCn Class="h-4 w-4 text-muted-foreground shrink-0" Size="16" />,
                Required = false, Enabled = false,
                Cookies = [new("_ga", "Google Analytics tracking", "2 years"), new("_gid", "Distinguish users", "24 hours"), new("performance_data", "Page load metrics", "30 days")],
            },
            new()
            {
                Id = "marketing", Name = "Marketing", Description = "Personalized ads and content",
                Details = "These cookies are used to deliver relevant advertisements and track campaign performance.",
                IconFragment = @<LucideMegaphoneCn Class="h-4 w-4 text-muted-foreground shrink-0" Size="16" />,
                Required = false, Enabled = false,
                Cookies = [new("_fbp", "Facebook advertising", "3 months"), new("ads_prefs", "Ad preferences", "1 year"), new("conversion_tracking", "Campaign attribution", "90 days")],
            },
        ];
    }

    private void HandleAcceptAll()
    {
        foreach (var cat in _cookieCategories) cat.Enabled = true;
    }

    private void HandleRejectAll()
    {
        foreach (var cat in _cookieCategories)
            cat.Enabled = cat.Required;
    }

    private void HandleSave() => _open = false;
}
