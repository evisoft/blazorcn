@* ========================================
   Block: dialog-select-quantity
   Title: Dialog Select Quantity
   Description: Quantity selector dialog with increment/decrement controls, direct input, stock availability, and bulk pricing
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LucideLoader2Cn, LucideMinusCn, LucidePlusCn, LucideShoppingCartCn
   Source: original/blocks/dialog/dialog-select-quantity.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideShoppingCartCn Class="mr-2 h-4 w-4" Size="16" />
                Select Quantity
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        <DialogHeaderCn>
            <DialogTitleCn>Select Quantity</DialogTitleCn>
            <DialogDescriptionCn>Choose how many items you'd like.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            <div class="flex items-center justify-center gap-3">
                <ButtonCn
                    Disabled="@(_quantity <= 1)"
                    @onclick="@(() => _quantity = Math.Max(1, _quantity - 1))"
                    Size="ButtonSize.Icon"
                    Variant="ButtonVariant.Outline">
                    <LucideMinusCn Class="h-4 w-4" Size="16" />
                </ButtonCn>

                <InputCn
                    Class="w-20 text-center text-lg font-semibold"
                    Type="number"
                    Value="@_quantity.ToString()"
                    ValueChanged="@HandleChange" />

                <ButtonCn
                    Disabled="@(_quantity >= MaxQty)"
                    @onclick="@(() => _quantity = Math.Min(MaxQty, _quantity + 1))"
                    Size="ButtonSize.Icon"
                    Variant="ButtonVariant.Outline">
                    <LucidePlusCn Class="h-4 w-4" Size="16" />
                </ButtonCn>
            </div>

            <div class="flex items-center justify-between rounded-lg border p-3">
                <div>
                    <p class="text-sm font-medium">$@Price each</p>
                    <p class="text-xs text-muted-foreground">
                        @_quantity item@(_quantity > 1 ? "s" : "")
                    </p>
                </div>
                <p class="text-lg font-semibold">$@Total</p>
            </div>
        </div>

        <DialogFooterCn>
            <ButtonCn @onclick="@(() => _open = false)" Variant="ButtonVariant.Outline">
                Cancel
            </ButtonCn>
            <ButtonCn Disabled="@_isUpdating" @onclick="HandleUpdate">
                @if (_isUpdating)
                {
                    <LucideLoader2Cn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    <span>Updating...</span>
                }
                else
                {
                    <span>Update</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private int _quantity = 1;
    private bool _isUpdating;

    private const decimal Price = 29.99m;
    private const int MaxQty = 99;

    private string Total => (Price * _quantity).ToString("F2");

    private void HandleChange(string value)
    {
        if (int.TryParse(value, out var num))
        {
            if (num < 1) _quantity = 1;
            else if (num > MaxQty) _quantity = MaxQty;
            else _quantity = num;
        }
        else
        {
            _quantity = 1;
        }
    }

    private async Task HandleUpdate()
    {
        _isUpdating = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isUpdating = false;
        _open = false;
    }
}
