<DialogCn @bind-Open="_open">
      <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
          <ButtonCn Variant="ButtonVariant.Outline">Show Dialog</ButtonCn>
        </DialogTriggerCn>
      </div>

      <DialogContentCn class="sm:max-w-sm flex flex-col items-center">
        <div class="flex justify-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-green-100">
            <LucideCheckCn Class="h-6 w-6 text-green-600"  Size="24" />
          </div>
        </div>

        <DialogHeaderCn class="text-center gap-0">
          <DialogTitleCn class="text-center">Payment successful</DialogTitleCn>
          <DialogDescriptionCn class="mt-2 text-center mx-auto sm:max-w-[90%]">
            Lorem ipsum dolor sit amet consectetur adipisicing elit. Consequatur amet labore.
          </DialogDescriptionCn>
        </DialogHeaderCn>
        <DialogFooterCn class="flex flex-col sm:flex-row sm:gap-3 w-full gap-2">
          <DialogCloseCn>
            <ButtonCn class="w-full sm:w-1/2" Variant="ButtonVariant.Default">
              Deactivate
            </ButtonCn>
          </DialogCloseCn>
          <DialogCloseCn>
            <ButtonCn class="w-full sm:w-1/2" Variant="ButtonVariant.Outline">
              Cancel
            </ButtonCn>
          </DialogCloseCn>
        </DialogFooterCn>
      </DialogContentCn>
    </DialogCn>

@code {
    private bool _open = false;
}
