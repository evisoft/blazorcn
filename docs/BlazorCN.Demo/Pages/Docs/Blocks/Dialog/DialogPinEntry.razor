@* ========================================
   Block: dialog-pin-entry
   Title: Dialog PIN Entry
   Description: PIN entry dialog with numeric keypad, masked input, and error feedback for secure apps
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCheckCn, LucideDeleteCn, LucideLockCn
   Source: original/blocks/dialog/dialog-pin-entry.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideLockCn Class="mr-2 h-4 w-4" Size="16" />
                Enter PIN
            </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 320px;">
        @if (_success)
        {
            <div class="flex flex-col items-center justify-center py-8 text-center">
                <LucideCheckCn Class="h-8 w-8 text-primary" Size="32" />
                <h3 class="mt-4 text-lg font-medium">Access Granted</h3>
                <ButtonCn Class="mt-6" @onclick="HandleClose">Continue</ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn Class="text-center">
                <DialogTitleCn>Enter PIN</DialogTitleCn>
                <DialogDescriptionCn>Enter your 4-digit PIN to continue</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="py-6 space-y-6">
                @* PIN dots *@
                <div class="@Cn.Merge("flex justify-center gap-3", _error ? "animate-shake" : "")">
                    @for (var i = 0; i < PinLength; i++)
                    {
                        var idx = i;
                        <div class="@Cn.Merge("h-3 w-3 rounded-full transition-colors", idx < _pin.Length ? (_error ? "bg-destructive" : "bg-primary") : "bg-muted")"></div>
                    }
                </div>

                @if (_error)
                {
                    <p class="text-center text-sm text-destructive">Incorrect PIN. Try again.</p>
                }

                @* Keypad *@
                <div class="grid grid-cols-3 gap-2">
                    @for (var d = 1; d <= 9; d++)
                    {
                        var digit = d.ToString();
                        <ButtonCn Class="h-12 text-lg font-medium" Variant="ButtonVariant.Outline" @onclick="@(() => HandleDigit(digit))">
                            @digit
                        </ButtonCn>
                    }
                    <div></div>
                    <ButtonCn Class="h-12 text-lg font-medium" Variant="ButtonVariant.Outline" @onclick="@(() => HandleDigit("0"))">
                        0
                    </ButtonCn>
                    <ButtonCn Class="h-12" Disabled="@(_pin.Length == 0)" Variant="ButtonVariant.Ghost" @onclick="HandleDelete">
                        <LucideDeleteCn Class="h-5 w-5" Size="20" />
                    </ButtonCn>
                </div>
            </div>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private const int PinLength = 4;
    private const string CorrectPin = "1234";

    private bool _open;
    private string _pin = "";
    private bool _error;
    private bool _success;

    private async Task HandleDigit(string digit)
    {
        if (_pin.Length >= PinLength) return;

        _pin += digit;
        _error = false;

        if (_pin.Length == PinLength)
        {
            if (_pin == CorrectPin)
            {
                _success = true;
            }
            else
            {
                _error = true;
                StateHasChanged();
                await Task.Delay(500);
                _pin = "";
            }
        }
    }

    private void HandleDelete()
    {
        if (_pin.Length > 0)
        {
            _pin = _pin[..^1];
            _error = false;
        }
    }

    private void HandleClose()
    {
        _open = false;
        _pin = "";
        _error = false;
        _success = false;
    }
}
