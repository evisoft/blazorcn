@* ========================================
   Block: dialog-file-preview
   Title: Dialog File Preview
   Description: File preview dialog with document viewer, file info, download, share, and quick actions
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCheckCn, LucideChevronLeftCn, LucideChevronRightCn, LucideCopyCn, LucideDownloadCn, LucideExternalLinkCn, LucideFileCodeCn, LucideFileCn, LucideFileTextCn, LucideImageCn, LucidePrinterCn, LucideShare2Cn, LucideTrash2Cn
   Source: original/blocks/dialog/dialog-file-preview.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideFileTextCn Class="mr-2 h-4 w-4" Size="16" />
                Preview File
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn class="sm:max-w-lg p-0 overflow-hidden">
        <DialogHeaderCn class="p-4 pb-0">
            <div class="flex items-start justify-between">
                <div class="flex items-center gap-3 min-w-0">
                    @switch (CurrentFile.Type)
                    {
                        case "image":
                            <LucideImageCn Class="h-5 w-5 text-muted-foreground shrink-0" Size="20" />
                            break;
                        case "pdf":
                            <LucideFileTextCn Class="h-5 w-5 text-muted-foreground shrink-0" Size="20" />
                            break;
                        case "code":
                            <LucideFileCodeCn Class="h-5 w-5 text-muted-foreground shrink-0" Size="20" />
                            break;
                        default:
                            <LucideFileCn Class="h-5 w-5 text-muted-foreground shrink-0" Size="20" />
                            break;
                    }
                    <div class="min-w-0">
                        <DialogTitleCn class="truncate">@CurrentFile.Name</DialogTitleCn>
                        <div class="flex items-center gap-2 mt-1">
                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                @CurrentFile.Type.ToUpperInvariant()
                            </BadgeCn>
                            <span class="text-xs text-muted-foreground">@CurrentFile.Size</span>
                            <span class="text-xs text-muted-foreground">&middot;</span>
                            <span class="text-xs text-muted-foreground">@CurrentFile.Modified</span>
                        </div>
                    </div>
                </div>
            </div>
        </DialogHeaderCn>

        @* Preview Area *@
        <div class="relative bg-muted/30 min-h-[300px] flex items-center justify-center mx-4 mt-4 rounded-lg border overflow-hidden">
            @if (CurrentFile.Type == "image" && !string.IsNullOrEmpty(CurrentFile.Preview))
            {
                <img alt="@CurrentFile.Name" class="max-h-[400px] w-auto object-contain" src="@CurrentFile.Preview" />
            }
            else if (CurrentFile.Type == "pdf")
            {
                <div class="flex flex-col items-center justify-center py-12 text-center">
                    <LucideFileTextCn Class="h-16 w-16 text-muted-foreground mb-4" Size="64" />
                    <p class="text-sm font-medium">PDF Preview</p>
                    <p class="text-xs text-muted-foreground mt-1">Click download to view the full document</p>
                </div>
            }
            else if (CurrentFile.Type == "code")
            {
                <div class="w-full p-4 font-mono text-sm overflow-auto max-h-[400px]">
                    <pre class="text-muted-foreground">@_codePreview</pre>
                </div>
            }
            else
            {
                <div class="flex flex-col items-center justify-center py-12 text-center">
                    <LucideFileCn Class="h-16 w-16 text-muted-foreground mb-4" Size="64" />
                    <p class="text-sm font-medium">Preview not available</p>
                    <p class="text-xs text-muted-foreground mt-1">Download to view this file</p>
                </div>
            }

            @if (_files.Length > 1)
            {
                <ButtonCn Class="absolute left-2 top-1/2 -translate-y-1/2 h-8 w-8 rounded-full bg-background/80 backdrop-blur-sm"
                          Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" @onclick="HandlePrevious">
                    <LucideChevronLeftCn Class="h-4 w-4" Size="16" />
                </ButtonCn>
                <ButtonCn Class="absolute right-2 top-1/2 -translate-y-1/2 h-8 w-8 rounded-full bg-background/80 backdrop-blur-sm"
                          Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" @onclick="HandleNext">
                    <LucideChevronRightCn Class="h-4 w-4" Size="16" />
                </ButtonCn>
                <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1">
                    @for (var i = 0; i < _files.Length; i++)
                    {
                        var index = i;
                        <button type="button"
                                class="@Cn.Merge("h-1.5 w-1.5 rounded-full transition-colors", index == _currentIndex ? "bg-primary" : "bg-muted-foreground/30")"
                                @onclick="@(() => _currentIndex = index)">
                        </button>
                    }
                </div>
            }
        </div>

        @* Actions *@
        <div class="p-4 border-t">
            <div class="flex flex-wrap gap-2">
                <ButtonCn>
                    <LucideDownloadCn Class="mr-2 h-4 w-4" Size="16" />
                    Download
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline">
                    <LucideShare2Cn Class="mr-2 h-4 w-4" Size="16" />
                    Share
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleCopyLink">
                    @if (_copied)
                    {
                        <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Copied!</span>
                    }
                    else
                    {
                        <LucideCopyCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Copy Link</span>
                    }
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Outline">
                    <LucidePrinterCn Class="h-4 w-4" Size="16" />
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Outline">
                    <LucideExternalLinkCn Class="h-4 w-4" Size="16" />
                </ButtonCn>
                <div class="flex-1"></div>
                <ButtonCn Class="text-destructive hover:text-destructive" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                    <LucideTrash2Cn Class="h-4 w-4" Size="16" />
                </ButtonCn>
            </div>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private record FileItem(string Id, string Name, string Type, string Size, string Modified, string? Preview = null);

    private static readonly FileItem[] _files =
    [
        new("1", "project-screenshot.png", "image", "2.4 MB", "Dec 10, 2024", "https://picsum.photos/seed/doc1/800/600"),
        new("2", "quarterly-report.pdf", "pdf", "1.8 MB", "Dec 8, 2024"),
        new("3", "config.json", "code", "4.2 KB", "Dec 5, 2024"),
    ];

    private static readonly string _codePreview = @"{
  ""name"": ""my-app"",
  ""version"": ""1.0.0"",
  ""dependencies"": {
    ""react"": ""^18.2.0"",
    ""next"": ""^14.0.0""
  }
}";

    private bool _open;
    private int _currentIndex;
    private bool _copied;

    private FileItem CurrentFile => _files[_currentIndex];

    private void HandlePrevious()
    {
        _currentIndex = _currentIndex > 0 ? _currentIndex - 1 : _files.Length - 1;
    }

    private void HandleNext()
    {
        _currentIndex = _currentIndex < _files.Length - 1 ? _currentIndex + 1 : 0;
    }

    private void HandleCopyLink()
    {
        _copied = true;
        _ = Task.Delay(2000).ContinueWith(_ => { _copied = false; InvokeAsync(StateHasChanged); });
    }
}
