@* ========================================
   Block: dialog-merge-accounts
   Title: Dialog Merge Accounts
   Description: Merge accounts dialog with account selection, data preview, conflict resolution, and confirmation
   Dependencies: AlertCn, AlertDescriptionCn, AvatarCn, AvatarFallbackCn, BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideActivityCn, LucideAlertTriangleCn, LucideArrowRightCn, LucideCalendarCn, LucideCheckCn, LucideLoader2Cn, LucideMailCn, LucideMergeCn, LucidePhoneCn, RadioGroupCn, RadioGroupItemCn, SeparatorCn
   Source: original/blocks/dialog/dialog-merge-accounts.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideMergeCn Class="mr-2 h-4 w-4" Size="16" />
                Merge Accounts
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-lg">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideMergeCn Class="h-5 w-5" Size="20" />
                Merge Accounts
            </DialogTitleCn>
            <DialogDescriptionCn>
                @(_step == "select" ? "Select the primary account to keep." : "Review and resolve any conflicts.")
            </DialogDescriptionCn>
        </DialogHeaderCn>

        @if (_step == "select")
        {
            <div class="space-y-4 py-4">
                <AlertCn>
                    <LucideAlertTriangleCn Class="h-4 w-4" Size="16" />
                    <AlertDescriptionCn>
                        The secondary account will be merged into the primary account. This action combines all data and cannot be easily undone.
                    </AlertDescriptionCn>
                </AlertCn>

                <RadioGroupCn Class="space-y-3" Value="@_primaryAccount" ValueChanged="@(v => _primaryAccount = v)">
                    @foreach (var account in _accounts)
                    {
                        <LabelCn Class="@Cn.Merge("flex items-start gap-4 rounded-lg border p-4 cursor-pointer transition-all", _primaryAccount == account.Id ? "border-primary bg-primary/5" : "hover:border-muted-foreground/50")"
                                 For="@account.Id">
                            <RadioGroupItemCn Class="mt-1" id="@account.Id" Value="@account.Id" />
                            <AvatarCn Class="h-10 w-10">
                                <AvatarFallbackCn>@account.Initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="flex-1 space-y-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium">@account.Name</span>
                                    @if (_primaryAccount == account.Id)
                                    {
                                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Default">Primary</BadgeCn>
                                    }
                                </div>
                                <p class="text-sm text-muted-foreground">@account.Email</p>
                                <div class="flex items-center gap-4 text-xs text-muted-foreground">
                                    <span class="flex items-center gap-1">
                                        <LucideCalendarCn Class="h-3 w-3" Size="12" />
                                        Created @account.CreatedAt
                                    </span>
                                    <span class="flex items-center gap-1">
                                        <LucideActivityCn Class="h-3 w-3" Size="12" />
                                        @account.ActivityCount activities
                                    </span>
                                </div>
                            </div>
                        </LabelCn>
                    }
                </RadioGroupCn>
            </div>
        }
        else
        {
            var primary = _accounts.First(a => a.Id == _primaryAccount);
            var secondary = _accounts.First(a => a.Id != _primaryAccount);

            <div class="space-y-4 py-4">
                @* Merge Direction *@
                <div class="flex items-center justify-center gap-4 py-2">
                    <div class="text-center">
                        <AvatarCn Class="h-12 w-12 mx-auto">
                            <AvatarFallbackCn>@secondary.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <p class="text-xs text-muted-foreground mt-1">Secondary</p>
                    </div>
                    <LucideArrowRightCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                    <div class="text-center">
                        <AvatarCn Class="h-12 w-12 mx-auto border-2 border-primary">
                            <AvatarFallbackCn>@primary.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <p class="text-xs font-medium mt-1">Primary</p>
                    </div>
                </div>

                <SeparatorCn />

                @* Conflict Resolution *@
                <div class="space-y-4">
                    <LabelCn Class="text-sm font-medium">Resolve Conflicts</LabelCn>

                    <div class="space-y-2">
                        <div class="flex items-center gap-2 text-sm">
                            <LucideMailCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            <span>Email Address</span>
                        </div>
                        <RadioGroupCn Class="grid grid-cols-2 gap-2" Value="@_emailConflict" ValueChanged="@(v => _emailConflict = v)">
                            @foreach (var account in _accounts)
                            {
                                <LabelCn Class="@Cn.Merge("flex items-center gap-2 rounded-md border p-2 cursor-pointer text-sm", _emailConflict == account.Id ? "border-primary bg-primary/5" : "")"
                                         For="@($"email-{account.Id}")">
                                    <RadioGroupItemCn id="@($"email-{account.Id}")" Value="@account.Id" />
                                    <span class="truncate">@account.Email</span>
                                </LabelCn>
                            }
                        </RadioGroupCn>
                    </div>

                    <div class="space-y-2">
                        <div class="flex items-center gap-2 text-sm">
                            <LucidePhoneCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            <span>Phone Number</span>
                        </div>
                        <RadioGroupCn Class="grid grid-cols-2 gap-2" Value="@_phoneConflict" ValueChanged="@(v => _phoneConflict = v)">
                            @foreach (var account in _accounts)
                            {
                                <LabelCn Class="@Cn.Merge("flex items-center gap-2 rounded-md border p-2 cursor-pointer text-sm", _phoneConflict == account.Id ? "border-primary bg-primary/5" : "")"
                                         For="@($"phone-{account.Id}")">
                                    <RadioGroupItemCn id="@($"phone-{account.Id}")" Value="@account.Id" />
                                    <span class="truncate">@account.Phone</span>
                                </LabelCn>
                            }
                        </RadioGroupCn>
                    </div>
                </div>

                <SeparatorCn />

                @* Summary *@
                <div class="rounded-lg border p-3 space-y-2">
                    <p class="text-sm font-medium">After merge:</p>
                    <ul class="text-sm text-muted-foreground space-y-1">
                        <li>&bull; Name: @primary.Name</li>
                        <li>&bull; Email: @(_accounts.FirstOrDefault(a => a.Id == _emailConflict)?.Email)</li>
                        <li>&bull; Phone: @(_accounts.FirstOrDefault(a => a.Id == _phoneConflict)?.Phone)</li>
                        <li>&bull; Activities: @(_accounts.Sum(a => a.ActivityCount)) total</li>
                    </ul>
                </div>
            </div>
        }

        <DialogFooterCn>
            @if (_step == "select")
            {
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">Cancel</ButtonCn>
                <ButtonCn @onclick="@(() => _step = "review")">
                    Continue
                    <LucideArrowRightCn Class="ml-2 h-4 w-4" Size="16" />
                </ButtonCn>
            }
            else
            {
                <ButtonCn Disabled="@_isMerging" Variant="ButtonVariant.Outline" @onclick="@(() => _step = "select")">Back</ButtonCn>
                <ButtonCn Disabled="@_isMerging" @onclick="HandleMerge">
                    @if (_isMerging)
                    {
                        <LucideLoader2Cn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                        @:Merging...
                    }
                    else
                    {
                        <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                        @:Merge Accounts
                    }
                </ButtonCn>
            }
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private record Account(string Id, string Name, string Email, string Phone, string Initials, string CreatedAt, string LastActive, int ActivityCount);

    private static readonly Account[] _accounts =
    [
        new("1", "John Smith", "john.smith@email.com", "+1 (555) 123-4567", "JS", "Jan 15, 2023", "2 hours ago", 156),
        new("2", "John D. Smith", "johnsmith@gmail.com", "+1 (555) 987-6543", "JS", "Mar 22, 2024", "5 days ago", 23),
    ];

    private bool _open;
    private string _primaryAccount = "1";
    private string _emailConflict = "1";
    private string _phoneConflict = "1";
    private bool _isMerging;
    private string _step = "select";

    private async Task HandleMerge()
    {
        _isMerging = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isMerging = false;
        _open = false;
        _step = "select";
    }
}
