@* ========================================
   Block: dialog-voice-command
   Title: Dialog Voice Command
   Description: Voice command dialog with listening animation, transcript display, and action confirmation for React voice apps
   Long Description: Version history dialog with timeline of changes, diff preview, restore functionality, and author attribution
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogTitleCn, DialogTriggerCn, LucideCheckCn, LucideMicCn
   Source: original/blocks/dialog/dialog-voice-command.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideMicCn Size="16" Class="mr-2 size-4" />
                Voice Command
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="text-center" Style="max-width: 320px">
        <DialogTitleCn Class="sr-only">Voice Command</DialogTitleCn>

        <div class="py-6 space-y-6">
            @if (_recognized is not null)
            {
                @* Recognized state *@
                <div class="flex flex-col items-center">
                    <div class="h-16 w-16 rounded-full bg-primary/10 flex items-center justify-center">
                        <LucideCheckCn Size="32" Class="size-8 text-primary" />
                    </div>
                </div>
                <div>
                    <p class="font-medium">@_recognized</p>
                    <p class="text-sm text-muted-foreground mt-1">Command recognized</p>
                </div>
                <ButtonCn Class="w-full" @onclick="HandleClose">
                    Done
                </ButtonCn>
            }
            else
            {
                @* Mic button with pulse *@
                <div class="flex flex-col items-center">
                    <button type="button"
                            class="@Cn.Merge("relative h-20 w-20 rounded-full flex items-center justify-center transition-colors", _listening ? "bg-primary text-primary-foreground" : "bg-muted hover:bg-muted/80")"
                            disabled="@_listening"
                            @onclick="HandleStart">
                        @if (_listening)
                        {
                            <span class="absolute inset-0 rounded-full bg-primary animate-ping opacity-25"></span>
                            <span class="absolute inset-[-8px] rounded-full border-2 border-primary/30 animate-pulse"></span>
                        }
                        <LucideMicCn Size="32" Class="size-8 relative z-10" />
                    </button>
                </div>

                @* Status *@
                <div class="min-h-[48px]">
                    @if (_listening)
                    {
                        <p class="text-sm text-muted-foreground">Listening...</p>
                        @if (!string.IsNullOrEmpty(_transcript))
                        {
                            <p class="font-medium mt-1">"@_transcript"</p>
                        }
                    }
                    else
                    {
                        <p class="text-sm text-muted-foreground">Tap the microphone and speak</p>
                    }
                </div>

                @* Example commands *@
                <div class="space-y-1">
                    <p class="text-xs text-muted-foreground">Try saying:</p>
                    <div class="flex flex-wrap justify-center gap-1.5">
                        @foreach (var cmd in _commands)
                        {
                            <span class="text-xs bg-muted px-2 py-1 rounded-full">
                                "@cmd.Trigger"
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private record VoiceCommand(string Trigger, string Action);

    private static readonly VoiceCommand[] _commands =
    {
        new("play music", "Playing your playlist"),
        new("turn off lights", "Turning off lights"),
        new("set timer", "Timer set for 5 minutes")
    };

    private bool _open;
    private bool _listening;
    private string _transcript = "";
    private string? _recognized;

    private void HandleStart()
    {
        // Show a static "listening" state with a recognized result
        _listening = false;
        _transcript = "play music";
        _recognized = "Playing your playlist";
    }

    private void HandleClose()
    {
        _open = false;
        _listening = false;
        _transcript = "";
        _recognized = null;
    }
}
