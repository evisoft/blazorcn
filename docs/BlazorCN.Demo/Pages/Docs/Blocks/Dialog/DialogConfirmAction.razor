@* ========================================
   Block: dialog-confirm-action
   Title: Dialog Confirm Action
   Description: Generic action confirmation dialog with customizable icon, title, message, and action buttons for any confirmation flow
   Dependencies: AlertDialogCn, AlertDialogContentCn, AlertDialogDescriptionCn, AlertDialogFooterCn, AlertDialogHeaderCn, AlertDialogTitleCn, AlertDialogTriggerCn, ButtonCn, CheckboxCn, LabelCn, LucideArchiveCn, LucideCheckCn, LucideGlobeCn, LucideLoader2Cn, LucideRefreshCwCn
   Source: original/blocks/dialog/dialog-confirm-action.tsx
   ======================================== *@

<div class="flex min-h-[350px] items-center justify-center">
    <div class="flex flex-wrap gap-3 justify-center">
        @foreach (var action in _actions)
        {
            var act = action;
            <AlertDialogCn @bind-Open="act.IsOpen">
                <AlertDialogTriggerCn Class="@Cn.Merge("cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0", act.Variant == "destructive" ? "cn-button-variant-destructive" : "cn-button-variant-outline", "cn-button-size-default")"
                                      data-variant="@(act.Variant == "destructive" ? "destructive" : "outline")" data-size="default">
                    @act.IconFragment
                    @act.TriggerLabel
                </AlertDialogTriggerCn>
                <AlertDialogContentCn>
                    <AlertDialogHeaderCn>
                        <div class="flex items-start gap-4">
                            <div class="@Cn.Merge("flex h-10 w-10 shrink-0 items-center justify-center rounded-full border", act.Variant == "destructive" ? "border-destructive/50" : "", act.Variant == "warning" ? "border-yellow-600/50" : "")">
                                <span class="@act.IconClass">@act.IconFragment</span>
                            </div>
                            <div class="space-y-2">
                                <AlertDialogTitleCn>@act.Title</AlertDialogTitleCn>
                                <AlertDialogDescriptionCn>@act.Description</AlertDialogDescriptionCn>
                            </div>
                        </div>
                    </AlertDialogHeaderCn>

                    <div class="flex items-center gap-2 py-2">
                        <CheckboxCn Id="@($"dont-ask-{act.Id}")" Checked="@_dontAskAgain" CheckedChanged="@((bool v) => _dontAskAgain = v)" />
                        <LabelCn Class="text-sm font-normal text-muted-foreground cursor-pointer" For="@($"dont-ask-{act.Id}")">
                            Don't ask me again
                        </LabelCn>
                    </div>

                    <AlertDialogFooterCn>
                        <ButtonCn Disabled="@_isLoading" Variant="ButtonVariant.Outline" @onclick="@(() => HandleCancel(act))">
                            Cancel
                        </ButtonCn>
                        <ButtonCn Class="@act.ButtonClass" Disabled="@_isLoading" @onclick="@(() => HandleConfirm(act))">
                            @if (_isLoading)
                            {
                                <LucideLoaderCircleCn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                                <span>Processing...</span>
                            }
                            else
                            {
                                <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                                <span>@act.ConfirmLabel</span>
                            }
                        </ButtonCn>
                    </AlertDialogFooterCn>
                </AlertDialogContentCn>
            </AlertDialogCn>
        }
    </div>
</div>

@code {
    private bool _isLoading;
    private bool _dontAskAgain;

    private class ActionConfig
    {
        public string Id { get; init; } = "";
        public string Title { get; init; } = "";
        public string Description { get; init; } = "";
        public string ConfirmLabel { get; init; } = "";
        public string Variant { get; init; } = "default";
        public string TriggerLabel { get; init; } = "";
        public RenderFragment? IconFragment { get; init; }
        public string IconClass { get; init; } = "";
        public string ButtonClass { get; init; } = "";
        public bool IsOpen { get; set; }
    }

    private readonly ActionConfig[] _actions;

    public DialogConfirmAction()
    {
        _actions =
        [
            new()
            {
                Id = "publish",
                Title = "Publish Content?",
                Description = "This will make your content visible to the public. You can unpublish it later if needed.",
                ConfirmLabel = "Publish",
                Variant = "default",
                TriggerLabel = "Publish",
                IconFragment = @<LucideGlobeCn Class="h-5 w-5 text-primary" Size="20" />,
                IconClass = "text-primary",
                ButtonClass = "",
            },
            new()
            {
                Id = "archive",
                Title = "Archive Project?",
                Description = "This project will be moved to archives. Team members will lose access but data will be preserved.",
                ConfirmLabel = "Archive",
                Variant = "warning",
                TriggerLabel = "Archive",
                IconFragment = @<LucideArchiveCn Class="h-5 w-5 text-yellow-600" Size="20" />,
                IconClass = "text-yellow-600",
                ButtonClass = "bg-yellow-600 text-white hover:bg-yellow-700",
            },
            new()
            {
                Id = "reset",
                Title = "Reset Settings?",
                Description = "All your customizations will be lost and settings will return to their defaults. This cannot be undone.",
                ConfirmLabel = "Reset All",
                Variant = "destructive",
                TriggerLabel = "Reset",
                IconFragment = @<LucideRefreshCwCn Class="h-5 w-5 text-destructive" Size="20" />,
                IconClass = "text-destructive",
                ButtonClass = "bg-destructive text-white hover:bg-destructive/90",
            },
        ];
    }

    private async Task HandleConfirm(ActionConfig action)
    {
        _isLoading = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isLoading = false;
        action.IsOpen = false;
        _dontAskAgain = false;
    }

    private void HandleCancel(ActionConfig action)
    {
        action.IsOpen = false;
        _dontAskAgain = false;
    }
}
