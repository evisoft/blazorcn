@* ========================================
   Block: dialog-referral-invite
   Title: Dialog Referral Invite
   Description: Referral program dialog with unique invite code, email invite form, rewards display, and referral stats
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCheckCn, LucideCopyCn, LucideGiftCn, LucideSendCn
   Source: original/blocks/dialog/dialog-referral-invite.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideGiftCn Class="mr-2 h-4 w-4" Size="16" />
                Invite Friends
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        <DialogHeaderCn>
            <DialogTitleCn>Invite Friends</DialogTitleCn>
            <DialogDescriptionCn>Give friends $10 off and earn $10 for each signup.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            <div class="space-y-2">
                <LabelCn>Your referral link</LabelCn>
                <div class="flex gap-2">
                    <InputCn Class="text-sm" Value="@ReferralLink" Disabled="@true" />
                    <ButtonCn Class="shrink-0" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="HandleCopy" aria-label="Confirm">
                        @if (_copied)
                        {
                            <LucideCheckCn Class="h-4 w-4 text-primary" Size="16" />
                        }
                        else
                        {
                            <LucideCopyCn Class="h-4 w-4" Size="16" />
                        }
                    </ButtonCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn>Or invite by email</LabelCn>
                <div class="flex gap-2">
                    <InputCn Placeholder="@("friend@example.com")" Type="email"
                             Value="@_email" ValueChanged="@(v => _email = v)" />
                    <ButtonCn Class="shrink-0"
                              Disabled="@(!IsValidEmail || _emailSent)"
                              @onclick="HandleSendEmail">
                        @if (_emailSent)
                        {
                            <LucideCheckCn Class="h-4 w-4" Size="16" />
                        }
                        else
                        {
                            <LucideSendCn Class="h-4 w-4" Size="16" />
                        }
                    </ButtonCn>
                </div>
                @if (_emailSent)
                {
                    <p class="text-xs text-primary">Invite sent!</p>
                }
            </div>

            <div class="flex items-center justify-between rounded-lg border p-3">
                <div>
                    <p class="text-sm font-medium">3 friends joined</p>
                    <p class="text-xs text-muted-foreground">$30 earned so far</p>
                </div>
                <ButtonCn Class="text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">View all</ButtonCn>
            </div>
        </div>

        <DialogFooterCn>
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">Done</ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private const string ReferralLink = "https://app.example.com/signup?ref=FRIEND2024";

    private bool _open;
    private bool _copied;
    private string _email = "";
    private bool _emailSent;

    private bool IsValidEmail => _email.Contains("@") && _email.Contains(".");

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }

    private async Task HandleSendEmail()
    {
        if (!IsValidEmail) return;
        _emailSent = true;
        StateHasChanged();
        await Task.Delay(2000);
        _emailSent = false;
        _email = "";
    }
}
