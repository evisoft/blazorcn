@* ========================================
   Block: dialog-contact-support
   Title: Dialog Contact Support
   Description: Contact support dialog with issue category selection, priority level, message input, file attachment, and ticket submission
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCheckCn, LucideLoader2Cn, LucideMessageSquareCn, LucideSendCn, LucideTriangleAlertCn, LucideXCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SeparatorCn, TextareaCn
   Source: original/blocks/dialog/dialog-contact-support.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideMessageSquareCn Class="mr-2 h-4 w-4" Size="16" />
                Contact Support
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-lg">
        @if (_isSubmitted)
        {
            <div class="flex flex-col items-center justify-center py-8 text-center">
                <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-primary">
                    <LucideCheckCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <h3 class="mt-4 text-lg font-semibold">Ticket Submitted</h3>
                <p class="mt-1 text-sm text-muted-foreground">
                    We've received your support request and will respond soon.
                </p>
                <div class="mt-4 rounded-lg border p-4 w-full">
                    <p class="text-xs text-muted-foreground">Ticket Reference</p>
                    <p class="font-mono text-lg font-semibold">@_ticketId</p>
                    <p class="mt-2 text-xs text-muted-foreground">
                        Expected response within 24 hours
                    </p>
                </div>
                <p class="mt-4 text-xs text-muted-foreground">
                    A confirmation email has been sent to your registered email address.
                </p>
                <ButtonCn Class="mt-6" @onclick="HandleClose">Done</ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn Class="flex items-center gap-2">
                    <LucideMessageSquareCn Class="h-5 w-5" Size="20" />
                    Contact Support
                </DialogTitleCn>
                <DialogDescriptionCn>
                    Describe your issue and we'll get back to you as soon as possible.
                </DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-4 py-4">
                @* Category *@
                <div class="space-y-2">
                    <LabelCn>Category <span class="text-destructive">*</span></LabelCn>
                    <SelectCn Value="@_category" ValueChanged="@((string v) => _category = v)">
                        <SelectTriggerCn>
                            <SelectValueCn Placeholder="Select issue category" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="technical">Technical Issue</SelectItemCn>
                            <SelectItemCn Value="billing">Billing &amp; Payments</SelectItemCn>
                            <SelectItemCn Value="account">Account &amp; Access</SelectItemCn>
                            <SelectItemCn Value="feature">Feature Question</SelectItemCn>
                            <SelectItemCn Value="other">General Inquiry</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>

                @* Priority *@
                <div class="space-y-2">
                    <LabelCn>Priority</LabelCn>
                    <SelectCn Value="@_priority" ValueChanged="@((string v) => _priority = v)">
                        <SelectTriggerCn>
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="low">Low - General questions</SelectItemCn>
                            <SelectItemCn Value="medium">Medium - Workaround exists</SelectItemCn>
                            <SelectItemCn Value="high">High - Needs attention</SelectItemCn>
                            <SelectItemCn Value="urgent">Urgent - Production issue</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <SeparatorCn />

                @* Subject *@
                <div class="space-y-2">
                    <LabelCn For="subject">Subject <span class="text-destructive">*</span></LabelCn>
                    <InputCn Id="subject" Placeholder="Brief summary of your issue" Value="@_subject" ValueChanged="@((string v) => _subject = v)" />
                </div>

                @* Message *@
                <div class="space-y-2">
                    <LabelCn For="message">Description <span class="text-destructive">*</span></LabelCn>
                    <TextareaCn Id="message" Rows="4" Placeholder="Please describe your issue in detail." Value="@_message" ValueChanged="@((string v) => _message = v)" />
                    <p class="text-xs text-muted-foreground">
                        @(_message.Length < 20 ? $"At least {20 - _message.Length} more characters needed" : $"{_message.Length} characters")
                    </p>
                </div>

                @* Priority Warning *@
                @if (_priority == "urgent")
                {
                    <div class="flex items-start gap-2 rounded-lg border border-destructive/50 p-3">
                        <LucideTriangleAlertCn Class="h-4 w-4 text-destructive mt-0.5" Size="16" />
                        <div>
                            <p class="text-sm font-medium text-destructive">Urgent Priority</p>
                            <p class="text-xs text-muted-foreground">
                                Please only use urgent for production-blocking issues.
                            </p>
                        </div>
                    </div>
                }
            </div>

            <DialogFooterCn>
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">Cancel</ButtonCn>
                <ButtonCn Disabled="@(!_isValid || _isSubmitting)" @onclick="HandleSubmit">
                    @if (_isSubmitting)
                    {
                        <LucideLoader2Cn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                        <span>Submitting...</span>
                    }
                    else
                    {
                        <LucideSendCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Submit Ticket</span>
                    }
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _category = "";
    private string _priority = "medium";
    private string _subject = "";
    private string _message = "";
    private bool _isSubmitting;
    private bool _isSubmitted;
    private string _ticketId = "";

    private bool _isValid => !string.IsNullOrEmpty(_category) && _subject.Trim().Length >= 5 && _message.Trim().Length >= 20;

    private async Task HandleSubmit()
    {
        if (!_isValid) return;
        _isSubmitting = true;
        StateHasChanged();
        await Task.Delay(1500);

        _ticketId = $"SUP-{Guid.NewGuid().ToString("N")[..6].ToUpper()}";
        _isSubmitting = false;
        _isSubmitted = true;
    }

    private void HandleClose()
    {
        _open = false;
        _category = "";
        _priority = "medium";
        _subject = "";
        _message = "";
        _isSubmitted = false;
        _ticketId = "";
    }
}
