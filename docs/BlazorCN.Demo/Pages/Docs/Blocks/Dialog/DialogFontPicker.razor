@* ========================================
   Block: dialog-font-picker
   Title: Dialog Font Picker
   Description: Font picker dialog with searchable font list, category filters, live preview, size adjustment, and recent selections
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LucideCheckCn, LucideSearchCn, LucideTypeCn
   Source: original/blocks/dialog/dialog-font-picker.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideTypeCn Class="mr-2 h-4 w-4" Size="16" />
                Choose Font
            </DialogTriggerCn>
    </div>
    <DialogContentCn class="sm:max-w-sm">
        <DialogHeaderCn>
            <DialogTitleCn class="flex items-center gap-2">
                <LucideTypeCn Class="h-5 w-5" Size="20" />
                Font Picker
            </DialogTitleCn>
            <DialogDescriptionCn>Select a font for your design.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            <div class="rounded-lg border p-4 text-center" style="font-family: @_selectedFont.Family;">
                <p class="text-xl">The quick brown fox jumps over the lazy dog</p>
                <p class="text-sm text-muted-foreground mt-2">
                    @_selectedFont.Name &middot; @_selectedFont.Category
                </p>
            </div>

            <div class="relative">
                <LucideSearchCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                <InputCn Class="pl-9" Placeholder="Search fonts..." @bind-Value="_search" />
            </div>

            <div class="h-[200px] overflow-y-auto space-y-1">
                @foreach (var font in FilteredFonts)
                {
                    <button type="button"
                            class="@Cn.Merge("w-full flex items-center justify-between p-2.5 rounded-lg transition-colors text-left", _selectedFont.Name == font.Name ? "bg-primary text-primary-foreground" : "hover:bg-muted")"
                            @onclick="@(() => _selectedFont = font)">
                        <span class="text-sm" style="font-family: @font.Family;">@font.Name</span>
                        @if (_selectedFont.Name == font.Name)
                        {
                            <LucideCheckCn Class="h-4 w-4 shrink-0" Size="16" />
                        }
                    </button>
                }
                @if (!FilteredFonts.Any())
                {
                    <div class="flex flex-col items-center justify-center py-8 text-center">
                        <LucideTypeCn Class="h-8 w-8 text-muted-foreground mb-2" Size="32" />
                        <p class="text-sm text-muted-foreground">No fonts found</p>
                    </div>
                }
            </div>
        </div>

        <DialogFooterCn>
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">
                Cancel
            </ButtonCn>
            <ButtonCn @onclick="HandleConfirm">Select</ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private record FontItem(string Name, string Family, string Category);

    private static readonly FontItem[] _fonts =
    [
        new("Inter", "Inter, sans-serif", "sans"),
        new("Roboto", "Roboto, sans-serif", "sans"),
        new("Open Sans", "'Open Sans', sans-serif", "sans"),
        new("Lato", "Lato, sans-serif", "sans"),
        new("Poppins", "Poppins, sans-serif", "sans"),
        new("Montserrat", "Montserrat, sans-serif", "sans"),
        new("Playfair Display", "'Playfair Display', serif", "serif"),
        new("Merriweather", "Merriweather, serif", "serif"),
        new("Lora", "Lora, serif", "serif"),
        new("Georgia", "Georgia, serif", "serif"),
        new("Bebas Neue", "'Bebas Neue', sans-serif", "display"),
        new("Oswald", "Oswald, sans-serif", "display"),
        new("Archivo Black", "'Archivo Black', sans-serif", "display"),
        new("JetBrains Mono", "'JetBrains Mono', monospace", "mono"),
        new("Fira Code", "'Fira Code', monospace", "mono"),
        new("Source Code Pro", "'Source Code Pro', monospace", "mono"),
    ];

    private bool _open;
    private string _search = "";
    private FontItem _selectedFont = _fonts[0];

    private IEnumerable<FontItem> FilteredFonts =>
        _fonts.Where(f => f.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void HandleConfirm() => _open = false;

    private void HandleClose()
    {
        _open = false;
        _search = "";
    }
}
