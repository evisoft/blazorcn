@* ========================================
   Block: dialog-assign-task
   Title: Dialog Assign Task
   Description: Assign task dialog with team member picker, due date selection, priority level, and task details
   Dependencies: AvatarCn, AvatarFallbackCn, BadgeCn, ButtonCn, CommandCn, CommandEmptyCn, CommandGroupCn, CommandInputCn, CommandItemCn, CommandListCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, PopoverCn, PopoverContentCn, PopoverTriggerCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, TextareaCn, LucideCalendarCn, LucideCheckCn, LucideClockCn, LucideFlagCn, LucideLoader2Cn, LucideUserPlusCn
   Source: original/blocks/dialog/dialog-assign-task.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideUserPlusCn Class="mr-2 h-4 w-4" Size="16" />
                Assign Task
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideUserPlusCn Class="h-5 w-5" Size="20" />
                Assign Task
            </DialogTitleCn>
            <DialogDescriptionCn>Assign this task to a team member with a deadline.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            @* Assignee Picker *@
            <div class="space-y-2">
                <LabelCn>Assignee</LabelCn>
                <PopoverCn @bind-Open="_assigneeOpen">
                    <PopoverTriggerCn>
                        <ButtonCn Class="w-full justify-start" Variant="ButtonVariant.Outline">
                            @if (_selectedMember is not null)
                            {
                                <div class="flex items-center gap-2">
                                    <AvatarCn Class="h-6 w-6">
                                        <AvatarFallbackCn Class="text-xs">@_selectedMember.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                    <span>@_selectedMember.Name</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted-foreground">Select team member...</span>
                            }
                        </ButtonCn>
                    </PopoverTriggerCn>
                    <PopoverContentCn Align="FloatingAlign.Start" Class="w-[300px] p-0">
                        <CommandCn>
                            <CommandInputCn Placeholder="Search team..." />
                            <CommandListCn>
                                <CommandEmptyCn>No member found.</CommandEmptyCn>
                                <CommandGroupCn>
                                    @foreach (var member in _teamMembers)
                                    {
                                        <CommandItemCn Class="cursor-pointer" @onclick="@(() => { _selectedMember = member; _assigneeOpen = false; })">
                                            <AvatarCn Class="h-8 w-8 mr-2">
                                                <AvatarFallbackCn Class="text-xs">@member.Initials</AvatarFallbackCn>
                                            </AvatarCn>
                                            <div class="flex-1">
                                                <p class="text-sm font-medium">@member.Name</p>
                                                <p class="text-xs text-muted-foreground">@member.TaskCount active tasks</p>
                                            </div>
                                            @if (_selectedMember?.Id == member.Id)
                                            {
                                                <LucideCheckCn Class="h-4 w-4 text-primary" Size="16" />
                                            }
                                        </CommandItemCn>
                                    }
                                </CommandGroupCn>
                            </CommandListCn>
                        </CommandCn>
                    </PopoverContentCn>
                </PopoverCn>
            </div>

            @* Due Date *@
            <div class="space-y-2">
                <LabelCn>Due Date</LabelCn>
                <ButtonCn Class="@Cn.Merge("w-full justify-start text-left", _dueDate is null ? "text-muted-foreground" : "")"
                          @onclick="@(() => _showDatePicker = !_showDatePicker)"
                          Variant="ButtonVariant.Outline">
                    <LucideCalendarCn Class="mr-2 h-4 w-4" Size="16" />
                    @(_dueDate?.ToShortDateString() ?? "Select due date...")
                </ButtonCn>
                @if (_showDatePicker)
                {
                    <div class="rounded-lg border p-2">
                        <div class="flex gap-1 border-b pb-2 mb-2">
                            @foreach (var qd in _quickDates)
                            {
                                <ButtonCn Class="text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                                          @onclick="@(() => { _dueDate = DateTime.Today.AddDays(qd.Days); _showDatePicker = false; })">
                                    @qd.Label
                                </ButtonCn>
                            }
                        </div>
                        <CalendarCn @bind-Value="_dueDate" />
                    </div>
                }
            </div>

            @* Priority *@
            <div class="space-y-2">
                <LabelCn>Priority</LabelCn>
                <SelectCn Value="@_priority" ValueChanged="@(v => _priority = v)">
                    <SelectTriggerCn>
                        <SelectValueCn>
                            <div class="flex items-center gap-2">
                                <LucideFlagCn Class="@Cn.Merge("h-4 w-4", SelectedPriority?.Color ?? "")" Size="16" />
                                <span>@SelectedPriority?.Label</span>
                            </div>
                        </SelectValueCn>
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var p in _priorities)
                        {
                            <SelectItemCn Value="@p.Value">
                                <div class="flex items-center gap-2">
                                    <LucideFlagCn Class="@Cn.Merge("h-4 w-4", p.Color)" Size="16" />
                                    <span>@p.Label</span>
                                </div>
                            </SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>

            @* Notes *@
            <div class="space-y-2">
                <LabelCn For="notes">Notes (optional)</LabelCn>
                <TextareaCn Id="notes" Value="@_notes" ValueChanged="@((string v) => _notes = v)"
                            Placeholder="Add any instructions or context..." Rows="3" />
            </div>

            @* Summary *@
            @if (_selectedMember is not null)
            {
                <div class="rounded-lg border p-3 space-y-2">
                    <p class="text-sm font-medium">Assignment Summary</p>
                    <div class="flex items-center gap-2 text-sm text-muted-foreground">
                        <AvatarCn Class="h-5 w-5">
                            <AvatarFallbackCn Class="text-[10px]">@_selectedMember.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <span>@_selectedMember.Name</span>
                        @if (_dueDate is not null)
                        {
                            <span>&bull;</span>
                            <LucideClockCn Class="h-3 w-3" Size="12" />
                            <span>@_dueDate.Value.ToShortDateString()</span>
                        }
                        <span>&bull;</span>
                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">@SelectedPriority?.Label</BadgeCn>
                    </div>
                </div>
            }
        </div>

        <DialogFooterCn>
            <ButtonCn Disabled="@_isAssigning" @onclick="@(() => _open = false)" Variant="ButtonVariant.Outline">Cancel</ButtonCn>
            <ButtonCn Disabled="@(_selectedMember is null || _isAssigning)" @onclick="HandleAssign">
                @if (_isAssigning)
                {
                    <LucideLoader2Cn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    <span>Assigning...</span>
                }
                else
                {
                    <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                    <span>Assign Task</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _assigneeOpen;
    private bool _showDatePicker;
    private TeamMember? _selectedMember;
    private DateTime? _dueDate;
    private string _priority = "medium";
    private string _notes = "";
    private bool _isAssigning;

    private record TeamMember(string Id, string Name, string Initials, int TaskCount);
    private record PriorityOption(string Value, string Label, string Color);
    private record QuickDate(string Label, int Days);

    private static readonly TeamMember[] _teamMembers =
    [
        new("1", "Alice Johnson", "AJ", 5),
        new("2", "Bob Smith", "BS", 3),
        new("3", "Carol Williams", "CW", 8),
        new("4", "David Brown", "DB", 2),
        new("5", "Emma Davis", "ED", 6),
    ];

    private static readonly PriorityOption[] _priorities =
    [
        new("low", "Low", "text-muted-foreground"),
        new("medium", "Medium", "text-blue-600"),
        new("high", "High", "text-orange-600"),
        new("urgent", "Urgent", "text-destructive"),
    ];

    private static readonly QuickDate[] _quickDates =
    [
        new("Today", 0), new("Tomorrow", 1), new("Next Week", 7), new("In 2 Weeks", 14),
    ];

    private PriorityOption? SelectedPriority => _priorities.FirstOrDefault(p => p.Value == _priority);

    private async Task HandleAssign()
    {
        if (_selectedMember is null) return;
        _isAssigning = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isAssigning = false;
        _open = false;
        _selectedMember = null;
        _dueDate = null;
        _priority = "medium";
        _notes = "";
    }
}
