@* ========================================
   Block: dialog-quick-calculator
   Title: Dialog Quick Calculator
   Description: Quick calculator dialog with basic operations, calculation history, memory functions, and keyboard support
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCalculatorCn, LucideDivideCn, LucideEqualCn, LucideMinusCn, LucidePercentCn, LucidePlusCn, LucideXCn, ScrollAreaCn
   Source: original/blocks/dialog/dialog-quick-calculator.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideCalculatorCn Class="mr-2 h-4 w-4" Size="16" />
                Calculator
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideCalculatorCn Class="h-5 w-5" Size="20" />
                    Calculator
                </div>
                <div class="flex items-center gap-1">
                    @if (_hasMemory)
                    {
                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">M</BadgeCn>
                    }
                    <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                              @onclick="@(() => _showHistory = !_showHistory)" aria-label="Time">
                        <LucideClockCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>
                </div>
            </DialogTitleCn>
            <DialogDescriptionCn Class="sr-only">Perform quick calculations</DialogDescriptionCn>
        </DialogHeaderCn>

        @if (_showHistory)
        {
            <div class="space-y-2 py-2">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium">History</span>
                    @if (_history.Count > 0)
                    {
                        <ButtonCn Class="h-7 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                                  @onclick="@(() => _history.Clear())">Clear</ButtonCn>
                    }
                </div>
                <ScrollAreaCn Class="h-[300px]">
                    @if (_history.Count == 0)
                    {
                        <div class="flex flex-col items-center justify-center py-8 text-center">
                            <LucideClockCn Class="h-8 w-8 text-muted-foreground mb-2" Size="32" />
                            <p class="text-sm text-muted-foreground">No history yet</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var entry in _history)
                            {
                                <button type="button"
                                        class="w-full rounded-lg border p-2 text-left hover:bg-muted transition-colors"
                                        @onclick="@(() => { _display = entry.Result; _waitingForOperand = true; _showHistory = false; })">
                                    <p class="text-xs text-muted-foreground truncate">@entry.Expression</p>
                                    <p class="text-lg font-mono font-semibold">= @entry.Result</p>
                                </button>
                            }
                        </div>
                    }
                </ScrollAreaCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline" @onclick="@(() => _showHistory = false)">
                    Back to Calculator
                </ButtonCn>
            </div>
        }
        else
        {
            <div class="space-y-2 py-2">
                <div class="rounded-lg border bg-muted/30 p-3 text-right">
                    @if (!string.IsNullOrEmpty(_expression))
                    {
                        <p class="text-xs text-muted-foreground mb-1 truncate">@_expression</p>
                    }
                    <p class="text-3xl font-mono font-bold tabular-nums truncate">@_display</p>
                </div>

                @* Memory buttons *@
                <div class="grid grid-cols-4 gap-1">
                    <ButtonCn Class="h-12 text-sm font-medium" Variant="ButtonVariant.Ghost" @onclick="MemoryClear">MC</ButtonCn>
                    <ButtonCn Class="h-12 text-sm font-medium" Variant="ButtonVariant.Ghost" @onclick="MemoryRecall">MR</ButtonCn>
                    <ButtonCn Class="h-12 text-sm font-medium" Variant="ButtonVariant.Ghost" @onclick="MemoryAdd">M+</ButtonCn>
                    <ButtonCn Class="h-12 text-sm font-medium" Variant="ButtonVariant.Ghost" @onclick="MemorySubtract">M-</ButtonCn>
                </div>

                @* Calculator buttons *@
                <div class="grid grid-cols-4 gap-1">
                    <ButtonCn Class="h-12 text-lg font-medium" Variant="ButtonVariant.Secondary" @onclick="ClearAll">AC</ButtonCn>
                    <ButtonCn Class="h-12 text-lg font-medium" Variant="ButtonVariant.Secondary" @onclick="ToggleSign">&#xB1;</ButtonCn>
                    <ButtonCn Class="h-12 text-lg font-medium" Variant="ButtonVariant.Secondary" @onclick="InputPercent">
                        <LucidePercentCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>
                    <ButtonCn Class="h-12 text-lg font-medium" @onclick="@(() => PerformOperation("\u00F7"))">
                        <LucideDivideCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>

                    <ButtonCn Class="h-12 text-lg font-medium" Variant="ButtonVariant.Outline" @onclick="@(() => InputDigit("7"))">7</ButtonCn>
                    <ButtonCn Class="h-12 text-lg font-medium" Variant="ButtonVariant.Outline" @onclick="@(() => InputDigit("8"))">8</ButtonCn>
                    <ButtonCn Class="h-12 text-lg font-medium" Variant="ButtonVariant.Outline" @onclick="@(() => InputDigit("9"))">9</ButtonCn>
                    <ButtonCn Class="h-12 text-lg font-medium" @onclick="@(() => PerformOperation("\u00D7"))">
                        <LucideXCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>

                    <ButtonCn Class="h-12 text-lg font-medium" Variant="ButtonVariant.Outline" @onclick="@(() => InputDigit("4"))">4</ButtonCn>
                    <ButtonCn Class="h-12 text-lg font-medium" Variant="ButtonVariant.Outline" @onclick="@(() => InputDigit("5"))">5</ButtonCn>
                    <ButtonCn Class="h-12 text-lg font-medium" Variant="ButtonVariant.Outline" @onclick="@(() => InputDigit("6"))">6</ButtonCn>
                    <ButtonCn Class="h-12 text-lg font-medium" @onclick="@(() => PerformOperation("-"))">
                        <LucideMinusCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>

                    <ButtonCn Class="h-12 text-lg font-medium" Variant="ButtonVariant.Outline" @onclick="@(() => InputDigit("1"))">1</ButtonCn>
                    <ButtonCn Class="h-12 text-lg font-medium" Variant="ButtonVariant.Outline" @onclick="@(() => InputDigit("2"))">2</ButtonCn>
                    <ButtonCn Class="h-12 text-lg font-medium" Variant="ButtonVariant.Outline" @onclick="@(() => InputDigit("3"))">3</ButtonCn>
                    <ButtonCn Class="h-12 text-lg font-medium" @onclick="@(() => PerformOperation("+"))">
                        <LucidePlusCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>

                    <ButtonCn Class="col-span-2 h-12 text-lg font-medium" Variant="ButtonVariant.Outline" @onclick="@(() => InputDigit("0"))">0</ButtonCn>
                    <ButtonCn Class="h-12 text-lg font-medium" Variant="ButtonVariant.Outline" @onclick="InputDecimal">.</ButtonCn>
                    <ButtonCn Class="h-12 text-lg font-medium" @onclick="Equals">
                        <LucideEqualCn Class="h-4 w-4" Size="16" />
                    </ButtonCn>
                </div>

                <p class="text-xs text-center text-muted-foreground">Keyboard supported</p>
            </div>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record HistoryEntry(string Expression, string Result);

    private bool _open;
    private string _display = "0";
    private double? _previousValue;
    private string? _operator;
    private bool _waitingForOperand;
    private double _memory;
    private bool _hasMemory;
    private List<HistoryEntry> _history = [];
    private bool _showHistory;
    private string _expression = "";

    private static string FormatNumber(double num)
    {
        if (Math.Abs(num) >= 1e10 || (Math.Abs(num) < 1e-6 && num != 0))
            return num.ToString("E6");
        return double.Parse(num.ToString("R")).ToString("G12");
    }

    private void InputDigit(string digit)
    {
        if (_waitingForOperand)
        {
            _display = digit;
            _waitingForOperand = false;
        }
        else
        {
            _display = _display == "0" ? digit : _display + digit;
        }
    }

    private void InputDecimal()
    {
        if (_waitingForOperand) { _display = "0."; _waitingForOperand = false; return; }
        if (!_display.Contains('.')) _display += ".";
    }

    private void ClearAll()
    {
        _display = "0"; _previousValue = null; _operator = null; _waitingForOperand = false; _expression = "";
    }

    private void ToggleSign()
    {
        if (double.TryParse(_display, out var v)) _display = FormatNumber(-v);
    }

    private void InputPercent()
    {
        if (double.TryParse(_display, out var v)) _display = FormatNumber(v / 100);
    }

    private static double Calculate(double left, double right, string? op) => op switch
    {
        "+" => left + right,
        "-" => left - right,
        "\u00D7" => left * right,
        "\u00F7" => right != 0 ? left / right : double.NaN,
        _ => right
    };

    private void PerformOperation(string? nextOp)
    {
        if (!double.TryParse(_display, out var inputValue)) return;

        if (_previousValue is null)
        {
            _previousValue = inputValue;
            _expression = $"{FormatNumber(inputValue)} {nextOp}";
        }
        else if (_operator is not null)
        {
            var result = Calculate(_previousValue.Value, inputValue, _operator);
            var newExpr = $"{_expression} {FormatNumber(inputValue)}";

            if (nextOp is not null)
            {
                _expression = $"{FormatNumber(result)} {nextOp}";
            }
            else
            {
                _history.Insert(0, new(newExpr, FormatNumber(result)));
                if (_history.Count > 20) _history.RemoveRange(20, _history.Count - 20);
                _expression = "";
            }
            _display = FormatNumber(result);
            _previousValue = nextOp is not null ? result : null;
        }

        _waitingForOperand = true;
        _operator = nextOp;
    }

    private void Equals()
    {
        if (_operator is not null && _previousValue is not null)
            PerformOperation(null);
    }

    private void MemoryAdd() { if (double.TryParse(_display, out var v)) { _memory += v; _hasMemory = true; } }
    private void MemorySubtract() { if (double.TryParse(_display, out var v)) { _memory -= v; _hasMemory = true; } }
    private void MemoryRecall() { _display = FormatNumber(_memory); _waitingForOperand = true; }
    private void MemoryClear() { _memory = 0; _hasMemory = false; }
}
