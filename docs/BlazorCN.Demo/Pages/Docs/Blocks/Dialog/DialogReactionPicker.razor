@* ========================================
   Block: dialog-reaction-picker
   Title: Dialog Reaction Picker
   Description: Reaction picker dialog with emoji grid, recent reactions, and selection feedback
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogTitleCn, DialogTriggerCn, LucideCheckCn, LucideSmilePlusCn
   Source: original/blocks/dialog/dialog-reaction-picker.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideSmilePlusCn Class="mr-2 h-4 w-4" Size="16" />
                Add Reaction
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="p-4" style="max-width: 320px;">
        <DialogTitleCn Class="sr-only">Add Reaction</DialogTitleCn>
        @if (_selected is not null)
        {
            <div class="flex flex-col items-center justify-center py-8">
                <span class="text-5xl">@_selected</span>
                <div class="flex items-center gap-1 mt-3 text-sm text-muted-foreground">
                    <LucideCheckCn Class="h-4 w-4" Size="16" />
                    Reaction added
                </div>
            </div>
        }
        else
        {
            <div class="space-y-3">
                @* Recent *@
                <div>
                    <p class="text-xs text-muted-foreground mb-2">Recent</p>
                    <div class="flex gap-1">
                        @foreach (var emoji in _recentReactions)
                        {
                            <button type="button"
                                    class="h-10 w-10 rounded-md hover:bg-muted flex items-center justify-center text-xl transition-colors"
                                    @onclick="@(() => HandleSelect(emoji))">
                                @emoji
                            </button>
                        }
                    </div>
                </div>

                @* All reactions *@
                <div>
                    <p class="text-xs text-muted-foreground mb-2">All</p>
                    <div class="grid grid-cols-6 gap-1">
                        @foreach (var reaction in _reactions)
                        {
                            <button type="button"
                                    aria-label="@reaction.Label"
                                    class="h-10 w-10 rounded-md flex items-center justify-center text-xl transition-colors hover:bg-muted"
                                    @onclick="@(() => HandleSelect(reaction.Emoji))">
                                @reaction.Emoji
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record Reaction(string Emoji, string Label);

    private static readonly Reaction[] _reactions =
    [
        new("\U0001F44D", "thumbs up"), new("\u2764\uFE0F", "heart"), new("\U0001F602", "laugh"),
        new("\U0001F62E", "wow"), new("\U0001F622", "sad"), new("\U0001F389", "celebrate"),
        new("\U0001F525", "fire"), new("\U0001F440", "eyes"), new("\U0001F680", "rocket"),
        new("\U0001F4AF", "hundred"), new("\U0001F44F", "clap"), new("\U0001F64C", "raised hands")
    ];

    private static readonly string[] _recentReactions = ["\U0001F44D", "\u2764\uFE0F", "\U0001F389"];

    private bool _open;
    private string? _selected;

    private async Task HandleSelect(string emoji)
    {
        _selected = emoji;
        StateHasChanged();
        await Task.Delay(400);
        _open = false;
        await Task.Delay(200);
        _selected = null;
    }
}
