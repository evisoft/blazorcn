@* ========================================
   Block: dialog-upgrade-plan
   Title: Dialog Upgrade Plan
   Description: Upgrade plan dialog with pricing tier comparison cards, feature lists, and billing toggle between monthly and annual
   Long Description: Privacy preferences with toggles
   Dependencies: ButtonCn, CardCn, CardContentCn, CardHeaderCn, CardTitleCn, DialogCn, DialogContentCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideCheckCn, LucideSparklesCn, SwitchCn
   Source: original/blocks/dialog/dialog-upgrade-plan.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn>
                <LucideSparklesCn Class="mr-2 h-4 w-4" Size="16" />
                Upgrade Plan
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 600px;">
        <DialogHeaderCn>
            <DialogTitleCn>Upgrade your plan</DialogTitleCn>
            <p class="text-sm text-muted-foreground">
                Choose the plan that works best for you and your team.
            </p>
        </DialogHeaderCn>

        <div class="flex items-center justify-center gap-3 py-4">
            <LabelCn Class="@Cn.Merge("text-sm", !_annual ? "text-foreground font-medium" : "")">
                Monthly
            </LabelCn>
            <SwitchCn Checked="@_annual" CheckedChanged="@((bool v) => _annual = v)" />
            <LabelCn Class="@Cn.Merge("text-sm", _annual ? "text-foreground font-medium" : "")">
                Annual
                <span class="ml-1.5 text-xs text-primary font-medium">Save 20%</span>
            </LabelCn>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            @foreach (var plan in _plans)
            {
                <CardCn Class="@Cn.Merge("relative", plan.Popular ? "border-primary shadow-md" : "")">
                    @if (plan.Popular)
                    {
                        <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                            <span class="bg-primary text-primary-foreground text-xs font-medium px-3 py-1 rounded-full">
                                Most Popular
                            </span>
                        </div>
                    }
                    <CardHeaderCn Class="pb-4">
                        <CardTitleCn Class="text-lg">@plan.Name</CardTitleCn>
                        <p class="text-sm text-muted-foreground">@plan.Description</p>
                        <div class="pt-2">
                            <span class="text-3xl font-bold">
                                $@(_annual ? plan.AnnualPrice : plan.MonthlyPrice)
                            </span>
                            <span class="text-muted-foreground">/month</span>
                            <p class="text-xs text-muted-foreground mt-1 h-4">
                                @if (_annual)
                                {
                                    @($"Billed annually (${plan.AnnualPrice * 12}/year)")
                                }
                            </p>
                        </div>
                    </CardHeaderCn>
                    <CardContentCn Class="space-y-4">
                        <ul class="space-y-2">
                            @foreach (var feature in plan.Features)
                            {
                                <li class="flex items-center gap-2 text-sm">
                                    <LucideCheckCn Class="h-4 w-4 text-primary flex-shrink-0" Size="16" />
                                    @feature
                                </li>
                            }
                        </ul>
                        <ButtonCn Class="w-full" Variant="@(plan.Popular ? ButtonVariant.Default : ButtonVariant.Outline)">
                            @(plan.Popular ? "Upgrade to Business" : "Upgrade to Pro")
                        </ButtonCn>
                    </CardContentCn>
                </CardCn>
            }
        </div>

        <p class="text-xs text-center text-muted-foreground pt-2">
            All plans include a 14-day free trial. Cancel anytime.
        </p>
    </DialogContentCn>
</DialogCn>

@code {
    private record Plan(string Name, int MonthlyPrice, int AnnualPrice, string Description, string[] Features, bool Popular);

    private static readonly Plan[] _plans =
    [
        new("Pro", 12, 9, "For individuals and small teams",
            ["Up to 10 team members", "20GB storage", "Priority support", "Advanced analytics", "Custom integrations"],
            false),
        new("Business", 29, 24, "For growing businesses",
            ["Unlimited team members", "100GB storage", "24/7 phone support", "Advanced analytics", "Custom integrations", "SSO authentication", "Audit logs"],
            true),
    ];

    private bool _open;
    private bool _annual = true;
}
