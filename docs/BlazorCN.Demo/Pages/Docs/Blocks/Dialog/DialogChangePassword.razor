@* ========================================
   Block: dialog-change-password
   Title: Dialog Change Password
   Description: Change password dialog with current password verification, new password input, strength indicator, and confirmation matching
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, ProgressCn, LucideCheckCn, LucideCircleAlertCn, LucideEyeCn, LucideEyeOffCn, LucideLoader2Cn, LucideLockCn, LucideShieldCheckCn, LucideXCn
   Source: original/blocks/dialog/dialog-change-password.tsx
   ======================================== *@

@using System.Text.RegularExpressions

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideLockCn Class="mr-2 h-4 w-4" Size="16" />
                Change Password
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideLockCn Class="h-5 w-5" Size="20" />
                Change Password
            </DialogTitleCn>
            <DialogDescriptionCn>Enter your current password and choose a new one.</DialogDescriptionCn>
        </DialogHeaderCn>

        @if (_isSuccess)
        {
            <div class="flex flex-col items-center py-8 text-center">
                <div class="rounded-full border-2 border-primary p-3 mb-4">
                    <LucideShieldCheckCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <h3 class="font-semibold">Password Changed</h3>
                <p class="text-sm text-muted-foreground mt-1">Your password has been updated successfully.</p>
                <ButtonCn Class="mt-4" @onclick="HandleClose">Done</ButtonCn>
            </div>
        }
        else
        {
            <div class="space-y-4 py-4">
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="flex items-center gap-2 text-sm text-destructive">
                        <LucideCircleAlertCn Class="h-4 w-4" Size="16" />
                        @_error
                    </div>
                }

                @* Current Password *@
                <div class="space-y-2">
                    <LabelCn For="current-password">Current Password</LabelCn>
                    <div class="relative">
                        <InputCn Class="pr-10" Id="current-password"
                                 Type="@(_showCurrent ? "text" : "password")"
                                 Value="@_currentPassword" ValueChanged="@((string v) => _currentPassword = v)"
                                 Placeholder="Enter current password" />
                        <ButtonCn Class="absolute right-0 top-0 h-full px-3 hover:bg-transparent"
                                  @onclick="@(() => _showCurrent = !_showCurrent)" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Hide">
                            @if (_showCurrent)
                            { <LucideEyeOffCn Class="h-4 w-4 text-muted-foreground" Size="16" /> }
                            else
                            { <LucideEyeCn Class="h-4 w-4 text-muted-foreground" Size="16" /> }
                        </ButtonCn>
                    </div>
                </div>

                @* New Password *@
                <div class="space-y-2">
                    <LabelCn For="new-password">New Password</LabelCn>
                    <div class="relative">
                        <InputCn Class="pr-10" Id="new-password"
                                 Type="@(_showNew ? "text" : "password")"
                                 Value="@_newPassword" ValueChanged="@((string v) => _newPassword = v)"
                                 Placeholder="Enter new password" />
                        <ButtonCn Class="absolute right-0 top-0 h-full px-3 hover:bg-transparent"
                                  @onclick="@(() => _showNew = !_showNew)" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Hide">
                            @if (_showNew)
                            { <LucideEyeOffCn Class="h-4 w-4 text-muted-foreground" Size="16" /> }
                            else
                            { <LucideEyeCn Class="h-4 w-4 text-muted-foreground" Size="16" /> }
                        </ButtonCn>
                    </div>

                    @if (!string.IsNullOrEmpty(_newPassword))
                    {
                        <div class="space-y-2">
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">Strength:</span>
                                <span class="@StrengthColor">@StrengthLabel</span>
                            </div>
                            <ProgressCn Class="h-1.5" Value="@StrengthProgress" aria-label="Progress" />
                        </div>
                    }
                </div>

                @* Confirm Password *@
                <div class="space-y-2">
                    <LabelCn For="confirm-password">Confirm New Password</LabelCn>
                    <div class="relative">
                        <InputCn Class="@Cn.Merge("pr-10", !string.IsNullOrEmpty(_confirmPassword) && !PasswordsMatch ? "border-destructive" : "")"
                                 Id="confirm-password"
                                 Type="@(_showConfirm ? "text" : "password")"
                                 Value="@_confirmPassword" ValueChanged="@((string v) => _confirmPassword = v)"
                                 Placeholder="Confirm new password" />
                        <ButtonCn Class="absolute right-0 top-0 h-full px-3 hover:bg-transparent"
                                  @onclick="@(() => _showConfirm = !_showConfirm)" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Hide">
                            @if (_showConfirm)
                            { <LucideEyeOffCn Class="h-4 w-4 text-muted-foreground" Size="16" /> }
                            else
                            { <LucideEyeCn Class="h-4 w-4 text-muted-foreground" Size="16" /> }
                        </ButtonCn>
                    </div>
                    @if (!string.IsNullOrEmpty(_confirmPassword))
                    {
                        <p class="@Cn.Merge("text-xs flex items-center gap-1", PasswordsMatch ? "text-primary" : "text-destructive")">
                            @if (PasswordsMatch)
                            {
                                <LucideCheckCn Class="h-3 w-3" Size="12" />
                                <span>Passwords match</span>
                            }
                            else
                            {
                                <LucideXCn Class="h-3 w-3" Size="12" />
                                <span>Passwords do not match</span>
                            }
                        </p>
                    }
                </div>

                @* Requirements *@
                <div class="rounded-lg border p-3 space-y-2">
                    <p class="text-xs font-medium text-muted-foreground">Requirements:</p>
                    <div class="grid grid-cols-1 gap-1">
                        @foreach (var req in _requirements)
                        {
                            var isMet = req.Test(_newPassword);
                            <div class="@Cn.Merge("text-xs flex items-center gap-2", isMet ? "text-primary" : "text-muted-foreground")">
                                @if (isMet)
                                { <LucideCheckCn Class="h-3 w-3" Size="12" /> }
                                else
                                { <LucideXCn Class="h-3 w-3" Size="12" /> }
                                @req.Label
                            </div>
                        }
                    </div>
                </div>
            </div>

            <DialogFooterCn>
                <ButtonCn @onclick="HandleClose" Variant="ButtonVariant.Outline">Cancel</ButtonCn>
                <ButtonCn Disabled="@(!CanSubmit || _isSubmitting)" @onclick="HandleSubmit">
                    @if (_isSubmitting)
                    {
                        <LucideLoaderCircleCn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                        <span>Updating...</span>
                    }
                    else
                    {
                        <LucideLockCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Update Password</span>
                    }
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _showCurrent, _showNew, _showConfirm;
    private bool _isSubmitting;
    private bool _isSuccess;
    private string _error = "";

    private record Requirement(string Id, string Label, Func<string, bool> Test);

    private static readonly Requirement[] _requirements =
    [
        new("length", "At least 8 characters", p => p.Length >= 8),
        new("uppercase", "One uppercase letter", p => Regex.IsMatch(p, "[A-Z]")),
        new("lowercase", "One lowercase letter", p => Regex.IsMatch(p, "[a-z]")),
        new("number", "One number", p => Regex.IsMatch(p, "[0-9]")),
        new("special", "One special character", p => Regex.IsMatch(p, @"[!@#$%^&*(),.?"":{}|<>]")),
    ];

    private int MetCount => _requirements.Count(r => r.Test(_newPassword));
    private bool AllRequirementsMet => MetCount == _requirements.Length;
    private bool PasswordsMatch => _newPassword == _confirmPassword && _confirmPassword.Length > 0;
    private bool CanSubmit => !string.IsNullOrEmpty(_currentPassword) && AllRequirementsMet && PasswordsMatch;

    private string StrengthLabel => MetCount <= 2 ? "Weak" : MetCount <= 4 ? "Medium" : "Strong";
    private string StrengthColor => MetCount <= 2 ? "text-destructive" : MetCount <= 4 ? "text-yellow-500" : "text-primary";
    private double StrengthProgress => MetCount <= 2 ? 33 : MetCount <= 4 ? 66 : 100;

    private async Task HandleSubmit()
    {
        if (!CanSubmit) return;
        _error = "";
        _isSubmitting = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isSubmitting = false;
        _isSuccess = true;
    }

    private void HandleClose()
    {
        _open = false;
        _currentPassword = _newPassword = _confirmPassword = "";
        _isSuccess = false;
        _error = "";
    }
}
