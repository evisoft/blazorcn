@* ========================================
   Block: dialog-cancel-subscription
   Title: Dialog Cancel Subscription
   Description: Subscription cancellation dialog with reason selection, retention offers, feedback collection, and final confirmation
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, RadioGroupCn, RadioGroupItemCn, SeparatorCn, TextareaCn, LucideArrowRightCn, LucideCheckCn, LucideGiftCn, LucideHeartCn, LucidePauseCn, LucideTriangleAlertCn, LucideXCn
   Source: original/blocks/dialog/dialog-cancel-subscription.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideXCn Class="mr-2 h-4 w-4" Size="16" />
                Cancel Subscription
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        @if (_cancelled)
        {
            <DialogHeaderCn Class="text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-muted mb-4">
                    <LucideCheckCn Class="h-6 w-6" Size="24" />
                </div>
                <DialogTitleCn>Subscription Cancelled</DialogTitleCn>
                <DialogDescriptionCn Class="space-y-2">
                    <p>Your subscription has been cancelled. You'll have access until <strong>January 15, 2025</strong>.</p>
                    <p class="text-xs">Changed your mind? You can reactivate anytime from your account settings.</p>
                </DialogDescriptionCn>
            </DialogHeaderCn>
            <DialogFooterCn>
                <ButtonCn Class="w-full" @onclick="HandleClose">Done</ButtonCn>
            </DialogFooterCn>
        }
        else
        {
            @if (_step == "reason")
            {
                <DialogHeaderCn>
                    <DialogTitleCn>We're sorry to see you go</DialogTitleCn>
                    <DialogDescriptionCn>Help us improve by telling us why you're cancelling.</DialogDescriptionCn>
                </DialogHeaderCn>
                <div class="py-4">
                    <RadioGroupCn Value="@_reason" ValueChanged="@(v => _reason = v)">
                        <div class="space-y-2">
                            @foreach (var option in _cancellationReasons)
                            {
                                <div class="flex items-center space-x-3 rounded-lg border p-3 hover:bg-muted cursor-pointer"
                                     @onclick="@(() => _reason = option.Id)">
                                    <RadioGroupItemCn Id="@option.Id" Value="@option.Id" />
                                    <LabelCn Class="flex-1 cursor-pointer" For="@option.Id">@option.Label</LabelCn>
                                </div>
                            }
                        </div>
                    </RadioGroupCn>
                </div>
                <DialogFooterCn Class="gap-2 sm:gap-0">
                    <ButtonCn @onclick="HandleClose" Variant="ButtonVariant.Outline">Never mind</ButtonCn>
                    <ButtonCn Disabled="@(string.IsNullOrEmpty(_reason))" @onclick="HandleNext">
                        Continue
                        <LucideArrowRightCn Class="ml-2 h-4 w-4" Size="16" />
                    </ButtonCn>
                </DialogFooterCn>
            }

            @if (_step == "offer")
            {
                <DialogHeaderCn>
                    <DialogTitleCn>Before you go...</DialogTitleCn>
                    <DialogDescriptionCn>We'd love to keep you! Here's a special offer.</DialogDescriptionCn>
                </DialogHeaderCn>
                <div class="py-4 space-y-4">
                    @if (SelectedReason?.Offer == "discount")
                    {
                        <div class="rounded-lg border-2 border-primary bg-primary/5 p-4 space-y-3">
                            <div class="flex items-center gap-2">
                                <LucideGiftCn Class="h-5 w-5 text-primary" Size="20" />
                                <span class="font-semibold">Special Offer</span>
                                <BadgeCn Class="ml-auto">50% OFF</BadgeCn>
                            </div>
                            <p class="text-sm text-muted-foreground">Stay with us and get 50% off your next 3 months. That's just $6/month instead of $12.</p>
                            <ButtonCn Class="w-full" @onclick="HandleClose">
                                <LucideHeartCn Class="mr-2 h-4 w-4" Size="16" />
                                Accept Offer &amp; Stay
                            </ButtonCn>
                        </div>
                    }
                    else if (SelectedReason?.Offer == "pause")
                    {
                        <div class="rounded-lg border-2 border-primary bg-primary/5 p-4 space-y-3">
                            <div class="flex items-center gap-2">
                                <LucidePauseCn Class="h-5 w-5 text-primary" Size="20" />
                                <span class="font-semibold">Take a Break</span>
                            </div>
                            <p class="text-sm text-muted-foreground">Not using it enough? Pause your subscription for up to 3 months instead of cancelling. Your data stays safe.</p>
                            <ButtonCn Class="w-full" @onclick="HandleClose">
                                <LucidePauseCn Class="mr-2 h-4 w-4" Size="16" />
                                Pause for 1 Month
                            </ButtonCn>
                        </div>
                    }
                    else
                    {
                        <div class="rounded-lg border bg-muted/50 p-4 space-y-3">
                            <div class="flex items-center gap-2">
                                <LucideTriangleAlertCn Class="h-5 w-5 text-amber-500" Size="20" />
                                <span class="font-semibold">We want to help</span>
                            </div>
                            <p class="text-sm text-muted-foreground">
                                @(SelectedReason?.Offer == "support" ? "Our support team can help resolve technical issues. Would you like to chat with us first?"
                                    : SelectedReason?.Offer == "compare" ? "We'd love to understand what's working better elsewhere. Your feedback helps us improve."
                                    : "We're constantly improving. Tell us what features you need and we'll prioritize them.")
                            </p>
                            <ButtonCn Class="w-full" @onclick="HandleClose" Variant="ButtonVariant.Outline">Talk to Us First</ButtonCn>
                        </div>
                    }
                    <SeparatorCn />
                    <ButtonCn Class="w-full text-muted-foreground" @onclick="HandleNext" Variant="ButtonVariant.Ghost">
                        No thanks, continue cancelling
                    </ButtonCn>
                </div>
            }

            @if (_step == "feedback")
            {
                <DialogHeaderCn>
                    <DialogTitleCn>One last thing</DialogTitleCn>
                    <DialogDescriptionCn>Your feedback helps us build a better product.</DialogDescriptionCn>
                </DialogHeaderCn>
                <div class="py-4 space-y-4">
                    <div class="space-y-2">
                        <LabelCn For="feedback">What could we have done better? (Optional)</LabelCn>
                        <TextareaCn Class="min-h-[100px] resize-none" Id="feedback" Value="@_feedback" ValueChanged="@((string v) => _feedback = v)"
                                    Placeholder="Tell us what would have made you stay..." />
                    </div>
                </div>
                <DialogFooterCn Class="gap-2 sm:gap-0">
                    <ButtonCn @onclick="@(() => _step = "offer")" Variant="ButtonVariant.Outline">Back</ButtonCn>
                    <ButtonCn @onclick="HandleNext">
                        Continue
                        <LucideArrowRightCn Class="ml-2 h-4 w-4" Size="16" />
                    </ButtonCn>
                </DialogFooterCn>
            }

            @if (_step == "confirm")
            {
                <DialogHeaderCn>
                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-destructive/10">
                            <LucideTriangleAlertCn Class="h-5 w-5 text-destructive" Size="20" />
                        </div>
                        <div>
                            <DialogTitleCn>Confirm Cancellation</DialogTitleCn>
                            <DialogDescriptionCn>This action cannot be undone.</DialogDescriptionCn>
                        </div>
                    </div>
                </DialogHeaderCn>
                <div class="py-4">
                    <div class="rounded-lg border bg-muted/50 p-4 space-y-2 text-sm">
                        <p><strong>What happens next:</strong></p>
                        <ul class="list-disc list-inside space-y-1 text-muted-foreground">
                            <li>Your access continues until January 15, 2025</li>
                            <li>You won't be charged again</li>
                            <li>Your data will be retained for 30 days</li>
                            <li>You can reactivate anytime</li>
                        </ul>
                    </div>
                </div>
                <DialogFooterCn Class="gap-2 sm:gap-0">
                    <ButtonCn @onclick="HandleClose" Variant="ButtonVariant.Outline">Keep Subscription</ButtonCn>
                    <ButtonCn @onclick="@(() => _cancelled = true)" Variant="ButtonVariant.Destructive">Cancel Subscription</ButtonCn>
                </DialogFooterCn>
            }
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _step = "reason";
    private string _reason = "";
    private string _feedback = "";
    private bool _cancelled;

    private record CancellationReason(string Id, string Label, string Offer);

    private static readonly CancellationReason[] _cancellationReasons =
    [
        new("expensive", "Too expensive", "discount"),
        new("not-using", "Not using it enough", "pause"),
        new("missing-features", "Missing features I need", "feedback"),
        new("alternative", "Switching to another service", "compare"),
        new("technical", "Technical issues", "support"),
        new("other", "Other reason", "feedback"),
    ];

    private CancellationReason? SelectedReason => _cancellationReasons.FirstOrDefault(r => r.Id == _reason);

    private void HandleNext()
    {
        _step = _step switch
        {
            "reason" when !string.IsNullOrEmpty(_reason) => "offer",
            "offer" => "feedback",
            "feedback" => "confirm",
            _ => _step,
        };
    }

    private void HandleClose()
    {
        _open = false;
        _step = "reason";
        _reason = "";
        _feedback = "";
        _cancelled = false;
    }
}
