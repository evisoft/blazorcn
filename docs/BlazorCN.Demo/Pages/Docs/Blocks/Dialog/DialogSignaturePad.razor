@* ========================================
   Block: dialog-signature-pad
   Title: Dialog Signature Pad
   Description: Digital signature pad dialog with drawing canvas, stroke customization, clear/undo options, and signature confirmation
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCheckCn, LucidePenCn, LucidePenToolCn, LucideTrash2Cn, LucideTypeCn, LucideUndo2Cn, SliderCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn
   Source: original/blocks/dialog/dialog-signature-pad.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucidePenToolCn Class="mr-2 h-4 w-4" Size="16" />
                Sign Document
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        @if (_signed)
        {
            <div class="flex flex-col items-center justify-center py-6 text-center">
                <LucideCheckCn Class="h-8 w-8 text-primary" Size="32" />
                <h3 class="mt-4 text-lg font-semibold">Signature Captured</h3>
                <p class="mt-1 text-sm text-muted-foreground">Your signature has been recorded.</p>
                <div class="mt-4 w-full rounded-lg border p-3">
                    @if (_activeTab == "draw")
                    {
                        <p class="text-sm text-muted-foreground text-center py-2">[Signature drawn on canvas]</p>
                    }
                    else
                    {
                        <p class="text-2xl py-2" style="font-family: cursive;">
                            @_typedName
                        </p>
                    }
                </div>
                <ButtonCn Class="mt-6" @onclick="HandleClose">
                    Done
                </ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn>Add Your Signature</DialogTitleCn>
                <DialogDescriptionCn>Draw your signature or type your name.</DialogDescriptionCn>
            </DialogHeaderCn>

            <TabsCn Class="w-full" Value="@_activeTab">
                <TabsListCn Class="grid w-full grid-cols-2">
                    <TabsTriggerCn Value="draw" @onclick="@(() => _activeTab = "draw")">
                        <LucidePenCn Class="mr-2 h-4 w-4" Size="16" />
                        Draw
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="type" @onclick="@(() => _activeTab = "type")">
                        <LucideTypeCn Class="mr-2 h-4 w-4" Size="16" />
                        Type
                    </TabsTriggerCn>
                </TabsListCn>

                <TabsContentCn Class="space-y-3 mt-4" Value="draw">
                    <div class="relative h-32 rounded-lg border-2 border-dashed cursor-crosshair touch-none bg-muted/20">
                        @if (!_hasDrawnSignature)
                        {
                            <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                                <p class="text-sm text-muted-foreground">Sign here</p>
                            </div>
                        }
                        else
                        {
                            <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                                <p class="text-sm text-muted-foreground">[Canvas signature]</p>
                            </div>
                        }
                    </div>

                    <div class="flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2 flex-1">
                            <LabelCn Class="text-xs text-muted-foreground">Stroke</LabelCn>
                            <SliderCn
                                Class="flex-1"
                                Max="5"
                                Min="1"
                                Step="0.5"
                                Value="@((double)_strokeWidth)"
                                ValueChanged="@(v => _strokeWidth = (int)v)" />
                        </div>
                        <div class="flex gap-1">
                            <ButtonCn
                                Class="h-8 w-8"
                                Disabled="@(!_hasDrawnSignature)"
                                @onclick="HandleUndo"
                                Size="ButtonSize.Icon"
                                Variant="ButtonVariant.Outline">
                                <LucideUndo2Cn Class="h-4 w-4" Size="16" />
                            </ButtonCn>
                            <ButtonCn
                                Class="h-8 w-8"
                                Disabled="@(!_hasDrawnSignature)"
                                @onclick="HandleClear"
                                Size="ButtonSize.Icon"
                                Variant="ButtonVariant.Outline">
                                <LucideTrash2Cn Class="h-4 w-4" Size="16" />
                            </ButtonCn>
                        </div>
                    </div>
                </TabsContentCn>

                <TabsContentCn Class="space-y-3 mt-4" Value="type">
                    <div class="space-y-2">
                        <LabelCn For="typed-signature">Full Name</LabelCn>
                        <InputCn
                            Id="typed-signature"
                            Placeholder="Enter your name"
                            Value="@_typedName"
                            ValueChanged="@(v => _typedName = v)" />
                    </div>

                    <div class="rounded-lg border p-3 h-20 flex items-center justify-center">
                        @if (!string.IsNullOrEmpty(_typedName))
                        {
                            <p class="text-2xl" style="font-family: cursive;">
                                @_typedName
                            </p>
                        }
                        else
                        {
                            <p class="text-sm text-muted-foreground">Preview</p>
                        }
                    </div>
                </TabsContentCn>
            </TabsCn>

            <DialogFooterCn>
                <ButtonCn @onclick="HandleClose" Variant="ButtonVariant.Outline">
                    Cancel
                </ButtonCn>
                <ButtonCn Disabled="@(!CanSubmit)" @onclick="HandleSign">
                    Apply
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _signed;
    private string _activeTab = "draw";
    private string _typedName = "";
    private int _strokeWidth = 2;
    private bool _hasDrawnSignature;
    private int _strokeCount;

    private bool HasTypedSignature => _typedName.Trim().Length >= 2;
    private bool CanSubmit => _activeTab == "draw" ? _hasDrawnSignature : HasTypedSignature;

    private void HandleUndo()
    {
        _strokeCount = Math.Max(0, _strokeCount - 1);
        _hasDrawnSignature = _strokeCount > 0;
    }

    private void HandleClear()
    {
        _strokeCount = 0;
        _hasDrawnSignature = false;
    }

    private void HandleSign()
    {
        _signed = true;
    }

    private void HandleClose()
    {
        _open = false;
        _signed = false;
        _hasDrawnSignature = false;
        _strokeCount = 0;
        _typedName = "";
        _activeTab = "draw";
    }
}
