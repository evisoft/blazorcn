@* ========================================
   Block: dialog-focus-mode
   Title: Dialog Focus Mode
   Description: Focus mode dialog with distraction blocking, session timer, and break reminders
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideFocusCn, LucidePlayCn, SwitchCn
   Source: original/blocks/dialog/dialog-focus-mode.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideFocusCn Class="mr-2 h-4 w-4" Size="16" />
                Focus Mode
            </DialogTriggerCn>
    </div>
    <DialogContentCn Style="max-width: 384px">
        @if (_started)
        {
            <div class="flex flex-col items-center justify-center py-8 text-center">
                <div class="h-16 w-16 rounded-full bg-primary/10 flex items-center justify-center">
                    <LucideFocusCn Class="h-8 w-8 text-primary" Size="32" />
                </div>
                <h3 class="mt-4 text-lg font-medium">Focus Mode Active</h3>
                <p class="mt-1 text-sm text-muted-foreground">@_duration minute session started</p>
                <p class="text-xs text-muted-foreground mt-1">
                    @(_blockNotifs ? "Notifications blocked" : "Notifications enabled")
                </p>
                <ButtonCn Class="mt-6" Variant="ButtonVariant.Outline" @onclick="HandleClose">
                    End Session
                </ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn>Start Focus Session</DialogTitleCn>
                <DialogDescriptionCn>Block distractions and concentrate</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="py-4 space-y-4">
                <div class="space-y-2">
                    <LabelCn Class="text-sm">Duration</LabelCn>
                    <div class="grid grid-cols-3 gap-2">
                        @foreach (var d in _durations)
                        {
                            <button type="button"
                                    class="@Cn.Merge("py-2 rounded-md border text-sm font-medium transition-colors", _duration == d.Value ? "border-primary bg-primary/5" : "hover:border-muted-foreground/50")"
                                    @onclick="@(() => _duration = d.Value)">
                                @d.Label
                            </button>
                        }
                    </div>
                </div>

                <div class="flex items-center justify-between">
                    <LabelCn Class="text-sm" For="notifs">
                        Block notifications
                    </LabelCn>
                    <SwitchCn Checked="_blockNotifs" CheckedChanged="@((bool v) => _blockNotifs = v)" id="notifs" />
                </div>
            </div>

            <DialogFooterCn>
                <ButtonCn Class="w-full" @onclick="@(() => _started = true)">
                    <LucidePlayCn Class="mr-2 h-4 w-4" Size="16" />
                    Start Focus
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record DurationOption(int Value, string Label);

    private static readonly DurationOption[] _durations =
    [
        new(25, "25 min"),
        new(50, "50 min"),
        new(90, "90 min"),
    ];

    private bool _open;
    private int _duration = 25;
    private bool _blockNotifs = true;
    private bool _started;

    private void HandleClose()
    {
        _open = false;
        _started = false;
    }
}
