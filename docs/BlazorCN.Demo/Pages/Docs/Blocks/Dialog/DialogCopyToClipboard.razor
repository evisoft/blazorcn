@* ========================================
   Block: dialog-copy-to-clipboard
   Title: Dialog Copy To Clipboard
   Description: Copy to clipboard dialog with multiple content types, code syntax highlighting, one-click copy, and success feedback
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideBracesCn, LucideCheckCn, LucideCodeCn, LucideCopyCn, LucideFileTextCn, LucideLinkCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn
   Source: original/blocks/dialog/dialog-copy-to-clipboard.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideCopyCn Class="mr-2 h-4 w-4" Size="16" />
                Copy to Clipboard
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn>Copy to Clipboard</DialogTitleCn>
            <DialogDescriptionCn>Select content type and copy to your clipboard.</DialogDescriptionCn>
        </DialogHeaderCn>

        <TabsCn Value="@_activeTab" ValueChanged="@((string v) => _activeTab = v)">
            <TabsListCn Class="grid w-full grid-cols-4">
                <TabsTriggerCn Class="text-xs" Value="text">
                    <LucideFileTextCn Class="mr-1.5 h-3.5 w-3.5" Size="14" />
                    Text
                </TabsTriggerCn>
                <TabsTriggerCn Class="text-xs" Value="code">
                    <LucideCodeCn Class="mr-1.5 h-3.5 w-3.5" Size="14" />
                    Code
                </TabsTriggerCn>
                <TabsTriggerCn Class="text-xs" Value="url">
                    <LucideLinkCn Class="mr-1.5 h-3.5 w-3.5" Size="14" />
                    URL
                </TabsTriggerCn>
                <TabsTriggerCn Class="text-xs" Value="json">
                    <LucideBracesCn Class="mr-1.5 h-3.5 w-3.5" Size="14" />
                    JSON
                </TabsTriggerCn>
            </TabsListCn>

            @foreach (var content in _copyContents)
            {
                <TabsContentCn Value="@content.Id">
                    <div class="@Cn.Merge("h-[200px] overflow-auto rounded-lg border p-4 text-sm", content.Id is "code" or "json" ? "font-mono text-xs" : "")">
                        <pre class="@(content.Id is "url" or "text" ? "whitespace-pre-wrap break-all" : "")">@content.Content</pre>
                    </div>
                </TabsContentCn>
            }
        </TabsCn>

        <DialogFooterCn>
            <ButtonCn Class="w-full" @onclick="HandleCopy">
                @if (_copiedId == _activeTab)
                {
                    <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                    <span>Copied!</span>
                }
                else
                {
                    <LucideCopyCn Class="mr-2 h-4 w-4" Size="16" />
                    <span>Copy @(_copyContents.FirstOrDefault(c => c.Id == _activeTab)?.Label ?? "")</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _activeTab = "code";
    private string? _copiedId;

    private record CopyContent(string Id, string Label, string Content);

    private static readonly CopyContent[] _copyContents =
    [
        new("text", "Text", "Welcome to our platform! Get started by creating your first project and inviting team members to collaborate."),
        new("code", "Code", "import { useState } from \"react\";\n\nexport function useCounter(initial = 0) {\n  const [count, setCount] = useState(initial);\n  \n  const increment = () => setCount(c => c + 1);\n  const decrement = () => setCount(c => c - 1);\n  const reset = () => setCount(initial);\n  \n  return { count, increment, decrement, reset };\n}"),
        new("url", "URL", "https://example.com/share/abc123?ref=clipboard&utm_source=app"),
        new("json", "JSON", "{\n  \"name\": \"Project Alpha\",\n  \"version\": \"1.0.0\",\n  \"description\": \"A sample project configuration\",\n  \"settings\": {\n    \"theme\": \"dark\",\n    \"notifications\": true,\n    \"autoSave\": true\n  },\n  \"tags\": [\"react\", \"typescript\", \"tailwind\"]\n}"),
    ];

    private async Task HandleCopy()
    {
        _copiedId = _activeTab;
        StateHasChanged();
        await Task.Delay(2000);
        _copiedId = null;
    }
}
