@* ========================================
   Block: dialog-confirm-delete
   Title: Dialog Confirm Delete
   Description: Confirm delete dialog with item name verification, destructive action warning, and type-to-confirm safety
   Dependencies: AlertDialogCn, AlertDialogContentCn, AlertDialogDescriptionCn, AlertDialogFooterCn, AlertDialogHeaderCn, AlertDialogTitleCn, AlertDialogTriggerCn, ButtonCn, InputCn, LabelCn, LucideLoader2Cn, LucideTrash2Cn, LucideTriangleAlertCn
   Source: original/blocks/dialog/dialog-confirm-delete.tsx
   ======================================== *@

<AlertDialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <AlertDialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Destructive">
                <LucideTrash2Cn Class="mr-2 h-4 w-4" Size="16" />
                Delete @_itemType
            </ButtonCn>
        </AlertDialogTriggerCn>
    </div>
    <AlertDialogContentCn>
        <AlertDialogHeaderCn>
            <AlertDialogTitleCn Class="flex items-center gap-2">
                <LucideTriangleAlertCn Class="h-5 w-5 text-destructive" Size="20" />
                Delete @_itemType?
            </AlertDialogTitleCn>
            <AlertDialogDescriptionCn Class="space-y-3">
                <span class="block">
                    This action cannot be undone. This will permanently delete
                    <span class="font-semibold text-foreground">@_itemName</span> and remove all
                    associated data from our servers.
                </span>
                <span class="block text-sm">
                    Please type
                    <span class="font-mono font-semibold text-foreground">@_itemName</span> to
                    confirm.
                </span>
            </AlertDialogDescriptionCn>
        </AlertDialogHeaderCn>

        <div class="space-y-2 py-2">
            <LabelCn Class="sr-only" For="confirm-name">
                Type @_itemName to confirm
            </LabelCn>
            <InputCn
                Class="font-mono"
                Id="confirm-name"
                Placeholder="@_itemName"
                Value="@_confirmText"
                ValueChanged="@((string v) => _confirmText = v)" />
        </div>

        <AlertDialogFooterCn>
            <ButtonCn Disabled="@_isDeleting" Variant="ButtonVariant.Outline" @onclick="HandleCancel">
                Cancel
            </ButtonCn>
            <ButtonCn
                Disabled="@(!_isConfirmed || _isDeleting)"
                Variant="ButtonVariant.Destructive"
                @onclick="HandleDelete">
                @if (_isDeleting)
                {
                    <LucideLoader2Cn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    <span>Deleting...</span>
                }
                else
                {
                    <LucideTrash2Cn Class="mr-2 h-4 w-4" Size="16" />
                    <span>Delete @_itemType</span>
                }
            </ButtonCn>
        </AlertDialogFooterCn>
    </AlertDialogContentCn>
</AlertDialogCn>

@code {
    private bool _open;
    private string _confirmText = "";
    private bool _isDeleting;

    private static readonly string _itemName = "Production Database";
    private static readonly string _itemType = "database";

    private bool _isConfirmed => _confirmText == _itemName;

    private async Task HandleDelete()
    {
        _isDeleting = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isDeleting = false;
        _open = false;
        _confirmText = "";
    }

    private void HandleCancel()
    {
        _open = false;
        _confirmText = "";
    }
}
