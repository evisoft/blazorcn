@* ========================================
   Block: dialog-add-profile
   Title: Dialog Add Profile
   Description: Add writer profile dialog with avatar upload, image preview with remove option, author name and title inputs in split layout
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, ButtonCn, DialogCn, DialogContentCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucidePlusCn, LucideUserRoundCn, LucideXCn
   Source: original/blocks/dialog/dialog-add-profile.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn>Add Writer</ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-lg p-0 rounded-3xl gap-0">
        <DialogHeaderCn Class="border-b px-6 py-4">
            <DialogTitleCn Class="font-medium">Add a writer</DialogTitleCn>
        </DialogHeaderCn>

        <div class="grid grid-cols-1 md:grid-cols-5 px-6 pt-4 pb-6">
            <div class="flex flex-col items-center justify-center md:col-span-2">
                <div class="relative mb-2">
                    <AvatarCn Class="h-24 w-24 border-2 border-muted">
                        <AvatarFallbackCn>
                            <LucideUserRoundCn Class="text-muted-foreground" Size="52" />
                        </AvatarFallbackCn>
                    </AvatarCn>
                    <ButtonCn Class="absolute -top-0.5 -right-0.5 bg-accent rounded-full border-[3px] border-background h-8 w-8 hover:bg-accent"
                              Size="ButtonSize.Icon"
                              Variant="ButtonVariant.Ghost">
                        <LucidePlusCn Class="h-3 w-3 text-muted-foreground" Size="12" />
                        <span class="sr-only">Upload image</span>
                    </ButtonCn>
                </div>

                <p class="text-center font-medium">Upload Image</p>
                <p class="text-center text-sm text-muted-foreground">Max file size: 1MB</p>
                <ButtonCn Class="mt-2" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    Add Image
                </ButtonCn>
            </div>

            <div class="flex flex-col justify-between md:col-span-3">
                <div class="space-y-4">
                    <div class="space-y-1">
                        <LabelCn Class="flex items-center" For="author-name">
                            Author name <span class="text-primary">*</span>
                        </LabelCn>
                        <InputCn Id="author-name"
                                 Value="@_authorName"
                                 ValueChanged="@((string v) => _authorName = v)"
                                 Placeholder="Enter author name" />
                    </div>

                    <div class="space-y-1">
                        <div class="flex items-center">
                            <LabelCn For="title">Title</LabelCn>
                        </div>
                        <InputCn Id="title"
                                 Value="@_title"
                                 ValueChanged="@((string v) => _title = v)"
                                 Placeholder="e.g., Senior Writer" />
                    </div>
                </div>

                <div class="flex justify-end gap-2 mt-4">
                    <ButtonCn @onclick="@(() => _open = false)" Variant="ButtonVariant.Outline">
                        Cancel
                    </ButtonCn>
                    <ButtonCn Class="bg-foreground text-background hover:bg-foreground/90">
                        Save Changes
                    </ButtonCn>
                </div>
            </div>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _authorName = "";
    private string _title = "";
}
