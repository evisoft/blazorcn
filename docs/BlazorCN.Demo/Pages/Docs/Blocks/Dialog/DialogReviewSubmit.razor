@* ========================================
   Block: dialog-review-submit
   Title: Dialog Review Submit
   Description: Product or service review dialog with star rating, review text, and submit functionality
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideLoaderCn, LucideStarCn, TextareaCn
   Source: original/blocks/dialog/dialog-review-submit.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideStarCn Class="mr-2 h-4 w-4" Size="16" />
                Write a Review
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        <DialogHeaderCn>
            <DialogTitleCn>Write a Review</DialogTitleCn>
            <DialogDescriptionCn>Share your experience to help others.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            <div class="space-y-2">
                <LabelCn>Rating</LabelCn>
                <div class="flex gap-1">
                    @for (var i = 1; i <= 5; i++)
                    {
                        var star = i;
                        <button class="p-0.5" type="button"
                                @onclick="@(() => _rating = star)"
                                @onmouseenter="@(() => _hoverRating = star)"
                                @onmouseleave="@(() => _hoverRating = 0)">
                            <LucideStarCn Class="@Cn.Merge("h-7 w-7 transition-colors", star <= DisplayRating ? "fill-primary text-primary" : "text-muted-foreground/30")" Size="28" />
                        </button>
                    }
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn For="review-text">Your Review</LabelCn>
                <TextareaCn Class="min-h-[100px] resize-none" Id="review-text"
                            Placeholder="What did you like or dislike?"
                            Value="@_review" ValueChanged="@(v => _review = v)" />
            </div>
        </div>

        <DialogFooterCn>
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">Cancel</ButtonCn>
            <ButtonCn Disabled="@(!IsValid || _isSubmitting)" @onclick="HandleSubmit">
                @if (_isSubmitting)
                {
                    <LucideLoaderCn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    <span>Submitting...</span>
                }
                else
                {
                    <span>Submit</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private int _rating;
    private int _hoverRating;
    private string _review = "";
    private bool _isSubmitting;

    private int DisplayRating => _hoverRating > 0 ? _hoverRating : _rating;
    private bool IsValid => _rating > 0 && _review.Length >= 10;

    private async Task HandleSubmit()
    {
        if (!IsValid) return;
        _isSubmitting = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isSubmitting = false;
        _open = false;
        _rating = 0;
        _review = "";
    }
}
