@* ========================================
   Block: dialog-share-permissions
   Title: Dialog Share Permissions
   Description: Share permissions dialog with user search, role assignment dropdown, existing collaborators list, and access level management
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCheckCn, LucideCrownCn, LucideEyeCn, LucidePencilCn, LucideSearchCn, LucideShare2Cn, LucideUserPlusCn, LucideXCn, ScrollAreaCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn
   Source: original/blocks/dialog/dialog-share-permissions.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideShare2Cn Class="mr-2 h-4 w-4" Size="16" />
                Share &amp; Permissions
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        @if (_saved)
        {
            <DialogHeaderCn Class="text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 mb-4">
                    <LucideCheckCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <DialogTitleCn>Permissions Updated</DialogTitleCn>
                <DialogDescriptionCn>
                    @_collaborators.Count people have access to this item.
                </DialogDescriptionCn>
            </DialogHeaderCn>
            <DialogFooterCn>
                <ButtonCn Class="w-full" @onclick="HandleClose">
                    Done
                </ButtonCn>
            </DialogFooterCn>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn Class="flex items-center gap-2">
                    <LucideShare2Cn Class="h-5 w-5" Size="20" />
                    Share &amp; Permissions
                </DialogTitleCn>
                <DialogDescriptionCn>Manage who has access to this item.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-4 py-4">
                <div class="space-y-2">
                    <LabelCn>Add people</LabelCn>
                    <div class="flex gap-2">
                        <div class="relative flex-1">
                            <LucideSearchCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                            <InputCn
                                Class="pl-9"
                                Placeholder="Search by name or email..."
                                Value="@_search"
                                ValueChanged="@(v => { _search = v; _showResults = !string.IsNullOrEmpty(v); })" />
                            @if (_showResults && FilteredResults.Any())
                            {
                                <div class="absolute top-full left-0 right-0 mt-1 rounded-md border bg-popover shadow-md z-10">
                                    @foreach (var user in FilteredResults)
                                    {
                                        <button
                                            type="button"
                                            class="w-full flex items-center gap-3 px-3 py-2 hover:bg-muted transition-colors"
                                            @onclick="@(() => HandleAddUser(user))">
                                            <AvatarCn Class="h-8 w-8">
                                                <AvatarFallbackCn Class="text-xs">
                                                    @GetInitials(user.Name)
                                                </AvatarFallbackCn>
                                            </AvatarCn>
                                            <div class="text-left">
                                                <p class="text-sm font-medium">@user.Name</p>
                                                <p class="text-xs text-muted-foreground">@user.Email</p>
                                            </div>
                                            <LucideUserPlusCn Class="ml-auto h-4 w-4 text-muted-foreground" Size="16" />
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <SelectCn Value="@_newUserPermission" ValueChanged="@(v => _newUserPermission = v)">
                            <SelectTriggerCn Class="w-[110px]" aria-label="Permission for new people">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="viewer">
                                    <span class="flex items-center gap-2">
                                        <LucideEyeCn Class="h-3 w-3" Size="12" />
                                        Viewer
                                    </span>
                                </SelectItemCn>
                                <SelectItemCn Value="editor">
                                    <span class="flex items-center gap-2">
                                        <LucidePencilCn Class="h-3 w-3" Size="12" />
                                        Editor
                                    </span>
                                </SelectItemCn>
                                <SelectItemCn Value="admin">
                                    <span class="flex items-center gap-2">
                                        <LucideCrownCn Class="h-3 w-3" Size="12" />
                                        Admin
                                    </span>
                                </SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                </div>

                <div class="space-y-2">
                    <LabelCn>People with access</LabelCn>
                    <ScrollAreaCn Class="h-[180px] rounded-md border">
                        <div class="divide-y">
                            @foreach (var collaborator in _collaborators)
                            {
                                <div class="flex items-center gap-3 px-3 py-2">
                                    <AvatarCn Class="h-8 w-8">
                                        <AvatarFallbackCn Class="text-xs">
                                            @GetInitials(collaborator.Name)
                                        </AvatarFallbackCn>
                                    </AvatarCn>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-2">
                                            <p class="text-sm font-medium truncate">@collaborator.Name</p>
                                            @if (collaborator.IsOwner)
                                            {
                                                <BadgeCn Class="text-xs px-1.5 py-0" Variant="BadgeVariant.Secondary">
                                                    Owner
                                                </BadgeCn>
                                            }
                                        </div>
                                        <p class="text-xs text-muted-foreground truncate">
                                            @collaborator.Email
                                        </p>
                                    </div>
                                    @if (collaborator.IsOwner)
                                    {
                                        <span class="text-xs text-muted-foreground flex items-center gap-1">
                                            <LucideCrownCn Class="h-3 w-3" Size="12" />
                                            Owner
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-1">
                                            <SelectCn Value="@collaborator.Permission" ValueChanged="@(v => HandleChangePermission(collaborator.Id, v))">
                                                <SelectTriggerCn Class="h-7 w-[90px] text-xs" aria-label="@($"Permission for {collaborator.Name}")">
                                                    <SelectValueCn />
                                                </SelectTriggerCn>
                                                <SelectContentCn>
                                                    <SelectItemCn Value="viewer">
                                                        <span class="flex items-center gap-2">
                                                            <LucideEyeCn Class="h-3 w-3" Size="12" />
                                                            Viewer
                                                        </span>
                                                    </SelectItemCn>
                                                    <SelectItemCn Value="editor">
                                                        <span class="flex items-center gap-2">
                                                            <LucidePencilCn Class="h-3 w-3" Size="12" />
                                                            Editor
                                                        </span>
                                                    </SelectItemCn>
                                                    <SelectItemCn Value="admin">
                                                        <span class="flex items-center gap-2">
                                                            <LucideCrownCn Class="h-3 w-3" Size="12" />
                                                            Admin
                                                        </span>
                                                    </SelectItemCn>
                                                </SelectContentCn>
                                            </SelectCn>
                                            <ButtonCn
                                                Class="h-7 w-7 p-0"
                                                @onclick="@(() => HandleRemoveUser(collaborator.Id))"
                                                Size="ButtonSize.Sm"
                                                Variant="ButtonVariant.Ghost">
                                                <LucideXCn Class="h-4 w-4" Size="16" />
                                            </ButtonCn>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </ScrollAreaCn>
                </div>
            </div>

            <DialogFooterCn Class="gap-2 sm:gap-0">
                <ButtonCn @onclick="HandleClose" Variant="ButtonVariant.Outline">
                    Cancel
                </ButtonCn>
                <ButtonCn @onclick="HandleSave">Save Changes</ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _search = "";
    private string _newUserPermission = "viewer";
    private bool _showResults;
    private bool _saved;

    private record Collaborator(string Id, string Name, string Email, string Permission, bool IsOwner = false);
    private record SearchResult(string Id, string Name, string Email);

    private static readonly Collaborator[] _initialCollaborators =
    [
        new("1", "Sarah Chen", "sarah@company.com", "admin", true),
        new("2", "Michael Park", "michael@company.com", "editor"),
        new("3", "Emma Wilson", "emma@company.com", "viewer")
    ];

    private static readonly SearchResult[] _searchResults =
    [
        new("4", "Alex Thompson", "alex@company.com"),
        new("5", "Jordan Lee", "jordan@company.com"),
        new("6", "Taylor Martinez", "taylor@company.com")
    ];

    private List<Collaborator> _collaborators = new(_initialCollaborators);

    private IEnumerable<SearchResult> FilteredResults => _searchResults
        .Where(u => !_collaborators.Any(c => c.Id == u.Id) &&
            (u.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             u.Email.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0])).ToUpper();

    private void HandleAddUser(SearchResult user)
    {
        _collaborators.Add(new Collaborator(user.Id, user.Name, user.Email, _newUserPermission));
        _search = "";
        _showResults = false;
    }

    private void HandleRemoveUser(string userId)
    {
        _collaborators.RemoveAll(c => c.Id == userId);
    }

    private void HandleChangePermission(string userId, string permission)
    {
        var index = _collaborators.FindIndex(c => c.Id == userId);
        if (index >= 0)
            _collaborators[index] = _collaborators[index] with { Permission = permission };
    }

    private void HandleSave()
    {
        _saved = true;
    }

    private void HandleClose()
    {
        _open = false;
        _search = "";
        _showResults = false;
        _saved = false;
        _collaborators = new List<Collaborator>(_initialCollaborators);
        _newUserPermission = "viewer";
    }
}
