@* ========================================
   Block: dialog-pomodoro-timer
   Title: Dialog Pomodoro Timer
   Description: Pomodoro timer dialog with work/break cycles, session counter, customizable durations, and sound notification toggle
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideBrainCn, LucideClockCn, LucideCoffeeCn, LucidePauseCn, LucidePlayCn, LucideRotateCcwCn, LucideSettingsCn, LucideSkipForwardCn, LucideTrophyCn, LucideVolume2Cn, LucideVolumeXCn, ProgressCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SwitchCn
   Source: original/blocks/dialog/dialog-pomodoro-timer.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideClockCn Class="mr-2 h-4 w-4" Size="16" />
                Pomodoro Timer
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideClockCn Class="h-5 w-5" Size="20" />
                    Pomodoro Timer
                </div>
                <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          @onclick="@(() => _showSettings = !_showSettings)">
                    <LucideSettingsCn Class="h-4 w-4" Size="16" />
                </ButtonCn>
            </DialogTitleCn>
            <DialogDescriptionCn>Focus with timed work sessions and breaks.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            @if (_showSettings)
            {
                <div class="space-y-4">
                    <div class="space-y-3">
                        <LabelCn Class="text-sm font-medium">Durations</LabelCn>
                        <div class="grid gap-3">
                            <div class="flex items-center justify-between">
                                <LabelCn Class="text-sm font-normal">Work</LabelCn>
                                <SelectCn Value="@(_workMinutes.ToString())" ValueChanged="@(v => HandleDurationChange("work", v))">
                                    <SelectTriggerCn Class="w-24"><SelectValueCn /></SelectTriggerCn>
                                    <SelectContentCn>
                                        @foreach (var min in new[] { 15, 20, 25, 30, 45, 50 })
                                        {
                                            <SelectItemCn Value="@min.ToString()">@min min</SelectItemCn>
                                        }
                                    </SelectContentCn>
                                </SelectCn>
                            </div>
                            <div class="flex items-center justify-between">
                                <LabelCn Class="text-sm font-normal">Short Break</LabelCn>
                                <SelectCn Value="@(_shortBreakMinutes.ToString())" ValueChanged="@(v => HandleDurationChange("shortBreak", v))">
                                    <SelectTriggerCn Class="w-24"><SelectValueCn /></SelectTriggerCn>
                                    <SelectContentCn>
                                        @foreach (var min in new[] { 3, 5, 10 })
                                        {
                                            <SelectItemCn Value="@min.ToString()">@min min</SelectItemCn>
                                        }
                                    </SelectContentCn>
                                </SelectCn>
                            </div>
                            <div class="flex items-center justify-between">
                                <LabelCn Class="text-sm font-normal">Long Break</LabelCn>
                                <SelectCn Value="@(_longBreakMinutes.ToString())" ValueChanged="@(v => HandleDurationChange("longBreak", v))">
                                    <SelectTriggerCn Class="w-24"><SelectValueCn /></SelectTriggerCn>
                                    <SelectContentCn>
                                        @foreach (var min in new[] { 15, 20, 30 })
                                        {
                                            <SelectItemCn Value="@min.ToString()">@min min</SelectItemCn>
                                        }
                                    </SelectContentCn>
                                </SelectCn>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <LabelCn Class="text-sm font-medium">Preferences</LabelCn>
                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <LabelCn Class="text-sm font-normal" For="auto-breaks">Auto-start breaks</LabelCn>
                                <SwitchCn Checked="_autoStartBreaks" CheckedChanged="@(v => _autoStartBreaks = v)" Id="auto-breaks" />
                            </div>
                            <div class="flex items-center justify-between">
                                <LabelCn Class="text-sm font-normal" For="sound">Sound notifications</LabelCn>
                                <SwitchCn Checked="_soundEnabled" CheckedChanged="@(v => _soundEnabled = v)" Id="sound" />
                            </div>
                        </div>
                    </div>

                    <ButtonCn Class="w-full" Variant="ButtonVariant.Outline" @onclick="@(() => _showSettings = false)">Done</ButtonCn>
                </div>
            }
            else
            {
                @* Mode tabs *@
                <div class="flex justify-center gap-2">
                    @foreach (var m in new[] { "work", "shortBreak", "longBreak" })
                    {
                        var modeLabel = m == "work" ? "Work" : m == "shortBreak" ? "Short" : "Long";
                        <ButtonCn Disabled="@(_timerState == "running")"
                                  Size="ButtonSize.Sm"
                                  Variant="@(_mode == m ? ButtonVariant.Default : ButtonVariant.Outline)"
                                  @onclick="@(() => HandleModeChange(m))">
                            @modeLabel
                        </ButtonCn>
                    }
                </div>

                @* Timer display *@
                <div class="flex flex-col items-center py-6">
                    <div class="@Cn.Merge("flex items-center gap-2 mb-2", ModeColor)">
                        @if (_mode == "work")
                        {
                            <LucideBrainCn Class="h-5 w-5" Size="20" />
                        }
                        else
                        {
                            <LucideCoffeeCn Class="h-5 w-5" Size="20" />
                        }
                        <span class="text-sm font-medium capitalize">
                            @(_mode == "shortBreak" ? "Short Break" : _mode == "longBreak" ? "Long Break" : "Focus Time")
                        </span>
                    </div>
                    <span class="@Cn.Merge("text-6xl font-mono font-bold tabular-nums", _timerState == "running" ? ModeColor : "")">
                        @FormatTime(_remainingSeconds)
                    </span>
                    <ProgressCn Class="w-full mt-4 h-2" Value="Progress" />
                </div>

                @* Controls *@
                <div class="flex justify-center gap-2">
                    @if (_timerState == "running")
                    {
                        <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline" @onclick="HandlePause">
                            <LucidePauseCn Class="mr-2 h-5 w-5" Size="20" />
                            Pause
                        </ButtonCn>
                    }
                    else
                    {
                        <ButtonCn Size="ButtonSize.Lg" @onclick="HandleStart">
                            <LucidePlayCn Class="mr-2 h-5 w-5" Size="20" />
                            @(_timerState == "paused" ? "Resume" : "Start")
                        </ButtonCn>
                    }
                    <ButtonCn Class="h-11 w-11" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="HandleReset">
                        <LucideRotateCcwCn Class="h-5 w-5" Size="20" />
                    </ButtonCn>
                    <ButtonCn Class="h-11 w-11" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="HandleSkip">
                        <LucideSkipForwardCn Class="h-5 w-5" Size="20" />
                    </ButtonCn>
                </div>

                @* Sessions completed *@
                <div class="flex items-center justify-between rounded-lg border p-3">
                    <div class="flex items-center gap-2">
                        <LucideTrophyCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                        <span class="text-sm">Sessions completed</span>
                    </div>
                    <BadgeCn Class="font-mono" Variant="BadgeVariant.Secondary">@_completedSessions</BadgeCn>
                </div>

                @if (_mode == "work")
                {
                    <p class="text-center text-xs text-muted-foreground">
                        @if (SessionsUntilLongBreak == 4)
                        {
                            @:Long break after this session
                        }
                        else
                        {
                            @($"{SessionsUntilLongBreak} session{(SessionsUntilLongBreak > 1 ? "s" : "")} until long break")
                        }
                    </p>
                }

                <div class="flex justify-center">
                    <ButtonCn Class="text-muted-foreground" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                              @onclick="@(() => _soundEnabled = !_soundEnabled)">
                        @if (_soundEnabled)
                        {
                            <LucideVolume2Cn Class="mr-2 h-4 w-4" Size="16" />
                            <span>Sound on</span>
                        }
                        else
                        {
                            <LucideVolumeXCn Class="mr-2 h-4 w-4" Size="16" />
                            <span>Sound off</span>
                        }
                    </ButtonCn>
                </div>
            }
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _mode = "work";
    private string _timerState = "idle"; // idle, running, paused
    private int _remainingSeconds = 25 * 60;
    private int _completedSessions;
    private bool _soundEnabled = true;
    private bool _autoStartBreaks = true;
    private bool _showSettings;
    private int _workMinutes = 25;
    private int _shortBreakMinutes = 5;
    private int _longBreakMinutes = 15;
    private System.Threading.Timer? _timer;

    private int TotalSeconds => _mode switch
    {
        "work" => _workMinutes * 60,
        "shortBreak" => _shortBreakMinutes * 60,
        "longBreak" => _longBreakMinutes * 60,
        _ => _workMinutes * 60
    };

    private int Progress => TotalSeconds > 0 ? (int)((TotalSeconds - _remainingSeconds) * 100.0 / TotalSeconds) : 0;
    private int SessionsUntilLongBreak => 4 - (_completedSessions % 4);

    private string ModeColor => _mode switch
    {
        "work" => "text-primary",
        "shortBreak" => "text-primary/80",
        _ => "text-primary/60"
    };

    private static string FormatTime(int seconds)
    {
        var mins = seconds / 60;
        var secs = seconds % 60;
        return $"{mins:D2}:{secs:D2}";
    }

    private void HandleStart()
    {
        if (_remainingSeconds <= 0) return;
        _timerState = "running";
        StartTimer();
    }

    private void HandlePause()
    {
        StopTimer();
        _timerState = "paused";
    }

    private void HandleReset()
    {
        StopTimer();
        _remainingSeconds = TotalSeconds;
        _timerState = "idle";
    }

    private void HandleSkip()
    {
        if (_mode == "work")
        {
            var nextMode = (_completedSessions + 1) % 4 == 0 ? "longBreak" : "shortBreak";
            SwitchMode(nextMode, false);
        }
        else
        {
            SwitchMode("work", false);
        }
    }

    private void HandleModeChange(string newMode)
    {
        if (_timerState == "running") StopTimer();
        SwitchMode(newMode, false);
    }

    private void HandleDurationChange(string modeKey, string minutesStr)
    {
        if (!int.TryParse(minutesStr, out var minutes)) return;
        switch (modeKey)
        {
            case "work": _workMinutes = minutes; break;
            case "shortBreak": _shortBreakMinutes = minutes; break;
            case "longBreak": _longBreakMinutes = minutes; break;
        }
        if (_mode == modeKey && _timerState == "idle")
            _remainingSeconds = minutes * 60;
    }

    private void SwitchMode(string newMode, bool autoStart)
    {
        StopTimer();
        _mode = newMode;
        _remainingSeconds = newMode switch
        {
            "work" => _workMinutes * 60,
            "shortBreak" => _shortBreakMinutes * 60,
            "longBreak" => _longBreakMinutes * 60,
            _ => _workMinutes * 60
        };
        _timerState = autoStart ? "running" : "idle";
        if (autoStart) StartTimer();
    }

    private void StartTimer()
    {
        _timer?.Dispose();
        _timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                if (_remainingSeconds <= 1)
                {
                    _remainingSeconds = 0;
                    HandleSessionComplete();
                }
                else
                {
                    _remainingSeconds--;
                }
                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

    private void StopTimer()
    {
        _timer?.Dispose();
        _timer = null;
    }

    private void HandleSessionComplete()
    {
        StopTimer();
        if (_mode == "work")
        {
            _completedSessions++;
            var nextMode = _completedSessions % 4 == 0 ? "longBreak" : "shortBreak";
            SwitchMode(nextMode, _autoStartBreaks);
        }
        else
        {
            SwitchMode("work", false);
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
