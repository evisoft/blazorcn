@* ========================================
   Block: dialog-order-tracking
   Title: Dialog Order Tracking
   Description: Order tracking dialog with status timeline, delivery estimate, and live updates
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCheckCn, LucideClockCn, LucideMapPinCn, LucidePackageCn, LucideTruckCn
   Source: original/blocks/dialog/dialog-order-tracking.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucidePackageCn Class="mr-2 h-4 w-4" Size="16" />
                Track Order
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 360px;">
        <DialogHeaderCn>
            <DialogTitleCn>Order #38492</DialogTitleCn>
        </DialogHeaderCn>

        <div class="py-4 space-y-6">
            @* Delivery estimate *@
            <div class="flex items-center gap-3 p-3 rounded-lg border">
                <div class="h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center">
                    <LucideTruckCn Class="h-5 w-5 text-primary" Size="20" />
                </div>
                <div>
                    <p class="text-sm font-medium">Arriving Tomorrow</p>
                    <p class="text-xs text-muted-foreground">Wednesday, December 11</p>
                </div>
            </div>

            @* Timeline *@
            <div class="space-y-0">
                @for (var i = 0; i < _steps.Length; i++)
                {
                    var step = _steps[i];
                    var isLast = i == _steps.Length - 1;
                    var nextDone = !isLast && _steps[i + 1].Done;

                    <div class="flex gap-3">
                        <div class="flex flex-col items-center">
                            <div class="@Cn.Merge("h-6 w-6 rounded-full flex items-center justify-center border-2", step.Done ? "bg-primary border-primary text-primary-foreground" : "border-muted-foreground/30")">
                                @if (step.Done)
                                {
                                    <LucideCheckCn Class="h-3 w-3" Size="12" />
                                }
                            </div>
                            @if (!isLast)
                            {
                                <div class="@Cn.Merge("w-0.5 h-8", nextDone ? "bg-primary" : "bg-muted")"></div>
                            }
                        </div>
                        <div class="pb-8">
                            <p class="@Cn.Merge("text-sm font-medium", step.Current ? "text-primary" : "")">@step.Label</p>
                            <p class="text-xs text-muted-foreground">@step.Time</p>
                        </div>
                    </div>
                }
            </div>

            @* Actions *@
            <div class="flex gap-2">
                <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">
                    <LucideMapPinCn Class="mr-2 h-4 w-4" Size="16" />
                    View Map
                </ButtonCn>
                <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">
                    <LucideClockCn Class="mr-2 h-4 w-4" Size="16" />
                    Remind Me
                </ButtonCn>
            </div>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private record TrackingStep(string Id, string Label, string Time, bool Done, bool Current = false);

    private static readonly TrackingStep[] _steps =
    [
        new("confirmed", "Confirmed", "Dec 8, 10:30 AM", true),
        new("processing", "Processing", "Dec 8, 2:15 PM", true),
        new("shipped", "Shipped", "Dec 9, 9:00 AM", true),
        new("transit", "In Transit", "Dec 10, 11:45 AM", true, true),
        new("delivered", "Delivered", "Expected Dec 11", false),
    ];

    private bool _open;
}
