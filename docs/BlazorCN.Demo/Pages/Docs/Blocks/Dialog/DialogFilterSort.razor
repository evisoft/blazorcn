@* ========================================
   Block: dialog-filter-sort
   Title: Dialog Filter Sort
   Description: Filter and sort dialog with multiple filter options, sort direction, saved presets, and clear all action
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideArrowDownCn, LucideArrowUpCn, LucideCheckCn, LucideFilterCn, LucideRotateCcwCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SeparatorCn
   Source: original/blocks/dialog/dialog-filter-sort.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideFilterCn Class="mr-2 h-4 w-4" Size="16" />
                Filter &amp; Sort
                @if (_activeFilterCount > 0)
                {
                    <BadgeCn Class="ml-2" Variant="BadgeVariant.Secondary">@_activeFilterCount</BadgeCn>
                }
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideFilterCn Class="h-5 w-5" Size="20" />
                    Filter &amp; Sort
                </div>
                @if (HasAnyFilter)
                {
                    <ButtonCn Class="h-8 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="HandleClearAll">
                        <LucideRotateCcwCn Class="mr-1 h-3 w-3" Size="12" />
                        Clear All
                    </ButtonCn>
                }
            </DialogTitleCn>
            <DialogDescriptionCn>Refine your results with filters and sorting.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            <div class="space-y-3">
                <LabelCn Class="text-sm font-medium">Search</LabelCn>
                <InputCn Placeholder="Search by name or keyword..." @bind-Value="_search" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div class="space-y-2">
                    <LabelCn Class="text-sm">Status</LabelCn>
                    <SelectCn Value="@_status" ValueChanged="@((string v) => _status = v)">
                        <SelectTriggerCn>
                            <SelectValueCn Placeholder="Any status" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="all">Any status</SelectItemCn>
                            <SelectItemCn Value="active">Active</SelectItemCn>
                            <SelectItemCn Value="pending">Pending</SelectItemCn>
                            <SelectItemCn Value="completed">Completed</SelectItemCn>
                            <SelectItemCn Value="cancelled">Cancelled</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <div class="space-y-2">
                    <LabelCn Class="text-sm">Category</LabelCn>
                    <SelectCn Value="@_category" ValueChanged="@((string v) => _category = v)">
                        <SelectTriggerCn>
                            <SelectValueCn Placeholder="Any category" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="all">Any category</SelectItemCn>
                            <SelectItemCn Value="sales">Sales</SelectItemCn>
                            <SelectItemCn Value="marketing">Marketing</SelectItemCn>
                            <SelectItemCn Value="support">Support</SelectItemCn>
                            <SelectItemCn Value="engineering">Engineering</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn Class="text-sm">Date Range</LabelCn>
                <div class="grid grid-cols-2 gap-3">
                    <InputCn type="date" Placeholder="From" @bind-Value="_dateFrom" />
                    <InputCn type="date" Placeholder="To" @bind-Value="_dateTo" />
                </div>
            </div>

            <div class="space-y-2">
                <LabelCn Class="text-sm">Amount Range</LabelCn>
                <div class="grid grid-cols-2 gap-3">
                    <InputCn type="number" Placeholder="Min" @bind-Value="_minAmount" />
                    <InputCn type="number" Placeholder="Max" @bind-Value="_maxAmount" />
                </div>
            </div>

            <SeparatorCn />

            <div class="space-y-2">
                <LabelCn Class="text-sm font-medium">Sort By</LabelCn>
                <div class="flex gap-2">
                    <SelectCn Value="@_sortField" ValueChanged="@((string v) => _sortField = v)">
                        <SelectTriggerCn Class="flex-1">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="created">Date Created</SelectItemCn>
                            <SelectItemCn Value="updated">Date Updated</SelectItemCn>
                            <SelectItemCn Value="name">Name</SelectItemCn>
                            <SelectItemCn Value="amount">Amount</SelectItemCn>
                            <SelectItemCn Value="status">Status</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Outline"
                              title="@(_sortDirection == "asc" ? "Ascending" : "Descending")"
                              @onclick="@(() => _sortDirection = _sortDirection == "asc" ? "desc" : "asc")">
                        @if (_sortDirection == "asc")
                        {
                            <LucideArrowUpCn Class="h-4 w-4" Size="16" />
                        }
                        else
                        {
                            <LucideArrowDownCn Class="h-4 w-4" Size="16" />
                        }
                    </ButtonCn>
                </div>
                <p class="text-xs text-muted-foreground">
                    @(_sortDirection == "asc" ? "Oldest first" : "Newest first")
                    @(_sortField == "name" ? (_sortDirection == "asc" ? " (A-Z)" : " (Z-A)") : "")
                    @(_sortField == "amount" ? (_sortDirection == "asc" ? " (Low to High)" : " (High to Low)") : "")
                </p>
            </div>
        </div>

        <DialogFooterCn class="gap-2 sm:gap-0">
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">
                Cancel
            </ButtonCn>
            <ButtonCn @onclick="HandleApply">
                <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                Apply Filters
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _search = "";
    private string _status = "all";
    private string _category = "all";
    private string _dateFrom = "";
    private string _dateTo = "";
    private string _minAmount = "";
    private string _maxAmount = "";
    private string _sortField = "created";
    private string _sortDirection = "desc";
    private int _activeFilterCount;

    private bool HasAnyFilter =>
        !string.IsNullOrEmpty(_search) || _status != "all" || _category != "all" ||
        !string.IsNullOrEmpty(_dateFrom) || !string.IsNullOrEmpty(_dateTo) ||
        !string.IsNullOrEmpty(_minAmount) || !string.IsNullOrEmpty(_maxAmount) ||
        _sortField != "created";

    private void HandleApply()
    {
        _activeFilterCount = 0;
        if (!string.IsNullOrEmpty(_search)) _activeFilterCount++;
        if (_status != "all") _activeFilterCount++;
        if (_category != "all") _activeFilterCount++;
        if (!string.IsNullOrEmpty(_dateFrom)) _activeFilterCount++;
        if (!string.IsNullOrEmpty(_dateTo)) _activeFilterCount++;
        if (!string.IsNullOrEmpty(_minAmount)) _activeFilterCount++;
        if (!string.IsNullOrEmpty(_maxAmount)) _activeFilterCount++;
        _open = false;
    }

    private void HandleClearAll()
    {
        _search = "";
        _status = "all";
        _category = "all";
        _dateFrom = "";
        _dateTo = "";
        _minAmount = "";
        _maxAmount = "";
        _sortField = "created";
        _sortDirection = "desc";
    }
}
