@* ========================================
   Block: dialog-apply-coupon
   Title: Dialog Apply Coupon
   Description: Apply coupon or promo code dialog with input validation, discount preview, and applied codes list
   Dependencies: AlertCn, AlertDescriptionCn, BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, SeparatorCn, LucideCheckCn, LucideCircleAlertCn, LucideLoader2Cn, LucidePercentCn, LucideSparklesCn, LucideTagCn, LucideXCn
   Source: original/blocks/dialog/dialog-apply-coupon.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideTagCn Class="mr-2 h-4 w-4" Size="16" />
                Apply Coupon
                @if (_appliedCoupons.Count > 0)
                {
                    <BadgeCn Class="ml-2" Variant="BadgeVariant.Secondary">@_appliedCoupons.Count</BadgeCn>
                }
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideTagCn Class="h-5 w-5" Size="20" />
                Apply Coupon Code
            </DialogTitleCn>
            <DialogDescriptionCn>Enter a promo code to get a discount on your order.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            @* Coupon Input *@
            <div class="space-y-2">
                <LabelCn For="coupon-code">Coupon Code</LabelCn>
                <div class="flex gap-2">
                    <InputCn Class="uppercase" Disabled="@_isValidating" Id="coupon-code"
                             Value="@_code" ValueChanged="@((string v) => HandleCodeChange(v))"
                             Placeholder="Enter code" />
                    <ButtonCn Disabled="@(_isValidating || string.IsNullOrWhiteSpace(_code))" @onclick="HandleApply">
                        @if (_isValidating)
                        {
                            <LucideLoader2Cn Class="h-4 w-4 animate-spin" Size="16" />
                        }
                        else
                        {
                            <span>Apply</span>
                        }
                    </ButtonCn>
                </div>
            </div>

            @* Preview Discount *@
            @if (_previewDiscount is not null && _error is null)
            {
                <div class="flex items-center gap-2 rounded-lg border border-primary/50 p-3">
                    <LucideSparklesCn Class="h-4 w-4 text-primary" Size="16" />
                    <span class="text-sm">
                        You'll save <span class="font-semibold text-primary">@_previewDiscount.Discount</span> with this code!
                    </span>
                </div>
            }

            @* Error Message *@
            @if (_error is not null)
            {
                <AlertCn Variant="AlertVariant.Destructive">
                    <LucideCircleAlertCn Class="h-4 w-4" Size="16" />
                    <AlertDescriptionCn>@_error</AlertDescriptionCn>
                </AlertCn>
            }

            @* Applied Coupons *@
            @if (_appliedCoupons.Count > 0)
            {
                <SeparatorCn />
                <div class="space-y-2">
                    <LabelCn Class="text-muted-foreground">Applied Coupons</LabelCn>
                    <div class="space-y-2">
                        @foreach (var coupon in _appliedCoupons)
                        {
                            <div class="flex items-center justify-between rounded-lg border p-3">
                                <div class="flex items-center gap-3">
                                    <div class="flex h-8 w-8 items-center justify-center rounded-full border">
                                        @if (coupon.Type == "percent")
                                        {
                                            <LucidePercentCn Class="h-4 w-4" Size="16" />
                                        }
                                        else
                                        {
                                            <LucideTagCn Class="h-4 w-4" Size="16" />
                                        }
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium">@coupon.Code</p>
                                        <p class="text-xs text-primary">@coupon.Discount off</p>
                                    </div>
                                </div>
                                <ButtonCn Class="h-8 w-8" @onclick="@(() => HandleRemove(coupon.Code))"
                                          Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                                    <LucideXCn Class="h-4 w-4" Size="16" />
                                </ButtonCn>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Sample Codes Hint *@
            <p class="text-xs text-muted-foreground text-center">
                Try: SAVE20, WELCOME10, or FREESHIP
            </p>
        </div>

        <DialogFooterCn>
            <ButtonCn @onclick="HandleClose" Variant="ButtonVariant.Outline">Cancel</ButtonCn>
            <ButtonCn @onclick="HandleClose">
                <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                Done
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _code = "";
    private bool _isValidating;
    private string? _error;
    private List<AppliedCoupon> _appliedCoupons = [];
    private CouponInfo? _previewDiscount;

    private record CouponInfo(string Discount, string Type);
    private record AppliedCoupon(string Code, string Discount, string Type);

    private static readonly Dictionary<string, CouponInfo> _validCoupons = new()
    {
        ["SAVE20"] = new("20%", "percent"),
        ["WELCOME10"] = new("$10", "fixed"),
        ["FREESHIP"] = new("Free Shipping", "fixed"),
    };

    private void HandleCodeChange(string value)
    {
        _code = value.ToUpperInvariant();
        _error = null;
        _previewDiscount = _validCoupons.GetValueOrDefault(_code);
    }

    private async Task HandleApply()
    {
        if (string.IsNullOrWhiteSpace(_code)) { _error = "Please enter a coupon code"; return; }
        if (_appliedCoupons.Any(c => c.Code == _code)) { _error = "This code is already applied"; return; }

        _isValidating = true;
        _error = null;
        StateHasChanged();
        await Task.Delay(1000);

        if (_validCoupons.TryGetValue(_code, out var coupon))
        {
            _appliedCoupons.Add(new AppliedCoupon(_code, coupon.Discount, coupon.Type));
            _code = "";
            _previewDiscount = null;
        }
        else
        {
            _error = "Invalid or expired coupon code";
        }
        _isValidating = false;
    }

    private void HandleRemove(string codeToRemove) =>
        _appliedCoupons.RemoveAll(c => c.Code == codeToRemove);

    private void HandleClose()
    {
        _open = false;
        _code = "";
        _error = null;
        _previewDiscount = null;
    }
}
