@* ========================================
   Block: dialog-recurring-payment
   Title: Dialog Recurring Payment
   Description: Recurring payment setup dialog with frequency selection, amount input, payment method display, and billing summary
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCheckCn, LucideRepeatCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn
   Source: original/blocks/dialog/dialog-recurring-payment.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideRepeatCn Class="mr-2 h-4 w-4" Size="16" />
                Set Up Auto-Pay
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        @if (_saved)
        {
            <div class="flex flex-col items-center justify-center py-8 text-center">
                <LucideCheckCn Class="h-8 w-8 text-primary" Size="32" />
                <h3 class="mt-4 text-lg font-semibold">Auto-Pay Enabled</h3>
                <p class="mt-2 text-sm text-muted-foreground">
                    $@_amount will be charged @_frequency.
                </p>
                <ButtonCn Class="mt-6" @onclick="HandleClose">Done</ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn>Set Up Auto-Pay</DialogTitleCn>
                <DialogDescriptionCn>Schedule automatic recurring payments.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-4 py-4">
                <div class="space-y-2">
                    <LabelCn For="amount">Amount</LabelCn>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">$</span>
                        <InputCn Class="pl-7" Id="amount" Type="number" Value="@_amount" ValueChanged="@(v => _amount = v)" />
                    </div>
                </div>

                <div class="space-y-2">
                    <LabelCn For="frequency">Frequency</LabelCn>
                    <SelectCn Value="@_frequency" ValueChanged="@(v => _frequency = v)">
                        <SelectTriggerCn Id="frequency">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var f in _frequencies)
                            {
                                <SelectItemCn Value="@f.Value">@f.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <div class="flex items-center justify-between rounded-lg border p-3">
                    <div>
                        <p class="text-sm font-medium">Visa &bull;&bull;&bull;&bull; 4242</p>
                        <p class="text-xs text-muted-foreground">Expires 12/26</p>
                    </div>
                    <ButtonCn Class="text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">Change</ButtonCn>
                </div>
            </div>

            <DialogFooterCn>
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">Cancel</ButtonCn>
                <ButtonCn Disabled="@(!IsValid)" @onclick="@(() => _saved = true)">Enable</ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record FrequencyOption(string Value, string Label);

    private static readonly FrequencyOption[] _frequencies =
    [
        new("weekly", "Weekly"), new("monthly", "Monthly"),
        new("quarterly", "Quarterly"), new("annually", "Annually")
    ];

    private bool _open;
    private bool _saved;
    private string _amount = "50.00";
    private string _frequency = "monthly";

    private bool IsValid => decimal.TryParse(_amount, out var v) && v > 0;

    private void HandleClose()
    {
        _open = false;
        _saved = false;
        _amount = "50.00";
        _frequency = "monthly";
    }
}
