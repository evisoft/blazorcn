@* ========================================
   Block: dialog-billing-address
   Title: Dialog Billing Address
   Description: Billing address form dialog with country selection, auto-formatted inputs, address validation, and save for future use option
   Dependencies: ButtonCn, CheckboxCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, LucideCheckCn, LucideMapPinCn
   Source: original/blocks/dialog/dialog-billing-address.tsx
   ======================================== *@

@using System.Text.RegularExpressions

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideMapPinCn Class="mr-2 h-4 w-4" Size="16" />
                Add Billing Address
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-lg">
        @if (_saved)
        {
            <DialogHeaderCn Class="text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-green-100 mb-4">
                    <LucideCheckCn Class="h-6 w-6 text-green-600" Size="24" />
                </div>
                <DialogTitleCn>Address Saved</DialogTitleCn>
                <DialogDescriptionCn>
                    Your billing address has been saved successfully.@(_saveForFuture ? " It will be available for future purchases." : "")
                </DialogDescriptionCn>
            </DialogHeaderCn>
            <DialogFooterCn>
                <ButtonCn Class="w-full" @onclick="HandleClose">Done</ButtonCn>
            </DialogFooterCn>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn Class="flex items-center gap-2">
                    <LucideMapPinCn Class="h-5 w-5" Size="20" />
                    Billing Address
                </DialogTitleCn>
                <DialogDescriptionCn>Enter your billing address for this purchase.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="grid gap-4 py-4">
                <div class="grid gap-2">
                    <LabelCn For="country">Country</LabelCn>
                    <SelectCn Value="@_country" ValueChanged="@(v => _country = v)">
                        <SelectTriggerCn Id="country"><SelectValueCn /></SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var c in _countries)
                            {
                                <SelectItemCn Value="@c.Code">@c.Name</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <div class="grid gap-2">
                    <LabelCn For="fullName">Full Name *</LabelCn>
                    <InputCn Id="fullName" Value="@_fullName" ValueChanged="@((string v) => _fullName = v)" Placeholder="John Smith" />
                </div>

                <div class="grid gap-2">
                    <LabelCn For="company">Company (Optional)</LabelCn>
                    <InputCn Id="company" Value="@_company" ValueChanged="@((string v) => _company = v)" Placeholder="Acme Inc." />
                </div>

                <div class="grid gap-2">
                    <LabelCn For="address1">Address Line 1 *</LabelCn>
                    <InputCn Id="address1" Value="@_address1" ValueChanged="@((string v) => _address1 = v)" Placeholder="123 Main Street" />
                </div>

                <div class="grid gap-2">
                    <LabelCn For="address2">Address Line 2 (Optional)</LabelCn>
                    <InputCn Id="address2" Value="@_address2" ValueChanged="@((string v) => _address2 = v)" Placeholder="Apt 4B" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="grid gap-2">
                        <LabelCn For="city">City *</LabelCn>
                        <InputCn Id="city" Value="@_city" ValueChanged="@((string v) => _city = v)" Placeholder="San Francisco" />
                    </div>
                    <div class="grid gap-2">
                        <LabelCn For="state">@SelectedCountry?.StateLabel *</LabelCn>
                        @if (_country == "US")
                        {
                            <SelectCn Value="@_state" ValueChanged="@(v => _state = v)">
                                <SelectTriggerCn Id="state"><SelectValueCn Placeholder="Select" /></SelectTriggerCn>
                                <SelectContentCn>
                                    @foreach (var s in _usStates)
                                    {
                                        <SelectItemCn Value="@s">@s</SelectItemCn>
                                    }
                                </SelectContentCn>
                            </SelectCn>
                        }
                        else
                        {
                            <InputCn Id="state" Value="@_state" ValueChanged="@((string v) => _state = v)" Placeholder="@SelectedCountry?.StateLabel" />
                        }
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="grid gap-2">
                        <LabelCn For="postalCode">@SelectedCountry?.PostalLabel *</LabelCn>
                        <InputCn Id="postalCode" Value="@_postalCode" ValueChanged="@((string v) => HandlePostalCodeChange(v))"
                                 Placeholder="@(_country == "US" ? "94102" : "")" />
                    </div>
                    <div class="grid gap-2">
                        <LabelCn For="phone">Phone (Optional)</LabelCn>
                        <InputCn Id="phone" Type="tel" Value="@_phone" ValueChanged="@((string v) => _phone = v)" Placeholder="+1 (555) 000-0000" />
                    </div>
                </div>

                <div class="flex items-center space-x-2 pt-2">
                    <CheckboxCn Checked="_saveForFuture" Id="saveForFuture" CheckedChanged="@(v => _saveForFuture = v)" />
                    <LabelCn Class="text-sm font-normal cursor-pointer" For="saveForFuture">
                        Save this address for future purchases
                    </LabelCn>
                </div>
            </div>

            <DialogFooterCn Class="gap-2 sm:gap-0">
                <ButtonCn @onclick="HandleClose" Variant="ButtonVariant.Outline">Cancel</ButtonCn>
                <ButtonCn Disabled="@(!IsValid)" @onclick="@(() => _saved = true)">Save Address</ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _saved;
    private string _country = "US";
    private bool _saveForFuture;
    private string _fullName = "", _company = "", _address1 = "", _address2 = "", _city = "", _state = "", _postalCode = "", _phone = "";

    private record Country(string Code, string Name, string PostalLabel, string StateLabel);

    private static readonly Country[] _countries =
    [
        new("US", "United States", "ZIP Code", "State"),
        new("CA", "Canada", "Postal Code", "Province"),
        new("GB", "United Kingdom", "Postcode", "County"),
        new("AU", "Australia", "Postcode", "State"),
        new("DE", "Germany", "Postleitzahl", "State"),
        new("FR", "France", "Code postal", "Region"),
    ];

    private static readonly string[] _usStates =
    [
        "Alabama","Alaska","Arizona","Arkansas","California","Colorado","Connecticut","Delaware",
        "Florida","Georgia","Hawaii","Idaho","Illinois","Indiana","Iowa","Kansas","Kentucky",
        "Louisiana","Maine","Maryland","Massachusetts","Michigan","Minnesota","Mississippi",
        "Missouri","Montana","Nebraska","Nevada","New Hampshire","New Jersey","New Mexico",
        "New York","North Carolina","North Dakota","Ohio","Oklahoma","Oregon","Pennsylvania",
        "Rhode Island","South Carolina","South Dakota","Tennessee","Texas","Utah","Vermont",
        "Virginia","Washington","West Virginia","Wisconsin","Wyoming"
    ];

    private Country? SelectedCountry => _countries.FirstOrDefault(c => c.Code == _country);
    private bool IsValid => !string.IsNullOrWhiteSpace(_fullName) && !string.IsNullOrWhiteSpace(_address1) && !string.IsNullOrWhiteSpace(_city) && !string.IsNullOrWhiteSpace(_state) && !string.IsNullOrWhiteSpace(_postalCode);

    private void HandlePostalCodeChange(string value)
    {
        if (_country == "US")
        {
            var cleaned = Regex.Replace(value, @"\D", "");
            _postalCode = cleaned.Length <= 5 ? cleaned : $"{cleaned[..5]}-{cleaned[5..Math.Min(9, cleaned.Length)]}";
        }
        else if (_country == "CA")
        {
            var cleaned = Regex.Replace(value, @"[^A-Za-z0-9]", "").ToUpperInvariant();
            _postalCode = cleaned.Length <= 3 ? cleaned : $"{cleaned[..3]} {cleaned[3..Math.Min(6, cleaned.Length)]}";
        }
        else
        {
            _postalCode = value;
        }
    }

    private void HandleClose()
    {
        _open = false;
        _saved = false;
        _fullName = _company = _address1 = _address2 = _city = _state = _postalCode = _phone = "";
        _country = "US";
        _saveForFuture = false;
    }
}
