@* ============================================================
   Block: dialog-two-factor-setup
   Title: Dialog Two Factor Setup
   Description: Two-factor authentication setup wizard with QR code display, authenticator app instructions, backup codes, and verification step
   Dependencies: AlertCn, ButtonCn, InputOtpCn
   Source: original/blocks/dialog/dialog-two-factor-setup.tsx
   ============================================================ *@

<div class="flex min-h-[350px] items-center justify-center">
    <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _open = true)">
        <LucideShieldCn Size="16" Class="mr-2 size-4" />
        Enable Two-Factor Auth
    </ButtonCn>
</div>

@if (_open)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @onclick="@HandleClose">
        <div class="mx-4 w-full max-w-md rounded-lg border bg-card p-6 shadow-lg" @onclick:stopPropagation="true">
            @if (_step == "scan")
            {
                <div class="space-y-1.5">
                    <h3 class="flex items-center gap-2 text-lg font-semibold leading-none tracking-tight">
                        <LucideSmartphoneCn Size="20" Class="size-5" />
                        Set Up Authenticator
                    </h3>
                    <p class="text-sm text-muted-foreground">
                        Scan the QR code with your authenticator app or enter the key manually.
                    </p>
                </div>

                <div class="space-y-4 py-4">
                    <div class="flex justify-center">
                        <div class="rounded-lg border bg-white p-4">
                            <div class="flex h-[140px] w-[140px] items-center justify-center bg-muted">
                                <div class="text-center text-xs text-muted-foreground">
                                    <div class="grid grid-cols-5 gap-1">
                                        @for (var i = 0; i < 25; i++)
                                        {
                                            <div class="@Cn.Merge("h-5 w-5 rounded-sm", i % 3 == 0 ? "bg-foreground" : "bg-white")"></div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <button type="button"
                                class="w-full text-center text-sm text-primary hover:underline"
                                @onclick="@(() => _showSecret = !_showSecret)">
                            @(_showSecret ? "Hide" : "Can't scan? Enter key manually")
                        </button>

                        @if (_showSecret)
                        {
                            <div class="flex items-center gap-2 rounded-lg border bg-muted/50 p-3">
                                <LucideKeyCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                <code class="flex-1 font-mono text-sm tracking-wider">@_secretKey</code>
                                <ButtonCn Class="size-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                                          @onclick="@(() => _copied = true)">
                                    @if (_copied)
                                    {
                                        <LucideCheckCn Size="16" Class="size-4 text-primary" />
                                    }
                                    else
                                    {
                                        <LucideCopyCn Size="16" Class="size-4" />
                                    }
                                </ButtonCn>
                            </div>
                        }
                    </div>

                    <AlertCn>
                        <LucideAlertTriangleCn Size="16" Class="size-4" />
                        <AlertDescriptionCn>
                            Use Google Authenticator, Authy, or any TOTP-compatible app.
                        </AlertDescriptionCn>
                    </AlertCn>
                </div>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" @onclick="@HandleClose">Cancel</ButtonCn>
                    <ButtonCn @onclick="@(() => _step = "verify")">Continue</ButtonCn>
                </div>
            }

            @if (_step == "verify")
            {
                <div class="space-y-1.5">
                    <h3 class="flex items-center gap-2 text-lg font-semibold leading-none tracking-tight">
                        <LucideShieldCn Size="20" Class="size-5" />
                        Verify Setup
                    </h3>
                    <p class="text-sm text-muted-foreground">
                        Enter the 6-digit code from your authenticator app to verify setup.
                    </p>
                </div>

                <div class="space-y-4 py-6">
                    <div class="flex justify-center">
                        <InputOtpCn MaxLength="6" Value="@_otp" ValueChanged="@(v => { _otp = v; _verifyError = false; })">
                            <InputOtpGroupCn>
                                <InputOtpSlotCn Index="0" />
                                <InputOtpSlotCn Index="1" />
                                <InputOtpSlotCn Index="2" />
                            </InputOtpGroupCn>
                            <InputOtpSeparatorCn />
                            <InputOtpGroupCn>
                                <InputOtpSlotCn Index="3" />
                                <InputOtpSlotCn Index="4" />
                                <InputOtpSlotCn Index="5" />
                            </InputOtpGroupCn>
                        </InputOtpCn>
                    </div>

                    @if (_verifyError)
                    {
                        <p class="text-center text-sm text-destructive">
                            Invalid code. Please try again.
                        </p>
                    }

                    <p class="text-center text-sm text-muted-foreground">
                        Code refreshes every 30 seconds
                    </p>
                </div>

                <div class="flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _step = "scan")">Back</ButtonCn>
                    <ButtonCn Disabled="@(_otp.Length != 6)" @onclick="@HandleVerify">Verify</ButtonCn>
                </div>
            }

            @if (_step == "backup")
            {
                <div class="space-y-1.5">
                    <h3 class="flex items-center gap-2 text-lg font-semibold leading-none tracking-tight">
                        <LucideKeyCn Size="20" Class="size-5" />
                        Save Backup Codes
                    </h3>
                    <p class="text-sm text-muted-foreground">
                        Store these codes safely. Use them to access your account if you lose your authenticator.
                    </p>
                </div>

                <div class="space-y-4 py-4">
                    <div class="grid grid-cols-2 gap-2 rounded-lg border bg-muted/30 p-4">
                        @foreach (var backupCode in _backupCodes)
                        {
                            <code class="py-1 text-center font-mono text-sm">@backupCode</code>
                        }
                    </div>

                    <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                        <LucideDownloadCn Size="16" Class="mr-2 size-4" />
                        Download Backup Codes
                    </ButtonCn>

                    <AlertCn>
                        <LucideAlertTriangleCn Size="16" Class="size-4" />
                        <AlertDescriptionCn>
                            Each code can only be used once. Keep them somewhere safe.
                        </AlertDescriptionCn>
                    </AlertCn>
                </div>

                <div class="flex justify-end">
                    <ButtonCn Class="w-full" @onclick="@(() => _step = "complete")">
                        I've Saved My Codes
                    </ButtonCn>
                </div>
            }

            @if (_step == "complete")
            {
                <div class="text-center">
                    <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-primary/10">
                        <LucideCheckCn Size="24" Class="size-6 text-primary" />
                    </div>
                    <h3 class="text-lg font-semibold leading-none tracking-tight">Two-Factor Enabled</h3>
                    <p class="mt-1.5 text-sm text-muted-foreground">
                        Your account is now protected with two-factor authentication.
                    </p>
                </div>

                <div class="py-4">
                    <div class="space-y-2 rounded-lg border p-4">
                        <div class="flex items-center gap-2 text-sm">
                            <LucideCheckCn Size="16" Class="size-4 text-primary" />
                            <span>Authenticator app configured</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm">
                            <LucideCheckCn Size="16" Class="size-4 text-primary" />
                            <span>8 backup codes saved</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm">
                            <LucideCheckCn Size="16" Class="size-4 text-primary" />
                            <span>Account security enhanced</span>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end">
                    <ButtonCn Class="w-full" @onclick="@HandleClose">Done</ButtonCn>
                </div>
            }
        </div>
    </div>
}

@code {
    private bool _open;
    private string _step = "scan";
    private string _otp = "";
    private bool _copied;
    private bool _showSecret;
    private bool _verifyError;

    private const string _secretKey = "JBSWY3DPEHPK3PXP";

    private static readonly string[] _backupCodes =
    [
        "A1B2-C3D4", "E5F6-G7H8", "I9J0-K1L2", "M3N4-O5P6",
        "Q7R8-S9T0", "U1V2-W3X4", "Y5Z6-A7B8", "C9D0-E1F2",
    ];

    private void HandleVerify()
    {
        if (_otp.Length == 6)
        {
            _verifyError = false;
            _step = "backup";
        }
        else
        {
            _verifyError = true;
        }
    }

    private void HandleClose()
    {
        _open = false;
        _step = "scan";
        _otp = "";
        _copied = false;
        _showSecret = false;
        _verifyError = false;
    }
}
