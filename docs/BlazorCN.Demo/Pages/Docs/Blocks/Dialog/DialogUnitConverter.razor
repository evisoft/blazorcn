@* ========================================
   Block: dialog-unit-converter
   Title: Dialog Unit Converter
   Description: Unit converter dialog with multiple categories, bidirectional conversion, common unit presets, and instant results
   Long Description: Two-factor authentication setup wizard with QR code display, authenticator app instructions, backup codes, and verification step
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideArrowLeftRightCn, LucideDropletsCn, LucideRulerCn, LucideScaleCn, LucideThermometerCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn
   Source: original/blocks/dialog/dialog-unit-converter.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideArrowLeftRightCn Class="mr-2 h-4 w-4" Size="16" />
                Unit Converter
            </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 384px">
        <DialogHeaderCn>
            <DialogTitleCn>Unit Converter</DialogTitleCn>
            <DialogDescriptionCn>Convert between units of measurement.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            @* Category Tabs *@
            <div class="grid grid-cols-4 gap-1">
                @foreach (var cat in _categories)
                {
                    <button
                        type="button"
                        class="@(Cn.Merge(
                            "flex flex-col items-center gap-1 rounded-md py-2 text-xs transition-colors",
                            _categoryId == cat.Id ? "bg-primary text-primary-foreground" : "hover:bg-muted"
                        ))"
                        @onclick="@(() => HandleCategoryChange(cat.Id))">
                        @if (cat.Id == "length")
                        {
                            <LucideRulerCn Class="h-4 w-4" Size="16" />
                        }
                        else if (cat.Id == "weight")
                        {
                            <LucideScaleCn Class="h-4 w-4" Size="16" />
                        }
                        else if (cat.Id == "temperature")
                        {
                            <LucideThermometerCn Class="h-4 w-4" Size="16" />
                        }
                        else
                        {
                            <LucideDropletsCn Class="h-4 w-4" Size="16" />
                        }
                        @cat.Name
                    </button>
                }
            </div>

            @* From *@
            <div class="space-y-2">
                <LabelCn class="text-sm">From</LabelCn>
                <div class="flex gap-2">
                    <InputCn
                        class="font-mono"
                        type="number"
                        Value="@_inputValue"
                        ValueChanged="@((string v) => _inputValue = v)" />
                    <SelectCn Value="@_fromUnitId" ValueChanged="@((string v) => { _fromUnitId = v; })">
                        <SelectTriggerCn class="w-24" aria-label="From unit">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var unit in CurrentCategory.Units)
                            {
                                <SelectItemCn Value="@unit.Id">
                                    @unit.Symbol
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            @* Swap Button *@
            <div class="flex justify-center">
                <ButtonCn class="h-8 w-8" @onclick="HandleSwapUnits" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Arrow left right">
                    <LucideArrowLeftRightCn Class="h-4 w-4" Size="16" />
                </ButtonCn>
            </div>

            @* To *@
            <div class="space-y-2">
                <LabelCn class="text-sm">To</LabelCn>
                <div class="flex gap-2">
                    <div class="flex-1 flex items-center h-9 px-3 border rounded-md bg-muted/50 font-mono tabular-nums">
                        @(string.IsNullOrEmpty(Result) ? "\u2014" : Result)
                    </div>
                    <SelectCn Value="@_toUnitId" ValueChanged="@((string v) => { _toUnitId = v; })">
                        <SelectTriggerCn class="w-24" aria-label="To unit">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var unit in CurrentCategory.Units)
                            {
                                <SelectItemCn Value="@unit.Id">
                                    @unit.Symbol
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            @* Result Summary *@
            @if (!string.IsNullOrEmpty(Result))
            {
                <p class="text-center text-sm text-muted-foreground">
                    @_inputValue @FromUnit.Symbol =
                    <span class="font-medium text-foreground">
                        @Result @ToUnit.Symbol
                    </span>
                </p>
            }
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private record UnitDef(string Id, string Name, string Symbol, double Factor);
    private record CategoryDef(string Id, string Name, UnitDef[] Units);

    private bool _open;
    private string _categoryId = "length";
    private string _fromUnitId = "km";
    private string _toUnitId = "mi";
    private string _inputValue = "1";

    private static readonly CategoryDef[] _categories =
    [
        new("length", "Length",
        [
            new("mm", "Millimeters", "mm", 0.001),
            new("cm", "Centimeters", "cm", 0.01),
            new("m", "Meters", "m", 1.0),
            new("km", "Kilometers", "km", 1000.0),
            new("in", "Inches", "in", 0.0254),
            new("ft", "Feet", "ft", 0.3048),
            new("mi", "Miles", "mi", 1609.344),
        ]),
        new("weight", "Weight",
        [
            new("g", "Grams", "g", 0.001),
            new("kg", "Kilograms", "kg", 1.0),
            new("lb", "Pounds", "lb", 0.453592),
            new("oz", "Ounces", "oz", 0.0283495),
        ]),
        new("temperature", "Temp",
        [
            new("c", "Celsius", "\u00b0C", 1.0),
            new("f", "Fahrenheit", "\u00b0F", 1.0),
            new("k", "Kelvin", "K", 1.0),
        ]),
        new("volume", "Volume",
        [
            new("ml", "Milliliters", "mL", 0.001),
            new("l", "Liters", "L", 1.0),
            new("gal", "Gallons", "gal", 3.78541),
            new("cup", "Cups", "cup", 0.236588),
        ]),
    ];

    private CategoryDef CurrentCategory => _categories.FirstOrDefault(c => c.Id == _categoryId) ?? _categories[0];
    private UnitDef FromUnit => CurrentCategory.Units.FirstOrDefault(u => u.Id == _fromUnitId) ?? CurrentCategory.Units[0];
    private UnitDef ToUnit => CurrentCategory.Units.FirstOrDefault(u => u.Id == _toUnitId) ?? CurrentCategory.Units[^1];

    private string Result
    {
        get
        {
            if (!double.TryParse(_inputValue, out var value)) return "";
            var baseValue = value * FromUnit.Factor;
            var converted = baseValue / ToUnit.Factor;
            return converted.ToString("G6");
        }
    }

    private void HandleCategoryChange(string newCategory)
    {
        _categoryId = newCategory;
        var cat = _categories.FirstOrDefault(c => c.Id == newCategory);
        if (cat != null)
        {
            _fromUnitId = cat.Units[0].Id;
            _toUnitId = cat.Units.Length > 1 ? cat.Units[1].Id : cat.Units[0].Id;
        }
        _inputValue = "1";
    }

    private void HandleSwapUnits()
    {
        (_fromUnitId, _toUnitId) = (_toUnitId, _fromUnitId);
        if (!string.IsNullOrEmpty(Result))
        {
            _inputValue = Result;
        }
    }
}
