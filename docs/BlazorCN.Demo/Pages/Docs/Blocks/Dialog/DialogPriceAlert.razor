@* ========================================
   Block: dialog-price-alert
   Title: Dialog Price Alert
   Description: Price alert dialog with target price input, comparison operators, notification channel selection, and expiration date
   Dependencies: ButtonCn, CheckboxCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideBellCn, LucideCalendarCn, LucideCheckCn, LucideDollarSignCn, LucideMailCn, LucideMessageSquareCn, LucideSmartphoneCn, LucideTrendingDownCn, LucideTrendingUpCn, RadioGroupCn, RadioGroupItemCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn
   Source: original/blocks/dialog/dialog-price-alert.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideBellCn Class="mr-2 h-4 w-4" Size="16" />
                Set Price Alert
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        @if (_saved)
        {
            <DialogHeaderCn Class="text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 mb-4">
                    <LucideCheckCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <DialogTitleCn>Alert Created</DialogTitleCn>
                <DialogDescriptionCn>
                    We'll notify you when the price goes @_condition $@_targetPrice.
                </DialogDescriptionCn>
            </DialogHeaderCn>
            <DialogFooterCn>
                <ButtonCn Class="w-full" @onclick="HandleClose">Done</ButtonCn>
            </DialogFooterCn>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn Class="flex items-center gap-2">
                    <LucideBellCn Class="h-5 w-5" Size="20" />
                    Set Price Alert
                </DialogTitleCn>
                <DialogDescriptionCn>Get notified when the price reaches your target.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-4 py-4">
                <div class="flex items-center justify-between p-3 rounded-lg border bg-muted/30">
                    <span class="text-sm text-muted-foreground">Current price</span>
                    <span class="text-lg font-semibold">$@CurrentPrice</span>
                </div>

                <div class="space-y-3">
                    <LabelCn>Alert me when price goes</LabelCn>
                    <RadioGroupCn Class="grid grid-cols-2 gap-3" Value="@_condition" ValueChanged="@(v => _condition = v)">
                        <LabelCn Class="@Cn.Merge("flex items-center gap-3 rounded-lg border p-3 cursor-pointer transition-colors", _condition == "below" ? "border-primary bg-primary/5" : "")"
                                 For="below">
                            <RadioGroupItemCn Id="below" Value="below" />
                            <LucideTrendingDownCn Class="h-4 w-4 text-primary" Size="16" />
                            <span class="font-medium">Below</span>
                        </LabelCn>
                        <LabelCn Class="@Cn.Merge("flex items-center gap-3 rounded-lg border p-3 cursor-pointer transition-colors", _condition == "above" ? "border-primary bg-primary/5" : "")"
                                 For="above">
                            <RadioGroupItemCn Id="above" Value="above" />
                            <LucideTrendingUpCn Class="h-4 w-4 text-primary" Size="16" />
                            <span class="font-medium">Above</span>
                        </LabelCn>
                    </RadioGroupCn>
                </div>

                <div class="space-y-2">
                    <LabelCn For="target-price">Target price</LabelCn>
                    <div class="relative">
                        <LucideDollarSignCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                        <InputCn Class="pl-9" Id="target-price" Type="number" Placeholder="0.00"
                                 Value="@_targetPrice" ValueChanged="@(v => _targetPrice = v)" />
                    </div>
                    @if (PriceDiff is not null)
                    {
                        <p class="@Cn.Merge("text-xs", PriceDiffValue < 0 ? "text-primary" : "text-muted-foreground")">
                            @(PriceDiffValue < 0 ? "\u2193" : "\u2191") @(Math.Abs(PriceDiffValue).ToString("F1"))% from current price
                        </p>
                    }
                </div>

                <div class="space-y-3">
                    <LabelCn>Notify me via</LabelCn>
                    <div class="space-y-2">
                        @foreach (var channel in _notificationChannels)
                        {
                            <LabelCn Class="@Cn.Merge("flex items-center gap-3 rounded-lg border p-3 cursor-pointer transition-colors", _channels.Contains(channel.Id) ? "border-primary bg-primary/5" : "")"
                                     For="@channel.Id">
                                <CheckboxCn Checked="@_channels.Contains(channel.Id)"
                                            CheckedChanged="@(v => HandleChannelToggle(channel.Id))"
                                            Id="@channel.Id" />
                                @if (channel.Id == "email")
                                {
                                    <LucideMailCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                }
                                else if (channel.Id == "push")
                                {
                                    <LucideSmartphoneCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                }
                                else
                                {
                                    <LucideMessageSquareCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                }
                                <div class="flex-1">
                                    <span class="font-medium">@channel.Label</span>
                                    <p class="text-xs text-muted-foreground">@channel.Description</p>
                                </div>
                            </LabelCn>
                        }
                    </div>
                </div>

                <div class="space-y-2">
                    <LabelCn For="expiration">Alert expires in</LabelCn>
                    <SelectCn Value="@_expiration" ValueChanged="@(v => _expiration = v)">
                        <SelectTriggerCn Id="expiration">
                            <LucideCalendarCn Class="mr-2 h-4 w-4 text-muted-foreground" Size="16" />
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var option in _expirationOptions)
                            {
                                <SelectItemCn Value="@option.Value">@option.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            <DialogFooterCn Class="gap-2 sm:gap-0">
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">Cancel</ButtonCn>
                <ButtonCn Disabled="@(!IsValid)" @onclick="@(() => _saved = true)">Create Alert</ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record NotificationChannel(string Id, string Label, string Description);
    private record ExpirationOption(string Value, string Label);

    private static readonly NotificationChannel[] _notificationChannels =
    [
        new("email", "Email", "Get notified via email"),
        new("push", "Push", "Mobile push notification"),
        new("sms", "SMS", "Text message alert")
    ];

    private static readonly ExpirationOption[] _expirationOptions =
    [
        new("7", "7 days"), new("30", "30 days"), new("90", "90 days"), new("never", "Never")
    ];

    private bool _open;
    private bool _saved;
    private string _targetPrice = "";
    private string _condition = "below";
    private List<string> _channels = ["email"];
    private string _expiration = "30";

    private const decimal CurrentPrice = 149.99m;

    private bool IsValidPrice => decimal.TryParse(_targetPrice, out var p) && p > 0;
    private bool IsValid => IsValidPrice && _channels.Count > 0;

    private double? PriceDiff => IsValidPrice
        ? (double)((decimal.Parse(_targetPrice) - CurrentPrice) / CurrentPrice * 100)
        : null;

    private double PriceDiffValue => PriceDiff ?? 0;

    private void HandleChannelToggle(string channelId)
    {
        if (_channels.Contains(channelId))
            _channels.Remove(channelId);
        else
            _channels.Add(channelId);
    }

    private void HandleClose()
    {
        _open = false;
        _saved = false;
        _targetPrice = "";
        _condition = "below";
        _channels = ["email"];
        _expiration = "30";
    }
}
