@* ========================================
   Block: dialog-gift-card
   Title: Dialog Gift Card
   Description: Gift card dialog with preset amounts, custom value input, recipient details, personal message, and delivery options
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCheckCn, LucideGiftCn, LucideMailCn, LucideSparklesCn, LucideUserCn, RadioGroupCn, RadioGroupItemCn, SeparatorCn, TextareaCn
   Source: original/blocks/dialog/dialog-gift-card.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideGiftCn Class="mr-2 h-4 w-4" Size="16" />
                Send Gift Card
            </DialogTriggerCn>
    </div>
    <DialogContentCn class="sm:max-w-md">
        @if (_saved)
        {
            <DialogHeaderCn class="text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 mb-4">
                    <LucideCheckCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <DialogTitleCn>Gift Card Sent!</DialogTitleCn>
                <DialogDescriptionCn>
                    A $@FinalAmount gift card
                    @(_deliveryOption == "now" ? "has been sent" : $"will be sent on {_scheduledDate:ddd, MMM d}")
                    to @_recipientEmail.
                </DialogDescriptionCn>
            </DialogHeaderCn>
            <div class="flex justify-center py-4">
                <div class="rounded-lg border bg-gradient-to-br from-primary/5 to-primary/10 p-6 text-center">
                    <LucideSparklesCn Class="h-8 w-8 mx-auto mb-2 text-primary" Size="32" />
                    <p class="text-2xl font-bold">$@FinalAmount</p>
                    <p class="text-sm text-muted-foreground">Gift Card</p>
                </div>
            </div>
            <DialogFooterCn>
                <ButtonCn Class="w-full" @onclick="HandleClose">Done</ButtonCn>
            </DialogFooterCn>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn class="flex items-center gap-2">
                    <LucideGiftCn Class="h-5 w-5" Size="20" />
                    Send a Gift Card
                </DialogTitleCn>
                <DialogDescriptionCn>Choose an amount and personalize your gift.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-4 py-4">
                <div class="space-y-3">
                    <LabelCn>Select amount</LabelCn>
                    <div class="grid grid-cols-3 gap-2">
                        @foreach (var amount in _presetAmounts)
                        {
                            <button type="button"
                                    class="@Cn.Merge("rounded-lg border p-3 text-center transition-colors", _selectedAmount == amount ? "border-primary bg-primary/5 text-primary font-semibold" : "hover:border-muted-foreground/50")"
                                    @onclick="@(() => HandleAmountSelect(amount))">
                                $@amount
                            </button>
                        }
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-sm text-muted-foreground">or</span>
                        <div class="relative flex-1">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">$</span>
                            <InputCn Class="pl-7" type="number" Placeholder="Custom amount"
                                     Value="@_customAmount"
                                     ValueChanged="@((string v) => HandleCustomAmountChange(v))" />
                        </div>
                    </div>
                    <p class="text-xs text-muted-foreground">Min $10 &middot; Max $500</p>
                </div>

                <SeparatorCn />

                <div class="space-y-3">
                    <LabelCn>Recipient details</LabelCn>
                    <div class="space-y-2">
                        <div class="relative">
                            <LucideUserCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                            <InputCn Class="pl-9" Placeholder="Recipient's name" @bind-Value="_recipientName" />
                        </div>
                        <div class="relative">
                            <LucideMailCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                            <InputCn Class="pl-9" Placeholder="Recipient's email" type="email" @bind-Value="_recipientEmail" />
                        </div>
                    </div>
                </div>

                <div class="space-y-2">
                    <LabelCn For="message">Personal message (optional)</LabelCn>
                    <TextareaCn Class="h-20 resize-none" id="message" Placeholder="Add a personal note..." @bind-Value="_message" />
                    <p class="text-xs text-muted-foreground text-right">@(_message.Length)/200</p>
                </div>

                <div class="space-y-3">
                    <LabelCn>Delivery</LabelCn>
                    <RadioGroupCn Class="grid grid-cols-2 gap-3" Value="@_deliveryOption" ValueChanged="@((string v) => _deliveryOption = v)">
                        <LabelCn Class="@Cn.Merge("flex items-center gap-2 rounded-lg border p-3 cursor-pointer transition-colors", _deliveryOption == "now" ? "border-primary bg-primary/5" : "")" For="now">
                            <RadioGroupItemCn Id="now" Value="now" />
                            <span class="text-sm font-medium">Send now</span>
                        </LabelCn>
                        <LabelCn Class="@Cn.Merge("flex items-center gap-2 rounded-lg border p-3 cursor-pointer transition-colors", _deliveryOption == "scheduled" ? "border-primary bg-primary/5" : "")" For="scheduled">
                            <RadioGroupItemCn Id="scheduled" Value="scheduled" />
                            <span class="text-sm font-medium">Schedule</span>
                        </LabelCn>
                    </RadioGroupCn>

                    @if (_deliveryOption == "scheduled")
                    {
                        <InputCn type="date" @bind-Value="_scheduledDateStr" />
                    }
                </div>
            </div>

            <DialogFooterCn class="gap-2 sm:gap-0">
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">Cancel</ButtonCn>
                <ButtonCn Disabled="@(!IsValid)" @onclick="HandleSave">
                    Purchase $@(FinalAmount ?? 0)
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private static readonly int[] _presetAmounts = [25, 50, 75, 100, 150, 200];

    private bool _open;
    private bool _saved;
    private int? _selectedAmount = 50;
    private string _customAmount = "";
    private string _recipientName = "";
    private string _recipientEmail = "";
    private string _message = "";
    private string _deliveryOption = "now";
    private string _scheduledDateStr = "";
    private DateTime? _scheduledDate => DateTime.TryParse(_scheduledDateStr, out var d) ? d : null;

    private int? FinalAmount => !string.IsNullOrEmpty(_customAmount) && int.TryParse(_customAmount, out var ca) ? ca : _selectedAmount;

    private bool IsValidEmail => _recipientEmail.Contains('@') && _recipientEmail.Contains('.');
    private bool IsValidAmount => FinalAmount.HasValue && FinalAmount >= 10 && FinalAmount <= 500;
    private bool IsValid => IsValidAmount && !string.IsNullOrWhiteSpace(_recipientName) && IsValidEmail &&
                           (_deliveryOption == "now" || _scheduledDate != null);

    private void HandleAmountSelect(int amount)
    {
        _selectedAmount = amount;
        _customAmount = "";
    }

    private void HandleCustomAmountChange(string value)
    {
        _customAmount = value;
        if (!string.IsNullOrEmpty(value))
            _selectedAmount = null;
    }

    private void HandleSave() => _saved = true;

    private void HandleClose()
    {
        _open = false;
        _saved = false;
        _selectedAmount = 50;
        _customAmount = "";
        _recipientName = "";
        _recipientEmail = "";
        _message = "";
        _deliveryOption = "now";
        _scheduledDateStr = "";
    }
}
