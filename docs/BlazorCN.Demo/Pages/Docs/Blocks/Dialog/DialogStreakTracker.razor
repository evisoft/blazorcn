@* ========================================
   Block: dialog-streak-tracker
   Title: Dialog Streak Tracker
   Description: Streak tracker dialog with daily progress, current streak count, and milestone celebrations
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCheckCn, LucideFlameCn
   Source: original/blocks/dialog/dialog-streak-tracker.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideFlameCn Class="mr-2 h-4 w-4" Size="16" />
                View Streak
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 384px;">
        @if (_checkedIn)
        {
            <div class="flex flex-col items-center justify-center py-6 text-center">
                <div class="text-5xl">&#128293;</div>
                <h3 class="mt-4 text-lg font-medium">@(CurrentStreak + 1) Day Streak!</h3>
                <p class="mt-1 text-sm text-muted-foreground">You're on fire. Keep it going!</p>
                <ButtonCn Class="mt-6" @onclick="HandleClose">
                    Done
                </ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn Class="text-center">
                <DialogTitleCn Class="flex items-center justify-center gap-2">
                    <LucideFlameCn Class="h-5 w-5 text-primary" Size="20" />
                    @CurrentStreak Day Streak
                </DialogTitleCn>
                <DialogDescriptionCn>Check in to keep your streak alive</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="py-6">
                @* Week grid *@
                <div class="flex justify-between">
                    @for (var i = 0; i < _weekDays.Length; i++)
                    {
                        var index = i;
                        var isToday = index == TodayIndex;
                        var isCompleted = _completedDays[index];
                        var isFuture = index > TodayIndex;

                        <div class="flex flex-col items-center gap-2">
                            <span class="text-xs text-muted-foreground">@_weekDays[index]</span>
                            <div class="@Cn.Merge(
                                "h-9 w-9 rounded-full flex items-center justify-center text-sm",
                                isCompleted ? "bg-primary text-primary-foreground" : "",
                                isToday && !isCompleted ? "border-2 border-primary" : "",
                                isFuture ? "bg-muted text-muted-foreground" : "",
                                !isCompleted && !isToday && !isFuture ? "bg-muted" : "")">
                                @if (isCompleted)
                                {
                                    <LucideCheckCn Class="h-4 w-4" Size="16" />
                                }
                                else
                                {
                                    <span class="@(isToday ? "text-primary font-medium" : "")">@(index + 1)</span>
                                }
                            </div>
                        </div>
                    }
                </div>

                @* Milestone *@
                <div class="mt-6 p-3 rounded-md border text-center">
                    <p class="text-xs text-muted-foreground">Next milestone</p>
                    <p class="font-medium">14 days</p>
                    <p class="text-xs text-muted-foreground">2 days to go</p>
                </div>
            </div>

            <DialogFooterCn>
                <ButtonCn Class="w-full" @onclick="HandleCheckIn">
                    Check In Today
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _checkedIn;

    private static readonly string[] _weekDays = ["M", "T", "W", "T", "F", "S", "S"];
    private static readonly bool[] _completedDays = [true, true, true, true, true, false, false];
    private const int CurrentStreak = 12;
    private const int TodayIndex = 5;

    private void HandleCheckIn() => _checkedIn = true;

    private void HandleClose()
    {
        _open = false;
        _checkedIn = false;
    }
}
