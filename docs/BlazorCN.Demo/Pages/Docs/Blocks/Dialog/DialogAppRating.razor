@* ========================================
   Block: dialog-app-rating
   Title: Dialog App Rating
   Description: App rating prompt dialog with star rating selector, feedback textarea, conditional flows for positive and negative ratings, and store redirect
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, TextareaCn, LucideExternalLinkCn, LucideStarCn
   Source: original/blocks/dialog/dialog-app-rating.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideStarCn Class="mr-2 h-4 w-4" Size="16" />
                Rate Our App
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        @if (_step == "rating")
        {
            <DialogHeaderCn Class="text-center">
                <DialogTitleCn>Enjoying the app?</DialogTitleCn>
                <DialogDescriptionCn>
                    Your feedback helps us improve. How would you rate your experience?
                </DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="py-6">
                <div class="flex justify-center gap-1">
                    @for (var star = 1; star <= 5; star++)
                    {
                        var s = star;
                        <button type="button" class="p-1 transition-transform hover:scale-110"
                                @onclick="@(() => HandleRatingSelect(s))"
                                @onmouseover="@(() => _hoveredRating = s)"
                                @onmouseout="@(() => _hoveredRating = 0)">
                            <LucideStarCn Class="@Cn.Merge("h-10 w-10 transition-colors", s <= DisplayRating ? "fill-primary text-primary" : "text-muted-foreground/30")" Size="40" />
                        </button>
                    }
                </div>
                <p class="text-center text-sm text-muted-foreground mt-3 h-5">
                    @(DisplayRating > 0 ? _ratingLabels[DisplayRating] : "Tap a star to rate")
                </p>
            </div>

            <DialogFooterCn Class="flex-col gap-2 sm:flex-col">
                <ButtonCn Class="w-full" @onclick="HandleClose" Variant="ButtonVariant.Ghost">Maybe Later</ButtonCn>
            </DialogFooterCn>
        }

        @if (_step == "positive")
        {
            <DialogHeaderCn Class="text-center">
                <DialogTitleCn>We're glad you love it!</DialogTitleCn>
                <DialogDescriptionCn>
                    Would you mind leaving us a review? It really helps other people discover our app.
                </DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="flex justify-center py-4">
                <div class="flex gap-0.5">
                    @for (var star = 1; star <= 5; star++)
                    {
                        <LucideStarCn Class="@Cn.Merge("h-6 w-6", star <= _rating ? "fill-primary text-primary" : "text-muted-foreground/30")" Size="24" />
                    }
                </div>
            </div>

            <DialogFooterCn Class="flex-col gap-2 sm:flex-col">
                <ButtonCn Class="w-full" @onclick="@(() => _step = "thanks")">
                    <LucideExternalLinkCn Class="mr-2 h-4 w-4" Size="16" />
                    Leave a Review
                </ButtonCn>
                <ButtonCn Class="w-full" @onclick="HandleClose" Variant="ButtonVariant.Ghost">No Thanks</ButtonCn>
            </DialogFooterCn>
        }

        @if (_step == "negative")
        {
            <DialogHeaderCn Class="text-center">
                <DialogTitleCn>We'd love your feedback</DialogTitleCn>
                <DialogDescriptionCn>
                    We're sorry to hear that. What can we do better?
                </DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="py-4 space-y-3">
                <div class="flex justify-center">
                    <div class="flex gap-0.5">
                        @for (var star = 1; star <= 5; star++)
                        {
                            <LucideStarCn Class="@Cn.Merge("h-5 w-5", star <= _rating ? "fill-primary text-primary" : "text-muted-foreground/30")" Size="20" />
                        }
                    </div>
                </div>
                <div class="space-y-2">
                    <LabelCn For="feedback">Your feedback</LabelCn>
                    <TextareaCn Class="h-24 resize-none" Id="feedback"
                                Value="@_feedback" ValueChanged="@((string v) => _feedback = v)"
                                Placeholder="Tell us what we can improve..." />
                </div>
            </div>

            <DialogFooterCn Class="flex-col gap-2 sm:flex-col">
                <ButtonCn Class="w-full" Disabled="@(string.IsNullOrWhiteSpace(_feedback))" @onclick="@(() => _step = "thanks")">
                    Submit Feedback
                </ButtonCn>
                <ButtonCn Class="w-full" @onclick="HandleClose" Variant="ButtonVariant.Ghost">Skip</ButtonCn>
            </DialogFooterCn>
        }

        @if (_step == "thanks")
        {
            <DialogHeaderCn Class="text-center">
                <DialogTitleCn>Thank you!</DialogTitleCn>
                <DialogDescriptionCn>
                    @(_rating >= 4
                        ? "Your support means the world to us. Thank you for helping others discover our app!"
                        : "Your feedback helps us build a better product. We'll work hard to improve your experience.")
                </DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="flex justify-center py-4">
                <div class="flex gap-0.5">
                    @for (var star = 1; star <= 5; star++)
                    {
                        <LucideStarCn Class="@Cn.Merge("h-6 w-6", star <= _rating ? "fill-primary text-primary" : "text-muted-foreground/30")" Size="24" />
                    }
                </div>
            </div>

            <DialogFooterCn>
                <ButtonCn Class="w-full" @onclick="HandleClose">Done</ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _step = "rating";
    private int _rating;
    private int _hoveredRating;
    private string _feedback = "";

    private static readonly string[] _ratingLabels = ["", "Very Poor", "Poor", "Okay", "Good", "Excellent"];

    private int DisplayRating => _hoveredRating > 0 ? _hoveredRating : _rating;

    private void HandleRatingSelect(int selectedRating)
    {
        _rating = selectedRating;
        _step = selectedRating >= 4 ? "positive" : "negative";
    }

    private void HandleClose()
    {
        _open = false;
        _step = "rating";
        _rating = 0;
        _hoveredRating = 0;
        _feedback = "";
    }
}
