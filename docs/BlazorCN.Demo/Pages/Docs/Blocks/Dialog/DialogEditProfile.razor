<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn>Edit Profile</ButtonCn>
        </DialogTriggerCn>
    </div>

    <DialogContentCn class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn>Edit Profile</DialogTitleCn>
            <DialogDescriptionCn>
                Make changes to your profile here. Click save when you're done.
            </DialogDescriptionCn>
        </DialogHeaderCn>
        <div class="space-y-2">
            <LabelCn Class="text-sm font-medium" For="username">
                Username
            </LabelCn>
            <InputCn id="username" name="username" Placeholder="Your username" type="text" />
        </div>
        <DialogFooterCn>
            <ButtonCn Class="w-full" type="submit">
                Save Changes
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
}
