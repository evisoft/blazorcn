@* ========================================
   Block: dialog-forgot-password
   Title: Dialog Forgot Password
   Description: Forgot password dialog with email input, reset link sending, and success confirmation for password recovery flow
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideArrowLeftCn, LucideCheckCn, LucideKeyRoundCn, LucideLoader2Cn, LucideMailCn, LucideSendCn
   Source: original/blocks/dialog/dialog-forgot-password.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideKeyRoundCn Class="mr-2 h-4 w-4" Size="16" />
                Forgot Password
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn class="sm:max-w-md">
        @if (_isSent)
        {
            <div class="flex flex-col items-center justify-center py-6 text-center">
                <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-primary">
                    <LucideCheckCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <h3 class="mt-4 text-lg font-semibold">Check your email</h3>
                <p class="mt-2 text-sm text-muted-foreground">
                    We've sent a password reset link to
                </p>
                <p class="mt-1 font-medium">@_email</p>

                <div class="mt-6 w-full space-y-3">
                    <div class="rounded-lg border p-4 text-left">
                        <p class="text-sm text-muted-foreground">
                            <span class="font-medium text-foreground">Didn't receive the email?</span>
                            Check your spam folder, or
                            <ButtonCn Class="h-auto p-0 text-sm" Disabled="_isLoading" Variant="ButtonVariant.Link" @onclick="HandleResend">
                                @(_isLoading ? "Sending..." : "click here to resend")
                            </ButtonCn>
                        </p>
                    </div>

                    <p class="text-xs text-muted-foreground">
                        The link will expire in 15 minutes for security reasons.
                    </p>
                </div>

                <ButtonCn Class="mt-6" Variant="ButtonVariant.Outline" @onclick="HandleBackToLogin">
                    <LucideArrowLeftCn Class="mr-2 h-4 w-4" Size="16" />
                    Back to login
                </ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn class="text-center">
                <div class="flex justify-center mb-2">
                    <div class="flex h-12 w-12 items-center justify-center rounded-full border">
                        <LucideKeyRoundCn Class="h-6 w-6" Size="24" />
                    </div>
                </div>
                <DialogTitleCn>Forgot your password?</DialogTitleCn>
                <DialogDescriptionCn>No worries, we'll send you reset instructions.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-4 py-4">
                <div class="space-y-2">
                    <LabelCn For="reset-email">Email address</LabelCn>
                    <div class="relative">
                        <LucideMailCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                        <InputCn Class="pl-9"
                                 Disabled="_isLoading"
                                 id="reset-email"
                                 Placeholder="you@example.com"
                                 type="email"
                                 @bind-Value="_email" />
                    </div>
                    <p class="text-xs text-muted-foreground">
                        Enter the email address associated with your account.
                    </p>
                </div>

                <ButtonCn Class="w-full" Disabled="@(!IsValidEmail || _isLoading)" @onclick="HandleSubmit">
                    @if (_isLoading)
                    {
                        <LucideLoader2Cn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                        <span>Sending link...</span>
                    }
                    else
                    {
                        <LucideSendCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Send reset link</span>
                    }
                </ButtonCn>
            </div>

            <div class="flex items-center justify-center pt-2 border-t">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="HandleBackToLogin">
                    <LucideArrowLeftCn Class="mr-2 h-4 w-4" Size="16" />
                    Back to login
                </ButtonCn>
            </div>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _email = "";
    private bool _isLoading;
    private bool _isSent;

    private bool IsValidEmail => _email.Contains('@') && _email.Contains('.');

    private async Task HandleSubmit()
    {
        if (!IsValidEmail) return;

        _isLoading = true;
        StateHasChanged();
        await Task.Delay(1500);
        _isLoading = false;
        _isSent = true;
    }

    private async Task HandleResend()
    {
        _isLoading = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isLoading = false;
    }

    private void HandleBackToLogin()
    {
        _open = false;
        _email = "";
        _isSent = false;
    }
}
