@* ========================================
   Block: dialog-feature-request
   Title: Dialog Feature Request
   Description: Feature request dialog with title, description, category selection, priority voting, and submission confirmation
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCheckCn, LucideLightbulbCn, LucideLoader2Cn, LucideSendCn, RadioGroupCn, RadioGroupItemCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SeparatorCn, TextareaCn
   Source: original/blocks/dialog/dialog-feature-request.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideLightbulbCn Class="mr-2 h-4 w-4" Size="16" />
                Request Feature
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn class="sm:max-w-lg">
        @if (_isSubmitted)
        {
            <div class="flex flex-col items-center justify-center py-8 text-center">
                <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-primary">
                    <LucideCheckCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <h3 class="mt-4 text-lg font-semibold">Request Submitted!</h3>
                <p class="mt-1 text-sm text-muted-foreground">
                    Thank you for your feedback. We've received your feature request.
                </p>
                <div class="mt-4 rounded-lg border p-3">
                    <p class="text-xs text-muted-foreground">Tracking ID</p>
                    <p class="font-mono font-semibold">@_ticketId</p>
                </div>
                @if (!string.IsNullOrEmpty(_email))
                {
                    <p class="mt-4 text-xs text-muted-foreground">We'll send updates to @_email</p>
                }
                <ButtonCn Class="mt-6" @onclick="HandleClose">
                    Done
                </ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn class="flex items-center gap-2">
                    <LucideLightbulbCn Class="h-5 w-5" Size="20" />
                    Request a Feature
                </DialogTitleCn>
                <DialogDescriptionCn>Share your ideas to help us improve the product.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-4 py-4">
                <div class="space-y-2">
                    <LabelCn For="feature-title">
                        Feature Title <span class="text-destructive">*</span>
                    </LabelCn>
                    <InputCn id="feature-title" Placeholder="Brief title for your feature request" @bind-Value="_title" />
                    @if (!string.IsNullOrEmpty(_title) && _title.Length < 5)
                    {
                        <p class="text-xs text-muted-foreground">Title should be at least 5 characters</p>
                    }
                </div>

                <div class="space-y-2">
                    <LabelCn>
                        Category <span class="text-destructive">*</span>
                    </LabelCn>
                    <SelectCn Value="@_category" ValueChanged="@((string v) => _category = v)">
                        <SelectTriggerCn>
                            <SelectValueCn Placeholder="Select a category" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="feature">New Feature</SelectItemCn>
                            <SelectItemCn Value="improvement">Improvement</SelectItemCn>
                            <SelectItemCn Value="integration">Integration</SelectItemCn>
                            <SelectItemCn Value="bug">Bug Fix</SelectItemCn>
                            <SelectItemCn Value="other">Other</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <div class="space-y-2">
                    <LabelCn For="feature-description">
                        Description <span class="text-destructive">*</span>
                    </LabelCn>
                    <TextareaCn id="feature-description"
                                Placeholder="Describe the feature, the problem it solves, and how you'd use it..."
                                Rows="4"
                                @bind-Value="_description" />
                    <div class="flex items-center justify-between">
                        <p class="text-xs text-muted-foreground">
                            @(_description.Length < 20 ? $"At least {20 - _description.Length} more characters needed" : "Good description length")
                        </p>
                        <span class="text-xs text-muted-foreground">@(_description.Length)/500</span>
                    </div>
                </div>

                <SeparatorCn />

                <div class="space-y-2">
                    <LabelCn>How important is this to you?</LabelCn>
                    <RadioGroupCn Class="flex gap-4" Value="@_impact" ValueChanged="@((string v) => _impact = v)">
                        @foreach (var option in _impactOptions)
                        {
                            <label for="@($"impact-{option.Value}")"
                                   class="@Cn.Merge("flex items-center gap-2 rounded-lg border px-3 py-2 cursor-pointer transition-colors", _impact == option.Value ? "border-primary" : "hover:border-primary/50")">
                                <RadioGroupItemCn Id="@($"impact-{option.Value}")" Value="@option.Value" />
                                <span class="text-xs">@option.Label</span>
                            </label>
                        }
                    </RadioGroupCn>
                </div>

                <div class="space-y-2">
                    <LabelCn For="feature-email">
                        Email
                        <BadgeCn Class="ml-2 text-xs" Variant="BadgeVariant.Secondary">Optional</BadgeCn>
                    </LabelCn>
                    <InputCn id="feature-email" Placeholder="your@email.com" type="email" @bind-Value="_email" />
                    <p class="text-xs text-muted-foreground">
                        Get notified when this feature is implemented
                    </p>
                </div>
            </div>

            <DialogFooterCn>
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">
                    Cancel
                </ButtonCn>
                <ButtonCn Disabled="@(!IsValid || _isSubmitting)" @onclick="HandleSubmit">
                    @if (_isSubmitting)
                    {
                        <LucideLoader2Cn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                        <span>Submitting...</span>
                    }
                    else
                    {
                        <LucideSendCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Submit Request</span>
                    }
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record ImpactOption(string Value, string Label);

    private static readonly ImpactOption[] _impactOptions =
    [
        new("low", "Nice to have"),
        new("medium", "Important"),
        new("high", "Very important"),
        new("critical", "Critical"),
    ];

    private bool _open;
    private string _title = "";
    private string _description = "";
    private string _category = "";
    private string _impact = "medium";
    private string _email = "";
    private bool _isSubmitting;
    private bool _isSubmitted;
    private string _ticketId = "";

    private bool IsValid =>
        _title.Trim().Length >= 5 &&
        _description.Trim().Length >= 20 &&
        !string.IsNullOrEmpty(_category);

    private async Task HandleSubmit()
    {
        if (!IsValid) return;

        _isSubmitting = true;
        StateHasChanged();
        await Task.Delay(1500);

        _ticketId = $"FR-{Guid.NewGuid().ToString("N")[..6].ToUpperInvariant()}";
        _isSubmitting = false;
        _isSubmitted = true;
    }

    private void HandleClose()
    {
        _open = false;
        _title = "";
        _description = "";
        _category = "";
        _impact = "medium";
        _email = "";
        _isSubmitted = false;
        _ticketId = "";
    }
}
