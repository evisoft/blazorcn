@* ========================================
   Block: dialog-emoji-picker
   Title: Dialog Emoji Picker
   Description: Emoji picker dialog with categorized grid, search functionality, skin tone selector, frequently used section, and click-to-copy
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LucideCheckCn, LucideClockCn, LucideCoffeeCn, LucideDogCn, LucideHeartCn, LucideLightbulbCn, LucideMusicCn, LucidePlaneCn, LucideSearchCn, LucideSmileCn, PopoverCn, PopoverContentCn, PopoverTriggerCn
   Source: original/blocks/dialog/dialog-emoji-picker.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideSmileCn Class="mr-2 h-4 w-4" Size="16" />
                Pick Emoji
            </DialogTriggerCn>
    </div>
    <DialogContentCn class="sm:max-w-sm">
        <DialogHeaderCn>
            <DialogTitleCn class="flex items-center gap-2">
                <LucideSmileCn Class="h-5 w-5" Size="20" />
                Emoji Picker
            </DialogTitleCn>
            <DialogDescriptionCn>Search or browse emojis. Click to copy.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-3 py-2">
            <div class="flex items-center gap-2">
                <div class="relative flex-1">
                    <LucideSearchCn Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                    <InputCn Class="pl-9" Placeholder="Search emojis..." @bind-Value="_search" />
                </div>
                <PopoverCn>
                    <PopoverTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-icon shrink-0" data-variant="outline" data-size="icon">
                            <span class="text-lg">@(_skinTone > 0 ? $"👋{_skinTones[_skinTone]}" : "👋")</span>
                        </PopoverTriggerCn>
                    <PopoverContentCn Align="FloatingAlign.End" Class="w-auto p-2">
                        <div class="flex gap-1">
                            @for (var i = 0; i < _skinTones.Length; i++)
                            {
                                var index = i;
                                <button type="button"
                                        class="@Cn.Merge("h-8 w-8 rounded-md flex items-center justify-center text-lg hover:bg-muted transition-colors", _skinTone == index ? "ring-2 ring-primary" : "")"
                                        @onclick="@(() => _skinTone = index)">
                                    👋@_skinTones[index]
                                </button>
                            }
                        </div>
                    </PopoverContentCn>
                </PopoverCn>
            </div>

            @if (string.IsNullOrEmpty(_search))
            {
                <div class="flex gap-1 overflow-x-auto pb-1">
                    @foreach (var cat in _categoryNames)
                    {
                        <button type="button"
                                class="@Cn.Merge("flex items-center justify-center h-8 w-8 rounded-md transition-colors shrink-0", _category == cat ? "bg-primary text-primary-foreground" : "hover:bg-muted")"
                                @onclick="@(() => _category = cat)"
                                title="@cat">
                            @(_categoryLabels[cat])
                        </button>
                    }
                </div>
            }

            <div class="h-[200px] overflow-y-auto">
                @if (FilteredEmojis.Any())
                {
                    <div class="flex flex-wrap gap-1">
                        @foreach (var item in FilteredEmojis)
                        {
                            <button type="button"
                                    class="@Cn.Merge("h-8 w-8 rounded-md flex items-center justify-center text-xl hover:bg-muted transition-all hover:scale-110", _copied == item.Emoji ? "bg-primary/10" : "")"
                                    title="@item.Name"
                                    @onclick="@(() => HandleSelectEmoji(item.Emoji))">
                                @item.Emoji
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="flex flex-col items-center justify-center py-8 text-center">
                        <LucideSmileCn Class="h-8 w-8 text-muted-foreground mb-2" Size="32" />
                        <p class="text-sm font-medium">No emojis found</p>
                        <p class="text-xs text-muted-foreground">Try a different search term</p>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_copied))
            {
                <div class="flex items-center justify-center gap-2 text-sm text-primary">
                    <LucideCheckCn Class="h-4 w-4" Size="16" />
                    <span>Copied @_copied to clipboard!</span>
                </div>
            }
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private record EmojiItem(string Emoji, string Name, string[] Keywords);

    private static readonly string[] _skinTones = ["", "\U0001F3FB", "\U0001F3FC", "\U0001F3FD", "\U0001F3FE", "\U0001F3FF"];

    private static readonly string[] _categoryNames = ["recent", "smileys", "people", "animals", "food", "activities", "travel", "objects", "symbols"];

    private static readonly Dictionary<string, string> _categoryLabels = new()
    {
        ["recent"] = "\u23F0",
        ["smileys"] = "\U0001F600",
        ["people"] = "\U0001F44B",
        ["animals"] = "\U0001F436",
        ["food"] = "\u2615",
        ["activities"] = "\U0001F3AE",
        ["travel"] = "\u2708\uFE0F",
        ["objects"] = "\U0001F4A1",
        ["symbols"] = "\u2764\uFE0F",
    };

    private static readonly Dictionary<string, EmojiItem[]> _emojiData = new()
    {
        ["smileys"] = [
            new("\U0001F600", "grinning face", ["happy", "smile"]),
            new("\U0001F603", "grinning face with big eyes", ["happy", "joy"]),
            new("\U0001F604", "grinning face with smiling eyes", ["happy", "joy"]),
            new("\U0001F601", "beaming face", ["happy", "smile"]),
            new("\U0001F605", "grinning face with sweat", ["hot", "happy"]),
            new("\U0001F602", "face with tears of joy", ["laugh", "cry"]),
            new("\U0001F923", "rolling on floor laughing", ["laugh", "lol"]),
            new("\U0001F60A", "smiling face with smiling eyes", ["happy", "blush"]),
            new("\U0001F60D", "smiling face with heart-eyes", ["love", "crush"]),
            new("\U0001F914", "thinking face", ["think", "hmm"]),
            new("\U0001F622", "crying face", ["sad", "tear"]),
            new("\U0001F621", "pouting face", ["angry", "rage"]),
        ],
        ["people"] = [
            new("\U0001F44B", "waving hand", ["hello", "bye"]),
            new("\U0001F44D", "thumbs up", ["yes", "good"]),
            new("\U0001F44E", "thumbs down", ["no", "bad"]),
            new("\U0001F44F", "clapping hands", ["applause", "congrats"]),
            new("\U0001F64C", "raising hands", ["hooray", "celebrate"]),
            new("\U0001F64F", "folded hands", ["please", "pray"]),
            new("\U0001F4AA", "flexed biceps", ["strong", "muscle"]),
            new("\U0001F440", "eyes", ["look", "see"]),
        ],
        ["animals"] = [
            new("\U0001F436", "dog face", ["puppy", "pet"]),
            new("\U0001F431", "cat face", ["kitty", "pet"]),
            new("\U0001F43B", "bear", ["animal"]),
            new("\U0001F43C", "panda", ["animal", "cute"]),
            new("\U0001F984", "unicorn", ["magical", "fantasy"]),
            new("\U0001F98B", "butterfly", ["insect", "beautiful"]),
        ],
        ["food"] = [
            new("\U0001F34E", "red apple", ["fruit", "healthy"]),
            new("\U0001F355", "pizza", ["food", "italian"]),
            new("\U0001F354", "hamburger", ["food", "burger"]),
            new("\U0001F369", "doughnut", ["food", "sweet"]),
            new("\u2615", "hot beverage", ["coffee", "tea"]),
        ],
        ["activities"] = [
            new("\u26BD", "soccer ball", ["sport", "football"]),
            new("\U0001F3AE", "video game", ["gaming", "play"]),
            new("\U0001F3A8", "artist palette", ["art", "paint"]),
            new("\U0001F3C6", "trophy", ["win", "champion"]),
        ],
        ["travel"] = [
            new("\U0001F697", "automobile", ["car", "drive"]),
            new("\u2708\uFE0F", "airplane", ["travel", "fly"]),
            new("\U0001F680", "rocket", ["space", "launch"]),
            new("\U0001F3E0", "house", ["home", "building"]),
        ],
        ["objects"] = [
            new("\U0001F4A1", "light bulb", ["idea", "light"]),
            new("\U0001F4BB", "laptop", ["computer", "work"]),
            new("\U0001F4DA", "books", ["read", "study"]),
            new("\U0001F510", "locked", ["security", "private"]),
            new("\U0001F381", "wrapped gift", ["present", "birthday"]),
        ],
        ["symbols"] = [
            new("\u2764\uFE0F", "red heart", ["love"]),
            new("\U0001F49C", "purple heart", ["love"]),
            new("\U0001F494", "broken heart", ["sad", "heartbreak"]),
            new("\u2728", "sparkles", ["magic", "special"]),
            new("\u2B50", "star", ["favorite", "rating"]),
            new("\u2705", "check mark button", ["yes", "done"]),
            new("\u274C", "cross mark", ["no", "wrong"]),
            new("\U0001F4AF", "hundred points", ["perfect", "score"]),
            new("\U0001F525", "fire", ["hot", "lit"]),
        ],
    };

    private bool _open;
    private string _search = "";
    private string _category = "smileys";
    private int _skinTone;
    private List<string> _recentEmojis = ["\U0001F600", "\U0001F44D", "\u2764\uFE0F", "\U0001F525", "\u2728", "\U0001F389", "\U0001F4AF", "\U0001F64F"];
    private string? _copied;

    private IEnumerable<EmojiItem> FilteredEmojis
    {
        get
        {
            if (string.IsNullOrEmpty(_search))
            {
                if (_category == "recent")
                    return _recentEmojis.Select(e => new EmojiItem(e, "", Array.Empty<string>()));
                return _emojiData.TryGetValue(_category, out var items) ? items : [];
            }
            var searchLower = _search.ToLowerInvariant();
            return _emojiData.Values.SelectMany(v => v)
                .Where(e => e.Name.Contains(searchLower, StringComparison.OrdinalIgnoreCase) ||
                            e.Keywords.Any(k => k.Contains(searchLower, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private void HandleSelectEmoji(string emoji)
    {
        _copied = emoji;
        if (!_recentEmojis.Contains(emoji))
            _recentEmojis = new List<string>(new[] { emoji }.Concat(_recentEmojis.Take(7)));

        _ = Task.Delay(1000).ContinueWith(_ => { _copied = null; InvokeAsync(StateHasChanged); });
    }
}
