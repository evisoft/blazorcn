@* ========================================
   Block: dialog-user-preferences
   Title: Dialog User Preferences
   Description: User preferences dialog with theme selection, display density, default views, and personalization options
   Long Description: Upgrade plan dialog with pricing tier comparison cards, feature lists, and billing toggle between monthly and annual
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideLoader2Cn, LucideMonitorCn, LucideMoonCn, LucideSettingsCn, LucideSunCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SwitchCn
   Source: original/blocks/dialog/dialog-user-preferences.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideSettingsCn Class="mr-2 h-4 w-4" Size="16" />
                Preferences
            </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 384px;">
        <DialogHeaderCn>
            <DialogTitleCn>Preferences</DialogTitleCn>
            <DialogDescriptionCn>Customize your experience.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            @* Theme *@
            <div class="space-y-2">
                <LabelCn Class="text-sm">Theme</LabelCn>
                <div class="grid grid-cols-3 gap-2">
                    <button type="button"
                            class="@Cn.Merge("flex flex-col items-center gap-1.5 rounded-md border p-2.5 text-xs transition-colors", _theme == "light" ? "border-primary" : "hover:border-muted-foreground/50")"
                            @onclick="@(() => _theme = "light")">
                        <LucideSunCn Class="h-4 w-4" Size="16" />
                        Light
                    </button>
                    <button type="button"
                            class="@Cn.Merge("flex flex-col items-center gap-1.5 rounded-md border p-2.5 text-xs transition-colors", _theme == "dark" ? "border-primary" : "hover:border-muted-foreground/50")"
                            @onclick="@(() => _theme = "dark")">
                        <LucideMoonCn Class="h-4 w-4" Size="16" />
                        Dark
                    </button>
                    <button type="button"
                            class="@Cn.Merge("flex flex-col items-center gap-1.5 rounded-md border p-2.5 text-xs transition-colors", _theme == "system" ? "border-primary" : "hover:border-muted-foreground/50")"
                            @onclick="@(() => _theme = "system")">
                        <LucideMonitorCn Class="h-4 w-4" Size="16" />
                        System
                    </button>
                </div>
            </div>

            @* Start Page *@
            <div class="flex items-center justify-between">
                <LabelCn Class="text-sm" For="dlg-user-preferences-start-page">Start Page</LabelCn>
                <SelectCn Value="@_defaultView" ValueChanged="@((string v) => _defaultView = v)">
                    <SelectTriggerCn Class="w-32" id="dlg-user-preferences-start-page">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="dashboard">Dashboard</SelectItemCn>
                        <SelectItemCn Value="projects">Projects</SelectItemCn>
                        <SelectItemCn Value="inbox">Inbox</SelectItemCn>
                        <SelectItemCn Value="calendar">Calendar</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>

            @* Toggles *@
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <LabelCn Class="text-sm">Collapsed Sidebar</LabelCn>
                    <SwitchCn Checked="@_sidebarCollapsed" CheckedChanged="@((bool v) => _sidebarCollapsed = v)" />
                </div>
                <div class="flex items-center justify-between">
                    <LabelCn Class="text-sm">Animations</LabelCn>
                    <SwitchCn Checked="@_animationsEnabled" CheckedChanged="@((bool v) => _animationsEnabled = v)" />
                </div>
            </div>
        </div>

        <DialogFooterCn>
            <ButtonCn @onclick="@(() => _open = false)" Variant="ButtonVariant.Outline">
                Cancel
            </ButtonCn>
            <ButtonCn Disabled="@_isSaving" @onclick="HandleSave">
                @if (_isSaving)
                {
                    <LucideLoaderCircleCn Class="h-4 w-4 animate-spin" Size="16" />
                }
                else
                {
                    <span>Save</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _isSaving;
    private string _theme = "system";
    private string _defaultView = "dashboard";
    private bool _sidebarCollapsed;
    private bool _animationsEnabled = true;

    private async Task HandleSave()
    {
        _isSaving = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isSaving = false;
        _open = false;
    }
}
