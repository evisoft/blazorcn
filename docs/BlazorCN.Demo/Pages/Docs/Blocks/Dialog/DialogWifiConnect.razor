@* ========================================
   Block: dialog-wifi-connect
   Title: Dialog Wifi Connect
   Description: WiFi connect dialog with network selection, password input, and connection status for React IoT apps
   Long Description: Destructive action warning dialog with alert icon, horizontal layout, and cancel/confirm buttons
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCheckCn, LucideLoader2Cn, LucideLockCn, LucideWifiCn
   Source: original/blocks/dialog/dialog-wifi-connect.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideWifiCn Class="mr-2 h-4 w-4" Size="16" />
                Connect WiFi
            </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 384px">
        @if (_connected)
        {
            <div class="flex flex-col items-center justify-center py-6 text-center">
                <LucideCheckCn Class="h-8 w-8 text-primary" Size="32" />
                <h3 class="mt-4 text-lg font-medium">Connected</h3>
                <p class="mt-1 text-sm text-muted-foreground">@_selected</p>
                <ButtonCn class="mt-6" @onclick="HandleClose">
                    Done
                </ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn>Connect to WiFi</DialogTitleCn>
                <DialogDescriptionCn>Select a network to connect</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="py-4 space-y-4">
                @* Networks *@
                <div class="space-y-1">
                    @foreach (var network in _networks)
                    {
                        <button
                            type="button"
                            class="@(Cn.Merge(
                                "w-full flex items-center justify-between p-3 rounded-md transition-colors",
                                _selected == network.Ssid
                                    ? "bg-primary/5 border border-primary"
                                    : "hover:bg-muted border border-transparent"
                            ))"
                            @onclick="@(() => _selected = network.Ssid)">
                            <div class="flex items-center gap-2">
                                @if (network.Secured)
                                {
                                    <LucideLockCn Class="h-3 w-3 text-muted-foreground" Size="12" />
                                }
                                <span class="text-sm">@network.Ssid</span>
                            </div>
                            <div class="flex items-end gap-0.5 h-4">
                                @for (var bar = 1; bar <= 3; bar++)
                                {
                                    var b = bar;
                                    <div class="@(Cn.Merge(
                                        "w-1 rounded-sm",
                                        b == 1 ? "h-1.5" : b == 2 ? "h-2.5" : "h-4",
                                        b <= network.Signal ? "bg-foreground" : "bg-muted"
                                    ))"></div>
                                }
                            </div>
                        </button>
                    }
                </div>

                @* Password *@
                @if (_selected != null && SelectedNetwork?.Secured == true)
                {
                    <div class="space-y-2">
                        <LabelCn class="text-sm" For="password">
                            Password
                        </LabelCn>
                        <InputCn
                            id="password"
                            Value="@_password"
                            ValueChanged="@((string v) => _password = v)"
                            Placeholder="Enter network password"
                            type="password" />
                    </div>
                }
            </div>

            <DialogFooterCn>
                <ButtonCn @onclick="HandleClose" Variant="ButtonVariant.Outline">
                    Cancel
                </ButtonCn>
                <ButtonCn
                    Disabled="@(_selected == null || (SelectedNetwork?.Secured == true && string.IsNullOrEmpty(_password)) || _connecting)"
                    @onclick="HandleConnect">
                    @if (_connecting)
                    {
                        <LucideLoaderCircleCn Class="h-4 w-4 animate-spin" Size="16" />
                    }
                    else
                    {
                        <span>Connect</span>
                    }
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record Network(string Ssid, int Signal, bool Secured);

    private static readonly Network[] _networks =
    [
        new("Home Network", 3, true),
        new("Office_5G", 2, true),
        new("Guest WiFi", 2, false),
    ];

    private bool _open;
    private string? _selected;
    private string _password = "";
    private bool _connecting;
    private bool _connected;

    private Network? SelectedNetwork => _networks.FirstOrDefault(n => n.Ssid == _selected);

    private async Task HandleConnect()
    {
        _connecting = true;
        StateHasChanged();
        await Task.Delay(1500);
        _connecting = false;
        _connected = true;
    }

    private void HandleClose()
    {
        _open = false;
        _selected = null;
        _password = "";
        _connecting = false;
        _connected = false;
    }
}
