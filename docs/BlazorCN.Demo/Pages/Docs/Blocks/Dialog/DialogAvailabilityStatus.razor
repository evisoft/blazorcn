@* ========================================
   Block: dialog-availability-status
   Title: Dialog Availability Status
   Description: Availability status dialog with preset options, custom message, and auto-clear timer
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LucideClockCn
   Source: original/blocks/dialog/dialog-availability-status.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <span class="mr-2">🟢</span>
                Set Status
            </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 320px;">
        @if (_saved)
        {
            <div class="flex flex-col items-center justify-center py-8 text-center">
                <span class="text-4xl">@SelectedStatus?.Emoji</span>
                <h3 class="mt-4 text-lg font-medium">@SelectedStatus?.Label</h3>
                @if (!string.IsNullOrEmpty(_message))
                {
                    <p class="mt-1 text-sm text-muted-foreground">@_message</p>
                }
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn>Set your status</DialogTitleCn>
            </DialogHeaderCn>

            <div class="py-4 space-y-4">
                @* Status options *@
                <div class="grid grid-cols-2 gap-2">
                    @foreach (var s in _statuses)
                    {
                        <button type="button"
                                class="@Cn.Merge("flex items-center gap-2 p-2.5 rounded-md transition-colors text-left", _status == s.Id ? "bg-primary/5 border border-primary" : "hover:bg-muted border border-transparent")"
                                @onclick="@(() => _status = s.Id)">
                            <span class="text-sm">@s.Emoji</span>
                            <span class="text-sm">@s.Label</span>
                        </button>
                    }
                </div>

                @* Message input *@
                <InputCn Value="@_message" ValueChanged="@((string v) => _message = v)"
                         Placeholder="What's happening?" />

                @* Duration chips *@
                <div class="flex items-center gap-2">
                    <LucideClockCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <div class="flex gap-1.5 flex-1">
                        @foreach (var d in _durations)
                        {
                            <button type="button"
                                    class="@Cn.Merge("px-2.5 py-1 rounded-full text-xs transition-colors", _duration == d.Value ? "bg-primary text-primary-foreground" : "bg-muted hover:bg-muted/80")"
                                    @onclick="@(() => _duration = d.Value)">
                                @d.Label
                            </button>
                        }
                    </div>
                </div>
            </div>

            <ButtonCn Class="w-full" @onclick="HandleSave">Save</ButtonCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _status = "available";
    private string _message = "";
    private string _duration = "60";
    private bool _saved;

    private record StatusOption(string Id, string Label, string Emoji);
    private record DurationOption(string Value, string Label);

    private static readonly StatusOption[] _statuses =
    [
        new("available", "Available", "🟢"),
        new("busy", "Busy", "🔴"),
        new("away", "Away", "🟡"),
        new("dnd", "Do not disturb", "⛔"),
        new("invisible", "Invisible", "⚫"),
    ];

    private static readonly DurationOption[] _durations =
    [
        new("30", "30 min"), new("60", "1 hour"), new("240", "4 hours"), new("today", "Today"),
    ];

    private StatusOption? SelectedStatus => _statuses.FirstOrDefault(s => s.Id == _status);

    private async void HandleSave()
    {
        _saved = true;
        StateHasChanged();
        await Task.Delay(800);
        _open = false;
        await Task.Delay(200);
        _saved = false;
        StateHasChanged();
    }
}
