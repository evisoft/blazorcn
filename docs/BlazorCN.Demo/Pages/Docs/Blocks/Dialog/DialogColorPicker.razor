@* ========================================
   Block: dialog-color-picker
   Title: Dialog Color Picker
   Description: Color picker dialog with preset swatches, custom hex/RGB input, opacity slider, recent colors history, and copy-to-clipboard
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, LucideCheckCn, LucideCopyCn, LucidePaletteCn, LucideRotateCcwCn, SeparatorCn, SliderCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn, TooltipCn, TooltipContentCn, TooltipTriggerCn
   Source: original/blocks/dialog/dialog-color-picker.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucidePaletteCn Class="mr-2 h-4 w-4" Size="16" />
                Pick Color
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucidePaletteCn Class="h-5 w-5" Size="20" />
                Color Picker
            </DialogTitleCn>
            <DialogDescriptionCn>
                Select a color from presets or enter a custom value.
            </DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            <div class="flex items-center gap-4">
                <div
                    class="h-16 w-16 rounded-lg border shadow-sm shrink-0"
                    style="background-color: @_color; opacity: @((_opacity / 100.0).ToString("F2"));" />
                <div class="flex-1 space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium">@_color</span>
                        <TooltipCn>
                            <TooltipTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon h-8 w-8" data-variant="ghost" data-size="icon"> HandleCopy("hex"))">
                                    @if (_copied)
                                    {
                                        <LucideCheckCn Class="h-4 w-4 text-primary" Size="16" />
                                    }
                                    else
                                    {
                                        <LucideCopyCn Class="h-4 w-4" Size="16" />
                                    }
                                </TooltipTriggerCn>
                            <TooltipContentCn>Copy HEX</TooltipContentCn>
                        </TooltipCn>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-muted-foreground">Opacity</span>
                        <SliderCn Class="flex-1" Max="100" Step="1" Value="@_opacity" ValueChanged="@((double v) => _opacity = v)" />
                        <span class="text-xs w-8 text-right">@((int)_opacity)%</span>
                    </div>
                </div>
            </div>

            <TabsCn Value="@_activeTab" ValueChanged="@((string v) => _activeTab = v)">
                <TabsListCn Class="grid w-full grid-cols-2">
                    <TabsTriggerCn Value="swatches">Swatches</TabsTriggerCn>
                    <TabsTriggerCn Value="custom">Custom</TabsTriggerCn>
                </TabsListCn>
                <TabsContentCn Class="space-y-3 mt-3" Value="swatches">
                    @foreach (var row in _presetColors)
                    {
                        <div class="flex justify-center gap-1.5">
                            @foreach (var swatchColor in row)
                            {
                                <button
                                    type="button"
                                    class="@Cn.Merge("h-7 w-7 rounded-md border transition-all hover:scale-110", _color == swatchColor ? "ring-2 ring-primary ring-offset-2" : "")"
                                    style="background-color: @swatchColor;"
                                    @onclick="@(() => _color = swatchColor)" />
                            }
                        </div>
                    }
                </TabsContentCn>
                <TabsContentCn Class="space-y-4 mt-3" Value="custom">
                    <div class="space-y-2">
                        <LabelCn For="hex">HEX</LabelCn>
                        <InputCn Id="hex" MaxLength="7" Value="@_hexInput" ValueChanged="@((string v) => HandleHexChange(v))" Placeholder="#000000" />
                    </div>
                    <div class="grid grid-cols-3 gap-3">
                        <div class="space-y-2">
                            <LabelCn For="r">R</LabelCn>
                            <InputCn Id="r" Type="number" Value="@_r.ToString()" ValueChanged="@((string v) => HandleRgbChange("r", v))" />
                        </div>
                        <div class="space-y-2">
                            <LabelCn For="g">G</LabelCn>
                            <InputCn Id="g" Type="number" Value="@_g.ToString()" ValueChanged="@((string v) => HandleRgbChange("g", v))" />
                        </div>
                        <div class="space-y-2">
                            <LabelCn For="b">B</LabelCn>
                            <InputCn Id="b" Type="number" Value="@_b.ToString()" ValueChanged="@((string v) => HandleRgbChange("b", v))" />
                        </div>
                    </div>
                    <ButtonCn Class="w-full" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="@(() => HandleCopy("rgb"))">
                        <LucideCopyCn Class="mr-2 h-4 w-4" Size="16" />
                        Copy as RGB
                    </ButtonCn>
                </TabsContentCn>
            </TabsCn>

            @if (_recentColors.Count > 0)
            {
                <SeparatorCn />
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <LabelCn Class="text-xs text-muted-foreground">Recent Colors</LabelCn>
                        <ButtonCn Class="h-6 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="@(() => _recentColors.Clear())">
                            <LucideRotateCcwCn Class="mr-1 h-3 w-3" Size="12" />
                            Clear
                        </ButtonCn>
                    </div>
                    <div class="flex gap-2">
                        @foreach (var recentColor in _recentColors)
                        {
                            <button
                                type="button"
                                class="@Cn.Merge("h-8 w-8 rounded-md border transition-all hover:scale-110", _color == recentColor ? "ring-2 ring-primary ring-offset-2" : "")"
                                style="background-color: @recentColor;"
                                @onclick="@(() => _color = recentColor)" />
                        }
                    </div>
                </div>
            }
        </div>

        <DialogFooterCn Class="gap-2 sm:gap-0">
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">Cancel</ButtonCn>
            <ButtonCn @onclick="HandleSelect">Select Color</ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _color = "#3B82F6";
    private double _opacity = 100;
    private string _hexInput = "#3B82F6";
    private int _r = 59, _g = 130, _b = 246;
    private List<string> _recentColors = new() { "#3B82F6", "#EF4444", "#22C55E", "#F97316", "#A855F7" };
    private bool _copied;
    private string _activeTab = "swatches";

    private static readonly string[][] _presetColors =
    [
        ["#FEE2E2", "#FECACA", "#FCA5A5", "#F87171", "#EF4444", "#DC2626"],
        ["#FFEDD5", "#FED7AA", "#FDBA74", "#FB923C", "#F97316", "#EA580C"],
        ["#FEF9C3", "#FEF08A", "#FDE047", "#FACC15", "#EAB308", "#CA8A04"],
        ["#DCFCE7", "#BBF7D0", "#86EFAC", "#4ADE80", "#22C55E", "#16A34A"],
        ["#DBEAFE", "#BFDBFE", "#93C5FD", "#60A5FA", "#3B82F6", "#2563EB"],
        ["#F3E8FF", "#E9D5FF", "#D8B4FE", "#C084FC", "#A855F7", "#9333EA"],
        ["#F9FAFB", "#F3F4F6", "#E5E7EB", "#D1D5DB", "#9CA3AF", "#6B7280"],
    ];

    private void HandleHexChange(string value)
    {
        _hexInput = value;
        if (System.Text.RegularExpressions.Regex.IsMatch(value, @"^#[0-9A-Fa-f]{6}$"))
        {
            _color = value.ToUpper();
            UpdateRgbFromHex();
        }
    }

    private void HandleRgbChange(string channel, string value)
    {
        var num = Math.Clamp(int.TryParse(value, out var n) ? n : 0, 0, 255);
        switch (channel)
        {
            case "r": _r = num; break;
            case "g": _g = num; break;
            case "b": _b = num; break;
        }
        _color = $"#{_r:X2}{_g:X2}{_b:X2}";
        _hexInput = _color;
    }

    private void UpdateRgbFromHex()
    {
        if (_color.Length == 7)
        {
            _r = Convert.ToInt32(_color.Substring(1, 2), 16);
            _g = Convert.ToInt32(_color.Substring(3, 2), 16);
            _b = Convert.ToInt32(_color.Substring(5, 2), 16);
        }
    }

    private async Task HandleCopy(string format)
    {
        // In a real app, use JSInterop to copy to clipboard
        _copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
    }

    private void HandleSelect()
    {
        if (!_recentColors.Contains(_color))
        {
            _recentColors.Insert(0, _color);
            if (_recentColors.Count > 5) _recentColors.RemoveAt(5);
        }
        _open = false;
    }
}
