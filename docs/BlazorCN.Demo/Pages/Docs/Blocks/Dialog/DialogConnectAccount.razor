@* ========================================
   Block: dialog-connect-account
   Title: Dialog Connect Account
   Description: Connect account dialog with OAuth provider list, connection status, linked accounts management, and disconnect option
   Dependencies: AlertDialogCn, AlertDialogContentCn, AlertDialogDescriptionCn, AlertDialogFooterCn, AlertDialogHeaderCn, AlertDialogTitleCn, AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCheckCn, LucideCircleAlertCn, LucideExternalLinkCn, LucideLink2Cn, LucideLoader2Cn, LucideUnlinkCn
   Source: original/blocks/dialog/dialog-connect-account.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideLink2Cn Class="mr-2 h-4 w-4" Size="16" />
                Connected Accounts
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideLink2Cn Class="h-5 w-5" Size="20" />
                Connected Accounts
            </DialogTitleCn>
            <DialogDescriptionCn>Manage your linked accounts and services.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            <div class="flex items-center justify-between">
                <span class="text-sm text-muted-foreground">
                    @_connectedCount of @_providers.Length accounts connected
                </span>
            </div>

            <div class="space-y-3">
                @foreach (var provider in _providers)
                {
                    <div class="@Cn.Merge("rounded-lg border p-4 transition-colors", provider.Connected ? "border-primary/50" : "")">
                        <div class="flex items-start justify-between">
                            <div class="flex items-start gap-3">
                                <div class="@Cn.Merge("flex h-10 w-10 items-center justify-center rounded-lg text-sm font-bold", provider.Connected ? "bg-primary text-primary-foreground" : "bg-muted text-muted-foreground")">
                                    @provider.Icon
                                </div>
                                <div class="space-y-1">
                                    <div class="flex items-center gap-2">
                                        <span class="font-medium">@provider.Name</span>
                                        @if (provider.Connected)
                                        {
                                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                                <LucideCheckCn Class="mr-1 h-3 w-3" Size="12" />
                                                Connected
                                            </BadgeCn>
                                        }
                                    </div>
                                    <p class="text-xs text-muted-foreground">@provider.Description</p>
                                    @if (provider.Connected && provider.Email is not null)
                                    {
                                        <div class="flex items-center gap-2 mt-2">
                                            <AvatarCn Class="h-5 w-5">
                                                <AvatarFallbackCn Class="text-xs">@provider.AccountName?.Substring(0, 1)</AvatarFallbackCn>
                                            </AvatarCn>
                                            <span class="text-xs text-muted-foreground">@provider.Email</span>
                                        </div>
                                    }
                                    @if (provider.ConnectedAt is not null)
                                    {
                                        <p class="text-xs text-muted-foreground">
                                            Connected @provider.ConnectedAt.Value.ToString("MMM d, yyyy")
                                        </p>
                                    }
                                </div>
                            </div>

                            <div>
                                @if (provider.Connected)
                                {
                                    var p = provider;
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="@(() => _disconnectProvider = p)">
                                        <LucideUnlinkCn Class="mr-2 h-4 w-4" Size="16" />
                                        Disconnect
                                    </ButtonCn>
                                }
                                else
                                {
                                    var p = provider;
                                    <ButtonCn Disabled="@(_connectingId == p.Id)" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="@(() => HandleConnect(p.Id))">
                                        @if (_connectingId == p.Id)
                                        {
                                            <LucideLoaderCircleCn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                                            <span>Connecting...</span>
                                        }
                                        else
                                        {
                                            <LucideExternalLinkCn Class="mr-2 h-4 w-4" Size="16" />
                                            <span>Connect</span>
                                        }
                                    </ButtonCn>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </DialogContentCn>
</DialogCn>

@* Disconnect confirmation *@
<AlertDialogCn Open="@(_disconnectProvider is not null)" OpenChanged="@(open => { if (!open) _disconnectProvider = null; })">
    <AlertDialogContentCn>
        <AlertDialogHeaderCn>
            <AlertDialogTitleCn Class="flex items-center gap-2">
                <LucideCircleAlertCn Class="h-5 w-5 text-destructive" Size="20" />
                Disconnect @_disconnectProvider?.Name?
            </AlertDialogTitleCn>
            <AlertDialogDescriptionCn>
                This will remove access to your @_disconnectProvider?.Name account. You can reconnect at any time.
            </AlertDialogDescriptionCn>
        </AlertDialogHeaderCn>
        <AlertDialogFooterCn>
            <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _disconnectProvider = null)">Cancel</ButtonCn>
            <ButtonCn Class="bg-destructive text-destructive-foreground hover:bg-destructive/90" @onclick="HandleDisconnect">
                <LucideUnlinkCn Class="mr-2 h-4 w-4" Size="16" />
                Disconnect
            </ButtonCn>
        </AlertDialogFooterCn>
    </AlertDialogContentCn>
</AlertDialogCn>

@code {
    private bool _open;
    private string? _connectingId;
    private ProviderInfo? _disconnectProvider;

    private int _connectedCount => _providers.Count(p => p.Connected);

    private class ProviderInfo
    {
        public string Id { get; init; } = "";
        public string Name { get; init; } = "";
        public string Icon { get; init; } = "";
        public string Description { get; init; } = "";
        public bool Connected { get; set; }
        public string? AccountName { get; set; }
        public string? Email { get; set; }
        public DateTime? ConnectedAt { get; set; }
    }

    private readonly ProviderInfo[] _providers =
    [
        new() { Id = "google", Name = "Google", Icon = "G", Description = "Sign in and sync with Google services", Connected = true, AccountName = "John Doe", Email = "john@gmail.com", ConnectedAt = DateTime.Now.AddDays(-30) },
        new() { Id = "github", Name = "GitHub", Icon = "GH", Description = "Access repositories and gists", Connected = true, AccountName = "johndoe", Email = "john@github.com", ConnectedAt = DateTime.Now.AddDays(-7) },
        new() { Id = "slack", Name = "Slack", Icon = "S", Description = "Send notifications to Slack channels", Connected = false },
        new() { Id = "microsoft", Name = "Microsoft", Icon = "M", Description = "Connect with Microsoft 365 services", Connected = false },
        new() { Id = "twitter", Name = "Twitter", Icon = "X", Description = "Share updates to Twitter", Connected = false },
    ];

    private async Task HandleConnect(string providerId)
    {
        _connectingId = providerId;
        StateHasChanged();
        await Task.Delay(1500);

        var provider = _providers.First(p => p.Id == providerId);
        provider.Connected = true;
        provider.AccountName = "Connected User";
        provider.Email = $"user@{providerId}.com";
        provider.ConnectedAt = DateTime.Now;
        _connectingId = null;
    }

    private void HandleDisconnect()
    {
        if (_disconnectProvider is null) return;

        _disconnectProvider.Connected = false;
        _disconnectProvider.AccountName = null;
        _disconnectProvider.Email = null;
        _disconnectProvider.ConnectedAt = null;
        _disconnectProvider = null;
    }
}
