@* ========================================
   Block: dialog-meeting-rsvp
   Title: Dialog Meeting RSVP
   Description: Meeting RSVP dialog with response options, availability indicator, and optional message
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideCalendarCn, LucideCheckCn, LucideClockCn, LucideCircleQuestionMarkCn, LucideMapPinCn, LucideXCn, RadioGroupCn, RadioGroupItemCn, TextareaCn
   Source: original/blocks/dialog/dialog-meeting-rsvp.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideCalendarCn Class="mr-2 h-4 w-4" Size="16" />
                RSVP to Meeting
            </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 384px;">
        @if (_submitted)
        {
            <div class="flex flex-col items-center justify-center py-6 text-center">
                @if (_response == "accept")
                {
                    <LucideCheckCn Class="h-8 w-8 text-primary" Size="32" />
                }
                else if (_response == "tentative")
                {
                    <LucideCircleQuestionMarkCn Class="h-8 w-8 text-primary" Size="32" />
                }
                else if (_response == "decline")
                {
                    <LucideXCn Class="h-8 w-8 text-primary" Size="32" />
                }
                <h3 class="mt-4 text-lg font-medium">
                    @(_response switch {
                        "accept" => "You're attending",
                        "tentative" => "Marked as maybe",
                        "decline" => "Declined",
                        _ => ""
                    })
                </h3>
                <p class="mt-1 text-sm text-muted-foreground">Sarah Chen has been notified</p>
                <ButtonCn Class="mt-6" @onclick="HandleClose">Done</ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn>Q4 Planning Review</DialogTitleCn>
            </DialogHeaderCn>

            <div class="py-4 space-y-4">
                @* Meeting details *@
                <div class="space-y-2 text-sm">
                    <div class="flex items-center gap-2 text-muted-foreground">
                        <LucideCalendarCn Class="h-4 w-4" Size="16" />
                        Tuesday, Dec 17
                    </div>
                    <div class="flex items-center gap-2 text-muted-foreground">
                        <LucideClockCn Class="h-4 w-4" Size="16" />
                        2:00 PM - 3:00 PM
                    </div>
                    <div class="flex items-center gap-2 text-muted-foreground">
                        <LucideMapPinCn Class="h-4 w-4" Size="16" />
                        Conference Room A
                    </div>
                </div>

                @* Response options *@
                <RadioGroupCn Value="@(_response ?? "")" ValueChanged="@(v => _response = v)">
                    <div class="grid grid-cols-3 gap-2">
                        @foreach (var option in _responses)
                        {
                            <LabelCn Class="@Cn.Merge("flex flex-col items-center gap-1 p-3 rounded-md border cursor-pointer transition-colors", _response == option.Value ? "border-primary bg-primary/5" : "hover:border-muted-foreground/50")"
                                     For="@option.Value">
                                <RadioGroupItemCn Class="sr-only" id="@option.Value" Value="@option.Value" />
                                @option.IconFragment
                                <span class="text-xs">@option.Label</span>
                            </LabelCn>
                        }
                    </div>
                </RadioGroupCn>

                @* Optional message *@
                <TextareaCn Class="resize-none h-16" Placeholder="Add a note (optional)"
                            Value="@_message" ValueChanged="@(v => _message = v)" />
            </div>

            <DialogFooterCn>
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="HandleClose">Cancel</ButtonCn>
                <ButtonCn Disabled="@(string.IsNullOrEmpty(_response))" @onclick="HandleSubmit">Send Response</ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record ResponseOption(string Value, string Label, RenderFragment IconFragment);

    private readonly ResponseOption[] _responses;

    public DialogMeetingRsvp()
    {
        _responses =
        [
            new("accept", "Accept", builder => { builder.OpenComponent<LucideCheckCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); }),
            new("tentative", "Maybe", builder => { builder.OpenComponent<LucideCircleQuestionMarkCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); }),
            new("decline", "Decline", builder => { builder.OpenComponent<LucideXCn>(0); builder.AddAttribute(1, "Class", "h-4 w-4"); builder.AddAttribute(2, "Size", 16); builder.CloseComponent(); }),
        ];
    }

    private bool _open;
    private string? _response;
    private string _message = "";
    private bool _submitted;

    private void HandleSubmit()
    {
        if (string.IsNullOrEmpty(_response)) return;
        _submitted = true;
    }

    private void HandleClose()
    {
        _open = false;
        _response = null;
        _message = "";
        _submitted = false;
    }
}
