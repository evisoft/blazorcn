@* ========================================
   Block: dialog-unsaved-changes
   Title: Dialog Unsaved Changes
   Description: Unsaved changes dialog with change summary, save/discard options, and navigation blocking confirmation
   Long Description: Unit converter dialog with multiple categories, bidirectional conversion, common unit presets, and instant results
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideAlertTriangleCn, LucideLoader2Cn
   Source: original/blocks/dialog/dialog-unsaved-changes.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideTriangleAlertCn Class="mr-2 h-4 w-4" Size="16" />
                Leave Page
            </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 384px;">
        <DialogHeaderCn>
            <DialogTitleCn>Unsaved Changes</DialogTitleCn>
            <DialogDescriptionCn>
                You have unsaved changes that will be lost if you leave.
            </DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="py-4">
            <p class="text-sm text-muted-foreground mb-2">@_changes.Length pending changes:</p>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var change in _changes)
                {
                    <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                        @change.Field
                    </BadgeCn>
                }
            </div>
        </div>

        <DialogFooterCn>
            <ButtonCn @onclick="@(() => _open = false)" Variant="ButtonVariant.Outline">
                Cancel
            </ButtonCn>
            <ButtonCn Disabled="@_isSaving" @onclick="@(() => _open = false)" Variant="ButtonVariant.Outline">
                Discard
            </ButtonCn>
            <ButtonCn Disabled="@_isSaving" @onclick="HandleSaveAndLeave">
                @if (_isSaving)
                {
                    <LucideLoaderCircleCn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save &amp; Leave</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private record Change(string Field, string Type);

    private static readonly Change[] _changes =
    [
        new("Title", "modified"),
        new("Description", "modified"),
        new("Category", "modified"),
        new("Tags", "added"),
        new("Cover Image", "added"),
    ];

    private bool _open;
    private bool _isSaving;

    private async Task HandleSaveAndLeave()
    {
        _isSaving = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isSaving = false;
        _open = false;
    }
}
