@* ========================================
   Block: dialog-bookmark-folder
   Title: Dialog Bookmark Folder
   Description: Bookmark save dialog with folder selection, new folder creation, tag input, and notes field for organizing saved items
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, ScrollAreaCn, TextareaCn, LucideBookmarkCn, LucideCheckCn, LucideChevronDownCn, LucideChevronRightCn, LucideFolderCn, LucideFolderPlusCn, LucidePlusCn, LucideXCn
   Source: original/blocks/dialog/dialog-bookmark-folder.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideBookmarkCn Class="mr-2 h-4 w-4" Size="16" />
                Save Bookmark
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-md">
        @if (_saved)
        {
            <DialogHeaderCn Class="text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 mb-4">
                    <LucideCheckCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <DialogTitleCn>Bookmark Saved</DialogTitleCn>
                <DialogDescriptionCn>
                    Saved to "@GetFolderName(_selectedFolder)"@(_tags.Count > 0 ? $" with {_tags.Count} tag{(_tags.Count > 1 ? "s" : "")}" : "").
                </DialogDescriptionCn>
            </DialogHeaderCn>
            <DialogFooterCn>
                <ButtonCn Class="w-full" @onclick="HandleClose">Done</ButtonCn>
            </DialogFooterCn>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn Class="flex items-center gap-2">
                    <LucideBookmarkCn Class="h-5 w-5" Size="20" />
                    Save Bookmark
                </DialogTitleCn>
                <DialogDescriptionCn>Choose a folder and add tags to organize this bookmark.</DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-4 py-4">
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <LabelCn>Folder</LabelCn>
                        <ButtonCn Class="h-7 px-2 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                                  @onclick="@(() => _showNewFolder = !_showNewFolder)">
                            <LucideFolderPlusCn Class="mr-1 h-3 w-3" Size="12" />
                            New Folder
                        </ButtonCn>
                    </div>

                    @if (_showNewFolder)
                    {
                        <div class="flex gap-2">
                            <InputCn Class="h-8 text-sm" Value="@_newFolderName" ValueChanged="@((string v) => _newFolderName = v)" Placeholder="Folder name" />
                            <ButtonCn Class="h-8" Disabled="@(string.IsNullOrWhiteSpace(_newFolderName))" Size="ButtonSize.Sm"
                                      @onclick="@(() => { _showNewFolder = false; _newFolderName = ""; })">
                                Create
                            </ButtonCn>
                        </div>
                    }

                    <ScrollAreaCn Class="h-[140px] rounded-md border">
                        <div class="p-2">
                            @RenderFolderTree(_folders, 0)
                        </div>
                    </ScrollAreaCn>
                </div>

                <div class="space-y-2">
                    <LabelCn For="tags">Tags</LabelCn>
                    <div class="flex flex-wrap gap-1.5 p-2 rounded-md border min-h-[42px]">
                        @foreach (var tag in _tags)
                        {
                            <BadgeCn Class="gap-1 pr-1" Variant="BadgeVariant.Secondary">
                                @tag
                                <button type="button" class="ml-0.5 rounded-full hover:bg-muted-foreground/20 p-0.5"
                                        @onclick="@(() => _tags.Remove(tag))">
                                    <LucideXCn Class="h-3 w-3" Size="12" />
                                </button>
                            </BadgeCn>
                        }
                        <InputCn Class="flex-1 min-w-[80px] border-0 h-6 p-0 text-sm focus-visible:ring-0 shadow-none"
                                 Id="tags" Value="@_tagInput" ValueChanged="@((string v) => _tagInput = v)"
                                 Placeholder="@(_tags.Count == 0 ? "Add tags..." : "")" />
                    </div>
                    @if (!string.IsNullOrEmpty(_tagInput))
                    {
                        var filtered = _suggestedTags.Where(t => !_tags.Contains(t) && t.Contains(_tagInput, StringComparison.OrdinalIgnoreCase)).Take(5);
                        @if (filtered.Any())
                        {
                            <div class="flex flex-wrap gap-1">
                                @foreach (var tag in filtered)
                                {
                                    <button type="button" class="inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-foreground"
                                            @onclick="@(() => HandleAddTag(tag))">
                                        <LucidePlusCn Class="h-3 w-3" Size="12" />
                                        @tag
                                    </button>
                                }
                            </div>
                        }
                    }
                </div>

                <div class="space-y-2">
                    <LabelCn For="notes">Notes (optional)</LabelCn>
                    <TextareaCn Class="h-20 resize-none" Id="notes" Value="@_notes" ValueChanged="@((string v) => _notes = v)"
                                Placeholder="Add a note about this bookmark..." />
                </div>
            </div>

            <DialogFooterCn Class="gap-2 sm:gap-0">
                <ButtonCn @onclick="HandleClose" Variant="ButtonVariant.Outline">Cancel</ButtonCn>
                <ButtonCn @onclick="@(() => _saved = true)">Save Bookmark</ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _saved;
    private string _selectedFolder = "4";
    private HashSet<string> _expandedFolders = new(["1", "2"]);
    private List<string> _tags = [];
    private string _tagInput = "";
    private string _notes = "";
    private bool _showNewFolder;
    private string _newFolderName = "";

    private record FolderItem(string Id, string Name, FolderItem[]? Children = null);

    private static readonly FolderItem[] _folders =
    [
        new("1", "Reading List", [new("1-1", "Articles"), new("1-2", "Research Papers")]),
        new("2", "Work", [new("2-1", "Projects"), new("2-2", "References"), new("2-3", "Tools")]),
        new("3", "Personal", [new("3-1", "Recipes"), new("3-2", "Travel")]),
        new("4", "Quick Save"),
    ];

    private static readonly string[] _suggestedTags = ["important", "read-later", "reference", "tutorial", "inspiration", "work", "personal"];

    private RenderFragment RenderFolderTree(FolderItem[] items, int level) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "space-y-0.5");
        foreach (var folder in items)
        {
            var hasChildren = folder.Children is { Length: > 0 };
            var isExpanded = _expandedFolders.Contains(folder.Id);
            var isSelected = _selectedFolder == folder.Id;

            builder.OpenElement(seq++, "div");

            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "class", Cn.Merge("w-full flex items-center gap-2 px-2 py-1.5 rounded-md text-sm transition-colors", isSelected ? "bg-primary text-primary-foreground" : "hover:bg-muted"));
            builder.AddAttribute(seq++, "style", $"padding-left: {level * 16 + 8}px;");
            var folderId = folder.Id;
            var fHasChildren = hasChildren;
            builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => { _selectedFolder = folderId; if (fHasChildren) ToggleFolder(folderId); }));

            if (hasChildren)
            {
                if (isExpanded)
                {
                    builder.OpenComponent<LucideChevronDownCn>(seq++);
                    builder.AddAttribute(seq++, "Class", "h-4 w-4 flex-shrink-0");
                    builder.AddAttribute(seq++, "Size", 16);
                    builder.CloseComponent();
                }
                else
                {
                    builder.OpenComponent<LucideChevronRightCn>(seq++);
                    builder.AddAttribute(seq++, "Class", "h-4 w-4 flex-shrink-0");
                    builder.AddAttribute(seq++, "Size", 16);
                    builder.CloseComponent();
                }
            }
            else
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "w-4");
                builder.CloseElement();
            }

            builder.OpenComponent<LucideFolderCn>(seq++);
            builder.AddAttribute(seq++, "Class", Cn.Merge("h-4 w-4 flex-shrink-0", isSelected ? "text-primary-foreground" : "text-muted-foreground"));
            builder.AddAttribute(seq++, "Size", 16);
            builder.CloseComponent();

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "truncate");
            builder.AddContent(seq++, folder.Name);
            builder.CloseElement();

            builder.CloseElement(); // button

            if (hasChildren && isExpanded)
            {
                builder.AddContent(seq++, RenderFolderTree(folder.Children!, level + 1));
            }

            builder.CloseElement(); // div
        }
        builder.CloseElement();
    };

    private void ToggleFolder(string id)
    {
        if (_expandedFolders.Contains(id)) _expandedFolders.Remove(id);
        else _expandedFolders.Add(id);
    }

    private void HandleAddTag(string tag)
    {
        var trimmed = tag.Trim().ToLowerInvariant();
        if (!string.IsNullOrEmpty(trimmed) && !_tags.Contains(trimmed))
            _tags.Add(trimmed);
        _tagInput = "";
    }

    private string GetFolderName(string id)
    {
        string? Find(FolderItem[] items)
        {
            foreach (var f in items)
            {
                if (f.Id == id) return f.Name;
                if (f.Children is not null) { var found = Find(f.Children); if (found is not null) return found; }
            }
            return null;
        }
        return Find(_folders) ?? "Unknown";
    }

    private void HandleClose()
    {
        _open = false;
        _saved = false;
        _selectedFolder = "4";
        _tags.Clear();
        _tagInput = "";
        _notes = "";
        _showNewFolder = false;
        _newFolderName = "";
    }
}
