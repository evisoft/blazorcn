@* ========================================
   Block: dialog-cookie-consent
   Title: Dialog Cookie Consent
   Description: Cookie consent dialog with preference toggles for different cookie categories, save preferences and accept all buttons
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideCookieCn, LucideShieldCn, SwitchCn
   Source: original/blocks/dialog/dialog-cookie-consent.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideCookieCn Class="mr-2 h-4 w-4" Size="16" />
                Cookie Settings
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-lg">
        <DialogHeaderCn>
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10">
                    <LucideShieldCn Class="h-5 w-5 text-primary" Size="20" />
                </div>
                <div>
                    <DialogTitleCn>Cookie Preferences</DialogTitleCn>
                    <DialogDescriptionCn>Manage your cookie settings below.</DialogDescriptionCn>
                </div>
            </div>
        </DialogHeaderCn>

        <div class="py-4 space-y-4">
            <p class="text-sm text-muted-foreground">
                We use cookies to enhance your browsing experience, analyze site traffic, and
                personalize content. You can choose which cookies to accept.
            </p>

            <div class="space-y-4">
                @foreach (var category in _cookieCategories)
                {
                    var cat = category;
                    <div class="flex items-start justify-between gap-4 rounded-lg border p-4">
                        <div class="space-y-1">
                            <LabelCn Class="text-sm font-medium cursor-pointer" For="@cat.Id">
                                @cat.Name
                                @if (cat.Required)
                                {
                                    <span class="ml-2 text-xs text-muted-foreground">(Required)</span>
                                }
                            </LabelCn>
                            <p class="text-xs text-muted-foreground">@cat.Description</p>
                        </div>
                        <SwitchCn
                            Id="@cat.Id"
                            Checked="@cat.Enabled"
                            CheckedChanged="@((bool v) => { if (!cat.Required) cat.Enabled = v; })"
                            Disabled="@cat.Required" />
                    </div>
                }
            </div>
        </div>

        <DialogFooterCn Class="flex-col sm:flex-row gap-2">
            <ButtonCn Class="sm:flex-1" Variant="ButtonVariant.Outline" @onclick="HandleSavePreferences">
                Save Preferences
            </ButtonCn>
            <ButtonCn Class="sm:flex-1" @onclick="HandleAcceptAll">
                Accept All
            </ButtonCn>
        </DialogFooterCn>

        <p class="text-xs text-center text-muted-foreground">
            By clicking &quot;Accept All&quot;, you consent to all cookies. Read our
            <a class="underline hover:text-foreground" href="#">Privacy Policy</a>
            for more information.
        </p>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;

    private class CookieCategory
    {
        public string Id { get; init; } = "";
        public string Name { get; init; } = "";
        public string Description { get; init; } = "";
        public bool Required { get; init; }
        public bool Enabled { get; set; }
    }

    private readonly CookieCategory[] _cookieCategories =
    [
        new() { Id = "essential", Name = "Essential Cookies", Description = "Required for the website to function. Cannot be disabled.", Required = true, Enabled = true },
        new() { Id = "analytics", Name = "Analytics Cookies", Description = "Help us understand how visitors interact with our website.", Required = false, Enabled = false },
        new() { Id = "marketing", Name = "Marketing Cookies", Description = "Used to deliver personalized advertisements.", Required = false, Enabled = false },
        new() { Id = "functional", Name = "Functional Cookies", Description = "Enable enhanced functionality like chat widgets and videos.", Required = false, Enabled = false },
    ];

    private void HandleAcceptAll()
    {
        foreach (var cat in _cookieCategories) cat.Enabled = true;
        _open = false;
    }

    private void HandleSavePreferences()
    {
        _open = false;
    }
}
