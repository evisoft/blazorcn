@* ========================================
   Block: dialog-download-app
   Title: Dialog Download App
   Description: Download app dialog with platform detection, QR code display, app store links, and installation instructions
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideAppleCn, LucideBellCn, LucideDownloadCn, LucideExternalLinkCn, LucideQrCodeCn, LucideSmartphoneCn, LucideWifiCn, LucideZapCn, SeparatorCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn
   Source: original/blocks/dialog/dialog-download-app.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideSmartphoneCn Class="mr-2 h-4 w-4" Size="16" />
                Get the App
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn class="flex items-center gap-2">
                <LucideSmartphoneCn Class="h-5 w-5" Size="20" />
                Get the Mobile App
            </DialogTitleCn>
            <DialogDescriptionCn>Take your experience on the go with our mobile app.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-4 py-4">
            @* Benefits *@
            <div class="flex items-center justify-center gap-4">
                @foreach (var benefit in _appBenefits)
                {
                    <div class="flex flex-col items-center gap-1 text-center">
                        <div class="flex h-10 w-10 items-center justify-center rounded-full border">
                            @benefit.Icon
                        </div>
                        <span class="text-xs text-muted-foreground">@benefit.Text</span>
                    </div>
                }
            </div>

            <SeparatorCn />

            @if (_platform == "desktop")
            {
                @* Desktop view with tabs and QR code *@
                <TabsCn Value="@_activeTab" ValueChanged="@((string v) => _activeTab = v)">
                    <TabsListCn Class="grid w-full grid-cols-2">
                        <TabsTriggerCn Value="ios" Class="gap-2">
                            <LucideAppleCn Class="h-4 w-4" Size="16" />
                            iOS
                        </TabsTriggerCn>
                        <TabsTriggerCn Value="android" Class="gap-2">
                            <svg aria-label="Android" class="h-4 w-4" fill="currentColor" role="img" viewBox="0 0 24 24">
                                <path d="M17.523 15.341c-.5 0-.91.41-.91.91s.41.91.91.91.91-.41.91-.91-.41-.91-.91-.91zm-11.046 0c-.5 0-.91.41-.91.91s.41.91.91.91.91-.41.91-.91-.41-.91-.91-.91zm11.405-6.02l1.9-3.292c.105-.183.045-.418-.135-.525-.18-.108-.415-.046-.522.135l-1.924 3.334C15.631 8.325 13.895 7.945 12 7.945s-3.631.38-5.201 1.028L4.875 5.639c-.107-.181-.342-.243-.522-.135-.18.107-.24.342-.135.525l1.9 3.292C2.676 11.039.364 14.593.364 18.591h23.272c0-3.998-2.312-7.552-5.754-9.27zM6.477 15.341c-.5 0-.91.41-.91.91s.41.91.91.91.91-.41.91-.91-.41-.91-.91-.91zm11.046 0c-.5 0-.91.41-.91.91s.41.91.91.91.91-.41.91-.91-.41-.91-.91-.91z" />
                            </svg>
                            Android
                        </TabsTriggerCn>
                    </TabsListCn>

                    <TabsContentCn Value="ios" Class="space-y-4">
                        <div class="flex flex-col items-center py-4">
                            <div class="w-40 h-40 rounded-lg border-2 border-dashed flex items-center justify-center">
                                <div class="text-center">
                                    <LucideQrCodeCn Class="h-16 w-16 mx-auto text-muted-foreground" Size="64" />
                                    <p class="text-xs text-muted-foreground mt-2">Scan to download</p>
                                </div>
                            </div>
                            <p class="mt-4 text-sm text-center text-muted-foreground">
                                Scan with your iPhone camera
                            </p>
                        </div>
                        <ButtonCn Class="w-full">
                            <LucideAppleCn Class="mr-2 h-4 w-4" Size="16" />
                            Download on App Store
                            <LucideExternalLinkCn Class="ml-2 h-3 w-3" Size="12" />
                        </ButtonCn>
                    </TabsContentCn>

                    <TabsContentCn Value="android" Class="space-y-4">
                        <div class="flex flex-col items-center py-4">
                            <div class="w-40 h-40 rounded-lg border-2 border-dashed flex items-center justify-center">
                                <div class="text-center">
                                    <LucideQrCodeCn Class="h-16 w-16 mx-auto text-muted-foreground" Size="64" />
                                    <p class="text-xs text-muted-foreground mt-2">Scan to download</p>
                                </div>
                            </div>
                            <p class="mt-4 text-sm text-center text-muted-foreground">
                                Scan with your Android camera
                            </p>
                        </div>
                        <ButtonCn Class="w-full">
                            <svg aria-label="Google Play" class="mr-2 h-4 w-4" fill="currentColor" role="img" viewBox="0 0 24 24">
                                <path d="M3 20.5v-17c0-.83.67-1.5 1.5-1.5.31 0 .61.1.86.28l13.07 8.5c.63.41.63 1.33 0 1.74l-13.07 8.5c-.25.18-.55.28-.86.28-.83 0-1.5-.67-1.5-1.5z" />
                            </svg>
                            Get it on Google Play
                            <LucideExternalLinkCn Class="ml-2 h-3 w-3" Size="12" />
                        </ButtonCn>
                    </TabsContentCn>
                </TabsCn>
            }
            else
            {
                @* Mobile view with direct download *@
                <div class="space-y-4">
                    <div class="rounded-lg border p-4 text-center">
                        <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                            @(_platform == "ios" ? "iOS" : "Android") detected
                        </BadgeCn>
                        <p class="text-sm text-muted-foreground">Download directly to your device</p>
                    </div>

                    <ButtonCn Class="w-full" Size="ButtonSize.Lg">
                        @if (_platform == "ios")
                        {
                            <LucideAppleCn Class="mr-2 h-5 w-5" Size="20" />
                            <span>Download on App Store</span>
                        }
                        else
                        {
                            <LucideDownloadCn Class="mr-2 h-5 w-5" Size="20" />
                            <span>Get it on Google Play</span>
                        }
                    </ButtonCn>

                    <ButtonCn Class="w-full" Variant="ButtonVariant.Ghost">
                        Looking for @(_platform == "ios" ? "Android" : "iOS")?
                    </ButtonCn>
                </div>
            }

            @* App Info *@
            <div class="flex items-center justify-between rounded-lg border p-3 text-sm">
                <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-primary-foreground font-bold">
                        A
                    </div>
                    <div>
                        <p class="font-medium">App Name</p>
                        <div class="flex items-center gap-2">
                            <span class="text-xs text-muted-foreground">v2.4.1</span>
                            <span class="text-xs text-muted-foreground">&middot;</span>
                            <span class="text-xs text-muted-foreground">45 MB</span>
                        </div>
                    </div>
                </div>
                <div class="flex items-center gap-1">
                    <span class="text-xs font-medium">4.8</span>
                    <svg aria-label="Star rating" class="h-3 w-3 fill-yellow-400" role="img" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                </div>
            </div>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private record Benefit(RenderFragment Icon, string Text);

    private readonly Benefit[] _appBenefits;

    private bool _open;
    private string _platform = "desktop";
    private string _activeTab = "ios";

    public DialogDownloadApp()
    {
        _appBenefits = new Benefit[]
        {
            new((RenderFragment)(b => { b.OpenComponent<LucideZapCn>(0); b.AddAttribute(1, "Class", "h-5 w-5 text-primary"); b.AddAttribute(2, "Size", 20); b.CloseComponent(); }), "Faster performance"),
            new((RenderFragment)(b => { b.OpenComponent<LucideBellCn>(0); b.AddAttribute(1, "Class", "h-5 w-5 text-primary"); b.AddAttribute(2, "Size", 20); b.CloseComponent(); }), "Push notifications"),
            new((RenderFragment)(b => { b.OpenComponent<LucideWifiCn>(0); b.AddAttribute(1, "Class", "h-5 w-5 text-primary"); b.AddAttribute(2, "Size", 20); b.CloseComponent(); }), "Offline access"),
        };
    }
}
