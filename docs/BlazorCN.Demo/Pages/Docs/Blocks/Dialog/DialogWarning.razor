@* ========================================
   Block: dialog-warning
   Title: Dialog Warning
   Description: Destructive action warning dialog with alert icon, horizontal layout, and cancel/confirm buttons
   Long Description: Delete confirmation with password
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideAlertTriangleCn
   Source: original/blocks/dialog/dialog-warning.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Destructive">Deactivate</ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 384px;">
        <DialogHeaderCn>
            <div class="flex items-center gap-3">
                <LucideTriangleAlertCn Class="h-5 w-5 text-destructive shrink-0" Size="20" />
                <DialogTitleCn>Deactivate account</DialogTitleCn>
            </div>
            <DialogDescriptionCn Class="pt-2">
                Are you sure? All of your data will be permanently removed. This action cannot be undone.
            </DialogDescriptionCn>
        </DialogHeaderCn>
        <DialogFooterCn>
            <ButtonCn @onclick="@(() => _open = false)" Variant="ButtonVariant.Outline">
                Cancel
            </ButtonCn>
            <ButtonCn Class="text-white" @onclick="@(() => _open = false)" Variant="ButtonVariant.Destructive">
                Deactivate
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
}
