@* ========================================
   Block: dialog-command-palette
   Title: Dialog Command Palette
   Description: Command palette dialog with fuzzy search, categorized actions, keyboard navigation, and recent commands
   Dependencies: ButtonCn, CommandCn, CommandEmptyCn, CommandGroupCn, CommandInputCn, CommandItemCn, CommandListCn, CommandSeparatorCn, DialogCn, DialogContentCn, DialogTitleCn, DialogTriggerCn, LucideBellCn, LucideCommandCn, LucideCopyCn, LucideDownloadCn, LucideFileTextCn, LucideInfoCn, LucideLogOutCn, LucideMoonCn, LucideCirclePlusCn, LucideSearchCn, LucideSettingsCn, LucideShare2Cn, LucideTrash2Cn, LucideUploadCn, LucideUsersCn
   Source: original/blocks/dialog/dialog-command-palette.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Class="gap-2" Variant="ButtonVariant.Outline">
                <LucideSearchCn Class="h-4 w-4" Size="16" />
                <span>Search commands...</span>
                <kbd class="pointer-events-none ml-2 hidden h-5 select-none items-center gap-1 rounded border bg-muted px-1.5 font-mono text-[10px] font-medium opacity-100 sm:flex">
                    <span class="text-xs">&#x2318;</span>K
                </kbd>
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="overflow-hidden p-0 sm:max-w-lg">
        <DialogTitleCn Class="sr-only">Command Palette</DialogTitleCn>
        <CommandCn>
            <div class="flex items-center border-b px-3">
                <LucideCommandCn Class="mr-2 h-4 w-4 shrink-0 opacity-50" Size="16" />
                <CommandInputCn Placeholder="Type a command or search..." />
            </div>
            <CommandListCn Class="max-h-[400px] overflow-y-auto overflow-x-hidden">
                <CommandEmptyCn>No results found.</CommandEmptyCn>

                @* Recent *@
                <CommandGroupCn Heading="Recent">
                    <CommandItemCn Class="cursor-pointer">
                        <LucideFileTextCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Open Dashboard</span>
                        <KbdCn>&#x2318;D</KbdCn>
                    </CommandItemCn>
                    <CommandItemCn Class="cursor-pointer">
                        <LucideSettingsCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Open Settings</span>
                        <KbdCn>&#x2318;,</KbdCn>
                    </CommandItemCn>
                </CommandGroupCn>
                <CommandSeparatorCn />

                @* Actions *@
                <CommandGroupCn Heading="Actions">
                    <CommandItemCn Class="cursor-pointer">
                        <LucideCirclePlusCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Create New Document</span>
                        <KbdCn>&#x2318;N</KbdCn>
                    </CommandItemCn>
                    <CommandItemCn Class="cursor-pointer">
                        <LucideUploadCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Upload File</span>
                        <KbdCn>&#x2318;U</KbdCn>
                    </CommandItemCn>
                    <CommandItemCn Class="cursor-pointer">
                        <LucideDownloadCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Export Data</span>
                        <KbdCn>&#x2318;E</KbdCn>
                    </CommandItemCn>
                    <CommandItemCn Class="cursor-pointer">
                        <LucideShare2Cn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Share Current Page</span>
                        <KbdCn>&#x2318;&#x21E7;S</KbdCn>
                    </CommandItemCn>
                    <CommandItemCn Class="cursor-pointer">
                        <LucideCopyCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Copy Link</span>
                        <KbdCn>&#x2318;&#x21E7;C</KbdCn>
                    </CommandItemCn>
                </CommandGroupCn>
                <CommandSeparatorCn />

                @* Navigation *@
                <CommandGroupCn Heading="Navigation">
                    <CommandItemCn Class="cursor-pointer">
                        <LucideFileTextCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Go to Documents</span>
                    </CommandItemCn>
                    <CommandItemCn Class="cursor-pointer">
                        <LucideUsersCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Go to Team</span>
                    </CommandItemCn>
                    <CommandItemCn Class="cursor-pointer">
                        <LucideBellCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Go to Notifications</span>
                    </CommandItemCn>
                    <CommandItemCn Class="cursor-pointer">
                        <LucideSettingsCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Go to Settings</span>
                    </CommandItemCn>
                </CommandGroupCn>
                <CommandSeparatorCn />

                @* Preferences *@
                <CommandGroupCn Heading="Preferences">
                    <CommandItemCn Class="cursor-pointer">
                        <LucideMoonCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Toggle Dark Mode</span>
                        <KbdCn>&#x2318;&#x21E7;D</KbdCn>
                    </CommandItemCn>
                    <CommandItemCn Class="cursor-pointer">
                        <LucideBellCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Notification Settings</span>
                    </CommandItemCn>
                    <CommandItemCn Class="cursor-pointer">
                        <LucideInfoCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Help &amp; Support</span>
                        <KbdCn>&#x2318;?</KbdCn>
                    </CommandItemCn>
                </CommandGroupCn>
                <CommandSeparatorCn />

                @* Danger Zone *@
                <CommandGroupCn Heading="Danger Zone">
                    <CommandItemCn Class="cursor-pointer">
                        <LucideTrash2Cn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Delete Current Item</span>
                        <KbdCn>&#x2318;&#x232B;</KbdCn>
                    </CommandItemCn>
                    <CommandItemCn Class="cursor-pointer">
                        <LucideLogOutCn Class="mr-2 h-4 w-4" Size="16" />
                        <span>Sign Out</span>
                    </CommandItemCn>
                </CommandGroupCn>
            </CommandListCn>
            <div class="border-t px-3 py-2">
                <div class="flex items-center justify-between text-xs text-muted-foreground">
                    <div class="flex items-center gap-2">
                        <kbd class="rounded border bg-muted px-1.5 py-0.5">&#x2191;&#x2193;</kbd>
                        <span>Navigate</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <kbd class="rounded border bg-muted px-1.5 py-0.5">&#x21B5;</kbd>
                        <span>Select</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <kbd class="rounded border bg-muted px-1.5 py-0.5">esc</kbd>
                        <span>Close</span>
                    </div>
                </div>
            </div>
        </CommandCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
}
