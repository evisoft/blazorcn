   Block: dialog-create-workspace
   Title: Dialog Create Workspace
   Description: Create workspace form dialog with input field, switch toggle for privacy setting, and sectioned footer background
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, InputCn, LabelCn, SwitchCn
   Source: original/blocks/dialog/dialog-create-workspace.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-default cn-button-size-default" data-variant="default" data-size="default">Create Workspace</DialogTriggerCn>
    </div>
    <DialogContentCn Class="p-0 sm:max-w-lg">
        <DialogHeaderCn Class="px-6 pt-4">
            <DialogTitleCn Class="text-lg font-semibold text-foreground">
                Create workspace
            </DialogTitleCn>
            <DialogDescriptionCn Class="mt-2 text-sm leading-6 text-muted-foreground">
                Workspaces are shared environments where teams can connect to data sources, run queries
                and create reports.
            </DialogDescriptionCn>
        </DialogHeaderCn>

        <form>
            <div class="px-6 pb-4">
                <LabelCn Class="text-sm font-medium" For="workspace-name">
                    Workspace Name<span class="text-destructive">*</span>
                </LabelCn>
                <InputCn Class="mt-2" Id="workspace-name" Placeholder="My workspace" />
                <ButtonCn Class="mt-4 w-full" Type="submit">
                    Create workspace
                </ButtonCn>
            </div>
            <div class="border-t bg-muted rounded-b-md px-6 py-4">
                <div class="flex items-start space-x-3">
                    <div class="mt-1 pt-0.5">
                        <SwitchCn Id="enable-private-workspace" />
                    </div>
                    <div>
                        <LabelCn Class="text-sm font-medium" For="enable-private-workspace">
                            Set workspace to private
                        </LabelCn>
                        <p class="text-sm text-muted-foreground">
                            Only those invited can access or view
                        </p>
                    </div>
                </div>
            </div>
        </form>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
}
