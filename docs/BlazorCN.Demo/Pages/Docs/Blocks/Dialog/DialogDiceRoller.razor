@* ========================================
   Block: dialog-dice-roller
   Title: Dialog Dice Roller
   Description: Dice roller dialog with multiple dice types, quantity selection, roll animation, history log, and total calculation
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideDicesCn, LucideHistoryCn, LucideMinusCn, LucidePlusCn, LucideRotateCcwCn, LucideSparklesCn, LucideTrash2Cn, ScrollAreaCn, SeparatorCn
   Source: original/blocks/dialog/dialog-dice-roller.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideDicesCn Class="mr-2 h-4 w-4" Size="16" />
                Roll Dice
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        <DialogHeaderCn>
            <DialogTitleCn Class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideDicesCn Class="h-5 w-5" Size="20" />
                    Dice Roller
                </div>
                <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" @onclick="@(() => _showHistory = !_showHistory)">
                    <LucideHistoryCn Class="h-4 w-4" Size="16" />
                </ButtonCn>
            </DialogTitleCn>
            <DialogDescriptionCn>Select dice type and quantity, then roll!</DialogDescriptionCn>
        </DialogHeaderCn>

        @if (_showHistory)
        {
            <div class="space-y-3 py-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium">Roll History</span>
                    @if (_history.Count > 0)
                    {
                        <ButtonCn Class="h-7 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="@(() => _history.Clear())">
                            <LucideTrash2Cn Class="mr-1 h-3 w-3" Size="12" />
                            Clear
                        </ButtonCn>
                    }
                </div>
                <ScrollAreaCn Class="h-[300px]">
                    @if (_history.Count == 0)
                    {
                        <div class="flex flex-col items-center justify-center py-8 text-center">
                            <LucideHistoryCn Class="h-8 w-8 text-muted-foreground mb-2" Size="32" />
                            <p class="text-sm text-muted-foreground">No rolls yet</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var roll in _history)
                            {
                                <div class="@Cn.Merge("rounded-lg border p-3", roll.IsCritical ? "border-primary bg-primary/5" : "", roll.IsCriticalFail ? "border-destructive bg-destructive/5" : "")">
                                    <div class="flex items-center justify-between mb-1">
                                        <BadgeCn Variant="BadgeVariant.Outline">
                                            @roll.Quantity@(roll.DiceType.ToUpper())
                                        </BadgeCn>
                                        <span class="text-xs text-muted-foreground">
                                            @roll.Timestamp.ToString("hh:mm tt")
                                        </span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-sm text-muted-foreground">
                                            [@(string.Join(", ", roll.Results))]
                                        </span>
                                        <span class="font-mono font-bold">= @roll.Total</span>
                                    </div>
                                    @if (roll.IsCritical)
                                    {
                                        <BadgeCn Class="mt-1">Critical Hit!</BadgeCn>
                                    }
                                    @if (roll.IsCriticalFail)
                                    {
                                        <BadgeCn Class="mt-1" Variant="BadgeVariant.Destructive">Critical Fail!</BadgeCn>
                                    }
                                </div>
                            }
                        </div>
                    }
                </ScrollAreaCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline" @onclick="@(() => _showHistory = false)">
                    Back to Roller
                </ButtonCn>
            </div>
        }
        else
        {
            <div class="space-y-4 py-4">
                <div class="grid grid-cols-6 gap-2">
                    @foreach (var dice in _diceTypes)
                    {
                        var d = dice;
                        <ButtonCn Class="font-mono" Size="ButtonSize.Sm" Variant="@(_selectedDice == d.Type ? ButtonVariant.Default : ButtonVariant.Outline)" @onclick="@(() => _selectedDice = d.Type)">
                            @d.Label
                        </ButtonCn>
                    }
                </div>

                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium">Quantity</span>
                    <div class="flex items-center gap-2">
                        <ButtonCn Class="h-8 w-8" Disabled="@(_quantity <= 1)" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="@(() => _quantity = Math.Max(1, _quantity - 1))">
                            <LucideMinusCn Class="h-4 w-4" Size="16" />
                        </ButtonCn>
                        <span class="w-8 text-center font-mono font-bold text-lg">@_quantity</span>
                        <ButtonCn Class="h-8 w-8" Disabled="@(_quantity >= 10)" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" @onclick="@(() => _quantity = Math.Min(10, _quantity + 1))">
                            <LucidePlusCn Class="h-4 w-4" Size="16" />
                        </ButtonCn>
                    </div>
                </div>

                <div class="text-center py-2">
                    <BadgeCn Class="text-lg font-mono" Variant="BadgeVariant.Secondary">
                        @_quantity@(_selectedDice.ToUpper())
                    </BadgeCn>
                </div>

                <SeparatorCn />

                @if (_currentResult is not null)
                {
                    <div class="@Cn.Merge("rounded-lg border p-4 text-center transition-all", _isRolling ? "animate-pulse" : "", _currentResult.IsCritical ? "border-primary bg-primary/5" : "", _currentResult.IsCriticalFail ? "border-destructive bg-destructive/5" : "")">
                        @if (_currentResult.IsCritical && !_isRolling)
                        {
                            <div class="flex items-center justify-center gap-1 text-primary mb-2">
                                <LucideSparklesCn Class="h-4 w-4" Size="16" />
                                <span class="text-sm font-medium">Natural 20!</span>
                                <LucideSparklesCn Class="h-4 w-4" Size="16" />
                            </div>
                        }
                        @if (_currentResult.IsCriticalFail && !_isRolling)
                        {
                            <div class="text-destructive text-sm font-medium mb-2">Natural 1!</div>
                        }
                        <div class="text-4xl font-mono font-bold tabular-nums">
                            @_currentResult.Total
                        </div>
                        @if (_currentResult.Quantity > 1)
                        {
                            <div class="text-sm text-muted-foreground mt-2">
                                [@(string.Join(" + ", _currentResult.Results))]
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="rounded-lg border border-dashed p-4 text-center">
                        <p class="text-sm text-muted-foreground">Click roll to get started</p>
                    </div>
                }

                <ButtonCn Class="w-full" Disabled="@_isRolling" Size="ButtonSize.Lg" @onclick="RollDice">
                    @if (_isRolling)
                    {
                        <LucideRotateCcwCn Class="mr-2 h-5 w-5 animate-spin" Size="20" />
                        <span>Rolling...</span>
                    }
                    else
                    {
                        <LucideDicesCn Class="mr-2 h-5 w-5" Size="20" />
                        <span>Roll Dice</span>
                    }
                </ButtonCn>

                @if (_history.Count > 0)
                {
                    <p class="text-xs text-center text-muted-foreground">
                        @_history.Count roll@(_history.Count != 1 ? "s" : "") in history
                    </p>
                }
            </div>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _selectedDice = "d20";
    private int _quantity = 1;
    private bool _isRolling;
    private RollResult? _currentResult;
    private readonly List<RollResult> _history = new();
    private bool _showHistory;

    private readonly Random _random = new();

    private record DiceTypeInfo(string Type, int Sides, string Label);
    private static readonly DiceTypeInfo[] _diceTypes =
    [
        new("d4", 4, "D4"), new("d6", 6, "D6"), new("d8", 8, "D8"),
        new("d10", 10, "D10"), new("d12", 12, "D12"), new("d20", 20, "D20"),
    ];

    private record RollResult(string DiceType, int Quantity, int[] Results, int Total, DateTime Timestamp, bool IsCritical, bool IsCriticalFail);

    private int GetDiceSides(string type) => _diceTypes.FirstOrDefault(d => d.Type == type)?.Sides ?? 6;

    private async Task RollDice()
    {
        var sides = GetDiceSides(_selectedDice);
        _isRolling = true;
        StateHasChanged();

        // Animate with random values
        for (var i = 0; i < 10; i++)
        {
            var tempResults = Enumerable.Range(0, _quantity).Select(_ => _random.Next(1, sides + 1)).ToArray();
            _currentResult = new(
                _selectedDice, _quantity, tempResults,
                tempResults.Sum(), DateTime.Now, false, false);
            StateHasChanged();
            await Task.Delay(50);
        }

        // Final roll
        var finalResults = Enumerable.Range(0, _quantity).Select(_ => _random.Next(1, sides + 1)).ToArray();
        var total = finalResults.Sum();
        var isCritical = _selectedDice == "d20" && finalResults.Contains(20);
        var isCriticalFail = _selectedDice == "d20" && finalResults.Contains(1);

        _currentResult = new(
            _selectedDice, _quantity, finalResults,
            total, DateTime.Now, isCritical, isCriticalFail);

        _history.Insert(0, _currentResult);
        if (_history.Count > 20) _history.RemoveAt(20);

        _isRolling = false;
    }
}
