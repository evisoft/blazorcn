@* ========================================
   Block: dialog-savings-goal
   Title: Dialog Savings Goal
   Description: Savings goal dialog with progress bar, target amount, and quick deposit options
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCheckCn, LucidePiggyBankCn, ProgressCn
   Source: original/blocks/dialog/dialog-savings-goal.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucidePiggyBankCn Class="mr-2 h-4 w-4" Size="16" />
                Savings Goal
            </DialogTriggerCn>
    </div>
    <DialogContentCn style="max-width: 384px;">
        @if (_deposited)
        {
            <div class="flex flex-col items-center justify-center py-6 text-center">
                <LucideCheckCn Class="h-8 w-8 text-primary" Size="32" />
                <h3 class="mt-4 text-lg font-medium">Deposit Added</h3>
                <p class="mt-1 text-sm text-muted-foreground">
                    $@_selected added to @_goal.Name
                </p>
                <ButtonCn Class="mt-6" @onclick="HandleClose">
                    Done
                </ButtonCn>
            </div>
        }
        else
        {
            <DialogHeaderCn>
                <DialogTitleCn>@_goal.Name</DialogTitleCn>
                <DialogDescriptionCn>
                    $@(Remaining.ToString("N0")) left to reach your goal
                </DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="py-4 space-y-4">
                @* Progress *@
                <div class="space-y-2">
                    <div class="flex justify-between text-sm">
                        <span class="font-medium">$@(_goal.Current.ToString("N0"))</span>
                        <span class="text-muted-foreground">$@(_goal.Target.ToString("N0"))</span>
                    </div>
                    <ProgressCn Class="h-2" Value="@Progress" aria-label="Progress" />
                    <p class="text-xs text-muted-foreground text-center">@Progress% complete</p>
                </div>

                @* Quick deposit *@
                <div class="space-y-2">
                    <p class="text-sm font-medium">Quick deposit</p>
                    <div class="grid grid-cols-4 gap-2">
                        @foreach (var amount in _quickAmounts)
                        {
                            <button
                                type="button"
                                class="@Cn.Merge("py-2 rounded-md border text-sm font-medium transition-colors", _selected == amount ? "border-primary bg-primary/5" : "hover:border-muted-foreground/50")"
                                @onclick="@(() => _selected = amount)">
                                $@amount
                            </button>
                        }
                    </div>
                </div>
            </div>

            <DialogFooterCn>
                <ButtonCn @onclick="HandleClose" Variant="ButtonVariant.Outline">
                    Cancel
                </ButtonCn>
                <ButtonCn Disabled="@(_selected == 0)" @onclick="HandleDeposit">
                    Add $@(_selected > 0 ? _selected : 0)
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private int _selected;
    private bool _deposited;

    private record GoalData(string Name, int Target, int Current);

    private static readonly GoalData _goal = new("Vacation Fund", 2000, 1340);
    private static readonly int[] _quickAmounts = [25, 50, 100, 250];

    private int Progress => (int)Math.Round((double)_goal.Current / _goal.Target * 100);
    private int Remaining => _goal.Target - _goal.Current;

    private void HandleDeposit()
    {
        if (_selected == 0) return;
        _deposited = true;
    }

    private void HandleClose()
    {
        _open = false;
        _selected = 0;
        _deposited = false;
    }
}
