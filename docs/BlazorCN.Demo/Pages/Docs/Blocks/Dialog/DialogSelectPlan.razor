@* ========================================
   Block: dialog-select-plan
   Title: Dialog Select Plan
   Description: Select plan dialog with pricing tiers, feature comparison, and plan selection for subscription flows
   Dependencies: BadgeCn, ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCreditCardCn, LucideLoader2Cn
   Source: original/blocks/dialog/dialog-select-plan.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">
                <LucideCreditCardCn Class="mr-2 h-4 w-4" Size="16" />
                Change Plan
            </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        <DialogHeaderCn>
            <DialogTitleCn>Choose a Plan</DialogTitleCn>
            <DialogDescriptionCn>Select the plan that fits your needs.</DialogDescriptionCn>
        </DialogHeaderCn>

        <div class="space-y-2 py-4">
            @foreach (var plan in _plans)
            {
                <button
                    type="button"
                    class="@Cn.Merge("w-full flex items-center justify-between rounded-lg border p-3 text-left transition-colors", _selected == plan.Id ? "border-primary bg-primary/5" : "hover:bg-muted")"
                    @onclick="@(() => _selected = plan.Id)">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@plan.Name</span>
                            @if (plan.Popular)
                            {
                                <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                    Popular
                                </BadgeCn>
                            }
                        </div>
                        <p class="text-xs text-muted-foreground">@plan.Features</p>
                    </div>
                    <span class="text-sm font-semibold">
                        @(plan.Price == 0 ? "Free" : $"${plan.Price}/mo")
                    </span>
                </button>
            }
        </div>

        <DialogFooterCn>
            <ButtonCn @onclick="@(() => _open = false)" Variant="ButtonVariant.Outline">
                Cancel
            </ButtonCn>
            <ButtonCn Disabled="@_isLoading" @onclick="HandleSelect">
                @if (_isLoading)
                {
                    <LucideLoaderCircleCn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    <span>Updating...</span>
                }
                else
                {
                    <span>Confirm</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private string _selected = "pro";
    private bool _isLoading;

    private record PlanData(string Id, string Name, int Price, string Features, bool Popular = false);

    private static readonly PlanData[] _plans =
    [
        new("free", "Free", 0, "3 projects, 1 GB storage"),
        new("pro", "Pro", 29, "Unlimited projects, 25 GB", true),
        new("team", "Team", 79, "Everything in Pro + SSO")
    ];

    private async Task HandleSelect()
    {
        _isLoading = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isLoading = false;
        _open = false;
    }
}
