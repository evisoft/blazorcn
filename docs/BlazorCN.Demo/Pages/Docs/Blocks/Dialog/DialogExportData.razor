@* ========================================
   Block: dialog-export-data
   Title: Dialog Export Data
   Description: Export data dialog with format selection, date range filters, field customization, and download progress
   Dependencies: BadgeCn, ButtonCn, CheckboxCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LabelCn, LucideCalendarCn, LucideCheckCn, LucideDownloadCn, LucideFileSpreadsheetCn, LucideFileTextCn, LucideLoader2Cn, ProgressCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SeparatorCn
   Source: original/blocks/dialog/dialog-export-data.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideDownloadCn Class="mr-2 h-4 w-4" Size="16" />
                Export Data
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn class="sm:max-w-md">
        <DialogHeaderCn>
            <DialogTitleCn class="flex items-center gap-2">
                <LucideDownloadCn Class="h-5 w-5" Size="20" />
                Export Data
            </DialogTitleCn>
            <DialogDescriptionCn>
                Configure your export settings and download your data.
            </DialogDescriptionCn>
        </DialogHeaderCn>

        @if (_isComplete)
        {
            <div class="flex flex-col items-center py-8 text-center">
                <div class="rounded-full border-2 border-primary p-3 mb-4">
                    <LucideCheckCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <h3 class="font-semibold">Export Complete</h3>
                <p class="text-sm text-muted-foreground mt-1">
                    Your @(_formatLabels[_format]) file has been downloaded.
                </p>
                <ButtonCn Class="mt-4" @onclick="HandleClose">
                    Done
                </ButtonCn>
            </div>
        }
        else if (_isExporting)
        {
            <div class="space-y-4 py-6">
                <div class="flex items-center justify-center">
                    <LucideLoader2Cn Class="h-8 w-8 animate-spin text-primary" Size="32" />
                </div>
                <div class="space-y-2">
                    <div class="flex justify-between text-sm">
                        <span>Exporting...</span>
                        <span class="font-mono">@(_progress)%</span>
                    </div>
                    <ProgressCn Value="_progress" />
                </div>
                <p class="text-xs text-center text-muted-foreground">
                    Preparing @_selectedFields.Count fields as @(_formatLabels[_format])
                </p>
            </div>
        }
        else
        {
            <div class="space-y-4 py-4">
                <div class="space-y-2">
                    <LabelCn>Format</LabelCn>
                    <div class="grid grid-cols-3 gap-2">
                        @foreach (var f in _formats)
                        {
                            <button type="button"
                                    class="@Cn.Merge("flex flex-col items-center gap-1 rounded-lg border p-3 transition-colors", _format == f.Id ? "border-primary bg-primary/5" : "hover:bg-muted")"
                                    @onclick="@(() => _format = f.Id)">
                                @f.IconFragment
                                <span class="text-sm font-medium">@f.Label</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="space-y-2">
                    <LabelCn>Date Range</LabelCn>
                    <SelectCn Value="@_dateRange" ValueChanged="@((string v) => _dateRange = v)">
                        <SelectTriggerCn>
                            <LucideCalendarCn Class="mr-2 h-4 w-4" Size="16" />
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var range in _dateRanges)
                            {
                                <SelectItemCn Value="@range.Id">@range.Label</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <SeparatorCn />

                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <LabelCn>Fields to Export</LabelCn>
                        <ButtonCn Class="h-auto py-1 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="HandleSelectAll">
                            Select All
                        </ButtonCn>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        @foreach (var field in _fields)
                        {
                            <div class="flex items-center space-x-2">
                                <CheckboxCn Checked="@_selectedFields.Contains(field.Id)"
                                            Disabled="@(field.Required)"
                                            CheckedChanged="@((bool _) => HandleFieldToggle(field.Id))"
                                            id="@field.Id" />
                                <LabelCn Class="text-sm font-normal cursor-pointer" For="@field.Id">
                                    @field.Label
                                    @if (field.Required)
                                    {
                                        <span class="text-xs text-muted-foreground ml-1">(required)</span>
                                    }
                                </LabelCn>
                            </div>
                        }
                    </div>
                </div>

                <div class="rounded-lg border p-3">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-muted-foreground">Export summary</span>
                        <BadgeCn Variant="BadgeVariant.Secondary">@_selectedFields.Count fields</BadgeCn>
                    </div>
                </div>
            </div>

            <DialogFooterCn>
                <ButtonCn Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">
                    Cancel
                </ButtonCn>
                <ButtonCn Disabled="@(_selectedFields.Count == 0)" @onclick="HandleExport">
                    <LucideFileTextCn Class="mr-2 h-4 w-4" Size="16" />
                    Export @(_formatLabels[_format])
                </ButtonCn>
            </DialogFooterCn>
        }
    </DialogContentCn>
</DialogCn>

@code {
    private record FormatOption(string Id, string Label, RenderFragment IconFragment);
    private record FieldOption(string Id, string Label, string Description, bool Required = false);
    private record DateRangeOption(string Id, string Label);

    private readonly FormatOption[] _formats;

    private static readonly FieldOption[] _fields =
    [
        new("id", "ID", "Unique identifier", true),
        new("name", "Name", "Display name"),
        new("email", "Email", "Email address"),
        new("created", "Created Date", "When the record was created"),
        new("updated", "Updated Date", "Last modification date"),
        new("status", "Status", "Current status"),
        new("metadata", "Metadata", "Additional information"),
    ];

    private static readonly DateRangeOption[] _dateRanges =
    [
        new("all", "All time"),
        new("today", "Today"),
        new("week", "Last 7 days"),
        new("month", "Last 30 days"),
        new("quarter", "Last 90 days"),
        new("year", "Last year"),
    ];

    private static readonly Dictionary<string, string> _formatLabels = new()
    {
        ["csv"] = "CSV",
        ["json"] = "JSON",
        ["xlsx"] = "Excel",
    };

    private bool _open;
    private string _format = "csv";
    private string _dateRange = "all";
    private List<string> _selectedFields = new(_fields.Select(f => f.Id));
    private bool _isExporting;
    private int _progress;
    private bool _isComplete;

    public DialogExportData()
    {
        _formats = new FormatOption[]
        {
            new("csv", "CSV", (RenderFragment)(b => { b.OpenComponent<LucideFileTextCn>(0); b.AddAttribute(1, "Class", "h-5 w-5"); b.AddAttribute(2, "Size", 20); b.CloseComponent(); })),
            new("json", "JSON", (RenderFragment)(b => { b.OpenComponent<LucideFileCodeCn>(0); b.AddAttribute(1, "Class", "h-5 w-5"); b.AddAttribute(2, "Size", 20); b.CloseComponent(); })),
            new("xlsx", "Excel", (RenderFragment)(b => { b.OpenComponent<LucideFileSpreadsheetCn>(0); b.AddAttribute(1, "Class", "h-5 w-5"); b.AddAttribute(2, "Size", 20); b.CloseComponent(); })),
        };
    }

    private void HandleFieldToggle(string fieldId)
    {
        var field = _fields.FirstOrDefault(f => f.Id == fieldId);
        if (field?.Required == true) return;

        if (_selectedFields.Contains(fieldId))
            _selectedFields.Remove(fieldId);
        else
            _selectedFields.Add(fieldId);
    }

    private void HandleSelectAll()
    {
        _selectedFields = new List<string>(_fields.Select(f => f.Id));
    }

    private async Task HandleExport()
    {
        _isExporting = true;
        _progress = 0;
        StateHasChanged();

        for (var i = 0; i <= 100; i += 10)
        {
            await Task.Delay(200);
            _progress = i;
            StateHasChanged();
        }

        _isExporting = false;
        _isComplete = true;
    }

    private void HandleClose()
    {
        _open = false;
        _isComplete = false;
        _progress = 0;
    }
}
