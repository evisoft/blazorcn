@* ========================================
   Block: dialog-contact-picker
   Title: Dialog Contact Picker
   Description: Contact picker dialog with searchable list, multi-select, recent contacts, and grouped alphabetically
   Dependencies: AvatarCn, AvatarFallbackCn, BadgeCn, ButtonCn, CheckboxCn, CommandCn, CommandEmptyCn, CommandGroupCn, CommandInputCn, CommandItemCn, CommandListCn, CommandSeparatorCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, DialogTriggerCn, LucideCheckCn, LucideClockCn, LucideLoader2Cn, LucideSearchCn, LucideUsersCn, LucideXCn
   Source: original/blocks/dialog/dialog-contact-picker.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn>
            <ButtonCn Variant="ButtonVariant.Outline">
                <LucideUsersCn Class="mr-2 h-4 w-4" Size="16" />
                Select Contacts
            </ButtonCn>
        </DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-lg p-0 overflow-hidden">
        <DialogHeaderCn Class="p-4 pb-0">
            <DialogTitleCn Class="flex items-center gap-2">
                <LucideUsersCn Class="h-5 w-5" Size="20" />
                Select Contacts
            </DialogTitleCn>
            <DialogDescriptionCn>Choose one or more contacts to share with.</DialogDescriptionCn>
        </DialogHeaderCn>

        @* Selected Preview *@
        @if (_selectedIds.Count > 0)
        {
            <div class="px-4 py-2 border-b">
                <div class="flex items-center gap-2 flex-wrap">
                    @foreach (var contact in _allContacts.Where(c => _selectedIds.Contains(c.Id)).Take(3))
                    {
                        var c = contact;
                        <BadgeCn Class="gap-1 pr-1" Variant="BadgeVariant.Secondary">
                            @c.Name.Split(' ')[0]
                            <button type="button" class="ml-1 rounded-full p-0.5 hover:bg-muted" @onclick="@(() => ToggleContact(c.Id))">
                                <LucideXCn Class="h-3 w-3" Size="12" />
                            </button>
                        </BadgeCn>
                    }
                    @if (_selectedIds.Count > 3)
                    {
                        <BadgeCn Variant="BadgeVariant.Outline">+@(_selectedIds.Count - 3) more</BadgeCn>
                    }
                    <ButtonCn Class="h-6 text-xs ml-auto" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="@(() => _selectedIds.Clear())">
                        Clear all
                    </ButtonCn>
                </div>
            </div>
        }

        <CommandCn Class="border-0">
            <div class="flex items-center border-b px-3">
                <LucideSearchCn Class="mr-2 h-4 w-4 shrink-0 opacity-50" Size="16" />
                <CommandInputCn Placeholder="Search contacts..." />
            </div>
            <CommandListCn Class="max-h-[300px]">
                <CommandEmptyCn>No contacts found.</CommandEmptyCn>

                @* All Contacts grouped alphabetically *@
                @foreach (var group in _groupedContacts)
                {
                    <CommandGroupCn Heading="@group.Key.ToString()">
                        @foreach (var contact in group)
                        {
                            var c = contact;
                            <CommandItemCn Class="cursor-pointer">
                                <div class="flex items-center gap-3 flex-1">
                                    <CheckboxCn Checked="@_selectedIds.Contains(c.Id)" Class="pointer-events-none" />
                                    <AvatarCn Class="h-8 w-8">
                                        <AvatarFallbackCn Class="text-xs">@c.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium truncate">@c.Name</p>
                                        <p class="text-xs text-muted-foreground truncate">@c.Email</p>
                                    </div>
                                </div>
                            </CommandItemCn>
                        }
                    </CommandGroupCn>
                }
            </CommandListCn>
        </CommandCn>

        <DialogFooterCn Class="p-4 border-t">
            <div class="flex items-center gap-2 mr-auto">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="HandleSelectAll">
                    @(_selectedIds.Count == _allContacts.Length ? "Deselect all" : "Select all")
                </ButtonCn>
            </div>
            <ButtonCn Disabled="@_isConfirming" Variant="ButtonVariant.Outline" @onclick="@(() => _open = false)">
                Cancel
            </ButtonCn>
            <ButtonCn Disabled="@(_selectedIds.Count == 0 || _isConfirming)" @onclick="HandleConfirm">
                @if (_isConfirming)
                {
                    <LucideLoader2Cn Class="mr-2 h-4 w-4 animate-spin" Size="16" />
                    <span>Adding...</span>
                }
                else
                {
                    <LucideCheckCn Class="mr-2 h-4 w-4" Size="16" />
                    <span>Add @(_selectedIds.Count > 0 ? $"({_selectedIds.Count})" : "")</span>
                }
            </ButtonCn>
        </DialogFooterCn>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;
    private bool _isConfirming;
    private readonly HashSet<string> _selectedIds = new();

    private record Contact(string Id, string Name, string Email, string Initials);

    private static readonly Contact[] _allContacts =
    [
        new("1", "Alice Johnson", "alice@example.com", "AJ"),
        new("2", "Bob Smith", "bob@example.com", "BS"),
        new("3", "Carol Williams", "carol@example.com", "CW"),
        new("4", "David Brown", "david@example.com", "DB"),
        new("5", "Emma Davis", "emma@example.com", "ED"),
        new("6", "Frank Miller", "frank@example.com", "FM"),
        new("7", "Grace Wilson", "grace@example.com", "GW"),
        new("8", "Henry Taylor", "henry@example.com", "HT"),
        new("9", "Ivy Anderson", "ivy@example.com", "IA"),
        new("10", "Jack Thomas", "jack@example.com", "JT"),
    ];

    private IEnumerable<IGrouping<char, Contact>> _groupedContacts =>
        _allContacts.GroupBy(c => c.Name[0]).OrderBy(g => g.Key);

    private void ToggleContact(string id)
    {
        if (!_selectedIds.Remove(id))
            _selectedIds.Add(id);
    }

    private void HandleSelectAll()
    {
        if (_selectedIds.Count == _allContacts.Length)
            _selectedIds.Clear();
        else
        {
            _selectedIds.Clear();
            foreach (var c in _allContacts) _selectedIds.Add(c.Id);
        }
    }

    private async Task HandleConfirm()
    {
        _isConfirming = true;
        StateHasChanged();
        await Task.Delay(1000);
        _isConfirming = false;
        _open = false;
    }
}
