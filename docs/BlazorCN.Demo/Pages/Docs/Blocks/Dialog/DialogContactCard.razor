@* ========================================
   Block: dialog-contact-card
   Title: Dialog Contact Card
   Description: Contact card dialog with avatar, name, contact details, and quick action buttons for email, call, and message
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, ButtonCn, DialogCn, DialogContentCn, DialogTitleCn, DialogTriggerCn, LucideBadgeCheckCn, LucideMailCn, LucideMapPinCn, LucidePhoneCn
   Source: original/blocks/dialog/dialog-contact-card.tsx
   ======================================== *@

<DialogCn @bind-Open="_open">
    <div class="flex min-h-[350px] items-center justify-center">
        <DialogTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default" data-variant="outline" data-size="default">View Contact</DialogTriggerCn>
    </div>
    <DialogContentCn Class="sm:max-w-sm">
        <DialogTitleCn Class="sr-only">Contact Details</DialogTitleCn>

        @* Profile *@
        <div class="flex flex-col items-center text-center pt-2 pb-4">
            <div class="relative">
                <AvatarCn Class="h-20 w-20">
                    <AvatarImageCn Src="@_contact.Avatar" Alt="@_contact.Name" />
                    <AvatarFallbackCn Class="text-lg">@_contact.Initials</AvatarFallbackCn>
                </AvatarCn>
                @if (_contact.Status == "online")
                {
                    <span class="absolute bottom-1 right-1 h-3.5 w-3.5 rounded-full bg-green-500 border-2 border-background"></span>
                }
            </div>
            <div class="mt-4">
                <div class="flex items-center justify-center gap-1.5">
                    <h3 class="font-semibold text-lg">@_contact.Name</h3>
                    @if (_contact.Verified)
                    {
                        <LucideBadgeCheckCn Class="h-4 w-4 text-primary" Size="16" />
                    }
                </div>
                <p class="text-sm text-muted-foreground mt-0.5">
                    @_contact.Role &middot; @_contact.Company
                </p>
            </div>
        </div>

        @* Contact details *@
        <div class="space-y-2 py-2">
            <div class="flex items-center gap-3 text-sm">
                <LucideMailCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                <span>@_contact.Email</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
                <LucidePhoneCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                <span>@_contact.Phone</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
                <LucideMapPinCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                <span>@_contact.Location</span>
            </div>
        </div>

        @* Quick actions *@
        <div class="flex gap-2 pt-4">
            <a href="mailto:@_contact.Email" class="flex-1">
                <ButtonCn Class="w-full">
                    <LucideMailCn Class="mr-2 h-4 w-4" Size="16" />
                    Email
                </ButtonCn>
            </a>
            <a href="tel:@_contact.Phone" class="flex-1">
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    <LucidePhoneCn Class="mr-2 h-4 w-4" Size="16" />
                    Call
                </ButtonCn>
            </a>
        </div>
    </DialogContentCn>
</DialogCn>

@code {
    private bool _open;

    private record ContactInfo(string Name, string Role, string Company, string Avatar, string Initials, bool Verified, string Email, string Phone, string Location, string Status);

    private static readonly ContactInfo _contact = new(
        "Sarah Chen",
        "Senior Product Designer",
        "Acme Inc.",
        "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=200&h=200&auto=format&fit=crop",
        "SC",
        true,
        "sarah.chen@acme.com",
        "+1 (555) 123-4567",
        "San Francisco, CA",
        "online"
    );
}
