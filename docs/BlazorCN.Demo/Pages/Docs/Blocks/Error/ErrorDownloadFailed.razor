@* ============================================================
   Block: error-download-failed
   Title: ErrorDownloadFailed
   Description: Download failed error with retry options and alternative download methods
   Source: original/blocks/error/error-download-failed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header — icon + title + description *@
        <div class="border-b px-4 py-6">
            <div class="flex items-start gap-4">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="download" Size="24" Class="size-6 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="font-medium text-sm">Download Failed</h1>
                    <p class="mt-1 text-muted-foreground text-sm">
                        The download couldn't be completed. Check your connection and storage space, then
                        try again.
                    </p>
                </div>
            </div>
        </div>

        @* Download Details *@
        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Download Details</h2>
            <div class="mt-3 space-y-2">
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">File name</span>
                    <span class="truncate font-mono text-xs">software-installer.dmg</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">File size</span>
                    <span class="tabular-nums text-xs">2.4 GB</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">Attempt time</span>
                    <span class="text-xs">Just now</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">Error code</span>
                    <span class="font-mono text-xs">ERR_NETWORK_FAILED</span>
                </div>
            </div>
        </div>

        @* System Check *@
        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">System Check</h2>
            <div class="mt-3 space-y-2">
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">Available storage</span>
                    <span class="tabular-nums text-xs">45.2 GB free</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">Connection status</span>
                    <span class="text-emerald-600 text-xs">Online</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">Browser downloads</span>
                    <span class="text-xs">Enabled</span>
                </div>
            </div>
        </div>

        @* Troubleshooting Tips *@
        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Troubleshooting Tips</h2>
            <ul class="mt-3 space-y-2 text-muted-foreground text-xs">
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">1.</span>
                    <span>Check you have at least 3 GB free space (file is 2.4 GB)</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">2.</span>
                    <span>Disable VPN or proxy temporarily</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">3.</span>
                    <span>Clear browser cache and download history</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">4.</span>
                    <span>Try downloading from a mirror server</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">5.</span>
                    <span>Use a download manager for large files</span>
                </li>
            </ul>
        </div>

        @* Actions *@
        <div class="px-4 py-4">
            <div class="flex flex-wrap gap-2">
                <ButtonCn OnClick="HandleRetry" Disabled="@_isRetrying" Class="h-8 gap-2">
                    <LucideIconCn Name="refresh-cw" Size="14" Class="@Cn.Merge("size-3.5", _isRetrying ? "animate-spin" : "")" />
                    @(_isRetrying ? "Retrying..." : "Retry Download")
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-8 gap-2">
                    <LucideIconCn Name="server" Size="14" Class="size-3.5" />
                    Try Mirror
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-8 gap-2">
                    <LucideIconCn Name="hard-drive" Size="14" Class="size-3.5" />
                    Check Storage
                </ButtonCn>
            </div>
            <p class="mt-3 text-muted-foreground text-xs">
                If the issue persists, contact support with error code ERR_NETWORK_FAILED.
            </p>
        </div>

    </div>
</section>

@code {
    private bool _isRetrying = false;

    private async Task HandleRetry()
    {
        _isRetrying = true;
        await Task.Delay(2000);
        _isRetrying = false;
    }
}
