@* ============================================================
   Block: error-feature-flag
   Title: ErrorFeatureFlag
   Description: Error page for features behind feature flags or in development
   Source: original/blocks/error/error-feature-flag.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border bg-blue-500/10">
                    <LucideIconCn Name="sparkles" Size="20" Class="size-5 text-blue-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <div class="mb-1 flex items-center gap-2">
                        <h1 class="text-sm font-medium">Advanced Analytics Dashboard</h1>
                        <span class="inline-flex items-center gap-1 rounded-full bg-blue-500/10 px-2 py-0.5 text-xs font-medium text-blue-600">
                            Coming Soon
                        </span>
                    </div>
                    <p class="mt-1 text-xs text-muted-foreground">
                        This feature is currently in development and will be available soon. Join the
                        waitlist to get early access and be notified when it launches.
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="map" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Development Progress</span>
            </div>
            <div class="space-y-2">
                @foreach (var roadmapItem in _roadmapItems)
                {
                    var item = roadmapItem;
                    <div class="flex items-center gap-3">
                        <div class="@(item.Status == "completed"
                                        ? "flex size-6 shrink-0 items-center justify-center rounded-full border border-emerald-500/30 bg-emerald-500/10"
                                        : item.Status == "in-progress"
                                            ? "flex size-6 shrink-0 items-center justify-center rounded-full border border-blue-500/30 bg-blue-500/10"
                                            : "flex size-6 shrink-0 items-center justify-center rounded-full border border-muted-foreground/20 bg-muted/30")">
                            @if (item.Status == "completed")
                            {
                                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-600" />
                            }
                            else
                            {
                                <span class="@(item.Status == "in-progress" ? "text-xs font-medium text-blue-600" : "text-xs font-medium text-muted-foreground/60")">
                                    @item.Index
                                </span>
                            }
                        </div>
                        <div class="flex flex-1 items-center justify-between">
                            <div>
                                <div class="text-sm font-medium">@item.Title</div>
                                <div class="text-xs text-muted-foreground">@item.Phase</div>
                            </div>
                            <span class="@(item.Status == "completed"
                                            ? "text-xs text-emerald-600"
                                            : item.Status == "in-progress"
                                                ? "text-xs text-blue-600"
                                                : "text-xs text-muted-foreground")">
                                @(item.Status == "completed"
                                    ? "Complete"
                                    : item.Status == "in-progress"
                                        ? "In Progress"
                                        : "Upcoming")
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Get Notified at Launch</span>
            </div>
            <p class="mb-3 text-xs text-muted-foreground">
                Join 2,847 others on the waitlist for early access
            </p>
            <div class="flex gap-2">
                <InputCn type="email" Placeholder="@("your@email.com")" Class="h-8 text-xs" />
                <ButtonCn Size="ButtonSize.Sm" Class="shrink-0">
                    Join Waitlist
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                View Full Roadmap
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                Learn More
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record RoadmapItem(string Phase, string Status, string Title, int Index);

    private static readonly RoadmapItem[] _roadmapItems =
    [
        new("Phase 1", "completed", "Core infrastructure", 1),
        new("Phase 2", "completed", "Beta testing", 2),
        new("Phase 3", "in-progress", "Security audit", 3),
        new("Phase 4", "upcoming", "Public release", 4),
    ];

    private string _email = "";
}
