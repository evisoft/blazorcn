@* ============================================================
   Block: error-country-restricted
   Title: ErrorCountryRestricted
   Description: Service not available in user's country with available regions list and expansion waitlist
   Source: original/blocks/error/error-country-restricted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-blue-500/10">
                    <LucideIconCn Name="globe" Size="20" Class="size-5 text-blue-600" />
                </div>
                <div>
                    <p class="text-sm font-medium">Not available in your region</p>
                    <p class="text-xs text-muted-foreground">
                        Service restricted in @_detectedCountry
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-sm text-muted-foreground">
                Our service is not currently available in @_detectedRegion. We're working on expanding
                globally and would love to bring this to you soon.
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2 rounded-lg bg-muted/50 px-3 py-2">
                <LucideIconCn Name="map-pin" Size="16" Class="size-4 text-muted-foreground" />
                <div class="text-sm">
                    <span class="text-muted-foreground">Detected location: </span>
                    <span class="font-medium">@_detectedCountry</span>
                </div>
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-3">
                <p class="text-xs font-medium text-muted-foreground">Currently available in</p>
            </div>
            @foreach (var region in _availableRegions)
            {
                <div class="flex items-center justify-between border-b px-4 py-3 last:border-b-0">
                    <span class="text-sm">@region.Name</span>
                    <span class="rounded bg-emerald-500/10 px-2 py-0.5 text-xs font-medium text-emerald-600">
                        @region.Status
                    </span>
                </div>
            }
        </div>

        <div class="border-t">
            <div class="border-b px-4 py-3">
                <p class="text-xs font-medium text-muted-foreground">Planned expansion</p>
            </div>
            @foreach (var region in _upcomingRegions)
            {
                <div class="flex items-center justify-between border-b px-4 py-3 last:border-b-0">
                    <span class="text-sm">@region.Name</span>
                    <span class="rounded bg-blue-500/10 px-2 py-0.5 text-xs font-medium text-blue-600">
                        @region.Eta
                    </span>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <div class="space-y-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">
                        Get notified when we launch in @_detectedCountry
                    </span>
                </div>
                <div class="flex gap-2">
                    <InputCn type="email" Placeholder="@("your@email.com")" Class="text-sm" @bind-Value="_emailInput" />
                    <ButtonCn Size="ButtonSize.Sm" Class="shrink-0">
                        Join waitlist
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
            <div class="flex items-start gap-2">
                <LucideIconCn Name="info" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                <p class="text-xs text-muted-foreground">
                    If you believe this is an error, please contact support with your location details.
                </p>
            </div>
        </div>

    </div>
</section>

@code {
    private string _detectedCountry = "Germany";
    private string _detectedRegion = "Europe";
    private string _emailInput = "";

    private record AvailableRegion(string Name, string Status);
    private record UpcomingRegion(string Name, string Eta);

    private static readonly AvailableRegion[] _availableRegions =
    [
        new("United States", "Available"),
        new("Canada", "Available"),
        new("United Kingdom", "Available"),
        new("Australia", "Available"),
        new("New Zealand", "Available"),
    ];

    private static readonly UpcomingRegion[] _upcomingRegions =
    [
        new("European Union", "Q3 2026"),
        new("Japan", "Q4 2026"),
    ];
}
