@* ============================================================
   Block: error-404-illustration
   Title: Error404Illustration
   Description: An illustrated 404 error page block for React and Next.js with placeholder visual area and dual action buttons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/error/error-404-illustration.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-col items-center px-4 py-12 text-center">
            <div class="mb-6 flex w-full items-center justify-center rounded-md bg-muted aspect-video"
                 aria-label="404 illustration placeholder">
                <span class="font-medium text-muted-foreground text-sm">
                    Illustration goes here
                </span>
            </div>

            <div>
                <h1 class="mb-4 font-semibold tabular-nums text-4xl tracking-tight">404</h1>
                <h2 class="mb-2 font-medium text-lg">Page not found</h2>
                <p class="mb-8 text-muted-foreground text-sm">
                    We couldn't find the page you're looking for. It might have been moved or deleted.
                </p>
            </div>

            <div class="flex flex-wrap items-center justify-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-2 text-xs">
                    <LucideIconCn Name="house" Size="14" Class="size-3.5" />
                    Go home
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 gap-2 text-xs">
                    <LucideIconCn Name="search" Size="14" Class="size-3.5" />
                    Search site
                </ButtonCn>
            </div>
        </div>
    </div>
</section>
