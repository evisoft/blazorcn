@* ============================================================
   Block: error-toast-style
   Title: ErrorToastStyle
   Description: Error notifications styled as dismissible toast cards with auto-retry
   Source: original/blocks/error/error-toast-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h1 class="font-medium text-sm">Notifications</h1>
                <span class="rounded-full bg-red-500/10 px-2 py-0.5 font-mono text-red-500 text-xs">
                    @(_toasts.Count(t => t.Type == "error")) error
                </span>
            </div>
        </div>

        @* Toast Stack *@
        <div class="p-4">
            <div class="space-y-3">
                @foreach (var toast in _toasts)
                {
                    <div class="overflow-hidden rounded-lg border bg-muted/50">
                        <div class="flex items-start gap-3 px-4 py-3">
                            <span class="@Cn.Merge("mt-0.5 size-1.5 shrink-0 rounded-full", GetToastColor(toast.Type))"></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="min-w-0 flex-1">
                                        <div class="font-medium text-sm">@toast.Title</div>
                                        <p class="mt-0.5 text-muted-foreground text-xs">@toast.Message</p>
                                        <div class="mt-2 flex items-center gap-2">
                                            <span class="font-mono text-muted-foreground text-xs">
                                                @toast.Time
                                            </span>
                                            @if (toast.Type == "error")
                                            {
                                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-5 gap-1 px-1.5">
                                                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                                                    <span class="text-xs">Retry</span>
                                                </ButtonCn>
                                            }
                                        </div>
                                    </div>
                                    <button type="button"
                                            class="shrink-0 text-muted-foreground/60 transition-colors hover:text-muted-foreground"
                                            aria-label="Dismiss notification">
                                        <LucideIconCn Name="x" Size="16" Class="size-4" />
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Actions *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Clear all
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                    Retry failed
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Toast(string Id, string Type, string Title, string Message, string Time);

    private static readonly Toast[] _toasts =
    [
        new("1", "error",   "Connection failed", "Unable to reach server. Retrying...",    "Just now"),
        new("2", "warning", "Slow response",      "API taking longer than expected",        "30s ago"),
        new("3", "success", "Reconnected",         "Connection restored successfully",       "1 min ago"),
    ];

    private static string GetToastColor(string type) => type switch
    {
        "error"   => "bg-red-500",
        "warning" => "bg-amber-500",
        "success" => "bg-emerald-500",
        "info"    => "bg-blue-500",
        _         => "bg-muted-foreground",
    };
}
