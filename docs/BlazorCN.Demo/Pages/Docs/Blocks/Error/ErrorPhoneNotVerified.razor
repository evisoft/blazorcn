@* ============================================================
   Block: error-phone-not-verified
   Title: ErrorPhoneNotVerified
   Description: Error page prompting users to verify their phone number via SMS code before accessing protected features
   Source: original/blocks/error/error-phone-not-verified.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-blue-500/10">
                    <LucideIconCn Name="phone" Size="20" Class="size-5 text-blue-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Verify Your Phone Number</h1>
                    <p class="text-xs text-muted-foreground">Two-factor authentication required</p>
                </div>
            </div>
        </div>

        @* Phone Number *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-2">
                <div class="min-w-0 flex-1">
                    <span class="text-xs text-muted-foreground">SMS will be sent to</span>
                    <p class="mt-0.5 font-mono text-sm">+1 (&#x2022;&#x2022;&#x2022;) &#x2022;&#x2022;&#x2022;-4829</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 text-xs">
                    Unverified
                </BadgeCn>
            </div>
        </div>

        @* Instructions *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <span class="text-xs font-medium">How It Works</span>
                <ol class="space-y-1.5 pl-4 text-sm text-muted-foreground">
                    <li class="list-decimal">Click "Send SMS Code" to receive a text message</li>
                    <li class="list-decimal">Enter the 6-digit code from the SMS</li>
                    <li class="list-decimal">Your phone number will be verified instantly</li>
                </ol>
            </div>
        </div>

        @* Security Notice *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-2 rounded-md bg-muted/50 p-3">
                <LucideIconCn Name="shield" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-emerald-600" />
                <div class="min-w-0 flex-1">
                    <p class="text-xs text-muted-foreground">
                        Phone verification helps protect your account from unauthorized access
                    </p>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Class="flex-1 gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="message-square" Size="14" Class="size-3.5" />
                    Send SMS Code
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="edit-2" Size="14" Class="size-3.5" />
                    Change Number
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Back
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
