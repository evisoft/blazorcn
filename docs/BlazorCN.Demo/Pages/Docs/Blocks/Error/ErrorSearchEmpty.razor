@* ============================================================
   Block: error-search-empty
   Title: ErrorSearchEmpty
   Description: Error page displayed when a search query returns no matching results with helpful suggestions and alternatives
   Source: original/blocks/error/error-search-empty.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted/50">
                    <LucideIconCn Name="search" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">No Results Found</h1>
                    <p class="text-xs text-muted-foreground">Try a different search term</p>
                </div>
            </div>
        </div>

        @* Search Query *@
        <div class="border-b px-4 py-3">
            <div class="space-y-1.5">
                <span class="text-xs text-muted-foreground">Your search</span>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <code class="font-mono text-sm text-foreground">shadcn dark mode toggle</code>
                </div>
            </div>
        </div>

        @* Search Tips *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <span class="text-xs font-medium">Search Tips</span>
                <ul class="space-y-1 pl-4 text-sm text-muted-foreground">
                    <li class="list-disc">Check your spelling</li>
                    <li class="list-disc">Try more general keywords</li>
                    <li class="list-disc">Use fewer words</li>
                    <li class="list-disc">Browse categories below</li>
                </ul>
            </div>
        </div>

        @* Suggested Searches *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium">Popular Searches</span>
                </div>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var term in _suggestedSearches)
                    {
                        <button type="button" class="rounded-md bg-muted/50 px-2.5 py-1 text-xs transition-colors hover:bg-muted">
                            @term
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Browse Categories *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="grid-3x3" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium">Browse by Category</span>
                </div>
                <div class="space-y-1">
                    @foreach (var category in _popularCategories)
                    {
                        <button type="button" class="flex w-full items-center justify-between rounded-md px-3 py-2 text-left transition-colors hover:bg-muted/50">
                            <span class="text-sm text-foreground">@category.Name</span>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                                @category.Count.ToString("N0")
                            </BadgeCn>
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Class="flex-1 gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="search" Size="14" Class="size-3.5" />
                    Try New Search
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Go Back
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record PopularCategory(string Name, int Count);

    private static readonly string[] _suggestedSearches =
    [
        "React components",
        "Next.js templates",
        "Dashboard layouts",
        "Landing pages",
    ];

    private static readonly PopularCategory[] _popularCategories =
    [
        new("Components", 2847),
        new("Templates", 1238),
        new("Blocks", 906),
        new("Icons", 285000),
    ];
}
