@* ============================================================
   Block: error-print-failed
   Title: ErrorPrintFailed
   Description: Print failed error with troubleshooting steps and PDF download alternative
   Source: original/blocks/error/error-print-failed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header — icon + title + description *@
        <div class="border-b px-4 py-6">
            <div class="flex items-start gap-4">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="printer" Size="24" Class="size-6 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="font-medium text-sm">Print Failed</h1>
                    <p class="mt-1 text-muted-foreground text-sm">
                        Unable to print the document. Try troubleshooting below or download as PDF instead.
                    </p>
                </div>
            </div>
        </div>

        @* Document Details *@
        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Document Details</h2>
            <div class="mt-3 space-y-2">
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">Document name</span>
                    <span class="truncate font-mono text-xs">Invoice-2024-0342.pdf</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">Pages</span>
                    <span class="tabular-nums text-xs">12</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">Selected printer</span>
                    <span class="text-xs">HP LaserJet Pro</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">Error code</span>
                    <span class="font-mono text-xs">PRINTER_UNAVAILABLE</span>
                </div>
            </div>
        </div>

        @* Troubleshooting Checklist *@
        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Troubleshooting Checklist</h2>
            <div class="mt-3 space-y-2.5">
                @foreach (var step in _steps)
                {
                    var stepId = step.Id;
                    <div class="flex cursor-pointer items-start gap-3 rounded-md px-2 py-1.5 transition-colors hover:bg-muted/50"
                         @onclick="@(() => ToggleStep(stepId))">
                        <CheckboxCn Checked="@(_checkedSteps.ContainsKey(step.Id) && _checkedSteps[step.Id])"
                                    Class="mt-0.5" />
                        <span class="text-muted-foreground text-xs">@step.Label</span>
                    </div>
                }
            </div>
        </div>

        @* Quick Fixes *@
        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Quick Fixes</h2>
            <ul class="mt-3 space-y-2 text-muted-foreground text-xs">
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">1.</span>
                    <span>Restart the printer and wait 30 seconds</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">2.</span>
                    <span>Check printer connection cable or Wi-Fi</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">3.</span>
                    <span>Cancel all print jobs and try again</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">4.</span>
                    <span>Try printing a test page from system settings</span>
                </li>
            </ul>
        </div>

        @* Actions *@
        <div class="px-4 py-4">
            <div class="flex flex-wrap gap-2">
                <ButtonCn Class="h-8 gap-2">
                    <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                    Try Again
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-8 gap-2">
                    <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                    Download PDF
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-8 gap-2">
                    <LucideIconCn Name="settings" Size="14" Class="size-3.5" />
                    Printer Settings
                </ButtonCn>
            </div>
            <div class="mt-3 rounded-md bg-muted/50 p-3">
                <div class="flex items-start gap-2">
                    <LucideIconCn Name="file-text" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div>
                        <p class="font-medium text-xs">Alternative: Save as PDF</p>
                        <p class="mt-1 text-muted-foreground text-xs">
                            Download the document as PDF to print later from any device or share
                            electronically.
                        </p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record ChecklistStep(string Id, string Label);

    private static readonly ChecklistStep[] _steps =
    [
        new("power",     "Printer is powered on and ready"),
        new("connected", "Printer is connected (USB or network)"),
        new("paper",     "Printer has paper loaded"),
        new("ink",       "Printer has sufficient ink/toner"),
        new("queue",     "Print queue is not stuck"),
        new("driver",    "Printer driver is up to date"),
    ];

    private Dictionary<string, bool> _checkedSteps = new();

    private void ToggleStep(string stepId)
    {
        if (_checkedSteps.ContainsKey(stepId))
            _checkedSteps[stepId] = !_checkedSteps[stepId];
        else
            _checkedSteps[stepId] = true;
    }
}
