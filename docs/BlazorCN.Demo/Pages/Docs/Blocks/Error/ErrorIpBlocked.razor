@* ============================================================
   Block: error-ip-blocked
   Title: ErrorIpBlocked
   Description: Security error page for blocked IP addresses with whitelist request options
   Source: original/blocks/error/error-ip-blocked.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="shield" Size="20" Class="size-5 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">IP Address Blocked</h1>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Access denied from your location
                    </p>
                </div>
            </div>
        </div>

        @* Error Code *@
        <div class="border-b px-4 py-6 text-center">
            <div class="flex items-center justify-center gap-3">
                <LucideIconCn Name="triangle-alert" Size="32" Class="size-8 text-red-600" />
                <span class="font-semibold tabular-nums text-4xl text-red-600">403</span>
            </div>
            <p class="mt-3 text-sm text-muted-foreground">
                Your IP address has been blocked by our security system
            </p>
        </div>

        @* Block Details *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Block information</h2>
            <div class="mt-3 space-y-2">
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <div>
                        <p class="text-xs font-medium">Your IP address</p>
                        <p class="mt-0.5 font-mono text-xs text-muted-foreground">203.0.113.42</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" OnClick="HandleCopy" Class="h-6 gap-1 px-2 text-xs">
                        @if (_copied)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                            <span>Copied</span>
                        }
                        else
                        {
                            <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            <span>Copy</span>
                        }
                    </ButtonCn>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs font-medium">Reason for block</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Multiple failed authentication attempts detected
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs font-medium">Block initiated</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">Today at 2:34 PM</p>
                </div>
            </div>
        </div>

        @* Possible Causes *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Common causes</h2>
            <div class="mt-3 space-y-2">
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        Repeated failed login attempts from this IP
                    </p>
                </div>
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        Suspicious or automated traffic patterns detected
                    </p>
                </div>
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        IP address listed in security threat databases
                    </p>
                </div>
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        Access from restricted geographic region
                    </p>
                </div>
            </div>
        </div>

        @* Whitelist Request Form *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Request IP whitelist</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                If you believe this block is in error, submit a whitelist request below
            </p>
            <div class="mt-3 space-y-3">
                <div>
                    <label for="organization" class="text-xs font-medium text-muted-foreground">
                        Organization name
                    </label>
                    <InputCn id="organization" type="text" Placeholder="Acme Corporation" Class="mt-1" />
                </div>
                <div>
                    <label for="ip-blocked-email" class="text-xs font-medium text-muted-foreground">
                        Contact email
                    </label>
                    <InputCn id="ip-blocked-email" type="email" Placeholder="@("admin@example.com")" Class="mt-1" />
                </div>
                <div>
                    <label for="reason" class="text-xs font-medium text-muted-foreground">
                        Reason for access
                    </label>
                    <TextareaCn id="reason" Placeholder="Explain why your IP should be whitelisted..." Class="mt-1 min-h-20 resize-none" />
                </div>
                <ButtonCn Class="w-full gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="mail" Size="16" Class="size-4" />
                    Submit request
                </ButtonCn>
                <p class="text-center text-xs text-muted-foreground">
                    Typical response time: 1-2 business days
                </p>
            </div>
        </div>

        @* Support Contact *@
        <div class="px-4 py-4">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs font-medium">Need immediate assistance?</p>
                <p class="mt-1 text-xs text-muted-foreground">
                    Contact our security team directly for urgent whitelist requests or if you suspect
                    your account has been compromised.
                </p>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="mt-2 h-6 px-2 text-xs">
                    Contact security team
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private bool _copied = false;

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
