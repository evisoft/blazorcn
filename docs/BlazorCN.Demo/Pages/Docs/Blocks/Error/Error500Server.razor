@* ============================================================
   Block: error-500-server
   Title: Error500Server
   Description: A 500 internal server error page block for React and Next.js with status indicator and retry actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/error/error-500-server.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex min-h-[500px] flex-col items-center justify-center px-4 py-16 text-center">
            <div class="mb-4 flex items-center gap-2">
                <span class="size-2 animate-pulse rounded-full bg-red-500"></span>
                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                    Server Error
                </span>
            </div>

            <div>
                <h1 class="mb-4 font-semibold tabular-nums text-5xl tracking-tight">500</h1>
                <h2 class="mb-2 font-medium text-lg">Internal server error</h2>
                <p class="mb-8 text-muted-foreground text-sm">
                    Something went wrong on our end. We've been notified and are working to fix it.
                </p>
            </div>

            <div class="flex flex-wrap items-center justify-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-2 text-xs">
                    <LucideIconCn Name="refresh-ccw" Size="14" Class="size-3.5" />
                    Try again
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 gap-2 text-xs">
                    <LucideIconCn Name="house" Size="14" Class="size-3.5" />
                    Go home
                </ButtonCn>
            </div>

            <div class="mt-8">
                <button type="button" class="inline-flex items-center gap-1 text-muted-foreground text-xs transition-colors hover:text-foreground">
                    Check system status
                    <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                </button>
            </div>
        </div>
    </div>
</section>
