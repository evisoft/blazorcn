@* ============================================================
   Block: error-wishlist-empty
   Title: ErrorWishlistEmpty
   Description: Error page shown when users view an empty wishlist or favorites list with recommendations to discover products
   Source: original/blocks/error/error-wishlist-empty.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted/50">
                    <LucideIconCn Name="heart" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Your Wishlist Is Empty</h1>
                    <p class="text-xs text-muted-foreground">Start saving items you love</p>
                </div>
            </div>
        </div>

        @* Message *@
        <div class="border-b px-4 py-3">
            <p class="text-sm text-muted-foreground">
                Save products to your wishlist to track prices, get stock alerts, and easily find your
                favorites later.
            </p>
        </div>

        @* How It Works *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium">How to Save Items</span>
                </div>
                <ol class="space-y-1.5 pl-4 text-sm text-muted-foreground">
                    <li class="list-decimal">Click the heart icon on any product</li>
                    <li class="list-decimal">Access your saved items anytime</li>
                    <li class="list-decimal">Get notified of price drops</li>
                </ol>
            </div>
        </div>

        @* Trending Items *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium">Trending Now</span>
                </div>
                <div class="space-y-1">
                    @foreach (var item in _trendingItems)
                    {
                        <button type="button"
                                class="flex w-full items-center justify-between rounded-md px-3 py-2 text-left transition-colors hover:bg-muted/50">
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium">@item.Name</p>
                                <p class="mt-0.5 text-xs text-muted-foreground">@item.Category</p>
                            </div>
                            <div class="flex shrink-0 items-center gap-1.5">
                                <LucideIconCn Name="heart" Size="12" Class="size-3 text-muted-foreground" />
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                                    @item.Saves.ToString("N0")
                                </BadgeCn>
                            </div>
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Benefits *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs text-muted-foreground">
                    <span class="font-medium text-foreground">Pro tip:</span> Wishlist items are
                    synced across all your devices and can be shared with friends and family.
                </p>
            </div>
        </div>

        @* Actions *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Class="flex-1 gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="sparkles" Size="14" Class="size-3.5" />
                    Discover Products
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Go Back
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record TrendingItem(string Name, string Category, int Saves);

    private static readonly TrendingItem[] _trendingItems =
    [
        new("Smart Watch Pro", "Electronics", 1247),
        new("Designer Backpack", "Fashion", 892),
        new("Coffee Maker Deluxe", "Home", 651),
    ];
}
