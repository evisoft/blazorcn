@* ============================================================
   Block: error-migration-failed
   Title: ErrorMigrationFailed
   Description: Database migration failure error with rollback options
   Source: original/blocks/error/error-migration-failed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                <h2 class="font-medium text-sm">Migration Error</h2>
            </div>
        </div>

        @* Error Summary *@
        <div class="border-b px-4 py-3">
            <div class="flex gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="database" Size="20" Class="size-5 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h3 class="mb-1 font-semibold text-sm">Database Migration Failed</h3>
                    <p class="text-muted-foreground text-sm">
                        The database migration could not be completed. Your database is in a safe state.
                        Review the error and decide whether to rollback or contact support.
                    </p>
                    <div class="mt-2 flex items-center gap-3 text-xs">
                        <span class="text-muted-foreground">
                            Migration: <span class="font-mono text-foreground">20240315_add_user_preferences</span>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        @* Error Details *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center gap-2">
                <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-amber-600" />
                <p class="font-medium text-sm">Error details</p>
            </div>
            <div class="relative max-h-48 overflow-auto rounded-md bg-zinc-950 p-3">
                <pre class="font-mono text-xs text-zinc-100">@_migrationError</pre>
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="arrow-left" Size="16" Class="size-4" />
                    Rollback Migration
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="mail" Size="16" Class="size-4" />
                    Contact DBA Support
                </ButtonCn>
            </div>
        </div>

        @* Migration State *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <p class="mb-2 font-medium text-sm">Current state:</p>
            <div class="space-y-2 text-xs">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground">Database version:</span>
                    <span class="font-mono text-foreground">2024.03.14.1</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground">Last successful:</span>
                    <span class="font-mono text-foreground">20240314_update_sessions</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground">Pending migrations:</span>
                    <span class="text-foreground">3</span>
                </div>
            </div>
        </div>

        @* Help Section *@
        <div class="px-4 py-3">
            <p class="mb-2 font-medium text-sm">Next steps:</p>
            <ul class="space-y-1.5 text-muted-foreground text-xs">
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>Review the error message to identify the root cause</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>Check if the migration can be safely modified and retried</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>Rollback if needed, or contact database support for assistance</span>
                </li>
            </ul>
        </div>

    </div>
</section>

@code {
    private const string _migrationError =
        "Migration failed: 20240315_add_user_preferences\n" +
        "Error: column \"theme_preference\" of relation \"users\" already exists\n" +
        "\n" +
        "SQL: ALTER TABLE users ADD COLUMN theme_preference VARCHAR(50);\n" +
        "\n" +
        "This migration was part of batch: 2024-03-15-user-settings\n" +
        "Previous successful migration: 20240314_update_sessions";
}
