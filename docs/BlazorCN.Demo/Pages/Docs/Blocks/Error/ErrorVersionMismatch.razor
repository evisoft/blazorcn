@* ============================================================
   Block: error-version-mismatch
   Title: ErrorVersionMismatch
   Description: Error page shown when the client app version is outdated and requires an update
   Source: original/blocks/error/error-version-mismatch.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border bg-amber-500/10">
                    <LucideIconCn Name="alert-triangle" Size="20" Class="size-5 text-amber-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Update Required</h1>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your application version is outdated and no longer supported. Please update to
                        continue using all features.
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <div class="mb-2 text-xs font-medium text-muted-foreground">Current Version</div>
                    <div class="flex items-baseline gap-2">
                        <span class="font-mono text-2xl font-semibold tabular-nums">
                            @_versions.Current
                        </span>
                        <span class="inline-flex items-center gap-1 rounded-full bg-red-500/10 px-2 py-0.5 text-xs font-medium text-red-600">
                            Outdated
                        </span>
                    </div>
                </div>
                <div>
                    <div class="mb-2 text-xs font-medium text-muted-foreground">Required Version</div>
                    <div class="flex items-baseline gap-2">
                        <span class="font-mono text-2xl font-semibold tabular-nums">
                            @_versions.Required
                        </span>
                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-medium text-emerald-600">
                            Latest
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">What's New</span>
            </div>
            <div class="space-y-3">
                @foreach (var release in _changelog)
                {
                    <div class="space-y-2">
                        <div class="flex items-baseline gap-2">
                            <span class="font-mono text-sm font-medium">@release.Version</span>
                            <span class="text-xs text-muted-foreground">@release.Date</span>
                        </div>
                        <ul class="space-y-1">
                            @foreach (var change in release.Changes)
                            {
                                <li class="flex items-start gap-2 text-xs text-muted-foreground">
                                    <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                    <span>@change</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>

        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="gap-1.5">
                <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                Update Now
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="gap-1.5">
                View Full Changelog
                <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5" />
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record VersionInfo(string Current, string Required);

    private record ChangelogEntry(string Version, string Date, string[] Changes);

    private static readonly VersionInfo _versions = new("2.4.1", "3.0.0");

    private static readonly ChangelogEntry[] _changelog =
    [
        new("3.0.0", "March 20, 2026", [
            "New real-time collaboration features",
            "Improved performance and stability",
            "Breaking: Updated API authentication",
        ]),
        new("2.9.0", "March 10, 2026", [
            "Enhanced dashboard widgets",
            "Bug fixes and improvements",
        ]),
    ];
}
