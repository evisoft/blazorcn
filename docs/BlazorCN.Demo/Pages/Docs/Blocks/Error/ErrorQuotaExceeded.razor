@* ============================================================
   Block: error-quota-exceeded
   Title: ErrorQuotaExceeded
   Description: Storage or usage quota exceeded error page with usage visualization and upgrade options
   Source: original/blocks/error/error-quota-exceeded.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Icon Header *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col items-center gap-4 text-center">
                <div class="flex size-16 items-center justify-center rounded-full bg-red-500/10">
                    <LucideIconCn Name="database" Size="32" Class="size-8 text-red-600" />
                </div>
                <div>
                    <h1 class="text-2xl font-semibold">Storage Quota Exceeded</h1>
                    <p class="mt-2 text-sm text-muted-foreground">
                        You've reached your storage limit
                    </p>
                </div>
            </div>
        </div>

        @* Error Code *@
        <div class="border-b px-4 py-6">
            <div class="text-center">
                <p class="text-4xl font-semibold tabular-nums text-red-600">507</p>
                <p class="mt-2 text-xs text-muted-foreground">Insufficient Storage</p>
            </div>
        </div>

        @* Storage Usage *@
        <div class="border-b px-4 py-6">
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium">Storage Usage</span>
                    <span class="text-sm text-muted-foreground">
                        @_usedStorage GB / @_totalStorage GB
                    </span>
                </div>
                <ProgressCn Value="@_usagePercentage" Class="h-2" />
                <div class="flex items-center gap-2">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    <span class="text-xs text-muted-foreground">
                        @((_usagePercentage - 100).ToString("F1"))% over limit
                    </span>
                </div>
            </div>
        </div>

        @* Storage Breakdown *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">Storage Breakdown</p>
                <div class="space-y-2">
                    @foreach (var item in _storageBreakdown)
                    {
                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-muted-foreground">@item.Category</span>
                                <span class="text-sm font-medium">@item.Size</span>
                            </div>
                            <ProgressCn Value="@item.Percentage" Class="h-1.5" />
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Alert Message *@
        <div class="border-b px-4 py-6">
            <div class="rounded-md bg-red-500/10 p-4">
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="database" Size="20" Class="mt-0.5 size-5 shrink-0 text-red-600" />
                    <div class="flex-1 space-y-1">
                        <p class="text-sm font-medium text-red-600">Action Required</p>
                        <p class="text-sm text-red-600">
                            You cannot upload new files until you free up space or upgrade your plan. Existing
                            files are safe and accessible.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @* What You Can Do *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">What You Can Do</p>
                <ul class="space-y-2 text-sm text-muted-foreground">
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Delete old or unused files to free up space</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Upgrade to a plan with more storage</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Download and archive files externally</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Compress large files to reduce size</span>
                    </li>
                </ul>
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Class="flex-1">
                    <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                    Upgrade Plan
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1">
                    <LucideIconCn Name="settings" Size="16" Class="size-4" />
                    Manage Storage
                </ButtonCn>
            </div>
        </div>

        @* Additional Info *@
        <div class="border-b px-4 py-6">
            <div class="rounded-md bg-muted/50 p-4">
                <p class="text-sm font-medium">Storage Tips</p>
                <p class="mt-2 text-sm text-muted-foreground">
                    Enable automatic file compression, set up file retention policies, or move
                    infrequently accessed files to archive storage to optimize your usage.
                </p>
            </div>
        </div>

        @* Alternative Action *@
        <div class="border-b px-4 py-6">
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full">
                <LucideIconCn Name="home" Size="16" Class="size-4" />
                Back to Home
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Need help managing your storage? Contact our support team
            </p>
        </div>

    </div>
</section>

@code {
    private const double _usedStorage = 10.2;
    private const int _totalStorage = 10;
    private static readonly double _usagePercentage = (_usedStorage / _totalStorage) * 100;

    private record StorageItem(string Category, string Size, int Percentage);

    private static readonly StorageItem[] _storageBreakdown =
    [
        new("Documents", "4.2 GB", 42),
        new("Images",    "3.1 GB", 31),
        new("Videos",    "2.4 GB", 24),
        new("Other",     "0.5 GB",  3),
    ];
}
