@* ============================================================
   Block: error-500-maintenance
   Title: Error500Maintenance
   Description: A planned maintenance page block for React and Next.js with downtime estimate and progress indicator built with shadcn/ui and Tailwind CSS
   Source: original/blocks/error/error-500-maintenance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-4 py-12">
            <div class="mb-8 text-center">
                <div class="mb-4 flex items-center justify-center gap-2">
                    <span class="size-2 animate-pulse rounded-full bg-amber-500"></span>
                    <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                        Scheduled Maintenance
                    </span>
                </div>

                <h1 class="mb-2 font-medium text-xl">We'll be back soon</h1>
                <p class="text-muted-foreground text-sm">
                    We're performing scheduled maintenance to improve our services. We expect to be back
                    online shortly.
                </p>
            </div>

            <div class="mb-8 rounded-md bg-muted/50 p-4">
                <div class="mb-3 flex items-center justify-between">
                    <span class="font-medium text-sm">Progress</span>
                    <span class="tabular-nums text-muted-foreground text-xs">65%</span>
                </div>
                <ProgressCn Value="65" Class="h-1.5" />
            </div>

            <div class="mb-8 space-y-3">
                <div class="flex items-start gap-3 rounded-md border bg-background px-3 py-2.5">
                    <LucideIconCn Name="clock" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                    <div>
                        <div class="mb-0.5 font-medium text-sm">Estimated time</div>
                        <div class="text-muted-foreground text-xs">
                            Expected to complete in approximately 45 minutes
                        </div>
                    </div>
                </div>

                <div class="flex items-start gap-3 rounded-md border bg-background px-3 py-2.5">
                    <LucideIconCn Name="bell" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                    <div>
                        <div class="mb-0.5 font-medium text-sm">Stay updated</div>
                        <div class="text-muted-foreground text-xs">
                            Subscribe to get notified when we're back online
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex flex-wrap items-center justify-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 gap-2 text-xs">
                    <LucideIconCn Name="bell" Size="14" Class="size-3.5" />
                    Get notified
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-8 gap-2 text-xs">
                    <LucideIconCn Name="home" Size="14" Class="size-3.5" />
                    Go home
                </ButtonCn>
            </div>
        </div>
    </div>
</section>
