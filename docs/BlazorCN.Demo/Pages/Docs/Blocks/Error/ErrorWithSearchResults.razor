@* ============================================================
   Block: error-with-search-results
   Title: ErrorWithSearchResults
   Description: 404 page that automatically searches based on the failed URL and shows best-guess results
   Source: original/blocks/error/error-with-search-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header: icon + title + subtitle *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-muted/50">
                    <LucideIconCn Name="search" Size="20" Class="size-5 text-foreground" />
                </div>
                <div>
                    <p class="text-sm font-medium">Page not found</p>
                    <p class="text-xs text-muted-foreground">
                        Here's what we found for "@(_searchQuery)"
                    </p>
                </div>
            </div>
        </div>

        @* Attempted URL *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs text-muted-foreground">Attempted URL:</p>
            <code class="block rounded bg-muted/50 px-2 py-1.5 font-mono text-xs">
                @_failedUrl
            </code>
        </div>

        @* Search bar *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <InputCn Type="search" Placeholder="Try a different search..." Value="@_searchQuery" Class="text-sm" />
                <ButtonCn Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="search" Size="16" Class="size-4" />
                    Search
                </ButtonCn>
            </div>
        </div>

        @* Results list *@
        <div>
            <div class="border-b px-4 py-3">
                <p class="text-xs font-medium text-muted-foreground">
                    @(_results.Length) results found
                </p>
            </div>
            @foreach (var result in _results)
            {
                <a href="@result.Href"
                   class="flex items-start gap-3 border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-muted/50">
                        <LucideIconCn Name="file-text" Size="16" Class="size-4 text-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <p class="text-sm font-medium">@result.Title</p>
                            <span class="shrink-0 rounded bg-muted/50 px-1.5 py-0.5 text-xs text-muted-foreground">
                                @result.Category
                            </span>
                        </div>
                        <p class="mt-1 text-xs text-muted-foreground">@result.Excerpt</p>
                    </div>
                    <LucideIconCn Name="arrow-right" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                </a>
            }
        </div>

    </div>
</section>

@code {
    private record SearchResult(string Title, string Excerpt, string Href, string Category);

    private const string _failedUrl = "/blog/react-server-components-guide";
    private const string _searchQuery = "react server components";

    private static readonly SearchResult[] _results =
    [
        new("Introduction to React Server Components",
            "Learn how React Server Components work and when to use them in your Next.js applications.",
            "/docs/react-server-components",
            "Documentation"),
        new("Server vs Client Components",
            "Understanding the differences between server and client components in React 19.",
            "/blog/server-vs-client-components",
            "Blog"),
        new("Building with RSC Patterns",
            "Common patterns and best practices for React Server Components in production apps.",
            "/guides/rsc-patterns",
            "Guides"),
        new("Next.js App Router Deep Dive",
            "Complete guide to the App Router, including server components, streaming, and suspense.",
            "/blog/nextjs-app-router",
            "Blog"),
    ];
}
