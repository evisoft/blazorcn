@* ============================================================
   Block: error-region-migration
   Title: ErrorRegionMigration
   Description: Error page shown during data center region migration
   Source: original/blocks/error/error-region-migration.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border bg-blue-500/10">
                    <LucideIconCn Name="globe" Size="20" Class="size-5 text-blue-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Region Migration in Progress</h1>
                    <p class="mt-1 text-xs text-muted-foreground">
                        We're migrating your data to a new region for improved performance. Your data is
                        safe and will be available shortly.
                    </p>
                </div>
            </div>
        </div>

        @* Migration Progress *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 text-sm font-medium">Migration Progress</div>
            <div class="mb-2 flex items-baseline gap-2">
                <span class="font-mono text-4xl font-semibold tabular-nums text-blue-600">
                    @_migrationDetails.Progress
                </span>
                <span class="text-sm text-muted-foreground">% complete</span>
            </div>
            <div class="mb-3 h-2 overflow-hidden rounded-full bg-muted">
                <div
                    class="h-full bg-blue-600 transition-all duration-300"
                    style="@($"width:{_migrationDetails.Progress}%")"
                ></div>
            </div>
            <div class="space-y-2 rounded-lg border bg-muted/30 p-3 text-xs">
                <div class="flex items-start justify-between">
                    <span class="text-muted-foreground">From</span>
                    <span class="font-medium">@_migrationDetails.FromRegion</span>
                </div>
                <div class="flex items-start justify-between border-t pt-2">
                    <span class="text-muted-foreground">To</span>
                    <span class="font-medium">@_migrationDetails.ToRegion</span>
                </div>
                <div class="flex items-start justify-between border-t pt-2">
                    <span class="text-muted-foreground">Estimated Completion</span>
                    <span class="font-medium">@_migrationDetails.EstimatedCompletion</span>
                </div>
            </div>
        </div>

        @* Migration Steps *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Migration Steps</span>
            </div>
            <div class="space-y-2">
                @for (int i = 0; i < _migrationSteps.Length; i++)
                {
                    var step = _migrationSteps[i];
                    var index = i + 1;
                    var dotClass = step.Status == "completed"
                        ? "border-emerald-500/30 bg-emerald-500/10 text-emerald-600"
                        : step.Status == "in-progress"
                            ? "border-blue-500/30 bg-blue-500/10 text-blue-600"
                            : "border-muted-foreground/20 bg-muted/30 text-muted-foreground/60";
                    <div class="flex items-center gap-3">
                        <div class="@Cn.Merge("flex size-6 shrink-0 items-center justify-center rounded-full border text-xs font-medium", dotClass)">
                            @index
                        </div>
                        <div class="flex flex-1 items-center justify-between">
                            <span class="text-sm">@step.Step</span>
                            @if (step.Status == "in-progress")
                            {
                                <span class="text-xs text-blue-600">In Progress</span>
                            }
                            @if (step.Status == "completed")
                            {
                                <span class="text-xs text-emerald-600">Complete</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Benefits *@
        <div class="border-b bg-emerald-500/5 px-4 py-3">
            <div class="mb-2 text-sm font-medium">Benefits After Migration</div>
            <div class="space-y-2">
                @foreach (var benefit in _benefits)
                {
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="@benefit.Icon" Size="16" Class="@Cn.Merge("size-4", benefit.Color)" />
                        <span class="text-xs text-muted-foreground">@benefit.Label</span>
                    </div>
                }
            </div>
        </div>

        @* Safety notice *@
        <div class="border-b bg-blue-500/5 px-4 py-2">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-blue-600" />
                <span class="text-xs text-blue-600">
                    Your data is safe. All data is backed up and verified during migration.
                </span>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                View Status Updates
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                Contact Support
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record MigrationDetails(
        string FromRegion,
        string ToRegion,
        string Reason,
        string StartDate,
        string EstimatedCompletion,
        int Progress
    );

    private record MigrationStep(string Step, string Status);

    private record Benefit(string Icon, string Label, string Color);

    private static readonly MigrationDetails _migrationDetails = new(
        FromRegion: "US East (Virginia)",
        ToRegion: "US West (Oregon)",
        Reason: "Improved performance for West Coast users",
        StartDate: "March 25, 2026 at 1:00 AM UTC",
        EstimatedCompletion: "March 25, 2026 at 5:00 AM UTC",
        Progress: 67
    );

    private static readonly MigrationStep[] _migrationSteps =
    [
        new("Data backup verification", "completed"),
        new("Database replication", "completed"),
        new("File storage migration", "in-progress"),
        new("DNS configuration", "pending"),
        new("Final verification", "pending"),
    ];

    private static readonly Benefit[] _benefits =
    [
        new("trending-up", "50% faster response times", "text-emerald-600"),
        new("shield-check", "Enhanced data redundancy", "text-blue-600"),
        new("globe", "Better regional coverage", "text-purple-600"),
    ];
}
