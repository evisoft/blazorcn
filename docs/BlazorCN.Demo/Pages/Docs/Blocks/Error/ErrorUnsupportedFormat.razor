@* ============================================================
   Block: error-unsupported-format
   Title: ErrorUnsupportedFormat
   Description: File format not supported error with accepted formats badges and conversion tool link
   Source: original/blocks/error/error-unsupported-format.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="file-question" Size="20" Class="size-5 text-amber-500" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="font-medium text-sm">Unsupported File Format</h1>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        This file type is not supported
                    </p>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="font-semibold tabular-nums text-4xl text-amber-500">415</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">UPLOADED FILE</span>
            <div class="mt-3 rounded-md bg-muted/50 p-3">
                <div class="flex items-center gap-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-background">
                        <LucideIconCn Name="file" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@_uploadedFileName</span>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs">
                            @_uploadedFileExtension file
                        </p>
                    </div>
                    <span class="shrink-0 rounded-md bg-amber-500/10 px-2 py-1 font-medium text-amber-500 text-xs">
                        Not Supported
                    </span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">ACCEPTED FORMATS</span>
            <div class="mt-3 flex flex-wrap gap-2">
                @foreach (var fmt in _acceptedFormats)
                {
                    <div class="group relative rounded-md border bg-muted/50 px-2.5 py-1.5 transition-colors hover:bg-muted">
                        <span class="font-mono font-medium text-xs">@fmt.Extension</span>
                        <div class="pointer-events-none absolute top-full left-1/2 z-10 mt-1 -translate-x-1/2 whitespace-nowrap rounded-md border bg-popover px-2 py-1 text-xs opacity-0 shadow-md transition-opacity group-hover:opacity-100">
                            @fmt.Description
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <h2 class="font-medium text-sm">Convert your file</h2>
                <p class="mt-1 text-muted-foreground text-xs">
                    Use a free online converter to change your file to a supported format. Most converters
                    can handle @_uploadedFileExtension files and convert them to PDF or other standard
                    formats.
                </p>
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Choose Different File
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="external-link" Size="14" Class="size-3.5" />
                    Online Converter
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private const string _uploadedFileName = "document.pages";
    private const string _uploadedFileExtension = ".pages";

    private record AcceptedFormat(string Extension, string Description);

    private static readonly AcceptedFormat[] _acceptedFormats =
    [
        new(".pdf",  "PDF Document"),
        new(".doc",  "Word 97-2003"),
        new(".docx", "Word Document"),
        new(".txt",  "Plain Text"),
        new(".rtf",  "Rich Text Format"),
        new(".odt",  "OpenDocument Text"),
        new(".jpg",  "JPEG Image"),
        new(".png",  "PNG Image"),
        new(".gif",  "GIF Image"),
        new(".webp", "WebP Image"),
        new(".svg",  "SVG Vector"),
        new(".zip",  "ZIP Archive"),
    ];
}
