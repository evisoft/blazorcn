@* ============================================================
   Block: error-clipboard-denied
   Title: ErrorClipboardDenied
   Description: Clipboard permission denied error with manual copy instructions
   Source: original/blocks/error/error-clipboard-denied.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-6">
            <div class="flex items-start gap-4">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="clipboard" Size="24" Class="size-6 text-amber-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="font-medium text-sm">Clipboard Access Denied</h1>
                    <p class="mt-1 text-muted-foreground text-sm">
                        This site doesn't have permission to access your clipboard. Copy manually or enable
                        clipboard access.
                    </p>
                </div>
            </div>
        </div>

        @* Manual Copy *@
        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Manual Copy</h2>
            <p class="mt-2 text-muted-foreground text-xs">
                Select the text below and copy it manually using your keyboard or right-click menu.
            </p>
            <div class="mt-3 flex gap-2">
                <InputCn Value="@_textToCopy" Placeholder="" Class="font-mono text-xs" />
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-9 shrink-0 gap-1.5 px-3" OnClick="HandleManualCopy">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                        <span class="text-xs">Copied</span>
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="14" Class="size-3.5" />
                        <span class="text-xs">Copy</span>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Keyboard Shortcuts *@
        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Keyboard Shortcuts</h2>
            <div class="mt-3 space-y-2">
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                    <span class="text-muted-foreground text-xs">Select all text</span>
                    <div class="flex items-center gap-1">
                        <kbd class="inline-flex h-5 items-center rounded border bg-background px-1.5 font-mono text-muted-foreground text-xs">
                            <LucideIconCn Name="command" Size="12" Class="size-3" />
                        </kbd>
                        <span class="text-muted-foreground text-xs">+</span>
                        <kbd class="inline-flex h-5 items-center rounded border bg-background px-1.5 font-mono text-muted-foreground text-xs">
                            A
                        </kbd>
                    </div>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                    <span class="text-muted-foreground text-xs">Copy selected text</span>
                    <div class="flex items-center gap-1">
                        <kbd class="inline-flex h-5 items-center rounded border bg-background px-1.5 font-mono text-muted-foreground text-xs">
                            <LucideIconCn Name="command" Size="12" Class="size-3" />
                        </kbd>
                        <span class="text-muted-foreground text-xs">+</span>
                        <kbd class="inline-flex h-5 items-center rounded border bg-background px-1.5 font-mono text-muted-foreground text-xs">
                            C
                        </kbd>
                    </div>
                </div>
            </div>
            <p class="mt-2 text-muted-foreground text-xs">On Windows, use Ctrl instead of Cmd</p>
        </div>

        @* Enable Clipboard Access *@
        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Enable Clipboard Access</h2>
            <p class="mt-2 text-muted-foreground text-xs">
                To enable automatic copying in the future:
            </p>
            <ul class="mt-3 space-y-2 text-muted-foreground text-xs">
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">1.</span>
                    <span>
                        Click the lock icon <span class="font-semibold">🔒</span> in your browser's
                        address bar
                    </span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">2.</span>
                    <span>Find "Clipboard" in the permissions list</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">3.</span>
                    <span>Change the setting from "Ask" or "Block" to "Allow"</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">4.</span>
                    <span>Refresh the page to apply changes</span>
                </li>
            </ul>
        </div>

        @* Browser-Specific Steps *@
        <div class="px-4 py-4">
            <div class="rounded-md bg-blue-500/10 p-3">
                <p class="font-medium text-xs">Browser-Specific Steps</p>
                <div class="mt-2 space-y-1.5 text-muted-foreground text-xs">
                    <p>
                        <span class="font-medium">Chrome/Edge:</span> Address bar → Site settings →
                        Clipboard
                    </p>
                    <p>
                        <span class="font-medium">Firefox:</span> Address bar → Connection secure → More
                        information → Permissions
                    </p>
                    <p>
                        <span class="font-medium">Safari:</span> Safari menu → Settings for This Website
                        → Clipboard
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private bool _copied = false;
    private readonly string _textToCopy = "https://example.com/share/abc123xyz789";

    private async Task HandleManualCopy()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
