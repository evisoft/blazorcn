@* ============================================================
   Block: error-api-key-missing
   Title: ErrorApiKeyMissing
   Description: Missing API key error with configuration instructions
   Source: original/blocks/error/error-api-key-missing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                <h2 class="font-medium text-sm">Configuration Error</h2>
            </div>
        </div>

        @* Error Message *@
        <div class="border-b px-4 py-3">
            <div class="flex gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="key" Size="20" Class="size-5 text-amber-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h3 class="mb-1 font-semibold text-sm">API Key Not Found</h3>
                    <p class="text-muted-foreground text-sm">
                        The required API key is missing from your environment configuration. Add your API
                        key to continue.
                    </p>
                </div>
            </div>
        </div>

        @* Configuration Example *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <p class="font-medium text-sm">Add to your configuration:</p>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2" OnClick="HandleCopy">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                    }
                    <span class="text-xs">@(_copied ? "Copied" : "Copy")</span>
                </ButtonCn>
            </div>
            <div class="relative overflow-hidden rounded-md bg-zinc-950 p-3">
                <pre class="overflow-x-auto font-mono text-sm text-zinc-100">@_envExample</pre>
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="key" Size="16" Class="size-4" />
                    Generate API Key
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="book-open" Size="16" Class="size-4" />
                    View Documentation
                </ButtonCn>
            </div>
        </div>

        @* Instructions *@
        <div class="bg-muted/30 px-4 py-3">
            <p class="mb-2 font-medium text-sm">Setup instructions:</p>
            <ol class="space-y-2 text-muted-foreground text-xs">
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 font-medium">1.</span>
                    <span>
                        Generate an API key from your
                        <button type="button" class="inline-flex items-center gap-0.5 text-foreground underline-offset-2 hover:underline">
                            account dashboard
                            <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                        </button>
                    </span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 font-medium">2.</span>
                    <span>Add the API key to your .env file</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 font-medium">3.</span>
                    <span>Restart your development server</span>
                </li>
            </ol>
        </div>

    </div>
</section>

@code {
    private bool _copied = false;

    private readonly string _envExample =
        "# Add this to your .env file\nAPI_KEY=your_api_key_here\nAPI_SECRET=your_api_secret_here";

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
