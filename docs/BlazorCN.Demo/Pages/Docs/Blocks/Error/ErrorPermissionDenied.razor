@* ============================================================
   Block: error-permission-denied
   Title: ErrorPermissionDenied
   Description: Error page shown when a user lacks required permissions to access a resource or perform an action
   Source: original/blocks/error/error-permission-denied.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="shield-alert" Size="20" Class="size-5 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Permission Denied</h1>
                    <p class="text-xs text-muted-foreground">
                        You don't have access to this resource
                    </p>
                </div>
            </div>
        </div>

        @* Current Role *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">Your current role</span>
                <BadgeCn Variant="BadgeVariant.Outline" Class="font-mono text-xs">
                    Viewer
                </BadgeCn>
            </div>
        </div>

        @* Required Permissions *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="lock" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium">Required Permission</span>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <code class="font-mono text-xs text-foreground">workspace:admin</code>
                </div>
            </div>
        </div>

        @* Message *@
        <div class="border-b px-4 py-3">
            <p class="text-sm text-muted-foreground">
                This action requires administrator access. Contact your workspace owner or request
                elevated permissions to proceed.
            </p>
        </div>

        @* Actions *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Class="flex-1 gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="mail" Size="14" Class="size-3.5" />
                    Request Access
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Go Back
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

