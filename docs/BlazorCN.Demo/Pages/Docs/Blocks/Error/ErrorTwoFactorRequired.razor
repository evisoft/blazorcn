@* ============================================================
   Block: error-two-factor-required
   Title: ErrorTwoFactorRequired
   Description: Error page requiring additional 2FA verification to proceed
   Source: original/blocks/error/error-two-factor-required.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-blue-500/10">
                    <LucideIconCn Name="lock" Size="20" Class="size-5 text-blue-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Two-Factor Authentication Required</h1>
                    <p class="mt-0.5 text-xs text-muted-foreground">Additional verification needed</p>
                </div>
            </div>
        </div>

        @* Reason *@
        <div class="border-b px-4 py-4">
            <div class="flex items-start gap-3">
                <LucideIconCn Name="shield" Size="20" Class="mt-0.5 size-5 shrink-0 text-blue-600" />
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">Security verification triggered</p>
                    <p class="mt-1 text-xs text-muted-foreground">
                        We detected a new device attempting to access your account. Please verify your
                        identity to continue.
                    </p>
                </div>
            </div>
        </div>

        @* Verification Code Input *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Enter verification code</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Check your authenticator app or email for the 6-digit code
            </p>
            <div class="mt-3 space-y-3">
                <InputCn type="text" inputmode="numeric" Placeholder="000000" maxlength="6" Class="text-center font-mono text-lg tracking-widest" />
                <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                    Verify and continue
                </ButtonCn>
            </div>
        </div>

        @* Resend Options *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium">Didn't receive a code?</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">Code sent 30 seconds ago</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-1.5">
                    <LucideIconCn Name="rotate-cw" Size="12" Class="size-3" />
                    Resend code
                </ButtonCn>
            </div>
        </div>

        @* Alternative Methods *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Other verification methods</h2>
            <div class="mt-3 space-y-2">
                <button type="button" class="flex w-full items-center justify-between rounded-md border px-3 py-2 text-left transition-colors hover:bg-muted/50">
                    <span class="text-xs font-medium">Send code via SMS</span>
                    <span class="font-mono text-muted-foreground text-xs">@("•••• 5678")</span>
                </button>
                <button type="button" class="flex w-full items-center justify-between rounded-md border px-3 py-2 text-left transition-colors hover:bg-muted/50">
                    <span class="text-xs font-medium">Send code via email</span>
                    <span class="font-mono text-muted-foreground text-xs">user@@•••.com</span>
                </button>
                <button type="button" class="flex w-full items-center justify-between rounded-md border px-3 py-2 text-left transition-colors hover:bg-muted/50">
                    <span class="text-xs font-medium">Use backup code</span>
                    <span class="text-muted-foreground text-xs">8 codes remaining</span>
                </button>
            </div>
        </div>

        @* Help *@
        <div class="px-4 py-4">
            <div class="flex items-start gap-3 rounded-md bg-muted/50 p-3">
                <LucideIconCn Name="help-circle" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <p class="text-xs font-medium">Having trouble?</p>
                    <p class="mt-1 text-xs text-muted-foreground">
                        If you've lost access to your 2FA device or backup codes, contact support for
                        account recovery assistance.
                    </p>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="mt-2 h-6 px-2 text-xs">
                        Contact support
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    // Presentational block — no interactive state required
}
