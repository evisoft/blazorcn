@* ============================================================
   Block: error-dark-404
   Title: ErrorDark404
   Description: Elegant dark-themed 404 error page with modern aesthetics
   Source: original/blocks/error/error-dark-404.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border border-zinc-800 bg-zinc-950">

        @* Header *@
        <div class="border-b border-zinc-800 px-4 py-3">
            <div class="flex items-center justify-between">
                <h1 class="font-medium text-sm text-zinc-100">Page Not Found</h1>
                <span class="rounded-full bg-zinc-800 px-2 py-0.5 font-mono text-zinc-400 text-xs">
                    404
                </span>
            </div>
        </div>

        @* Error Message *@
        <div class="border-b border-zinc-800 px-4 py-8 text-center">
            <div class="mx-auto mb-4 flex size-16 items-center justify-center rounded-full bg-zinc-900">
                <span class="font-bold text-4xl text-zinc-400">?</span>
            </div>
            <h2 class="mb-2 font-semibold text-2xl text-zinc-100 tabular-nums">404</h2>
            <p class="text-sm text-zinc-400">
                The page you're looking for doesn't exist or has been moved.
            </p>
        </div>

        @* Search *@
        <div class="border-b border-zinc-800 px-4 py-4">
            <label for="search-input" class="mb-2 block text-xs text-zinc-400">
                Search for what you need
            </label>
            <div class="flex gap-2">
                <div class="relative flex-1">
                    <LucideIconCn Name="search" Size="16" Class="absolute top-2.5 left-3 size-4 text-zinc-500" />
                    <InputCn Id="search-input" Placeholder="Search pages..." Class="border-zinc-800 bg-zinc-900 pl-9 text-zinc-100 placeholder:text-zinc-500 focus-visible:ring-zinc-700" />
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="border-zinc-800 bg-zinc-900 text-zinc-100 hover:bg-zinc-800">
                    Search
                </ButtonCn>
            </div>
        </div>

        @* Quick Actions *@
        <div class="px-4 py-4">
            <span class="mb-3 block text-xs text-zinc-400">Quick actions</span>
            <div class="grid gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-auto justify-start gap-3 px-3 py-2.5 text-zinc-100 hover:bg-zinc-900">
                    <LucideIconCn Name="home" Size="16" Class="size-4 text-zinc-500" />
                    <div class="text-left">
                        <div class="text-sm">Go to homepage</div>
                        <div class="text-muted-foreground text-xs text-zinc-500">
                            Return to the main page
                        </div>
                    </div>
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-auto justify-start gap-3 px-3 py-2.5 text-zinc-100 hover:bg-zinc-900">
                    <LucideIconCn Name="arrow-left" Size="16" Class="size-4 text-zinc-500" />
                    <div class="text-left">
                        <div class="text-sm">Go back</div>
                        <div class="text-muted-foreground text-xs text-zinc-500">
                            Return to previous page
                        </div>
                    </div>
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-auto justify-start gap-3 px-3 py-2.5 text-zinc-100 hover:bg-zinc-900">
                    <LucideIconCn Name="mail" Size="16" Class="size-4 text-zinc-500" />
                    <div class="text-left">
                        <div class="text-sm">Contact support</div>
                        <div class="text-muted-foreground text-xs text-zinc-500">
                            Get help from our team
                        </div>
                    </div>
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
