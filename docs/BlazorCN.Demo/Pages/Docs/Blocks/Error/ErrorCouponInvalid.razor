@* ============================================================
   Block: error-coupon-invalid
   Title: ErrorCouponInvalid
   Description: Invalid promo code page explaining why the code didn't work and showing active promotions
   Source: original/blocks/error/error-coupon-invalid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="x-circle" Size="20" Class="size-5 text-red-600" />
                </div>
                <div>
                    <p class="text-sm font-medium">This code isn't valid</p>
                    <p class="text-xs text-muted-foreground">Unable to apply promo code</p>
                </div>
            </div>
        </div>

        @* Entered code *@
        <div class="border-b px-4 py-3">
            <p class="text-xs text-muted-foreground">You entered:</p>
            <div class="mt-2 flex items-center gap-2 rounded-lg bg-muted/50 px-3 py-2">
                <LucideIconCn Name="tag" Size="16" Class="size-4 text-muted-foreground" />
                <code class="font-mono text-sm font-medium">@_invalidCode</code>
            </div>
        </div>

        @* Common reasons header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="info" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">Common reasons</span>
            </div>
        </div>

        @* Reason rows *@
        @foreach (var reason in _reasons)
        {
            <div class="flex items-start gap-3 border-b px-4 py-3 last:border-b-0">
                <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">@reason.Text</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@reason.Detail</p>
                </div>
            </div>
        }

        @* Active promotions header *@
        <div class="border-t border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="percent" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">Active promotions</span>
            </div>
        </div>

        @* Promotion rows *@
        @foreach (var promo in _activePromotions)
        {
            <a href="@promo.Href" class="flex items-center justify-between border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <code class="rounded bg-emerald-500/10 px-1.5 py-0.5 font-mono text-xs font-medium text-emerald-600">@promo.Code</code>
                        <p class="text-sm font-medium">@promo.Description</p>
                    </div>
                    <p class="mt-1 text-xs text-muted-foreground">@promo.Terms</p>
                </div>
                <LucideIconCn Name="arrow-right" Size="16" Class="ml-3 size-4 shrink-0 text-muted-foreground/60" />
            </a>
        }

        @* Footer action *@
        <div class="border-t px-4 py-3">
            <a href="/checkout" class="inline-flex w-full items-center justify-center rounded-md border border-input bg-background px-3 py-1.5 text-sm font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
                Continue to checkout
            </a>
        </div>

    </div>
</section>

@code {
    private readonly string _invalidCode = "SUMMER2025";

    private record Reason(string Text, string Detail);
    private record Promotion(string Code, string Description, string Terms, string Href);

    private static readonly Reason[] _reasons =
    [
        new("Code expired", "This promotion ended on Dec 31, 2025"),
        new("Already used", "One-time codes can't be reused"),
        new("Typo in code", "Check spelling and spacing"),
        new("Minimum not met", "Some codes require minimum purchase"),
    ];

    private static readonly Promotion[] _activePromotions =
    [
        new("SPRING2026", "20% off all products", "Valid until March 31, 2026", "/promotions/spring2026"),
        new("FIRST15", "15% off your first order", "New customers only", "/promotions/first15"),
    ];
}
