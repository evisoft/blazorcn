@* ============================================================
   Block: error-with-history
   Title: ErrorWithHistory
   Description: Error page that shows where the user came from and provides smart navigation options based on their history
   Source: original/blocks/error/error-with-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="triangle-alert" Size="20" Class="size-5 text-amber-600" />
                </div>
                <div>
                    <p class="text-sm font-medium">Page not found</p>
                    <p class="text-xs text-muted-foreground">Error 404 • This page doesn't exist</p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs text-muted-foreground">You came from:</p>
            <p class="mt-1 font-mono text-sm">@_referrer</p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex gap-2">
                <a href="@_referrer" class="inline-flex items-center justify-center gap-2 rounded-md border border-input bg-background px-3 text-xs font-medium shadow-sm hover:bg-accent hover:text-accent-foreground h-8">
                    <LucideIconCn Name="arrow-left" Size="16" Class="size-4" />
                    Go back
                </a>
                <a href="/" class="inline-flex items-center justify-center gap-2 rounded-md border border-input bg-background px-3 text-xs font-medium shadow-sm hover:bg-accent hover:text-accent-foreground h-8">
                    <LucideIconCn Name="house" Size="16" Class="size-4" />
                    Go home
                </a>
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">Recent pages</span>
                </div>
            </div>
            @foreach (var item in _recentPages)
            {
                <a href="@item.Path" class="flex items-center justify-between border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@item.Title</p>
                        <p class="mt-0.5 truncate font-mono text-xs text-muted-foreground">@item.Path</p>
                    </div>
                    <span class="ml-3 shrink-0 text-xs text-muted-foreground">@item.Timestamp</span>
                </a>
            }
        </div>

    </div>
</section>

@code {
    private record HistoryItem(string Path, string Title, string Timestamp);

    private static readonly HistoryItem[] _recentPages =
    [
        new("/dashboard",          "Dashboard",          "2 min ago"),
        new("/settings/profile",   "Profile Settings",   "5 min ago"),
        new("/projects/acme-corp", "Acme Corp Project",  "12 min ago"),
    ];

    private static readonly string _referrer = "/dashboard";
}
