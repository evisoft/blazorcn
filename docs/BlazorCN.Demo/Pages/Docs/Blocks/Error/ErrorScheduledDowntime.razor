@* ============================================================
   Block: error-scheduled-downtime
   Title: ErrorScheduledDowntime
   Description: Error page shown during scheduled maintenance windows
   Source: original/blocks/error/error-scheduled-downtime.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border bg-blue-500/10">
                    <LucideIconCn Name="calendar" Size="20" Class="size-5 text-blue-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Scheduled Maintenance in Progress</h1>
                    <p class="mt-1 text-xs text-muted-foreground">
                        We're performing scheduled maintenance to improve performance and security. The
                        service will be back online shortly.
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Estimated Time Remaining</span>
            </div>
            <div class="mb-3 flex items-baseline gap-2">
                <span class="font-mono text-4xl font-semibold tabular-nums">@_timeRemaining.Hours</span>
                <span class="text-sm text-muted-foreground">hours</span>
                <span class="font-mono text-4xl font-semibold tabular-nums">@_timeRemaining.Minutes</span>
                <span class="text-sm text-muted-foreground">minutes</span>
            </div>
            <div class="space-y-2 rounded-lg border bg-muted/30 p-3 text-xs">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground">Maintenance Type</span>
                    <span class="font-medium">@_maintenanceDetails.Reason</span>
                </div>
                <div class="flex items-center justify-between border-t pt-2">
                    <span class="text-muted-foreground">Start Time</span>
                    <span class="font-medium">@_maintenanceDetails.StartTime</span>
                </div>
                <div class="flex items-center justify-between border-t pt-2">
                    <span class="text-muted-foreground">Expected End</span>
                    <span class="font-medium">@_maintenanceDetails.EndTime</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 text-sm font-medium">Progress</div>
            <div class="space-y-0 overflow-hidden rounded-lg border">
                @foreach (var item in _maintenanceTasks)
                {
                    <div class="@Cn.Merge("flex items-center gap-3 px-3 py-2", item != _maintenanceTasks[_maintenanceTasks.Length - 1] ? "border-b" : "")">
                        <div class="@Cn.Merge("flex size-6 shrink-0 items-center justify-center rounded-full border", GetTaskIconClass(item.Status))">
                            @if (item.Status == "completed")
                            {
                                <LucideIconCn Name="check-circle" Size="14" Class="size-3.5 text-emerald-600" />
                            }
                            else if (item.Status == "in-progress")
                            {
                                <div class="size-2 animate-pulse rounded-full bg-blue-600"></div>
                            }
                            else
                            {
                                <div class="size-2 rounded-full bg-muted-foreground/40"></div>
                            }
                        </div>
                        <div class="flex flex-1 items-center justify-between">
                            <span class="text-sm">@item.Task</span>
                            <span class="text-xs text-muted-foreground">@item.Duration</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Get Notified When We're Back</span>
            </div>
            <p class="mb-3 text-xs text-muted-foreground">
                Enter your email to receive a notification when maintenance is complete
            </p>
            <div class="flex gap-2">
                <InputCn type="email" Placeholder="@("your@email.com")" Class="h-8 text-xs" />
                <ButtonCn Size="ButtonSize.Sm" Class="shrink-0">
                    Notify Me
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                View Status Page
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                Contact Support
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record MaintenanceDetails(string Reason, string StartTime, string EndTime, string Duration, string Status);
    private record MaintenanceTask(string Task, string Status, string Duration);
    private record TimeRemaining(string Hours, string Minutes);

    private static readonly MaintenanceDetails _maintenanceDetails = new(
        "Infrastructure Upgrade",
        "March 26, 2026 at 2:00 AM UTC",
        "March 26, 2026 at 6:00 AM UTC",
        "4 hours",
        "In Progress"
    );

    private static readonly MaintenanceTask[] _maintenanceTasks =
    [
        new("Database migration",      "completed",   "45 min"),
        new("Security patches",        "completed",   "30 min"),
        new("Performance optimization","in-progress", "60 min"),
        new("System verification",     "pending",     "45 min"),
    ];

    private static readonly TimeRemaining _timeRemaining = new("1", "32");

    private static string GetTaskIconClass(string status) => status switch
    {
        "completed"   => "border-emerald-500/30 bg-emerald-500/10",
        "in-progress" => "border-blue-500/30 bg-blue-500/10",
        _             => "border-muted-foreground/20 bg-muted/30",
    };
}
