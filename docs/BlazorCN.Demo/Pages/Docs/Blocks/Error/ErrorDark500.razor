@* ============================================================
   Block: error-dark-500
   Title: ErrorDark500
   Description: Dark-themed server error page with retry and status options
   Source: original/blocks/error/error-dark-500.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border border-zinc-800 bg-zinc-950">

        @* Header *@
        <div class="border-b border-zinc-800 px-4 py-3">
            <div class="flex items-center justify-between">
                <h1 class="font-medium text-sm text-zinc-100">Server Error</h1>
                <span class="rounded-full bg-red-500/10 px-2 py-0.5 font-mono text-red-400 text-xs">
                    500
                </span>
            </div>
        </div>

        @* Error Message *@
        <div class="border-b border-zinc-800 px-4 py-8 text-center">
            <div class="mx-auto mb-4 flex size-16 items-center justify-center rounded-full bg-red-500/10">
                <LucideIconCn Name="server" Size="32" Class="size-8 text-red-400" />
            </div>
            <h2 class="mb-2 font-semibold text-2xl text-zinc-100 tabular-nums">
                Something went wrong
            </h2>
            <p class="text-sm text-zinc-400">
                We're experiencing technical difficulties. Our team has been notified and is working on
                a fix.
            </p>
        </div>

        @* Error Details *@
        <div class="border-b border-zinc-800 px-4 py-4">
            <div class="grid gap-3">
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="alert-circle" Size="16" Class="mt-0.5 size-4 shrink-0 text-zinc-500" />
                    <div class="min-w-0 flex-1">
                        <div class="text-sm text-zinc-100">Error Type</div>
                        <div class="mt-0.5 font-mono text-muted-foreground text-xs text-zinc-500">
                            Internal Server Error
                        </div>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="clock" Size="16" Class="mt-0.5 size-4 shrink-0 text-zinc-500" />
                    <div class="min-w-0 flex-1">
                        <div class="text-sm text-zinc-100">Occurred At</div>
                        <div class="mt-0.5 font-mono text-muted-foreground text-xs text-zinc-500">
                            2 minutes ago
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="px-4 py-4">
            <span class="mb-3 block text-xs text-zinc-400">What you can do</span>
            <div class="grid gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-auto justify-start gap-3 border-zinc-800 bg-zinc-900 px-3 py-2.5 text-zinc-100 hover:bg-zinc-800">
                    <LucideIconCn Name="refresh-cw" Size="16" Class="size-4" />
                    <div class="text-left">
                        <div class="text-sm">Retry request</div>
                        <div class="text-muted-foreground text-xs text-zinc-500">
                            Try loading the page again
                        </div>
                    </div>
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-auto justify-start gap-3 px-3 py-2.5 text-zinc-100 hover:bg-zinc-900">
                    <LucideIconCn Name="external-link" Size="16" Class="size-4 text-zinc-500" />
                    <div class="text-left">
                        <div class="text-sm">Check status page</div>
                        <div class="text-muted-foreground text-xs text-zinc-500">
                            View real-time system status
                        </div>
                    </div>
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="border-t border-zinc-800 px-4 py-3">
            <p class="text-center text-xs text-zinc-500">
                If the problem persists, please contact our support team
            </p>
        </div>

    </div>
</section>
