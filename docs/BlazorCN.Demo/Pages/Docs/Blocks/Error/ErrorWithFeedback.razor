@* ============================================================
   Block: error-with-feedback
   Title: ErrorWithFeedback
   Description: Error page with user feedback form to report what went wrong and what they were trying to do
   Source: original/blocks/error/error-with-feedback.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header: icon + title + error code *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-muted/50">
                    <LucideIconCn Name="alert-circle" Size="20" Class="size-5 text-foreground" />
                </div>
                <div>
                    <p class="text-sm font-medium">Something went wrong</p>
                    <p class="text-xs text-muted-foreground">Error 500 • Server error</p>
                </div>
            </div>
        </div>

        @* Description *@
        <div class="border-b px-4 py-3">
            <p class="text-sm text-muted-foreground">
                We encountered an unexpected error. Help us fix this by telling us what you were trying
                to do.
            </p>
        </div>

        @* Form / success state *@
        <div class="px-4 py-3">
            @if (!_submitted)
            {
                <form class="space-y-4">
                    <div class="space-y-2">
                        <label for="description" class="text-xs font-medium text-muted-foreground">
                            What were you trying to do?
                        </label>
                        <TextareaCn id="description"
                                    Placeholder="I was trying to export my data when the page crashed..."
                                    @bind-Value="_description"
                                    Class="min-h-[120px] resize-none text-sm"
                                    required="required" />
                    </div>

                    <div class="space-y-2">
                        <label for="email" class="text-xs font-medium text-muted-foreground">
                            Email (optional)
                        </label>
                        <InputCn id="email"
                                 type="email"
                                 Placeholder="@("your@email.com")"
                                 @bind-Value="_email"
                                 Class="text-sm" />
                        <p class="text-xs text-muted-foreground">
                            We'll send you updates if you provide your email
                        </p>
                    </div>

                    <ButtonCn type="submit" Class="w-full gap-2" @onclick="HandleSubmit">
                        <LucideIconCn Name="send" Size="16" Class="size-4" />
                        Submit Feedback
                    </ButtonCn>
                </form>
            }
            else
            {
                <div class="space-y-3 py-6 text-center">
                    <div class="mx-auto flex size-12 items-center justify-center rounded-lg bg-emerald-500/10">
                        <LucideIconCn Name="message-square" Size="24" Class="size-6 text-emerald-600" />
                    </div>
                    <div>
                        <p class="text-sm font-medium">Feedback received</p>
                        <p class="mt-1 text-xs text-muted-foreground">
                            Thank you for helping us improve. Our team will investigate this issue.
                        </p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4">
                        <a href="/">Return to home</a>
                    </ButtonCn>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private string _description = "";
    private string _email = "";
    private bool _submitted = false;

    private void HandleSubmit()
    {
        _submitted = true;
    }
}
