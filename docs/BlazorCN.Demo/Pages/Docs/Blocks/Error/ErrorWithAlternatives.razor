@* ============================================================
   Block: error-with-alternatives
   Title: ErrorWithAlternatives
   Description: Error page that suggests relevant alternative pages the user might be looking for
   Source: original/blocks/error/error-with-alternatives.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-muted/50">
                    <LucideIconCn Name="file-question" Size="20" Class="size-5 text-foreground" />
                </div>
                <div>
                    <p class="text-sm font-medium">Page not found</p>
                    <p class="text-xs text-muted-foreground">
                        We couldn't find what you're looking for
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">You might be looking for:</p>
        </div>

        <div>
            @foreach (var alt in _alternatives)
            {
                <a href="@alt.Href"
                   class="flex items-center gap-3 border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-muted/50">
                        <LucideIconCn Name="@alt.Icon" Size="16" Class="size-4 text-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@alt.Title</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@alt.Description</p>
                    </div>
                    <LucideIconCn Name="arrow-right" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                </a>
            }
        </div>

    </div>
</section>

@code {
    private record Alternative(string Title, string Description, string Href, string Icon);

    private static readonly Alternative[] _alternatives =
    [
        new("Documentation",     "Guides and API references",              "/docs",      "book-open"),
        new("Dashboard",         "Your projects and analytics",            "/dashboard", "home"),
        new("Account Settings",  "Manage your profile and preferences",    "/settings",  "settings"),
        new("Billing",           "Subscription and payment info",          "/billing",   "credit-card"),
        new("Support Center",    "FAQs and contact support",               "/support",   "life-buoy"),
    ];
}
