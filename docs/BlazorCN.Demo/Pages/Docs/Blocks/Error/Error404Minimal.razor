<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex min-h-[500px] flex-col items-center justify-center px-4 py-16 text-center">
            <h1 class="mb-4 font-semibold tabular-nums text-6xl tracking-tight">404</h1>
            <h2 class="mb-2 font-medium text-lg">Page not found</h2>
            <p class="mb-8 text-muted-foreground text-sm">
