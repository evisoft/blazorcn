@* ============================================================
   Block: error-browser-unsupported
   Title: ErrorBrowserUnsupported
   Description: Unsupported browser error page listing supported browsers with download links
   Source: original/blocks/error/error-browser-unsupported.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Icon Header *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col items-center gap-4 text-center">
                <div class="flex size-16 items-center justify-center rounded-full bg-amber-500/10">
                    <LucideIconCn Name="globe" Size="32" Class="size-8 text-amber-600" />
                </div>
                <div>
                    <h1 class="text-2xl font-semibold">Browser Not Supported</h1>
                    <p class="mt-2 text-sm text-muted-foreground">
                        Your browser version is not compatible
                    </p>
                </div>
            </div>
        </div>

        @* Message *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3 text-center">
                <p class="text-sm text-muted-foreground">
                    This application requires a modern browser to function properly. Please upgrade to one
                    of the supported browsers below.
                </p>
                <div class="rounded-md bg-amber-500/10 p-3">
                    <p class="text-sm text-amber-700">
                        Using an outdated browser may result in security vulnerabilities and missing
                        features.
                    </p>
                </div>
            </div>
        </div>

        @* Supported Browsers *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">Supported Browsers</p>
                <div class="space-y-2">
                    @foreach (var browser in _supportedBrowsers)
                    {
                        var b = browser;
                        <div class="flex items-center justify-between rounded-md border bg-muted/50 px-4 py-3">
                            <div class="flex items-center gap-3">
                                <span class="text-2xl">@b.Icon</span>
                                <div>
                                    <p class="text-sm font-medium">@b.Name</p>
                                    <p class="text-xs text-muted-foreground">Version @b.Version</p>
                                </div>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm">
                                <LucideIconCn Name="download" Size="16" Class="size-4" />
                                Download
                            </ButtonCn>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Why Upgrade *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">Why Upgrade?</p>
                <ul class="space-y-2 text-sm text-muted-foreground">
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Better security and protection from threats</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Improved performance and faster loading times</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Access to the latest web features and standards</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Enhanced privacy controls and user experience</span>
                    </li>
                </ul>
            </div>
        </div>

        @* Technical Requirements *@
        <div class="border-b px-4 py-6">
            <div class="rounded-md bg-muted/50 p-4">
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="chrome" Size="20" Class="mt-0.5 size-5 shrink-0 text-muted-foreground" />
                    <div class="flex-1 space-y-1">
                        <p class="text-sm font-medium">Required Features</p>
                        <p class="text-sm text-muted-foreground">
                            This application requires ES6 modules, CSS Grid, and WebGL support. All modern
                            browsers listed above include these features.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Need help? Contact support for browser compatibility assistance
            </p>
        </div>

    </div>
</section>

@code {
    private record Browser(string Name, string Version, string Url, string Icon);

    private static readonly Browser[] _supportedBrowsers =
    [
        new("Google Chrome",   "90+", "https://www.google.com/chrome/",         "🌐"),
        new("Mozilla Firefox", "88+", "https://www.mozilla.org/firefox/",        "🦊"),
        new("Microsoft Edge",  "90+", "https://www.microsoft.com/edge",          "🔷"),
        new("Safari",          "14+", "https://www.apple.com/safari/",           "🧭"),
    ];
}
