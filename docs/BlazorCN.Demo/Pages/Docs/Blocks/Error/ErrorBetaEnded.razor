@* ============================================================
   Block: error-beta-ended
   Title: ErrorBetaEnded
   Description: Error page shown when a beta program has concluded
   Source: original/blocks/error/error-beta-ended.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border bg-rose-500/10">
                    <LucideIconCn Name="heart" Size="20" Class="size-5 text-rose-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Thank You for Beta Testing</h1>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Our beta program has concluded. Thank you for helping us build a better product.
                        Your feedback shaped many of the features you see today.
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 text-sm font-medium">Your Beta Contributions</div>
            <div class="grid grid-cols-3 gap-3">
                @foreach (var stat in _betaStats)
                {
                    <div class="rounded-lg border bg-muted/30 p-3 text-center">
                        <div class="mb-1 font-mono text-xl font-semibold tabular-nums">
                            @stat.Value
                        </div>
                        <div class="text-xs text-muted-foreground">@stat.Label</div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b bg-blue-500/5 px-4 py-2">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-blue-600" />
                <span class="text-xs font-medium text-blue-600">
                    Exclusive Beta Discount: 35% off for your first year
                </span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 text-sm font-medium">Continue Your Journey</div>
            <div class="grid gap-3 sm:grid-cols-2">
                @foreach (var tier in _pricingTiers)
                {
                    <div class="rounded-lg border bg-muted/30 p-3">
                        <div class="mb-2 text-sm font-medium">@tier.Name</div>
                        <div class="mb-3 flex items-baseline gap-2">
                            <span class="font-mono text-2xl font-semibold tabular-nums">
                                $@tier.Price
                            </span>
                            <span class="text-xs text-muted-foreground line-through">
                                $@tier.Original
                            </span>
                            <span class="text-xs text-muted-foreground">/month</span>
                        </div>
                        <ul class="space-y-1.5">
                            @foreach (var feature in tier.Features)
                            {
                                <li class="flex items-start gap-2 text-xs">
                                    <span class="mt-1 size-1 shrink-0 rounded-full bg-foreground"></span>
                                    <span class="text-muted-foreground">@feature</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>

        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="gap-1.5">
                <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5" />
                Upgrade Now
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="gap-1.5">
                <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                Export My Data
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                Share Feedback
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record BetaStat(string Label, string Value);
    private record PricingTier(string Name, int Price, int Original, string[] Features);

    private static readonly BetaStat[] _betaStats =
    [
        new("Beta Duration", "6 months"),
        new("Feedback Submitted", "47 items"),
        new("Features Tested", "23"),
    ];

    private static readonly PricingTier[] _pricingTiers =
    [
        new("Pro", 19, 29, ["Unlimited projects", "Advanced analytics", "Priority support", "API access"]),
        new("Team", 49, 79, ["Everything in Pro", "5 team members", "Shared workspaces", "Admin controls"]),
    ];
}
