@* ============================================================
   Block: error-with-status
   Title: ErrorWithStatus
   Description: Error page showing real-time system status for multiple services
   Source: original/blocks/error/error-with-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h1 class="font-medium text-sm">System Status</h1>
                <div class="flex items-center gap-2">
                    @if (_downCount > 0)
                    {
                        <span class="rounded-full bg-red-500/10 px-2 py-0.5 font-mono text-red-500 text-xs">
                            @_downCount down
                        </span>
                    }
                    @if (_degradedCount > 0)
                    {
                        <span class="rounded-full bg-amber-500/10 px-2 py-0.5 font-mono text-amber-500 text-xs">
                            @_degradedCount degraded
                        </span>
                    }
                </div>
            </div>
        </div>

        @* Error Summary *@
        <div class="border-b px-4 py-4">
            <div class="flex items-start gap-3">
                <LucideIconCn Name="alert-circle" Size="20" Class="mt-0.5 size-5 shrink-0 text-red-500" />
                <div class="min-w-0 flex-1">
                    <h2 class="font-medium text-sm">Service disruption detected</h2>
                    <p class="mt-1 text-muted-foreground text-xs">
                        We're experiencing issues with multiple services. Our team is investigating and
                        working on a fix.
                    </p>
                </div>
            </div>
        </div>

        @* Service Status List *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-xs text-muted-foreground">Service status</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                    Refresh
                </ButtonCn>
            </div>
            <div class="space-y-3">
                @foreach (var svc in _services)
                {
                    var cfg = GetStatusConfig(svc.Status);
                    <div class="flex items-start gap-3">
                        <span class="@($"mt-1 size-1.5 shrink-0 rounded-full {cfg.Dot}")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-2">
                                <div class="min-w-0 flex-1">
                                    <div class="font-medium text-sm">@svc.Name</div>
                                    <p class="mt-0.5 text-muted-foreground text-xs">
                                        @svc.Description
                                    </p>
                                </div>
                                <div class="flex shrink-0 items-center gap-2">
                                    <span class="@($"text-xs {cfg.Color}")">@cfg.Text</span>
                                </div>
                            </div>
                            <div class="mt-1 font-mono text-muted-foreground text-xs">
                                Last checked: @svc.LastChecked
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Status Summary *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-3 gap-3">
                <div class="rounded-md bg-emerald-500/10 p-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="check-circle" Size="16" Class="size-4 text-emerald-500" />
                        <span class="text-xs text-muted-foreground">Operational</span>
                    </div>
                    <div class="mt-1 font-semibold text-2xl tabular-nums">
                        @_operationalCount
                    </div>
                </div>
                <div class="rounded-md bg-amber-500/10 p-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-amber-500" />
                        <span class="text-xs text-muted-foreground">Degraded</span>
                    </div>
                    <div class="mt-1 font-semibold text-2xl tabular-nums">@_degradedCount</div>
                </div>
                <div class="rounded-md bg-red-500/10 p-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-500" />
                        <span class="text-xs text-muted-foreground">Down</span>
                    </div>
                    <div class="mt-1 font-semibold text-2xl tabular-nums">@_downCount</div>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="px-4 py-4">
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-2">
                    <LucideIconCn Name="external-link" Size="16" Class="size-4" />
                    View status page
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="flex-1">
                    Subscribe to updates
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Service(string Name, string Status, string Description, string LastChecked);

    private record StatusConfig(string Dot, string Text, string Color);

    private static readonly Service[] _services =
    [
        new("API",            "down",        "REST API endpoints",          "2 min ago"),
        new("Database",       "down",        "Primary database cluster",    "2 min ago"),
        new("Authentication", "degraded",    "User login and sessions",     "3 min ago"),
        new("CDN",            "operational", "Content delivery network",    "1 min ago"),
        new("File Storage",   "operational", "Upload and download services","1 min ago"),
        new("Email",          "operational", "Transactional emails",        "4 min ago"),
    ];

    private static StatusConfig GetStatusConfig(string status) => status switch
    {
        "operational" => new("bg-emerald-500", "Operational", "text-emerald-500"),
        "degraded"    => new("bg-amber-500",   "Degraded",    "text-amber-500"),
        "down"        => new("bg-red-500",      "Down",        "text-red-500"),
        _             => new("bg-muted-foreground", "Unknown", "text-muted-foreground"),
    };

    private int _downCount        => _services.Count(s => s.Status == "down");
    private int _degradedCount    => _services.Count(s => s.Status == "degraded");
    private int _operationalCount => _services.Count(s => s.Status == "operational");
}
