@* ============================================================
   Block: error-location-denied
   Title: ErrorLocationDenied
   Description: Location permission denied error with manual location entry fallback
   Source: original/blocks/error/error-location-denied.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-6">
            <div class="flex items-start gap-4">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="map-pin" Size="24" Class="size-6 text-amber-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="font-medium text-sm">Location Access Denied</h1>
                    <p class="mt-1 text-muted-foreground text-sm">
                        This site needs location access to show nearby results. Enable location or enter
                        manually.
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Enter Location Manually</h2>
            <p class="mt-2 text-muted-foreground text-xs">
                Type your city, address, or zip code to continue without location access.
            </p>
            <div class="mt-3 flex gap-2">
                <div class="relative flex-1">
                    <LucideIconCn Name="search" Size="16" Class="absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted-foreground" />
                    <InputCn @bind-Value="_location" Placeholder="Enter city, address, or zip code" Class="pl-9 text-xs" />
                </div>
                <ButtonCn Class="h-9 shrink-0 text-xs">Search</ButtonCn>
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Browser Permissions</h2>
            <p class="mt-2 text-muted-foreground text-xs">
                Enable location access in your browser:
            </p>
            <ul class="mt-3 space-y-2 text-muted-foreground text-xs">
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">1.</span>
                    <span>
                        Click the location icon <span class="font-semibold">📍</span> in your browser's
                        address bar
                    </span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">2.</span>
                    <span>Select "Allow" when prompted for location access</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">3.</span>
                    <span>If the icon is not visible, go to Site Settings → Location → Allow</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">4.</span>
                    <span>Refresh the page after enabling</span>
                </li>
            </ul>
        </div>

        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">System Permissions</h2>
            <p class="mt-2 text-muted-foreground text-xs">
                Your operating system must also allow location access:
            </p>
            <div class="mt-3 space-y-3">
                <div class="rounded-md bg-muted/50 p-3">
                    <p class="font-medium text-xs">macOS</p>
                    <ul class="mt-2 space-y-1.5 text-muted-foreground text-xs">
                        <li class="flex gap-2">
                            <span class="text-muted-foreground/60">1.</span>
                            <span>Open System Preferences → Security &amp; Privacy → Privacy</span>
                        </li>
                        <li class="flex gap-2">
                            <span class="text-muted-foreground/60">2.</span>
                            <span>Select "Location Services" from the left sidebar</span>
                        </li>
                        <li class="flex gap-2">
                            <span class="text-muted-foreground/60">3.</span>
                            <span>Enable Location Services at the top</span>
                        </li>
                        <li class="flex gap-2">
                            <span class="text-muted-foreground/60">4.</span>
                            <span>Check the box next to your browser (Chrome, Safari, etc.)</span>
                        </li>
                    </ul>
                </div>
                <div class="rounded-md bg-muted/50 p-3">
                    <p class="font-medium text-xs">Windows</p>
                    <ul class="mt-2 space-y-1.5 text-muted-foreground text-xs">
                        <li class="flex gap-2">
                            <span class="text-muted-foreground/60">1.</span>
                            <span>Open Settings → Privacy → Location</span>
                        </li>
                        <li class="flex gap-2">
                            <span class="text-muted-foreground/60">2.</span>
                            <span>Enable "Location service" at the top</span>
                        </li>
                        <li class="flex gap-2">
                            <span class="text-muted-foreground/60">3.</span>
                            <span>Enable "Allow apps to access your location"</span>
                        </li>
                        <li class="flex gap-2">
                            <span class="text-muted-foreground/60">4.</span>
                            <span>Ensure your browser is allowed in the list below</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Why Location Access?</h2>
            <ul class="mt-3 space-y-2 text-muted-foreground text-xs">
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">•</span>
                    <span>Show nearby stores, restaurants, or services</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">•</span>
                    <span>Provide accurate directions and travel times</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">•</span>
                    <span>Customize content based on your region</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">•</span>
                    <span>Calculate shipping costs and delivery estimates</span>
                </li>
            </ul>
            <p class="mt-3 text-muted-foreground text-xs">
                Your location is never shared with third parties without your consent.
            </p>
        </div>

        <div class="px-4 py-4">
            <div class="flex flex-wrap gap-2">
                <ButtonCn Class="h-8 gap-2" @onclick="HandleRetry">
                    <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                    Try Again
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-8 gap-2">
                    <LucideIconCn Name="external-link" Size="14" Class="size-3.5" />
                    Help Article
                </ButtonCn>
            </div>
            <p class="mt-3 text-muted-foreground text-xs">
                After enabling permissions, click "Try Again" or refresh the page to request location
                again.
            </p>
        </div>

    </div>
</section>

@code {
    private string _location = "";

    private void HandleRetry()
    {
        // In a real app this would call JS to reload: window.location.reload()
    }
}
