            <div>
                <h1 class="mb-4 font-semibold tabular-nums text-4xl tracking-tight">401</h1>
                <h2 class="mb-2 font-medium text-lg">Authentication required</h2>
                <p class="mb-8 text-muted-foreground text-sm">
                    Please sign in to continue. You'll need an account to access this page.
                </p>
            </div>

            <div class="w-full max-w-xs space-y-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-9 w-full justify-start gap-2 text-xs">
                    <svg
                        class="size-4"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-label="Google logo">
                        <title>Sign in with Google</title>
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
                    </svg>
                    Sign in with Google
                </ButtonCn>

                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-9 w-full justify-start gap-2 text-xs">
                    <LucideGithubCn class="size-4" />
                    Sign in with GitHub
                </ButtonCn>
            </div>

            <div class="mt-8 flex items-center gap-4 text-muted-foreground text-xs">
                <button type="button" class="transition-colors hover:text-foreground">
                    Create account
                </button>
                <span class="text-muted-foreground/40">•</span>
                <button type="button" class="transition-colors hover:text-foreground">
                    Go home
                </button>
            </div>
        </div>
    </div>
</section>

