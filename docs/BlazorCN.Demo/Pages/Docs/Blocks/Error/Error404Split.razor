@* ============================================================
   Block: error-404-split
   Title: Error404Split
   Description: A split-panel 404 error page block for React and Next.js with error info and popular links side by side built with shadcn/ui and Tailwind CSS
   Source: original/blocks/error/error-404-split.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid grid-cols-1 md:grid-cols-2">
            <div class="flex flex-col justify-center border-b px-6 py-12 md:border-r md:border-b-0">
                <h1 class="mb-4 font-semibold tabular-nums text-5xl tracking-tight">404</h1>
                <h2 class="mb-2 font-medium text-xl">Page not found</h2>
                <p class="mb-8 text-muted-foreground text-sm">
                    The page you're looking for doesn't exist. It might have been moved, deleted, or the
                    URL might be incorrect.
                </p>
                <div>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-2 text-xs">
                        <LucideIconCn Name="house" Size="14" Class="size-3.5" />
                        Go to homepage
                    </ButtonCn>
                </div>
            </div>

            <div class="px-6 py-12">
                <h3 class="mb-4 font-medium text-sm">Popular pages</h3>
                <div class="space-y-1">
                    @foreach (var link in _popularLinks)
                    {
                        <button type="button" class="flex w-full items-start gap-3 rounded-md px-3 py-2.5 text-left transition-colors hover:bg-muted/50">
                            <div class="min-w-0 flex-1">
                                <div class="mb-0.5 font-medium text-sm">@link.Title</div>
                                <div class="text-muted-foreground text-xs">@link.Description</div>
                            </div>
                            <LucideIconCn Name="arrow-right" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record PopularLink(string Title, string Href, string Description);

    private static readonly PopularLink[] _popularLinks =
    [
        new("Documentation", "/docs", "Learn how to use our platform"),
        new("API Reference", "/api", "Explore our API endpoints"),
        new("Guides", "/guides", "Step-by-step tutorials"),
        new("Support", "/support", "Get help from our team"),
        new("Blog", "/blog", "Latest news and updates"),
        new("Community", "/community", "Join the discussion"),
    ];
}
