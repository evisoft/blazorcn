@* ============================================================
   Block: error-banner-style
   Title: ErrorBannerStyle
   Description: Full-width error banner with dismiss and action buttons
   Source: original/blocks/error/error-banner-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h1 class="font-medium text-sm">System Alerts</h1>
        </div>

        @* Banner Stack *@
        <div class="p-4">
            <div class="space-y-3">
                @foreach (var banner in _banners)
                {
                    var colors = GetBannerColor(banner.Type);
                    <div class="@Cn.Merge("overflow-hidden rounded-lg border", colors.Border, colors.Bg)">
                        <div class="flex items-start gap-3 px-4 py-3">
                            <span class="@Cn.Merge("mt-0.5 size-1.5 shrink-0 rounded-full", colors.Dot)"></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-start justify-between gap-3">
                                    <p class="text-sm">@banner.Message</p>
                                    <button type="button"
                                            class="shrink-0 text-muted-foreground/60 transition-colors hover:text-muted-foreground"
                                            aria-label="Dismiss alert">
                                        <LucideIconCn Name="x" Size="16" Class="size-4" />
                                    </button>
                                </div>
                                @if (banner.Action != null)
                                {
                                    <div class="mt-2 flex items-center gap-2">
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2">
                                            @if (banner.Action == "refresh")
                                            {
                                                <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                                            }
                                            <span class="text-xs">@banner.ActionLabel</span>
                                        </ButtonCn>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Full-width banner example *@
        <div class="border-t px-4 py-3">
            <span class="mb-3 block text-xs text-muted-foreground">Full-width variant</span>
            <div class="overflow-hidden rounded-lg border border-red-500/20 bg-red-500/10">
                <div class="flex items-center justify-between gap-4 px-4 py-3">
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="alert-circle" Size="16" Class="size-4 shrink-0 text-red-500" />
                        <span class="text-sm">
                            Critical error: Database connection lost. Reconnecting...
                        </span>
                    </div>
                    <div class="flex items-center gap-2">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                            <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                            Retry
                        </ButtonCn>
                        <button type="button"
                                class="shrink-0 text-muted-foreground/60 transition-colors hover:text-muted-foreground"
                                aria-label="Dismiss">
                            <LucideIconCn Name="x" Size="16" Class="size-4" />
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record BannerColors(string Bg, string Border, string Dot, string Text);

    private record Banner(string Id, string Type, string Message, string? Action, string? ActionLabel);

    private static readonly Banner[] _banners =
    [
        new("1", "error",
            "Service disruption detected. Some features may be unavailable. Our team is investigating.",
            "status", "View status"),
        new("2", "warning",
            "Scheduled maintenance in 2 hours. The platform will be offline for approximately 30 minutes.",
            "details", "Learn more"),
        new("3", "info",
            "New security update available. Please refresh your browser to apply the latest changes.",
            "refresh", "Refresh now"),
    ];

    private static BannerColors GetBannerColor(string type) => type switch
    {
        "error"   => new("bg-red-500/10",   "border-red-500/20",   "bg-red-500",           "text-red-500"),
        "warning" => new("bg-amber-500/10", "border-amber-500/20", "bg-amber-500",         "text-amber-500"),
        "info"    => new("bg-blue-500/10",  "border-blue-500/20",  "bg-blue-500",          "text-blue-500"),
        _         => new("bg-muted/50",     "border-border",       "bg-muted-foreground",  "text-muted-foreground"),
    };
}
