@* ============================================================
   Block: error-payment-failed
   Title: ErrorPaymentFailed
   Description: Payment failed error page with retry options and alternative payment methods
   Source: original/blocks/error/error-payment-failed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Icon Header *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col items-center gap-4 text-center">
                <div class="flex size-16 items-center justify-center rounded-full bg-red-500/10">
                    <LucideIconCn Name="credit-card" Size="32" Class="size-8 text-red-600" />
                </div>
                <div>
                    <h1 class="text-2xl font-semibold">Payment Failed</h1>
                    <p class="mt-2 text-sm text-muted-foreground">We couldn't process your payment</p>
                </div>
            </div>
        </div>

        @* Transaction Details *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3 text-center">
                <div>
                    <p class="text-4xl font-semibold tabular-nums text-red-600">@_amount</p>
                    <p class="mt-2 text-xs text-muted-foreground">
                        Transaction attempted @_attemptTime
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 p-3">
                    <p class="font-mono text-xs text-muted-foreground">ID: @_transactionId</p>
                </div>
            </div>
        </div>

        @* Error Message *@
        <div class="border-b px-4 py-6">
            <div class="rounded-md bg-red-500/10 p-4">
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="alert-circle" Size="20" Class="mt-0.5 size-5 shrink-0 text-red-600" />
                    <div class="flex-1 space-y-1">
                        <p class="text-sm font-medium text-red-600">Payment Declined</p>
                        <p class="text-sm text-red-600">
                            Your payment could not be processed. Please check your payment details and try
                            again, or use a different payment method.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @* Common Reasons *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">Common Reasons for Failure</p>
                <div class="space-y-2">
                    @foreach (var reason in _failureReasons)
                    {
                        <div class="flex items-start gap-2 rounded-md bg-muted/50 px-3 py-2">
                            <span class="mt-1 size-1.5 shrink-0 rounded-full bg-red-500"></span>
                            <div class="flex-1">
                                <p class="text-sm font-medium">@reason.Title</p>
                                <p class="text-xs text-muted-foreground">@reason.Description</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">Try Again</p>
                <div class="flex flex-col gap-2 sm:flex-row">
                    <ButtonCn Class="flex-1" @onclick="HandleRetry">
                        <LucideIconCn Name="refresh-ccw" Size="16" Class="size-4" />
                        Retry Payment
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1" @onclick="HandleChangeCard">
                        <LucideIconCn Name="credit-card" Size="16" Class="size-4" />
                        Use Different Card
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Alternative Payment Methods *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">Alternative Payment Methods</p>
                <div class="space-y-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="w-full justify-start">
                        <span class="mr-2 text-base">💳</span>
                        Debit Card
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="w-full justify-start">
                        <span class="mr-2 text-base">🏦</span>
                        Bank Transfer
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="w-full justify-start">
                        <span class="mr-2 text-base">📱</span>
                        Digital Wallet
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Help Section *@
        <div class="border-b px-4 py-6">
            <div class="rounded-md bg-muted/50 p-4">
                <p class="text-sm font-medium">Need Help?</p>
                <p class="mt-2 text-sm text-muted-foreground">
                    If you continue to experience issues, please contact your bank or our billing support
                    team. Keep your transaction ID ready for reference.
                </p>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="mt-3">
                    <LucideIconCn Name="mail" Size="16" Class="size-4" />
                    Contact Billing Support
                </ButtonCn>
            </div>
        </div>

        @* Security Note *@
        <div class="border-b px-4 py-6">
            <div class="flex items-start gap-3 rounded-md bg-muted/50 p-3">
                <LucideIconCn Name="alert-circle" Size="20" Class="mt-0.5 size-5 shrink-0 text-muted-foreground" />
                <div class="flex-1">
                    <p class="text-sm font-medium">Payment Security</p>
                    <p class="mt-1 text-xs text-muted-foreground">
                        All payment information is encrypted and processed securely. We never store your
                        full card details.
                    </p>
                </div>
            </div>
        </div>

        @* Alternative Action *@
        <div class="border-b px-4 py-6">
            <ButtonCn Variant="ButtonVariant.Outline" Class="w-full">
                <LucideIconCn Name="home" Size="16" Class="size-4" />
                Back to Home
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Payment issues? Our support team is here to help 24/7
            </p>
        </div>

    </div>
</section>

@code {
    private record FailureReason(string Title, string Description);

    private readonly string _transactionId = "TXN-2026-03-25-XYZ123";
    private readonly string _attemptTime = "2 minutes ago";
    private readonly string _amount = "$29.99";

    private static readonly FailureReason[] _failureReasons =
    [
        new("Insufficient Funds",  "The card doesn't have enough balance"),
        new("Card Declined",       "Your bank declined the transaction"),
        new("Expired Card",        "The card expiration date has passed"),
        new("Incorrect Details",   "Card number, CVV, or billing info is incorrect"),
    ];

    private void HandleRetry()
    {
        // Retry payment
    }

    private void HandleChangeCard()
    {
        // Open card update form
    }
}
