@* ============================================================
   Block: error-content-removed
   Title: ErrorContentRemoved
   Description: Error page displayed when content has been removed for violating community guidelines or terms of service
   Source: original/blocks/error/error-content-removed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="file-x" Size="20" Class="size-5 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Content Removed</h1>
                    <p class="text-xs text-muted-foreground">This content is no longer available</p>
                </div>
            </div>
        </div>

        @* Removal Details *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <div class="flex items-center justify-between gap-2">
                    <span class="text-xs text-muted-foreground">Reason</span>
                    <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 bg-red-500/10 text-xs text-red-600">
                        Policy Violation
                    </BadgeCn>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-sm text-foreground">
                        This content violated our Community Guidelines regarding spam and misleading
                        information.
                    </p>
                </div>
            </div>
        </div>

        @* Content Info *@
        <div class="border-b px-4 py-3">
            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Content ID</span>
                    <code class="font-mono text-xs text-foreground">post-a8f92e</code>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Removed on</span>
                    <span class="text-xs text-foreground">March 24, 2026</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Reviewed by</span>
                    <span class="text-xs text-foreground">Moderation Team</span>
                </div>
            </div>
        </div>

        @* Appeal Notice *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-2 rounded-md bg-muted/50 p-3">
                <LucideIconCn Name="triangle-alert" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-amber-600" />
                <div class="min-w-0 flex-1 space-y-1">
                    <p class="text-xs font-medium">Disagree With This Decision?</p>
                    <p class="text-xs text-muted-foreground">
                        You can appeal this removal if you believe it was made in error. Our team will
                        review your appeal within 48 hours.
                    </p>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Size="ButtonSize.Sm" Class="flex-1 gap-2">
                    <LucideIconCn Name="message-circle" Size="14" Class="size-3.5" />
                    Submit Appeal
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="book-open" Size="14" Class="size-3.5" />
                    Read Guidelines
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Go Back
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
