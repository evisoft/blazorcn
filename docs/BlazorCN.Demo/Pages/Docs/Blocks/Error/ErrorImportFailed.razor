@* ============================================================
   Block: error-import-failed
   Title: ErrorImportFailed
   Description: Error page for CSV/data import failures with row-level error details and fix options
   Source: original/blocks/error/error-import-failed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="file-x" Size="20" Class="size-5 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Import Failed</h1>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Data validation errors detected
                    </p>
                </div>
            </div>
        </div>

        @* Import Summary *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Import summary</h2>
            <div class="mt-3 grid grid-cols-3 gap-2">
                <div class="rounded-md bg-muted/50 px-3 py-2 text-center">
                    <p class="font-semibold tabular-nums text-2xl">248</p>
                    <p class="mt-1 text-xs text-muted-foreground">Total rows</p>
                </div>
                <div class="rounded-md bg-emerald-500/10 px-3 py-2 text-center">
                    <p class="font-semibold tabular-nums text-2xl text-emerald-600">235</p>
                    <p class="mt-1 text-xs text-emerald-800/80 dark:text-emerald-200/70">Valid</p>
                </div>
                <div class="rounded-md bg-red-500/10 px-3 py-2 text-center">
                    <p class="font-semibold tabular-nums text-2xl text-red-600">13</p>
                    <p class="mt-1 text-xs text-red-800/80 dark:text-red-200/70">Errors</p>
                </div>
            </div>
            <div class="mt-3 rounded-md bg-muted/50 px-3 py-2">
                <p class="text-xs font-medium">File name</p>
                <p class="mt-0.5 font-mono text-xs text-muted-foreground">
                    customers-2026-03-25.csv
                </p>
            </div>
        </div>

        @* Error Details *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <h2 class="text-sm font-medium">Error details</h2>
                <span class="text-xs text-muted-foreground">Showing first 5 of 13 errors</span>
            </div>
            <div class="mt-3 space-y-2">
                @foreach (var err in _errors)
                {
                    <div class="rounded-md border border-red-200 bg-red-500/5 p-3 dark:border-red-900/50">
                        <div class="flex items-start gap-3">
                            <LucideIconCn Name="alert-triangle" Size="16" Class="mt-0.5 size-4 shrink-0 text-red-600" />
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-mono text-xs font-medium">@err.Row</span>
                                    <span class="text-xs text-muted-foreground">•</span>
                                    <span class="font-mono text-xs text-muted-foreground">Column: @err.Column</span>
                                </div>
                                <p class="mt-1 text-xs text-muted-foreground">@err.Message</p>
                                <div class="mt-2 rounded-md bg-muted/50 px-2 py-1">
                                    <p class="font-mono text-xs">
                                        <span class="text-muted-foreground">Value:</span>
                                        @(" ")
                                        <span class="text-red-600">@err.Value</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Download Error Report *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Error report</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Download a detailed report with all error rows highlighted and correction suggestions
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-3 w-full gap-2">
                <LucideIconCn Name="download" Size="16" Class="size-4" />
                Download error report (CSV)
            </ButtonCn>
        </div>

        @* Next Steps *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">What would you like to do?</h2>
            <div class="mt-3 space-y-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full gap-2">
                    <LucideIconCn Name="refresh-cw" Size="16" Class="size-4" />
                    Fix errors and retry upload
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full">
                    Import valid rows only (235 rows)
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full">
                    Cancel import
                </ButtonCn>
            </div>
        </div>

        @* Help *@
        <div class="px-4 py-4">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs font-medium">Need help fixing errors?</p>
                <p class="mt-1 text-xs text-muted-foreground">
                    View our data format guide and validation rules to ensure your CSV meets all
                    requirements
                </p>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="mt-2 h-6 gap-1 px-2 text-xs">
                    <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                    View format guide
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record ImportError(string Row, string Column, string Message, string Value);

    private static readonly ImportError[] _errors =
    [
        new("Row 12",  "email",       "Invalid email format",                         "john.doe@invalid"),
        new("Row 24",  "phone",       "Required field is empty",                      "(empty)"),
        new("Row 87",  "date_joined", "Invalid date format (expected YYYY-MM-DD)",    "03/25/2026"),
        new("Row 142", "customer_id", "Duplicate value (already exists in database)", "CUST-1234"),
        new("Row 203", "status",      "Invalid value (allowed: active, inactive, pending)", "archived"),
    ];
}
