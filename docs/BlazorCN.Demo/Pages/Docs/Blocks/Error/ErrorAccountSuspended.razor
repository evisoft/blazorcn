@* ============================================================
   Block: error-account-suspended
   Title: ErrorAccountSuspended
   Description: Account suspension notice with warning icon, reason, appeal form link, and support contact
   Source: original/blocks/error/error-account-suspended.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="shield-alert" Size="20" Class="size-5 text-amber-500" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="font-medium text-sm">Account Suspended</h1>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Your account access has been temporarily restricted
                    </p>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="font-semibold tabular-nums text-4xl text-amber-500">403</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">SUSPENSION DETAILS</span>
            <div class="mt-3 space-y-0">
                <div class="flex items-center gap-3 border-b px-0 py-3">
                    <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Reason</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@_suspension.Reason</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 border-b px-0 py-3">
                    <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Suspension Date</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@_suspension.Date</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 px-0 py-3">
                    <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Reference Number</span>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs">@_suspension.Reference</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-amber-500/10 p-3">
                <div class="flex items-start gap-2">
                    <LucideIconCn Name="alert-triangle" Size="16" Class="mt-0.5 size-4 shrink-0 text-amber-500" />
                    <div class="min-w-0 flex-1">
                        <h2 class="font-medium text-sm">What this means</h2>
                        <p class="mt-1 text-muted-foreground text-xs">
                            Your account has been temporarily suspended and you cannot access most features.
                            To resolve this issue, please update your payment method or contact our support
                            team to discuss your account status.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">NEXT STEPS</span>
            <div class="mt-3 space-y-2">
                <div class="rounded-md bg-muted/50 p-3">
                    <h3 class="font-medium text-sm">Review suspension details</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Check your email for a detailed explanation of the suspension and steps to resolve
                        it
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 p-3">
                    <h3 class="font-medium text-sm">Update payment information</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        If suspended due to payment issues, update your billing details to restore access
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 p-3">
                    <h3 class="font-medium text-sm">Submit an appeal</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        If you believe this suspension was made in error, submit an appeal for review
                    </p>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    <span>Reference: @_suspension.Reference</span>
                </div>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="file-text" Size="14" Class="size-3.5" />
                        Submit Appeal
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="mail" Size="14" Class="size-3.5" />
                        Contact Support
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SuspensionDetails(string Reason, string Date, string Reference);

    private static readonly SuspensionDetails _suspension = new(
        "Multiple failed payment attempts",
        "March 20, 2026",
        "SUSP-2026-12345"
    );
}
