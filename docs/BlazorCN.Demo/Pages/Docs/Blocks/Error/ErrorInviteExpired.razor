@* ============================================================
   Block: error-invite-expired
   Title: ErrorInviteExpired
   Description: Expired invitation link error with clock icon and request new invite button
   Source: original/blocks/error/error-invite-expired.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="clock" Size="20" Class="size-5 text-amber-500" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="font-medium text-sm">Invitation Expired</h1>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        This invitation link is no longer valid
                    </p>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="font-semibold tabular-nums text-4xl text-amber-500">410</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">INVITATION DETAILS</span>
            <div class="mt-3 space-y-0">
                <div class="flex items-center gap-3 border-b px-0 py-3">
                    <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Invitation Type</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@_invite.Type</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 border-b px-0 py-3">
                    <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Sent By</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@_invite.SentBy</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 border-b px-0 py-3">
                    <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Sent Date</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@_invite.SentDate</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 border-b px-0 py-3">
                    <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Expired Date</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@_invite.ExpiredDate</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 px-0 py-3">
                    <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Invitation Code</span>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs">@_invite.InviteCode</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-amber-500/10 p-3">
                <div class="flex items-start gap-2">
                    <LucideIconCn Name="clock" Size="16" Class="mt-0.5 size-4 shrink-0 text-amber-500" />
                    <div class="min-w-0 flex-1">
                        <h2 class="font-medium text-sm">Why did this happen?</h2>
                        <p class="mt-1 text-muted-foreground text-xs">
                            Invitation links expire for security reasons. This invitation was valid for 7 days
                            and expired on @_invite.ExpiredDate. To access the workspace, you'll need a
                            new invitation.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">WHAT TO DO NEXT</span>
            <div class="mt-3 space-y-2">
                <div class="rounded-md bg-muted/50 p-3">
                    <h3 class="font-medium text-sm">Request a new invitation</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Contact @_invite.SentBy or a workspace administrator to send you a fresh
                        invitation link
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 p-3">
                    <h3 class="font-medium text-sm">Check your email</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        A new invitation may have already been sent. Check your inbox and spam folder for
                        recent messages
                    </p>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    <span>Expired: @_invite.ExpiredDate</span>
                </div>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                        Request New Invite
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="help-circle" Size="14" Class="size-3.5" />
                        Get Help
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record InviteDetails(string Type, string SentBy, string SentDate, string ExpiredDate, string InviteCode);

    private static readonly InviteDetails _invite = new(
        Type: "Team Workspace",
        SentBy: "Sarah Johnson",
        SentDate: "March 10, 2026",
        ExpiredDate: "March 17, 2026",
        InviteCode: "INV-2026-ABC123"
    );
}
