@* ============================================================
   Block: error-with-steps
   Title: ErrorWithSteps
   Description: Error page with numbered troubleshooting steps and progress tracking
   Source: original/blocks/error/error-with-steps.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h1 class="font-medium text-sm">Troubleshooting Guide</h1>
                <span class="rounded-full bg-red-500/10 px-2 py-0.5 font-mono text-red-500 text-xs">
                    Error
                </span>
            </div>
        </div>

        @* Error Summary *@
        <div class="border-b px-4 py-4">
            <div class="flex items-start gap-3">
                <LucideIconCn Name="alert-circle" Size="20" Class="mt-0.5 size-5 shrink-0 text-red-500" />
                <div class="min-w-0 flex-1">
                    <h2 class="font-medium text-sm">Unable to connect to the server</h2>
                    <p class="mt-1 text-muted-foreground text-xs">
                        We couldn't establish a connection. Follow the steps below to resolve this issue.
                    </p>
                </div>
            </div>
        </div>

        @* Troubleshooting Steps *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block text-xs text-muted-foreground">Follow these steps</span>
            <div class="space-y-4">
                @foreach (var step in _steps)
                {
                    var stepItem = step;
                    <label for="@($"step-{stepItem.Id}")"
                           class="flex cursor-pointer items-start gap-3 rounded-md p-3 transition-colors hover:bg-muted/50">
                        <CheckboxCn Id="@($"step-{stepItem.Id}")"
                                    Class="mt-0.5"
                                    aria-label="@($"Complete step {stepItem.Id}")"
                                    @bind-Value="_checked[stepItem.Id]" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start gap-2">
                                <span class="font-mono text-muted-foreground text-xs">@(stepItem.Id).</span>
                                <div class="min-w-0 flex-1">
                                    <div class="font-medium text-sm">@stepItem.Title</div>
                                    <p class="mt-1 text-muted-foreground text-xs">@stepItem.Description</p>
                                    @if (stepItem.Link != null)
                                    {
                                        <button type="button"
                                                class="mt-2 inline-flex items-center gap-1 text-xs text-blue-500 transition-colors hover:text-blue-600">
                                            @stepItem.Link
                                            <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </label>
                }
            </div>
        </div>

        @* Progress *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="check-circle" Size="16" Class="size-4 text-emerald-500" />
                    <span class="text-sm">Progress</span>
                </div>
                <span class="font-mono text-muted-foreground text-xs">
                    @CompletedCount of @_steps.Length completed
                </span>
            </div>
            <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-muted">
                <div class="h-full bg-emerald-500 transition-all duration-500"
                     style="@(FormattableString.Invariant($"width:{ProgressPercent}%"))">
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="px-4 py-4">
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-2">
                    <LucideIconCn Name="refresh-cw" Size="16" Class="size-4" />
                    Try again
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="flex-1">
                    Report issue
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Step(string Id, string Title, string Description, string? Link = null);

    private static readonly Step[] _steps =
    [
        new("1", "Check your internet connection",
            "Ensure you're connected to a stable network. Try opening another website to verify."),
        new("2", "Clear your browser cache",
            "Cached data may be causing conflicts. Clear your cache and cookies, then reload the page.",
            "How to clear cache"),
        new("3", "Disable browser extensions",
            "Some extensions may interfere with the site. Try disabling them temporarily."),
        new("4", "Try a different browser",
            "If the issue persists, try accessing the site using a different browser."),
        new("5", "Contact support",
            "If none of the above steps work, reach out to our support team for assistance.",
            "Open support ticket"),
    ];

    private readonly Dictionary<string, bool> _checked = new()
    {
        ["1"] = false,
        ["2"] = false,
        ["3"] = false,
        ["4"] = false,
        ["5"] = false,
    };

    private int CompletedCount => _checked.Values.Count(v => v);
    private double ProgressPercent => _steps.Length == 0 ? 0 : (double)CompletedCount / _steps.Length * 100;
}
