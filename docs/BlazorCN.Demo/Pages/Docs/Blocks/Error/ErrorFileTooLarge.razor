@* ============================================================
   Block: error-file-too-large
   Title: ErrorFileTooLarge
   Description: Upload file size exceeded error showing max size, current file, compression tips, and upgrade option
   Source: original/blocks/error/error-file-too-large.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="x-circle" Size="20" Class="size-5 text-red-500" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="font-medium text-sm">File Too Large</h1>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Your file exceeds the maximum upload size
                    </p>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="font-semibold tabular-nums text-4xl text-red-500">413</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">FILE DETAILS</span>
            <div class="mt-3 rounded-md bg-muted/50 p-3">
                <div class="flex items-center gap-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-background">
                        <LucideIconCn Name="file" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@_fileName</span>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs">@_currentSize MB</p>
                    </div>
                    <span class="shrink-0 rounded-md bg-red-500/10 px-2 py-1 font-medium text-red-500 text-xs">
                        Too Large
                    </span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">SIZE COMPARISON</span>
            <div class="mt-3 space-y-3">
                <div>
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground text-xs">Maximum allowed</span>
                        <span class="font-medium tabular-nums text-xs">@_maxSize MB</span>
                    </div>
                    <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-muted">
                        <div class="h-full bg-emerald-500" style="width:100%"></div>
                    </div>
                </div>
                <div>
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground text-xs">Your file size</span>
                        <span class="font-medium tabular-nums text-red-500 text-xs">
                            @_currentSize MB
                        </span>
                    </div>
                    <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-muted">
                        <div class="h-full bg-red-500" style="width:100%"></div>
                    </div>
                </div>
                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    <span>Your file is @((_currentSize - _maxSize).ToString("F1")) MB over the limit</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">COMPRESSION TIPS</span>
            <div class="mt-3 space-y-2">
                @foreach (var tip in _compressionTips)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="flex items-start gap-2">
                            <LucideIconCn Name="check-circle-2" Size="16" Class="mt-0.5 size-4 shrink-0 text-emerald-500" />
                            <div class="min-w-0 flex-1">
                                <h2 class="font-medium text-sm">@tip.Title</h2>
                                <p class="mt-0.5 text-muted-foreground text-xs">@tip.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-blue-500/10 p-3">
                <div class="flex items-start gap-2">
                    <LucideIconCn Name="sparkles" Size="16" Class="mt-0.5 size-4 shrink-0 text-blue-500" />
                    <div class="min-w-0 flex-1">
                        <h3 class="font-medium text-sm">Need larger uploads?</h3>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Pro accounts can upload files up to 100MB. Enterprise plans support files up to
                            1GB.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="file" Size="14" Class="size-3.5" />
                    Choose Different File
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="arrow-up" Size="14" Class="size-3.5" />
                    Upgrade Plan
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private const int _maxSize = 10;
    private const double _currentSize = 24.5;
    private const string _fileName = "presentation-deck.pdf";

    private record CompressionTip(string Title, string Description);

    private static readonly CompressionTip[] _compressionTips =
    [
        new("Compress your file",      "Use online tools to reduce file size by up to 80%"),
        new("Split into smaller parts","Break large files into multiple smaller uploads"),
        new("Remove unused content",   "Delete unnecessary pages, images, or attachments"),
    ];
}
