@* ============================================================
   Block: error-storage-full
   Title: ErrorStorageFull
   Description: Browser or device storage full error with cleanup instructions
   Source: original/blocks/error/error-storage-full.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-6">
            <div class="flex items-start gap-4">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="hard-drive" Size="24" Class="size-6 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="font-medium text-sm">Storage Full</h1>
                    <p class="mt-1 text-muted-foreground text-sm">
                        Your device or browser storage is full. Free up space by clearing cache and
                        temporary files.
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <h2 class="font-medium text-sm">Storage Status</h2>
                <span class="tabular-nums font-medium text-red-600 text-sm">98% Full</span>
            </div>
            <div class="mt-3">
                <div class="h-2 w-full overflow-hidden rounded-full bg-muted">
                    <div class="h-full bg-red-500" style="width:98%"></div>
                </div>
            </div>
            <div class="mt-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">19.6 GB of 20 GB used</span>
                <span class="tabular-nums text-xs">400 MB free</span>
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Storage Breakdown</h2>
            <div class="mt-3 space-y-2">
                @foreach (var item in _storageData)
                {
                    <div class="rounded-md bg-muted/50 px-3 py-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs">@item.Category</span>
                            <div class="flex items-center gap-2">
                                <span class="tabular-nums text-muted-foreground text-xs">@item.Size</span>
                                <span class="tabular-nums text-muted-foreground text-xs">
                                    (@(item.Percentage)%)
                                </span>
                            </div>
                        </div>
                        <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-muted">
                            <div class="h-full bg-foreground/20" style="@($"width:{item.Percentage}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Clear Browser Cache</h2>
            <p class="mt-2 text-muted-foreground text-xs">
                Clearing cache is safe and often frees up several gigabytes.
            </p>
            <ul class="mt-3 space-y-2 text-muted-foreground text-xs">
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">1.</span>
                    <span>Open browser settings (@("⋮") menu → Settings, or Cmd/Ctrl + ,)</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">2.</span>
                    <span>Go to Privacy and Security → Clear Browsing Data</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">3.</span>
                    <span>Select "Cached images and files" (uncheck passwords and autofill)</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">4.</span>
                    <span>Choose "All time" as the time range</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">5.</span>
                    <span>Click "Clear data"</span>
                </li>
            </ul>
            <div class="mt-3 rounded-md bg-emerald-500/10 p-3">
                <div class="flex items-start gap-2">
                    <LucideIconCn Name="circle-check" Size="16" Class="size-4 shrink-0 text-emerald-600" />
                    <div>
                        <p class="font-medium text-xs">Safe to Delete</p>
                        <p class="mt-1 text-muted-foreground text-xs">
                            Cache contains temporary copies of web pages. Clearing it won't affect your
                            passwords, bookmarks, or saved data.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Other Storage Cleanup Tips</h2>
            <ul class="mt-3 space-y-2 text-muted-foreground text-xs">
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">•</span>
                    <span>Empty Downloads folder and remove old installation files</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">•</span>
                    <span>Clear Trash/Recycle Bin to permanently delete files</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">•</span>
                    <span>Uninstall unused applications and browser extensions</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">•</span>
                    <span>Move large files to external drive or cloud storage</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">•</span>
                    <span>Delete old videos, screenshots, and duplicate photos</span>
                </li>
            </ul>
        </div>

        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Quick Actions by Browser</h2>
            <div class="mt-3 space-y-2">
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-xs">Chrome/Edge</span>
                        <span class="font-mono text-muted-foreground text-xs">
                            chrome://settings/clearBrowserData
                        </span>
                    </div>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-xs">Firefox</span>
                        <span class="font-mono text-muted-foreground text-xs">
                            about:preferences#privacy
                        </span>
                    </div>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-xs">Safari</span>
                        <span class="text-muted-foreground text-xs">
                            Cmd+, → Advanced → Show Developer
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="px-4 py-4">
            <div class="flex flex-wrap gap-2">
                <ButtonCn Class="h-8 gap-2">
                    <LucideIconCn Name="trash" Size="14" Class="size-3.5" />
                    Clear Cache Now
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-8 gap-2">
                    <LucideIconCn Name="settings" Size="14" Class="size-3.5" />
                    Storage Settings
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-8 gap-2">
                    <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                    Refresh Status
                </ButtonCn>
            </div>
            <p class="mt-3 text-muted-foreground text-xs">
                After clearing storage, refresh this page to verify available space.
            </p>
        </div>

    </div>
</section>

@code {
    private record StorageItem(string Category, string Size, int Percentage);

    private static readonly StorageItem[] _storageData =
    [
        new("Cache & Temporary Files", "8.4 GB", 42),
        new("Downloads",               "5.2 GB", 26),
        new("Application Data",        "3.8 GB", 19),
        new("Cookies & Site Data",     "1.9 GB",  9),
        new("Other",                   "0.7 GB",  4),
    ];
}
