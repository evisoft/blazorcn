<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-muted/50">
                    <LucideIconCn Name="file-question" Size="20" Class="size-5 text-foreground" />
                </div>
                <div>
                    <p class="text-sm font-medium">Page not found</p>
                    <p class="text-xs text-muted-foreground">Error 404</p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-sm text-muted-foreground">
                The page you're looking for doesn't exist. It may have been moved or deleted.
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <label for="search" class="text-xs font-medium text-muted-foreground">
                    Search our site
                </label>
                <div class="flex gap-2">
                    <InputCn Id="search" Type="search" Placeholder="What are you looking for?" Class="text-sm" />
                    <ButtonCn Size="ButtonSize.Sm" Class="gap-2">
                        <LucideIconCn Name="search" Size="16" Class="size-4" />
                        Search
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <p class="mb-3 text-xs font-medium text-muted-foreground">Quick links</p>
            <div class="flex flex-wrap gap-2">
                <a href="https://example.com"
                   class="inline-flex items-center gap-2 rounded-md border border-input bg-background px-3 py-1.5 text-sm font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground">
                    <LucideIconCn Name="house" Size="16" Class="size-4" />
                    Homepage
                </a>
                <a href="https://example.com/docs"
                   class="inline-flex items-center gap-2 rounded-md border border-input bg-background px-3 py-1.5 text-sm font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground">
                    <LucideIconCn Name="book-open" Size="16" Class="size-4" />
                    Documentation
                </a>
            </div>
        </div>
    </div>
</section>

