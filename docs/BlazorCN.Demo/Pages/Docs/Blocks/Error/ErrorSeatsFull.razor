@* ============================================================
   Block: error-seats-full
   Title: ErrorSeatsFull
   Description: Error page shown when a team has reached its maximum seat capacity
   Source: original/blocks/error/error-seats-full.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border bg-amber-500/10">
                    <LucideIconCn Name="users" Size="20" Class="size-5 text-amber-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Team Seats at Capacity</h1>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your team has reached the maximum number of seats for your current plan. Upgrade to
                        add more members or remove inactive users.
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-sm font-medium">Current Usage</span>
                <span class="text-xs text-muted-foreground">Team Plan (5 seats)</span>
            </div>
            <div class="mb-2 flex items-baseline gap-2">
                <span class="font-mono text-4xl font-semibold tabular-nums">5</span>
                <span class="text-muted-foreground">/</span>
                <span class="font-mono text-2xl font-semibold tabular-nums text-muted-foreground">
                    5
                </span>
                <span class="text-xs text-muted-foreground">seats used</span>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-muted">
                <div class="h-full w-full bg-amber-500"></div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Active Team Members</span>
            </div>
            <div class="space-y-0">
                @foreach (var member in _currentMembers)
                {
                    var isLast = member == _currentMembers[^1];
                    <div class="@Cn.Merge("flex items-center justify-between px-3 py-2", !isLast ? "border-b" : "")">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@member.Name</span>
                                @if (member.Status == "Invited")
                                {
                                    <span class="inline-flex items-center rounded-full bg-blue-500/10 px-2 py-0.5 text-xs font-medium text-blue-600">
                                        Pending
                                    </span>
                                }
                            </div>
                            <div class="text-xs text-muted-foreground">@member.Email</div>
                        </div>
                        <span class="text-xs text-muted-foreground">@member.Role</span>
                    </div>
                }
            </div>
        </div>

        <div class="border-b bg-amber-500/5 px-4 py-2">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="alert-circle" Size="16" Class="size-4 text-amber-600" />
                <span class="text-xs text-muted-foreground">
                    Remove inactive members or upgrade your plan to invite more team members
                </span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 text-sm font-medium">Upgrade Options</div>
            <div class="grid gap-3 sm:grid-cols-2">
                @foreach (var plan in _upgradePlans)
                {
                    <div class="rounded-lg border bg-muted/30 p-3">
                        <div class="mb-2 text-sm font-medium">@plan.Name</div>
                        <div class="mb-1 flex items-baseline gap-2">
                            <span class="font-mono text-2xl font-semibold tabular-nums">
                                $@plan.Price
                            </span>
                            <span class="text-xs text-muted-foreground">/month</span>
                        </div>
                        <div class="text-xs text-muted-foreground">@plan.Additional</div>
                    </div>
                }
            </div>
        </div>

        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="gap-1.5">
                <LucideIconCn Name="arrow-up" Size="14" Class="size-3.5" />
                Upgrade Plan
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="gap-1.5">
                <LucideIconCn Name="settings" Size="14" Class="size-3.5" />
                Manage Team
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Member(string Name, string Email, string Role, string Status);
    private record UpgradePlan(string Name, int Price, int Seats, string Additional);

    private static readonly Member[] _currentMembers =
    [
        new("Sarah Chen", "sarah@@company.com", "Admin", "Active"),
        new("Mike Johnson", "mike@@company.com", "Member", "Active"),
        new("Emma Davis", "emma@@company.com", "Member", "Active"),
        new("Alex Rivera", "alex@@company.com", "Member", "Active"),
        new("Jordan Lee", "jordan@@company.com", "Member", "Invited"),
    ];

    private static readonly UpgradePlan[] _upgradePlans =
    [
        new("Team (10 seats)", 79, 10, "Double your capacity"),
        new("Organization (25 seats)", 159, 25, "For growing teams"),
    ];
}
