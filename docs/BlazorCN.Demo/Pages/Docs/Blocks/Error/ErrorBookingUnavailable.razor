@* ============================================================
   Block: error-booking-unavailable
   Title: ErrorBookingUnavailable
   Description: Booking slot unavailable page with alternative time suggestions and waitlist signup
   Source: original/blocks/error/error-booking-unavailable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="calendar-x" Size="20" Class="size-5 text-amber-600" />
                </div>
                <div>
                    <p class="text-sm font-medium">This time is taken</p>
                    <p class="text-xs text-muted-foreground">Appointment slot unavailable</p>
                </div>
            </div>
        </div>

        @* Requested Slot *@
        <div class="border-b px-4 py-3">
            <p class="text-xs text-muted-foreground">You tried to book:</p>
            <div class="mt-2 flex items-center gap-3">
                <div class="flex items-center gap-2 rounded-lg bg-muted/50 px-3 py-2">
                    <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm">@_requestedDate</span>
                </div>
                <div class="flex items-center gap-2 rounded-lg bg-muted/50 px-3 py-2">
                    <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm">@_requestedTime</span>
                </div>
            </div>
        </div>

        @* Alternative Slots *@
        <div>
            <div class="border-b px-4 py-3">
                <p class="text-xs font-medium text-muted-foreground">Next available times</p>
            </div>
            @foreach (var slot in _alternativeSlots)
            {
                <button type="button" class="flex w-full items-center justify-between border-b px-4 py-3 text-left transition-colors last:border-b-0 hover:bg-muted/50">
                    <div>
                        <p class="text-sm font-medium">@slot.Date</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@slot.Day</p>
                    </div>
                    <div class="flex items-center gap-2 rounded bg-muted/50 px-2.5 py-1.5">
                        <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs font-medium">@slot.Time</span>
                    </div>
                </button>
            }
        </div>

        @* Waitlist *@
        <div class="border-t px-4 py-3">
            <div class="space-y-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">
                        Join waitlist for March 28, 2:00 PM
                    </span>
                </div>
                <p class="text-xs text-muted-foreground">
                    We'll notify you if this time becomes available due to a cancellation.
                </p>
                <div class="flex gap-2">
                    <InputCn Type="email" Placeholder="@("your@email.com")" Class="text-sm" />
                    <ButtonCn Size="ButtonSize.Sm" Class="shrink-0">
                        Join waitlist
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private readonly string _requestedDate = "March 28, 2026";
    private readonly string _requestedTime = "2:00 PM";

    private record TimeSlot(string Date, string Time, string Day);

    private static readonly TimeSlot[] _alternativeSlots =
    [
        new("March 28, 2026", "4:30 PM", "Friday"),
        new("March 29, 2026", "10:00 AM", "Saturday"),
        new("March 29, 2026", "2:00 PM", "Saturday"),
        new("March 31, 2026", "11:00 AM", "Monday"),
        new("April 1, 2026", "3:00 PM", "Tuesday"),
    ];
}
