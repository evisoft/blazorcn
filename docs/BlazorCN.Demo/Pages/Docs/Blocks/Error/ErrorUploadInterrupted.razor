@* ============================================================
   Block: error-upload-interrupted
   Title: ErrorUploadInterrupted
   Description: Upload interrupted error with resume functionality and progress indicator
   Source: original/blocks/error/error-upload-interrupted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header — icon + title + description *@
        <div class="border-b px-4 py-6">
            <div class="flex items-start gap-4">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="upload" Size="24" Class="size-6 text-amber-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="font-medium text-sm">Upload Interrupted</h1>
                    <p class="mt-1 text-muted-foreground text-sm">
                        The upload was interrupted at 63%. You can resume or start over.
                    </p>
                </div>
            </div>
        </div>

        @* Progress *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Upload progress</span>
                <span class="tabular-nums font-medium text-amber-600 text-sm">@_progress%</span>
            </div>
            <div class="mt-2">
                <div class="h-2 w-full overflow-hidden rounded-full bg-muted">
                    <div class="h-full bg-amber-500" style="@($"width:{_progress}%")"></div>
                </div>
            </div>
            <p class="mt-2 text-muted-foreground text-xs">432 MB of 687 MB uploaded</p>
        </div>

        @* File Details *@
        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">File Details</h2>
            <div class="mt-3 space-y-2">
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">File name</span>
                    <span class="truncate font-mono text-xs">presentation-final.pptx</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">Total size</span>
                    <span class="tabular-nums text-xs">687 MB</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">Started at</span>
                    <span class="text-xs">10:23 AM</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">Interrupted at</span>
                    <span class="text-xs">10:28 AM</span>
                </div>
            </div>
        </div>

        @* Possible Causes *@
        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Possible Causes</h2>
            <ul class="mt-3 space-y-2 text-muted-foreground text-xs">
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">•</span>
                    <span>Network connection was lost or became unstable</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">•</span>
                    <span>Browser tab was closed or refreshed</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">•</span>
                    <span>Computer went to sleep or lost power</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">•</span>
                    <span>File size exceeded temporary limits</span>
                </li>
            </ul>
        </div>

        @* Actions *@
        <div class="px-4 py-4">
            <div class="flex flex-wrap gap-2">
                <ButtonCn OnClick="HandleResume" Disabled="@_isResuming" Class="h-8 gap-2">
                    <LucideIconCn Name="play" Size="14" Class="size-3.5" />
                    @(_isResuming ? "Resuming..." : "Resume Upload")
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-8 gap-2">
                    <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                    Start Over
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-8 gap-2">
                    <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    Cancel
                </ButtonCn>
            </div>
            <p class="mt-3 text-muted-foreground text-xs">
                Your progress is saved. Resume will continue from 63% completion.
            </p>
        </div>

    </div>
</section>

@code {
    private int _progress = 63;
    private bool _isResuming = false;

    private async Task HandleResume()
    {
        _isResuming = true;
        await Task.Delay(2000);
        _isResuming = false;
    }
}
