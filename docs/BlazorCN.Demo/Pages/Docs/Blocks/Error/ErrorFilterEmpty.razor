@* ============================================================
   Block: error-filter-empty
   Title: ErrorFilterEmpty
   Description: Error page shown when applied filters return no matching items with active filter display and quick reset options
   Source: original/blocks/error/error-filter-empty.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted/50">
                    <LucideIconCn Name="filter" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">No Items Match Your Filters</h1>
                    <p class="text-xs text-muted-foreground">Try adjusting your filter criteria</p>
                </div>
            </div>
        </div>

        @* Filter Count *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">Active filters</span>
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                    @_activeFilters.Length
                </BadgeCn>
            </div>
        </div>

        @* Active Filters *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <span class="text-xs font-medium">Current Filters</span>
                <div class="space-y-1.5">
                    @foreach (var filter in _activeFilters)
                    {
                        <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                            <div class="min-w-0 flex-1">
                                <span class="text-xs text-muted-foreground">@filter.Label</span>
                                <p class="mt-0.5 text-sm text-foreground">@filter.Value</p>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 shrink-0 p-0">
                                <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                                <span class="sr-only">Remove @filter.Label filter</span>
                            </ButtonCn>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Suggestions *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <span class="text-xs font-medium">Suggestions</span>
                <ul class="space-y-1 pl-4 text-sm text-muted-foreground">
                    <li class="list-disc">Remove one or more filters to see more results</li>
                    <li class="list-disc">Try broadening your date range</li>
                    <li class="list-disc">Select different categories or tags</li>
                    <li class="list-disc">Clear all filters and start over</li>
                </ul>
            </div>
        </div>

        @* Info Notice *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs text-muted-foreground">
                    <span class="font-medium text-foreground">Tip:</span> The "Updated: Last 7 days"
                    filter is most restrictive. Try removing it first for better results.
                </p>
            </div>
        </div>

        @* Actions *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Class="flex-1 gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                    Clear All Filters
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Go Back
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record ActiveFilter(string Id, string Label, string Value);

    private static readonly ActiveFilter[] _activeFilters =
    [
        new("1", "Category", "Components"),
        new("2", "Framework", "React 19"),
        new("3", "Price", "Free"),
        new("4", "Updated", "Last 7 days"),
    ];
}
