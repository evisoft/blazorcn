@* ============================================================
   Block: error-dns-resolution
   Title: ErrorDnsResolution
   Description: Network error page for DNS lookup failures with troubleshooting steps
   Source: original/blocks/error/error-dns-resolution.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="globe" Size="20" Class="size-5 text-amber-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Can't Reach This Site</h1>
                    <p class="mt-0.5 text-xs text-muted-foreground">DNS resolution failed</p>
                </div>
            </div>
        </div>

        @* Error Message *@
        <div class="border-b px-4 py-6 text-center">
            <LucideIconCn Name="alert-circle" Size="48" Class="mx-auto size-12 text-amber-600" />
            <h2 class="mt-4 text-sm font-medium">This site can't be reached</h2>
            <p class="mt-2 font-mono text-sm text-muted-foreground">
                example-site-that-doesnt-exist.com
            </p>
            <p class="mt-2 text-xs text-muted-foreground">
                The server's DNS address could not be found
            </p>
        </div>

        @* Diagnostic *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Quick diagnostic</h2>
            <div class="mt-3 space-y-2">
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="check-circle" Size="16" Class="size-4 text-emerald-600" />
                        <span class="text-xs">Internet connection</span>
                    </div>
                    <span class="text-xs text-muted-foreground">Active</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-600" />
                        <span class="text-xs">DNS lookup</span>
                    </div>
                    <span class="text-xs text-muted-foreground">Failed</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-600" />
                        <span class="text-xs">Server reachability</span>
                    </div>
                    <span class="text-xs text-muted-foreground">Unknown</span>
                </div>
            </div>
        </div>

        @* Possible Causes *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Common causes</h2>
            <div class="mt-3 space-y-2">
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        The website address may contain a typo
                    </p>
                </div>
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        The domain name may have expired or not been registered
                    </p>
                </div>
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        Your DNS server may be experiencing issues
                    </p>
                </div>
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        A firewall or network filter may be blocking access
                    </p>
                </div>
            </div>
        </div>

        @* Troubleshooting Steps *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Try these solutions</h2>
            <div class="mt-3 space-y-2">
                <div class="rounded-md border p-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <p class="text-xs font-medium">Check the URL</p>
                            <p class="mt-1 text-xs text-muted-foreground">
                                Verify the web address is spelled correctly
                            </p>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                            Edit URL
                        </ButtonCn>
                    </div>
                </div>
                <div class="rounded-md border p-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <p class="text-xs font-medium">Try again later</p>
                            <p class="mt-1 text-xs text-muted-foreground">
                                The site may be temporarily unavailable
                            </p>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1 text-xs">
                            <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                            Retry
                        </ButtonCn>
                    </div>
                </div>
                <div class="rounded-md border p-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <p class="text-xs font-medium">Clear DNS cache</p>
                            <p class="mt-1 font-mono text-xs text-muted-foreground">
                                Run: ipconfig /flushdns (Windows)
                            </p>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                            Copy
                        </ButtonCn>
                    </div>
                </div>
                <div class="rounded-md border p-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <p class="text-xs font-medium">Use different DNS</p>
                            <p class="mt-1 text-xs text-muted-foreground">
                                Try Google DNS (8.8.8.8) or Cloudflare (1.1.1.1)
                            </p>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                            Guide
                        </ButtonCn>
                    </div>
                </div>
            </div>
        </div>

        @* Alternative Access *@
        <div class="px-4 py-4">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs font-medium">View cached version</p>
                <p class="mt-1 text-xs text-muted-foreground">
                    If the site is temporarily down, you may be able to view a cached snapshot
                </p>
                <div class="mt-3 flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                        <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                        Google Cache
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                        <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                        Internet Archive
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>
