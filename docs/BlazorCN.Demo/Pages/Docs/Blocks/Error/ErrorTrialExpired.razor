@* ============================================================
   Block: error-trial-expired
   Title: ErrorTrialExpired
   Description: Error page shown when a user's free trial period has ended
   Source: original/blocks/error/error-trial-expired.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border bg-amber-500/10">
                    <LucideIconCn Name="clock" Size="20" Class="size-5 text-amber-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Your Free Trial Has Ended</h1>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Your 14-day trial expired on March 11, 2026. Upgrade to Pro to continue accessing
                        all premium features and keep your data.
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 text-sm font-medium">Your Trial Activity</div>
            <div class="grid grid-cols-3 gap-3">
                @foreach (var stat in _trialStats)
                {
                    <div class="rounded-lg border bg-muted/30 p-3 text-center">
                        <div class="mb-1 font-mono text-xl font-semibold tabular-nums">
                            @stat.Value
                        </div>
                        <div class="text-xs text-muted-foreground">@stat.Label</div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 text-sm font-medium">What You'll Lose</div>
            <ul class="space-y-2">
                @foreach (var feature in _restrictedFeatures)
                {
                    <li class="flex items-start gap-2 text-xs">
                        <span class="mt-1.5 size-1 shrink-0 rounded-full bg-red-500"></span>
                        <span class="text-muted-foreground">@feature</span>
                    </li>
                }
            </ul>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="star" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Choose Your Plan</span>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
                @foreach (var plan in _plans)
                {
                    <div class="rounded-lg border bg-muted/30 p-3">
                        <div class="mb-2 flex items-center justify-between">
                            <span class="text-sm font-medium">@plan.Name</span>
                            @if (plan.Badge != null)
                            {
                                <span class="inline-flex items-center rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-medium text-emerald-600">
                                    @plan.Badge
                                </span>
                            }
                        </div>
                        <div class="flex items-baseline gap-1">
                            <span class="font-mono text-2xl font-semibold tabular-nums">
                                $@plan.Price
                            </span>
                            <span class="text-xs text-muted-foreground">@plan.Period</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="gap-1.5">
                <LucideIconCn Name="credit-card" Size="14" Class="size-3.5" />
                Upgrade to Pro
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="gap-1.5">
                <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                Export Data
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                Contact Sales
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record TrialStat(string Label, string Value);
    private record Plan(string Name, int Price, string Period, string? Badge);

    private static readonly TrialStat[] _trialStats =
    [
        new("Projects Created", "12"),
        new("Team Members", "3"),
        new("API Requests", "8.4K"),
    ];

    private static readonly string[] _restrictedFeatures =
    [
        "Unlimited projects (currently: 3/3 used)",
        "Advanced analytics dashboard",
        "Team collaboration features",
        "Priority email support",
        "API access and webhooks",
    ];

    private static readonly Plan[] _plans =
    [
        new("Monthly", 29, "per month", null),
        new("Annual", 249, "per year", "Save $99"),
    ];
}
