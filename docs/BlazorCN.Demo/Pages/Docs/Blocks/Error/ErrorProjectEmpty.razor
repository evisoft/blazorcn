@* ============================================================
   Block: error-project-empty
   Title: ErrorProjectEmpty
   Description: Empty workspace state with project creation and import options
   Source: original/blocks/error/error-project-empty.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="folder" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="font-medium text-sm">Projects</h2>
            </div>
        </div>

        @* Empty State *@
        <div class="flex flex-col items-center justify-center px-4 py-16 text-center">
            <div class="mb-4 flex size-16 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="folder" Size="32" Class="size-8 text-muted-foreground" />
            </div>
            <h3 class="mb-2 font-semibold text-lg">No projects yet</h3>
            <p class="mb-6 max-w-sm text-muted-foreground text-sm">
                Get started by creating your first project or importing an existing one from a template.
            </p>
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="folder-plus" Size="16" Class="size-4" />
                    Create Project
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="upload" Size="16" Class="size-4" />
                    Import from Template
                </ButtonCn>
            </div>
        </div>

        @* Quick Start Tips *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 font-medium text-sm">Quick start guide:</p>
            <ul class="space-y-1.5 text-muted-foreground text-xs">
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>Create a new project to organize your work</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>Import from templates to get started quickly</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>Invite team members to collaborate</span>
                </li>
            </ul>
        </div>

    </div>
</section>
