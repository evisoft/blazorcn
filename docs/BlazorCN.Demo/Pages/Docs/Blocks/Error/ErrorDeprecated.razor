@* ============================================================
   Block: error-deprecated
   Title: ErrorDeprecated
   Description: Deprecated endpoint or page with redirect information and countdown timer
   Source: original/blocks/error/error-deprecated.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Icon Header *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col items-center gap-4 text-center">
                <div class="flex size-16 items-center justify-center rounded-full bg-amber-500/10">
                    <LucideIconCn Name="triangle-alert" Size="32" Class="size-8 text-amber-600" />
                </div>
                <div>
                    <h1 class="text-2xl font-semibold">Page Deprecated</h1>
                    <p class="mt-2 text-sm text-muted-foreground">
                        This page has been moved to a new location
                    </p>
                </div>
            </div>
        </div>

        @* Error Code *@
        <div class="border-b px-4 py-6">
            <div class="text-center">
                <p class="text-4xl font-semibold tabular-nums text-amber-600">410</p>
                <p class="mt-2 text-xs text-muted-foreground">Gone</p>
            </div>
        </div>

        @* Redirect Notice *@
        <div class="border-b px-4 py-6">
            <div class="rounded-md bg-amber-500/10 p-4">
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="triangle-alert" Size="20" Class="mt-0.5 size-5 shrink-0 text-amber-600" />
                    <div class="flex-1 space-y-1">
                        <p class="text-sm font-medium text-amber-700">Automatic Redirect</p>
                        <p class="text-sm text-amber-700">
                            You will be redirected to the new location in
                            <span class="font-semibold">@_countdown</span> seconds.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @* New Location *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">New Location</p>
                <div class="flex items-center gap-2 rounded-md bg-muted/50 p-3">
                    <code class="flex-1 font-mono text-sm text-muted-foreground">@_newUrl</code>
                    <LucideIconCn Name="arrow-right" Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <p class="text-xs text-muted-foreground">
                    Please update your bookmarks and links to point to the new location.
                </p>
            </div>
        </div>

        @* Deprecation Info *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">Deprecation Details</p>
                <ul class="space-y-2 text-sm text-muted-foreground">
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>
                            <span class="font-medium text-foreground">Deprecated on:</span>
                            @_deprecationDate
                        </span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>
                            <span class="font-medium text-foreground">Reason:</span> Improved structure
                            and functionality
                        </span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>
                            <span class="font-medium text-foreground">Impact:</span> All functionality
                            moved to new location
                        </span>
                    </li>
                </ul>
            </div>
        </div>

        @* Migration Guide *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">Migration Guide</p>
                <div class="space-y-2">
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="mb-1 text-xs font-medium text-muted-foreground">Old Endpoint</p>
                        <code class="font-mono text-sm">/api/v1/users</code>
                    </div>
                    <div class="flex justify-center">
                        <LucideIconCn Name="arrow-right" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="mb-1 text-xs font-medium text-muted-foreground">New Endpoint</p>
                        <code class="font-mono text-sm">/api/v2/users</code>
                    </div>
                </div>
                <p class="text-xs text-muted-foreground">
                    Update all API calls to use the new endpoint. Response format remains compatible.
                </p>
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Class="flex-1" onclick="@HandleRedirectNow">
                    <LucideIconCn Name="arrow-right" Size="16" Class="size-4" />
                    Go to New Location
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1">
                    <LucideIconCn Name="book-open" Size="16" Class="size-4" />
                    View Documentation
                </ButtonCn>
            </div>
        </div>

        @* Alternative Action *@
        <div class="border-b px-4 py-6">
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full">
                <LucideIconCn Name="home" Size="16" Class="size-4" />
                Back to Home
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Questions about this change? Contact our support team
            </p>
        </div>

    </div>
</section>

@code {
    private int _countdown = 10;
    private readonly string _newUrl = "/new-location";
    private readonly string _deprecationDate = "January 1, 2026";

    private void HandleRedirectNow()
    {
        // In a demo context, navigation is a no-op
    }
}
