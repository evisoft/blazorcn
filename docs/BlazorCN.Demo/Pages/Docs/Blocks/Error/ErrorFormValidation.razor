@* ============================================================
   Block: error-form-validation
   Title: ErrorFormValidation
   Description: Form submission error summary showing field errors with icons and actionable fix button
   Source: original/blocks/error/error-form-validation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header: icon + title + error count *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="x-circle" Size="20" Class="size-5 text-red-500" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="font-medium text-sm">Form Validation Failed</h1>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Please fix the errors below and resubmit
                    </p>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="font-semibold tabular-nums text-4xl text-red-500">
                        @_errors.Length
                    </span>
                </div>
            </div>
        </div>

        @* Validation errors list *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-xs text-muted-foreground">VALIDATION ERRORS</span>
                <span class="text-muted-foreground text-xs">@_errors.Length errors found</span>
            </div>
            <div class="mt-3 space-y-0">
                @foreach (var err in _errors)
                {
                    <div class="flex items-start gap-3 border-b px-0 py-3 last:border-b-0">
                        <span class="mt-0.5 size-2 shrink-0 rounded-full bg-red-500"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@err.Field</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@err.Message</p>
                        </div>
                        @if (err.Type == "error")
                        {
                            <LucideIconCn Name="alert-circle" Size="16" Class="mt-0.5 size-4 shrink-0 text-red-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="alert-circle" Size="16" Class="mt-0.5 size-4 shrink-0 text-amber-500" />
                        }
                    </div>
                }
            </div>
        </div>

        @* Valid fields *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">VALID FIELDS</span>
            <div class="mt-3 flex flex-wrap gap-2">
                @foreach (var field in _validFields)
                {
                    <div class="flex items-center gap-1.5 rounded-md bg-emerald-500/10 px-2 py-1">
                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                        <span class="font-medium text-emerald-500 text-xs">@field</span>
                    </div>
                }
            </div>
        </div>

        @* How to fix *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <h2 class="font-medium text-sm">How to fix</h2>
                <p class="mt-1 text-muted-foreground text-xs">
                    Review each error above, correct the highlighted fields in your form, and click submit
                    again. All fields marked with an asterisk (*) are required.
                </p>
            </div>
        </div>

        @* Footer: return button + error count summary *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Return to Form
                </ButtonCn>
                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    <span>@_errors.Length errors must be fixed</span>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record ValidationError(string Field, string Message, string Type);

    private static readonly ValidationError[] _errors =
    [
        new("Email Address",  "Please enter a valid email address",          "error"),
        new("Password",       "Password must be at least 8 characters",      "error"),
        new("Phone Number",   "Phone number format should be (555) 555-5555","error"),
        new("Company Name",   "This field is required",                      "error"),
        new("ZIP Code",       "ZIP code should be 5 digits",                 "error"),
        new("Terms of Service","You must accept the terms to continue",      "error"),
    ];

    private static readonly string[] _validFields =
    [
        "First Name", "Last Name", "Country", "State/Province"
    ];
}
