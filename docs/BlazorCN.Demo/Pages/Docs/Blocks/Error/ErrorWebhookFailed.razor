@* ============================================================
   Block: error-webhook-failed
   Title: ErrorWebhookFailed
   Description: Technical error page for webhook delivery failures with payload inspection and retry options
   Source: original/blocks/error/error-webhook-failed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="webhook" Size="20" Class="size-5 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Webhook Delivery Failed</h1>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Unable to deliver event payload
                    </p>
                </div>
            </div>
        </div>

        @* Error Details *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Delivery details</h2>
            <div class="mt-3 space-y-2">
                <div class="rounded-md bg-red-500/10 px-3 py-2">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-medium text-red-900 dark:text-red-100">HTTP Status</p>
                            <p class="mt-0.5 font-mono text-xs text-red-800/80 dark:text-red-200/70">
                                500 Internal Server Error
                            </p>
                        </div>
                        <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-red-600" />
                    </div>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs font-medium">Webhook URL</p>
                    <p class="mt-0.5 font-mono text-xs text-muted-foreground">
                        https://api.example.com/webhooks/payment
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs font-medium">Event type</p>
                    <p class="mt-0.5 font-mono text-xs text-muted-foreground">payment.succeeded</p>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs font-medium">Timestamp</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">2026-03-25 14:32:18 UTC</p>
                </div>
            </div>
        </div>

        @* Response Body *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <h2 class="text-sm font-medium">Response body</h2>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                    <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                    View headers
                </ButtonCn>
            </div>
            <div class="mt-3 rounded-md bg-zinc-950 p-3 font-mono text-sm text-zinc-100">
                <div class="space-y-1 text-xs">
                    <p class="text-zinc-400">@("{")</p>
                    <p class="pl-4">
                        <span class="text-zinc-500">"error":</span>
                        <span class="text-green-400">"Database connection timeout"</span>,
                    </p>
                    <p class="pl-4">
                        <span class="text-zinc-500">"code":</span>
                        <span class="text-blue-400">"DB_TIMEOUT"</span>,
                    </p>
                    <p class="pl-4">
                        <span class="text-zinc-500">"timestamp":</span>
                        <span class="text-green-400">"2026-03-25T14:32:18.234Z"</span>
                    </p>
                    <p class="text-zinc-400">@("}")</p>
                </div>
            </div>
        </div>

        @* Request Payload *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <h2 class="text-sm font-medium">Request payload</h2>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="HandleCopyPayload">
                    @if (_copiedPayload)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>
            <div class="mt-3 rounded-md bg-zinc-950 p-3 font-mono text-sm text-zinc-100">
                <div class="space-y-1 text-xs">
                    <p class="text-zinc-400">@("{")</p>
                    <p class="pl-4">
                        <span class="text-zinc-500">"event":</span>
                        <span class="text-green-400">"payment.succeeded"</span>,
                    </p>
                    <p class="pl-4">
                        <span class="text-zinc-500">"payment_id":</span>
                        <span class="text-green-400">"pay_abc123"</span>,
                    </p>
                    <p class="pl-4">
                        <span class="text-zinc-500">"amount":</span>
                        <span class="text-blue-400">4999</span>,
                    </p>
                    <p class="pl-4">
                        <span class="text-zinc-500">"currency":</span>
                        <span class="text-green-400">"usd"</span>,
                    </p>
                    <p class="pl-4">
                        <span class="text-zinc-500">"customer_id":</span>
                        <span class="text-green-400">"cus_xyz789"</span>
                    </p>
                    <p class="text-zinc-400">@("}")</p>
                </div>
            </div>
        </div>

        @* Retry Information *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Retry status</h2>
            <div class="mt-3 space-y-2">
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-xs">Retry attempts</span>
                    <span class="font-semibold tabular-nums text-sm">2 of 5</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-xs">Next retry in</span>
                    <span class="font-semibold tabular-nums text-sm">4 minutes</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-xs">Retry schedule</span>
                    <span class="font-mono text-xs text-muted-foreground">1m @("→") 5m @("→") 15m @("→") 1h</span>
                </div>
            </div>
            <ButtonCn Class="mt-3 w-full gap-2" Size="ButtonSize.Sm">
                <LucideIconCn Name="refresh-cw" Size="16" Class="size-4" />
                Retry now
            </ButtonCn>
        </div>

        @* Delivery History *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Delivery history</h2>
            <div class="mt-3 space-y-2">
                <div class="flex items-center justify-between rounded-md border px-3 py-2">
                    <div>
                        <p class="text-xs font-medium">Attempt 2</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">3 minutes ago</p>
                    </div>
                    <div class="text-right">
                        <p class="font-mono text-xs text-red-600">500</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">Failed</p>
                    </div>
                </div>
                <div class="flex items-center justify-between rounded-md border px-3 py-2">
                    <div>
                        <p class="text-xs font-medium">Attempt 1</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">8 minutes ago</p>
                    </div>
                    <div class="text-right">
                        <p class="font-mono text-xs text-red-600">500</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">Failed</p>
                    </div>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="px-4 py-4">
            <div class="space-y-2">
                <ButtonCn Variant="ButtonVariant.Outline" Class="w-full gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="external-link" Size="16" Class="size-4" />
                    View event log
                </ButtonCn>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1" Size="ButtonSize.Sm">
                        Edit webhook
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1" Size="ButtonSize.Sm">
                        Disable retries
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private bool _copiedPayload = false;

    private async Task HandleCopyPayload()
    {
        _copiedPayload = true;
        await Task.Delay(2000);
        _copiedPayload = false;
    }
}
