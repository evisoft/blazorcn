@* ============================================================
   Block: error-cors
   Title: ErrorCors
   Description: Developer-focused CORS error page with code block, fix suggestions, and API documentation link
   Source: original/blocks/error/error-cors.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="triangle-alert" Size="20" Class="size-5 text-amber-500" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="font-medium text-sm">CORS Policy Error</h1>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Cross-Origin Resource Sharing blocked this request
                    </p>
                </div>
            </div>
        </div>

        @* Error Details *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-xs text-muted-foreground">ERROR DETAILS</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="HandleCopy">
                    <LucideIconCn Name="copy" Size="12" Class="size-3" />
                    @(_copied ? "Copied" : "Copy")
                </ButtonCn>
            </div>
            <div class="mt-2 rounded-md bg-zinc-950 p-3">
                <pre class="overflow-x-auto font-mono text-sm text-zinc-300">@_errorCode</pre>
            </div>
        </div>

        @* Fix Suggestions *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">FIX SUGGESTIONS</span>
            <div class="mt-3 space-y-2">
                <div class="rounded-md bg-muted/50 p-3">
                    <h3 class="font-medium text-sm">Add CORS Headers</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Configure your server to include Access-Control-Allow-Origin header with your domain
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 p-3">
                    <h3 class="font-medium text-sm">Use Server Proxy</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Route requests through your backend to avoid browser CORS restrictions
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 p-3">
                    <h3 class="font-medium text-sm">Development Workaround</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Use a CORS proxy like cors-anywhere or browser extensions during local development
                    </p>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    <span>Request blocked by browser security policy</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="book-open" Size="14" Class="size-3.5" />
                    API Documentation
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private bool _copied = false;

    private readonly string _errorCode =
        "Access to fetch at 'https://api.example.com/data'\nfrom origin 'https://app.example.com' has been\nblocked by CORS policy: No 'Access-Control-\nAllow-Origin' header is present on the\nrequested resource.";

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
