@* ============================================================
   Block: error-microservice-down
   Title: ErrorMicroserviceDown
   Description: Technical error page showing specific microservice failures with degraded mode information
   Source: original/blocks/error/error-microservice-down.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="server" Size="20" Class="size-5 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Service Temporarily Unavailable</h1>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Payment processing service is down
                    </p>
                </div>
            </div>
        </div>

        @* Error Code *@
        <div class="border-b px-4 py-6 text-center">
            <div class="flex items-center justify-center gap-3">
                <LucideIconCn Name="triangle-alert" Size="32" Class="size-8 text-red-600" />
                <span class="font-semibold tabular-nums text-4xl text-red-600">503</span>
            </div>
            <p class="mt-3 text-sm text-muted-foreground">
                A critical service is currently unavailable
            </p>
        </div>

        @* Affected Service *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Service details</h2>
            <div class="mt-3 space-y-2">
                <div class="rounded-md bg-red-500/10 px-3 py-2">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-medium text-red-900 dark:text-red-100">
                                Payment Processing Service
                            </p>
                            <p class="mt-0.5 font-mono text-xs text-red-800/80 dark:text-red-200/70">
                                payment-api-v2.internal
                            </p>
                        </div>
                        <span class="size-2 rounded-full bg-red-500"></span>
                    </div>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs font-medium">Outage started</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">18 minutes ago</p>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs font-medium">Estimated recovery</p>
                    <div class="mt-1 flex items-center gap-2">
                        <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                        <p class="text-xs text-muted-foreground">Within 30-45 minutes</p>
                    </div>
                </div>
            </div>
        </div>

        @* Degraded Mode Status *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">System operating in degraded mode</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Some features remain available while we work to restore full service
            </p>
            <div class="mt-3 space-y-2">
                <div class="flex items-center justify-between rounded-md border px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="check-circle" Size="16" Class="size-4 text-emerald-600" />
                        <span class="text-xs">Browse products</span>
                    </div>
                    <span class="text-xs text-muted-foreground">Available</span>
                </div>
                <div class="flex items-center justify-between rounded-md border px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="check-circle" Size="16" Class="size-4 text-emerald-600" />
                        <span class="text-xs">View account</span>
                    </div>
                    <span class="text-xs text-muted-foreground">Available</span>
                </div>
                <div class="flex items-center justify-between rounded-md border px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-600" />
                        <span class="text-xs">Process payments</span>
                    </div>
                    <span class="text-xs text-muted-foreground">Unavailable</span>
                </div>
                <div class="flex items-center justify-between rounded-md border px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-600" />
                        <span class="text-xs">Refund transactions</span>
                    </div>
                    <span class="text-xs text-muted-foreground">Unavailable</span>
                </div>
            </div>
        </div>

        @* Service Dependencies *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Dependent services</h2>
            <div class="mt-3 space-y-2">
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-xs">Stripe Gateway</span>
                    <div class="flex items-center gap-2">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="text-xs text-muted-foreground">Operational</span>
                    </div>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-xs">Authentication Service</span>
                    <div class="flex items-center gap-2">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="text-xs text-muted-foreground">Operational</span>
                    </div>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-xs">Database Primary</span>
                    <div class="flex items-center gap-2">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="text-xs text-muted-foreground">Operational</span>
                    </div>
                </div>
            </div>
        </div>

        @* Updates *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Recent updates</h2>
            <div class="mt-3 space-y-3">
                <div class="rounded-md bg-muted/50 p-3">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <p class="text-xs text-muted-foreground">5 minutes ago</p>
                            <p class="mt-1 text-xs">
                                Engineering team has identified the root cause and is implementing a fix
                            </p>
                        </div>
                    </div>
                </div>
                <div class="rounded-md bg-muted/50 p-3">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <p class="text-xs text-muted-foreground">18 minutes ago</p>
                            <p class="mt-1 text-xs">
                                Payment processing service became unresponsive. Investigating the issue
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Status Page Link *@
        <div class="px-4 py-4">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs font-medium">Stay updated</p>
                <p class="mt-1 text-xs text-muted-foreground">
                    Subscribe to our status page for real-time updates and incident reports
                </p>
                <div class="mt-3 flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                        <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                        View status page
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2 text-xs">
                        Subscribe to updates
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>
