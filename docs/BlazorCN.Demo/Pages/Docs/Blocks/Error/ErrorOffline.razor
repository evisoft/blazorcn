@* ============================================================
   Block: error-offline
   Title: ErrorOffline
   Description: No internet connection error page with connection checker and retry functionality
   Source: original/blocks/error/error-offline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Icon Header *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col items-center gap-4 text-center">
                <div class="flex size-16 items-center justify-center rounded-full bg-red-500/10">
                    <LucideIconCn Name="wifi-off" Size="32" Class="size-8 text-red-600" />
                </div>
                <div>
                    <h1 class="text-2xl font-semibold">No Internet Connection</h1>
                    <p class="mt-2 text-sm text-muted-foreground">
                        Please check your network settings
                    </p>
                </div>
            </div>
        </div>

        @* Connection Status *@
        <div class="border-b px-4 py-6">
            <div class="flex items-center justify-center gap-3">
                <span class="@($"size-2 rounded-full {(_isOnline ? "bg-emerald-500" : "bg-red-500")}")"></span>
                <span class="text-sm font-medium">
                    Status:&nbsp;
                    <span class="@(_isOnline ? "text-emerald-600" : "text-red-600")">
                        @(_isOnline ? "Connected" : "Offline")
                    </span>
                </span>
            </div>
        </div>

        @* Message *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3 text-center">
                <p class="text-sm text-muted-foreground">
                    Unable to connect to the internet. Your device appears to be offline.
                </p>
                @if (!_isOnline)
                {
                    <div class="rounded-md bg-red-500/10 p-3">
                        <p class="text-sm text-red-600">
                            Check your WiFi or cellular connection and try again.
                        </p>
                    </div>
                }
                @if (_isOnline)
                {
                    <div class="rounded-md bg-emerald-500/10 p-3">
                        <p class="text-sm text-emerald-600">
                            Connection restored! You can now continue.
                        </p>
                    </div>
                }
            </div>
        </div>

        @* Troubleshooting *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">Troubleshooting Steps</p>
                <ul class="space-y-2 text-sm text-muted-foreground">
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Check if WiFi or mobile data is enabled</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Try turning airplane mode off and on</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Restart your router or modem</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Move closer to your WiFi router</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Check if other devices can connect</span>
                    </li>
                </ul>
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn OnClick="HandleCheckConnection" Disabled="@_isChecking" Class="flex-1">
                    <LucideIconCn Name="refresh-ccw" Size="16" Class="size-4" />
                    @(_isChecking ? "Checking..." : "Check Connection")
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1" Disabled="@(!_isOnline)">
                    <LucideIconCn Name="home" Size="16" Class="size-4" />
                    Back to Home
                </ButtonCn>
            </div>
        </div>

        @* Offline Mode Info *@
        <div class="border-b px-4 py-6">
            <div class="rounded-md bg-muted/50 p-4">
                <p class="text-sm font-medium">Offline Mode</p>
                <p class="mt-2 text-sm text-muted-foreground">
                    Some features may be available offline. Any changes you make will be synced when your
                    connection is restored.
                </p>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Connection issues? Contact your network administrator or ISP
            </p>
        </div>

    </div>
</section>

@code {
    private bool _isOnline = true;
    private bool _isChecking = false;

    private async Task HandleCheckConnection()
    {
        _isChecking = true;
        await Task.Delay(1000);
        _isChecking = false;
    }
}
