@* ============================================================
   Block: error-deploy-rollback
   Title: ErrorDeployRollback
   Description: Deployment rollback notification with incident details
   Source: original/blocks/error/error-deploy-rollback.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                <h2 class="font-medium text-sm">Deployment Rolled Back</h2>
            </div>
        </div>

        @* Rollback Summary *@
        <div class="border-b px-4 py-3">
            <div class="flex gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="arrow-left" Size="20" Class="size-5 text-amber-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h3 class="mb-1 font-semibold text-sm">Deployment Automatically Rolled Back</h3>
                    <p class="text-muted-foreground text-sm">
                        Your deployment was automatically rolled back to the previous stable version due to
                        @_rollback.Reason.ToLower(). The application is now running normally.
                    </p>
                    <div class="mt-2 flex items-center gap-3 text-xs">
                        <span class="text-muted-foreground">
                            Deployment: <span class="font-mono text-foreground">@_rollback.DeploymentId</span>
                        </span>
                        <span class="text-muted-foreground">@_rollback.Timestamp</span>
                    </div>
                </div>
            </div>
        </div>

        @* Rollback Details *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 font-medium text-sm">Rollback details:</p>
            <div class="space-y-2 text-xs">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground">Attempted version:</span>
                    <span class="font-mono text-foreground">@_rollback.PreviousVersion</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground">Current version:</span>
                    <span class="font-mono text-emerald-600">@_rollback.RolledBackTo</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground">Rollback reason:</span>
                    <span class="text-foreground">@_rollback.Reason</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground">Rollback duration:</span>
                    <span class="text-foreground">@_rollback.Duration</span>
                </div>
            </div>
        </div>

        @* Health Status *@
        <div class="border-b bg-emerald-500/5 px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="activity" Size="16" Class="size-4 text-emerald-600" />
                <p class="font-medium text-sm">Current system health</p>
            </div>
            <div class="grid grid-cols-2 gap-3">
                @foreach (var metric in _healthMetrics)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground text-xs">@metric.Label</span>
                        <div class="flex items-center gap-1.5">
                            <span class="font-medium text-foreground text-xs">@metric.Value</span>
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="file-text" Size="16" Class="size-4" />
                    View Deploy Logs
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="activity" Size="16" Class="size-4" />
                    View Metrics
                </ButtonCn>
            </div>
        </div>

        @* Next Steps *@
        <div class="px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-amber-600" />
                <p class="font-medium text-sm">What happened?</p>
            </div>
            <ul class="space-y-1.5 text-muted-foreground text-xs">
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>The deployment failed health checks and was automatically rolled back</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>
                        Review
                        <button type="button" class="inline-flex items-center gap-0.5 text-foreground underline-offset-2 hover:underline">
                            deployment logs
                            <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                        </button>
                        to identify the root cause
                    </span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>Fix the issues and redeploy when ready</span>
                </li>
            </ul>
        </div>

    </div>
</section>

@code {
    private record RollbackDetails(
        string DeploymentId,
        string PreviousVersion,
        string RolledBackTo,
        string Reason,
        string Timestamp,
        string Duration);

    private record HealthMetric(string Label, string Value, string Status);

    private static readonly RollbackDetails _rollback = new(
        DeploymentId: "dpl_9xk3m2n",
        PreviousVersion: "v2.4.7",
        RolledBackTo: "v2.4.6",
        Reason: "Health check failures",
        Timestamp: "2 minutes ago",
        Duration: "45s");

    private static readonly HealthMetric[] _healthMetrics =
    [
        new("Error rate", "0.12%", "normal"),
        new("Response time", "124ms", "normal"),
        new("CPU usage", "42%", "normal"),
        new("Memory usage", "68%", "normal"),
    ];
}
