@* ============================================================
   Block: error-age-restricted
   Title: ErrorAgeRestricted
   Description: Age verification required page with date of birth input or confirmation button
   Source: original/blocks/error/error-age-restricted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="shield-alert" Size="20" Class="size-5 text-amber-600" />
                </div>
                <div>
                    <p class="text-sm font-medium">Age verification required</p>
                    <p class="text-xs text-muted-foreground">
                        You must be 18 or older to access this content
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-sm text-muted-foreground">
                This page contains age-restricted content. Please verify your age to continue.
            </p>
        </div>

        @if (_verificationMethod == "choose")
        {
            <div class="border-b px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" Class="w-full justify-start gap-2" OnClick="HandleQuickConfirm">
                    <LucideIconCn Name="check" Size="16" Class="size-4" />I am 18 years or older
                </ButtonCn>
            </div>

            <div class="px-4 py-3">
                <button type="button" @onclick="@(() => _verificationMethod = "dob")"
                        class="w-full rounded-lg border border-dashed px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                        <div>
                            <p class="text-sm font-medium">Enter date of birth</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                More accurate verification method
                            </p>
                        </div>
                    </div>
                </button>
            </div>
        }

        @if (_verificationMethod == "dob")
        {
            <div class="px-4 py-3">
                <div class="space-y-3">
                    <label for="month" class="text-xs font-medium text-muted-foreground">
                        Date of birth
                    </label>
                    <div class="grid grid-cols-3 gap-2">
                        <div>
                            <InputCn id="month" type="text" Placeholder="MM" maxlength="2"
                                     @bind-Value="_dobMonth" Class="text-center text-sm" />
                            <p class="mt-1 text-center text-xs text-muted-foreground">Month</p>
                        </div>
                        <div>
                            <InputCn type="text" Placeholder="DD" maxlength="2"
                                     @bind-Value="_dobDay" Class="text-center text-sm" />
                            <p class="mt-1 text-center text-xs text-muted-foreground">Day</p>
                        </div>
                        <div>
                            <InputCn type="text" Placeholder="YYYY" maxlength="4"
                                     @bind-Value="_dobYear" Class="text-center text-sm" />
                            <p class="mt-1 text-center text-xs text-muted-foreground">Year</p>
                        </div>
                    </div>
                    <ButtonCn Class="w-full" OnClick="HandleDobSubmit">
                        Verify and continue
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="w-full"
                              OnClick="@(() => _verificationMethod = "choose")">
                        Back
                    </ButtonCn>
                </div>
            </div>
        }

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                Your age will be verified once per session. We respect your privacy and do not store
                personal information.
            </p>
        </div>

    </div>
</section>

@code {
    private string _verificationMethod = "choose";
    private string _dobMonth = "";
    private string _dobDay = "";
    private string _dobYear = "";

    private void HandleQuickConfirm()
    {
        _verificationMethod = "confirm";
    }

    private void HandleDobSubmit()
    {
        // Verification logic here
    }
}
