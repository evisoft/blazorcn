@* ============================================================
   Block: error-database-connection
   Title: ErrorDatabaseConnection
   Description: Technical error page for database connectivity failures with retry logic
   Source: original/blocks/error/error-database-connection.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="database" Size="20" Class="size-5 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Database Connection Failed</h1>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Unable to connect to data store
                    </p>
                </div>
            </div>
        </div>

        @* Error Code *@
        <div class="border-b px-4 py-6 text-center">
            <div class="flex items-center justify-center gap-3">
                <LucideIconCn Name="alert-triangle" Size="32" Class="size-8 text-red-600" />
                <span class="font-semibold tabular-nums text-4xl text-red-600">503</span>
            </div>
            <p class="mt-3 text-sm text-muted-foreground">
                Database connection could not be established
            </p>
        </div>

        @* Connection Status *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Connection details</h2>
            <div class="mt-3 space-y-2">
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <div>
                        <p class="text-xs font-medium">Status</p>
                        <p class="mt-0.5 text-xs text-red-600">Connection refused</p>
                    </div>
                    <span class="size-2 rounded-full bg-red-500"></span>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs font-medium">Error type</p>
                    <p class="mt-0.5 font-mono text-xs text-muted-foreground">
                        ECONNREFUSED: Connection timeout after 5000ms
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs font-medium">Last successful connection</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">14 minutes ago</p>
                </div>
            </div>
        </div>

        @* Connection Pool Stats *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <h2 class="text-sm font-medium">Connection pool</h2>
                <LucideIconCn Name="activity" Size="16" Class="size-4 text-muted-foreground" />
            </div>
            <div class="mt-3 grid grid-cols-3 gap-2">
                <div class="rounded-md bg-muted/50 px-3 py-2 text-center">
                    <p class="font-semibold tabular-nums text-2xl">0</p>
                    <p class="mt-1 text-xs text-muted-foreground">Active</p>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2 text-center">
                    <p class="font-semibold tabular-nums text-2xl">0</p>
                    <p class="mt-1 text-xs text-muted-foreground">Available</p>
                </div>
                <div class="rounded-md bg-amber-500/10 px-3 py-2 text-center">
                    <p class="font-semibold tabular-nums text-2xl text-amber-600">12</p>
                    <p class="mt-1 text-xs text-amber-800/80 dark:text-amber-200/70">Waiting</p>
                </div>
            </div>
        </div>

        @* Retry Strategy *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Automatic retry</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Using exponential backoff strategy to reconnect
            </p>
            <div class="mt-3 space-y-2">
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-xs">Next retry in</span>
                    <span class="font-semibold tabular-nums text-sm">8s</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-xs">Retry schedule</span>
                    <span class="font-mono text-xs text-muted-foreground">2s @("→") 4s @("→") 8s @("→") 16s</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-xs">Attempts remaining</span>
                    <span class="font-semibold tabular-nums text-sm">2 of 5</span>
                </div>
            </div>
            <ButtonCn Class="mt-3 w-full gap-2" Size="ButtonSize.Sm">
                <LucideIconCn Name="refresh-cw" Size="16" Class="size-4" />
                Retry now
            </ButtonCn>
        </div>

        @* Possible Causes *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Common causes</h2>
            <div class="mt-3 space-y-2">
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">Database server is down or restarting</p>
                </div>
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        Connection pool exhausted due to high load
                    </p>
                </div>
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        Network connectivity issues between services
                    </p>
                </div>
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        Authentication credentials expired or invalid
                    </p>
                </div>
            </div>
        </div>

        @* Status Page Link *@
        <div class="px-4 py-4">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs font-medium">Check system status</p>
                <p class="mt-1 text-xs text-muted-foreground">
                    View real-time status of all services and scheduled maintenance windows
                </p>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="mt-2 h-6 gap-1 px-2 text-xs">
                    <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                    Open status page
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
