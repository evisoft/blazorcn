@* ============================================================
   Block: error-ssl-certificate
   Title: ErrorSslCertificate
   Description: Security warning page for SSL certificate validation failures
   Source: original/blocks/error/error-ssl-certificate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="shield" Size="20" Class="size-5 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Connection Not Private</h1>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        SSL certificate verification failed
                    </p>
                </div>
            </div>
        </div>

        @* Warning Message *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col items-center text-center">
                <div class="flex size-16 items-center justify-center rounded-full bg-red-500/10">
                    <LucideIconCn Name="lock" Size="32" Class="size-8 text-red-600" />
                </div>
                <h2 class="mt-4 text-sm font-medium">Your connection to this site is not secure</h2>
                <p class="mt-2 text-sm text-muted-foreground">
                    Attackers might be trying to steal your information from
                    <span class="font-mono text-xs">api.example.com</span> (for example, passwords,
                    messages, or credit cards).
                </p>
            </div>
        </div>

        @* Error Summary *@
        <div class="border-b px-4 py-4">
            <div class="space-y-2">
                <div class="flex items-center justify-between rounded-md bg-red-500/10 px-3 py-2">
                    <div>
                        <p class="text-xs font-medium text-red-900 dark:text-red-100">
                            Certificate error
                        </p>
                        <p class="mt-0.5 font-mono text-xs text-red-800/80 dark:text-red-200/70">
                            NET::ERR_CERT_AUTHORITY_INVALID
                        </p>
                    </div>
                    <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-red-600" />
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs font-medium">Subject</p>
                    <p class="mt-0.5 font-mono text-xs text-muted-foreground">api.example.com</p>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs font-medium">Issuer</p>
                    <p class="mt-0.5 font-mono text-xs text-muted-foreground">
                        Self-signed certificate
                    </p>
                </div>
            </div>
        </div>

        @* Technical Details (Expandable) *@
        <div class="border-b">
            <button type="button"
                    @onclick="@(() => _showDetails = !_showDetails)"
                    class="flex w-full items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <span class="text-sm font-medium">Technical details</span>
                <LucideIconCn Name="chevron-down" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground transition-transform duration-200", _showDetails ? "rotate-180" : "")" />
            </button>
            @if (_showDetails)
            {
                <div class="border-t px-4 py-4">
                    <div class="space-y-3">
                        <div>
                            <p class="text-xs font-medium text-muted-foreground">Certificate chain</p>
                            <div class="mt-2 rounded-md bg-zinc-950 p-3 font-mono text-sm text-zinc-100">
                                <div class="space-y-1 text-xs">
                                    <p class="text-zinc-400">Subject: CN=api.example.com</p>
                                    <p class="text-zinc-400">Issuer: CN=api.example.com</p>
                                    <p class="text-zinc-400">Valid from: Jan 15 2026</p>
                                    <p class="text-red-400">Valid to: Dec 31 2025 (expired)</p>
                                    <p class="text-zinc-400">Serial: 00:A1:B2:C3:D4:E5</p>
                                </div>
                            </div>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-muted-foreground">Error details</p>
                            <p class="mt-2 text-xs text-muted-foreground">
                                The server presented a certificate that was not issued by a trusted certificate
                                authority. This could indicate a man-in-the-middle attack or a misconfigured
                                server.
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Actions *@
        <div class="border-b px-4 py-4">
            <div class="space-y-2">
                <ButtonCn Class="w-full gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="arrow-left" Size="16" Class="size-4" />
                    Return to safety
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="w-full" Size="ButtonSize.Sm">
                    Try different network
                </ButtonCn>
            </div>
        </div>

        @* Advanced Option *@
        <div class="px-4 py-4">
            <div class="rounded-md bg-amber-500/10 p-3">
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="alert-triangle" Size="16" Class="mt-0.5 size-4 shrink-0 text-amber-600" />
                    <div class="min-w-0 flex-1">
                        <p class="text-xs font-medium text-amber-900 dark:text-amber-100">
                            Advanced users only
                        </p>
                        <p class="mt-1 text-xs text-amber-800/80 dark:text-amber-200/70">
                            If you understand the risks and trust this site, you can proceed anyway. This is
                            not recommended for sites handling sensitive data.
                        </p>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                  Class="mt-2 h-6 px-2 text-xs text-amber-900 hover:bg-amber-500/20 hover:text-amber-900 dark:text-amber-100 dark:hover:text-amber-100">
                            Proceed anyway (unsafe)
                        </ButtonCn>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private bool _showDetails = false;
}
