@* ============================================================
   Block: error-token-invalid
   Title: ErrorTokenInvalid
   Description: Security error page for invalid or malformed authentication tokens
   Source: original/blocks/error/error-token-invalid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="shield" Size="20" Class="size-5 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Invalid Authentication Token</h1>
                    <p class="mt-0.5 text-xs text-muted-foreground">Security validation failed</p>
                </div>
            </div>
        </div>

        @* Error Code *@
        <div class="border-b px-4 py-6 text-center">
            <div class="flex items-center justify-center gap-3">
                <LucideIconCn Name="triangle-alert" Size="32" Class="size-8 text-red-600" />
                <span class="font-semibold tabular-nums text-4xl text-red-600">401</span>
            </div>
            <p class="mt-3 text-sm text-muted-foreground">
                The authentication token provided is invalid or malformed
            </p>
        </div>

        @* Explanation *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">What happened?</h2>
            <p class="mt-2 text-sm text-muted-foreground">
                The security token in your request could not be validated. This may occur if the token
                was manually modified, corrupted during transmission, or is not properly formatted.
            </p>
            <div class="mt-4 space-y-2">
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        Token format doesn't match expected structure
                    </p>
                </div>
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        Authentication data may have been tampered with
                    </p>
                </div>
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        URL parameters contain invalid characters
                    </p>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Next steps</h2>
            <div class="mt-3 flex flex-col gap-2 sm:flex-row">
                <ButtonCn Class="flex-1 gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="arrow-left" Size="16" Class="size-4" />
                    Sign in again
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1" Size="ButtonSize.Sm">
                    Return to home
                </ButtonCn>
            </div>
        </div>

        @* Security Report *@
        <div class="px-4 py-4">
            <div class="rounded-md bg-amber-500/10 p-3">
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="triangle-alert" Size="16" Class="mt-0.5 size-4 shrink-0 text-amber-600" />
                    <div class="min-w-0 flex-1">
                        <p class="text-xs font-medium text-amber-900 dark:text-amber-100">
                            Suspicious activity?
                        </p>
                        <p class="mt-1 text-xs text-amber-800/80 dark:text-amber-200/70">
                            If you didn't attempt to access this page or believe your account may be
                            compromised, report this immediately.
                        </p>
                        <ButtonCn
                            Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.Sm"
                            Class="mt-2 h-7 gap-1.5 px-2 text-xs text-amber-900 hover:bg-amber-500/20 hover:text-amber-900 dark:text-amber-100 dark:hover:text-amber-100">
                            <LucideIconCn Name="mail" Size="12" Class="size-3" />
                            Report to security
                        </ButtonCn>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

