@* ============================================================
   Block: error-captcha-failed
   Title: ErrorCaptchaFailed
   Description: Error page shown when CAPTCHA verification fails, prompting users to retry human verification
   Source: original/blocks/error/error-captcha-failed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="bot" Size="20" Class="size-5 text-amber-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Verification Failed</h1>
                    <p class="text-xs text-muted-foreground">Please verify you're human</p>
                </div>
            </div>
        </div>

        @* Error Details *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="alert-circle" Size="14" Class="size-3.5 text-amber-600" />
                    <span class="text-xs font-medium">What Happened?</span>
                </div>
                <p class="text-sm text-muted-foreground">
                    The CAPTCHA verification was not completed successfully. This security check helps
                    protect our service from automated access.
                </p>
            </div>
        </div>

        @* Why This Happens *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <span class="text-xs font-medium">Common Causes</span>
                <ul class="space-y-1.5 pl-4 text-sm text-muted-foreground">
                    <li class="list-disc">CAPTCHA expired before submission</li>
                    <li class="list-disc">Browser security settings blocking verification</li>
                    <li class="list-disc">Network connection interrupted</li>
                    <li class="list-disc">Multiple failed verification attempts</li>
                </ul>
            </div>
        </div>

        @* Tips *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-2 rounded-md bg-muted/50 p-3">
                <LucideIconCn Name="help-circle" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-blue-600" />
                <div class="min-w-0 flex-1 space-y-1">
                    <p class="text-xs font-medium">Tips for Success</p>
                    <p class="text-xs text-muted-foreground">
                        Make sure JavaScript is enabled and complete the verification within 2 minutes.
                        Disable browser extensions that may interfere.
                    </p>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Class="flex-1 gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                    Try Again
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="help-circle" Size="14" Class="size-3.5" />
                    Get Help
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Cancel
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
