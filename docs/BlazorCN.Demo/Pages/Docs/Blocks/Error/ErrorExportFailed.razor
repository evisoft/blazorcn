@* ============================================================
   Block: error-export-failed
   Title: ErrorExportFailed
   Description: Error page for data export failures with partial download options and retry mechanisms
   Source: original/blocks/error/error-export-failed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="file-down" Size="20" Class="size-5 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Export Failed</h1>
                    <p class="mt-0.5 text-xs text-muted-foreground">Unable to complete data export</p>
                </div>
            </div>
        </div>

        @* Error Details *@
        <div class="border-b px-4 py-6 text-center">
            <LucideIconCn Name="alert-triangle" Size="48" Class="mx-auto size-12 text-red-600" />
            <h2 class="mt-4 text-sm font-medium">Export timed out after 5 minutes</h2>
            <p class="mt-2 text-sm text-muted-foreground">
                The requested dataset was too large to export within the time limit
            </p>
        </div>

        @* Export Details *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Export details</h2>
            <div class="mt-3 space-y-2">
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs font-medium">Export type</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">Customer records (CSV)</p>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs font-medium">Date range</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        January 1, 2024 - March 25, 2026
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs font-medium">Requested records</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">45,892 records</p>
                </div>
            </div>
        </div>

        @* Progress Summary *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Processing summary</h2>
            <div class="mt-3 grid grid-cols-2 gap-2">
                <div class="rounded-md bg-emerald-500/10 px-3 py-2 text-center">
                    <p class="font-semibold tabular-nums text-2xl text-emerald-600">32,450</p>
                    <p class="mt-1 text-xs text-emerald-800/80 dark:text-emerald-200/70">Processed</p>
                </div>
                <div class="rounded-md bg-red-500/10 px-3 py-2 text-center">
                    <p class="font-semibold tabular-nums text-2xl text-red-600">13,442</p>
                    <p class="mt-1 text-xs text-red-800/80 dark:text-red-200/70">Not processed</p>
                </div>
            </div>
            <div class="mt-3 rounded-md bg-muted/50 px-3 py-2">
                <p class="text-xs font-medium">Estimated file size</p>
                <p class="mt-0.5 text-xs text-muted-foreground">142 MB (exceeds 100 MB limit)</p>
            </div>
        </div>

        @* Partial Export Option *@
        <div class="border-b px-4 py-4">
            <div class="rounded-md bg-amber-500/10 p-3">
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="alert-triangle" Size="16" Class="mt-0.5 size-4 shrink-0 text-amber-600" />
                    <div class="min-w-0 flex-1">
                        <p class="text-xs font-medium text-amber-900 dark:text-amber-100">
                            Partial export available
                        </p>
                        <p class="mt-1 text-xs text-amber-800/80 dark:text-amber-200/70">
                            We successfully exported 32,450 records before the timeout. You can download this
                            partial file and retry for the remaining data.
                        </p>
                        <ButtonCn Size="ButtonSize.Sm" Class="mt-2 h-7 gap-1.5 bg-amber-600 px-2 text-xs hover:bg-amber-700">
                            <LucideIconCn Name="download" Size="12" Class="size-3" />
                            Download partial export (102 MB)
                        </ButtonCn>
                    </div>
                </div>
            </div>
        </div>

        @* Solutions *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">Recommended solutions</h2>
            <div class="mt-3 space-y-2">
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        Split export into smaller date ranges (e.g., quarterly)
                    </p>
                </div>
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        Reduce columns by selecting only required fields
                    </p>
                </div>
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        Use background export with email delivery for large datasets
                    </p>
                </div>
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/60"></span>
                    <p class="text-xs text-muted-foreground">
                        Try compressed format (ZIP) to reduce file size
                    </p>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-4">
            <h2 class="text-sm font-medium">What would you like to do?</h2>
            <div class="mt-3 space-y-2">
                <ButtonCn Size="ButtonSize.Sm" Class="w-full gap-2">
                    <LucideIconCn Name="refresh-cw" Size="16" Class="size-4" />
                    Retry with smaller date range
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full gap-2">
                    <LucideIconCn Name="mail" Size="16" Class="size-4" />
                    Request background export via email
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full">
                    Modify export settings
                </ButtonCn>
            </div>
        </div>

        @* Help *@
        <div class="px-4 py-4">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs font-medium">Need assistance?</p>
                <p class="mt-1 text-xs text-muted-foreground">
                    Contact support if you continue to experience export issues or need help with large
                    dataset exports
                </p>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="mt-2 h-6 px-2 text-xs">
                    Contact support
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
