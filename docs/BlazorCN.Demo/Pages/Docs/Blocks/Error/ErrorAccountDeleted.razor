@* ============================================================
   Block: error-account-deleted
   Title: ErrorAccountDeleted
   Description: Deleted account notice with recovery window information and create new account option
   Source: original/blocks/error/error-account-deleted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="x-circle" Size="20" Class="size-5 text-red-500" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="font-medium text-sm">Account Deleted</h1>
                    <p class="mt-0.5 text-muted-foreground text-xs">This account no longer exists</p>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="font-semibold tabular-nums text-4xl text-red-500">410</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">ACCOUNT INFORMATION</span>
            <div class="mt-3 space-y-0">
                <div class="flex items-center gap-3 border-b px-0 py-3">
                    <span class="size-2 shrink-0 rounded-full bg-red-500"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Email Address</span>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs">
                            @_deletionDetails.Email
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-3 border-b px-0 py-3">
                    <span class="size-2 shrink-0 rounded-full bg-red-500"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Deletion Date</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @_deletionDetails.DeletedDate
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-3 px-0 py-3">
                    <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Recovery Window Status</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @_deletionDetails.DaysRemaining days remaining
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-amber-500/10 p-3">
                <div class="flex items-start gap-2">
                    <LucideIconCn Name="clock" Size="16" Class="mt-0.5 size-4 shrink-0 text-amber-500" />
                    <div class="min-w-0 flex-1">
                        <h3 class="font-medium text-sm">Recovery window still open</h3>
                        <p class="mt-1 text-muted-foreground text-xs">
                            Your account can be recovered until @_deletionDetails.RecoveryDeadline. After this
                            date, all data will be permanently deleted and cannot be restored.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">YOUR OPTIONS</span>
            <div class="mt-3 space-y-2">
                <div class="rounded-md bg-muted/50 p-3">
                    <h3 class="font-medium text-sm">Recover your account</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Contact support within @_deletionDetails.DaysRemaining days to restore your account
                        and all associated data
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 p-3">
                    <h3 class="font-medium text-sm">Create a new account</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Start fresh with a new account. You can reuse the same email address after the
                        recovery window expires
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <div class="flex items-start gap-2">
                    <LucideIconCn Name="info" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <h3 class="font-medium text-sm">About data retention</h3>
                        <p class="mt-1 text-muted-foreground text-xs">
                            During the recovery window, your data is securely stored but inaccessible. After
                            @_deletionDetails.RecoveryDeadline, all personal data, files, and settings are
                            permanently removed from our systems.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    <span>Recovery window closes @_deletionDetails.RecoveryDeadline</span>
                </div>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="mail" Size="14" Class="size-3.5" />
                        Request Recovery
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="user-plus" Size="14" Class="size-3.5" />
                        Create New Account
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private readonly DeletionDetails _deletionDetails = new DeletionDetails
    {
        Email = "user@example.com",
        DeletedDate = "March 15, 2026",
        RecoveryDeadline = "April 14, 2026",
        DaysRemaining = 20,
    };

    private sealed class DeletionDetails
    {
        public string Email { get; init; } = "";
        public string DeletedDate { get; init; } = "";
        public string RecoveryDeadline { get; init; } = "";
        public int DaysRemaining { get; init; }
    }
}
