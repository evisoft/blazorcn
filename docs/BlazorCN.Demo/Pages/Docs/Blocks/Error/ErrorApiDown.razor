@* ============================================================
   Block: error-api-down
   Title: ErrorApiDown
   Description: Service status page showing multiple API service indicators, status page link, and subscription option for updates
   Source: original/blocks/error/error-api-down.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="cloud-off" Size="20" Class="size-5 text-red-500" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="font-medium text-sm">Service Unavailable</h1>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Some services are experiencing issues
                    </p>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="font-semibold tabular-nums text-4xl text-red-500">503</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">SERVICE STATUS</span>
            <div class="mt-3 space-y-0">
                @foreach (var svc in _services)
                {
                    <div class="flex items-center gap-3 border-b px-0 py-3 last:border-b-0">
                        <span class="@($"size-2 shrink-0 rounded-full {GetStatusColor(svc.Status)}")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@svc.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@svc.Message</p>
                        </div>
                        <span class="shrink-0 font-medium text-muted-foreground text-xs capitalize">
                            @svc.Status
                        </span>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <h2 class="font-medium text-sm">What's happening?</h2>
                <p class="mt-1 text-muted-foreground text-xs">
                    Our team is aware of the issue and working on a fix. Please check our status page for
                    real-time updates and estimated resolution time.
                </p>
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    <span>Last updated: 3 minutes ago</span>
                </div>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="bell" Size="14" Class="size-3.5" />
                        Subscribe to Updates
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="external-link" Size="14" Class="size-3.5" />
                        Status Page
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record ServiceStatus(string Name, string Status, string Message);

    private static readonly ServiceStatus[] _services =
    [
        new("Authentication API", "operational", "All systems operational"),
        new("Core API",           "down",        "Experiencing outage"),
        new("Payment Processing", "degraded",    "Slower than normal"),
        new("Database Cluster",   "down",        "Connection timeout"),
        new("File Storage",       "operational", "All systems operational"),
    ];

    private static string GetStatusColor(string status) => status switch
    {
        "operational" => "bg-emerald-500",
        "degraded"    => "bg-amber-500",
        "down"        => "bg-red-500",
        _             => "bg-muted-foreground",
    };
}
