@* ============================================================
   Block: error-read-only
   Title: ErrorReadOnly
   Description: Error page shown when a resource is in read-only mode
   Source: original/blocks/error/error-read-only.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border bg-blue-500/10">
                    <LucideIconCn Name="eye" Size="20" Class="size-5 text-blue-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">This Resource is Read-Only</h1>
                    <p class="mt-1 text-xs text-muted-foreground">
                        You can view this content but cannot make changes. Request edit access from the
                        owner to modify this resource.
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 text-sm font-medium">Resource Details</div>
            <div class="space-y-2 rounded-lg border bg-muted/30 p-3">
                <div class="flex items-start justify-between">
                    <div>
                        <div class="text-sm font-medium">@_resourceInfo.Name</div>
                        <div class="mt-0.5 text-xs text-muted-foreground">
                            Last updated @_resourceInfo.LastUpdated
                        </div>
                    </div>
                    <span class="inline-flex items-center gap-1 rounded-full bg-blue-500/10 px-2 py-0.5 text-xs font-medium text-blue-600">
                        <LucideIconCn Name="eye" Size="12" Class="size-3" />
                        View Only
                    </span>
                </div>
                <div class="flex items-center gap-2 border-t pt-2">
                    <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">
                        Owned by <span class="font-medium text-foreground">@_resourceInfo.Owner</span>
                    </span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="lock" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Your Permissions</span>
            </div>
            <div class="space-y-0 overflow-hidden rounded-lg border">
                @foreach (var perm in _permissions)
                {
                    var isLast = perm == _permissions[^1];
                    <div class="@Cn.Merge("flex items-center justify-between px-3 py-2", !isLast ? "border-b" : "")">
                        <span class="text-xs text-muted-foreground">@perm.Action</span>
                        @if (perm.Allowed)
                        {
                            <span class="text-xs text-emerald-600">Allowed</span>
                        }
                        else
                        {
                            <span class="text-xs text-muted-foreground">Not allowed</span>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center gap-2">
                <LucideIconCn Name="mail" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Request Edit Access</span>
            </div>
            <p class="mb-3 text-xs text-muted-foreground">
                Send a message to @_resourceInfo.Owner explaining why you need edit access
            </p>
            <TextareaCn Placeholder="@("I'd like to contribute to the Q2 roadmap by adding items for the design team...")" Class="mb-3 min-h-[80px] text-xs" />
            <div class="flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="gap-1.5">
                    <LucideIconCn Name="mail" Size="14" Class="size-3.5" />
                    Send Request
                </ButtonCn>
                <span class="text-xs text-muted-foreground">
                    @_resourceInfo.Owner will be notified via email
                </span>
            </div>
        </div>

        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                Contact Owner
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                View in Read Mode
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private sealed record ResourceInfo(
        string Name,
        string Owner,
        string OwnerEmail,
        string SharedWith,
        string LastUpdated);

    private sealed record Permission(string Action, bool Allowed);

    private static readonly ResourceInfo _resourceInfo = new(
        Name: "Q2 2026 Product Roadmap",
        Owner: "Sarah Chen",
        OwnerEmail: "sarah@company.com",
        SharedWith: "5 people",
        LastUpdated: "2 hours ago");

    private static readonly Permission[] _permissions =
    [
        new("View content", true),
        new("Download document", true),
        new("Leave comments", false),
        new("Edit content", false),
        new("Share with others", false),
        new("Change permissions", false),
    ];
}
