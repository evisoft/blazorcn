@* ============================================================
   Block: error-compact
   Title: ErrorCompact
   Description: Ultra-compact error card for embedding in dashboards and widgets
   Source: original/blocks/error/error-compact.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="space-y-3">

        @* Error variant *@
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex items-start gap-3 px-4 py-3">
                <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-red-500"></span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="font-medium text-sm">Failed to load data</div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                Connection timeout after 30s
                            </p>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2">
                            <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                            <span class="text-xs">Retry</span>
                        </ButtonCn>
                    </div>
                </div>
                <button type="button"
                        class="shrink-0 text-muted-foreground/60 transition-colors hover:text-muted-foreground"
                        aria-label="Dismiss error">
                    <LucideIconCn Name="x" Size="16" Class="size-4" />
                </button>
            </div>
        </div>

        @* Warning variant *@
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex items-start gap-3 px-4 py-3">
                <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-amber-500"></span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="font-medium text-sm">Partial data loaded</div>
                            <p class="mt-0.5 text-muted-foreground text-xs">Some metrics unavailable</p>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2">
                            <LucideIconCn Name="info" Size="12" Class="size-3" />
                            <span class="text-xs">Details</span>
                        </ButtonCn>
                    </div>
                </div>
                <button type="button"
                        class="shrink-0 text-muted-foreground/60 transition-colors hover:text-muted-foreground"
                        aria-label="Dismiss warning">
                    <LucideIconCn Name="x" Size="16" Class="size-4" />
                </button>
            </div>
        </div>

        @* Minimal variant *@
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex items-start gap-3 px-4 py-3">
                <LucideIconCn Name="alert-circle" Size="16" Class="mt-0.5 size-4 shrink-0 text-red-500" />
                <div class="min-w-0 flex-1">
                    <div class="font-medium text-sm">Unable to save changes</div>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Check your connection and try again
                    </p>
                </div>
                <button type="button"
                        class="shrink-0 text-muted-foreground/60 transition-colors hover:text-muted-foreground"
                        aria-label="Dismiss error">
                    <LucideIconCn Name="x" Size="16" Class="size-4" />
                </button>
            </div>
        </div>

        @* Multiple errors stacked *@
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">Recent Errors</span>
                        <span class="rounded-full bg-red-500/10 px-1.5 py-0.5 font-mono text-red-500 text-xs">
                            3
                        </span>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs">
                        Clear all
                    </ButtonCn>
                </div>
            </div>
            <div>
                @foreach (var err in _errors)
                {
                    <div class="@($"flex items-center gap-3 px-4 py-2.5{(err.ShowBorder ? " border-b" : "")}")">
                        <span class="size-1.5 shrink-0 rounded-full bg-red-500"></span>
                        <div class="min-w-0 flex-1">
                            <div class="text-sm">@err.Title</div>
                            <div class="mt-0.5 font-mono text-muted-foreground text-xs">@err.Time</div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record ErrorItem(string Title, string Time, bool ShowBorder);

    private static readonly ErrorItem[] _errors =
    [
        new("API request failed", "2 min ago",  true),
        new("Cache sync error",   "5 min ago",  true),
        new("Webhook timeout",    "12 min ago", false),
    ];
}
