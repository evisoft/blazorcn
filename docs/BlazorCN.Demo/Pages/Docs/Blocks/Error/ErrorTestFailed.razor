@* ============================================================
   Block: error-test-failed
   Title: ErrorTestFailed
   Description: Test suite failure error with results and fix suggestions
   Source: original/blocks/error/error-test-failed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                <h2 class="font-medium text-sm">Test Results</h2>
            </div>
        </div>

        @* Summary *@
        <div class="border-b px-4 py-3">
            <div class="flex gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="bug" Size="20" Class="size-5 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h3 class="mb-1 font-semibold text-sm">@_stats.Failed Tests Failed</h3>
                    <p class="text-muted-foreground text-sm">
                        @_stats.Passed passed, @_stats.Failed failed, @_stats.Total total
                    </p>
                    <div class="mt-2 flex items-center gap-3 text-xs">
                        <span class="flex items-center gap-1">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            <span class="text-muted-foreground">@_stats.Passed passed</span>
                        </span>
                        <span class="flex items-center gap-1">
                            <span class="size-1.5 rounded-full bg-red-500"></span>
                            <span class="text-muted-foreground">@_stats.Failed failed</span>
                        </span>
                        <span class="text-muted-foreground">Duration: @_stats.Duration</span>
                    </div>
                </div>
            </div>
        </div>

        @* Failed Tests *@
        <div class="border-b">
            <div class="px-4 py-3">
                <p class="mb-3 font-medium text-sm">Failed tests:</p>
            </div>
            <div>
                @foreach (var failure in _failures)
                {
                    var idx = Array.IndexOf(_failures, failure);
                    var isExpanded = _expandedTest == idx;
                    <div class="@Cn.Merge("border-t", idx == 0 ? "border-t-0" : "")">
                        <button type="button"
                                @onclick="@(() => ToggleExpanded(idx))"
                                class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                            <span class="mt-1 size-1.5 shrink-0 rounded-full bg-red-500"></span>
                            <div class="min-w-0 flex-1">
                                <p class="font-medium text-sm">@failure.Name</p>
                                <p class="mt-0.5 truncate font-mono text-muted-foreground text-xs">
                                    @failure.File
                                </p>
                            </div>
                            <LucideIconCn Name="chevron-right"
                                          Size="16"
                                          Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </button>
                        @if (isExpanded)
                        {
                            <div class="space-y-3 border-t bg-muted/30 px-4 py-3">
                                <div>
                                    <p class="mb-1 font-medium text-xs">Error:</p>
                                    <div class="rounded-md bg-red-500/5 p-2">
                                        <p class="text-red-600 text-xs">@failure.Error</p>
                                    </div>
                                </div>
                                <div>
                                    <p class="mb-1 font-medium text-xs">Suggested fix:</p>
                                    <div class="rounded-md bg-muted/50 p-2">
                                        <p class="text-muted-foreground text-xs">@failure.Suggestion</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="refresh-cw" Size="16" Class="size-4" />
                    Run Tests Again
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="check-circle" Size="16" Class="size-4" />
                    Run Failed Tests Only
                </ButtonCn>
            </div>
        </div>

        @* Common Fixes *@
        <div class="bg-muted/30 px-4 py-3">
            <p class="mb-2 font-medium text-sm">Common test issues:</p>
            <ul class="space-y-1.5 text-muted-foreground text-xs">
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>Ensure all async operations are properly awaited</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>Verify test data and mocks match expected formats</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>Check component props and state initialization</span>
                </li>
            </ul>
        </div>

    </div>
</section>

@code {
    private record TestFailure(string Name, string File, string Error, string Suggestion);

    private record TestStats(int Passed, int Failed, int Total, string Duration);

    private static readonly TestFailure[] _failures =
    [
        new(
            "should render user profile correctly",
            "src/components/UserProfile.test.tsx:42",
            "Expected element to have text content 'John Doe', but received 'undefined'",
            "Ensure the user prop is passed correctly and contains a name property"
        ),
        new(
            "should handle form submission",
            "src/components/ContactForm.test.tsx:87",
            "Timeout: async callback was not invoked within the 5000ms timeout",
            "Check that the form submit handler is called and resolves"
        ),
        new(
            "should display error message on API failure",
            "src/hooks/useApi.test.ts:134",
            "Expected spy 'showError' to have been called, but it was not",
            "Verify the error handling logic is triggered in the API hook"
        ),
    ];

    private static readonly TestStats _stats = new(47, 3, 50, "12.4s");

    private int? _expandedTest = null;

    private void ToggleExpanded(int index)
    {
        _expandedTest = _expandedTest == index ? null : index;
    }
}
