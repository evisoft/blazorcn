@* ============================================================
   Block: error-config-invalid
   Title: ErrorConfigInvalid
   Description: Invalid configuration error with validation details
   Source: original/blocks/error/error-config-invalid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                <h2 class="font-medium text-sm">Configuration Error</h2>
            </div>
        </div>

        @* Error Summary *@
        <div class="border-b px-4 py-3">
            <div class="flex gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="alert-circle" Size="20" Class="size-5 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h3 class="mb-1 font-semibold text-sm">Invalid Configuration</h3>
                    <p class="text-muted-foreground text-sm">
                        Your configuration file contains @_validationErrors.Length validation errors that
                        must be fixed before proceeding.
                    </p>
                </div>
            </div>
        </div>

        @* Validation Errors *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 font-medium text-sm">Validation errors:</p>
            <div class="space-y-2">
                @foreach (var err in _validationErrors)
                {
                    <div class="rounded-md border border-red-500/20 bg-red-500/5 p-3">
                        <p class="mb-0.5 font-mono text-red-600 text-xs">@err.Field</p>
                        <p class="text-muted-foreground text-xs">@err.Message</p>
                    </div>
                }
            </div>
        </div>

        @* Config Snippet *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center gap-2">
                <LucideIconCn Name="file-code" Size="16" Class="size-4 text-muted-foreground" />
                <p class="font-medium text-sm">config.json</p>
            </div>
            <div class="relative overflow-hidden rounded-md bg-zinc-950 p-3">
                <pre class="overflow-x-auto font-mono text-sm text-zinc-100">@_configExample</pre>
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                <LucideIconCn Name="book-open" Size="16" Class="size-4" />
                View Configuration Docs
            </ButtonCn>
        </div>

        @* Help Section *@
        <div class="bg-muted/30 px-4 py-3">
            <p class="mb-2 font-medium text-sm">Next steps:</p>
            <ul class="space-y-1.5 text-muted-foreground text-xs">
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>Review and fix each validation error listed above</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>
                        Check the
                        <button type="button" class="inline-flex items-center gap-0.5 text-foreground underline-offset-2 hover:underline">
                            configuration schema
                            <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                        </button>
                        for valid values
                    </span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>Restart the application after making changes</span>
                </li>
            </ul>
        </div>

    </div>
</section>

@code {
    private record ValidationError(string Field, string Message);

    private static readonly ValidationError[] _validationErrors =
    [
        new("database.port", "Must be a number between 1 and 65535"),
        new("api.timeout",   "Required field is missing"),
        new("cache.maxSize", "Value exceeds maximum allowed size of 1000MB"),
    ];

    private static readonly string _configExample =
        "{\n" +
        "  \"database\": {\n" +
        "    \"port\": \"invalid\", // Should be a number\n" +
        "    \"host\": \"localhost\"\n" +
        "  },\n" +
        "  \"api\": {\n" +
        "    // \"timeout\": 5000, // Missing required field\n" +
        "    \"retries\": 3\n" +
        "  },\n" +
        "  \"cache\": {\n" +
        "    \"maxSize\": 2000 // Exceeds 1000MB limit\n" +
        "  }\n" +
        "}";
}
