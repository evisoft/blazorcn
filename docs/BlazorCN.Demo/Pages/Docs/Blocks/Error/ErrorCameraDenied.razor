                    <ul class="mt-2 space-y-1.5 text-muted-foreground text-xs">
                        <li class="flex gap-2">
                            <span class="text-muted-foreground/60">1.</span>
                            <span>Open Settings → Privacy → Camera / Microphone</span>
                        </li>
                        <li class="flex gap-2">
                            <span class="text-muted-foreground/60">2.</span>
                            <span>Enable "Allow apps to access your camera"</span>
                        </li>
                        <li class="flex gap-2">
                            <span class="text-muted-foreground/60">3.</span>
                            <span>Enable "Allow desktop apps to access your camera"</span>
                        </li>
                        <li class="flex gap-2">
                            <span class="text-muted-foreground/60">4.</span>
                            <span>Restart the browser</span>
                        </li>
                    </ul>
                </div>
