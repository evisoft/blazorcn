@* ============================================================
   Block: error-session-expired
   Title: ErrorSessionExpired
   Description: Session expired error page with sign in options and remember me functionality
   Source: original/blocks/error/error-session-expired.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Icon Header *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col items-center gap-4 text-center">
                <div class="flex size-16 items-center justify-center rounded-full bg-amber-500/10">
                    <LucideIconCn Name="clock" Size="32" Class="size-8 text-amber-600" />
                </div>
                <div>
                    <h1 class="text-2xl font-semibold">Session Expired</h1>
                    <p class="mt-2 text-sm text-muted-foreground">
                        Your session has ended for security
                    </p>
                </div>
            </div>
        </div>

        @* Error Code *@
        <div class="border-b px-4 py-6">
            <div class="text-center">
                <p class="text-4xl font-semibold tabular-nums text-amber-600">440</p>
                <p class="mt-2 text-xs text-muted-foreground">Login Time-out</p>
            </div>
        </div>

        @* Message *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3 text-center">
                <p class="text-sm text-muted-foreground">
                    For your security, your session has expired due to inactivity. Please sign in again to
                    continue.
                </p>
                <div class="rounded-md bg-amber-500/10 p-3">
                    <p class="text-sm text-amber-700">
                        Sessions expire after @_sessionDuration of inactivity to protect your account.
                    </p>
                </div>
            </div>
        </div>

        @* Session Info *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">Why Did This Happen?</p>
                <ul class="space-y-2 text-sm text-muted-foreground">
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>You were inactive for more than @_sessionDuration</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Your session token expired for security reasons</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>You may have signed in from another device</span>
                    </li>
                </ul>
            </div>
        </div>

        @* Sign In Options *@
        <div class="border-b px-4 py-6">
            <div class="space-y-4">
                <p class="text-sm font-medium">Sign In Again</p>
                <div class="flex items-start gap-3 rounded-md bg-muted/50 p-3">
                    <CheckboxCn Class="mt-0.5" @bind-Value="_rememberMe" />
                    <div class="flex-1 space-y-1">
                        <span class="text-sm font-medium">Remember me</span>
                        <p class="text-xs text-muted-foreground">
                            Stay signed in for 30 days. Only use on trusted devices.
                        </p>
                    </div>
                </div>
                <ButtonCn OnClick="HandleSignIn" Class="w-full">
                    <LucideIconCn Name="log-in" Size="16" Class="size-4" />
                    Sign In Again
                </ButtonCn>
            </div>
        </div>

        @* Security Notice *@
        <div class="border-b px-4 py-6">
            <div class="rounded-md bg-muted/50 p-4">
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="shield" Size="20" Class="mt-0.5 size-5 shrink-0 text-muted-foreground" />
                    <div class="flex-1 space-y-1">
                        <p class="text-sm font-medium">Security Best Practices</p>
                        <ul class="space-y-1 text-sm text-muted-foreground">
                            <li class="flex items-start gap-2">
                                <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground"></span>
                                <span>Never share your login credentials with anyone</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground"></span>
                                <span>Always sign out when using shared computers</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground"></span>
                                <span>Enable two-factor authentication for extra security</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        @* Alternative Action *@
        <div class="border-b px-4 py-6">
            <ButtonCn Variant="ButtonVariant.Outline" Class="w-full">
                <LucideIconCn Name="house" Size="16" Class="size-4" />
                Back to Home
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Having trouble signing in? Contact support for assistance
            </p>
        </div>

    </div>
</section>

@code {
    private bool _rememberMe = false;
    private readonly string _sessionDuration = "30 minutes";

    private void HandleSignIn()
    {
        // Sign in logic would go here
    }
}
