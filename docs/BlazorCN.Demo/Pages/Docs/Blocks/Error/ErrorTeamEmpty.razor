@* ============================================================
   Block: error-team-empty
   Title: ErrorTeamEmpty
   Description: Empty team state with member invitation options
   Source: original/blocks/error/error-team-empty.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="font-medium text-sm">Team Members</h2>
            </div>
        </div>

        @* Empty State *@
        <div class="flex flex-col items-center justify-center px-4 py-16 text-center">
            <div class="mb-4 flex size-16 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="users" Size="32" Class="size-8 text-muted-foreground" />
            </div>
            <h3 class="mb-2 font-semibold text-lg">You're the only one here</h3>
            <p class="mb-6 max-w-sm text-muted-foreground text-sm">
                Invite your team members to collaborate on projects, share resources, and work together
                more effectively.
            </p>
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="mail" Size="16" Class="size-4" />
                    Invite Team Members
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2" @onclick="HandleCopyLink">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="16" Class="size-4" />
                    }
                    else
                    {
                        <LucideIconCn Name="share-2" Size="16" Class="size-4" />
                    }
                    @(_copied ? "Link Copied" : "Share Invite Link")
                </ButtonCn>
            </div>
        </div>

        @* Invite Link Section *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <p class="mb-0.5 font-medium text-sm">Quick invite link</p>
                    <p class="truncate font-mono text-muted-foreground text-xs">
                        https://app.example.com/invite/abc123
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1 px-2" @onclick="HandleCopyLink">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                    }
                    <span class="text-xs">@(_copied ? "Copied" : "Copy")</span>
                </ButtonCn>
            </div>
        </div>

        @* Benefits *@
        <div class="border-t bg-muted/30 px-4 py-3">
            <p class="mb-2 font-medium text-sm">Team collaboration benefits:</p>
            <ul class="space-y-1.5 text-muted-foreground text-xs">
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>Real-time collaboration on projects</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>Shared resources and assets</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                    <span>Centralized team management</span>
                </li>
            </ul>
        </div>

    </div>
</section>

@code {
    private bool _copied = false;

    private void HandleCopyLink()
    {
        _copied = true;
    }
}
