@* ============================================================
   Block: error-dependency-missing
   Title: ErrorDependencyMissing
   Description: Missing package dependency error with installation commands
   Source: original/blocks/error/error-dependency-missing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                <h2 class="font-medium text-sm">Dependency Error</h2>
            </div>
        </div>

        @* Error Message *@
        <div class="border-b px-4 py-3">
            <div class="flex gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="package" Size="20" Class="size-5 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h3 class="mb-1 font-semibold text-sm">Missing Required Package</h3>
                    <p class="mb-2 text-muted-foreground text-sm">
                        The package
                        <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">framer-motion</code>
                        is not installed. Install it to continue.
                    </p>
                    <div class="rounded-md bg-muted/50 p-2">
                        <p class="font-mono text-red-600 text-xs">Error: Cannot find module 'framer-motion'</p>
                    </div>
                </div>
            </div>
        </div>

        @* Installation Commands *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 font-medium text-sm">Install the package:</p>
            <TabsCn DefaultValue="npm" Class="w-full">
                <TabsListCn Class="grid w-full grid-cols-4">
                    <TabsTriggerCn Value="npm">npm</TabsTriggerCn>
                    <TabsTriggerCn Value="yarn">yarn</TabsTriggerCn>
                    <TabsTriggerCn Value="pnpm">pnpm</TabsTriggerCn>
                    <TabsTriggerCn Value="bun">bun</TabsTriggerCn>
                </TabsListCn>
                @foreach (var entry in _commands)
                {
                    var manager = entry.Manager;
                    var command = entry.Command;
                    <TabsContentCn Value="@manager" Class="mt-3">
                        <div class="flex items-center gap-2">
                            <div class="min-w-0 flex-1 overflow-hidden rounded-md bg-zinc-950 p-3">
                                <pre class="overflow-x-auto font-mono text-sm text-zinc-100">@command</pre>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-9 shrink-0 gap-1 px-3" OnClick="@(() => HandleCopy(command, manager))">
                                @if (_copied == manager)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                }
                                <span class="text-xs">@(_copied == manager ? "Copied" : "Copy")</span>
                            </ButtonCn>
                        </div>
                    </TabsContentCn>
                }
            </TabsCn>
        </div>

        @* Package Info *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <p class="mb-0.5 font-medium text-sm">framer-motion</p>
                    <p class="text-muted-foreground text-xs">A production-ready motion library for React</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="shrink-0 gap-2">
                    <LucideIconCn Name="book-open" Size="12" Class="size-3" />
                    <span class="text-xs">Docs</span>
                </ButtonCn>
            </div>
        </div>

        @* Instructions *@
        <div class="px-4 py-3">
            <p class="mb-2 font-medium text-sm">After installation:</p>
            <ol class="space-y-1.5 text-muted-foreground text-xs">
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 font-medium">1.</span>
                    <span>Run the install command in your terminal</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 font-medium">2.</span>
                    <span>Restart your development server</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="mt-0.5 font-medium">3.</span>
                    <span>Refresh your browser to see the changes</span>
                </li>
            </ol>
        </div>

    </div>
</section>

@code {
    private record CommandEntry(string Manager, string Command);

    private string _copied = "";

    private static readonly CommandEntry[] _commands =
    [
        new("npm",  "npm install framer-motion@^11.0.0"),
        new("yarn", "yarn add framer-motion@^11.0.0"),
        new("pnpm", "pnpm add framer-motion@^11.0.0"),
        new("bun",  "bun add framer-motion@^11.0.0"),
    ];

    private async Task HandleCopy(string command, string manager)
    {
        _copied = manager;
        await Task.Delay(2000);
        _copied = "";
    }
}
