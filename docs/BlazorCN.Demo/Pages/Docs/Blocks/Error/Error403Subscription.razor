@* ============================================================
   Block: error-403-subscription
   Title: Error403Subscription
   Description: A 403 subscription paywall error page block for React and Next.js with plan comparison and upgrade CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/error/error-403-subscription.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-4 py-12">
            <div class="mb-8 text-center">
                <div class="mb-4 flex items-center justify-center">
                    <div class="flex size-16 items-center justify-center rounded-full bg-muted">
                        <LucideIconCn Name="crown" Size="28" Class="size-7 text-muted-foreground" />
                    </div>
                </div>

                <h1 class="mb-2 font-medium text-xl">Upgrade to access this feature</h1>
                <p class="text-muted-foreground text-sm">
                    This feature is available on our Pro plan. Upgrade now to unlock advanced
                    capabilities.
                </p>
            </div>

            <div class="mb-8 rounded-lg border bg-background p-4">
                <div class="mb-4 flex items-center gap-2">
                    <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Pro Plan includes</span>
                </div>
                <div class="space-y-2.5">
                    @foreach (var feature in _premiumFeatures)
                    {
                        <div class="flex items-start gap-2">
                            <div class="mt-0.5 flex size-4 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600" />
                            </div>
                            <span class="text-sm">@feature</span>
                        </div>
                    }
                </div>
            </div>

            <div class="flex flex-wrap items-center justify-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-2 text-xs">
                    <LucideIconCn Name="crown" Size="14" Class="size-3.5" />
                    Upgrade to Pro
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 gap-2 text-xs">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Go back
                </ButtonCn>
            </div>

            <div class="mt-6 text-center">
                <button type="button" class="text-muted-foreground text-xs transition-colors hover:text-foreground">
                    Compare all plans
                </button>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _premiumFeatures =
    [
        "Advanced analytics and reporting",
        "Priority customer support",
        "Custom integrations",
        "Unlimited team members",
        "Advanced security features",
    ];
}
