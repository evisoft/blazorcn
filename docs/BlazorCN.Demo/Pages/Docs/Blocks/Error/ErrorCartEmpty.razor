@* ============================================================
   Block: error-cart-empty
   Title: ErrorCartEmpty
   Description: Error page displayed when users view an empty shopping cart with suggestions to continue shopping
   Source: original/blocks/error/error-cart-empty.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted/50">
                    <LucideIconCn Name="shopping-cart" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Your Cart Is Empty</h1>
                    <p class="text-xs text-muted-foreground">Add items to get started</p>
                </div>
            </div>
        </div>

        @* Message *@
        <div class="border-b px-4 py-3">
            <p class="text-sm text-muted-foreground">
                Your shopping cart is waiting to be filled. Browse our collection to find products
                you'll love.
            </p>
        </div>

        @* Quick Actions *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <span class="text-xs font-medium">Quick Actions</span>
                <div class="space-y-1.5">
                    <button type="button"
                            class="flex w-full items-center gap-3 rounded-md px-3 py-2 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="heart" Size="16" Class="size-4 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">View Saved Items</p>
                            <p class="text-xs text-muted-foreground">3 items waiting for you</p>
                        </div>
                    </button>
                    <button type="button"
                            class="flex w-full items-center gap-3 rounded-md px-3 py-2 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="star" Size="16" Class="size-4 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">Browse Popular Items</p>
                            <p class="text-xs text-muted-foreground">See what's trending</p>
                        </div>
                    </button>
                </div>
            </div>
        </div>

        @* Suggested Products *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <span class="text-xs font-medium">You Might Like</span>
                <div class="space-y-1">
                    @foreach (var product in _suggestedProducts)
                    {
                        <button type="button"
                                class="flex w-full items-center justify-between rounded-md px-3 py-2 text-left transition-colors hover:bg-muted/50">
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium">@product.Name</p>
                                <div class="mt-0.5 flex items-center gap-2">
                                    <div class="flex items-center gap-1">
                                        <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                                        <span class="text-xs text-muted-foreground">@product.Rating</span>
                                    </div>
                                </div>
                            </div>
                            <span class="shrink-0 text-sm font-medium">$@product.Price</span>
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Info Notice *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs text-muted-foreground">
                    <span class="font-medium text-foreground">Free shipping</span> on orders over $50.
                    Easy returns within 30 days.
                </p>
            </div>
        </div>

        @* Actions *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Class="flex-1 gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="shopping-cart" Size="14" Class="size-3.5" />
                    Continue Shopping
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Go Back
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record SuggestedProduct(string Name, int Price, double Rating);

    private static readonly SuggestedProduct[] _suggestedProducts =
    [
        new("Premium Headphones", 199, 4.8),
        new("Wireless Mouse", 49, 4.6),
        new("Mechanical Keyboard", 129, 4.9),
    ];
}
