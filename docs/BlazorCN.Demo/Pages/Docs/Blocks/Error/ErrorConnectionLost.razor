@* ============================================================
   Block: error-connection-lost
   Title: ErrorConnectionLost
   Description: Real-time connection interrupted error with auto-retry countdown
   Source: original/blocks/error/error-connection-lost.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-6">
            <div class="flex items-start gap-4">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="plug" Size="24" Class="size-6 text-amber-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="font-medium text-sm">Connection Lost</h1>
                    <p class="mt-1 text-muted-foreground text-sm">
                        Real-time connection interrupted. Attempting to reconnect automatically.
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <span class="size-2 rounded-full bg-amber-500"></span>
                    <span class="text-muted-foreground text-xs">Reconnecting...</span>
                </div>
                <span class="tabular-nums text-muted-foreground text-xs">Next attempt in 5s</span>
            </div>
            <div class="mt-3">
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                    <div class="h-full bg-amber-500 w-1/2"></div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Connection Status</h2>
            <div class="mt-3 space-y-2">
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">Retry attempts</span>
                    <span class="tabular-nums text-xs">@_retryCount</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">Last connected</span>
                    <span class="text-xs">2 minutes ago</span>
                </div>
                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                    <span class="text-muted-foreground text-xs">Unsaved changes</span>
                    <span class="text-emerald-600 text-xs">Saved locally</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <h2 class="font-medium text-sm">Troubleshooting Steps</h2>
            <ul class="mt-3 space-y-2 text-muted-foreground text-xs">
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">1.</span>
                    <span>Check your internet connection is stable</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">2.</span>
                    <span>Disable VPN or proxy if enabled</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">3.</span>
                    <span>Check firewall settings allow WebSocket connections</span>
                </li>
                <li class="flex gap-2">
                    <span class="text-muted-foreground/60">4.</span>
                    <span>Try a different network or browser</span>
                </li>
            </ul>
        </div>

        <div class="px-4 py-4">
            <div class="flex flex-wrap gap-2">
                <ButtonCn Class="h-8 gap-2" OnClick="HandleRetry" Disabled="@_isRetrying">
                    <LucideIconCn Name="refresh-cw" Size="14" Class="@($"size-3.5 {(_isRetrying ? "animate-spin" : "")}")" />
                    @(_isRetrying ? "Retrying..." : "Retry Now")
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-8 gap-2">
                    <LucideIconCn Name="wifi-off" Size="14" Class="size-3.5" />
                    Work Offline
                </ButtonCn>
            </div>
            <p class="mt-3 text-muted-foreground text-xs">
                Your changes are saved locally and will sync automatically when connection is restored.
            </p>
        </div>

    </div>
</section>

@code {
    private int _retryCount = 3;
    private bool _isRetrying = false;

    private async Task HandleRetry()
    {
        _isRetrying = true;
        await Task.Delay(2000);
        _isRetrying = false;
        _retryCount++;
    }
}
