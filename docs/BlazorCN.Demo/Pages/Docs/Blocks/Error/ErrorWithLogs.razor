@* ============================================================
   Block: error-with-logs
   Title: ErrorWithLogs
   Description: Error page with expandable debug logs and error reporting
   Source: original/blocks/error/error-with-logs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h1 class="font-medium text-sm">Error Details</h1>
                <span class="rounded-full bg-red-500/10 px-2 py-0.5 font-mono text-red-500 text-xs">
                    Critical
                </span>
            </div>
        </div>

        @* Error Summary *@
        <div class="border-b px-4 py-4">
            <div class="flex items-start gap-3">
                <LucideIconCn Name="alert-circle" Size="20" Class="mt-0.5 size-5 shrink-0 text-red-500" />
                <div class="min-w-0 flex-1">
                    <h2 class="font-medium text-sm">Database connection failed</h2>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Unable to establish connection to the database server after multiple retry attempts.
                    </p>
                </div>
            </div>
        </div>

        @* Error ID *@
        <div class="border-b px-4 py-4">
            <div class="space-y-3">
                <div>
                    <span class="mb-2 block text-xs text-muted-foreground">Error ID</span>
                    <div class="flex items-center justify-between gap-2 rounded-md bg-muted/50 p-3">
                        <code class="font-mono text-sm">@_errorId</code>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2" @onclick="HandleCopyErrorId">
                            @if (_copiedErrorId)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                                <span class="text-xs">Copied</span>
                            }
                            else
                            {
                                <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                <span class="text-xs">Copy</span>
                            }
                        </ButtonCn>
                    </div>
                </div>
                <div>
                    <span class="mb-2 block text-xs text-muted-foreground">Timestamp</span>
                    <div class="rounded-md bg-muted/50 p-3">
                        <code class="font-mono text-sm">@_timestamp</code>
                    </div>
                </div>
            </div>
        </div>

        @* Debug Logs *@
        <div class="border-b">
            <button type="button" @onclick="@(() => _expandedLogs = !_expandedLogs)"
                    class="flex w-full items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <span class="font-medium text-sm">Debug Logs</span>
                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _expandedLogs ? "rotate-90" : "")" />
            </button>
            @if (_expandedLogs)
            {
                <div class="border-t px-4 py-3">
                    <div class="overflow-hidden rounded-md bg-zinc-950 p-3">
                        <div class="space-y-1">
                            @foreach (var entry in _logEntries)
                            {
                                <div class="font-mono text-xs text-zinc-100">
                                    <span class="@GetLevelColor(entry.Level)">[@("{")@entry.Level@("}")]</span>@(" ")@entry.Message
                                </div>
                            }
                        </div>
                    </div>
                    <div class="mt-2 flex gap-2">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                            <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            Copy logs
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                            <LucideIconCn Name="download" Size="12" Class="size-3" />
                            Download
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Actions *@
        <div class="px-4 py-4">
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-2">
                    <LucideIconCn Name="external-link" Size="16" Class="size-4" />
                    Report issue
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="flex-1">
                    Contact support
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private bool _expandedLogs = false;
    private bool _copiedErrorId = false;

    private readonly string _errorId = "ERR-2024-03-25-A7B9C2";
    private readonly string _timestamp = "2024-03-25 14:32:41 UTC";

    private record LogEntry(string Level, string Message);

    private static readonly LogEntry[] _logEntries =
    [
        new("INFO",  "Initiating API request to /api/users/123"),
        new("DEBUG", "Request headers: Content-Type: application/json"),
        new("DEBUG", "Auth token validated successfully"),
        new("ERROR", "Connection timeout after 30000ms"),
        new("ERROR", "Failed to establish connection to database"),
        new("WARN",  "Retry attempt 1 of 3 failed"),
        new("ERROR", "Max retries exceeded. Request aborted."),
    ];

    private async Task HandleCopyErrorId()
    {
        _copiedErrorId = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copiedErrorId = false;
    }

    private static string GetLevelColor(string level) => level switch
    {
        "ERROR" => "text-red-500",
        "WARN"  => "text-amber-500",
        "DEBUG" => "text-blue-500",
        _       => "text-muted-foreground",
    };
}
