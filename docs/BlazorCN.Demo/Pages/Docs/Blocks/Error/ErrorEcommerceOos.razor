@* ============================================================
   Block: error-ecommerce-oos
   Title: ErrorEcommerceOos
   Description: Product unavailable page with email notification signup and similar product recommendations
   Source: original/blocks/error/error-ecommerce-oos.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header — out of stock *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="package-x" Size="20" Class="size-5 text-amber-600" />
                </div>
                <div>
                    <p class="text-sm font-medium">Currently unavailable</p>
                    <p class="text-xs text-muted-foreground">This product is out of stock</p>
                </div>
            </div>
        </div>

        @* Product info *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <img src="https://placehold.co/80x80/e5e7eb/1f2937?text=OOS"
                     alt="Product"
                     class="size-20 shrink-0 rounded-lg border bg-muted/50 object-cover" />
                <div>
                    <p class="text-sm font-medium">Wireless Keyboard Elite</p>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Mechanical switches • RGB backlight
                    </p>
                    <p class="mt-2 text-sm font-medium">$149.99</p>
                </div>
            </div>
        </div>

        @* Notify form / success *@
        <div class="border-b px-4 py-3">
            @if (!_notified)
            {
                <form class="space-y-3" @onsubmit="HandleNotify" @onsubmit:preventDefault="true">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">
                            Get notified when back in stock
                        </span>
                    </div>
                    <div class="flex gap-2">
                        <InputCn type="email"
                                 Placeholder="@("your@email.com")"
                                 @bind-Value="_email"
                                 required="required"
                                 Class="text-sm" />
                        <ButtonCn type="submit" Size="ButtonSize.Sm">
                            Notify me
                        </ButtonCn>
                    </div>
                </form>
            }
            else
            {
                <div class="flex items-center gap-3 py-2">
                    <div class="flex size-9 items-center justify-center rounded-lg bg-emerald-500/10">
                        <LucideIconCn Name="check" Size="20" Class="size-5 text-emerald-600" />
                    </div>
                    <div>
                        <p class="text-sm font-medium">You're on the list</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            We'll email you when this item is back in stock
                        </p>
                    </div>
                </div>
            }
        </div>

        @* Similar products *@
        <div>
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="tag" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">Similar products</span>
                </div>
            </div>
            @foreach (var prod in _similarProducts)
            {
                <a href="@prod.Href"
                   class="flex items-center gap-3 border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <img src="@prod.Image"
                         alt="@prod.Name"
                         class="size-16 shrink-0 rounded-lg border bg-muted/50 object-cover" />
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@prod.Name</p>
                        <p class="mt-1 text-sm text-muted-foreground">@prod.Price</p>
                    </div>
                    <span class="shrink-0 rounded bg-emerald-500/10 px-2 py-1 text-xs font-medium text-emerald-600">
                        In stock
                    </span>
                </a>
            }
        </div>

    </div>
</section>

@code {
    private string _email = "";
    private bool _notified = false;

    private void HandleNotify()
    {
        _notified = true;
    }

    private record Product(string Name, string Price, string Image, string Href, bool InStock);

    private static readonly Product[] _similarProducts =
    [
        new("Wireless Keyboard Pro",    "$129", "https://placehold.co/80x80/e5e7eb/1f2937?text=KB", "/products/keyboard-pro",     true),
        new("Mechanical Keyboard RGB",  "$159", "https://placehold.co/80x80/e5e7eb/1f2937?text=KB", "/products/keyboard-rgb",     true),
        new("Compact Keyboard",         "$99",  "https://placehold.co/80x80/e5e7eb/1f2937?text=KB", "/products/keyboard-compact", true),
    ];
}
