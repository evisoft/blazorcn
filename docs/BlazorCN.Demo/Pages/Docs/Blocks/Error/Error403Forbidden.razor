@* ============================================================
   Block: error-403-forbidden
   Title: Error403Forbidden
   Description: A 403 access denied error page block for React and Next.js with permission messaging and recovery actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/error/error-403-forbidden.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex min-h-[500px] flex-col items-center justify-center px-4 py-16 text-center">
            <div class="mb-6 flex size-16 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="lock" Size="28" Class="size-7 text-muted-foreground" />
            </div>

            <div>
                <h1 class="mb-4 font-semibold tabular-nums text-4xl tracking-tight">403</h1>
                <h2 class="mb-2 font-medium text-lg">Access denied</h2>
                <p class="mb-8 text-muted-foreground text-sm">
                    You don't have permission to access this page. If you believe this is an error,
                    please contact your administrator.
                </p>
            </div>

            <div class="flex flex-wrap items-center justify-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-2 text-xs">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Go back
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 gap-2 text-xs">
                    <LucideIconCn Name="mail" Size="14" Class="size-3.5" />
                    Contact admin
                </ButtonCn>
            </div>

            <div class="mt-8 rounded-md bg-muted/50 px-4 py-3">
                <p class="text-muted-foreground text-xs">
                    Need different access? Contact your team administrator to request permission changes.
                </p>
            </div>
        </div>
    </div>
</section>
