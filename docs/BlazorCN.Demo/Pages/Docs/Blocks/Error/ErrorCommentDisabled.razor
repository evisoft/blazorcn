@* ============================================================
   Block: error-comment-disabled
   Title: ErrorCommentDisabled
   Description: Error page shown when users try to comment on content that has commenting disabled
   Source: original/blocks/error/error-comment-disabled.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted/50">
                    <LucideIconCn Name="message-square-off" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Comments Are Disabled</h1>
                    <p class="text-xs text-muted-foreground">The author has turned off commenting</p>
                </div>
            </div>
        </div>

        @* Explanation *@
        <div class="border-b px-4 py-3">
            <p class="text-sm text-muted-foreground">
                Comments are not available for this content. The creator has chosen to limit
                interactions at this time.
            </p>
        </div>

        @* Alternative Actions *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <span class="text-xs font-medium">Other Ways to Engage</span>
                <div class="space-y-1.5">
                    <button type="button" class="flex w-full items-center gap-3 rounded-md px-3 py-2 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="thumbs-up" Size="16" Class="size-4 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">React to this content</p>
                            <p class="text-xs text-muted-foreground">Show your support with a reaction</p>
                        </div>
                    </button>
                    <button type="button" class="flex w-full items-center gap-3 rounded-md px-3 py-2 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="share-2" Size="16" Class="size-4 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">Share with others</p>
                            <p class="text-xs text-muted-foreground">Spread the word via social media</p>
                        </div>
                    </button>
                    <button type="button" class="flex w-full items-center gap-3 rounded-md px-3 py-2 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="mail" Size="16" Class="size-4 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">Contact the author</p>
                            <p class="text-xs text-muted-foreground">Send a direct message instead</p>
                        </div>
                    </button>
                </div>
            </div>
        </div>

        @* Info Notice *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs text-muted-foreground">
                    Comments may be disabled temporarily or permanently. Check back later to see if
                    they've been re-enabled.
                </p>
            </div>
        </div>

        @* Actions *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Class="flex-1 gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="share-2" Size="14" Class="size-3.5" />
                    Share Content
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Go Back
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
