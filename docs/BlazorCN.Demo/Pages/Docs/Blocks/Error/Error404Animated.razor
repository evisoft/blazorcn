<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex min-h-[500px] flex-col items-center justify-center px-4 py-16 text-center">
            <h1 class="mb-6 font-semibold tabular-nums text-7xl tracking-tight">
                404
            </h1>

            <div>
                <h2 class="mb-2 font-medium text-lg">Page not found</h2>
                <p class="mb-8 text-muted-foreground text-sm">
                    Oops! The page you're looking for seems to have vanished into the void.
                </p>
            </div>

            <div class="flex flex-wrap items-center justify-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-2 text-xs">
                    <LucideIconCn Name="house" Size="14" Class="size-3.5" />
                    Go home
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 gap-2 text-xs">
                    <LucideIconCn Name="refresh-ccw" Size="14" Class="size-3.5" />
                    Try again
                </ButtonCn>
            </div>

            <div class="mt-8 flex items-center gap-1">
                <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
            </div>
        </div>
    </div>
</section>
