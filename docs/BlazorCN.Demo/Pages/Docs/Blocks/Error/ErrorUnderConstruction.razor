@* ============================================================
   Block: error-under-construction
   Title: ErrorUnderConstruction
   Description: Page under construction with completion timeline and notification signup
   Source: original/blocks/error/error-under-construction.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Icon Header *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col items-center gap-4 text-center">
                <div class="flex size-16 items-center justify-center rounded-full bg-amber-500/10">
                    <LucideIconCn Name="construction" Size="32" Class="size-8 text-amber-600" />
                </div>
                <div>
                    <h1 class="text-2xl font-semibold">Under Construction</h1>
                    <p class="mt-2 text-sm text-muted-foreground">We're building something great</p>
                </div>
            </div>
        </div>

        @* Progress *@
        <div class="border-b px-4 py-6">
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium">Overall Progress</span>
                    <span class="text-sm text-muted-foreground">@_completionPercentage%</span>
                </div>
                <ProgressCn Value="@_completionPercentage" Class="h-2" aria-label="Progress" />
                <p class="text-center text-xs text-muted-foreground">
                    Expected completion: @_expectedDate
                </p>
            </div>
        </div>

        @* Message *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3 text-center">
                <p class="text-sm text-muted-foreground">
                    This page is currently being developed. We're working hard to bring you an amazing
                    experience with new features and improvements.
                </p>
                <div class="rounded-md bg-amber-500/10 p-3">
                    <p class="text-sm text-amber-700">
                        Thank you for your patience while we build something special.
                    </p>
                </div>
            </div>
        </div>

        @* Milestones *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">Development Timeline</p>
                <div class="space-y-2">
                    @foreach (var ms in _milestones)
                    {
                        <div class="flex items-center gap-3 rounded-md bg-muted/50 px-4 py-3">
                            <div class="@Cn.Merge("flex size-6 shrink-0 items-center justify-center rounded-full", ms.Completed ? "bg-emerald-500/10" : "bg-muted")">
                                @if (ms.Completed)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-600" />
                                }
                                else
                                {
                                    <span class="size-2 rounded-full bg-muted-foreground"></span>
                                }
                            </div>
                            <div class="flex-1">
                                <p class="text-sm font-medium">@ms.Title</p>
                                <p class="text-xs text-muted-foreground">@ms.Date</p>
                            </div>
                            @if (ms.Completed)
                            {
                                <span class="text-xs text-emerald-600">Complete</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Notify Me *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">Get Notified When We Launch</p>
                @if (!_isSubscribed)
                {
                    <form @onsubmit="HandleNotifyMe" @onsubmit:preventDefault="true" class="flex gap-2">
                        <InputCn type="email" Placeholder="Enter your email" @bind-Value="_email" required="required" Class="flex-1" />
                        <ButtonCn type="submit">
                            <LucideIconCn Name="mail" Size="16" Class="size-4" />
                            Notify Me
                        </ButtonCn>
                    </form>
                }
                else
                {
                    <div class="rounded-md bg-emerald-500/10 p-3">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-600" />
                            <p class="text-sm text-emerald-600">
                                Thanks! We'll notify you when we launch.
                            </p>
                        </div>
                    </div>
                }
                <p class="text-xs text-muted-foreground">
                    We'll send you a single email when this page goes live. No spam, promise.
                </p>
            </div>
        </div>

        @* What's Coming *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">What to Expect</p>
                <ul class="space-y-2 text-sm text-muted-foreground">
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Enhanced user interface and experience</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>New features and functionality</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Improved performance and reliability</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Mobile-optimized responsive design</span>
                    </li>
                </ul>
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-6">
            <ButtonCn Variant="ButtonVariant.Outline" Class="w-full">
                <LucideIconCn Name="home" Size="16" Class="size-4" />
                Back to Home
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Questions? Contact us at support@@example.com
            </p>
        </div>

    </div>
</section>

@code {
    private record Milestone(string Title, string Date, bool Completed);

    private static readonly Milestone[] _milestones =
    [
        new("Design Phase",     "January 2026",  true),
        new("Development Phase","February 2026", true),
        new("Testing Phase",    "March 2026",    false),
        new("Launch",           "April 2026",    false),
    ];

    private readonly string _expectedDate = "April 2026";
    private readonly int _completionPercentage = 65;

    private string _email = "";
    private bool _isSubscribed = false;

    private void HandleNotifyMe()
    {
        if (!string.IsNullOrEmpty(_email))
        {
            _isSubscribed = true;
        }
    }
}
