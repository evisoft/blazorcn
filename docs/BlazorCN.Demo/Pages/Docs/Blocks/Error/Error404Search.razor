@* ============================================================
   Block: error-404-search
   Title: Error404Search
   Description: A 404 error page block for React and Next.js with integrated search input and suggested links built with shadcn/ui and Tailwind CSS
   Source: original/blocks/error/error-404-search.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-4 py-12">
            @* Heading *@
            <div class="mb-8 text-center">
                <h1 class="mb-4 font-semibold tabular-nums text-4xl tracking-tight">404</h1>
                <h2 class="mb-2 font-medium text-lg">Page not found</h2>
                <p class="text-muted-foreground text-sm">
                    Let's help you find what you're looking for. Try searching or browse our suggestions
                    below.
                </p>
            </div>

            @* Search form *@
            <form class="mb-8">
                <label for="search-404" class="sr-only">Search</label>
                <div class="flex gap-2">
                    <div class="relative flex-1">
                        <LucideIconCn Name="search" Size="16" Class="absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted-foreground" />
                        <InputCn Id="search-404" Type="search" Placeholder="Search our site..." Class="pl-9" />
                    </div>
                    <ButtonCn Type="submit" Size="ButtonSize.Sm" Class="h-9 text-xs">Search</ButtonCn>
                </div>
            </form>

            @* Suggestions *@
            <div>
                <h3 class="mb-3 font-medium text-sm">Popular pages</h3>
                <div class="space-y-1">
                    @foreach (var link in _suggestions)
                    {
                        <button type="button"
                                class="flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-sm transition-colors hover:bg-muted/50">
                            <span class="text-sm">@link.Title</span>
                            <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5 text-muted-foreground" />
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SuggestionLink(string Title, string Href);

    private static readonly SuggestionLink[] _suggestions =
    [
        new("Documentation", "/docs"),
        new("Product Features", "/features"),
        new("Pricing", "/pricing"),
        new("Blog", "/blog"),
    ];
}
