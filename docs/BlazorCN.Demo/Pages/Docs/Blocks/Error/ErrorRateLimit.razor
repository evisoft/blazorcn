@* ============================================================
   Block: error-rate-limit
   Title: ErrorRateLimit
   Description: A 429 Too Many Requests error page with usage meter and wait time estimate
   Source: original/blocks/error/error-rate-limit.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Icon Header *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col items-center gap-4 text-center">
                <div class="flex size-16 items-center justify-center rounded-full bg-red-500/10">
                    <LucideIconCn Name="gauge" Size="32" Class="size-8 text-red-600" />
                </div>
                <div>
                    <h1 class="text-2xl font-semibold">Rate Limit Exceeded</h1>
                    <p class="mt-2 text-sm text-muted-foreground">You have made too many requests</p>
                </div>
            </div>
        </div>

        @* Error Code *@
        <div class="border-b px-4 py-6">
            <div class="text-center">
                <p class="text-4xl font-semibold tabular-nums text-red-600">429</p>
                <p class="mt-2 text-xs text-muted-foreground">Too Many Requests</p>
            </div>
        </div>

        @* Usage Meter *@
        <div class="border-b px-4 py-6">
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium">API Usage</span>
                    <span class="text-sm text-muted-foreground">
                        @_requestsUsed.ToString("N0") / @_requestsLimit.ToString("N0") requests
                    </span>
                </div>
                <ProgressCn Value="@_usagePercentage" Class="h-2" aria-label="Progress" />
                <div class="flex items-center gap-2">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    <span class="text-xs text-muted-foreground">Limit reached</span>
                </div>
            </div>
        </div>

        @* Reset Time *@
        <div class="border-b px-4 py-6">
            <div class="rounded-md bg-muted/50 p-4">
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="shield-alert" Size="20" Class="mt-0.5 size-5 shrink-0 text-muted-foreground" />
                    <div class="flex-1 space-y-1">
                        <p class="text-sm font-medium">Rate Limit Will Reset</p>
                        <p class="text-sm text-muted-foreground">
                            Your rate limit will automatically reset in
                            <span class="font-medium text-foreground">@_resetTime</span>. You can then
                            make new requests.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @* Information *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">What You Can Do</p>
                <ul class="space-y-2 text-sm text-muted-foreground">
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Wait for the rate limit to reset automatically</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Upgrade your plan for higher rate limits</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Implement request batching or caching</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Review API documentation for best practices</span>
                    </li>
                </ul>
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Class="flex-1">
                    <LucideIconCn Name="book-open" Size="16" Class="size-4" />
                    API Documentation
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1">
                    <LucideIconCn Name="home" Size="16" Class="size-4" />
                    Back to Home
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Need higher rate limits? Contact sales to upgrade your plan
            </p>
        </div>

    </div>
</section>

@code {
    private const int _requestsUsed = 1000;
    private const int _requestsLimit = 1000;
    private const string _resetTime = "15 minutes";
    private static readonly double _usagePercentage = (_requestsUsed / (double)_requestsLimit) * 100;
}
