@* ============================================================
   Block: error-link-expired
   Title: ErrorLinkExpired
   Description: Generic expired link error for password resets, magic links, or verification links with request new link button
   Source: original/blocks/error/error-link-expired.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="clock" Size="20" Class="size-5 text-amber-500" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="font-medium text-sm">Link Expired</h1>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        This security link is no longer valid
                    </p>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="font-semibold tabular-nums text-4xl text-amber-500">410</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">LINK INFORMATION</span>
            <div class="mt-3 space-y-0">
                <div class="flex items-center gap-3 border-b px-0 py-3">
                    <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Link Type</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@_linkDetails.Type</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 border-b px-0 py-3">
                    <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Requested</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@_linkDetails.RequestedDate</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 border-b px-0 py-3">
                    <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Valid Duration</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@_linkDetails.ExpirationTime</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 px-0 py-3">
                    <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Email Address</span>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs">@_linkDetails.Email</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-amber-500/10 p-3">
                <div class="flex items-start gap-2">
                    <LucideIconCn Name="clock" Size="16" Class="mt-0.5 size-4 shrink-0 text-amber-500" />
                    <div class="min-w-0 flex-1">
                        <h3 class="font-medium text-sm">Security feature</h3>
                        <p class="mt-1 text-muted-foreground text-xs">
                            For your protection, authentication links expire after @_linkDetails.ExpirationTime. This prevents unauthorized access if someone gains
                            access to your email. The link you clicked has already expired or been used.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">HOW TO PROCEED</span>
            <div class="mt-3 space-y-2">
                <div class="rounded-md bg-muted/50 p-3">
                    <h3 class="font-medium text-sm">Request a new link</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Click the button below to request a fresh link. It will be sent to @_linkDetails.Email and will be valid for @_linkDetails.ExpirationTime
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 p-3">
                    <h3 class="font-medium text-sm">Check your email</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Make sure to use the new link immediately. If you don't see the email, check your
                        spam or junk folder
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 p-3">
                    <h3 class="font-medium text-sm">Need help?</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        If you're having trouble receiving or using the link, our support team can assist
                        you
                    </p>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    <span>Valid for @_linkDetails.ExpirationTime after request</span>
                </div>
                <div class="flex gap-2">
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                        Request New Link
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="help-circle" Size="14" Class="size-3.5" />
                        Help Center
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record LinkDetails(string Type, string RequestedDate, string ExpirationTime, string Email);

    private static readonly LinkDetails _linkDetails = new(
        "Password Reset",
        "March 25, 2026 at 2:15 PM",
        "15 minutes",
        "user@example.com"
    );
}
