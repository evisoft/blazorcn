@* ============================================================
   Block: error-timeout
   Title: ErrorTimeout
   Description: A timeout error page with countdown timer and retry functionality
   Source: original/blocks/error/error-timeout.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Icon Header *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col items-center gap-4 text-center">
                <div class="flex size-16 items-center justify-center rounded-full bg-amber-500/10">
                    <LucideIconCn Name="clock" Size="32" Class="size-8 text-amber-600" />
                </div>
                <div>
                    <h1 class="text-2xl font-semibold">Request Timeout</h1>
                    <p class="mt-2 text-sm text-muted-foreground">
                        The server took too long to respond
                    </p>
                </div>
            </div>
        </div>

        @* Error Code *@
        <div class="border-b px-4 py-6">
            <div class="text-center">
                <p class="text-4xl font-semibold tabular-nums text-amber-600">408</p>
                <p class="mt-2 text-xs text-muted-foreground">Request Timeout</p>
            </div>
        </div>

        @* Message *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-center text-sm text-muted-foreground">
                    The request took longer than expected to complete. This could be due to:
                </p>
                <ul class="space-y-2 text-sm text-muted-foreground">
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Heavy server load or processing</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Slow network connection</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Large data processing request</span>
                    </li>
                </ul>
            </div>
        </div>

        @* Countdown Timer *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col items-center gap-3">
                <p class="text-sm text-muted-foreground">You can retry in:</p>
                <div class="flex size-20 items-center justify-center rounded-full bg-muted/50">
                    <span class="text-3xl font-semibold tabular-nums">@_countdown</span>
                </div>
                <p class="text-xs text-muted-foreground">seconds</p>
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn @onclick="HandleRetry" Disabled="@(_countdown > 0 || _isRetrying)" Class="flex-1">
                    <LucideIconCn Name="refresh-ccw" Size="16" Class="size-4" />
                    @(_isRetrying ? "Retrying..." : _countdown > 0 ? $"Retry ({_countdown}s)" : "Retry Now")
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1">
                    <LucideIconCn Name="home" Size="16" Class="size-4" />
                    Back to Home
                </ButtonCn>
            </div>
        </div>

        @* Alternative Actions *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">Alternative Actions</p>
                <div class="flex flex-col gap-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="justify-start">
                        <LucideIconCn Name="refresh-ccw" Size="16" Class="size-4" />
                        Try a different endpoint
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="justify-start">
                        <LucideIconCn Name="mail" Size="16" Class="size-4" />
                        Contact support
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                If this problem persists, please contact our support team
            </p>
        </div>

    </div>
</section>

@code {
    private int _countdown = 30;
    private bool _isRetrying = false;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(async _ =>
        {
            if (_countdown > 0)
            {
                _countdown--;
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                _timer?.Change(System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
            }
        }, null, 1000, 1000);
    }

    private void HandleRetry()
    {
        if (_countdown > 0 || _isRetrying) return;
        _isRetrying = true;
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
