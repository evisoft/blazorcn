                    <h2 class=""font-medium text-sm"">Unable to process your request</h2>
                    <p class=""mt-1 text-muted-foreground text-xs"">
                        An unexpected error occurred. Our support team is here to help you resolve this
                        issue.
                    </p>
                </div>
            </div>
        </div>

        @* Support Options *@
        <div class=""border-b px-4 py-4"">
            <span class=""mb-3 block text-xs text-muted-foreground"">Get help now</span>
            <div class=""grid gap-2"">
                <button type=""button""
                        class=""flex items-start gap-3 rounded-md px-3 py-2.5 text-left transition-colors hover:bg-muted/50"">
                    <LucideIconCn Name=""message-square"" Size=""16"" Class=""mt-0.5 size-4 shrink-0 text-blue-500"" />
                    <div class=""min-w-0 flex-1"">
                        <div class=""font-medium text-sm"">Chat with support</div>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">
                            Get instant help from our support team
                        </p>
                        <div class=""mt-1 flex items-center gap-1.5"">
                            <span class=""size-1.5 rounded-full bg-emerald-500""></span>
                            <span class=""text-muted-foreground text-xs"">Available now</span>
                        </div>
                    </div>
                </button>

                <button type=""button""
                        class=""flex items-start gap-3 rounded-md px-3 py-2.5 text-left transition-colors hover:bg-muted/50"">
                    <LucideIconCn Name=""mail"" Size=""16"" Class=""mt-0.5 size-4 shrink-0 text-amber-500"" />
                    <div class=""min-w-0 flex-1"">
                        <div class=""font-medium text-sm"">Email support</div>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">
                            Send us a detailed message about your issue
                        </p>
                        <div class=""mt-1"">
                            <span class=""text-muted-foreground text-xs"">Response within 24h</span>
                        </div>
                    </div>
                </button>

                <button type=""button""
                        class=""flex items-start gap-3 rounded-md px-3 py-2.5 text-left transition-colors hover:bg-muted/50"">
                    <LucideIconCn Name=""book-open"" Size=""16"" Class=""mt-0.5 size-4 shrink-0 text-muted-foreground"" />
                    <div class=""min-w-0 flex-1"">
                        <div class=""font-medium text-sm"">Browse help center</div>
                        <p class=""mt-0.5 text-muted-foreground text-xs"">
                            Search our knowledge base for solutions
                        </p>
                    </div>
                </button>
            </div>
        </div>

        @* Quick Message *@
        <div class=""border-b px-4 py-4"">
            <span class=""mb-3 block text-xs text-muted-foreground"">Describe your issue</span>
            <TextareaCn Placeholder=""Tell us what happened and what you were trying to do...""
                        Class=""min-h-[100px] resize-none"" />
            <div class=""mt-2 flex items-center justify-between"">
                <span class=""text-xs text-muted-foreground"">
                    Error details will be included automatically
                </span>
                <ButtonCn Size=""ButtonSize.Sm"" Class=""h-7 gap-1 px-3"">
                    <LucideIconCn Name=""send"" Size=""12"" Class=""size-3"" />
                    <span class=""text-xs"">Send</span>
                </ButtonCn>
            </div>
        </div>

        @* FAQ Links *@
        <div class=""px-4 py-4"">
            <span class=""mb-3 block text-xs text-muted-foreground"">Common questions</span>
            <div class=""space-y-2"">
                @foreach (var item in _faqItems)
                {
                    <button type=""button""
                            class=""flex w-full items-center justify-between gap-2 rounded-md px-3 py-2 text-left transition-colors hover:bg-muted/50"">
                        <span class=""text-sm"">@item.Title</span>
                        <LucideIconCn Name=""external-link"" Size=""12"" Class=""size-3 shrink-0 text-muted-foreground/60"" />
                    </button>
                }
            </div>
        </div>

        @* Footer *@
        <div class=""border-t px-4 py-3"">
            <p class=""text-center text-xs text-muted-foreground"">
                Need urgent help? Call us at +1 (555) 123-4567
            </p>
        </div>

    </div>
</section>

@code {
    private record FaqItem(string Title, string Url);

    private static readonly FaqItem[] _faqItems =
    [
        new(""Why did this error occur?"", ""/help/common-errors""),
        new(""How to resolve connection issues"", ""/help/connection-issues""),
        new(""Browser compatibility guide"", ""/help/browser-support""),
    ];
}";
}
