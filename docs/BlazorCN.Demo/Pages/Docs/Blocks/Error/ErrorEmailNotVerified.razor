@* ============================================================
   Block: error-email-not-verified
   Title: ErrorEmailNotVerified
   Description: Error page prompting users to verify their email address before accessing protected features
   Source: original/blocks/error/error-email-not-verified.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="mail" Size="20" Class="size-5 text-amber-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Verify Your Email</h1>
                    <p class="text-xs text-muted-foreground">Please check your inbox to continue</p>
                </div>
            </div>
        </div>

        @* Email Address *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-2">
                <div class="min-w-0 flex-1">
                    <span class="text-xs text-muted-foreground">Verification email sent to</span>
                    <p class="mt-0.5 truncate font-mono text-sm">user@@example.com</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="shrink-0 text-xs">
                    Unverified
                </BadgeCn>
            </div>
        </div>

        @* Instructions *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                <span class="text-xs font-medium">Next Steps</span>
                <ol class="space-y-1.5 pl-4 text-sm text-muted-foreground">
                    <li class="list-decimal">Check your inbox for a verification email</li>
                    <li class="list-decimal">Click the verification link in the email</li>
                    <li class="list-decimal">Return here to access your account</li>
                </ol>
            </div>
        </div>

        @* Help Text *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-2 rounded-md bg-muted/50 p-3">
                <LucideIconCn Name="check-circle-2" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-emerald-600" />
                <div class="min-w-0 flex-1">
                    <p class="text-xs text-muted-foreground">
                        Check your spam folder if you don't see the email within a few minutes
                    </p>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Class="flex-1 gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                    Resend Verification
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="edit-2" Size="14" Class="size-3.5" />
                    Change Email
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="gap-2" Size="ButtonSize.Sm">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Back
                </ButtonCn>
            </div>
        </div>

    </div>
</section>
