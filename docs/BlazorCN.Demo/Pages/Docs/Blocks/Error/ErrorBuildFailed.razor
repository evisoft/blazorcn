@* ============================================================
   Block: error-build-failed
   Title: ErrorBuildFailed
   Description: Build or deployment failure error with logs and fixes
   Source: original/blocks/error/error-build-failed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                <h2 class="font-medium text-sm">Build Failed</h2>
            </div>
        </div>

        @* Error Summary *@
        <div class="border-b px-4 py-3">
            <div class="flex gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-red-500/10">
                    <LucideIconCn Name="alert-circle" Size="20" Class="size-5 text-red-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h3 class="mb-1 font-semibold text-sm">Build Process Failed</h3>
                    <p class="text-muted-foreground text-sm">
                        The build failed due to type errors. Review the error log below and fix the issues
                        before retrying.
                    </p>
                    <div class="mt-2 flex items-center gap-3 text-xs">
                        <span class="text-muted-foreground">
                            Build ID: <span class="font-mono text-foreground">bld_8k2j9x1</span>
                        </span>
                        <span class="text-muted-foreground">
                            Duration: <span class="text-foreground">47s</span>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        @* Error Log *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center gap-2">
                <LucideIconCn Name="terminal" Size="16" Class="size-4 text-muted-foreground" />
                <p class="font-medium text-sm">Build log</p>
            </div>
            <div class="relative max-h-64 overflow-auto rounded-md bg-zinc-950 p-3">
                <pre class="font-mono text-xs text-zinc-100">@_buildLog</pre>
            </div>
        </div>

        @* Common Fixes *@
        <div class="border-b px-4 py-3">
            <p class="mb-3 font-medium text-sm">Common fixes:</p>
            <div class="space-y-2">
                @foreach (var fix in _commonFixes)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="mb-1 font-medium text-sm">@fix.Title</p>
                        <p class="text-muted-foreground text-xs">@fix.Description</p>
                    </div>
                }
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="refresh-cw" Size="16" Class="size-4" />
                    Retry Build
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="terminal" Size="16" Class="size-4" />
                    View Full Logs
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="book-open" Size="16" Class="size-4" />
                    Build Docs
                </ButtonCn>
            </div>
        </div>

        @* Help Section *@
        <div class="bg-muted/30 px-4 py-3">
            <p class="text-muted-foreground text-xs">
                <span class="font-medium">Need help?</span> Check the build documentation or contact
                support if the issue persists. Include the build ID for faster resolution.
            </p>
        </div>

    </div>
</section>

@code {
    private record CommonFix(string Title, string Description);

    private const string _buildLog =
        "[14:32:15] Starting build process...\n" +
        "[14:32:18] Installing dependencies... ✓\n" +
        "[14:32:45] Running type checks...\n" +
        "[14:33:02] × Type error: Property 'name' does not exist on type 'User'\n" +
        "[14:33:02]\n" +
        "[14:33:02]   src/components/UserProfile.tsx:42:18\n" +
        "[14:33:02]\n" +
        "[14:33:02]   40 | function UserProfile({ user }: Props) {\n" +
        "[14:33:02]   41 |   return (\n" +
        "[14:33:02] > 42 |     <h1>{user.name}</h1>\n" +
        "[14:33:02]      |           ^\n" +
        "[14:33:02]   43 |   )\n" +
        "[14:33:02]   44 | }\n" +
        "[14:33:02]\n" +
        "[14:33:02] Build failed with 1 error";

    private static readonly CommonFix[] _commonFixes =
    [
        new("Check TypeScript types",
            "Verify that all types are correctly defined and imported. Run 'npm run typecheck' locally."),
        new("Clear build cache",
            "Delete .next, node_modules, and lock files, then reinstall dependencies."),
        new("Update dependencies",
            "Ensure all packages are up to date and compatible with your Node.js version."),
    ];
}
