@* ============================================================
   Block: error-with-countdown
   Title: ErrorWithCountdown
   Description: Error page with animated countdown timer and redirect cancellation
   Source: original/blocks/error/error-with-countdown.tsx
   ============================================================ *@

@using System.Timers

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h1 class="font-medium text-sm">Session Expired</h1>
                <span class="rounded-full bg-amber-500/10 px-2 py-0.5 font-mono text-amber-500 text-xs">
                    401
                </span>
            </div>
        </div>

        @* Error Message *@
        <div class="border-b px-4 py-4">
            <div class="flex items-start gap-3">
                <LucideIconCn Name="alert-circle" Size="20" Class="mt-0.5 size-5 shrink-0 text-amber-500" />
                <div class="min-w-0 flex-1">
                    <h2 class="font-medium text-sm">Your session has expired</h2>
                    <p class="mt-1 text-muted-foreground text-xs">
                        For security reasons, you've been logged out. Please sign in again to continue.
                    </p>
                </div>
            </div>
        </div>

        @* Countdown *@
        @if (!_isCancelled && _countdown > 0)
        {
            <div class="border-b px-4 py-4">
                <div class="mb-3 flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Auto-redirecting to login</span>
                    <button type="button" @onclick="HandleCancel"
                            class="flex items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground">
                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                        Cancel
                    </button>
                </div>
                <div class="flex items-center gap-4">
                    <div class="flex-1">
                        <div class="h-2 overflow-hidden rounded-full bg-muted">
                            <div class="h-full bg-blue-500 transition-all duration-300"
                                 style="@(FormattableString.Invariant($"width:{_progress}%"))">
                            </div>
                        </div>
                    </div>
                    <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-blue-500/10">
                        <span class="font-semibold text-blue-500 text-xl tabular-nums">
                            @_countdown
                        </span>
                    </div>
                </div>
            </div>
        }

        @* Cancelled Message *@
        @if (_isCancelled)
        {
            <div class="border-b bg-muted/50 px-4 py-3">
                <div class="flex items-center gap-2">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-sm">Auto-redirect cancelled</span>
                </div>
            </div>
        }

        @* Redirect Complete *@
        @if (_countdown == 0 && !_isCancelled)
        {
            <div class="border-b bg-blue-500/10 px-4 py-3">
                <div class="flex items-center gap-2">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    <span class="text-sm">Redirecting now...</span>
                </div>
            </div>
        }

        @* Actions *@
        <div class="px-4 py-4">
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-2">
                    <LucideIconCn Name="arrow-left" Size="16" Class="size-4" />
                    Sign in now
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="flex-1 gap-2">
                    <LucideIconCn Name="house" Size="16" Class="size-4" />
                    Go home
                </ButtonCn>
            </div>
        </div>

        @* Additional Info *@
        <div class="border-t px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Sessions expire after 30 minutes of inactivity
            </p>
        </div>

    </div>
</section>

@code {
    private int _countdown = 10;
    private bool _isCancelled = false;
    private Timer? _timer;

    private double _progress => ((10 - _countdown) / 10.0) * 100;

    protected override void OnInitialized()
    {
        _timer = new Timer(1000);
        _timer.Elapsed += async (_, _) =>
        {
            if (_isCancelled || _countdown <= 0)
            {
                _timer?.Stop();
                return;
            }

            _countdown--;

            if (_countdown <= 0)
            {
                _timer?.Stop();
            }

            await InvokeAsync(StateHasChanged);
        };
        _timer.AutoReset = true;
        _timer.Start();
    }

    private void HandleCancel()
    {
        _isCancelled = true;
        _timer?.Stop();
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }
}
