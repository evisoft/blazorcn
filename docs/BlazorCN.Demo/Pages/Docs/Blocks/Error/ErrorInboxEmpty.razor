@* ============================================================
   Block: error-inbox-empty
   Title: ErrorInboxEmpty
   Description: Empty inbox state with notification setup suggestions
   Source: original/blocks/error/error-inbox-empty.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <h2 class="font-medium text-sm">Notifications</h2>
            </div>
        </div>

        @* Empty State *@
        <div class="flex flex-col items-center justify-center px-4 py-16 text-center">
            <div class="mb-4 flex size-16 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="bell" Size="32" Class="size-8 text-muted-foreground" />
            </div>
            <h3 class="mb-2 font-semibold text-lg">All caught up!</h3>
            <p class="mb-6 max-w-sm text-muted-foreground text-sm">
                You don't have any notifications right now. We'll notify you when something important
                happens.
            </p>
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="bell-ring" Size="16" Class="size-4" />
                    Enable Notifications
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="settings" Size="16" Class="size-4" />
                    Notification Settings
                </ButtonCn>
            </div>
        </div>

        @* Suggestions *@
        <div class="border-t bg-muted/30 px-4 py-3">
            <p class="text-muted-foreground text-xs">
                <span class="font-medium">Tip:</span> Enable browser notifications to stay updated
                on important activities, mentions, and messages.
            </p>
        </div>

    </div>
</section>
