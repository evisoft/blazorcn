@* ============================================================
   Block: error-geo-blocked
   Title: ErrorGeoBlocked
   Description: Region-restricted content error page with location info and support contact
   Source: original/blocks/error/error-geo-blocked.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Icon Header *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col items-center gap-4 text-center">
                <div class="flex size-16 items-center justify-center rounded-full bg-red-500/10">
                    <LucideIconCn Name="globe" Size="32" Class="size-8 text-red-600" />
                </div>
                <div>
                    <h1 class="text-2xl font-semibold">Content Not Available</h1>
                    <p class="mt-2 text-sm text-muted-foreground">
                        This content is restricted in your region
                    </p>
                </div>
            </div>
        </div>

        @* Error Code *@
        <div class="border-b px-4 py-6">
            <div class="text-center">
                <p class="text-4xl font-semibold tabular-nums text-red-600">451</p>
                <p class="mt-2 text-xs text-muted-foreground">Unavailable For Legal Reasons</p>
            </div>
        </div>

        @* Location Info *@
        <div class="border-b px-4 py-6">
            <div class="rounded-md bg-red-500/10 p-4">
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="map-pin" Size="20" Class="mt-0.5 size-5 shrink-0 text-red-600" />
                    <div class="flex-1 space-y-1">
                        <p class="text-sm font-medium text-red-600">Access Restricted</p>
                        <p class="text-sm text-red-600">
                            Detected location: <span class="font-medium">@_detectedLocation</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @* Message *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3 text-center">
                <p class="text-sm text-muted-foreground">
                    We're sorry, but this content is not available in your geographic region due to
                    licensing restrictions, legal requirements, or regional content policies.
                </p>
            </div>
        </div>

        @* Available Regions *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">Available Regions</p>
                <div class="rounded-md bg-muted/50 p-4">
                    <p class="mb-2 text-sm text-muted-foreground">
                        This content is currently available in:
                    </p>
                    <ul class="space-y-1.5">
                        @foreach (var region in _availableRegions)
                        {
                            <li class="flex items-center gap-2 text-sm text-muted-foreground">
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                <span>@region</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        @* What You Can Do *@
        <div class="border-b px-4 py-6">
            <div class="space-y-3">
                <p class="text-sm font-medium">What You Can Do</p>
                <ul class="space-y-2 text-sm text-muted-foreground">
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Check if you're using a VPN that routes through restricted regions</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Contact support to verify your account location settings</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Browse other content that may be available in your region</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                        <span>Subscribe to updates about regional availability changes</span>
                    </li>
                </ul>
            </div>
        </div>

        @* VPN Notice *@
        <div class="border-b px-4 py-6">
            <div class="rounded-md bg-muted/50 p-4">
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="globe" Size="20" Class="mt-0.5 size-5 shrink-0 text-muted-foreground" />
                    <div class="flex-1 space-y-1">
                        <p class="text-sm font-medium">Using a VPN?</p>
                        <p class="text-sm text-muted-foreground">
                            If you're using a VPN service, try connecting to a server in one of the available
                            regions listed above. Make sure to disconnect and reconnect after changing
                            servers.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col gap-2 sm:flex-row">
                <ButtonCn Class="flex-1">
                    <LucideIconCn Name="mail" Size="16" Class="size-4" />
                    Contact Support
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1">
                    <LucideIconCn Name="home" Size="16" Class="size-4" />
                    Back to Home
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                We're working to expand availability. Check back for updates.
            </p>
        </div>

    </div>
</section>

@code {
    private string _detectedLocation = "Your Region";

    private static readonly string[] _availableRegions =
    [
        "United States",
        "Canada",
        "United Kingdom",
        "European Union",
        "Australia",
        "New Zealand",
    ];
}
