@* ============================================================
   Block: error-archived
   Title: ErrorArchived
   Description: Error page shown when content has been archived
   Source: original/blocks/error/error-archived.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border bg-muted">
                    <LucideIconCn Name="archive" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">This Page Has Been Archived</h1>
                    <p class="mt-1 text-xs text-muted-foreground">
                        This content has been moved to the archive due to inactivity. You can restore it to
                        continue working or browse archived content in read-only mode.
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 text-sm font-medium">Archive Information</div>
            <div class="space-y-3 rounded-lg border bg-muted/30 p-3">
                <div>
                    <div class="mb-1 text-sm font-medium">@_archivedItem.Name</div>
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <span>@_archivedItem.Type</span>
                        <span class="size-1 rounded-full bg-muted-foreground"></span>
                        <span>@_archivedItem.Size</span>
                    </div>
                </div>
                <div class="flex items-start gap-3 border-t pt-2">
                    <div class="flex-1">
                        <div class="mb-0.5 text-xs text-muted-foreground">Archived</div>
                        <div class="text-xs font-medium">@_archivedItem.ArchivedDate</div>
                    </div>
                    <div class="flex-1">
                        <div class="mb-0.5 text-xs text-muted-foreground">Archived By</div>
                        <div class="text-xs font-medium">@_archivedItem.ArchivedBy</div>
                    </div>
                </div>
                <div class="flex items-center gap-2 border-t pt-2 text-xs text-muted-foreground">
                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                    <span>Last activity: @_archivedItem.LastActivity</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 text-sm font-medium">Archive Statistics</div>
            <div class="grid grid-cols-3 gap-3">
                @foreach (var detail in _archiveDetails)
                {
                    <div class="rounded-lg border bg-muted/30 p-3 text-center">
                        <div class="mb-1 font-mono text-xl font-semibold tabular-nums">
                            @detail.Value
                        </div>
                        <div class="text-xs text-muted-foreground">@detail.Label</div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b bg-blue-500/5 px-4 py-2">
            <div class="flex items-start gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="archive" Size="12" Class="mt-0.5 size-3 shrink-0" />
                <span>
                    Archived content will be permanently deleted after 1 year. Restore now to continue
                    accessing this project.
                </span>
            </div>
        </div>

        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="gap-1.5">
                <LucideIconCn Name="rotate-ccw" Size="14" Class="size-3.5" />
                Restore Project
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="gap-1.5">
                <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                Download Archive
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                Browse Active Projects
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private sealed record ArchivedItem(
        string Name,
        string Type,
        string ArchivedDate,
        string ArchivedBy,
        string OriginalOwner,
        string LastActivity,
        string Size);

    private sealed record ArchiveDetail(string Label, string Value);

    private static readonly ArchivedItem _archivedItem = new(
        Name: "2024 Marketing Campaign",
        Type: "Project",
        ArchivedDate: "January 15, 2026",
        ArchivedBy: "Sarah Chen",
        OriginalOwner: "Marketing Team",
        LastActivity: "December 20, 2024",
        Size: "147 MB");

    private static readonly ArchiveDetail[] _archiveDetails =
    [
        new("Files", "234"),
        new("Contributors", "8"),
        new("Days Inactive", "95"),
    ];
}
