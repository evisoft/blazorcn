@* ============================================================
   Block: error-sync-conflict
   Title: ErrorSyncConflict
   Description: Error page for data sync conflicts with side-by-side version comparison and resolution options
   Source: original/blocks/error/error-sync-conflict.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border bg-amber-500/10">
                    <LucideIconCn Name="git-merge" Size="20" Class="size-5 text-amber-600" />
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-sm font-medium">Sync Conflict Detected</h1>
                    <p class="mt-1 text-xs text-muted-foreground">
                        This document was edited by multiple people at the same time. Choose which version
                        to keep or merge the changes manually.
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="grid gap-4 md:grid-cols-2">
                <div class="space-y-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="user" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="text-sm font-medium">Your Version</span>
                    </div>
                    <div class="space-y-2">
                        <div class="flex items-center gap-2 text-xs text-muted-foreground">
                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                            <span>@_yourVersion.LastModified</span>
                        </div>
                        @foreach (var itm in _yourVersion.Content)
                        {
                            var isConflict = _conflicts.Contains(itm.Field);
                            <div class="@($"rounded-md border p-2 {(isConflict ? "border-amber-500/30 bg-amber-500/5" : "bg-muted/30")}")">
                                <div class="mb-1 text-xs font-medium text-muted-foreground">@itm.Field</div>
                                <div class="text-sm">@itm.Value</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="space-y-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="user" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="text-sm font-medium">@(_theirVersion.Author)'s Version</span>
                    </div>
                    <div class="space-y-2">
                        <div class="flex items-center gap-2 text-xs text-muted-foreground">
                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                            <span>@_theirVersion.LastModified</span>
                        </div>
                        @foreach (var itm in _theirVersion.Content)
                        {
                            var isConflict = _conflicts.Contains(itm.Field);
                            <div class="@($"rounded-md border p-2 {(isConflict ? "border-amber-500/30 bg-amber-500/5" : "bg-muted/30")}")">
                                <div class="mb-1 text-xs font-medium text-muted-foreground">@itm.Field</div>
                                <div class="text-sm">@itm.Value</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b bg-amber-500/5 px-4 py-2">
            <div class="flex items-center gap-2 text-xs">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                <span class="text-muted-foreground">
                    @_conflicts.Length conflicting fields require your attention
                </span>
            </div>
        </div>

        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="gap-1.5">
                <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                Keep My Version
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="gap-1.5">
                <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                Keep Their Version
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="gap-1.5">
                <LucideIconCn Name="git-merge" Size="14" Class="size-3.5" />
                Merge Manually
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record ContentField(string Field, string Value);
    private record VersionData(string Title, string LastModified, string Author, ContentField[] Content);

    private static readonly VersionData _yourVersion = new(
        "Q2 Marketing Strategy",
        "5 minutes ago",
        "You",
        [
            new("Budget",          "$125,000"),
            new("Target Audience", "Enterprise SaaS companies, 100-500 employees"),
            new("Campaign Duration", "April - June 2026"),
            new("Primary Channel", "LinkedIn Sponsored Content"),
        ]
    );

    private static readonly VersionData _theirVersion = new(
        "Q2 Marketing Strategy",
        "3 minutes ago",
        "Sarah Chen",
        [
            new("Budget",          "$135,000"),
            new("Target Audience", "Mid-market B2B companies, 50-200 employees"),
            new("Campaign Duration", "April - June 2026"),
            new("Primary Channel", "Google Ads + LinkedIn"),
        ]
    );

    private static readonly string[] _conflicts = ["Budget", "Target Audience", "Primary Channel"];
}
