@* ============================================================
   Block: timeline-commit-log
   Title: TimelineCommitLog
   Description: React Git-style commit timeline with hash dots and branch badges, built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-commit-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Commits</span>
            <span class="text-muted-foreground text-xs">@_commits.Length commits</span>
        </div>

        @* Timeline *@
        <div class="px-4 py-3">
            <div class="relative">
                @for (var i = 0; i < _commits.Length; i++)
                {
                    var commit = _commits[i];
                    var isLast = i == _commits.Length - 1;
                    var dotColor = _branchColors.TryGetValue(commit.Branch, out var c) ? c : "bg-muted-foreground";
                    var commitHash = commit.Hash;
                    <div class="relative flex gap-3 pb-5 last:pb-0">
                        @* Vertical line *@
                        @if (!isLast)
                        {
                            <div class="absolute top-5 bottom-0 left-[7px] w-px bg-border"></div>
                        }

                        @* Commit dot *@
                        <div class="relative z-10 flex shrink-0 pt-1.5">
                            @if (commit.IsMerge)
                            {
                                <div class="flex size-[15px] items-center justify-center rounded-full bg-card ring-2 ring-border">
                                    <LucideIconCn Name="git-merge" Size="10" Class="size-2.5 text-muted-foreground" />
                                </div>
                            }
                            else
                            {
                                <div class="@($"size-[15px] rounded-full ring-2 ring-card {dotColor}")"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <p class="font-medium text-sm leading-snug">@commit.Message</p>
                            <div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1">
                                @* Hash with copy *@
                                <button type="button"
                                        class="inline-flex items-center gap-1 h-5 px-1.5 font-mono text-[11px] text-muted-foreground rounded-sm hover:bg-accent hover:text-accent-foreground"
                                        @onclick="@(() => CopyHash(commitHash))">
                                    @if (_copiedHash == commit.Hash)
                                    {
                                        <LucideIconCn Name="check" Size="10" Class="size-2.5" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="copy" Size="10" Class="size-2.5" />
                                    }
                                    @commit.Hash
                                </button>
                                <span class="text-muted-foreground text-xs">@commit.Author</span>
                                <span class="text-muted-foreground/40 text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@commit.Timestamp</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 font-mono text-[10px] font-normal">
                                    @commit.Branch
                                </BadgeCn>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Commit(
        string Id,
        string Hash,
        string Message,
        string Author,
        string Branch,
        string Timestamp,
        bool IsMerge = false
    );

    private static readonly Commit[] _commits =
    [
        new("1", "a3f8c21", "Fix WebSocket reconnection dropping pending messages",   "Sarah Chen",    "main",                 "14 min ago",  true),
        new("2", "e7b2d09", "Add rate limiter middleware with sliding window",         "Marcus Rivera", "feature/rate-limit",   "48 min ago"),
        new("3", "1c9a4f6", "Migrate session store from Redis to Valkey",              "Ava Patel",     "feature/rate-limit",   "1 hour ago"),
        new("4", "b5d0e83", "Update Stripe SDK to v14 and fix webhook signatures",     "James Wilson",  "main",                 "2 hours ago", true),
        new("5", "8f2c7a1", "Refactor auth middleware to support multi-tenant tokens", "Lina Nakamura", "feature/multi-tenant", "3 hours ago"),
        new("6", "d4e1b09", "Add database connection pooling with PgBouncer config",   "Omar Farouk",   "main",                 "4 hours ago"),
        new("7", "72f9c3e", "Fix N+1 query in user dashboard endpoint",               "Sarah Chen",    "hotfix/n-plus-one",    "5 hours ago"),
        new("8", "0a6d5b2", "Add OpenTelemetry tracing to all API routes",             "Marcus Rivera", "main",                 "6 hours ago"),
    ];

    private static readonly Dictionary<string, string> _branchColors = new()
    {
        ["main"]                 = "bg-emerald-500",
        ["feature/rate-limit"]   = "bg-blue-500",
        ["feature/multi-tenant"] = "bg-violet-500",
        ["hotfix/n-plus-one"]    = "bg-amber-500",
    };

    private string? _copiedHash;

    private async Task CopyHash(string hash)
    {
        _copiedHash = hash;
        await Task.Delay(2000);
        _copiedHash = null;
    }
}
