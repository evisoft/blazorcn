@* ============================================================
   Block: timeline-filterable
   Title: TimelineFilterable
   Description: A React timeline with category filters to show and hide entries by type using Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-filterable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Changelog</span>
                <span class="text-muted-foreground text-xs">
                    @_filtered.Length @(_filtered.Length == 1 ? "entry" : "entries")
                </span>
            </div>
        </div>

        @* Filter buttons *@
        <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-3">
            @foreach (var cat in _categories)
            {
                var catItem = cat;
                var isActive = _activeFilter == catItem.Value;
                var count = catItem.Value == "all"
                    ? _entries.Length
                    : Array.FindAll(_entries, e => e.Category == catItem.Value).Length;
                <ButtonCn Variant="@(isActive ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-7 gap-1 text-xs"
                          OnClick="@(() => SetFilter(catItem.Value))">
                    @if (catItem.IconName != null)
                    {
                        <LucideIconCn Name="@catItem.IconName" Size="12" Class="size-3" />
                    }
                    @catItem.Label
                    <span class="@($"ml-0.5 tabular-nums {(isActive ? "text-primary-foreground/70" : "text-muted-foreground")}")">
                        @count
                    </span>
                </ButtonCn>
            }
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            @if (_filtered.Length == 0)
            {
                <div class="py-8 text-center">
                    <span class="text-muted-foreground text-sm">No entries match this filter</span>
                </div>
            }
            else
            {
                <div class="relative">
                    @for (var i = 0; i < _filtered.Length; i++)
                    {
                        var entry = _filtered[i];
                        var isLast = i == _filtered.Length - 1;
                        var badge = GetCategoryBadge(entry.Category);
                        var dotClass = GetStatusDot(entry.Status);
                        var pbClass = isLast ? "pb-0" : "pb-6";
                        <div class="relative flex gap-4">
                            @* Line + Dot column *@
                            <div class="flex flex-col items-center">
                                <div class="@($"relative z-10 flex size-6 shrink-0 items-center justify-center rounded-full border-2 {dotClass}")">
                                    @if (entry.Status == "completed")
                                    {
                                        <LucideIconCn Name="check" Size="12" Class="size-3 text-white" />
                                    }
                                    else if (entry.Status == "current")
                                    {
                                        <LucideIconCn Name="circle-dot" Size="12" Class="size-3 text-white" />
                                        <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="circle" Size="12" Class="size-3 text-muted-foreground/40" />
                                    }
                                </div>
                                @if (!isLast)
                                {
                                    <div class="@($"w-0.5 flex-1 {GetConnectorClass(entry.Status)}")"></div>
                                }
                            </div>

                            @* Content *@
                            <div class="@($"{pbClass} min-w-0 flex-1 pt-0.5")">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@entry.Title</span>
                                    <span class="flex items-center gap-1">
                                        <span class="@($"size-1.5 rounded-full {badge.Dot}")"></span>
                                        <span class="text-muted-foreground text-xs">@badge.Label</span>
                                    </span>
                                </div>
                                <span class="mt-0.5 block text-muted-foreground text-xs">
                                    @entry.Date
                                </span>
                                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">
                                    @entry.Description
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TimelineEntry(string Id, string Date, string Title, string Description, string Category, string Status);
    private record CategoryFilter(string Value, string Label, string? IconName);
    private record CategoryBadge(string Label, string Dot);

    private string _activeFilter = "all";

    private static readonly TimelineEntry[] _entries =
    [
        new("e1", "Jan 12, 2026", "Dark mode support across all components",
            "Added automatic dark mode detection and manual toggle. All 48 components now support both light and dark themes with consistent color tokens.",
            "feature", "completed"),
        new("e2", "Jan 19, 2026", "Fixed dropdown menu positioning on scroll",
            "Resolved an issue where dropdown menus would detach from their trigger element when the page was scrolled. Used Floating UI for dynamic repositioning.",
            "bug", "completed"),
        new("e3", "Feb 3, 2026", "Reduced bundle size by 34%",
            "Tree-shook unused icon imports, lazy-loaded heavy components, and switched to dynamic imports for modals and drawers. Total JS reduced from 287KB to 189KB.",
            "improvement", "completed"),
        new("e4", "Feb 18, 2026", "Multi-file upload with drag and drop",
            "New file upload component supporting drag-and-drop, paste from clipboard, and multi-file selection. Includes progress indicators, file type validation, and size limits.",
            "feature", "completed"),
        new("e5", "Mar 1, 2026", "Fixed memory leak in real-time subscriptions",
            "WebSocket connections were not properly cleaned up on component unmount, causing gradual memory growth. Added cleanup in useEffect return and connection pooling.",
            "bug", "completed"),
        new("e6", "Mar 10, 2026", "Keyboard navigation overhaul",
            "Implementing comprehensive keyboard navigation for all interactive components. Arrow keys, Home/End, and type-ahead search in lists, menus, and comboboxes.",
            "improvement", "current"),
        new("e7", "Apr 2026", "Collaborative editing with presence cursors",
            "Real-time multiplayer editing with colored cursors, selection highlights, and conflict-free merging using CRDTs. Up to 50 concurrent editors per document.",
            "feature", "upcoming"),
        new("e8", "Apr 2026", "Optimistic updates for all mutations",
            "Migrate all create, update, and delete operations to optimistic patterns with automatic rollback on failure. Reduces perceived latency to near-zero.",
            "improvement", "upcoming"),
    ];

    private static readonly CategoryFilter[] _categories =
    [
        new("all", "All", null),
        new("feature", "Feature", "sparkles"),
        new("bug", "Bug Fix", "bug"),
        new("improvement", "Improvement", "wrench"),
    ];

    private TimelineEntry[] _filtered => _activeFilter == "all"
        ? _entries
        : Array.FindAll(_entries, e => e.Category == _activeFilter);

    private void SetFilter(string value) => _activeFilter = value;

    private static CategoryBadge GetCategoryBadge(string category) => category switch
    {
        "feature"     => new("Feature",     "bg-blue-500"),
        "bug"         => new("Bug Fix",     "bg-red-500"),
        "improvement" => new("Improvement", "bg-amber-500"),
        _             => new("Other",       "bg-muted-foreground"),
    };

    private static string GetStatusDot(string status) => status switch
    {
        "completed" => "border-emerald-500 bg-emerald-500",
        "current"   => "border-blue-500 bg-blue-500",
        _           => "border-muted-foreground/30 bg-transparent",
    };

    private static string GetConnectorClass(string status) => status switch
    {
        "completed" => "bg-emerald-500/40",
        "current"   => "bg-gradient-to-b from-blue-500/40 to-muted-foreground/15",
        _           => "bg-muted-foreground/15",
    };
}
