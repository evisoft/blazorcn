@* ============================================================
   Block: timeline-vertical-dots
   Title: TimelineVerticalDots
   Description: React vertical timeline with continuous line and dot markers built with Next.js, shadcn/ui Badge, and Tailwind CSS
   Source: original/blocks/timeline/timeline-vertical-dots.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Project timeline</span>
                <span class="text-muted-foreground text-xs">
                    @_completedCount of @_milestones.Length completed
                </span>
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var ms in _milestones)
                {
                    var milestone = ms;
                    var index = Array.IndexOf(_milestones, milestone);
                    var isLast = index == _milestones.Length - 1;
                    <div class="relative flex gap-4">
                        @* Line + Dot column *@
                        <div class="flex flex-col items-center">
                            @* Dot *@
                            <div class="@($"relative z-10 flex size-6 shrink-0 items-center justify-center rounded-full border-2 {GetStatusDotClass(milestone.Status)}")">
                                @if (milestone.Status == MilestoneStatus.Completed)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-white" />
                                }
                                @if (milestone.Status == MilestoneStatus.Current)
                                {
                                    <LucideIconCn Name="circle-dot" Size="12" Class="size-3 text-white" />
                                    <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                }
                                @if (milestone.Status == MilestoneStatus.Upcoming)
                                {
                                    <LucideIconCn Name="circle" Size="12" Class="size-3 text-muted-foreground/40" />
                                }
                            </div>
                            @* Connector line *@
                            @if (!isLast)
                            {
                                <div class="@($"w-0.5 flex-1 {GetConnectorClass(milestone.Status)}")"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@($"{(isLast ? "pb-0" : "pb-6")} min-w-0 flex-1 pt-0.5")">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@milestone.Title</span>
                                @if (milestone.Tag != null)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@milestone.Tag</BadgeCn>
                                }
                            </div>
                            <span class="mt-0.5 block text-muted-foreground text-xs">@milestone.Date</span>
                            <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">@milestone.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum MilestoneStatus { Completed, Current, Upcoming }

    private record Milestone(string Id, string Date, string Title, string Description, MilestoneStatus Status, string? Tag);

    private static readonly Milestone[] _milestones =
    [
        new("m1", "Jan 2026", "Project kickoff and planning",
            "Defined the product roadmap, assembled the core team, and established design system foundations. Completed stakeholder interviews and competitive analysis.",
            MilestoneStatus.Completed, "Planning"),
        new("m2", "Feb 2026", "Design system and component library",
            "Built the foundational component library with 48 primitives, established color tokens, typography scale, and spacing system. Shipped the internal Storybook instance.",
            MilestoneStatus.Completed, "Design"),
        new("m3", "Mar 2026", "Core platform development",
            "Implemented authentication, database schema, API layer, and real-time sync engine. Integrated Stripe billing and usage-based metering for all plan tiers.",
            MilestoneStatus.Completed, "Engineering"),
        new("m4", "Apr 2026", "Private beta launch",
            "Onboarded 120 beta users across 34 teams. Collecting feedback through in-app surveys and weekly user interviews. Iterating on the dashboard experience.",
            MilestoneStatus.Current, "Launch"),
        new("m5", "Jun 2026", "Public launch and GA release",
            "General availability release with self-serve onboarding, documentation portal, and public API. Targeting 1,000 active teams in the first quarter.",
            MilestoneStatus.Upcoming, "Launch"),
    ];

    private int _completedCount => Array.FindAll(_milestones, m => m.Status == MilestoneStatus.Completed).Length;

    private static string GetStatusDotClass(MilestoneStatus status) => status switch
    {
        MilestoneStatus.Completed => "border-emerald-500 bg-emerald-500",
        MilestoneStatus.Current => "border-blue-500 bg-blue-500",
        _ => "border-muted-foreground/30 bg-transparent",
    };

    private static string GetConnectorClass(MilestoneStatus status) => status switch
    {
        MilestoneStatus.Completed => "bg-emerald-500/40",
        MilestoneStatus.Current => "bg-gradient-to-b from-blue-500/40 to-muted-foreground/15",
        _ => "bg-muted-foreground/15",
    };
}
