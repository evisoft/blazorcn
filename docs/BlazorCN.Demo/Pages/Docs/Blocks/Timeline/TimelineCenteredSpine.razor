@* ============================================================
   Block: timeline-centered-spine
   Title: TimelineCenteredSpine
   Description: React centered spine timeline with alternating entries and diamond markers, built with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-centered-spine.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Growth timeline</span>
                <div class="flex items-center gap-2">
                    <span class="text-muted-foreground text-xs">2024 - 2026</span>
                </div>
            </div>
        </div>

        @* Spine timeline *@
        <div class="py-6">
            <div class="relative">
                @* Bold center spine *@
                <div class="absolute top-0 bottom-0 left-1/2 w-[3px] -translate-x-1/2 rounded-full bg-foreground/10" />

                @foreach (var (entry, index) in _entries.Select((e, i) => (e, i)))
                {
                    var isLeft = index % 2 == 0;
                    var isExpanded = _expanded == entry.Id;
                    var isLast = index == _entries.Length - 1;

                    <div class="@Cn.Merge("relative", isLast ? "" : "mb-2")">
                        @* Diamond marker on spine *@
                        <div class="absolute top-3 left-1/2 z-10 -translate-x-1/2">
                            <div class="size-2.5 rotate-45 border-2 border-foreground/20 bg-card" />
                        </div>

                        @* Content row *@
                        <div class="flex">
                            @* Left panel *@
                            <div class="w-[calc(50%-12px)]">
                                @if (isLeft)
                                {
                                    var entryLeft = entry;
                                    var isExpandedLeft = isExpanded;
                                    <div class="@Cn.Merge("rounded-l-md py-3 pr-5 pl-4", isLeft ? "bg-muted/30" : "")">
                                        <div class="flex items-center justify-end gap-2">
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                                @entryLeft.Category
                                            </BadgeCn>
                                            <span class="font-mono font-medium text-muted-foreground text-xs">
                                                @entryLeft.Year @entryLeft.Quarter
                                            </span>
                                        </div>
                                        <p class="mt-1.5 text-right font-medium text-sm">@entryLeft.Title</p>
                                        <p class="mt-1 text-right text-muted-foreground text-xs leading-relaxed">
                                            @entryLeft.Description
                                        </p>
                                        @if (entryLeft.Metrics != null)
                                        {
                                            <div class="mt-2 flex justify-end">
                                                <span class="font-medium text-foreground text-xs">
                                                    @entryLeft.Metrics
                                                </span>
                                            </div>
                                        }
                                        <div class="mt-1.5 flex justify-end">
                                            <button type="button"
                                                    @onclick="@(() => ToggleExpanded(entryLeft.Id))"
                                                    class="flex items-center gap-0.5 text-muted-foreground text-xs transition-colors hover:text-foreground">
                                                Details
                                                <LucideIconCn Name="chevron-right" Size="12" Class="@Cn.Merge("size-3 transition-transform duration-200", isExpandedLeft ? "rotate-90" : "")" />
                                            </button>
                                        </div>
                                        @if (isExpandedLeft)
                                        {
                                            <div class="mt-2 rounded-md bg-muted/50 p-2.5">
                                                <p class="text-right text-muted-foreground text-xs leading-relaxed">
                                                    @entryLeft.Details
                                                </p>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            @* Spine gap *@
                            <div class="w-6 shrink-0" />

                            @* Right panel *@
                            <div class="w-[calc(50%-12px)]">
                                @if (!isLeft)
                                {
                                    var entryRight = entry;
                                    var isExpandedRight = isExpanded;
                                    <div class="@Cn.Merge("rounded-r-md py-3 pr-4 pl-5", !isLeft ? "bg-muted/30" : "")">
                                        <div class="flex items-center gap-2">
                                            <span class="font-mono font-medium text-muted-foreground text-xs">
                                                @entryRight.Year @entryRight.Quarter
                                            </span>
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                                @entryRight.Category
                                            </BadgeCn>
                                        </div>
                                        <p class="mt-1.5 font-medium text-sm">@entryRight.Title</p>
                                        <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                                            @entryRight.Description
                                        </p>
                                        @if (entryRight.Metrics != null)
                                        {
                                            <div class="mt-2">
                                                <span class="font-medium text-foreground text-xs">
                                                    @entryRight.Metrics
                                                </span>
                                            </div>
                                        }
                                        <div class="mt-1.5">
                                            <button type="button"
                                                    @onclick="@(() => ToggleExpanded(entryRight.Id))"
                                                    class="flex items-center gap-0.5 text-muted-foreground text-xs transition-colors hover:text-foreground">
                                                Details
                                                <LucideIconCn Name="chevron-right" Size="12" Class="@Cn.Merge("size-3 transition-transform duration-200", isExpandedRight ? "rotate-90" : "")" />
                                            </button>
                                        </div>
                                        @if (isExpandedRight)
                                        {
                                            <div class="mt-2 rounded-md bg-muted/50 p-2.5">
                                                <p class="text-muted-foreground text-xs leading-relaxed">
                                                    @entryRight.Details
                                                </p>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record SpineEntry(string Id, string Year, string Quarter, string Title, string Description, string Details, string Category, string? Metrics = null);

    private static readonly SpineEntry[] _entries =
    [
        new("s1", "2024", "Q2", "Infrastructure overhaul",
            "Migrated the entire platform from a monolithic Rails app to a distributed Next.js and Go microservices architecture.",
            "Decomposed 14 bounded contexts into independent services. Reduced P99 latency from 1,200ms to 180ms. Zero-downtime migration completed over 6 weeks with shadow traffic validation.",
            "Engineering", "85% latency reduction"),
        new("s2", "2024", "Q4", "Series A funding round",
            "Closed a $12M Series A led by Accel with participation from existing investors. Expanded the team from 8 to 24 across engineering and design.",
            "Valuation at $48M post-money. Funds allocated: 60% engineering hiring, 25% go-to-market, 15% infrastructure. Hired VP of Engineering and Head of Design within 30 days of close.",
            "Business", "$12M raised"),
        new("s3", "2025", "Q1", "AI-powered analytics launch",
            "Shipped natural language querying for analytics dashboards. Users describe what they want to see and the system generates the visualization.",
            "Fine-tuned an LLM on 50,000 anonymized query-to-chart pairs. Supports bar, line, scatter, and funnel charts. Accuracy benchmarked at 91% on held-out test set. Average generation time: 1.8 seconds.",
            "Product", "91% accuracy"),
        new("s4", "2025", "Q3", "Enterprise customer expansion",
            "Signed 8 enterprise contracts including two Fortune 500 companies. Annual contract value exceeded $2M for the first time.",
            "Deployed dedicated infrastructure for enterprise accounts with 99.99% SLA. Implemented SSO with Okta, Azure AD, and Google Workspace. Average deal cycle shortened from 90 to 52 days.",
            "Sales", "$2M+ ACV"),
        new("s5", "2026", "Q1", "Platform V2 and developer SDK",
            "Released the completely redesigned platform with a public developer SDK, enabling third-party integrations and custom workflow automation.",
            "SDK supports TypeScript, Python, and Go. Launched with 23 pre-built integrations (Slack, Linear, Notion, GitHub, etc.). Developer documentation site with interactive examples and a sandbox environment.",
            "Product", "23 integrations"),
    ];

    private string? _expanded = "s3";

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }
}
