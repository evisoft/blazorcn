@* ============================================================
   Block: timeline-work-experience
   Title: TimelineWorkExperience
   Description: A React career history timeline built with Next.js, shadcn/ui Badge, and Tailwind CSS
   Source: original/blocks/timeline/timeline-work-experience.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Work experience</span>
                <span class="text-muted-foreground text-xs">
                    @_experiences.Length roles · 7+ years
                </span>
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var exp in _experiences)
                {
                    var isLast = exp.Id == _experiences[_experiences.Length - 1].Id;
                    <div class="relative flex gap-4">
                        @* Line + Node column *@
                        <div class="flex flex-col items-center">
                            @* Company initial node *@
                            <div class="@Cn.Merge("relative z-10 flex size-8 shrink-0 items-center justify-center rounded-full", exp.Color)">
                                <span class="font-semibold text-white text-xs">@exp.Initials</span>
                                @if (exp.Current)
                                {
                                    <span class="absolute inset-0 animate-ping rounded-full bg-foreground opacity-10"></span>
                                }
                            </div>
                            @* Connector line *@
                            @if (!isLast)
                            {
                                <div class="w-0.5 flex-1 bg-border"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@Cn.Merge("min-w-0 flex-1 pt-0.5", isLast ? "pb-0" : "pb-6")">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@exp.Role</span>
                                @if (exp.Current)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Current</BadgeCn>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-1.5 text-muted-foreground text-xs">
                                <span class="font-medium text-foreground/80">@exp.Company</span>
                                <span>·</span>
                                <span>@exp.Type</span>
                            </div>
                            <span class="mt-0.5 block text-muted-foreground text-xs">
                                @exp.Period · @exp.Duration
                            </span>

                            @* Bullet points *@
                            <ul class="mt-2 space-y-1">
                                @foreach (var bullet in exp.Bullets)
                                {
                                    <li class="flex gap-2 text-muted-foreground text-sm leading-relaxed">
                                        <span class="mt-2 size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                        <span>@bullet</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Experience(string Id, string Company, string Initials, string Color, string Role, string Type, string Period, string Duration, bool Current, string[] Bullets);

    private static readonly Experience[] _experiences =
