@* ============================================================
   Block: timeline-inline
   Title: TimelineInline
   Description: A React horizontal timeline with dot-line-dot pattern and status labels using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-inline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Order status</span>
            <span class="font-mono text-muted-foreground text-xs">#WB-4821</span>
        </div>

        @* Inline horizontal timeline *@
        <div class="px-6 py-6">
            <div class="flex items-start">
                @for (int i = 0; i < _orderSteps.Length; i++)
                {
                    var step = _orderSteps[i];
                    var isLast = i == _orderSteps.Length - 1;
                    <div class="@Cn.Merge("flex flex-col items-center", isLast ? "" : "flex-1")">
                        @* Dot + line row *@
                        <div class="@Cn.Merge("flex w-full items-center", isLast ? "w-auto" : "")">
                            @* Dot *@
                            <div class="relative flex shrink-0 items-center justify-center">
                                @if (step.Status == StepStatus.Completed)
                                {
                                    <span class="size-3 rounded-full bg-foreground"></span>
                                }
                                else if (step.Status == StepStatus.Current)
                                {
                                    <span class="relative flex size-3 items-center justify-center">
                                        <span class="absolute size-5 animate-pulse rounded-full bg-foreground/10"></span>
                                        <span class="relative size-3 rounded-full border-2 border-foreground bg-card"></span>
                                    </span>
                                }
                                else
                                {
                                    <span class="size-3 rounded-full border-2 border-muted-foreground/30 bg-card"></span>
                                }
                            </div>

                            @* Connecting line *@
                            @if (!isLast)
                            {
                                var lineClass = (step.Status == StepStatus.Completed) ? "bg-foreground" : "bg-border";
                                <div class="@Cn.Merge("h-px flex-1", lineClass)"></div>
                            }
                        </div>

                        @* Labels below dot *@
                        <div class="mt-2 flex flex-col items-center">
                            <span class="@Cn.Merge("text-center font-medium text-xs", step.Status == StepStatus.Upcoming ? "text-muted-foreground" : "text-foreground")">
                                @step.Label
                            </span>
                            <span class="mt-0.5 text-center text-muted-foreground text-[10px]">
                                @step.Sublabel
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Alternate context: project phases *@
        <div class="border-t px-6 py-6">
            <div class="mb-3 px-0">
                <span class="font-medium text-muted-foreground text-xs">Project phases</span>
            </div>
            @{ RenderInlineTimeline(_projectSteps); }
        </div>

        @* Alternate context: pipeline *@
        <div class="border-t px-6 py-6">
            <div class="mb-3 px-0">
                <span class="font-medium text-muted-foreground text-xs">CI pipeline</span>
            </div>
            @{ RenderInlineTimeline(_pipelineSteps); }
        </div>
    </div>
</section>

@code {
    private enum StepStatus { Completed, Current, Upcoming }

    private record Step(string Id, string Label, string Sublabel, StepStatus Status);

    private static readonly Step[] _orderSteps =
    [
        new("1", "Placed",     "Mar 18", StepStatus.Completed),
        new("2", "Confirmed",  "Mar 18", StepStatus.Completed),
        new("3", "Shipped",    "Mar 19", StepStatus.Completed),
        new("4", "In transit", "Mar 20", StepStatus.Current),
        new("5", "Delivered",  "Mar 21", StepStatus.Upcoming),
    ];

    private static readonly Step[] _projectSteps =
    [
        new("p1", "Research", "4 weeks", StepStatus.Completed),
        new("p2", "Design",   "3 weeks", StepStatus.Completed),
        new("p3", "Build",    "8 weeks", StepStatus.Current),
        new("p4", "Test",     "2 weeks", StepStatus.Upcoming),
        new("p5", "Launch",   "1 week",  StepStatus.Upcoming),
    ];

    private static readonly Step[] _pipelineSteps =
    [
        new("c1", "Install", "12s",     StepStatus.Completed),
        new("c2", "Lint",    "8s",      StepStatus.Completed),
        new("c3", "Test",    "47s",     StepStatus.Completed),
        new("c4", "Build",   "31s",     StepStatus.Completed),
        new("c5", "Deploy",  "Running", StepStatus.Current),
    ];

    private RenderFragment RenderInlineTimeline(Step[] items) => __builder =>
    {
        <div class="flex items-start">
            @for (int i = 0; i < items.Length; i++)
            {
                var step = items[i];
                var isLast = i == items.Length - 1;
                <div class="@Cn.Merge("flex flex-col items-center", isLast ? "" : "flex-1")">
                    @* Dot + line row *@
                    <div class="@Cn.Merge("flex w-full items-center", isLast ? "w-auto" : "")">
                        @if (step.Status == StepStatus.Completed)
                        {
                            <span class="size-2.5 shrink-0 rounded-full bg-foreground"></span>
                        }
                        else if (step.Status == StepStatus.Current)
                        {
                            <span class="relative flex size-2.5 shrink-0 items-center justify-center">
                                <span class="absolute size-4 animate-pulse rounded-full bg-foreground/10"></span>
                                <span class="relative size-2.5 rounded-full border-2 border-foreground bg-card"></span>
                            </span>
                        }
                        else
                        {
                            <span class="size-2.5 shrink-0 rounded-full border-2 border-muted-foreground/30 bg-card"></span>
                        }

                        @if (!isLast)
                        {
                            var lineClass = step.Status == StepStatus.Completed ? "bg-foreground" : "bg-border";
                            <div class="@Cn.Merge("h-px flex-1", lineClass)"></div>
                        }
                    </div>

                    @* Labels *@
                    <div class="mt-1.5 flex flex-col items-center">
                        <span class="@Cn.Merge("text-center text-[11px]", step.Status == StepStatus.Upcoming ? "text-muted-foreground" : "font-medium text-foreground")">
                            @step.Label
                        </span>
                        <span class="mt-0.5 text-center text-muted-foreground text-[10px]">
                            @step.Sublabel
                        </span>
                    </div>
                </div>
            }
        </div>
    };
}
