@* ============================================================
   Block: timeline-subscription-events
   Title: TimelineSubscriptionEvents
   Description: React subscription lifecycle timeline tracking trials, upgrades, renewals, and plan changes using Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-subscription-events.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Subscription history</span>
            <span class="text-muted-foreground text-xs">@_events.Length events</span>
        </div>

        @* Current plan *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">Team</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Active
            </BadgeCn>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">$79/mo</span>
            <span class="ml-auto text-muted-foreground text-xs">Since Feb 24, 2026</span>
        </div>

        @* Timeline *@
        <div class="py-1">
            @foreach (var evt in _events)
            {
                var isLast = evt.Id == _events[_events.Length - 1].Id;
                var isExpanded = _expanded == evt.Id;
                var cfg = GetConfig(evt.EventType);
                var ev = evt;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : ev.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Timeline node *@
                        <div class="relative flex flex-col items-center self-stretch">
                            <div class="@($"relative z-10 mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full {cfg.Dot}")">
                                <LucideIconCn Name="@cfg.IconName" Size="12" Class="@cfg.IconClass" />
                            </div>
                            @if (!isLast)
                            {
                                <div class="w-px flex-1 bg-border"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@cfg.Label</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    @ev.Plan
                                </BadgeCn>
                            </div>
                            <div class="mt-0.5 flex items-center gap-1.5 text-muted-foreground text-xs">
                                <span>@ev.Date</span>
                                @if (ev.PreviousPrice != null)
                                {
                                    <span>·</span>
                                    <span class="line-through">@ev.PreviousPrice</span>
                                    <span>→</span>
                                    <span class="font-medium text-foreground">@ev.Price</span>
                                }
                                else
                                {
                                    <span>·</span>
                                    <span>@ev.Price</span>
                                }
                            </div>
                        </div>

                        @* Chevron *@
                        <LucideIconCn Name="chevron-right" Size="16" Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                    </button>

                    @* Expanded detail *@
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-13">
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="text-sm leading-relaxed">@ev.Detail</p>
                                @if (ev.PreviousPlan != null)
                                {
                                    <div class="mt-2 flex items-center gap-2 text-xs">
                                        <span class="text-muted-foreground">@ev.PreviousPlan</span>
                                        <span class="text-muted-foreground">→</span>
                                        <span class="font-medium">@ev.Plan</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum EvtType { TrialStarted, Activated, Upgraded, Renewed, Downgraded, Paused, Resumed }

    private record SubscriptionEvent(
        string Id,
        string Date,
        EvtType EventType,
        string Plan,
        string Price,
        string? PreviousPlan,
        string? PreviousPrice,
        string Interval,
        string Detail);

    private record EventConfig(string Dot, string IconName, string IconClass, string Label);

    private string? _expanded = "e2";

    private static readonly SubscriptionEvent[] _events =
    [
        new("e1", "Mar 24, 2026", EvtType.Renewed, "Team", "$79/mo", null, null, "Monthly",
            "Auto-renewed for the next billing cycle. 5 seats active, 3 in use. Next renewal Apr 24, 2026."),
        new("e2", "Feb 24, 2026", EvtType.Upgraded, "Team", "$79/mo", "Individual", "$39/mo", "Monthly",
            "Upgraded from Individual to Team plan. Added 4 team seats. Prorated charge of $26.00 applied for remaining cycle."),
        new("e3", "Feb 10, 2026", EvtType.Resumed, "Individual", "$39/mo", null, null, "Monthly",
            "Subscription resumed after pause. Full access restored immediately. Next billing date Feb 24, 2026."),
        new("e4", "Jan 15, 2026", EvtType.Paused, "Individual", "$39/mo", null, null, "Monthly",
            "Subscription paused by customer. Access continues until current period ends Jan 24, 2026. Can resume anytime."),
        new("e5", "Dec 24, 2025", EvtType.Renewed, "Individual", "$39/mo", null, null, "Monthly",
            "Auto-renewed successfully. Payment of $39.00 processed. Next renewal Jan 24, 2026."),
        new("e6", "Nov 24, 2025", EvtType.Activated, "Individual", "$39/mo", "Trial", "Free", "Monthly",
            "Converted from 14-day trial to paid Individual plan. Payment method Visa ending 4242. First charge $39.00."),
        new("e7", "Nov 10, 2025", EvtType.TrialStarted, "Trial", "Free", null, null, "14 days",
            "Trial started with full access to Individual plan features. Trial expires Nov 24, 2025. No payment method required."),
    ];

    private static EventConfig GetConfig(EvtType evtType) => evtType switch
    {
        EvtType.TrialStarted => new("border-2 border-muted-foreground/30 bg-transparent", "sparkles", "size-3 text-muted-foreground/50", "Trial started"),
        EvtType.Activated    => new("bg-emerald-500", "check", "size-3 text-white", "Activated"),
        EvtType.Upgraded     => new("bg-blue-500", "arrow-up", "size-3 text-white", "Upgraded"),
        EvtType.Renewed      => new("bg-emerald-500", "refresh-cw", "size-3 text-white", "Renewed"),
        EvtType.Downgraded   => new("bg-amber-500", "arrow-down", "size-3 text-white", "Downgraded"),
        EvtType.Paused       => new("bg-muted-foreground/40", "pause", "size-3 text-white", "Paused"),
        EvtType.Resumed      => new("bg-blue-500", "play", "size-3 text-white", "Resumed"),
        _                    => new("bg-muted", "circle", "size-3", "Unknown"),
    };
}
