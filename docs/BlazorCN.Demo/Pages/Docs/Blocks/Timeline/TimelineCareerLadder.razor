@* ============================================================
   Block: timeline-career-ladder
   Title: TimelineCareerLadder
   Description: React career ladder timeline with ascending visual progression, showing role titles, team sizes, and achievements with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-career-ladder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Career progression</span>
                <span class="text-muted-foreground text-xs">
                    @_levels.Length levels · @_levels[0].Period.Split(" — ")[0] — present
                </span>
            </div>
        </div>

        @* Ladder *@
        <div class="py-2">
            @foreach (var role in _levels)
            {
                var isLast = role.Id == _levels[_levels.Length - 1].Id;
                var indent = _indentMap.TryGetValue(role.Level, out var ml) ? ml : "ml-0";
                <div class="@(!isLast ? "border-b" : "")">
                    <div class="px-4 py-3 @indent">
                        @* Level indicator + title row *@
                        <div class="flex items-center gap-3">
                            @* Level badge *@
                            <div class="@Cn.Merge("relative flex size-7 shrink-0 items-center justify-center rounded-md border", role.Current ? "border-foreground/20 bg-foreground text-background" : "border-border bg-muted/50 text-muted-foreground")">
                                <span class="font-semibold font-mono text-xs">@role.Level</span>
                                @if (role.Current)
                                {
                                    <span class="absolute -top-0.5 -right-0.5 size-2 rounded-full bg-emerald-500">
                                        <span class="absolute inset-0 animate-ping rounded-full bg-emerald-500 opacity-40"></span>
                                    </span>
                                }
                            </div>

                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@role.Title</span>
                                    @if (role.Current)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Current</BadgeCn>
                                    }
                                </div>
                                <div class="mt-0.5 flex items-center gap-1.5 text-muted-foreground text-xs">
                                    <span>@role.Company</span>
                                    <span>·</span>
                                    <span>@role.Period</span>
                                    <span>·</span>
                                    <span>@role.Duration</span>
                                </div>
                            </div>

                            @* Upward arrow for non-last items *@
                            @if (!isLast)
                            {
                                <LucideIconCn Name="arrow-up-right" Size="16" Class="size-4 shrink-0 text-muted-foreground/30" />
                            }
                        </div>

                        @* Team size *@
                        <div class="ml-10 mt-2 flex items-center gap-1.5 text-muted-foreground text-xs">
                            <LucideIconCn Name="users" Size="12" Class="size-3" />
                            <span>@role.TeamSize</span>
                        </div>

                        @* Key achievement *@
                        <div class="ml-10 mt-1.5">
                            <p class="text-muted-foreground text-sm leading-relaxed">@role.Achievement</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CareerLevel(string Id, int Level, string Title, string Company, string Period, string Duration, string TeamSize, string Achievement, bool Current = false);

    private static readonly CareerLevel[] _levels =
    [
        new("l1", 1, "Frontend Intern", "StartupXYZ", "Jun 2018 — Dec 2018", "7 mos", "Individual contributor",
            "Shipped responsive marketing pages that improved signup conversion by 18% through A/B testing"),
        new("l2", 2, "Junior Developer", "Acme Corp", "Jan 2019 — May 2020", "1 yr 5 mos", "Team of 4",
            "Migrated 12 legacy jQuery pages to React and increased test coverage from 48% to 87%"),
        new("l3", 3, "UI Engineer", "Figma", "Jun 2020 — Feb 2022", "1 yr 9 mos", "Team of 6",
            "Built the plugin marketplace frontend and optimized canvas rendering for 10K+ layer documents"),
        new("l4", 4, "Frontend Engineer", "Stripe", "Mar 2022 — Aug 2024", "2 yrs 6 mos", "Team of 8",
            "Reduced Checkout load time by 320ms and contributed to Stripe Elements v2 serving 4M+ merchants"),
        new("l5", 5, "Senior Frontend Engineer", "Vercel", "Sep 2024 — Present", "1 yr 7 mos", "Team of 12",
            "Led RSC migration reducing bundle size by 42%, shipped edge middleware config UI for 180K+ projects", true),
    ];

    private static readonly Dictionary<int, string> _indentMap = new()
    {
        [1] = "ml-0",
        [2] = "ml-4",
        [3] = "ml-8",
        [4] = "ml-12",
        [5] = "ml-16",
    };
}
