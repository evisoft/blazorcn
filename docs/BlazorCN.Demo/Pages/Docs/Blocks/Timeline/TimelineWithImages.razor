@* ============================================================
   Block: timeline-with-images
   Title: TimelineWithImages
   Description: React timeline with image previews built with Next.js, shadcn/ui Badge, and Tailwind CSS
   Source: original/blocks/timeline/timeline-with-images.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layers" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Project showcase</span>
            </div>
            <span class="text-muted-foreground text-xs">
                @_completedCount of @_milestones.Length shipped
            </span>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var ms in _milestones)
                {
                    var idx = System.Array.IndexOf(_milestones, ms);
                    var isLast = idx == _milestones.Length - 1;
                    <div class="relative flex gap-4">
                        @* Line + Dot column *@
                        <div class="flex flex-col items-center">
                            <div class="@Cn.Merge("relative z-10 flex size-5 shrink-0 items-center justify-center rounded-full border-2", StatusDotClass(ms.Status))">
                                @if (ms.Status == MilestoneStatus.Completed)
                                {
                                    <LucideIconCn Name="check" Size="10" Class="size-2.5 text-white" />
                                }
                                else if (ms.Status == MilestoneStatus.Current)
                                {
                                    <LucideIconCn Name="circle-dot" Size="10" Class="size-2.5 text-white" />
                                    <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                }
                            </div>
                            @if (!isLast)
                            {
                                <div class="@Cn.Merge("w-0.5 flex-1", LineColorClass(ms.Status))"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@Cn.Merge("min-w-0 flex-1 pt-0", isLast ? "pb-0" : "pb-6")">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@ms.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@ms.Category</BadgeCn>
                            </div>
                            <span class="mt-0.5 block text-muted-foreground text-xs">@ms.Date</span>
                            <p class="mt-1 text-muted-foreground text-sm leading-relaxed">@ms.Description</p>

                            @* Image placeholder *@
                            <div class="mt-3 overflow-hidden rounded-md border bg-muted/50">
                                <div class="flex aspect-video items-center justify-center bg-muted">
                                    <div class="flex flex-col items-center gap-1.5">
                                        <LucideIconCn Name="image" Size="24" Class="size-6 text-muted-foreground/40" />
                                        <span class="text-muted-foreground/60 text-xs">@ms.ImageLabel</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum MilestoneStatus { Completed, Current, Upcoming }

    private record Milestone(string Id, string Date, string Title, string Description, MilestoneStatus Status, string ImageLabel, string Category);

    private static readonly Milestone[] _milestones =
    [
        new("m1", "Mar 2025", "Brand identity redesign", "Complete visual identity overhaul including new logo, typography system, color palette, and brand guidelines document. Delivered 120-page brand book to all departments.", MilestoneStatus.Completed, "Brand guidelines cover", "Design"),
        new("m2", "May 2025", "Marketing site launch", "Shipped the new marketing website with 14 landing pages, interactive product demos, and a customer story showcase. Page speed score improved from 62 to 97.", MilestoneStatus.Completed, "Homepage hero section", "Engineering"),
        new("m3", "Aug 2025", "Mobile app release", "Published iOS and Android apps to respective stores. Featured in App Store's productivity category. 12,000 downloads in the first week.", MilestoneStatus.Completed, "App store screenshots", "Product"),
        new("m4", "Nov 2025", "Dashboard v2 redesign", "Redesigned the analytics dashboard with real-time data streams, customizable widgets, and a dark mode. User engagement increased 34% after launch.", MilestoneStatus.Current, "Dashboard overview panel", "Design"),
        new("m5", "Feb 2026", "Developer portal", "Interactive API documentation with live code examples, SDK downloads, and webhook testing sandbox. Targeting 2,000 registered developers in Q1.", MilestoneStatus.Upcoming, "API docs interface", "Engineering"),
    ];

    private int _completedCount => System.Array.FindAll(_milestones, m => m.Status == MilestoneStatus.Completed).Length;

    private static string StatusDotClass(MilestoneStatus status) => status switch
    {
        MilestoneStatus.Completed => "border-emerald-500 bg-emerald-500",
        MilestoneStatus.Current   => "border-blue-500 bg-blue-500",
        _                         => "border-muted-foreground/30 bg-transparent",
    };

    private static string LineColorClass(MilestoneStatus status) => status switch
    {
        MilestoneStatus.Completed => "bg-emerald-500/30",
        MilestoneStatus.Current   => "bg-blue-500/30",
        _                         => "bg-muted-foreground/15",
    };
}
