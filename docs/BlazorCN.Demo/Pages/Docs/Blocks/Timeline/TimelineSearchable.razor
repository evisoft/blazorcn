@* ============================================================
   Block: timeline-searchable
   Title: TimelineSearchable
   Description: React timeline with real-time search filtering. Built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-searchable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with search *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="search" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
            <InputCn @bind-Value="_query"
                     Placeholder="Search timeline entries..."
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            @if (!string.IsNullOrEmpty(_query))
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 shrink-0 px-1.5" aria-label="Clear search" OnClick="@(() => _query = "")">
                    <LucideIconCn Name="x" Size="12" Class="size-3" />
                </ButtonCn>
            }
        </div>

        @* Results count *@
        @if (!string.IsNullOrEmpty(_query))
        {
            <div class="border-b px-4 py-2">
                <span class="text-muted-foreground text-xs">
                    @Filtered.Count @(Filtered.Count == 1 ? "result" : "results") for "@_query"
                </span>
            </div>
        }

        @* Timeline *@
        <div class="px-4 py-4">
            @if (Filtered.Count == 0)
            {
                <div class="py-8 text-center">
                    <span class="text-muted-foreground text-sm">No entries match your search</span>
                </div>
            }
            else
            {
                <div class="relative">
                    @for (int i = 0; i < Filtered.Count; i++)
                    {
                        var entry = Filtered[i];
                        var isLast = i == Filtered.Count - 1;
                        var dotClass = StatusDotClass(entry.Status);
                        var lineClass = StatusLineClass(entry.Status);

                        <div class="relative flex gap-4">
                            @* Line + Dot column *@
                            <div class="flex flex-col items-center">
                                <div class="@($"relative z-10 flex size-6 shrink-0 items-center justify-center rounded-full border-2 {dotClass}")">
                                    @if (entry.Status == TimelineStatus.Completed)
                                    {
                                        <LucideIconCn Name="check" Size="12" Class="size-3 text-white" />
                                    }
                                    else if (entry.Status == TimelineStatus.Current)
                                    {
                                        <LucideIconCn Name="circle-dot" Size="12" Class="size-3 text-white" />
                                        <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="circle" Size="12" Class="size-3 text-muted-foreground/40" />
                                    }
                                </div>
                                @if (!isLast)
                                {
                                    <div class="@($"w-0.5 flex-1 {lineClass}")"></div>
                                }
                            </div>

                            @* Content *@
                            <div class="@($"{(isLast ? "pb-0" : "pb-6")} min-w-0 flex-1 pt-0.5")">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@((MarkupString)HighlightText(entry.Title, _query))</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@((MarkupString)HighlightText(entry.Tag, _query))</BadgeCn>
                                </div>
                                <span class="mt-0.5 block text-muted-foreground text-xs">@((MarkupString)HighlightText(entry.Date, _query))</span>
                                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">@((MarkupString)HighlightText(entry.Description, _query))</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum TimelineStatus { Completed, Current, Upcoming }

    private record TimelineEntry(string Id, string Date, string Title, string Description, TimelineStatus Status, string Tag);

    private static readonly TimelineEntry[] _entries =
    [
        new("e1", "Jan 6, 2026", "Database migration to PostgreSQL 16",
            "Migrated from MySQL to PostgreSQL 16 with zero downtime. Leveraged logical replication for live cutover. Query performance improved 40% on aggregate operations.",
            TimelineStatus.Completed, "Infrastructure"),
        new("e2", "Jan 20, 2026", "Two-factor authentication rollout",
            "Added TOTP-based two-factor authentication with QR code setup, backup recovery codes, and mandatory enforcement for admin accounts. Supports authenticator apps.",
            TimelineStatus.Completed, "Security"),
        new("e3", "Feb 5, 2026", "Search indexing with Elasticsearch",
            "Implemented full-text search across all content types using Elasticsearch. Supports fuzzy matching, faceted filtering, and result highlighting with sub-50ms query times.",
            TimelineStatus.Completed, "Feature"),
        new("e4", "Feb 19, 2026", "Automated backup and disaster recovery",
            "Set up automated daily backups with point-in-time recovery. Cross-region replication to two availability zones. Recovery time objective under 15 minutes.",
            TimelineStatus.Completed, "Infrastructure"),
        new("e5", "Mar 3, 2026", "Webhook delivery system redesign",
            "Rebuilt the webhook pipeline with at-least-once delivery guarantees. Includes retry with exponential backoff, payload signing with HMAC-SHA256, and a delivery log dashboard.",
            TimelineStatus.Completed, "Feature"),
        new("e6", "Mar 15, 2026", "Content Security Policy enforcement",
            "Rolling out strict CSP headers across all pages. Blocking inline scripts, restricting external resource loading, and adding nonce-based script whitelisting.",
            TimelineStatus.Current, "Security"),
        new("e7", "Apr 2026", "GraphQL API public beta",
            "Launching a GraphQL API alongside the existing REST endpoints. Includes schema introspection, query complexity limits, persisted queries, and interactive playground.",
            TimelineStatus.Upcoming, "Feature"),
        new("e8", "May 2026", "Edge caching with regional replication",
            "Deploy read replicas to 12 edge locations. Cache invalidation within 500ms globally. Static assets served from the nearest PoP with Brotli compression.",
            TimelineStatus.Upcoming, "Infrastructure"),
    ];

    private string _query = "";

    private List<TimelineEntry> Filtered => string.IsNullOrWhiteSpace(_query)
        ? [.._entries]
        : [.._entries.Where(e =>
            e.Title.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
            e.Description.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
            e.Date.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
            e.Tag.Contains(_query, StringComparison.OrdinalIgnoreCase))];

    private static string StatusDotClass(TimelineStatus status) => status switch
    {
        TimelineStatus.Completed => "border-emerald-500 bg-emerald-500",
        TimelineStatus.Current   => "border-blue-500 bg-blue-500",
        _                        => "border-muted-foreground/30 bg-transparent",
    };

    private static string StatusLineClass(TimelineStatus status) => status switch
    {
        TimelineStatus.Completed => "bg-emerald-500/40",
        TimelineStatus.Current   => "bg-gradient-to-b from-blue-500/40 to-muted-foreground/15",
        _                        => "bg-muted-foreground/15",
    };

    private static string HighlightText(string text, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
            return System.Web.HttpUtility.HtmlEncode(text);

        var escaped = System.Text.RegularExpressions.Regex.Escape(query);
        var regex = new System.Text.RegularExpressions.Regex($"({escaped})", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var parts = regex.Split(text);
        var sb = new System.Text.StringBuilder();
        foreach (var part in parts)
        {
            if (regex.IsMatch(part))
                sb.Append($"<mark class=\"rounded-sm bg-yellow-200/60 px-0.5 text-inherit dark:bg-yellow-500/20\">{System.Web.HttpUtility.HtmlEncode(part)}</mark>");
            else
                sb.Append(System.Web.HttpUtility.HtmlEncode(part));
        }
        return sb.ToString();
    }
}
