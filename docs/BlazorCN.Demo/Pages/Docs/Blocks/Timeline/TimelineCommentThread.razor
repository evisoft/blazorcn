@* ============================================================
   Block: timeline-comment-thread
   Title: TimelineCommentThread
   Description: React threaded comment timeline with nested replies and vote counts, built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-comment-thread.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Discussion</span>
                <span class="text-muted-foreground text-xs">@_totalComments comments</span>
            </div>
            <span class="text-muted-foreground text-xs">Sorted by votes</span>
        </div>

        @* Comment timeline *@
        <div class="py-1">
            @foreach (var comment in _comments)
            {
                var commentItem = comment;
                var isLastComment = commentItem.Id == _comments[_comments.Length - 1].Id;
                var isCollapsed = _collapsedReplies.Contains(commentItem.Id);
                var hasReplies = commentItem.Replies.Length > 0;
                var userVote = GetVote(commentItem.Id);

                <div>
                    @* Parent comment *@
                    <div class="relative flex gap-3 px-4 py-3">
                        @* Timeline column *@
                        <div class="flex flex-col items-center">
                            @* Avatar node *@
                            <AvatarCn Class="relative z-10 size-8 shrink-0 ring-2 ring-card">
                                <AvatarFallbackCn Class="text-[10px]">@commentItem.Author.Initials</AvatarFallbackCn>
                            </AvatarCn>
                            @* Main line extending down *@
                            @if (!isLastComment || (hasReplies && !isCollapsed))
                            {
                                <div class="w-px flex-1 bg-border"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@commentItem.Author.Name</span>
                                <span class="text-muted-foreground text-xs">@commentItem.Timestamp</span>
                            </div>
                            <p class="mt-1 text-sm leading-relaxed">@commentItem.Content</p>
                            <div class="mt-2 flex items-center gap-3">
                                @* Vote controls *@
                                <div class="flex items-center gap-1">
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0" aria-label="@($"Upvote comment by {commentItem.Author.Name}")" OnClick="@(() => Vote(commentItem.Id, 1))">
                                        <LucideIconCn Name="chevron-up" Size="14" Class="@Cn.Merge("size-3.5", userVote == 1 ? "text-emerald-500" : "text-muted-foreground")" />
                                    </ButtonCn>
                                    <span class="@Cn.Merge("min-w-[1.5rem] text-center font-medium text-xs tabular-nums", userVote == 1 ? "text-emerald-500" : userVote == -1 ? "text-red-500" : "text-muted-foreground")">
                                        @(commentItem.Votes + userVote)
                                    </span>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0" aria-label="@($"Downvote comment by {commentItem.Author.Name}")" OnClick="@(() => Vote(commentItem.Id, -1))">
                                        <LucideIconCn Name="chevron-down" Size="14" Class="@Cn.Merge("size-3.5", userVote == -1 ? "text-red-500" : "text-muted-foreground")" />
                                    </ButtonCn>
                                </div>

                                @* Reply toggle *@
                                @if (hasReplies)
                                {
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs text-muted-foreground" OnClick="@(() => ToggleReplies(commentItem.Id))">
                                        <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                        @commentItem.Replies.Length @(commentItem.Replies.Length == 1 ? "reply" : "replies")
                                    </ButtonCn>
                                }
                            </div>
                        </div>
                    </div>

                    @* Reply branch *@
                    @if (hasReplies && !isCollapsed)
                    {
                        <div class="pl-4">
                            @foreach (var reply in commentItem.Replies)
                            {
                                var replyItem = reply;
                                var isLastReply = replyItem.Id == commentItem.Replies[commentItem.Replies.Length - 1].Id;
                                var replyVote = GetVote(replyItem.Id);

                                <div class="relative flex gap-3 px-4 py-2">
                                    @* Indented sub-line column *@
                                    <div class="flex flex-col items-center">
                                        @* Branch connector *@
                                        <div class="relative z-10 flex size-6 shrink-0 items-center justify-center">
                                            <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                                        </div>
                                        @* Continue line *@
                                        @if (!isLastReply || !isLastComment)
                                        {
                                            <div class="w-px flex-1 bg-border/60"></div>
                                        }
                                    </div>

                                    @* Reply content *@
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <AvatarCn Class="size-5 text-[8px]">
                                                <AvatarFallbackCn Class="text-[8px]">@replyItem.Author.Initials</AvatarFallbackCn>
                                            </AvatarCn>
                                            <span class="font-medium text-xs">@replyItem.Author.Name</span>
                                            <span class="text-muted-foreground text-xs">@replyItem.Timestamp</span>
                                        </div>
                                        <p class="mt-1 text-muted-foreground text-sm leading-relaxed">@replyItem.Content</p>
                                        <div class="mt-1.5 flex items-center gap-1">
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-5 p-0" aria-label="@($"Upvote reply by {replyItem.Author.Name}")" OnClick="@(() => Vote(replyItem.Id, 1))">
                                                <LucideIconCn Name="chevron-up" Size="12" Class="@Cn.Merge("size-3", replyVote == 1 ? "text-emerald-500" : "text-muted-foreground")" />
                                            </ButtonCn>
                                            <span class="@Cn.Merge("min-w-[1.25rem] text-center text-xs tabular-nums", replyVote == 1 ? "text-emerald-500" : replyVote == -1 ? "text-red-500" : "text-muted-foreground")">
                                                @(replyItem.Votes + replyVote)
                                            </span>
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-5 p-0" aria-label="@($"Downvote reply by {replyItem.Author.Name}")" OnClick="@(() => Vote(replyItem.Id, -1))">
                                                <LucideIconCn Name="chevron-down" Size="12" Class="@Cn.Merge("size-3", replyVote == -1 ? "text-red-500" : "text-muted-foreground")" />
                                            </ButtonCn>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @* Separator between parent comments *@
                    @if (!isLastComment)
                    {
                        <div class="border-b"></div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Author(string Name, string Initials);

    private record ReplyItem(string Id, Author Author, string Content, string Timestamp, int Votes);

    private record CommentItem(string Id, Author Author, string Content, string Timestamp, int Votes, ReplyItem[] Replies);

    private static readonly CommentItem[] _comments =
    [
        new("c1", new("Elena Vasquez", "EV"),
            "The new edge caching strategy is impressive, but I am curious about cache invalidation. How do you handle stale data when a user updates their profile and the cached version is served to a different region?",
            "3 hours ago", 24,
            [
                new("r1a", new("David Park", "DP"),
                    "We use a two-phase approach. Write operations publish an invalidation event to a global pub/sub channel, and each edge node subscribes and purges the relevant keys. P99 propagation is under 200ms.",
                    "2 hours ago", 18),
                new("r1b", new("Elena Vasquez", "EV"),
                    "That is cleaner than I expected. Do you use a TTL as a safety net in case the invalidation event is dropped?",
                    "2 hours ago", 7),
                new("r1c", new("David Park", "DP"),
                    "Yes, 60-second TTL on all edge-cached entries. The pub/sub handles the happy path, and TTL covers partition scenarios. We have not seen stale reads beyond 300ms in production.",
                    "1 hour ago", 12),
            ]),
        new("c2", new("Marcus Rivera", "MR"),
            "Have you considered using Consistent Hashing for the cache key distribution? It would reduce the thundering herd problem during deployments when a large portion of the cache is invalidated at once.",
            "2 hours ago", 15,
            [
                new("r2a", new("Ava Patel", "AP"),
                    "We actually moved away from consistent hashing because our key space is highly skewed. A small number of hot keys account for 80% of reads. We use a dedicated hot-key cache tier instead.",
                    "1 hour ago", 21),
            ]),
        new("c3", new("James Wilson", "JW"),
            "Solid architecture post. One thing I would add: monitoring cache hit ratios per route is essential. We found that 3 API endpoints had sub-20% hit rates and were better served without caching at all.",
            "1 hour ago", 31,
            []),
        new("c4", new("Lina Nakamura", "LN"),
            "The latency improvement numbers are great but I am wondering about the cold start story. After a deployment, how long until the cache is warm enough to see those P95 numbers?",
            "45 min ago", 9,
            [
                new("r4a", new("David Park", "DP"),
                    "We pre-warm the top 500 keys from a precomputed manifest during deployment. That covers about 70% of traffic. The remaining keys warm organically within 2-3 minutes of receiving real traffic.",
                    "30 min ago", 14),
            ]),
    ];

    private int _totalComments = 0;
    private Dictionary<string, int> _voteDelta = new();
    private HashSet<string> _collapsedReplies = new();

    protected override void OnInitialized()
    {
        _totalComments = _comments.Sum(c => 1 + c.Replies.Length);
    }

    private int GetVote(string id) => _voteDelta.TryGetValue(id, out var v) ? v : 0;

    private void Vote(string id, int direction)
    {
        var current = GetVote(id);
        var next = current == direction ? 0 : direction;
        _voteDelta[id] = next;
    }

    private void ToggleReplies(string commentId)
    {
        if (_collapsedReplies.Contains(commentId))
            _collapsedReplies.Remove(commentId);
        else
            _collapsedReplies.Add(commentId);
    }
}
