@* ============================================================
   Block: timeline-horizontal-scroll
   Title: TimelineHorizontalScroll
   Description: React scrollable timeline with alternating entries, dot markers, and central line using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-horizontal-scroll.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Product Roadmap</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">@_milestones.Length milestones</span>
        </div>

        @* Scrollable timeline *@
        <div class="overflow-x-auto" tabindex="0" role="group" aria-label="Product roadmap timeline">
            <div class="relative min-w-[900px] px-8 py-10">
                @* Central horizontal line *@
                <div class="absolute top-1/2 right-8 left-8 h-px -translate-y-1/2 bg-border"></div>

                @* Entries *@
                <div class="relative flex justify-between">
                    @foreach (var ms in _milestones)
                    {
                        var milestone = ms;
                        var index = System.Array.IndexOf(_milestones, milestone);
                        var isAbove = index % 2 == 0;
                        <div class="relative flex w-36 flex-col items-center">
                            @if (isAbove)
                            {
                                @* Content above *@
                                <div class="mb-3 text-center">
                                    <span class="font-medium text-muted-foreground text-xs">@milestone.Date</span>
                                    <p class="mt-1 font-medium text-sm">@milestone.Title</p>
                                    <p class="mt-1 text-muted-foreground text-xs leading-relaxed">@milestone.Description</p>
                                </div>
                                @* Vertical connector *@
                                <div class="h-6 w-px bg-border"></div>
                                @* Dot on line *@
                                <div class="relative z-10 flex size-3 items-center justify-center rounded-full border-2 border-foreground bg-card"></div>
                                @* Spacer below *@
                                <div class="h-6"></div>
                                <div class="h-[72px]"></div>
                            }
                            else
                            {
                                @* Spacer above *@
                                <div class="h-[72px]"></div>
                                <div class="h-6"></div>
                                @* Dot on line *@
                                <div class="relative z-10 flex size-3 items-center justify-center rounded-full border-2 border-foreground bg-card"></div>
                                @* Vertical connector *@
                                <div class="h-6 w-px bg-border"></div>
                                @* Content below *@
                                <div class="mt-3 text-center">
                                    <span class="font-medium text-muted-foreground text-xs">@milestone.Date</span>
                                    <p class="mt-1 font-medium text-sm">@milestone.Title</p>
                                    <p class="mt-1 text-muted-foreground text-xs leading-relaxed">@milestone.Description</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Footer hint *@
        <div class="border-t px-4 py-2">
            <span class="text-muted-foreground text-xs">Scroll horizontally to explore</span>
        </div>
    </div>
</section>

@code {
    private record Milestone(string Id, string Date, string Title, string Description);

    private static readonly Milestone[] _milestones =
    [
        new("m1", "Jan 2025", "Project Kickoff",
            "Initial planning, team assembly, and architecture design for the new platform."),
        new("m2", "Mar 2025", "Alpha Release",
            "Core features shipped to internal testers. Authentication, dashboard, and API layer complete."),
        new("m3", "Jun 2025", "Beta Launch",
            "Public beta with 500 early adopters. Feedback collection and iteration cycle begins."),
        new("m4", "Sep 2025", "General Availability",
            "Production release with full documentation, onboarding flows, and billing integration."),
        new("m5", "Dec 2025", "Enterprise Tier",
            "SSO, audit logs, and team management features for enterprise customers."),
        new("m6", "Mar 2026", "Platform v2",
            "Major redesign with AI-assisted workflows, real-time collaboration, and plugin system."),
    ];
}
