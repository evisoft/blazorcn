@* ============================================================
   Block: timeline-build-history
   Title: TimelineBuildHistory
   Description: React CI/CD build timeline with pass/fail indicators built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-build-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Build history</span>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs">@_builds.Length builds</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_passedCount
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_failedCount
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">@_successRate% pass rate</span>
            </div>
        </div>

        @* Health bar *@
        <div class="flex gap-0.5 border-b px-4 py-3">
            @foreach (var build in _builds.Reverse())
            {
                var barClass = build.Status == BuildStatus.Passed
                    ? "h-6 flex-1 first:rounded-l-sm last:rounded-r-sm bg-emerald-500/70"
                    : build.Status == BuildStatus.Failed
                        ? "h-6 flex-1 first:rounded-l-sm last:rounded-r-sm bg-red-500/70"
                        : "h-6 flex-1 first:rounded-l-sm last:rounded-r-sm animate-pulse bg-muted-foreground/30";
                <div class="@barClass"></div>
            }
        </div>

        @* Timeline *@
        <div class="px-4 py-3">
            <div class="relative">
                @for (var i = 0; i < _builds.Length; i++)
                {
                    var build = _builds[i];
                    var isLast = i == _builds.Length - 1;
                    var isExpanded = _expanded == build.Id;
                    var hasFail = build.FailureReason != null;
                    var iconName = build.Status == BuildStatus.Passed
                        ? "check-circle-2"
                        : build.Status == BuildStatus.Failed
                            ? "x-circle"
                            : "circle-dot";
                    var iconColor = build.Status == BuildStatus.Passed
                        ? "text-emerald-600 dark:text-emerald-400"
                        : build.Status == BuildStatus.Failed
                            ? "text-red-600 dark:text-red-400"
                            : "text-foreground";
                    var iconClass = build.Status == BuildStatus.Running
                        ? $"size-[17px] {iconColor} animate-pulse"
                        : $"size-[17px] {iconColor}";
                    var statusLineClass = build.Status == BuildStatus.Passed
                        ? "absolute top-6 bottom-0 left-[8px] w-px bg-emerald-500/30"
                        : build.Status == BuildStatus.Failed
                            ? "absolute top-6 bottom-0 left-[8px] w-px bg-red-500/30"
                            : "absolute top-6 bottom-0 left-[8px] w-px bg-border";
                    var btnCursorClass = hasFail ? "flex w-full items-center gap-2 text-left cursor-pointer" : "flex w-full items-center gap-2 text-left cursor-default";
                    var chevronClass = isExpanded
                        ? "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 rotate-90"
                        : "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200";
                    var buildId = build.Id;
                    <div class="relative flex gap-3 pb-4 last:pb-0">
                        @* Vertical line *@
                        @if (!isLast)
                        {
                            <div class="@statusLineClass"></div>
                        }

                        @* Status icon *@
                        <div class="relative z-10 flex shrink-0 pt-0.5">
                            <LucideIconCn Name="@iconName" Size="17" Class="@iconClass" />
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <button type="button"
                                    @onclick="@(() => { if (hasFail) _expanded = isExpanded ? null : buildId; })"
                                    class="@btnCursorClass">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="font-medium text-sm">#@build.Number</span>
                                        <span class="truncate text-muted-foreground text-sm">@build.Message</span>
                                    </div>
                                    <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5">
                                        <span class="flex items-center gap-1 font-mono text-muted-foreground text-xs">
                                            <LucideIconCn Name="git-commit-horizontal" Size="12" Class="size-3" />
                                            @build.Commit
                                        </span>
                                        <span class="text-muted-foreground/40 text-xs">·</span>
                                        <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                            <LucideIconCn Name="git-branch" Size="12" Class="size-3" />
                                            @build.Branch
                                        </span>
                                        <span class="text-muted-foreground/40 text-xs">·</span>
                                        <span class="font-mono text-muted-foreground text-xs tabular-nums">@build.Duration</span>
                                        <span class="text-muted-foreground/40 text-xs">·</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 text-[10px] font-normal">
                                            @_triggerLabels[build.Trigger]
                                        </BadgeCn>
                                        <span class="text-muted-foreground/40 text-xs">·</span>
                                        <span class="text-muted-foreground text-xs">@build.Timestamp</span>
                                    </div>
                                </div>

                                @if (hasFail)
                                {
                                    <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                                }
                            </button>

                            @* Failure detail *@
                            @if (isExpanded && build.FailureReason != null)
                            {
                                <div class="mt-2 rounded-md bg-red-500/5 p-3">
                                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Failure reason</span>
                                    <p class="text-sm leading-relaxed">@build.FailureReason</p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum BuildStatus { Passed, Failed, Running }
    private enum Trigger { Push, PullRequest, Schedule, Manual }

    private record Build(
        string Id,
        int Number,
        BuildStatus Status,
        string Commit,
        string Message,
        string Branch,
        string Duration,
        Trigger Trigger,
        string Timestamp,
        string Author,
        string? FailureReason = null
    );

    private static readonly Build[] _builds =
    [
        new("b1", 1847, BuildStatus.Running, "a3f8c21", "Add workspace invitation flow with email notifications", "feature/invites", "2m 14s", Trigger.Push, "3 min ago", "Sarah Chen"),
        new("b2", 1846, BuildStatus.Passed,  "e7b2d09", "Fix rate limiter edge case with concurrent requests",    "main",            "4m 38s", Trigger.PullRequest, "18 min ago", "Marcus Rivera"),
        new("b3", 1845, BuildStatus.Failed,  "1c9a4f6", "Update Stripe SDK to v14 with new webhook format",        "deps/stripe-v14",  "1m 52s", Trigger.Push, "42 min ago", "James Wilson",
            "Test suite failed: 3 tests in payments.test.ts. Expected webhook payload v2 format but received v1. The stripe.webhooks.constructEvent signature changed in v14 — update the verification call to use the new API."),
        new("b4", 1844, BuildStatus.Passed,  "b5d0e83", "Migrate session store from Redis to Valkey",              "main",            "5m 02s", Trigger.PullRequest, "1 hour ago", "Ava Patel"),
        new("b5", 1843, BuildStatus.Passed,  "8f2c7a1", "Add database connection pooling with PgBouncer",          "main",            "4m 21s", Trigger.PullRequest, "2 hours ago", "Omar Farouk"),
        new("b6", 1842, BuildStatus.Failed,  "d4e1b09", "Implement SSO with SAML 2.0 for enterprise tier",         "feature/sso",     "3m 07s", Trigger.Push, "3 hours ago", "Lina Nakamura",
            "E2E test timeout: SSO callback handler exceeded 30s deadline. The SAML assertion XML parsing blocks the event loop for large identity provider responses. Consider streaming the XML parser or moving to a worker thread."),
        new("b7", 1841, BuildStatus.Passed,  "72f9c3e", "Add OpenTelemetry tracing to all API routes",              "main",            "4m 45s", Trigger.PullRequest, "4 hours ago", "Sarah Chen"),
        new("b8", 1840, BuildStatus.Passed,  "0a6d5b2", "Nightly integration test suite",                          "main",            "12m 33s", Trigger.Schedule, "8 hours ago", "CI Bot"),
    ];

    private static readonly Dictionary<Trigger, string> _triggerLabels = new()
    {
        [Trigger.Push]        = "Push",
        [Trigger.PullRequest] = "PR merge",
        [Trigger.Schedule]    = "Scheduled",
        [Trigger.Manual]      = "Manual",
    };

    private static readonly int _passedCount  = _builds.Count(b => b.Status == BuildStatus.Passed);
    private static readonly int _failedCount   = _builds.Count(b => b.Status == BuildStatus.Failed);
    private static readonly int _successRate   = (int)Math.Round((double)_passedCount / (_passedCount + _failedCount) * 100);

    private string? _expanded = "b3";
}
