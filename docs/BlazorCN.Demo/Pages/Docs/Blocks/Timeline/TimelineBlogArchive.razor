@* ============================================================
   Block: timeline-blog-archive
   Title: TimelineBlogArchive
   Description: React blog post archive timeline grouped by year and month built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-blog-archive.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Blog archive</span>
                </div>
                <span class="text-muted-foreground text-xs">@_totalPosts posts</span>
            </div>
        </div>

        @* Timeline *@
        <div class="relative">
            @* Vertical spine *@
            <div class="absolute top-0 bottom-0 left-[27px] w-px bg-border"></div>

            @foreach (var yearGroup in _archive)
            {
                var yearIndex = System.Array.IndexOf(_archive, yearGroup);
                var isExpanded = _expandedYear == yearGroup.Year;
                var isLastYear = yearIndex == _archive.Length - 1;

                <div>
                    @* Year marker *@
                    <div class="@(yearIndex > 0 ? "border-t" : "")">
                        <button type="button"
                                @onclick="@(() => { var yr = yearGroup.Year; _expandedYear = isExpanded ? "" : yr; })"
                                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                            @* Year dot — prominent marker *@
                            <div class="relative z-10 flex size-7 shrink-0 items-center justify-center rounded-full border-2 border-foreground/20 bg-card">
                                <span class="font-semibold text-xs tabular-nums">@yearGroup.Year.Substring(2)</span>
                            </div>

                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@yearGroup.Year</span>
                            </div>

                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @yearGroup.Total posts
                            </BadgeCn>

                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </button>
                    </div>

                    @* Month groups *@
                    @if (isExpanded)
                    {
                        @foreach (var monthGroup in yearGroup.Months)
                        {
                            var monthIndex = System.Array.IndexOf(yearGroup.Months, monthGroup);
                            <div>
                                @* Month sub-header *@
                                <div class="flex items-center gap-3 border-t px-4 py-2">
                                    <div class="relative z-10 flex size-7 shrink-0 items-center justify-center">
                                        <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                                    </div>
                                    <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">@monthGroup.Month</span>
                                    <div class="h-px flex-1 bg-border"></div>
                                </div>

                                @* Posts *@
                                @foreach (var post in monthGroup.Posts)
                                {
                                    var postIndex = System.Array.IndexOf(monthGroup.Posts, post);
                                    var isLastPost = isLastYear
                                        && monthIndex == yearGroup.Months.Length - 1
                                        && postIndex == monthGroup.Posts.Length - 1;
                                    var dotColor = GetCategoryColor(post.Category);
                                    <div class="@Cn.Merge("flex items-start gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLastPost ? "" : "border-b border-dashed")">
                                        @* Small dot *@
                                        <div class="relative z-10 mt-1.5 flex size-7 shrink-0 items-center justify-center">
                                            <span class="@Cn.Merge("size-1.5 rounded-full", dotColor)"></span>
                                        </div>

                                        @* Post content *@
                                        <div class="min-w-0 flex-1">
                                            <span class="font-medium text-sm leading-snug">@post.Title</span>
                                            <div class="mt-0.5 flex items-center gap-2">
                                                <span class="text-muted-foreground text-xs">@post.Date</span>
                                                <span class="text-muted-foreground text-xs">·</span>
                                                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                    <LucideIconCn Name="clock" Size="10" Class="size-2.5" />
                                                    @post.ReadingTime
                                                </span>
                                            </div>
                                        </div>

                                        @* Category badge *@
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="mt-0.5 shrink-0 font-normal text-xs">
                                            @post.Category
                                        </BadgeCn>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Post(string Id, string Title, string Date, string ReadingTime, string Category);
    private record MonthGroup(string Month, Post[] Posts);
    private record YearGroup(string Year, MonthGroup[] Months, int Total);

    private string _expandedYear = "2026";

    private static readonly YearGroup[] _archive =
    [
        new("2026",
            [
                new("March",
                [
                    new("p1", "Building accessible component libraries from scratch", "Mar 18", "12 min", "Engineering"),
                    new("p2", "Why we migrated from REST to tRPC", "Mar 7", "8 min", "Architecture"),
                ]),
                new("February",
                [
                    new("p3", "Designing tokens for multi-brand design systems", "Feb 22", "10 min", "Design"),
                    new("p4", "Edge functions: when and when not to use them", "Feb 14", "6 min", "Infrastructure"),
                    new("p5", "A practical guide to React Server Components", "Feb 3", "15 min", "Engineering"),
                ]),
                new("January",
                [
                    new("p6", "2025 in review: lessons from shipping 14 projects", "Jan 15", "9 min", "Reflection"),
                    new("p7", "Setting up a monorepo with Turborepo and Bun", "Jan 8", "7 min", "Tooling"),
                    new("p8", "Goals and themes for 2026", "Jan 2", "4 min", "Reflection"),
                ]),
            ],
            8),
        new("2025",
            [
                new("December",
                [
                    new("p9", "Optimizing Prisma queries for large datasets", "Dec 20", "11 min", "Database"),
                    new("p10", "The case for incremental static regeneration", "Dec 8", "7 min", "Architecture"),
                ]),
                new("November",
                [
                    new("p11", "Writing effective pull request descriptions", "Nov 25", "5 min", "Process"),
                    new("p12", "Stripe integration patterns for SaaS billing", "Nov 12", "13 min", "Engineering"),
                ]),
                new("October",
                [
                    new("p13", "Testing React hooks with Vitest and Testing Library", "Oct 28", "8 min", "Testing"),
                    new("p14", "Authentication patterns with Better Auth", "Oct 10", "10 min", "Security"),
                ]),
            ],
            6),
    ];

    private int _totalPosts = System.Linq.Enumerable.Sum(_archive, y => y.Total);

    private static string GetCategoryColor(string category) => category switch
    {
        "Engineering"    => "bg-blue-500",
        "Architecture"   => "bg-violet-500",
        "Design"         => "bg-pink-500",
        "Infrastructure" => "bg-amber-500",
        "Reflection"     => "bg-emerald-500",
        "Tooling"        => "bg-orange-500",
        "Database"       => "bg-cyan-500",
        "Process"        => "bg-indigo-500",
        "Testing"        => "bg-teal-500",
        "Security"       => "bg-red-500",
        _                => "bg-muted-foreground/30",
    };
}
