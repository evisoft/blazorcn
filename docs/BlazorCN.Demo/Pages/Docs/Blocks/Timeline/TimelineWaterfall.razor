@* ============================================================
   Block: timeline-waterfall
   Title: TimelineWaterfall
   Description: React cascading waterfall timeline with progressive indentation built with Next.js, shadcn/ui Badge, and Tailwind CSS
   Source: original/blocks/timeline/timeline-waterfall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="layers" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Deploy pipeline</span>
                </div>
                <span class="text-muted-foreground text-xs">
                    @(_steps.Count(s => s.Status == StepStatus.Done)) of @_steps.Length complete
                </span>
            </div>
        </div>

        @* Waterfall cascade *@
        <div class="overflow-x-auto px-4 py-4">
            <div style="@($"min-width:{(_steps.Length - 1) * StepIndent + 320}px")">
                @foreach (var step in _steps)
                {
                    var stepIdx = System.Array.IndexOf(_steps, step);
                    var isLast = stepIdx == _steps.Length - 1;
                    var indent = stepIdx * StepIndent;
                    var styleConfig = _statusStyles[step.Status];

                    <div>
                        @* Step row *@
                        <div class="flex items-start gap-3" style="@($"margin-left:{indent}px")">
                            @* Dot *@
                            <div class="relative flex flex-col items-center">
                                <div class="@($"relative z-10 flex size-5 shrink-0 items-center justify-center rounded-full border-2 {styleConfig.DotClass}")">
                                    <LucideIconCn Name="@styleConfig.IconName" Size="10" Class="size-2.5" />
                                </div>
                                @if (step.Status == StepStatus.Active)
                                {
                                    <span class="absolute inset-0 flex items-center justify-center">
                                        <span class="absolute size-5 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                    </span>
                                }
                            </div>

                            @* Content *@
                            <div class="min-w-0 flex-1 pt-0.5">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@step.Title</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">
                                        @step.Duration
                                    </BadgeCn>
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                                    @step.Description
                                </p>
                            </div>
                        </div>

                        @* L-shaped connector to next level *@
                        @if (!isLast)
                        {
                            <div class="relative" style="@($"margin-left:{indent + 10}px;height:28px")">
                                @* Vertical segment going down *@
                                <div class="@($"absolute top-0 left-0 h-full w-0.5 {styleConfig.LineClass}")"></div>
                                @* Horizontal segment going right to next indent *@
                                <div class="@($"absolute bottom-0 left-0 h-0.5 {styleConfig.LineClass}")" style="width:48px"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2">
            <span class="text-muted-foreground text-xs">Total estimated time: ~36 min</span>
        </div>
    </div>
</section>

@code {
    private const int StepIndent = 48;

    private enum StepStatus { Done, Active, Pending }

    private record WaterfallStep(string Id, string Title, string Description, string Duration, StepStatus Status);

    private record StepStyleConfig(string DotClass, string IconName, string LineClass);

    private static readonly Dictionary<StepStatus, StepStyleConfig> _statusStyles = new()
    {
        [StepStatus.Done]    = new("border-emerald-500 bg-emerald-500 text-white",                "check",      "bg-emerald-500/30"),
        [StepStatus.Active]  = new("border-blue-500 bg-blue-500 text-white",                      "circle-dot", "bg-blue-500/30"),
        [StepStatus.Pending] = new("border-muted-foreground/30 bg-card text-muted-foreground/40", "circle",     "bg-muted-foreground/15"),
    };

    private static readonly WaterfallStep[] _steps =
    [
        new("s1", "Code commit pushed",
            "Developer pushes to main branch. Pre-commit hooks validate linting and type checks.",
            "~2 sec", StepStatus.Done),
        new("s2", "CI pipeline triggered",
            "GitHub Actions workflow starts. Installs dependencies, runs unit tests across 3 shards.",
            "~4 min", StepStatus.Done),
        new("s3", "Integration tests pass",
            "End-to-end tests run against staging database. API contract tests validate all endpoints.",
            "~8 min", StepStatus.Done),
        new("s4", "Docker image built and scanned",
            "Multi-stage Docker build creates optimized image. Trivy scanner checks for CVEs.",
            "~3 min", StepStatus.Active),
        new("s5", "Staging deployment",
            "Image pushed to ECR and deployed to staging ECS cluster. Health checks confirm service is live.",
            "~2 min", StepStatus.Pending),
        new("s6", "Smoke tests on staging",
            "Automated smoke tests hit critical user paths. Performance benchmarks compare against baseline.",
            "~5 min", StepStatus.Pending),
        new("s7", "Production deploy complete",
            "Blue-green deploy to production. Traffic shifted gradually over 10 minutes with automated rollback.",
            "~12 min", StepStatus.Pending),
    ];
}
