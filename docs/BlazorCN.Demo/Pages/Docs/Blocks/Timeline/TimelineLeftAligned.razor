@* ============================================================
   Block: timeline-left-aligned
   Title: TimelineLeftAligned
   Description: React timeline with left-aligned dates and vertical connector using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-left-aligned.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Changelog</span>
                <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-foreground"></span>
                        Major
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-foreground/50"></span>
                        Minor
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-foreground/25"></span>
                        Patch
                    </span>
                </div>
            </div>
        </div>

        @* Timeline *@
        <div class="py-2">
            @foreach (var release in _releases)
            {
                var index = System.Array.IndexOf(_releases, release);
                var isExpanded = _expanded == release.Id;
                var isLast = index == _releases.Length - 1;
                var dotClass = release.Type == ReleaseType.Major
                    ? "bg-foreground"
                    : release.Type == ReleaseType.Minor
                        ? "bg-foreground/50"
                        : "bg-foreground/25";
                var chevronClass = isExpanded
                    ? "size-3 transition-transform duration-200 rotate-90"
                    : "size-3 transition-transform duration-200";
                var releaseId = release.Id;

                <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => SetExpanded(releaseId, isExpanded))"
                            class="flex w-full items-start gap-0 text-left transition-colors hover:bg-muted/50">
                        @* Date column *@
                        <div class="flex w-16 shrink-0 flex-col items-center py-3 pl-3">
                            <span class="font-semibold text-lg tabular-nums leading-none">@release.Day</span>
                            <span class="mt-0.5 font-medium text-muted-foreground text-xs uppercase tracking-wide">@release.Month</span>
                        </div>

                        @* Line + dot *@
                        <div class="flex flex-col items-center py-3">
                            <div class="@Cn.Merge("size-2.5 shrink-0 rounded-full", dotClass)"></div>
                            @if (!isLast)
                            {
                                <div class="mt-1 w-px flex-1 bg-border"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1 py-3 pr-4 pl-3">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@release.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono font-normal text-xs">@release.Version</BadgeCn>
                            </div>
                            <p class="mt-1 text-muted-foreground text-xs leading-relaxed">@release.Description</p>
                            <div class="mt-1 flex items-center gap-1 text-muted-foreground/60 text-xs">
                                <span>@release.Changes.Length change@(release.Changes.Length != 1 ? "s" : "")</span>
                                <LucideIconCn Name="chevron-right" Size="12" Class="@chevronClass" />
                            </div>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="pb-3 pl-[88px] pr-4">
                            <div class="space-y-1.5">
                                @foreach (var change in release.Changes)
                                {
                                    <div class="flex items-start gap-2">
                                        <LucideIconCn Name="tag" Size="12" Class="mt-0.5 size-3 shrink-0 text-muted-foreground/40" />
                                        <span class="text-muted-foreground text-xs leading-relaxed">@change</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum ReleaseType { Major, Minor, Patch }

    private record Release(string Id, string Date, string Month, string Day, string Version, string Title, string Description, string[] Changes, ReleaseType Type);

    private static readonly Release[] _releases =
    [
        new("r1", "Mar 15", "Mar", "15", "v3.0.0", "Platform redesign and new editor",
            "Complete UI overhaul with a new block-based editor, redesigned navigation, and dark mode support across all surfaces.",
            [
                "Block-based content editor with 24 block types",
                "Redesigned sidebar navigation with collapsible sections",
                "System-aware dark mode with manual override toggle",
                "New keyboard shortcuts for all major actions",
            ],
            ReleaseType.Major),
        new("r2", "Feb 28", "Feb", "28", "v2.8.0", "Real-time collaboration",
            "Multiple users can now edit documents simultaneously with live cursors, presence indicators, and conflict-free merging.",
            [
                "Live cursor tracking with user avatars",
                "Presence indicators in the document header",
                "Operational transform engine for conflict resolution",
                "Comment threads with @mentions and notifications",
            ],
            ReleaseType.Major),
        new("r3", "Feb 12", "Feb", "12", "v2.7.2", "Performance and stability fixes",
            "Resolved critical rendering issues on Safari, reduced bundle size by 18%, and fixed a memory leak in the websocket connection handler.",
            [
                "Fixed Safari flexbox rendering in dashboard grids",
                "Tree-shook unused icon imports saving 42KB gzipped",
                "Patched websocket reconnection memory leak",
                "Improved initial load time from 2.8s to 1.9s",
            ],
            ReleaseType.Patch),
        new("r4", "Jan 20", "Jan", "20", "v2.7.0", "API v2 and webhook system",
            "Released the second generation REST API with pagination, filtering, and a new webhook delivery system with retry logic and event logs.",
            [
                "REST API v2 with cursor-based pagination",
                "Webhook system with configurable retry policies",
                "API key scoping with granular permission sets",
                "Interactive API explorer in the developer portal",
            ],
            ReleaseType.Minor),
        new("r5", "Jan 5", "Jan", "05", "v2.6.0", "Team workspaces and permissions",
            "Introduced shared team workspaces with role-based access controls, activity audit logs, and guest user invitations.",
            [
                "Team workspaces with owner, admin, member, and viewer roles",
                "Activity audit log with filterable event stream",
                "Guest invitations with time-limited access tokens",
                "Workspace-level billing and usage dashboards",
            ],
            ReleaseType.Minor),
    ];

    private string? _expanded = "r1";

    private void SetExpanded(string id, bool wasExpanded)
    {
        _expanded = wasExpanded ? null : id;
    }
}
