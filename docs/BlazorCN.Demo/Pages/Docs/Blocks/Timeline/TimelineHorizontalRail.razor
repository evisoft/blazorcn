@* ============================================================
   Block: timeline-horizontal-rail
   Title: TimelineHorizontalRail
   Description: React timeline with train-track rail design, notch markers, and hanging card entries using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-horizontal-rail.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="train-front" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Version Roadmap</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">@_stops.Length releases</span>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Shipped
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    Current
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-muted-foreground"></span>
                    Planned
                </span>
            </div>
        </div>

        @* Rail *@
        <div class="overflow-x-auto">
            <div class="min-w-[750px] px-8 pt-6 pb-6">
                <div class="relative">
                    @* Thick rail bar *@
                    <div class="absolute top-0 right-0 left-0 h-1 rounded-full bg-border"></div>
                    @* Filled portion *@
                    <div class="absolute top-0 left-0 h-1 rounded-full bg-foreground"
                         style="@(FormattableString.Invariant($"width:{_filledWidthPct}%"))">
                    </div>

                    @* Stops *@
                    <div class="relative flex justify-between">
                        @foreach (var st in _stops)
                        {
                            var stop = st;
                            var config = GetConfig(stop.Status);
                            var isExpanded = _expandedStop == stop.Id;
                            <div class="flex flex-col items-center">
                                @* Notch marker *@
                                <div class="@($"relative z-10 -mt-[3px] h-2.5 w-3 rounded-sm {config.Notch}")"></div>

                                @* Vertical connector *@
                                <div class="h-4 w-px bg-border"></div>

                                @* Card *@
                                <div class="w-40">
                                    <button type="button"
                                            @onclick="@(() => ToggleStop(stop.Id))"
                                            class="w-full rounded-md border bg-card p-3 text-left transition-colors hover:bg-muted/50">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-1.5">
                                                <span class="@($"size-1.5 rounded-full {config.Dot}")"></span>
                                                <span class="font-mono font-medium text-sm">@stop.Version</span>
                                            </div>
                                            <LucideIconCn Name="chevron-right"
                                                          Size="14"
                                                          Class="@($"size-3.5 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                                        </div>
                                        <p class="mt-1 font-medium text-muted-foreground text-xs">@stop.Codename</p>
                                        <span class="mt-0.5 block font-mono text-muted-foreground text-[10px]">@stop.Date</span>

                                        @if (isExpanded)
                                        {
                                            <div class="mt-2 space-y-1 border-t pt-2">
                                                @foreach (var highlight in stop.Highlights)
                                                {
                                                    <p class="text-muted-foreground text-xs">@highlight</p>
                                                }
                                            </div>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private enum StopStatus { Shipped, Current, Planned }

    private record Stop(string Id, string Version, string Codename, string Date, string[] Highlights, StopStatus Status);

    private record StatusConfig(string Notch, string Dot, string Text);

    private static StatusConfig GetConfig(StopStatus status) => status switch
    {
        StopStatus.Shipped => new StatusConfig("bg-foreground", "bg-emerald-500", "Shipped"),
        StopStatus.Current => new StatusConfig("bg-foreground ring-2 ring-foreground/20 ring-offset-2 ring-offset-card", "bg-blue-500", "In Development"),
        StopStatus.Planned => new StatusConfig("bg-border", "bg-muted-foreground", "Planned"),
        _ => new StatusConfig("", "", "")
    };

    private static readonly Stop[] _stops =
    [
        new("st1", "v3.0", "Atlas", "Feb 2025", ["New auth system", "Webhook support", "Rate limiting"], StopStatus.Shipped),
        new("st2", "v3.1", "Beacon", "May 2025", ["Real-time events", "Team roles", "Audit logs"], StopStatus.Shipped),
        new("st3", "v3.2", "Compass", "Aug 2025", ["GraphQL API", "Custom fields", "Bulk operations"], StopStatus.Current),
        new("st4", "v3.3", "Drift", "Nov 2025", ["AI assistant", "Smart search", "Workflow builder"], StopStatus.Planned),
        new("st5", "v4.0", "Eclipse", "Feb 2026", ["Platform v2", "Plugin SDK", "Multi-region"], StopStatus.Planned),
    ];

    private string? _expandedStop = "st3";

    private double _filledWidthPct => ((Array.FindIndex(_stops, s => s.Status == StopStatus.Current) + 0.5) / _stops.Length) * 100;

    private void ToggleStop(string id)
    {
        _expandedStop = _expandedStop == id ? null : id;
    }
}
