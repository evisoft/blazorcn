@* ============================================================
   Block: timeline-numbered-steps
   Title: TimelineNumberedSteps
   Description: React timeline with numbered circle markers. Built with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-numbered-steps.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Release process</span>
                <div class="flex items-center gap-2">
                    <span class="text-muted-foreground text-xs">
                        Step @(_currentStepIndex + 1) of @_steps.Length
                    </span>
                </div>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Track each phase from requirements to production
            </p>
        </div>

        @* Timeline *@
        <div class="relative">
            @* Connecting line *@
            <div class="absolute top-0 bottom-0 left-[31px] w-px bg-border"></div>

            @foreach (var step in _steps)
            {
                var index = System.Array.IndexOf(_steps, step);
                var isExpanded = _expanded == step.Id;
                var isLast = index == _steps.Length - 1;
                var stepNumber = index + 1;
                var stepId = step.Id;

                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => SetExpanded(stepId, isExpanded))"
                        class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Number marker *@
                        <div class="relative z-10 shrink-0">
                            @if (step.Status == StepStatus.Completed)
                            {
                                <div class="flex size-8 items-center justify-center rounded-full bg-foreground">
                                    <LucideIconCn Name="check" Size="16" Class="size-4 text-background" />
                                </div>
                            }
                            else if (step.Status == StepStatus.Current)
                            {
                                <div class="flex size-8 items-center justify-center rounded-full border-2 border-foreground bg-card">
                                    <span class="font-semibold text-sm tabular-nums">@stepNumber</span>
                                </div>
                            }
                            else
                            {
                                <div class="flex size-8 items-center justify-center rounded-full border border-border bg-card">
                                    <span class="font-medium text-muted-foreground text-sm tabular-nums">
                                        @stepNumber
                                    </span>
                                </div>
                            }
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1 pt-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", step.Status == StepStatus.Upcoming ? "text-muted-foreground" : "")">
                                    @step.Title
                                </span>
                                @if (step.Status == StepStatus.Current)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Current</BadgeCn>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-1.5">
                                <span class="text-muted-foreground text-xs">@step.Date</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@step.Description</span>
                            </div>
                        </div>

                        @* Chevron *@
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("mt-1.5 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @* Expanded detail *@
                    @if (isExpanded)
                    {
                        <div class="mb-3 ml-[44px] mr-4 rounded-md bg-muted/50 p-3">
                            <p class="text-sm leading-relaxed">@step.Detail</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum StepStatus { Completed, Current, Upcoming }

    private record Step(string Id, string Title, string Date, StepStatus Status, string Description, string Detail);

    private static readonly Step[] _steps =
    [
        new("1", "Requirements gathered", "Jan 6, 2026", StepStatus.Completed,
            "Product & engineering alignment",
            "Conducted 12 user interviews, mapped 3 user personas, and defined 28 acceptance criteria across 4 epics. PRD reviewed and signed off by all stakeholders."),
        new("2", "Technical design approved", "Jan 22, 2026", StepStatus.Completed,
            "Architecture decision records finalized",
            "Selected Next.js App Router with edge runtime. Database schema normalized to 3NF. API contract published as OpenAPI 3.1 spec. Load testing benchmarks established."),
        new("3", "Frontend implementation", "Feb 12, 2026", StepStatus.Completed,
            "Core UI components and pages built",
            "Built 34 components, 8 page layouts, and 3 interactive flows. Component test coverage at 92%. Lighthouse performance score averaging 96 across all routes."),
        new("4", "Integration testing", "Mar 3, 2026", StepStatus.Current,
            "End-to-end test suite running",
            "Playwright test suite covering 47 critical user journeys. CI pipeline running tests on every PR. 3 flaky tests identified and stabilized. Coverage gate set at 85%."),
        new("5", "Staging deployment", "Mar 17, 2026", StepStatus.Upcoming,
            "Preview environment for stakeholder review",
            "Deploy to staging environment with production-like data. Stakeholder walkthrough scheduled. Performance monitoring enabled. Rollback procedure documented."),
        new("6", "Production release", "Mar 28, 2026", StepStatus.Upcoming,
            "General availability launch",
            "Blue-green deployment with traffic shifting. Monitoring alerts configured. On-call rotation scheduled for launch week. Post-launch retrospective planned."),
    ];

    private int _currentStepIndex = System.Array.FindIndex(_steps, s => s.Status == StepStatus.Current);

    private string? _expanded = "4";

    private void SetExpanded(string id, bool isCurrentlyExpanded)
    {
        _expanded = isCurrentlyExpanded ? null : id;
    }
}
