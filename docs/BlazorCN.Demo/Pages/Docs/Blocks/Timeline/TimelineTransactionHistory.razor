@* ============================================================
   Block: timeline-transaction-history
   Title: TimelineTransactionHistory
   Description: React financial transaction timeline with color-coded payments built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-transaction-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Transaction history</span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_incomingCount in
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_outgoingCount out
                </span>
            </div>
        </div>

        @* Current balance *@
        <div class="flex items-baseline gap-1 border-b px-4 py-3">
            <span class="font-semibold text-2xl tabular-nums">$18,430.52</span>
            <span class="text-muted-foreground text-xs">current balance</span>
        </div>

        @* Timeline *@
        <div class="py-1">
            @foreach (var tx in _transactions)
            {
                var isLast = tx.Id == _transactions[_transactions.Length - 1].Id;
                var isExpanded = _expanded == tx.Id;
                var txItem = tx;
                var dotClass = tx.Direction == Direction.Incoming ? "bg-emerald-500" : "bg-red-500";
                var iconName = tx.Direction == Direction.Incoming ? "arrow-down-left" : "arrow-up-right";
                var textClass = tx.Direction == Direction.Incoming ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400";
                var prefix = tx.Direction == Direction.Incoming ? "+" : "−";
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : txItem.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Timeline node *@
                        <div class="relative flex flex-col items-center self-stretch">
                            <div class="@($"relative z-10 mt-1 flex size-5 shrink-0 items-center justify-center rounded-full {dotClass}")">
                                <span class="text-white">
                                    <LucideIconCn Name="@iconName" Size="12" Class="size-3" />
                                </span>
                            </div>
                            @if (!isLast)
                            {
                                <div class="w-px flex-1 bg-border"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@tx.Description</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    @tx.Category
                                </BadgeCn>
                            </div>
                            <span class="mt-0.5 block text-muted-foreground text-xs">@tx.Date</span>
                        </div>

                        @* Amount + chevron *@
                        <div class="flex items-center gap-2">
                            <span class="@($"font-semibold text-sm tabular-nums {textClass}")">
                                @prefix$@tx.Amount
                            </span>
                            <LucideIconCn Name="chevron-right" Size="16" Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                        </div>
                    </button>

                    @* Expanded detail *@
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-12">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="flex items-center justify-between">
                                    <span class="font-medium text-muted-foreground text-xs">Reference</span>
                                    <span class="font-mono text-xs">@tx.Reference</span>
                                </div>
                                <div class="mt-2 flex items-center justify-between">
                                    <span class="font-medium text-muted-foreground text-xs">Balance after</span>
                                    <span class="font-semibold text-sm tabular-nums">$@tx.RunningBalance</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum Direction { Incoming, Outgoing }

    private record Transaction(string Id, string Date, string Description, string Amount, Direction Direction, string Category, string Reference, string RunningBalance);

    private string? _expanded;

    private static readonly Transaction[] _transactions =
    [
        new("t1", "Mar 24, 2026", "Client payment — Acme Corp",      "4,200.00", Direction.Incoming, "Invoice",        "INV-2026-0087", "18,430.52"),
        new("t2", "Mar 23, 2026", "AWS infrastructure",              "847.33",   Direction.Outgoing, "Cloud services", "AWS-938271",    "14,230.52"),
        new("t3", "Mar 22, 2026", "Stripe payout",                   "2,150.00", Direction.Incoming, "Revenue",        "po_3NkQ9x2eZ",  "15,077.85"),
        new("t4", "Mar 21, 2026", "Figma annual subscription",       "144.00",   Direction.Outgoing, "Software",       "FIG-10294",     "12,927.85"),
        new("t5", "Mar 20, 2026", "Consulting fee — DataSync",       "1,800.00", Direction.Incoming, "Invoice",        "INV-2026-0086", "13,071.85"),
        new("t6", "Mar 19, 2026", "Vercel Pro plan",                 "20.00",    Direction.Outgoing, "Hosting",        "VCL-88431",     "11,271.85"),
        new("t7", "Mar 18, 2026", "GitHub Team seats",               "75.00",    Direction.Outgoing, "Software",       "GH-44821",      "11,291.85"),
        new("t8", "Mar 17, 2026", "Client retainer — Meridian",      "3,500.00", Direction.Incoming, "Retainer",       "INV-2026-0085", "11,366.85"),
    ];

    private int _incomingCount => Array.FindAll(_transactions, t => t.Direction == Direction.Incoming).Length;
    private int _outgoingCount => Array.FindAll(_transactions, t => t.Direction == Direction.Outgoing).Length;
}
