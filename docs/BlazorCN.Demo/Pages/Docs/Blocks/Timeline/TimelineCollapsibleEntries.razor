@* ============================================================
   Block: timeline-collapsible-entries
   Title: TimelineCollapsibleEntries
   Description: React vertical timeline with expandable entries that reveal detail panels, built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-collapsible-entries.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Project timeline</span>
            <span class="text-muted-foreground text-xs">
                @_entries.Count(e => e.Status == EntryStatus.Completed) of @_entries.Length completed
            </span>
        </div>

        @* Timeline entries *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var entry in _entries)
                {
                    var index = System.Array.IndexOf(_entries, entry);
                    var isLast = index == _entries.Length - 1;
                    var isExpanded = _expanded.Contains(entry.Id);
                    var dotClass = entry.Status == EntryStatus.Completed
                        ? "border-emerald-500 bg-emerald-500"
                        : entry.Status == EntryStatus.Current
                            ? "border-blue-500 bg-blue-500"
                            : "border-muted-foreground/30 bg-transparent";
                    var lineClass = entry.Status == EntryStatus.Completed
                        ? "bg-emerald-500/40"
                        : entry.Status == EntryStatus.Current
                            ? "bg-gradient-to-b from-blue-500/40 to-muted-foreground/15"
                            : "bg-muted-foreground/15";
                    var chevronClass = isExpanded
                        ? "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 rotate-90"
                        : "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200";

                    <div class="relative flex gap-4">
                        @* Line + Dot column *@
                        <div class="flex flex-col items-center">
                            <div class="@Cn.Merge("relative z-10 flex size-6 shrink-0 items-center justify-center rounded-full border-2", dotClass)">
                                @if (entry.Status == EntryStatus.Completed)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-white" />
                                }
                                else if (entry.Status == EntryStatus.Current)
                                {
                                    <LucideIconCn Name="circle-dot" Size="12" Class="size-3 text-white" />
                                    <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                }
                                else
                                {
                                    <LucideIconCn Name="circle" Size="12" Class="size-3 text-muted-foreground/40" />
                                }
                            </div>
                            @if (!isLast)
                            {
                                <div class="@Cn.Merge("w-0.5 flex-1", lineClass)"></div>
                            }
                        </div>

                        @* Content column *@
                        <div class="@Cn.Merge("min-w-0 flex-1 pt-0.5", isLast ? "pb-0" : "pb-6")">
                            @{
                                var entryId = entry.Id;
                            }
                            <button type="button"
                                    @onclick="@(() => Toggle(entryId))"
                                    class="-ml-1 flex w-full items-center gap-2 rounded-md px-1 py-0.5 text-left transition-colors hover:bg-muted/50">
                                <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="font-medium text-sm">@entry.Title</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@entry.Tag</BadgeCn>
                                    </div>
                                    <div class="mt-0.5 flex items-center gap-2">
                                        <span class="text-muted-foreground text-xs">@entry.Date</span>
                                        <span class="text-muted-foreground text-xs">·</span>
                                        <span class="truncate text-muted-foreground text-xs">@entry.Summary</span>
                                    </div>
                                </div>
                            </button>

                            @if (isExpanded)
                            {
                                <div class="mt-2 ml-5 rounded-md bg-muted/50 p-3">
                                    <p class="text-sm leading-relaxed">@entry.Detail</p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum EntryStatus { Completed, Current, Upcoming }

    private record TimelineEntry(string Id, string Date, string Title, string Summary, string Detail, EntryStatus Status, string Tag);

    private static readonly TimelineEntry[] _entries =
    [
        new("e1", "Jan 8, 2026", "Repository created and initial commit",
            "Scaffolded the monorepo with Turborepo, configured ESLint, Prettier, and CI pipeline.",
            "Set up the project structure with apps/web and packages/ui directories. Configured TypeScript path aliases, added Husky pre-commit hooks, and established the branching strategy. The CI pipeline runs lint, type-check, and build on every pull request with a 4-minute average completion time.",
            EntryStatus.Completed, "Setup"),
        new("e2", "Jan 22, 2026", "Design system foundations shipped",
            "Published 36 primitive components with full Storybook documentation.",
            "Built the color token system with semantic naming, typography scale from xs to 4xl, and spacing primitives. Each component includes accessibility tests, keyboard navigation support, and dark mode variants. The Storybook instance auto-deploys to a preview URL on every push to the design-system branch.",
            EntryStatus.Completed, "Design"),
        new("e3", "Feb 14, 2026", "Authentication and authorization layer",
            "Implemented OAuth, magic links, and role-based access control across all routes.",
            "Integrated Better Auth with Google and GitHub OAuth providers, email magic links with 5-minute expiry, and session management with 7-day tokens. The RBAC system supports owner, admin, member, and viewer roles with granular permission checks on both API routes and server components. Rate limiting is enforced at 10 sign-in attempts per 15 minutes per IP.",
            EntryStatus.Completed, "Auth"),
        new("e4", "Mar 5, 2026", "Real-time collaboration engine",
            "WebSocket-based presence and conflict-free editing for team workspaces.",
            "Built on top of Yjs CRDT with a custom WebSocket provider. Supports real-time cursor positions, selection highlighting, and undo/redo per user. The server handles up to 500 concurrent connections per workspace with automatic reconnection and offline queue. Changes sync within 50ms on stable connections.",
            EntryStatus.Current, "Engineering"),
        new("e5", "Apr 2026", "Public beta and onboarding flow",
            "Launch to early adopters with guided setup wizard and interactive product tour.",
            "The onboarding flow includes workspace creation, team invitations, template selection, and a 5-step product tour highlighting key features. Beta access will be gated behind a waitlist with 200 invites per week. In-app feedback widgets collect NPS scores and feature requests directly from the dashboard.",
            EntryStatus.Upcoming, "Launch"),
        new("e6", "Jun 2026", "General availability and enterprise tier",
            "Production release with SSO, audit logs, and SLA-backed support for enterprise teams.",
            "GA release includes SAML SSO integration, comprehensive audit logging with 90-day retention, and a dedicated support channel with 4-hour response SLA. Enterprise billing supports annual invoicing, purchase orders, and custom seat counts. The admin console provides usage analytics, security policies, and data export tools.",
            EntryStatus.Upcoming, "Launch"),
    ];

    private readonly HashSet<string> _expanded = ["e4"];

    private void Toggle(string id)
    {
        if (_expanded.Contains(id))
            _expanded.Remove(id);
        else
            _expanded.Add(id);
    }
}
