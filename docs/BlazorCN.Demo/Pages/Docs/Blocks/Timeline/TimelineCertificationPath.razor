@* ============================================================
   Block: timeline-certification-path
   Title: TimelineCertificationPath
   Description: React certification milestones timeline with shield icons and status markers, built with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-certification-path.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Certifications</span>
                <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-emerald-500" />
                        @_earnedCount earned
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <LucideIconCn Name="circle-dashed" Size="12" Class="size-3" />
                        @_inProgressCount in progress
                    </span>
                </div>
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @for (var i = 0; i < _certifications.Length; i++)
                {
                    var cert = _certifications[i];
                    var isLast = i == _certifications.Length - 1;
                    var isEarned = cert.Status == "earned";
                    var nextIsEarned = !isLast && _certifications[i + 1].Status == "earned";

                    <div class="relative flex gap-4">
                        @* Line + Node column *@
                        <div class="flex flex-col items-center">
                            @* Badge/shield node *@
                            <div class="@Cn.Merge("relative z-10 flex size-7 shrink-0 items-center justify-center rounded-full border-2", isEarned ? "border-emerald-500 bg-emerald-500/10" : "border-dashed border-muted-foreground/40 bg-transparent")">
                                @if (isEarned)
                                {
                                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                                }
                                else
                                {
                                    <LucideIconCn Name="shield" Size="14" Class="size-3.5 text-muted-foreground/50" />
                                }
                            </div>
                            @* Connector line *@
                            @if (!isLast)
                            {
                                <div class="@Cn.Merge("w-0.5 flex-1", isEarned && nextIsEarned ? "bg-emerald-500/30" : isEarned ? "bg-gradient-to-b from-emerald-500/30 to-border" : "border-l border-dashed border-muted-foreground/20 bg-transparent")"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@Cn.Merge("min-w-0 flex-1 pt-0.5", isLast ? "pb-0" : "pb-5")">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", !isEarned ? "text-muted-foreground" : "")">
                                    @cert.Name
                                </span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-1.5 text-muted-foreground text-xs">
                                <span>@cert.Issuer</span>
                                <span>·</span>
                                <span>@cert.Date</span>
                                @if (cert.Expiry != null)
                                {
                                    <span>·</span>
                                    <span>Expires @cert.Expiry</span>
                                }
                            </div>

                            @if (cert.CredentialId != null)
                            {
                                <div class="mt-1.5 flex items-center gap-1.5">
                                    <span class="text-muted-foreground text-xs">Credential ID</span>
                                    <span class="font-mono text-xs">@cert.CredentialId</span>
                                </div>
                            }

                            <p class="@Cn.Merge("mt-1.5 text-sm leading-relaxed", isEarned ? "text-muted-foreground" : "text-muted-foreground/70")">
                                @cert.Description
                            </p>

                            @if (!isEarned)
                            {
                                <BadgeCn Variant="BadgeVariant.Outline" Class="mt-2 font-normal text-xs border-dashed">
                                    In progress
                                </BadgeCn>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Certification(
        string Id,
        string Name,
        string Issuer,
        string Date,
        string Status,
        string Description,
        string? CredentialId = null,
        string? Expiry = null
    );

    private static readonly Certification[] _certifications =
    [
        new("c1", "AWS Solutions Architect — Professional", "Amazon Web Services", "Nov 2024", "earned",
            "Advanced cloud architecture certification covering multi-account strategies, cost optimization, migration planning, and disaster recovery across AWS services.",
            "AWS-SAP-2024-7849", "Nov 2027"),
        new("c2", "Google Cloud Professional Cloud Developer", "Google Cloud", "Jun 2024", "earned",
            "Covers building scalable applications on GCP using Cloud Run, Cloud Functions, Firestore, and Pub/Sub with CI/CD best practices.",
            "GCP-PCD-2024-3291", "Jun 2026"),
        new("c3", "Certified Kubernetes Administrator", "Cloud Native Computing Foundation", "Jan 2024", "earned",
            "Demonstrated expertise in cluster management, networking, storage, security policies, and troubleshooting production Kubernetes environments.",
            "CKA-2024-LF-8812", "Jan 2027"),
        new("c4", "HashiCorp Terraform Associate", "HashiCorp", "Aug 2023", "earned",
            "Infrastructure as Code fundamentals including HCL syntax, state management, modules, provisioners, and Terraform Cloud workflows.",
            "HC-TFA-2023-4456"),
        new("c5", "AWS DevOps Engineer — Professional", "Amazon Web Services", "Target Q2 2026", "in-progress",
            "Studying for the professional-level DevOps certification covering CI/CD pipelines, monitoring, incident response, and infrastructure automation on AWS."),
        new("c6", "Certified Kubernetes Security Specialist", "Cloud Native Computing Foundation", "Target Q4 2026", "in-progress",
            "Preparing for the advanced security certification covering cluster hardening, network policies, supply chain security, and runtime monitoring."),
    ];

    private int _earnedCount => _certifications.Length > 0
        ? System.Linq.Enumerable.Count(_certifications, c => c.Status == "earned")
        : 0;

    private int _inProgressCount => _certifications.Length > 0
        ? System.Linq.Enumerable.Count(_certifications, c => c.Status == "in-progress")
        : 0;
}
