@* ============================================================
   Block: timeline-notification-center
   Title: TimelineNotificationCenter
   Description: React notification center timeline grouped by date. Built with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-notification-center.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Notifications</span>
                @if (_unreadCount > 0)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_unreadCount new</BadgeCn>
                }
            </div>
            @if (_unreadCount > 0)
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground" OnClick="MarkAllRead">
                    Mark all read
                </ButtonCn>
            }
        </div>

        @* Notification timeline grouped by date *@
        <div>
            @foreach (var grp in _groups)
            {
                var groupNotifications = _notifications.Where(n => n.Group == grp).ToArray();
                var isLastGroup = grp == _groups[_groups.Length - 1];
                <div class="@(isLastGroup ? "" : "border-b")">
                    @* Group date label *@
                    <div class="px-4 pt-3 pb-1">
                        <span class="font-medium text-muted-foreground text-xs">@grp</span>
                    </div>

                    @* Notifications in this group *@
                    <div class="px-4 pb-2">
                        <div class="relative">
                            @for (int i = 0; i < groupNotifications.Length; i++)
                            {
                                var notification = groupNotifications[i];
                                var isLast = i == groupNotifications.Length - 1;
                                var config = _typeConfig[notification.Type];
                                <div class="relative flex gap-3">
                                    @* Timeline column *@
                                    <div class="flex flex-col items-center">
                                        @* Icon node *@
                                        <div class="@Cn.Merge("relative z-10 flex size-8 shrink-0 items-center justify-center rounded-full border bg-card", notification.IsRead ? "text-muted-foreground/60" : "text-foreground")">
                                            <LucideIconCn Name="@config.IconName" Size="14" Class="size-3.5" />
                                            @* Unread blue dot *@
                                            @if (!notification.IsRead)
                                            {
                                                <span class="absolute -top-0.5 -right-0.5 size-2.5 rounded-full bg-blue-500 ring-2 ring-card"></span>
                                            }
                                        </div>
                                        @* Connector line *@
                                        @if (!isLast)
                                        {
                                            <div class="w-px flex-1 bg-border"></div>
                                        }
                                    </div>

                                    @* Content *@
                                    <div class="@Cn.Merge("min-w-0 flex-1", isLast ? "pb-1" : "pb-4")">
                                        <div class="flex items-start justify-between gap-2">
                                            <div class="min-w-0 flex-1">
                                                <p class="@Cn.Merge("text-sm", notification.IsRead ? "text-muted-foreground" : "font-medium")">
                                                    @notification.Title
                                                </p>
                                                <p class="mt-0.5 truncate text-muted-foreground text-xs">
                                                    @notification.Description
                                                </p>
                                            </div>
                                            <span class="shrink-0 pt-0.5 text-muted-foreground text-xs">
                                                @notification.Timestamp
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum NotificationType { Comment, Mention, Deploy, Alert, Member, Pr, Setting }

    private record NotificationItem(string Id, NotificationType Type, string Title, string Description, string Timestamp, bool IsRead, string Group);

    private record TypeConfigEntry(string IconName, string Dot);

    private static readonly Dictionary<NotificationType, TypeConfigEntry> _typeConfig = new()
    {
        [NotificationType.Comment] = new("message-square", "bg-foreground/80"),
        [NotificationType.Mention] = new("zap", "bg-blue-500"),
        [NotificationType.Deploy]  = new("check-circle-2", "bg-emerald-500"),
        [NotificationType.Alert]   = new("alert-triangle", "bg-amber-500"),
        [NotificationType.Member]  = new("user-plus", "bg-violet-500"),
        [NotificationType.Pr]      = new("git-pull-request", "bg-foreground/80"),
        [NotificationType.Setting] = new("settings", "bg-muted-foreground"),
    };

    private static readonly NotificationItem[] _initialNotifications =
    [
        new("n1",  NotificationType.Mention,  "Sarah Chen mentioned you",      @"in ""API migration plan for Q2""",                         "5 min ago",              false, "Today"),
        new("n2",  NotificationType.Deploy,   "Deployment succeeded",           "v2.4.1 deployed to production in 2m 14s",                    "22 min ago",             false, "Today"),
        new("n3",  NotificationType.Comment,  "Marcus Rivera commented",        @"on PR #847 ""Fix WebSocket reconnection""",                  "1 hour ago",             false, "Today"),
        new("n4",  NotificationType.Alert,    "Error rate spike detected",      "API endpoint /users/sync returned 5xx errors at 3.2% rate",  "2 hours ago",            true,  "Today"),
        new("n5",  NotificationType.Pr,       "Pull request approved",          @"Ava Patel approved #842 ""Migrate billing API""",            "3 hours ago",            true,  "Today"),
        new("n6",  NotificationType.Member,   "New team member joined",         "Kai Nakamura accepted the invitation to Engineering",         "Yesterday at 4:30 PM",   true,  "Yesterday"),
        new("n7",  NotificationType.Deploy,   "Deployment succeeded",           "v2.4.0 deployed to production in 1m 48s",                    "Yesterday at 2:15 PM",   true,  "Yesterday"),
        new("n8",  NotificationType.Comment,  "James Wilson replied",           @"to your comment in ""Rate limiter investigation""",          "Yesterday at 11:00 AM",  true,  "Yesterday"),
        new("n9",  NotificationType.Setting,  "Billing updated",                "Team plan renewed for the next billing cycle",                "Mar 22 at 9:00 AM",      true,  "Earlier"),
        new("n10", NotificationType.Alert,    "SSL certificate expiring",       "Certificate for api.acme.com expires in 14 days",            "Mar 21 at 3:00 PM",      true,  "Earlier"),
        new("n11", NotificationType.Pr,       "Pull request merged",            @"Elena Vasquez merged #838 ""Add OpenTelemetry tracing""",    "Mar 20 at 10:30 AM",     true,  "Earlier"),
    ];

    private static readonly string[] _allGroups = ["Today", "Yesterday", "Earlier"];

    private NotificationItem[] _notifications = _initialNotifications.ToArray();

    private int _unreadCount => _notifications.Count(n => !n.IsRead);

    private string[] _groups => _allGroups.Where(g => _notifications.Any(n => n.Group == g)).ToArray();

    private void MarkAllRead()
    {
        _notifications = _notifications.Select(n => n with { IsRead = true }).ToArray();
    }
}
