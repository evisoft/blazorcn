@* ============================================================
   Block: timeline-email-thread
   Title: TimelineEmailThread
   Description: React email conversation timeline with read status built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-email-thread.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Email thread</span>
                <span class="text-muted-foreground text-xs">@_emails.Length messages</span>
            </div>
            @if (_unreadCount > 0)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_unreadCount unread
                </BadgeCn>
            }
        </div>

        @* Subject bar *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">Q2 infrastructure budget proposal</p>
            <div class="mt-1 flex items-center gap-2">
                <span class="text-muted-foreground text-xs">
                    David Park, Maya Rodriguez, James Liu
                </span>
            </div>
        </div>

        @* Email timeline *@
        <div class="px-4 py-3">
            <div class="relative">
                @foreach (var email in _emails)
                {
                    var isLast = email.Id == _emails[_emails.Length - 1].Id;
                    var isExpanded = _expanded == email.Id;
                    var emailItem = email;
                    <div class="relative flex gap-3 pb-0">
                        @* Line + icon column *@
                        <div class="flex flex-col items-center">
                            @* Mail icon node *@
                            <div class="relative z-10 flex size-8 shrink-0 items-center justify-center rounded-full border bg-card">
                                <LucideIconCn Name="@(email.IsRead ? "mail-open" : "mail")" Size="14" Class="@("size-3.5 " + (email.IsRead ? "text-muted-foreground/60" : "text-foreground"))" />
                                @* Unread dot *@
                                @if (!email.IsRead)
                                {
                                    <span class="absolute -top-0.5 -right-0.5 size-2 rounded-full bg-blue-500 ring-2 ring-card"></span>
                                }
                            </div>
                            @* Connector line *@
                            @if (!isLast)
                            {
                                <div class="w-px flex-1 bg-border"></div>
                            }
                        </div>

                        @* Content column *@
                        <div class="@("min-w-0 flex-1 " + (isLast ? "pb-0" : "pb-4"))">
                            <button
                                type="button"
                                @onclick="@(() => SetExpanded(emailItem.Id, isExpanded))"
                                class="-ml-1 flex w-full items-start gap-2 rounded-md px-1 py-0.5 text-left transition-colors hover:bg-muted/50">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="@("text-sm " + (email.IsRead ? "text-muted-foreground" : "font-medium"))">
                                            @email.Sender.Name
                                        </span>
                                        @if (email.IsReply)
                                        {
                                            <LucideIconCn Name="reply" Size="12" Class="size-3 text-muted-foreground/50" />
                                        }
                                        @if (email.HasAttachment)
                                        {
                                            <LucideIconCn Name="paperclip" Size="12" Class="size-3 text-muted-foreground/50" />
                                        }
                                        <span class="ml-auto shrink-0 text-muted-foreground text-xs">
                                            @email.Timestamp
                                        </span>
                                    </div>
                                    <p class="mt-0.5 truncate text-muted-foreground text-xs">
                                        @email.Preview
                                    </p>
                                </div>
                                <LucideIconCn Name="chevron-right" Size="16" Class="@("mt-0.5 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 " + (isExpanded ? "rotate-90" : ""))" />
                            </button>

                            @* Expanded body *@
                            @if (isExpanded)
                            {
                                <div class="mt-2 ml-0 rounded-md bg-muted/50 p-3">
                                    <div class="mb-2 flex items-center gap-2">
                                        <span class="font-medium text-xs">@email.Sender.Name</span>
                                        <span class="text-muted-foreground text-xs">&lt;@email.Sender.Email&gt;</span>
                                    </div>
                                    <p class="text-sm leading-relaxed">@email.Body</p>
                                    @if (email.HasAttachment)
                                    {
                                        <div class="mt-2 flex items-center gap-1.5 text-muted-foreground text-xs">
                                            <LucideIconCn Name="paperclip" Size="12" Class="size-3" />
                                            <span>1 attachment</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record EmailSender(string Name, string Email);
    private record EmailItem(
        string Id,
        EmailSender Sender,
        string Subject,
        string Preview,
        string Body,
        string Timestamp,
        bool IsRead,
        bool HasAttachment = false,
        bool IsReply = false
    );

    private static readonly EmailItem[] _emails =
    [
        new("e1",
            new("David Park", "david@acmecorp.com"),
            "Q2 infrastructure budget proposal",
            "Hi team, I have put together the infrastructure budget for Q2. We are looking at a 15% increase in cloud spend due to the new multi-region setup.",
            "Hi team, I have put together the infrastructure budget for Q2. We are looking at a 15% increase in cloud spend due to the new multi-region setup. The main cost drivers are the additional Kubernetes clusters in EU-West and AP-Southeast, plus the expanded RDS instances for read replicas. I have itemized everything in the attached spreadsheet. Let me know if you have questions before the Friday review.",
            "9:15 AM",
