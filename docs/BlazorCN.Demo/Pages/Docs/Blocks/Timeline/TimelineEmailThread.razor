            HasAttachment: true),
        new("e2",
            new("Maya Rodriguez", "maya@acmecorp.com"),
            "Re: Q2 infrastructure budget proposal",
            "Thanks David. The multi-region costs look reasonable. One question — did you factor in the reserved instance savings for the RDS clusters?",
            "Thanks David. The multi-region costs look reasonable. One question — did you factor in the reserved instance savings for the RDS clusters? We committed to 1-year reserved instances last quarter which should offset about 30% of the new read replica costs. Also, should we budget for the Cloudflare enterprise upgrade that the security team requested?",
            "9:42 AM",
            true,
            IsReply: true),
        new("e3",
            new("David Park", "david@acmecorp.com"),
            "Re: Q2 infrastructure budget proposal",
            "Good catch on the reserved instances. I have updated the spreadsheet — the adjusted total is $47,200/mo, down from $52,800.",
            "Good catch on the reserved instances. I have updated the spreadsheet — the adjusted total is $47,200/mo, down from $52,800. I did not include the Cloudflare upgrade yet. Can you get me a quote from the security team? I will add it as a separate line item so we can present it as optional to finance.",
            "10:18 AM",
            true,
            HasAttachment: true,
            IsReply: true),
        new("e4",
            new("James Liu", "james@acmecorp.com"),
            "Re: Q2 infrastructure budget proposal",
            "Adding myself to this thread. The Cloudflare enterprise plan is $4,800/mo. Includes WAF rules, bot management, and the advanced DDoS package.",
            "Adding myself to this thread. The Cloudflare enterprise plan is $4,800/mo. Includes WAF rules, bot management, and the advanced DDoS package we discussed after the March incident. I would classify this as a must-have rather than optional given our current threat model. Happy to present the security case to finance if needed.",
            "11:05 AM",
            false,
            IsReply: true),
        new("e5",
            new("Maya Rodriguez", "maya@acmecorp.com"),
            "Re: Q2 infrastructure budget proposal",
            "Agreed with James on the Cloudflare upgrade. David, can you send the final version with all line items to finance by Thursday EOD?",
            "Agreed with James on the Cloudflare upgrade. David, can you send the final version with all line items to finance by Thursday EOD? I will schedule the review meeting for Friday at 2pm. Loop in the VP of Engineering so we can get approval in one session instead of the usual back-and-forth.",
            "11:30 AM",
            false,
            IsReply: true),
        new("e6",
            new("David Park", "david@acmecorp.com"),
            "Re: Q2 infrastructure budget proposal",
            "Will do. Final budget including Cloudflare comes to $52,000/mo. I will have the deck ready by Thursday noon.",
            "Will do. Final budget including Cloudflare comes to $52,000/mo. I will have the deck ready by Thursday noon so you all can review before I send to finance. I am also adding a cost optimization section showing how we reduced the original estimate by $5,600/mo through reserved instances — should help with the approval.",
            "11:48 AM",
            false,
            IsReply: true),
    ];

    private string? _expanded = "e4";

    private int _unreadCount => Array.FindAll(_emails, e => !e.IsRead).Length;

    private void SetExpanded(string id, bool isCurrentlyExpanded)
    {
        _expanded = isCurrentlyExpanded ? null : id;
    }
}
