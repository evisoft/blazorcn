@* ============================================================
   Block: timeline-with-tags
   Title: TimelineWithTags
   Description: A React timeline with filterable category tags built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-with-tags.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="tag" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Changelog</span>
            </div>
            <span class="text-muted-foreground text-xs">
                @_filtered.Length of @_entries.Length entries
            </span>
        </div>

        @* Tag legend / filter bar *@
        <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-2.5">
            <LucideIconCn Name="filter" Size="12" Class="mr-0.5 size-3 text-muted-foreground/60" />
            <ButtonCn Variant="@(_activeTag == null ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                      Size="ButtonSize.Sm"
                      Class="h-6 px-2 text-xs"
                      OnClick="SetTagAll">
                All
            </ButtonCn>
            @foreach (var tag in _tagStyles.Keys)
            {
                var tagItem = tag;
                var style = _tagStyles[tagItem];
                var isActive = _activeTag == tagItem;
                <ButtonCn Variant="@(isActive ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-6 gap-1 px-2 text-xs"
                          OnClick="@(() => ToggleTag(tagItem))">
                    <span class="@($"size-1.5 rounded-full {style.Dot}")"></span>
                    @tagItem
                    <span class="text-muted-foreground/60 tabular-nums">@GetTagCount(tagItem)</span>
                </ButtonCn>
            }
        </div>

        @* Timeline *@
        <div class="px-4 py-3">
            <div class="relative">
                @for (var i = 0; i < _filtered.Length; i++)
                {
                    var entry = _filtered[i];
                    var isLast = i == _filtered.Length - 1;
                    var pbClass = isLast ? "pb-0" : "pb-5";
                    <div class="relative flex gap-3">
                        @* Line + dot *@
                        <div class="flex flex-col items-center">
                            <div class="relative z-10 mt-1.5 flex size-2.5 shrink-0 items-center justify-center rounded-full border-2 border-foreground/30 bg-card"></div>
                            @if (!isLast)
                            {
                                <div class="w-px flex-1 bg-border"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@($"min-w-0 flex-1 {pbClass}")">
                            <div class="flex items-start justify-between gap-2">
                                <span class="font-medium text-sm">@entry.Title</span>
                                <span class="shrink-0 text-muted-foreground text-xs">@entry.Date</span>
                            </div>
                            <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                                @entry.Description
                            </p>

                            @* Tags *@
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                @foreach (var entryTag in entry.Tags)
                                {
                                    var tagName = entryTag;
                                    var tagStyle = _tagStyles[tagName];
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"gap-1 border-0 font-normal text-xs {tagStyle.Bg} {tagStyle.Text}")">
                                        <span class="@($"size-1.5 rounded-full {tagStyle.Dot}")"></span>
                                        @tagName
                                    </BadgeCn>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TagStyle(string Dot, string Bg, string Text);
    private record TimelineEntry(string Id, string Date, string Title, string Description, string[] Tags);

    private static readonly Dictionary<string, TagStyle> _tagStyles = new()
    {
        ["Engineering"]    = new("bg-blue-500",    "bg-blue-500/10",    "text-blue-700 dark:text-blue-300"),
        ["Design"]         = new("bg-violet-500",  "bg-violet-500/10",  "text-violet-700 dark:text-violet-300"),
        ["Marketing"]      = new("bg-amber-500",   "bg-amber-500/10",   "text-amber-700 dark:text-amber-300"),
        ["Infrastructure"] = new("bg-emerald-500", "bg-emerald-500/10", "text-emerald-700 dark:text-emerald-300"),
        ["Security"]       = new("bg-red-500",     "bg-red-500/10",     "text-red-700 dark:text-red-300"),
        ["Product"]        = new("bg-cyan-500",    "bg-cyan-500/10",    "text-cyan-700 dark:text-cyan-300"),
    };

    private static readonly TimelineEntry[] _entries =
    [
        new("e1", "Mar 24, 2026", "OAuth provider migration to PKCE flow",
            "Migrated all OAuth integrations from implicit grant to PKCE authorization code flow. Updated Google, GitHub, and Microsoft providers. Session tokens now rotate on every refresh.",
            ["Engineering", "Security"]),
        new("e2", "Mar 21, 2026", "Product Hunt launch campaign",
            "Coordinated launch day with teaser emails, social media blitz, and community outreach. Achieved 1,847 upvotes and #2 Product of the Day. 3,200 signups in 24 hours.",
            ["Marketing", "Product"]),
        new("e3", "Mar 18, 2026", "Edge CDN rollout to 12 new regions",
            "Expanded edge network to cover South America, Southeast Asia, and Africa. P95 latency for those regions dropped from 380ms to 62ms. Cache hit ratio above 94%.",
            ["Infrastructure", "Engineering"]),
        new("e4", "Mar 14, 2026", "Component library v2 shipped",
            "Released 28 new components including data tables, chart primitives, and form builders. Updated all existing components to support the new theming system. Full Figma sync enabled.",
            ["Design", "Engineering"]),
        new("e5", "Mar 10, 2026", "Penetration test completed",
            "Third-party security firm completed the annual penetration test. Zero critical vulnerabilities found. Three medium-severity issues patched within 72 hours. Report delivered to compliance team.",
            ["Security"]),
        new("e6", "Mar 6, 2026", "Onboarding flow redesign live",
            "Shipped the new 3-step onboarding with progressive profiling, workspace templates, and sample data generation. Time-to-first-value reduced from 12 minutes to 90 seconds.",
            ["Product", "Design", "Marketing"]),
        new("e7", "Mar 2, 2026", "Database failover testing",
            "Conducted planned failover drill across primary and replica clusters. Recovery time was 4.2 seconds with zero data loss. Automated runbook executed successfully.",
            ["Infrastructure", "Security"]),
    ];

    private string? _activeTag = null;

    private TimelineEntry[] _filtered
    {
        get
        {
            var tag = _activeTag;
            return tag is null ? _entries : Array.FindAll(_entries, e => e.Tags.Contains(tag));
        }
    }

    private int GetTagCount(string tag) => Array.FindAll(_entries, e => e.Tags.Contains(tag)).Length;

    private void SetTagAll() => _activeTag = null;
    private void ToggleTag(string tag) => _activeTag = (_activeTag == tag) ? null : tag;
}
