@* ============================================================
   Block: timeline-selectable
   Title: TimelineSelectable
   Description: React timeline with multi-select checkboxes. Built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-selectable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Event log</span>
                @if (_selected.Count > 0)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal tabular-nums text-xs">
                        @_selected.Count selected
                    </BadgeCn>
                }
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="ToggleAll">
                @(_allSelected ? "Deselect all" : "Select all")
            </ButtonCn>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @for (var i = 0; i < _entries.Length; i++)
                {
                    var entry = _entries[i];
                    var isLast = i == _entries.Length - 1;
                    var isSelected = _selected.Contains(entry.Id);
                    var pbClass = isLast ? "pb-0" : "pb-6";
                    var dotClass = isSelected
                        ? "border-blue-500 bg-blue-500 ring-2 ring-blue-500/20"
                        : "border-muted-foreground/30 bg-card";
                    var contentRowClass = isSelected
                        ? "-ml-1 flex cursor-pointer items-start gap-2.5 rounded-md px-1 py-1 transition-colors hover:bg-muted/50 bg-muted/30"
                        : "-ml-1 flex cursor-pointer items-start gap-2.5 rounded-md px-1 py-1 transition-colors hover:bg-muted/50";
                    <div class="relative flex gap-4">
                        @* Line + Dot column *@
                        <div class="flex flex-col items-center">
                            <div class="@($"relative z-10 flex size-6 shrink-0 items-center justify-center rounded-full border-2 transition-all {dotClass}")">
                                @if (isSelected)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-white" />
                                }
                                else
                                {
                                    <span class="size-2 rounded-full bg-muted-foreground/20"></span>
                                }
                            </div>
                            @if (!isLast)
                            {
                                <div class="w-0.5 flex-1 bg-muted-foreground/15"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@($"{pbClass} min-w-0 flex-1 pt-0.5")">
                            <label for="@($"tl-sel-{entry.Id}")" class="@contentRowClass">
                                <CheckboxCn id="@($"tl-sel-{entry.Id}")"
                                            aria-label="@($"Select {entry.Title}")" Checked="@isSelected"
                                            CheckedChanged="@((bool v) => Toggle(entry.Id))"
                                            Class="mt-0.5 shrink-0" />
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="font-medium text-sm">@entry.Title</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                            @entry.Tag
                                        </BadgeCn>
                                    </div>
                                    <span class="mt-0.5 block text-muted-foreground text-xs">
                                        @entry.Date
                                    </span>
                                    <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                                        @entry.Description
                                    </p>
                                </div>
                            </label>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        @if (_selected.Count > 0)
        {
            <div class="flex items-center justify-between border-t px-4 py-3">
                <span class="text-muted-foreground text-xs">
                    @_selected.Count of @_entries.Length entries selected
                </span>
                <div class="flex items-center gap-1.5">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Export
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Archive
                    </ButtonCn>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record TimelineEntry(string Id, string Date, string Title, string Description, string Tag);

    private static readonly TimelineEntry[] _entries =
    [
        new("e1", "Jan 8, 2026", "API rate limiting implemented",
            "Added sliding window rate limits of 100 requests per minute per API key. Returns 429 status with Retry-After header. Tracked per endpoint with Redis counters.",
            "Backend"),
        new("e2", "Jan 21, 2026", "Dashboard analytics redesign",
            "Rebuilt the analytics dashboard with new chart library. Added custom date range picker, CSV export, and comparison mode for week-over-week metrics.",
            "Frontend"),
        new("e3", "Feb 4, 2026", "Email notification preferences",
            "Users can now configure granular email preferences: digest frequency, event types, and quiet hours. Includes one-click unsubscribe and preference center link in every email.",
            "Feature"),
        new("e4", "Feb 18, 2026", "Database connection pooling upgrade",
            "Migrated from PgBouncer to Supavisor for connection pooling. Connection establishment time dropped from 45ms to 8ms. Supports up to 10,000 concurrent connections.",
            "Infrastructure"),
        new("e5", "Mar 3, 2026", "Accessibility audit and remediation",
            "Completed WCAG 2.1 AA audit across all pages. Fixed 23 critical issues: missing alt text, low contrast ratios, keyboard traps, and missing ARIA labels on interactive elements.",
            "Quality"),
        new("e6", "Mar 12, 2026", "Stripe billing migration to usage-based",
            "Switched from flat-rate to usage-based billing with metered events. Customers see real-time usage in their dashboard with projected costs and configurable spending alerts.",
            "Billing"),
        new("e7", "Mar 20, 2026", "Terraform infrastructure-as-code setup",
            "Codified all AWS infrastructure in Terraform modules. VPC, ECS clusters, RDS instances, and CloudFront distributions are now version-controlled with automated plan/apply via CI.",
            "Infrastructure"),
    ];

    private HashSet<string> _selected = ["e2", "e5"];

    private bool _allSelected => _selected.Count == _entries.Length;

    private void Toggle(string id)
    {
        if (_selected.Contains(id))
            _selected.Remove(id);
        else
            _selected.Add(id);
    }

    private void ToggleAll()
    {
        if (_allSelected)
            _selected.Clear();
        else
            _selected = new HashSet<string>(_entries.Select(e => e.Id));
    }
}
