@* ============================================================
   Block: timeline-with-metrics
   Title: TimelineWithMetrics
   Description: React timeline displaying growth KPIs built with Next.js, shadcn/ui Badge, and Tailwind CSS
   Source: original/blocks/timeline/timeline-with-metrics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Growth timeline</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    MRR
                    <span class="font-semibold text-foreground tabular-nums">@_totalMrr</span>
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    Users
                    <span class="font-semibold text-foreground tabular-nums">@_totalUsers</span>
                </span>
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var ms in _milestones)
                {
                    var isLast = ms.Id == _milestones[_milestones.Length - 1].Id;
                    <div class="relative flex gap-4">
                        @* Line + Dot column *@
                        <div class="flex flex-col items-center">
                            <div class="@Cn.Merge("relative z-10 flex size-5 shrink-0 items-center justify-center rounded-full border-2", StatusDotClass(ms.Status))">
                                @if (ms.Status == "current")
                                {
                                    <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                }
                            </div>
                            @if (!isLast)
                            {
                                <div class="@($"w-0.5 flex-1 {LineColorClass(ms.Status)}")"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@Cn.Merge("min-w-0 flex-1 pt-0", isLast ? "pb-0" : "pb-6")">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@ms.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@ms.Date</BadgeCn>
                            </div>
                            <p class="mt-1 text-muted-foreground text-sm leading-relaxed">@ms.Description</p>

                            @* Metrics grid *@
                            <div class="mt-3 grid grid-cols-3 gap-2">
                                @foreach (var metric in ms.Metrics)
                                {
                                    <div class="rounded-md bg-muted/50 px-3 py-2">
                                        <span class="block text-muted-foreground text-xs">@metric.Label</span>
                                        <span class="mt-0.5 block font-semibold text-2xl tabular-nums">@metric.MetricValue</span>
                                        @if (metric.Change != null)
                                        {
                                            <span class="@Cn.Merge("mt-0.5 flex items-center gap-0.5 text-xs", metric.Change.Direction == "up" ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                                @if (metric.Change.Direction == "up")
                                                {
                                                    <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                                                }
                                                @metric.Change.ChangeValue
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record MetricChange(string ChangeValue, string Direction);
    private record Metric(string Label, string MetricValue, MetricChange? Change = null);
    private record Milestone(string Id, string Date, string Title, string Description, string Status, Metric[] Metrics);

    private const string _totalMrr = "$127K";
    private const string _totalUsers = "12,400";

    private static readonly Milestone[] _milestones =
    [
        new("m1", "Q1 2025", "Seed round closed",
            "Closed $2.1M seed round. Hired first 4 engineers and launched internal alpha with 12 design partners.",
            "completed",
            [
                new("Revenue", "$0"),
                new("Users", "12"),
                new("Team size", "6"),
            ]),
        new("m2", "Q2 2025", "Public beta launch",
            "Launched public beta with self-serve onboarding. Featured on Product Hunt with 1,200 upvotes.",
            "completed",
            [
                new("MRR", "$4.2K", new("+$4.2K", "up")),
                new("Users", "847", new("+835", "up")),
                new("Conversion", "3.2%", new("+3.2%", "up")),
            ]),
        new("m3", "Q3 2025", "Series A funding",
            "Raised $12M Series A. Expanded to 28 team members across engineering, design, and go-to-market.",
            "completed",
            [
                new("MRR", "$38K", new("+$33.8K", "up")),
                new("Users", "4,210", new("+3,363", "up")),
                new("Conversion", "5.8%", new("+2.6%", "up")),
            ]),
        new("m4", "Q4 2025", "Enterprise tier launched",
            "Shipped SSO, audit logs, and custom SLAs. Signed first 3 enterprise contracts worth $420K ARR.",
            "current",
            [
                new("MRR", "$127K", new("+$89K", "up")),
                new("Users", "12,400", new("+8,190", "up")),
                new("Churn", "2.1%", new("-1.4%", "down")),
            ]),
        new("m5", "Q1 2026", "International expansion",
            "Targeting EU and APAC markets. Projected to reach $3M ARR with 40K active users by end of quarter.",
            "upcoming",
            [
                new("MRR target", "$250K"),
                new("Users target", "40K"),
                new("NPS target", "72"),
            ]),
    ];

    private static string StatusDotClass(string status) => status switch
    {
        "completed" => "border-emerald-500 bg-emerald-500",
        "current" => "border-blue-500 bg-blue-500",
        _ => "border-muted-foreground/30 bg-transparent",
    };

    private static string LineColorClass(string status) => status switch
    {
        "completed" => "bg-emerald-500/30",
        "current" => "bg-blue-500/30",
        _ => "bg-muted-foreground/15",
    };
}
