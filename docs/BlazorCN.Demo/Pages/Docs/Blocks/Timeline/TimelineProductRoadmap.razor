@* ============================================================
   Block: timeline-product-roadmap
   Title: TimelineProductRoadmap
   Description: React product roadmap with Now/Next/Later buckets using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-product-roadmap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Product roadmap</span>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span>@_shippedCount shipped</span>
                <span class="text-muted-foreground/40">·</span>
                <span>@_totalFeatures total</span>
            </div>
        </div>

        @* Quarter axis *@
        <div class="flex items-center border-b">
            @foreach (var bkt in _buckets)
            {
                var dotClass = bkt.Key == "now"
                    ? "size-2 rounded-full bg-emerald-500"
                    : bkt.Key == "next"
                        ? "size-2 rounded-full bg-blue-500"
                        : "size-2 rounded-full bg-muted-foreground/30";
                var isNotLastAxis = bkt.Key != _buckets[_buckets.Length - 1].Key;
                <div class="@Cn.Merge("flex-1 px-4 py-2", isNotLastAxis ? "border-r" : "")">
                    <div class="flex items-center gap-2">
                        <span class="@dotClass"></span>
                        <span class="font-medium text-xs">@bkt.Label</span>
                        <span class="text-muted-foreground/60 text-xs">@bkt.Quarter</span>
                    </div>
                </div>
            }
        </div>

        @* Roadmap content *@
        <div class="flex">
            @foreach (var bkt in _buckets)
            {
                var isNotLastBucket = bkt.Key != _buckets[_buckets.Length - 1].Key;
                <div class="@Cn.Merge("flex-1", isNotLastBucket ? "border-r" : "")">
                    @* Timeline for this bucket *@
                    <div class="px-3 py-3">
                        <div class="relative">
                            @foreach (var feature in bkt.Features)
                            {
                                var isLast = feature.Id == bkt.Features[bkt.Features.Length - 1].Id;
                                var dotBorderClass = bkt.Key == "now"
                                    ? "bg-emerald-500 border-emerald-500"
                                    : bkt.Key == "next"
                                        ? "bg-blue-500 border-blue-500"
                                        : "bg-transparent border-muted-foreground/30";
                                var lineClass = bkt.Key == "now"
                                    ? "w-0.5 flex-1 bg-emerald-500/40"
                                    : bkt.Key == "next"
                                        ? "w-0.5 flex-1 bg-blue-500/40"
                                        : "w-0.5 flex-1 bg-muted-foreground/20";
                                var statusColorClass = feature.Status == "shipped"
                                    ? "text-emerald-600 dark:text-emerald-400"
                                    : feature.Status == "in-progress"
                                        ? "text-blue-600 dark:text-blue-400"
                                        : feature.Status == "planned"
                                            ? "text-muted-foreground"
                                            : "text-muted-foreground/60";
                                var statusLabel = feature.Status == "shipped"
                                    ? "Shipped"
                                    : feature.Status == "in-progress"
                                        ? "In progress"
                                        : feature.Status == "planned"
                                            ? "Planned"
                                            : "Exploring";
                                var titleColorClass = bkt.Key == "later" ? "font-medium text-sm text-muted-foreground" : "font-medium text-sm";
                                <div class="relative flex gap-3">
                                    @* Timeline column *@
                                    <div class="flex flex-col items-center">
                                        <div class="@Cn.Merge("relative z-10 flex size-5 shrink-0 items-center justify-center rounded-full border-2", dotBorderClass)">
                                            @if (bkt.Key == "now")
                                            {
                                                <LucideIconCn Name="check-circle-2" Size="10" Class="size-2.5 text-white" />
                                            }
                                            @if (bkt.Key == "next")
                                            {
                                                <span class="size-1.5 rounded-full bg-white"></span>
                                            }
                                        </div>
                                        @if (!isLast)
                                        {
                                            <div class="@lineClass"></div>
                                        }
                                    </div>

                                    @* Feature card *@
                                    <div class="@Cn.Merge("min-w-0 flex-1", isLast ? "pb-0" : "pb-4")">
                                        <div class="flex items-start gap-2">
                                            <div class="min-w-0 flex-1">
                                                <span class="@titleColorClass">@feature.Title</span>
                                                <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">@feature.Description</p>
                                            </div>
                                            <AvatarCn Class="size-6 shrink-0">
                                                <AvatarFallbackCn Class="text-[9px]">@feature.Owner.Initials</AvatarFallbackCn>
                                            </AvatarCn>
                                        </div>

                                        @* Status + Priority *@
                                        <div class="mt-1.5 flex items-center gap-2">
                                            <span class="@Cn.Merge("flex items-center gap-1 text-xs", statusColorClass)">
                                                @if (feature.Status == "shipped")
                                                {
                                                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                                                }
                                                else if (feature.Status == "in-progress")
                                                {
                                                    <LucideIconCn Name="circle-dot" Size="14" Class="size-3.5" />
                                                }
                                                else if (feature.Status == "planned")
                                                {
                                                    <LucideIconCn Name="clock" Size="14" Class="size-3.5" />
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="circle" Size="14" Class="size-3.5" />
                                                }
                                                @statusLabel
                                            </span>
                                            @if (feature.Priority == "high")
                                            {
                                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">High</BadgeCn>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FeatureOwner(string Name, string Initials);
    private record RoadmapFeature(string Id, string Title, string Description, string Status, FeatureOwner Owner, string Priority);
    private record RoadmapBucket(string Key, string Label, string Quarter, RoadmapFeature[] Features);

    private static readonly RoadmapBucket[] _buckets =
    [
        new("now", "Now", "Q1 2026",
        [
            new("f1", "Real-time collaboration", "Multi-cursor editing with presence indicators", "shipped", new("Sarah Chen", "SC"), "high"),
            new("f2", "API rate limiting dashboard", "Visual usage analytics and threshold alerts", "shipped", new("Marcus Rivera", "MR"), "high"),
            new("f3", "Webhook event log", "Searchable log with retry and payload inspection", "in-progress", new("Ava Patel", "AP"), "medium"),
        ]),
        new("next", "Next", "Q2 2026",
        [
            new("f4", "Custom workflow builder", "Drag-and-drop automation with conditional logic", "planned", new("James Wilson", "JW"), "high"),
            new("f5", "Audit trail export", "CSV and JSON export with date range filtering", "planned", new("Lina Nakamura", "LN"), "medium"),
            new("f6", "SSO with SAML 2.0", "Enterprise single sign-on for Okta, Azure AD, OneLogin", "planned", new("Sarah Chen", "SC"), "high"),
        ]),
        new("later", "Later", "Q3–Q4 2026",
        [
            new("f7", "Mobile companion app", "iOS and Android app for alerts and quick actions", "exploring", new("Omar Farouk", "OF"), "low"),
            new("f8", "AI-powered anomaly detection", "Automatic alerting on metric deviations and trend shifts", "exploring", new("Ava Patel", "AP"), "medium"),
            new("f9", "Multi-region deployment", "EU and APAC data residency with automatic routing", "exploring", new("Marcus Rivera", "MR"), "low"),
        ]),
    ];

    private int _totalFeatures => _buckets.Sum(b => b.Features.Length);
    private int _shippedCount => _buckets.Sum(b => b.Features.Count(f => f.Status == "shipped"));
}
