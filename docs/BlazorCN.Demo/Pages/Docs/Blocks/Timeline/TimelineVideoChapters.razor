@* ============================================================
   Block: timeline-video-chapters
   Title: TimelineVideoChapters
   Description: React video chapter timeline with timestamps and progress tracking built with Next.js, shadcn/ui Badge, and Tailwind CSS
   Source: original/blocks/timeline/timeline-video-chapters.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Full-stack workshop</span>
                <span class="text-muted-foreground text-xs">46:28 total</span>
            </div>
            <div class="mt-1.5 flex items-center gap-3">
                <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                    <div
                        class="h-full rounded-full bg-foreground transition-all duration-300"
                        style="@($"width:{(((_playingIndex + 0.5) / _chapters.Length) * 100):F2}%")">
                    </div>
                </div>
                <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                    @_completedCount/@_chapters.Length
                </span>
            </div>
        </div>

        @* Chapters timeline *@
        <div class="relative">
            @* Vertical spine *@
            <div class="absolute top-0 bottom-0 left-[23px] w-px">
                @* Completed portion *@
                <div
                    class="w-full bg-foreground/30 transition-all duration-300"
                    style="@($"height:{((_playingIndex / (double)(_chapters.Length - 1)) * 100):F2}%")">
                </div>
                @* Remaining portion *@
                <div
                    class="w-full flex-1 bg-border"
                    style="@($"height:{(100 - (_playingIndex / (double)(_chapters.Length - 1)) * 100):F2}%")">
                </div>
            </div>

            @foreach (var chapter in _chapters)
            {
                var ch = chapter;
                var index = Array.IndexOf(_chapters, chapter);
                var isPlaying = chapter.Id == _playing;
                var isCompleted = index < _playingIndex;
                var isLast = index == _chapters.Length - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _playing = ch.Id)"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", isPlaying ? "bg-muted/30" : "")">
                        @* Play/check marker *@
                        <div class="relative z-10 flex size-5 shrink-0 items-center justify-center">
                            @if (isPlaying)
                            {
                                <div class="flex size-5 items-center justify-center rounded-full bg-foreground">
                                    <LucideIconCn Name="pause" Size="10" Class="size-2.5 fill-background text-background" />
                                    <span class="absolute inset-0 animate-ping rounded-full bg-foreground opacity-10"></span>
                                </div>
                            }
                            else if (isCompleted)
                            {
                                <div class="flex size-5 items-center justify-center rounded-full bg-foreground/15">
                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-foreground/60" />
                                </div>
                            }
                            else
                            {
                                <div class="flex size-5 items-center justify-center rounded-full border border-muted-foreground/25 bg-card">
                                    <LucideIconCn Name="play" Size="10" Class="size-2.5 fill-muted-foreground/40 text-muted-foreground/40" />
                                </div>
                            }
                        </div>

                        @* Timestamp *@
                        <span class="w-10 shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                            @chapter.Timestamp
                        </span>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <span class="@Cn.Merge("text-sm", isPlaying ? "font-medium" : isCompleted ? "text-muted-foreground" : "font-medium")">
                                @chapter.Title
                            </span>
                        </div>

                        @* Duration *@
                        <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                            @chapter.Duration
                        </span>
                    </button>

                    @* Expanded description for current chapter *@
                    @if (isPlaying)
                    {
                        <div class="border-t border-dashed px-4 py-2.5 pl-[72px]">
                            <p class="text-muted-foreground text-xs leading-relaxed">
                                @chapter.Description
                            </p>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                Playing chapter @(_playingIndex + 1) of @_chapters.Length
            </span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_chapters[_playingIndex].Duration remaining
            </BadgeCn>
        </div>
    </div>
</section>

@code {
    private record Chapter(string Id, string Timestamp, string Title, string Duration, string Description);

    private string _playing = "c4";

    private int _playingIndex => Array.IndexOf(_chapters, Array.Find(_chapters, c => c.Id == _playing));
    private int _completedCount => _playingIndex;

    private static readonly Chapter[] _chapters =
    [
        new("c1", "0:00",  "Introduction and overview",                "2:14", "Course objectives, prerequisites, and what you will build by the end of this module."),
        new("c2", "2:14",  "Setting up the development environment",   "4:38", "Installing Node.js, creating the project scaffold, and configuring TypeScript."),
        new("c3", "6:52",  "Building the data model",                  "8:21", "Designing the database schema with Prisma, defining relations, and running migrations."),
        new("c4", "15:13", "Authentication and middleware",             "6:47", "Implementing session-based auth with JWT tokens, protected routes, and role-based access."),
        new("c5", "22:00", "Building the API layer",                   "9:15", "Creating REST endpoints, input validation with Zod, and error handling patterns."),
        new("c6", "31:15", "Frontend integration",                     "7:33", "Connecting the React frontend to the API, state management, and optimistic updates."),
        new("c7", "38:48", "Testing and deployment",                   "5:52", "Writing integration tests, CI pipeline setup, and deploying to production on Vercel."),
        new("c8", "44:40", "Summary and next steps",                   "1:48", "Recap of key concepts, additional resources, and recommended follow-up modules."),
    ];
}
