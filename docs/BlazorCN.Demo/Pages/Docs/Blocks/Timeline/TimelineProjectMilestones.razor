@* ============================================================
   Block: timeline-project-milestones
   Title: TimelineProjectMilestones
   Description: React project milestones with diamond markers using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-project-milestones.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="flag" Size="16" Class="size-4 text-muted-foreground" />
            <div class="flex-1">
                <span class="font-medium text-sm">Project Milestones</span>
                <p class="text-muted-foreground text-xs">
                    @_completedCount of @_milestones.Length milestones completed
                </p>
            </div>
            @if (_inProgressMilestone != null)
            {
                <span class="font-mono text-muted-foreground text-xs">
                    Next: @_inProgressMilestone.Date
                </span>
            }
        </div>

        @* Timeline *@
        <div class="px-4 py-5">
            @foreach (var ms in _milestones)
            {
                var idx = System.Array.IndexOf(_milestones, ms);
                var isLast = idx == _milestones.Length - 1;
                <div class="relative flex gap-4">
                    @* Diamond + line *@
                    <div class="flex flex-col items-center">
                        @* Diamond marker *@
                        @if (ms.Status == MilestoneStatus.Completed)
                        {
                            <div class="relative flex size-8 shrink-0 items-center justify-center">
                                <div class="flex size-6 rotate-45 items-center justify-center bg-foreground">
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 -rotate-45 text-background" />
                                </div>
                            </div>
                        }
                        else if (ms.Status == MilestoneStatus.InProgress)
                        {
                            <div class="relative flex size-8 shrink-0 items-center justify-center">
                                <div class="flex size-6 rotate-45 items-center justify-center border-2 border-foreground bg-card">
                                    <span class="-rotate-45 font-mono text-[9px] font-semibold text-foreground tabular-nums">
                                        @ms.Progress
                                    </span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="relative flex size-8 shrink-0 items-center justify-center">
                                <div class="size-6 rotate-45 border-2 border-muted-foreground/30 bg-card"></div>
                            </div>
                        }

                        @* Connecting line *@
                        @if (!isLast)
                        {
                            <div class="my-1 h-16 w-0.5">
                                @if (ms.Status == MilestoneStatus.Completed)
                                {
                                    <div class="h-full w-full bg-foreground"></div>
                                }
                                else if (ms.Status == MilestoneStatus.InProgress)
                                {
                                    <div class="relative h-full w-full bg-muted-foreground/20">
                                        <div class="absolute inset-x-0 top-0 bg-foreground" style="@($"height:{ms.Progress}%")"></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="h-full w-full bg-muted-foreground/20"></div>
                                }
                            </div>
                        }
                    </div>

                    @* Content *@
                    <div class="@Cn.Merge("flex-1 pt-0.5", isLast ? "pb-0" : "pb-4")">
                        @* Date *@
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="font-mono text-muted-foreground text-xs">
                                @ms.Date
                            </span>
                        </div>

                        @* Title *@
                        <span class="@Cn.Merge("mt-1 block font-medium text-sm", ms.Status == MilestoneStatus.Upcoming ? "text-muted-foreground" : "text-foreground")">
                            @ms.Title
                        </span>

                        @* Description *@
                        <p class="@Cn.Merge("mt-0.5 text-xs", ms.Status == MilestoneStatus.Upcoming ? "text-muted-foreground/60" : "text-muted-foreground")">
                            @ms.Description
                        </p>

                        @* Progress bar for in-progress *@
                        @if (ms.Status == MilestoneStatus.InProgress)
                        {
                            <div class="mt-2 flex items-center gap-2">
                                <div class="h-1 w-24 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-foreground" style="@($"width:{ms.Progress}%")"></div>
                                </div>
                                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                                    @ms.Progress%
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum MilestoneStatus { Completed, InProgress, Upcoming }

    private record Milestone(string Id, string Date, string Title, string Description, int Progress, MilestoneStatus Status);

    private static readonly Milestone[] _milestones =
    [
        new("m1", "Jan 15", "Project Kickoff", "Team assembled, requirements documented, architecture approved", 100, MilestoneStatus.Completed),
        new("m2", "Feb 12", "Design System Complete", "Component library, tokens, and Figma handoff finalized", 100, MilestoneStatus.Completed),
        new("m3", "Mar 8", "Core API Launch", "REST and GraphQL endpoints deployed to staging with docs", 100, MilestoneStatus.Completed),
        new("m4", "Apr 1", "Beta Release", "Internal beta with 50 users, feedback collection active", 62, MilestoneStatus.InProgress),
        new("m5", "May 5", "Public Launch", "Production deploy, marketing push, and press outreach", 0, MilestoneStatus.Upcoming),
    ];

    private int _completedCount => System.Array.FindAll(_milestones, m => m.Status == MilestoneStatus.Completed).Length;
    private Milestone? _inProgressMilestone => System.Array.Find(_milestones, m => m.Status == MilestoneStatus.InProgress);
}
