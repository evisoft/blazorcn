@* ============================================================
   Block: timeline-construction-phases
   Title: TimelineConstructionPhases
   Description: React construction timeline with progress rings and phase tracking, built with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-construction-phases.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="hard-hat" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Construction phases</span>
                </div>
                <span class="text-muted-foreground text-xs">8-phase project</span>
            </div>
        </div>

        @* Progress summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">@_overallProgress%</span>
                <span class="text-muted-foreground text-xs">overall</span>
            </div>
            <span class="text-muted-foreground/40 text-xs">·</span>
            <span class="text-muted-foreground text-xs">
                @_completedCount of @_phases.Length phases completed
            </span>
            @* Phase progress bar *@
            <div class="ml-auto flex items-center gap-0.5">
                @foreach (var phase in _phases)
                {
                    <div class="@($"h-1.5 w-5 rounded-full {(phase.Status == PhaseStatus.Completed ? "bg-emerald-500" : phase.Status == PhaseStatus.InProgress ? "bg-blue-500" : "bg-muted-foreground/15")}")"></div>
                }
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var phase in _phases)
                {
                    var phaseIndex = System.Array.IndexOf(_phases, phase);
                    var isLast = phaseIndex == _phases.Length - 1;
                    var isExpanded = _expanded == phase.Id;
                    var dashOffset = Circumference - (phase.Progress / 100.0) * Circumference;

                    <div class="relative flex gap-4">
                        @* Timeline column: progress node + connector *@
                        <div class="flex flex-col items-center">
                            @* Phase node *@
                            <div class="relative z-10 flex size-8 shrink-0 items-center justify-center">
                                @if (phase.Status == PhaseStatus.Completed)
                                {
                                    <div class="flex size-8 items-center justify-center rounded-full bg-emerald-500 text-white">
                                        <LucideIconCn Name="check" Size="16" Class="size-4" />
                                    </div>
                                }
                                else if (phase.Status == PhaseStatus.InProgress)
                                {
                                    <div class="relative flex size-8 items-center justify-center">
                                        @* SVG progress ring *@
                                        <svg width="28" height="28" class="absolute -rotate-90">
                                            <circle
                                                cx="14"
                                                cy="14"
                                                r="12.5"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="3"
                                                class="text-muted-foreground/15" />
                                            <circle
                                                cx="14"
                                                cy="14"
                                                r="12.5"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="3"
                                                stroke-dasharray="@Circumference.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)"
                                                stroke-dashoffset="@dashOffset.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)"
                                                stroke-linecap="round"
                                                class="text-blue-500" />
                                        </svg>
                                        <span class="relative font-semibold text-blue-600 text-xs tabular-nums dark:text-blue-400">@phase.Progress</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex size-8 items-center justify-center rounded-full border-2 border-muted-foreground/20 bg-card">
                                        <span class="font-medium text-muted-foreground/50 text-xs tabular-nums">@(phaseIndex + 1)</span>
                                    </div>
                                }
                            </div>
                            @* Connector line *@
                            @if (!isLast)
                            {
                                <div class="@($"w-px flex-1 {(phase.Status == PhaseStatus.Completed ? "bg-emerald-500/30" : phase.Status == PhaseStatus.InProgress ? "bg-gradient-to-b from-blue-500/30 to-muted-foreground/10" : "bg-muted-foreground/10")}")"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@($"{(isLast ? "pb-0" : "pb-5")} min-w-0 flex-1 pt-0.5")">
                            <button
                                type="button"
                                @onclick="@(() => ToggleExpanded(phase.Id))"
                                class="-mx-2 flex w-[calc(100%+16px)] items-center gap-2 rounded-md px-2 py-1 text-left transition-colors hover:bg-muted/50">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="@($"font-medium text-sm{(phase.Status == PhaseStatus.Upcoming ? " text-muted-foreground" : "")}")">
                                            @phase.Name
                                        </span>
                                        @if (phase.Status == PhaseStatus.InProgress)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 gap-1 px-1.5 font-normal text-xs">
                                                <span class="size-1 rounded-full bg-blue-500"></span>
                                                In progress
                                            </BadgeCn>
                                        }
                                    </div>
                                    <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                        <span>@phase.DateRange</span>
                                        @if (phase.Progress > 0 && phase.Progress < 100)
                                        {
                                            <span>·</span>
                                            <span class="font-medium tabular-nums">@phase.Progress% complete</span>
                                        }
                                    </div>
                                </div>
                                <LucideIconCn Name="chevron-right" Size="16" Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                            </button>

                            @if (isExpanded)
                            {
                                <div class="mt-2 space-y-2">
                                    <div class="rounded-md bg-muted/50 p-3">
                                        <p class="text-sm leading-relaxed">@phase.Description</p>
                                    </div>
                                    @* Deliverables checklist *@
                                    <div class="rounded-md bg-muted/50 p-3">
                                        <span class="mb-2 block font-medium text-muted-foreground text-xs">Key deliverables</span>
                                        <div class="space-y-1.5">
                                            @for (int dIndex = 0; dIndex < phase.Deliverables.Length; dIndex++)
                                            {
                                                var deliverable = phase.Deliverables[dIndex];
                                                var isDelivered = phase.Status == PhaseStatus.Completed ||
                                                    (phase.Status == PhaseStatus.InProgress &&
                                                     dIndex < (int)Math.Ceiling((phase.Progress / 100.0) * phase.Deliverables.Length));

                                                <div class="flex items-center gap-2">
                                                    <span class="@($"flex size-4 shrink-0 items-center justify-center rounded-sm {(isDelivered ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-muted text-muted-foreground/40")}")">
                                                        @if (isDelivered)
                                                        {
                                                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                                                        }
                                                    </span>
                                                    <span class="@($"text-xs {(isDelivered ? "text-foreground" : "text-muted-foreground")}")">
                                                        @deliverable
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum PhaseStatus { Completed, InProgress, Upcoming }

    private record Phase(
        string Id,
        string Name,
        string DateRange,
        PhaseStatus Status,
        int Progress,
        string Description,
        string[] Deliverables);

    private const double CircleSize = 28;
    private const double StrokeWidth = 3;
    private const double Radius = (CircleSize - StrokeWidth) / 2;
    private const double Circumference = 2 * Math.PI * Radius;

    private string? _expanded = "ph4";

    private static readonly Phase[] _phases =
    [
        new("ph1", "Architectural design", "Sep 2025 — Nov 2025", PhaseStatus.Completed, 100,
            "Completed schematic design, design development, and construction document phases. Final blueprints approved by client and submitted to city planning department.",
            ["Floor plans and elevations", "Structural engineering drawings", "MEP system layouts", "Material specifications"]),
        new("ph2", "Permits and approvals", "Dec 2025 — Jan 2026", PhaseStatus.Completed, 100,
            "Obtained building permit, zoning approval, and environmental compliance certification. All inspections scheduled and pre-approved with the county building department.",
            ["Building permit issued", "Zoning variance approved", "Environmental impact clearance", "Utility connection permits"]),
        new("ph3", "Site preparation", "Feb 2026", PhaseStatus.Completed, 100,
            "Completed land clearing, grading, and excavation. Temporary utilities installed. Erosion control measures in place. Survey markers set for foundation layout.",
            ["Site cleared and graded", "Erosion control installed", "Temporary utilities connected", "Foundation layout marked"]),
        new("ph4", "Foundation and concrete", "Mar 2026 — Apr 2026", PhaseStatus.InProgress, 62,
            "Footings poured and cured. Foundation walls 80% complete. Waterproofing membrane applied to completed sections. Slab-on-grade preparation underway for the garage level.",
            ["Footings poured and inspected", "Foundation walls completed", "Waterproofing applied", "Garage slab poured"]),
        new("ph5", "Structural framing", "May 2026 — Jul 2026", PhaseStatus.Upcoming, 0,
            "Steel and wood framing for all three floors. Roof truss installation, sheathing, and weather barrier application. Window and exterior door rough openings framed.",
            ["Floor framing for 3 levels", "Roof trusses installed", "Sheathing and weather barrier", "Rough openings framed"]),
        new("ph6", "Mechanical, electrical, plumbing", "Jul 2026 — Sep 2026", PhaseStatus.Upcoming, 0,
            "Rough-in for all mechanical systems including HVAC ductwork, electrical wiring, and plumbing supply and drain lines. Low-voltage wiring for data, security, and audio systems.",
            ["HVAC ductwork installed", "Electrical rough-in complete", "Plumbing rough-in complete", "Low-voltage systems roughed"]),
        new("ph7", "Interior finishes", "Oct 2026 — Dec 2026", PhaseStatus.Upcoming, 0,
            "Drywall, paint, flooring, cabinetry, countertops, and fixture installation. Trim carpentry and millwork. Final mechanical and electrical connections.",
            ["Drywall and paint complete", "Flooring installed", "Cabinetry and countertops", "Fixtures and trim complete"]),
        new("ph8", "Final inspection and handover", "Jan 2027", PhaseStatus.Upcoming, 0,
            "Final building inspection, certificate of occupancy issued, punch list completion, and client walkthrough. Keys and documentation package delivered to owner.",
            ["Building inspection passed", "Certificate of occupancy", "Punch list completed", "Owner documentation package"]),
    ];

    private int _completedCount => System.Array.FindAll(_phases, p => p.Status == PhaseStatus.Completed).Length;
    private int _overallProgress => (int)Math.Round(_phases.Average(p => p.Progress));

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }
}
