@* ============================================================
   Block: timeline-ribbon
   Title: TimelineRibbon
   Description: React horizontal ribbon timeline with pinned events. Built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-ribbon.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Company timeline</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">@_events.Length events</span>
        </div>

        @* Ribbon area *@
        <div class="overflow-x-auto" tabindex="0" role="group" aria-label="Company timeline">
            <div class="relative min-w-[900px] px-6 pb-6 pt-4">
                @* Above-ribbon events *@
                <div class="relative mb-0 flex">
                    @foreach (var ev in _events)
                    {
                        var evt = ev;
                        var idx = System.Array.IndexOf(_events, evt);
                        var isAbove = idx % 2 == 0;
                        if (!isAbove)
                        {
                            <div class="flex-1"></div>
                        }
                        else
                        {
                            <div class="flex flex-1 flex-col items-center">
                                @* Card *@
                                <div class="mb-2 w-[110px] text-center">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="mb-1 font-normal text-xs">@evt.Tag</BadgeCn>
                                    <p class="font-medium text-xs leading-tight">@evt.Title</p>
                                    <p class="mt-0.5 text-muted-foreground text-xs leading-tight line-clamp-2">@evt.Description</p>
                                </div>
                                @* Pin line down to ribbon *@
                                <div class="flex flex-col items-center">
                                    <div class="h-6 w-px bg-border"></div>
                                    <div class="size-2 rounded-full border-2 border-foreground bg-card"></div>
                                </div>
                            </div>
                        }
                    }
                </div>

                @* Ribbon band *@
                <div class="relative flex h-8 overflow-hidden rounded-md border">
                    @foreach (var quarter in _quarters)
                    {
                        var q = quarter;
                        var qi = System.Array.IndexOf(_quarters, q);
                        <div class="@Cn.Merge("flex flex-1 items-center justify-center border-r last:border-r-0", qi % 2 == 0 ? "bg-muted/30" : "bg-muted/60")">
                            <span class="font-medium text-muted-foreground text-xs">@q</span>
                        </div>
                    }
                </div>

                @* Below-ribbon events *@
                <div class="relative mt-0 flex">
                    @foreach (var ev in _events)
                    {
                        var evt = ev;
                        var idx = System.Array.IndexOf(_events, evt);
                        var isAbove = idx % 2 == 0;
                        if (isAbove)
                        {
                            <div class="flex-1"></div>
                        }
                        else
                        {
                            <div class="flex flex-1 flex-col items-center">
                                @* Pin line up from ribbon *@
                                <div class="flex flex-col items-center">
                                    <div class="size-2 rounded-full border-2 border-foreground bg-card"></div>
                                    <div class="h-6 w-px bg-border"></div>
                                </div>
                                @* Card *@
                                <div class="mt-2 w-[110px] text-center">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="mb-1 font-normal text-xs">@evt.Tag</BadgeCn>
                                    <p class="font-medium text-xs leading-tight">@evt.Title</p>
                                    <p class="mt-0.5 text-muted-foreground text-xs leading-tight line-clamp-2">@evt.Description</p>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Scroll horizontally to explore</span>
                <div class="flex items-center gap-2">
                    @foreach (var tag in _tags)
                    {
                        <span class="text-muted-foreground text-xs">@tag</span>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record RibbonEvent(string Id, string Date, string Title, string Description, string Quarter, string Tag);

    private static readonly RibbonEvent[] _events =
    [
        new("r1", "Jan 15", "Seed funding closed",
