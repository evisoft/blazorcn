@* ============================================================
   Block: timeline-customer-journey
   Title: TimelineCustomerJourney
   Description: React customer journey timeline with touchpoints and conversion tracking, built with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-customer-journey.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Customer journey</span>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span>48,200 visitors</span>
                <span class="text-muted-foreground/40">·</span>
                <span>4.8% end-to-end</span>
            </div>
        </div>

        @* Journey timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var stg in _stages)
                {
                    var idx = Array.IndexOf(_stages, stg);
                    var isLast = idx == _stages.Length - 1;
                    var nextStage = isLast ? null : _stages[idx + 1];

                    <div>
                        <div class="relative flex gap-4">
                            @* Timeline column *@
                            <div class="flex flex-col items-center">
                                @* Stage marker *@
                                <div class="@($"relative z-10 flex size-7 shrink-0 items-center justify-center rounded-full border-2 {stg.DotClass}")">
                                    <LucideIconCn Name="@stg.IconName" Size="14" Class="@($"size-3.5 {stg.IconTextClass}")" />
                                </div>
                                @* Connector *@
                                @if (!isLast)
                                {
                                    <div class="@($"w-0.5 flex-1 {stg.LineClass}")"></div>
                                }
                            </div>

                            @* Content *@
                            <div class="@($"min-w-0 flex-1 {(isLast ? "pb-0" : "pb-2")}")">
                                @* Stage header *@
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@stg.Name</span>
                                    <span class="@($"font-mono text-xs tabular-nums {stg.TextClass}")">@stg.ConversionRate%</span>
                                    <span class="ml-auto text-muted-foreground text-xs tabular-nums">@stg.Visitors</span>
                                </div>

                                @* Conversion bar *@
                                <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                    <div class="@($"h-full rounded-full {stg.BarClass}")" style="@($"width:{stg.ConversionRate}%")"></div>
                                </div>

                                @* Touchpoints *@
                                <div class="mt-2.5 space-y-1.5">
                                    @foreach (var tp in stg.Touchpoints)
                                    {
                                        <div class="@($"flex items-start gap-2 rounded-md p-2 {stg.BgClass}")">
                                            <span class="mt-0.5 text-muted-foreground">
                                                <LucideIconCn Name="@tp.ChannelIconName" Size="12" Class="size-3" />
                                            </span>
                                            <div class="min-w-0 flex-1">
                                                <span class="font-medium text-xs">@tp.Channel</span>
                                                <p class="mt-0.5 text-muted-foreground text-xs">@tp.Action</p>
                                            </div>
                                        </div>
                                    }
                                </div>

                                @* Metric *@
                                <div class="mt-2 flex items-center gap-2 text-muted-foreground text-xs">
                                    <span>@stg.MetricLabel:</span>
                                    <span class="font-medium text-foreground tabular-nums">@stg.MetricValue</span>
                                </div>
                            </div>
                        </div>

                        @* Drop-off indicator between stages *@
                        @if (!isLast && nextStage != null)
                        {
                            var dropOff = (int)Math.Round(((stg.ConversionRate - nextStage.ConversionRate) / stg.ConversionRate) * 100.0);
                            <div class="relative flex gap-4">
                                <div class="flex flex-col items-center">
                                    <div class="@($"w-0.5 flex-1 {stg.LineClass}")"></div>
                                </div>
                                <div class="flex items-center gap-1.5 py-2 text-muted-foreground text-xs">
                                    <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                                    <span class="tabular-nums">@dropOff% drop-off</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
