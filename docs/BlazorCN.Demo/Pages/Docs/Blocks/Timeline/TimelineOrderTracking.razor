@* ============================================================
   Block: timeline-order-tracking
   Title: TimelineOrderTracking
   Description: React package delivery tracking timeline with progress. Built with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-order-tracking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
            <div class="flex-1">
                <span class="font-medium text-sm">Order #WB-4821</span>
                <p class="text-muted-foreground text-xs">Estimated delivery today</p>
            </div>
            <span class="font-mono text-muted-foreground text-xs">1Z999AA10123456784</span>
        </div>

        @* Timeline *@
        <div class="px-4 py-5">
            <div class="relative">
                @for (int i = 0; i < _steps.Length; i++)
                {
                    var step = _steps[i];
                    var isLast = i == _steps.Length - 1;

                    <div class="relative flex gap-4">
                        @* Circle + Line column *@
                        <div class="flex flex-col items-center">
                            @* Circle *@
                            @if (step.Status == StepStatus.Completed)
                            {
                                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-foreground">
                                    <LucideIconCn Name="check" Size="16" Class="size-4 text-background" />
                                </div>
                            }
                            else if (step.Status == StepStatus.Current)
                            {
                                <div class="relative flex size-8 shrink-0 items-center justify-center">
                                    <span class="absolute inset-0 animate-pulse rounded-full bg-foreground/20"></span>
                                    <div class="relative flex size-8 items-center justify-center rounded-full border-2 border-foreground bg-card">
                                        <span class="size-2.5 rounded-full bg-foreground"></span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="flex size-8 shrink-0 items-center justify-center rounded-full border-2 border-muted-foreground/30 bg-card">
                                    <span class="size-2 rounded-full bg-muted-foreground/30"></span>
                                </div>
                            }

                            @* Connecting line *@
                            @if (!isLast)
                            {
                                <div class="relative my-1 h-10 w-0.5">
                                    <div class="absolute inset-0 bg-muted-foreground/20"></div>
                                    @if (step.Status == StepStatus.Completed ||
                                         (step.Status == StepStatus.Current && i + 1 < _steps.Length && _steps[i + 1].Status != StepStatus.Pending))
                                    {
                                        <div class="absolute inset-0 bg-foreground"></div>
                                    }
                                    @if (step.Status == StepStatus.Current && i + 1 < _steps.Length && _steps[i + 1].Status == StepStatus.Pending)
                                    {
                                        <div class="absolute inset-x-0 top-0 h-1/2 bg-foreground"></div>
                                    }
                                </div>
                            }
                        </div>

                        @* Content *@
                        <div class="@(isLast ? "pb-0 pt-1" : "pb-4 pt-1")">
                            <span class="@($"font-medium text-sm {(step.Status == StepStatus.Pending ? "text-muted-foreground" : "text-foreground")}")">
                                @step.Label
                            </span>
                            <div class="mt-0.5 flex items-center gap-2">
                                <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-muted-foreground text-xs">@step.Location</span>
                                <span class="text-muted-foreground/40 text-xs">·</span>
                                <span class="font-mono text-muted-foreground text-xs">@step.Time</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum StepStatus { Completed, Current, Pending }

    private record TrackingStep(string Id, string Label, string Location, string Time, StepStatus Status);

    private static readonly TrackingStep[] _steps =
    [
        new("1", "Order Placed",       "Online",                              "Mar 18, 9:42 AM",  StepStatus.Completed),
        new("2", "Picked Up",          "Warehouse, Austin TX",                "Mar 18, 3:15 PM",  StepStatus.Completed),
        new("3", "In Transit",         "Distribution Center, Denver CO",      "Mar 19, 11:08 AM", StepStatus.Completed),
        new("4", "Out for Delivery",   "Local Facility, San Francisco CA",    "Mar 20, 7:30 AM",  StepStatus.Current),
        new("5", "Delivered",          "Front Door",                          "Estimated 2:00 PM",StepStatus.Pending),
    ];
}
