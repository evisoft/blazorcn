@* ============================================================
   Block: timeline-tree
   Title: TimelineTree
   Description: React tree timeline with expandable branches showing hierarchical events built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-tree.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Growth roadmap</span>
                <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-foreground"></span>
                        Milestones
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        Decisions
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                        Tasks
                    </span>
                </div>
            </div>
        </div>

        @* Tree *@
        <div class="px-4 py-4">
            @foreach (var flat in GetFlatNodes())
            {
                var nodeId = flat.Node.Id;
                var hasChildren = flat.Node.Children != null && flat.Node.Children.Length > 0;
                var isExpanded = _expanded.Contains(flat.Node.Id);
                var showLine = !flat.IsLast || (hasChildren && isExpanded);
                var nodeStyle = _nodeTypeStyles[flat.Node.Type];

                <div>
                    <div class="flex items-start gap-3" style="@($"padding-left:{flat.Depth * 24}px")">
                        @* Vertical trunk + dot *@
                        <div class="flex flex-col items-center">
                            <div class="@($"relative z-10 size-3 shrink-0 rounded-full border-2 {nodeStyle.Dot}")"></div>
                            @if (showLine)
                            {
                                <div class="w-0.5 flex-1 bg-border" style="min-height:16px"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@($"min-w-0 flex-1 {(flat.IsLast && !(hasChildren && isExpanded) ? "pb-0" : "pb-3")}")">
                            <div class="flex items-center gap-2">
                                @if (hasChildren)
                                {
                                    <button type="button" @onclick="@(() => Toggle(nodeId))" class="flex size-5 shrink-0 items-center justify-center rounded transition-colors hover:bg-muted/50">
                                        <LucideIconCn Name="chevron-right" Size="14" Class="@($"size-3.5 text-muted-foreground transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                                    </button>
                                }
                                <span class="font-medium text-sm">@flat.Node.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@nodeStyle.Label</BadgeCn>
                            </div>
                            <div class="@(hasChildren ? "ml-7" : "")">
                                <span class="text-muted-foreground text-xs">@flat.Node.Date</span>
                                <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">@flat.Node.Description</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2">
            <span class="text-muted-foreground text-xs">@TotalNodes events across 3 levels</span>
        </div>
    </div>
</section>

@code {
    private enum NodeType { Milestone, Task, Decision }

    private record NodeTypeStyle(string Dot, string Label);

    private record TreeNode(string Id, string Date, string Title, string Description, NodeType Type, TreeNode[]? Children = null);

    private record FlatNode(TreeNode Node, int Depth, bool IsLast);

    private static readonly Dictionary<NodeType, NodeTypeStyle> _nodeTypeStyles = new()
    {
        { NodeType.Milestone, new("border-foreground bg-foreground", "Milestone") },
        { NodeType.Task,      new("border-muted-foreground/40 bg-muted-foreground/40", "Task") },
        { NodeType.Decision,  new("border-amber-500 bg-amber-500", "Decision") },
    };

    private static readonly TreeNode[] _treeData =
    [
        new("n1", "Jan 2025", "Company founded",
            "Incorporated the company, secured initial angel investment of $500K.",
            NodeType.Milestone,
            [
                new("n1a", "Feb 2025", "Hired founding engineers",
                    "Recruited 3 senior engineers from previous network. Established engineering culture docs.",
                    NodeType.Task),
                new("n1b", "Feb 2025", "Office and tooling setup",
                    "Leased co-working space, set up GitHub org, CI/CD, and Slack workspace.",
                    NodeType.Task),
            ]),
        new("n2", "Apr 2025", "MVP development complete",
            "Core product features built and passing integration tests. Ready for user feedback.",
            NodeType.Milestone,
            [
                new("n2a", "May 2025", "Choose go-to-market strategy",
                    "Evaluated PLG vs sales-led approaches based on customer interviews.",
                    NodeType.Decision,
                    [
                        new("n2a1", "May 2025", "Product-led growth selected",
                            "Chose PLG with free tier, self-serve onboarding, and usage-based upgrade prompts.",
                            NodeType.Task),
                        new("n2a2", "Jun 2025", "Built onboarding funnel",
                            "Interactive setup wizard, sample workspace, and guided tour. 68% completion rate.",
                            NodeType.Task),
                    ]),
                new("n2b", "May 2025", "Beta user program launched",
                    "Onboarded 120 beta users with weekly feedback calls and in-app surveys.",
                    NodeType.Task),
            ]),
        new("n3", "Aug 2025", "Public launch",
            "General availability release with documentation, pricing page, and support channels.",
            NodeType.Milestone,
            [
                new("n3a", "Sep 2025", "Pricing model finalized",
                    "Three tiers: Free, Pro at $29/mo, and Team at $79/mo. Annual discounts at 20%.",
                    NodeType.Decision),
                new("n3b", "Oct 2025", "First 1,000 paying customers",
                    "Reached $30K MRR milestone. Churn rate at 4.2% monthly. NPS score of 58.",
                    NodeType.Milestone),
            ]),
        new("n4", "Jan 2026", "Series A planning",
            "Preparing fundraise materials, financial models, and investor pipeline for Q2 raise.",
            NodeType.Milestone),
    ];

    private readonly HashSet<string> _expanded = ["n1", "n2", "n2a", "n3"];

    private void Toggle(string id)
    {
        if (_expanded.Contains(id))
            _expanded.Remove(id);
        else
            _expanded.Add(id);
    }

    private List<FlatNode> GetFlatNodes()
    {
        var result = new List<FlatNode>();
        AddFlatNodes(result, _treeData, 0);
        return result;
    }

    private void AddFlatNodes(List<FlatNode> result, TreeNode[] nodes, int depth)
    {
        for (int i = 0; i < nodes.Length; i++)
        {
            var node = nodes[i];
            bool isLast = i == nodes.Length - 1;
            result.Add(new FlatNode(node, depth, isLast));
            if (node.Children != null && node.Children.Length > 0 && _expanded.Contains(node.Id))
            {
                AddFlatNodes(result, node.Children, depth + 1);
            }
        }
    }

    private static int CountNodes(TreeNode[] nodes)
    {
        int count = 0;
        foreach (var n in nodes)
            count += 1 + (n.Children != null ? CountNodes(n.Children) : 0);
        return count;
    }

    private int TotalNodes => CountNodes(_treeData);
}
