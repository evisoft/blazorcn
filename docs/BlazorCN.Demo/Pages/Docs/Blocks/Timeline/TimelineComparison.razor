@* ============================================================
   Block: timeline-comparison
   Title: TimelineComparison
   Description: A React side-by-side timeline comparing two plans with parallel tracks, built with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="scale" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Migration strategy comparison</span>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var trk in _tracks)
                {
                    var track = trk;
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@($"size-1.5 rounded-full {track.AccentDotBg}")"></span>
                        @track.Label
                    </span>
                }
            </div>
        </div>

        @* Column headers *@
        <div class="grid grid-cols-[1fr_40px_1fr] border-b">
            @for (int ti = 0; ti < _tracks.Length; ti++)
            {
                var track = _tracks[ti];
                var borderClass = ti == 0 ? "border-r" : "border-l";
                <div class="@($"px-4 py-3 {borderClass}")">
                    <div class="flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"font-normal text-xs {track.AccentBadge}")">
                            @track.Label
                        </BadgeCn>
                        <span class="text-muted-foreground text-xs">@track.Subtitle</span>
                    </div>
                    <span class="mt-0.5 block font-mono text-muted-foreground text-xs">
                        @track.TotalDuration total
                    </span>
                </div>
            }
        </div>

        @* Timeline rows *@
        <div>
            @for (int rowIndex = 0; rowIndex < _phaseLabels.Length; rowIndex++)
            {
                var phase = _phaseLabels[rowIndex];
                var isLast = rowIndex == _phaseLabels.Length - 1;
                var leftEntry = _tracks[0].Entries[rowIndex];
                var rightEntry = _tracks[1].Entries[rowIndex];
                var leftTrack = _tracks[0];
                var rightTrack = _tracks[1];

                <div class="@(isLast ? "" : "border-b")">
                    @* Phase label *@
                    <div class="border-b bg-muted/30 px-4 py-1.5">
                        <span class="font-medium text-muted-foreground text-xs">@phase</span>
                    </div>

                    <div class="grid grid-cols-[1fr_40px_1fr]">
                        @* Left track entry *@
                        <div class="px-4 py-3">
                            @if (leftEntry != null)
                            {
                                var leftDotClass = leftEntry.Status == EntryStatus.Pending ? _pendingDot : leftTrack.AccentDot;
                                var leftTextClass = leftEntry.Status == EntryStatus.Pending ? "text-muted-foreground" : "";
                                <div class="flex gap-3">
                                    <div class="flex flex-col items-center">
                                        <div class="@($"relative z-10 flex size-5 shrink-0 items-center justify-center rounded-full border-2 {leftDotClass} {GetStatusTextClass(leftEntry.Status)}")">
                                            @if (leftEntry.Status == EntryStatus.Done)
                                            {
                                                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                                            }
                                            else if (leftEntry.Status == EntryStatus.Active)
                                            {
                                                <LucideIconCn Name="circle-dot" Size="12" Class="size-3" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="circle" Size="12" Class="size-3 text-muted-foreground/40" />
                                            }
                                            @if (leftEntry.Status == EntryStatus.Active)
                                            {
                                                <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                            }
                                        </div>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="@($"font-medium text-sm {leftTextClass}")">
                                                @leftEntry.Title
                                            </span>
                                        </div>
                                        <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                                            @leftEntry.Description
                                        </p>
                                        <span class="mt-1 inline-block font-mono text-muted-foreground text-xs">
                                            @leftEntry.Duration
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>

                        @* Center connector *@
                        <div class="flex items-center justify-center border-x">
                            <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5 text-muted-foreground/30" />
                        </div>

                        @* Right track entry *@
                        <div class="px-4 py-3">
                            @if (rightEntry != null)
                            {
                                var rightDotClass = rightEntry.Status == EntryStatus.Pending ? _pendingDot : rightTrack.AccentDot;
                                var rightTextClass = rightEntry.Status == EntryStatus.Pending ? "text-muted-foreground" : "";
                                <div class="flex gap-3">
                                    <div class="flex flex-col items-center">
                                        <div class="@($"relative z-10 flex size-5 shrink-0 items-center justify-center rounded-full border-2 {rightDotClass} {GetStatusTextClass(rightEntry.Status)}")">
                                            @if (rightEntry.Status == EntryStatus.Done)
                                            {
                                                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                                            }
                                            else if (rightEntry.Status == EntryStatus.Active)
                                            {
                                                <LucideIconCn Name="circle-dot" Size="12" Class="size-3" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="circle" Size="12" Class="size-3 text-muted-foreground/40" />
                                            }
                                            @if (rightEntry.Status == EntryStatus.Active)
                                            {
                                                <span class="absolute inset-0 animate-ping rounded-full border-2 border-violet-500 opacity-20"></span>
                                            }
                                        </div>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="@($"font-medium text-sm {rightTextClass}")">
                                                @rightEntry.Title
                                            </span>
                                        </div>
                                        <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                                            @rightEntry.Description
                                        </p>
                                        <span class="mt-1 inline-block font-mono text-muted-foreground text-xs">
                                            @rightEntry.Duration
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Summary comparison *@
        <div class="grid grid-cols-[1fr_40px_1fr] border-t bg-muted/30">
            <div class="px-4 py-3">
                <div class="flex items-center gap-3">
                    <span class="font-semibold text-sm tabular-nums">@_tracks[0].TotalDuration</span>
                    <span class="text-muted-foreground text-xs">·</span>
                    <span class="text-muted-foreground text-xs">Lower risk, longer timeline</span>
                </div>
            </div>
            <div class="flex items-center justify-center border-x">
                <span class="text-muted-foreground text-xs">vs</span>
            </div>
            <div class="px-4 py-3">
                <div class="flex items-center gap-3">
                    <span class="font-semibold text-sm tabular-nums">@_tracks[1].TotalDuration</span>
                    <span class="text-muted-foreground text-xs">·</span>
                    <span class="text-muted-foreground text-xs">Higher risk, faster delivery</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private enum EntryStatus { Done, Active, Pending }

    private record ComparisonEntry(string Id, string Title, string Description, string Duration, EntryStatus Status);

    private record ComparisonTrack(
        string Label,
        string Subtitle,
        string TotalDuration,
        string AccentDot,
        string AccentDotBg,
        string AccentLine,
        string AccentBadge,
        ComparisonEntry[] Entries
    );

    private const string _pendingDot = "border-muted-foreground/30 bg-transparent";

    private static string GetStatusTextClass(EntryStatus status) => status switch
    {
        EntryStatus.Done   => "text-white",
        EntryStatus.Active => "text-white",
        _                  => "",
    };

    private static readonly string[] _phaseLabels = ["Discovery", "Implementation", "Testing", "Migration", "Launch"];

    private static readonly ComparisonTrack[] _tracks =
    [
        new(
            Label: "Plan A",
            Subtitle: "Incremental migration",
            TotalDuration: "16 weeks",
            AccentDot: "border-blue-500 bg-blue-500",
            AccentDotBg: "bg-blue-500",
            AccentLine: "bg-blue-500/30",
            AccentBadge: "border-blue-500/20 bg-blue-500/10 text-blue-600 dark:text-blue-400",
            Entries:
            [
                new("a1", "Audit existing system",    "Map all dependencies, identify migration risks, document API surface area",                           "2 weeks", EntryStatus.Done),
                new("a2", "Build adapter layer",      "Create compatibility shims so old and new systems coexist during migration",                          "4 weeks", EntryStatus.Active),
                new("a3", "Migrate module by module", "Move each feature independently with rollback capability per module",                                 "6 weeks", EntryStatus.Pending),
                new("a4", "Parallel run validation",  "Both systems run simultaneously, comparing outputs for 2 weeks before cutover",                       "2 weeks", EntryStatus.Pending),
                new("a5", "Gradual traffic shift",    "Route 10%, 25%, 50%, 100% of traffic with automated rollback triggers",                              "2 weeks", EntryStatus.Pending),
            ]
        ),
        new(
            Label: "Plan B",
            Subtitle: "Big bang rewrite",
            TotalDuration: "12 weeks",
            AccentDot: "border-violet-500 bg-violet-500",
            AccentDotBg: "bg-violet-500",
            AccentLine: "bg-violet-500/30",
            AccentBadge: "border-violet-500/20 bg-violet-500/10 text-violet-600 dark:text-violet-400",
            Entries:
            [
                new("b1", "Requirements and architecture", "Clean-slate design, new database schema, modern API patterns from scratch",                          "3 weeks", EntryStatus.Done),
                new("b2", "Full rebuild from scratch",     "Rewrite all features on new stack without legacy constraints or adapter overhead",                   "5 weeks", EntryStatus.Active),
                new("b3", "Comprehensive testing",         "Full regression suite since no gradual validation. 100% feature parity check",                      "2 weeks", EntryStatus.Pending),
                new("b4", "Data migration and cutover",    "One-time data migration with 4-hour maintenance window and DNS switch",                             "1 week",  EntryStatus.Pending),
                new("b5", "Launch and stabilize",          "All traffic on new system immediately. War room for first 48 hours post-launch",                   "1 week",  EntryStatus.Pending),
            ]
        ),
    ];
}
