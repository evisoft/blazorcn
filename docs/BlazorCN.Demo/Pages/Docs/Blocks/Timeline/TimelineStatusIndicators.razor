@* ============================================================
   Block: timeline-status-indicators
   Title: TimelineStatusIndicators
   Description: React task timeline with color-coded status indicators, expandable details, and progress legend using Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-status-indicators.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Deployment pipeline</span>
                <span class="text-muted-foreground text-xs">
                    @_tasks.Count(t => t.Status == TaskStatus.Complete)/@_tasks.Length complete
                </span>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">v3.0 release checklist</p>
        </div>

        @* Legend *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Complete
                <span class="tabular-nums">(@_tasks.Count(t => t.Status == TaskStatus.Complete))</span>
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-blue-500"></span>
                In progress
                <span class="tabular-nums">(@_tasks.Count(t => t.Status == TaskStatus.InProgress))</span>
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                Pending
                <span class="tabular-nums">(@_tasks.Count(t => t.Status == TaskStatus.Pending))</span>
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                Not started
                <span class="tabular-nums">(@_tasks.Count(t => t.Status == TaskStatus.NotStarted))</span>
            </span>
        </div>

        @* Timeline *@
        <div class="relative">
            @foreach (var task in _tasks)
            {
                var idx = System.Array.IndexOf(_tasks, task);
                var isExpanded = _expanded == task.Id;
                var isLast = idx == _tasks.Length - 1;
                var lineClass = task.Status == TaskStatus.Complete
                    ? "bg-emerald-500/40"
                    : task.Status == TaskStatus.InProgress
                        ? "bg-blue-500/40"
                        : task.Status == TaskStatus.Pending
                            ? "bg-amber-500/40"
                            : "bg-border";
                var titleClass = task.Status == TaskStatus.NotStarted
                    ? "font-medium text-sm text-muted-foreground"
                    : "font-medium text-sm";
                var chevronClass = isExpanded
                    ? "mt-1 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 rotate-90"
                    : "mt-1 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200";
                var taskId = task.Id;

                <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                    @* Status line segment *@
                    @if (!isLast)
                    {
                        <div class="@Cn.Merge("absolute left-[19px] w-0.5", lineClass)"
                             style="@($"top:{idx * 60 + 30}px;height:60px;")">
                        </div>
                    }

                    <button type="button"
                            @onclick="@(() => ToggleExpanded(taskId))"
                            class="relative flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Status dot *@
                        <div class="relative z-10 mt-1 shrink-0">
                            @if (task.Status == TaskStatus.Complete)
                            {
                                <div class="flex size-5 items-center justify-center rounded-full bg-emerald-500">
                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-white" />
                                </div>
                            }
                            else if (task.Status == TaskStatus.InProgress)
                            {
                                <div class="size-5 rounded-full border-2 border-blue-500 bg-blue-500/10"></div>
                            }
                            else if (task.Status == TaskStatus.Pending)
                            {
                                <div class="size-5 rounded-full border-2 border-amber-500 bg-amber-500/10"></div>
                            }
                            else
                            {
                                <div class="size-5 rounded-full border-2 border-muted-foreground/30 bg-muted/50"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@titleClass">@task.Title</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-1.5">
                                <span class="text-muted-foreground text-xs">@task.Date</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@task.Assignee</span>
                            </div>
                        </div>

                        @* Chevron *@
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @* Expanded detail *@
                    @if (isExpanded)
                    {
                        <div class="mb-3 ml-[36px] mr-4 rounded-md bg-muted/50 p-3">
                            <p class="text-sm leading-relaxed">@task.Description</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum TaskStatus { Complete, InProgress, Pending, NotStarted }

    private record TimelineTask(string Id, string Title, string Date, TaskStatus Status, string Assignee, string Description);

    private static readonly TimelineTask[] _tasks =
    [
        new("1", "Database migration script", "Mar 10", TaskStatus.Complete, "Sarah K.",
            "Schema migration from v2 to v3 completed. 14 tables updated, 3 new indexes added. Zero-downtime migration verified on staging. Rollback script tested and archived."),
        new("2", "API versioning layer", "Mar 14", TaskStatus.Complete, "Marcus T.",
            "Introduced /v3/ prefix with backward-compatible /v2/ proxy. All 23 endpoints migrated. Rate limiting updated. API documentation regenerated from OpenAPI spec."),
        new("3", "Frontend component refactor", "Mar 18", TaskStatus.InProgress, "Leah R.",
            "Migrating 18 components to new design tokens. 11 completed, 7 remaining. Storybook updated with new variants. Visual regression tests passing on completed components."),
        new("4", "End-to-end test coverage", "Mar 21", TaskStatus.Pending, "James W.",
            "Waiting on frontend refactor completion. Test plan written for 32 critical paths. Playwright fixtures prepared. CI integration branch ready for merge."),
        new("5", "Performance benchmark suite", "Mar 24", TaskStatus.Pending, "Priya D.",
            "Lighthouse CI configured for automated scoring. Core Web Vitals baselines documented. Budget thresholds set at LCP < 2.5s, CLS < 0.1, INP < 200ms."),
        new("6", "Staging deployment", "Mar 26", TaskStatus.NotStarted, "Ops team",
            "Infrastructure provisioned in Terraform. Environment variables configured. DNS records prepared. Deployment runbook reviewed by SRE team."),
        new("7", "Production release", "Mar 28", TaskStatus.NotStarted, "Release manager",
            "Blue-green deployment with 10% canary. Monitoring dashboards configured. PagerDuty escalation policy updated. Post-release smoke test checklist prepared."),
    ];

    private string? _expanded = "3";

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }
}
