@* ============================================================
   Block: timeline-split-view
   Title: TimelineSplitView
   Description: React two-panel timeline for Next.js with shadcn/ui Badge and Tailwind CSS with navigation rail and detail panel.
   Source: original/blocks/timeline/timeline-split-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="panel-left" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Project timeline</span>
            </div>
            <span class="text-muted-foreground text-xs">
                @(_entries.Where(e => e.Status == "completed").Count()) of @_entries.Length completed
            </span>
        </div>

        @* Two-panel layout *@
        <div class="grid grid-cols-[280px_1fr]">
            @* Left: Timeline navigation *@
            <div class="h-[700px] overflow-y-auto border-r">
                <div class="px-3 py-4">
                    <div class="relative">
                        @foreach (var entry in _entries)
                        {
                            var item = entry;
                            var index = System.Array.IndexOf(_entries, item);
                            var isLast = index == _entries.Length - 1;
                            var isSelected = item.Id == _selectedId;
                            var dotClass = StatusDotClass(item.Status);
                            var lineClass = LineColorClass(item.Status);
                            <div class="relative flex gap-3">
                                @* Line + Dot *@
                                <div class="flex flex-col items-center">
                                    <div class="@Cn.Merge("relative z-10 flex size-5 shrink-0 items-center justify-center rounded-full border-2", dotClass, isSelected ? "ring-2 ring-foreground/20 ring-offset-2 ring-offset-card" : "")">
                                        @if (item.Status == "completed")
                                        {
                                            <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-white" />
                                        }
                                        else if (item.Status == "current")
                                        {
                                            <LucideIconCn Name="circle-dot" Size="12" Class="size-3 text-white" />
                                            @if (!isSelected)
                                            {
                                                <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                            }
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="circle" Size="12" Class="size-3 text-muted-foreground/40" />
                                        }
                                    </div>
                                    @if (!isLast)
                                    {
                                        <div class="@Cn.Merge("w-0.5 flex-1", lineClass)"></div>
                                    }
                                </div>

                                @* Clickable entry *@
                                <div class="@Cn.Merge("min-w-0 flex-1", isLast ? "pb-0" : "pb-4")">
                                    <button type="button"
                                            @onclick="@(() => _selectedId = item.Id)"
                                            class="@Cn.Merge("-ml-1 w-full rounded-md px-2 py-1.5 text-left transition-colors", isSelected ? "bg-muted/70" : "hover:bg-muted/50")">
                                        <span class="@Cn.Merge("block font-medium text-sm leading-tight", item.Status == "upcoming" && !isSelected ? "text-muted-foreground" : "")">
                                            @item.Title
                                        </span>
                                        <span class="mt-0.5 block text-muted-foreground text-xs">
                                            @item.Date
                                        </span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Right: Detail panel *@
            @{
                var selected = _entries.FirstOrDefault(e => e.Id == _selectedId) ?? _entries[0];
            }
            <div class="h-[700px] overflow-y-auto">
                <div class="px-5 py-4">
                    @* Title and category *@
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <h2 class="font-medium text-sm">@selected.Title</h2>
                            <p class="mt-1 text-muted-foreground text-xs">@selected.Summary</p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary"
                                 Class="@Cn.Merge("shrink-0 font-normal text-xs", selected.Status == "current" ? "border-blue-500/20 bg-blue-500/10 text-blue-600 dark:text-blue-400" : selected.Status == "completed" ? "border-emerald-500/20 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "")">
                            @selected.Category
                        </BadgeCn>
                    </div>

                    @* Metadata row *@
                    <div class="mt-3 flex flex-wrap items-center gap-4 border-b pb-3">
                        <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                            <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                            @selected.Date
                        </span>
                        <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                            @selected.Duration
                        </span>
                        <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                            <LucideIconCn Name="user" Size="12" Class="size-3" />
                            @selected.Author
                        </span>
                    </div>

                    @* Detail content *@
                    <div class="mt-4">
                        <span class="font-medium text-muted-foreground text-xs">Details</span>
                        <p class="mt-2 text-sm leading-relaxed">@selected.Detail</p>
                    </div>

                    @* Impact *@
                    <div class="mt-4 rounded-md bg-muted/50 p-3">
                        <span class="font-medium text-muted-foreground text-xs">Impact</span>
                        <p class="mt-1 text-sm">@selected.Impact</p>
                    </div>

                    @* Tags *@
                    <div class="mt-4">
                        <span class="flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                            <LucideIconCn Name="tag" Size="12" Class="size-3" />
                            Tags
                        </span>
                        <div class="mt-2 flex flex-wrap gap-1.5">
                            @foreach (var tag in selected.Tags)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@tag</BadgeCn>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record TimelineEntry(
        string Id,
        string Date,
        string Title,
        string Summary,
        string Detail,
        string Status,
        string Category,
        string Author,
        string Duration,
        string[] Tags,
        string Impact
    );

    private static readonly TimelineEntry[] _entries =
    [
        new("e1", "Jan 10, 2026", "Infrastructure overhaul completed",
            "Migrated from monolithic EC2 to containerized ECS with auto-scaling.",
            "Completed the migration of all 14 microservices from a single EC2 monolith to Amazon ECS with Fargate. Each service now runs in its own container with independent scaling policies based on CPU and memory utilization. The migration involved rewriting the service discovery layer to use AWS Cloud Map, implementing circuit breakers with exponential backoff, and setting up centralized logging through CloudWatch Logs Insights. Deployment time dropped from 45 minutes to 3 minutes per service. The auto-scaling configuration handles traffic spikes up to 10x baseline without manual intervention. Total infrastructure cost decreased by 34% despite handling 2.5x more traffic than the previous quarter.",
            "completed", "Infrastructure", "Sarah Kim", "6 weeks",
            ["AWS", "ECS", "Migration", "DevOps"],
            "34% cost reduction, 15x faster deploys"),
        new("e2", "Feb 3, 2026", "Authentication system redesign",
