@* ============================================================
   Block: timeline-tabbed
   Title: TimelineTabbed
   Description: React timeline with tab navigation for time-range filtering and dynamic entry display using Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-tabbed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <TabsCn DefaultValue="all">
            @* Header with tabs *@
            <div class="flex items-center justify-between border-b px-4 py-3">
                <span class="font-medium text-sm">Project timeline</span>
                <TabsListCn Class="h-7">
                    @foreach (var tab in _tabData)
                    {
                        var tabItem = tab;
                        <TabsTriggerCn Value="@tabItem.Value" Class="h-6 gap-1 px-2 text-xs">
                            @tabItem.Label
                            <span class="text-muted-foreground tabular-nums">@tabItem.Entries.Length</span>
                        </TabsTriggerCn>
                    }
                </TabsListCn>
            </div>

            @* Tab content *@
            @foreach (var tab in _tabData)
            {
                var tabItem = tab;
                <TabsContentCn Value="@tabItem.Value" Class="mt-0">
                    <div class="px-4 py-4">
                        @if (tabItem.Entries.Length == 0)
                        {
                            <div class="py-8 text-center">
                                <span class="text-muted-foreground text-sm">No entries in this time range</span>
                            </div>
                        }
                        else
                        {
                            <div class="relative">
                                @for (var i = 0; i < tabItem.Entries.Length; i++)
                                {
                                    var entry = tabItem.Entries[i];
                                    var isLast = i == tabItem.Entries.Length - 1;
                                    var dotClass = GetStatusDot(entry.Status);
                                    var pbClass = isLast ? "pb-0" : "pb-6";
                                    <div class="relative flex gap-4">
                                        @* Line + Dot column *@
                                        <div class="flex flex-col items-center">
                                            <div class="@($"relative z-10 flex size-6 shrink-0 items-center justify-center rounded-full border-2 {dotClass}")">
                                                @if (entry.Status == "completed")
                                                {
                                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-white" />
                                                }
                                                else if (entry.Status == "current")
                                                {
                                                    <LucideIconCn Name="circle-dot" Size="12" Class="size-3 text-white" />
                                                    <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="circle" Size="12" Class="size-3 text-muted-foreground/40" />
                                                }
                                            </div>
                                            @if (!isLast)
                                            {
                                                <div class="@($"w-0.5 flex-1 {GetConnectorClass(entry.Status)}")"></div>
                                            }
                                        </div>

                                        @* Content *@
                                        <div class="@($"{pbClass} min-w-0 flex-1 pt-0.5")">
                                            <div class="flex items-center gap-2">
                                                <span class="font-medium text-sm">@entry.Title</span>
                                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@entry.Tag</BadgeCn>
                                            </div>
                                            <span class="mt-0.5 block text-muted-foreground text-xs">@entry.Date</span>
                                            <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">@entry.Description</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </TabsContentCn>
            }
        </TabsCn>
    </div>
</section>

@code {
    private record TimelineEntry(string Id, string Date, string Title, string Description, string Status, string Tag);
    private record TabItem(string Value, string Label, TimelineEntry[] Entries);

    private static readonly TimelineEntry[] _allEntries =
    [
        new("e1",  "Aug 15, 2025", "Project charter signed and team assembled",
            "Secured executive sponsorship, defined success metrics, and onboarded a cross-functional team of 8 engineers, 2 designers, and a product manager.",
            "completed", "Planning"),
        new("e2",  "Oct 2, 2025",  "Architecture review and tech stack finalized",
            "Evaluated three architecture candidates. Selected event-driven microservices with PostgreSQL, Redis, and Kafka. Published ADR documents for all major decisions.",
            "completed", "Architecture"),
        new("e3",  "Dec 10, 2025", "Core API layer and database schema shipped",
            "Deployed the REST API with 42 endpoints, database migrations for 18 tables, and integration test suite covering 94% of business logic paths.",
            "completed", "Backend"),
        new("e4",  "Feb 20, 2026", "Frontend application shell and design system",
            "Launched the Next.js application shell with routing, authentication flow, and 36 shared UI components. Storybook documentation deployed to internal preview.",
            "completed", "Frontend"),
        new("e5",  "Mar 5, 2026",  "Stripe billing integration completed",
            "Integrated Stripe Checkout, customer portal, and webhook handlers. Supports monthly, yearly, and lifetime plans with automatic proration and usage metering.",
            "completed", "Billing"),
        new("e6",  "Mar 14, 2026", "Performance optimization sprint",
            "Reduced Largest Contentful Paint from 3.2s to 1.1s. Implemented route-based code splitting, image lazy loading, and server component streaming for the dashboard.",
            "completed", "Performance"),
        new("e7",  "Mar 21, 2026", "End-to-end test suite with Playwright",
            "Wrote 86 E2E tests covering critical user flows: signup, onboarding, billing, and core CRUD operations. Tests run in CI against staging on every pull request.",
            "completed", "Testing"),
        new("e8",  "Mar 24, 2026", "Security audit and penetration testing",
            "Engaging a third-party firm for comprehensive security audit. Reviewing authentication flows, API authorization, input validation, and infrastructure hardening.",
            "current", "Security"),
        new("e9",  "Apr 2026",     "Private beta with 200 invited users",
            "Opening access to waitlist users in cohorts of 50 per week. Collecting feedback through in-app surveys, session recordings, and weekly user interviews.",
            "upcoming", "Launch"),
        new("e10", "Jun 2026",     "General availability and public launch",
            "Public release with self-serve onboarding, documentation portal, API reference, and community Discord. Targeting 500 active teams in the first month.",
            "upcoming", "Launch"),
    ];

    private static readonly string[] _thisWeekIds  = ["e7", "e8"];
    private static readonly string[] _thisMonthIds = ["e5", "e6", "e7", "e8"];
    private static readonly string[] _thisYearIds  = ["e4", "e5", "e6", "e7", "e8", "e9", "e10"];

    private static TimelineEntry[] FilterById(string[] ids) =>
        Array.FindAll(_allEntries, e => Array.IndexOf(ids, e.Id) >= 0);

    private static readonly TabItem[] _tabData =
    [
        new("all",   "All",        _allEntries),
        new("week",  "This Week",  FilterById(_thisWeekIds)),
        new("month", "This Month", FilterById(_thisMonthIds)),
        new("year",  "This Year",  FilterById(_thisYearIds)),
    ];

    private static string GetStatusDot(string status) => status switch
    {
        "completed" => "border-emerald-500 bg-emerald-500",
        "current"   => "border-blue-500 bg-blue-500",
        _           => "border-muted-foreground/30 bg-transparent",
    };

    private static string GetConnectorClass(string status) => status switch
    {
        "completed" => "bg-emerald-500/40",
        "current"   => "bg-gradient-to-b from-blue-500/40 to-muted-foreground/15",
        _           => "bg-muted-foreground/15",
    };
}
