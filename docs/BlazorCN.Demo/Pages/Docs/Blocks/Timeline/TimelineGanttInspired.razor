@* ============================================================
   Block: timeline-gantt-inspired
   Title: TimelineGanttInspired
   Description: A React Gantt chart timeline with horizontal task bars showing duration and concurrency using Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-gantt-inspired.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Project timeline</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Mar 3 – Mar 28
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_completedCount done
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_activeCount active
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="users" Size="12" Class="size-3" />4 members
                </span>
            </div>
        </div>

        @* Week headers *@
        <div class="flex border-b">
            <div class="w-48 shrink-0 border-r px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Task</span>
            </div>
            <div class="relative flex-1">
                <div class="flex">
                    @foreach (var week in _weeks)
                    {
                        <div class="flex-1 border-r px-2 py-2 text-center last:border-r-0">
                            <span class="font-medium text-muted-foreground text-xs">@week</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Day column headers *@
        <div class="flex border-b">
            <div class="w-48 shrink-0 border-r"></div>
            <div class="relative flex flex-1">
                @for (int i = 0; i < _dayLabels.Length; i++)
                {
                    var label = _dayLabels[i];
                    var idx = i;
                    var isWeekBoundary = _weekBoundaries.Contains(idx) && idx > 0;
                    <div class="@Cn.Merge("flex-1 py-1 text-center", isWeekBoundary ? "border-l" : "")">
                        <span class="text-[10px] text-muted-foreground tabular-nums">@label.Split(' ')[1]</span>
                    </div>
                }
            </div>
        </div>

        @* Task rows *@
        <div>
            @for (int i = 0; i < _tasks.Length; i++)
            {
                var task = _tasks[i];
                var isLast = i == _tasks.Length - 1;
                var isSelected = _selectedTask == task.Id;
                var leftPct = (task.StartDay * 100.0 / TotalDays);
                var widthPct = ((task.EndDay - task.StartDay + 1) * 100.0 / TotalDays);
                var cfg = _statusBar[task.Status];
                var dot = _statusDot[task.Status];
                var taskCapture = task;
                var isSelectedCapture = isSelected;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _selectedTask = isSelectedCapture ? null : taskCapture.Id)"
                            class="@Cn.Merge("flex w-full items-center transition-colors hover:bg-muted/50", isSelected ? "bg-muted/30" : "")">
                        @* Task label *@
                        <div class="flex w-48 shrink-0 items-center gap-2 border-r px-4 py-3">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dot)"></span>
                            <div class="min-w-0 flex-1 text-left">
                                <span class="block truncate font-medium text-sm">@task.Name</span>
                                <span class="block text-muted-foreground text-xs">@task.Assignee</span>
                            </div>
                            <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 shrink-0 text-muted-foreground/50 transition-transform duration-200", isSelected ? "rotate-90" : "")" />
                        </div>

                        @* Gantt bar area *@
                        <div class="relative flex-1 px-1 py-3">
                            @* Week grid lines *@
                            @foreach (var boundary in _weekBoundaries)
                            {
                                if (boundary > 0)
                                {
                                    var leftStyle = FormattableString.Invariant($"left:{(boundary * 100.0 / TotalDays):F4}%");
                                    <div class="absolute top-0 bottom-0 w-px bg-border" style="@leftStyle"></div>
                                }
                            }
                            @* Today marker *@
                            <div class="absolute top-0 bottom-0 w-px bg-blue-500/40" style="@(FormattableString.Invariant($"left:{(TodayDay * 100.0 / TotalDays):F4}%"))"></div>
                            @* Bar *@
                            <div class="@Cn.Merge("relative h-7 rounded", cfg.Bg)"
                                 style="@(FormattableString.Invariant($"margin-left:{leftPct:F4}%;width:{widthPct:F4}%"))">
                                @* Progress fill *@
                                <div class="@Cn.Merge("absolute inset-y-0 left-0 rounded", cfg.Fill)"
                                     style="@($"width:{task.Progress}%")"></div>
                                @* Label on bar *@
                                <span class="relative z-10 flex h-full items-center px-2">
                                    <span class="truncate font-mono text-[10px] tabular-nums">@(task.Progress > 0 ? $"{task.Progress}%" : "")</span>
                                </span>
                            </div>
                        </div>
                    </button>

                    @* Expanded detail *@
                    @if (isSelected)
                    {
                        <div class="flex border-t bg-muted/20">
                            <div class="w-48 shrink-0 border-r"></div>
                            <div class="flex flex-1 items-center gap-4 px-4 py-2.5">
                                <span class="text-muted-foreground text-xs">@_dayLabels[task.StartDay] – @_dayLabels[task.EndDay]</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@(task.EndDay - task.StartDay + 1) days</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_statusLabel[task.Status]</BadgeCn>
                                @if (task.Progress > 0 && task.Progress < 100)
                                {
                                    <span class="text-muted-foreground text-xs">·</span>
                                    <span class="font-mono text-muted-foreground text-xs tabular-nums">@task.Progress% complete</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Milestones footer *@
        <div class="flex items-center gap-4 border-t bg-muted/20 px-4 py-2.5">
            <span class="font-medium text-muted-foreground text-xs">Milestones</span>
            @foreach (var ms in _milestones)
            {
                <span class="flex items-center gap-1.5 text-xs">
                    <span class="size-2 rotate-45 border border-foreground/60 bg-foreground/10"></span>
                    <span class="text-muted-foreground">
                        @ms.Label<span class="ml-1 font-mono tabular-nums">@_dayLabels[ms.Day]</span>
                    </span>
                </span>
            }
        </div>
    </div>
</section>

@code {
    private const int TotalDays = 20;
    private const int TodayDay = 10;

    private string? _selectedTask = "t3";

    private int _completedCount => _tasks.Count(t => t.Status == TaskStatus.Completed);
    private int _activeCount => _tasks.Count(t => t.Status == TaskStatus.InProgress);

    private enum TaskStatus { Completed, InProgress, Upcoming, Blocked }

    private record GanttTask(string Id, string Name, string Assignee, TaskStatus Status, int StartDay, int EndDay, int Progress);
    private record GanttMilestone(string Id, string Label, int Day);
    private record StatusBarConfig(string Bg, string Fill);

    private static readonly string[] _dayLabels =
    [
        "Mar 3", "Mar 4", "Mar 5", "Mar 6", "Mar 7",
        "Mar 10", "Mar 11", "Mar 12", "Mar 13", "Mar 14",
        "Mar 17", "Mar 18", "Mar 19", "Mar 20", "Mar 21",
        "Mar 24", "Mar 25", "Mar 26", "Mar 27", "Mar 28",
    ];

    private static readonly int[] _weekBoundaries = [0, 5, 10, 15];

    private static readonly string[] _weeks = ["Week 1", "Week 2", "Week 3", "Week 4"];

    private static readonly GanttTask[] _tasks =
    [
        new("t1", "API schema design",          "Sarah K.",  TaskStatus.Completed,  0,  3, 100),
        new("t2", "Database migration",          "Marcus L.", TaskStatus.Completed,  2,  6, 100),
        new("t3", "Auth service implementation", "Sarah K.",  TaskStatus.InProgress, 4, 11,  65),
        new("t4", "Frontend components",         "Alex W.",   TaskStatus.InProgress, 6, 14,  40),
        new("t5", "Payment integration",         "Marcus L.", TaskStatus.Upcoming,   8, 13,   0),
        new("t6", "E2E test suite",              "Priya R.",  TaskStatus.Upcoming,  12, 17,   0),
        new("t7", "Performance audit",           "Alex W.",   TaskStatus.Blocked,   15, 18,   0),
        new("t8", "Launch preparation",          "Priya R.",  TaskStatus.Upcoming,  17, 19,   0),
    ];

    private static readonly GanttMilestone[] _milestones =
    [
        new("m1", "API Freeze",   4),
        new("m2", "Beta Release", 14),
        new("m3", "Launch",       19),
    ];

    private static readonly Dictionary<TaskStatus, StatusBarConfig> _statusBar = new()
    {
        [TaskStatus.Completed]  = new("bg-emerald-500/15", "bg-emerald-500"),
        [TaskStatus.InProgress] = new("bg-blue-500/15",    "bg-blue-500"),
        [TaskStatus.Upcoming]   = new("bg-muted",          "bg-muted-foreground/30"),
        [TaskStatus.Blocked]    = new("bg-red-500/10",     "bg-red-500/40"),
    };

    private static readonly Dictionary<TaskStatus, string> _statusDot = new()
    {
        [TaskStatus.Completed]  = "bg-emerald-500",
        [TaskStatus.InProgress] = "bg-blue-500",
        [TaskStatus.Upcoming]   = "bg-muted-foreground/30",
        [TaskStatus.Blocked]    = "bg-red-500",
    };

    private static readonly Dictionary<TaskStatus, string> _statusLabel = new()
    {
        [TaskStatus.Completed]  = "Done",
        [TaskStatus.InProgress] = "Active",
        [TaskStatus.Upcoming]   = "Planned",
        [TaskStatus.Blocked]    = "Blocked",
    };
}
