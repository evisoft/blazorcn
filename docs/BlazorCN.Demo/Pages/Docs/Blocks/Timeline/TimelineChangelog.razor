@* ============================================================
   Block: timeline-changelog
   Title: TimelineChangelog
   Description: React product changelog timeline with version badges and categorized changes, built with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-changelog.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Changelog</span>
            <span class="text-muted-foreground text-xs">@_releases.Length releases</span>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var rel in _releases)
                {
                    var release = rel;
                    var isLast = release.Id == _releases[_releases.Length - 1].Id;
                    <div class="relative flex gap-4 pb-8 @(isLast ? "!pb-0" : "")">
                        @* Vertical line *@
                        @if (!isLast)
                        {
                            <div class="absolute top-8 bottom-0 left-[23px] w-px bg-border"></div>
                        }

                        @* Version badge node *@
                        <div class="relative z-10 shrink-0 pt-0.5">
                            <BadgeCn Variant="BadgeVariant.Outline" Class="h-6 min-w-[48px] justify-center rounded-full font-mono text-[11px] font-semibold ring-2 ring-card">
                                @release.Version
                            </BadgeCn>
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@release.Title</span>
                            </div>
                            <span class="text-muted-foreground text-xs">@release.Date</span>

                            @* Changes list *@
                            <div class="mt-3 space-y-2">
                                @foreach (var chg in release.Changes)
                                {
                                    var change = chg;
                                    var cfg = GetCategoryConfig(change.Category);
                                    <div class="flex items-start gap-2">
                                        <span class="@($"mt-[7px] size-1.5 shrink-0 rounded-full {cfg.Dot}")"></span>
                                        <p class="text-muted-foreground text-sm leading-relaxed">
                                            <span class="font-medium text-foreground text-xs">@cfg.Label</span>
                                            @(" ")@change.Text
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum ChangeCategory { Added, Fixed, Improved, Removed }

    private record Change(ChangeCategory Category, string Text);

    private record Release(string Id, string Version, string Date, string Title, Change[] Changes);

    private record CategoryConfig(string Label, string Dot);

    private static CategoryConfig GetCategoryConfig(ChangeCategory cat) => cat switch
    {
        ChangeCategory.Added    => new("Added",    "bg-emerald-500"),
        ChangeCategory.Fixed    => new("Fixed",    "bg-blue-500"),
        ChangeCategory.Improved => new("Improved", "bg-amber-500"),
        ChangeCategory.Removed  => new("Removed",  "bg-red-500"),
        _                       => new("Other",    "bg-muted-foreground"),
    };

    private static readonly Release[] _releases =
    [
        new("1", "2.4.0", "Mar 22, 2026", "Team workspaces and real-time collaboration",
        [
            new(ChangeCategory.Added,    "Team workspaces with role-based permissions"),
            new(ChangeCategory.Added,    "Real-time cursor presence for collaborative editing"),
            new(ChangeCategory.Added,    "Workspace-level API keys with scoped access"),
            new(ChangeCategory.Improved, "Dashboard load time reduced by 40% with streaming SSR"),
            new(ChangeCategory.Fixed,    "Session expiry no longer redirects during active editing"),
        ]),
        new("2", "2.3.1", "Mar 15, 2026", "Performance improvements and bug fixes",
        [
            new(ChangeCategory.Fixed,    "WebSocket reconnection dropping pending messages"),
            new(ChangeCategory.Fixed,    "CSV export truncating rows beyond 10,000 entries"),
            new(ChangeCategory.Improved, "Search indexing now processes in background workers"),
            new(ChangeCategory.Improved, "Reduced bundle size by 18% with tree-shaking improvements"),
        ]),
        new("3", "2.3.0", "Mar 8, 2026", "Advanced analytics and custom dashboards",
        [
            new(ChangeCategory.Added,   "Custom dashboard builder with drag-and-drop widgets"),
            new(ChangeCategory.Added,   "Funnel analysis with multi-step conversion tracking"),
            new(ChangeCategory.Added,   "Scheduled report delivery via email and Slack"),
            new(ChangeCategory.Improved, "Chart rendering performance for datasets over 100K points"),
            new(ChangeCategory.Removed,  "Legacy analytics v1 endpoints (deprecated since v2.0)"),
        ]),
        new("4", "2.2.0", "Feb 28, 2026", "Audit logging and compliance tools",
        [
            new(ChangeCategory.Added,    "Comprehensive audit trail for all workspace actions"),
            new(ChangeCategory.Added,    "SOC 2 compliance report generation"),
            new(ChangeCategory.Fixed,    "Two-factor authentication bypass on password reset flow"),
            new(ChangeCategory.Improved, "API rate limiting now uses sliding window algorithm"),
        ]),
    ];
}
