@* ============================================================
   Block: timeline-with-charts
   Title: TimelineWithCharts
   Description: React vertical timeline with inline mini charts built with Next.js, shadcn/ui Badge, and Tailwind CSS
   Source: original/blocks/timeline/timeline-with-charts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Performance timeline</span>
            </div>
            <span class="text-muted-foreground text-xs">@_milestones.Length milestones</span>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @for (var i = 0; i < _milestones.Length; i++)
                {
                    var ms = _milestones[i];
                    var isLast = i == _milestones.Length - 1;
                    var dotClass = GetStatusDotClass(ms.Status);
                    var lineClass = GetLineColorClass(ms.Status);
                    var contentPb = isLast ? "pb-0" : "pb-6";
                    <div class="relative flex gap-4">
                        @* Line + Dot column *@
                        <div class="flex flex-col items-center">
                            <div class="@($"relative z-10 flex size-5 shrink-0 items-center justify-center rounded-full border-2 {dotClass}")">
                                @if (ms.Status == MilestoneStatus.Completed)
                                {
                                    <LucideIconCn Name="check" Size="10" Class="size-2.5 text-white" />
                                }
                                else if (ms.Status == MilestoneStatus.Current)
                                {
                                    <LucideIconCn Name="circle-dot" Size="10" Class="size-2.5 text-white" />
                                }
                                @if (ms.Status == MilestoneStatus.Current)
                                {
                                    <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                }
                            </div>
                            @if (!isLast)
                            {
                                <div class="@($"w-0.5 flex-1 {lineClass}")"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@($"min-w-0 flex-1 {contentPb} pt-0")">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@ms.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@ms.Date</BadgeCn>
                            </div>
                            <p class="mt-1 text-muted-foreground text-sm leading-relaxed">@ms.Description</p>

                            @* Chart + Metric *@
                            <div class="mt-3 rounded-md bg-muted/50 p-3">
                                <div class="mb-2 flex items-baseline justify-between">
                                    <span class="text-muted-foreground text-xs">@ms.Metric.Label</span>
                                    <span class="font-semibold text-sm tabular-nums">@ms.Metric.Value</span>
                                </div>
                                @if (ms.ChartType == MilestoneChartType.Bar)
                                {
                                    var maxVal = ms.ChartData.Max();
                                    var barColor = GetBarColor(ms.Status, false);
                                    <div class="flex flex-col gap-1">
                                        <div class="flex h-12 items-end gap-1">
                                            @foreach (var val in ms.ChartData)
                                            {
                                                <div class="@($"flex-1 rounded-sm {barColor} min-w-0 transition-all")" style="@($"height:{val / maxVal * 100:F1}%")"></div>
                                            }
                                        </div>
                                        @if (ms.ChartLabels != null)
                                        {
                                            <div class="flex gap-1">
                                                @foreach (var lbl in ms.ChartLabels)
                                                {
                                                    <span class="min-w-0 flex-1 text-center text-muted-foreground text-[10px]">@lbl</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    var sMax = ms.ChartData.Max();
                                    var sMin = ms.ChartData.Min();
                                    var sRange = sMax - sMin == 0.0 ? 1.0 : sMax - sMin;
                                    var sparkColor = GetBarColor(ms.Status, true);
                                    <div class="flex h-10 items-end gap-px">
                                        @foreach (var val in ms.ChartData)
                                        {
                                            <div class="@($"min-w-0 flex-1 rounded-sm {sparkColor}")" style="@($"height:{((val - sMin) / sRange * 80 + 20):F1}%")"></div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum MilestoneStatus { Completed, Current, Upcoming }
    private enum MilestoneChartType { Bar, Sparkline }

    private record MilestoneMetric(string Label, string Value);
    private record MilestoneItem(string Id, string Date, string Title, string Description,
        MilestoneStatus Status, MilestoneMetric Metric, MilestoneChartType ChartType,
        double[] ChartData, string[]? ChartLabels = null);

    private static readonly MilestoneItem[] _milestones =
    [
        new("m1", "Jan 2025", "Infrastructure migration",
            "Migrated to edge runtime across 6 regions. Response times dropped from 240ms to 48ms average globally.",
            MilestoneStatus.Completed,
            new("Avg latency", "48ms"),
            MilestoneChartType.Bar,
            [240, 180, 120, 95, 72, 48],
            ["Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]),
        new("m2", "Apr 2025", "User acquisition push",
            "Launched referral program and content marketing. Monthly signups grew 4.2x from January baseline.",
            MilestoneStatus.Completed,
            new("Monthly signups", "8,420"),
            MilestoneChartType.Sparkline,
            [2000, 2400, 2100, 3200, 3800, 4100, 5200, 5900, 6400, 7100, 7800, 8420]),
        new("m3", "Jul 2025", "Revenue milestone",
            "Crossed $100K MRR. Enterprise contracts account for 42% of revenue. Net revenue retention at 134%.",
            MilestoneStatus.Completed,
            new("MRR", "$108K"),
            MilestoneChartType.Bar,
            [12, 24, 38, 52, 67, 84, 108],
            ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul"]),
        new("m4", "Oct 2025", "Platform reliability",
            "Achieved 99.99% uptime for the quarter. Reduced P1 incidents from 8 to 1. Error rate dropped below 0.01%.",
            MilestoneStatus.Current,
            new("Uptime", "99.99%"),
            MilestoneChartType.Sparkline,
            [99.91, 99.93, 99.95, 99.94, 99.97, 99.96, 99.98, 99.97, 99.99, 99.99, 99.99, 99.99]),
        new("m5", "Jan 2026", "API usage growth",
            "Targeting 500M API calls per month by end of Q1. Current trajectory shows 12% week-over-week growth.",
            MilestoneStatus.Upcoming,
            new("API calls/mo", "340M"),
            MilestoneChartType.Bar,
            [180, 210, 240, 270, 300, 340],
            ["Aug", "Sep", "Oct", "Nov", "Dec", "Jan"]),
    ];

    private static string GetStatusDotClass(MilestoneStatus status) => status switch
    {
        MilestoneStatus.Completed => "border-emerald-500 bg-emerald-500",
        MilestoneStatus.Current => "border-blue-500 bg-blue-500",
        _ => "border-muted-foreground/30 bg-transparent"
    };

    private static string GetLineColorClass(MilestoneStatus status) => status switch
    {
        MilestoneStatus.Completed => "bg-emerald-500/30",
        MilestoneStatus.Current => "bg-blue-500/30",
        _ => "bg-muted-foreground/15"
    };

    private static string GetBarColor(MilestoneStatus status, bool sparkline) => status switch
    {
        MilestoneStatus.Completed => sparkline ? "bg-emerald-500/60" : "bg-emerald-500/70",
        MilestoneStatus.Current => sparkline ? "bg-blue-500/60" : "bg-blue-500/70",
        _ => sparkline ? "bg-muted-foreground/25" : "bg-muted-foreground/30"
    };
}
