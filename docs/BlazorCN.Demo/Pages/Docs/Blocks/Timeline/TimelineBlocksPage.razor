                var isLast = idx == _events.Length - 1;
                var isExpanded = _expanded == evt.Id;
                var cfg = GetConfig(evt.Severity);
                var severityClass = evt.Severity == Severity.Error
                    ? ""w-10 shrink-0 pt-px font-mono text-[10px] font-semibold text-red-600 dark:text-red-400""
