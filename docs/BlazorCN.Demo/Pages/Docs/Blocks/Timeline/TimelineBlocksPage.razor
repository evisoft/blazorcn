                            }
                        </div>

                        @* Content *@
                        <div class=""flex min-w-0 flex-1 items-center gap-2"">
                            <span class=""@Cn.Merge(""w-8 text-xs font-medium"", day.Completed ? ""text-foreground"" : ""text-muted-foreground/50"")"">
                                @day.DayOfWeek
                            </span>
                            <span class=""text-muted-foreground text-xs tabular-nums"">@day.Date</span>
                            @if (isFirst)
                            {
                                <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""h-5 font-normal text-[10px]"">Today</BadgeCn>
                            }
                            @if (day.Note != null)
                            {
                                <span class=""ml-auto truncate text-muted-foreground text-xs"">@day.Note</span>
                            }
                            @if (day.Completed && day.Note == null)
                            {
                                <span class=""ml-auto text-emerald-600 text-xs dark:text-emerald-400"">Done</span>
                            }
                            @if (!day.Completed && day.Note == null)
                            {
                                <span class=""ml-auto text-muted-foreground/40 text-xs"">Missed</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

