                <span class=""font-semibold text-sm tabular-nums"">@_totalCalories.ToString(""N0"")</span>
                <span class=""text-muted-foreground text-xs"">kcal</span>
            </div>
            <span class=""text-muted-foreground/40 text-xs"">·</span>
            <div class=""flex items-center gap-1.5"">
                <LucideIconCn Name=""heart"" Size=""12"" Class=""size-3 text-muted-foreground"" />
