                        </div>
                    }
                </div>
            </div>
        </div>

        @* Day column headers *@
        <div class=""flex border-b"">
            <div class=""w-48 shrink-0 border-r""></div>
            <div class=""relative flex flex-1"">
                @for (int i = 0; i < _dayLabels.Length; i++)
                {
                    var label = _dayLabels[i];
                    var idx = i;
                    var isWeekBoundary = _weekBoundaries.Contains(idx) && idx > 0;
                    <div class=""@Cn.Merge(""flex-1 py-1 text-center"", isWeekBoundary ? ""border-l"" : """")"">
                        <span class=""text-[10px] text-muted-foreground tabular-nums"">@label.Split(' ')[1]</span>
