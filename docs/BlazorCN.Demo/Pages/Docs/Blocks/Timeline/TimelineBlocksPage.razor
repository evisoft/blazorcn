                </span>
            </div>
        </div>

        @* Week headers *@
        <div class=""flex border-b"">
            <div class=""w-48 shrink-0 border-r px-4 py-2"">
                <span class=""font-medium text-muted-foreground text-xs"">Task</span>
            </div>
            <div class=""relative flex-1"">
                <div class=""flex"">
                    @foreach (var week in _weeks)
                    {
                        <div class=""flex-1 border-r px-2 py-2 text-center last:border-r-0"">
