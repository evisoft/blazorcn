                var isLast = i == _tasks.Length - 1;
                var isSelected = _selectedTask == task.Id;
                var leftPct = (task.StartDay * 100.0 / TotalDays);
                var widthPct = ((task.EndDay - task.StartDay + 1) * 100.0 / TotalDays);
                var cfg = _statusBar[task.Status];
                var dot = _statusDot[task.Status];
                var taskCapture = task;
                var isSelectedCapture = isSelected;
                <div class=""@(isLast ? """" : ""border-b"")"">
