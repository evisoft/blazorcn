                    : ""mt-0.5 size-3.5 shrink-0 text-muted-foreground/60 transition-transform duration-200"";
                var evtId = evt.Id;

                <div class=""@(isLast ? """" : ""border-b"")"">
                    <button type=""button""
                            @onclick=""@(() => ToggleExpand(evtId))""
                            class=""flex w-full items-start gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50"">
                        @* Timeline dot + line *@
                        <div class=""relative flex shrink-0 items-center pt-1"">
                            <span class=""@($""size-2 rounded-full {cfg.Dot}"")""></span>
                            @if (!isLast)
