                                    <LucideIconCn Name=""circle-dot"" Size=""14"" Class=""size-3.5 text-white"" />
                                    <span class=""absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20""></span>
                                }
                                else
                                {
                                    <LucideIconCn Name=""circle"" Size=""14"" Class=""size-3.5 text-muted-foreground/40"" />
                                }
                            </div>
                            @* Connector *@
                            @if (!isLast)
                            {
                                <div class=""@($""w-0.5 flex-1 {cfg.Line}"")""></div>
                            }
                        </div>

                        @* Content *@
                        <div class=""@($""min-w-0 flex-1 {(isLast ? ""pb-0"" : ""pb-6"")}"")"">
                            @* Sprint header *@
                            <div class=""flex items-center gap-2"">
                                <span class=""@Cn.Merge(""font-medium text-sm"", sprint.Status == SprintStatus.Planned ? ""text-muted-foreground"" : """")"">
                                    @sprint.Name
                                </span>
                                <BadgeCn Variant=""BadgeVariant.Secondary""
                                         Class=""@Cn.Merge(""font-normal text-xs"", sprint.Status == SprintStatus.Active ? ""border-blue-500/20 bg-blue-500/10 text-blue-600 dark:text-blue-400"" : """")"">
                                    @(sprint.Status == SprintStatus.Completed ? ""Done"" : sprint.Status == SprintStatus.Active ? ""In progress"" : ""Planned"")
                                </BadgeCn>
                            </div>
                            <span class=""mt-0.5 block text-muted-foreground text-xs"">@sprint.DateRange</span>

                            @* Goal *@
                            <p class=""mt-1.5 text-muted-foreground text-xs"">@sprint.Goal</p>

                            @* Points + Progress *@
                            <div class=""mt-2.5 flex items-center gap-3"">
                                <div class=""flex items-center gap-1.5"">
                                    <LucideIconCn Name=""flame"" Size=""12"" Class=""size-3 text-muted-foreground"" />
                                    <span class=""font-mono text-xs tabular-nums"">
                                        @sprint.CompletedPoints<span class=""text-muted-foreground"">/@sprint.TotalPoints pts</span>
                                    </span>
                                </div>
                                @* Burndown bar *@
                                <div class=""h-1.5 flex-1 overflow-hidden rounded-full bg-muted"">
                                    <div class=""@Cn.Merge(""h-full rounded-full transition-all"", sprint.Status == SprintStatus.Completed ? ""bg-emerald-500"" : sprint.Status == SprintStatus.Active ? ""bg-blue-500"" : ""bg-transparent"")""
                                         style=""@($""width:{progress}%"")"">
                                    </div>
                                </div>
                                <span class=""font-mono text-muted-foreground text-xs tabular-nums"">@(progress)%</span>
                            </div>

                            @* Stories *@
                            <div class=""mt-2.5 space-y-0"">
                                @foreach (var story in sprint.Stories)
                                {
                                    <div class=""flex items-center gap-2 py-1"">
                                        <span class=""@Cn.Merge(""size-1.5 shrink-0 rounded-full"", story.Done ? ""bg-emerald-500"" : ""bg-muted-foreground/30"")""></span>
                                        <span class=""@Cn.Merge(""min-w-0 flex-1 truncate text-xs"", story.Done ? ""text-muted-foreground line-through"" : sprint.Status == SprintStatus.Planned ? ""text-muted-foreground"" : ""text-foreground"")"">
                                            @story.Title
                                        </span>
                                        <span class=""shrink-0 font-mono text-muted-foreground text-xs tabular-nums"">@story.Points</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

