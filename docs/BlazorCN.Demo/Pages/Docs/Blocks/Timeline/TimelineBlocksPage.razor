                    NodeType.Task),
            ]),
        new(""n3"", ""Aug 2025"", ""Public launch"",
            ""General availability release with documentation, pricing page, and support channels."",
            NodeType.Milestone,
            [
                new(""n3a"", ""Sep 2025"", ""Pricing model finalized"",
                    ""Three tiers: Free, Pro at $29/mo, and Team at $79/mo. Annual discounts at 20%."",
                    NodeType.Decision),
                new(""n3b"", ""Oct 2025"", ""First 1,000 paying customers"",
                    ""Reached $30K MRR milestone. Churn rate at 4.2% monthly. NPS score of 58."",
                    NodeType.Milestone),
            ]),
        new(""n4"", ""Jan 2026"", ""Series A planning"",
            ""Preparing fundraise materials, financial models, and investor pipeline for Q2 raise."",
            NodeType.Milestone),
    ];

    private readonly HashSet<string> _expanded = [""n1"", ""n2"", ""n2a"", ""n3""];

    private void Toggle(string id)
    {
        if (_expanded.Contains(id))
            _expanded.Remove(id);
        else
            _expanded.Add(id);
    }

    private List<FlatNode> GetFlatNodes()
    {
        var result = new List<FlatNode>();
        AddFlatNodes(result, _treeData, 0);
        return result;
    }

    private void AddFlatNodes(List<FlatNode> result, TreeNode[] nodes, int depth)
    {
        for (int i = 0; i < nodes.Length; i++)
        {
            var node = nodes[i];
            bool isLast = i == nodes.Length - 1;
            result.Add(new FlatNode(node, depth, isLast));
            if (node.Children != null && node.Children.Length > 0 && _expanded.Contains(node.Id))
            {
                AddFlatNodes(result, node.Children, depth + 1);
            }
        }
    }

    private static int CountNodes(TreeNode[] nodes)
    {
        int count = 0;
        foreach (var n in nodes)
            count += 1 + (n.Children != null ? CountNodes(n.Children) : 0);
        return count;
    }

    private int TotalNodes => CountNodes(_treeData);
}";

