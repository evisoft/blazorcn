@code {
    private record ApiRequest(
        string Id,
        string Method,
        string Path,
        int Status,
        string Duration,
        string Timestamp,
        string RequestId,
        string ResponseSize,
        string? Detail = null
    );

    private static readonly ApiRequest[] _requests =
    [
        new(""1"", ""POST"", ""/api/auth/login"", 200, ""142ms"", ""14:32:18"", ""req_8f2a4b1c"", ""1.2 KB"",
            ""User sarah@acme.com authenticated. Token issued with 24h expiry. Session created for workspace ws_prod_01.""),
        new(""2"", ""GET"", ""/api/users/me/profile"", 200, ""23ms"", ""14:32:19"", ""req_c3d9e7f0"", ""3.8 KB""),
        new(""3"", ""GET"", ""/api/projects?workspace=ws_prod_01&limit=25"", 200, ""89ms"", ""14:32:20"", ""req_a1b2c3d4"", ""12.4 KB""),
        new(""4"", ""POST"", ""/api/projects/proj_42/deployments"", 201, ""340ms"", ""14:32:24"", ""req_e5f6a7b8"", ""0.8 KB"",
            ""Deployment deploy_891 created for project proj_42. Build queued at position 3. Estimated start in 45 seconds.""),
        new(""5"", ""GET"", ""/api/deployments/deploy_891/status"", 200, ""18ms"", ""14:33:10"", ""req_d4c3b2a1"", ""0.4 KB""),
        new(""6"", ""PUT"", ""/api/projects/proj_42/settings"", 200, ""67ms"", ""14:33:28"", ""req_f8e7d6c5"", ""2.1 KB"",
            ""Updated environment variables: added DATABASE_URL, REDIS_URL. Removed deprecated API_KEY_V1. Changes applied to production environment.""),
        new(""7"", ""DELETE"", ""/api/projects/proj_38/deployments/deploy_847"", 204, ""112ms"", ""14:34:02"", ""req_b9a8c7d6"", ""0 B"",
            ""Deployment deploy_847 cancelled and resources deallocated. Associated build artifacts purged from storage.""),
        new(""8"", ""GET"", ""/api/analytics/events?from=2026-03-17&to=2026-03-24"", 504, ""30,000ms"", ""14:34:15"", ""req_1a2b3c4d"", ""0 B"",
            ""Gateway timeout. Upstream analytics-service did not respond within 30s. Query spans 7 days across 2.4M events. Consider narrowing the date range or using the /analytics/summary endpoint.""),
    ];

    private static readonly int _totalRequests = _requests.Length;
    private static readonly int _errorCount = System.Linq.Enumerable.Count(_requests, r => r.Status >= 400);

    private string? _expanded = ""8"";

    private void ToggleExpand(string id, bool hasDetail)
    {
        if (!hasDetail) return;
        _expanded = _expanded == id ? null : id;
    }

    private static string GetMethodDot(string method) => method switch
    {
        ""GET"" => ""bg-blue-500"",
        ""POST"" => ""bg-emerald-500"",
        ""PUT"" => ""bg-amber-500"",
        ""PATCH"" => ""bg-amber-500"",
        ""DELETE"" => ""bg-red-500"",
        _ => ""bg-muted-foreground""
    };

    private static string GetMethodBg(string method) => method switch
    {
        ""GET"" => ""bg-blue-500/10"",
        ""POST"" => ""bg-emerald-500/10"",
        ""PUT"" => ""bg-amber-500/10"",
        ""PATCH"" => ""bg-amber-500/10"",
        ""DELETE"" => ""bg-red-500/10"",
        _ => """"
    };

    private static string GetMethodText(string method) => method switch
    {
        ""GET"" => ""text-blue-600 dark:text-blue-400"",
        ""POST"" => ""text-emerald-600 dark:text-emerald-400"",
        ""PUT"" => ""text-amber-600 dark:text-amber-400"",
        ""PATCH"" => ""text-amber-600 dark:text-amber-400"",
        ""DELETE"" => ""text-red-600 dark:text-red-400"",
        _ => """"
    };

    private static string StatusColor(int status)
    {
        if (status >= 500) return ""text-red-600 dark:text-red-400"";
        if (status >= 400) return ""text-amber-600 dark:text-amber-400"";
        if (status >= 300) return ""text-blue-600 dark:text-blue-400"";
        return ""text-emerald-600 dark:text-emerald-400"";
    }

    private static string DurationColor(string duration)
    {
        var numStr = System.Text.RegularExpressions.Regex.Replace(duration, ""[^0-9]"", """");
        if (int.TryParse(numStr, out var ms))
        {
            if (ms >= 5000) return ""text-red-600 dark:text-red-400"";
            if (ms >= 1000) return ""text-amber-600 dark:text-amber-400"";
        }
        return ""text-muted-foreground"";
    }
}";

