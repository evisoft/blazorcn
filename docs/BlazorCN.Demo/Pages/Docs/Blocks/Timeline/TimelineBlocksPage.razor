    private record ProjectItem(Project Project, int Index, bool ShowYearHeader, bool IsLast);

    private static readonly Project[] _projects =
    [
        new(""p1"", ""Meridian Design System"",
            ""Built a comprehensive design system with 120+ components, token-based theming, and automated accessibility testing. Adopted by 8 product teams across the organization."",
            ""2026"", ""Lead Engineer"", [""React"", ""TypeScript"", ""Storybook"", ""Figma""], ""meridian.design""),
