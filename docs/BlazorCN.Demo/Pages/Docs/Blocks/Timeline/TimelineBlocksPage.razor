                    <ButtonCn Variant=""@(_activeFilter == cfgItem.Category ? ButtonVariant.Default : ButtonVariant.Outline)"" Size=""ButtonSize.Sm"" Class=""h-6 text-xs"" @onclick=""@(() => _activeFilter = cfgItem.Category)"">
