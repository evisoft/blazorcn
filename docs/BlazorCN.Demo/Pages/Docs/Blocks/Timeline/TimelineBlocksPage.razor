@code {
    private record Author(string Name, string Initials);

    private record ReplyItem(string Id, Author Author, string Content, string Timestamp, int Votes);

    private record CommentItem(string Id, Author Author, string Content, string Timestamp, int Votes, ReplyItem[] Replies);

    private static readonly CommentItem[] _comments =
    [
        new(""c1"", new(""Elena Vasquez"", ""EV""),
            ""The new edge caching strategy is impressive, but I am curious about cache invalidation. How do you handle stale data when a user updates their profile and the cached version is served to a different region?"",
            ""3 hours ago"", 24,
            [
                new(""r1a"", new(""David Park"", ""DP""),
                    ""We use a two-phase approach. Write operations publish an invalidation event to a global pub/sub channel, and each edge node subscribes and purges the relevant keys. P99 propagation is under 200ms."",
                    ""2 hours ago"", 18),
                new(""r1b"", new(""Elena Vasquez"", ""EV""),
                    ""That is cleaner than I expected. Do you use a TTL as a safety net in case the invalidation event is dropped?"",
                    ""2 hours ago"", 7),
                new(""r1c"", new(""David Park"", ""DP""),
                    ""Yes, 60-second TTL on all edge-cached entries. The pub/sub handles the happy path, and TTL covers partition scenarios. We have not seen stale reads beyond 300ms in production."",
                    ""1 hour ago"", 12),
            ]),
        new(""c2"", new(""Marcus Rivera"", ""MR""),
            ""Have you considered using Consistent Hashing for the cache key distribution? It would reduce the thundering herd problem during deployments when a large portion of the cache is invalidated at once."",
            ""2 hours ago"", 15,
            [
                new(""r2a"", new(""Ava Patel"", ""AP""),
                    ""We actually moved away from consistent hashing because our key space is highly skewed. A small number of hot keys account for 80% of reads. We use a dedicated hot-key cache tier instead."",
                    ""1 hour ago"", 21),
            ]),
        new(""c3"", new(""James Wilson"", ""JW""),
            ""Solid architecture post. One thing I would add: monitoring cache hit ratios per route is essential. We found that 3 API endpoints had sub-20% hit rates and were better served without caching at all."",
            ""1 hour ago"", 31,
            []),
        new(""c4"", new(""Lina Nakamura"", ""LN""),
            ""The latency improvement numbers are great but I am wondering about the cold start story. After a deployment, how long until the cache is warm enough to see those P95 numbers?"",
            ""45 min ago"", 9,
            [
                new(""r4a"", new(""David Park"", ""DP""),
                    ""We pre-warm the top 500 keys from a precomputed manifest during deployment. That covers about 70% of traffic. The remaining keys warm organically within 2-3 minutes of receiving real traffic."",
                    ""30 min ago"", 14),
            ]),
    ];

    private int _totalComments = 0;
    private Dictionary<string, int> _voteDelta = new();
    private HashSet<string> _collapsedReplies = new();

    protected override void OnInitialized()
    {
        _totalComments = _comments.Sum(c => 1 + c.Replies.Length);
    }

    private int GetVote(string id) => _voteDelta.TryGetValue(id, out var v) ? v : 0;

    private void Vote(string id, int direction)
    {
        var current = GetVote(id);
        var next = current == direction ? 0 : direction;
        _voteDelta[id] = next;
    }

    private void ToggleReplies(string commentId)
    {
        if (_collapsedReplies.Contains(commentId))
            _collapsedReplies.Remove(commentId);
        else
            _collapsedReplies.Add(commentId);
    }
}";

