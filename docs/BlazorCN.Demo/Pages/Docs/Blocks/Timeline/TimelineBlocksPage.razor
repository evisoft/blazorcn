    private const string TimelineNestedCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @* Header *@
        <div class=""flex items-center justify-between border-b px-4 py-3"">
            <div class=""flex items-center gap-2"">
                <LucideIconCn Name=""git-branch"" Size=""16"" Class=""size-4 text-muted-foreground"" />
                <span class=""font-medium text-sm"">Project roadmap</span>
            </div>
            <span class=""text-muted-foreground text-xs"">
                @_completedCount of @_entries.Length phases completed
            </span>
        </div>

        @* Timeline *@
        <div class=""px-4 py-4"">
            <div class=""relative"">
                @foreach (var entry in _entries)
                {
                    var index = System.Array.IndexOf(_entries, entry);
                    var isLast = index == _entries.Length - 1;
                    var isExpanded = _expanded.Contains(entry.Id);
                    var hasSubEntries = entry.SubEntries != null && entry.SubEntries.Length > 0;

                    var dotClass = entry.Status == EntryStatus.Completed
                        ? ""border-emerald-500 bg-emerald-500""
                        : entry.Status == EntryStatus.Active
                            ? ""border-blue-500 bg-blue-500""
                            : ""border-muted-foreground/30 bg-transparent"";

                    var lineClass = entry.Status == EntryStatus.Completed
                        ? ""bg-emerald-500/30""
                        : entry.Status == EntryStatus.Active
                            ? ""bg-gradient-to-b from-blue-500/30 to-muted-foreground/15""
                            : ""bg-muted-foreground/15"";

                    var titleClass = entry.Status == EntryStatus.Pending
                        ? ""font-medium text-sm text-muted-foreground""
                        : ""font-medium text-sm"";

                    var chevronClass = isExpanded
                        ? ""size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 rotate-90""
                        : ""size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200"";

                    var entryId = entry.Id;

                    <div class=""relative flex gap-4"">
                        @* Line + Dot column *@
                        <div class=""flex flex-col items-center"">
                            <div class=""@Cn.Merge(""relative z-10 flex size-6 shrink-0 items-center justify-center rounded-full border-2"", dotClass)"">
                                @if (entry.Status == EntryStatus.Completed)
                                {
                                    <LucideIconCn Name=""check-circle-2"" Size=""12"" Class=""size-3 text-white"" />
                                }
                                else if (entry.Status == EntryStatus.Active)
                                {
                                    <LucideIconCn Name=""circle-dot"" Size=""12"" Class=""size-3 text-white"" />
                                    <span class=""absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20""></span>
                                }
                                else
                                {
                                    <LucideIconCn Name=""circle"" Size=""12"" Class=""size-3 text-muted-foreground/40"" />
                                }
                            </div>
                            @if (!isLast)
                            {
                                <div class=""@Cn.Merge(""w-0.5 flex-1"", lineClass)""></div>
                            }
                        </div>

                        @* Content column *@
                        <div class=""@Cn.Merge(""min-w-0 flex-1 pt-0.5"", isLast ? ""pb-0"" : ""pb-6"")"">
                            @* Entry header *@
                            @if (hasSubEntries)
                            {
                                <button type=""button""
                                        @onclick=""@(() => Toggle(entryId))""
                                        class=""-ml-1 flex w-full items-center gap-2 rounded-md px-1 py-0.5 text-left transition-colors hover:bg-muted/50"">
                                    <LucideIconCn Name=""chevron-right"" Size=""16"" Class=""@chevronClass"" />
                                    <div class=""min-w-0 flex-1"">
                                        <div class=""flex items-center gap-2"">
                                            <span class=""@titleClass"">@entry.Title</span>
                                            <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs"">@entry.Tag</BadgeCn>
                                        </div>
                                        <div class=""mt-0.5 flex items-center gap-2"">
                                            <span class=""text-muted-foreground text-xs"">@entry.Date</span>
                                            <span class=""text-muted-foreground text-xs"">·</span>
                                            <span class=""text-muted-foreground text-xs"">@(entry.SubEntries?.Length) sub-tasks</span>
                                        </div>
                                    </div>
                                </button>
                            }
                            else
                            {
                                <div class=""ml-5"">
                                    <div class=""flex items-center gap-2"">
                                        <span class=""@titleClass"">@entry.Title</span>
                                        <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs"">@entry.Tag</BadgeCn>
                                    </div>
                                    <span class=""mt-0.5 block text-muted-foreground text-xs"">@entry.Date</span>
                                </div>
                            }

                            @* Description *@
                            <p class=""mt-1.5 ml-5 text-muted-foreground text-xs leading-relaxed"">@entry.Description</p>

                            @* Nested sub-timeline *@
                            @if (isExpanded && hasSubEntries)
                            {
                                <div class=""mt-3 ml-5 rounded-md border border-dashed p-3"">
                                    <div class=""relative"">
                                        @foreach (var sub in entry.SubEntries!)
                                        {
                                            var subIndex = System.Array.IndexOf(entry.SubEntries, sub);
                                            var isSubLast = subIndex == entry.SubEntries.Length - 1;

                                            var subDotClass = sub.Status == EntryStatus.Completed
                                                ? ""bg-emerald-500""
                                                : sub.Status == EntryStatus.Active
                                                    ? ""bg-blue-500""
                                                    : ""bg-muted-foreground/30"";

                                            var subLineClass = sub.Status == EntryStatus.Completed
                                                ? ""bg-emerald-500/20""
                                                : sub.Status == EntryStatus.Active
                                                    ? ""bg-blue-500/20""
                                                    : ""bg-muted-foreground/10"";

                                            var subTitleClass = sub.Status == EntryStatus.Pending
                                                ? ""font-medium text-xs text-muted-foreground""
                                                : ""font-medium text-xs"";

                                            <div class=""relative flex gap-3"">
                                                @* Sub-timeline connector *@
                                                <div class=""flex flex-col items-center"">
                                                    <div class=""@Cn.Merge(""relative z-10 size-2.5 shrink-0 rounded-full"", subDotClass)"">
                                                        @if (sub.Status == EntryStatus.Active)
                                                        {
                                                            <span class=""absolute inset-0 animate-ping rounded-full border border-blue-500 opacity-20""></span>
                                                        }
                                                    </div>
                                                    @if (!isSubLast)
                                                    {
                                                        <div class=""@Cn.Merge(""w-px flex-1"", subLineClass)""></div>
                                                    }
                                                </div>

                                                @* Sub-entry content *@
                                                <div class=""@Cn.Merge(""min-w-0 flex-1 -mt-0.5"", isSubLast ? ""pb-0"" : ""pb-3"")"">
                                                    <span class=""@subTitleClass"">@sub.Title</span>
                                                    <p class=""mt-0.5 text-muted-foreground text-xs leading-relaxed"">@sub.Description</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

