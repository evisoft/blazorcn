        new(""v2"", ""v11"", ""Marcus Rivera"", ""MR"", ""Added executive summary and revised methodology paragraph"",      ""28 min ago"",  283400,   4800),
        new(""v3"", ""v10"", ""Sarah Chen"",    ""SC"", ""Replaced figure 3 with updated chart and rewrote caption"",       ""1 hour ago"",  278600,  -2100),
        new(""v4"", ""v9"",  ""Ava Patel"",     ""AP"", ""Copy-edited sections 2 through 4 for clarity and tone"",          ""2 hours ago"", 280700,   -340, Label: ""Reviewed""),
        new(""v5"", ""v8"",  ""James Wilson"",  ""JW"", ""Inserted appendix A with raw survey data and footnotes"",         ""3 hours ago"", 281040,  12400),
        new(""v6"", ""v7"",  ""Marcus Rivera"", ""MR"", ""Removed duplicate references and consolidated bibliography"",     ""5 hours ago"", 268640,  -3200),
        new(""v7"", ""v6"",  ""Sarah Chen"",    ""SC"", ""Initial draft of results section with placeholder figures"",      ""Yesterday"",   271840,  18600),
    ];

    private string? _restored;

    private async Task HandleRestore(string id)
    {
        _restored = id;
        await Task.Delay(2000);
        _restored = null;
    }

    private static string FormatSize(int bytes)
    {
        if (bytes < 1024) return $""{bytes} B"";
        var kb = bytes / 1024.0;
        if (kb < 1024) return $""{kb:F1} KB"";
        var mb = kb / 1024.0;
        return $""{mb:F1} MB"";
    }

    private static string FormatDelta(int delta)
    {
        var abs = Math.Abs(delta);
        var formatted = abs < 1024 ? $""{abs} B"" : $""{abs / 1024.0:F1} KB"";
        return delta >= 0 ? $""+{formatted}"" : $""-{formatted}"";
    }
}";

