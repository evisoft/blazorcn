            TimelineStatus.Current, ""Security""),
        new(""e7"", ""Apr 2026"", ""GraphQL API public beta"",
            ""Launching a GraphQL API alongside the existing REST endpoints. Includes schema introspection, query complexity limits, persisted queries, and interactive playground."",
            TimelineStatus.Upcoming, ""Feature""),
        new(""e8"", ""May 2026"", ""Edge caching with regional replication"",
            ""Deploy read replicas to 12 edge locations. Cache invalidation within 500ms globally. Static assets served from the nearest PoP with Brotli compression."",
            TimelineStatus.Upcoming, ""Infrastructure""),
    ];

    private string _query = """";

    private List<TimelineEntry> Filtered => string.IsNullOrWhiteSpace(_query)
        ? [.._entries]
        : [.._entries.Where(e =>
            e.Title.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
            e.Description.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
            e.Date.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
            e.Tag.Contains(_query, StringComparison.OrdinalIgnoreCase))];

    private static string StatusDotClass(TimelineStatus status) => status switch
    {
        TimelineStatus.Completed => ""border-emerald-500 bg-emerald-500"",
        TimelineStatus.Current   => ""border-blue-500 bg-blue-500"",
        _                        => ""border-muted-foreground/30 bg-transparent"",
    };

    private static string StatusLineClass(TimelineStatus status) => status switch
    {
        TimelineStatus.Completed => ""bg-emerald-500/40"",
        TimelineStatus.Current   => ""bg-gradient-to-b from-blue-500/40 to-muted-foreground/15"",
        _                        => ""bg-muted-foreground/15"",
    };

    private static string HighlightText(string text, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
            return System.Web.HttpUtility.HtmlEncode(text);

        var escaped = System.Text.RegularExpressions.Regex.Escape(query);
        var regex = new System.Text.RegularExpressions.Regex($""({escaped})"", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var parts = regex.Split(text);
        var sb = new System.Text.StringBuilder();
        foreach (var part in parts)
        {
            if (regex.IsMatch(part))
                sb.Append($""<mark class=\""rounded-sm bg-yellow-200/60 px-0.5 text-inherit dark:bg-yellow-500/20\"">{System.Web.HttpUtility.HtmlEncode(part)}</mark>"");
            else
                sb.Append(System.Web.HttpUtility.HtmlEncode(part));
        }
        return sb.ToString();
    }
}";

