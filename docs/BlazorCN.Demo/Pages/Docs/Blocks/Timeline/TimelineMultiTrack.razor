@* ============================================================
   Block: timeline-multi-track
   Title: TimelineMultiTrack
   Description: React parallel timeline component with color-coded team lanes and shared time axis for Next.js apps using shadcn/ui and Tailwind CSS.
   Source: original/blocks/timeline/timeline-multi-track.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layers" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Multi-track timeline</span>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var track in _tracks)
                {
                    var t = track;
                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <span class="@Cn.Merge("size-1.5 rounded-full", t.ColorDotFirst)"></span>
                        @t.Label
                    </span>
                }
                <span class="text-muted-foreground text-xs">@_totalDone/@_totalEntries done</span>
            </div>
        </div>

        @* Time axis header *@
        <div class="grid grid-cols-[80px_1fr_1fr_1fr] border-b">
            <div class="border-r px-3 py-2">
                <span class="text-muted-foreground text-xs font-medium">Week</span>
            </div>
            @foreach (var track in _tracks)
            {
                var t = track;
                <div class="border-r px-3 py-2 last:border-r-0">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-normal text-xs", t.ColorBadge)">
                        @t.Label
                    </BadgeCn>
                </div>
            }
        </div>

        @* Timeline rows *@
        <div>
            @for (int wi = 0; wi < _weeks.Length; wi++)
            {
                var week = _weeks[wi];
                var weekIndex = wi;
                var isLast = weekIndex == _weeks.Length - 1;
                <div class="@Cn.Merge("grid grid-cols-[80px_1fr_1fr_1fr]", isLast ? "" : "border-b")">
                    @* Week label *@
                    <div class="flex items-start border-r px-3 py-3">
                        <span class="font-mono text-muted-foreground text-xs">@week</span>
                    </div>

                    @* Track entries *@
                    @foreach (var track in _tracks)
                    {
                        var tr = track;
                        if (weekIndex >= tr.Entries.Length)
                        {
                            <div class="border-r px-3 py-3 last:border-r-0"></div>
                        }
                        else
                        {
                            var entry = tr.Entries[weekIndex];
                            var dotColor = entry.Status == EntryStatus.Pending ? "border-muted-foreground/30 bg-transparent" : tr.ColorDot;
                            var iconTextColor = entry.Status == EntryStatus.Pending ? "text-muted-foreground/40" : "text-white";
                            var lineColor = (entry.Status == EntryStatus.Done || entry.Status == EntryStatus.Active) ? tr.ColorLine : "bg-muted-foreground/15";
                            <div class="relative border-r px-3 py-3 last:border-r-0">
                                <div class="flex gap-2.5">
                                    @* Mini timeline connector *@
                                    <div class="flex flex-col items-center">
                                        <div class="@Cn.Merge("relative z-10 flex size-5 shrink-0 items-center justify-center rounded-full border-2", dotColor, iconTextColor)">
                                            @if (entry.Status == EntryStatus.Done)
                                            {
                                                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                                            }
                                            else if (entry.Status == EntryStatus.Active)
                                            {
                                                <LucideIconCn Name="circle-dot" Size="12" Class="size-3" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="circle" Size="12" Class="size-3" />
                                            }
                                            @if (entry.Status == EntryStatus.Active)
                                            {
                                                <span class="@Cn.Merge("absolute inset-0 animate-ping rounded-full border-2 opacity-20", tr.ColorDotSecond)"></span>
                                            }
                                        </div>
                                        @if (!isLast)
                                        {
                                            <div class="@Cn.Merge("w-0.5 flex-1", lineColor)"></div>
                                        }
                                    </div>

                                    @* Entry content *@
                                    <div class="min-w-0 flex-1 pt-0.5">
                                        <span class="@Cn.Merge("font-medium text-sm", entry.Status == EntryStatus.Pending ? "text-muted-foreground" : "")">
                                            @entry.Title
                                        </span>
                                        <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                                            @entry.Description
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum EntryStatus { Done, Active, Pending }

    private record TrackEntry(string Id, string Title, string Description, EntryStatus Status, string Week);

    private sealed class Track
    {
        public string Label { get; init; } = "";
        public string ColorDot { get; init; } = "";
        public string ColorLine { get; init; } = "";
        public string ColorBadge { get; init; } = "";
        public TrackEntry[] Entries { get; init; } = [];

        // split "bg-violet-500 border-violet-500" -> first part for the dot color
        public string ColorDotFirst => ColorDot.Split(' ')[0];
        // split "bg-violet-500 border-violet-500" -> second part for the ping ring border
        public string ColorDotSecond => ColorDot.Split(' ').Length > 1 ? ColorDot.Split(' ')[1] : "";
    }

    private static readonly string[] _weeks = ["Week 1", "Week 2", "Week 3", "Week 4", "Week 5"];

    private static readonly Track[] _tracks =
    [
        new Track
        {
            Label = "Design",
            ColorDot = "bg-violet-500 border-violet-500",
            ColorLine = "bg-violet-500/30",
            ColorBadge = "border-violet-500/20 bg-violet-500/10 text-violet-600 dark:text-violet-400",
            Entries =
            [
                new("d1", "User research interviews", "8 customer interviews completed across 3 segments", EntryStatus.Done, "Week 1"),
                new("d2", "Wireframes and information architecture", "Low-fidelity flows for all 12 screens approved", EntryStatus.Done, "Week 2"),
                new("d3", "High-fidelity mockups", "Pixel-perfect designs with component specs in Figma", EntryStatus.Active, "Week 3"),
                new("d4", "Prototype and usability testing", "Interactive prototype with 5 usability test sessions", EntryStatus.Pending, "Week 4"),
                new("d5", "Design handoff and QA", "Final specs, assets, and redline documentation", EntryStatus.Pending, "Week 5"),
            ],
        },
        new Track
        {
            Label = "Engineering",
            ColorDot = "bg-blue-500 border-blue-500",
            ColorLine = "bg-blue-500/30",
            ColorBadge = "border-blue-500/20 bg-blue-500/10 text-blue-600 dark:text-blue-400",
            Entries =
            [
                new("e1", "API schema and database migration", "PostgreSQL schema with 14 tables, seed data ready", EntryStatus.Done, "Week 1"),
                new("e2", "Core API endpoints", "REST endpoints with auth middleware and validation", EntryStatus.Done, "Week 2"),
                new("e3", "Frontend component scaffold", "React components matching wireframe structure", EntryStatus.Done, "Week 3"),
                new("e4", "Integration and state management", "Connect UI to APIs with optimistic updates", EntryStatus.Active, "Week 4"),
                new("e5", "Performance optimization and testing", "Lighthouse 95+, e2e tests, load testing at 5K concurrent", EntryStatus.Pending, "Week 5"),
            ],
        },
        new Track
        {
            Label = "QA",
            ColorDot = "bg-amber-500 border-amber-500",
            ColorLine = "bg-amber-500/30",
            ColorBadge = "border-amber-500/20 bg-amber-500/10 text-amber-600 dark:text-amber-400",
            Entries =
            [
                new("q1", "Test plan and environment setup", "Test matrix covering 48 scenarios across 3 browsers", EntryStatus.Done, "Week 1"),
                new("q2", "API contract testing", "Automated contract tests for all 22 endpoints", EntryStatus.Done, "Week 2"),
                new("q3", "Functional test execution", "Manual + automated testing of core user flows", EntryStatus.Active, "Week 3"),
                new("q4", "Regression and edge cases", "Full regression suite plus boundary condition testing", EntryStatus.Pending, "Week 4"),
                new("q5", "Sign-off and release certification", "Final approval, release notes, known issues documented", EntryStatus.Pending, "Week 5"),
            ],
        },
    ];

    private int _totalDone => _tracks.Sum(t => t.Entries.Count(e => e.Status == EntryStatus.Done));
    private int _totalEntries => _tracks.Sum(t => t.Entries.Length);
}
