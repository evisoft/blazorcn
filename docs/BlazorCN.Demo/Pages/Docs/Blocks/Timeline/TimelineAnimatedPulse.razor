@* ============================================================
   Block: timeline-animated-pulse
   Title: TimelineAnimatedPulse
   Description: React timeline with pulsing active node, completed and upcoming dots built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-animated-pulse.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Order fulfillment</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_completedCount/@_events.Length complete
                </BadgeCn>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">Order #ORD-7824 · Express delivery</p>
        </div>

        @* Timeline *@
        <div class="relative">
            @foreach (var evt in _events)
            {
                var index = Array.IndexOf(_events, evt);
                var isExpanded = _expanded == evt.Id;
                var isLast = index == _events.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    @* Connecting line segment *@
                    @if (!isLast)
                    {
                        <div
                            class="@($"absolute left-[19px] w-0.5 {(index < _activeIndex ? "bg-foreground/20" : "bg-border")}")"
                            style="@($"top:{index * 60 + 30}px;height:60px;")">
                        </div>
                    }

                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(evt.Id))"
                        class="relative flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Node *@
                        <div class="relative z-10 mt-1 flex shrink-0 items-center justify-center">
                            @if (evt.Status == EventStatus.Completed)
                            {
                                <div class="flex size-5 items-center justify-center rounded-full bg-foreground">
                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-background" />
                                </div>
                            }
                            @if (evt.Status == EventStatus.Active)
                            {
                                <div class="relative flex items-center justify-center">
                                    @* Pulse ring *@
                                    <span class="absolute inline-flex size-5 animate-ping rounded-full bg-foreground/20"></span>
                                    @* Solid dot *@
                                    <span class="relative inline-flex size-3 rounded-full bg-foreground"></span>
                                </div>
                            }
                            @if (evt.Status == EventStatus.Upcoming)
                            {
                                <div class="size-5 rounded-full border-2 border-border bg-card"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@($"font-medium text-sm {(evt.Status == EventStatus.Upcoming ? "text-muted-foreground" : "")}")">
                                    @evt.Title
                                </span>
                                @if (evt.Status == EventStatus.Active)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">In progress</BadgeCn>
                                }
                            </div>
                            <span class="mt-0.5 block text-muted-foreground text-xs">@evt.Time</span>
                        </div>

                        @* Chevron *@
                        <LucideIconCn Name="chevron-right" Size="16" Class="@($"mt-1 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                    </button>

                    @* Expanded detail *@
                    @if (isExpanded)
                    {
                        <div class="mb-3 ml-[36px] mr-4 rounded-md bg-muted/50 p-3">
                            <p class="text-sm leading-relaxed">@evt.Description</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum EventStatus { Completed, Active, Upcoming }

    private record TimelineEvent(string Id, string Title, string Time, EventStatus Status, string Description);

    private static readonly TimelineEvent[] _events =
    [
        new("1", "Order confirmed", "9:04 AM", EventStatus.Completed,
            "Payment processed successfully. Order #ORD-7824 created with 3 line items totaling $249.00. Confirmation email sent to the customer."),
        new("2", "Inventory reserved", "9:05 AM", EventStatus.Completed,
            "All 3 items verified in stock and reserved from warehouse W-02. Pick list generated and assigned to fulfillment queue."),
        new("3", "Picking in progress", "9:32 AM", EventStatus.Completed,
            "Warehouse associate picked all items from zones A-3 and B-7. Items scanned and verified against the order manifest. No substitutions needed."),
        new("4", "Quality check passed", "9:48 AM", EventStatus.Completed,
            "Visual inspection completed. Package weight verified within tolerance. Fragile item wrapped with additional padding. QC stamp applied."),
        new("5", "Packing and labeling", "10:12 AM", EventStatus.Active,
            "Items packed into box size M. Shipping label printed for express delivery. Tracking number generated: TRK-9847562310. Estimated ready for carrier pickup in 15 minutes."),
        new("6", "Carrier pickup", "Estimated 10:45 AM", EventStatus.Upcoming,
            "Scheduled for next carrier sweep. Express lane priority. Package will be scanned at facility dock and loaded onto the afternoon route truck."),
        new("7", "Out for delivery", "Estimated 2:00 PM", EventStatus.Upcoming,
            "Package assigned to local delivery route. Customer will receive a notification with a live tracking link and estimated delivery window."),
    ];

    private string? _expanded = "5";

    private int _completedCount => Array.FindAll(_events, e => e.Status == EventStatus.Completed).Length;
    private int _activeIndex => Array.FindIndex(_events, e => e.Status == EventStatus.Active);

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }
}
