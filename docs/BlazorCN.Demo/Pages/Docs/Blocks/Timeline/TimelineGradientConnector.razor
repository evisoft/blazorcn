@* ============================================================
   Block: timeline-gradient-connector
   Title: TimelineGradientConnector
   Description: React timeline with blue-to-purple gradient connector line using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-gradient-connector.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Project timeline</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_events.Length milestones
                </BadgeCn>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Platform rebuild from kickoff to launch
            </p>
        </div>

        @* Timeline *@
        <div class="relative px-4 py-4">
            @* Gradient line *@
            <div class="absolute top-4 bottom-4 left-[29px] w-0.5 rounded-full bg-gradient-to-b from-blue-500 via-indigo-500 to-purple-500"></div>

            <div class="space-y-0">
                @foreach (var evt in _events)
                {
                    var index = System.Array.IndexOf(_events, evt);
                    var isExpanded = _expanded == evt.Id;
                    var isLast = index == _events.Length - 1;
                    var nodeColor = _nodeColors[index];
                    var ringColor = _ringColors[index];
                    var chevronClass = isExpanded
                        ? "mt-0.5 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 rotate-90"
                        : "mt-0.5 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200";
                    var evtId = evt.Id;

                    <div>
                        <button type="button"
                                @onclick="@(() => SetExpanded(evtId, isExpanded))"
                                class="group flex w-full items-start gap-4 rounded-md px-0 py-3 text-left transition-colors hover:bg-muted/50">
                            @* Node dot *@
                            <div class="relative z-10 flex shrink-0 items-center justify-center">
                                <span class="@Cn.Merge("size-3 rounded-full ring-4", nodeColor, ringColor)"></span>
                            </div>

                            @* Content *@
                            <div class="min-w-0 flex-1 pt-px">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@evt.Title</span>
                                    <span class="text-muted-foreground text-xs">@evt.Date</span>
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-xs">@evt.Category</p>
                            </div>

                            @* Chevron *@
                            <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                        </button>

                        @* Expanded detail *@
                        @if (isExpanded)
                        {
                            <div class="mb-2 ml-7 rounded-md bg-muted/50 p-3">
                                <p class="text-sm leading-relaxed">@evt.Description</p>
                            </div>
                        }

                        @if (!isLast)
                        {
                            <div class="ml-7 border-b"></div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TimelineEvent(string Id, string Title, string Date, string Category, string Description);

    private static readonly TimelineEvent[] _events =
    [
        new("1", "Project kickoff", "Jan 8, 2026", "Planning",
            "Initial requirements gathering, stakeholder alignment meeting, and sprint zero setup for the new platform rebuild."),
        new("2", "Design system finalized", "Feb 3, 2026", "Design",
            "Component library, color tokens, and typography scale approved. Figma handoff completed for all core page templates."),
        new("3", "API contracts signed off", "Feb 19, 2026", "Engineering",
            "REST and GraphQL schema locked for v1. OpenAPI spec published to internal docs portal. Mock server deployed for frontend development."),
        new("4", "Beta release to testers", "Mar 10, 2026", "Release",
            "Internal beta opened to 50 users. Bug reporting channel created. Crash-free rate target set at 99.5% before public launch."),
        new("5", "Public launch", "Mar 24, 2026", "Release",
            "General availability announced. Marketing campaign activated across email, social, and product hunt. On-call rotation scheduled for launch week."),
    ];

    private static readonly string[] _nodeColors =
    [
        "bg-blue-500",
        "bg-blue-400",
        "bg-indigo-500",
        "bg-violet-500",
        "bg-purple-500",
    ];

    private static readonly string[] _ringColors =
    [
        "ring-blue-500/20",
        "ring-blue-400/20",
        "ring-indigo-500/20",
        "ring-violet-500/20",
        "ring-purple-500/20",
    ];

    private string? _expanded = "3";

    private void SetExpanded(string id, bool currentlyExpanded)
    {
        _expanded = currentlyExpanded ? null : id;
    }
}
