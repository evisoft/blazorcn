@* ============================================================
   Block: timeline-investment-portfolio
   Title: TimelineInvestmentPortfolio
   Description: React investment timeline tracking trades with P&L indicators and portfolio value using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-investment-portfolio.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Portfolio activity</span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_totalGains gains
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_totalLosses losses
                </span>
            </div>
        </div>

        @* Portfolio value *@
        <div class="flex items-baseline gap-2 border-b px-4 py-3">
            <span class="font-semibold text-2xl tabular-nums">$127,840.00</span>
            <span class="text-muted-foreground text-xs">portfolio value</span>
            <span class="ml-auto flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                +12.3%
            </span>
        </div>

        @* Timeline *@
        <div class="py-1">
            @foreach (var trade in _trades)
            {
                var tradeId = trade.Id;
                var index = System.Array.IndexOf(_trades, trade);
                var isLast = index == _trades.Length - 1;
                var isExpanded = _expanded == trade.Id;
                var dotColor = trade.PnlDirection == "gain"
                    ? "bg-emerald-500"
                    : trade.PnlDirection == "loss"
                        ? "bg-red-500"
                        : "bg-blue-500";
                var chevronClass = isExpanded
                    ? "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 rotate-90"
                    : "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200";
                var badgeVariant = trade.Action == "buy" ? BadgeVariant.Outline : BadgeVariant.Secondary;
                var badgeLabel = trade.Action == "buy" ? "Buy" : "Sell";
                var pnlClass = trade.PnlDirection == "gain"
                    ? "block text-xs tabular-nums text-emerald-600 dark:text-emerald-400"
                    : "block text-xs tabular-nums text-red-600 dark:text-red-400";

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => SetExpanded(tradeId, isExpanded))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Timeline node *@
                        <div class="relative flex flex-col items-center self-stretch">
                            <div class="@Cn.Merge("relative z-10 mt-1 size-3 shrink-0 rounded-full", dotColor)"></div>
                            @if (!isLast)
                            {
                                <div class="w-px flex-1 bg-border"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono font-semibold text-sm">@trade.Ticker</span>
                                <span class="text-muted-foreground text-xs">@trade.Name</span>
                                <BadgeCn Variant="@badgeVariant" Class="font-normal text-xs">@badgeLabel</BadgeCn>
                            </div>
                            <span class="mt-0.5 block text-muted-foreground text-xs">
                                @trade.Date · @trade.Shares shares @("@") $@trade.PricePerShare
                            </span>
                        </div>

                        @* P&L + chevron *@
                        <div class="flex items-center gap-2">
                            <div class="text-right">
                                <span class="block font-medium text-sm tabular-nums">$@trade.TotalValue</span>
                                @if (trade.Pnl != null && trade.PnlDirection != null)
                                {
                                    <span class="@pnlClass">@trade.Pnl</span>
                                }
                            </div>
                            <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                        </div>
                    </button>

                    @* Expanded detail *@
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-10">
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="text-sm leading-relaxed">@trade.Note</p>
                                <div class="mt-2 flex items-center justify-between">
                                    <span class="font-medium text-muted-foreground text-xs">Portfolio value after</span>
                                    <span class="font-semibold text-sm tabular-nums">$@trade.PortfolioValue</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TradeEvent(
        string Id,
        string Date,
        string Ticker,
        string Name,
        string Action,
        int Shares,
        string PricePerShare,
        string TotalValue,
        string? Pnl,
        string? PnlDirection,
        string PortfolioValue,
        string Note);

    private static readonly TradeEvent[] _trades =
    [
        new("t1", "Mar 24, 2026", "NVDA", "NVIDIA Corp", "sell", 15, "892.40", "13,386.00", "+4,218.75", "gain", "127,840.00", "Trimmed position after 46% run. Holding 25 shares."),
        new("t2", "Mar 21, 2026", "AAPL", "Apple Inc", "buy", 20, "198.50", "3,970.00", null, null, "114,454.00", "Adding to core position on pullback to 200-day MA."),
        new("t3", "Mar 18, 2026", "TSLA", "Tesla Inc", "sell", 10, "171.20", "1,712.00", "−638.00", "loss", "118,424.00", "Stop-loss triggered at support break. Exited full position."),
        new("t4", "Mar 15, 2026", "MSFT", "Microsoft Corp", "buy", 8, "428.90", "3,431.20", null, null, "120,136.00", "New position ahead of earnings. Target $480."),
        new("t5", "Mar 12, 2026", "GOOG", "Alphabet Inc", "sell", 12, "174.85", "2,098.20", "+892.40", "gain", "116,704.80", "Profit target reached. Keeping 18 shares for long term."),
        new("t6", "Mar 8, 2026", "AMD", "Advanced Micro Devices", "buy", 25, "162.30", "4,057.50", null, null, "113,806.60", "Initiating position on AI chip demand thesis."),
    ];

    private string? _expanded = "t1";

    private int _totalGains => System.Array.FindAll(_trades, t => t.PnlDirection == "gain").Length;
    private int _totalLosses => System.Array.FindAll(_trades, t => t.PnlDirection == "loss").Length;

    private void SetExpanded(string id, bool wasExpanded)
    {
        _expanded = wasExpanded ? null : id;
    }
}
