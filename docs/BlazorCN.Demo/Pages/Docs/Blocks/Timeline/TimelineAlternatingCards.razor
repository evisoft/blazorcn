@* ============================================================
   Block: timeline-alternating-cards
   Title: TimelineAlternatingCards
   Description: React timeline with alternating left-right entries centered around a vertical spine built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-alternating-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Company milestones</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_events.Length events
                </BadgeCn>
            </div>
        </div>

        @* Alternating Timeline *@
        <div class="px-4 py-6">
            <div class="relative">
                @* Center spine — continuous vertical line *@
                <div class="absolute top-0 bottom-0 left-1/2 w-px -translate-x-1/2 bg-border" />

                @foreach (var (evt, index) in _events.Select((e, i) => (e, i)))
                {
                    var isLeft = index % 2 == 0;
                    var isLast = index == _events.Length - 1;
                    var currentIndex = Array.FindIndex(_events, e => e.IsCurrent);

                    <div class="@Cn.Merge("relative flex items-start", isLast ? "" : "mb-8")">
                        @* Left content or spacer *@
                        <div class="w-[calc(50%-20px)]">
                            @if (isLeft)
                            {
                                <div class="pr-4 text-right">
                                    <span class="font-medium text-muted-foreground text-xs">
                                        @evt.Date
                                    </span>
                                    <p class="mt-1 font-medium text-sm">@evt.Title</p>
                                    <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                                        @evt.Description
                                    </p>
                                    <div class="mt-2 flex justify-end">
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                            @evt.Tag
                                        </BadgeCn>
                                    </div>
                                </div>
                            }
                        </div>

                        @* Center dot *@
                        <div class="relative z-10 flex w-10 shrink-0 items-start justify-center">
                            <div class="@Cn.Merge("flex size-7 items-center justify-center rounded-full border-2",
                                evt.IsCurrent
                                    ? "border-blue-500 bg-blue-500 text-white"
                                    : (currentIndex >= 0 && index < currentIndex)
                                        ? "border-emerald-500/60 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
                                        : "border-muted-foreground/20 bg-muted/50 text-muted-foreground")">
                                <LucideIconCn Name="@evt.IconName" Size="14" Class="size-3.5" />
                            </div>
                            @if (evt.IsCurrent)
                            {
                                <span class="absolute top-0 left-1/2 flex size-7 -translate-x-1/2 items-center justify-center">
                                    <span class="absolute size-7 animate-ping rounded-full border-2 border-blue-500 opacity-15" />
                                </span>
                            }
                        </div>

                        @* Right content or spacer *@
                        <div class="w-[calc(50%-20px)]">
                            @if (!isLeft)
                            {
                                <div class="pl-4">
                                    <span class="font-medium text-muted-foreground text-xs">
                                        @evt.Date
                                    </span>
                                    <p class="mt-1 font-medium text-sm">@evt.Title</p>
                                    <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                                        @evt.Description
                                    </p>
                                    <div class="mt-2">
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                            @evt.Tag
                                        </BadgeCn>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TimelineEvent(string Id, string Date, string Title, string Description, string IconName, string Tag, bool IsCurrent = false);

    private static readonly TimelineEvent[] _events =
    [
        new("e1", "Q1 2025", "Concept and validation",
            "Conducted 40 customer discovery interviews, validated the core problem hypothesis, and secured $2.1M in seed funding from Sequoia Scout.",
            "calendar", "Research"),
        new("e2", "Q2 2025", "Technical foundation",
            "Architected the real-time collaboration engine, established CI/CD pipelines, and shipped the first internal dogfooding build to the engineering team.",
            "code", "Engineering"),
        new("e3", "Q3 2025", "Closed beta with design partners",
            "Onboarded 12 design partner companies. Iterated through 3 major UI revisions based on session recordings and feedback calls. NPS score reached 62.",
            "users", "Beta"),
        new("e4", "Q4 2025", "Product Hunt launch",
            "Launched on Product Hunt and reached #2 Product of the Day. Acquired 2,400 sign-ups in the first week with a 34% activation rate.",
            "rocket", "Launch", true),
        new("e5", "Q1 2026", "Enterprise tier and SOC 2",
            "Shipping SSO/SAML, audit logs, and role-based access controls. SOC 2 Type II certification in progress with completion targeted for March.",
            "zap", "Enterprise"),
    ];
}
