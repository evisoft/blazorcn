@* ============================================================
   Block: timeline-map-route
   Title: TimelineMapRoute
   Description: React timeline component displaying journey waypoints with travel modes, distances, and durations for Next.js apps using shadcn/ui and Tailwind CSS.
   Source: original/blocks/timeline/timeline-map-route.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="navigation" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Conference day route</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                    @_totalStops stops
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">@_totalDistance total</span>
            </div>
        </div>

        @* Progress summary *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                <div
                    class="h-full rounded-full bg-emerald-500"
                    style="@($"width:{(_visitedStops * 100 / _totalStops)}%")"
                ></div>
            </div>
            <span class="font-mono text-muted-foreground text-xs tabular-nums">
                @_visitedStops/@_totalStops
            </span>
        </div>

        @* Route stops *@
        <div class="px-4 py-4">
            @for (int i = 0; i < _stops.Length; i++)
            {
                var stop = _stops[i];
                var isLast = i == _stops.Length - 1;
                var isExpanded = _expandedStop == stop.Id;
                var pinNumber = i + 1;
                var pinClass = StatusPin(stop.Status);
                var lineClass = StatusLine(stop.Status);

                <div class="relative flex gap-3">
                    @* Pin column *@
                    <div class="flex flex-col items-center">
                        @* Waypoint pin *@
                        <div class="@($"relative z-10 flex size-7 shrink-0 items-center justify-center rounded-full border-2 font-medium text-xs {pinClass}")">
                            @pinNumber
                            @if (stop.Status == StopStatus.Current)
                            {
                                <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                            }
                        </div>

                        @* Route line + travel segment *@
                        @if (!isLast && stop.Segment != null)
                        {
                            var seg = stop.Segment;
                            <div class="flex flex-col items-center py-1">
                                <div
                                    class="@($"w-0 flex-1 border-l-2 border-dashed {lineClass}")"
                                    style="min-height:16px"
                                ></div>
                                <div class="my-1 flex items-center gap-1 rounded bg-muted/50 px-1.5 py-0.5">
                                    <LucideIconCn Name="@ModeIconName(seg.Mode)" Size="12" Class="size-3" />
                                    <span class="font-mono text-[10px] text-muted-foreground tabular-nums">
                                        @seg.Distance
                                    </span>
                                </div>
                                <div
                                    class="@($"w-0 flex-1 border-l-2 border-dashed {lineClass}")"
                                    style="min-height:16px"
                                ></div>
                            </div>
                        }
                    </div>

                    @* Content *@
                    <div class="@($"min-w-0 flex-1 {(isLast ? "pb-0" : "pb-2")}")">
                        @{ var stopId = stop.Id; }
                        <button
                            type="button"
                            @onclick="@(() => ToggleStop(stopId, isExpanded))"
                            class="w-full text-left"
                        >
                            <div class="flex items-center gap-2">
                                <span class="@($"font-medium text-sm {(stop.Status == StopStatus.Upcoming ? "text-muted-foreground" : "")}")">
                                    @stop.Name
                                </span>
                                @if (stop.Status == StopStatus.Current)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="border-blue-500/20 bg-blue-500/10 font-normal text-blue-600 text-xs dark:text-blue-400">
                                        Now
                                    </BadgeCn>
                                }
                            </div>
                            <span class="mt-0.5 block text-muted-foreground text-xs">
                                @stop.Address
                            </span>
                            <div class="mt-1 flex items-center gap-2">
                                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                    @stop.Arrival
                                </span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@stop.Duration</span>
                            </div>
                        </button>

                        @* Expanded detail *@
                        @if (isExpanded && stop.Notes != null)
                        {
                            <div class="mt-2 rounded-md bg-muted/50 p-3">
                                <p class="text-sm leading-relaxed">@stop.Notes</p>
                                @if (stop.Segment != null)
                                {
                                    var expandSeg = stop.Segment;
                                    <div class="mt-2 flex items-center gap-2 pt-2">
                                        <span class="font-medium text-muted-foreground text-xs">
                                            Next leg
                                        </span>
                                        <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                            <LucideIconCn Name="@ModeIconName(expandSeg.Mode)" Size="12" Class="size-3" />
                                            @ModeLabel(expandSeg.Mode)
                                        </span>
                                        <span class="text-muted-foreground text-xs">·</span>
                                        <span class="font-mono text-muted-foreground text-xs tabular-nums">
                                            @expandSeg.Distance
                                        </span>
                                        <span class="text-muted-foreground text-xs">·</span>
                                        <span class="font-mono text-muted-foreground text-xs tabular-nums">
                                            @expandSeg.Duration
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer summary *@
        <div class="flex items-center justify-between border-t bg-muted/20 px-4 py-2.5">
            <span class="text-muted-foreground text-xs">8:00 AM – 7:15 PM · @_totalDistance</span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="footprints" Size="12" Class="size-3" />
                    0.7 mi
                </span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="train-front" Size="12" Class="size-3" />
                    5.5 mi
                </span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="car" Size="12" Class="size-3" />
                    6.0 mi
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private enum StopStatus { Visited, Current, Upcoming }
    private enum TravelMode { Drive, Walk, Transit }

    private record TravelSegment(TravelMode Mode, string Distance, string Duration);

    private record Stop(
        string Id,
        string Name,
        string Address,
        string Arrival,
        string Duration,
        StopStatus Status,
        string? Notes = null,
        TravelSegment? Segment = null
    );

    private static readonly Stop[] _stops =
    [
        new("s1", "Hotel & Conference Center",        "340 Stockton St, San Francisco",              "8:00 AM",  "15 min",  StopStatus.Visited,  "Picked up badges and schedule",                    new(TravelMode.Walk,    "0.4 mi", "8 min")),
        new("s2", "Blue Bottle Coffee",               "66 Mint St, San Francisco",                   "8:23 AM",  "25 min",  StopStatus.Visited,  "Morning coffee and prep for keynote",              new(TravelMode.Transit, "2.1 mi", "12 min")),
        new("s3", "Moscone Center West",              "800 Howard St, San Francisco",                "9:00 AM",  "3 hrs",   StopStatus.Visited,  "Attended morning keynote and two breakout sessions", new(TravelMode.Walk,    "0.3 mi", "5 min")),
        new("s4", "The Cavalier",                     "360 Jessie St, San Francisco",                "12:15 PM", "1 hr",    StopStatus.Current,  "Lunch meeting with Acme Corp team",                new(TravelMode.Drive,   "1.8 mi", "10 min")),
        new("s5", "GitHub HQ",                        "88 Colin P. Kelly Jr. St, San Francisco",    "1:30 PM",  "2 hrs",   StopStatus.Upcoming, "Workshop on CI/CD best practices",                 new(TravelMode.Transit, "3.4 mi", "18 min")),
        new("s6", "Salesforce Tower Observation Deck","415 Mission St, San Francisco",               "4:00 PM",  "45 min",  StopStatus.Upcoming, "Networking event and city views",                  new(TravelMode.Drive,   "4.2 mi", "15 min")),
        new("s7", "Ferry Building Marketplace",       "1 Ferry Building, San Francisco",             "5:15 PM",  "2 hrs",   StopStatus.Upcoming, "Team dinner and evening reception"),
    ];

    private string _expandedStop = "s4";
    private string _totalDistance = "12.2 mi";
    private int _totalStops => _stops.Length;
    private int _visitedStops => System.Array.FindAll(_stops, s => s.Status == StopStatus.Visited).Length;

    private void ToggleStop(string id, bool isExpanded)
    {
        _expandedStop = isExpanded ? "" : id;
    }

    private static string StatusPin(StopStatus status) => status switch
    {
        StopStatus.Visited  => "border-emerald-500 bg-emerald-500 text-white",
        StopStatus.Current  => "border-blue-500 bg-blue-500 text-white",
        _                   => "border-muted-foreground/30 bg-card text-muted-foreground",
    };

    private static string StatusLine(StopStatus status) => status switch
    {
        StopStatus.Visited  => "border-emerald-500/40",
        StopStatus.Current  => "border-blue-500/40",
        _                   => "border-muted-foreground/20",
    };

    private static string ModeIconName(TravelMode mode) => mode switch
    {
        TravelMode.Drive    => "car",
        TravelMode.Walk     => "footprints",
        _                   => "train-front",
    };

    private static string ModeLabel(TravelMode mode) => mode switch
    {
        TravelMode.Drive    => "Drive",
        TravelMode.Walk     => "Walk",
        _                   => "Transit",
    };
}
