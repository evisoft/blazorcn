@* ============================================================
   Block: timeline-zigzag
   Title: TimelineZigzag
   Description: A React alternating timeline with diagonal connectors built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-zigzag.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Company journey</span>
                <span class="text-muted-foreground text-xs">
                    @_entries[0].Date — @_entries[_entries.Length - 1].Date
                </span>
            </div>
        </div>

        @* Zigzag timeline *@
        <div class="px-4 py-6">
            @foreach (var (entry, index) in _entries.Select((e, i) => (e, i)))
            {
                var isLeft = index % 2 == 0;
                var isLast = index == _entries.Length - 1;
                var x1 = isLeft ? "65" : "35";
                var x2 = isLeft ? "35" : "65";

                <div>
                    @* Entry positioned left or right *@
                    <div class="@Cn.Merge("flex", isLeft ? "justify-start" : "justify-end")">
                        <div class="relative w-[65%]">
                            @* Dot on the inner edge *@
                            <div class="@Cn.Merge("absolute top-1 z-10 size-3 rounded-full border-2 border-foreground bg-card", isLeft ? "-right-1.5" : "-left-1.5")" />

                            <div class="@(isLeft ? "pr-5 text-right" : "pl-5 text-left")">
                                <span class="font-medium text-muted-foreground text-xs">
                                    @entry.Date
                                </span>
                                <p class="mt-1 font-medium text-sm">@entry.Title</p>
                                <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                                    @entry.Description
                                </p>
                                <div class="@Cn.Merge("mt-2 flex", isLeft ? "justify-end" : "justify-start")">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        @_categoryLabel[entry.Category]
                                    </BadgeCn>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Diagonal connector crossing from one side to the other *@
                    @if (!isLast)
                    {
                        <div class="relative my-1 h-10">
                            <svg class="absolute inset-0 h-full w-full" preserveAspectRatio="none" viewBox="0 0 100 100" aria-hidden="true">
                                <title>Zigzag connector</title>
                                <line
                                    x1="@x1"
                                    y1="0"
                                    x2="@x2"
                                    y2="100"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    class="text-border"
                                    vector-effect="non-scaling-stroke" />
                            </svg>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ZigzagEntry(string Id, string Date, string Title, string Description, string Category);

    private static readonly ZigzagEntry[] _entries =
    [
        new("z1", "Jan 2025", "Initial prototype built",
            "Built the first working prototype in 3 weeks. Core editor, real-time sync, and basic auth. Demoed to 8 potential customers.",
            "milestone"),
        new("z2", "Apr 2025", "Seed round closed at $3.2M",
            "Oversubscribed seed round led by Accel with participation from 12 angels. Hired first 4 engineers and a founding designer.",
            "growth"),
        new("z3", "Jul 2025", "v1.0 public launch",
            "Shipped GA on Product Hunt. Reached #1 Product of the Day with 3,200 upvotes. 8K signups in the first 72 hours.",
            "release"),
        new("z4", "Oct 2025", "Enterprise pilot program",
            "Signed 5 enterprise design partners including two Fortune 500 companies. Built SSO, audit logs, and admin dashboard.",
            "growth"),
        new("z5", "Jan 2026", "AI copilot beta shipped",
            "Integrated LLM-powered suggestions, auto-complete, and natural language queries. 40% faster workflow completion reported.",
            "release"),
        new("z6", "Mar 2026", "Series A at $18M valuation",
            "Series A led by Benchmark. 15K active teams, $1.2M ARR, and 94% monthly retention. Expanding to European market.",
            "milestone"),
    ];

    private static readonly Dictionary<string, string> _categoryLabel = new()
    {
        ["milestone"] = "Milestone",
        ["release"] = "Release",
        ["research"] = "Research",
        ["growth"] = "Growth",
    };
}
