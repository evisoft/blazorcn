@* ============================================================
   Block: timeline-reading-list
   Title: TimelineReadingList
   Description: React reading history timeline with star ratings using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-reading-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Reading list</span>
                </div>
                <div class="flex items-center gap-3 text-muted-foreground text-xs">
                    <span>@_finished finished</span>
                    <span>·</span>
                    <span class="tabular-nums">@_totalPages.ToString("N0") pages</span>
                </div>
            </div>
        </div>

        @* Book timeline *@
        <div class="relative">
            @* Vertical spine *@
            <div class="absolute top-0 bottom-0 left-[31px] w-px bg-border"></div>

            @foreach (var bk in _books)
            {
                var book = bk;
                var isLast = book.Id == _books[_books.Length - 1].Id;
                var isReading = book.Status == BookStatus.Reading;
                var isFinished = book.Status == BookStatus.Finished;
                var progress = (int)Math.Round((double)book.PagesRead / book.Pages * 100);
                var cfg = GetConfig(book.Status);

                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-start gap-3 px-4 py-3">
                        @* Timeline marker *@
                        <div class="relative z-10 flex size-7 shrink-0 items-center justify-center">
                            @if (isFinished)
                            {
                                <div class="flex size-7 items-center justify-center rounded-full border border-emerald-500/30 bg-emerald-500/10">
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                                </div>
                            }
                            else if (isReading)
                            {
                                <div class="relative flex size-7 items-center justify-center rounded-full border-2 border-blue-500 bg-card">
                                    <LucideIconCn Name="book-open" Size="12" Class="size-3 text-blue-500" />
                                    <span class="absolute inset-0 animate-pulse rounded-full border-2 border-blue-500/30"></span>
                                </div>
                            }
                            else
                            {
                                <div class="flex size-7 items-center justify-center rounded-full border border-border bg-card">
                                    <LucideIconCn Name="book-open" Size="12" Class="size-3 text-muted-foreground/40" />
                                </div>
                            }
                        </div>

                        @* Book info *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0 flex-1">
                                    <span class="@($"text-sm{(isReading ? " font-medium" : "")}")">@book.Title</span>
                                    <p class="mt-0.5 text-muted-foreground text-xs">@book.Author</p>
                                </div>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">@book.Genre</BadgeCn>
                            </div>

                            @* Rating (only for finished books) *@
                            @if (isFinished)
                            {
                                <div class="mt-1.5">
                                    <div class="flex items-center gap-0.5">
                                        @for (int i = 0; i < 5; i++)
                                        {
                                            var idx = i;
                                            <LucideIconCn Name="star" Size="12" Class="@($"size-3 {(idx < book.Rating ? "fill-amber-500 text-amber-500" : "text-muted-foreground/20")}")" />
                                        }
                                        @if (book.Rating > 0)
                                        {
                                            <span class="ml-1 font-mono text-muted-foreground text-xs tabular-nums">@(book.Rating).0</span>
                                        }
                                    </div>
                                </div>
                            }

                            @* Progress bar for currently reading *@
                            @if (isReading)
                            {
                                <div class="mt-2">
                                    <div class="mb-1 flex items-center justify-between">
                                        <span class="text-muted-foreground text-xs">@book.PagesRead of @book.Pages pages</span>
                                        <span class="font-mono text-muted-foreground text-xs tabular-nums">@(progress)%</span>
                                    </div>
                                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                        <div
                                            class="h-full rounded-full bg-blue-500 transition-all"
                                            style="@($"width:{progress}%")">
                                        </div>
                                    </div>
                                </div>
                            }

                            @* Meta line *@
                            <div class="mt-1.5 flex items-center gap-2">
                                <span class="@($"size-1.5 rounded-full {cfg.Dot}")"></span>
                                <span class="text-muted-foreground text-xs">@cfg.Label</span>
                                <span class="text-muted-foreground/40 text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@book.FinishedAt</span>
                                <span class="text-muted-foreground/40 text-xs">·</span>
                                <span class="font-mono text-muted-foreground text-xs tabular-nums">@(book.Pages)p</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum BookStatus { Finished, Reading, Abandoned }

    private record Book(string Id, string Title, string Author, int Pages, int PagesRead, int Rating, BookStatus Status, string FinishedAt, string Genre);

    private record StatusCfg(string Label, string Dot);

    private static readonly Book[] _books =
    [
        new("b1", "Designing Data-Intensive Applications", "Martin Kleppmann", 616, 342, 0, BookStatus.Reading, "In progress", "Engineering"),
        new("b2", "The Pragmatic Programmer", "David Thomas & Andrew Hunt", 352, 352, 5, BookStatus.Finished, "Mar 2026", "Engineering"),
        new("b3", "Thinking, Fast and Slow", "Daniel Kahneman", 499, 499, 4, BookStatus.Finished, "Feb 2026", "Psychology"),
        new("b4", "Staff Engineer", "Will Larson", 387, 387, 4, BookStatus.Finished, "Jan 2026", "Career"),
        new("b5", "The Mom Test", "Rob Fitzpatrick", 130, 130, 5, BookStatus.Finished, "Dec 2025", "Business"),
        new("b6", "Refactoring", "Martin Fowler", 448, 112, 0, BookStatus.Abandoned, "Stopped Nov 2025", "Engineering"),
        new("b7", "Zero to One", "Peter Thiel", 224, 224, 3, BookStatus.Finished, "Oct 2025", "Business"),
    ];

    private int _finished => Array.FindAll(_books, b => b.Status == BookStatus.Finished).Length;
    private int _totalPages => Array.FindAll(_books, _ => true).Sum(b => b.PagesRead);

    private static StatusCfg GetConfig(BookStatus status) => status switch
    {
        BookStatus.Finished => new("Finished", "bg-emerald-500"),
        BookStatus.Reading => new("Reading", "bg-blue-500"),
        BookStatus.Abandoned => new("Stopped", "bg-muted-foreground"),
        _ => new("Unknown", "bg-muted")
    };
}
