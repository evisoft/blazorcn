@* ============================================================
   Block: timeline-horizontal-compact
   Title: TimelineHorizontalCompact
   Description: React horizontal timeline with colored segments, hover details, and proportional date ranges using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-horizontal-compact.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">2025 Project Timeline</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">@_phases.Length phases</span>
            <div class="ml-auto flex items-center gap-3">
                @foreach (var status in _legendStatuses)
                {
                    var st = status;
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _statusStyles[st].Dot)"></span>
                        @_statusStyles[st].Label
                    </span>
                }
            </div>
        </div>

        @* Timeline bar *@
        <div class="px-4 pt-4 pb-2">
            @* Month labels *@
            <div class="mb-2 flex">
                @foreach (var month in _months)
                {
                    <div class="flex-1 text-center">
                        <span class="font-mono text-muted-foreground text-[10px]">@month</span>
                    </div>
                }
            </div>

            @* Grid lines + segments *@
            <div class="relative">
                @* Vertical grid lines *@
                <div class="absolute inset-0 flex">
                    @foreach (var month in _months)
                    {
                        <div class="flex-1 border-l border-border/40 first:border-l-0"></div>
                    }
                </div>

                @* Phase rows *@
                <div class="relative space-y-1.5">
                    @foreach (var phase in _phases)
                    {
                        var ph = phase;
                        var leftPercent = (ph.StartMonth / (double)_totalMonths) * 100;
                        var widthPercent = ((ph.EndMonth - ph.StartMonth) / (double)_totalMonths) * 100;
                        var styles = _statusStyles[ph.Status];
                        var isActive = _displayPhase.Id == ph.Id;
                        <div class="relative h-7">
                            <div
                                class="@Cn.Merge("absolute top-0 flex h-full cursor-pointer items-center rounded-sm px-2 transition-all", styles.Bar, isActive ? "ring-1 ring-foreground/20" : "hover:ring-1 hover:ring-foreground/10")"
                                style="@($"left:{leftPercent:F4}%;width:{widthPercent:F4}%")"
                                @onmouseenter="@(() => SetActive(ph))"
                                @onmouseleave="@(() => ClearActive())">
                                <span class="truncate font-medium text-xs">@ph.Name</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Detail panel *@
        <div class="border-t px-4 py-3">
            <div class="flex items-start gap-3">
                <span class="@Cn.Merge("mt-1 size-2 shrink-0 rounded-full", _statusStyles[_displayPhase.Status].Dot)"></span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">@_displayPhase.Name</span>
                        <span class="text-muted-foreground text-xs">@_months[_displayPhase.StartMonth]–@_months[_displayPhase.EndMonth - 1]</span>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_displayPhase.Description</p>
                </div>
                <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 font-mono text-muted-foreground text-[10px]">@_displayPhase.Team</span>
            </div>
        </div>
    </div>
</section>

@code {
    private enum PhaseStatus { Completed, InProgress, Planned }

    private record Phase(string Id, string Name, string Description, int StartMonth, int EndMonth, PhaseStatus Status, string Team);

    private record StatusStyle(string Bar, string Dot, string Label);

    private static readonly Phase[] _phases =
    [
        new("p1", "Research & Discovery",   "User interviews, competitive analysis, and requirements documentation.", 0,  2,  PhaseStatus.Completed,  "Product"),
        new("p2", "Architecture & Design",  "System design, database schema, API contracts, and UI wireframes.",     2,  4,  PhaseStatus.Completed,  "Engineering"),
        new("p3", "Core Development",       "Backend services, frontend components, and integration testing.",       4,  8,  PhaseStatus.InProgress, "Engineering"),
        new("p4", "QA & Hardening",         "End-to-end testing, performance optimization, and security audit.",     7,  10, PhaseStatus.InProgress, "QA"),
        new("p5", "Launch & Rollout",       "Staged deployment, monitoring setup, and customer migration.",          10, 12, PhaseStatus.Planned,    "DevOps"),
    ];

    private static readonly string[] _months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    private const int _totalMonths = 12;

    private static readonly PhaseStatus[] _legendStatuses = [PhaseStatus.Completed, PhaseStatus.InProgress, PhaseStatus.Planned];

    private static readonly Dictionary<PhaseStatus, StatusStyle> _statusStyles = new()
    {
        [PhaseStatus.Completed]  = new("bg-foreground/20",         "bg-foreground",         "Completed"),
        [PhaseStatus.InProgress] = new("bg-blue-500/20",           "bg-blue-500",           "In Progress"),
        [PhaseStatus.Planned]    = new("bg-muted-foreground/15",   "bg-muted-foreground",   "Planned"),
    };

    private Phase? _activePhase;

    private Phase _displayPhase =>
        _activePhase
        ?? Array.Find(_phases, p => p.Status == PhaseStatus.InProgress)
        ?? _phases[0];

    private void SetActive(Phase phase) => _activePhase = phase;
    private void ClearActive() => _activePhase = null;
}
