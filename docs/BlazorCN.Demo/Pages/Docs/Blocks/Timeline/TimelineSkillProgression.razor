@* ============================================================
   Block: timeline-skill-progression
   Title: TimelineSkillProgression
   Description: React skill growth timeline for Next.js with shadcn/ui Badge, progress bars, and Tailwind CSS showing proficiency levels over time.
   Source: original/blocks/timeline/timeline-skill-progression.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Skill progression</span>
                <span class="text-muted-foreground text-xs">
                    @_skills.Length skills · @_skills[0].Date — present
                </span>
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var skill in _skills)
                {
                    var isLast = skill.Id == _skills[_skills.Length - 1].Id;
                    <div class="relative flex gap-4">
                        @* Line + Node column *@
                        <div class="flex flex-col items-center">
                            @* Skill node — colored dot by category *@
                            <div class="relative z-10 flex size-6 shrink-0 items-center justify-center rounded-full border-2 border-background bg-card">
                                <span class="@($"size-2.5 rounded-full {CategoryColor(skill.Category)}")" />
                            </div>
                            @* Connector line *@
                            @if (!isLast)
                            {
                                <div class="w-0.5 flex-1 bg-border"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@($"min-w-0 flex-1 {(isLast ? "pb-0" : "pb-5")} pt-0.5")">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@skill.Skill</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    @CategoryLabel(skill.Category)
                                </BadgeCn>
                            </div>
                            <span class="mt-0.5 block text-muted-foreground text-xs">@skill.Date</span>
                            <p class="mt-1 text-muted-foreground text-sm leading-relaxed">@skill.Context</p>

                            @* Progress bar *@
                            <div class="mt-2.5 flex items-center gap-3">
                                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="@($"h-full rounded-full {CategoryColor(skill.Category)}")" style="@($"width:{skill.Level}%")"></div>
                                </div>
                                <div class="flex items-center gap-1.5 shrink-0">
                                    <span class="font-mono text-muted-foreground text-xs tabular-nums">@skill.Level%</span>
                                    <span class="text-muted-foreground/60 text-xs">·</span>
                                    <span class="text-muted-foreground text-xs">@LevelLabel(skill.Level)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record SkillEntry(string Id, string Skill, string Category, string Date, string Context, int Level);

    private static readonly SkillEntry[] _skills =
    [
        new("s1", "HTML & CSS",              "frontend",   "2016", "Self-taught through freeCodeCamp and personal projects",                          95),
        new("s2", "JavaScript",              "frontend",   "2017", "University coursework and first internship at StartupXYZ",                         92),
        new("s3", "React",                   "frontend",   "2018", "Built first production app during internship — a real-time dashboard",             95),
        new("s4", "TypeScript",              "frontend",   "2019", "Adopted at Acme Corp for the admin dashboard rewrite",                             90),
        new("s5", "Node.js",                 "backend",    "2019", "Built REST APIs and webhook handlers for internal tools",                          78),
        new("s6", "Next.js",                 "frontend",   "2020", "Migrated Figma plugin marketplace from CRA to Next.js",                            93),
        new("s7", "System Design",           "leadership", "2022", "Led architecture reviews and RFC process at Stripe",                               75),
        new("s8", "React Server Components", "frontend",   "2024", "Spearheaded RSC migration at Vercel — 42% bundle reduction",                      88),
    ];

    private static string CategoryColor(string category) => category switch
    {
        "frontend"   => "bg-blue-500",
        "backend"    => "bg-emerald-500",
        "devops"     => "bg-amber-500",
        "design"     => "bg-violet-500",
        "leadership" => "bg-rose-500",
        _            => "bg-muted-foreground",
    };

    private static string CategoryLabel(string category) => category switch
    {
        "frontend"   => "Frontend",
        "backend"    => "Backend",
        "devops"     => "DevOps",
        "design"     => "Design",
        "leadership" => "Leadership",
        _            => category,
    };

    private static string LevelLabel(int level)
    {
        if (level >= 90) return "Expert";
        if (level >= 75) return "Advanced";
        if (level >= 50) return "Intermediate";
        return "Beginner";
    }
}
