@* ============================================================
   Block: timeline-chat-history
   Title: TimelineChatHistory
   Description: React timeline with alternating chat bubbles on a vertical line, built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-chat-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Conversation</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_messages.Length messages
                </BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs">Today</span>
        </div>

        @* Chat timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @* Central timeline line *@
                <div class="absolute top-0 bottom-0 left-1/2 w-px -translate-x-1/2 bg-border"></div>

                @foreach (var msg in _messages)
                {
                    var isRight = msg.Sender.IsCurrentUser;
                    var isLast = msg.Id == _messages[_messages.Length - 1].Id;
                    <div class="@Cn.Merge("relative flex items-start", isLast ? "" : "mb-6")">
                        @* Left side content or spacer *@
                        <div class="w-[calc(50%-20px)]">
                            @if (!isRight)
                            {
                                <div class="pr-3">
                                    <div class="rounded-lg bg-muted/50 p-3">
                                        <p class="text-sm leading-relaxed">@msg.Content</p>
                                    </div>
                                    <div class="mt-1 flex items-center gap-2 pl-1">
                                        <span class="font-medium text-muted-foreground text-xs">@msg.Sender.Name</span>
                                        <span class="text-muted-foreground/40 text-xs">·</span>
                                        <span class="text-muted-foreground text-xs">@msg.Timestamp</span>
                                    </div>
                                </div>
                            }
                        </div>

                        @* Center avatar node *@
                        <div class="relative z-10 flex w-10 shrink-0 items-start justify-center">
                            <AvatarCn Class="@Cn.Merge("size-8 ring-2 ring-card", isRight ? "bg-foreground text-background" : "")">
                                <AvatarFallbackCn Class="@Cn.Merge("text-[10px]", isRight ? "bg-foreground text-background" : "")">
                                    @msg.Sender.Initials
                                </AvatarFallbackCn>
                            </AvatarCn>
                        </div>

                        @* Right side content or spacer *@
                        <div class="w-[calc(50%-20px)]">
                            @if (isRight)
                            {
                                <div class="pl-3">
                                    <div class="rounded-lg border bg-muted/30 p-3">
                                        <p class="text-sm leading-relaxed">@msg.Content</p>
                                    </div>
                                    <div class="mt-1 flex items-center gap-2 pr-1 justify-end">
                                        <span class="text-muted-foreground text-xs">@msg.Timestamp</span>
                                        <span class="text-muted-foreground/40 text-xs">·</span>
                                        <span class="font-medium text-muted-foreground text-xs">@msg.Sender.Name</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record MessageSender(string Name, string Initials, bool IsCurrentUser);
    private record ChatMessage(string Id, MessageSender Sender, string Content, string Timestamp);

    private static readonly ChatMessage[] _messages =
    [
        new("m1", new("You", "YU", true),  "Hey, are we still on track for the API migration this sprint? I noticed a few open PRs that might block the deploy.", "10:02 AM"),
        new("m2", new("Sarah Chen", "SC", false), "Good call. The Stripe webhook PR is ready to merge. The auth middleware one still needs a review from Marcus.", "10:04 AM"),
        new("m3", new("You", "YU", true),  "I can review the auth middleware today. Any breaking changes I should know about before I start?", "10:05 AM"),
        new("m4", new("Sarah Chen", "SC", false), "The token format changed from JWT to opaque tokens. There is a migration script in the PR description. Run it against staging first.", "10:08 AM"),
        new("m5", new("You", "YU", true),  "Got it. I will run the migration on staging after lunch and post the results in the PR.", "10:09 AM"),
        new("m6", new("Sarah Chen", "SC", false), "Perfect. If staging looks clean, we can merge both PRs and schedule the production deploy for Thursday morning.", "10:12 AM"),
        new("m7", new("You", "YU", true),  "Sounds like a plan. I will ping you once the staging results are in.", "10:13 AM"),
        new("m8", new("Sarah Chen", "SC", false), "Thanks. Also, can you flag any latency regressions from the new middleware? We had a P95 spike last time we touched that path.", "10:15 AM"),
    ];
}
