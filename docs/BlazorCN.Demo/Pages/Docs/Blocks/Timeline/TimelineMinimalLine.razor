@* ============================================================
   Block: timeline-minimal-line
   Title: TimelineMinimalLine
   Description: React minimal timeline component with hairline connector and tiny dots for Next.js apps using shadcn/ui and Tailwind CSS.
   Source: original/blocks/timeline/timeline-minimal-line.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Our story</span>
        </div>

        @* Minimal timeline *@
        <div class="px-6 py-8">
            <div class="relative">
                @foreach (var en in _entries)
                {
                    var entry = en;
                    var isLast = entry.Id == _entries[_entries.Length - 1].Id;

                    <div class="relative flex gap-6">
                        @* Hairline + tiny dot *@
                        <div class="flex flex-col items-center pt-1.5">
                            <div class="size-[5px] shrink-0 rounded-full bg-foreground/40"></div>
                            @if (!isLast)
                            {
                                <div class="w-px flex-1 bg-foreground/10"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@(isLast ? "pb-0" : "pb-10")">
                            <span class="font-mono text-muted-foreground/60 text-xs tracking-wider">@entry.Date</span>
                            <p class="mt-1 font-medium text-sm">@entry.Title</p>
                            <p class="mt-1.5 max-w-md text-muted-foreground text-xs leading-relaxed">@entry.Description</p>
                            @if (entry.Note != null)
                            {
                                <span class="mt-2 block font-mono text-muted-foreground/40 text-xs">@entry.Note</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record MinimalEntry(string Id, string Date, string Title, string Description, string? Note = null);

    private static readonly MinimalEntry[] _entries =
    [
        new("m1", "2026", "Open source release",
            "Published the core library under MIT license. Repository reached 4,200 stars in the first month.",
            "github.com/acme/core"),
        new("m2", "2025", "Acquired by Vercel",
            "Joined the Vercel ecosystem to accelerate development tooling for frontend teams worldwide."),
        new("m3", "2024", "Series B and international expansion",
            "Raised $38M to expand into European and Asian markets. Opened offices in London and Singapore.",
            "Led by Benchmark"),
        new("m4", "2023", "Product-market fit",
            "Crossed 10,000 paying customers. Net revenue retention hit 142%. Named a Gartner Cool Vendor."),
        new("m5", "2022", "Founded",
            "Two engineers left Stripe to build better developer tooling. First commit pushed from a coffee shop in San Francisco.",
            "Day one"),
    ];
}
