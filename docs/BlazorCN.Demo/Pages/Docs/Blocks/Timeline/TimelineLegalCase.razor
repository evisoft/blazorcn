@* ============================================================
   Block: timeline-legal-case
   Title: TimelineLegalCase
   Description: React legal case timeline with court proceedings and status tracking using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-legal-case.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="scale" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Case proceedings</span>
                </div>
                <span class="font-mono text-muted-foreground text-xs">CV-2026-00142</span>
            </div>
        </div>

        @* Case summary *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @_completedCount of @_proceedings.Length milestones completed
            </span>
            <span class="text-muted-foreground/40 text-xs">·</span>
            <span class="text-muted-foreground text-xs">Hon. Margaret Torres presiding</span>
            <div class="ml-auto flex items-center gap-2">
                <span class="flex items-center gap-1.5 text-xs">
                    <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                    <span class="text-muted-foreground">@_completedCount</span>
                </span>
                <span class="flex items-center gap-1.5 text-xs">
                    <LucideIconCn Name="clock" Size="12" Class="size-3 text-blue-500" />
                    <span class="text-muted-foreground">@_scheduledCount</span>
                </span>
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var proc in _proceedings)
                {
                    var procItem = proc;
                    var index = System.Array.IndexOf(_proceedings, procItem);
                    var isLast = index == _proceedings.Length - 1;
                    var isExpanded = _expanded == procItem.Id;
                    var dotClass = GetDotClass(procItem.Status);
                    var badgeClass = GetBadgeClass(procItem.Status);
                    var statusLabel = GetStatusLabel(procItem.Status);
                    var dotColorClass = procItem.Status == ProceedingStatus.Completed
                        ? "bg-emerald-500"
                        : procItem.Status == ProceedingStatus.Scheduled
                            ? "bg-blue-500"
                            : "bg-muted-foreground/40";
                    var connectorClass = procItem.Status == ProceedingStatus.Completed
                        ? "w-px flex-1 bg-emerald-500/25"
                        : "w-px flex-1 border-l border-dashed border-muted-foreground/20 bg-transparent";

                    <div class="relative flex gap-4">
                        @* Timeline column *@
                        <div class="flex flex-col items-center">
                            @* Node marker *@
                            <div class="@Cn.Merge("relative z-10 flex size-8 shrink-0 items-center justify-center rounded-lg border-2 bg-card", dotClass)">
                                @if (procItem.EventType == EventType.Filing)
                                {
                                    <LucideIconCn Name="file-text" Size="14" Class="size-3.5" />
                                }
                                else if (procItem.EventType == EventType.Discovery)
                                {
                                    <LucideIconCn Name="search" Size="14" Class="size-3.5" />
                                }
                                else if (procItem.EventType == EventType.Motion)
                                {
                                    <LucideIconCn Name="book-open" Size="14" Class="size-3.5" />
                                }
                                else if (procItem.EventType == EventType.Hearing)
                                {
                                    <LucideIconCn Name="gavel" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <LucideIconCn Name="scale" Size="14" Class="size-3.5" />
                                }
                            </div>
                            @* Connector *@
                            @if (!isLast)
                            {
                                <div class="@connectorClass"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@(isLast ? "pb-0" : "pb-5") min-w-0 flex-1 pt-0.5">
                            <button type="button"
                                    @onclick="@(() => ToggleExpand(procItem.Id))"
                                    class="-mx-2 flex w-[calc(100%+16px)] items-center gap-2 rounded-md px-2 py-1 text-left transition-colors hover:bg-muted/50">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="font-medium text-sm">@procItem.Title</span>
                                    </div>
                                    <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                        <span>@procItem.Date</span>
                                        <span>·</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-xs">
                                            @GetEventLabel(procItem.EventType)
                                        </BadgeCn>
                                        <span class="@Cn.Merge("inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 font-medium text-xs", badgeClass)">
                                            <span class="@Cn.Merge("size-1 rounded-full", dotColorClass)"></span>
                                            @statusLabel
                                        </span>
                                    </div>
                                </div>
                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                            </button>

                            @if (isExpanded)
                            {
                                <div class="mt-2 rounded-md bg-muted/50 p-3">
                                    <div class="mb-1.5 flex items-center gap-2">
                                        @if (!string.IsNullOrEmpty(procItem.Judge))
                                        {
                                            <span class="text-muted-foreground text-xs">@procItem.Judge</span>
                                        }
                                        @if (!string.IsNullOrEmpty(procItem.Courtroom))
                                        {
                                            <span class="text-muted-foreground/40 text-xs">·</span>
                                            <span class="text-muted-foreground text-xs">@procItem.Courtroom</span>
                                        }
                                    </div>
                                    <p class="text-sm leading-relaxed">@procItem.Description</p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum EventType { Filing, Discovery, Motion, Hearing, Verdict }
    private enum ProceedingStatus { Completed, Scheduled, Pending }

    private record Proceeding(
        string Id,
        string Date,
        EventType EventType,
        ProceedingStatus Status,
        string Title,
        string CaseRef,
        string Description,
        string Judge = "",
        string Courtroom = "");

    private static readonly Proceeding[] _proceedings =
    [
        new("p1", "Jan 8, 2026", EventType.Filing, ProceedingStatus.Completed,
            "Complaint filed — breach of contract", "CV-2026-00142",
            "Plaintiff filed initial complaint alleging breach of service agreement dated September 2025. Seeking $2.4M in compensatory damages plus legal fees. Service of process completed on January 12."),
        new("p2", "Feb 3, 2026", EventType.Filing, ProceedingStatus.Completed,
            "Defendant's answer and counterclaim", "CV-2026-00142",
            "Defendant filed answer denying all allegations and asserting affirmative defenses. Counterclaim filed for tortious interference with business relationships seeking $1.8M.",
            "Hon. Margaret Torres"),
        new("p3", "Feb 28, 2026", EventType.Discovery, ProceedingStatus.Completed,
            "Initial disclosures exchanged", "CV-2026-00142",
            "Both parties submitted Rule 26(a) initial disclosures including witness lists, document indices, and damage computations. 4,200 pages of documents produced by plaintiff, 2,800 by defendant.",
            "Hon. Margaret Torres"),
        new("p4", "Mar 15, 2026", EventType.Motion, ProceedingStatus.Completed,
            "Motion to compel additional discovery", "CV-2026-00142",
            "Plaintiff filed motion to compel production of internal communications. Court granted motion in part, ordering production of emails from September through December 2025. Defendant to comply within 14 days.",
            "Hon. Margaret Torres", "Courtroom 4B"),
        new("p5", "Apr 22, 2026", EventType.Hearing, ProceedingStatus.Scheduled,
            "Pre-trial conference", "CV-2026-00142",
            "Scheduled conference to establish trial timeline, discuss settlement prospects, and resolve any outstanding discovery disputes. Both parties required to submit pre-trial briefs 7 days in advance.",
            "Hon. Margaret Torres", "Courtroom 4B"),
        new("p6", "Jun 2, 2026", EventType.Hearing, ProceedingStatus.Pending,
            "Jury trial — estimated 5 days", "CV-2026-00142",
            "Trial scheduled for five business days. Jury of twelve to be selected on day one. Plaintiff estimates calling 8 witnesses, defendant estimates 6. Expert testimony expected from both sides on damages.",
            "Hon. Margaret Torres", "Courtroom 2A"),
        new("p7", "Pending", EventType.Verdict, ProceedingStatus.Pending,
            "Verdict and judgment", "CV-2026-00142",
            "Jury verdict expected following trial conclusion. Post-trial motions deadline 28 days after judgment entry. Appeal window of 30 days from final judgment.",
            "Hon. Margaret Torres"),
    ];

    private string? _expanded = "p4";

    private int _completedCount => System.Array.FindAll(_proceedings, p => p.Status == ProceedingStatus.Completed).Length;
    private int _scheduledCount => System.Array.FindAll(_proceedings, p => p.Status == ProceedingStatus.Scheduled).Length;

    private void ToggleExpand(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string GetDotClass(ProceedingStatus status) => status switch
    {
        ProceedingStatus.Completed => "border-emerald-500/40 text-emerald-600 dark:text-emerald-400",
        ProceedingStatus.Scheduled => "border-blue-500/40 text-blue-600 dark:text-blue-400",
        _ => "border-muted-foreground/30 text-muted-foreground",
    };

    private static string GetBadgeClass(ProceedingStatus status) => status switch
    {
        ProceedingStatus.Completed => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        ProceedingStatus.Scheduled => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        _ => "bg-muted text-muted-foreground",
    };

    private static string GetStatusLabel(ProceedingStatus status) => status switch
    {
        ProceedingStatus.Completed => "Completed",
        ProceedingStatus.Scheduled => "Scheduled",
        _ => "Pending",
    };

    private static string GetEventLabel(EventType eventType) => eventType switch
    {
        EventType.Filing => "Filing",
        EventType.Discovery => "Discovery",
        EventType.Motion => "Motion",
        EventType.Hearing => "Hearing",
        _ => "Verdict",
    };
}
