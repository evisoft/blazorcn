@* ============================================================
   Block: timeline-music-playlist
   Title: TimelineMusicPlaylist
   Description: React listening history timeline with play/pause icons and now-playing indicator for Next.js music apps using shadcn/ui and Tailwind CSS.
   Source: original/blocks/timeline/timeline-music-playlist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="disc" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Listening history</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-muted-foreground text-xs">@_totalDuration</span>
                    <span class="text-muted-foreground text-xs">·</span>
                    <span class="text-muted-foreground text-xs">@_tracks.Length tracks</span>
                </div>
            </div>
        </div>

        @* Track list timeline *@
        <div class="relative">
            @* Vertical spine *@
            <div class="absolute top-0 bottom-0 left-[31px] w-px bg-border"></div>

            @foreach (var track in _tracks)
            {
                var isPlaying = track.Id == _playing;
                var trackIndex = Array.IndexOf(_tracks, track);
                var isLast = trackIndex == _tracks.Length - 1;
                var t = track;

                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _playing = t.Id)"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", isPlaying ? "bg-muted/30" : "")">
                        @* Play/pause marker *@
                        <div class="relative z-10 flex size-7 shrink-0 items-center justify-center">
                            @if (isPlaying)
                            {
                                <div class="flex size-7 items-center justify-center rounded-full border-2 border-emerald-500 bg-emerald-500">
                                    <LucideIconCn Name="pause" Size="12" Class="size-3 fill-white text-white" />
                                    <span class="absolute inset-0 animate-ping rounded-full border-2 border-emerald-500 opacity-15"></span>
                                </div>
                            }
                            else if (trackIndex < _playingIndex)
                            {
                                <div class="flex size-7 items-center justify-center rounded-full border border-muted-foreground/20 bg-card">
                                    <LucideIconCn Name="music" Size="12" Class="size-3 text-muted-foreground/40" />
                                </div>
                            }
                            else
                            {
                                <div class="flex size-7 items-center justify-center rounded-full border border-muted-foreground/20 bg-card">
                                    <LucideIconCn Name="play" Size="12" Class="size-3 fill-muted-foreground/40 text-muted-foreground/40" />
                                </div>
                            }
                        </div>

                        @* Album art placeholder *@
                        <div class="size-10 shrink-0 rounded-md bg-muted"></div>

                        @* Track info *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("truncate text-sm", isPlaying ? "font-medium" : "")">
                                    @track.Title
                                </span>
                                @if (isPlaying)
                                {
                                    <div class="flex items-end gap-0.5">
                                        <span class="inline-block h-2.5 w-0.5 animate-pulse rounded-full bg-emerald-500"></span>
                                        <span class="inline-block h-3.5 w-0.5 animate-pulse rounded-full bg-emerald-500" style="animation-delay:150ms"></span>
                                        <span class="inline-block h-2 w-0.5 animate-pulse rounded-full bg-emerald-500" style="animation-delay:300ms"></span>
                                    </div>
                                }
                            </div>
                            <p class="mt-0.5 truncate text-muted-foreground text-xs">
                                @track.Artist · @track.Album
                            </p>
                        </div>

                        @* Duration and time *@
                        <div class="shrink-0 text-right">
                            <span class="block font-mono text-muted-foreground text-xs tabular-nums">
                                @track.Duration
                            </span>
                            <span class="block text-muted-foreground/60 text-xs">@track.PlayedAt</span>
                        </div>
                    </button>

                    @* Progress bar for playing track *@
                    @if (isPlaying)
                    {
                        <div class="mx-4 mb-3 ml-[52px]">
                            <div class="h-0.5 w-full overflow-hidden rounded-full bg-muted">
                                <div class="h-full w-[65%] rounded-full bg-emerald-500"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">@(_playingIndex >= 0 ? _tracks[_playingIndex].Artist : "")</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Now playing
            </BadgeCn>
        </div>
    </div>
</section>

@code {
    private record Track(string Id, string Title, string Artist, string Album, string Duration, string PlayedAt);

    private string _playing = "t1";
    private const string _totalDuration = "32:38";

    private int _playingIndex => Array.IndexOf(_tracks, Array.Find(_tracks, t => t.Id == _playing));

    private static readonly Track[] _tracks =
    [
        new("t1", "Midnight City", "M83", "Hurry Up, We're Dreaming", "4:03", "Just now"),
        new("t2", "Breathe", "Telepopmusik", "Genetic World", "4:47", "4 min ago"),
        new("t3", "Gooey", "Glass Animals", "ZABA", "3:33", "9 min ago"),
        new("t4", "Intro", "The xx", "xx", "2:07", "12 min ago"),
        new("t5", "Myth", "Beach House", "Bloom", "4:18", "14 min ago"),
        new("t6", "On Melancholy Hill", "Gorillaz", "Plastic Beach", "3:54", "19 min ago"),
        new("t7", "Taro", "alt-J", "An Awesome Wave", "5:06", "23 min ago"),
        new("t8", "Reckoner", "Radiohead", "In Rainbows", "4:50", "28 min ago"),
    ];
}
