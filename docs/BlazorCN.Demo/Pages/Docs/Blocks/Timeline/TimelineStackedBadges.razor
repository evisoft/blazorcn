@* ============================================================
   Block: timeline-stacked-badges
   Title: TimelineStackedBadges
   Description: React contribution timeline with color-coded pill badges, category grouping, and dense scannable layout using Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-stacked-badges.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Contributions</span>
            <div class="flex items-center gap-3">
                @foreach (var cat in _categories)
                {
                    var style = _categoryStyles[cat];
                    <span class="flex items-center gap-1 text-muted-foreground text-[10px]">
                        <span class="@Cn.Merge("size-1.5 rounded-full", style.Dot)"></span>
                        @cat
                    </span>
                }
            </div>
        </div>

        @* Summary bar *@
        <div class="flex items-center gap-3 border-b px-4 py-2">
            <span class="font-semibold text-2xl tabular-nums">@_totalEntries</span>
            <span class="text-muted-foreground text-xs">contributions in 3 weeks</span>
        </div>

        @* Timeline groups *@
        <div>
            @for (int wi = 0; wi < _weeks.Length; wi++)
            {
                var week = _weeks[wi];
                var isLastWeek = wi == _weeks.Length - 1;
                <div class="@(isLastWeek ? "" : "border-b")">
                    @* Week label *@
                    <div class="px-4 pt-3 pb-1.5">
                        <span class="font-medium text-muted-foreground text-xs">@week.Label</span>
                    </div>

                    @* Badge entries on timeline *@
                    <div class="relative px-4 pb-3">
                        @* Vertical rail *@
                        <div class="absolute top-0 bottom-3 left-[23px] w-px bg-border"></div>

                        <div class="flex flex-col gap-1.5">
                            @foreach (var entry in week.Entries)
                            {
                                var entryStyle = _categoryStyles[entry.Category];
                                <div class="relative flex items-center gap-3">
                                    @* Dot on rail *@
                                    <div class="relative z-10 flex w-3 shrink-0 items-center justify-center">
                                        <span class="@Cn.Merge("size-1.5 rounded-full", entryStyle.Dot)"></span>
                                    </div>

                                    @* Badge pill *@
                                    <div class="@Cn.Merge("flex min-w-0 items-center gap-2 rounded-full px-2.5 py-0.5", entryStyle.Bg)">
                                        <span class="@Cn.Merge("truncate text-xs", entryStyle.Text)">@entry.Title</span>
                                        <span class="shrink-0 text-muted-foreground/60 text-[10px]">@entry.Timestamp</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CategoryStyle(string Bg, string Text, string Dot);
    private record TimelineEntry(string Id, string Title, string Category, string Timestamp);
    private record WeekGroup(string Label, TimelineEntry[] Entries);

    private static readonly string[] _categories = ["feature", "fix", "docs", "refactor", "test", "chore"];

    private static readonly Dictionary<string, CategoryStyle> _categoryStyles = new()
    {
        ["feature"]  = new("bg-emerald-500/10", "text-emerald-700 dark:text-emerald-400", "bg-emerald-500"),
        ["fix"]      = new("bg-red-500/10",     "text-red-700 dark:text-red-400",         "bg-red-500"),
        ["docs"]     = new("bg-blue-500/10",    "text-blue-700 dark:text-blue-400",       "bg-blue-500"),
        ["refactor"] = new("bg-violet-500/10",  "text-violet-700 dark:text-violet-400",   "bg-violet-500"),
        ["test"]     = new("bg-amber-500/10",   "text-amber-700 dark:text-amber-400",     "bg-amber-500"),
        ["chore"]    = new("bg-muted",          "text-muted-foreground",                  "bg-muted-foreground/50"),
    };

    private static readonly WeekGroup[] _weeks =
    [
        new("This week",
        [
            new("1",  "Add user preferences API",         "feature",  "2h ago"),
            new("2",  "Fix session timeout handling",      "fix",      "3h ago"),
            new("3",  "Update API rate limiting docs",     "docs",     "5h ago"),
            new("4",  "Extract auth middleware",           "refactor", "6h ago"),
            new("5",  "Add e2e tests for checkout",        "test",     "1d ago"),
            new("6",  "Dark mode toggle component",        "feature",  "1d ago"),
            new("7",  "Bump dependencies to latest",       "chore",    "2d ago"),
            new("8",  "Fix race condition in sync",        "fix",      "2d ago"),
        ]),
        new("Last week",
        [
            new("9",  "Implement webhook retry logic",     "feature",  "5d ago"),
            new("10", "Fix decimal rounding in billing",   "fix",      "5d ago"),
            new("11", "Inline cache module into core",     "refactor", "6d ago"),
            new("12", "Add integration tests for API",     "test",     "6d ago"),
            new("13", "Document deployment process",       "docs",     "7d ago"),
            new("14", "File upload progress bar",          "feature",  "7d ago"),
        ]),
        new("2 weeks ago",
        [
            new("15", "Migrate to new auth provider",      "refactor", "9d ago"),
            new("16", "Fix timezone display bug",          "fix",      "10d ago"),
            new("17", "Add snapshot tests for UI",         "test",     "11d ago"),
            new("18", "Update onboarding guide",           "docs",     "12d ago"),
            new("19", "Clean up unused imports",           "chore",    "13d ago"),
        ]),
    ];

    private int _totalEntries => _weeks.Sum(w => w.Entries.Length);
}
