@* ============================================================
   Block: timeline-recipe-steps
   Title: TimelineRecipeSteps
   Description: React recipe timeline with step tracking. Built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-recipe-steps.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="chef-hat" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Pan-seared salmon with lemon butter</span>
                </div>
                <span class="text-muted-foreground text-xs">2 servings</span>
            </div>
        </div>

        @* Progress summary *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-sm">
                <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-semibold tabular-nums">@_completedMinutes</span>
                <span class="text-muted-foreground text-xs">of @_totalMinutes min</span>
            </span>
            <span class="text-muted-foreground/40 text-xs">·</span>
            <span class="text-muted-foreground text-xs">
                Step @_activeStep of @_steps.Length
            </span>
            @* Progress dots *@
            <div class="ml-auto flex items-center gap-1">
                @foreach (var step in _steps)
                {
                    var dotStatus = GetStatus(step.StepNumber);
                    <span class="@($"size-1.5 rounded-full {(dotStatus == StepStatus.Completed ? "bg-emerald-500" : dotStatus == StepStatus.Active ? "bg-blue-500" : "bg-muted-foreground/20")}")"></span>
                }
            </div>
        </div>

        @* Steps timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var step in _steps)
                {
                    var stepIndex = System.Array.IndexOf(_steps, step);
                    var isLast = stepIndex == _steps.Length - 1;
                    var status = GetStatus(step.StepNumber);

                    <div class="relative flex gap-4">
                        @* Timeline column: numbered marker + connector *@
                        <div class="flex flex-col items-center">
                            @* Numbered circle marker *@
                            <button type="button" aria-label="@($"Step {step.StepNumber}: {step.Title}")"
                                    @onclick="@(() => SetActiveStep(step.StepNumber))"
                                    class="@($"relative z-10 flex size-8 shrink-0 items-center justify-center rounded-full transition-colors {(status == StepStatus.Completed ? "bg-emerald-500 text-white" : status == StepStatus.Active ? "bg-blue-500 text-white" : "border-2 border-muted-foreground/25 bg-card text-muted-foreground")}")">
                                @if (status == StepStatus.Completed)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="size-4" />
                                }
                                else
                                {
                                    <span class="font-semibold text-xs tabular-nums">@step.StepNumber</span>
                                }
                                @if (status == StepStatus.Active)
                                {
                                    <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                }
                            </button>
                            @* Connector line *@
                            @if (!isLast)
                            {
                                <div class="@($"w-px flex-1 {(status == StepStatus.Completed ? "bg-emerald-500/30" : "bg-muted-foreground/15")}")"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@($"{(isLast ? "pb-0" : "pb-5")} min-w-0 flex-1 pt-0.5")">
                            <div class="flex items-center gap-2">
                                <span class="@($"font-medium text-sm {(status == StepStatus.Upcoming ? "text-muted-foreground" : "")}")">
                                    @step.Title
                                </span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 gap-1 px-1.5 font-normal text-xs">
                                    <LucideIconCn Name="clock" Size="10" Class="size-2.5" />
                                    @step.Duration
                                </BadgeCn>
                                @if (!string.IsNullOrEmpty(step.Technique))
                                {
                                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                        <LucideIconCn Name="flame" Size="12" Class="size-3 text-amber-500" />
                                        @step.Technique
                                    </span>
                                }
                            </div>

                            @* Instructions *@
                            <p class="@($"mt-1.5 text-sm leading-relaxed {(status == StepStatus.Active ? "text-foreground" : "text-muted-foreground")}")">
                                @step.Instructions
                            </p>

                            @* Ingredients for this step *@
                            @if (step.Ingredients.Length > 0)
                            {
                                <div class="mt-2 flex flex-wrap gap-1.5">
                                    @foreach (var ingredient in step.Ingredients)
                                    {
                                        <span class="@($"inline-flex items-center rounded-md px-2 py-0.5 text-xs {(status == StepStatus.Completed ? "bg-emerald-500/5 text-emerald-700 line-through dark:text-emerald-400" : status == StepStatus.Active ? "bg-blue-500/10 text-blue-700 dark:text-blue-400" : "bg-muted/50 text-muted-foreground")}")">
                                            @ingredient
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum StepStatus { Completed, Active, Upcoming }

    private record RecipeStep(string Id, int StepNumber, string Title, string Duration, string Instructions, string[] Ingredients, string Technique = "");

    private int _activeStep = 3;

    private static readonly RecipeStep[] _steps =
    [
        new("s1", 1, "Prepare the salmon fillets", "5 min",
            "Pat the salmon fillets completely dry with paper towels. Season both sides generously with salt and freshly cracked black pepper. Let sit at room temperature while you prepare the remaining ingredients.",
            ["2 salmon fillets (6 oz each)", "Kosher salt", "Black pepper"]),
        new("s2", 2, "Prepare aromatics and garnish", "5 min",
            "Mince 3 cloves of garlic. Slice one lemon into thin rounds, juice the other half into a small bowl. Roughly chop fresh dill fronds. Cube the cold butter into 4 pieces.",
            ["3 garlic cloves", "2 lemons", "Fresh dill", "3 tbsp unsalted butter"]),
        new("s3", 3, "Sear the salmon skin-side up", "4 min",
            "Heat olive oil in a large stainless steel skillet over medium-high heat until the oil shimmers. Place salmon fillets presentation-side down. Press gently for the first 30 seconds to ensure even contact. Cook without moving for 4 minutes until a golden crust forms.",
            ["2 tbsp olive oil"],
            "Medium-high heat"),
        new("s4", 4, "Flip and finish cooking", "3 min",
            "Carefully flip the fillets. Reduce heat to medium. Add the cubed butter and minced garlic to the pan. As the butter melts and foams, tilt the pan and spoon the garlic butter over the salmon repeatedly for 3 minutes.",
            [],
            "Medium heat, baste continuously"),
        new("s5", 5, "Make the lemon butter sauce", "2 min",
            "Remove salmon to a warm plate and tent with foil. Return the skillet to medium heat. Add lemon juice and 1 tablespoon of butter. Stir and scrape up any browned bits from the bottom of the pan. Simmer until slightly thickened, about 1 minute. Season with a pinch of salt.",
            ["Lemon juice", "1 tbsp butter", "Pinch of salt"],
            "Medium heat"),
        new("s6", 6, "Plate and serve", "2 min",
            "Place each salmon fillet on a warm plate. Spoon the lemon butter sauce over the top. Garnish with fresh dill and a lemon round. Serve immediately alongside roasted asparagus or steamed rice.",
            ["Fresh dill garnish", "Lemon rounds"]),
    ];

    private int _totalMinutes => _steps.Sum(s => ParseMinutes(s.Duration));
    private int _completedMinutes => _steps.Where(s => GetStatus(s.StepNumber) == StepStatus.Completed).Sum(s => ParseMinutes(s.Duration));

    private StepStatus GetStatus(int stepNumber)
    {
        if (stepNumber < _activeStep) return StepStatus.Completed;
        if (stepNumber == _activeStep) return StepStatus.Active;
        return StepStatus.Upcoming;
    }

    private void SetActiveStep(int stepNumber)
    {
        _activeStep = stepNumber;
    }

    private static int ParseMinutes(string duration)
    {
        var match = System.Text.RegularExpressions.Regex.Match(duration, @"(\d+)");
        return match.Success ? int.Parse(match.Groups[1].Value) : 0;
    }
}
