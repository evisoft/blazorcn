@* ============================================================
   Block: timeline-thick-rail
   Title: TimelineThickRail
   Description: React timeline with thick rounded rail backbone connecting horizontal arms built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-thick-rail.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Infrastructure timeline</span>
                <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        @_milestones.Count(m => m.Phase == Phase.Complete) done
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-blue-500"></span>
                        @_milestones.Count(m => m.Phase == Phase.Active) active
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                        @_milestones.Count(m => m.Phase == Phase.Planned) planned
                    </span>
                </div>
            </div>
        </div>

        @* Rail timeline *@
        <div class="relative px-4 py-4">
            <div class="relative flex">
                @* Thick rail *@
                <div class="relative flex shrink-0 flex-col items-center" style="width:6px">
                    @foreach (var milestone in _milestones)
                    {
                        var idx = System.Array.IndexOf(_milestones, milestone);
                        var railClass = PhaseRail(milestone.Phase);
                        var roundTop = idx == 0 ? " rounded-t-full" : "";
                        var roundBottom = idx == _milestones.Length - 1 ? " rounded-b-full" : "";
                        <div class="@Cn.Merge("w-full flex-1", railClass + roundTop + roundBottom)"></div>
                    }
                </div>

                @* Entries *@
                <div class="flex-1">
                    @foreach (var milestone in _milestones)
                    {
                        var midx = System.Array.IndexOf(_milestones, milestone);
                        var isLast = midx == _milestones.Length - 1;
                        var isExpanded = _expanded == milestone.Id;
                        var chevronClass = isExpanded
                            ? "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 rotate-90"
                            : "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200";
                        var mid = milestone.Id;

                        <div class="@Cn.Merge(isLast ? "" : "border-b")">
                            <div class="flex items-start">
                                @* Horizontal arm *@
                                <div class="relative mt-[18px] flex items-center">
                                    <div class="@Cn.Merge("h-0.5 w-4", PhaseArm(milestone.Phase))"></div>
                                    <div class="@Cn.Merge("size-2 shrink-0 rounded-full", PhaseDot(milestone.Phase))"></div>
                                </div>

                                @* Content *@
                                <div class="min-w-0 flex-1">
                                    <button type="button"
                                            @onclick="@(() => SetExpanded(mid, isExpanded))"
                                            class="flex w-full items-center gap-3 px-3 py-3 text-left transition-colors hover:bg-muted/50">
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center gap-2">
                                                <span class="font-medium text-sm">@milestone.Title</span>
                                                @if (milestone.Tag != null)
                                                {
                                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@milestone.Tag</BadgeCn>
                                                }
                                            </div>
                                            <span class="mt-0.5 block text-muted-foreground text-xs">@milestone.Date</span>
                                        </div>
                                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                                    </button>

                                    @if (isExpanded)
                                    {
                                        <div class="px-3 pb-3">
                                            <p class="text-muted-foreground text-sm leading-relaxed">@milestone.Summary</p>
                                            <div class="mt-2 rounded-md bg-muted/50 p-3">
                                                <span class="mb-1 block font-medium text-muted-foreground text-xs">Technical details</span>
                                                <p class="text-sm leading-relaxed">@milestone.Details</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private enum Phase { Complete, Active, Planned }

    private record RailEntry(string Id, string Date, string Title, string Summary, string Details, Phase Phase, string? Tag);

    private static readonly RailEntry[] _milestones =
    [
        new("r1", "Jan 2026", "Database migration to CockroachDB",
            "Migrated 4.2TB of production data from PostgreSQL to CockroachDB with zero downtime using a dual-write strategy and shadow reads.",
            "Ran parallel writes for 3 weeks to validate data consistency. Automated schema translation covered 94% of cases. Manual fixes for 12 stored procedures. Final cutover completed in 8 minutes.",
            Phase.Complete, "Infrastructure"),
        new("r2", "Feb 2026", "Edge caching layer deployment",
            "Deployed a global edge caching layer across 34 regions. Reduced average API response time from 240ms to 18ms for cached endpoints.",
            "Implemented stale-while-revalidate with 60-second TTL for read-heavy endpoints. Cache hit rate stabilized at 87% after warm-up period. Added cache-busting webhooks for write operations.",
            Phase.Complete, "Performance"),
        new("r3", "Mar 2026", "Observability stack upgrade",
            "Replaced Datadog with an OpenTelemetry-based stack using Grafana, Tempo, and Loki. Annual cost reduced by 62% with better trace correlation.",
            "Instrumented 340 service endpoints with distributed tracing. Custom dashboards for P50/P95/P99 latency, error budget burn rate, and dependency maps. Alert routing through PagerDuty with 4-tier escalation.",
            Phase.Active, "Observability"),
        new("r4", "Apr 2026", "Kubernetes cluster consolidation",
            "Consolidating 6 regional Kubernetes clusters into 3 multi-zone clusters with improved resource utilization and simplified operations.",
            "Expected to reduce node count by 40% through better bin-packing. Implementing Karpenter for autoscaling. Service mesh migration from Istio to Cilium for reduced overhead.",
            Phase.Planned, "Infrastructure"),
        new("r5", "May 2026", "CI/CD pipeline modernization",
            "Replacing Jenkins with GitHub Actions and Dagger for reproducible builds. Target: reduce average build time from 14 minutes to under 4 minutes.",
            "Introducing remote caching with Turborepo for monorepo builds. Hermetic builds using Nix for dependency management. Automated security scanning integrated into the pull request workflow.",
            Phase.Planned, "DevOps"),
    ];

    private string? _expanded = "r3";

    private void SetExpanded(string id, bool currentlyExpanded)
    {
        _expanded = currentlyExpanded ? null : id;
    }

    private static string PhaseRail(Phase phase) => phase switch
    {
        Phase.Complete => "bg-emerald-500/50",
        Phase.Active   => "bg-blue-500/50",
        _              => "bg-muted-foreground/15",
    };

    private static string PhaseArm(Phase phase) => phase switch
    {
        Phase.Complete => "bg-emerald-500/40",
        Phase.Active   => "bg-blue-500/40",
        _              => "bg-muted-foreground/15",
    };

    private static string PhaseDot(Phase phase) => phase switch
    {
        Phase.Complete => "bg-emerald-500",
        Phase.Active   => "bg-blue-500",
        _              => "bg-muted-foreground/30",
    };
}
