@* ============================================================
   Block: timeline-single-line
   Title: TimelineSingleLine
   Description: React minimal timeline for Next.js with shadcn/ui and Tailwind CSS where each entry is one line with timestamp and dot marker.
   Source: original/blocks/timeline/timeline-single-line.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Deploy log</span>
            <span class="font-mono text-muted-foreground text-xs">@_entries.Length entries</span>
        </div>

        @* Timeline *@
        <div class="py-0.5">
            @for (var i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var isFirst = i == 0;
                var isLast = i == _entries.Length - 1;
                var dotClass = entry.Highlight ? "size-2 bg-foreground" : "size-1.5 bg-muted-foreground/40";
                var titleClass = entry.Highlight ? "font-medium text-foreground" : "text-muted-foreground";
                <div class="group flex items-center gap-0 transition-colors hover:bg-muted/50">
                    @* Timestamp *@
                    <span class="shrink-0 py-[5px] pr-0 pl-4 font-mono text-muted-foreground text-xs tabular-nums">
                        @entry.Timestamp
                    </span>

                    @* Dot + line column *@
                    <div class="relative flex w-8 shrink-0 items-center justify-center self-stretch">
                        @* Line above *@
                        @if (!isFirst)
                        {
                            <div class="absolute top-0 bottom-1/2 left-1/2 w-px -translate-x-1/2 bg-border"></div>
                        }
                        @* Dot *@
                        <span class="@($"relative z-10 shrink-0 rounded-full {dotClass}")"></span>
                        @* Line below *@
                        @if (!isLast)
                        {
                            <div class="absolute top-1/2 bottom-0 left-1/2 w-px -translate-x-1/2 bg-border"></div>
                        }
                    </div>

                    @* Title *@
                    <span class="@($"min-w-0 flex-1 truncate py-[5px] pr-4 text-sm {titleClass}")">
                        @entry.Title
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TimelineEntry(string Id, string Timestamp, string Title, bool Highlight = false);

    private static readonly TimelineEntry[] _entries =
    [
        new("1",  "16:42:31", "Production deploy v3.8.2 completed",          Highlight: true),
        new("2",  "16:41:58", "All health checks passing"),
        new("3",  "16:41:12", "Rolling restart finished on 4 pods"),
        new("4",  "16:40:27", "Container image sha:a3f8c12 pushed"),
