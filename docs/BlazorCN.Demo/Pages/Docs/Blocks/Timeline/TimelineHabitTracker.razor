@* ============================================================
   Block: timeline-habit-tracker
   Title: TimelineHabitTracker
   Description: React habit streak timeline with completion nodes and streak counters using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-habit-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="flame" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Habit tracker</span>
            </div>
            <span class="text-muted-foreground text-xs">Last 14 days</span>
        </div>

        @* Habit selector *@
        <div class="flex items-center gap-2 border-b px-4 py-2.5">
            @foreach (var h in _habits)
            {
                var habitId = h.Id;
                <button
                    type="button"
                    @onclick="@(() => _activeHabit = habitId)"
                    class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _activeHabit == h.Id ? "bg-foreground text-background font-medium" : "text-muted-foreground hover:bg-muted/50")">
                    @h.Name
                </button>
            }
        </div>

        @{
            var habit = System.Linq.Enumerable.FirstOrDefault(_habits, h => h.Id == _activeHabit) ?? _habits[0];
            var completedCount = System.Linq.Enumerable.Count(habit.Days, d => d.Completed);
        }

        @* Streak stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="flame" Size="14" Class="size-3.5 text-amber-500" />
                <span class="font-semibold text-2xl tabular-nums">@habit.CurrentStreak</span>
                <span class="text-muted-foreground text-xs">day streak</span>
            </div>
            <span class="text-muted-foreground/40 text-xs">·</span>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="trophy" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium text-sm tabular-nums">@habit.BestStreak</span>
                <span class="text-muted-foreground text-xs">best</span>
            </div>
            <div class="ml-auto flex items-center gap-1.5">
                <span class="font-medium text-sm tabular-nums">@completedCount/@habit.Days.Length</span>
                <span class="text-muted-foreground text-xs">completed</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-1 h-5 font-normal text-[10px] tabular-nums">@habit.CompletionRate%</BadgeCn>
            </div>
        </div>

        @* Mini streak bar *@
        <div class="flex items-center gap-1 border-b px-4 py-2.5">
            @foreach (var day in habit.Days)
            {
                <div class="@Cn.Merge("h-2 flex-1 rounded-full", day.Completed ? "bg-emerald-500" : "bg-muted-foreground/15")"></div>
            }
        </div>

        @* Timeline *@
        <div class="px-4 py-3">
            <div class="relative">
                @for (int i = 0; i < habit.Days.Length; i++)
                {
                    var day = habit.Days[i];
                    var index = i;
                    var isLast = index == habit.Days.Length - 1;
                    var isFirst = index == 0;
                    var nextCompleted = !isLast && habit.Days[index + 1].Completed;
                    var lineColor = day.Completed && nextCompleted ? "bg-emerald-500/30" : "bg-border";

                    <div class="relative flex gap-3 pb-3 last:pb-0">
                        @* Vertical line *@
                        @if (!isLast)
                        {
                            <div class="@Cn.Merge("absolute top-5 bottom-0 left-[7px] w-px", lineColor)"></div>
                        }

                        @* Day dot *@
                        <div class="relative z-10 flex shrink-0 pt-1">
                            @if (day.Completed)
                            {
                                <div class="flex size-[15px] items-center justify-center rounded-full bg-emerald-500 ring-2 ring-card">
                                    <LucideIconCn Name="check" Size="10" Class="size-2.5 text-white" />
                                </div>
                            }
                            else
                            {
                                <div class="size-[15px] rounded-full border-2 border-muted-foreground/30 bg-card ring-2 ring-card"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="flex min-w-0 flex-1 items-center gap-2">
                            <span class="@Cn.Merge("w-8 text-xs font-medium", day.Completed ? "text-foreground" : "text-muted-foreground/50")">
                                @day.DayOfWeek
                            </span>
                            <span class="text-muted-foreground text-xs tabular-nums">@day.Date</span>
                            @if (isFirst)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 font-normal text-[10px]">Today</BadgeCn>
                            }
                            @if (day.Note != null)
                            {
                                <span class="ml-auto truncate text-muted-foreground text-xs">@day.Note</span>
                            }
                            @if (day.Completed && day.Note == null)
                            {
                                <span class="ml-auto text-emerald-600 text-xs dark:text-emerald-400">Done</span>
                            }
                            @if (!day.Completed && day.Note == null)
                            {
                                <span class="ml-auto text-muted-foreground/40 text-xs">Missed</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
