@* ============================================================
   Block: timeline-education-history
   Title: TimelineEducationHistory
   Description: React academic timeline with degree icons and honors built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-education-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Education</span>
                <span class="text-muted-foreground text-xs">@_education.Length degrees</span>
            </div>
        </div>

        @* Timeline *@
        <div>
            @for (var i = 0; i < _education.Length; i++)
            {
                var entry = _education[i];
                var isLast = i == _education.Length - 1;
                var isAlternate = i % 2 == 1;
                var config = _typeConfig[entry.Type];

                <div class="@Cn.Merge(!isLast ? "border-b" : "", isAlternate ? "bg-muted/30" : "")">
                    <div class="flex gap-4 px-4 py-4">
                        @* Line + Node column *@
                        <div class="flex flex-col items-center">
                            @* Degree icon node *@
                            <div class="@Cn.Merge("relative z-10 flex size-8 shrink-0 items-center justify-center rounded-full border-2", config.DotColor)">
                                @if (entry.Type == DegreeType.Doctorate)
                                {
                                    <LucideIconCn Name="scroll-text" Size="14" Class="size-3.5 text-amber-600 dark:text-amber-400" />
                                }
                                else if (entry.Type == DegreeType.Masters)
                                {
                                    <LucideIconCn Name="graduation-cap" Size="14" Class="size-3.5 text-violet-600 dark:text-violet-400" />
                                }
                                else if (entry.Type == DegreeType.Bachelors)
                                {
                                    <LucideIconCn Name="book-open" Size="14" Class="size-3.5 text-blue-600 dark:text-blue-400" />
                                }
                                else
                                {
                                    <LucideIconCn Name="award" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                                }
                                @if (entry.InProgress)
                                {
                                    <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                }
                            </div>
                            @* Connector line *@
                            @if (!isLast)
                            {
                                <div class="w-0.5 flex-1 bg-border"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1 pt-0.5">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@entry.Degree</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    @config.Label
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-sm text-foreground/80">@entry.Field</p>
                            <div class="mt-0.5 flex items-center gap-1.5 text-muted-foreground text-xs">
                                <span>@entry.Abbreviation</span>
                                <span>·</span>
                                <span>Class of @entry.Year</span>
                                <span>·</span>
                                <span>@entry.Duration</span>
                            </div>

                            @if (entry.Gpa != null)
                            {
                                <div class="mt-2 flex items-center gap-1.5">
                                    <span class="text-muted-foreground text-xs">GPA</span>
                                    <span class="font-medium font-mono text-xs">@entry.Gpa</span>
                                </div>
                            }

                            @* Honors *@
                            @if (entry.Honors != null && entry.Honors.Length > 0)
                            {
                                <ul class="mt-2 space-y-1">
                                    @foreach (var honor in entry.Honors)
                                    {
                                        <li class="flex gap-2 text-muted-foreground text-sm leading-relaxed">
                                            <span class="mt-2 size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                            <span>@honor</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum DegreeType { Doctorate, Masters, Bachelors, Associate }

    private record Education(
        string Id,
        string Institution,
        string Abbreviation,
        string Degree,
        string Field,
        string Year,
        string Duration,
        DegreeType Type,
        string? Gpa = null,
        string[]? Honors = null,
        bool InProgress = false
    );

    private record TypeConfig(string Label, string DotColor);

    private static readonly Dictionary<DegreeType, TypeConfig> _typeConfig = new()
    {
        [DegreeType.Doctorate]  = new("Ph.D.",        "border-amber-500 bg-amber-500/10"),
        [DegreeType.Masters]    = new("Master's",     "border-violet-500 bg-violet-500/10"),
        [DegreeType.Bachelors]  = new("Bachelor's",   "border-blue-500 bg-blue-500/10"),
        [DegreeType.Associate]  = new("Associate's",  "border-emerald-500 bg-emerald-500/10"),
    };

    private static readonly Education[] _education =
    [
        new("ed1", "Stanford University", "Stanford",
            "Master of Science", "Computer Science — Human-Computer Interaction",
            "2019", "2 years", DegreeType.Masters,
            "3.92 / 4.0",
            [
                "Published thesis on adaptive UI systems at CHI 2019",
                "Teaching assistant for CS 147: Introduction to HCI",
                "Graduate Research Fellowship recipient",
            ]),
        new("ed2", "University of California, Berkeley", "UC Berkeley",
            "Bachelor of Science", "Electrical Engineering & Computer Sciences",
            "2017", "4 years", DegreeType.Bachelors,
            "3.78 / 4.0",
            [
                "Dean's List — 6 semesters",
                "Undergraduate Research Apprentice Program, HCI Lab",
                "ACM student chapter president, 2016–2017",
            ]),
        new("ed3", "De Anza College", "De Anza",
            "Associate of Science", "Mathematics and Computer Science",
            "2013", "2 years", DegreeType.Associate,
            "3.85 / 4.0",
            [
                "Phi Theta Kappa Honor Society",
                "Transfer Admission Guarantee to UC Berkeley",
            ]),
    ];
}
