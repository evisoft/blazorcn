@* ============================================================
   Block: timeline-calendar-view
   Title: TimelineCalendarView
   Description: React calendar timeline showing events on a weekly grid with chronological threading, built with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-calendar-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Week of March 17, 2026</span>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0" aria-label="Previous week">
                    <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Today
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0" aria-label="Next week">
                    <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

        @* Category legend *@
        <div class="flex flex-wrap items-center gap-3 border-b px-4 py-2.5">
            @foreach (var cat in _categoryDotKeys)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", _categoryDot[cat])"></span>
                    @_categoryLabel[cat]
                </span>
            }
            <span class="ml-auto text-muted-foreground text-xs">@_events.Length events</span>
        </div>

        @* Calendar grid *@
        <div class="border-b">
            @* Day headers *@
            <div class="grid grid-cols-7 border-b">
                @for (var i = 0; i < _weekDays.Length; i++)
                {
                    var dayIndex = i;
                    var day = _weekDays[dayIndex];
                    var hasEvents = _eventsByDay.ContainsKey(dayIndex) && _eventsByDay[dayIndex].Count > 0;
                    var isToday = dayIndex == 2;
                    <div class="@Cn.Merge("border-r px-2 py-2 text-center last:border-r-0", isToday ? "bg-muted/30" : "")">
                        <span class="block text-muted-foreground text-xs">@day</span>
                        <span class="@Cn.Merge("mt-0.5 block font-medium text-sm tabular-nums", isToday ? "text-blue-600 dark:text-blue-400" : "")">
                            @(_dates[dayIndex].Split(' ')[1])
                        </span>
                        @if (hasEvents)
                        {
                            <div class="mt-1 flex justify-center gap-0.5">
                                @foreach (var ev in _eventsByDay[dayIndex])
                                {
                                    <span class="@Cn.Merge("size-1 rounded-full", _categoryDot[ev.Category])"></span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @* Event cells *@
            <div class="grid grid-cols-7">
                @for (var i = 0; i < _weekDays.Length; i++)
                {
                    var dayIndex = i;
                    var dayEvents = _eventsByDay.ContainsKey(dayIndex) ? _eventsByDay[dayIndex] : new System.Collections.Generic.List<CalendarEvent>();
                    var isToday = dayIndex == 2;
                    <div class="@Cn.Merge("min-h-[140px] border-r p-1.5 last:border-r-0", isToday ? "bg-muted/15" : "")">
                        @foreach (var ev in dayEvents)
                        {
                            var evItem = ev;
                            var isActive = _selectedEvent == evItem.Id;
                            <button type="button" @onclick="@(() => ToggleSelected(evItem.Id))"
                                    class="@Cn.Merge("mb-1 w-full rounded px-1.5 py-1.5 text-left transition-colors", isActive ? "bg-muted ring-1 ring-border" : "hover:bg-muted/50")">
                                <div class="flex items-start gap-1">
                                    <span class="@Cn.Merge("mt-1 size-1.5 shrink-0 rounded-full", _categoryDot[evItem.Category])"></span>
                                    <div class="min-w-0 flex-1">
                                        <span class="block truncate font-medium text-xs leading-tight">@evItem.Title</span>
                                        <span class="block text-[10px] text-muted-foreground">@evItem.Time</span>
                                    </div>
                                </div>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        @* Chronological thread *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center gap-2">
                <LucideIconCn Name="circle" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Chronological thread</span>
            </div>
            <div class="relative pl-4">
                @* Vertical connecting line *@
                <div class="absolute top-0 bottom-0 left-[7px] w-px bg-border"></div>

                @foreach (var ev in _events)
                {
                    var evItem = ev;
                    var isActive = _selectedEvent == evItem.Id;
                    <button type="button" @onclick="@(() => ToggleSelected(evItem.Id))"
                            class="relative flex items-center gap-3 py-1.5 text-left">
                        @* Dot on the line *@
                        <span class="@Cn.Merge("relative z-10 -ml-4 size-2 shrink-0 rounded-full border", isActive ? "border-foreground bg-foreground" : $"border-transparent {_categoryDot[evItem.Category]}")"></span>
                        <span class="font-mono text-[10px] text-muted-foreground tabular-nums">@(_dates[evItem.Day].Split(' ')[1])</span>
                        <span class="@Cn.Merge("truncate text-xs", isActive ? "font-medium" : "text-muted-foreground")">@evItem.Title</span>
                        <span class="text-[10px] text-muted-foreground">@evItem.Time</span>
                    </button>
                }
            </div>
        </div>

        @* Selected event detail *@
        @if (_selected != null)
        {
            <div class="px-4 py-3">
                <div class="flex items-center gap-2">
                    <span class="@Cn.Merge("size-2 rounded-full", _categoryDot[_selected.Category])"></span>
                    <span class="font-medium text-sm">@_selected.Title</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @_categoryLabel[_selected.Category]
                    </BadgeCn>
                </div>
                <div class="mt-1 flex items-center gap-2">
                    <span class="text-muted-foreground text-xs">@_dates[_selected.Day] · @_selected.Time</span>
                </div>
                <p class="mt-2 text-muted-foreground text-sm leading-relaxed">
                    @_selected.Description
                </p>
            </div>
        }
    </div>
</section>

@code {
    private record CalendarEvent(string Id, string Title, string Time, string Category, int Day, string Description);

    private static readonly string[] _weekDays = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    private static readonly string[] _dates = ["Mar 17", "Mar 18", "Mar 19", "Mar 20", "Mar 21", "Mar 22", "Mar 23"];

    private static readonly CalendarEvent[] _events =
    [
        new("e1", "Sprint planning",    "9:00 AM",  "meeting",   0, "Plan Sprint 18 backlog and assign story points to each item"),
        new("e2", "API review deadline","5:00 PM",  "deadline",  1, "Final review of the v3 REST API specification before freeze"),
        new("e3", "Design critique",    "2:00 PM",  "review",    2, "Review updated onboarding flow mockups with the design team"),
        new("e4", "v2.4 release",       "10:00 AM", "release",   3, "Deploy version 2.4 to production with billing and SSO features"),
        new("e5", "Stakeholder demo",   "3:00 PM",  "meeting",   3, "Live demo of the new dashboard analytics to the leadership team"),
        new("e6", "Security audit",     "11:00 AM", "review",    4, "Third-party pen test report walkthrough and remediation planning"),
        new("e7", "Q1 milestone",       "All day",  "milestone", 4, "Quarter 1 ends — review OKR progress and finalize metrics"),
        new("e8", "Team retrospective", "4:00 PM",  "meeting",   5, "Sprint retrospective to identify improvements and celebrate wins"),
    ];

    private static readonly System.Collections.Generic.Dictionary<string, string> _categoryDot = new()
    {
        ["meeting"]   = "bg-blue-500",
        ["deadline"]  = "bg-red-500",
        ["release"]   = "bg-emerald-500",
        ["review"]    = "bg-amber-500",
        ["milestone"] = "bg-purple-500",
    };

    private static readonly System.Collections.Generic.Dictionary<string, string> _categoryLabel = new()
    {
        ["meeting"]   = "Meeting",
        ["deadline"]  = "Deadline",
        ["release"]   = "Release",
        ["review"]    = "Review",
        ["milestone"] = "Milestone",
    };

    private static readonly string[] _categoryDotKeys = ["meeting", "deadline", "release", "review", "milestone"];

    private System.Collections.Generic.Dictionary<int, System.Collections.Generic.List<CalendarEvent>> _eventsByDay = new();

    private string? _selectedEvent = "e4";

    private CalendarEvent? _selected => _events.FirstOrDefault(e => e.Id == _selectedEvent);

    protected override void OnInitialized()
    {
        foreach (var ev in _events)
        {
            if (!_eventsByDay.ContainsKey(ev.Day))
                _eventsByDay[ev.Day] = new System.Collections.Generic.List<CalendarEvent>();
            _eventsByDay[ev.Day].Add(ev);
        }
    }

    private void ToggleSelected(string id)
    {
        _selectedEvent = _selectedEvent == id ? null : id;
    }
}
