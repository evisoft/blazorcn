@* ============================================================
   Block: timeline-travel-itinerary
   Title: TimelineTravelItinerary
   Description: React trip itinerary timeline with location markers built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-travel-itinerary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="plane" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Trip itinerary</span>
                </div>
                <span class="text-muted-foreground text-xs">@_itinerary.Length days · Japan</span>
            </div>
        </div>

        @* Current location *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="map-pin" Size="14" Class="size-3.5 text-blue-500" />
            <span class="text-sm">
                Day @(_currentDay?.Day) · @(_currentDay?.Location)
            </span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Today</BadgeCn>
            <span class="ml-auto text-muted-foreground text-xs">
                @(_itinerary.Count(d => d.Status == DayStatus.Past)) of @_itinerary.Length days completed
            </span>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var day in _itinerary)
                {
                    var idx = System.Array.IndexOf(_itinerary, day);
                    var isLast = idx == _itinerary.Length - 1;
                    var isExpanded = _expanded == day.Id;
                    var markerClass = StatusMarkerClass(day.Status);
                    var lineClass = LineClass(day.Status);
                    var chevronClass = isExpanded
                        ? "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 rotate-90"
                        : "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200";
                    var dayId = day.Id;

                    <div class="relative flex gap-4">
                        @* Timeline column: pin marker + dashed line *@
                        <div class="flex flex-col items-center">
                            @* Pin marker *@
                            <div class="@Cn.Merge("relative z-10 flex size-8 shrink-0 items-center justify-center rounded-full", markerClass)">
                                <span class="font-semibold text-xs tabular-nums">@day.Day</span>
                                @if (day.Status == DayStatus.Current)
                                {
                                    <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                }
                            </div>
                            @* Dashed journey line *@
                            @if (!isLast)
                            {
                                <div class="@Cn.Merge("w-px flex-1 border-l-2 border-dashed", lineClass)"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@Cn.Merge("min-w-0 flex-1 pt-0.5", isLast ? "pb-0" : "pb-5")">
                            <button type="button"
                                    @onclick="@(() => Toggle(dayId))"
                                    class="-mx-2 flex w-[calc(100%+16px)] items-center gap-2 rounded-md px-2 py-1 text-left transition-colors hover:bg-muted/50">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="font-medium text-sm">@day.Location</span>
                                        <span class="text-muted-foreground text-xs">@day.Country</span>
                                    </div>
                                    <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                        <span>@day.Date</span>
                                        <span>·</span>
                                        <span>@day.Activities.Length activities</span>
                                    </div>
                                </div>
                                <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                            </button>

                            @if (isExpanded)
                            {
                                <div class="mt-2 space-y-2">
                                    @foreach (var activity in day.Activities)
                                    {
                                        <div class="rounded-md bg-muted/50 p-3">
                                            <div class="mb-1 flex items-center gap-2">
                                                <span class="font-mono text-muted-foreground text-xs">@activity.Time</span>
                                            </div>
                                            <p class="font-medium text-sm">@activity.Title</p>
                                            <p class="mt-1 text-muted-foreground text-xs leading-relaxed">@activity.Notes</p>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum DayStatus { Past, Current, Upcoming }

    private record TripActivity(string Time, string Title, string Notes);

    private record TripDay(string Id, int Day, string Date, string Location, string Country, DayStatus Status, TripActivity[] Activities);

    private static readonly TripDay[] _itinerary =
    [
        new("d1", 1, "Apr 10", "Tokyo", "Japan", DayStatus.Past,
        [
            new("10:30 AM", "Arrive at Narita International Airport",
                "Terminal 1. Pick up pocket Wi-Fi at arrivals counter. Take Narita Express to Shinjuku Station."),
            new("2:00 PM", "Check in at Park Hyatt Tokyo",
                "Deluxe room, 42nd floor. Confirmation #PHT-29841."),
            new("6:00 PM", "Walk through Shinjuku Gyoen National Garden",
                "Open until 6:30 PM. Cherry blossom season — arrive early for the best light."),
        ]),
        new("d2", 2, "Apr 11", "Tokyo", "Japan", DayStatus.Past,
        [
            new("8:00 AM", "Tsukiji Outer Market breakfast",
                "Try the tamagoyaki and fresh sashimi. Market is busiest before 9 AM."),
            new("11:00 AM", "TeamLab Borderless digital art museum",
                "Pre-booked tickets for 11 AM entry. Allow 2-3 hours. Wear dark clothing for the best immersive experience."),
            new("7:00 PM", "Dinner at Narisawa restaurant",
                "Reservation for 2 at 7 PM. Innovative Japanese cuisine, 2 Michelin stars. Smart casual dress code."),
        ]),
        new("d3", 3, "Apr 12", "Kyoto", "Japan", DayStatus.Current,
        [
            new("7:15 AM", "Shinkansen to Kyoto Station",
                "Nozomi 207, Car 8 Seats 3A-3B. Journey time 2 hours 15 minutes. Reserved seats."),
            new("10:00 AM", "Fushimi Inari Shrine hike",
                "Start at the main gate and hike the full torii gate trail. Allow 2 hours for the complete loop. Less crowded past the halfway point."),
            new("3:00 PM", "Tea ceremony at Camellia Garden",
                "Traditional matcha preparation class. 90 minutes. Located in the Higashiyama district."),
        ]),
        new("d4", 4, "Apr 13", "Osaka", "Japan", DayStatus.Upcoming,
        [
            new("9:00 AM", "Train to Osaka",
                "JR Special Rapid from Kyoto Station. 30-minute journey. No reservation needed."),
            new("11:00 AM", "Osaka Castle and park grounds",
                "Main tower observation deck opens at 9 AM. The castle museum covers 400 years of history across 8 floors."),
            new("5:00 PM", "Dotonbori street food tour",
                "Self-guided walk along the canal. Must-try: takoyaki at Kukuru, gyoza at Chao Chao, and okonomiyaki at Mizuno."),
        ]),
        new("d5", 5, "Apr 14", "Osaka", "Japan", DayStatus.Upcoming,
        [
            new("10:00 AM", "Kuromon Ichiba Market",
                "The kitchen of Osaka. Sample fresh seafood, wagyu beef skewers, and seasonal fruits. Best before noon."),
            new("2:00 PM", "Check out and transfer to Kansai Airport",
                "Nankai Rapi:t express from Namba Station. 40 minutes. Departs every 30 minutes."),
            new("5:45 PM", "Depart Kansai International Airport",
                "Flight JL-408 to San Francisco. Terminal 1. Check-in closes 60 minutes before departure."),
        ]),
    ];

    private string? _expanded = "d3";

    private TripDay? _currentDay => System.Array.Find(_itinerary, d => d.Status == DayStatus.Current);

    private string StatusMarkerClass(DayStatus status) => status switch
    {
        DayStatus.Past => "bg-foreground text-background",
        DayStatus.Current => "bg-blue-500 text-white",
        DayStatus.Upcoming => "bg-card text-muted-foreground border-2 border-muted-foreground/30",
        _ => ""
    };

    private string LineClass(DayStatus status) => status switch
    {
        DayStatus.Past => "border-foreground/20",
        DayStatus.Current => "border-blue-500/30",
        DayStatus.Upcoming => "border-muted-foreground/15",
        _ => ""
    };

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }
}
