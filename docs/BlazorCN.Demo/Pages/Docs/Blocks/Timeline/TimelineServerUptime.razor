@* ============================================================
   Block: timeline-server-uptime
   Title: TimelineServerUptime
   Description: React server uptime timeline with color-coded segments for Next.js, shadcn/ui, and Tailwind CSS showing availability patterns and incidents.
   Source: original/blocks/timeline/timeline-server-uptime.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Uptime log</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    72h window
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    Uptime
                    <span class="font-semibold text-emerald-600 tabular-nums dark:text-emerald-400">
                        @_uptimePercent%
                    </span>
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">@_totalIncidents incidents</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">@_totalDowntime down</span>
            </div>
        </div>

        @* Availability bar *@
        <div class="border-b px-4 py-3">
            <div class="flex h-2 w-full gap-0.5 overflow-hidden rounded-full">
                <div class="flex-[1842] rounded-l-full bg-emerald-500/80"></div>
                <div class="flex-[23] bg-red-500/80"></div>
                <div class="flex-[612] bg-emerald-500/80"></div>
                <div class="flex-[8] bg-amber-500/80"></div>
                <div class="flex-[1431] bg-emerald-500/80"></div>
                <div class="flex-[41] bg-orange-500/80"></div>
                <div class="flex-[2215] rounded-r-full bg-emerald-500/80"></div>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-muted-foreground text-[10px]">72h ago</span>
                <span class="text-muted-foreground text-[10px]">Now</span>
            </div>
        </div>

        @* Timeline entries *@
        <div>
            @foreach (var entry in _entries)
            {
                var isLast = entry.Id == _entries[_entries.Length - 1].Id;
                var isIncident = entry.Status == EntryStatus.Incident;
                var isExpanded = _expanded == entry.Id;
                var impactCfg = entry.Impact != null ? _impactConfig[entry.Impact] : null;

                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => { if (isIncident) { _expanded = isExpanded ? null : entry.Id; } })"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors", isIncident ? "cursor-pointer hover:bg-muted/50" : "cursor-default")">
                        @* Status indicator *@
                        <div class="flex flex-col items-center self-stretch">
                            @if (isIncident)
                            {
                                <LucideIconCn Name="shield-alert" Size="16" Class="size-4 shrink-0 text-red-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="shield-check" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                            }
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", isIncident ? "text-foreground" : "text-muted-foreground")">
                                    @entry.Title
                                </span>
                                @if (impactCfg != null)
                                {
                                    <span class="flex items-center gap-1.5">
                                        <span class="@($"size-1.5 rounded-full {impactCfg.Color}")"></span>
                                        <span class="text-muted-foreground text-xs">@impactCfg.Label</span>
                                    </span>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="font-mono text-muted-foreground text-xs">@entry.Duration</span>
                                <span class="text-muted-foreground/40 text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@entry.Timestamp</span>
                                <span class="text-muted-foreground/40 text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@string.Join(", ", entry.Services)</span>
                            </div>
                        </div>

                        @* Chevron for incidents *@
                        @if (isIncident)
                        {
                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        }
                    </button>

                    @* Expanded incident detail *@
                    @if (isExpanded && entry.Description != null)
                    {
                        <div class="px-4 pb-4 pl-11">
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Incident summary</span>
                                <p class="text-sm leading-relaxed">@entry.Description</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum EntryStatus { Operational, Incident }

    private record Entry(
        string Id,
        EntryStatus Status,
        string Title,
        string Duration,
        string Timestamp,
        string[] Services,
        string? Impact = null,
        string? Description = null
    );

    private record ImpactConfig(string Color, string Label);

    private string? _expanded = "2";

    private const string _uptimePercent = "99.82";
    private const string _totalDowntime = "1h 12m";
    private int _totalIncidents => System.Array.FindAll(_entries, e => e.Status == EntryStatus.Incident).Length;

    private static readonly Entry[] _entries =
    [
        new("1", EntryStatus.Operational, "All systems operational", "18h 42m", "Mar 24, 06:00",
            ["API", "Web", "Database", "CDN"]),
        new("2", EntryStatus.Incident, "Database connection pool exhaustion", "23m", "Mar 24, 00:18",
            ["Database", "API"], "critical",
            "Primary PostgreSQL instance exceeded max_connections limit of 200. All API writes failed. Resolved by scaling connection pooler from 200 to 500 and restarting affected pods."),
        new("3", EntryStatus.Operational, "All systems operational", "6h 12m", "Mar 23, 18:06",
            ["API", "Web", "Database", "CDN"]),
        new("4", EntryStatus.Incident, "CDN cache invalidation delay", "8m", "Mar 23, 17:58",
            ["CDN"], "minor",
            "Cache purge propagation delayed by 8 minutes across edge nodes. Users in EU-West served stale assets. No data loss. CDN provider confirmed intermittent purge queue congestion."),
        new("5", EntryStatus.Operational, "All systems operational", "14h 31m", "Mar 23, 03:27",
            ["API", "Web", "Database", "CDN"]),
        new("6", EntryStatus.Incident, "API gateway 502 errors", "41m", "Mar 23, 02:46",
            ["API", "Web"], "major",
            "Upstream API pods entered crash loop after OOM kill during traffic spike. 32% of requests returned 502 for 41 minutes. Resolved by increasing memory limits from 512Mi to 1Gi and adding horizontal pod autoscaler."),
        new("7", EntryStatus.Operational, "All systems operational", "22h 15m", "Mar 22, 04:31",
            ["API", "Web", "Database", "CDN"]),
    ];

    private static readonly System.Collections.Generic.Dictionary<string, ImpactConfig> _impactConfig = new()
    {
        ["minor"]    = new ImpactConfig("bg-amber-500", "Minor"),
        ["major"]    = new ImpactConfig("bg-orange-500", "Major"),
        ["critical"] = new ImpactConfig("bg-red-500", "Critical"),
    };
}
