@* ============================================================
   Block: timeline-onboarding-steps
   Title: TimelineOnboardingSteps
   Description: React user onboarding timeline with progress tracking. Built with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-onboarding-steps.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
            <div class="flex-1">
                <span class="font-medium text-sm">Getting Started</span>
                <p class="text-muted-foreground text-xs">
                    @_completedCount of @_steps.Length steps completed
                </p>
            </div>
            <span class="font-semibold text-sm tabular-nums">@_progress%</span>
        </div>

        @* Overall progress bar *@
        <div class="border-b px-4 py-3">
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div
                    class="h-full rounded-full bg-foreground transition-all duration-500"
                    style="@($"width:{_progress}%")"
                ></div>
            </div>
        </div>

        @* Steps *@
        <div class="px-4 py-5">
            @foreach (var step in _steps)
            {
                var idx = System.Array.IndexOf(_steps, step);
                var isLast = idx == _steps.Length - 1;

                <div class="relative flex gap-4">
                    @* Number circle + line *@
                    <div class="flex flex-col items-center">
                        @if (step.Status == StepStatus.Completed)
                        {
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-foreground">
                                <LucideIconCn Name="check" Size="16" Class="size-4 text-background" />
                            </div>
                        }
                        else if (step.Status == StepStatus.Current)
                        {
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-full border-2 border-foreground bg-card">
                                <span class="font-medium text-foreground text-xs tabular-nums">@step.Number</span>
                            </div>
                        }
                        else
                        {
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-full border-2 border-muted-foreground/25 bg-card">
                                <span class="text-muted-foreground/50 text-xs tabular-nums">@step.Number</span>
                            </div>
                        }

                        @* Connecting bar *@
                        @if (!isLast)
                        {
                            <div class="my-1 h-10 w-0.5">
                                @if (step.Status == StepStatus.Completed)
                                {
                                    <div class="h-full w-full bg-foreground"></div>
                                }
                                else
                                {
                                    <div class="h-full w-full bg-muted-foreground/20"></div>
                                }
                            </div>
                        }
                    </div>

                    @* Content *@
                    <div class="@(isLast ? "flex-1 pt-1 pb-0" : "flex-1 pt-1 pb-4")">
                        <span class="@(step.Status == StepStatus.Upcoming ? "font-medium text-sm text-muted-foreground" : "font-medium text-sm text-foreground")">
                            @step.Label
                        </span>
                        <p class="@(step.Status == StepStatus.Upcoming ? "mt-0.5 text-xs text-muted-foreground/60" : "mt-0.5 text-xs text-muted-foreground")">
                            @step.Description
                        </p>

                        @* Action button for current step *@
                        @if (step.Status == StepStatus.Current)
                        {
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="mt-2 h-7 text-xs" OnClick="HandleComplete">
                                Mark Complete
                            </ButtonCn>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum StepStatus { Completed, Current, Upcoming }

    private record OnboardingStep(string Id, int Number, string Label, string Description, StepStatus Status);

    private OnboardingStep[] _steps =
    [
        new("account",       1, "Create Account",       "Set up your email and password",                    StepStatus.Completed),
        new("profile",       2, "Complete Profile",     "Add your name, photo, and bio",                     StepStatus.Completed),
        new("workspace",     3, "Set Up Workspace",     "Name your workspace and invite teammates",          StepStatus.Current),
        new("integrations",  4, "Connect Integrations", "Link GitHub, Slack, or Jira to your workspace",    StepStatus.Upcoming),
        new("first-project", 5, "Create First Project", "Start a project to see everything in action",      StepStatus.Upcoming),
    ];

    private int _completedCount => System.Array.FindAll(_steps, s => s.Status == StepStatus.Completed).Length;
    private int _progress => (int)System.Math.Round((double)_completedCount / _steps.Length * 100);

    private void HandleComplete()
    {
        var currentIndex = System.Array.FindIndex(_steps, s => s.Status == StepStatus.Current);
        if (currentIndex < 0) return;

        for (int i = 0; i < _steps.Length; i++)
        {
            if (i == currentIndex)
                _steps[i] = _steps[i] with { Status = StepStatus.Completed };
            else if (i == currentIndex + 1)
                _steps[i] = _steps[i] with { Status = StepStatus.Current };
        }
    }
}
