@* ============================================================
   Block: timeline-audit-trail
   Title: TimelineAuditTrail
   Description: React audit log timeline with colored status dots showing actions, users, IP addresses, and timestamps built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-audit-trail.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Audit Trail</span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_successCount
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_warningCount
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_failureCount
                </span>
            </div>
        </div>

        @* Timeline *@
        <div>
            @for (int i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var isLast = i == _entries.Length - 1;
                var isExpanded = _expanded == entry.Id;
                var entryId = entry.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = (isExpanded ? null : entryId))"
                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        @* Timeline dot column *@
                        <div class="relative flex shrink-0 items-center justify-center">
                            <span class="size-2 rounded-full @StatusDotClass(entry.Status)"></span>
                        </div>

                        @* Timestamp *@
                        <span class="w-16 shrink-0 font-mono text-muted-foreground text-xs">
                            @entry.Timestamp
                        </span>

                        @* Action *@
                        <span class="w-28 shrink-0 font-mono text-xs">@entry.Action</span>

                        @* User + IP *@
                        <div class="min-w-0 flex-1">
                            <span class="truncate text-muted-foreground text-xs">@entry.User</span>
                        </div>

                        @* Status badge *@
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 min-w-[38px] justify-center font-mono text-[10px] font-normal">
                            @StatusLabelText(entry.Status)
                        </BadgeCn>

                        <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded && entry.Detail != null)
                    {
                        <div class="px-4 pb-3 pl-[52px]">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="mb-1.5 flex items-center gap-3 text-muted-foreground text-xs">
                                    <span class="font-mono">@entry.Resource</span>
                                    <span class="text-muted-foreground/40">·</span>
                                    <span class="font-mono">@entry.Ip</span>
                                </div>
                                <p class="text-sm leading-relaxed">@entry.Detail</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum AuditStatus { Success, Warning, Failure }

    private record AuditEntry(string Id, string Action, string Resource, string User, string Ip, string Timestamp, AuditStatus Status, string? Detail = null);

    private static readonly AuditEntry[] _entries =
    [
        new("1", "user.login", "auth/session", "sarah.chen@acme.com", "192.168.1.42", "10:42:18", AuditStatus.Success,
            "Multi-factor authentication verified. Session token issued with 24h expiry. Login from Chrome 122 on macOS."),
        new("2", "api.key.create", "settings/api-keys", "marcus.rivera@acme.com", "10.0.0.15", "10:38:05", AuditStatus.Success,
            "New API key created with read-only scope for workspace 'production'. Expires in 90 days."),
        new("3", "user.login", "auth/session", "unknown@external.io", "203.0.113.77", "10:35:51", AuditStatus.Failure,
            "Authentication failed — invalid credentials. Third failed attempt from this IP in 15 minutes. IP added to watchlist."),
        new("4", "role.update", "workspace/members", "ava.patel@acme.com", "172.16.0.8", "10:29:33", AuditStatus.Warning,
            "Role escalation: james.wilson@acme.com promoted from 'viewer' to 'admin'. This change grants full workspace access including billing."),
        new("5", "data.export", "analytics/reports", "james.wilson@acme.com", "192.168.1.100", "10:22:17", AuditStatus.Success,
            "Exported 'Monthly Active Users' report as CSV. 14,832 rows, 2.3 MB file size."),
        new("6", "webhook.fail", "integrations/stripe", "system", "10.0.0.1", "10:15:44", AuditStatus.Failure,
            "Stripe webhook delivery failed after 3 retries. Endpoint returned 503. Event: invoice.payment_succeeded. Queued for manual retry."),
        new("7", "secret.access", "vault/env-vars", "lina.nakamura@acme.com", "10.0.0.22", "10:11:09", AuditStatus.Warning,
            "Production database connection string accessed. Access logged per SOC 2 compliance policy."),
        new("8", "deploy.trigger", "ci/production", "omar.farouk@acme.com", "192.168.1.55", "10:04:28", AuditStatus.Success,
            "Production deployment triggered for commit a3f8c21. Docker image built and pushed. Rolling update initiated across 3 replicas."),
        new("9", "user.invite", "workspace/members", "sarah.chen@acme.com", "192.168.1.42", "09:58:02", AuditStatus.Success,
            "Invitation sent to new.hire@acme.com with 'developer' role. Invitation expires in 7 days."),
        new("10", "billing.update", "settings/billing", "ava.patel@acme.com", "172.16.0.8", "09:45:31", AuditStatus.Success,
            "Payment method updated to Visa ending in 4242. Next billing cycle: Apr 1, 2026."),
    ];

    private string? _expanded = "3";

    private int _successCount => _entries.Count(e => e.Status == AuditStatus.Success);
    private int _warningCount => _entries.Count(e => e.Status == AuditStatus.Warning);
    private int _failureCount => _entries.Count(e => e.Status == AuditStatus.Failure);

    private static string StatusDotClass(AuditStatus status) => status switch
    {
        AuditStatus.Success => "bg-emerald-500",
        AuditStatus.Warning => "bg-amber-500",
        AuditStatus.Failure => "bg-red-500",
        _ => ""
    };

    private static string StatusLabelText(AuditStatus status) => status switch
    {
        AuditStatus.Success => "OK",
        AuditStatus.Warning => "Warn",
        AuditStatus.Failure => "Fail",
        _ => ""
    };
}
