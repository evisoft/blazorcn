@* ============================================================
   Block: timeline-double-line
   Title: TimelineDoubleLine
   Description: React timeline with parallel lines and cross-ties built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-double-line.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Release track</span>
                <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        @_releases.Count(r => r.Status == TrackStatus.Shipped) shipped
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-blue-500"></span>
                        @_releases.Count(r => r.Status == TrackStatus.InProgress) active
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                        @_releases.Count(r => r.Status == TrackStatus.Queued) queued
                    </span>
                </div>
            </div>
        </div>

        @* Double-line timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var release in _releases)
                {
                    var index = Array.IndexOf(_releases, release);
                    var isLast = index == _releases.Length - 1;
                    var isExpanded = _expanded == release.Id;
                    var nodeClass = StatusNodeClass(release.Status);
                    var railClass = StatusRailClass(release.Status);
                    var tieClass = StatusTieClass(release.Status);
                    <div>
                        @* Entry row *@
                        <div class="relative flex gap-4">
                            @* Double-line track column *@
                            <div class="relative flex shrink-0 items-start justify-center" style="width:22px">
                                @* Left rail *@
                                <div class="@($"absolute top-0 bottom-0 left-1 w-px {railClass}")"></div>
                                @* Right rail *@
                                <div class="@($"absolute top-0 bottom-0 w-px {railClass}")" style="left:15px"></div>
                                @* Center node *@
                                <div class="@($"relative z-10 mt-3 size-3 shrink-0 rounded-full border-2 {nodeClass}")" style="margin-left:1px"></div>
                            </div>

                            @* Content *@
                            <div class="@($"min-w-0 flex-1 {(isLast ? "pb-0" : "pb-2")}")">
                                <button type="button" @onclick="@(() => Toggle(release.Id))" class="flex w-full items-center gap-2 py-2 text-left transition-colors">
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="font-medium text-sm">@release.Title</span>
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">@release.Version</BadgeCn>
                                        </div>
                                        <span class="mt-0.5 block text-muted-foreground text-xs">@release.Date</span>
                                    </div>
                                    <LucideIconCn Name="chevron-right" Size="16" Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="pb-2">
                                        <p class="text-muted-foreground text-sm leading-relaxed">@release.Summary</p>
                                        <div class="mt-2 rounded-md bg-muted/50 p-3">
                                            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Changes</span>
                                            <ul class="space-y-1">
                                                @foreach (var change in release.Changes)
                                                {
                                                    <li class="flex items-start gap-2 text-sm leading-relaxed">
                                                        <span class="mt-2 size-1 shrink-0 rounded-full bg-foreground/30"></span>
                                                        @change
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        @* Cross-ties between entries *@
                        @if (!isLast)
                        {
                            <div class="flex flex-col items-start gap-1.5 py-1" style="padding-left:4px">
                                @for (var ti = 0; ti < CrossTieCount; ti++)
                                {
                                    <div class="@($"h-px rounded-full {tieClass}")" style="width:12px"></div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum TrackStatus { Shipped, InProgress, Queued }

    private record TrackEntry(
        string Id,
        string Version,
        string Date,
        string Title,
        string Summary,
        string[] Changes,
        TrackStatus Status);

    private static readonly TrackEntry[] _releases =
    [
        new("t1", "v3.0.0", "Jan 15, 2026", "Platform architecture rewrite",
            "Complete rewrite of the core platform from Express to Next.js App Router with server components, streaming, and edge runtime support.",
            ["Migrated 186 API routes to server actions", "Reduced bundle size by 43% with tree-shaking", "Added edge runtime for 12 latency-critical endpoints", "Implemented streaming SSR for dashboard views"],
            TrackStatus.Shipped),
        new("t2", "v3.1.0", "Feb 12, 2026", "Real-time collaboration engine",
            "WebSocket-based collaboration layer enabling simultaneous editing, live cursors, and presence indicators across all workspace documents.",
            ["CRDT-based conflict resolution for concurrent edits", "Live cursor positions with user avatar indicators", "Presence API showing online team members", "Operational transform fallback for legacy browsers"],
            TrackStatus.Shipped),
        new("t3", "v3.2.0", "Mar 8, 2026", "Advanced permissions and RBAC",
            "Fine-grained role-based access control with custom roles, resource-level permissions, and audit logging for compliance requirements.",
            ["Custom role builder with 64 permission flags", "Resource-level access policies with inheritance", "Immutable audit log with tamper detection", "SCIM 2.0 provisioning for enterprise directories"],
            TrackStatus.InProgress),
        new("t4", "v3.3.0", "Apr 2026", "AI assistant and smart automation",
            "Embedded AI assistant for natural language queries, automated workflow creation, and predictive alerting based on usage patterns.",
            ["Natural language to SQL query builder", "Automated workflow suggestions from usage data", "Predictive anomaly detection on key metrics", "AI-generated weekly summary reports"],
            TrackStatus.Queued),
        new("t5", "v3.4.0", "May 2026", "Plugin marketplace and SDK",
            "Public plugin marketplace with a developer SDK, sandboxed execution environment, and revenue sharing for third-party extensions.",
            ["TypeScript SDK with 40+ extension points", "Sandboxed V8 isolates for plugin execution", "Marketplace with ratings and verified badges", "70/30 revenue share for paid plugins"],
            TrackStatus.Queued),
    ];

    private const int CrossTieCount = 3;

    private string? _expanded = "t3";

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string StatusNodeClass(TrackStatus status) => status switch
    {
        TrackStatus.Shipped => "bg-emerald-500 border-emerald-500",
        TrackStatus.InProgress => "bg-blue-500 border-blue-500",
        _ => "bg-card border-muted-foreground/25",
    };

    private static string StatusRailClass(TrackStatus status) => status switch
    {
        TrackStatus.Shipped => "bg-emerald-500/30",
        TrackStatus.InProgress => "bg-blue-500/30",
        _ => "bg-muted-foreground/15",
    };

    private static string StatusTieClass(TrackStatus status) => status switch
    {
        TrackStatus.Shipped => "bg-emerald-500/20",
        TrackStatus.InProgress => "bg-blue-500/20",
        _ => "bg-muted-foreground/10",
    };
}
