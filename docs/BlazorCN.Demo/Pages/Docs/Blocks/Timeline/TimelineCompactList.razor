@* ============================================================
   Block: timeline-compact-list
   Title: TimelineCompactList
   Description: React dense timeline with single-row entries and status badges, built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-compact-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">System events</span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_events.Where(e => e.Status == EventStatus.Error).Count()
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_events.Where(e => e.Status == EventStatus.Warning).Count()
                </span>
                <span class="text-muted-foreground text-xs">@_events.Length events</span>
            </div>
        </div>

        @* Timeline list *@
        <div class="py-1">
            @for (int i = 0; i < _events.Length; i++)
            {
                var evt = _events[i];
                var isLast = i == _events.Length - 1;
                var dotClass = _statusDot[evt.Status];
                <div class="group relative flex items-center gap-3 px-4 py-1.5 transition-colors hover:bg-muted/50">
                    @* Dot + connecting line column *@
                    <div class="relative flex flex-col items-center self-stretch">
                        @* Line above dot *@
                        @if (i > 0)
                        {
                            <div class="absolute bottom-1/2 w-px flex-1 bg-border" style="top:0"></div>
                        }
                        @* Dot *@
                        <div class="relative z-10 flex items-center self-center py-1">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dotClass)"></span>
                        </div>
                        @* Line below dot *@
                        @if (!isLast)
                        {
                            <div class="absolute top-1/2 w-px flex-1 bg-border" style="bottom:0"></div>
                        }
                    </div>

                    @* Timestamp *@
                    <span class="w-16 shrink-0 font-mono text-muted-foreground text-xs">@evt.Time</span>

                    @* Title *@
                    <span class="min-w-0 flex-1 truncate text-sm">@evt.Title</span>

                    @* Category badge *@
                    @if (evt.Category != null)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono font-normal text-[10px]">@evt.Category</BadgeCn>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum EventStatus { Success, Info, Warning, Error, Neutral }

    private record TimelineEvent(string Id, string Time, string Title, string? Category, EventStatus Status);

    private static readonly TimelineEvent[] _events =
    [
        new("1",  "14:32:08", "Deployment completed successfully",                       "deploy",   EventStatus.Success),
        new("2",  "14:31:45", "Health checks passing on all 3 instances",                "health",   EventStatus.Success),
        new("3",  "14:31:22", "Container image pushed to registry",                      "build",    EventStatus.Info),
        new("4",  "14:30:58", "Database migration applied: add_user_preferences",        "database", EventStatus.Info),
        new("5",  "14:30:41", "Rate limiter triggered on /api/search endpoint",          "alert",    EventStatus.Warning),
        new("6",  "14:29:17", "Build artifacts cached for next run",                     "build",    EventStatus.Neutral),
        new("7",  "14:28:54", "SSL certificate renewed for api.acme.io",                 "infra",    EventStatus.Success),
        new("8",  "14:28:03", "Memory usage exceeded 85% threshold on worker-2",         "alert",    EventStatus.Error),
        new("9",  "14:27:39", "Cron job completed: daily-report-generation",             "cron",     EventStatus.Neutral),
        new("10", "14:26:55", "New API key generated for service account",               "auth",     EventStatus.Info),
        new("11", "14:25:12", "Cache invalidated for product catalog",                   "cache",    EventStatus.Neutral),
        new("12", "14:24:08", "Webhook delivery failed to https://hooks.slack.com",      "webhook",  EventStatus.Error),
    ];

    private static readonly Dictionary<EventStatus, string> _statusDot = new()
    {
        [EventStatus.Success] = "bg-emerald-500",
        [EventStatus.Info]    = "bg-blue-500",
        [EventStatus.Warning] = "bg-amber-500",
        [EventStatus.Error]   = "bg-red-500",
        [EventStatus.Neutral] = "bg-muted-foreground/40",
    };
}
