@* ============================================================
   Block: timeline-fitness-log
   Title: TimelineFitnessLog
   Description: React workout timeline with exercise icons, duration, calories, and heart rate tracking using Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-fitness-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="heart" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Workout log</span>
            </div>
            <span class="text-muted-foreground text-xs">@_workouts.Length workouts this week</span>
        </div>

        @* Summary bar *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="flame" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-semibold text-sm tabular-nums">@_totalCalories.ToString("N0")</span>
                <span class="text-muted-foreground text-xs">kcal</span>
            </div>
            <span class="text-muted-foreground/40 text-xs">·</span>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="heart" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-semibold text-sm tabular-nums">@_avgHeartRate</span>
                <span class="text-muted-foreground text-xs">avg bpm</span>
            </div>
            <div class="ml-auto flex items-center gap-2">
                @foreach (var level in _intensityLevels)
                {
                    var cfg = GetIntensityConfig(level);
                    <span class="flex items-center gap-1 text-muted-foreground text-[10px]">
                        <span class="@Cn.Merge("size-1.5 rounded-full", cfg.Dot)"></span>
                        @cfg.Label
                    </span>
                }
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-3">
            <div class="relative">
                @foreach (var workout in _workouts)
                {
                    var isLast = workout.Id == _workouts[_workouts.Length - 1].Id;
                    var config = GetIntensityConfig(workout.Intensity);
                    <div class="relative flex gap-3 pb-5 last:pb-0">
                        @* Vertical line *@
                        @if (!isLast)
                        {
                            <div class="@Cn.Merge("absolute top-8 bottom-0 left-[11px] w-0.5", config.Line)"></div>
                        }

                        @* Icon marker *@
                        <div class="relative z-10 flex shrink-0 pt-0.5">
                            <div class="@Cn.Merge("flex size-6 items-center justify-center rounded-full ring-2 ring-card", config.Dot)">
                                <LucideIconCn Name="@workout.IconName" Size="12" Class="size-3 text-white dark:text-background" />
                            </div>
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@workout.Type</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 font-normal text-[10px]">
                                    @config.Label
                                </BadgeCn>
                                <span class="ml-auto shrink-0 text-muted-foreground text-xs">@workout.Timestamp</span>
                            </div>

                            @if (workout.Note != null)
                            {
                                <p class="mt-0.5 text-muted-foreground text-sm">@workout.Note</p>
                            }

                            @* Stats row *@
                            <div class="mt-1.5 flex items-center gap-3">
                                <span class="flex items-center gap-1 text-xs">
                                    <LucideIconCn Name="timer" Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="tabular-nums">@workout.Duration</span>
                                </span>
                                <span class="text-muted-foreground/40 text-xs">·</span>
                                <span class="flex items-center gap-1 text-xs">
                                    <LucideIconCn Name="flame" Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="tabular-nums">@workout.Calories</span>
                                    <span class="text-muted-foreground text-xs">kcal</span>
                                </span>
                                <span class="text-muted-foreground/40 text-xs">·</span>
                                <span class="flex items-center gap-1 text-xs">
                                    <LucideIconCn Name="heart" Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="tabular-nums">@workout.HeartRate</span>
                                    <span class="text-muted-foreground text-xs">bpm</span>
                                </span>
                                @if (workout.Distance != null)
                                {
                                    <span class="text-muted-foreground/40 text-xs">·</span>
                                    <span class="font-mono text-muted-foreground text-xs tabular-nums">@workout.Distance</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record IntensityConfig(string Dot, string Line, string Label);

    private record Workout(
        string Id,
        string Type,
        string IconName,
        string Duration,
        int Calories,
        int HeartRate,
        string Intensity,
        string Timestamp,
        string? Distance = null,
        string? Note = null
    );

    private static readonly string[] _intensityLevels = ["low", "moderate", "high", "max"];

    private static IntensityConfig GetIntensityConfig(string intensity) => intensity switch
    {
        "low"      => new("bg-muted-foreground/40", "bg-muted-foreground/15", "Low"),
        "moderate" => new("bg-emerald-500", "bg-emerald-500/20", "Moderate"),
        "high"     => new("bg-amber-500", "bg-amber-500/25", "High"),
        "max"      => new("bg-red-500", "bg-red-500/25", "Max"),
        _          => new("bg-muted-foreground/40", "bg-muted-foreground/15", "Low"),
    };

    private static readonly Workout[] _workouts =
    [
        new("w1", "Running",  "footprints", "48 min",  520, 162, "high",     "Today, 7:15 AM",       "6.2 km",   "Tempo run with hill intervals"),
        new("w2", "Strength", "dumbbell",   "62 min",  380, 134, "moderate", "Yesterday, 6:30 AM",   null,       "Upper body — bench, rows, OHP"),
        new("w3", "Cycling",  "bike",       "1h 15m",  680, 148, "high",     "Mar 23, 8:00 AM",      "32 km",    "Long ride along coast route"),
        new("w4", "Swimming", "waves",      "35 min",  290, 138, "moderate", "Mar 22, 12:00 PM",     "1,200 m",  "Freestyle drills and cool-down laps"),
        new("w5", "Hiking",   "mountain",   "2h 40m",  860, 128, "moderate", "Mar 21, 9:00 AM",      "11.4 km",  "Eagle Peak trail with 480m elevation"),
        new("w6", "HIIT",     "flame",      "28 min",  410, 174, "max",      "Mar 20, 6:45 AM",      null,       "Tabata circuit — 8 rounds"),
        new("w7", "Strength", "dumbbell",   "55 min",  340, 126, "moderate", "Mar 19, 7:00 AM",      null,       "Lower body — squats, RDL, lunges"),
    ];

    private static readonly int _totalCalories = _workouts.Sum(static w => w.Calories);
    private static readonly int _avgHeartRate = (int)Math.Round(_workouts.Average(static w => w.HeartRate));
}
