@* ============================================================
   Block: timeline-billing-history
   Title: TimelineBillingHistory
   Description: React invoice timeline with status indicators for paid, overdue, and pending invoices built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-billing-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Billing history</span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_paidCount
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_overdueCount
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                    @_pendingCount
                </span>
            </div>
        </div>

        @* Overdue alert *@
        @if (_overdueCount > 0)
        {
            <div class="flex items-center gap-2 border-b bg-amber-500/5 px-4 py-2.5">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                <span class="text-xs">
                    <span class="font-medium">1 overdue invoice</span>
                    <span class="text-muted-foreground"> — $1,999.00 past due</span>
                </span>
            </div>
        }

        @* Timeline *@
        <div class="py-1">
            @foreach (var invoice in _invoices)
            {
                var isLast = invoice.Id == _invoices[_invoices.Length - 1].Id;
                var isExpanded = _expanded == invoice.Id;
                var cfg = GetConfig(invoice.Status);
                var inv = invoice;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : inv.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Timeline node *@
                        <div class="relative flex flex-col items-center self-stretch">
                            <div class="@($"relative z-10 mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full {cfg.Dot}")">
                                <LucideIconCn Name="@cfg.IconName" Size="14" Class="@cfg.IconClass" />
                            </div>
                            @if (!isLast)
                            {
                                <div class="w-px flex-1 bg-border"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@invoice.Description</span>
                                <BadgeCn Variant="@cfg.BadgeVariant" Class="@($"font-normal text-xs {(invoice.Status == InvoiceStatus.Overdue ? "border-amber-500/30 text-amber-600 dark:text-amber-400" : "")}")">
                                    @cfg.Label
                                </BadgeCn>
                            </div>
                            <span class="mt-0.5 block font-mono text-muted-foreground text-xs">
                                @invoice.Number · @invoice.Date
                            </span>
                        </div>

                        @* Amount + chevron *@
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm tabular-nums">$@invoice.Amount</span>
                            <LucideIconCn Name="chevron-right" Size="16" Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                        </div>
                    </button>

                    @* Expanded detail *@
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-13">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="flex items-center justify-between">
                                    <span class="font-medium text-muted-foreground text-xs">Due date</span>
                                    <span class="text-xs">@invoice.DueDate</span>
                                </div>
                                <div class="mt-3 space-y-1.5">
                                    @foreach (var lineItem in invoice.LineItems)
                                    {
                                        <div class="flex items-center justify-between">
                                            <span class="text-sm">@lineItem.Name</span>
                                            <span class="font-mono text-sm tabular-nums">$@lineItem.Amount</span>
                                        </div>
                                    }
                                    <div class="mt-2 flex items-center justify-between border-t pt-2">
                                        <span class="font-medium text-sm">Total</span>
                                        <span class="font-semibold text-sm tabular-nums">$@invoice.Amount</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum InvoiceStatus { Paid, Overdue, Pending }

    private record LineItem(string Name, string Amount);

    private record Invoice(string Id, string Number, string Date, string DueDate, string Amount, InvoiceStatus Status, string Description, LineItem[] LineItems);

    private record StatusConfig(string Dot, BadgeVariant BadgeVariant, string Label, string IconName, string IconClass);

    private string? _expanded = "i2";

    private static readonly Invoice[] _invoices =
    [
        new("i1", "INV-2026-0042", "Mar 24, 2026", "Apr 23, 2026", "2,499.00", InvoiceStatus.Pending,
            "Pro plan — March 2026",
            [new("Pro plan (5 seats)", "1,999.00"), new("Additional storage (50 GB)", "500.00")]),
        new("i2", "INV-2026-0041", "Feb 24, 2026", "Mar 10, 2026", "1,999.00", InvoiceStatus.Overdue,
            "Pro plan — February 2026",
            [new("Pro plan (5 seats)", "1,999.00")]),
        new("i3", "INV-2026-0040", "Jan 24, 2026", "Feb 23, 2026", "1,999.00", InvoiceStatus.Paid,
            "Pro plan — January 2026",
            [new("Pro plan (5 seats)", "1,999.00")]),
        new("i4", "INV-2025-0039", "Dec 24, 2025", "Jan 23, 2026", "2,299.00", InvoiceStatus.Paid,
            "Pro plan — December 2025",
            [new("Pro plan (5 seats)", "1,999.00"), new("API overage (12,000 calls)", "300.00")]),
        new("i5", "INV-2025-0038", "Nov 24, 2025", "Dec 24, 2025", "1,999.00", InvoiceStatus.Paid,
            "Pro plan — November 2025",
            [new("Pro plan (5 seats)", "1,999.00")]),
        new("i6", "INV-2025-0037", "Oct 24, 2025", "Nov 23, 2025", "1,999.00", InvoiceStatus.Paid,
            "Pro plan — October 2025",
            [new("Pro plan (5 seats)", "1,999.00")]),
    ];

    private int _paidCount => Array.FindAll(_invoices, i => i.Status == InvoiceStatus.Paid).Length;
    private int _overdueCount => Array.FindAll(_invoices, i => i.Status == InvoiceStatus.Overdue).Length;
    private int _pendingCount => Array.FindAll(_invoices, i => i.Status == InvoiceStatus.Pending).Length;

    private static StatusConfig GetConfig(InvoiceStatus status) => status switch
    {
        InvoiceStatus.Paid => new("bg-emerald-500", BadgeVariant.Secondary, "Paid", "circle-check", "size-3.5 text-white"),
        InvoiceStatus.Overdue => new("bg-amber-500", BadgeVariant.Outline, "Overdue", "triangle-alert", "size-3.5 text-white"),
        InvoiceStatus.Pending => new("border-2 border-muted-foreground/30 bg-transparent", BadgeVariant.Outline, "Pending", "clock", "size-3.5 text-muted-foreground/40"),
        _ => new("bg-muted", BadgeVariant.Secondary, "Unknown", "circle", "size-3.5")
    };
}
