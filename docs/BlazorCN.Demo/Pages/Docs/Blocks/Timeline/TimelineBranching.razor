@* ============================================================
   Block: timeline-branching
   Title: TimelineBranching
   Description: React timeline that forks into parallel tracks and merges back built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-branching.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Sprint pipeline</span>
                <span class="text-muted-foreground text-xs">
                    @(_preFork.Length + _branches[0].Entries.Length + _branches[1].Entries.Length + _postMerge.Length) tasks
                </span>
            </div>
        </div>

        <div class="px-4 py-4">
            @* Pre-fork entries *@
            <div>
                @foreach (var entry in _preFork)
                {
                    @EntryRow(entry, false, LineColorForStatus(entry.Status))
                }
            </div>

            @* Fork node *@
            <div class="relative flex gap-3">
                <div class="flex flex-col items-center">
                    <div class="relative z-10 flex size-6 shrink-0 items-center justify-center rounded-full border-2 border-foreground/20 bg-muted/50">
                        <LucideIconCn Name="git-branch" Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                </div>
                <div class="flex-1 pt-1">
                    <span class="font-medium text-muted-foreground text-xs">Fork — parallel workstreams</span>
                </div>
            </div>

            @* Diagonal fork lines *@
            <div class="relative ml-2.5 h-6">
                <svg class="absolute inset-0 h-full w-full overflow-visible" preserveAspectRatio="none" aria-hidden="true">
                    <title>Fork connector lines</title>
                    @* Left branch line *@
                    <line x1="0" y1="0" x2="30" y2="24" stroke="currentColor" stroke-width="2" class="text-border" />
                    @* Right branch line *@
                    <line x1="0" y1="0" x2="270" y2="24" stroke="currentColor" stroke-width="2" class="text-border" />
                </svg>
            </div>

            @* Parallel branches *@
            <div class="grid grid-cols-2 gap-4">
                @foreach (var branch in _branches)
                {
                    <div>
                        <div class="mb-3 flex items-center gap-1.5">
                            <span class="size-1.5 rounded-full bg-foreground/40"></span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@branch.Label</BadgeCn>
                        </div>
                        <div class="rounded-md border border-dashed p-3">
                            @for (int i = 0; i < branch.Entries.Length; i++)
                            {
                                var entry = branch.Entries[i];
                                var isLast = i == branch.Entries.Length - 1;
                                @EntryRow(entry, isLast, LineColorForStatus(entry.Status))
                            }
                        </div>
                    </div>
                }
            </div>

            @* Diagonal merge lines *@
            <div class="relative ml-2.5 h-6">
                <svg class="absolute inset-0 h-full w-full overflow-visible" preserveAspectRatio="none" aria-hidden="true">
                    <title>Merge connector lines</title>
                    <line x1="30" y1="0" x2="0" y2="24" stroke="currentColor" stroke-width="2" class="text-border" />
                    <line x1="270" y1="0" x2="0" y2="24" stroke="currentColor" stroke-width="2" class="text-border" />
                </svg>
            </div>

            @* Merge node *@
            <div class="relative flex gap-3">
                <div class="flex flex-col items-center">
                    <div class="relative z-10 flex size-6 shrink-0 items-center justify-center rounded-full border-2 border-foreground/20 bg-muted/50">
                        <LucideIconCn Name="git-merge" Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div class="w-0.5 flex-1 bg-muted-foreground/15"></div>
                </div>
                <div class="flex-1 pb-5 pt-1">
                    <span class="font-medium text-muted-foreground text-xs">Merge — streams converge</span>
                </div>
            </div>

            @* Post-merge entries *@
            <div>
                @for (int i = 0; i < _postMerge.Length; i++)
                {
                    var entry = _postMerge[i];
                    var isLast = i == _postMerge.Length - 1;
                    @EntryRow(entry, isLast, LineColorForStatus(entry.Status))
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum EntryStatus { Done, Active, Pending }

    private record BranchEntry(string Id, string Title, string Description, EntryStatus Status);
    private record BranchData(string Label, BranchEntry[] Entries);

    private static string DotClass(EntryStatus status) => status switch
    {
        EntryStatus.Done    => "border-emerald-500 bg-emerald-500 text-white",
        EntryStatus.Active  => "border-blue-500 bg-blue-500 text-white",
        _                   => "border-muted-foreground/30 bg-card text-muted-foreground/40",
    };

    private static string LineColorForStatus(EntryStatus status) => status switch
    {
        EntryStatus.Done   => "bg-emerald-500/30",
        EntryStatus.Active => "bg-blue-500/30",
        _                  => "bg-muted-foreground/15",
    };

    private static string IconName(EntryStatus status) => status switch
    {
        EntryStatus.Done   => "check-circle-2",
        EntryStatus.Active => "circle-dot",
        _                  => "circle",
    };

    private RenderFragment EntryRow(BranchEntry entry, bool isLast, string lineColor) =>
        @<div class="relative flex gap-3">
            <div class="flex flex-col items-center">
                <div class="@($"relative z-10 flex size-5 shrink-0 items-center justify-center rounded-full border-2 {DotClass(entry.Status)}")">
                    <LucideIconCn Name="@IconName(entry.Status)" Size="12" Class="size-3" />
                </div>
                @if (!isLast)
                {
                    <div class="@($"w-0.5 flex-1 {lineColor}")"></div>
                }
            </div>
            <div class="@($"min-w-0 flex-1 {(isLast ? "pb-0" : "pb-5")} pt-0.5")">
                <span class="font-medium text-sm">@entry.Title</span>
                <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">@entry.Description</p>
            </div>
        </div>;

    private static readonly BranchEntry[] _preFork =
    [
        new("pre1", "Requirements finalized",
            "Product spec reviewed and signed off by all stakeholders. Acceptance criteria locked.",
            EntryStatus.Done),
        new("pre2", "Architecture design approved",
            "System design document passed technical review. Database schema and API contracts agreed.",
            EntryStatus.Done),
    ];

    private static readonly BranchData[] _branches =
    [
        new("Frontend",
        [
            new("fe1", "Component library setup",
                "Scaffold design system with tokens, primitives, and Storybook integration.",
                EntryStatus.Done),
            new("fe2", "Dashboard UI implementation",
                "Build analytics dashboard with charts, tables, and real-time data views.",
                EntryStatus.Active),
            new("fe3", "Responsive polish and a11y audit",
                "Ensure WCAG AA compliance across all breakpoints and screen readers.",
                EntryStatus.Pending),
        ]),
        new("Backend",
        [
            new("be1", "Database migrations and seeding",
                "PostgreSQL schema deployed with seed data for development and staging environments.",
                EntryStatus.Done),
            new("be2", "API endpoints and auth layer",
                "REST and GraphQL endpoints with JWT auth, rate limiting, and input validation.",
                EntryStatus.Done),
            new("be3", "Load testing and optimization",
                "Run k6 load tests targeting 10K concurrent users. Optimize slow queries and add caching.",
                EntryStatus.Active),
        ]),
    ];

    private static readonly BranchEntry[] _postMerge =
    [
        new("post1", "Integration testing",
            "End-to-end tests across frontend and backend. Verify all API contracts and data flows.",
            EntryStatus.Pending),
        new("post2", "Production deployment",
            "Blue-green deploy to production with feature flags. Monitor error rates for 24 hours.",
            EntryStatus.Pending),
    ];
}
