@* ============================================================
   Block: timeline-sprint-board
   Title: TimelineSprintBoard
   Description: React agile sprint planning timeline with story points, burndown progress, and velocity tracking using Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-sprint-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="target" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Sprint board</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="zap" Size="12" Class="size-3" />
                    Avg velocity: @_avgVelocity pts
                </span>
            </div>
        </div>

        @* Sprints timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var sprint in _sprints)
                {
                    var sprintIndex = System.Array.IndexOf(_sprints, sprint);
                    var isLast = sprintIndex == _sprints.Length - 1;
                    var cfg = _statusConfig[sprint.Status];
                    var progress = sprint.TotalPoints > 0
                        ? (int)Math.Round((double)sprint.CompletedPoints / sprint.TotalPoints * 100)
                        : 0;

                    <div class="relative flex gap-4">
                        @* Timeline column *@
                        <div class="flex flex-col items-center">
                            @* Dot *@
                            <div class="@Cn.Merge("relative z-10 flex size-7 shrink-0 items-center justify-center rounded-full border-2", cfg.Dot)">
                                @if (sprint.Status == SprintStatus.Completed)
                                {
                                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-white" />
                                }
                                else if (sprint.Status == SprintStatus.Active)
                                {
                                    <LucideIconCn Name="circle-dot" Size="14" Class="size-3.5 text-white" />
                                    <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                }
                                else
                                {
                                    <LucideIconCn Name="circle" Size="14" Class="size-3.5 text-muted-foreground/40" />
                                }
                            </div>
                            @* Connector *@
                            @if (!isLast)
                            {
                                <div class="@($"w-0.5 flex-1 {cfg.Line}")"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@($"min-w-0 flex-1 {(isLast ? "pb-0" : "pb-6")}")">
                            @* Sprint header *@
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", sprint.Status == SprintStatus.Planned ? "text-muted-foreground" : "")">
                                    @sprint.Name
                                </span>
                                <BadgeCn Variant="BadgeVariant.Secondary"
                                         Class="@Cn.Merge("font-normal text-xs", sprint.Status == SprintStatus.Active ? "border-blue-500/20 bg-blue-500/10 text-blue-600 dark:text-blue-400" : "")">
                                    @(sprint.Status == SprintStatus.Completed ? "Done" : sprint.Status == SprintStatus.Active ? "In progress" : "Planned")
                                </BadgeCn>
                            </div>
                            <span class="mt-0.5 block text-muted-foreground text-xs">@sprint.DateRange</span>

                            @* Goal *@
                            <p class="mt-1.5 text-muted-foreground text-xs">@sprint.Goal</p>

                            @* Points + Progress *@
                            <div class="mt-2.5 flex items-center gap-3">
                                <div class="flex items-center gap-1.5">
                                    <LucideIconCn Name="flame" Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="font-mono text-xs tabular-nums">
                                        @sprint.CompletedPoints<span class="text-muted-foreground">/@sprint.TotalPoints pts</span>
                                    </span>
                                </div>
                                @* Burndown bar *@
                                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="@Cn.Merge("h-full rounded-full transition-all", sprint.Status == SprintStatus.Completed ? "bg-emerald-500" : sprint.Status == SprintStatus.Active ? "bg-blue-500" : "bg-transparent")"
                                         style="@($"width:{progress}%")">
                                    </div>
                                </div>
                                <span class="font-mono text-muted-foreground text-xs tabular-nums">@(progress)%</span>
                            </div>

                            @* Stories *@
                            <div class="mt-2.5 space-y-0">
                                @foreach (var story in sprint.Stories)
                                {
                                    <div class="flex items-center gap-2 py-1">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", story.Done ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                                        <span class="@Cn.Merge("min-w-0 flex-1 truncate text-xs", story.Done ? "text-muted-foreground line-through" : sprint.Status == SprintStatus.Planned ? "text-muted-foreground" : "text-foreground")">
                                            @story.Title
                                        </span>
                                        <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">@story.Points</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum SprintStatus { Completed, Active, Planned }

    private record SprintStory(string Id, string Title, int Points, bool Done);

    private record Sprint(string Id, string Name, string DateRange, SprintStatus Status,
        int TotalPoints, int CompletedPoints, string Goal, SprintStory[] Stories, int? Velocity = null);

    private record StatusConfig(string Dot, string Line);

    private static readonly Dictionary<SprintStatus, StatusConfig> _statusConfig = new()
    {
        [SprintStatus.Completed] = new("bg-emerald-500 border-emerald-500", "bg-emerald-500/30"),
        [SprintStatus.Active]    = new("bg-blue-500 border-blue-500",       "bg-border"),
        [SprintStatus.Planned]   = new("bg-transparent border-muted-foreground/30", "bg-border"),
    };

    private static readonly Sprint[] _sprints =
    [
        new("s1", "Sprint 14", "Feb 3 – Feb 14", SprintStatus.Completed, 34, 34,
            "Complete user authentication overhaul",
            [
                new("st1", "OAuth2 provider integration",  8, true),
                new("st2", "Session management refactor",  5, true),
                new("st3", "MFA enrollment flow",          8, true),
                new("st4", "Password reset redesign",      5, true),
                new("st5", "Auth error handling",          8, true),
            ], 34),
        new("s2", "Sprint 15", "Feb 17 – Feb 28", SprintStatus.Completed, 29, 26,
            "Launch billing dashboard MVP",
            [
                new("st6",  "Invoice list view",            5, true),
                new("st7",  "Payment method management",    8, true),
                new("st8",  "Usage metering display",       5, true),
                new("st9",  "Subscription plan selector",   8, true),
                new("st10", "Export invoice PDF",           3, false),
            ], 26),
        new("s3", "Sprint 16", "Mar 3 – Mar 14", SprintStatus.Active, 31, 18,
            "Team collaboration features",
            [
                new("st11", "Workspace invite system",     5, true),
                new("st12", "Role-based permissions",      8, true),
                new("st13", "Activity feed",               5, true),
                new("st14", "Shared dashboard views",      8, false),
                new("st15", "Comment threads on reports",  5, false),
            ]),
        new("s4", "Sprint 17", "Mar 17 – Mar 28", SprintStatus.Planned, 26, 0,
            "Performance and observability",
            [
                new("st16", "Query optimization pass",     8, false),
                new("st17", "Error tracking integration",  5, false),
                new("st18", "Load testing suite",          5, false),
                new("st19", "API response caching",        8, false),
            ]),
    ];

    private int _avgVelocity = 0;

    protected override void OnInitialized()
    {
        var withVelocity = System.Array.FindAll(_sprints, s => s.Velocity.HasValue);
        if (withVelocity.Length > 0)
        {
            var total = 0;
            foreach (var s in withVelocity) total += s.Velocity!.Value;
            _avgVelocity = (int)Math.Round((double)total / withVelocity.Length);
        }
    }
}
