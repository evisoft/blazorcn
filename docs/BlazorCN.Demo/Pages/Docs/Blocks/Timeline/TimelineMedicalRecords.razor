@* ============================================================
   Block: timeline-medical-records
   Title: TimelineMedicalRecords
   Description: React patient medical history timeline with color-coded events and severity indicators for Next.js healthcare apps using shadcn/ui and Tailwind CSS.
   Source: original/blocks/timeline/timeline-medical-records.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Patient medical history</span>
                <span class="text-muted-foreground text-xs">@_events.Length records</span>
            </div>
        </div>

        @* Summary counts *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="flex size-4 items-center justify-center rounded bg-blue-500/10">
                    <LucideIconCn Name="stethoscope" Size="10" Class="size-2.5 text-blue-600 dark:text-blue-400" />
                </span>
                @(_events.Count(e => e.Type == EventType.Visit)) visits
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="flex size-4 items-center justify-center rounded bg-violet-500/10">
                    <LucideIconCn Name="pill" Size="10" Class="size-2.5 text-violet-600 dark:text-violet-400" />
                </span>
                @(_events.Count(e => e.Type == EventType.Medication)) medications
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="flex size-4 items-center justify-center rounded bg-amber-500/10">
                    <LucideIconCn Name="syringe" Size="10" Class="size-2.5 text-amber-600 dark:text-amber-400" />
                </span>
                @(_events.Count(e => e.Type == EventType.Procedure)) procedures
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="flex size-4 items-center justify-center rounded bg-emerald-500/10">
                    <LucideIconCn Name="flask-conical" Size="10" Class="size-2.5 text-emerald-600 dark:text-emerald-400" />
                </span>
                @(_events.Count(e => e.Type == EventType.Lab)) labs
            </span>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var evt in _events)
                {
                    var index = System.Array.IndexOf(_events, evt);
                    var isLast = index == _events.Length - 1;
                    var isExpanded = _expanded == evt.Id;
                    var evtId = evt.Id;

                    var iconColor = evt.Type == EventType.Medication ? "bg-violet-500/10 text-violet-600 dark:text-violet-400"
                        : evt.Type == EventType.Visit ? "bg-blue-500/10 text-blue-600 dark:text-blue-400"
                        : evt.Type == EventType.Procedure ? "bg-amber-500/10 text-amber-600 dark:text-amber-400"
                        : "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400";

                    var borderColor = evt.Type == EventType.Medication ? "border-violet-500/40"
                        : evt.Type == EventType.Visit ? "border-blue-500/40"
                        : evt.Type == EventType.Procedure ? "border-amber-500/40"
                        : "border-emerald-500/40";

                    var iconName = evt.Type == EventType.Medication ? "pill"
                        : evt.Type == EventType.Visit ? "stethoscope"
                        : evt.Type == EventType.Procedure ? "syringe"
                        : "flask-conical";

                    var severityDotClass = evt.Severity == Severity.Moderate ? "bg-amber-500"
                        : evt.Severity == Severity.Urgent ? "bg-red-500"
                        : "bg-muted-foreground/30";

                    var severityLabel = evt.Severity == Severity.Moderate ? "Moderate"
                        : evt.Severity == Severity.Urgent ? "Urgent"
                        : "Routine";

                    var typeLabel = evt.Type == EventType.Medication ? "Medication"
                        : evt.Type == EventType.Visit ? "Visit"
                        : evt.Type == EventType.Procedure ? "Procedure"
                        : "Lab result";

                    var chevronClass = isExpanded
                        ? "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 rotate-90"
                        : "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200";

                    <div class="relative flex gap-4">
                        @* Timeline column: icon node + connector line *@
                        <div class="flex flex-col items-center">
                            @* Icon node *@
                            <div class="@Cn.Merge("relative z-10 flex size-8 shrink-0 items-center justify-center rounded-full border-2 bg-card", iconColor, borderColor)">
                                <LucideIconCn Name="@iconName" Size="14" Class="size-3.5" />
                                @* Severity indicator dot *@
                                @if (evt.Severity != Severity.Routine)
                                {
                                    <span class="@Cn.Merge("absolute -top-0.5 -right-0.5 size-2 rounded-full ring-2 ring-card", severityDotClass)"></span>
                                }
                            </div>
                            @* Connector line *@
                            @if (!isLast)
                            {
                                <div class="w-px flex-1 bg-border"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@Cn.Merge("min-w-0 flex-1 pt-0.5", isLast ? "pb-0" : "pb-5")">
                            <button type="button"
                                    @onclick="@(() => SetExpanded(evtId, isExpanded))"
                                    class="-mx-2 flex w-[calc(100%+16px)] items-center gap-2 rounded-md px-2 py-1 text-left transition-colors hover:bg-muted/50">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="font-medium text-sm">@evt.Title</span>
                                        @if (evt.Severity != Severity.Routine)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                                <span class="@Cn.Merge("mr-1 inline-block size-1.5 rounded-full", severityDotClass)"></span>
                                                @severityLabel
                                            </BadgeCn>
                                        }
                                    </div>
                                    <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                        <span>@evt.Date</span>
                                        <span>·</span>
                                        <span>@evt.Time</span>
                                        <span>·</span>
                                        <span>@evt.Provider</span>
                                    </div>
                                </div>
                                <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                            </button>

                            @if (isExpanded)
                            {
                                <div class="mt-2 rounded-md bg-muted/50 p-3">
                                    <div class="mb-1.5 flex items-center gap-2">
                                        <span class="font-medium text-muted-foreground text-xs">@typeLabel</span>
                                        @if (evt.Location != null)
                                        {
                                            <span class="text-muted-foreground/40 text-xs">·</span>
                                            <span class="text-muted-foreground text-xs">@evt.Location</span>
                                        }
                                    </div>
                                    <p class="text-sm leading-relaxed">@evt.Notes</p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum EventType { Medication, Visit, Procedure, Lab }
    private enum Severity { Routine, Moderate, Urgent }

    private record MedicalEvent(
        string Id,
        string Date,
        string Time,
        EventType Type,
        Severity Severity,
        string Title,
        string Provider,
        string Notes,
        string? Location = null
    );

    private static readonly MedicalEvent[] _events =
    [
        new("e1", "Mar 18, 2026", "2:30 PM", EventType.Visit, Severity.Urgent,
            "Emergency department visit", "Dr. Sarah Chen",
            "Presented with acute chest pain. ECG normal, troponin negative. Diagnosed with costochondritis. Prescribed NSAIDs and follow-up in one week.",
            "City General Hospital"),
        new("e2", "Mar 18, 2026", "4:15 PM", EventType.Medication, Severity.Routine,
            "Naproxen 500mg prescribed", "Dr. Sarah Chen",
            "Take twice daily with food for 7 days. Monitor for GI side effects. Avoid concurrent aspirin use."),
        new("e3", "Mar 12, 2026", "9:00 AM", EventType.Lab, Severity.Moderate,
            "Comprehensive metabolic panel", "Quest Diagnostics",
            "Elevated fasting glucose at 118 mg/dL, borderline high. All other values within normal range. HbA1c recommended for follow-up."),
        new("e4", "Mar 5, 2026", "11:30 AM", EventType.Procedure, Severity.Routine,
            "Annual flu vaccination", "Nurse Amy Park",
            "Quadrivalent influenza vaccine administered in left deltoid. No adverse reaction observed during 15-minute observation period.",
            "Valley Health Clinic"),
        new("e5", "Feb 20, 2026", "10:00 AM", EventType.Visit, Severity.Routine,
            "Annual physical examination", "Dr. James Okafor",
            "BP 122/78, BMI 24.3, all vitals within normal limits. Routine bloodwork ordered. Continue current medications. Next annual visit in 12 months.",
            "Valley Health Clinic"),
        new("e6", "Feb 10, 2026", "8:30 AM", EventType.Medication, Severity.Routine,
            "Lisinopril 10mg refill", "Dr. James Okafor",
            "90-day supply. Continue once daily in the morning. Blood pressure stable at current dose. Next refill due May 2026."),
        new("e7", "Jan 15, 2026", "3:00 PM", EventType.Procedure, Severity.Moderate,
            "Skin lesion biopsy", "Dr. Lisa Huang",
            "Punch biopsy of suspicious mole on right forearm. Specimen sent to pathology. Results expected in 5-7 business days. Keep site clean and dry.",
            "Dermatology Associates"),
    ];

    private string? _expanded = "e1";

    private void SetExpanded(string id, bool isCurrentlyExpanded)
    {
        _expanded = isCurrentlyExpanded ? null : id;
    }
}
