@* ============================================================
   Block: timeline-gradient-cards
   Title: TimelineGradientCards
   Description: React timeline component with alternating gradient cards and connecting lines using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-gradient-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Company journey</span>
                <span class="text-muted-foreground text-xs">2021 - 2026</span>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                From garage prototype to global platform
            </p>
        </div>

        @* Timeline with gradient cards *@
        <div class="relative px-4 py-4">
            @* Connecting line *@
            <div class="absolute top-4 bottom-4 left-[27px] w-px bg-foreground/10"></div>

            <div class="space-y-2">
                @foreach (var chapter in _chapters)
                {
                    var chapterId = chapter.Id;
                    var isExpanded = _expanded == chapter.Id;
                    var index = System.Array.IndexOf(_chapters, chapter);
                    var isEven = index % 2 == 0;
                    var gradientClass = isEven
                        ? "min-w-0 flex-1 rounded-md p-3 bg-gradient-to-r from-muted/50 to-transparent"
                        : "min-w-0 flex-1 rounded-md p-3 bg-gradient-to-l from-muted/50 to-transparent";
                    var chevronClass = isExpanded
                        ? "mt-0.5 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 rotate-90"
                        : "mt-0.5 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200";

                    <div class="relative">
                        @* Entry with gradient card *@
                        <div class="flex gap-4">
                            @* Dot on the line *@
                            <div class="relative z-10 mt-3 flex shrink-0 items-start">
                                <div class="size-2.5 rounded-full border-2 border-foreground/20 bg-card"></div>
                            </div>

                            @* Gradient card *@
                            <div class="@gradientClass">
                                <button type="button"
                                        @onclick="@(() => SetExpanded(chapterId, isExpanded))"
                                        class="flex w-full items-start gap-2 text-left">
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="font-medium text-sm">@chapter.Title</span>
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@chapter.Category</BadgeCn>
                                        </div>
                                        <p class="mt-0.5 text-muted-foreground text-xs">@chapter.Headline</p>
                                        <div class="mt-1 flex items-center gap-1.5">
                                            <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground/60" />
                                            <span class="font-mono text-muted-foreground text-xs">@chapter.Year</span>
                                        </div>
                                    </div>
                                    <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="mt-2 space-y-2">
                                        <p class="text-muted-foreground text-sm leading-relaxed">@chapter.Description</p>
                                        @if (chapter.Highlight != null)
                                        {
                                            <div class="inline-flex items-center gap-1.5 rounded-md bg-muted/50 px-2 py-1">
                                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                                <span class="font-medium text-xs">@chapter.Highlight</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Chapter(string Id, string Year, string Title, string Headline, string Description, string Category, string? Highlight);

    private static readonly Chapter[] _chapters =
    [
        new("c1", "2021", "Founded in a garage", "Two engineers, one idea, zero funding",
            "Started as a weekend project between two former colleagues frustrated with existing developer tooling. Built the first prototype in 6 weeks using Next.js and a single PostgreSQL instance. Launched on Hacker News and hit the front page within 3 hours.",
            "Origin", "Front page HN on day one"),
        new("c2", "2022", "First paying customers", "From open source to revenue",
            "Crossed 10,000 GitHub stars and converted 2% of active users to a paid tier. Introduced team features, SSO, and audit logs. Revenue hit $18K MRR by December. Hired the first two full-time employees — a designer and a backend engineer.",
            "Growth", "$18K MRR by year end"),
        new("c3", "2023", "Seed round and team expansion", "Raised $4.2M to accelerate",
            "Closed a seed round led by Founders Fund with participation from 8 angel investors including senior engineers from Vercel and Stripe. Grew the team to 12 people. Opened a small office in San Francisco while keeping a remote-first culture.",
            "Funding", "$4.2M seed round"),
        new("c4", "2024", "Enterprise product launch", "Landing Fortune 500 accounts",
            "Shipped the enterprise tier with SCIM provisioning, custom SLAs, dedicated infrastructure, and compliance certifications. Signed 14 enterprise contracts in the first quarter. Average deal size reached $48K annually.",
            "Product", "14 enterprise deals in Q1"),
        new("c5", "2025", "AI-native platform pivot", "Rebuilding around intelligence",
            "Integrated LLM capabilities into every surface of the product. Natural language querying, automated code review, and predictive analytics became core features. User engagement increased 3.4x within 60 days of the AI release.",
            "Innovation", "3.4x engagement lift"),
        new("c6", "2026", "Series A and global expansion", "Scaling to new markets",
            "Raised $28M Series A to fund international expansion. Opened offices in London and Tokyo. Launched localized versions in 6 languages. Platform now serves 12,000 teams across 84 countries with 99.99% uptime.",
            "Expansion", "$28M Series A"),
    ];

    private string? _expanded = "c4";

    private void SetExpanded(string id, bool isCurrentlyExpanded)
    {
        _expanded = isCurrentlyExpanded ? null : id;
    }
}
