@* ============================================================
   Block: timeline-photo-album
   Title: TimelinePhotoAlbum
   Description: React photo memory timeline with alternating image layouts using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-photo-album.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="camera" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Photo memories</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_memories.Length moments
                </BadgeCn>
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-6">
            <div class="relative">
                @* Center spine *@
                <div class="absolute top-0 bottom-0 left-1/2 w-px -translate-x-1/2 bg-border" />

                @foreach (var (memory, index) in _memories.Select((m, i) => (m, i)))
                {
                    var isLeft = index % 2 == 0;
                    var isLast = index == _memories.Length - 1;

                    <div class="@Cn.Merge("relative flex items-start", isLast ? "" : "mb-10")">
                        @* Left side *@
                        <div class="w-[calc(50%-16px)]">
                            @if (isLeft)
                            {
                                <div class="pr-4">
                                    @* Image placeholder *@
                                    <div class="aspect-video w-full rounded-md bg-muted"></div>
                                    <div class="mt-2 text-right">
                                        <span class="font-medium text-sm">@memory.Caption</span>
                                        <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                                            @memory.Description
                                        </p>
                                        <div class="mt-1.5 flex items-center justify-end gap-1.5">
                                            <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-muted-foreground/60" />
                                            <span class="text-muted-foreground text-xs">@memory.Location</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (!isLeft)
                            {
                                <div class="flex h-full items-start justify-end pr-4 pt-1">
                                    <span class="font-medium text-muted-foreground text-xs">
                                        @memory.Date
                                    </span>
                                </div>
                            }
                        </div>

                        @* Center dot *@
                        <div class="relative z-10 flex w-8 shrink-0 items-start justify-center">
                            <div class="flex size-6 items-center justify-center rounded-full border-2 border-muted-foreground/20 bg-card">
                                <span class="size-2 rounded-full bg-muted-foreground/40"></span>
                            </div>
                        </div>

                        @* Right side *@
                        <div class="w-[calc(50%-16px)]">
                            @if (!isLeft)
                            {
                                <div class="pl-4">
                                    @* Image placeholder *@
                                    <div class="aspect-video w-full rounded-md bg-muted"></div>
                                    <div class="mt-2">
                                        <span class="font-medium text-sm">@memory.Caption</span>
                                        <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                                            @memory.Description
                                        </p>
                                        <div class="mt-1.5 flex items-center gap-1.5">
                                            <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-muted-foreground/60" />
                                            <span class="text-muted-foreground text-xs">@memory.Location</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (isLeft)
                            {
                                <div class="flex h-full items-start pl-4 pt-1">
                                    <span class="font-medium text-muted-foreground text-xs">
                                        @memory.Date
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Memory(string Id, string Date, string Caption, string Location, string Description);

    private static readonly Memory[] _memories =
    [
        new("m1", "Mar 15, 2026", "Cherry blossoms in full bloom", "Kyoto, Japan",
            "Morning walk through the Philosopher's Path. The sakura canopy was at peak bloom, petals drifting onto the canal surface like pink confetti."),
        new("m2", "Feb 28, 2026", "Summit at golden hour", "Dolomites, Italy",
            "Reached the Tre Cime di Lavaredo viewpoint just as the sun dipped behind the peaks. The rock faces turned amber for exactly twelve minutes."),
        new("m3", "Jan 12, 2026", "First snow of the season", "Reykjavik, Iceland",
            "The city woke up under a thick blanket of snow. Hallgrimskirkja looked otherworldly against the slate-gray sky. Coffee at Reykjavik Roasters."),
        new("m4", "Dec 1, 2025", "Street market at dusk", "Marrakech, Morocco",
            "Jemaa el-Fnaa square coming alive as the sun set. Smoke from food stalls mixed with the sound of Gnawa musicians. Bought handwoven textiles."),
        new("m5", "Oct 18, 2025", "Autumn vineyard walk", "Napa Valley, California",
            "The vines had turned deep crimson and gold. Tasted the 2023 reserve cabernet at the hilltop estate. Light was perfect for portraits."),
        new("m6", "Aug 24, 2025", "Kayaking through sea caves", "Algarve, Portugal",
            "Paddled into the Benagil cave at low tide. Sunlight poured through the collapsed ceiling onto turquoise water. Completely surreal."),
    ];
}
