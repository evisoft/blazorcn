@* ============================================================
   Block: timeline-grouped-by-date
   Title: TimelineGroupedByDate
   Description: React timeline with date-grouped entries and section headers using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-grouped-by-date.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Activity log</span>
            </div>
            <span class="text-muted-foreground text-xs">@_totalEntries events</span>
        </div>

        @* Grouped timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var grp in _dateGroups)
                {
                    var groupIndex = System.Array.IndexOf(_dateGroups, grp);
                    var isLastGroup = groupIndex == _dateGroups.Length - 1;

                    <div>
                        @* Date header with timeline connector *@
                        <div class="relative flex gap-4">
                            <div class="flex flex-col items-center">
                                <div class="relative z-10 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border-2 border-foreground/20 bg-muted/50">
                                    <span class="font-mono text-[9px] font-semibold text-muted-foreground">@grp.Entries.Length</span>
                                </div>
                                <div class="w-0.5 flex-1 bg-border"></div>
                            </div>
                            <div class="flex-1 pb-3 pt-0.5">
                                <span class="font-medium text-sm">@grp.Label</span>
                                <span class="ml-2 text-muted-foreground text-xs">@grp.Entries.Length @(grp.Entries.Length == 1 ? "event" : "events")</span>
                            </div>
                        </div>

                        @* Entries within group *@
                        @foreach (var entry in grp.Entries)
                        {
                            var entryIndex = System.Array.IndexOf(grp.Entries, entry);
                            var isLastEntry = entryIndex == grp.Entries.Length - 1;
                            var isGlobalLast = isLastGroup && isLastEntry;
                            var cat = _categoryConfig[entry.Category];
                            var dotClass = _statusDot[entry.Status];
                            var lineClass = isLastEntry ? "bg-border" : _lineColor[entry.Status];
                            var contentPb = isGlobalLast ? "pb-0" : "pb-5";

                            <div class="relative flex gap-4">
                                @* Line + Dot *@
                                <div class="flex flex-col items-center">
                                    <div class="@($"relative z-10 flex size-5 shrink-0 items-center justify-center rounded-full border-2 {dotClass}")">
                                        @if (entry.Status == EntryStatus.Completed)
                                        {
                                            <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-white" />
                                        }
                                        else if (entry.Status == EntryStatus.Current)
                                        {
                                            <LucideIconCn Name="circle-dot" Size="12" Class="size-3 text-white" />
                                            <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="circle" Size="12" Class="size-3 text-muted-foreground/40" />
                                        }
                                    </div>
                                    @if (!isGlobalLast)
                                    {
                                        <div class="@($"w-0.5 flex-1 {lineClass}")"></div>
                                    }
                                </div>

                                @* Content *@
                                <div class="@($"min-w-0 flex-1 {contentPb} pt-0")">
                                    <div class="flex items-center gap-2">
                                        <span class="font-medium text-sm">@entry.Title</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                                            <LucideIconCn Name="@cat.IconName" Size="12" Class="size-3" />
                                            @cat.Label
                                        </BadgeCn>
                                    </div>
                                    <div class="mt-0.5 flex items-center gap-2">
                                        <span class="font-mono text-muted-foreground text-xs">@entry.Time</span>
                                        <span class="text-muted-foreground text-xs">·</span>
                                        <span class="truncate text-muted-foreground text-xs">@entry.Description</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum EntryStatus { Completed, Current, Upcoming }
    private enum EntryCategory { Deploy, Review, Security, Team, Feature, Bugfix, Config }

    private record TimelineEntry(string Id, string Time, string Title, string Description, EntryStatus Status, EntryCategory Category);
    private record DateGroup(string Label, TimelineEntry[] Entries);
    private record CategoryInfo(string IconName, string Label);

    private static readonly System.Collections.Generic.Dictionary<EntryCategory, CategoryInfo> _categoryConfig = new()
    {
        [EntryCategory.Deploy]   = new("zap",              "Deploy"),
        [EntryCategory.Review]   = new("git-pull-request", "Review"),
        [EntryCategory.Security] = new("shield",           "Security"),
        [EntryCategory.Team]     = new("users",            "Team"),
        [EntryCategory.Feature]  = new("code",             "Feature"),
        [EntryCategory.Bugfix]   = new("bug",              "Bugfix"),
        [EntryCategory.Config]   = new("settings",         "Config"),
    };

    private static readonly System.Collections.Generic.Dictionary<EntryStatus, string> _statusDot = new()
    {
        [EntryStatus.Completed] = "border-emerald-500 bg-emerald-500",
        [EntryStatus.Current]   = "border-blue-500 bg-blue-500",
        [EntryStatus.Upcoming]  = "border-muted-foreground/30 bg-transparent",
    };

    private static readonly System.Collections.Generic.Dictionary<EntryStatus, string> _lineColor = new()
    {
        [EntryStatus.Completed] = "bg-emerald-500/30",
        [EntryStatus.Current]   = "bg-gradient-to-b from-blue-500/30 to-emerald-500/30",
        [EntryStatus.Upcoming]  = "bg-muted-foreground/15",
    };

    private static readonly DateGroup[] _dateGroups =
    [
        new("Today", [
            new("t1", "2:45 PM",  "Production deployment v3.8.2",         "Hotfix for payment webhook timeout. Deployed to all 6 regions with zero-downtime rolling update.",                                          EntryStatus.Current,   EntryCategory.Deploy),
            new("t2", "11:20 AM", "Pull request #847 merged",              "Refactored subscription billing logic to handle mid-cycle plan changes with prorated credits.",                                              EntryStatus.Completed, EntryCategory.Review),
            new("t3", "9:05 AM",  "Security advisory CVE-2026-1234 patched","Updated dependency chain for OpenSSL vulnerability. No user data was exposed.",                                                             EntryStatus.Completed, EntryCategory.Security),
        ]),
        new("Yesterday", [
            new("y1", "5:30 PM",  "Team standup notes published",          "Sprint 18 midpoint check-in. 14 of 21 story points completed. On track for Friday delivery.",                                              EntryStatus.Completed, EntryCategory.Team),
            new("y2", "3:15 PM",  "Feature flag enabled: dark mode v2",    "Rolled out to 25% of users for A/B testing. Monitoring engagement and error rates for 48 hours.",                                           EntryStatus.Completed, EntryCategory.Feature),
            new("y3", "10:40 AM", "Bug fix: CSV export truncation",        "Exports with more than 10,000 rows were silently truncated. Increased buffer size and added row count validation.",                          EntryStatus.Completed, EntryCategory.Bugfix),
        ]),
        new("March 22", [
            new("m1", "4:00 PM",  "Infrastructure config update",          "Increased Redis cluster from 3 to 5 nodes. Connection pool limit raised to 500 per service.",                                               EntryStatus.Completed, EntryCategory.Config),
            new("m2", "1:30 PM",  "Production deployment v3.8.0",          "Major release with workspace collaboration, real-time cursors, and comment threads. 42 PRs included.",                                      EntryStatus.Completed, EntryCategory.Deploy),
            new("m3", "9:00 AM",  "New team member onboarding",            "Alex Chen joined the platform team. Access provisioned to staging, CI/CD, and monitoring dashboards.",                                      EntryStatus.Completed, EntryCategory.Team),
        ]),
        new("March 20", [
            new("o1", "6:15 PM",  "Load test results published",           "Sustained 8,200 concurrent users with p99 latency under 200ms. Database connection pooling held steady.",                                   EntryStatus.Completed, EntryCategory.Feature),
            new("o2", "11:00 AM", "Pull request #831 merged",              "Added rate limiting middleware to all public API endpoints. 100 requests per minute per API key.",                                           EntryStatus.Completed, EntryCategory.Review),
        ]),
    ];

    private int _totalEntries => _dateGroups.Sum(g => g.Entries.Length);
}
