@* ============================================================
   Block: timeline-horizontal-cards
   Title: TimelineHorizontalCards
   Description: React horizontal timeline with hanging card entries connected by vertical lines using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-horizontal-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="git-branch" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Release Timeline</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">@_releases.Length releases</span>
            <div class="ml-auto flex items-center gap-2">
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="tag" Size="12" Class="size-3" />
                    Latest: @_releases[_releases.Length - 1].Version
                </span>
            </div>
        </div>

        @* Timeline *@
        <div class="overflow-x-auto">
            <div class="min-w-[800px] px-6 pt-6 pb-6">
                @* Horizontal rail *@
                <div class="relative">
                    <div class="absolute top-0 right-0 left-0 h-0.5 rounded-full bg-border"></div>

                    @* Entries *@
                    <div class="flex justify-between">
                        @foreach (var rel in _releases)
                        {
                            var release = rel;
                            var tagClass = GetTagClass(release.Tag);
                            <div class="flex flex-col items-center">
                                @* Dot on rail *@
                                <div class="relative z-10 -mt-[5px] size-2.5 rounded-full bg-foreground"></div>

                                @* Vertical connector *@
                                <div class="h-5 w-px bg-border"></div>

                                @* Card *@
                                <div class="w-44 rounded-md border bg-card p-3">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono font-medium text-sm">@release.Version</span>
                                        <BadgeCn Class="@($"h-4 px-1.5 text-[10px] {tagClass}")">
                                            @release.Tag
                                        </BadgeCn>
                                    </div>
                                    <p class="mt-1.5 font-medium text-sm">@release.Title</p>
                                    <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                                        @release.Description
                                    </p>
                                    <span class="mt-2 block text-muted-foreground text-xs">
                                        @release.Date
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private enum ReleaseTag { Major, Minor, Patch }

    private record Release(string Id, string Version, string Date, string Title, string Description, ReleaseTag Tag);

    private static string GetTagClass(ReleaseTag tag) => tag switch
    {
        ReleaseTag.Major => "bg-foreground text-background",
        ReleaseTag.Minor => "bg-secondary text-secondary-foreground",
        ReleaseTag.Patch => "bg-muted text-muted-foreground",
        _ => ""
    };

    private static readonly Release[] _releases =
    [
        new("r1", "v1.0", "Jan 15, 2025", "Initial Release",
            "Core platform launch with authentication, dashboard, and API endpoints.",
            ReleaseTag.Major),
        new("r2", "v1.1", "Mar 8, 2025", "Team Collaboration",
            "Workspace sharing, role-based permissions, and real-time presence indicators.",
            ReleaseTag.Minor),
        new("r3", "v1.2", "May 20, 2025", "Analytics Dashboard",
            "Usage metrics, funnel visualization, and exportable CSV reports.",
            ReleaseTag.Minor),
        new("r4", "v2.0", "Aug 1, 2025", "Platform Redesign",
            "Rebuilt UI with new design system, improved navigation, and dark mode support.",
            ReleaseTag.Major),
        new("r5", "v2.1", "Oct 12, 2025", "AI Integration",
            "Smart suggestions, automated tagging, and natural language search powered by LLMs.",
            ReleaseTag.Minor),
    ];
}
