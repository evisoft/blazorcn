@* ============================================================
   Block: timeline-company-history
   Title: TimelineCompanyHistory
   Description: React company history timeline with year markers and metrics, built with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-company-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="building" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Our journey</span>
            </div>
            <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">
                From two engineers in a co-working space to a publicly traded company serving 50,000+
                teams worldwide. Here are the milestones that defined us.
            </p>
        </div>

        @* Summary stats *@
        <div class="grid grid-cols-4 border-b">
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Founded</span>
                <span class="mt-0.5 block font-semibold text-lg tabular-nums">2018</span>
            </div>
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Team size</span>
                <span class="mt-0.5 block font-semibold text-lg tabular-nums">380</span>
            </div>
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Total raised</span>
                <span class="mt-0.5 block font-semibold text-lg tabular-nums">$371M</span>
            </div>
            <div class="px-4 py-3">
                <span class="block text-muted-foreground text-xs">ARR</span>
                <span class="mt-0.5 block font-semibold text-lg tabular-nums">$142M</span>
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-6">
            <div class="relative">
                @{
                    var lastYear = "";
                }
                @foreach (var ms in _milestones)
                {
                    var milestone = ms;
                    var isLast = milestone.Id == _milestones[_milestones.Length - 1].Id;
                    var showYear = milestone.Year != lastYear;
                    lastYear = milestone.Year;
                    var cfg = GetTypeConfig(milestone.Type);

                    @* Year marker *@
                    @if (showYear)
                    {
                        <div class="relative flex gap-4">
                            <div class="flex flex-col items-center">
                                <div class="relative z-10 flex h-8 items-center justify-center rounded-full border bg-card px-3">
                                    <span class="font-semibold text-sm tabular-nums">@milestone.Year</span>
                                </div>
                                <div class="w-px flex-1 bg-border" style="min-height:12px"></div>
                            </div>
                            <div class="pb-3 pt-1.5"></div>
                        </div>
                    }

                    @* Milestone *@
                    <div class="relative flex gap-4">
                        @* Dot column *@
                        <div class="flex flex-col items-center">
                            <div class="@($"relative z-10 flex size-8 shrink-0 items-center justify-center rounded-full border-2 {cfg.Color}")">
                                <LucideIconCn Name="@cfg.IconName" Size="14" Class="size-3.5" />
                            </div>
                            @if (!isLast)
                            {
                                <div class="w-px flex-1 bg-border"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@($"min-w-0 flex-1 {(isLast ? "pb-0" : "pb-8")}")">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@milestone.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    @milestone.Month @milestone.Year
                                </BadgeCn>
                            </div>

                            <p class="mt-2 text-sm leading-relaxed">@milestone.Description</p>

                            <p class="mt-2 text-muted-foreground text-xs italic leading-relaxed">@milestone.Significance</p>

                            @* Metrics *@
                            @if (milestone.Metrics != null && milestone.Metrics.Length > 0)
                            {
                                <div class="mt-3 flex gap-2">
                                    @foreach (var met in milestone.Metrics)
                                    {
                                        var metric = met;
                                        <div class="rounded-md bg-muted/50 px-3 py-2">
                                            <span class="block text-muted-foreground text-xs">@metric.Label</span>
                                            <span class="mt-0.5 block font-semibold text-lg tabular-nums">@metric.Value</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t bg-muted/20 px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="user-plus" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-sm">Want to be part of the next chapter?</span>
                <span class="font-medium text-sm">We're hiring.</span>
            </div>
        </div>
    </div>
</section>

@code {
    private enum MilestoneType { Founding, Growth, Funding, Product, Expansion, Ipo }

    private record MilestoneMetric(string Label, string Value);

    private record Milestone(
        string Id,
        string Year,
        string Month,
        string Title,
        MilestoneType Type,
        string Description,
        string Significance,
        MilestoneMetric[]? Metrics = null);

    private record TypeConfig(string IconName, string Color);

    private static TypeConfig GetTypeConfig(MilestoneType type) => type switch
    {
        MilestoneType.Founding  => new("flag",        "border-foreground bg-foreground text-background"),
        MilestoneType.Growth    => new("users",        "border-emerald-500 bg-emerald-500 text-white"),
        MilestoneType.Funding   => new("trending-up",  "border-blue-500 bg-blue-500 text-white"),
        MilestoneType.Product   => new("rocket",       "border-amber-500 bg-amber-500 text-white"),
        MilestoneType.Expansion => new("globe",        "border-purple-500 bg-purple-500 text-white"),
        MilestoneType.Ipo       => new("sparkles",     "border-foreground bg-foreground text-background"),
        _                       => new("circle",       "border-muted-foreground bg-muted-foreground text-white"),
    };

    private static readonly Milestone[] _milestones =
    [
        new("m1", "2018", "March", "Company founded", MilestoneType.Founding,
            "Two engineers left their roles at a Fortune 500 to build developer tools that actually respect the developer experience. Started in a co-working space in San Francisco with $50K in personal savings.",
            "The founding vision was simple: make infrastructure invisible so developers can focus on building products.",
            [
                new("Team", "2"),
                new("Funding", "$50K"),
            ]),
        new("m2", "2019", "January", "First paying customer", MilestoneType.Growth,
            "After 10 months of building in stealth, signed the first paying customer: a 15-person startup that needed a better way to manage deployments. Revenue: $299/month.",
            "Validated the core hypothesis that developers would pay for a simpler deployment experience.",
            [
                new("MRR", "$299"),
                new("Customers", "1"),
                new("Team", "4"),
            ]),
        new("m3", "2019", "September", "Seed round: $3.2M", MilestoneType.Funding,
            "Raised a $3.2M seed round led by Sequoia Scout with participation from angel investors including former CTO of Heroku. Oversubscribed 2x in 3 weeks.",
            "Capital to hire the first dedicated engineering team and build out the platform beyond MVP.",
            [
                new("Raised", "$3.2M"),
                new("MRR", "$8.4K"),
                new("Team", "8"),
            ]),
        new("m4", "2020", "June", "Platform v2.0 launched", MilestoneType.Product,
            "Complete platform rewrite with a new CLI, dashboard, and GitHub integration. Introduced preview deployments, automatic HTTPS, and edge functions. Featured on Hacker News front page for 18 hours.",
            "The v2 launch was the inflection point. Organic signups jumped 12x in the first month.",
            [
                new("MRR", "$42K"),
                new("Users", "2,800"),
                new("Team", "22"),
            ]),
        new("m5", "2021", "February", "Series A: $28M", MilestoneType.Funding,
            "Raised $28M Series A led by Andreessen Horowitz. Valuation: $180M pre-money. Funds allocated to engineering (60%), go-to-market (25%), and operations (15%).",
            "Series A gave us the runway to hire aggressively and expand the product surface area.",
            [
                new("Raised", "$28M"),
                new("ARR", "$2.1M"),
                new("Team", "45"),
            ]),
        new("m6", "2022", "August", "100 employees milestone", MilestoneType.Growth,
            "Crossed 100 employees across 14 countries. Fully remote since founding. Opened optional hub offices in San Francisco and London for team members who prefer in-person collaboration.",
            "Proved that a fully distributed team can build a world-class product without a central HQ.",
            [
                new("Team", "104"),
                new("Countries", "14"),
                new("ARR", "$18M"),
            ]),
        new("m7", "2023", "November", "European expansion", MilestoneType.Expansion,
            "Opened EU data centers in Frankfurt and Amsterdam. Achieved GDPR compliance certification. Signed first EU enterprise contracts with 3 Fortune 500 companies headquartered in Europe.",
            "International expansion doubled our addressable market and unlocked the enterprise segment.",
            [
                new("ARR", "$52M"),
                new("Enterprise", "38"),
                new("Regions", "3"),
            ]),
        new("m8", "2025", "October", "IPO on NASDAQ", MilestoneType.Ipo,
            "Went public on NASDAQ at $42 per share, raising $340M. Market cap: $4.2B on first day of trading. The stock opened 34% above IPO price. All early employees retained through a 6-month lockup.",
            "From two engineers in a co-working space to a public company in 7 years. The developer-first thesis was right.",
            [
                new("Market cap", "$4.2B"),
                new("ARR", "$142M"),
                new("Team", "380"),
            ]),
    ];
}
