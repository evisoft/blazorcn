@* ============================================================
   Block: timeline-flight-tracker
   Title: TimelineFlightTracker
   Description: React flight itinerary timeline with airport codes, layovers, and journey progress using Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-flight-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="font-semibold text-lg tabular-nums tracking-tight">
                    @_departure?.AirportCode
                </span>
                <div class="flex items-center gap-1.5 text-muted-foreground">
                    <div class="h-px w-6 bg-border"></div>
                    <LucideIconCn Name="plane" Size="14" Class="size-3.5 rotate-45" />
                    <div class="h-px w-6 bg-border"></div>
                </div>
                <span class="font-semibold text-lg tabular-nums tracking-tight">
                    @_arrival?.AirportCode
                </span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                1 stop
            </BadgeCn>
        </div>

        @* Route summary *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <span class="text-muted-foreground text-xs">@_departure?.City</span>
            <span class="text-muted-foreground/40 text-xs">→</span>
            <span class="text-muted-foreground text-xs">@_arrival?.City</span>
            <div class="ml-auto flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                <span class="tabular-nums">9h 35m total</span>
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @for (int i = 0; i < _segments.Length; i++)
                {
                    var seg = _segments[i];
                    var isLast = i == _segments.Length - 1;

                    if (seg.Type == SegmentType.Flight)
                    {
                        var planeClass = seg.Status == SegmentStatus.Upcoming
                            ? "text-muted-foreground/50"
                            : "text-foreground";
                        var lineClass = seg.Status == SegmentStatus.Upcoming
                            ? "w-px flex-1 border-l border-dashed border-border bg-transparent"
                            : $"w-px flex-1 {StatusLine(seg.Status)}";
                        <div class="relative flex gap-3 pb-4">
                            @* Line column *@
                            <div class="flex w-[19px] shrink-0 flex-col items-center">
                                <div class="@lineClass"></div>
                            </div>
                            @* Flight info *@
                            <div class="flex flex-1 items-center gap-3 rounded-md bg-muted/50 px-3 py-2.5">
                                <LucideIconCn Name="plane" Size="14" Class="@($"size-3.5 rotate-45 {planeClass}")" />
                                <div class="flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono font-medium text-sm">@seg.FlightNumber</span>
                                        <span class="text-muted-foreground text-xs">@seg.Airline</span>
                                    </div>
                                </div>
                                <span class="font-mono text-muted-foreground text-xs tabular-nums">@seg.Duration</span>
                            </div>
                        </div>
                    }
                    else if (seg.Type == SegmentType.Layover)
                    {
                        <div class="relative flex gap-3 pb-4">
                            @* Line column with layover dot *@
                            <div class="flex w-[19px] shrink-0 flex-col items-center">
                                <div class="w-px flex-1 bg-foreground/10"></div>
                                <div class="relative z-10 my-0.5 flex size-5 items-center justify-center">
                                    <span class="size-2 rounded-full bg-amber-500"></span>
                                    @if (seg.Status == SegmentStatus.Active)
                                    {
                                        <span class="absolute inset-0 animate-ping rounded-full bg-amber-500/20"></span>
                                    }
                                </div>
                                <div class="w-px flex-1 bg-border"></div>
                            </div>
                            @* Layover info *@
                            <div class="flex flex-1 items-center gap-3 rounded-md border border-dashed border-border px-3 py-2.5">
                                <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-amber-500" />
                                <div class="flex-1">
                                    <span class="font-medium text-sm">@seg.Label</span>
                                    <span class="ml-2 text-muted-foreground text-xs">in Chicago</span>
                                </div>
                                <span class="font-mono text-muted-foreground text-xs tabular-nums">@seg.Duration</span>
                                @if (seg.Status == SegmentStatus.Active)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 font-normal text-[10px]">
                                        Now
                                    </BadgeCn>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        @* Airport node *@
                        var dotClass = StatusDot(seg.Status);
                        <div class="relative flex gap-3 @(isLast ? "pb-0" : "pb-4")">
                            @* Line + dot column *@
                            @if (!isLast)
                            {
                                <div class="absolute top-7 bottom-0 left-[9px] w-px bg-border"></div>
                            }
                            <div class="relative z-10 flex w-[19px] shrink-0 justify-center pt-0.5">
                                <div class="@($"size-[19px] rounded-full ring-2 ring-card {dotClass}")"></div>
                            </div>
                            @* Airport content *@
                            <div class="min-w-0 flex-1">
                                <div class="flex items-baseline gap-2">
                                    <span class="font-semibold text-xl tabular-nums tracking-tight">@seg.AirportCode</span>
                                    <span class="text-muted-foreground text-sm">@seg.City</span>
                                    @if (seg.Label != null)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto h-5 font-normal text-[10px]">
                                            @seg.Label
                                        </BadgeCn>
                                    }
                                </div>
                                <div class="mt-1 flex items-center gap-3">
                                    <span class="font-medium text-sm tabular-nums">@seg.Time</span>
                                    <span class="text-muted-foreground/40 text-xs">·</span>
                                    <span class="text-muted-foreground text-xs">@seg.Terminal</span>
                                    <span class="text-muted-foreground/40 text-xs">·</span>
                                    <span class="text-muted-foreground text-xs">@seg.Gate</span>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum SegmentStatus { Completed, Active, Upcoming }
    private enum SegmentType { Airport, Flight, Layover }

    private record Segment(
        string Id,
        SegmentType Type,
        SegmentStatus Status,
        string? AirportCode = null,
        string? City = null,
        string? Time = null,
        string? Terminal = null,
        string? Gate = null,
        string? FlightNumber = null,
        string? Duration = null,
        string? Airline = null,
        string? Label = null
    );

    private static readonly Segment[] _segments =
    [
        new("s1", SegmentType.Airport,  SegmentStatus.Completed, AirportCode: "SFO", City: "San Francisco",    Time: "6:45 AM",  Terminal: "Terminal 2", Gate: "Gate D47"),
        new("s2", SegmentType.Flight,   SegmentStatus.Completed, FlightNumber: "UA 1492", Duration: "4h 12m", Airline: "United Airlines"),
        new("s3", SegmentType.Airport,  SegmentStatus.Completed, AirportCode: "ORD", City: "Chicago O'Hare",   Time: "2:57 PM",  Terminal: "Terminal 1", Gate: "Gate B18", Label: "Arrived"),
        new("s4", SegmentType.Layover,  SegmentStatus.Active,    Duration: "2h 35m", Label: "Layover"),
        new("s5", SegmentType.Airport,  SegmentStatus.Upcoming,  AirportCode: "ORD", City: "Chicago O'Hare",   Time: "5:32 PM",  Terminal: "Terminal 1", Gate: "Gate C22"),
        new("s6", SegmentType.Flight,   SegmentStatus.Upcoming,  FlightNumber: "UA 872",  Duration: "2h 48m", Airline: "United Airlines"),
        new("s7", SegmentType.Airport,  SegmentStatus.Upcoming,  AirportCode: "JFK", City: "New York JFK",     Time: "8:20 PM",  Terminal: "Terminal 7", Gate: "Gate 10"),
    ];

    private Segment? _departure => System.Array.Find(_segments, s => s.Type == SegmentType.Airport && s.Id == "s1");
    private Segment? _arrival   => System.Array.Find(_segments, s => s.Type == SegmentType.Airport && s.Id == "s7");

    private static string StatusLine(SegmentStatus status) => status switch
    {
        SegmentStatus.Completed => "bg-foreground/20",
        SegmentStatus.Active    => "bg-foreground/10",
        _                       => "bg-border",
    };

    private static string StatusDot(SegmentStatus status) => status switch
    {
        SegmentStatus.Completed => "bg-foreground",
        SegmentStatus.Active    => "border-2 border-foreground bg-card",
        _                       => "border-2 border-border bg-card",
    };
}
