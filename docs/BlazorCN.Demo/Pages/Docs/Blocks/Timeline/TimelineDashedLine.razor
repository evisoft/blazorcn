@* ============================================================
   Block: timeline-dashed-line
   Title: TimelineDashedLine
   Description: React vertical timeline with dashed connector built with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-dashed-line.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Release roadmap</span>
                <span class="text-muted-foreground text-xs">
                    @_doneCount of @_entries.Length completed
                </span>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">Platform v2 development timeline</p>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var entry in _entries)
                {
                    var index = Array.IndexOf(_entries, entry);
                    var isLast = index == _entries.Length - 1;
                    var dotClass = StatusDotClass(entry.Status);
                    var lineClass = LineStyleClass(entry.Status);
                    <div class="relative flex gap-4">
                        @* Dashed line + dot column *@
                        <div class="flex flex-col items-center">
                            @* Solid dot *@
                            <div class="@($"relative z-10 flex size-6 shrink-0 items-center justify-center rounded-full border-2 {dotClass}")">
                                @if (entry.Status == EntryStatus.Done)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-white" />
                                }
                                @if (entry.Status == EntryStatus.Active)
                                {
                                    <LucideIconCn Name="loader" Size="12" Class="size-3 text-white" />
                                    <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                }
                                @if (entry.Status == EntryStatus.Pending)
                                {
                                    <LucideIconCn Name="circle" Size="12" Class="size-3 text-muted-foreground/30" />
                                }
                            </div>
                            @* Dashed connector *@
                            @if (!isLast)
                            {
                                <div class="@($"flex-1 border-l-2 border-dashed {lineClass}")"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@($"{(isLast ? "pb-0" : "pb-6")} min-w-0 flex-1 pt-0.5")">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@entry.Title</span>
                                @if (entry.Label != null)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@entry.Label</BadgeCn>
                                }
                            </div>
                            <span class="mt-0.5 block text-muted-foreground text-xs">@entry.Date</span>
                            <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">@entry.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum EntryStatus { Done, Active, Pending }

    private record TimelineEntry(string Id, string Date, string Title, string Description, EntryStatus Status, string? Label);

    private static readonly TimelineEntry[] _entries =
    [
        new("d1", "Jan 6, 2026", "Requirements and scoping",
            "Conducted stakeholder interviews, mapped user journeys, and defined the MVP feature set. Delivered a 40-page specification document with acceptance criteria for all core workflows.",
            EntryStatus.Done, "Discovery"),
        new("d2", "Feb 10, 2026", "Architecture and technical design",
            "Selected the tech stack, designed the database schema, and created architecture decision records. Established CI/CD pipelines and deployed staging infrastructure.",
            EntryStatus.Done, "Engineering"),
        new("d3", "Mar 3, 2026", "Core feature development",
            "Built the authentication system, dashboard views, and real-time notification engine. Integrated third-party payment processing with webhook handlers for all subscription events.",
            EntryStatus.Done, "Engineering"),
        new("d4", "Mar 24, 2026", "Internal testing and QA",
            "Running integration tests across 3 environments. 47 of 62 test suites passing. Fixing edge cases in the billing flow and permission boundary checks.",
            EntryStatus.Active, "QA"),
        new("d5", "Apr 14, 2026", "Beta rollout to early adopters",
            "Invite-only beta for 200 waitlist users. Collecting structured feedback through in-app surveys and weekly cohort calls. Targeting 85% activation rate.",
            EntryStatus.Pending, "Launch"),
        new("d6", "May 5, 2026", "General availability release",
            "Public launch with self-serve onboarding, documentation portal, and public API. Marketing campaign across email, social channels, and developer communities.",
            EntryStatus.Pending, "Launch"),
    ];

    private int _doneCount => Array.FindAll(_entries, e => e.Status == EntryStatus.Done).Length;

    private static string StatusDotClass(EntryStatus status) => status switch
    {
        EntryStatus.Done => "border-emerald-500 bg-emerald-500",
        EntryStatus.Active => "border-blue-500 bg-blue-500",
        _ => "border-muted-foreground/30 bg-card",
    };

    private static string LineStyleClass(EntryStatus status) => status switch
    {
        EntryStatus.Done => "border-emerald-500/40",
        EntryStatus.Active => "border-blue-500/40",
        _ => "border-muted-foreground/20",
    };
}
