@* ============================================================
   Block: timeline-approval-workflow
   Title: TimelineApprovalWorkflow
   Description: React multi-stage approval timeline with approver avatars, status indicators built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-approval-workflow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
            <div class="flex-1">
                <span class="font-medium text-sm">Contract Approval — Vendor #A-2847</span>
                <p class="text-muted-foreground text-xs">$42,000 · Q2 Marketing Services</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                <span class="mr-1.5 size-1.5 rounded-full bg-amber-500"></span>
                In Review
            </BadgeCn>
        </div>

        @* Timeline *@
        <div class="px-4 py-5">
            @foreach (var stage in _stages)
            {
                var isLast = stage.Id == _stages[_stages.Length - 1].Id;
                var stageIndex = System.Array.IndexOf(_stages, stage);
                var nextStage = stageIndex < _stages.Length - 1 ? _stages[stageIndex + 1] : null;

                <div class="relative flex gap-4">
                    @* Circle + Line column *@
                    <div class="flex flex-col items-center">
                        @* Status circle *@
                        @if (stage.Status == StageStatus.Approved)
                        {
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-foreground">
                                <LucideIconCn Name="check" Size="16" Class="size-4 text-background" />
                            </div>
                        }
                        else if (stage.Status == StageStatus.Current)
                        {
                            <div class="relative flex size-8 shrink-0 items-center justify-center">
                                <span class="absolute inset-0 animate-pulse rounded-full bg-amber-500/20"></span>
                                <div class="relative flex size-8 items-center justify-center rounded-full border-2 border-amber-500 bg-card">
                                    <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-amber-600 dark:text-amber-400" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-full border-2 border-dashed border-muted-foreground/30 bg-card"></div>
                        }

                        @* Connecting line *@
                        @if (!isLast)
                        {
                            <div class="my-1 h-14 w-0.5">
                                @if (stage.Status == StageStatus.Approved && nextStage?.Status == StageStatus.Approved)
                                {
                                    <div class="h-full w-full bg-foreground"></div>
                                }
                                else if (stage.Status == StageStatus.Approved && nextStage?.Status == StageStatus.Current)
                                {
                                    <div class="h-full w-full bg-foreground"></div>
                                }
                                else if (stage.Status == StageStatus.Current)
                                {
                                    <div class="h-full w-full border-l-2 border-dashed border-muted-foreground/30"></div>
                                }
                                else
                                {
                                    <div class="h-full w-full border-l-2 border-dashed border-muted-foreground/20"></div>
                                }
                            </div>
                        }
                    </div>

                    @* Content *@
                    <div class="@(isLast ? "flex-1 pb-0" : "flex-1 pb-4")">
                        <div class="flex items-center gap-2">
                            <span class="@(stage.Status == StageStatus.Pending ? "font-medium text-sm text-muted-foreground" : "font-medium text-sm text-foreground")">
                                @stage.Label
                            </span>
                        </div>

                        @* Approver row *@
                        <div class="mt-2 flex items-center gap-2.5">
                            <AvatarCn Class="size-6">
                                <AvatarFallbackCn Class="@(stage.Status == StageStatus.Pending ? "text-[10px] bg-muted text-muted-foreground" : "text-[10px] bg-muted text-foreground")">
                                    @stage.Approver.Initials
                                </AvatarFallbackCn>
                            </AvatarCn>
                            <div>
                                <span class="@(stage.Status == StageStatus.Pending ? "text-xs text-muted-foreground" : "text-xs text-foreground")">
                                    @stage.Approver.Name
                                </span>
                                <span class="mx-1.5 text-muted-foreground/40 text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@stage.Approver.Role</span>
                            </div>
                        </div>

                        @* Note + timestamp *@
                        <p class="mt-1 text-muted-foreground text-xs">@stage.Note</p>
                        <span class="mt-0.5 font-mono text-muted-foreground/60 text-xs">
                            @stage.Timestamp
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum StageStatus { Approved, Current, Pending }

    private record Approver(string Name, string Initials, string Role);

    private record ApprovalStage(string Id, string Label, StageStatus Status, Approver Approver, string Timestamp, string Note);

    private static readonly ApprovalStage[] _stages =
    [
        new("submit", "Submitted", StageStatus.Approved,
            new("Alex Chen", "AC", "Requester"),
            "Mar 18, 9:15 AM",
            "Vendor contract for Q2 marketing spend"),
        new("review", "Manager Review", StageStatus.Approved,
            new("Sarah Kim", "SK", "Engineering Manager"),
            "Mar 18, 2:40 PM",
            "Approved — budget aligns with Q2 plan"),
        new("legal", "Legal Review", StageStatus.Current,
            new("James Wright", "JW", "Legal Counsel"),
            "Assigned Mar 19",
            "Under review — checking liability clauses"),
        new("finance", "Finance Approval", StageStatus.Pending,
            new("Maria Lopez", "ML", "Finance Director"),
            "Waiting",
            "Pending legal clearance"),
        new("final", "Final Approval", StageStatus.Pending,
            new("David Park", "DP", "VP Operations"),
            "Waiting",
            "Final sign-off required"),
    ];
}
