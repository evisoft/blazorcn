@* ============================================================
   Block: timeline-horizontal-stepper
   Title: TimelineHorizontalStepper
   Description: React step-by-step timeline with numbered circles, progress bar, and pulsing animation using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-horizontal-stepper.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Deployment Pipeline</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">
                @_completedCount of @_steps.Length completed
            </span>
        </div>

        @* Stepper *@
        <div class="overflow-x-auto">
            <div class="min-w-[750px] px-8 py-8">
                <div class="flex items-start">
                    @foreach (var st in _steps)
                    {
                        var step = st;
                        var stepIndex = System.Array.IndexOf(_steps, step);
                        var isLast = stepIndex == _steps.Length - 1;
                        <div class="flex flex-1 flex-col items-center">
                            @* Step circle + connector row *@
                            <div class="flex w-full items-center">
                                @* Left connector *@
                                @if (stepIndex > 0)
                                {
                                    <div class="@Cn.Merge("h-0.5 flex-1", (step.Status == StepStatus.Completed || step.Status == StepStatus.Current) ? "bg-foreground" : "bg-border")"></div>
                                }
                                else
                                {
                                    <div class="flex-1"></div>
                                }

                                @* Circle *@
                                <div class="relative flex items-center justify-center">
                                    @if (step.Status == StepStatus.Current)
                                    {
                                        <span class="absolute size-10 animate-ping rounded-full bg-foreground/10"></span>
                                    }
                                    <div class="@Cn.Merge("relative z-10 flex size-8 items-center justify-center rounded-full text-xs font-medium transition-colors", step.Status == StepStatus.Completed ? "bg-foreground text-background" : step.Status == StepStatus.Current ? "border-2 border-foreground bg-card text-foreground" : "border-2 border-border bg-card text-muted-foreground")">
                                        @if (step.Status == StepStatus.Completed)
                                        {
                                            <LucideIconCn Name="check" Size="16" Class="size-4" />
                                        }
                                        else
                                        {
                                            @step.Number
                                        }
                                    </div>
                                </div>

                                @* Right connector *@
                                @if (!isLast)
                                {
                                    <div class="@Cn.Merge("h-0.5 flex-1", step.Status == StepStatus.Completed ? "bg-foreground" : "bg-border")"></div>
                                }
                                else
                                {
                                    <div class="flex-1"></div>
                                }
                            </div>

                            @* Label *@
                            <div class="mt-3 w-28 text-center">
                                <p class="@Cn.Merge("font-medium text-sm", step.Status == StepStatus.Upcoming ? "text-muted-foreground" : "")">
                                    @step.Title
                                </p>
                                <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                                    @step.Description
                                </p>
                                <span class="mt-1.5 block font-mono text-muted-foreground text-xs">
                                    @step.Date
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Progress footer *@
        <div class="border-t px-4 py-2">
            <div class="flex items-center gap-3">
                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-foreground transition-all"
                         style="@($"width:{(double)_completedCount / _steps.Length * 100:0}%")">
                    </div>
                </div>
                <span class="shrink-0 font-mono text-muted-foreground text-xs">
                    @(((double)_completedCount / _steps.Length * 100).ToString("0"))%
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private enum StepStatus { Completed, Current, Upcoming }

    private record Step(string Id, int Number, string Title, string Description, string Date, StepStatus Status);

    private static readonly Step[] _steps =
    [
        new("s1", 1, "Discovery",
            "Requirements gathering, stakeholder interviews, and technical feasibility assessment.",
            "Jan 2025", StepStatus.Completed),
        new("s2", 2, "Design",
            "Wireframes, design system creation, and interactive prototype validation.",
            "Mar 2025", StepStatus.Completed),
        new("s3", 3, "Development",
            "Sprint-based implementation with weekly demos and continuous integration.",
            "Jun 2025", StepStatus.Completed),
        new("s4", 4, "Testing",
            "QA automation, performance benchmarking, and security penetration testing.",
            "Sep 2025", StepStatus.Current),
        new("s5", 5, "Staging",
            "Production-mirror environment with load testing and final stakeholder sign-off.",
            "Nov 2025", StepStatus.Upcoming),
        new("s6", 6, "Launch",
            "Phased rollout, monitoring dashboards, and post-launch support rotation.",
            "Jan 2026", StepStatus.Upcoming),
    ];

    private static readonly int _completedCount = System.Array.FindAll(_steps, s => s.Status == StepStatus.Completed).Length;
}
