@* ============================================================
   Block: timeline-activity-feed
   Title: TimelineActivityFeed
   Description: React social activity feed timeline with avatars, user actions, timestamps built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-activity-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Activity</span>
            <span class="text-muted-foreground text-xs">@_activities.Length events</span>
        </div>

        @* Timeline *@
        <div class="px-4 py-3">
            <div class="relative">
                @foreach (var activity in _activities)
                {
                    var isLast = activity.Id == _activities[_activities.Length - 1].Id;
                    <div class="relative flex gap-3 pb-6 last:pb-0">
                        @* Vertical line *@
                        @if (!isLast)
                        {
                            <div class="absolute top-8 bottom-0 left-[15px] w-px bg-border"></div>
                        }

                        @* Avatar node *@
                        <div class="relative z-10 shrink-0">
                            <AvatarCn Class="size-8 ring-2 ring-card">
                                <AvatarFallbackCn Class="text-[11px]">@activity.User.Initials</AvatarFallbackCn>
                            </AvatarCn>
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1 pt-0.5">
                            <p class="text-sm leading-relaxed">
                                <span class="font-medium">@activity.User.Name</span>
                                <span class="text-muted-foreground"> @activity.Action </span>
                                <span class="font-medium">@activity.Target</span>
                            </p>
                            <div class="mt-1 flex items-center gap-2">
                                <span class="text-muted-foreground text-xs">@activity.Timestamp</span>
                                @if (activity.Badge != null)
                                {
                                    <BadgeCn Variant="@(activity.Badge.Variant == "secondary" ? BadgeVariant.Secondary : BadgeVariant.Outline)" Class="h-5 text-[10px]">
                                        @activity.Badge.Label
                                    </BadgeCn>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ActivityUser(string Name, string Initials);
    private record ActivityBadge(string Label, string Variant);
    private record ActivityItem(string Id, ActivityUser User, string Action, string Target, string Timestamp, ActivityBadge? Badge = null);

    private static readonly ActivityItem[] _activities =
    [
        new("1", new("Sarah Chen", "SC"), "deployed", "v2.4.0 to production", "2 min ago", new("Production", "secondary")),
        new("2", new("Marcus Rivera", "MR"), "commented on", "Add dark mode support for dashboard", "18 min ago"),
        new("3", new("Ava Patel", "AP"), "merged pull request", "#847 Fix memory leak in WebSocket handler", "1 hour ago", new("Merged", "secondary")),
        new("4", new("James Wilson", "JW"), "opened issue", "Rate limiter drops requests under high concurrency", "2 hours ago"),
        new("5", new("Lina Nakamura", "LN"), "pushed 3 commits to", "feature/auth-refactor", "3 hours ago"),
        new("6", new("Sarah Chen", "SC"), "approved review on", "#842 Migrate to new billing API", "4 hours ago"),
        new("7", new("Omar Farouk", "OF"), "created branch", "hotfix/session-timeout", "5 hours ago"),
        new("8", new("Ava Patel", "AP"), "closed issue", "#831 Stale cache after config update", "6 hours ago"),
    ];
}
