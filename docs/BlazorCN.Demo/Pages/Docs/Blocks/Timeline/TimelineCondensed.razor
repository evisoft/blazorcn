@* ============================================================
   Block: timeline-condensed
   Title: TimelineCondensed
   Description: React condensed timeline with date grouping for high-volume events, built with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-condensed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Event log</span>
            <span class="text-muted-foreground text-xs">
                @_totalEvents events
            </span>
        </div>

        @* Grouped timeline *@
        <div>
            @for (int gi = 0; gi < _groups.Length; gi++)
            {
                var grp = _groups[gi];
                var isLastGroup = gi == _groups.Length - 1;
                <div class="@(isLastGroup ? "" : "border-b")">
                    @* Date header *@
                    <div class="flex items-center gap-2 px-4 py-2">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                            @grp.Date
                        </BadgeCn>
                        <div class="h-px flex-1 bg-border"></div>
                        <span class="text-muted-foreground text-[10px]">@grp.Entries.Length</span>
                    </div>

                    @* Entries within group *@
                    <div class="pb-2">
                        @for (int ei = 0; ei < grp.Entries.Length; ei++)
                        {
                            var entry = grp.Entries[ei];
                            var isFirstEntry = ei == 0;
                            var isLastEntry = ei == grp.Entries.Length - 1;
                            <div class="group relative flex items-center gap-3 px-4 py-1 transition-colors hover:bg-muted/50">
                                @* Dot + line column *@
                                <div class="relative flex w-3 shrink-0 items-center justify-center self-stretch">
                                    @* Line above *@
                                    @if (!isFirstEntry)
                                    {
                                        <div class="absolute top-0 bottom-1/2 left-1/2 w-px -translate-x-1/2 bg-border"></div>
                                    }
                                    @* Dot *@
                                    <span class="@Cn.Merge("relative z-10 size-1.5 shrink-0 rounded-full", TypeDotClass(entry.Type))"></span>
                                    @* Line below *@
                                    @if (!isLastEntry)
                                    {
                                        <div class="absolute top-1/2 bottom-0 left-1/2 w-px -translate-x-1/2 bg-border"></div>
                                    }
                                </div>

                                @* Time *@
                                <span class="w-10 shrink-0 font-mono text-muted-foreground text-[11px] tabular-nums">
                                    @entry.Time
                                </span>

                                @* Title *@
                                <span class="min-w-0 flex-1 truncate text-muted-foreground text-xs group-hover:text-foreground">
                                    @entry.Title
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum EntryType { Deploy, Alert, Config, User, System }

    private record Entry(string Id, string Time, string Title, EntryType Type);

    private record DateGroup(string Date, Entry[] Entries);

    private static readonly DateGroup[] _groups =
    [
        new("Today",
        [
            new("1", "14:32", "Production deploy v3.8.2 completed", EntryType.Deploy),
            new("2", "14:28", "Memory alert resolved on worker-2", EntryType.Alert),
            new("3", "13:15", "Feature flag updated: dark-mode-v2", EntryType.Config),
            new("4", "11:42", "New team member added: alex.rivera@acme.io", EntryType.User),
            new("5", "10:08", "SSL certificate auto-renewed for api.acme.io", EntryType.System),
        ]),
        new("Yesterday",
        [
            new("6", "22:15", "Cron: daily-backup completed in 34s", EntryType.System),
            new("7", "19:30", "Staging deploy v3.8.1 completed", EntryType.Deploy),
            new("8", "16:44", "Rate limit threshold adjusted to 1000 req/min", EntryType.Config),
            new("9", "14:22", "Disk usage alert triggered at 92%", EntryType.Alert),
            new("10", "11:05", "API key rotated for billing-service", EntryType.System),
            new("11", "09:18", "Database migration: add_audit_log_index", EntryType.Deploy),
        ]),
        new("Mar 22",
        [
            new("12", "17:55", "Webhook endpoint registered: /hooks/stripe", EntryType.Config),
            new("13", "15:30", "Production deploy v3.7.9 completed", EntryType.Deploy),
            new("14", "12:10", "User role updated: sarah.chen promoted to admin", EntryType.User),
            new("15", "08:45", "Cron: log-rotation completed", EntryType.System),
        ]),
    ];

    private int _totalEvents => _groups.Sum(g => g.Entries.Length);

    private static string TypeDotClass(EntryType type) => type switch
    {
        EntryType.Deploy => "bg-emerald-500",
        EntryType.Alert => "bg-amber-500",
        EntryType.Config => "bg-blue-500",
        EntryType.User => "bg-violet-500",
        EntryType.System => "bg-muted-foreground/40",
        _ => ""
    };
}
