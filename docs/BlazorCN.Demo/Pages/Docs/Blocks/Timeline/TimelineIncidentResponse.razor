@* ============================================================
   Block: timeline-incident-response
   Title: TimelineIncidentResponse
   Description: React incident timeline with detection, investigation, mitigation, and resolution stages using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-incident-response.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-red-500" />
                <span class="font-medium text-sm">@_incidentTitle</span>
            </div>
            <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                <span class="font-mono">@_incidentId</span>
                <span class="text-muted-foreground/40">·</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 border-red-500/20 bg-red-500/10 px-1.5 font-normal text-[10px] text-red-600 dark:text-red-400">
                    @_severity
                </BadgeCn>
                <span class="text-muted-foreground/40">·</span>
                <span>Total: @_totalElapsed</span>
                <span class="text-muted-foreground/40">·</span>
                <span>@_completedStages/@_stages.Length stages</span>
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var stage in _stages)
                {
                    var idx = System.Array.IndexOf(_stages, stage);
                    var isLast = idx == _stages.Length - 1;

                    <div class="relative flex gap-4">
                        @* Timeline column *@
                        <div class="flex flex-col items-center">
                            @* Stage marker *@
                            <div class="@($"relative z-10 flex size-7 shrink-0 items-center justify-center rounded-full border-2 {stage.ColorDot}")">
                                <LucideIconCn Name="@stage.IconName" Size="14" Class="size-3.5 text-white" />
                                @if (stage.Status == StageStatus.Active)
                                {
                                    <span class="@($"absolute inset-0 animate-ping rounded-full border-2 {stage.ColorDot} opacity-20")"></span>
                                }
                            </div>
                            @* Connector with gradient *@
                            @if (!isLast)
                            {
                                <div class="@($"w-0.5 flex-1 bg-gradient-to-b {stage.ColorLine}")"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@($"min-w-0 flex-1 {(isLast ? "pb-0" : "pb-6")}")">
                            @* Stage header *@
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@stage.Name</span>
                                <span class="@($"font-mono text-xs tabular-nums {stage.ColorText}")">+@stage.Elapsed</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="font-mono">@stage.Timestamp</span>
                                <span class="text-muted-foreground/40">·</span>
                                <span>@stage.Responder</span>
                            </div>

                            @* Description *@
                            <div class="@($"mt-2 rounded-md p-3 {stage.ColorBg}")">
                                <p class="text-sm leading-relaxed">@stage.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum StageStatus { Completed, Active, Pending }

    private record Stage(
        string Id,
        string Name,
        string Timestamp,
        string Elapsed,
        string Responder,
        string Description,
        StageStatus Status,
        string ColorDot,
        string ColorText,
        string ColorBg,
        string ColorLine,
        string IconName
    );

    private const string _severity = "critical";
    private const string _incidentTitle = "Database connection pool exhaustion";
    private const string _incidentId = "INC-2847";
    private const string _totalElapsed = "3h 42m";

    private static readonly Stage[] _stages =
    [
        new("s1", "Detection", "Mar 11, 02:14 AM", "0m", "PagerDuty alert",
            "Automated alert triggered: PostgreSQL connection pool utilization exceeded 95%. Error rate spiked to 34% across API endpoints. 2,400 requests queued.",
            StageStatus.Completed,
            "bg-red-500 border-red-500",
            "text-red-600 dark:text-red-400",
            "bg-red-500/10",
            "from-red-500/40 to-red-500/20",
            "shield-alert"),

        new("s2", "Investigation", "Mar 11, 02:22 AM", "8m", "Sarah Chen (SRE)",
            "Identified root cause: a runaway migration job held 180 connections for 45+ minutes. Connection leak in the batch processor prevented pool recycling. Normal pool size is 50 connections.",
            StageStatus.Completed,
            "bg-amber-500 border-amber-500",
            "text-amber-600 dark:text-amber-400",
            "bg-amber-500/10",
            "from-amber-500/30 to-amber-500/15",
            "search"),

        new("s3", "Mitigation", "Mar 11, 02:51 AM", "37m", "Marcus Rivera (Backend)",
            "Killed the runaway migration job. Increased pool max to 100 connections as temporary relief. Deployed connection timeout patch to force-release stale connections after 30 seconds.",
            StageStatus.Completed,
            "bg-yellow-500 border-yellow-500",
            "text-yellow-600 dark:text-yellow-400",
            "bg-yellow-500/10",
            "from-yellow-500/25 to-emerald-500/20",
            "wrench"),

        new("s4", "Resolution", "Mar 11, 05:56 AM", "3h 42m", "Sarah Chen (SRE)",
            "Error rate returned to baseline (0.02%). Connection pool stable at 22/50 utilization. Deployed permanent fix: batch processor now uses a dedicated connection pool with a 5-connection limit.",
            StageStatus.Completed,
            "bg-emerald-500 border-emerald-500",
            "text-emerald-600 dark:text-emerald-400",
            "bg-emerald-500/10",
            "from-emerald-500/30 to-blue-500/20",
            "check-circle-2"),

        new("s5", "Post-mortem", "Mar 12, 10:00 AM", "+1 day", "Engineering team",
            "Conducted blameless review. Action items: add connection pool monitoring per-service, implement circuit breaker for batch jobs, set hard limit on migration job concurrency, add runbook for pool exhaustion.",
            StageStatus.Active,
            "bg-blue-500 border-blue-500",
            "text-blue-600 dark:text-blue-400",
            "bg-blue-500/10",
            "from-blue-500/20 to-blue-500/10",
            "clipboard-list"),
    ];

    private int _completedStages => System.Array.FindAll(_stages, s => s.Status == StageStatus.Completed).Length;
}
