@* ============================================================
   Block: timeline-social-posts
   Title: TimelineSocialPosts
   Description: React social media timeline for Next.js with shadcn/ui, Tailwind CSS showing platform posts, engagement metrics, and content previews.
   Source: original/blocks/timeline/timeline-social-posts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Content timeline</span>
            <div class="flex items-center gap-3">
                @foreach (var p in _platforms)
                {
                    var platform = p;
                    var cfg = _platformConfig[platform];
                    var cnt = _posts.Where(post => post.Platform == platform).Count();
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@($"size-1.5 rounded-full {cfg.Dot}")"></span>
                        @cnt
                    </span>
                }
            </div>
        </div>

        @* Timeline grouped by date *@
        <div>
            @{
                var dateGroups = _posts.GroupBy(p => p.Date).ToList();
            }
            @foreach (var grp in dateGroups)
            {
                var groupIndex = dateGroups.IndexOf(grp);
                var isLastGroup = groupIndex == dateGroups.Count - 1;
                var datePosts = grp.ToArray();
                <div class="@(isLastGroup ? "" : "border-b")">
                    @* Date separator *@
                    <div class="px-4 pt-3 pb-1">
                        <span class="font-medium text-muted-foreground text-xs">@grp.Key</span>
                    </div>

                    @* Posts in this date group *@
                    <div class="px-4 pb-3">
                        <div class="relative">
                            @for (var i = 0; i < datePosts.Length; i++)
                            {
                                var post = datePosts[i];
                                var isLast = i == datePosts.Length - 1;
                                var config = _platformConfig[post.Platform];
                                <div class="relative flex gap-3 pb-0">
                                    @* Line + dot column *@
                                    <div class="flex flex-col items-center">
                                        @* Platform dot *@
                                        <div class="relative z-10 flex size-7 shrink-0 items-center justify-center rounded-full border bg-card">
                                            <span class="@($"size-2.5 rounded-full {config.Dot}")"></span>
                                        </div>
                                        @* Connector *@
                                        @if (!isLast)
                                        {
                                            <div class="w-px flex-1 bg-border"></div>
                                        }
                                    </div>

                                    @* Content *@
                                    <div class="@($"min-w-0 flex-1 {(isLast ? "pb-0" : "pb-4")}")">
                                        <div class="flex items-center gap-2">
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                                @config.Label
                                            </BadgeCn>
                                            @if (post.PostType == "text")
                                            {
                                                <LucideIconCn Name="globe" Size="12" Class="size-3 text-muted-foreground/60" />
                                            }
                                            else if (post.PostType == "image")
                                            {
                                                <LucideIconCn Name="image" Size="12" Class="size-3 text-muted-foreground/60" />
                                            }
                                            else if (post.PostType == "link")
                                            {
                                                <LucideIconCn Name="link" Size="12" Class="size-3 text-muted-foreground/60" />
                                            }
                                            <span class="ml-auto text-muted-foreground text-xs">
                                                @post.Timestamp
                                            </span>
                                        </div>
                                        <p class="mt-1.5 text-sm leading-relaxed line-clamp-2">
                                            @post.Content
                                        </p>
                                        @* Engagement metrics *@
                                        <div class="mt-2 flex items-center gap-4">
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="heart" Size="12" Class="size-3" />
                                                @FormatNumber(post.Metrics.Likes)
                                            </span>
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="repeat" Size="12" Class="size-3" />
                                                @FormatNumber(post.Metrics.Shares)
                                            </span>
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="message-circle" Size="12" Class="size-3" />
                                                @FormatNumber(post.Metrics.Comments)
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PostMetrics(int Likes, int Shares, int Comments);
    private record SocialPost(string Id, string Platform, string PostType, string Content, PostMetrics Metrics, string Timestamp, string Date);
    private record PlatformConfig(string Label, string Dot);

    private static readonly string[] _platforms = ["twitter", "linkedin", "blog", "newsletter"];

    private static readonly Dictionary<string, PlatformConfig> _platformConfig = new()
    {
        ["twitter"]     = new("Twitter",    "bg-foreground"),
        ["linkedin"]    = new("LinkedIn",   "bg-blue-500"),
        ["blog"]        = new("Blog",       "bg-emerald-500"),
        ["newsletter"]  = new("Newsletter", "bg-amber-500"),
    };

    private static readonly SocialPost[] _posts =
    [
        new("p1", "twitter",    "text",  "Just shipped dark mode support across the entire dashboard. 47 components updated, zero visual regressions. Our snapshot testing pipeline paid for itself today.",                                                                                             new(284,  42,  18), "9:00 AM",  "Today"),
        new("p2", "linkedin",   "link",  "We published our engineering blog post on how we reduced API latency by 60% using edge caching with Cloudflare Workers. Full architecture breakdown inside.",                                                                                               new(156,  38,  12), "11:30 AM", "Today"),
        new("p3", "twitter",    "image", "Before and after of our new onboarding flow. Reduced time-to-first-value from 8 minutes to 90 seconds. The secret: progressive disclosure instead of a 12-field form.",                                                                                   new(892, 167,  43), "2:00 PM",  "Yesterday"),
        new("p4", "blog",       "link",  "New post: Building a real-time collaboration engine with CRDTs. We cover the tradeoffs between OT and CRDT, our Yjs implementation, and benchmarks at 500 concurrent users.",                                                                             new(421,  89,  27), "10:00 AM", "Yesterday"),
        new("p5", "newsletter", "text",  "Weekly digest #24: Edge caching deep dive, Q1 retrospective, 3 new integrations (Slack, Linear, Notion), and a preview of the AI features coming in v3.0.",                                                                                              new( 64,  12,   8), "8:00 AM",  "Mar 22"),
        new("p6", "linkedin",   "text",  "Excited to announce we have crossed 10,000 active teams on the platform. When we started 18 months ago, our stretch goal was 1,000. Grateful for every user who gave us feedback along the way.",                                                       new(1247, 203,  86), "3:00 PM",  "Mar 21"),
        new("p7", "twitter",    "text",  "Hot take: the best documentation is not comprehensive — it is discoverable. We rebuilt our docs search with semantic embeddings and support tickets dropped 34%.",                                                                                        new(563,  94,  31), "12:15 PM", "Mar 20"),
    ];

    private static string FormatNumber(int n)
    {
        if (n >= 1000)
            return $"{(n / 1000.0).ToString("F1")}k";
        return n.ToString();
    }
}
