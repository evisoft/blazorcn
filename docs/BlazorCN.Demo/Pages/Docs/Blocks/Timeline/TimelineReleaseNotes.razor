@* ============================================================
   Block: timeline-release-notes
   Title: TimelineReleaseNotes
   Description: React release timeline with version tags. Built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-release-notes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="tag" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Release notes</span>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <LucideIconCn Name="git-branch" Size="12" Class="size-3" />
                <span>@_releases.Length releases</span>
            </div>
        </div>

        @* Releases timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var rel in _releases)
                {
                    var release = rel;
                    var isLast = release.Id == _releases[_releases.Length - 1].Id;
                    var cfg = GetTypeConfig(release.Type);
                    <div class="relative flex gap-4">
                        @* Timeline column *@
                        <div class="flex flex-col items-center">
                            @* Version marker *@
                            <div class="@($"relative z-10 flex shrink-0 items-center justify-center rounded-full {cfg.Size} {cfg.Marker}")">
                                @if (release.Type == ReleaseType.Major)
                                {
                                    <span>@release.Version.Split('.')[0]</span>
                                }
                                @if (release.Type == ReleaseType.Minor)
                                {
                                    <span class="size-2 rounded-full bg-foreground"></span>
                                }
                                @if (release.Type == ReleaseType.Patch)
                                {
                                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                                }
                            </div>
                            @* Connector *@
                            @if (!isLast)
                            {
                                <div class="@($"w-0.5 flex-1 {(release.Type == ReleaseType.Major ? "bg-foreground/20" : "bg-border")}")"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@($"min-w-0 flex-1 {(isLast ? "pb-0" : "pb-6")}")">
                            @* Version + date row *@
                            <div class="flex items-center gap-2">
                                <span class="font-mono font-semibold text-sm">@release.Version</span>
                                @if (release.Breaking)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 border-red-500/20 bg-red-500/10 px-1.5 font-normal text-[10px] text-red-600 dark:text-red-400">
                                        Breaking
                                    </BadgeCn>
                                }
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                                    @release.Type.ToString().ToLower()
                                </BadgeCn>
                                <ButtonCn aria-label="@($"Copy version {release.Version}")" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="ml-auto h-5 gap-1 px-1.5 text-muted-foreground text-xs" OnClick="@(() => CopyVersion(release.Id, release.Version))">
                                    @if (_copiedId == release.Id)
                                    {
                                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                    }
                                </ButtonCn>
                            </div>
                            <span class="mt-0.5 block text-muted-foreground text-xs">@release.Date</span>

                            @* Title *@
                            <p class="mt-1.5 font-medium text-sm">@release.Title</p>

                            @* Highlights *@
                            <div class="mt-2 space-y-1">
                                @foreach (var highlight in release.Highlights)
                                {
                                    <div class="flex items-start gap-2">
                                        <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                        <span class="text-muted-foreground text-xs leading-relaxed">@highlight</span>
                                    </div>
                                }
                            </div>

                            @* Contributors *@
                            <div class="mt-2 flex items-center gap-1.5 text-muted-foreground text-xs">
                                <LucideIconCn Name="users" Size="12" Class="size-3" />
                                <span>@release.Contributors contributor@(release.Contributors != 1 ? "s" : "")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum ReleaseType { Major, Minor, Patch }

    private record Release(string Id, string Version, string Date, ReleaseType Type, string Title, string[] Highlights, int Contributors, bool Breaking = false);

    private record TypeConfig(string Size, string Marker);

    private static TypeConfig GetTypeConfig(ReleaseType type) => type switch
    {
        ReleaseType.Major => new("size-8", "bg-foreground text-background font-mono text-[10px] font-semibold"),
        ReleaseType.Minor => new("size-6", "border-2 border-foreground bg-card"),
        ReleaseType.Patch => new("size-5", "border-2 border-muted-foreground/40 bg-card"),
        _                 => new("size-5", "bg-muted"),
    };

    private string? _copiedId;

    private async Task CopyVersion(string id, string version)
    {
        _copiedId = id;
        await Task.Delay(2000);
        _copiedId = null;
    }

    private static readonly Release[] _releases =
    [
        new("r1", "v3.0.0", "Mar 12, 2026", ReleaseType.Major, "Real-time collaboration engine",
        [
            "Multi-cursor live editing with conflict resolution",
            "Presence indicators showing active collaborators",
            "New WebSocket transport layer with auto-reconnection",
            "Redesigned permission model for shared workspaces",
        ], 14, Breaking: true),
        new("r2", "v2.8.1", "Feb 28, 2026", ReleaseType.Patch, "Hotfix: Session timeout on idle",
        [
            "Fixed session expiry not refreshing on background tabs",
            "Resolved race condition in token rotation",
        ], 2),
        new("r3", "v2.8.0", "Feb 20, 2026", ReleaseType.Minor, "Billing dashboard and usage analytics",
        [
            "Invoice history with PDF export",
            "Real-time usage metering charts",
            "Subscription plan comparison view",
        ], 7),
        new("r4", "v2.7.0", "Feb 5, 2026", ReleaseType.Minor, "Webhook management overhaul",
        [
            "Event log with payload inspection and replay",
            "Configurable retry policies per endpoint",
            "Signature verification guide in docs",
        ], 5),
        new("r5", "v2.0.0", "Jan 10, 2026", ReleaseType.Major, "Platform V2 — complete redesign",
        [
            "New component architecture with RSC support",
            "Migrated to PostgreSQL with Prisma ORM",
            "Tailwind CSS 4 with design token system",
            "Zero-downtime deployment pipeline",
        ], 22, Breaking: true),
    ];
}
