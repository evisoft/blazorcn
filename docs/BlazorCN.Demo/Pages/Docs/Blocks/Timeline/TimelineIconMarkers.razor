@* ============================================================
   Block: timeline-icon-markers
   Title: TimelineIconMarkers
   Description: React vertical timeline with Lucide icon markers, expandable events, and badges using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-icon-markers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Development roadmap</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_events.Length events
                </BadgeCn>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">From concept to public launch</p>
        </div>

        @* Timeline *@
        <div class="relative">
            @* Connecting line *@
            <div class="absolute top-0 bottom-0 left-[27px] w-px bg-border"></div>

            @foreach (var evt in _events)
            {
                var evtId = evt.Id;
                var index = System.Array.IndexOf(_events, evt);
                var isExpanded = _expanded == evt.Id;
                var isLast = index == _events.Length - 1;
                var chevronClass = Cn.Merge("mt-1 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "");

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => SetExpanded(evtId, isExpanded))"
                            class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Icon marker *@
                        <div class="relative z-10 flex size-7 shrink-0 items-center justify-center rounded-full border bg-card">
                            <LucideIconCn Name="@evt.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1 pt-0.5">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@evt.Title</span>
                                <span class="text-muted-foreground text-xs">@evt.Date</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@evt.Label</p>
                        </div>

                        @* Chevron *@
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @* Expanded detail *@
                    @if (isExpanded)
                    {
                        <div class="mb-3 ml-[40px] mr-4 rounded-md bg-muted/50 p-3">
                            <p class="text-sm leading-relaxed">@evt.Description</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TimelineEvent(string Id, string Title, string Date, string Label, string Icon, string Description);

    private static readonly TimelineEvent[] _events =
    [
        new("1", "Concept ideation", "Jan 5, 2026", "Research", "lightbulb",
            "Brainstormed product direction based on user interviews and competitive analysis. Prioritized three key feature areas for the MVP scope."),
        new("2", "Architecture review", "Jan 20, 2026", "Engineering", "search",
            "Evaluated microservices vs monolith. Selected edge-first architecture with serverless functions for API layer. Database schema designed and reviewed."),
        new("3", "Core development sprint", "Feb 10, 2026", "Engineering", "code",
            "Four-week sprint building authentication, dashboard, and data pipeline modules. 47 pull requests merged. Test coverage reached 88%."),
        new("4", "Security audit passed", "Feb 28, 2026", "Security", "shield-check",
            "Third-party penetration testing completed with zero critical findings. Two medium-severity issues patched within 48 hours. SOC 2 compliance checklist submitted."),
        new("5", "Bug bash week", "Mar 7, 2026", "QA", "bug",
            "Company-wide bug bash surfaced 23 issues. 19 fixed during the sprint, 4 deferred to post-launch backlog. Crash-free sessions hit 99.7%."),
        new("6", "Feature flag rollout", "Mar 14, 2026", "Release", "flag",
            "Staged rollout to 10%, 25%, 50%, then 100% of users over four days. Monitoring dashboards confirmed latency within SLA. No rollback triggered."),
        new("7", "Public launch", "Mar 24, 2026", "Release", "rocket",
            "General availability announced. Press coverage, Product Hunt launch, and email campaign activated. 2,400 sign-ups in the first 24 hours."),
    ];

    private string? _expanded = "3";

    private void SetExpanded(string id, bool isCurrentlyExpanded)
    {
        _expanded = isCurrentlyExpanded ? null : id;
    }
}
