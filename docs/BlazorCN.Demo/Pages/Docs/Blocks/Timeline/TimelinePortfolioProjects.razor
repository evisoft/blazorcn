@* ============================================================
   Block: timeline-portfolio-projects
   Title: TimelinePortfolioProjects
   Description: React portfolio timeline with project cards and tech badges using Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-portfolio-projects.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="folder" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Project portfolio</span>
                </div>
                <span class="text-muted-foreground text-xs">
                    @_projects.Length projects · @_years.Length years
                </span>
            </div>
        </div>

        @* Timeline *@
        <div class="relative px-4 py-4">
            @* Vertical spine *@
            <div class="absolute top-0 bottom-0 left-[31px] w-px bg-border"></div>

            @foreach (var item in _projectItems)
            {
                var proj = item.Project;
                var idx = item.Index;
                var showYearHeader = item.ShowYearHeader;
                var isLast = item.IsLast;

                @* Year header marker *@
                @if (showYearHeader)
                {
                    <div class="@Cn.Merge("relative flex items-center gap-3 mb-4", idx > 0 ? "mt-2" : "")">
                        <div class="relative z-10 flex size-7 shrink-0 items-center justify-center rounded-full border bg-card">
                            <span class="font-semibold text-xs tabular-nums">@proj.Year.Substring(2)</span>
                        </div>
                        <div class="h-px flex-1 bg-border"></div>
                    </div>
                }

                @* Project entry *@
                <div class="@Cn.Merge("relative flex gap-3", isLast ? "" : "mb-5")">
                    @* Dot marker *@
                    <div class="relative z-10 mt-1 flex size-7 shrink-0 items-center justify-center">
                        <span class="size-2 rounded-full bg-muted-foreground/30"></span>
                    </div>

                    @* Project card *@
                    <div class="min-w-0 flex-1 overflow-hidden rounded-md border">
                        @* Thumbnail placeholder *@
                        <div class="aspect-video w-full bg-muted"></div>

                        @* Content *@
                        <div class="p-3">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0">
                                    <span class="font-medium text-sm">@proj.Title</span>
                                    <div class="mt-0.5 flex items-center gap-1.5">
                                        <span class="text-muted-foreground text-xs">@proj.Role</span>
                                        @if (proj.Link != null)
                                        {
                                            <span class="text-muted-foreground text-xs">·</span>
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="external-link" Size="10" Class="size-2.5" />
                                                @proj.Link
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <p class="mt-2 text-muted-foreground text-xs leading-relaxed">
                                @proj.Description
                            </p>

                            @* Tech stack *@
                            <div class="mt-2.5 flex flex-wrap gap-1">
                                @foreach (var tech in proj.Tech)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@tech</BadgeCn>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Project(string Id, string Title, string Description, string Year, string Role, string[] Tech, string? Link = null);

    private record ProjectItem(Project Project, int Index, bool ShowYearHeader, bool IsLast);

    private static readonly Project[] _projects =
    [
        new("p1", "Meridian Design System",
            "Built a comprehensive design system with 120+ components, token-based theming, and automated accessibility testing. Adopted by 8 product teams across the organization.",
            "2026", "Lead Engineer", ["React", "TypeScript", "Storybook", "Figma"], "meridian.design"),
        new("p2", "Pulse Analytics Dashboard",
            "Real-time analytics dashboard processing 2M events per day with interactive charts, custom date ranges, and exportable reports. Sub-200ms query performance on all views.",
            "2026", "Full Stack", ["Next.js", "PostgreSQL", "D3.js", "Prisma"], "pulse.app"),
        new("p3", "Terraform Cloud Migration Tool",
            "CLI tool that audits existing AWS infrastructure and generates Terraform configuration files. Migrated 340+ resources across 12 AWS accounts with zero downtime.",
            "2025", "Backend Engineer", ["Go", "Terraform", "AWS", "Docker"]),
        new("p4", "Wavelength Music Discovery",
            "Social music discovery platform with collaborative playlists, mood-based recommendations, and friend activity feeds. Grew to 18K monthly active users organically.",
            "2025", "Co-founder", ["React Native", "Node.js", "Spotify API", "Redis"], "wavelength.fm"),
        new("p5", "OpenBench Performance Suite",
            "Open-source benchmarking framework for JavaScript runtimes. Standardized test suite comparing Node.js, Deno, and Bun across 40 real-world workloads.",
            "2024", "Creator", ["TypeScript", "Bun", "GitHub Actions"], "github.com/openbench"),
        new("p6", "Canopy E-commerce Platform",
            "Headless commerce platform for specialty retailers with inventory sync, multi-currency checkout, and a visual page builder. Processed $2.4M in transactions in year one.",
            "2024", "Technical Lead", ["Next.js", "Stripe", "Sanity CMS", "Vercel"]),
    ];

    private static readonly string[] _years = ["2026", "2025", "2024"];

    private static readonly ProjectItem[] _projectItems = BuildItems();

    private static ProjectItem[] BuildItems()
    {
        var items = new ProjectItem[_projects.Length];
        for (var i = 0; i < _projects.Length; i++)
        {
            var prevYear = i > 0 ? _projects[i - 1].Year : null;
            var showYearHeader = _projects[i].Year != prevYear;
            var isLast = i == _projects.Length - 1;
            items[i] = new ProjectItem(_projects[i], i, showYearHeader, isLast);
        }
        return items;
    }
}
