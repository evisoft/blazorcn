@* ============================================================
   Block: timeline-version-control
   Title: TimelineVersionControl
   Description: React file version history timeline with restore actions built with Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/timeline/timeline-version-control.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Version history</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">@_versions.Length versions</span>
                <span class="text-muted-foreground/40 text-xs">·</span>
                <span class="text-muted-foreground text-xs">@FormatSize(_versions[0].SizeBytes)</span>
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-3">
            <div class="relative">
                @for (var i = 0; i < _versions.Length; i++)
                {
                    var ver = _versions[i];
                    var isLast = i == _versions.Length - 1;
                    var item = ver;
                    <div class="relative flex gap-3 pb-5 last:pb-0">
                        @* Vertical line *@
                        @if (!isLast)
                        {
                            <div class="absolute top-6 bottom-0 left-[9px] w-px bg-border"></div>
                        }

                        @* Version dot *@
                        <div class="relative z-10 flex shrink-0 pt-1">
                            <div class="@Cn.Merge("flex size-[19px] items-center justify-center rounded-full ring-2 ring-card", ver.IsCurrent ? "bg-foreground" : "border border-border bg-card")">
                                <span class="@Cn.Merge("font-mono text-[8px] font-bold leading-none", ver.IsCurrent ? "text-background" : "text-muted-foreground")">
                                    @ver.VersionNum.Replace("v", "")
                                </span>
                            </div>
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@ver.Editor</span>
                                @if (ver.Label != null)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 font-normal text-[10px]">@ver.Label</BadgeCn>
                                }
                                <span class="ml-auto shrink-0 text-muted-foreground text-xs">@ver.Timestamp</span>
                            </div>

                            <p class="mt-0.5 text-muted-foreground text-sm leading-relaxed">@ver.Summary</p>

                            <div class="mt-1.5 flex items-center gap-3">
                                <span class="font-mono text-muted-foreground text-xs">@ver.VersionNum</span>
                                <span class="text-muted-foreground/40 text-xs">·</span>
                                <span class="font-mono text-muted-foreground text-xs tabular-nums">@FormatSize(ver.SizeBytes)</span>
                                <span class="text-muted-foreground/40 text-xs">·</span>
                                <span class="@Cn.Merge("font-mono text-xs tabular-nums", ver.SizeDelta >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                    @FormatDelta(ver.SizeDelta)
                                </span>
                                @if (!ver.IsCurrent)
                                {
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="ml-auto h-6 gap-1 px-2 text-xs" @onclick="@(() => HandleRestore(item.Id))">
                                        @if (_restored == item.Id)
                                        {
                                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                                            @("Restored")
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                                            @("Restore")
                                        }
                                    </ButtonCn>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record VersionEntry(
        string Id,
        string VersionNum,
        string Editor,
        string Initials,
        string Summary,
        string Timestamp,
        int SizeBytes,
        int SizeDelta,
        bool IsCurrent = false,
        string? Label = null
    );

    private static readonly VersionEntry[] _versions =
    [
        new("v1", "v12", "Sarah Chen",    "SC", "Updated conclusion section and fixed formatting in tables",      "4 min ago",   284600,   1200, IsCurrent: true, Label: "Current"),
        new("v2", "v11", "Marcus Rivera", "MR", "Added executive summary and revised methodology paragraph",      "28 min ago",  283400,   4800),
        new("v3", "v10", "Sarah Chen",    "SC", "Replaced figure 3 with updated chart and rewrote caption",       "1 hour ago",  278600,  -2100),
        new("v4", "v9",  "Ava Patel",     "AP", "Copy-edited sections 2 through 4 for clarity and tone",          "2 hours ago", 280700,   -340, Label: "Reviewed"),
        new("v5", "v8",  "James Wilson",  "JW", "Inserted appendix A with raw survey data and footnotes",         "3 hours ago", 281040,  12400),
        new("v6", "v7",  "Marcus Rivera", "MR", "Removed duplicate references and consolidated bibliography",     "5 hours ago", 268640,  -3200),
        new("v7", "v6",  "Sarah Chen",    "SC", "Initial draft of results section with placeholder figures",      "Yesterday",   271840,  18600),
    ];

    private string? _restored;

    private async Task HandleRestore(string id)
    {
        _restored = id;
        await Task.Delay(2000);
        _restored = null;
    }

    private static string FormatSize(int bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        var kb = bytes / 1024.0;
        if (kb < 1024) return $"{kb:F1} KB";
        var mb = kb / 1024.0;
        return $"{mb:F1} MB";
    }

    private static string FormatDelta(int delta)
    {
        var abs = Math.Abs(delta);
        var formatted = abs < 1024 ? $"{abs} B" : $"{abs / 1024.0:F1} KB";
        return delta >= 0 ? $"+{formatted}" : $"-{formatted}";
    }
}
