@* ============================================================
   Block: timeline-with-avatars
   Title: TimelineWithAvatars
   Description: React vertical timeline anchored by user avatars built with Next.js, shadcn/ui Avatar, and Tailwind CSS
   Source: original/blocks/timeline/timeline-with-avatars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Team activity</span>
            </div>
            <div class="flex items-center gap-2">
                <AvatarGroupCn>
                    @foreach (var c in _uniqueContributors.Take(4))
                    {
                        <AvatarCn Class="size-6">
                            <AvatarFallbackCn Class="text-[9px]">@c.Initials</AvatarFallbackCn>
                        </AvatarCn>
                    }
                </AvatarGroupCn>
                @if (_uniqueContributors.Length > 4)
                {
                    <span class="text-muted-foreground text-xs">+@(_uniqueContributors.Length - 4)</span>
                }
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-3">
            <div class="relative">
                @foreach (var entry in _entries)
                {
                    var index = System.Array.IndexOf(_entries, entry);
                    var isLast = index == _entries.Length - 1;
                    var isExpanded = _expandedId == entry.Id;
                    var badge = GetBadge(entry.Type);
                    var entryId = entry.Id;

                    <div class="relative flex gap-3">
                        @* Timeline line + avatar node *@
                        <div class="flex flex-col items-center">
                            @* Primary avatar as the node *@
                            <div class="relative z-10 shrink-0">
                                <AvatarCn Class="ring-2 ring-card size-8">
                                    <AvatarFallbackCn Class="text-[11px]">@entry.Contributors[0].Initials</AvatarFallbackCn>
                                </AvatarCn>
                            </div>
                            @* Connector line *@
                            @if (!isLast)
                            {
                                <div class="w-px flex-1 bg-border"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@Cn.Merge("min-w-0 flex-1 pt-0.5", isLast ? "pb-0" : "pb-5")">
                            <div role="button"
                                 tabindex="0"
                                 @onclick="@(() => Toggle(entryId))"
                                 @onkeydown="@((KeyboardEventArgs e) => ToggleOnKey(entryId, e))"
                                 class="cursor-pointer">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@entry.Title</span>
                                    <span class="flex items-center gap-1">
                                        <span class="@Cn.Merge("size-1.5 rounded-full", badge.Dot)"></span>
                                        <span class="text-muted-foreground text-xs">@badge.Label</span>
                                    </span>
                                </div>
                                <div class="mt-0.5 flex items-center gap-2">
                                    <span class="text-muted-foreground text-xs">@entry.Date</span>
                                    <span class="text-muted-foreground text-xs">·</span>
                                    <span class="text-muted-foreground text-xs">
                                        @entry.Contributors[0].Name@if (entry.Contributors.Length > 1) {<text> +@(entry.Contributors.Length - 1)</text>}
                                    </span>
                                </div>
                            </div>

                            @if (isExpanded)
                            {
                                <div class="mt-2">
                                    <p class="text-muted-foreground text-sm leading-relaxed">@entry.Description</p>

                                    @* Contributors detail *@
                                    <div class="mt-3 rounded-md bg-muted/50 p-3">
                                        <span class="mb-2 block font-medium text-muted-foreground text-xs">Contributors</span>
                                        <div class="flex flex-col gap-2">
                                            @foreach (var contributor in entry.Contributors)
                                            {
                                                <div class="flex items-center gap-2">
                                                    <AvatarCn Class="size-6">
                                                        <AvatarFallbackCn Class="text-[9px]">@contributor.Initials</AvatarFallbackCn>
                                                    </AvatarCn>
                                                    <div class="min-w-0">
                                                        <span class="block font-medium text-sm">@contributor.Name</span>
                                                        <span class="block text-muted-foreground text-xs">@contributor.Role</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum EntryType { Milestone, Release, Review, Decision }

    private record Contributor(string Name, string Initials, string Role);

    private record TimelineEntry(string Id, string Date, string Title, string Description, Contributor[] Contributors, EntryType Type);

    private record BadgeInfo(string Label, string Dot);

    private static BadgeInfo GetBadge(EntryType type) => type switch
    {
        EntryType.Milestone => new("Milestone", "bg-emerald-500"),
        EntryType.Release   => new("Release",   "bg-blue-500"),
        EntryType.Review    => new("Review",    "bg-amber-500"),
        EntryType.Decision  => new("Decision",  "bg-violet-500"),
        _                   => new("",          ""),
    };

    private static readonly TimelineEntry[] _entries =
    [
        new("e1", "Mar 25, 2026",
            "API rate limiter redesign approved",
            "Reviewed and approved the new token-bucket rate limiter architecture. Migrating from fixed-window to sliding-window approach to handle traffic bursts more gracefully.",
            [
                new("Sarah Chen",    "SC", "Staff Engineer"),
                new("Marcus Rivera", "MR", "Engineering Manager"),
            ],
            EntryType.Decision),

        new("e2", "Mar 22, 2026",
            "v3.2.0 shipped to production",
            "Released the new dashboard analytics module, webhook retry system, and 14 bug fixes. Zero-downtime deployment across all 3 regions.",
            [
                new("Ava Patel",      "AP", "Senior Engineer"),
                new("James Wilson",   "JW", "DevOps Lead"),
                new("Lina Nakamura", "LN", "QA Engineer"),
            ],
            EntryType.Release),

        new("e3", "Mar 19, 2026",
            "Billing migration completed",
            "Migrated 4,200 active subscriptions from legacy billing to Stripe. All customers verified, zero payment disruptions. Revenue recognition updated.",
            [
                new("Omar Farouk", "OF", "Backend Engineer"),
            ],
            EntryType.Milestone),

        new("e4", "Mar 15, 2026",
            "Security audit passed",
            "Completed SOC 2 Type II audit with zero critical findings. Two minor observations related to log retention addressed within 48 hours.",
            [
                new("Sarah Chen",  "SC", "Staff Engineer"),
                new("Rachel Kim",  "RK", "Security Lead"),
            ],
            EntryType.Review),

        new("e5", "Mar 11, 2026",
            "Design system v2 handoff",
            "Finalized component library with 64 primitives, 12 layout patterns, and comprehensive Figma-to-code documentation. Engineering adoption begins next sprint.",
            [
                new("Lina Nakamura", "LN", "QA Engineer"),
                new("Ava Patel",     "AP", "Senior Engineer"),
                new("Marcus Rivera", "MR", "Engineering Manager"),
                new("James Wilson",  "JW", "DevOps Lead"),
            ],
            EntryType.Milestone),

        new("e6", "Mar 7, 2026",
            "Database sharding strategy finalized",
            "Selected horizontal sharding by tenant ID. Projected to handle 10x current load. Migration plan approved for Q2 execution window.",
            [
                new("Omar Farouk", "OF", "Backend Engineer"),
                new("Sarah Chen",  "SC", "Staff Engineer"),
            ],
            EntryType.Decision),
    ];

    private static readonly Contributor[] _uniqueContributors =
        _entries.SelectMany(e => e.Contributors)
                .GroupBy(c => c.Initials)
                .Select(g => g.First())
                .ToArray();

    private string? _expandedId = "e1";

    private void Toggle(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private void ToggleOnKey(string id, KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ")
            Toggle(id);
    }
}
