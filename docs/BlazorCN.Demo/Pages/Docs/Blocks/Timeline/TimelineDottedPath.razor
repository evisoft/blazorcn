@* ============================================================
   Block: timeline-dotted-path
   Title: TimelineDottedPath
   Description: React vertical timeline with dotted connector built with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/timeline/timeline-dotted-path.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Project roadshow</span>
                <div class="flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @_visitedCount of @_stops.Length stops
                    </BadgeCn>
                </div>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">Cross-country team alignment tour</p>
        </div>

        @* Dotted path timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @foreach (var stop in _stops)
                {
                    var idx = Array.IndexOf(_stops, stop);
                    var isLast = idx == _stops.Length - 1;
                    var isExpanded = _expanded == stop.Id;
                    var nodeClass = StatusNodeClass(stop.Status);
                    var dotCls = DotColorClass(stop.Status);
                    var chevronClass = isExpanded
                        ? "mt-0.5 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 rotate-90"
                        : "mt-0.5 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200";
                    <div>
                        @* Entry row *@
                        <div class="relative flex gap-4">
                            @* Node column *@
                            <div class="flex flex-col items-center">
                                @* Large node marker *@
                                <div class="@($"relative z-10 flex size-7 shrink-0 items-center justify-center rounded-full border-2 {nodeClass}")">
                                    <LucideIconCn Name="map-pin" Size="14" Class="size-3.5" />
                                    @if (stop.Status == StopStatus.Current)
                                    {
                                        <span class="absolute inset-0 animate-ping rounded-full border-2 border-blue-500 opacity-20"></span>
                                    }
                                </div>
                            </div>

                            @* Content *@
                            <div class="min-w-0 flex-1 pt-1">
                                <button type="button"
                                        class="flex w-full items-start gap-2 text-left"
                                        @onclick="@(() => ToggleExpanded(stop.Id))">
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="font-medium text-sm">@stop.Title</span>
                                        </div>
                                        <div class="mt-0.5 flex items-center gap-2">
                                            <span class="font-medium text-muted-foreground text-xs">@stop.Location</span>
                                            <span class="text-muted-foreground/40 text-xs">·</span>
                                            <span class="text-muted-foreground text-xs">@stop.Date</span>
                                            @if (stop.Duration != null)
                                            {
                                                <span class="text-muted-foreground/40 text-xs">·</span>
                                                <span class="text-muted-foreground text-xs">@stop.Duration</span>
                                            }
                                        </div>
                                    </div>
                                    <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="mt-2 rounded-md bg-muted/50 p-3">
                                        <p class="text-sm leading-relaxed">@stop.Description</p>
                                    </div>
                                }
                            </div>
                        </div>

                        @* Dotted path between entries *@
                        @if (!isLast)
                        {
                            <div class="flex items-center">
                                <div class="flex flex-col items-center" style="width:28px">
                                    <div class="flex flex-col items-center gap-1.5 py-2">
                                        @for (int d = 0; d < DotCount; d++)
                                        {
                                            <span class="@($"size-1 rounded-full {dotCls}")"></span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum StopStatus { Visited, Current, Upcoming }

    private record PathStop(
        string Id,
        string Location,
        string Date,
        string Title,
        string Description,
        StopStatus Status,
        string? Duration = null);

    private const int DotCount = 4;

    private static readonly PathStop[] _stops =
    [
        new("p1", "San Francisco", "Jan 12 - Jan 18",
            "Kickoff workshop and team alignment",
            "Three-day intensive workshop with the founding team to define product vision, map competitive landscape, and establish quarterly OKRs. Wrapped up with a 90-day sprint plan and assigned workstream owners.",
            StopStatus.Visited, "6 days"),
        new("p2", "Austin", "Feb 3 - Feb 7",
            "User research and interviews",
            "Conducted 24 in-person interviews with target users across three customer segments. Synthesized findings into 8 persona profiles and a prioritized pain-point matrix that shaped the feature roadmap.",
            StopStatus.Visited, "4 days"),
        new("p3", "New York", "Feb 24 - Feb 28",
            "Design sprint and prototyping",
            "Five-day Google Ventures-style design sprint. Produced 3 clickable prototypes and tested them with 12 users. Identified the winning concept with 83% task completion rate on first attempt.",
            StopStatus.Visited, "4 days"),
        new("p4", "Chicago", "Mar 17 - Mar 21",
            "Engineering deep dive and architecture review",
            "Reviewing the technical architecture with the platform team. Evaluating scalability constraints, dependency upgrades, and migration paths for the legacy notification system.",
            StopStatus.Current, "4 days"),
        new("p5", "Seattle", "Apr 7 - Apr 10",
            "Partner integrations summit",
            "Meeting with 6 integration partners to align on API contracts, data sharing agreements, and co-marketing opportunities. Finalizing technical specs for the top 3 requested integrations.",
            StopStatus.Upcoming, "3 days"),
        new("p6", "Denver", "Apr 28 - May 2",
            "Launch rehearsal and go-to-market prep",
            "Full launch simulation including load testing, support team training, press outreach coordination, and contingency planning. Final sign-off before the public release date.",
            StopStatus.Upcoming, "4 days"),
    ];

    private string? _expanded = "p4";

    private int _visitedCount => Array.FindAll(_stops, s => s.Status == StopStatus.Visited).Length;

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string StatusNodeClass(StopStatus status) => status switch
    {
        StopStatus.Visited => "border-emerald-500 bg-emerald-500 text-white",
        StopStatus.Current => "border-blue-500 bg-blue-500 text-white",
        _ => "border-muted-foreground/25 bg-card text-muted-foreground/40",
    };

    private static string DotColorClass(StopStatus status) => status switch
    {
        StopStatus.Visited => "bg-emerald-500/30",
        StopStatus.Current => "bg-blue-500/30",
        _ => "bg-muted-foreground/15",
    };
}
