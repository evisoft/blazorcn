@* ============================================================
   Block: hero-bento-mixed-widgets
   Title: HeroBentoMixedWidgets
   Description: A bento grid hero with asymmetric mixed widgets for React and Next.js featuring a headline tile, animated NumberFlow stat, avatar proof, sparkline chart, and testimonial tile built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-bento-mixed-widgets.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:grid-rows-2">

        @* Large headline tile — col-span-2 row-span-2 *@
        <div class="col-span-2 row-span-2 overflow-hidden rounded-2xl border bg-card px-6 py-8 sm:px-8 sm:py-10">
            @* Pill *@
            <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="font-medium">Series B announcement</span>
                <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
            </a>

            @* Headline *@
            <h1 class="mt-6 text-3xl font-bold tracking-tight sm:text-4xl md:text-5xl">
                Ship faster,<br />break less
            </h1>

            @* Subtitle *@
            <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted-foreground sm:text-base">
                One platform for your team to build, preview, and deploy with confidence.
            </p>

            @* CTAs *@
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">Learn more</ButtonCn>
            </div>
        </div>

        @* Stat tile — col-span-1 row-span-1 *@
        <div class="flex flex-col justify-between overflow-hidden rounded-2xl border bg-card p-5">
            <span class="text-xs font-medium text-muted-foreground">Active builds</span>
            <div class="mt-3 text-3xl font-semibold tabular-nums sm:text-4xl">
                24.8k
            </div>
            <span class="mt-1 text-[10px] text-emerald-600 dark:text-emerald-500">
                +12.4% this week
            </span>
        </div>

        @* Avatars + trust tile — col-span-1 row-span-1 *@
        <div class="flex flex-col justify-between overflow-hidden rounded-2xl border bg-card p-5">
            <span class="text-xs font-medium text-muted-foreground">Trusted by</span>
            <div class="mt-3 flex -space-x-2">
                @foreach (var avatar in _avatars)
                {
                    <div class="@Cn.Merge("flex size-8 items-center justify-center rounded-full border-2 border-card text-[10px] font-semibold text-white", avatar.Bg)">
                        @avatar.Initials
                    </div>
                }
                <div class="flex size-8 items-center justify-center rounded-full border-2 border-card bg-muted text-[10px] font-semibold text-foreground">
                    +9k
                </div>
            </div>
            <span class="mt-2 text-[10px] text-muted-foreground">10k+ teams building daily</span>
        </div>

        @* Sparkline tile — col-span-1 row-span-1 *@
        <div class="flex flex-col justify-between overflow-hidden rounded-2xl border bg-card p-5">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Deploys</span>
                <span class="text-[10px] text-emerald-600 dark:text-emerald-500">+38%</span>
            </div>
            <svg aria-hidden="true" viewBox="0 0 100 40" preserveAspectRatio="none" class="mt-3 h-10 w-full">
                <path d="@_sparklineArea" fill="currentColor" class="text-emerald-500/10" />
                <path d="@_sparklinePath" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500" />
            </svg>
            <span class="mt-1 text-[10px] text-muted-foreground">Last 7 days</span>
        </div>

        @* Testimonial tile — col-span-1 row-span-1 *@
        <div class="flex flex-col justify-between overflow-hidden rounded-2xl border border-blue-500/30 bg-blue-500/5 p-5">
            <LucideIconCn Name="quote" Size="16" Class="size-4 text-blue-500" />
            <p class="mt-2 text-xs leading-relaxed text-foreground">
                &ldquo;@_testimonial.Quote&rdquo;
            </p>
            <div class="mt-3 flex flex-col">
                <span class="text-[10px] font-medium">@_testimonial.Author</span>
                <span class="text-[10px] text-muted-foreground">@_testimonial.Role</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record AvatarData(string Initials, string Bg);
    private record TestimonialData(string Quote, string Author, string Role);

    private static readonly AvatarData[] _avatars =
    [
        new("MC", "bg-emerald-500"),
        new("JL", "bg-blue-500"),
        new("AP", "bg-amber-500"),
    ];

    private static readonly TestimonialData _testimonial = new(
        "Cut our deploy time from hours to minutes. It just works.",
        "Priya R.",
        "Staff Engineer, Linear"
    );

    private const string _sparklinePath =
        "M 0,28 L 14,24 L 28,26 L 42,18 L 56,20 L 70,12 L 84,14 L 100,4";

    private const string _sparklineArea =
        "M 0,40 L 0,28 L 14,24 L 28,26 L 42,18 L 56,20 L 70,12 L 84,14 L 100,4 L 100,40 Z";
}
