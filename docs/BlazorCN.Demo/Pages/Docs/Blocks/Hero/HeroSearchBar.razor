@* ========================================
   Block: hero-search-bar
   Title: Hero Search Bar
   Description: Hero block with prominent search bar and category filters
   Dependencies: BadgeCn, ButtonCn, InputCn
   Source: original/blocks/hero/hero-search-bar.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="mx-auto max-w-3xl text-center">
            <BadgeCn Class="mb-6" Variant="BadgeVariant.Secondary">
                Over 10,000 resources available
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                What can we help you <span class="text-primary">find</span>?
            </h1>

            <p class="mx-auto mb-10 max-w-xl text-lg text-muted-foreground">
                Search our extensive library of resources, guides, and documentation to find exactly
                what you need.
            </p>

            @* Search form *@
            <div class="mx-auto mb-6 max-w-2xl">
                <div class="relative">
                    <LucideSearchCn Size="20" Class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-muted-foreground" />
                    <InputCn Class="h-14 rounded-full pl-12 pr-32 text-lg shadow-lg"
                             Placeholder="Search for anything..."
                             Type="text"
                             @bind-Value="_query" />
                    <ButtonCn Class="absolute right-2 top-1/2 h-10 -translate-y-1/2 rounded-full">
                        Search
                    </ButtonCn>
                </div>
            </div>

            @* Category filters *@
            <div class="mb-8 flex flex-wrap items-center justify-center gap-2">
                @foreach (var category in _categories)
                {
                    <ButtonCn Class="rounded-full"
                              Size="ButtonSize.Sm"
                              Variant="@(_activeCategory == category ? ButtonVariant.Default : ButtonVariant.Outline)"
                              @onclick="@(() => _activeCategory = category)">
                        @category
                    </ButtonCn>
                }
            </div>

            @* Popular searches *@
            <div class="border-t pt-8">
                <p class="mb-4 text-sm text-muted-foreground">Popular searches</p>
                <div class="flex flex-wrap items-center justify-center gap-2">
                    @foreach (var search in _popularSearches)
                    {
                        <ButtonCn Class="gap-1 text-muted-foreground hover:text-foreground"
                                  Size="ButtonSize.Sm"
                                  Variant="ButtonVariant.Ghost"
                                  @onclick="@(() => _query = search)">
                            @search
                            <LucideArrowRightCn Size="12" Class="h-3 w-3" />
                        </ButtonCn>
                    }
                </div>
            </div>

            @* Stats *@
            <div class="mt-12 grid grid-cols-3 gap-8 border-t pt-8">
                <div>
                    <p class="text-2xl font-bold">10K+</p>
                    <p class="text-sm text-muted-foreground">Articles</p>
                </div>
                <div>
                    <p class="text-2xl font-bold">500+</p>
                    <p class="text-sm text-muted-foreground">Guides</p>
                </div>
                <div>
                    <p class="text-2xl font-bold">24/7</p>
                    <p class="text-sm text-muted-foreground">Support</p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _query = "";
    private string _activeCategory = "All";

    private static readonly string[] _categories = ["All", "Products", "Services", "Guides", "Support"];

    private static readonly string[] _popularSearches = ["Getting started", "API documentation", "Pricing", "Integrations", "Templates"];
}
