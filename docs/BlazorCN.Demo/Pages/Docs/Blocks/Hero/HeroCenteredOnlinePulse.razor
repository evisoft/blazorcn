@* ============================================================
   Block: hero-centered-online-pulse
   Title: HeroCenteredOnlinePulse
   Description: A centered hero with a prominent live pulsing online indicator and animated NumberFlow count for React and Next.js featuring a continuously pulsing emerald dot, avatar stack trust signal, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-online-pulse.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="flex flex-col items-center px-6 py-10 text-center sm:px-8 lg:px-12 lg:py-12">

            @* Live presence indicator *@
            <div class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs">
                @* Pulsing dot with ring *@
                <span class="relative flex size-2 items-center justify-center" aria-hidden="true">
                    <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-60"></span>
                    <span class="relative inline-flex size-1.5 rounded-full bg-emerald-500"></span>
                </span>
                <span class="font-medium">Online now</span>
                <span class="text-muted-foreground">&middot;</span>
                <span class="inline-flex items-center gap-1 text-muted-foreground tabular-nums" aria-live="polite">
                    <span>@ActiveUsers</span>
                    <span>people building right now</span>
                </span>
            </div>

            @* Headline *@
            <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl">
                The workspace
                <br />
                that never sleeps.
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                Join thousands of teams shipping in real time. Live cursors, live comments, live
                everything.
            </p>

            @* CTA row *@
            <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[180px]">Start building</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-[150px]">Watch demo</ButtonCn>
            </div>

            @* Avatar stack trust signal *@
            <div class="mt-8 flex items-center justify-center gap-3">
                <div class="flex -space-x-2" aria-hidden="true">
                    @foreach (var i in _avatarIndices)
                    {
                        <div class="size-8 rounded-full border-2 border-card bg-muted"></div>
                    }
                    <div class="flex size-8 items-center justify-center rounded-full border-2 border-card bg-muted/80 text-[10px] font-medium text-muted-foreground tabular-nums">
                        +@OverflowCount
                    </div>
                </div>
                <p class="text-xs text-muted-foreground">building with us from 40+ countries</p>
            </div>

        </div>
    </div>
</section>

@code {
    private const int ActiveUsers = 247;
    private const int TotalAvatars = 5;
    private const int OverflowCount = 242;

    private static readonly int[] _avatarIndices = [0, 1, 2, 3, 4];
}
