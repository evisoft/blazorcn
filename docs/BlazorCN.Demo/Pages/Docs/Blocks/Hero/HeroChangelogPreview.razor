@* ============================================================
   Block: hero-changelog-preview
   Title: HeroChangelogPreview
   Description: A split-layout hero with a compact changelog timeline card for React and Next.js featuring an announcement pill, two-line headline, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-changelog-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid md:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">
                @* Announcement pill *@
                <div class="mb-5">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Shipping weekly</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">200+ updates this year</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
                    We never stop<br />
                    improving
                </h1>

                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    New features every week. Bug fixes every day. Our team ships fast so you can build
                    faster.
                </p>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                    <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">Full changelog</ButtonCn>
                </div>

                <p class="mt-5 text-sm text-muted-foreground">
                    <span class="font-semibold text-foreground tabular-nums">4.2.0</span> is the
                    latest release &middot; Updated 3 days ago
                </p>
            </div>

            @* Right — changelog card *@
            <div class="flex items-center border-t bg-muted/30 p-6 md:border-l md:border-t-0 md:p-8">
                <div class="w-full overflow-hidden rounded-xl border bg-card">
                    @* Card header *@
                    <div class="flex items-center justify-between border-b px-4 py-3">
                        <span class="text-sm font-medium">Recent releases</span>
                        <a href="#" class="text-xs font-medium text-muted-foreground transition-colors hover:text-foreground">
                            View all
                        </a>
                    </div>

                    @* Entries with left-border timeline *@
                    <div class="divide-y">
                        @foreach (var rel in _releases)
                        {
                            <div class="flex gap-3 px-4 py-3">
                                @* Timeline indicator *@
                                <div class="relative flex flex-col items-center pt-1.5">
                                    <div class="size-2 rounded-full bg-muted-foreground/30"></div>
                                    <div class="mt-1 flex-1 w-px bg-border"></div>
                                </div>

                                @* Content *@
                                <div class="min-w-0 flex-1">
                                    <div class="flex flex-wrap items-center gap-1.5">
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px]">
                                            @rel.Version
                                        </BadgeCn>
                                        <span class="text-[10px] text-muted-foreground">@_typeLabels[rel.Type]</span>
                                        <span class="text-[10px] text-muted-foreground">&middot;</span>
                                        <span class="text-[10px] text-muted-foreground">@rel.Date</span>
                                    </div>
                                    <p class="mt-1 text-sm font-medium leading-snug">@rel.Title</p>
                                    <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">@rel.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Release(string Version, string Date, string Title, string Description, string Type);

    private static readonly Release[] _releases =
    [
        new("v4.2.0", "Mar 28, 2026", "AI-powered auto-complete",
            "Smart suggestions that learn from your codebase across TypeScript, Python, and Go.",
            "feature"),
        new("v4.1.3", "Mar 14, 2026", "2x faster build times",
            "Incremental builds now skip unchanged modules automatically.",
            "improvement"),
        new("v4.1.0", "Feb 28, 2026", "Team workspaces",
            "Invite your team, set permissions, and collaborate in real time.",
            "feature"),
        new("v4.0.5", "Feb 20, 2026", "Enhanced security controls",
            "SSO support, IP allowlisting, and 2FA enforcement for enterprise plans.",
            "improvement"),
    ];

    private static readonly Dictionary<string, string> _typeLabels = new()
    {
        ["feature"] = "New",
        ["improvement"] = "Improved",
        ["fix"] = "Fixed",
    };
}
