@* ============================================================
   Block: hero-integration-grid
   Title: HeroIntegrationGrid
   Description: A centered hero with a responsive 3-to-4 column grid of integration placeholder cards below the headline for React and Next.js featuring an announcement pill and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-integration-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        @* Header *@
        <div class="px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">
            @* Announcement pill *@
            <div class="mb-5">
                <a
                    href="#"
                    class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted"
                >
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium">Integrations</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">200+ connectors</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            <h1 class="mx-auto max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl">
                Connects with everything
                <br />
                you already use
            </h1>

            <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-muted-foreground">
                Seamlessly integrate with your existing tools. No custom code, no middleware — just
                connect and go.
            </p>

            <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[200px]">View integrations</ButtonCn>
                <ButtonCn Class="w-[200px]" Variant="ButtonVariant.Ghost">Request integration</ButtonCn>
            </div>
        </div>

        @* Integration grid *@
        <div class="border-t bg-muted/30 px-6 py-6 sm:px-8">
            <div class="mx-auto grid max-w-3xl grid-cols-3 gap-2.5 md:grid-cols-4">
                @foreach (var integration in _integrations)
                {
                    <div class="flex flex-col items-center gap-2.5 rounded-lg border bg-card px-3 py-4 transition-colors hover:bg-muted/50">
                        <div class="flex size-10 items-center justify-center rounded-full bg-muted">
                            <LucideIconCn Name="box" Size="18" Class="size-4.5 text-muted-foreground/60" />
                        </div>
                        <span class="text-xs font-medium text-muted-foreground">
                            @integration.Name
                        </span>
                    </div>
                }
            </div>

            <p class="mt-4 text-center text-xs text-muted-foreground">
                And 200+ more integrations available
            </p>
        </div>
    </div>
</section>

@code {
    private record Integration(string Name);

    private static readonly Integration[] _integrations =
    [
        new("Slack"),
        new("GitHub"),
        new("Stripe"),
        new("Figma"),
        new("Notion"),
        new("Linear"),
        new("Vercel"),
        new("GitLab"),
        new("Jira"),
        new("AWS"),
        new("Zapier"),
        new("Twilio"),
    ];
}
