@* ============================================================
   Block: hero-split-feature-flags
   Title: HeroSplitFeatureFlags
   Description: A split-layout hero with a feature flag dashboard mockup for React and Next.js featuring environment tabs, flag rows with rollout percentages, real shadcn/ui Switch toggles, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-feature-flags.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="grid lg:grid-cols-2">
      @* Left — copy *@
      <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">
        <div class="mb-8">
          <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="font-medium">Changelog</span>
            <span class="text-muted-foreground">·</span>
            <span class="text-muted-foreground">Scheduled rollouts are here</span>
            <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
          </a>
        </div>

        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          Ship to production
          <br />
          without holding your breath
        </h1>

        <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
          Release new features to a fraction of users, roll back in one click, and measure
          impact without ever touching a deploy pipeline.
        </p>

        <ul class="mt-6 space-y-2.5">
          @foreach (var feature in _FEATURES)
          {
            <li class="flex items-center gap-3">
              <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
              <span class="text-sm text-foreground">@feature</span>
            </li>
          }
        </ul>

        <div class="mt-8 flex items-center gap-3">
          <ButtonCn class="w-[180px]">Get started</ButtonCn>
          <ButtonCn class="w-[170px]" Variant="ButtonVariant.Ghost">Book a demo</ButtonCn>
        </div>
      </div>

      @* Right — feature flag dashboard mockup *@
      <div class="flex items-center p-6 lg:p-10">
        <div aria-hidden="true" class="w-full overflow-hidden rounded-2xl border bg-muted/50">
          @* Window chrome *@
          <div class="flex items-center gap-2 border-b bg-background/60 px-4 py-2.5">
            <div class="flex gap-1.5">
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
            </div>
            <div class="ml-2 h-2 w-24 rounded-full bg-muted-foreground/10"></div>
          </div>

          @* Environment tab strip *@
          <div class="flex items-center gap-1 border-b bg-background/40 px-3 pt-2.5">
            @foreach (var env in _ENVIRONMENTS)
            {
              var envItem = env;
              <button
                type="button"
                tabindex="-1"
                class="@(Cn.Merge("relative px-3 pb-2 text-[11px] transition-colors", (_activeEnv == envItem ? "font-medium text-foreground" : "text-muted-foreground hover:text-foreground/80")))"
                @onclick="@(() => _activeEnv = envItem)"
              >
                @envItem
                @if (_activeEnv == envItem)
                {
                  <span class="absolute inset-x-2 -bottom-[1px] h-[2px] rounded-full bg-foreground"></span>
                }
              </button>
            }
            <span class="ml-auto mb-2 inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-medium text-emerald-700 dark:text-emerald-400">
              <span class="size-1 rounded-full bg-emerald-500"></span>
              Synced
            </span>
          </div>

          @* Flag list *@
          <ul class="divide-y divide-border/60">
            @foreach (var flag in _flags)
            {
              var f = flag;
              <li class="flex items-center gap-3 px-4 py-3">
                <div class="min-w-0 flex-1">
                  <p class="truncate font-mono text-[11px] font-medium text-foreground">@f.Key</p>
                  <p class="truncate text-[10px] text-muted-foreground">@f.Description</p>
                </div>
                <span class="@(Cn.Merge("shrink-0 tabular-nums text-[10px]", (f.Rollout == 100 ? "text-emerald-600 dark:text-emerald-400" : f.Rollout == 0 ? "text-muted-foreground" : "text-foreground/80")))">
                  @f.Rollout%
                </span>
                <SwitchCn Checked="@f.Enabled" CheckedChanged="@(_ => ToggleFlag(f.Key))" tabindex="-1" />
              </li>
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

@code {
    private string _activeEnv = "Production";

    private static readonly string[] _ENVIRONMENTS = ["Production", "Staging", "Dev"];

    private static readonly string[] _FEATURES =
    [
        "Progressive rollouts with percentage targeting",
        "Environment overrides without a redeploy",
        "SDKs for every framework and runtime",
    ];

    private record FlagData(string Key, string Description, int Rollout, bool Enabled);

    private List<FlagData> _flags =
    [
        new("new-checkout",    "Two-step checkout flow",   30,  true),
        new("ai-suggestions",  "Inline copilot hints",     100, true),
        new("referral-program","Invite a friend credits",  0,   false),
        new("dark-mode-v2",    "New dark theme tokens",    100, true),
        new("legacy-billing",  "Pre-2024 plan pricing",    5,   false),
    ];

    private void ToggleFlag(string key)
    {
        var idx = _flags.FindIndex(f => f.Key == key);
        if (idx >= 0)
        {
            var f = _flags[idx];
            _flags[idx] = f with { Enabled = !f.Enabled };
        }
    }
}
