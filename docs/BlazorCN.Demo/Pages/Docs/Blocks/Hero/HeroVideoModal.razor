@* ========================================
   Block: hero-video-modal
   Title: Hero Video Modal
   Description: Hero block with play button that opens video in a modal dialog
   Dependencies: BadgeCn, ButtonCn, DialogCn
   Source: original/blocks/hero/hero-video-modal.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="mx-auto max-w-4xl text-center">
            @* Badge *@
            <BadgeCn Class="mb-6 gap-2" Variant="BadgeVariant.Secondary">
                <LucidePlayCn Size="14" Class="h-3.5 w-3.5" />
                Watch the demo
            </BadgeCn>

            @* Headline *@
            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                See how it works in <span class="text-primary">2 minutes</span>
            </h1>

            @* Subtitle *@
            <p class="mx-auto mb-10 max-w-2xl text-lg text-muted-foreground">
                Watch our quick demo to see how easy it is to get started. No signup required&#x2014;just press
                play.
            </p>

            @* Video thumbnail with play button *@
            <div class="relative mx-auto mb-10 max-w-3xl">
                <button type="button"
                        class="group relative block w-full overflow-hidden rounded-2xl shadow-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
                        @onclick="@(() => _isVideoOpen = true)">
                    @* Thumbnail image *@
                    <img alt="Video thumbnail showing product demo"
                         class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-105"
                         height="800"
                         src="https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&w=1200&q=85"
                         width="1200" />

                    @* Overlay *@
                    <div class="absolute inset-0 bg-black/40 transition-colors group-hover:bg-black/50"></div>

                    @* Play button *@
                    <div class="absolute inset-0 flex items-center justify-center">
                        <div class="relative">
                            @* Animated ring *@
                            <div class="absolute inset-0 animate-ping rounded-full bg-white/30"></div>
                            @* Play button *@
                            <div class="relative flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-lg transition-transform group-hover:scale-110 sm:h-20 sm:w-20">
                                <LucidePlayCn Size="24" Class="h-6 w-6 text-primary sm:h-8 sm:w-8" />
                            </div>
                        </div>
                    </div>

                    @* Duration badge *@
                    <div class="absolute bottom-4 right-4 rounded-md bg-black/70 px-2 py-1 text-sm font-medium text-white">
                        2:34
                    </div>
                </button>
            </div>

            @* CTA buttons *@
            <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
                <ButtonCn Class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
                    Get Started Free
                    <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                </ButtonCn>
                <ButtonCn Class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                    View Documentation
                </ButtonCn>
            </div>

            @* Trust text *@
            <p class="mt-8 text-sm text-muted-foreground">Trusted by 10,000+ teams worldwide</p>
        </div>
    </div>

    @* Video Modal *@
    <DialogCn @bind-Open="_isVideoOpen">
        <DialogContentCn Class="max-w-4xl border-none bg-black p-0 shadow-2xl">
            <DialogTitleCn Class="sr-only">Product Demo Video</DialogTitleCn>
            @* Video *@
            <div class="aspect-video w-full">
                <video autoplay class="h-full w-full" controls
                       src="https://www.w3schools.com/html/mov_bbb.mp4">
                    Your browser does not support the video tag.
                </video>
            </div>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _isVideoOpen;
}
