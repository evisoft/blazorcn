@* ============================================================
   Block: hero-centered-email-capture
   Title: HeroCenteredEmailCapture
   Description: A centered hero with an inline email capture form for React and Next.js featuring announcement pill, bold headline, ShadcnioButton submit, success state transition, and avatar stack social proof built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-email-capture.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">

            @* Announcement pill *@
            <div class="mb-6 flex justify-center">
                <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium">What's new</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">Issue #128 is out</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            @* Headline *@
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                Level up your craft,
                <br />
                one issue at a time
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-muted-foreground sm:text-lg">
                Join 12,000+ designers and developers getting weekly insights on building better
                products. No spam, unsubscribe anytime.
            </p>

            @* Newsletter form *@
            <div class="mx-auto mt-8 max-w-md">
                @if (_isSuccess)
                {
                    <div class="rounded-lg border bg-muted/50 px-6 py-5">
                        <div class="mx-auto mb-3 flex size-10 items-center justify-center rounded-full bg-foreground/[0.07]">
                            <LucideIconCn Name="check" Size="20" Class="size-5 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                        </div>
                        <p class="text-sm font-medium">You're subscribed!</p>
                        <p class="mt-1 text-sm text-muted-foreground">
                            Check your inbox for a confirmation email.
                        </p>
                    </div>
                }
                else
                {
                    <div class="flex flex-col gap-3 sm:flex-row">
                        <InputCn Class="h-12 flex-1 text-base"
                                 Type="email"
                                 Placeholder="@("you@@example.com")"
                                 @bind-Value="_email"
                                 Disabled="@_isSubmitting" />
                        <ButtonCn Class="w-[150px]"
                                  type="submit"
                                  Disabled="@_isSubmitting"
                                  @onclick="HandleSubmit">
                            @if (_isSubmitting)
                            {
                                <LucideIconCn Name="loader-2" Size="16" Class="size-4 animate-spin" />
                                <span>Subscribing</span>
                            }
                            else
                            {
                                <span>Subscribe</span>
                            }
                        </ButtonCn>
                    </div>
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <p class="mt-2 text-left text-sm text-muted-foreground">@_error</p>
                    }
                }
            </div>

            @* Social proof *@
            <div class="mt-8 flex flex-col items-center justify-center gap-5 sm:flex-row sm:gap-6">
                <div class="flex items-center gap-3">
                    <div class="flex -space-x-2">
                        @foreach (var i in Enumerable.Range(0, 5))
                        {
                            <div class="size-8 rounded-full border-2 border-background bg-muted"></div>
                        }
                    </div>
                    <p class="text-sm text-muted-foreground">
                        <span class="font-semibold text-foreground">12,437</span> subscribers
                    </p>
                </div>

                <div class="hidden h-4 w-px bg-border sm:block"></div>

                <p class="text-sm text-muted-foreground">Free forever &middot; No credit card</p>
            </div>

        </div>
    </div>
</section>

@code {
    private string _email = "";
    private bool _isSubmitting;
    private bool _isSuccess;
    private string _error = "";

    private async Task HandleSubmit()
    {
        _error = "";

        if (string.IsNullOrEmpty(_email) || !_email.Contains('@') || !_email.Contains('.'))
        {
            _error = "Please enter a valid email address";
            return;
        }

        _isSubmitting = true;
        await Task.Delay(1200);
        _isSubmitting = false;
        _isSuccess = true;
    }
}
