@* ============================================================
   Block: hero-split-commit-graph
   Title: HeroSplitCommitGraph
   Description: A split-layout hero with a git commit graph SVG mockup for React and Next.js featuring branch and merge topology, commit hashes, author avatars, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-commit-graph.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="grid lg:grid-cols-2">

      @* Left — copy *@
      <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">
        <div class="mb-8">
          <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="font-medium">New</span>
            <span class="text-muted-foreground">·</span>
            <span class="text-muted-foreground">Protected branches v2</span>
            <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
          </a>
        </div>

        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          Ship code without<br />
          losing the thread
        </h1>

        <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
          A code host that makes branch topology, reviews, and deploy previews feel like one
          continuous workflow. Built for teams that ship every day.
        </p>

        <ul class="mt-6 space-y-2.5">
          @foreach (var feature in _features)
          {
            <li class="flex items-center gap-3">
              <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
              <span class="text-sm text-foreground">@feature</span>
            </li>
          }
        </ul>

        <div class="mt-8 flex items-center gap-3">
          <ButtonCn Class="w-[180px]">Get started</ButtonCn>
          <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">View pricing</ButtonCn>
        </div>
      </div>

      @* Right — commit graph mockup *@
      <div class="flex items-center p-6 lg:p-10">
        <div aria-hidden="true" class="w-full overflow-hidden rounded-2xl border bg-muted/50">

          @* Window chrome *@
          <div class="flex items-center gap-2 border-b bg-background/60 px-4 py-2.5">
            <div class="flex gap-1.5">
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
            </div>
            <div class="ml-2 h-2 w-20 rounded-full bg-muted-foreground/10"></div>
            <div class="ml-auto flex items-center gap-1.5">
              <span class="size-1.5 rounded-full bg-foreground/60"></span>
              <span class="text-[10px] text-muted-foreground">main</span>
              <span class="ml-1.5 size-1.5 rounded-full bg-emerald-500"></span>
              <span class="text-[10px] text-muted-foreground">feature/auth</span>
              <span class="ml-1.5 size-1.5 rounded-full bg-blue-500"></span>
              <span class="text-[10px] text-muted-foreground">fix/types</span>
            </div>
          </div>

          @* Commit rows *@
          <div class="flex px-4 py-3">

            @* SVG graph column *@
            <svg class="shrink-0" height="@_svgHeight" role="presentation" viewBox="@($"0 0 120 {_svgHeight}")" width="120">
              @* Vertical branch lines *@
              <line class="stroke-foreground/60" stroke-width="1.5"
                    x1="@_branchX[0]" x2="@_branchX[0]"
                    y1="16" y2="@(_svgHeight - 16)" />
              <line class="stroke-emerald-500/70" stroke-width="1.5"
                    x1="@_branchX[1]" x2="@_branchX[1]"
                    y1="@(16 + _rowH * 1)" y2="@(16 + _rowH * 3)" />
              <line class="stroke-blue-500/70" stroke-width="1.5"
                    x1="@_branchX[2]" x2="@_branchX[2]"
                    y1="@(16 + _rowH * 2)" y2="@(16 + _rowH * 5)" />

              @* Merge curve: commit 0 (main, row 0) <- commit 1 (feature/auth, row 1) *@
              <path class="stroke-emerald-500/70 fill-none"
                    d="@($"M {_branchX[1]} {16 + _rowH * 1} C {_branchX[1]} {16 + _rowH * 0.5}, {_branchX[0]} {16 + _rowH * 0.5}, {_branchX[0]} {16 + _rowH * 0}")"
                    stroke-width="1.5" />

              @* Commit dots *@
              @foreach (var commitItem in _commits)
              {
                var ci = commitItem;
                var cy = 16 + _rowH * ci.Index;
                var cx = _branchX[ci.Branch];
                <g>
                  @if (ci.IsMerge)
                  {
                    <circle class="@(_branchFill[ci.Branch]) stroke-background"
                            cx="@cx" cy="@cy" r="4.5" stroke-width="2" />
                  }
                  else
                  {
                    <circle class="@(_branchFill[ci.Branch]) stroke-background"
                            cx="@cx" cy="@cy" r="3.5" stroke-width="2" />
                  }
                </g>
              }
            </svg>

            @* Commit messages column *@
            <ul class="-my-[2px] flex-1">
              @foreach (var commitItem in _commits)
              {
                var ci = commitItem;
                var avatarClass = ci.Branch == 0
                  ? "bg-foreground/10 text-foreground/70"
                  : ci.Branch == 1
                    ? "bg-emerald-500/15 text-emerald-700 dark:text-emerald-400"
                    : "bg-blue-500/15 text-blue-700 dark:text-blue-400";
                var msgClass = ci.IsMerge ? "truncate text-[11px] font-medium text-foreground/90" : "truncate text-[11px] text-foreground/80";
                <li class="flex items-center gap-2" style="@($"height:{_rowH}px")">
                  <div class="@($"flex size-5 shrink-0 items-center justify-center rounded-full text-[9px] font-medium {avatarClass}")">
                    @ci.Author
                  </div>
                  <span class="font-mono text-[10px] text-muted-foreground">@ci.Hash</span>
                  <span class="@msgClass">@ci.Message</span>
                </li>
              }
            </ul>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>

@code {
  private static readonly string[] _features =
  [
    "Visual branch history with zero config",
    "Inline code review on every commit",
    "CI checks and deploy previews per PR",
  ];

  private record CommitEntry(
    string Id,
    string Hash,
    int Branch,
    string Author,
    string Message,
    int Index,
    bool IsMerge = false
  );

  private static readonly CommitEntry[] _commits =
  [
    new("c1", "a3f91c2", 0, "DV", "Merge pull request #842 from feature/auth", 0, IsMerge: true),
    new("c2", "7bd4e8a", 1, "SK", "auth: add magic link flow",                  1),
    new("c3", "2e1f0b9", 2, "MR", "types: tighten event payload",               2),
    new("c4", "c98a4d1", 1, "SK", "auth: scaffold provider routes",             3),
    new("c5", "5f6b213", 0, "DV", "chore: bump next to 16.0.3",                4),
    new("c6", "9a0cc7e", 2, "MR", "types: extract api schema",                  5),
    new("c7", "1d8f4a0", 0, "DV", "docs: update readme",                        6),
  ];

  private const int _rowH = 36;
  private static readonly int[] _branchX = [28, 60, 92];
  private static readonly int _svgHeight = _commits.Length * _rowH + 16;

  private static readonly string[] _branchFill =
  [
    "fill-foreground/80",
    "fill-emerald-500",
    "fill-blue-500",
  ];
}
