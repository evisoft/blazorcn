@* ============================================================
   Block: hero-split-map-canvas
   Title: HeroSplitMapCanvas
   Description: A split-layout hero with an abstract map canvas and positioned city location dots for React and Next.js featuring an announcement pill, inline stats, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-map-canvas.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid md:grid-cols-2">

            @* Left -- copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">

                @* Announcement pill *@
                <div class="mb-5">
                    <a href="#"
                       class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Expanding</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">Now in 40+ regions</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Infrastructure<br />
                    everywhere your<br />
                    customers are
                </h1>

                @* Subtitle *@
                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    Sub-50ms latency to users worldwide with teams across 5 continents and data centers in
                    40+ regions.
                </p>

                @* CTAs *@
                <div class="mt-6 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                    <ButtonCn Class="w-[180px]" Variant="ButtonVariant.Ghost">Contact sales</ButtonCn>
                </div>

                @* Inline stats *@
                <div class="mt-6 flex items-center gap-6">
                    @foreach (var stat in _stats)
                    {
                        var isLast = stat.Label == _stats[_stats.Length - 1].Label;
                        <div class="flex items-center gap-6">
                            <div>
                                <p class="text-lg font-semibold tabular-nums">@stat.Value</p>
                                <p class="text-xs text-muted-foreground">@stat.Label</p>
                            </div>
                            @if (!isLast)
                            {
                                <div class="h-8 w-px bg-border" aria-hidden="true"></div>
                            }
                        </div>
                    }
                </div>
            </div>

            @* Right -- abstract map *@
            <div class="relative min-h-[340px] bg-muted" aria-hidden="true">

                @* Subtle grid lines *@
                <div class="absolute inset-0">
                    @foreach (var y in _gridYs)
                    {
                        <div class="absolute left-0 right-0 border-t border-dashed border-muted-foreground/[0.06]"
                             style="@($"top:{y}%")"></div>
                    }
                    @foreach (var x in _gridXs)
                    {
                        <div class="absolute bottom-0 top-0 border-l border-dashed border-muted-foreground/[0.06]"
                             style="@($"left:{x}%")"></div>
                    }
                </div>

                @* Location dots *@
                @foreach (var loc in _locations)
                {
                    <div class="absolute -translate-x-1/2 -translate-y-1/2"
                         style="@($"left:{loc.X}%;top:{loc.Y}%")">
                        @* Outer ring *@
                        <div class="absolute -inset-2 rounded-full border border-foreground/[0.06]"></div>
                        @* Dot *@
                        <div class="size-2 rounded-full bg-foreground/20"></div>
                        @* Label *@
                        <span class="absolute left-1/2 top-full mt-2 -translate-x-1/2 whitespace-nowrap text-[10px] text-muted-foreground">
                            @loc.Name
                        </span>
                    </div>
                }
            </div>

        </div>
    </div>
</section>

@code {
    private record Location(string Name, int X, int Y);
    private record Stat(string Value, string Label);

    private static readonly Location[] _locations =
    [
        new("San Francisco", 12, 38),
        new("New York",      23, 34),
        new("London",        46, 26),
        new("Singapore",     76, 58),
        new("Tokyo",         83, 35),
    ];

    private static readonly Stat[] _stats =
    [
        new("8",    "Offices"),
        new("40+",  "Regions"),
        new("187",  "Team members"),
    ];

    private static readonly int[] _gridYs = [25, 50, 75];
    private static readonly int[] _gridXs = [25, 50, 75];
}
