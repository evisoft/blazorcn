@* ============================================================
   Block: hero-announcement-bar
   Title: HeroAnnouncementBar
   Description: A centered hero section for React and Next.js with a dismissible announcement bar collapsing via AnimatePresence, bold headline, dual ShadcnioButton CTAs, and a wide image placeholder built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-announcement-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">

    @* Dismissible announcement bar *@
    @if (_showBanner)
    {
      <div class="relative overflow-hidden border-b">
        <div class="flex items-center justify-center gap-3 px-10 py-2.5">
          <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-0.5 text-xs font-medium">
            New
          </span>
          <p class="text-sm">
            We just launched v3.0 with 50+ new features.&nbsp;
            <a
              href="#"
              class="inline-flex items-center gap-1 font-medium underline-offset-4 hover:underline"
            >
              Read the announcement
              <LucideIconCn Name="external-link" Size="12" Class="size-3" />
            </a>
          </p>
          <button
            type="button"
            @onclick="@(() => _showBanner = false)"
            class="absolute right-4 rounded p-0.5 text-muted-foreground transition-colors hover:text-foreground"
            aria-label="Dismiss announcement"
          >
            <LucideIconCn Name="x" Size="16" Class="size-4" />
          </button>
        </div>
      </div>
    }

    @* Centered content *@
    <div class="px-8 py-8 text-center sm:py-10 lg:py-12">
      @* Headline *@
      <h1 class="mx-auto max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl">
        Build better products,
        <br />
        ship with confidence
      </h1>

      @* Subtitle *@
      <p class="mx-auto mt-5 max-w-lg text-lg leading-relaxed text-muted-foreground">
        The all-in-one platform for product teams to collaborate, iterate, and ship. From design
        to deployment in one workflow.
      </p>

      @* CTAs *@
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <ButtonCn Class="w-[200px]">Start free trial</ButtonCn>
        <ButtonCn Class="w-[160px]" Variant="ButtonVariant.Ghost">Watch demo</ButtonCn>
      </div>

      @* Trust text *@
      <p class="mt-6 text-sm text-muted-foreground">
        No credit card required &middot; Free for teams up to 5
      </p>
    </div>

    @* Wide image placeholder *@
    <div class="px-6 pb-6">
      <div class="flex aspect-[16/9] w-full items-center justify-center rounded-2xl bg-muted">
        <div class="relative flex items-center justify-center">
          <div class="absolute size-32 rounded-full border border-muted-foreground/[0.06]"></div>
          <div class="absolute size-20 rounded-full border border-muted-foreground/[0.08]"></div>
          <div class="absolute h-px w-40 bg-muted-foreground/[0.06]"></div>
          <div class="absolute h-40 w-px bg-muted-foreground/[0.06]"></div>
          <div class="flex size-12 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
            <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/40" />
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

@code {
  private bool _showBanner = true;
}
