@* ========================================
   Block: hero-tabs
   Title: Hero Tabs
   Description: Hero block with tabbed content sections, feature showcase, and interactive navigation
   Dependencies: BadgeCn, ButtonCn, TabsCn
   Source: original/blocks/hero/hero-tabs.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        @* Header *@
        <div class="mx-auto mb-12 max-w-3xl text-center md:mb-16">
            <BadgeCn Class="mb-6 gap-2" Variant="BadgeVariant.Secondary">
                <LucideZapCn Size="14" Class="h-3.5 w-3.5" />
                Built for everyone
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                One platform,<br />
                <span class="text-primary">endless possibilities</span>
            </h1>

            <p class="mx-auto max-w-2xl text-lg text-muted-foreground">
                Whether you're a developer, designer, or team lead, our platform adapts to your
                workflow and helps you do your best work.
            </p>
        </div>

        @* Tabbed content *@
        <TabsCn Class="mx-auto max-w-5xl" DefaultValue="developers">
            <TabsListCn Class="mx-auto mb-8 grid w-full max-w-md grid-cols-3">
                <TabsTriggerCn Class="gap-2 text-xs sm:text-sm" Value="developers">
                    <LucideCode2Cn Size="16" Class="h-4 w-4" />
                    <span class="hidden sm:inline">Developers</span>
                </TabsTriggerCn>
                <TabsTriggerCn Class="gap-2 text-xs sm:text-sm" Value="designers">
                    <LucidePaletteCn Size="16" Class="h-4 w-4" />
                    <span class="hidden sm:inline">Designers</span>
                </TabsTriggerCn>
                <TabsTriggerCn Class="gap-2 text-xs sm:text-sm" Value="teams">
                    <LucideBarChart3Cn Size="16" Class="h-4 w-4" />
                    <span class="hidden sm:inline">Teams</span>
                </TabsTriggerCn>
            </TabsListCn>

            @foreach (var tab in _tabs)
            {
                <TabsContentCn Value="@tab.Value">
                    <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
                        @* Content *@
                        <div class="flex flex-col justify-center">
                            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10">
                                <span class="text-lg text-primary">@tab.Icon</span>
                            </div>

                            <h2 class="mb-4 text-2xl font-bold sm:text-3xl">@tab.Headline</h2>

                            <p class="mb-6 text-muted-foreground">@tab.Description</p>

                            <ul class="mb-8 grid grid-cols-2 gap-3">
                                @foreach (var feature in tab.Features)
                                {
                                    <li class="flex items-center gap-2 text-sm">
                                        <div class="h-1.5 w-1.5 rounded-full bg-primary"></div>
                                        @feature
                                    </li>
                                }
                            </ul>

                            <div class="flex flex-col gap-3 sm:flex-row">
                                <ButtonCn Class="gap-2">
                                    @tab.Cta
                                    <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Outline">Learn More</ButtonCn>
                            </div>
                        </div>

                        @* Image *@
                        <div class="relative">
                            <div class="aspect-[4/3] overflow-hidden rounded-2xl bg-muted">
                                <img alt="@tab.Headline"
                                     class="h-full w-full object-cover"
                                     height="800"
                                     src="@tab.Image"
                                     width="1200" />
                            </div>
                            @* Decorative gradient *@
                            <div class="absolute -inset-4 -z-10 rounded-3xl bg-gradient-to-r from-primary/20 via-transparent to-primary/20 blur-2xl"></div>
                        </div>
                    </div>
                </TabsContentCn>
            }
        </TabsCn>
    </div>
</section>

@code {
    private record TabItem(string Value, string Icon, string Headline, string Description, string[] Features, string Image, string Cta);

    private static readonly TabItem[] _tabs =
    [
        new("developers", "\ud83d\udcbb", "Ship code faster with powerful APIs",
            "Clean, well-documented APIs that integrate in minutes. TypeScript support, webhooks, and SDKs for every major language.",
            ["RESTful & GraphQL APIs", "TypeScript SDK", "Webhook events", "CLI tools"],
            "https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&w=800&q=85",
            "View API Docs"),
        new("designers", "\ud83c\udfa8", "Design systems that scale beautifully",
            "Figma components, design tokens, and a complete UI kit that keeps your team aligned and shipping pixel-perfect interfaces.",
            ["Figma component library", "Design tokens", "Auto-layout ready", "Dark mode support"],
            "https://images.unsplash.com/photo-1561070791-2526d30994b5?auto=format&w=800&q=85",
            "Get Figma Kit"),
        new("teams", "\ud83d\udcca", "Collaborate without the chaos",
            "Real-time collaboration, version history, and powerful admin controls. Everything your team needs to work together seamlessly.",
            ["Real-time editing", "Version history", "Role-based access", "Audit logs"],
            "https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&w=800&q=85",
            "See Team Features"),
    ];
}
