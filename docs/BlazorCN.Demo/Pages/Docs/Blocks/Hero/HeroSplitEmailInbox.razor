@* ============================================================
   Block: hero-split-email-inbox
   Title: HeroSplitEmailInbox
   Description: A split-layout hero with a Gmail-style email inbox mockup for React and Next.js featuring a folder sidebar, unread and starred rows, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-email-inbox.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="grid lg:grid-cols-2">

      @* Left — copy *@
      <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">
        <div class="mb-8">
          <a href="#"
             class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="font-medium">Spring release</span>
            <span class="text-muted-foreground">·</span>
            <span class="text-muted-foreground">Snooze 2.0 is live</span>
            <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
          </a>
        </div>

        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          Email that works<br />
          as fast as you do
        </h1>

        <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
          A keyboard-first inbox that bundles, snoozes, and surfaces only what matters. Reach
          inbox zero without breaking flow.
        </p>

        <ul class="mt-6 space-y-2.5">
          @foreach (var feature in _features)
          {
            <li class="flex items-center gap-3">
              <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
              <span class="text-sm text-foreground">@feature</span>
            </li>
          }
        </ul>

        <div class="mt-8 flex items-center gap-3">
          <ButtonCn Class="w-[200px]">Start free trial</ButtonCn>
          <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">Watch demo</ButtonCn>
        </div>
      </div>

      @* Right — email inbox mockup *@
      <div class="flex items-center p-6 lg:p-10">
        <div aria-hidden="true"
             class="w-full overflow-hidden rounded-2xl border bg-muted/50">

          @* Window chrome *@
          <div class="flex items-center gap-2 border-b bg-background/60 px-4 py-2.5">
            <div class="flex gap-1.5">
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
            </div>
            <div class="ml-2 h-2 w-24 rounded-full bg-muted-foreground/10"></div>
          </div>

          @* Inbox body *@
          <div class="flex">

            @* Folder sidebar *@
            <div class="w-28 shrink-0 border-r bg-background/40 p-2">
              <ul class="space-y-0.5">
                @foreach (var folder in _folders)
                {
                  <li class="@Cn.Merge("flex items-center justify-between rounded-md px-2 py-1.5 text-[11px]", folder.Active ? "bg-foreground/[0.08] font-medium text-foreground" : "text-muted-foreground")">
                    <span class="flex items-center gap-1.5">
                      <LucideIconCn Name="@folder.Icon" Size="12" Class="size-3" />
                      <span>@folder.Label</span>
                    </span>
                    @if (!string.IsNullOrEmpty(folder.Count))
                    {
                      <span class="text-[10px] tabular-nums text-muted-foreground">@folder.Count</span>
                    }
                  </li>
                }
              </ul>
            </div>

            @* Email list *@
            <ul class="flex-1 divide-y divide-border/60">
              @foreach (var email in _emails)
              {
                <li class="@Cn.Merge("flex items-start gap-2.5 px-3 py-2.5", email.Selected ? "bg-foreground/[0.04]" : "")">
                  <div class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-foreground/[0.07] text-[9px] font-medium text-muted-foreground">
                    @email.Initials
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center justify-between gap-2">
                      <span class="@Cn.Merge("truncate text-[11px]", email.Unread ? "font-semibold text-foreground" : "text-foreground/80")">
                        @email.Sender
                      </span>
                      <span class="shrink-0 text-[10px] tabular-nums text-muted-foreground">@email.Time</span>
                    </div>
                    <p class="@Cn.Merge("truncate text-[11px]", email.Unread ? "font-medium text-foreground/90" : "text-muted-foreground")">
                      @email.Subject
                    </p>
                    <p class="truncate text-[10px] text-muted-foreground/70">@email.Snippet</p>
                  </div>
                  @if (email.Starred)
                  {
                    <LucideIconCn Name="star" Size="12" Class="mt-1 size-3 shrink-0 fill-emerald-500 text-emerald-500" />
                  }
                  @if (email.Unread && !email.Starred)
                  {
                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                  }
                </li>
              }
            </ul>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>

@code {
  private static readonly string[] _features =
  [
    "Inbox zero in minutes with smart bundling",
    "Keyboard shortcuts for every action",
    "End-to-end encryption on every message",
  ];

  private record Folder(string Id, string Label, string Count, string Icon, bool Active);

  private static readonly Folder[] _folders =
  [
    new("inbox",   "Inbox",   "12", "inbox",  true),
    new("starred", "Starred", "4",  "star",   false),
    new("sent",    "Sent",    "",   "send",   false),
  ];

  private record Email(
    string Id,
    string Initials,
    string Sender,
    string Subject,
    string Snippet,
    string Time,
    bool Unread,
    bool Starred,
    bool Selected
  );

  private static readonly Email[] _emails =
  [
    new("e1", "LM", "Linear",       "Your weekly team digest",
        "12 issues closed, 4 new cycles started this week",
        "9:42",     true,  false, false),
    new("e2", "SK", "Sofia Kim",    "Design review notes from yesterday",
        "I left some thoughts on the onboarding flow, mostly around the empty states",
        "8:15",     false, true,  false),
    new("e3", "GH", "GitHub",       "[shadcnio] PR #842 ready for review",
        "dov opened a pull request: Add keyboard shortcut for archive",
        "7:03",     false, false, true),
    new("e4", "VL", "Vercel",       "Deployment to production succeeded",
        "shadcnio.com was deployed in 42 seconds from main",
        "Yesterday", false, false, false),
    new("e5", "MR", "Marcus Reyes", "Quick question about the roadmap",
        "Hey, do you have 15 minutes on Friday to walk me through the Q3 priorities?",
        "Yesterday", false, false, false),
    new("e6", "ST", "Stripe",       "Your April invoice is available",
        "Invoice #9421 for $249.00 has been issued to your account",
        "Mon",      false, false, false),
  ];
}
