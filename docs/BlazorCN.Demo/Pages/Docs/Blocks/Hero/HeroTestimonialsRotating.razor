@* ============================================================
   Block: hero-testimonials-rotating
   Title: Hero Testimonials Rotating
   Description: Hero block with rotating testimonials and customer quotes
   Long Description: Hero block with grid of testimonial cards showing multiple customer stories
   Dependencies: AvatarCn, BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-testimonials-rotating.tsx
   ============================================================ *@

<section class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="mx-auto max-w-4xl text-center">
          <BadgeCn Class="mb-6" Variant="BadgeVariant.Secondary">
            Loved by thousands
          </BadgeCn>

          <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
            See why teams choose <span class="text-primary">our platform</span>
          </h1>

          <p class="mx-auto mb-12 max-w-2xl text-lg text-muted-foreground">
            Join over 10,000 companies that trust us to power their business. Here&apos;s what they
            have to say.
          </p>

          @* Testimonial card *@
          <CardCn Class="mx-auto mb-8 max-w-2xl">
            <CardContentCn Class="p-8">
              <LucideQuoteCn Class="mx-auto mb-6 h-10 w-10 text-primary/20" />

              <div class="min-h-[120px]">
                @{ var tIndex = 0; }
                @foreach (var testimonial in _TESTIMONIALS)
                {
                  <div
                    class="@(Cn.Merge("transition-opacity duration-500", (_currentIndex == tIndex ? "opacity-100" : "absolute opacity-0")))"
                  >
                    @if (_currentIndex == tIndex)
                    {
                      <blockquote class="mb-6 text-xl italic text-foreground">
                        &ldquo;@testimonial.Quote&rdquo;
                      </blockquote>

                      <div class="flex items-center justify-center gap-4">
                        <AvatarCn Class="h-12 w-12">
                          <AvatarImageCn alt="@testimonial.Author" src="@testimonial.Avatar" />
                          <AvatarFallbackCn>@testimonial.Author[0]</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="text-left">
                          <p class="font-semibold">@testimonial.Author</p>
                          <p class="text-sm text-muted-foreground">
                            @testimonial.Role at @testimonial.Company
                          </p>
                        </div>
                      </div>
                    }
                  </div>
                  tIndex++;
                }
              </div>

              @* Navigation dots *@
              <div class="mt-6 flex justify-center gap-2">
                @for (var i = 0; i < _TESTIMONIALS.Length; i++)
                {
                  var dotIndex = i;
                  <button
                    type="button"
                    aria-label="@($"Go to testimonial {dotIndex + 1}")"
                    class="@(Cn.Merge("h-2 w-2 rounded-full transition-colors", (_currentIndex == dotIndex ? "bg-primary" : "bg-muted-foreground/30")))"
                    @onclick="@(() => _currentIndex = dotIndex)"
                  ></button>
                }
              </div>
            </CardContentCn>
          </CardCn>

          @* CTA buttons *@
          <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
            <ButtonCn Class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
              Start Free Trial
              <LucideArrowRightCn Size="16" Class="h-4 w-4" />
            </ButtonCn>
            <ButtonCn Class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
              View All Reviews
            </ButtonCn>
          </div>
        </div>
      </div>
    </section>

@code {
    private int _currentIndex = 0;

    private record TestimonialData(string Quote, string Author, string Role, string Company, string Avatar);

    private static readonly TestimonialData[] _TESTIMONIALS = new[]
    {
        new TestimonialData("This platform changed everything for our team. We shipped 3x faster.", "Alex Thompson", "Engineering Lead", "TechCorp", "https://i.pravatar.cc/150?img=1"),
        new TestimonialData("The best developer experience I've ever had. Absolutely love it.", "Maria Garcia", "VP of Product", "StartupHQ", "https://i.pravatar.cc/150?img=2"),
        new TestimonialData("Our productivity soared. Can't imagine going back to our old tools.", "James Wilson", "CTO", "DevStudio", "https://i.pravatar.cc/150?img=3"),
    };
}
