@* ========================================
   Block: hero-app-download
   Title: Hero App Download
   Description: Hero block with app store download buttons for mobile apps
   Long Description: Hero block with prominent announcement banner and news highlight
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-app-download.tsx
   ======================================== *@

<section class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
          @* Left content *@
          <div class="text-center lg:text-left">
            <BadgeCn class="mb-6 gap-2" Variant="BadgeVariant.Secondary">
              <LucideDownloadCn Size="12" Class="h-3.5 w-3.5" />
              Available Now
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
              Your life, organized in <span class="text-primary">one app</span>
            </h1>

            <p class="mb-8 text-lg text-muted-foreground">
              The all-in-one productivity app that helps you manage tasks, habits, and goals.
              Available on iOS and Android.
            </p>

            @* App store buttons *@
            <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:justify-center lg:justify-start">
              <ButtonCn class="h-14 gap-3 px-6" Size="ButtonSize.Lg">
                <LucideAppleCn Size="24" Class="h-6 w-6" />
                <div class="text-left">
                  <div class="text-xs font-normal opacity-80">Download on the</div>
                  <div class="text-sm font-semibold">App Store</div>
                </div>
              </ButtonCn>
              <ButtonCn class="h-14 gap-3 px-6" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                <LucidePlayCn Size="24" Class="h-6 w-6" />
                <div class="text-left">
                  <div class="text-xs font-normal opacity-80">Get it on</div>
                  <div class="text-sm font-semibold">Google Play</div>
                </div>
              </ButtonCn>
            </div>

            @* Stats *@
            <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-muted-foreground lg:justify-start">
              <div class="flex items-center gap-1">
                <LucideStarCn Size="16" Class="h-4 w-4 fill-yellow-400 text-yellow-400" />
                <span class="font-semibold text-foreground">4.9</span>
                <span>rating</span>
              </div>
              <div class="flex items-center gap-1">
                <span class="font-semibold text-foreground">500K+</span>
                <span>downloads</span>
              </div>
              <div class="flex items-center gap-1">
                <span class="font-semibold text-foreground">#1</span>
                <span>in Productivity</span>
              </div>
            </div>
          </div>

          @* Right content - Phone mockup *@
          <div class="flex items-center justify-center">
            <div class="relative">
              @* Phone frame *@
              <div class="relative mx-auto h-[500px] w-[250px] rounded-[3rem] border-[8px] border-foreground bg-background p-2 shadow-xl">
                @* Notch *@
                <div class="absolute left-1/2 top-0 h-6 w-24 -translate-x-1/2 rounded-b-xl bg-foreground" ></div>
                @* Screen *@
                <div class="flex h-full w-full items-center justify-center rounded-[2.5rem] bg-muted">
                  <p class="px-4 text-center text-sm text-muted-foreground">
                    App screenshot placeholder
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

