@* ============================================================
   Block: hero-enterprise-grade
   Title: HeroEnterpriseGrade
   Description: A dark centered hero for React and Next.js with compliance badges row, bottom stats bar, and inverted ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-enterprise-grade.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border">
        @* Dark hero section *@
        <div class="bg-foreground px-6 py-10 text-center sm:px-10 sm:py-12 lg:py-14">
            @* Shield pill *@
            <div class="mb-6 flex justify-center">
                <span class="inline-flex items-center gap-2 rounded-full border border-background/20 px-3 py-1 text-xs">
                    <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-background/60" />
                    <span class="font-medium text-background">Enterprise ready</span>
                </span>
            </div>

            @* Headline *@
            <h1 class="mx-auto max-w-2xl text-4xl font-bold tracking-tight text-background sm:text-5xl">
                Security your CISO<br />will sign off on
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-background/50">
                Built for organizations where compliance is a requirement, not a feature.
                Enterprise-grade infrastructure with the certifications your team demands.
            </p>

            @* CTAs *@
            <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[180px] bg-background text-foreground hover:bg-background/90">
                    Contact sales
                </ButtonCn>
                <ButtonCn Class="w-[200px] border border-background/20 bg-transparent text-background hover:bg-background/10" Variant="ButtonVariant.Ghost">
                    View security page
                </ButtonCn>
            </div>

            @* Compliance badges *@
            <div class="mt-8 flex flex-wrap items-center justify-center gap-2.5">
                @foreach (var badge in _complianceBadges)
                {
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-background/15 px-3 py-1.5">
                        <span class="text-xs font-medium text-background/80">@badge.Name</span>
                        <span class="text-[10px] text-background/35">@badge.Detail</span>
                    </span>
                }
            </div>
        </div>

        @* Stats bar — light section *@
        <div class="border-t bg-muted/30 px-6 py-6 sm:px-8 sm:py-8">
            <div class="mx-auto grid max-w-3xl grid-cols-2 gap-6 md:grid-cols-4 md:gap-8">
                @foreach (var stat in _stats)
                {
                    <div class="text-center">
                        <p class="text-2xl font-semibold tabular-nums">@stat.Value</p>
                        <p class="mt-1 text-xs text-muted-foreground">@stat.Label</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ComplianceBadge(string Name, string Detail);
    private record Stat(string Value, string Label);

    private static readonly ComplianceBadge[] _complianceBadges =
    [
        new("SOC 2 Type II", "Audited annually"),
        new("GDPR", "EU compliant"),
        new("HIPAA", "Healthcare ready"),
        new("ISO 27001", "Certified"),
    ];

    private static readonly Stat[] _stats =
    [
        new("99.99%", "Uptime SLA"),
        new("50M+", "API requests / day"),
        new("<50ms", "Avg response time"),
        new("24/7", "Priority support"),
    ];
}
