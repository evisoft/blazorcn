@* ========================================
   Block: hero-code-preview
   Title: Hero Code Preview
   Description: Hero with code snippet preview, syntax highlighting, and copy-to-clipboard functionality
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-code-preview.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div class="flex flex-col justify-center">
                <BadgeCn Class="mb-6 w-fit gap-2" Variant="BadgeVariant.Secondary">
                    <LucideTerminalCn Size="14" Class="h-3.5 w-3.5" />
                    Developer-first platform
                </BadgeCn>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    Build faster with <span class="text-primary">three lines of code</span>
                </h1>

                <p class="mb-8 text-lg text-muted-foreground">
                    Stop wrestling with infrastructure. Our SDK handles the complexity so you can focus on
                    building features your users actually want.
                </p>

                <div class="flex flex-col gap-4 sm:flex-row">
                    <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                        Get API Key
                        <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                        Read the Docs
                    </ButtonCn>
                </div>

                <div class="mt-8 flex flex-wrap items-center gap-6 text-sm text-muted-foreground">
                    <div class="flex items-center gap-2">
                        <LucideCheckCn Size="16" Class="h-4 w-4 text-green-500" />
                        Free tier included
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideCheckCn Size="16" Class="h-4 w-4 text-green-500" />
                        No credit card required
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideCheckCn Size="16" Class="h-4 w-4 text-green-500" />
                        TypeScript support
                    </div>
                </div>
            </div>

            <div class="relative">
                <div class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950 shadow-2xl">
                    <div class="flex items-center justify-between border-b border-zinc-800 px-4 py-3">
                        <div class="flex items-center gap-2">
                            <div class="flex gap-1.5">
                                <div class="h-3 w-3 rounded-full bg-zinc-700"></div>
                                <div class="h-3 w-3 rounded-full bg-zinc-700"></div>
                                <div class="h-3 w-3 rounded-full bg-zinc-700"></div>
                            </div>
                            <span class="ml-2 text-xs text-zinc-500">index.ts</span>
                        </div>
                        <ButtonCn Class="h-8 gap-2 text-zinc-400 hover:text-zinc-100" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                            @if (_copied)
                            {
                                <LucideCheckCn Size="14" Class="h-3.5 w-3.5" />
                                <span>Copied</span>
                            }
                            else
                            {
                                <LucideCopyCn Size="14" Class="h-3.5 w-3.5" />
                                <span>Copy</span>
                            }
                        </ButtonCn>
                    </div>

                    <div class="overflow-x-auto p-4">
                        <pre class="text-sm leading-relaxed"><code><span class="text-zinc-500">npm install </span><span class="text-green-400">@@acme/sdk</span>

<span class="text-purple-400">import</span><span class="text-zinc-100"> { </span><span class="text-yellow-400">Acme</span><span class="text-zinc-100"> } </span><span class="text-purple-400">from</span><span class="text-green-400"> '@@acme/sdk'</span>

<span class="text-purple-400">const</span><span class="text-zinc-100"> client </span><span class="text-purple-400">=</span><span class="text-purple-400"> new</span><span class="text-yellow-400"> Acme</span><span class="text-zinc-100">({ apiKey: </span><span class="text-green-400">'sk_...'</span><span class="text-zinc-100"> })</span>

<span class="text-purple-400">const</span><span class="text-zinc-100"> result </span><span class="text-purple-400">=</span><span class="text-purple-400"> await</span><span class="text-zinc-100"> client.</span><span class="text-blue-400">generate</span><span class="text-zinc-100">({</span>
<span class="text-zinc-100">  prompt: </span><span class="text-green-400">'Build something amazing'</span>
<span class="text-zinc-100">})</span></code></pre>
                    </div>
                </div>

                <div class="absolute -inset-x-4 -bottom-4 h-32 bg-gradient-to-t from-background via-background/80 to-transparent lg:hidden"></div>
            </div>
        </div>
    </div>
</section>

@code {
    private bool _copied;
}
