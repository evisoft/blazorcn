@* ============================================================
   Block: hero-split-log-viewer
   Title: HeroSplitLogViewer
   Description: A split-layout hero with a dark server log viewer mockup for React and Next.js featuring live-tail logs, leveled tags, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-log-viewer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">
                @* Announcement pill *@
                <div class="mb-8">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Live tail</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">Sub-second ingest</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Search every log
                    <br />
                    before the alert fires
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
                    Ship structured logs from every service and query them in milliseconds. No index
                    limits, no sampling, no surprise bills at the end of the month.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[200px]">Start free trial</ButtonCn>
                    <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">View pricing</ButtonCn>
                </div>
            </div>

            @* Right — log viewer mockup *@
            <div class="flex items-center p-6 lg:p-10">
                <div aria-hidden="true" class="w-full overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-950 font-mono shadow-xl">
                    @* Header with live indicator and filter *@
                    <div class="flex items-center gap-3 border-b border-zinc-800 bg-zinc-900/80 px-4 py-2.5">
                        <div class="flex items-center gap-2">
                            <span class="relative flex size-2">
                                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-60"></span>
                                <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
                            </span>
                            <span class="text-[10px] font-medium tracking-wider text-emerald-400 uppercase">
                                Live
                            </span>
                        </div>
                        <div class="flex-1">
                            <div class="flex h-6 items-center rounded-md border border-zinc-800 bg-zinc-900 px-2 text-[11px] text-zinc-500">
                                service:* level:ERROR
                            </div>
                        </div>
                        <span class="text-[10px] text-zinc-600">9 events</span>
                    </div>

                    @* Log rows *@
                    <div class="divide-y divide-zinc-900/80">
                        @foreach (var line in _logLines)
                        {
                            var rowClass = Cn.Merge("flex items-start gap-3 px-4 py-1.5 text-[11px] leading-5", line.Highlight ? "bg-red-500/[0.07]" : "");
                            var badgeClass = Cn.Merge("shrink-0 rounded px-1.5 text-[10px] font-semibold tracking-wide", _levelStyles[line.Level]);
                            <div class="@rowClass">
                                <span class="shrink-0 tabular-nums text-zinc-600">@line.Time</span>
                                <span class="@badgeClass">
                                    @line.Level
                                </span>
                                <span class="shrink-0 text-zinc-500">@line.Service</span>
                                <span class="truncate text-zinc-300">@line.Message</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Tail structured logs across every service in real time",
        "Millisecond search and filters over terabytes per day",
        "SOC 2 ready with encrypted ingest and audit trails",
    ];

    private static readonly Dictionary<string, string> _levelStyles = new()
    {
        ["INFO"]  = "bg-blue-500/15 text-blue-300",
        ["WARN"]  = "bg-amber-500/15 text-amber-300",
        ["ERROR"] = "bg-red-500/20 text-red-300",
        ["DEBUG"] = "bg-zinc-500/15 text-zinc-400",
    };

    private record LogLine(string Time, string Level, string Service, string Message, bool Highlight = false);

    private static readonly LogLine[] _logLines =
    [
        new("14:22:01", "INFO",  "api-gateway", "Request GET /v1/users 200 in 42ms"),
        new("14:22:02", "DEBUG", "auth",         "Token verified for user_8a4c region=eu-west-1"),
        new("14:22:03", "INFO",  "worker",       "Processed job billing.invoice.send id=ivc_2817"),
        new("14:22:04", "WARN",  "api-gateway",  "Upstream latency exceeded 500ms threshold"),
        new("14:22:05", "ERROR", "payments",     "Stripe webhook signature mismatch evt_9f3a — retrying", true),
        new("14:22:05", "INFO",  "auth",         "Session refreshed for user_1b7e"),
        new("14:22:06", "DEBUG", "worker",       "Queue depth=12 inflight=3 waiting=9"),
        new("14:22:07", "INFO",  "api-gateway",  "Request POST /v1/webhooks 201 in 88ms"),
        new("14:22:08", "WARN",  "cache",        "Redis evicted 214 keys under memory pressure"),
    ];
}
