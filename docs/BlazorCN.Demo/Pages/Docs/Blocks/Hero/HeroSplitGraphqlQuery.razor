@* ============================================================
   Block: hero-split-graphql-query
   Title: HeroSplitGraphqlQuery
   Description: A split-layout hero with a dark GraphQL code editor mockup and a collapsible schema explorer panel for React and Next.js built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-graphql-query.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-2">

            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">

                @* Announcement pill *@
                <div class="mb-8">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Federation v2</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">Contracts now GA</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Query anything,<br />
                    fetch exactly what you need
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
                    A managed GraphQL layer that unifies every service behind one typed schema — with zero
                    boilerplate.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                    <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">Explore schema</ButtonCn>
                </div>
            </div>

            @* Right — GraphQL editor mockup *@
            <div class="flex items-center p-6 lg:p-8">
                <div class="w-full overflow-hidden rounded-2xl border bg-zinc-950" aria-hidden="true">

                    @* Chrome *@
                    <div class="flex items-center gap-2 border-b border-zinc-800 bg-zinc-900/60 px-4 py-2.5">
                        <div class="flex gap-1.5">
                            <span class="size-2 rounded-full bg-zinc-700"></span>
                            <span class="size-2 rounded-full bg-zinc-700"></span>
                            <span class="size-2 rounded-full bg-zinc-700"></span>
                        </div>
                        <span class="ml-2 font-mono text-[10px] text-zinc-500">GetUser.graphql</span>
                    </div>

                    @* Editor + explorer body *@
                    <div class="flex min-h-[280px]">

                        @* Schema explorer *@
                        <div class="w-[104px] shrink-0 border-r border-zinc-800 bg-zinc-900/40 px-2 py-3">
                            <div class="mb-2 px-1 text-[9px] font-medium uppercase tracking-wider text-zinc-500">
                                Schema
                            </div>
                            <ul class="space-y-1">
                                @foreach (var schemaType in _schemaTypes)
                                {
                                    <li>
                                        <div class="flex items-center gap-1 rounded-sm px-1 py-1 text-[10px] text-zinc-300">
                                            @if (schemaType.Expanded)
                                            {
                                                <LucideIconCn Name="chevron-down" Size="12" Class="size-3 text-zinc-500" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="chevron-right" Size="12" Class="size-3 text-zinc-500" />
                                            }
                                            <span class="text-sky-300">@schemaType.Name</span>
                                        </div>
                                        @if (schemaType.Expanded && schemaType.Fields.Length > 0)
                                        {
                                            <ul class="ml-4 mt-0.5 space-y-0.5">
                                                @foreach (var field in schemaType.Fields)
                                                {
                                                    <li class="px-1 py-0.5 font-mono text-[9px] text-zinc-400">@field</li>
                                                }
                                            </ul>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>

                        @* Query editor *@
                        <div class="flex-1 px-4 py-3">
                            <div class="mb-2 flex items-center justify-between">
                                <span class="text-[9px] font-medium uppercase tracking-wider text-zinc-500">
                                    Query
                                </span>
                                <span class="font-mono text-[9px] text-zinc-500">1 op</span>
                            </div>
                            <div class="font-mono text-[11px] leading-[1.7]">
                                @foreach (var lineEntry in _queryLinesIndexed)
                                {
                                    var lineIdx = lineEntry.Index;
                                    var line = lineEntry.Tokens;
                                    <div class="flex whitespace-pre">
                                        <span class="w-5 shrink-0 select-none text-right text-zinc-600">@(lineIdx + 1)</span>
                                        <span class="pl-2">
                                            @foreach (var token in line)
                                            {
                                                <span class="@token.ClassName">@token.Value</span>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record QueryToken(string Value, string ClassName);
    private record SchemaTypeItem(string Name, string[] Fields, bool Expanded);
    private record IndexedLine(int Index, QueryToken[] Tokens);

    private static readonly string[] _features =
    [
        "Type-safe queries with generated TypeScript clients",
        "Persisted queries and automatic field-level caching",
        "Federated schema composition across 20+ services",
    ];

    private static readonly QueryToken[][] _queryLines =
    [
        [
            new("query", "text-pink-400"),
            new(" ", ""),
            new("GetUser", "text-sky-300"),
            new(" {", "text-zinc-500"),
        ],
        [
            new("  user", "text-sky-300"),
            new("(", "text-zinc-500"),
            new("id", "text-amber-300"),
            new(": ", "text-zinc-500"),
            new("1", "text-emerald-300"),
            new(") {", "text-zinc-500"),
        ],
        [ new("    name", "text-sky-300") ],
        [ new("    email", "text-sky-300") ],
        [
            new("    posts", "text-sky-300"),
            new(" {", "text-zinc-500"),
        ],
        [ new("      title", "text-sky-300") ],
        [ new("      publishedAt", "text-sky-300") ],
        [ new("    }", "text-zinc-500") ],
        [ new("  }", "text-zinc-500") ],
        [ new("}", "text-zinc-500") ],
    ];

    private static readonly SchemaTypeItem[] _schemaTypes =
    [
        new("User", ["id", "name", "email", "posts"], true),
        new("Post", [], false),
        new("Comment", [], false),
    ];

    private static readonly IndexedLine[] _queryLinesIndexed =
        _queryLines.Select((line, idx) => new IndexedLine(idx, line)).ToArray();
}
