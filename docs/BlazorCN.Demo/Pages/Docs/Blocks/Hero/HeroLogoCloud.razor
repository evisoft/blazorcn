@* ============================================================
   Block: hero-logo-cloud
   Title: Hero Logo Cloud
   Description: Hero block with prominent logo cloud, trust indicators, and enterprise-focused messaging
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-logo-cloud.tsx
   ============================================================ *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="mx-auto max-w-4xl text-center">
            <BadgeCn Class="mb-6 gap-2 px-4 py-2" Variant="BadgeVariant.Outline">
                <LucideShieldCn Size="14" Class="h-3.5 w-3.5" />
                Trusted by industry leaders
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                The platform that powers <span class="text-primary">modern teams</span>
            </h1>

            <p class="mx-auto mb-10 max-w-2xl text-lg text-muted-foreground sm:text-xl">
                Join thousands of companies using our platform to build better products, faster.
                Enterprise-grade security, world-class support.
            </p>

            <div class="mb-16 flex flex-col items-center justify-center gap-4 sm:flex-row">
                <ButtonCn Class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
                    Start Free Trial
                    <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                </ButtonCn>
                <ButtonCn Class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                    Contact Sales
                </ButtonCn>
            </div>
        </div>

        <div class="mx-auto max-w-5xl">
            <p class="mb-8 text-center text-sm font-medium text-muted-foreground">
                POWERING THE WORLD'S BEST PRODUCT TEAMS
            </p>

            <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
                @foreach (var logo in _logos)
                {
                    <img alt="@logo.Name" class="h-10 w-auto grayscale opacity-60 transition-all duration-300 hover:grayscale-0 hover:opacity-100 dark:brightness-200 dark:hover:brightness-100"
                         height="800" src="@logo.Url" width="1200" />
                }
            </div>

            <div class="mt-12 flex flex-wrap items-center justify-center gap-8 text-center">
                <div class="flex items-center gap-2">
                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/30">
                        <LucideShieldCn Size="20" Class="h-5 w-5 text-green-600 dark:text-green-400" />
                    </div>
                    <div class="text-left">
                        <p class="text-sm font-semibold">SOC 2 Certified</p>
                        <p class="text-xs text-muted-foreground">Enterprise security</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-100 dark:bg-blue-900/30">
                        <span class="text-lg font-bold text-blue-600 dark:text-blue-400">99%</span>
                    </div>
                    <div class="text-left">
                        <p class="text-sm font-semibold">Customer Satisfaction</p>
                        <p class="text-xs text-muted-foreground">Based on 5,000+ reviews</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Logo(string Name, string Url);

    private static readonly Logo[] _logos =
    [
        new("Vercel", "https://www.vectorlogo.zone/logos/vercel/vercel-ar21.svg"),
        new("Stripe", "https://www.vectorlogo.zone/logos/stripe/stripe-ar21.svg"),
        new("Notion", "https://www.vectorlogo.zone/logos/notion/notion-ar21.svg"),
        new("Slack", "https://www.vectorlogo.zone/logos/slack/slack-ar21.svg"),
        new("Linear", "https://www.vectorlogo.zone/logos/linear/linear-ar21.svg"),
        new("Figma", "https://www.vectorlogo.zone/logos/figma/figma-ar21.svg"),
        new("GitHub", "https://www.vectorlogo.zone/logos/github/github-ar21.svg"),
        new("GitLab", "https://www.vectorlogo.zone/logos/gitlab/gitlab-ar21.svg"),
    ];
}
