@* ============================================================
   Block: hero-split-chat-skeleton
   Title: HeroSplitChatSkeleton
   Description: A split-layout hero with a minimal AI chat skeleton mockup for React and Next.js featuring an announcement pill, emerald feature checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-chat-skeleton.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="grid lg:grid-cols-2">
      @* Left — copy *@
      <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">
        @* Announcement pill *@
        <div class="mb-8">
          <a
            href="#"
            class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted"
          >
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="font-medium">What&apos;s new</span>
            <span class="text-muted-foreground">·</span>
            <span class="text-muted-foreground">AI v2.0 is here</span>
            <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
          </a>
        </div>

        @* Headline *@
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          Ship faster with<br />
          AI at the core
        </h1>

        @* Subtitle *@
        <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
          An AI copilot that understands your entire stack. Ask questions, generate code, and
          debug issues — all from one interface.
        </p>

        @* Feature checklist *@
        <ul class="mt-6 space-y-2.5">
          @foreach (var feature in _features)
          {
            <li class="flex items-center gap-3">
              <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
              <span class="text-sm text-foreground">@feature</span>
            </li>
          }
        </ul>

        @* CTAs *@
        <div class="mt-8 flex items-center gap-3">
          <ButtonCn Class="w-[180px]">Get started</ButtonCn>
          <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">Learn more</ButtonCn>
        </div>
      </div>

      @* Right — AI interface mockup *@
      <div class="flex items-center p-6 lg:p-10">
        <div
          class="w-full overflow-hidden rounded-2xl border bg-muted/50"
          aria-hidden="true"
        >
          @* Window chrome *@
          <div class="flex items-center gap-2 border-b bg-background/60 px-4 py-2.5">
            <div class="flex gap-1.5">
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
            </div>
            <div class="ml-2 h-2 w-20 rounded-full bg-muted-foreground/10"></div>
          </div>

          <div class="space-y-5 p-5 sm:p-6">
            @* User prompt — skeleton lines *@
            <div class="flex items-start gap-2.5">
              <div class="mt-0.5 size-6 shrink-0 rounded-full bg-muted-foreground/10"></div>
              <div class="flex-1 space-y-1.5">
                <div class="h-2 w-3/4 rounded-full bg-muted-foreground/12"></div>
                <div class="h-2 w-1/2 rounded-full bg-muted-foreground/8"></div>
              </div>
            </div>

            @* AI response — skeleton with bot icon *@
            <div class="flex items-start gap-2.5">
              <div class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-foreground/[0.07]">
                <LucideIconCn Name="bot-message-square" Size="12" Class="size-3 text-muted-foreground/50" />
              </div>
              <div class="flex-1 space-y-1.5">
                <div class="h-2 w-full rounded-full bg-muted-foreground/10"></div>
                <div class="h-2 w-11/12 rounded-full bg-muted-foreground/8"></div>
                <div class="h-2 w-4/5 rounded-full bg-muted-foreground/10"></div>
              </div>
            </div>

            @* Prompt input — skeleton *@
            <div class="flex items-center gap-2 rounded-lg border bg-background/60 px-3 py-2">
              <div class="size-3.5 rounded bg-muted-foreground/10"></div>
              <div class="h-2 w-24 rounded-full bg-muted-foreground/8"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

@code {
  private static readonly string[] _features =
  [
    "Context-aware AI that understands your codebase",
    "Sub-200ms responses across 40+ languages",
    "Enterprise-grade security with SOC 2 compliance",
  ];
}
