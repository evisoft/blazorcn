@* ============================================================
   Block: hero-email-signup
   Title: Hero Email Signup
   Description: Hero section with navbar, badge announcement, email signup form, and full-width image
   Long Description: Dark themed hero with app store buttons
   Dependencies: BadgeCn, ButtonCn, InputCn, SeparatorCn
   Source: original/blocks/hero/hero-email-signup.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
<header class="relative">
      <div class="container mx-auto px-4">
      </div>
      <div class="container mx-auto px-4 py-12 md:py-20 lg:py-28">
        <div class="mb-16 text-center">
          <BadgeCn Class="mb-6 gap-1.5 px-3 py-1.5" Variant="BadgeVariant.Secondary">
            <LucideInfoCn Size="12" Class="h-3.5 w-3.5" />
            Exciting News! Introducing our latest innovation
          </BadgeCn>
          <h1 class="mx-auto mb-6 max-w-4xl scroll-m-20 text-center text-4xl !leading-tight font-bold tracking-tight [text-wrap:_balance] md:text-5xl lg:text-6xl">
            Get ready to experience a new level of <span class="text-primary">performance</span> 
            and <span class="text-primary">functionality</span>.
          </h1>
          <p class="text-muted-foreground mx-auto mb-10 max-w-2xl text-center text-base leading-relaxed md:text-lg lg:text-xl">
            The time is now for it to be okay to be great. For being a bright color. For standing
            out.
          </p>
          <form action="#" class="mx-auto w-full max-w-lg">
            <div class="flex w-full flex-col items-center gap-3 sm:flex-row">
              <InputCn
                Class="h-11 w-full"
                id="email"
                Placeholder="@("someone@@example.com")"
                type="email"
              />
              <ButtonCn Class="w-full shrink-0 sm:w-auto" Size="ButtonSize.Lg" type="submit">
                Get Started
              </ButtonCn>
            </div>
          </form>
        </div>
        <div class="relative h-[40vh] w-full overflow-hidden rounded-2xl shadow-2xl sm:h-[50vh] md:h-[60vh] lg:h-[70vh]">
          <img
            alt="Modern architecture and design"
            class="h-full w-full object-cover object-center"
            height="800"
            src="https://images.unsplash.com/photo-1573588028698-f4759befb09a?auto=format&w=2000&q=85"
            width="1200"
          />
        </div>
      </div>
    </header>
</section>

