@* ============================================================
   Block: hero-browser-frame
   Title: HeroBrowserFrame
   Description: A split-layout hero for React and Next.js with a large browser frame mockup on the right, announcement pill, headline, emerald feature checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-browser-frame.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid md:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-6 py-8 sm:px-10 md:py-10 lg:px-14 lg:py-12">
                @* Announcement pill *@
                <div class="mb-5">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Just shipped</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">Edge Functions v2</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
                    Ship faster,<br />
                    worry less
                </h1>

                @* Subtitle *@
                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    The deployment platform that handles infrastructure so your team can focus on building
                    great products.
                </p>

                @* Feature checklist *@
                <ul class="mt-5 space-y-2">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-2.5">
                            <LucideIconCn Name="check" Size="16" StrokeWidth="3" Class="size-4 shrink-0 text-emerald-600 dark:text-emerald-500" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-7 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Start deploying</ButtonCn>
                    <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">View docs</ButtonCn>
                </div>
            </div>

            @* Right — browser frame *@
            <div class="relative flex items-center justify-center bg-muted p-6 md:p-8 lg:p-10" aria-hidden="true">
                <div class="w-full">
                    <div class="overflow-hidden rounded-lg border bg-card shadow-md">
                        @* Browser chrome *@
                        <div class="flex items-center gap-1.5 border-b bg-muted/50 px-3 py-2">
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            <div class="ml-2.5 flex flex-1 items-center gap-2 rounded-md border bg-background px-2.5 py-1">
                                <div class="size-2.5 rounded-sm bg-muted-foreground/10"></div>
                                <div class="h-1.5 w-28 rounded-full bg-muted-foreground/[0.07]"></div>
                            </div>
                        </div>

                        @* Crosshair image placeholder *@
                        <div class="flex aspect-[16/10] w-full items-center justify-center bg-muted/30">
                            <div class="relative flex items-center justify-center">
                                <div class="absolute size-24 rounded-full border border-muted-foreground/[0.06]"></div>
                                <div class="absolute size-14 rounded-full border border-muted-foreground/[0.08]"></div>
                                <div class="absolute h-px w-32 bg-muted-foreground/[0.06]"></div>
                                <div class="absolute h-32 w-px bg-muted-foreground/[0.06]"></div>
                                <div class="flex size-8 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                                    <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Deploy globally in under 10 seconds",
        "Built-in analytics and error tracking",
        "Automatic SSL and edge caching",
    ];
}
