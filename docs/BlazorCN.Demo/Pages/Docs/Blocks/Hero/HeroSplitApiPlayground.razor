@* ============================================================
   Block: hero-split-api-playground
   Title: HeroSplitApiPlayground
   Description: A split-layout hero with an API request builder and response panel mockup for React and Next.js featuring an announcement pill, emerald feature checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-api-playground.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">
                @* Announcement pill *@
                <div class="mb-8">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">API v2</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">Idempotency keys now GA</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    One API for<br />
                    every payment
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
                    Accept cards, wallets, and bank transfers through a single REST endpoint — with typed
                    SDKs and predictable errors.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Get API keys</ButtonCn>
                    <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">Read the docs</ButtonCn>
                </div>
            </div>

            @* Right — API playground mockup *@
            <div class="flex items-center p-6 lg:p-8">
                <div class="w-full overflow-hidden rounded-2xl border bg-muted/50" aria-hidden="true">
                    @* Chrome *@
                    <div class="flex items-center gap-2 border-b bg-background/60 px-4 py-2.5">
                        <div class="flex gap-1.5">
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                        </div>
                        <span class="ml-2 font-mono text-[10px] text-muted-foreground/60">
                            api.example.com
                        </span>
                    </div>

                    @* Request panel *@
                    <div class="px-5 py-4 sm:px-6">
                        <div class="mb-2 text-[10px] font-medium uppercase tracking-wider text-muted-foreground/70">
                            Request
                        </div>

                        @* Method + URL row *@
                        <div class="flex items-center gap-2">
                            <span class="rounded-md bg-emerald-500/15 px-2 py-0.5 font-mono text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">
                                @_requestMethod
                            </span>
                            <span class="truncate font-mono text-[11px] text-foreground/80">
                                @_requestPath
                            </span>
                        </div>

                        @* Auth header row *@
                        <div class="mt-3 flex items-center justify-between rounded-md border border-dashed bg-background/60 px-2.5 py-1.5">
                            <span class="font-mono text-[10px] text-muted-foreground">Authorization</span>
                            <span class="truncate pl-2 font-mono text-[10px] text-foreground/70">
                                @_requestAuthHeader
                            </span>
                        </div>

                        @* Request body *@
                        <div class="mt-3 rounded-md border bg-background/60 px-3 py-2 font-mono text-[10px] leading-[1.6] text-foreground/80">
                            @foreach (var line in _requestBody)
                            {
                                <div class="whitespace-pre">@line</div>
                            }
                        </div>
                    </div>

                    @* Divider *@
                    <div class="border-t"></div>

                    @* Response panel *@
                    <div class="px-5 py-4 sm:px-6">
                        <div class="mb-2 flex items-center justify-between">
                            <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground/70">
                                Response
                            </span>
                            <span class="font-mono text-[10px] text-muted-foreground">
                                @_responseTime
                            </span>
                        </div>

                        @* Status row *@
                        <div class="flex items-center gap-2">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            <span class="font-mono text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">
                                @_responseStatus
                            </span>
                        </div>

                        @* Response body *@
                        <div class="mt-2 rounded-md border bg-background/60 px-3 py-2 font-mono text-[10px] leading-[1.6] text-foreground/80">
                            @foreach (var line in _responseBody)
                            {
                                <div class="whitespace-pre">@line</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private const string _requestMethod = "POST";
    private const string _requestPath = "/v2/payments/charges";
    private const string _requestAuthHeader = "Bearer sk_live_••••4F2a";

    private static readonly string[] _requestBody =
    [
        "{",
        "  \"amount\": 4900,",
        "  \"currency\": \"usd\",",
        "  \"customer\": \"cus_NkT7aQ\",",
        "  \"description\": \"Pro plan\"",
        "}",
    ];

    private const string _responseStatus = "200 OK";
    private const string _responseTime = "143ms";

    private static readonly string[] _responseBody =
    [
        "{",
        "  \"id\": \"ch_3Nq9x2Hk\",",
        "  \"object\": \"charge\",",
        "  \"status\": \"succeeded\",",
        "  \"paid\": true",
        "}",
    ];

    private static readonly string[] _features =
    [
        "99.99% uptime across six global regions",
        "Signed webhooks with automatic retry on failure",
        "Generated SDKs for TypeScript, Go, and Python",
    ];
}
