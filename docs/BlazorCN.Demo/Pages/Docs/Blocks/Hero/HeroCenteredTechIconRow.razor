@* ============================================================
   Block: hero-centered-tech-icon-row
   Title: HeroCenteredTechIconRow
   Description: A centered hero with a horizontal row of abstract tech icon placeholders for React and Next.js featuring a headline, subtitle, dual ShadcnioButton CTAs, and labeled shape tiles built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-tech-icon-row.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="px-6 py-8 text-center sm:px-10 sm:py-10 lg:py-12">
            @* Headline *@
            <div>
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Built with the tools<br />
                    you already love
                </h1>

                <p class="mx-auto mt-4 max-w-lg text-lg leading-relaxed text-muted-foreground">
                    Native integrations with your entire stack. No plugins, no configuration drift.
                    Connect once and ship.
                </p>

                @* CTAs *@
                <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                    <ButtonCn Class="w-[200px]">View integrations</ButtonCn>
                    <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">Read the docs</ButtonCn>
                </div>
            </div>

            @* Tech stack row *@
            <div class="mx-auto mt-10 max-w-lg">
                <p class="mb-4 text-xs font-medium tracking-wide text-muted-foreground uppercase">
                    Works seamlessly with
                </p>
                <div class="grid grid-cols-3 gap-4 md:grid-cols-6">
                    @foreach (var tech in _techStack)
                    {
                        <div class="flex flex-col items-center gap-2">
                            <div class="flex size-14 items-center justify-center rounded-xl border bg-muted/50" aria-hidden="true">
                                @if (tech.Shape == "circle")
                                {
                                    <div class="size-7 rounded-full border border-muted-foreground/15 bg-muted-foreground/[0.07]"></div>
                                }
                                @if (tech.Shape == "square")
                                {
                                    <div class="size-6 rounded-md border border-muted-foreground/15 bg-muted-foreground/[0.07]"></div>
                                }
                                @if (tech.Shape == "hexagon")
                                {
                                    <div class="size-7 rotate-45 rounded-lg border border-muted-foreground/15 bg-muted-foreground/[0.07]"></div>
                                }
                                @if (tech.Shape == "cylinder")
                                {
                                    <div class="flex flex-col items-center gap-0.5">
                                        <div class="h-1.5 w-6 rounded-full border border-muted-foreground/15 bg-muted-foreground/[0.07]"></div>
                                        <div class="h-4 w-6 rounded-sm border border-muted-foreground/15 bg-muted-foreground/[0.07]"></div>
                                        <div class="h-1.5 w-6 rounded-full border border-muted-foreground/15 bg-muted-foreground/[0.07]"></div>
                                    </div>
                                }
                                @if (tech.Shape == "diamond")
                                {
                                    <div class="size-5 rotate-45 border border-muted-foreground/15 bg-muted-foreground/[0.07]"></div>
                                }
                                @if (tech.Shape == "box")
                                {
                                    <div class="flex flex-col gap-0.5">
                                        <div class="h-3 w-7 rounded-sm border border-muted-foreground/15 bg-muted-foreground/[0.07]"></div>
                                        <div class="h-3 w-7 rounded-sm border border-muted-foreground/15 bg-muted-foreground/[0.07]"></div>
                                    </div>
                                }
                            </div>
                            <span class="text-xs text-muted-foreground">@tech.Name</span>
                        </div>
                    }
                </div>
                <p class="mt-4 text-xs text-muted-foreground">
                    And 40+ more integrations available
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record TechItem(string Name, string Shape);

    private static readonly TechItem[] _techStack =
    [
        new("React",      "circle"),
        new("TypeScript", "square"),
        new("Node.js",    "hexagon"),
        new("PostgreSQL", "cylinder"),
        new("Redis",      "diamond"),
        new("Docker",     "box"),
    ];
}
