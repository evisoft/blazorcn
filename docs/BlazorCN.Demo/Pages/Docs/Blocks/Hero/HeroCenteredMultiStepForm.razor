@* ============================================================
   Block: hero-centered-multi-step-form
   Title: HeroCenteredMultiStepForm
   Description: A centered hero with an inline multi step lead capture wizard for React and Next.js featuring a three step progress dot indicator, shadcn/ui Input fields, and a ShadcnioButton next CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-multi-step-form.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card px-6 py-10 sm:px-8 sm:py-12 lg:px-12">

        @* Headline *@
        <div class="text-center">
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                Get set up in
                <br />
                under a minute
            </h1>
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                Three quick steps and your workspace is live. Cancel anytime, no questions asked.
            </p>
        </div>

        @* Wizard card *@
        <div class="mt-8 rounded-xl border bg-background p-5 sm:p-6">

            @* Progress dots row *@
            <div aria-hidden="true" class="flex items-center justify-center gap-6 sm:gap-8">
                @foreach (var step in _steps)
                {
                    var isActive = step.Id == _currentStep;
                    var isComplete = step.Id < _currentStep;
                    <div class="flex items-center gap-6 sm:gap-8">
                        <div class="flex flex-col items-center gap-1.5">
                            <span class="@Cn.Merge("size-2 rounded-full transition-colors", (isActive || isComplete) ? "bg-foreground" : "bg-muted-foreground/25")"></span>
                            <span class="@Cn.Merge("text-[10px] font-medium transition-colors", isActive ? "text-foreground" : isComplete ? "text-muted-foreground" : "text-muted-foreground/60")">
                                @step.Label
                            </span>
                        </div>
                        @if (step.Id < _steps.Length)
                        {
                            <span class="-mt-4 h-px w-6 bg-border sm:w-10"></span>
                        }
                    </div>
                }
            </div>

            @* Step content *@
            <div class="mt-7 space-y-3.5">
                @if (_currentStep == 1)
                {
                    <div class="space-y-1.5">
                        <label for="wizard-name" class="block text-xs font-medium text-foreground">
                            Full name
                        </label>
                        <InputCn Id="wizard-name"
                                 Type="text"
                                 Placeholder="Ada Lovelace"
                                 @bind-Value="_name" />
                    </div>
                    <div class="space-y-1.5">
                        <label for="wizard-email" class="block text-xs font-medium text-foreground">
                            Work email
                        </label>
                        <InputCn Id="wizard-email"
                                 Type="email"
                                 Placeholder="@("ada@@company.com")"
                                 @bind-Value="_email" />
                    </div>
                }
                @if (_currentStep == 2)
                {
                    <div class="rounded-lg border bg-muted/40 p-4 text-center">
                        <p class="text-sm font-medium text-foreground">Pick your plan</p>
                        <p class="mt-1 text-xs text-muted-foreground">
                            Step 2 placeholder content for plan selection.
                        </p>
                    </div>
                }
                @if (_currentStep == 3)
                {
                    <div class="rounded-lg border bg-muted/40 p-4 text-center">
                        <p class="text-sm font-medium text-foreground">Add payment</p>
                        <p class="mt-1 text-xs text-muted-foreground">
                            Step 3 placeholder content for payment details.
                        </p>
                    </div>
                }
            </div>

            @* Footer row — back link + next CTA *@
            <div class="mt-6 flex items-center justify-between">
                <button type="button"
                        @onclick="HandleBack"
                        disabled="@(_currentStep == 1)"
                        class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground disabled:cursor-not-allowed disabled:opacity-40">
                    <LucideIconCn Name="arrow-left" Size="14" Class="size-3.5" />
                    Back
                </button>
                <ButtonCn Size="ButtonSize.Sm" Class="w-[140px]" @onclick="HandleNext">
                    @(_currentStep == _steps.Length ? "Finish" : "Next")
                </ButtonCn>
            </div>
        </div>

        @* Trust microcopy below the card *@
        <p class="mt-5 text-center text-xs text-muted-foreground">
            No credit card required &middot; SOC 2 Type II compliant
        </p>

    </div>
</section>

@code {
    private record Step(int Id, string Label);

    private static readonly Step[] _steps =
    [
        new(1, "Account"),
        new(2, "Plan"),
        new(3, "Payment"),
    ];

    private int _currentStep = 1;
    private string _name = "";
    private string _email = "";

    private void HandleNext()
    {
        if (_currentStep < _steps.Length)
            _currentStep++;
    }

    private void HandleBack()
    {
        if (_currentStep > 1)
            _currentStep--;
    }
}
