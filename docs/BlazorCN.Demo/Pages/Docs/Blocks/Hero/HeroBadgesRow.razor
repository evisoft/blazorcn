@* ========================================
   Block: hero-badges-row
   Title: Hero Badges Row
   Description: Hero block with horizontal badge row highlighting key features
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-badges-row.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="mx-auto max-w-4xl text-center">
            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                Build and deploy <span class="text-primary">in seconds</span>
            </h1>

            <p class="mx-auto mb-8 max-w-2xl text-lg text-muted-foreground">
                The fastest way to ship your projects. From idea to production with zero configuration
                required.
            </p>

            <div class="mb-10 flex flex-wrap items-center justify-center gap-2">
                @foreach (var feature in _features)
                {
                    <BadgeCn Class="gap-1.5 px-3 py-1.5 text-sm" Variant="BadgeVariant.Secondary">
                        @feature
                    </BadgeCn>
                }
            </div>

            <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
                <ButtonCn Class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
                    Get Started Free
                    <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                </ButtonCn>
                <ButtonCn Class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                    View Documentation
                </ButtonCn>
            </div>

            <p class="mt-8 text-sm text-muted-foreground">
                No credit card required • Setup in under 2 minutes
            </p>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Lightning Fast",
        "Secure by Default",
        "Global CDN",
        "99.9% Uptime",
        "Free Forever Plan",
    ];
}
