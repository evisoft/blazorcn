@* ========================================
   Block: hero-steps
   Title: Hero Steps
   Description: Hero block with visual step-by-step process or how it works section
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-steps.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="mx-auto max-w-4xl text-center">
            <BadgeCn Class="mb-6" Variant="BadgeVariant.Secondary">
                How It Works
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                Get started in <span class="text-primary">three simple steps</span>
            </h1>

            <p class="mx-auto mb-12 max-w-2xl text-lg text-muted-foreground">
                No complicated setup. No lengthy onboarding. Just a simple process to get you from zero
                to productive in minutes.
            </p>
        </div>

        @* Steps *@
        <div class="mx-auto mb-12 max-w-4xl">
            <div class="grid gap-8 md:grid-cols-3">
                @for (var i = 0; i < _steps.Length; i++)
                {
                    var step = _steps[i];
                    var index = i;
                    <div class="relative text-center">
                        @* Connector line (hidden on mobile, visible on md+) *@
                        @if (index < _steps.Length - 1)
                        {
                            <div class="absolute left-[calc(50%+40px)] top-6 hidden h-0.5 w-[calc(100%-80px)] bg-border md:block"></div>
                        }

                        @* Step number *@
                        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary text-lg font-bold text-primary-foreground">
                            @step.Number
                        </div>

                        @* Step content *@
                        <h2 class="mb-2 text-lg font-semibold">@step.Title</h2>
                        <p class="text-sm text-muted-foreground">@step.Description</p>
                    </div>
                }
            </div>
        </div>

        @* CTA *@
        <div class="text-center">
            <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                Get Started Now
                <LucideArrowRightCn Size="16" Class="h-4 w-4" />
            </ButtonCn>
            <p class="mt-4 text-sm text-muted-foreground">
                Free 14-day trial &#x2022; No credit card required
            </p>
        </div>
    </div>
</section>

@code {
    private record Step(string Number, string Title, string Description);

    private static readonly Step[] _steps =
    [
        new("01", "Sign Up", "Create your free account in seconds. No credit card required."),
        new("02", "Connect", "Link your tools and import your existing data seamlessly."),
        new("03", "Launch", "Go live and start seeing results from day one."),
    ];
}
