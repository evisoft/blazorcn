@* ============================================================
   Block: hero-split-pull-request
   Title: HeroSplitPullRequest
   Description: A split-layout hero with a GitHub pull request review mockup for React and Next.js featuring a branch pill, reviewer avatar stack, file change list with diff bars, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-pull-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">
                @* Announcement pill *@
                <div class="mb-8">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Merge queue</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">Now GA on GitHub</span>
                        <LucideArrowUpRightCn Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Ship pull requests<br />
                    without babysitting
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                    A merge bot that batches, re-runs flaky tests, and lands your PRs the moment every
                    check goes green — no manual clicks required.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideCheckCn Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[200px]">Install GitHub App</ButtonCn>
                    <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">View live demo</ButtonCn>
                </div>
            </div>

            @* Right — pull request mockup *@
            <div class="flex items-center p-6 lg:p-8">
                <div class="w-full overflow-hidden rounded-2xl border bg-muted/50" aria-hidden="true">
                    @* Header row *@
                    <div class="flex items-center justify-between border-b bg-background/60 px-4 py-3">
                        <div class="flex items-center gap-2">
                            <LucideGitPullRequestCn Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-500" />
                            <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/70 px-2 py-0.5 font-mono text-[10px] text-muted-foreground">
                                <span class="text-foreground">@_branch</span>
                                <span>&rarr;</span>
                                <span>@_baseBranch</span>
                            </span>
                        </div>
                        <span class="font-mono text-[10px] text-muted-foreground">#482</span>
                    </div>

                    @* PR title + reviewers *@
                    <div class="border-b bg-background/40 px-4 py-4">
                        <p class="text-[13px] font-semibold leading-snug text-foreground">@_prTitle</p>
                        <div class="mt-3 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-[10px] uppercase tracking-wider text-muted-foreground">
                                    Reviewers
                                </span>
                                <div class="flex -space-x-1.5">
                                    @foreach (var r in _reviewers)
                                    {
                                        var reviewer = r;
                                        <span class="@Cn.Merge("inline-flex size-5 items-center justify-center rounded-full border border-background font-medium text-[9px] text-white", reviewer.Color)">
                                            @reviewer.Initial
                                        </span>
                                    }
                                </div>
                            </div>
                            <span class="inline-flex items-center gap-1 text-[10px] text-muted-foreground">
                                <LucideMessageSquareCn Size="12" Class="size-3" />
                                @_conversationCount
                            </span>
                        </div>
                    </div>

                    @* File changes list *@
                    <div class="divide-y bg-background/30">
                        @foreach (var file in _files)
                        {
                            var f = file;
                            var total = f.Additions + f.Deletions;
                            var addPct = _maxBar > 0 ? (f.Additions / (double)_maxBar) * 100.0 : 0;
                            var delPct = _maxBar > 0 ? (f.Deletions / (double)_maxBar) * 100.0 : 0;
                            var addBarPct = (addPct + delPct) > 0 ? (addPct / (addPct + delPct)) * 100.0 : 0;
                            var delBarPct = (addPct + delPct) > 0 ? (delPct / (addPct + delPct)) * 100.0 : 0;
                            <div class="flex items-center gap-3 px-4 py-2.5">
                                <LucideFileCodeCn Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                <span class="min-w-0 flex-1 truncate font-mono text-[11px] text-foreground">@f.Name</span>
                                <div class="flex items-center gap-2 font-mono text-[10px]">
                                    <span class="text-emerald-600 dark:text-emerald-500">+@f.Additions</span>
                                    <span class="text-red-500 dark:text-red-400">&minus;@f.Deletions</span>
                                </div>
                                <div class="flex h-1 w-14 shrink-0 items-center gap-px overflow-hidden rounded-full bg-muted">
                                    <span class="h-full bg-emerald-500" style="@($"width:{addBarPct:F2}%")"></span>
                                    <span class="h-full bg-red-500" style="@($"width:{delBarPct:F2}%")"></span>
                                </div>
                                <span class="w-8 text-right font-mono text-[10px] text-muted-foreground">@total</span>
                            </div>
                        }
                    </div>

                    @* Merge footer *@
                    <div class="flex items-center justify-between border-t bg-background/60 px-4 py-3">
                        <span class="inline-flex items-center gap-1.5 text-[11px] text-muted-foreground">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            All checks passed
                        </span>
                        <span class="inline-flex items-center gap-1.5 rounded-md bg-emerald-600 px-3 py-1 font-medium text-[11px] text-white dark:bg-emerald-500">
                            <LucideGitPullRequestCn Size="12" Class="size-3" />
                            Merge pull request
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private const string _branch = "feat/oauth";
    private const string _baseBranch = "main";
    private const string _prTitle = "Add OAuth 2.0 provider support with refresh tokens";
    private const int _conversationCount = 14;

    private record Reviewer(string Id, string Initial, string Color);

    private static readonly Reviewer[] _reviewers =
    [
        new("r1", "M", "bg-emerald-500/80"),
        new("r2", "J", "bg-blue-500/80"),
        new("r3", "A", "bg-amber-500/80"),
        new("r4", "S", "bg-rose-500/80"),
    ];

    private record FileChange(string Name, int Additions, int Deletions);

    private static readonly FileChange[] _files =
    [
        new("src/auth/oauth-provider.ts", 82, 12),
        new("src/auth/token-refresh.ts", 46, 4),
        new("tests/auth/oauth.test.ts", 31, 0),
    ];

    private static readonly string[] _features =
    [
        "Auto-merge once CI is green and reviewers approve",
        "Batches stacked PRs into a single merge train",
        "Re-runs flaky tests automatically before blocking",
    ];

    private static readonly int _maxBar = _files.Length > 0
        ? _files.Max(f => f.Additions + f.Deletions)
        : 1;
}
