@* ============================================================
   Block: hero-split-terminal-install
   Title: HeroSplitTerminalInstall
   Description: A split-layout hero with a dark terminal mockup and copyable install command for React and Next.js featuring an announcement pill, emerald feature checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-terminal-install.tsx
   ============================================================ *@

@inject IJSRuntime JS

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid md:grid-cols-2">
            @* Left -- text content *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 md:py-10 lg:px-14 lg:py-12">
                @* Announcement pill *@
                <div class="mb-5">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Open source</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">v4.0 released</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
                    The developer<br />toolkit that ships
                </h1>

                @* Subtitle *@
                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    Deploy production-ready features in minutes with our battle-tested SDK. One command to
                    install, one call to ship.
                </p>

                @* Feature checklist *@
                <ul class="mt-5 space-y-2">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-2.5">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* Install command *@
                <div class="mt-5 flex items-center justify-between gap-2 rounded-lg border bg-muted/30 px-3 py-2">
                    <code class="font-mono text-xs text-muted-foreground">
                        <span class="text-muted-foreground/50">$ </span>
                        @_installCmd
                    </code>
                    <button type="button"
                            class="flex h-6 shrink-0 items-center gap-1 rounded px-1.5 text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                            @onclick="HandleCopy">
                        @if (_copied)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                            <span>Copied</span>
                        }
                        else
                        {
                            <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            <span>Copy</span>
                        }
                    </button>
                </div>

                @* CTAs *@
                <div class="mt-6 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                    <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">Read the docs</ButtonCn>
                </div>
            </div>

            @* Right -- terminal mockup *@
            <div class="flex items-center bg-muted/30 p-6 md:p-8">
                <div class="w-full overflow-hidden rounded-xl border border-foreground/10 bg-foreground shadow-sm" aria-hidden="true">
                    @* Window chrome *@
                    <div class="flex items-center gap-2 border-b border-background/10 px-4 py-2.5">
                        <div class="flex gap-1.5">
                            <span class="size-2 rounded-full bg-background/15"></span>
                            <span class="size-2 rounded-full bg-background/15"></span>
                            <span class="size-2 rounded-full bg-background/15"></span>
                        </div>
                        <span class="ml-2 font-mono text-[10px] text-background/25">Terminal</span>
                    </div>

                    @* Code content *@
                    <div class="p-4">
                        <pre class="font-mono text-xs leading-relaxed">
@foreach (var line in _codeLines)
{
    <div>
        @if (line.Indent > 0)
        {
            <span>@(new string(' ', line.Indent * 2))</span>
        }
        @foreach (var token in line.Tokens)
        {
            <span style="@($"opacity:{token.Op.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}")" class="text-background">@token.Text</span>
        }
    </div>
}
                        </pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private const string _installCmd = "npm install @acme/sdk";
    private bool _copied = false;

    private static readonly string[] _features =
    [
        "Type-safe with full TypeScript support",
        "Zero dependencies, tree-shakeable",
        "Sub-200ms responses across 40+ languages",
    ];

    private record CodeToken(string Text, double Op);
    private record CodeLine(int Indent, CodeToken[] Tokens);

    private static readonly CodeLine[] _codeLines =
    [
        new(0, [new("const ", 0.3), new("response", 0.6), new(" = ", 0.3), new("await ", 0.3), new("acme", 0.6), new(".", 0.3), new("deploy", 0.55), new("({", 0.3)]),
        new(1, [new("project", 0.6), new(": ", 0.3), new("\"my-app\"", 0.45), new(",", 0.3)]),
        new(1, [new("region", 0.6), new(":  ", 0.3), new("\"us-east-1\"", 0.45), new(",", 0.3)]),
        new(1, [new("env", 0.6), new(":     ", 0.3), new("\"production\"", 0.45), new(",", 0.3)]),
        new(0, [new("})", 0.3)]),
        new(0, []),
        new(0, [new("// ", 0.2), new("Response", 0.2)]),
        new(0, [new("{", 0.3)]),
        new(1, [new("\"status\"", 0.6), new(":  ", 0.3), new("\"deployed\"", 0.45), new(",", 0.3)]),
        new(1, [new("\"url\"", 0.6), new(":     ", 0.3), new("\"https://my-app.acme.dev\"", 0.45), new(",", 0.3)]),
        new(1, [new("\"latency\"", 0.6), new(": ", 0.3), new("142", 0.5), new(",", 0.3)]),
        new(1, [new("\"region\"", 0.6), new(":  ", 0.3), new("\"us-east-1\"", 0.45)]),
        new(0, [new("}", 0.3)]),
    ];

    private async Task HandleCopy()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _installCmd);
        }
        catch
        {
            // clipboard may be unavailable in some environments
        }
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
