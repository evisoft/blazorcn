@* ============================================================
   Block: hero-centered-cta-dotted-bg
   Title: HeroCenteredCtaDottedBg
   Description: A centered hero with a subtle SVG dotted grid pattern behind the content for React and Next.js featuring a radial mask fade, bold headline, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-cta-dotted-bg.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-2xl border bg-card">

        @* Dotted grid background *@
        <svg
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 size-full text-muted-foreground/25 [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_75%)]">
            <defs>
                <pattern
                    id="hero-dotted-bg-pattern"
                    x="0"
                    y="0"
                    width="22"
                    height="22"
                    patternUnits="userSpaceOnUse">
                    <circle cx="1.5" cy="1.5" r="1.25" fill="currentColor" />
                </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#hero-dotted-bg-pattern)" />
        </svg>

        @* Content *@
        <div class="relative px-6 py-10 text-center sm:px-8 sm:py-12 lg:px-12 lg:py-14">

            @* Announcement pill *@
            <div class="mb-6 flex justify-center">
                <a
                    href="#"
                    class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs backdrop-blur-sm transition-colors hover:bg-muted">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium">v2.4 just shipped</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">See the changelog</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            @* Headline *@
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                The fastest way
                <br />
                to ship production
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                Everything your team needs to build, preview, and deploy without the usual overhead.
            </p>

            @* CTAs *@
            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">Learn more</ButtonCn>
            </div>

        </div>
    </div>
</section>
