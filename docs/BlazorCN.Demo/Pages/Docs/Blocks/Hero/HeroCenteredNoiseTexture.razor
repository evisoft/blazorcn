@* ============================================================
   Block: hero-centered-noise-texture
   Title: HeroCenteredNoiseTexture
   Description: A centered hero with a subtle SVG turbulence noise grain texture background for React and Next.js featuring an announcement pill, bold headline, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-noise-texture.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-2xl border bg-card">
        @* SVG noise texture background *@
        <div
            class="pointer-events-none absolute inset-0 opacity-[0.08] mix-blend-multiply dark:opacity-[0.12] dark:mix-blend-screen"
            aria-hidden="true">
            <svg aria-hidden="true" class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
                <filter id="noise-filter">
                    <feTurbulence
                        type="fractalNoise"
                        baseFrequency="0.9"
                        numOctaves="3"
                        stitchTiles="stitch" />
                    <feColorMatrix type="saturate" values="0" />
                </filter>
                <rect width="100%" height="100%" filter="url(#noise-filter)" />
            </svg>
        </div>

        <div class="relative px-6 py-10 text-center sm:px-8 sm:py-12 lg:py-14">
            @* Announcement pill *@
            <div class="mb-6 flex justify-center">
                <a
                    href="#"
                    class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    <span class="font-medium">Fresh ink</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">Writer 1.4 is out</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            @* Headline *@
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                Writing that<br />
                feels like paper
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground sm:mt-5 sm:text-lg">
                A calm, grain-textured writing surface built for long-form thinking. No toolbars, no
                distractions, just the words.
            </p>

            @* Feature checklist *@
            <ul class="mx-auto mt-6 inline-flex flex-col items-start gap-2.5">
                @foreach (var feature in _features)
                {
                    <li class="flex items-center gap-3">
                        <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                        <span class="text-sm text-foreground">@feature</span>
                    </li>
                }
            </ul>

            @* CTAs *@
            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[180px]">Start writing</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-[150px]">Take the tour</ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Distraction-free Markdown editor",
        "Real-time collaborative drafts",
        "AI-assisted line editing on demand",
    ];
}
