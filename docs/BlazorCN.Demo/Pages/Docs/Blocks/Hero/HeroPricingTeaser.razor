@* ========================================
   Block: hero-pricing-teaser
   Title: Hero Pricing Teaser
   Description: Hero block with pricing teaser showing starting price and key value prop
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-pricing-teaser.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="mx-auto max-w-4xl text-center">
            <BadgeCn Class="mb-6 gap-2" Variant="BadgeVariant.Secondary">
                <LucideZapCn Size="14" Class="h-3.5 w-3.5" />
                Limited Time Offer
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                Professional tools at <span class="text-primary">startup prices</span>
            </h1>

            <p class="mx-auto mb-10 max-w-2xl text-lg text-muted-foreground">
                Everything you need to build, launch, and scale your product. No hidden fees, no
                surprises.
            </p>

            <div class="mb-10 flex flex-col items-center justify-center gap-2">
                <div class="flex items-baseline gap-2">
                    <span class="text-lg text-muted-foreground line-through">$49</span>
                    <span class="text-5xl font-bold sm:text-6xl">$29</span>
                    <span class="text-lg text-muted-foreground">/month</span>
                </div>
                <p class="text-sm text-muted-foreground">Billed annually • Save 40%</p>
            </div>

            <div class="mb-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
                @foreach (var item in _included)
                {
                    <div class="flex items-center gap-2 text-sm">
                        <LucideCheckCn Size="16" Class="h-4 w-4 text-primary" />
                        <span>@item</span>
                    </div>
                }
            </div>

            <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
                <ButtonCn Class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
                    Start Free Trial
                    <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                </ButtonCn>
                <ButtonCn Class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                    View All Plans
                </ButtonCn>
            </div>

            <p class="mt-6 text-sm text-muted-foreground">
                14-day free trial • No credit card required • Cancel anytime
            </p>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _included = ["Unlimited projects", "All core features", "Email support", "API access"];
}
