@* ============================================================
   Block: hero-dark-glass-card
   Title: HeroDarkGlassCard
   Description: A dark centered hero with a frosted glass card floating over blurred color blobs for React and Next.js featuring an announcement pill, bold headline, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-dark-glass-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-zinc-950">
        @* Blurred color blobs *@
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
            <div class="absolute -top-20 -left-16 size-64 rounded-full bg-emerald-500/20 blur-3xl"></div>
            <div class="absolute -top-10 right-0 size-72 rounded-full bg-blue-500/20 blur-3xl"></div>
            <div class="absolute -bottom-24 left-1/3 size-72 rounded-full bg-purple-500/25 blur-3xl"></div>
        </div>

        @* Frosted glass inner card *@
        <div class="relative m-6 rounded-2xl border border-white/10 bg-white/5 px-6 py-10 text-center backdrop-blur-xl sm:m-8 sm:px-8 sm:py-12">
            @* Announcement pill *@
            <div class="mb-6 flex justify-center">
                <a
                    href="#"
                    class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs backdrop-blur-sm transition-colors hover:bg-white/10">
                    <span class="size-1.5 rounded-full bg-emerald-400"></span>
                    <span class="font-medium text-white">New</span>
                    <span class="text-white/40">&middot;</span>
                    <span class="text-white/60">Edge runtime v3 is live</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-white/40" />
                </a>
            </div>

            @* Headline *@
            <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
                Ship AI that feels<br />instant
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-white/60 sm:text-lg">
                The edge-native inference platform for teams who refuse to compromise on latency,
                privacy, or developer experience.
            </p>

            @* Feature checklist *@
            <ul class="mx-auto mt-6 inline-flex flex-col items-start gap-2.5">
                @foreach (var feature in _features)
                {
                    <li class="flex items-center gap-3">
                        <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-400" />
                        <span class="text-sm text-white/80">@feature</span>
                    </li>
                }
            </ul>

            @* CTAs *@
            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[180px] bg-white text-zinc-950 hover:bg-white/90">Start free</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-[150px] text-white hover:bg-white/10 hover:text-white">Read the docs</ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "End-to-end encryption on every request",
        "Sub-100ms edge inference worldwide",
        "SOC 2 Type II and HIPAA compliant",
    ];
}
