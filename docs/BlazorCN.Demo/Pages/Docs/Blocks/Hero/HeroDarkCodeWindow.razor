@* ============================================================
   Block: hero-dark-code-window
   Title: HeroDarkCodeWindow
   Description: A dark-themed centered hero with a code window mockup below the CTAs for React and Next.js featuring syntax-highlighted TSX, traffic light chrome, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-dark-code-window.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="relative overflow-hidden rounded-2xl border border-white/5 bg-zinc-950 px-6 pt-12 pb-8 text-center sm:px-10 sm:pt-14 sm:pb-10">
    <div class="flex flex-col items-center">

      @* Announcement pill *@
      <a href="#" class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/10 px-3 py-1 text-xs text-white transition-colors hover:bg-white/15">
        <span class="size-1.5 rounded-full bg-emerald-400"></span>
        <span class="font-medium">v2.0</span>
        <span class="text-white/40">&middot;</span>
        <span class="text-white/60">Now with TypeScript</span>
        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-white/60" />
      </a>

      @* Headline *@
      <h1 class="mt-6 text-4xl font-bold tracking-tight text-white sm:text-5xl">
        The UI library<br />developers love
      </h1>

      @* Subtitle *@
      <p class="mt-4 max-w-md text-base leading-relaxed text-white/60">
        Accessible, customizable components. Copy, paste, and ship your next project faster than
        ever.
      </p>

      @* CTAs *@
      <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <ButtonCn Class="w-[180px] bg-white text-zinc-950 hover:bg-white/90">
          Get started
        </ButtonCn>
        <ButtonCn Class="w-[150px] border border-white/15 bg-transparent text-white hover:bg-white/10 hover:text-white">
          Learn more
        </ButtonCn>
      </div>

      @* Code window mockup *@
      <div aria-hidden="true" class="mt-10 w-full max-w-lg overflow-hidden rounded-xl border border-white/10 bg-zinc-900 text-left shadow-2xl shadow-black/40">

        @* Window chrome *@
        <div class="flex items-center gap-3 border-b border-white/5 px-4 py-2.5">
          <div class="flex items-center gap-1.5">
            <span class="size-2.5 rounded-full bg-red-400/60"></span>
            <span class="size-2.5 rounded-full bg-amber-400/60"></span>
            <span class="size-2.5 rounded-full bg-emerald-400/60"></span>
          </div>
          <div class="flex items-center gap-2 rounded-md bg-white/5 px-2 py-0.5">
            <span class="font-mono text-[10px] text-white/70">app.tsx</span>
          </div>
        </div>

        @* Code body *@
        <pre class="overflow-x-auto px-4 py-4 font-mono text-[11px] leading-relaxed sm:text-xs"><code>
@foreach (var line in _codeLines)
{
    var lineNum = line.LineIndex + 1;
    <div class="flex">
      <span class="mr-3 w-4 shrink-0 text-right text-zinc-600">@lineNum</span>
      <span>
        @foreach (var token in line.Tokens)
        {
            <span class="@token.ClassName">@token.Text</span>
        }
      </span>
    </div>
}
        </code></pre>
      </div>

    </div>
  </div>
</section>

@code {
    private record Token(string Text, string ClassName);
    private record CodeLine(int LineIndex, Token[] Tokens);

    private static readonly CodeLine[] _codeLines =
    [
        new(0, [new("// app.tsx", "text-zinc-500")]),
        new(1, [
            new("import", "text-violet-300"),
            new(" { ", "text-zinc-200"),
            new("Button", "text-sky-300"),
            new(" } ", "text-zinc-200"),
            new("from", "text-violet-300"),
            new(" ", "text-zinc-200"),
            new("'~/components/ui/button'", "text-emerald-300"),
        ]),
        new(2, [new("", "text-zinc-200")]),
        new(3, [
            new("export default function", "text-violet-300"),
            new(" ", "text-zinc-200"),
            new("Page", "text-sky-300"),
            new("() {", "text-zinc-200"),
        ]),
        new(4, [
            new("  return", "text-violet-300"),
            new(" (", "text-zinc-200"),
        ]),
        new(5, [
            new("    <", "text-zinc-200"),
            new("Button", "text-sky-300"),
            new(" ", "text-zinc-200"),
            new("variant", "text-zinc-200"),
            new("=", "text-zinc-200"),
            new("'default'", "text-emerald-300"),
            new(">", "text-zinc-200"),
        ]),
        new(6, [new("      Ship it", "text-zinc-200")]),
        new(7, [
            new("    </", "text-zinc-200"),
            new("Button", "text-sky-300"),
            new(">", "text-zinc-200"),
        ]),
        new(8, [new("  )", "text-zinc-200")]),
        new(9, [new("}", "text-zinc-200")]),
    ];
}
