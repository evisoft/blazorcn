@* ============================================================
   Block: hero-centered-launch-rank-badge
   Title: HeroCenteredLaunchRankBadge
   Description: A centered hero with a bordered upvote launch badge card, bold headline, and social proof metrics bar for React and Next.js built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/hero/hero-centered-launch-rank-badge.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="px-6 py-10 text-center sm:px-8 sm:py-12 lg:px-12 lg:py-14">

            @* Product Hunt launch badge *@
            <div class="mb-8 inline-block">
                <a href="#" class="group inline-flex items-center gap-4 rounded-xl border bg-muted/50 px-5 py-3.5 transition-colors hover:bg-muted">
                    @* Upvote block *@
                    <div class="flex flex-col items-center rounded-lg border px-3 py-2 transition-colors group-hover:border-foreground/20">
                        <LucideIconCn Name="chevron-up" Size="16" Class="size-4 text-foreground" />
                        <span class="text-xs font-bold tabular-nums">@_upvotes.ToString("N0")</span>
                    </div>

                    @* Info *@
                    <div class="text-left">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-semibold">@_productName</span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_rank &middot; Featured on Product Hunt
                        </p>
                    </div>
                </a>
            </div>

            @* Headline *@
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                Voted the #1 tool<br />
                for teams that ship
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                Join thousands of makers who plan, build, and launch their products in half the time.
            </p>

            @* CTAs *@
            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[200px]">Get started free</ButtonCn>
                <ButtonCn Class="w-[180px]" Variant="ButtonVariant.Ghost">See why we won</ButtonCn>
            </div>

        </div>

        @* Social proof metrics bar *@
        <div class="border-t bg-muted/30 px-6 py-6 sm:px-10">
            <div class="flex flex-wrap items-center justify-center gap-8">
                @foreach (var metric in _metrics)
                {
                    var idx = Array.IndexOf(_metrics, metric);
                    <div class="flex items-center gap-8">
                        <div class="text-center">
                            <p class="text-2xl font-semibold tabular-nums">@metric.Value</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">@metric.Label</p>
                        </div>
                        @if (idx < _metrics.Length - 1)
                        {
                            <div class="hidden h-8 w-px bg-border sm:block" aria-hidden="true"></div>
                        }
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record Metric(string Value, string Label);

    private const int _upvotes = 1247;
    private const string _rank = "#1 Product of the Day";
    private const string _productName = "Acme Platform";

    private static readonly Metric[] _metrics =
    [
        new("1,200+", "Upvotes"),
        new("4.9/5", "Rating"),
        new("8,400+", "Users this week"),
    ];
}
