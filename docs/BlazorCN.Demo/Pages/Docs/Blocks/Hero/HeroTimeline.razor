@* ========================================
   Block: hero-timeline
   Title: Hero Timeline
   Description: Hero block with a visual timeline showing product milestones or roadmap
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-timeline.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="mx-auto max-w-4xl">
            <div class="mb-12 text-center">
                <BadgeCn Class="mb-6 gap-2" Variant="BadgeVariant.Secondary">
                    <LucideCalendarCn Size="14" Class="h-3.5 w-3.5" />
                    Our Journey
                </BadgeCn>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    Building the future, <span class="text-primary">one milestone at a time</span>
                </h1>

                <p class="mx-auto max-w-2xl text-lg text-muted-foreground">
                    From idea to industry leader. Here's how we're growing and what's coming next.
                </p>
            </div>

            @* Timeline *@
            <div class="relative mb-12">
                @* Vertical line *@
                <div class="absolute left-4 top-0 h-full w-0.5 bg-border md:left-1/2 md:-translate-x-1/2"></div>

                <div class="space-y-8">
                    @for (var i = 0; i < _milestones.Length; i++)
                    {
                        var milestone = _milestones[i];
                        var index = i;
                        <div class="@($"relative flex items-start gap-6 md:gap-12 {(index % 2 == 0 ? "md:flex-row" : "md:flex-row-reverse")}")">
                            @* Dot *@
                            <div class="absolute left-4 flex h-4 w-4 -translate-x-1/2 items-center justify-center md:left-1/2">
                                <div class="@($"h-4 w-4 rounded-full border-2 {(milestone.Current ? "border-primary bg-primary" : milestone.Completed ? "border-primary bg-background" : "border-muted-foreground/30 bg-background")}")"></div>
                            </div>

                            @* Content *@
                            <div class="ml-10 flex-1 md:ml-0 md:w-1/2">
                                <div class="@($"rounded-lg border bg-card p-4 {(milestone.Current ? "border-primary" : "")}")">
                                    <div class="mb-2 flex items-center gap-2">
                                        <span class="text-sm font-semibold text-primary">@milestone.Date</span>
                                        @if (milestone.Current)
                                        {
                                            <BadgeCn Class="text-xs">
                                                Current
                                            </BadgeCn>
                                        }
                                    </div>
                                    <h3 class="mb-1 font-semibold">@milestone.Title</h3>
                                    <p class="text-sm text-muted-foreground">@milestone.Description</p>
                                </div>
                            </div>

                            @* Spacer for alternating layout *@
                            <div class="hidden flex-1 md:block md:w-1/2"></div>
                        </div>
                    }
                </div>
            </div>

            @* CTA *@
            <div class="text-center">
                <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                    <LucideRocketCn Size="16" Class="h-4 w-4" />
                    Join the Journey
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Milestone(string Date, string Title, string Description, bool Completed, bool Current = false);

    private static readonly Milestone[] _milestones =
    [
        new("Q1 2024", "Public Launch", "Launched to the public with core features", true),
        new("Q2 2024", "10K Users", "Reached our first major user milestone", true),
        new("Q3 2024", "Enterprise Launch", "Introduced team features and SSO", true, Current: true),
        new("Q4 2024", "API & Integrations", "Opening up our platform to developers", false),
    ];
}
