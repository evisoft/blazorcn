@* ============================================================
   Block: hero-scroll-indicator
   Title: HeroScrollIndicator
   Description: A centered hero with an animated bouncing chevron scroll indicator and a four-column stats bar footer for React and Next.js built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/hero/hero-scroll-indicator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="relative overflow-hidden rounded-2xl border bg-card">
        @* Main content *@
        <div class="px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">
            @* Announcement pill *@
            <div class="mb-5">
                <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium">What&apos;s new</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">Just shipped v3.0</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            @* Headline *@
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                The platform that
                <br />
                scales with you
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-lg text-lg leading-relaxed text-muted-foreground">
                Start small, grow without limits. Our infrastructure adapts to your needs whether you
                have ten users or ten million.
            </p>

            @* CTAs *@
            <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[200px]">Get started free</ButtonCn>
                <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">Talk to sales</ButtonCn>
            </div>

            @* Scroll indicator *@
            <div class="mt-8">
                <button type="button"
                        aria-label="Scroll down to see more content"
                        class="group mx-auto flex flex-col items-center gap-1.5 text-muted-foreground transition-colors hover:text-foreground">
                    <span class="text-xs font-medium">Scroll to explore</span>
                    <div class="animate-bounce">
                        <LucideIconCn Name="chevron-down" Size="20" Class="size-5" />
                    </div>
                </button>
            </div>
        </div>

        @* Stats bar *@
        <div class="border-t bg-muted/30 px-8 py-6">
            <div class="mx-auto grid max-w-3xl grid-cols-2 gap-6 sm:grid-cols-4">
                @foreach (var stat in _stats)
                {
                    <div class="text-center">
                        <p class="text-2xl font-semibold tabular-nums">@stat.Value</p>
                        <p class="mt-1 text-xs text-muted-foreground">@stat.Label</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Stat(string Value, string Label);

    private static readonly Stat[] _stats =
    [
        new("150K+", "Active users"),
        new("99.99%", "Uptime SLA"),
        new("90+", "Countries"),
        new("<50ms", "Avg latency"),
    ];
}
