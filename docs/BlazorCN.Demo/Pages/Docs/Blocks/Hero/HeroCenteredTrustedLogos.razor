@* ============================================================
   Block: hero-centered-trusted-logos
   Title: HeroCenteredTrustedLogos
   Description: A centered hero with a trusted-by logo row for React and Next.js featuring an announcement pill, headline, dual ShadcnioButton CTAs, and six muted logo placeholders built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-trusted-logos.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        @* Hero content *@
        <div class="px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">
            @* Announcement pill *@
            <div class="mb-5">
                <a href="#"
                   class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium">Trusted</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">Now serving 5,000+ teams</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            @* Headline *@
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                Infrastructure that
                <br />
                scales with you
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-muted-foreground sm:text-lg">
                From first prototype to global deployment. Our platform grows with your business so you
                never worry about infrastructure again.
            </p>

            @* CTAs *@
            <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
                <ButtonCn Class="w-[200px]">Get started free</ButtonCn>
                <ButtonCn Class="w-[160px]" Variant="ButtonVariant.Ghost">Talk to sales</ButtonCn>
            </div>

            @* Trust indicators *@
            <div class="mt-6 flex flex-wrap items-center justify-center gap-5 text-sm text-muted-foreground">
                @foreach (var item in _trustItems)
                {
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                        <span class="text-xs text-foreground">@item</span>
                    </div>
                }
            </div>
        </div>

        @* Trusted by section *@
        <div class="border-t bg-muted/30 px-6 py-8 sm:px-10">
            @* Label with dividers *@
            <div class="flex items-center gap-4">
                <div class="h-px flex-1 bg-border"></div>
                <p class="shrink-0 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Trusted by leading companies
                </p>
                <div class="h-px flex-1 bg-border"></div>
            </div>

            @* Logo placeholders *@
            <div class="mt-6 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
                @foreach (var logo in _logos)
                {
                    <div class="flex h-8 w-24 items-center justify-center rounded bg-muted/50 px-3"
                         aria-hidden="true">
                        @* Skeleton shape inside to suggest a logo *@
                        <div class="flex items-center gap-1.5">
                            <div class="size-3 rounded bg-muted-foreground/[0.08]"></div>
                            <div class="h-2 w-12 rounded-full bg-muted-foreground/[0.08]"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _trustItems =
    [
        "99.99% uptime SLA",
        "SOC 2 Type II certified",
        "GDPR compliant",
    ];

    private record Logo(string Name, string WidthClass);

    private static readonly Logo[] _logos =
    [
        new("Streamline", "w-20"),
        new("Arcline", "w-16"),
        new("Vaultkey", "w-24"),
        new("Basecamp", "w-20"),
        new("Covalent", "w-18"),
        new("Meridian", "w-22"),
    ];
}
