@* ============================================================
   Block: hero-centered-newsletter-archive
   Title: HeroCenteredNewsletterArchive
   Description: A centered hero with inline newsletter signup and a past issues archive grid for React and Next.js featuring an announcement pill, inline email input with ShadcnioButton submit, and clickable past issue cards built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-newsletter-archive.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="px-6 py-10 text-center sm:px-8 lg:px-12 lg:py-12">

            @* Announcement pill *@
            <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="font-medium">Weekly dispatch</span>
                <span class="text-muted-foreground">&middot;</span>
                <span class="text-muted-foreground">Issue #42 is out</span>
                <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
            </a>

            @* Headline *@
            <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl">
                One email.<br />
                Zero fluff.
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                A weekly deep-dive on shipping software, delivered every Friday morning.
            </p>

            @* Inline email form *@
            <div class="mx-auto mt-8 max-w-md">
                @if (_isSubmitted)
                {
                    <div class="rounded-lg border bg-muted/50 px-5 py-4">
                        <div class="flex items-center justify-center gap-2">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span class="text-sm font-medium">You&apos;re subscribed</span>
                        </div>
                        <p class="mt-1 text-xs text-muted-foreground">
                            Issue #43 lands in your inbox this Friday.
                        </p>
                    </div>
                }
                else
                {
                    <div class="flex flex-col gap-2 sm:flex-row">
                        <InputCn
                            Type="email"
                            Placeholder="@("you@@company.com")"
                            Class="h-12 flex-1"
                            @bind-Value="_email"
                            Disabled="@_isLoading"
                        />
                        <ButtonCn Class="w-[160px] shrink-0" @onclick="HandleSubmit" Disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <LucideIconCn Name="loader-2" Size="16" Class="size-4 animate-spin" />
                            }
                            else
                            {
                                <text>Subscribe</text>
                            }
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>

        @* Past issues archive *@
        <div class="border-t bg-muted/30 px-6 py-6 sm:px-8 lg:px-10">
            <div class="flex items-center justify-between">
                <h2 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Latest issues
                </h2>
                <a href="#" class="inline-flex items-center gap-1 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground">
                    View archive
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3" />
                </a>
            </div>

            <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
                @foreach (var issue in _issues)
                {
                    <li>
                        <a href="@issue.Href" class="group flex h-full flex-col rounded-lg border bg-card px-3.5 py-3 transition-colors hover:border-foreground/20 hover:bg-muted/50">
                            <div class="flex items-center justify-between">
                                <span class="font-mono text-xs font-medium text-muted-foreground tabular-nums">#@issue.Number</span>
                                <span class="text-[10px] text-muted-foreground">@issue.Date</span>
                            </div>
                            <p class="mt-1.5 line-clamp-1 text-sm font-medium text-foreground">
                                @issue.Title
                            </p>
                            <p class="mt-1 line-clamp-1 text-xs text-muted-foreground">
                                @issue.Description
                            </p>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>

@code {
    private record Issue(int Number, string Title, string Description, string Date, string Href);

    private static readonly Issue[] _issues =
    [
        new(42, "Shipping fast with server actions", "How we cut our deploy cycle from 40 minutes to under 5.", "Apr 4, 2026", "#"),
        new(41, "The quiet death of the spinner", "Optimistic UI patterns that feel instant on any connection.", "Mar 28, 2026", "#"),
        new(40, "Type safety at the API edge", "A practical guide to end-to-end types without a monorepo.", "Mar 21, 2026", "#"),
        new(39, "Design tokens that survive redesigns", "A token architecture you can actually refactor around.", "Mar 14, 2026", "#"),
    ];

    private string _email = "";
    private bool _isLoading;
    private bool _isSubmitted;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrEmpty(_email)) return;
        _isLoading = true;
        await Task.Delay(1200);
        _isLoading = false;
        _isSubmitted = true;
    }
}
