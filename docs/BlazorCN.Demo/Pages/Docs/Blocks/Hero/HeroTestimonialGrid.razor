@* ========================================
   Block: hero-testimonial-grid
   Title: Hero Testimonial Grid
   Description: Hero block with grid of testimonial cards showing multiple customer stories
   Long Description: Hero with integrated testimonial quote, avatar stack, and social proof metrics
   Dependencies: AvatarCn, BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-testimonial-grid.tsx
   ======================================== *@

<section class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:py-28">
        @* Header *@
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <BadgeCn class="mb-6" Variant="BadgeVariant.Secondary">
            Customer Stories
          </BadgeCn>

          <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
            Loved by teams <span class="text-primary">everywhere</span>
          </h1>

          <p class="mx-auto max-w-2xl text-lg text-muted-foreground">
            Don't just take our word for it. Here's what our customers have to say about their
            experience.
          </p>
        </div>

        @* Testimonials grid *@
        <div class="mx-auto mb-12 grid max-w-6xl gap-6 md:grid-cols-2 lg:grid-cols-3">
          @foreach (var testimonial in _TESTIMONIALS)
          {
            <CardCn class="flex flex-col">
              <CardContentCn class="flex flex-1 flex-col p-6">
                @* Stars *@
                <div class="mb-4 flex gap-0.5">
                  @for (var star = 1; star <= 5; star++)
                  {
                    <LucideStarCn Size="16" Class="@($"h-4 w-4 {(star <= testimonial.Rating ? "fill-yellow-400 text-yellow-400" : "fill-muted text-muted")}")" />
                  }
                </div>

                @* Quote *@
                <p class="mb-6 flex-1 text-sm leading-relaxed">"@testimonial.Quote"</p>

                @* Author *@
                <div class="flex items-center gap-3">
                  <AvatarCn class="h-10 w-10">
                    <AvatarImageCn alt="@testimonial.Author" src="@testimonial.Avatar" />
                    <AvatarFallbackCn>@testimonial.Author[0]</AvatarFallbackCn>
                  </AvatarCn>
                  <div>
                    <p class="text-sm font-medium">@testimonial.Author</p>
                    <p class="text-xs text-muted-foreground">
                      @testimonial.Role, @testimonial.Company
                    </p>
                  </div>
                </div>
              </CardContentCn>
            </CardCn>
          }
        </div>

        @* CTA *@
        <div class="text-center">
          <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
            <ButtonCn class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
              Join 10,000+ Happy Teams
              <LucideArrowRightCn Size="16" Class="h-4 w-4" />
            </ButtonCn>
            <ButtonCn class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
              Read More Reviews
            </ButtonCn>
          </div>
        </div>
      </div>
    </section>

@code {
    private record TestimonialData(string Quote, string Author, string Role, string Company, string Avatar, int Rating);

    private static readonly TestimonialData[] _TESTIMONIALS = new[]
    {
        new TestimonialData("This platform has completely transformed how our team works. The collaboration features are incredible.", "Alex Thompson", "Engineering Lead", "TechCorp", "https://i.pravatar.cc/150?img=1", 5),
        new TestimonialData("We saw a 40% increase in productivity within the first month. The ROI is undeniable.", "Maria Garcia", "VP of Product", "StartupHQ", "https://i.pravatar.cc/150?img=2", 5),
        new TestimonialData("The best tool we've used for managing our workflow. Simple yet powerful.", "James Wilson", "CTO", "DevStudio", "https://i.pravatar.cc/150?img=3", 5),
        new TestimonialData("Customer support is amazing. They helped us set everything up in less than a day.", "Sarah Chen", "Operations Manager", "ScaleUp", "https://i.pravatar.cc/150?img=4", 4),
        new TestimonialData("We've tried many tools, but this is the one that stuck. Our entire team loves it.", "David Kim", "Product Manager", "InnoTech", "https://i.pravatar.cc/150?img=5", 5),
        new TestimonialData("The analytics dashboard alone is worth the price. Incredible insights into our data.", "Emma Davis", "Data Lead", "AnalyticsPro", "https://i.pravatar.cc/150?img=6", 5),
    };
}
