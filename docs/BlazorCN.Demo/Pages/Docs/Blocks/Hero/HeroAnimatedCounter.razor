@* ============================================================
   Block: hero-animated-counter
   Title: HeroAnimatedCounter
   Description: A centered hero section for React and Next.js with scroll-triggered animated number counters, announcement pill, bold headline, dual ShadcnioButton CTAs, avatar social proof, and a muted counter bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-animated-counter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="px-8 py-8 text-center sm:py-10">

            @* Announcement pill *@
            <div class="mb-4 flex justify-center">
                <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium">Milestone</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">50K users reached</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            @* Headline *@
            <h1 class="mx-auto max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl">
                Numbers that speak<br />for themselves
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
                Thousands of teams trust us to power their most critical workflows. Here is what that
                looks like in real numbers.
            </p>

            @* CTAs *@
            <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                <ButtonCn Class="w-[200px]" Variant="ButtonVariant.Ghost">Read case studies</ButtonCn>
            </div>

            @* Social proof *@
            <div class="mt-5 flex items-center justify-center gap-3">
                <div class="flex -space-x-2">
                    @foreach (var i in Enumerable.Range(0, 5))
                    {
                        <div class="size-8 rounded-full border-2 border-background bg-muted"></div>
                    }
                </div>
                <p class="text-sm text-muted-foreground">
                    Loved by <span class="font-semibold text-foreground">10,000+</span> developers
                </p>
            </div>
        </div>

        @* Counter section *@
        <div class="border-t bg-muted/30 px-8 py-8 sm:py-10">
            <div class="mx-auto grid max-w-4xl grid-cols-2 gap-8 md:grid-cols-4 md:gap-10">
                @foreach (var counter in _counters)
                {
                    <div class="text-center">
                        <p class="text-2xl font-bold tabular-nums tracking-tight sm:text-3xl lg:text-4xl">@counter.DisplayValue</p>
                        <p class="mt-2 text-sm font-medium">@counter.Label</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@counter.Description</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record CounterData(string DisplayValue, string Label, string Description);

    private static readonly CounterData[] _counters =
    [
        new("50,000+", "Active Users", "Across 120 countries"),
        new("99.9%",   "Uptime",       "Over the last 12 months"),
        new("$4,200,000", "Revenue Processed", "Monthly average"),
        new("150+",    "Integrations", "And growing weekly"),
    ];
}
