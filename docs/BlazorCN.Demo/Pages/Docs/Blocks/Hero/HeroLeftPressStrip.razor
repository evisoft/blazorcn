@* ============================================================
   Block: hero-left-press-strip
   Title: HeroLeftPressStrip
   Description: A left-heavy asymmetric hero with a vertical press quote strip sidebar for React and Next.js featuring an announcement pill, bold headline, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-left-press-strip.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-[1.4fr_1fr]">
            @* Left — main copy (dominant) *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">
                @* Announcement pill *@
                <div class="mb-8">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">In the press</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">Featured in 40+ outlets</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    The tool the press
                    <br />
                    keeps writing about
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                    Loved by editors at TechCrunch, Forbes, Wired, and The Verge. Try the product they
                    keep recommending to their readers.
                </p>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn class="w-[180px]">Get started</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" class="w-[150px]">Read coverage</ButtonCn>
                </div>
            </div>

            @* Right — vertical press quote strip (narrower) *@
            <aside class="flex flex-col justify-center border-t bg-muted/50 px-6 py-8 sm:px-8 lg:border-t-0 lg:border-l lg:px-8 lg:py-10"
                   aria-label="Press mentions">
                <p class="mb-5 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Featured in
                </p>
                <ul class="flex flex-col">
                    @foreach (var item in _pressQuotes)
                    {
                        var isLast = item.Id == _pressQuotes[_pressQuotes.Length - 1].Id;
                        <li>
                            <div class="py-3">
                                <div class="font-mono text-xs font-semibold tracking-tight text-foreground">
                                    @item.Publication
                                </div>
                                <blockquote class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                                    &ldquo;@item.Quote&rdquo;
                                </blockquote>
                            </div>
                            @if (!isLast)
                            {
                                <div class="h-px w-full bg-border/60"></div>
                            }
                        </li>
                    }
                </ul>
            </aside>
        </div>
    </div>
</section>

@code {
    private record PressQuote(string Id, string Publication, string Quote);

    private static readonly PressQuote[] _pressQuotes =
    [
        new("pq1", "TechCrunch", "The kind of developer tool that makes you wonder how you worked without it."),
        new("pq2", "Forbes", "A rare combination of polish, power, and developer empathy."),
        new("pq3", "Wired", "Quietly rewriting the rules of how small teams ship production software."),
        new("pq4", "The Verge", "Feels like it was built by people who actually ship code every day."),
    ];
}
