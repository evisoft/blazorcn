@* ============================================================
   Block: hero-split-hover-cards
   Title: HeroSplitHoverCards
   Description: A split-layout hero with three hoverable feature cards that lift on hover for React and Next.js featuring an announcement pill, emerald feature checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-hover-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid md:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">
                @* Announcement pill *@
                <div class="mb-5">
                    <a href="#"
                       class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">New</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">Team workspaces</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Everything you need<br />
                    to ship faster
                </h1>

                @* Subtitle *@
                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    The modern platform that replaces your entire tool stack. Built for teams that move
                    fast and care about quality.
                </p>

                @* Feature checklist *@
                <ul class="mt-5 space-y-2">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-2.5">
                            <LucideIconCn Name="check" Size="16" StrokeWidth="3" Class="size-4 shrink-0 text-emerald-600 dark:text-emerald-500" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-7 flex items-center gap-3">
                    <ButtonCn Class="w-[200px]">Start free trial</ButtonCn>
                    <ButtonCn Class="w-[180px]" Variant="ButtonVariant.Ghost">Book a demo</ButtonCn>
                </div>
            </div>

            @* Right — interactive cards *@
            <div class="flex flex-col justify-center gap-3 bg-muted/30 p-6 md:p-8">
                @foreach (var card in _cards)
                {
                    <div class="rounded-lg border bg-card px-5 py-4 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md">
                        <div class="flex items-start gap-4">
                            <div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-muted">
                                <LucideIconCn Name="@card.IconName" Size="18" Class="size-4.5 text-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium">@card.Title</p>
                                <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">
                                    @card.Description
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record FeatureCard(string IconName, string Title, string Description);

    private static readonly FeatureCard[] _cards =
    [
        new("bar-chart-3", "Real-time analytics", "Track every metric that matters to your business in one dashboard."),
        new("zap", "Lightning performance", "Sub-200ms responses across 40+ global edge regions."),
        new("lock", "Enterprise security", "SOC 2 Type II certified with end-to-end encryption by default."),
    ];

    private static readonly string[] _features =
    [
        "Context-aware intelligence that learns your workflows",
        "Scales from startup to enterprise without config changes",
        "White-glove onboarding with dedicated success manager",
    ];
}
