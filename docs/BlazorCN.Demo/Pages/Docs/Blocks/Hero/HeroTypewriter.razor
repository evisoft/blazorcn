@* ============================================================
   Block: hero-typewriter
   Title: Hero Typewriter
   Description: Hero block with animated typewriter text effect and rotating headlines
   Long Description: Hero block with two equal columns for comparison or dual messaging
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-typewriter.tsx
   ============================================================ *@

<section class="relative overflow-hidden">
      @* Background decoration *@
      <div class="absolute inset-0 -z-10">
        <div class="absolute left-1/4 top-1/4 h-96 w-96 rounded-full bg-primary/5 blur-3xl"></div>
        <div class="absolute right-1/4 bottom-1/4 h-96 w-96 rounded-full bg-purple-500/5 blur-3xl"></div>
      </div>

      <div class="container mx-auto px-4 py-24 md:py-32 lg:py-40">
        <div class="mx-auto max-w-4xl text-center">
          <BadgeCn Class="mb-6 gap-2" Variant="BadgeVariant.Secondary">
            <LucideSparklesCn Size="12" Class="h-3.5 w-3.5" />
            The all-in-one platform
          </BadgeCn>

          <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl lg:text-7xl">
            Everything you need to
            <br />
            <span class="relative text-primary">
              @_displayText
              <span class="ml-1 inline-block h-[1em] w-[3px] animate-blink bg-primary align-middle"></span>
            </span>
          </h1>

          <p class="mx-auto mb-10 max-w-2xl text-lg text-muted-foreground sm:text-xl">
            One platform to manage your entire business. From idea to launch, we&apos;ve got you
            covered with powerful tools and seamless integrations.
          </p>

          <div class="mb-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
            <ButtonCn Class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
              Start Free Trial
              <LucideArrowRightCn Size="16" Class="h-4 w-4" />
            </ButtonCn>
            <ButtonCn Class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
              Book a Demo
            </ButtonCn>
          </div>

          @* Feature pills *@
          <div class="flex flex-wrap items-center justify-center gap-3">
            @foreach (var feature in _featurePills)
            {
              <div class="flex items-center gap-2 text-sm text-muted-foreground">
                <div class="h-1.5 w-1.5 rounded-full bg-green-500"></div>
                @feature
              </div>
            }
          </div>

          @* Trust logos *@
          <div class="mt-16 border-t pt-12">
            <p class="mb-6 text-sm text-muted-foreground">
              Trusted by 10,000+ companies worldwide
            </p>
            <div class="flex flex-wrap items-center justify-center gap-8 opacity-50 grayscale">
              @foreach (var company in _companies)
              {
                <span class="text-xl font-semibold">@company</span>
              }
            </div>
          </div>
        </div>
      </div>

      @* Blink animation *@
      <style>
        @@keyframes blink {
          0%, 50% {
            opacity: 1;
          }
          51%, 100% {
            opacity: 0;
          }
        }

        .animate-blink {
          animation: blink 1s infinite;
        }
      </style>
    </section>

@code {
    private string _displayText = "build products";
    private int _phraseIndex = 0;
    private bool _isTyping = true;
    private bool _isPaused = false;

    private static readonly string[] _featurePills = new[] { "No credit card", "14-day trial", "Cancel anytime", "24/7 support" };
    private static readonly string[] _companies = new[] { "Vercel", "Stripe", "Linear", "Notion", "Figma" };
}
