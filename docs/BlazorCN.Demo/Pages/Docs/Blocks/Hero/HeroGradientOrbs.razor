<section class="relative min-h-[600px] overflow-hidden">
      @* Gradient orbs *@
      <div class="pointer-events-none absolute inset-0">
        @* Top right orb *@
        <div class="absolute -right-20 -top-20 h-96 w-96 rounded-full bg-gradient-to-br from-purple-500/30 to-pink-500/30 blur-3xl" ></div>
        @* Bottom left orb *@
        <div class="absolute -bottom-32 -left-32 h-96 w-96 rounded-full bg-gradient-to-tr from-blue-500/30 to-cyan-500/30 blur-3xl" ></div>
        @* Center orb *@
        <div class="absolute left-1/2 top-1/2 h-64 w-64 -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-to-r from-primary/20 to-primary/10 blur-3xl"></div>
      </div>

      @* Content *@
      <div class="container relative mx-auto flex min-h-[600px] items-center px-4 py-20">
        <div class="mx-auto max-w-3xl text-center">
          <BadgeCn class="mb-6" Variant="BadgeVariant.Secondary">
            Introducing v2.0
          </BadgeCn>

          <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl lg:text-7xl">
            Design at the 
            <span class="bg-gradient-to-r from-purple-600 via-pink-600 to-blue-600 bg-clip-text text-transparent">
              speed of thought
            </span>
          </h1>

          <p class="mx-auto mb-10 max-w-xl text-lg text-muted-foreground">
            The creative platform that removes barriers between imagination and reality. From
            concept to creation in moments.
          </p>

          <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
            <ButtonCn class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
              Start Creating
              <LucideArrowRightCn Size="16" Class="h-4 w-4" />
            </ButtonCn>
            <ButtonCn class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
              Watch Demo
            </ButtonCn>
          </div>

          @* Stats *@
          <div class="mt-16 flex flex-wrap items-center justify-center gap-8 md:gap-12">
            <div class="text-center">
              <div class="text-3xl font-bold">2M+</div>
              <div class="text-sm text-muted-foreground">Creators</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold">50M+</div>
              <div class="text-sm text-muted-foreground">Designs Made</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold">4.9</div>
              <div class="text-sm text-muted-foreground">User Rating</div>
            </div>
          </div>
        </div>
      </div>
    </section>

