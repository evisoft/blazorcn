@* ============================================================
   Block: hero-centered-search-product-grid
   Title: HeroCenteredSearchProductGrid
   Description: A centered hero with a prominent search bar and 2x2 product card grid for React and Next.js featuring category pills, crosshair image placeholders, and ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-search-product-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        @* Top section -- headline + search *@
        <div class="px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                Find your next<br />
                building block
            </h1>

            <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-muted-foreground">
                50,000+ templates, plugins, and design assets from creators worldwide. Everything you
                need to ship faster.
            </p>

            @* Search bar *@
            <div class="mx-auto mt-6 max-w-xl">
                <div class="flex items-center gap-2 rounded-lg border bg-muted/50 p-1.5">
                    <div class="flex flex-1 items-center gap-2 px-2.5">
                        <LucideIconCn Name="search" Size="16" Class="size-4 text-muted-foreground" />
                        <input
                            class="w-full bg-transparent text-sm outline-none placeholder:text-muted-foreground"
                            @bind="_query"
                            @bind:event="oninput"
                            placeholder="Search templates, plugins, themes..."
                            type="text" />
                    </div>
                    <ButtonCn Class="h-9 w-[110px] rounded-md px-4 text-sm">Search</ButtonCn>
                </div>
            </div>

            @* Category pills *@
            <div class="mt-4 flex flex-wrap items-center justify-center gap-1.5">
                @foreach (var cat in _categories)
                {
                    var category = cat;
                    <button
                        type="button"
                        @onclick="@(() => _activeCategory = category)"
                        class="@Cn.Merge("rounded-full px-3 py-1 text-xs transition-colors", _activeCategory == category ? "bg-foreground text-background" : "bg-muted text-muted-foreground hover:bg-muted/80")">
                        @category
                    </button>
                }
            </div>
        </div>

        @* Product grid *@
        <div class="border-t bg-muted/30 px-6 pb-6 pt-5 sm:px-10">
            <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
                @foreach (var product in _products)
                {
                    <div class="group overflow-hidden rounded-lg border bg-card transition-colors hover:bg-accent/50">
                        @* Crosshair image placeholder *@
                        <div class="flex aspect-square w-full items-center justify-center bg-muted">
                            <div class="relative flex items-center justify-center">
                                <div class="absolute size-12 rounded-full border border-muted-foreground/[0.07]"></div>
                                <div class="absolute size-6 rounded-full border border-muted-foreground/[0.09]"></div>
                                <div class="absolute h-px w-16 bg-muted-foreground/[0.07]"></div>
                                <div class="absolute h-16 w-px bg-muted-foreground/[0.07]"></div>
                                <div class="flex size-5 items-center justify-center rounded-full border border-muted-foreground/10 bg-background/60">
                                    <LucideIconCn Name="image" Size="10" Class="size-2.5 text-muted-foreground/40" />
                                </div>
                            </div>
                        </div>

                        @* Info *@
                        <div class="p-3">
                            <div class="flex items-start justify-between gap-2">
                                <p class="text-sm font-medium leading-tight">@product.Name</p>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px]">@product.Tag</BadgeCn>
                            </div>
                            <p class="mt-1.5 text-sm font-semibold tabular-nums">@product.Price</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Product(string Name, string Price, string Tag);

    private static readonly Product[] _products =
    [
        new("Dashboard Pro Kit", "$49", "Template"),
        new("Icon Library 3.0",  "$29", "Icons"),
        new("Auth Starter Pack", "$39", "Plugin"),
        new("Landing Page Set",  "$59", "Template"),
    ];

    private static readonly string[] _categories = ["All", "Templates", "Plugins", "Icons", "Themes"];

    private string _query = "";
    private string _activeCategory = "All";
}
