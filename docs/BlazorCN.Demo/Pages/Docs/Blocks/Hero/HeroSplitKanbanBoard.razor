@* ============================================================
   Block: hero-split-kanban-board
   Title: HeroSplitKanbanBoard
   Description: A split-layout hero with a three-column kanban board mockup of skeleton task cards for React and Next.js featuring an announcement pill, feature checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-kanban-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="grid lg:grid-cols-2">

      @* Left — copy *@
      <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">

        @* Announcement pill *@
        <div class="mb-8">
          <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="font-medium">Sprint 24</span>
            <span class="text-muted-foreground">·</span>
            <span class="text-muted-foreground">Roadmaps are live</span>
            <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
          </a>
        </div>

        @* Headline *@
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          Project planning<br />
          your team will use
        </h1>

        @* Subtitle *@
        <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
          Boards, sprints, and roadmaps that move at the speed of your team — without the admin overhead of legacy tools.
        </p>

        @* Feature checklist *@
        <ul class="mt-6 space-y-2.5">
          @foreach (var feature in _features)
          {
            <li class="flex items-center gap-3">
              <LucideIconCn Name="check" Size="16" StrokeWidth="3" Class="size-4 shrink-0 text-emerald-600 dark:text-emerald-500" />
              <span class="text-sm text-foreground">@feature</span>
            </li>
          }
        </ul>

        @* CTAs *@
        <div class="mt-8 flex items-center gap-3">
          <ButtonCn Class="w-[180px]">Start free</ButtonCn>
          <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">Watch the tour</ButtonCn>
        </div>

      </div>

      @* Right — kanban board mockup *@
      <div class="flex items-center p-6 lg:p-8">
        <div class="w-full overflow-hidden rounded-2xl border bg-muted/50" aria-hidden="true">

          @* Window chrome *@
          <div class="flex items-center gap-2 border-b bg-background/60 px-4 py-2.5">
            <div class="flex gap-1.5">
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
            </div>
            <span class="ml-2 font-mono text-[10px] text-muted-foreground/60">Sprint 24</span>
          </div>

          @* Three-column board *@
          <div class="grid grid-cols-3 gap-2.5 p-4 sm:gap-3 sm:p-5">
            @foreach (var col in _columns)
            {
              var colCls = Cn.Merge("flex flex-col gap-2 rounded-lg border bg-background/60 p-2", col.Active ? "ring-1 ring-foreground/15" : "");
              <div class="@colCls">

                @* Column header *@
                <div class="flex items-center justify-between px-1">
                  <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">@col.Title</span>
                  <span class="rounded-full bg-muted px-1.5 py-0.5 text-[9px] font-medium text-muted-foreground tabular-nums">@col.Cards.Length</span>
                </div>

                @* Cards *@
                <div class="flex flex-col gap-1.5">
                  @foreach (var card in col.Cards)
                  {
                    var cardCls = Cn.Merge("rounded-md border bg-card p-2", card.Active ? "border-l-2 border-l-blue-500" : "");
                    var line1Cls = Cn.Merge("h-1.5 rounded-full bg-muted-foreground/20", card.LineOne);
                    var line2Cls = Cn.Merge("mt-1.5 h-1.5 rounded-full bg-muted-foreground/12", card.LineTwo);
                    <div class="@cardCls">
                      <div class="@line1Cls"></div>
                      <div class="@line2Cls"></div>
                      <div class="mt-2 flex items-center justify-between">
                        <div class="size-3.5 rounded-full bg-muted-foreground/15"></div>
                        <div class="h-1 w-4 rounded-full bg-muted-foreground/12"></div>
                      </div>
                    </div>
                  }
                </div>

              </div>
            }
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Drag-and-drop boards that sync in real time",
        "Roadmaps, sprints, and parent-child issues",
        "Native integrations with GitHub, Slack, and Figma",
    ];

    private record KanbanCard(string Id, string LineOne, string LineTwo, bool Active = false);
    private record KanbanColumn(string Title, KanbanCard[] Cards, bool Active = false);

    private static readonly KanbanColumn[] _columns =
    [
        new KanbanColumn("Todo",
        [
            new KanbanCard("t1", "w-3/4", "w-1/2"),
            new KanbanCard("t2", "w-5/6", "w-2/3"),
            new KanbanCard("t3", "w-2/3", "w-1/3"),
        ]),
        new KanbanColumn("In progress",
        [
            new KanbanCard("p1", "w-4/5", "w-1/2", Active: true),
            new KanbanCard("p2", "w-3/4", "w-2/3"),
        ], Active: true),
        new KanbanColumn("Done",
        [
            new KanbanCard("d1", "w-2/3", "w-1/2"),
            new KanbanCard("d2", "w-3/4", "w-1/3"),
            new KanbanCard("d3", "w-1/2", "w-1/3"),
        ]),
    ];
}
