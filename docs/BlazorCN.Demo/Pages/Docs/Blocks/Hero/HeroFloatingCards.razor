@* ============================================================
   Block: hero-floating-cards
   Title: HeroFloatingCards
   Description: A centered hero for React and Next.js with small floating feature preview cards positioned around the headline using absolute positioning and motion/react entrance animations, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-floating-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="relative overflow-hidden rounded-2xl border bg-card">
        @* Floating cards -- hidden on mobile *@
        <div class="hidden md:block" aria-hidden="true">
            @foreach (var card in _CARDS)
            {
                <div class="@($"absolute z-10 {card.Position}")">
                    <div class="flex items-center gap-2 rounded-lg border bg-card/90 px-3 py-2 shadow-sm backdrop-blur-sm">
                        <LucideIconCn Name="@card.IconName" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs font-medium">@card.Label</span>
                    </div>
                </div>
            }
        </div>

        @* Center content *@
        <div class="relative z-20 px-6 py-8 text-center sm:px-10 sm:py-10 lg:py-12">
            <div class="mx-auto max-w-xl">
                @* Announcement pill *@
                <div class="mb-6">
                    <a
                        href="#"
                        class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted"
                    >
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Platform update</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">4 new integrations</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Everything your
                    <br />
                    team needs
                </h1>

                <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    One platform for analytics, security, deployment, and collaboration. Stop context
                    switching between tools.
                </p>

                <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
                    <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                    <ButtonCn Class="w-[180px]" Variant="ButtonVariant.Ghost">See all features</ButtonCn>
                </div>

                @* Social proof *@
                <div class="mt-8 flex items-center justify-center gap-3">
                    <div class="flex -space-x-2">
                        @for (var i = 0; i < 5; i++)
                        {
                            <div class="size-7 rounded-full border-2 border-background bg-muted"></div>
                        }
                    </div>
                    <p class="text-sm text-muted-foreground">
                        Trusted by <span class="font-semibold text-foreground">8,000+</span> teams
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record FloatingCard(string IconName, string Label, string Position);

    private static readonly FloatingCard[] _CARDS =
    [
        new("bar-chart-3", "Analytics", "top-[10%] left-[6%]"),
        new("globe",       "Edge CDN",  "top-[8%] right-[8%]"),
        new("shield",      "SOC 2",     "bottom-[18%] left-[4%]"),
        new("git-branch",  "Branching", "bottom-[14%] right-[6%]"),
    ];
}
