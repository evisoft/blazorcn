@* ============================================================
   Block: hero-left-metric-cards
   Title: HeroLeftMetricCards
   Description: A left-heavy asymmetric hero with a vertical stack of animated NumberFlow metric cards for React and Next.js featuring an announcement pill, headline, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-left-metric-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-[1.4fr_1fr]">

            @* Left — main copy (dominant) *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">

                @* Announcement pill *@
                <div class="mb-8">
                    <a href="#"
                       class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">All systems healthy</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">Live status</span>
                        <LucideArrowUpRightCn Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Numbers that speak<br />
                    louder than pitch decks
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                    Built for teams that measure what matters. Ship on infrastructure trusted by thousands
                    of developers.
                </p>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-[150px]">View status</ButtonCn>
                </div>
            </div>

            @* Right — stacked metric cards (narrower) *@
            <aside class="flex flex-col justify-center gap-3 border-t bg-muted/50 px-6 py-8 sm:px-8 lg:border-t-0 lg:border-l lg:px-8 lg:py-10"
                   aria-label="Key performance metrics">
                @foreach (var metric in _metrics)
                {
                    <article class="rounded-xl border bg-card px-4 py-3.5">
                        <div class="flex items-baseline gap-1.5">
                            <span class="text-3xl font-semibold tabular-nums text-foreground">
                                @(metric.Compact
                                    ? (metric.Value >= 1000 ? $"{metric.Value / 1000.0:0.#}K" : $"{metric.Value}")
                                    : $"{metric.Value:0.##}")
                            </span>
                            <span class="text-sm font-medium text-muted-foreground">@metric.Unit</span>
                        </div>
                        <div class="mt-1 flex items-center justify-between gap-2">
                            <span class="text-xs text-muted-foreground">@metric.Label</span>
                            <span class="@($"inline-flex items-center gap-1 text-[10px] font-medium tabular-nums {(metric.Positive ? "text-emerald-600 dark:text-emerald-500" : "text-red-600 dark:text-red-500")}")">
                                @if (metric.Trend == "up")
                                {
                                    <LucideTrendingUpCn Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideTrendingDownCn Size="12" Class="size-3" />
                                }
                                @metric.Delta
                            </span>
                        </div>
                    </article>
                }
            </aside>

        </div>
    </div>
</section>

@code {
    private record Metric(string Id, double Value, string Unit, string Label, string Delta, string Trend, bool Positive, bool Compact = false);

    private static readonly Metric[] _metrics =
    [
        new("latency", 42,     "ms",    "Average latency",    "18% lower", "down", true),
        new("uptime",  99.99,  "%",     "Uptime SLA",         "365 days",  "up",   true),
        new("users",   12400,  "users", "Active developers",  "24% MoM",   "up",   true, Compact: true),
    ];
}
