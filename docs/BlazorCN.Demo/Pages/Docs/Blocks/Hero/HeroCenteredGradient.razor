@* ========================================
   Block: hero-centered-gradient
   Title: Hero Centered Gradient
   Description: Centered hero with gradient text, animated badge, and stacked CTA buttons
   Long Description: Hero block with category/use case grid for navigating to different sections
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-centered-gradient.tsx
   ======================================== *@

<section class="relative overflow-hidden">
      @* Background gradient *@
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.15),rgba(255,255,255,0))]" ></div>

      <div class="container mx-auto px-4 py-24 md:py-32 lg:py-40">
        <div class="mx-auto max-w-4xl text-center">
          @* Announcement badge *@
          <BadgeCn class="mb-8 animate-pulse gap-2 px-4 py-2 text-sm" Variant="BadgeVariant.Secondary">
            <LucideSparklesCn Size="12" Class="h-3.5 w-3.5" />
            <span>Announcing our Series A funding</span>
            <LucideArrowRightCn Size="12" Class="h-3.5 w-3.5" />
          </BadgeCn>

          @* Headline *@
          <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl lg:text-7xl">
            Build products faster with 
            <span class="bg-gradient-to-r from-primary via-purple-500 to-pink-500 bg-clip-text text-transparent">
              modern tools
            </span>
          </h1>

          @* Subtitle *@
          <p class="mx-auto mb-10 max-w-2xl text-lg text-muted-foreground sm:text-xl">
            The complete platform for building production-ready applications. Ship faster, scale
            effortlessly, and focus on what matters most—your users.
          </p>

          @* CTA buttons *@
          <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
            <ButtonCn class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
              Start Building
              <LucideArrowRightCn Size="16" Class="h-4 w-4" />
            </ButtonCn>
            <ButtonCn class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
              View Documentation
            </ButtonCn>
          </div>

          @* Social proof *@
          <p class="mt-12 text-sm text-muted-foreground">
            Trusted by 10,000+ developers worldwide
          </p>
        </div>
      </div>
    </section>

