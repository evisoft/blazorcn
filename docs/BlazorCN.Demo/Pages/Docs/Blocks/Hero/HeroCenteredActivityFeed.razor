@* ============================================================
   Block: hero-centered-activity-feed
   Title: HeroCenteredActivityFeed
   Description: A centered hero with a compact live activity feed below the CTAs for React and Next.js featuring an announcement pill, dual ShadcnioButton CTAs, and staggered feed row animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-activity-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        @* Top section -- centered copy *@
        <div class="px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">
            @* Announcement pill *@
            <div class="mb-5">
                <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium">Live</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">2,847 active now</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            @* Headline *@
            <h1 class="mx-auto max-w-lg text-4xl font-bold tracking-tight sm:text-5xl">
                See what&apos;s happening right now
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                Teams around the world are shipping faster, collaborating better, and scaling with
                confidence. Join them.
            </p>

            @* CTAs *@
            <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[200px]">Get started free</ButtonCn>
                <ButtonCn Class="w-[180px]" Variant="ButtonVariant.Ghost">See how it works</ButtonCn>
            </div>
        </div>

        @* Activity feed *@
        <div class="border-t bg-muted/30 px-4 py-5 sm:px-6">
            <p class="mb-3 text-center text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                Recent activity
            </p>
            <div class="mx-auto max-w-lg space-y-1">
                @foreach (var activity in _activities)
                {
                    <div class="flex items-center gap-3 rounded-md px-3 py-2 transition-colors hover:bg-muted/50">
                        @* Avatar placeholder *@
                        <div class="size-6 shrink-0 rounded-full bg-muted-foreground/10"></div>

                        @* Activity text *@
                        <div class="flex-1 min-w-0 truncate text-sm">
                            <span class="font-medium">@activity.Name</span>
                            @(" ")
                            <span class="text-muted-foreground">@activity.Action</span>
                        </div>

                        @* Timestamp *@
                        <span class="shrink-0 text-xs text-muted-foreground">@activity.Time</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Activity(string Id, string Name, string Action, string Time);

    private static readonly Activity[] _activities =
    [
        new("a1", "Sarah M.", "just signed up for Pro", "Just now"),
        new("a2", "James L.", "deployed to production", "2 min ago"),
        new("a3", "Priya K.", "invited 3 team members", "4 min ago"),
        new("a4", "Tom R.", "upgraded to Enterprise", "7 min ago"),
        new("a5", "Lucia F.", "connected Slack integration", "11 min ago"),
    ];
}
