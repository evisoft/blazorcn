@* ============================================================
   Block: hero-dark-metric-tiles
   Title: HeroDarkMetricTiles
   Description: A dark-inverted centered hero with a four-column metric tiles grid in a light footer strip for React and Next.js built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/hero/hero-dark-metric-tiles.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        @* Dark section *@
        <div class="bg-foreground px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">
            @* Announcement pill *@
            <div class="mb-6 flex justify-center">
                <a
                    href="#"
                    class="inline-flex items-center gap-2 rounded-full border border-background/20 px-3 py-1 text-xs transition-colors hover:bg-background/10">
                    <span class="size-1.5 rounded-full bg-background/60"></span>
                    <span class="font-medium text-background">Status</span>
                    <span class="text-background/40">&middot;</span>
                    <span class="text-background/40">All systems operational</span>
                </a>
            </div>

            @* Headline *@
            <h1 class="text-4xl font-bold tracking-tight text-background sm:text-5xl">
                Infrastructure you
                <br />
                can count on
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-background/60">
                Built for teams that refuse to compromise on reliability. Enterprise-grade performance
                at every scale.
            </p>

            @* CTAs *@
            <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[180px] bg-background text-foreground hover:bg-background/90">
                    Start building
                </ButtonCn>
                <ButtonCn Class="w-[180px] border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background">
                    View status page
                </ButtonCn>
            </div>
        </div>

        @* Metrics grid — light section *@
        <div class="border-t bg-muted/30 px-6 py-8 sm:px-10 sm:py-10">
            <div class="mx-auto grid max-w-4xl grid-cols-2 gap-8 md:grid-cols-4 md:gap-10">
                @foreach (var metric in _metrics)
                {
                    <div class="text-center">
                        <p class="text-2xl font-semibold tabular-nums">@metric.Value</p>
                        <p class="mt-1 text-sm font-medium">@metric.Label</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@metric.Sublabel</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Metric(string Value, string Label, string Sublabel);

    private static readonly Metric[] _metrics =
    [
        new("99.99%", "Uptime SLA", "Last 365 days"),
        new("12ms", "Avg latency", "P50 global"),
        new("4.2B", "Requests / day", "Across all regions"),
        new("200+", "Edge locations", "6 continents"),
    ];
}
