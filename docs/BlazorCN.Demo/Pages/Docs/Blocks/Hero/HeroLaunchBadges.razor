@* ========================================
   Block: hero-launch-badges
   Title: Hero Launch Badges
   Description: Hero block with launch badges like Product Hunt, badges, and awards
   Long Description: Hero block with interactive mini-demo or playground
   Dependencies: ButtonCn
   Source: original/blocks/hero/hero-launch-badges.tsx
   ======================================== *@

<section class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="mx-auto max-w-4xl text-center">
          @* Launch badges *@
          <div class="mb-8 flex flex-wrap items-center justify-center gap-3">
            @foreach (var badge in _BADGES)
            {
              <div
                class="@(Cn.Merge("flex items-center gap-2 rounded-full border px-4 py-2", (badge.Highlight ? "border-primary bg-primary/5" : "border-border bg-muted/50")))"
              >
                <LucideTrophyCn Size="16" Class="@($"h-4 w-4 {(badge.Highlight ? "text-primary" : "text-muted-foreground")}")" />
                <div class="text-left">
                  <div class="text-sm font-semibold leading-none">@badge.Title</div>
                  <div class="text-xs text-muted-foreground">@badge.Subtitle</div>
                </div>
              </div>
            }
          </div>

          <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
            The most-loved tool for <span class="text-primary">modern teams</span>
          </h1>

          <p class="mx-auto mb-10 max-w-2xl text-lg text-muted-foreground">
            Join thousands of teams who've discovered a better way to work. See why we're the #1
            choice on Product Hunt.
          </p>

          @* Rating summary *@
          <div class="mb-10 flex items-center justify-center gap-2">
            <div class="flex">
              @for (var i = 0; i < 5; i++)
              {
                <LucideStarCn Size="20" Class="h-5 w-5 fill-yellow-400 text-yellow-400" />
              }
            </div>
            <span class="font-semibold">4.9/5</span>
            <span class="text-muted-foreground">from 1,200+ reviews</span>
          </div>

          @* CTA buttons *@
          <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
            <ButtonCn class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
              Try It Free
              <LucideArrowRightCn Size="16" Class="h-4 w-4" />
            </ButtonCn>
            <ButtonCn class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
              See Our Reviews
            </ButtonCn>
          </div>

          <p class="mt-6 text-sm text-muted-foreground">
            Free forever for individuals &#x2022; No credit card required
          </p>
        </div>
      </div>
    </section>

@code {
    private record BadgeData(string Title, string Subtitle, bool Highlight);

    private static readonly BadgeData[] _BADGES = new[]
    {
        new BadgeData("#1 Product of the Day", "Product Hunt", true),
        new BadgeData("Best New Startup", "TechCrunch Disrupt", false),
        new BadgeData("Trending on HN", "Hacker News", false),
    };
}
