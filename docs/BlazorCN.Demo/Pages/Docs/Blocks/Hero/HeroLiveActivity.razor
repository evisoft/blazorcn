@* ========================================
   Block: hero-live-activity
   Title: Hero Live Activity
   Description: Hero block with live activity feed showing recent user actions
   Dependencies: AvatarCn, BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-live-activity.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div class="flex flex-col justify-center">
                <BadgeCn Class="mb-6 w-fit gap-2" Variant="BadgeVariant.Secondary">
                    <LucideActivityCn Size="14" Class="h-3.5 w-3.5" />
                    Live Activity
                </BadgeCn>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    Join thousands <span class="text-primary">taking action</span>
                </h1>

                <p class="mb-8 max-w-lg text-lg text-muted-foreground">
                    See what's happening right now. People around the world are using our platform to
                    transform their workflow.
                </p>

                <div class="flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                        Get Started Free
                        <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                        See How It Works
                    </ButtonCn>
                </div>

                <div class="mt-8 flex items-center gap-3">
                    <div class="relative flex h-3 w-3">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
                        <span class="relative inline-flex h-3 w-3 rounded-full bg-green-500"></span>
                    </div>
                    <span class="text-sm text-muted-foreground">
                        <span class="font-semibold text-foreground">2,847</span> people active right now
                    </span>
                </div>
            </div>

            <div class="flex items-center justify-center">
                <CardCn Class="w-full max-w-md">
                    <CardContentCn Class="p-4">
                        <div class="mb-4 flex items-center justify-between">
                            <h3 class="font-semibold">Recent Activity</h3>
                            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                <span class="relative flex h-2 w-2">
                                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
                                    <span class="relative inline-flex h-2 w-2 rounded-full bg-green-500"></span>
                                </span>
                                Live
                            </div>
                        </div>

                        <div class="space-y-4">
                            @foreach (var activity in _activities)
                            {
                                <div class="flex items-center gap-3 rounded-lg bg-muted/50 p-3">
                                    <AvatarCn Class="h-10 w-10">
                                        <AvatarImageCn Src="@activity.Avatar" />
                                        <AvatarFallbackCn>@activity.Name[..1]</AvatarFallbackCn>
                                    </AvatarCn>

                                    <div class="min-w-0 flex-1">
                                        <p class="text-sm">
                                            <span class="font-medium">@activity.Name</span>
                                            <span class="text-muted-foreground"> @activity.Action</span>
                                        </p>
                                        <p class="text-xs text-muted-foreground">@activity.Location • @activity.Time</p>
                                    </div>
                                </div>
                            }
                        </div>

                        <p class="mt-4 text-center text-xs text-muted-foreground">
                            12,483 actions in the last 24 hours
                        </p>
                    </CardContentCn>
                </CardCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ActivityItem(string Name, string Avatar, string Action, string Location, string Time);

    private static readonly ActivityItem[] _activities =
    [
        new("Sarah M.", "https://i.pravatar.cc/150?img=1", "just signed up", "San Francisco, US", "Just now"),
        new("James L.", "https://i.pravatar.cc/150?img=3", "purchased Pro plan", "London, UK", "2 min ago"),
        new("Maria G.", "https://i.pravatar.cc/150?img=5", "left a 5-star review", "Berlin, DE", "5 min ago"),
        new("Alex K.", "https://i.pravatar.cc/150?img=8", "downloaded the app", "Tokyo, JP", "8 min ago"),
    ];
}
