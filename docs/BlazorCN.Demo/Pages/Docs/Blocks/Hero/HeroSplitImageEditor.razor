@* ============================================================
   Block: hero-split-image-editor
   Title: HeroSplitImageEditor
   Description: A split-layout hero with an image editor mockup for React and Next.js featuring a tool rail, canvas with selection handles, properties panel, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-image-editor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">
                @* Announcement pill *@
                <div class="mb-8">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Canvas 3.0</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">Multiplayer is live</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    A design canvas<br />
                    built for the browser
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
                    Crop, retouch, and annotate images without ever leaving the tab. Instant export,
                    version history, and realtime collaboration out of the box.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[160px]">Try it free</ButtonCn>
                    <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">Learn more</ButtonCn>
                </div>
            </div>

            @* Right — image editor mockup *@
            <div class="flex items-center p-6 lg:p-10">
                <div aria-hidden="true" class="flex w-full overflow-hidden rounded-2xl border bg-muted/50">
                    @* Left tool rail *@
                    <div class="flex w-10 flex-col items-center gap-1 border-r bg-background/60 py-3">
                        @foreach (var tool in _tools)
                        {
                            var toolItem = tool;
                            <div class="@(toolItem.Active ? "flex size-7 items-center justify-center rounded-md bg-foreground/10 text-foreground" : "flex size-7 items-center justify-center rounded-md text-muted-foreground/70")">
                                <LucideIconCn Name="@toolItem.IconName" Size="14" Class="size-3.5" />
                            </div>
                        }
                    </div>

                    @* Canvas *@
                    <div class="relative flex flex-1 items-center justify-center p-5">
                        @* Checkerboard-ish background hint *@
                        <div class="relative aspect-[4/3] w-full max-w-[260px] rounded-md bg-muted-foreground/10">
                            @* Sample image placeholder *@
                            <div class="absolute inset-3 rounded-sm bg-muted-foreground/15">
                                @* Selection outline *@
                                <div class="absolute inset-0 rounded-sm ring-1 ring-foreground/70 ring-offset-2 ring-offset-muted/50"></div>
                                @* Corner handles *@
                                <span class="absolute -top-1 -left-1 size-2 rounded-[2px] border border-background bg-foreground"></span>
                                <span class="absolute -top-1 -right-1 size-2 rounded-[2px] border border-background bg-foreground"></span>
                                <span class="absolute -bottom-1 -left-1 size-2 rounded-[2px] border border-background bg-foreground"></span>
                                <span class="absolute -right-1 -bottom-1 size-2 rounded-[2px] border border-background bg-foreground"></span>
                            </div>
                        </div>
                    </div>

                    @* Right properties panel *@
                    <div class="flex w-28 flex-col gap-3 border-l bg-background/60 p-3">
                        <div class="text-[10px] font-semibold tracking-wide text-muted-foreground uppercase">
                            Properties
                        </div>

                        @* X/Y/W/H grid *@
                        <div class="grid grid-cols-2 gap-1.5">
                            @foreach (var prop in _properties)
                            {
                                var propItem = prop;
                                <div class="flex items-center gap-1 rounded-md border bg-card px-1.5 py-1">
                                    <span class="text-[9px] font-medium text-muted-foreground">@propItem.Label</span>
                                    <span class="flex-1 text-right text-[10px] text-foreground tabular-nums">@propItem.Value</span>
                                </div>
                            }
                        </div>

                        @* Opacity slider *@
                        <div class="mt-1 flex flex-col gap-1.5">
                            <div class="flex items-center justify-between">
                                <span class="text-[9px] font-medium text-muted-foreground">Opacity</span>
                                <span class="text-[9px] text-foreground tabular-nums">82%</span>
                            </div>
                            <div class="relative h-1 rounded-full bg-muted-foreground/15">
                                <div class="absolute inset-y-0 left-0 w-[82%] rounded-full bg-foreground/70"></div>
                                <div class="-translate-y-1/2 absolute top-1/2 left-[82%] size-2.5 -translate-x-1/2 rounded-full border border-background bg-foreground shadow"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Non-destructive layers with infinite undo history",
        "Realtime multiplayer cursors and instant comments",
        "Export to PNG, SVG, and WebP in one click",
    ];

    private record ToolItem(string Id, string Label, string IconName, bool Active);

    private static readonly ToolItem[] _tools =
    [
        new("select", "Select", "mouse-pointer-2", true),
        new("crop", "Crop", "crop", false),
        new("text", "Text", "type", false),
        new("brush", "Brush", "brush", false),
    ];

    private record PropItem(string Label, string Value);

    private static readonly PropItem[] _properties =
    [
        new("X", "128"),
        new("Y", "96"),
        new("W", "480"),
        new("H", "320"),
    ];
}
