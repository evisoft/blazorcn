@* ========================================
   Block: hero-with-stats
   Title: Hero With Stats
   Description: Hero section with animated stats counter, trust badges, and dual CTA layout
   Dependencies: BadgeCn, ButtonCn, SeparatorCn
   Source: original/blocks/hero/hero-with-stats.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="mx-auto max-w-4xl">
            @* Badge *@
            <div class="mb-8 flex justify-center">
                <BadgeCn Class="gap-2 px-4 py-2" Variant="BadgeVariant.Outline">
                    <span class="relative flex h-2 w-2">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
                        <span class="relative inline-flex h-2 w-2 rounded-full bg-green-500"></span>
                    </span>
                    All systems operational
                </BadgeCn>
            </div>

            @* Headline *@
            <h1 class="mb-6 text-center text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                Infrastructure that scales with your ambition
            </h1>

            @* Subtitle *@
            <p class="mx-auto mb-10 max-w-2xl text-center text-lg text-muted-foreground sm:text-xl">
                Deploy globally in seconds. Scale automatically. Pay only for what you use. The cloud
                platform built for developers who ship fast.
            </p>

            @* CTA buttons *@
            <div class="mb-16 flex flex-col items-center justify-center gap-4 sm:flex-row">
                <ButtonCn Class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
                    Start Free Trial
                    <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                </ButtonCn>
                <ButtonCn Class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                    Talk to Sales
                </ButtonCn>
            </div>

            @* Stats *@
            <div class="mx-auto max-w-2xl rounded-2xl border bg-card p-6 shadow-sm md:p-8">
                <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-0">
                    @for (var i = 0; i < _stats.Length; i++)
                    {
                        var stat = _stats[i];
                        var index = i;
                        <div class="relative">
                            @if (index > 0)
                            {
                                <SeparatorCn Class="mb-6 md:hidden" />
                                <SeparatorCn Class="absolute left-0 top-0 hidden h-full md:block" Orientation="Orientation.Vertical" />
                            }
                            <div class="flex flex-col items-center text-center md:px-6">
                                <span class="mb-3 text-lg text-muted-foreground">@stat.Icon</span>
                                <p class="text-3xl font-bold tabular-nums tracking-tight md:text-4xl">
                                    @stat.Value
                                </p>
                                <p class="mt-1 text-sm text-muted-foreground">@stat.Label</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Trust badges *@
            <div class="mt-12 flex flex-col items-center">
                <p class="mb-6 text-sm text-muted-foreground">Trusted by industry leaders</p>
                <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
                    @foreach (var company in _companies)
                    {
                        <div class="text-lg font-semibold text-muted-foreground/50">
                            @company
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Stat(string Icon, string Value, string Label);

    private static readonly Stat[] _stats =
    [
        new("\ud83d\udc65", "10K+", "Active Users"),
        new("\ud83d\udee1\ufe0f", "99.9%", "Uptime SLA"),
        new("\u26a1", "50ms", "Avg Response"),
    ];

    private static readonly string[] _companies = ["Vercel", "Stripe", "Linear", "Notion", "Figma"];
}
