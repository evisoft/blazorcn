@* ============================================================
   Block: hero-split-database-schema
   Title: HeroSplitDatabaseSchema
   Description: A split-layout hero with an entity relationship diagram mockup of three table boxes connected by SVG lines for React and Next.js featuring an announcement pill, feature checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-database-schema.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="grid lg:grid-cols-2">

      @* Left — copy *@
      <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">

        @* Announcement pill *@
        <div class="mb-8">
          <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="font-medium">v2 launch</span>
            <span class="text-muted-foreground">·</span>
            <span class="text-muted-foreground">Branching for Postgres</span>
            <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
          </a>
        </div>

        @* Headline *@
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          The database
          <br />
          that knows your schema
        </h1>

        @* Subtitle *@
        <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
          A type-safe ORM and migration toolkit that turns your schema into a single source of
          truth — from local dev to production.
        </p>

        @* Feature checklist *@
        <ul class="mt-6 space-y-2.5">
          @foreach (var feature in _features)
          {
            <li class="flex items-center gap-3">
              <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
              <span class="text-sm text-foreground">@feature</span>
            </li>
          }
        </ul>

        @* CTAs *@
        <div class="mt-8 flex items-center gap-3">
          <ButtonCn Class="w-[180px]">Start building</ButtonCn>
          <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">Read the docs</ButtonCn>
        </div>

      </div>

      @* Right — ER schema mockup *@
      <div class="flex items-center p-6 lg:p-8">
        <div class="w-full overflow-hidden rounded-2xl border bg-muted/50" aria-hidden="true">

          @* Diagram chrome *@
          <div class="flex items-center gap-2 border-b bg-background/60 px-4 py-2.5">
            <div class="flex gap-1.5">
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
              <span class="size-2 rounded-full bg-muted-foreground/15"></span>
            </div>
            <span class="ml-2 font-mono text-[10px] text-muted-foreground/60">schema.prisma</span>
          </div>

          @* Schema SVG *@
          <div class="p-5 sm:p-6">
            <svg aria-hidden="true" viewBox="0 0 300 240" class="h-auto w-full" fill="none">

              @* Relation lines *@
              @foreach (var rel in _relations)
              {
                var fromEdge = GetEntityRightEdge(rel.From);
                var toEdge = GetEntityLeftEdge(rel.To);
                var midX = (fromEdge.X + toEdge.X) / 2.0;
                var pathD = $"M {fromEdge.X} {fromEdge.Y} C {midX} {fromEdge.Y}, {midX} {toEdge.Y}, {toEdge.X} {toEdge.Y}";
                <path d="@pathD"
                      stroke="currentColor"
                      stroke-width="1.25"
                      stroke-dasharray="3 3"
                      class="text-muted-foreground/50" />
              }

              @* Crow's foot endpoints (small circles) *@
              @foreach (var rel in _relations)
              {
                var fromEdge = GetEntityRightEdge(rel.From);
                var toEdge = GetEntityLeftEdge(rel.To);
                <g>
                  <circle cx="@fromEdge.X" cy="@fromEdge.Y" r="2" class="fill-muted-foreground/60" />
                  <circle cx="@toEdge.X" cy="@toEdge.Y" r="2" class="fill-muted-foreground/60" />
                </g>
              }

              @* Entity boxes *@
              @foreach (var entity in _entities)
              {
                var height = GetEntityHeight(entity);
                <g>
                  @* Outer box *@
                  <rect x="@entity.X" y="@entity.Y" width="@EntityWidth" height="@height" rx="6" ry="6"
                        class="fill-background stroke-border" stroke-width="1" />
                  @* Header background *@
                  <rect x="@entity.X" y="@entity.Y" width="@EntityWidth" height="@HeaderHeight" rx="6" ry="6"
                        class="fill-muted/80" />
                  @* Bottom mask of header rounding *@
                  <rect x="@entity.X" y="@(entity.Y + HeaderHeight - 6)" width="@EntityWidth" height="6"
                        class="fill-muted/80" />
                  @* Header bottom border line *@
                  <line x1="@entity.X" y1="@(entity.Y + HeaderHeight)"
                        x2="@(entity.X + EntityWidth)" y2="@(entity.Y + HeaderHeight)"
                        class="stroke-border" stroke-width="1" />
                  @* Table name *@
                  <text x="@(entity.X + 10)" y="@(entity.Y + 16)"
                        class="fill-foreground font-mono font-semibold text-[10px]">@entity.Name</text>

                  @* Field rows *@
                  @foreach (var (field, fi) in entity.Fields.Select((f, i) => (f, i)))
                  {
                    var fy = entity.Y + HeaderHeight + 4 + fi * FieldHeight;
                    <g>
                      <text x="@(entity.X + 10)" y="@(fy + 10)"
                            class="fill-foreground/80 font-mono text-[9px]">@field.Name</text>
                      <text x="@(entity.X + EntityWidth - 10)" y="@(fy + 10)"
                            text-anchor="end"
                            class="fill-muted-foreground font-mono text-[8px]">@field.Type</text>
                    </g>
                  }
                </g>
              }

            </svg>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

@code {
    private const int EntityWidth = 110;
    private const int HeaderHeight = 24;
    private const int FieldHeight = 16;

    private record EntityField(string Name, string Type);
    private record Entity(string Id, string Name, int X, int Y, EntityField[] Fields);
    private record Relation(string From, string To);
    private record Point(double X, double Y);

    private static readonly string[] _features =
    [
        "Type-safe queries from a single schema source",
        "Auto-generated migrations with rollback safety",
        "Postgres, MySQL, and SQLite from one client",
    ];

    private static readonly Entity[] _entities =
    [
        new("users", "users", 12, 18,
        [
            new("id", "uuid"),
            new("email", "text"),
            new("created_at", "timestamptz"),
        ]),
        new("orders", "orders", 178, 14,
        [
            new("id", "uuid"),
            new("user_id", "uuid"),
            new("total_cents", "int"),
            new("placed_at", "timestamptz"),
        ]),
        new("products", "products", 178, 138,
        [
            new("id", "uuid"),
            new("title", "text"),
            new("price_cents", "int"),
        ]),
    ];

    private static readonly Relation[] _relations =
    [
        new("users", "orders"),
        new("products", "orders"),
    ];

    private static int GetEntityHeight(Entity entity) =>
        HeaderHeight + entity.Fields.Length * FieldHeight + 6;

    private static Point GetEntityRightEdge(string id)
    {
        var entity = Array.Find(_entities, e => e.Id == id);
        if (entity is null) return new Point(0, 0);
        return new Point(entity.X + EntityWidth, entity.Y + GetEntityHeight(entity) / 2.0);
    }

    private static Point GetEntityLeftEdge(string id)
    {
        var entity = Array.Find(_entities, e => e.Id == id);
        if (entity is null) return new Point(0, 0);
        return new Point(entity.X, entity.Y + GetEntityHeight(entity) / 2.0);
    }
}
