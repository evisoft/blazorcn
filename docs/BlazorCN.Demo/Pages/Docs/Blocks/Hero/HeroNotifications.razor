@* ========================================
   Block: hero-notifications
   Title: Hero Notifications
   Description: Hero block with notification/alert style preview showing real-time updates
   Long Description: Hero block with prominent newsletter signup, social proof counter, and privacy-focused messaging
   Dependencies: AvatarCn, BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-notifications.tsx
   ======================================== *@

<section class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
          @* Left content *@
          <div class="flex flex-col justify-center">
            <BadgeCn class="mb-6 w-fit gap-2" Variant="BadgeVariant.Secondary">
              <LucideBellCn Size="12" Class="h-3.5 w-3.5" />
              Real-time Alerts
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
              Never miss what <span class="text-primary">matters</span>
            </h1>

            <p class="mb-8 max-w-lg text-lg text-muted-foreground">
              Intelligent notifications that keep you informed without overwhelming you. Get the
              right alert at the right time.
            </p>

            <div class="flex flex-col gap-3 sm:flex-row">
              <ButtonCn class="gap-2" Size="ButtonSize.Lg">
                Get Started
                <LucideArrowRightCn Size="16" Class="h-4 w-4" />
              </ButtonCn>
              <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                View Integrations
              </ButtonCn>
            </div>

            <div class="mt-8 flex items-center gap-6 text-sm text-muted-foreground">
              <div class="flex items-center gap-2">
                <LucideCircleCheckCn Size="16" Class="h-4 w-4 text-primary" />
                Slack integration
              </div>
              <div class="flex items-center gap-2">
                <LucideCircleCheckCn Size="16" Class="h-4 w-4 text-primary" />
                Email digest
              </div>
              <div class="flex items-center gap-2">
                <LucideCircleCheckCn Size="16" Class="h-4 w-4 text-primary" />
                Mobile push
              </div>
            </div>
          </div>

          @* Right - Notification stack *@
          <div class="flex items-center justify-center">
            <div class="relative w-full max-w-sm">
              @* Notification cards stacked *@
              @{ var index = 0; }
              @foreach (var notification in _NOTIFICATIONS)
              {
                <CardCn
                  class="relative mb-3 shadow-lg transition-all hover:shadow-xl"
                  style="@($"transform: translateY({index * 4}px); z-index: {_NOTIFICATIONS.Length - index}")"
                >
                  <CardContentCn class="p-4">
                    <div class="flex items-start gap-3">
                      @if (notification.Avatar != null)
                      {
                        <AvatarCn class="h-10 w-10">
                          <AvatarImageCn src="@notification.Avatar" Alt="" />
                          <AvatarFallbackCn>U</AvatarFallbackCn>
                        </AvatarCn>
                      }
                      else
                      {
                        <div class="@(Cn.Merge("mt-0.5", notification.Color))">
                          <LucideCircleCheckCn Size="20" Class="h-5 w-5" />
                        </div>
                      }
                      <div class="flex-1 min-w-0">
                        <div class="flex items-start justify-between gap-2">
                          <p class="font-medium text-sm">@notification.Title</p>
                          <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="shrink-0" aria-label="Close">
                            <LucideXCn Size="16" Class="h-4 w-4" />
                          </ButtonCn>
                        </div>
                        <p class="text-sm text-muted-foreground">@notification.Description</p>
                        <p class="mt-1 text-xs text-muted-foreground">@notification.Time</p>
                      </div>
                    </div>
                  </CardContentCn>
                </CardCn>
                index++;
              }

              @* "More" indicator *@
              <div class="mt-2 text-center">
                <span class="text-sm text-muted-foreground">+ 12 more notifications</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

@code {
    private record NotificationData(string Type, string Title, string Description, string Time, string Color, string? Avatar = null);

    private static readonly NotificationData[] _NOTIFICATIONS = new[]
    {
        new NotificationData("success", "Deployment successful", "Your app is now live at app.example.com", "Just now", "text-green-500"),
        new NotificationData("info", "New team member", "Sarah joined the design team", "2 min ago", "text-blue-500", "https://i.pravatar.cc/150?img=5"),
        new NotificationData("warning", "Storage almost full", "You've used 90% of your storage quota", "5 min ago", "text-yellow-500"),
    };
}
