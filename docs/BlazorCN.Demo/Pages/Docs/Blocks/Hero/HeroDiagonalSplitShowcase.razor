@* ============================================================
   Block: hero-diagonal-split-showcase
   Title: HeroDiagonalSplitShowcase
   Description: A diagonal split showcase hero for React and Next.js featuring two skewed panels divided by a CSS clip path with a dark inverted copy panel and a light stat tile panel and a single ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-diagonal-split-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="relative overflow-hidden rounded-2xl border bg-card">
        @* Stacked container — uses grid for mobile fallback, absolute clip path on md+ *@
        <div class="grid min-h-[520px] md:grid-cols-2">

            @* LEFT — dark inverted panel with copy + CTA *@
            <div class="relative z-10 flex flex-col justify-center bg-foreground px-8 py-12 text-background sm:px-12 md:py-14 lg:px-14 lg:py-16 [clip-path:none] md:[clip-path:polygon(0_0,100%_0,88%_100%,0_100%)]">
                @* Tag row *@
                <div class="mb-5 flex items-center gap-2">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-background/60">
                        Volume 06
                    </span>
                </div>
                @* Headline *@
                <h1 class="max-w-md text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl">
                    Built loud.
                    <br />
                    Shipped quiet.
                </h1>
                @* Subtitle *@
                <p class="mt-5 max-w-md text-base leading-relaxed text-background/65 sm:text-lg">
                    The platform behind the products you already use. No ceremony, no roadmap theater,
                    just shipped surface area.
                </p>
                @* CTA *@
                <div class="mt-8">
                    <ButtonCn Class="w-[180px] bg-background text-foreground hover:bg-background/90">
                        Read the manifesto
                    </ButtonCn>
                </div>
            </div>

            @* RIGHT — light stats panel, sits behind the diagonal cut on md+ *@
            <div class="relative flex flex-col justify-center bg-card px-8 py-12 sm:px-12 md:py-14 lg:px-14 lg:py-16 md:-ml-16 md:pl-24 lg:pl-32">
                <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-muted-foreground">
                    By the numbers
                </p>
                <div class="mt-6 space-y-6">
                    @foreach (var stat in _stats)
                    {
                        <div class="border-border border-b pb-5 last:border-b-0 last:pb-0">
                            <p class="text-3xl font-semibold tabular-nums tracking-tight text-foreground sm:text-4xl">
                                @stat.Value
                            </p>
                            <p class="mt-1 text-xs font-medium text-muted-foreground">@stat.Label</p>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record Stat(string Value, string Label);

    private static readonly Stat[] _stats =
    [
        new("2.4M", "Active builders"),
        new("180+", "Countries shipped"),
        new("99.9%", "Platform uptime"),
    ];
}
