@* ============================================================
   Block: hero-centered-masonry-gallery
   Title: HeroCenteredMasonryGallery
   Description: A centered hero with a 3-column masonry-style image gallery below the headline for React and Next.js featuring crosshair placeholder cells, dual ShadcnioButton CTAs, and varying aspect ratios built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-masonry-gallery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        @* Header *@
        <div class="px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">
            <h1 class="mx-auto max-w-xl text-4xl font-bold tracking-tight sm:text-5xl">
                Crafting digital<br />experiences
            </h1>

            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                We design and build beautiful digital products that help brands connect with their
                audience. From concept to launch.
            </p>

            <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[180px]">View portfolio</ButtonCn>
                <ButtonCn Class="w-[160px]" Variant="ButtonVariant.Ghost">Our process</ButtonCn>
            </div>
        </div>

        @* Masonry gallery *@
        <div class="border-t px-6 pb-6 pt-6" aria-hidden="true">
            <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
                @foreach (var col in _columns)
                {
                    <div class="flex flex-col gap-3">
                        @foreach (var cell in col)
                        {
                            var outerSize = GetSizeMap(cell.Aspect).Outer;
                            var innerSize = GetSizeMap(cell.Aspect).Inner;
                            var lineSize = GetSizeMap(cell.Aspect).Line;
                            <div class="@($"{cell.Aspect} flex w-full items-center justify-center rounded-xl bg-muted")">
                                <div class="relative flex items-center justify-center">
                                    <div class="@($"absolute {outerSize} rounded-full border border-muted-foreground/[0.06]")"></div>
                                    <div class="@($"absolute {innerSize} rounded-full border border-muted-foreground/[0.08]")"></div>
                                    <div class="@($"absolute h-px {lineSize} bg-muted-foreground/[0.06]")"></div>
                                    <div class="@($"absolute {lineSize} h-px rotate-90 bg-muted-foreground/[0.06]")"></div>
                                    <div class="flex size-8 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                                        <LucideIconCn Name="image" Size="14" Class="size-3.5 text-muted-foreground/40" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record GalleryCell(string Aspect, int Column);

    private record CellSizes(string Outer, string Inner, string Line);

    private static readonly GalleryCell[] _galleryCells =
    [
        new("aspect-square",  0),
        new("aspect-[4/3]",   0),
        new("aspect-[3/4]",   1),
        new("aspect-square",  1),
        new("aspect-[4/3]",   2),
        new("aspect-square",  2),
    ];

    private static readonly Dictionary<string, CellSizes> _sizeMap = new()
    {
        ["aspect-square"] = new CellSizes("size-20", "size-12", "w-28"),
        ["aspect-[4/3]"]  = new CellSizes("size-16", "size-10", "w-24"),
        ["aspect-[3/4]"]  = new CellSizes("size-20", "size-12", "w-28"),
    };

    private static CellSizes GetSizeMap(string aspect) =>
        _sizeMap.TryGetValue(aspect, out var s) ? s : _sizeMap["aspect-square"];

    private IEnumerable<GalleryCell>[] _columns =
    [
        _galleryCells.Where(c => c.Column == 0).ToArray(),
        _galleryCells.Where(c => c.Column == 1).ToArray(),
        _galleryCells.Where(c => c.Column == 2).ToArray(),
    ];
}
