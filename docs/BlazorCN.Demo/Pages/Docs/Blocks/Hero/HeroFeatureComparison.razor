@* ============================================================
   Block: hero-feature-comparison
   Title: HeroFeatureComparison
   Description: A split-layout hero for React and Next.js with headline and dual ShadcnioButton CTAs on the left and a compact Us vs Others comparison table with check and cross indicators on the right, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-feature-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid md:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 md:py-10 lg:px-14 lg:py-12">
                @* Announcement pill *@
                <div class="mb-5">
                    <span class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Switching is easy</span>
                    </span>
                </div>

                @* Headline *@
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
                    More features,<br />
                    less complexity
                </h1>

                @* Subtitle *@
                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    See why teams are switching. We include everything you need out of the box so you can
                    focus on building, not configuring.
                </p>

                @* CTAs *@
                <div class="mt-7 flex flex-col items-start gap-3 sm:flex-row">
                    <ButtonCn Class="w-[200px]">Start free trial</ButtonCn>
                    <ButtonCn Class="w-[210px]" Variant="ButtonVariant.Ghost">View full comparison</ButtonCn>
                </div>

                @* Trust text *@
                <p class="mt-5 text-xs text-muted-foreground">
                    Free 14-day trial &middot; No credit card required &middot; Cancel anytime
                </p>
            </div>

            @* Right — comparison table *@
            <div class="flex items-center border-t bg-muted/30 p-6 sm:p-8 md:border-l md:border-t-0">
                <div class="w-full overflow-hidden rounded-lg border bg-card">
                    <table class="w-full">
                        <thead>
                            <tr class="border-b bg-muted/50">
                                <th class="px-4 py-2.5 text-left text-xs font-medium text-muted-foreground">Feature</th>
                                <th class="w-20 px-3 py-2.5 text-center text-xs font-semibold">Us</th>
                                <th class="w-20 px-3 py-2.5 text-center text-xs font-medium text-muted-foreground">Others</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (row, idx) in _comparisonRows.Select((r, i) => (r, i)))
                            {
                                <tr class="@(idx < _comparisonRows.Length - 1 ? "border-b" : "")">
                                    <td class="px-4 py-2.5 text-sm">@row.Feature</td>
                                    <td class="px-3 py-2.5">
                                        <div class="flex justify-center">
                                            @if (row.Us)
                                            {
                                                <LucideIconCn Name="check" Size="14" Class="size-3.5 shrink-0 text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="minus" Size="14" Class="size-3.5 text-muted-foreground/40" />
                                            }
                                        </div>
                                    </td>
                                    <td class="px-3 py-2.5">
                                        <div class="flex justify-center">
                                            @if (row.Others)
                                            {
                                                <LucideIconCn Name="check" Size="14" Class="size-3.5 shrink-0 text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="minus" Size="14" Class="size-3.5 text-muted-foreground/40" />
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="border-t bg-muted/50">
                                <td class="px-4 py-2.5 text-xs font-medium text-muted-foreground">Starting price</td>
                                <td class="px-3 py-2.5 text-center text-sm font-semibold">$19/mo</td>
                                <td class="px-3 py-2.5 text-center text-xs text-muted-foreground">$49/mo</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ComparisonRow(string Feature, bool Us, bool Others);

    private static readonly ComparisonRow[] _comparisonRows =
    [
        new("Unlimited projects", true, true),
        new("Real-time collaboration", true, false),
        new("Custom integrations", true, false),
        new("SOC 2 compliance", true, false),
        new("Self-hosting option", true, false),
        new("Priority support", true, true),
    ];
}
