@* ============================================================
   Block: hero-tabbed-product-views
   Title: HeroTabbedProductViews
   Description: A tabbed product views hero for React and Next.js featuring a PillTabs segmented control with three swappable mockup panels for chat, code, and docs and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-tabbed-product-views.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="px-6 py-10 sm:px-10 sm:py-12 lg:px-14">

            @* Headline *@
            <div class="text-center">
                <h1 class="mx-auto max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl">
                    Three surfaces,<br />
                    one workspace
                </h1>
                <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    Switch between chat, code, and docs without ever leaving your flow. Pick a tab below
                    to take a peek.
                </p>
            </div>

            @* PillTabs control *@
            <div class="mt-7 flex justify-center">
                <div class="inline-flex items-center gap-1 rounded-full border bg-muted p-1 text-sm font-medium" role="tablist" aria-label="Product view" id="hero-product-view">
                    @foreach (var tab in _tabs)
                    {
                        var tabKey = tab;
                        <button type="button"
                                role="tab"
                                aria-selected="@(_activeTab == tabKey ? "true" : "false")"
                                class="@Cn.Merge("rounded-full px-4 py-1.5 transition-colors", _activeTab == tabKey ? "bg-background shadow text-foreground" : "text-muted-foreground hover:text-foreground")"
                                @onclick="@(() => _activeTab = tabKey)">
                            @_tabLabels[tabKey]
                        </button>
                    }
                </div>
            </div>

            @* Mockup panels *@
            <div class="mx-auto mt-7 max-w-xl" aria-hidden="true">
                <div class="relative min-h-[208px] overflow-hidden rounded-xl border bg-muted/40 p-5">

                    @if (_activeTab == "chat")
                    {
                        <div class="space-y-2.5">
                            @* Bot bubble *@
                            <div class="flex items-start gap-2">
                                <div class="size-6 shrink-0 rounded-full bg-muted-foreground/15"></div>
                                <div class="max-w-[78%] space-y-1.5 rounded-2xl rounded-tl-sm bg-background px-3 py-2">
                                    <div class="h-2 w-44 rounded-full bg-muted-foreground/15"></div>
                                    <div class="h-2 w-32 rounded-full bg-muted-foreground/10"></div>
                                </div>
                            </div>
                            @* User bubble *@
                            <div class="flex items-start justify-end gap-2">
                                <div class="max-w-[78%] space-y-1.5 rounded-2xl rounded-tr-sm bg-foreground px-3 py-2">
                                    <div class="h-2 w-36 rounded-full bg-background/30"></div>
                                </div>
                            </div>
                            @* Bot bubble *@
                            <div class="flex items-start gap-2">
                                <div class="size-6 shrink-0 rounded-full bg-muted-foreground/15"></div>
                                <div class="max-w-[78%] space-y-1.5 rounded-2xl rounded-tl-sm bg-background px-3 py-2">
                                    <div class="h-2 w-52 rounded-full bg-muted-foreground/15"></div>
                                    <div class="h-2 w-40 rounded-full bg-muted-foreground/10"></div>
                                    <div class="h-2 w-24 rounded-full bg-muted-foreground/10"></div>
                                </div>
                            </div>
                            @* Input row *@
                            <div class="mt-3 flex h-8 items-center gap-2 rounded-full border bg-background px-3">
                                <div class="h-2 flex-1 rounded-full bg-muted-foreground/10"></div>
                                <div class="size-1.5 rounded-full bg-emerald-500"></div>
                            </div>
                        </div>
                    }

                    @if (_activeTab == "code")
                    {
                        <div class="font-mono text-[11px]">
                            @* Window chrome *@
                            <div class="-m-1 mb-3 flex items-center gap-1.5 border-b border-border/60 px-2 pb-3">
                                <span class="size-2 rounded-full bg-muted-foreground/20"></span>
                                <span class="size-2 rounded-full bg-muted-foreground/20"></span>
                                <span class="size-2 rounded-full bg-muted-foreground/20"></span>
                                <span class="ml-2 text-[10px] text-muted-foreground">~/projects/api</span>
                            </div>
                            @* Lines *@
                            <div class="space-y-1.5">
                                <div class="flex items-center gap-3">
                                    <span class="w-4 text-right text-muted-foreground/40">1</span>
                                    <span class="text-emerald-600 dark:text-emerald-500">$</span>
                                    <span class="text-muted-foreground">npm install workspace</span>
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="w-4 text-right text-muted-foreground/40">2</span>
                                    <div class="h-1.5 w-40 rounded-full bg-muted-foreground/15"></div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="w-4 text-right text-muted-foreground/40">3</span>
                                    <div class="h-1.5 w-32 rounded-full bg-muted-foreground/15"></div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="w-4 text-right text-muted-foreground/40">4</span>
                                    <span class="text-emerald-600 dark:text-emerald-500">$</span>
                                    <span class="text-muted-foreground">workspace deploy</span>
                                    <span class="inline-block h-3 w-1.5 animate-pulse bg-foreground"></span>
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="w-4 text-right text-muted-foreground/40">5</span>
                                    <div class="h-1.5 w-48 rounded-full bg-muted-foreground/15"></div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_activeTab == "docs")
                    {
                        <div>
                            @* Doc page in a faux frame *@
                            <div class="rounded-lg border bg-background px-5 py-4">
                                <div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                                    Quickstart
                                </div>
                                <div class="mt-2 h-3 w-3/5 rounded-full bg-muted-foreground/20"></div>
                                <div class="mt-3 space-y-1.5">
                                    <div class="h-2 w-full rounded-full bg-muted-foreground/12"></div>
                                    <div class="h-2 w-11/12 rounded-full bg-muted-foreground/12"></div>
                                    <div class="h-2 w-9/12 rounded-full bg-muted-foreground/12"></div>
                                </div>
                                <div class="mt-3 rounded-md bg-muted/60 px-3 py-2">
                                    <div class="h-1.5 w-2/3 rounded-full bg-muted-foreground/20"></div>
                                </div>
                                <div class="mt-3 space-y-1.5">
                                    <div class="h-2 w-10/12 rounded-full bg-muted-foreground/12"></div>
                                    <div class="h-2 w-7/12 rounded-full bg-muted-foreground/12"></div>
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>

            @* CTAs *@
            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-[150px]">View docs</ButtonCn>
            </div>

        </div>
    </div>
</section>

@code {
    private string _activeTab = "chat";

    private static readonly string[] _tabs = ["chat", "code", "docs"];

    private static readonly Dictionary<string, string> _tabLabels = new()
    {
        { "chat", "Chat" },
        { "code", "Code" },
        { "docs", "Docs" },
    };
}
