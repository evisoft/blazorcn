@* ============================================================
   Block: hero-split-progress-tracker
   Title: HeroSplitProgressTracker
   Description: A split-layout hero with an onboarding progress tracker mockup for React and Next.js featuring an announcement pill, feature checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-progress-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">
                @* Announcement pill *@
                <div class="mb-6">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Faster onboarding</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">Now with AI hints</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Activation that<br />
                    actually activates
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                    Turn sign-ups into power users with a guided setup flow that adapts to each persona.
                    No more empty dashboards or lost trials.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                    <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">Learn more</ButtonCn>
                </div>
            </div>

            @* Right — onboarding progress tracker mockup *@
            <div class="flex items-center p-6 lg:p-10" aria-hidden="true">
                <div class="w-full overflow-hidden rounded-2xl border bg-muted/50">
                    @* Window chrome *@
                    <div class="flex items-center gap-2 border-b bg-background/60 px-4 py-2.5">
                        <div class="flex gap-1.5">
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                        </div>
                        <div class="ml-2 h-2 w-24 rounded-full bg-muted-foreground/10"></div>
                    </div>

                    <div class="p-5 sm:p-6">
                        @* Panel header *@
                        <div class="mb-4 flex items-center justify-between">
                            <div class="h-2 w-20 rounded-full bg-muted-foreground/15"></div>
                            <div class="h-2 w-10 rounded-full bg-muted-foreground/10"></div>
                        </div>

                        @* Step list with connecting line *@
                        <ol class="relative space-y-4">
                            @* Vertical progress line *@
                            <div class="absolute top-3 bottom-3 left-[11px] w-px bg-border" aria-hidden="true"></div>

                            @foreach (var step in _steps)
                            {
                                <li class="relative flex items-start gap-3">
                                    @* Step indicator *@
                                    <div class="relative z-10 flex size-6 shrink-0 items-center justify-center">
                                        @if (step.Status == "complete")
                                        {
                                            <span class="flex size-6 items-center justify-center rounded-full bg-emerald-500 text-background">
                                                <LucideIconCn Name="check" Size="14" Class="size-3.5" StrokeWidth="3" />
                                            </span>
                                        }
                                        @if (step.Status == "active")
                                        {
                                            <span class="flex size-6 items-center justify-center rounded-full border-2 border-emerald-500 bg-background">
                                                <span class="size-2 rounded-full bg-emerald-500"></span>
                                            </span>
                                        }
                                        @if (step.Status == "pending")
                                        {
                                            <span class="flex size-6 items-center justify-center rounded-full border border-border bg-background">
                                                <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                                            </span>
                                        }
                                    </div>

                                    @* Step content *@
                                    <div class="min-w-0 flex-1 pt-0.5">
                                        <div class="@(step.Status == "pending" ? "text-xs font-medium text-muted-foreground" : "text-xs font-semibold text-foreground")">
                                            @step.Title
                                        </div>
                                        <div class="mt-0.5 text-[11px] text-muted-foreground">
                                            @step.Description
                                        </div>
                                    </div>
                                </li>
                            }
                        </ol>

                        @* Summary bar *@
                        <div class="mt-5 border-t pt-4">
                            <div class="mb-2 flex items-center justify-between">
                                <span class="text-[11px] font-medium text-foreground">
                                    @_completeCount of @_steps.Length complete
                                </span>
                                <span class="text-[11px] tabular-nums text-muted-foreground">
                                    @_progressPct%
                                </span>
                            </div>
                            <div class="h-1 w-full overflow-hidden rounded-full bg-muted-foreground/10">
                                <div class="h-full rounded-full bg-emerald-500" style="@($"width:{_progressPct}%")"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Guided setup that adapts to each user persona",
        "Real-time progress sync across web and mobile",
        "Drop-off alerts when users stall on a step",
    ];

    private record Step(string Id, string Title, string Description, string Status);

    private static readonly Step[] _steps =
    [
        new("s1", "Create workspace", "Name your team and pick a subdomain", "complete"),
        new("s2", "Invite teammates", "Send invites to collaborators", "complete"),
        new("s3", "Connect data source", "Link GitHub, Postgres, or Stripe", "active"),
        new("s4", "Configure alerts", "Route notifications to Slack", "pending"),
        new("s5", "Ship first project", "Deploy to production", "pending"),
    ];

    private static readonly int _completeCount = _steps.Count(s => s.Status == "complete");
    private static readonly int _progressPct = (int)Math.Round((double)_completeCount / _steps.Length * 100);
}
