@* ========================================
   Block: hero-comparison
   Title: Hero Comparison
   Description: Hero block with before/after comparison slider, transformation showcase, and visual impact demo
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-comparison.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div class="flex flex-col justify-center">
                <BadgeCn Class="mb-6 w-fit gap-2" Variant="BadgeVariant.Secondary">
                    <LucideSparklesCn Size="14" Class="h-3.5 w-3.5" />
                    See the difference
                </BadgeCn>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    Transform your images with <span class="text-primary">one click</span>
                </h1>

                <p class="mb-8 max-w-lg text-lg text-muted-foreground">
                    Our AI-powered tools enhance your photos instantly. From color correction to complete
                    transformations, see the magic happen in real-time.
                </p>

                <div class="mb-8 grid grid-cols-2 gap-4 sm:grid-cols-3">
                    @foreach (var stat in _stats)
                    {
                        <div>
                            <p class="text-2xl font-bold">@stat.Value</p>
                            <p class="text-sm text-muted-foreground">@stat.Label</p>
                        </div>
                    }
                </div>

                <div class="flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                        Try It Free
                        <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                        See Examples
                    </ButtonCn>
                </div>
            </div>

            <div class="relative aspect-[4/3] cursor-ew-resize select-none overflow-hidden rounded-2xl shadow-2xl">
                <img alt="After enhancement" class="absolute inset-0 h-full w-full object-cover" height="800"
                     src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?auto=format&w=1200&q=85" width="1200" />

                <div class="absolute inset-0 overflow-hidden" style="clip-path: inset(0 @(100 - _sliderPosition)% 0 0)">
                    <img alt="Before enhancement" class="absolute inset-0 h-full w-full object-cover" height="800"
                         src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?auto=format&w=1200&q=85&sat=-100" width="1200" />
                </div>

                <div class="absolute top-0 bottom-0 z-10 w-1 bg-white shadow-lg" style="left: @(_sliderPosition)%; transform: translateX(-50%)">
                    <div class="absolute top-1/2 left-1/2 flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-white bg-white shadow-lg">
                        <LucideGripVerticalCn Size="20" Class="h-5 w-5 text-gray-600" />
                    </div>
                </div>

                <div class="pointer-events-none absolute inset-0">
                    <div class="absolute left-4 top-4 rounded-full bg-black/50 px-3 py-1 text-sm font-medium text-white backdrop-blur-sm"
                         style="opacity: @(_sliderPosition > 15 ? 1 : 0)">Before</div>
                    <div class="absolute right-4 top-4 rounded-full bg-black/50 px-3 py-1 text-sm font-medium text-white backdrop-blur-sm"
                         style="opacity: @(_sliderPosition < 85 ? 1 : 0)">After</div>
                </div>

                <div class="absolute inset-x-0 bottom-4 flex justify-center">
                    <div class="rounded-full bg-black/50 px-4 py-2 text-sm text-white backdrop-blur-sm">
                        Drag to compare
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Stat(string Value, string Label);

    private double _sliderPosition = 50;

    private static readonly Stat[] _stats =
    [
        new("2M+", "Photos Enhanced"),
        new("500K hrs", "Time Saved"),
        new("50K+", "Happy Users"),
    ];
}
