@* ============================================================
   Block: hero-centered-founder-avatars
   Title: HeroCenteredFounderAvatars
   Description: A centered hero with an overlapping founder avatar row trust signal for React and Next.js featuring initials-based gradient avatars, a two-line bold headline, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-founder-avatars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card px-6 py-10 sm:px-8 lg:px-12 lg:py-12">
        <div class="flex flex-col items-center text-center">
            <div class="flex items-center">
                @foreach (var founder in _founders)
                {
                    var idx = Array.IndexOf(_founders, founder);
                    var gradientId = $"founder-{founder.Initials.ToLower()}";
                    <span class="relative inline-block size-12 overflow-hidden rounded-full ring-2 ring-card"
                          style="@($"margin-left:{(idx == 0 ? "0" : "-14px")};z-index:{_founders.Length - idx}")">
                        <svg aria-label="@($"{founder.Name} avatar")"
                             class="size-full"
                             viewBox="0 0 48 48"
                             xmlns="http://www.w3.org/2000/svg">
                            <title>@founder.Name</title>
                            <defs>
                                <linearGradient id="@gradientId" x1="0%" x2="100%" y1="0%" y2="100%">
                                    <stop offset="0%" stop-color="@founder.From" />
                                    <stop offset="100%" stop-color="@founder.To" />
                                </linearGradient>
                            </defs>
                            <rect fill="@($"url(#{gradientId})")" height="48" width="48" />
                            <text dominant-baseline="central"
                                  fill="white"
                                  font-family="ui-sans-serif, system-ui, sans-serif"
                                  font-size="18"
                                  font-weight="600"
                                  text-anchor="middle"
                                  x="24"
                                  y="25">@founder.Initials</text>
                        </svg>
                    </span>
                }
            </div>

            <p class="mt-4 text-xs text-muted-foreground">
                @foreach (var founder in _founders)
                {
                    var idx = Array.IndexOf(_founders, founder);
                    <span>
                        <span class="font-medium text-foreground">@founder.Name</span>
                        @(", ")
                        <span>@founder.Role</span>
                        @if (idx < _founders.Length - 1)
                        {
                            <span class="mx-2 text-muted-foreground/60">&bull;</span>
                        }
                    </span>
                }
            </p>

            <h1 class="mt-8 text-4xl font-bold tracking-tight sm:text-5xl">
                Built by the people
                <br />
                <span class="text-muted-foreground">who used to break it</span>
            </h1>

            <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
                Three engineers who spent a decade shipping infrastructure at scale finally got tired of
                bad tooling. So we built the product we always wished existed.
            </p>

            <div class="mt-8 flex items-center gap-3">
                <ButtonCn Class="w-[180px]">Start free trial</ButtonCn>
                <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">Meet the team</ButtonCn>
            </div>

            <p class="mt-3 text-xs text-muted-foreground">
                Backed by a16z and Sequoia &bull; YC W24
            </p>
        </div>
    </div>
</section>

@code {
    private record Founder(string Name, string Role, string Initials, string From, string To);

    private static readonly Founder[] _founders =
    [
        new("Ada Chen", "Co-founder", "AC", "#10b981", "#065f46"),
        new("Raj Patel", "Co-founder", "RP", "#6366f1", "#1e1b4b"),
        new("Mika Okafor", "Co-founder", "MO", "#f59e0b", "#78350f"),
    ];
}
