@* ============================================================
   Block: hero-split-tab-switch-browser
   Title: HeroSplitTabSwitchBrowser
   Description: A split-layout hero with a browser frame mockup and tab-switchable crosshair placeholder views for React and Next.js featuring AnimatePresence transitions and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-tab-switch-browser.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid md:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">
                @* Announcement pill *@
                <div class="mb-5">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Interactive preview</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">Try the demo</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Ship faster with<br />
                    less complexity
                </h1>

                @* Subtitle *@
                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    A unified platform that replaces your fragmented toolchain. One workspace for every
                    team, every workflow, every stage.
                </p>

                @* CTAs *@
                <div class="mt-7 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Start building</ButtonCn>
                    <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">View docs</ButtonCn>
                </div>

                @* Trust line *@
                <p class="mt-5 text-xs text-muted-foreground">
                    Free for teams up to 5 &middot; No credit card required
                </p>
            </div>

            @* Right — browser frame with switchable tabs *@
            <div class="relative flex flex-col bg-muted p-5 md:p-7" aria-hidden="true">
                @* Browser frame *@
                <div class="flex flex-1 flex-col overflow-hidden rounded-lg border bg-card">
                    @* Window chrome *@
                    <div class="flex items-center gap-1.5 border-b bg-muted/50 px-3 py-2">
                        <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                        <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                        <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                        <div class="ml-2.5 h-2 w-24 rounded-full bg-muted-foreground/[0.07]"></div>
                    </div>

                    @* Placeholder content area *@
                    <div class="flex flex-1 items-center justify-center bg-muted/30" style="min-height:240px">
                        <div class="flex flex-col items-center gap-3">
                            @* CrosshairPlaceholder size="small" *@
                            <div class="relative flex items-center justify-center">
                                <div class="absolute size-20 rounded-full border border-muted-foreground/[0.06]"></div>
                                <div class="absolute size-12 rounded-full border border-muted-foreground/[0.08]"></div>
                                <div class="absolute h-px w-28 bg-muted-foreground/[0.06]"></div>
                                <div class="absolute h-28 w-px bg-muted-foreground/[0.06]"></div>
                                <div class="flex size-8 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                                    <LucideIconCn Name="image" Size="14" Class="size-3.5 text-muted-foreground/40" />
                                </div>
                            </div>
                            <span class="text-[10px] font-medium text-muted-foreground/50">
                                @_tabs[_activeTab].Label view
                            </span>
                        </div>
                    </div>
                </div>

                @* Tab switcher below the browser frame *@
                <div class="mt-3 flex items-center gap-1.5">
                    @foreach (var tab in _tabs)
                    {
                        var t = tab;
                        <button type="button"
                                tabindex="-1"
                                @onclick="@(() => _activeTab = t.Index)"
                                class="@Cn.Merge("flex flex-1 items-center justify-center gap-1.5 rounded-md px-3 py-2 text-xs font-medium transition-colors", _activeTab == t.Index ? "bg-card border text-foreground" : "text-muted-foreground hover:text-foreground hover:bg-card/60")">
                            <LucideIconCn Name="@t.Icon" Size="12" Class="size-3" />
                            @t.Label
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private int _activeTab = 0;

    private record TabItem(int Index, string Label, string Icon);

    private static readonly TabItem[] _tabs =
    [
        new(0, "Dashboard", "layout-dashboard"),
        new(1, "Analytics", "line-chart"),
        new(2, "Settings", "settings"),
    ];
}
