@* ============================================================
   Block: hero-left-testimonial-single
   Title: HeroLeftTestimonialSingle
   Description: A left-heavy asymmetric hero with a single anchored testimonial card in a narrow sidebar for React and Next.js featuring an announcement pill, headline, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-left-testimonial-single.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-[1.4fr_1fr]">

            @* Left — main copy (dominant) *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">

                @* Announcement pill *@
                <div class="mb-8">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Customer story</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">Read the full case study</span>
                        <LucideArrowUpRightCn Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Teams ship faster<br />
                    when they switch
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                    Engineering leaders trust us to untangle their release cycles. Hear it from the people
                    who made the switch.
                </p>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-[170px]">View case study</ButtonCn>
                </div>
            </div>

            @* Right — single anchored testimonial card (narrower) *@
            <aside class="flex items-center justify-center border-t bg-muted/50 px-6 py-8 sm:px-8 lg:border-t-0 lg:border-l lg:px-8 lg:py-10"
                   aria-label="Customer testimonial">
                <figure class="relative w-full rounded-2xl border bg-card p-6">

                    @* Large opening quote mark *@
                    <LucideQuoteCn Size="32" Class="absolute -top-3 left-5 size-8 rotate-180 fill-muted stroke-muted-foreground/40" aria-hidden="true" />

                    @* Quote *@
                    <blockquote class="pt-3 text-sm leading-relaxed text-foreground">
                        &ldquo;@_testimonial.Quote&rdquo;
                    </blockquote>

                    @* Divider *@
                    <div class="my-4 h-px w-full bg-border"></div>

                    @* Attribution *@
                    <figcaption class="flex items-center gap-3">
                        <div class="flex size-9 shrink-0 items-center justify-center rounded-full border bg-muted/50 text-sm font-semibold text-foreground">
                            @_testimonial.Initial
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="truncate text-xs font-semibold text-foreground">@_testimonial.Name</div>
                            <div class="truncate text-[11px] text-muted-foreground">
                                @_testimonial.Role<span class="mx-1">·</span>@_testimonial.Company
                            </div>
                        </div>
                    </figcaption>
                </figure>
            </aside>

        </div>
    </div>
</section>

@code {
    private record TestimonialData(string Quote, string Name, string Role, string Company, string Initial);

    private static readonly TestimonialData _testimonial = new(
        Quote: "We cut our release cycle from two weeks to two days. It is the single biggest productivity unlock our engineering team has had in the last five years.",
        Name: "Sarah Chen",
        Role: "VP Engineering",
        Company: "Linear Labs",
        Initial: "S"
    );
}
