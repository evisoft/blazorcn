@* ============================================================
   Block: hero-typing-animation
   Title: HeroTypingAnimation
   Description: A centered hero section for React and Next.js with a progressive subtitle typing animation that reveals text character by character, static headline, announcement pill, and dual CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-typing-animation.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">

      @* Announcement pill *@
      <div class="mb-6">
        <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
          <span class="size-1.5 rounded-full bg-emerald-500"></span>
          <span class="font-medium">Just shipped</span>
          <span class="text-muted-foreground">&middot;</span>
          <span class="text-muted-foreground">Instant rollbacks</span>
          <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
        </a>
      </div>

      @* Static headline *@
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        The platform for<br />modern teams
      </h1>

      @* Typing subtitle *@
      <div class="mx-auto mt-5 h-[3.5rem] max-w-lg">
        <p class="text-lg leading-relaxed text-muted-foreground">
          @_subtitle.Substring(0, _charCount)
          @if (!_animationDone)
          {
            <span class="ml-0.5 inline-block h-[0.85em] w-[2px] translate-y-[0.1em] rounded-sm bg-muted-foreground animate-hero-blink"></span>
          }
        </p>
      </div>

      @* CTAs *@
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <ButtonCn Class="w-[180px]">Start deploying</ButtonCn>
        <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">Read the docs</ButtonCn>
      </div>

      @* Trust text *@
      <p class="mt-7 text-sm text-muted-foreground">
        No credit card required &middot; Free for hobby projects &middot; Enterprise ready
      </p>

    </div>
  </div>

  @* Cursor blink keyframes *@
  <style>
    @@keyframes heroTypingBlink {
      0%, 50% { opacity: 1; }
      51%, 100% { opacity: 0; }
    }
    .animate-hero-blink {
      animation: heroTypingBlink 1s step-end infinite;
    }
  </style>
</section>

@code {
    private const string _subtitle = "One command to deploy. Zero configuration needed. Your code, live in seconds.";
    private const int _charSpeed = 32;
    private const int _startDelay = 600;

    private int _charCount = 0;
    private bool _animationDone = false;
    private System.Threading.Timer? _timer;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;

        _timer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(() =>
            {
                if (_charCount == 0)
                {
                    _charCount = 1;
                    StateHasChanged();
                    ScheduleNextChar();
                }
            });
        }, null, _startDelay, System.Threading.Timeout.Infinite);
    }

    private void ScheduleNextChar()
    {
        if (_charCount >= _subtitle.Length)
        {
            _animationDone = true;
            StateHasChanged();
            return;
        }

        _timer?.Dispose();
        _timer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(() =>
            {
                if (_charCount < _subtitle.Length)
                {
                    _charCount++;
                    StateHasChanged();
                    ScheduleNextChar();
                }
                else
                {
                    _animationDone = true;
                    StateHasChanged();
                }
            });
        }, null, _charSpeed, System.Threading.Timeout.Infinite);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
