@* ============================================================
   Block: hero-split-music-player
   Title: HeroSplitMusicPlayer
   Description: A split layout hero with a minimal music player skeleton mockup for React and Next.js featuring an announcement pill, emerald feature checklist, dual ShadcnioButton CTAs, and a waveform plus track list right panel built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-music-player.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid md:grid-cols-2">

            @* LEFT — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">

                @* Announcement pill *@
                <div class="mb-5">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Spatial audio</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">Now in beta</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Hear it before<br />
                    you ship it
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                    The audio platform engineered for collaborative production. Mix in the browser, ship
                    to every speaker.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
                    <ButtonCn Class="w-[180px]">Start mixing</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-[150px]">Listen to demo</ButtonCn>
                </div>
            </div>

            @* RIGHT — music player mockup *@
            <div class="flex items-center justify-center bg-muted/30 px-8 py-10 sm:px-12 lg:py-12" aria-hidden="true">
                <div class="w-full max-w-sm rounded-2xl border bg-card p-5 shadow-sm">

                    @* Now playing — album + meta *@
                    <div class="flex items-center gap-3">
                        <div class="relative size-12 shrink-0 overflow-hidden rounded-md bg-muted-foreground/15">
                            <div class="absolute inset-2 rounded-sm bg-muted-foreground/20"></div>
                        </div>
                        <div class="min-w-0 flex-1 space-y-1.5">
                            <div class="h-2.5 w-3/4 rounded-full bg-muted-foreground/25"></div>
                            <div class="h-2 w-1/2 rounded-full bg-muted-foreground/15"></div>
                        </div>
                        <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            Now
                        </span>
                    </div>

                    @* Waveform *@
                    <div class="mt-5 flex h-14 items-center justify-between gap-[2px]">
                        @foreach (var bar in _waveformBarsIndexed)
                        {
                            var isPlayed = bar.Index < _playedThreshold;
                            <span class="@(isPlayed ? "w-[3px] rounded-full bg-foreground" : "w-[3px] rounded-full bg-muted-foreground/20")"
                                  style="@($"height:{bar.Height}%")"></span>
                        }
                    </div>

                    @* Progress bar *@
                    <div class="mt-4">
                        <div class="relative h-1 w-full overflow-hidden rounded-full bg-muted">
                            <div class="absolute inset-y-0 left-0 rounded-full bg-foreground"
                                 style="@($"width:{_progressPercent}%")"></div>
                        </div>
                        <div class="mt-1.5 flex items-center justify-between text-[10px] tabular-nums text-muted-foreground">
                            <span>1:12</span>
                            <span>3:42</span>
                        </div>
                    </div>

                    @* Transport controls *@
                    <div class="mt-2 flex items-center justify-center gap-5">
                        <LucideIconCn Name="skip-back" Size="16" Class="size-4 text-muted-foreground" />
                        <div class="flex size-9 items-center justify-center rounded-full bg-foreground text-background">
                            <LucideIconCn Name="play" Size="16" Class="size-4 fill-current" />
                        </div>
                        <LucideIconCn Name="skip-forward" Size="16" Class="size-4 text-muted-foreground" />
                    </div>

                    @* Track list *@
                    <div class="mt-5 space-y-1.5 border-t pt-4">
                        <div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                            Up next
                        </div>
                        @foreach (var trackItem in _tracksIndexed)
                        {
                            <div class="flex items-center justify-between gap-3 py-1">
                                <div class="flex min-w-0 items-center gap-2.5">
                                    <span class="w-3 text-right text-[10px] tabular-nums text-muted-foreground/60">
                                        @(trackItem.Index + 1)
                                    </span>
                                    @if (trackItem.Index == 0)
                                    {
                                        <LucideIconCn Name="pause" Size="12" Class="size-3 text-foreground" />
                                    }
                                    else
                                    {
                                        <span class="h-2 w-12 rounded-full bg-muted-foreground/15"></span>
                                    }
                                </div>
                                <span class="text-[10px] tabular-nums text-muted-foreground">
                                    @trackItem.Track.Duration
                                </span>
                            </div>
                        }
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Lossless audio across every device",
        "Sub 80ms latency for live collab sessions",
        "Open source SDK with first class TypeScript",
    ];

    private record TrackItem(string Title, string Duration);

    private static readonly TrackItem[] _tracks =
    [
        new("Echo Chamber",  "3:42"),
        new("Slow Dial Tone","4:18"),
        new("Carbon Loop",   "2:56"),
        new("Northbound",    "5:04"),
    ];

    private static readonly int[] _waveformBars =
    [
        20, 32, 44, 28, 56, 64, 40, 24, 36, 52, 70, 58, 44, 30, 48, 66, 78, 62, 50, 38, 26, 42, 60, 74,
        68, 54, 36, 22, 34, 50, 64, 46, 30, 24, 40, 28,
    ];

    private const int _progressPercent = 32;

    private double _playedThreshold => _waveformBars.Length * (_progressPercent / 100.0);

    private record WaveBarEntry(int Index, int Height);
    private record TrackIndexEntry(int Index, TrackItem Track);

    private WaveBarEntry[] _waveformBarsIndexed =>
        _waveformBars.Select((h, i) => new WaveBarEntry(i, h)).ToArray();

    private TrackIndexEntry[] _tracksIndexed =>
        _tracks.Select((t, i) => new TrackIndexEntry(i, t)).ToArray();
}
