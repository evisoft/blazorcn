@* ============================================================
   Block: hero-centered-demo-schedule
   Title: HeroCenteredDemoSchedule
   Description: A centered hero with a compact demo scheduling widget below the CTAs for React and Next.js featuring a weekday strip, time slot grid, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-demo-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">
            @* Announcement pill *@
            <div class="mb-6 flex justify-center">
                <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium">30-minute walkthrough</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">Live with a product expert</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            @* Headline *@
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                See it in action
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                Book a personalized demo with our team and see how fast your team can ship with our
                platform.
            </p>

            @* CTAs *@
            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[170px]">Book a demo</ButtonCn>
                <ButtonCn Class="w-[160px]" Variant="ButtonVariant.Ghost">Try it free</ButtonCn>
            </div>

            @* Demo scheduling widget *@
            <div class="mx-auto mt-10 max-w-md rounded-xl border bg-muted/50 p-4 text-left">
                @* Widget header *@
                <div class="mb-3 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs font-medium">Book a demo</span>
                    </div>
                    <span class="text-[10px] text-muted-foreground">@_monthLabel</span>
                </div>

                @* Weekday strip *@
                <div class="flex items-stretch justify-between gap-1.5">
                    @foreach (var day in _weekDays)
                    {
                        <button type="button"
                                aria-pressed="@(day.Selected ? "true" : "false")"
                                class="@Cn.Merge("flex flex-1 flex-col items-center gap-0.5 rounded-lg border px-2 py-2 transition-colors", day.Selected ? "border-foreground bg-foreground text-background" : "border-transparent bg-background hover:border-border")">
                            <span class="@Cn.Merge("text-[10px] font-medium uppercase", day.Selected ? "text-background/70" : "text-muted-foreground")">
                                @day.Weekday
                            </span>
                            <span class="text-sm font-semibold tabular-nums">@day.Date</span>
                        </button>
                    }
                </div>

                @* Time slot grid *@
                <div class="mt-3 grid grid-cols-3 gap-1.5">
                    @foreach (var slot in _timeSlots)
                    {
                        <button type="button"
                                aria-pressed="@(slot.Selected ? "true" : "false")"
                                class="@Cn.Merge("rounded-md border py-1.5 text-xs font-medium tabular-nums transition-colors", slot.Selected ? "border-foreground bg-foreground text-background" : "border-border bg-background text-foreground hover:bg-muted")">
                            @slot.Label
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private const string _monthLabel = "April 2026";

    private record WeekDay(string Weekday, int Date, bool Selected = false);
    private record TimeSlot(string Label, bool Selected = false);

    private static readonly WeekDay[] _weekDays =
    [
        new("Mon", 13),
        new("Tue", 14),
        new("Wed", 15, Selected: true),
        new("Thu", 16),
        new("Fri", 17),
    ];

    private static readonly TimeSlot[] _timeSlots =
    [
        new("9:00"),
        new("10:30", Selected: true),
        new("13:00"),
        new("14:30"),
        new("16:00"),
        new("17:30"),
    ];
}
