@* ============================================================
   Block: hero-left-trust-compliance
   Title: HeroLeftTrustCompliance
   Description: A left-heavy split hero with a compact compliance badge grid panel for React and Next.js featuring an announcement pill, feature checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-left-trust-compliance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-[1.4fr_1fr]">
            @* Left — copy *@
            <div class="flex flex-col justify-center border-b px-8 py-10 sm:px-12 lg:border-r lg:border-b-0 lg:px-16 lg:py-12">
                @* Announcement pill *@
                <div class="mb-6">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">ISO 27001 renewed</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">Read the report</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Security your<br />
                    auditors love
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                    Ship faster without slowing down your security team. Continuous compliance, automated
                    evidence, and a trust center your customers actually read.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                    <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">Visit trust center</ButtonCn>
                </div>
            </div>

            @* Right — compliance badge panel *@
            <div class="flex flex-col justify-center px-6 py-8 sm:px-8 lg:px-8 lg:py-12" aria-hidden="true">
                @* Panel header *@
                <div class="mb-5 flex items-center gap-2">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        Enterprise-ready security
                    </span>
                </div>

                @* 2x3 badge grid *@
                <ul class="grid grid-cols-2 gap-2">
                    @foreach (var item in _compliance)
                    {
                        <li class="flex items-center gap-2.5 rounded-lg border bg-muted/50 px-3 py-3 transition-colors hover:bg-muted">
                            <div class="flex size-7 shrink-0 items-center justify-center rounded-md border bg-background/60">
                                <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-500" />
                            </div>
                            <div class="min-w-0">
                                <div class="truncate text-xs font-semibold text-foreground">@item.Label</div>
                                <div class="truncate text-[10px] text-muted-foreground">@item.Sub</div>
                            </div>
                        </li>
                    }
                </ul>

                @* Footer note *@
                <div class="mt-4 flex items-center justify-between text-[10px] text-muted-foreground">
                    <span>Audited by Vanta</span>
                    <span class="font-mono">Updated Apr 2026</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Continuous compliance monitoring across your stack",
        "Automated evidence collection for audit cycles",
        "Real-time access controls with full audit trail",
    ];

    private record ComplianceItem(string Label, string Sub);

    private static readonly ComplianceItem[] _compliance =
    [
        new("SOC 2", "Type II"),
        new("GDPR", "Compliant"),
        new("HIPAA", "Ready"),
        new("ISO 27001", "Certified"),
        new("CCPA", "Compliant"),
        new("PCI DSS", "Level 1"),
    ];
}
