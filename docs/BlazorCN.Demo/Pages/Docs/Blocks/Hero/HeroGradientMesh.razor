@* ============================================================
   Block: hero-gradient-mesh
   Title: HeroGradientMesh
   Description: A centered hero with a multi-layer CSS radial-gradient mesh background for React and Next.js featuring an announcement pill, dual ShadcnioButton CTAs, avatar social proof, and a bottom stats bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-gradient-mesh.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="relative overflow-hidden rounded-2xl border bg-card">
    @* Mesh gradient background -- theme variables only *@
    <div
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
      style="background: radial-gradient(ellipse 60% 50% at 20% 30%, hsl(var(--primary) / 0.06) 0%, transparent 70%), radial-gradient(ellipse 50% 60% at 80% 25%, hsl(var(--accent) / 0.04) 0%, transparent 70%), radial-gradient(ellipse 70% 40% at 50% 80%, hsl(var(--primary) / 0.03) 0%, transparent 70%)"
    />

    @* Content *@
    <div class="relative z-10 px-6 py-10 text-center sm:px-8 sm:py-12 lg:px-12 lg:py-14">
      <div class="mx-auto max-w-xl">
        @* Announcement pill *@
        <div class="mb-6">
          <a
            href="#"
            class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs backdrop-blur-sm transition-colors hover:bg-muted"
          >
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="font-medium">Design forward</span>
            <span class="text-muted-foreground">&middot;</span>
            <span class="text-muted-foreground">Creative suite v3</span>
            <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
          </a>
        </div>

        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          Where ideas
          <br />
          become products
        </h1>

        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
          From concept to production in minutes. A design platform that moves as fast as your
          imagination, with none of the friction.
        </p>

        <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <ButtonCn class="w-[180px]">Start creating</ButtonCn>
          <ButtonCn class="w-[160px]" Variant="ButtonVariant.Ghost">View gallery</ButtonCn>
        </div>

        @* Social proof *@
        <div class="mt-8 flex items-center justify-center gap-3">
          <div class="flex -space-x-2">
            @foreach (var i in Enumerable.Range(0, 5))
            {
              <div class="size-7 rounded-full border-2 border-background bg-muted"></div>
            }
          </div>
          <p class="text-sm text-muted-foreground">
            Loved by <span class="font-semibold text-foreground">12,000+</span> creators
          </p>
        </div>
      </div>
    </div>

    @* Bottom stats bar *@
    <div class="relative z-10 border-t bg-muted/30">
      <div class="flex flex-wrap items-center justify-center gap-8 px-6 py-6 sm:gap-10">
        @foreach (var stat in _stats)
        {
          var statItem = stat;
          <div class="flex items-center gap-8 sm:gap-10">
            <div class="text-center">
              <p class="text-xl font-semibold tabular-nums sm:text-2xl">@statItem.Value</p>
              <p class="mt-0.5 text-xs text-muted-foreground">@statItem.Label</p>
            </div>
            @if (statItem.ShowDivider)
            {
              <div class="hidden h-8 w-px bg-border sm:block" aria-hidden="true"></div>
            }
          </div>
        }
      </div>
    </div>
  </div>
</section>

@code {
  private record Stat(string Value, string Label, bool ShowDivider);

  private static readonly Stat[] _stats =
  [
    new("2M+", "Projects created", true),
    new("150+", "Templates", true),
    new("99.9%", "Uptime", false),
  ];
}
