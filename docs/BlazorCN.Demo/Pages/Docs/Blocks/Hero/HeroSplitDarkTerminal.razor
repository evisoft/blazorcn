@* ============================================================
   Block: hero-split-dark-terminal
   Title: HeroSplitDarkTerminal
   Description: A split-layout hero section for React and Next.js with bold headline and feature checklist on the left and a dark terminal mockup with window chrome, request line, status bar, and syntax-highlighted JSON response with copy-to-clipboard on the right built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-dark-terminal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="grid lg:grid-cols-2">

      @* Left — copy *@
      <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">

        @* Announcement pill *@
        <div class="mb-6">
          <a
            href="#"
            class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted"
          >
            <span class="size-1.5 rounded-full bg-foreground/60"></span>
            <span class="font-medium">For developers</span>
            <span class="text-muted-foreground">&middot;</span>
            <span class="text-muted-foreground">API v2 released</span>
            <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
          </a>
        </div>

        @* Headline *@
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          Build anything with
          <br />
          one API call
        </h1>

        @* Subtitle *@
        <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
          Simple, powerful REST APIs with predictable responses. See it in action — no signup
          required.
        </p>

        @* Feature checklist *@
        <ul class="mt-6 space-y-2.5">
          @foreach (var feature in _features)
          {
            var f = feature;
            <li class="flex items-center gap-3">
              <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
              <span class="text-sm text-foreground">@f</span>
            </li>
          }
        </ul>

        @* CTAs *@
        <div class="mt-8 flex items-center gap-3">
          <ButtonCn Class="w-[200px]">Get your API key</ButtonCn>
          <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">Read docs</ButtonCn>
        </div>
      </div>

      @* Right — terminal mockup *@
      <div class="flex items-center p-6 lg:p-10">
        <div
          class="w-full overflow-hidden rounded-2xl border bg-foreground"
          aria-hidden="true"
        >
          @* Window chrome *@
          <div class="flex items-center gap-2 border-b border-background/10 px-4 py-2.5">
            <div class="flex gap-1.5">
              <span class="size-2 rounded-full bg-background/15"></span>
              <span class="size-2 rounded-full bg-background/15"></span>
              <span class="size-2 rounded-full bg-background/15"></span>
            </div>
            <span class="ml-2 font-mono text-[10px] text-background/30">
              API Playground
            </span>
          </div>

          @* Request line *@
          <div class="flex items-center gap-2.5 border-b border-background/10 px-4 py-2.5">
            <span class="rounded bg-background/15 px-1.5 py-0.5 font-mono text-[10px] font-medium text-background/50">
              GET
            </span>
            <span class="truncate font-mono text-xs text-background/40">
              @_apiEndpoint
            </span>
          </div>

          @* Status line *@
          <div class="flex items-center justify-between border-b border-background/10 px-4 py-2">
            <div class="flex items-center gap-2.5">
              <span class="font-mono text-[10px] text-background/30">Response</span>
              <span class="rounded bg-background/10 px-1.5 py-0.5 font-mono text-[10px] text-background/40">
                200 OK
              </span>
              <span class="font-mono text-[10px] text-background/20">142ms</span>
            </div>
            <button
              type="button"
              @onclick="HandleCopy"
              class="flex items-center gap-1 rounded px-1.5 py-0.5 text-background/30 transition-colors hover:text-background/60"
            >
              @if (_copied)
              {
                <LucideIconCn Name="check" Size="12" Class="size-3" />
                <span class="font-mono text-[10px]">Copied</span>
              }
              else
              {
                <LucideIconCn Name="copy" Size="12" Class="size-3" />
                <span class="font-mono text-[10px]">Copy</span>
              }
            </button>
          </div>

          @* JSON response *@
          <div class="p-4">
            <pre class="font-mono text-xs leading-relaxed"><span class="text-background/30">@("{")</span>
  <span class="text-background/60">&quot;id&quot;</span><span class="text-background/30">: </span><span class="text-background/45">&quot;usr_2kF9xLm&quot;</span><span class="text-background/20">,</span>
  <span class="text-background/60">&quot;name&quot;</span><span class="text-background/30">: </span><span class="text-background/45">&quot;Sarah Chen&quot;</span><span class="text-background/20">,</span>
  <span class="text-background/60">&quot;email&quot;</span><span class="text-background/30">: </span><span class="text-background/45">&quot;sarah@@acme.co&quot;</span><span class="text-background/20">,</span>
  <span class="text-background/60">&quot;plan&quot;</span><span class="text-background/30">: </span><span class="text-background/45">&quot;pro&quot;</span><span class="text-background/20">,</span>
  <span class="text-background/60">&quot;usage&quot;</span><span class="text-background/30">: @("{")</span>
    <span class="text-background/60">&quot;api_calls&quot;</span><span class="text-background/30">: </span><span class="text-background/50">12847</span><span class="text-background/20">,</span>
    <span class="text-background/60">&quot;storage_mb&quot;</span><span class="text-background/30">: </span><span class="text-background/50">256</span>
  <span class="text-background/30">@("}")</span>
<span class="text-background/30">@("}")</span></pre>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

@code {
    private const string _apiEndpoint = "https://api.acme.co/v1/users/usr_2kF9xLm";
    private bool _copied = false;

    private static readonly string[] _features =
    [
        "RESTful endpoints with predictable responses",
        "Sub-50ms latency across all regions",
        "10,000 free API calls per month",
    ];

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
