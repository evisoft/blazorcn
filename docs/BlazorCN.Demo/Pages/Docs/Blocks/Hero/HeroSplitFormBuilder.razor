@* ============================================================
   Block: hero-split-form-builder
   Title: HeroSplitFormBuilder
   Description: A split-layout hero with a no-code form builder mockup featuring a field palette sidebar and a drag-to-reorder canvas for React and Next.js built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-form-builder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">
                @* Announcement pill *@
                <div class="mb-8">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">New</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">Conditional logic is here</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Build any form<br />
                    without writing code
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
                    Drag fields onto a canvas, wire up logic, and publish to a hosted URL — all without
                    touching a single line of JavaScript.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Start building</ButtonCn>
                    <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">See templates</ButtonCn>
                </div>
            </div>

            @* Right — form builder mockup *@
            <div class="flex items-center p-6 lg:p-8">
                <div class="w-full overflow-hidden rounded-2xl border bg-muted/50" aria-hidden="true">
                    @* Chrome *@
                    <div class="flex items-center gap-2 border-b bg-background/60 px-4 py-2.5">
                        <div class="flex gap-1.5">
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                        </div>
                        <span class="ml-2 font-mono text-[10px] text-muted-foreground/60">
                            Contact form
                        </span>
                    </div>

                    @* Builder body *@
                    <div class="flex min-h-[320px]">
                        @* Palette sidebar *@
                        <div class="w-[108px] shrink-0 border-r bg-background/40 px-2 py-3">
                            <div class="mb-2 px-1 text-[9px] font-medium uppercase tracking-wider text-muted-foreground/70">
                                Fields
                            </div>
                            <ul class="space-y-1">
                                @foreach (var item in _palette)
                                {
                                    <li class="flex items-center gap-2 rounded-md border bg-card/60 px-2 py-1.5">
                                        <LucideIconCn Name="@item.IconName" Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="text-[10px] text-foreground/80">@item.Label</span>
                                    </li>
                                }
                            </ul>
                        </div>

                        @* Canvas *@
                        <div class="flex-1 px-4 py-4">
                            <div class="mb-3 flex items-center justify-between">
                                <span class="text-[9px] font-medium uppercase tracking-wider text-muted-foreground/70">
                                    Canvas
                                </span>
                                <span class="font-mono text-[9px] text-muted-foreground/60">4 fields</span>
                            </div>

                            <div class="space-y-2.5">
                                @foreach (var field in _canvas)
                                {
                                    var ring = field.IsSelected
                                        ? "border-dashed border-foreground/60 ring-2 ring-foreground/10"
                                        : "border-border";

                                    if (field.Type == "checkbox")
                                    {
                                        <div class="@($"flex items-center gap-2 rounded-md border bg-background/60 px-2.5 py-2 {ring}")">
                                            <span class="flex size-3 items-center justify-center rounded-sm border border-muted-foreground/40"></span>
                                            <span class="text-[10px] text-foreground/80">@field.Label</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="@($"rounded-md border bg-background/60 px-2.5 py-2 {ring}")">
                                            <div class="text-[9px] font-medium text-muted-foreground">
                                                @field.Label
                                            </div>
                                            <div class="mt-1 flex h-5 items-center rounded-sm border bg-background/80 px-2 font-mono text-[9px] text-muted-foreground/70">
                                                @field.Placeholder
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record PaletteItem(string Id, string Label, string IconName);

    private record CanvasField(string Id, string Label, string Placeholder, string Type, bool IsSelected = false);

    private static readonly PaletteItem[] _palette =
    [
        new("text", "Text", "type"),
        new("email", "Email", "mail"),
        new("select", "Select", "list"),
        new("checkbox", "Checkbox", "square-check"),
    ];

    private static readonly CanvasField[] _canvas =
    [
        new("full-name", "Full name", "Ada Lovelace", "text"),
        new("work-email", "Work email", "ada@@company.com", "email"),
        new("team-size", "Team size", "Select a range", "select", IsSelected: true),
        new("terms", "I agree to the terms", "", "checkbox"),
    ];

    private static readonly string[] _features =
    [
        "Drag-and-drop builder with 30+ field types",
        "Conditional logic and multi-step branching",
        "Native integrations for HubSpot, Slack, and Zapier",
    ];
}
