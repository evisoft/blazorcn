@* ============================================================
   Block: hero-split-phone-frame
   Title: HeroSplitPhoneFrame
   Description: A split-layout hero section for React and Next.js with headline, dual ShadcnioButton CTAs, and avatar social proof on the left and a portrait phone frame mockup with notch and home indicator on the right built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-phone-frame.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">
                @* Announcement pill *@
                <div class="mb-6">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-foreground/60"></span>
                        <span class="font-medium">Available now</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">iOS &amp; Android</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Your life, organized
                    <br />
                    in one app
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
                    The all-in-one productivity app that helps you manage tasks, habits, and goals.
                    Available on iOS and Android.
                </p>

                @* App store buttons *@
                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="w-[180px]">
                        <LucideIconCn Name="apple" Size="16" Class="size-4" />
                        App Store
                    </ButtonCn>
                    <ButtonCn Class="w-[180px]" Variant="ButtonVariant.Ghost">
                        <LucideIconCn Name="play" Size="16" Class="size-4" />
                        Google Play
                    </ButtonCn>
                </div>

                @* Social proof *@
                <div class="mt-8 flex items-center gap-3">
                    <div class="flex -space-x-2">
                        @foreach (var i in Enumerable.Range(0, 5))
                        {
                            <div class="size-8 rounded-full border-2 border-background bg-muted"></div>
                        }
                    </div>
                    <div>
                        <p class="text-sm">
                            Loved by <span class="font-semibold">500K+</span> users
                        </p>
                        <p class="text-xs text-muted-foreground">4.9 average rating</p>
                    </div>
                </div>
            </div>

            @* Right — phone frame with crosshair placeholder *@
            <div class="flex items-center justify-center p-6 lg:p-10">
                <div class="relative mx-auto">
                    @* Phone frame *@
                    <div class="relative h-[440px] w-[220px] rounded-[2.5rem] border-[6px] border-foreground/90 bg-background shadow-lg">
                        @* Notch *@
                        <div class="absolute left-1/2 top-0 z-10 h-5 w-20 -translate-x-1/2 rounded-b-xl bg-foreground/90"></div>

                        @* Screen with crosshair placeholder *@
                        <div class="flex h-full w-full items-center justify-center overflow-hidden rounded-[2rem] bg-muted">
                            <div class="relative flex items-center justify-center">
                                <div class="absolute size-24 rounded-full border border-muted-foreground/[0.06]"></div>
                                <div class="absolute size-16 rounded-full border border-muted-foreground/[0.08]"></div>
                                <div class="absolute h-px w-32 bg-muted-foreground/[0.06]"></div>
                                <div class="absolute h-32 w-px bg-muted-foreground/[0.06]"></div>
                                <div class="flex size-10 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                                    <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
                                </div>
                            </div>
                        </div>

                        @* Home indicator *@
                        <div class="absolute bottom-2 left-1/2 h-1 w-16 -translate-x-1/2 rounded-full bg-foreground/20"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

