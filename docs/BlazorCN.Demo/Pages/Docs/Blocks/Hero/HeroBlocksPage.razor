                    ? ""bg-emerald-500/15 text-emerald-700 dark:text-emerald-400""
                    : ""bg-blue-500/15 text-blue-700 dark:text-blue-400"";
                var msgClass = ci.IsMerge ? ""truncate text-[11px] font-medium text-foreground/90"" : ""truncate text-[11px] text-foreground/80"";
                <li class=""flex items-center gap-2"" style=""@($""height:{_rowH}px"")"">
                  <div class=""@($""flex size-5 shrink-0 items-center justify-center rounded-full text-[9px] font-medium {avatarClass}"")"">
                    @ci.Author
                  </div>
                  <span class=""font-mono text-[10px] text-muted-foreground"">@ci.Hash</span>
                  <span class=""@msgClass"">@ci.Message</span>
                </li>
              }
            </ul>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>

