    private record GalleryCell(string Aspect, int Column);

    private record CellSizes(string Outer, string Inner, string Line);

    private static readonly GalleryCell[] _galleryCells =
    [
        new(""aspect-square"",  0),
        new(""aspect-[4/3]"",   0),
        new(""aspect-[3/4]"",   1),
        new(""aspect-square"",  1),
        new(""aspect-[4/3]"",   2),
        new(""aspect-square"",  2),
    ];

    private static readonly Dictionary<string, CellSizes> _sizeMap = new()
    {
        [""aspect-square""] = new CellSizes(""size-20"", ""size-12"", ""w-28""),
        [""aspect-[4/3]""]  = new CellSizes(""size-16"", ""size-10"", ""w-24""),
        [""aspect-[3/4]""]  = new CellSizes(""size-20"", ""size-12"", ""w-28""),
    };

    private static CellSizes GetSizeMap(string aspect) =>
        _sizeMap.TryGetValue(aspect, out var s) ? s : _sizeMap[""aspect-square""];

    private IEnumerable<GalleryCell>[] _columns =
    [
        _galleryCells.Where(c => c.Column == 0).ToArray(),
        _galleryCells.Where(c => c.Column == 1).ToArray(),
        _galleryCells.Where(c => c.Column == 2).ToArray(),
    ];
}";

