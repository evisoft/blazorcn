                    </p>
                </div>
            }
            else
            {
                <div class=""mx-auto max-w-md"">
                    <div class=""flex flex-col gap-3 sm:flex-row"">
                        <InputCn Class=""h-12""
                                 Placeholder=""Enter your email""
                                 Type=""email""
                                 @bind-Value=""_email"" />
                        <ButtonCn Class=""h-12 shrink-0"" Size=""ButtonSize.Lg"" @onclick=""HandleSubmit"">
                            Join Waitlist
                        </ButtonCn>
                    </div>

                    @* Progress indicator *@
                    <div class=""mt-6 space-y-2"">
                        <ProgressCn Class=""h-2"" Value=""@_progress"" aria-label=""Progress"" />
