    private string _inputValue = ""Hello World"";
    private bool _isUppercase;
    private bool _isReversed;
    private bool _hasEmoji;

    private string GetTransformedText()
    {
        var result = _inputValue;
        if (string.IsNullOrEmpty(result)) return ""Enter text above..."";
        if (_isUppercase) result = result.ToUpperInvariant();
        if (_isReversed) result = new string(result.Reverse().ToArray());
        if (_hasEmoji) result = $""\u2728 {result} \u2728"";
        return result;
    }
}";
