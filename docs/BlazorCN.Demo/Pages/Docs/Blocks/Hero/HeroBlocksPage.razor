            @* SVG graph column *@
            <svg class=""shrink-0"" height=""@_svgHeight"" role=""presentation"" viewBox=""@($""0 0 120 {_svgHeight}"")"" width=""120"">
              @* Vertical branch lines *@
              <line class=""stroke-foreground/60"" stroke-width=""1.5""
                    x1=""@_branchX[0]"" x2=""@_branchX[0]""
                    y1=""16"" y2=""@(_svgHeight - 16)"" />
              <line class=""stroke-emerald-500/70"" stroke-width=""1.5""
                    x1=""@_branchX[1]"" x2=""@_branchX[1]""
                    y1=""@(16 + _rowH * 1)"" y2=""@(16 + _rowH * 3)"" />
              <line class=""stroke-blue-500/70"" stroke-width=""1.5""
                    x1=""@_branchX[2]"" x2=""@_branchX[2]""
                    y1=""@(16 + _rowH * 2)"" y2=""@(16 + _rowH * 5)"" />

              @* Merge curve: commit 0 (main, row 0) <- commit 1 (feature/auth, row 1) *@
              <path class=""stroke-emerald-500/70 fill-none""
                    d=""@(FormattableString.Invariant($""M {_branchX[1]} {16 + _rowH * 1} C {_branchX[1]} {16 + _rowH * 0.5}, {_branchX[0]} {16 + _rowH * 0.5}, {_branchX[0]} {16 + _rowH * 0}""))""
                    stroke-width=""1.5"" />

              @* Commit dots *@
              @foreach (var commitItem in _commits)
              {
                var ci = commitItem;
                var cy = 16 + _rowH * ci.Index;
