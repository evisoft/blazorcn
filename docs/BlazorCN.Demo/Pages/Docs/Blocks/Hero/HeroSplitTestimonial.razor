@* ========================================
   Block: hero-split-testimonial
   Title: Hero Split Testimonial
   Description: Hero block with split layout featuring testimonial on one side
   Long Description: Full-height split hero with image column, floating navigation, dual CTAs, and client logo strip
   Dependencies: AvatarCn, BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-split-testimonial.tsx
   ======================================== *@

<section class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
          @* Left - Main content *@
          <div class="flex flex-col justify-center">
            <BadgeCn class="mb-6 w-fit" Variant="BadgeVariant.Secondary">
              Trusted by 10,000+ teams
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
              Transform how your team <span class="text-primary">collaborates</span>
            </h1>

            <p class="mb-8 max-w-lg text-lg text-muted-foreground">
              Streamline your workflow, reduce meetings, and ship faster with the collaboration
              platform built for modern teams.
            </p>

            <div class="flex flex-col gap-3 sm:flex-row">
              <ButtonCn class="gap-2" Size="ButtonSize.Lg">
                Start Free Trial
                <LucideArrowRightCn Size="16" Class="h-4 w-4" />
              </ButtonCn>
              <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                Book a Demo
              </ButtonCn>
            </div>

            <p class="mt-6 text-sm text-muted-foreground">
              Free for teams up to 10 • No credit card required
            </p>
          </div>

          @* Right - Testimonial *@
          <div class="flex items-center justify-center">
            <CardCn class="max-w-md">
              <CardContentCn class="p-6 sm:p-8">
                <LucideQuoteCn Class="mb-4 h-10 w-10 text-primary/20" />

                <blockquote class="mb-6 text-lg leading-relaxed">
                  We cut our meeting time by 60% and shipped our product two months ahead of
                  schedule. This tool completely changed how our team works together.
                </blockquote>

                <div class="flex items-center gap-4">
                  <AvatarCn class="h-12 w-12">
                    <AvatarImageCn alt="Alex Rivera" src="https://i.pravatar.cc/150?img=28" />
                    <AvatarFallbackCn>AR</AvatarFallbackCn>
                  </AvatarCn>
                  <div>
                    <div class="font-semibold">Alex Rivera</div>
                    <div class="text-sm text-muted-foreground">VP of Engineering, Acme Inc</div>
                  </div>
                </div>

                <div class="mt-6 flex items-center gap-2 border-t pt-6">
                  <span class="text-sm text-muted-foreground">Results:</span>
                  <BadgeCn Variant="BadgeVariant.Outline">60% fewer meetings</BadgeCn>
                  <BadgeCn Variant="BadgeVariant.Outline">2 months saved</BadgeCn>
                </div>
              </CardContentCn>
            </CardCn>
          </div>
        </div>
      </div>
    </section>

