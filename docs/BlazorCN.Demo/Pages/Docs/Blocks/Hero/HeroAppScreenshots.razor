@* ========================================
   Block: hero-app-screenshots
   Title: Hero App Screenshots
   Description: Hero block with multiple app screenshots in a staggered display
   Long Description: Hero block with app store download buttons for mobile apps
   Dependencies: BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-app-screenshots.tsx
   ======================================== *@

<section class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
          @* Left content *@
          <div class="flex flex-col justify-center">
            <BadgeCn class="mb-6 w-fit gap-2" Variant="BadgeVariant.Secondary">
              <LucideLayersCn Size="12" Class="h-3.5 w-3.5" />
              Beautiful Interface
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
              Designed for <span class="text-primary">clarity</span>
            </h1>

            <p class="mb-8 max-w-lg text-lg text-muted-foreground">
              A thoughtfully designed interface that puts your work front and center. Every pixel
              serves a purpose.
            </p>

            <ul class="mb-8 space-y-3">
              <li class="flex items-center gap-3 text-sm">
                <div class="h-1.5 w-1.5 rounded-full bg-primary" ></div>
                Intuitive drag-and-drop interface
              </li>
              <li class="flex items-center gap-3 text-sm">
                <div class="h-1.5 w-1.5 rounded-full bg-primary" ></div>
                Real-time collaboration
              </li>
              <li class="flex items-center gap-3 text-sm">
                <div class="h-1.5 w-1.5 rounded-full bg-primary" ></div>
                Dark and light themes
              </li>
              <li class="flex items-center gap-3 text-sm">
                <div class="h-1.5 w-1.5 rounded-full bg-primary" ></div>
                Customizable workspaces
              </li>
            </ul>

            <div class="flex flex-col gap-3 sm:flex-row">
              <ButtonCn class="gap-2" Size="ButtonSize.Lg">
                Start Free Trial
                <LucideArrowRightCn Size="16" Class="h-4 w-4" />
              </ButtonCn>
              <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                View All Features
              </ButtonCn>
            </div>
          </div>

          @* Right - Staggered screenshots *@
          <div class="relative flex items-center justify-center">
            <div class="relative h-[400px] w-full max-w-lg md:h-[500px]">
              @* Background screenshot *@
              <CardCn class="absolute right-0 top-0 h-64 w-72 overflow-hidden shadow-xl md:h-80 md:w-80">
                <CardContentCn class="h-full p-0">
                  <div class="h-full bg-muted">
                    @* Screenshot placeholder - Dashboard *@
                    <div class="border-b bg-card p-3">
                      <div class="flex items-center gap-2">
                        <div class="h-2 w-2 rounded-full bg-red-400" ></div>
                        <div class="h-2 w-2 rounded-full bg-yellow-400" ></div>
                        <div class="h-2 w-2 rounded-full bg-green-400"></div>
                      </div>
                    </div>
                    <div class="p-4">
                      <div class="mb-3 h-3 w-20 rounded bg-muted-foreground/20" ></div>
                      <div class="grid grid-cols-2 gap-2">
                        <div class="h-16 rounded bg-primary/10" ></div>
                        <div class="h-16 rounded bg-primary/10"></div>
                      </div>
                      <div class="mt-3 h-20 rounded bg-muted-foreground/10"></div>
                    </div>
                  </div>
                </CardContentCn>
              </CardCn>

              @* Middle screenshot *@
              <CardCn class="absolute bottom-16 left-8 h-64 w-72 overflow-hidden shadow-2xl md:bottom-12 md:left-4 md:h-80 md:w-80">
                <CardContentCn class="h-full p-0">
                  <div class="h-full bg-muted">
                    @* Screenshot placeholder - Analytics *@
                    <div class="border-b bg-card p-3">
                      <div class="flex items-center gap-2">
                        <div class="h-2 w-2 rounded-full bg-red-400" ></div>
                        <div class="h-2 w-2 rounded-full bg-yellow-400" ></div>
                        <div class="h-2 w-2 rounded-full bg-green-400"></div>
                      </div>
                    </div>
                    <div class="p-4">
                      <div class="mb-3 h-3 w-24 rounded bg-muted-foreground/20" ></div>
                      <div class="h-32 rounded bg-gradient-to-t from-primary/20 to-primary/5" ></div>
                      <div class="mt-3 flex gap-2">
                        <div class="h-8 flex-1 rounded bg-muted-foreground/10" ></div>
                        <div class="h-8 flex-1 rounded bg-muted-foreground/10"></div>
                      </div>
                    </div>
                  </div>
                </CardContentCn>
              </CardCn>

              @* Front screenshot - slightly visible *@
              <CardCn class="absolute bottom-0 left-0 h-48 w-56 overflow-hidden shadow-lg md:h-56 md:w-64">
                <CardContentCn class="h-full p-0">
                  <div class="h-full bg-muted">
                    @* Screenshot placeholder - Settings *@
                    <div class="border-b bg-card p-2">
                      <div class="flex items-center gap-1.5">
                        <div class="h-1.5 w-1.5 rounded-full bg-red-400" ></div>
                        <div class="h-1.5 w-1.5 rounded-full bg-yellow-400" ></div>
                        <div class="h-1.5 w-1.5 rounded-full bg-green-400"></div>
                      </div>
                    </div>
                    <div class="p-3">
                      <div class="space-y-2">
                        <div class="h-2 w-16 rounded bg-muted-foreground/20" ></div>
                        <div class="h-6 rounded bg-muted-foreground/10" ></div>
                        <div class="h-6 rounded bg-muted-foreground/10" ></div>
                        <div class="h-6 rounded bg-primary/20"></div>
                      </div>
                    </div>
                  </div>
                </CardContentCn>
              </CardCn>
            </div>
          </div>
        </div>
      </div>
    </section>

