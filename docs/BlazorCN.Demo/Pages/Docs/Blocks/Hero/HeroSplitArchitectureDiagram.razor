@* ============================================================
   Block: hero-split-architecture-diagram
   Title: HeroSplitArchitectureDiagram
   Description: A split-layout hero with an animated SVG architecture diagram of service nodes and dashed edges for React and Next.js featuring an announcement pill, emerald checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-architecture-diagram.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">
                @* Announcement pill *@
                <div class="mb-8">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Now generally available</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">Multi-region edge</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Infrastructure
                    <br />
                    that scales itself
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
                    A composable platform that wires up queues, caches, and workers in seconds — no YAML,
                    no Terraform, no on-call paging.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Deploy free</ButtonCn>
                    <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">Read the docs</ButtonCn>
                </div>
            </div>

            @* Right — architecture diagram mockup *@
            <div class="flex items-center p-6 lg:p-8">
                <div class="w-full overflow-hidden rounded-2xl border bg-muted/50" aria-hidden="true">
                    @* Diagram chrome *@
                    <div class="flex items-center gap-2 border-b bg-background/60 px-4 py-2.5">
                        <div class="flex gap-1.5">
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                        </div>
                        <span class="ml-2 font-mono text-[10px] text-muted-foreground/60">topology.svg</span>
                    </div>

                    @* SVG diagram *@
                    <div class="p-5 sm:p-6">
                        <svg aria-hidden="true" viewBox="0 0 358 200" class="h-auto w-full" fill="none">
                            @* Edges (drawn first so nodes overlay them) *@
                            @foreach (var edge in _edges)
                            {
                                var from = GetNodeCenter(edge.From);
                                var to = GetNodeCenter(edge.To);
                                <line x1="@from.Cx.ToString(System.Globalization.CultureInfo.InvariantCulture)" y1="@from.Cy.ToString(System.Globalization.CultureInfo.InvariantCulture)" x2="@to.Cx.ToString(System.Globalization.CultureInfo.InvariantCulture)" y2="@to.Cy.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                      stroke="currentColor" stroke-width="1" stroke-dasharray="3 3"
                                      class="text-muted-foreground/40" />
                            }

                            @* Nodes *@
                            @foreach (var node in _nodes)
                            {
                                var rectClass = node.Active
                                    ? "fill-background stroke-emerald-500"
                                    : "fill-background stroke-border";
                                var strokeWidth = node.Active ? "1.5" : "1";
                                var textX = node.X + NodeWidth / 2 + (node.Active ? 6 : 0);
                                var textY = node.Y + NodeHeight / 2 + 4;
                                <g>
                                    <rect x="@node.X" y="@node.Y" width="@NodeWidth" height="@NodeHeight"
                                          rx="@NodeRadius" ry="@NodeRadius"
                                          class="@rectClass" stroke-width="@strokeWidth" />
                                    @if (node.Active)
                                    {
                                        var dotCx = node.X + 14;
                                        var dotCy = node.Y + NodeHeight / 2;
                                        <circle cx="@dotCx" cy="@dotCy" r="2.5" class="fill-emerald-500" />
                                    }
                                    <text x="@textX" y="@textY" text-anchor="middle"
                                          class="fill-foreground font-medium text-[11px]">@node.Label</text>
                                </g>
                            }
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private const int NodeWidth = 88;
    private const int NodeHeight = 36;
    private const int NodeRadius = 8;

    private record DiagramNode(string Id, string Label, int X, int Y, bool Active = false);
    private record DiagramEdge(string From, string To, bool Flow = false);
    private record NodeCenter(double Cx, double Cy);

    private static readonly DiagramNode[] _nodes =
    [
        new("cdn",    "CDN",    30,  40),
        new("api",    "API",    150, 40,  Active: true),
        new("queue",  "Queue",  270, 40),
        new("worker", "Worker", 270, 140),
        new("cache",  "Cache",  150, 140),
        new("db",     "DB",     30,  140),
    ];

    private static readonly DiagramEdge[] _edges =
    [
        new("cdn",    "api"),
        new("api",    "queue", Flow: true),
        new("queue",  "worker"),
        new("api",    "cache"),
        new("cache",  "db"),
        new("worker", "cache"),
    ];

    private static readonly string[] _features =
    [
        "Auto-scaling workers across 14 global regions",
        "Sub-50ms cache reads with Redis-compatible API",
        "Built-in tracing with OpenTelemetry exporters",
    ];

    private static NodeCenter GetNodeCenter(string id)
    {
        var node = System.Array.Find(_nodes, n => n.Id == id);
        if (node is null) return new NodeCenter(0, 0);
        return new NodeCenter(node.X + NodeWidth / 2.0, node.Y + NodeHeight / 2.0);
    }
}
