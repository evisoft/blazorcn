@* ============================================================
   Block: hero-split-video
   Title: HeroSplitVideo
   Description: A split-layout hero with a 16:9 video player mockup for React and Next.js featuring an announcement pill, emerald feature checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-video.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid md:grid-cols-2">
            @* Left -- marketing copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">
                @* Announcement pill *@
                <div class="mb-5">
                    <a
                        href="#"
                        class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted"
                    >
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">New release</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">Watch the 2-min demo</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
                    See your product<br />
                    come to life
                </h1>

                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    Watch how teams go from idea to deployed product in minutes, not weeks. We handle the
                    infrastructure so you can focus on what matters.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[200px]">Get started free</ButtonCn>
                    <ButtonCn Class="w-[180px]" Variant="ButtonVariant.Ghost">Schedule demo</ButtonCn>
                </div>
            </div>

            @* Right -- video player mockup *@
            <div class="flex items-center justify-center border-t bg-muted/30 p-6 md:border-l md:border-t-0 md:p-8">
                <div class="w-full overflow-hidden rounded-xl border bg-muted" aria-hidden="true">
                    @* Video chrome bar *@
                    <div class="flex items-center gap-1.5 border-b bg-card px-3 py-2">
                        <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                        <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                        <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                        <div class="ml-2.5 h-2 w-20 rounded-full bg-muted-foreground/[0.07]"></div>
                    </div>

                    @* Video area with centered play button *@
                    <div class="relative flex aspect-[16/9] w-full items-center justify-center bg-muted">
                        @* Subtle crosshair lines *@
                        <div class="absolute h-px w-48 bg-muted-foreground/[0.05]"></div>
                        <div class="absolute h-48 w-px bg-muted-foreground/[0.05]"></div>

                        @* Play button circle *@
                        <div class="flex size-14 items-center justify-center rounded-full border border-muted-foreground/10 bg-background/80 shadow-sm transition-colors hover:bg-background">
                            <LucideIconCn Name="play" Size="24" Class="ml-0.5 size-6 fill-foreground text-foreground" />
                        </div>

                        @* Duration badge *@
                        <div class="absolute bottom-3 right-3 rounded bg-foreground/80 px-2 py-0.5">
                            <span class="font-mono text-[10px] text-background">2:14</span>
                        </div>

                        @* Progress bar *@
                        <div class="absolute inset-x-0 bottom-0 h-0.5 bg-muted-foreground/10">
                            <div class="h-full w-0 bg-foreground/30"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Deploy in one click with zero configuration",
        "Automatic scaling handles any traffic spike",
        "Built-in error tracking and alerting",
    ];
}
