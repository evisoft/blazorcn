@* ============================================================
   Block: hero-centered-single-price
   Title: HeroCenteredSinglePrice
   Description: A centered hero with a prominent single price display for React and Next.js featuring announcement pill, bold headline, oversized price, ShadcnioButton CTA, and dot-separated trust signals built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-single-price.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">

            @* Announcement pill *@
            <div class="mb-6">
                <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium">New</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">Teams plan now available</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            @* Headline *@
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                Ship faster, spend less
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                Everything you need to build, launch, and grow your product. One plan, no complexity.
            </p>

            @* Price display *@
            <div class="mt-8 flex items-baseline justify-center gap-1.5">
                <span class="text-5xl font-bold tracking-tight sm:text-6xl">$19</span>
                <span class="text-lg text-muted-foreground">/mo</span>
            </div>

            @* CTA *@
            <div class="mt-8 flex justify-center">
                <ButtonCn Class="w-[200px]">Start free trial</ButtonCn>
            </div>

            @* Trust text *@
            <div class="mt-5 flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
                @foreach (var trustItem in _trustItems)
                {
                    var idx = Array.IndexOf(_trustItems, trustItem);
                    <span class="flex items-center gap-x-4 text-xs text-muted-foreground">
                        @if (idx > 0)
                        {
                            <span class="mr-4 hidden size-0.5 rounded-full bg-muted-foreground/40 sm:block" aria-hidden="true"></span>
                        }
                        @trustItem
                    </span>
                }
            </div>

        </div>
    </div>
</section>

@code {
    private static readonly string[] _trustItems = ["No credit card required", "14-day free trial", "Cancel anytime"];
}
