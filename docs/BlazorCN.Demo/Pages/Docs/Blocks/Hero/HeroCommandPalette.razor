@* ========================================
   Block: hero-command-palette
   Title: Hero Command Palette
   Description: Hero block with command palette style interface preview
   Dependencies: BadgeCn, ButtonCn, CardCn, InputCn
   Source: original/blocks/hero/hero-command-palette.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
            <div>
                <BadgeCn Class="mb-6 gap-2" Variant="BadgeVariant.Secondary">
                    <LucideCommandCn Size="14" Class="h-3.5 w-3.5" />
                    Keyboard First
                </BadgeCn>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    Do anything with <span class="text-primary">one shortcut</span>
                </h1>

                <p class="mb-8 max-w-lg text-lg text-muted-foreground">
                    Press \u2318K to open the command palette and access every feature instantly. No more
                    clicking through menus—just type what you want.
                </p>

                <div class="flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                        Try It Now
                        <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                        View All Shortcuts
                    </ButtonCn>
                </div>

                <p class="mt-6 text-sm text-muted-foreground">Works on Mac, Windows, and Linux</p>
            </div>

            <div class="flex items-center justify-center">
                <CardCn Class="w-full max-w-md shadow-2xl">
                    <CardContentCn Class="p-0">
                        <div class="border-b p-4">
                            <div class="relative">
                                <LucideSearchCn Size="16" Class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
                                <InputCn Class="pl-10" Placeholder="Type a command or search..." ReadOnly="true" />
                            </div>
                        </div>

                        <div class="p-2">
                            <div class="mb-2 px-2 text-xs font-medium text-muted-foreground">Quick Actions</div>
                            @foreach (var command in _commands)
                            {
                                <div class="flex items-center justify-between rounded-md px-2 py-2 hover:bg-muted">
                                    <div class="flex items-center gap-3">
                                        <span class="text-sm text-muted-foreground">@command.Icon</span>
                                        <span class="text-sm">@command.Label</span>
                                    </div>
                                    <kbd class="rounded bg-muted px-2 py-1 text-xs text-muted-foreground">@command.Shortcut</kbd>
                                </div>
                            }
                        </div>

                        <div class="border-t px-4 py-3">
                            <p class="text-center text-xs text-muted-foreground">
                                Press <kbd class="rounded bg-muted px-1.5 py-0.5">\u2191</kbd>
                                <kbd class="rounded bg-muted px-1.5 py-0.5">\u2193</kbd> to navigate,
                                <kbd class="rounded bg-muted px-1.5 py-0.5">Enter</kbd> to select
                            </p>
                        </div>
                    </CardContentCn>
                </CardCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record CommandItem(string Icon, string Label, string Shortcut);

    private static readonly CommandItem[] _commands =
    [
        new("\ud83d\udcc4", "Create new document", "\u2318 N"),
        new("\ud83d\udd0d", "Search everything", "\u2318 K"),
        new("\ud83d\udc65", "Invite team member", "\u2318 I"),
        new("\u2699\ufe0f", "Open settings", "\u2318 ,"),
        new("\u26a1", "Run automation", "\u2318 R"),
    ];
}
