@* ============================================================
   Block: hero-marquee-dual-testimonials
   Title: HeroMarqueeDualTestimonials
   Description: A centered hero with two opposing marquee rows of scrolling testimonial mini cards for React and Next.js featuring an announcement pill, bold headline, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-marquee-dual-testimonials.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">

    @* Hero copy *@
    <div class="px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:pt-12">

      @* Announcement pill *@
      <div class="mb-5">
        <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
          <span class="size-1.5 rounded-full bg-emerald-500"></span>
          <span class="font-medium">Community</span>
          <span class="text-muted-foreground">&middot;</span>
          <span class="text-muted-foreground">12,000+ five-star reviews</span>
          <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
        </a>
      </div>

      @* Headline *@
      <h1 class="mx-auto max-w-xl text-4xl font-bold tracking-tight sm:text-5xl">
        Built by the people who use it
      </h1>

      @* Subtitle *@
      <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
        From ambitious startups to enterprise teams, shipping the most important work of their
        careers.
      </p>

      @* CTAs *@
      <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <ButtonCn Class="w-[180px]">Get started</ButtonCn>
        <ButtonCn Class="w-[180px]" Variant="ButtonVariant.Ghost">Read reviews</ButtonCn>
      </div>
    </div>

    @* Dual marquee section *@
    <div class="border-t bg-muted/30 py-6 sm:py-8" aria-hidden="true">
      <p class="mb-5 text-center text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
        Loved by teams everywhere
      </p>

      @* Marquee container with gradient edge masks *@
      <div class="relative space-y-3 overflow-hidden"
           style="mask-image:linear-gradient(to right, transparent, black 6%, black 94%, transparent);-webkit-mask-image:linear-gradient(to right, transparent, black 6%, black 94%, transparent)">

        @* Top row — scrolling left *@
        <div class="flex w-max gap-3 marquee-scroll-left">
          <div class="flex shrink-0 gap-3">
            @foreach (var t in _TopRow)
            {
              <div class="flex w-[320px] shrink-0 flex-col rounded-xl border bg-card p-4">
                <p class="line-clamp-2 text-xs leading-relaxed text-foreground/80">
                  &ldquo;@t.Quote&rdquo;
                </p>
                <div class="mt-3 flex items-center gap-2.5">
                  <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                    @t.Initials
                  </div>
                  <div class="min-w-0">
                    <p class="truncate text-xs font-medium">@t.Name</p>
                    <p class="truncate text-[10px] text-muted-foreground">@t.Role</p>
                  </div>
                </div>
              </div>
            }
          </div>
          <div class="flex shrink-0 gap-3">
            @foreach (var t in _TopRow)
            {
              <div class="flex w-[320px] shrink-0 flex-col rounded-xl border bg-card p-4">
                <p class="line-clamp-2 text-xs leading-relaxed text-foreground/80">
                  &ldquo;@t.Quote&rdquo;
                </p>
                <div class="mt-3 flex items-center gap-2.5">
                  <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                    @t.Initials
                  </div>
                  <div class="min-w-0">
                    <p class="truncate text-xs font-medium">@t.Name</p>
                    <p class="truncate text-[10px] text-muted-foreground">@t.Role</p>
                  </div>
                </div>
              </div>
            }
          </div>
        </div>

        @* Bottom row — scrolling right *@
        <div class="flex w-max gap-3 marquee-scroll-right">
          <div class="flex shrink-0 gap-3">
            @foreach (var t in _BottomRow)
            {
              <div class="flex w-[320px] shrink-0 flex-col rounded-xl border bg-card p-4">
                <p class="line-clamp-2 text-xs leading-relaxed text-foreground/80">
                  &ldquo;@t.Quote&rdquo;
                </p>
                <div class="mt-3 flex items-center gap-2.5">
                  <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                    @t.Initials
                  </div>
                  <div class="min-w-0">
                    <p class="truncate text-xs font-medium">@t.Name</p>
                    <p class="truncate text-[10px] text-muted-foreground">@t.Role</p>
                  </div>
                </div>
              </div>
            }
          </div>
          <div class="flex shrink-0 gap-3">
            @foreach (var t in _BottomRow)
            {
              <div class="flex w-[320px] shrink-0 flex-col rounded-xl border bg-card p-4">
                <p class="line-clamp-2 text-xs leading-relaxed text-foreground/80">
                  &ldquo;@t.Quote&rdquo;
                </p>
                <div class="mt-3 flex items-center gap-2.5">
                  <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                    @t.Initials
                  </div>
                  <div class="min-w-0">
                    <p class="truncate text-xs font-medium">@t.Name</p>
                    <p class="truncate text-[10px] text-muted-foreground">@t.Role</p>
                  </div>
                </div>
              </div>
            }
          </div>
        </div>

      </div>
    </div>

  </div>

  @* CSS keyframes for dual marquee *@
  <style>
    @@keyframes marquee-scroll-left {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    @@keyframes marquee-scroll-right {
      from { transform: translateX(-50%); }
      to { transform: translateX(0); }
    }
    .marquee-scroll-left {
      animation: marquee-scroll-left 45s linear infinite;
    }
    .marquee-scroll-right {
      animation: marquee-scroll-right 50s linear infinite;
    }
    @@media (prefers-reduced-motion: reduce) {
      .marquee-scroll-left,
      .marquee-scroll-right {
        animation: none;
      }
    }
  </style>
</section>

@code {
    private record MiniTestimonial(string Id, string Quote, string Name, string Role, string Initials);

    private static readonly MiniTestimonial[] _TopRow =
    [
        new("t1", "Cut our onboarding time from weeks to a single afternoon.", "Sarah Chen", "Eng Lead, Meridian", "SC"),
        new("t2", "The UX is so clean our designers actually filed complaints about having nothing to fix.", "Marcus Rivera", "PM, Cosmo AI", "MR"),
        new("t3", "Migrated 500K records with zero downtime. That level of care is rare.", "Emily Zhao", "CTO, Lattice Health", "EZ"),
        new("t4", "Paid for itself in the first month through the analytics alone.", "David Kim", "Growth, Canopy", "DK"),
        new("t5", "We evaluated every competitor. Nothing comes close to this polish.", "Lisa Okonkwo", "Design, Studio Noire", "LO"),
        new("t6", "Our engineers shipped features by day three. Actually unreal.", "James Whitfield", "VP Eng, Prism", "JW"),
        new("t7", "Replaced three legacy tools with one subscription. Finance loves it.", "Priya Nair", "Ops Lead, Vantage", "PN"),
    ];

    private static readonly MiniTestimonial[] _BottomRow =
    [
        new("b1", "Shipped our biggest product launch using this stack. Flawless.", "Noah Bennett", "Founder, Aster", "NB"),
        new("b2", "Support replied to a Friday night bug report within minutes.", "Maya Okafor", "Staff Eng, Orbit", "MO"),
        new("b3", "We rebuilt our whole admin panel in two sprints with this.", "Tomas Adler", "Tech Lead, Paperline", "TA"),
        new("b4", "The docs set a new bar. Every team I recommend says the same.", "Hannah Weiss", "DevRel, Figma", "HW"),
        new("b5", "Feels designed for people who actually ship software.", "Ravi Patel", "Engineer, Slate", "RP"),
        new("b6", "Replaced a custom in-house tool we spent 18 months building.", "Amara Osei", "CTO, Finch", "AO"),
        new("b7", "My whole team switched within a week. No training required.", "Jordan Lee", "Head of Product, Ember", "JL"),
    ];
}
