@* ============================================================
   Block: hero-progress
   Title: Hero Progress
   Description: Hero block with progress indicators showing goals or milestones achieved
   Dependencies: BadgeCn, ButtonCn, CardCn, ProgressCn
   Source: original/blocks/hero/hero-progress.tsx
   ============================================================ *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="mx-auto max-w-4xl">
            <div class="mb-12 text-center">
                <BadgeCn Class="mb-6" Variant="BadgeVariant.Secondary">
                    Join the Movement
                </BadgeCn>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    Help us reach our <span class="text-primary">goals</span>
                </h1>

                <p class="mx-auto max-w-2xl text-lg text-muted-foreground">
                    We're building something special, and we're almost there. Join thousands of early
                    adopters who are helping shape the future.
                </p>
            </div>

            <div class="mb-12 grid gap-6 md:grid-cols-3">
                @foreach (var goal in _goals)
                {
                    var percentage = (int)Math.Round((double)goal.Current / goal.Target * 100);
                    <CardCn>
                        <CardContentCn Class="p-6">
                            <div class="mb-4 flex items-center gap-3">
                                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
                                    <span class="text-sm font-bold text-primary">@goal.Icon</span>
                                </div>
                                <span class="font-medium">@goal.Label</span>
                            </div>

                            <div class="mb-2">
                                <span class="text-3xl font-bold">@(goal.Prefix)@FormatNumber(goal.Current)</span>
                                <span class="text-muted-foreground"> / @(goal.Prefix)@FormatNumber(goal.Target) @goal.Unit</span>
                            </div>

                            <ProgressCn Class="mb-2 h-2" Value="percentage" />

                            <div class="flex items-center justify-between text-sm">
                                <span class="text-muted-foreground">@percentage% complete</span>
                                <span class="font-medium text-primary">@FormatNumber(goal.Target - goal.Current) to go</span>
                            </div>
                        </CardContentCn>
                    </CardCn>
                }
            </div>

            <div class="text-center">
                <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
                    <ButtonCn Class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
                        Join Now
                        <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                        View Roadmap
                    </ButtonCn>
                </div>

                <p class="mt-6 text-sm text-muted-foreground">
                    Be part of something big • Early supporters get lifetime benefits
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record Goal(string Icon, string Label, int Current, int Target, string Unit, string Prefix = "");

    private static readonly Goal[] _goals =
    [
        new("\ud83d\udc65", "Early Adopters", 8420, 10000, "users"),
        new("\ud83c\udfaf", "Funding Goal", 847000, 1000000, "raised", "$"),
        new("\ud83d\ude80", "Features Shipped", 42, 50, "features"),
    ];

    private static string FormatNumber(int num)
    {
        if (num >= 1_000_000) return $"{num / 1_000_000.0:F1}M";
        if (num >= 1000) return $"{num / 1000}K";
        return num.ToString();
    }
}
