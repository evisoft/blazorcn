@* ========================================
   Block: hero-founder-note
   Title: Hero Founder Note
   Description: Hero block with personal founder message and signature
   Long Description: Hero block with prominent vertical feature list and icons
   Dependencies: AvatarCn, BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-founder-note.tsx
   ======================================== *@

<section class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="mx-auto max-w-3xl">
          <div class="mb-8 text-center">
            <BadgeCn class="mb-6 gap-2" Variant="BadgeVariant.Secondary">
              <LucideHeartCn Size="12" Class="h-3.5 w-3.5" />A Note From Our Founder
            </BadgeCn>
          </div>

          <CardCn class="mb-10">
            <CardContentCn class="p-8 sm:p-10">
              <div class="prose prose-lg max-w-none">
                <p class="text-lg leading-relaxed text-foreground">Hi there,</p>

                <p class="text-lg leading-relaxed text-muted-foreground">
                  I built this product because I was frustrated with the tools available. They were
                  either too complex, too expensive, or just didn't work the way I needed them to.
                </p>

                <p class="text-lg leading-relaxed text-muted-foreground">
                  So I decided to create something different—a tool that's simple enough for anyone
                  to use, powerful enough for professionals, and priced fairly so everyone can
                  access it.
                </p>

                <p class="text-lg leading-relaxed text-muted-foreground">
                  Every feature we build starts with one question: "Will this actually help our
                  users?" If the answer isn't a clear yes, we don't build it.
                </p>

                <p class="text-lg leading-relaxed text-foreground">
                  I'd love for you to give it a try. And if you have feedback, I read every single
                  message personally.
                </p>
              </div>

              @* Signature *@
              <div class="mt-8 flex items-center gap-4">
                <AvatarCn class="h-14 w-14">
                  <AvatarImageCn alt="Alex Chen" src="https://i.pravatar.cc/150?img=11" />
                  <AvatarFallbackCn>AC</AvatarFallbackCn>
                </AvatarCn>
                <div>
                  <div class="font-semibold">Alex Chen</div>
                  <div class="text-sm text-muted-foreground">Founder & CEO</div>
                  <div class="text-sm text-primary">alex@@company.com</div>
                </div>
              </div>
            </CardContentCn>
          </CardCn>

          @* CTA *@
          <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
            <ButtonCn class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
              Start Your Free Trial
              <LucideArrowRightCn Size="16" Class="h-4 w-4" />
            </ButtonCn>
            <ButtonCn class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
              Read Our Story
            </ButtonCn>
          </div>

          <p class="mt-6 text-center text-sm text-muted-foreground">
            Join 25,000+ users who trust us with their workflow
          </p>
        </div>
      </div>
    </section>

