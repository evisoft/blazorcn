@* ========================================
   Block: hero-interactive-demo
   Title: Hero Interactive Demo
   Description: Hero block with interactive mini-demo or playground
   Dependencies: BadgeCn, ButtonCn, CardCn, InputCn, LabelCn, SwitchCn
   Source: original/blocks/hero/hero-interactive-demo.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div class="flex flex-col justify-center">
                <BadgeCn Class="mb-6 w-fit gap-2" Variant="BadgeVariant.Secondary">
                    <LucideSparklesCn Size="14" Class="h-3.5 w-3.5" />
                    Try It Now
                </BadgeCn>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    See the magic <span class="text-primary">in action</span>
                </h1>

                <p class="mb-8 max-w-lg text-lg text-muted-foreground">
                    Don't just take our word for it. Try our text transformer right here and see how
                    powerful and easy it is to use.
                </p>

                <div class="flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                        Start Free Trial
                        <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                        View Documentation
                    </ButtonCn>
                </div>

                <div class="mt-8 flex items-center gap-6 text-sm text-muted-foreground">
                    <div class="flex items-center gap-2">
                        <LucideCheckCn Size="16" Class="h-4 w-4 text-primary" />
                        No signup required
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideCheckCn Size="16" Class="h-4 w-4 text-primary" />
                        Instant results
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-center">
                <CardCn Class="w-full max-w-md shadow-lg">
                    <CardContentCn Class="p-6">
                        <h3 class="mb-4 font-semibold">Text Transformer Demo</h3>

                        <div class="mb-4 space-y-2">
                            <LabelCn For="demo-input">Your text</LabelCn>
                            <InputCn id="demo-input" Placeholder="Enter some text..." @bind-Value="_inputValue" />
                        </div>

                        <div class="mb-6 space-y-4">
                            <div class="flex items-center justify-between">
                                <LabelCn Class="cursor-pointer" For="uppercase">Uppercase</LabelCn>
                                <SwitchCn id="uppercase" Checked="_isUppercase" CheckedChanged="@((bool v) => _isUppercase = v)" />
                            </div>
                            <div class="flex items-center justify-between">
                                <LabelCn Class="cursor-pointer" For="reverse">Reverse</LabelCn>
                                <SwitchCn id="reverse" Checked="_isReversed" CheckedChanged="@((bool v) => _isReversed = v)" />
                            </div>
                            <div class="flex items-center justify-between">
                                <LabelCn Class="cursor-pointer" For="emoji">Add sparkles</LabelCn>
                                <SwitchCn id="emoji" Checked="_hasEmoji" CheckedChanged="@((bool v) => _hasEmoji = v)" />
                            </div>
                        </div>

                        <div class="rounded-lg border bg-muted/50 p-4">
                            <LabelCn Class="mb-2 block text-xs text-muted-foreground">Result</LabelCn>
                            <p class="min-h-[24px] break-all font-mono text-lg">
                                @(GetTransformedText())
                            </p>
                        </div>

                        <ButtonCn Class="mt-4 w-full gap-2">
                            Unlock 100+ Transformations
                            <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                        </ButtonCn>
                    </CardContentCn>
                </CardCn>
            </div>
        </div>
    </div>
</section>

@code {
    private string _inputValue = "Hello World";
    private bool _isUppercase;
    private bool _isReversed;
    private bool _hasEmoji;

    private string GetTransformedText()
    {
        var result = _inputValue;
        if (string.IsNullOrEmpty(result)) return "Enter text above...";
        if (_isUppercase) result = result.ToUpperInvariant();
        if (_isReversed) result = new string(result.Reverse().ToArray());
        if (_hasEmoji) result = $"\u2728 {result} \u2728";
        return result;
    }
}
