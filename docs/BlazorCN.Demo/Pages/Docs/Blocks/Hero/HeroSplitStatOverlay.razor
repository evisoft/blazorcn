@* ============================================================
   Block: hero-split-stat-overlay
   Title: HeroSplitStatOverlay
   Description: A split-layout hero with floating stat cards overlaid on a dashboard mockup for React and Next.js featuring an announcement pill, feature checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-stat-overlay.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">
                @* Announcement pill *@
                <div class="mb-6">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Live dashboards</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">v3 released</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Metrics that
                    <br />
                    move the needle
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                    Watch your most important numbers change in real time. Stop refreshing spreadsheets
                    and start shipping decisions.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                    <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">View live demo</ButtonCn>
                </div>
            </div>

            @* Right — dashboard mockup with floating stat cards *@
            <div class="relative flex items-center p-6 lg:p-10" aria-hidden="true">
                <div class="relative w-full">
                    @* Base dashboard mockup *@
                    <div class="overflow-hidden rounded-2xl border bg-muted/50">
                        @* Window chrome *@
                        <div class="flex items-center gap-2 border-b bg-background/60 px-4 py-2.5">
                            <div class="flex gap-1.5">
                                <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                                <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                                <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            </div>
                            <div class="ml-2 h-2 w-24 rounded-full bg-muted-foreground/10"></div>
                        </div>

                        <div class="space-y-4 p-5 sm:p-6">
                            @* Chart area *@
                            <div class="relative h-28 overflow-hidden rounded-lg border bg-background/40 p-3">
                                <div class="mb-2 h-1.5 w-20 rounded-full bg-muted-foreground/15"></div>
                                <svg class="h-16 w-full" viewBox="0 0 200 60" preserveAspectRatio="none">
                                    <title>Chart skeleton</title>
                                    <path
                                        d="M0,45 C25,38 40,20 60,22 S100,42 120,30 S160,8 200,14"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        class="text-muted-foreground/30" />
                                    <path
                                        d="M0,45 C25,38 40,20 60,22 S100,42 120,30 S160,8 200,14 L200,60 L0,60 Z"
                                        fill="currentColor"
                                        class="text-muted-foreground/5" />
                                </svg>
                            </div>

                            @* Table rows *@
                            <div class="space-y-2">
                                <div class="flex items-center gap-3">
                                    <div class="size-5 rounded bg-muted-foreground/10"></div>
                                    <div class="h-2 flex-1 rounded-full bg-muted-foreground/12"></div>
                                    <div class="h-2 w-10 rounded-full bg-muted-foreground/10"></div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div class="size-5 rounded bg-muted-foreground/10"></div>
                                    <div class="h-2 flex-1 rounded-full bg-muted-foreground/10"></div>
                                    <div class="h-2 w-10 rounded-full bg-muted-foreground/10"></div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div class="size-5 rounded bg-muted-foreground/10"></div>
                                    <div class="h-2 flex-1 rounded-full bg-muted-foreground/12"></div>
                                    <div class="h-2 w-10 rounded-full bg-muted-foreground/10"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Floating stat card 1 — top left *@
                    <div class="absolute -top-3 left-2 w-36 rounded-xl border bg-card p-3 shadow-xl shadow-foreground/5 ring-1 ring-border/50 sm:-top-4 sm:left-4">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                Revenue
                            </span>
                            <span class="inline-flex items-center gap-0.5 text-[10px] font-semibold text-emerald-600 dark:text-emerald-500">
                                <LucideIconCn Name="trending-up" Size="10" Class="size-2.5" />
                                12.4%
                            </span>
                        </div>
                        <div class="mt-1 text-xl font-semibold tabular-nums text-foreground">
                            $48.2K
                        </div>
                    </div>

                    @* Floating stat card 2 — middle right *@
                    <div class="absolute top-1/2 -right-2 w-32 -translate-y-1/2 rounded-xl border bg-card p-3 shadow-xl shadow-foreground/5 ring-1 ring-border/50 sm:-right-4">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                Users
                            </span>
                            <span class="inline-flex items-center gap-0.5 text-[10px] font-semibold text-emerald-600 dark:text-emerald-500">
                                <LucideIconCn Name="trending-up" Size="10" Class="size-2.5" />
                                8.1%
                            </span>
                        </div>
                        <div class="mt-1 text-xl font-semibold tabular-nums text-foreground">12.4K</div>
                    </div>

                    @* Floating stat card 3 — bottom left *@
                    <div class="absolute -bottom-3 left-6 w-32 rounded-xl border bg-card p-3 shadow-xl shadow-foreground/5 ring-1 ring-border/50 sm:-bottom-4 sm:left-10">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                Churn
                            </span>
                            <span class="inline-flex items-center gap-0.5 text-[10px] font-semibold text-red-600 dark:text-red-500">
                                <LucideIconCn Name="trending-down" Size="10" Class="size-2.5" />
                                2.3%
                            </span>
                        </div>
                        <div class="mt-1 text-xl font-semibold tabular-nums text-foreground">0.8%</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Real-time metrics with sub-second query latency",
        "Custom dashboards with drag-and-drop widgets",
        "Alerts that ping Slack, PagerDuty, or email",
    ];
}
