@* ============================================================
   Block: hero-dark-terminal-copy
   Title: HeroDarkTerminalCopy
   Description: A dark-themed centered hero with a terminal install command and copy-to-clipboard interaction for React and Next.js featuring an inverted announcement pill and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-dark-terminal-copy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">

    @* Dark hero section *@
    <div class="bg-foreground px-6 py-10 text-center sm:px-10 sm:py-12 lg:py-14">

      @* Announcement pill *@
      <div class="mb-5">
        <a
          href="#"
          class="inline-flex items-center gap-2 rounded-full border border-background/20 bg-background/[0.06] px-3 py-1 text-xs transition-colors hover:bg-background/10"
        >
          <span class="size-1.5 rounded-full bg-background/60"></span>
          <span class="font-medium text-background">Now available</span>
          <span class="text-background/40">&middot;</span>
          <span class="text-background/40">v3.0 released</span>
          <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-background/40" />
        </a>
      </div>

      @* Headline *@
      <h1 class="text-4xl font-bold tracking-tight text-background sm:text-5xl">
        From zero to production
        <br />
        in one command
      </h1>

      @* Subtitle *@
      <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-background/60">
        TypeScript, testing, CI/CD, and deployment. All configured and ready to ship. No
        boilerplate.
      </p>

      @* Terminal command block *@
      <div class="mx-auto mt-7 max-w-xl">
        <div class="flex items-center justify-between rounded-lg border border-background/10 bg-background/[0.06] px-4 py-3">
          <div class="flex items-center gap-2.5 overflow-hidden">
            <span class="shrink-0 font-mono text-sm text-background/40">$</span>
            <code class="truncate font-mono text-sm text-background/80">
              @_installCommand
            </code>
          </div>
          <ButtonCn
            Variant="ButtonVariant.Outline"
            Size="ButtonSize.Sm"
            Class="ml-3 shrink-0 border border-background/15 bg-transparent text-background/60 hover:bg-background/10 hover:text-background"
            OnClick="HandleCopy"
          >
            @if (_copied)
            {
              <LucideIconCn Name="check" Size="14" Class="size-3.5 stroke-[3] text-emerald-500" StrokeWidth="3" />
              <span class="ml-1.5 text-xs">Copied</span>
            }
            else
            {
              <LucideIconCn Name="copy" Size="14" Class="size-3.5" />
              <span class="ml-1.5 text-xs">Copy</span>
            }
          </ButtonCn>
        </div>
        <p class="mt-3 text-xs text-background/35">Works with npm, yarn, pnpm, and bun</p>
      </div>

      @* CTAs *@
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <ButtonCn Class="w-[180px] bg-background text-foreground hover:bg-background/90">
          Get started
        </ButtonCn>
        <ButtonCn
          Variant="ButtonVariant.Outline"
          Class="w-[150px] border border-background/20 bg-transparent text-background hover:bg-background/10"
        >
          Read the docs
        </ButtonCn>
      </div>
    </div>

    @* Light stats bar *@
    <div class="border-t bg-muted/30 px-6 py-6 sm:px-10">
      <div class="mx-auto flex max-w-2xl flex-wrap items-center justify-center gap-8">
        @foreach (var stat in _stats)
        {
          var s = stat;
          <div class="flex items-center gap-8">
            <div class="text-center">
              <p class="text-2xl font-semibold tabular-nums">@s.Value</p>
              <p class="text-xs text-muted-foreground">@s.Label</p>
            </div>
            @if (s.ShowDivider)
            {
              <div class="hidden h-8 w-px bg-border sm:block" aria-hidden="true"></div>
            }
          </div>
        }
      </div>
    </div>

  </div>
</section>

@code {
    private const string _installCommand = "npx create-app@latest";
    private bool _copied = false;

    private record Stat(string Value, string Label, bool ShowDivider);

    private static readonly Stat[] _stats =
    [
        new("50K+", "Developers", true),
        new("12M", "Downloads", true),
        new("99.9%", "Uptime", false),
    ];

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
