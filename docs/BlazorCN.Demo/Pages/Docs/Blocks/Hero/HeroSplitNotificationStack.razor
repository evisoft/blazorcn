@* ============================================================
   Block: hero-split-notification-stack
   Title: HeroSplitNotificationStack
   Description: A split-layout hero with a stacked notification card panel for React and Next.js featuring icon circles, staggered entrance, emerald feature checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-notification-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="grid md:grid-cols-[1fr,1.1fr]">

      @* Left -- copy *@
      <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">

        @* Announcement pill *@
        <div class="mb-5">
          <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="font-medium">What&apos;s new</span>
            <span class="text-muted-foreground">&middot;</span>
            <span class="text-muted-foreground">Smart routing v2</span>
            <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
          </a>
        </div>

        @* Headline *@
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Never miss what<br />
          matters most
        </h1>

        @* Subtitle *@
        <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
          Intelligent notifications that keep your team informed without the noise. The right
          alert, to the right person, at the right time.
        </p>

        @* Feature checklist *@
        <ul class="mt-6 space-y-2.5">
          @foreach (var feature in _Features)
          {
            <li class="flex items-center gap-3">
              <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
              <span class="text-sm text-foreground">@feature</span>
            </li>
          }
        </ul>

        @* CTAs *@
        <div class="mt-8 flex items-center gap-3">
          <ButtonCn Class="w-[180px]">Get started</ButtonCn>
          <ButtonCn Class="w-[190px]" Variant="ButtonVariant.Ghost">View integrations</ButtonCn>
        </div>

      </div>

      @* Right -- notification stack *@
      <div class="flex items-center justify-center bg-muted p-6 md:p-8" aria-hidden="true">
        <div class="w-full max-w-sm space-y-3">

          @* Bell icon header *@
          <div class="mb-4 flex items-center gap-2">
            <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-xs font-medium text-muted-foreground">3 new notifications</span>
          </div>

          @* Notification cards *@
          @foreach (var notification in _Notifications)
          {
            <div class="rounded-lg border bg-card p-3.5 shadow-sm">
              <div class="flex items-start gap-3">
                @* Icon circle *@
                <div class="@Cn.Merge("mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full", notification.IconBg)">
                  <LucideIconCn Name="@notification.IconName" Size="16" Class="size-4 text-foreground/70" />
                </div>
                @* Content *@
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-medium">@notification.Title</p>
                  <p class="mt-0.5 text-xs text-muted-foreground">@notification.Description</p>
                  <div class="mt-1.5 flex items-center gap-1">
                    <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground/60" />
                    <span class="text-[10px] text-muted-foreground/60">@notification.Time</span>
                  </div>
                </div>
              </div>
            </div>
          }

        </div>
      </div>

    </div>
  </div>
</section>

@code {
    private static readonly string[] _Features =
    [
        "Intelligent routing to the right channel",
        "Customizable notification preferences",
        "Enterprise-grade delivery guarantees",
    ];

    private record NotificationItem(string IconName, string IconBg, string Title, string Description, string Time);

    private static readonly NotificationItem[] _Notifications =
    [
        new("circle-check-2", "bg-foreground/[0.07]", "Deployment successful", "Production build deployed to app.example.com", "Just now"),
        new("user-plus", "bg-foreground/[0.05]", "New team member joined", "Sarah Chen accepted the invitation to the design team", "2 min ago"),
        new("shield-alert", "bg-foreground/[0.05]", "Security alert", "Unusual login attempt blocked from 192.168.1.42", "8 min ago"),
    ];
}
