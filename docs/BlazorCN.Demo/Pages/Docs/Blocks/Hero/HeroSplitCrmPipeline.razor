@* ============================================================
   Block: hero-split-crm-pipeline
   Title: HeroSplitCrmPipeline
   Description: A split-layout hero with a four-column CRM deal pipeline mockup for React and Next.js featuring stage totals, deal cards, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-crm-pipeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">
                @* Announcement pill *@
                <div class="mb-8">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Q2 release</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">Forecasting 2.0</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    The pipeline
                    <br />
                    your reps actually update
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
                    Drag deals through every stage with one click. Auto-enriched contacts, AI summaries,
                    and forecasts your finance team can trust.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[170px]">Book a demo</ButtonCn>
                    <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">Learn more</ButtonCn>
                </div>
            </div>

            @* Right — CRM pipeline mockup *@
            <div class="flex items-center p-6 lg:p-10">
                <div aria-hidden="true" class="w-full overflow-hidden rounded-2xl border bg-muted/50 p-3">
                    <div class="grid grid-cols-4 gap-2">
                        @foreach (var stage in _stages)
                        {
                            <div class="flex flex-col gap-2 rounded-lg border bg-background/60 p-2">
                                @* Stage header *@
                                <div class="flex flex-col gap-0.5 border-b pb-2">
                                    <div class="flex items-center justify-between">
                                        <span class="text-[10px] font-semibold tracking-wide text-foreground uppercase">@stage.Name</span>
                                        <span class="text-[9px] text-muted-foreground tabular-nums">@stage.Count</span>
                                    </div>
                                    <span class="text-[10px] font-medium text-muted-foreground tabular-nums">@stage.Total</span>
                                </div>

                                @* Deal cards *@
                                <div class="flex flex-col gap-1.5">
                                    @foreach (var deal in stage.Deals)
                                    {
                                        <div class="@Cn.Merge("flex flex-col gap-1.5 rounded-md border bg-card p-1.5", deal.Highlight ? "border-foreground/40 ring-1 ring-foreground/10" : "")">
                                            <span class="truncate text-[10px] font-medium text-foreground">@deal.Company</span>
                                            <div class="flex items-center justify-between">
                                                <span class="text-[9px] text-muted-foreground tabular-nums">@deal.Value</span>
                                                <span class="flex size-4 items-center justify-center rounded-full bg-muted-foreground/15 text-[8px] font-semibold text-muted-foreground">@deal.Initials</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "One pipeline across every rep, team, and region",
        "Auto-enriched deals with company and contact data",
        "Forecast accuracy within 3% of closed revenue",
    ];

    private record Deal(string Id, string Company, string Value, string Initials, bool Highlight = false);
    private record Stage(string Name, int Count, string Total, Deal[] Deals);

    private static readonly Stage[] _stages =
    [
        new("Lead", 12, "$84k",
        [
            new("l1", "Northwind", "$6k", "NW"),
            new("l2", "Acme Co", "$12k", "AC"),
            new("l3", "Lumen", "$4k", "LU"),
        ]),
        new("Qualified", 7, "$62k",
        [
            new("q1", "Globex", "$14k", "GX"),
            new("q2", "Initech", "$9k", "IT"),
        ]),
        new("Proposal", 4, "$118k",
        [
            new("p1", "Stark Ind.", "$28k", "SI"),
            new("p2", "Wayne Co.", "$42k", "WC", Highlight: true),
            new("p3", "Vandelay", "$18k", "VD"),
        ]),
        new("Won", 9, "$204k",
        [
            new("w1", "Hooli", "$52k", "HL"),
            new("w2", "Pied Piper", "$31k", "PP"),
        ]),
    ];
}
