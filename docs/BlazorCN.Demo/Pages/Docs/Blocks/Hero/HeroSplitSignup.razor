@* ============================================================
   Block: hero-split-signup
   Title: HeroSplitSignup
   Description: A split-layout hero with marketing copy on the left and an inline three-field signup form card on the right for React and Next.js built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/hero/hero-split-signup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="grid md:grid-cols-2">

      @* Left -- marketing copy *@
      <div class="flex flex-col justify-center px-6 py-8 sm:px-10 md:py-10 lg:px-14 lg:py-12">

        @* Announcement pill *@
        <div class="mb-5">
          <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="font-medium">Free to start</span>
            <span class="text-muted-foreground">&middot;</span>
            <span class="text-muted-foreground">No credit card needed</span>
            <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
          </a>
        </div>

        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Start building in<br />
          under a minute
        </h1>

        <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
          Create your account and deploy your first project before you finish your coffee. Zero
          configuration required.
        </p>

        <ul class="mt-5 space-y-2.5">
          @foreach (var feature in _features)
          {
            <li class="flex items-center gap-3">
              <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
              <span class="text-sm text-foreground">@feature</span>
            </li>
          }
        </ul>

        <p class="mt-6 text-xs text-muted-foreground">
          Trusted by 8,000+ developers and 500+ teams worldwide
        </p>
      </div>

      @* Right -- signup form card *@
      <div class="flex items-center justify-center border-t bg-muted/30 p-6 md:border-l md:border-t-0 md:p-8">
        <div class="w-full max-w-sm">
          <h2 class="text-lg font-semibold">Create your account</h2>
          <p class="mt-1 text-sm text-muted-foreground">Get started for free in seconds</p>

          <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true" class="mt-6 space-y-4">
            <div>
              <LabelCn For="signup-name" Class="text-sm">Full name</LabelCn>
              <InputCn id="signup-name" Placeholder="Sarah Chen" Class="mt-1.5" />
            </div>
            <div>
              <LabelCn For="signup-email" Class="text-sm">Work email</LabelCn>
              <InputCn id="signup-email" type="email" Placeholder="@("sarah@@company.com")" Class="mt-1.5" />
            </div>
            <div>
              <LabelCn For="signup-password" Class="text-sm">Password</LabelCn>
              <InputCn id="signup-password" type="password" Placeholder="8+ characters" Class="mt-1.5" />
            </div>

            <ButtonCn type="submit" Class="w-full" Disabled="@_isLoading">
              @if (_isLoading)
              {
                <LucideIconCn Name="loader-2" Size="16" Class="size-4 animate-spin" />
                <span>Creating account...</span>
              }
              else
              {
                <span>Create account</span>
              }
            </ButtonCn>
          </form>

          <p class="mt-4 text-center text-xs text-muted-foreground">
            Already have an account?&#32;
            <a href="#" class="underline hover:text-foreground">Sign in</a>
          </p>

          <p class="mt-3 text-center text-[10px] text-muted-foreground">
            By creating an account, you agree to our&#32;
            <a href="#" class="underline hover:text-foreground">Terms</a>
            &#32;and&#32;
            <a href="#" class="underline hover:text-foreground">Privacy Policy</a>
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

@code {
  private bool _isLoading = false;

  private static readonly string[] _features =
  [
    "Unlimited projects on the free tier",
    "Automatic deployments from Git",
    "Built-in analytics and monitoring",
  ];

  private async Task HandleSubmit()
  {
    _isLoading = true;
    await Task.Delay(2000);
    _isLoading = false;
  }
}
