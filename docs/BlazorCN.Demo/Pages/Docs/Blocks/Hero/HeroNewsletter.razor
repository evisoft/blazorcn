@* ========================================
   Block: hero-newsletter
   Title: Hero Newsletter
   Description: Hero block with prominent newsletter signup, social proof counter, and privacy-focused messaging
   Dependencies: AvatarCn, BadgeCn, ButtonCn, InputCn
   Source: original/blocks/hero/hero-newsletter.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10">
        <div class="absolute left-1/2 top-0 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/5 blur-3xl"></div>
    </div>

    <div class="container mx-auto px-4 py-24 md:py-32 lg:py-40">
        <div class="mx-auto max-w-2xl text-center">
            <BadgeCn Class="mb-6 gap-2" Variant="BadgeVariant.Secondary">
                <LucideSparklesCn Size="14" Class="h-3.5 w-3.5" />
                Free weekly insights
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                Level up your<br />
                <span class="text-primary">product skills</span>
            </h1>

            <p class="mx-auto mb-10 max-w-lg text-lg text-muted-foreground">
                Join 12,000+ designers and developers getting weekly tips on building better products.
                No spam, unsubscribe anytime.
            </p>

            @if (_isSuccess)
            {
                <div class="mx-auto max-w-md rounded-2xl border bg-green-50 p-8 dark:bg-green-950/30">
                    <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/50">
                        <LucideCheckCn Size="24" Class="h-6 w-6 text-green-600 dark:text-green-400" />
                    </div>
                    <h3 class="mb-2 text-xl font-semibold">You're subscribed!</h3>
                    <p class="text-muted-foreground">
                        Check your inbox for a confirmation email. Welcome to the community!
                    </p>
                </div>
            }
            else
            {
                <div class="mx-auto max-w-md">
                    <div class="flex flex-col gap-3 sm:flex-row">
                        <div class="relative flex-1">
                            <LucideMailCn Size="20" Class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-muted-foreground" />
                            <InputCn Class="h-14 pl-12 text-base" Placeholder="Enter your email" Type="email" @bind-Value="_email" />
                        </div>
                        <ButtonCn Class="h-14 gap-2 px-8" Size="ButtonSize.Lg" @onclick="HandleSubmit">
                            Subscribe
                            <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                        </ButtonCn>
                    </div>
                </div>
            }

            <div class="mt-10 flex flex-col items-center justify-center gap-6 sm:flex-row sm:gap-8">
                <div class="flex items-center gap-3">
                    <div class="flex -space-x-2">
                        @foreach (var sub in _subscribers)
                        {
                            <AvatarCn Class="h-8 w-8 border-2 border-background">
                                <AvatarImageCn Alt="Subscriber" Src="@sub.Src" />
                                <AvatarFallbackCn Class="text-xs">@sub.Fallback</AvatarFallbackCn>
                            </AvatarCn>
                        }
                    </div>
                    <p class="text-sm text-muted-foreground">
                        <span class="font-semibold text-foreground">12,437</span> subscribers
                    </p>
                </div>

                <div class="hidden h-4 w-px bg-border sm:block"></div>

                <div class="flex items-center gap-2 text-sm text-muted-foreground">
                    <LucideShieldCn Size="16" Class="h-4 w-4" />
                    <span>No spam, ever</span>
                </div>
            </div>

            <div class="mt-12 flex flex-wrap items-center justify-center gap-6 text-xs text-muted-foreground">
                <div class="flex items-center gap-2">
                    <LucideCheckCn Size="16" Class="h-4 w-4 text-green-500" />
                    Weekly insights
                </div>
                <div class="flex items-center gap-2">
                    <LucideCheckCn Size="16" Class="h-4 w-4 text-green-500" />
                    Exclusive content
                </div>
                <div class="flex items-center gap-2">
                    <LucideCheckCn Size="16" Class="h-4 w-4 text-green-500" />
                    Unsubscribe anytime
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Subscriber(string Src, string Fallback);

    private string _email = "";
    private bool _isSuccess;

    private static readonly Subscriber[] _subscribers =
    [
        new("https://i.pravatar.cc/150?img=1", "JD"),
        new("https://i.pravatar.cc/150?img=2", "AS"),
        new("https://i.pravatar.cc/150?img=3", "MK"),
        new("https://i.pravatar.cc/150?img=4", "RW"),
        new("https://i.pravatar.cc/150?img=5", "TL"),
    ];

    private void HandleSubmit()
    {
        if (!string.IsNullOrEmpty(_email) && _email.Contains('@'))
        {
            _isSuccess = true;
        }
    }
}
