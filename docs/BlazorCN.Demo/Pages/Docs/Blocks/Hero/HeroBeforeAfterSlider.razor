@* ============================================================
   Block: hero-before-after-slider
   Title: HeroBeforeAfterSlider
   Description: A dark-themed hero for React and Next.js with a full-width draggable before/after comparison, pointer-driven slider, stats bar, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-before-after-slider.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border">

        @* Dark header section *@
        <div class="bg-foreground px-8 py-8 text-center sm:py-10">

            @* Announcement pill *@
            <div class="mb-5 flex justify-center">
                <a href="#" class="inline-flex items-center gap-2 rounded-full border border-background/20 px-3.5 py-1.5 text-sm transition-colors hover:bg-background/10">
                    <span class="size-1.5 rounded-full bg-background/60"></span>
                    <span class="font-medium text-background">Now available</span>
                    <span class="text-background/40">&middot;</span>
                    <span class="text-background/40">Performance analyzer v3</span>
                </a>
            </div>

            <h1 class="text-4xl font-bold tracking-tight text-background sm:text-5xl">
                From slow to blazing fast
            </h1>
            <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-background/60">
                Drag the handle to see the transformation. Our optimizer rewrites your code for peak
                performance automatically.
            </p>

            <div class="mt-6 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
                <ButtonCn Class="w-[200px] bg-background text-foreground hover:bg-background/90">
                    Start optimizing
                </ButtonCn>
                <ButtonCn Class="w-[200px] border border-background/20 bg-transparent text-background hover:bg-background/10">
                    View case studies
                </ButtonCn>
            </div>
        </div>

        @* Comparison area *@
        <div
            class="relative h-64 cursor-col-resize select-none overflow-hidden border-t bg-card md:h-72"
            @onpointerdown="HandlePointerDown"
            @onpointermove="HandlePointerMove"
            @onpointerup="HandlePointerUp"
            @onpointerleave="HandlePointerUp">

            @* After state (background) *@
            <div class="absolute inset-0 p-5 md:p-6">
                <div class="flex h-full flex-col justify-between">
                    <div>
                        <div class="mb-3 flex items-center gap-2">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            <span class="text-[10px] font-medium text-muted-foreground">Optimized</span>
                        </div>
                        <div class="space-y-1.5">
                            <div class="h-2 w-3/4 rounded-full bg-foreground/8"></div>
                            <div class="h-2 w-1/2 rounded-full bg-foreground/6"></div>
                        </div>
                        <div class="mt-4 grid grid-cols-3 gap-2">
                            <div class="rounded-md border bg-muted/30 p-2.5 text-center">
                                <p class="text-sm font-semibold tabular-nums">98%</p>
                                <p class="text-[10px] text-muted-foreground">Score</p>
                            </div>
                            <div class="rounded-md border bg-muted/30 p-2.5 text-center">
                                <p class="text-sm font-semibold tabular-nums">0.4s</p>
                                <p class="text-[10px] text-muted-foreground">Load</p>
                            </div>
                            <div class="rounded-md border bg-muted/30 p-2.5 text-center">
                                <p class="text-sm font-semibold tabular-nums">A+</p>
                                <p class="text-[10px] text-muted-foreground">Grade</p>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="h-1.5 flex-1 rounded-full bg-muted">
                            <div class="h-1.5 w-[98%] rounded-full bg-foreground/15"></div>
                        </div>
                        <span class="text-[10px] font-medium tabular-nums text-muted-foreground">98%</span>
                    </div>
                </div>
            </div>

            @* Before state (clipped overlay) *@
            <div
                class="absolute inset-0 bg-card p-5 md:p-6"
                style="@(FormattableString.Invariant($"clip-path: inset(0 {100 - _sliderPosition:F2}% 0 0)"))">
                <div class="flex h-full flex-col justify-between">
                    <div>
                        <div class="mb-3 flex items-center gap-2">
                            <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                            <span class="text-[10px] font-medium text-muted-foreground">Unoptimized</span>
                        </div>
                        <div class="space-y-1.5">
                            <div class="h-2 w-full rounded-full bg-muted-foreground/10"></div>
                            <div class="h-2 w-4/5 rounded-full bg-muted-foreground/8"></div>
                            <div class="h-2 w-3/5 rounded-full bg-muted-foreground/6"></div>
                        </div>
                        <div class="mt-4 rounded-md bg-muted/40 p-5">
                            <div class="space-y-1.5">
                                <div class="h-2 w-full rounded-full bg-muted-foreground/8"></div>
                                <div class="h-2 w-3/4 rounded-full bg-muted-foreground/6"></div>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="h-1.5 flex-1 rounded-full bg-muted">
                            <div class="h-1.5 w-[32%] rounded-full bg-muted-foreground/20"></div>
                        </div>
                        <span class="text-[10px] font-medium tabular-nums text-muted-foreground">32%</span>
                    </div>
                </div>
            </div>

            @* Slider divider *@
            <div
                class="absolute top-0 z-10 h-full w-px bg-foreground/15"
                style="@(FormattableString.Invariant($"left: {_sliderPosition:F2}%"))">
                <div class="@Cn.Merge("absolute left-1/2 top-1/2 flex size-9 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border bg-background shadow-lg transition-transform", _isDragging ? "scale-110" : null)">
                    <LucideIconCn Name="grip-vertical" Size="16" Class="size-4 text-muted-foreground" />
                </div>
            </div>

            @* Labels *@
            <div class="pointer-events-none absolute bottom-3 left-3 z-20 rounded-md bg-background/80 px-2 py-0.5 text-[10px] font-medium backdrop-blur-sm">
                Before
            </div>
            <div class="pointer-events-none absolute bottom-3 right-3 z-20 rounded-md bg-background/80 px-2 py-0.5 text-[10px] font-medium backdrop-blur-sm">
                After
            </div>
        </div>

        @* Stats bar *@
        <div class="border-t bg-muted/30 px-8 py-6">
            <div class="mx-auto grid max-w-3xl grid-cols-2 gap-6 md:grid-cols-4">
                @foreach (var stat in _stats)
                {
                    <div class="text-center">
                        <p class="text-2xl font-semibold tabular-nums">@stat.Value</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@stat.Label</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private double _sliderPosition = 50;
    private bool _isDragging = false;

    private record Stat(string Value, string Label);

    private static readonly Stat[] _stats =
    [
        new("3x", "Faster load times"),
        new("98%", "Performance score"),
        new("50%", "Smaller bundle"),
        new("24/7", "Monitoring"),
    ];

    private void HandlePointerDown(PointerEventArgs e)
    {
        _isDragging = true;
        UpdateSliderFromOffset(e.OffsetX);
    }

    private void HandlePointerMove(PointerEventArgs e)
    {
        if (!_isDragging) return;
        UpdateSliderFromOffset(e.OffsetX);
    }

    private void HandlePointerUp(PointerEventArgs e)
    {
        _isDragging = false;
    }

    private void UpdateSliderFromOffset(double offsetX)
    {
        // OffsetX is the cursor position relative to the element's left edge.
        // Without JS interop we cannot read the element's rendered width, so we use
        // a fixed 800 px estimate (reasonable for a max-w-6xl container at desktop).
        // This approximation keeps the component JS-free while still being interactive.
        const double estimatedWidth = 800.0;
        _sliderPosition = Math.Max(0, Math.Min(100, (offsetX / estimatedWidth) * 100));
    }
}
