@* ========================================
   Block: hero-contact-locations
   Title: Hero Contact Locations
   Description: Hero block with contact info cards and office locations
   Dependencies: BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-contact-locations.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="mx-auto max-w-3xl text-center">
            <BadgeCn Class="mb-6" Variant="BadgeVariant.Secondary">
                Get in touch
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                We'd love to hear from <span class="text-primary">you</span>
            </h1>

            <p class="mx-auto mb-12 max-w-2xl text-lg text-muted-foreground">
                Have questions? Our team is here to help. Reach out to any of our offices or send us a
                message directly.
            </p>
        </div>

        <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var location in _locations)
            {
                <CardCn Class="transition-shadow hover:shadow-lg">
                    <CardHeaderCn>
                        <div class="flex items-center justify-between">
                            <CardTitleCn Class="text-xl">@location.Name</CardTitleCn>
                            @if (location.Badge != null)
                            {
                                <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">@location.Badge</BadgeCn>
                            }
                        </div>
                    </CardHeaderCn>
                    <CardContentCn Class="space-y-4">
                        <div class="flex gap-3">
                            <LucideMapPinCn Size="20" Class="h-5 w-5 shrink-0 text-muted-foreground" />
                            <div class="text-sm">
                                <p>@location.Address</p>
                                <p class="text-muted-foreground">@location.City</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <LucidePhoneCn Size="20" Class="h-5 w-5 text-muted-foreground" />
                            <a class="text-sm hover:text-primary" href="tel:@(location.Phone.Replace(" ", ""))">@location.Phone</a>
                        </div>
                        <div class="flex items-center gap-3">
                            <LucideMailCn Size="20" Class="h-5 w-5 text-muted-foreground" />
                            <a class="text-sm hover:text-primary" href="mailto:@location.Email">@location.Email</a>
                        </div>
                        <div class="flex items-center gap-3">
                            <LucideClockCn Size="20" Class="h-5 w-5 text-muted-foreground" />
                            <p class="text-sm text-muted-foreground">@location.Hours</p>
                        </div>
                    </CardContentCn>
                </CardCn>
            }
        </div>

        <div class="mt-12 text-center">
            <p class="mb-4 text-muted-foreground">Prefer to send us a message?</p>
            <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                Contact Us
                <LucideArrowRightCn Size="16" Class="h-4 w-4" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Location(string Name, string? Badge, string Address, string City, string Phone, string Email, string Hours);

    private static readonly Location[] _locations =
    [
        new("San Francisco", "Headquarters", "100 Market St, Suite 300", "San Francisco, CA 94105", "+1 (415) 555-0123", "sf@company.com", "Mon-Fri: 9AM - 6PM PST"),
        new("New York", null, "350 Fifth Avenue, 21st Floor", "New York, NY 10118", "+1 (212) 555-0456", "nyc@company.com", "Mon-Fri: 9AM - 6PM EST"),
        new("London", null, "1 Canada Square, Level 25", "London E14 5AB, UK", "+44 20 7946 0958", "london@company.com", "Mon-Fri: 9AM - 6PM GMT"),
    ];
}
