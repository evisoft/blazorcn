@* ============================================================
   Block: hero-split-code-diff
   Title: HeroSplitCodeDiff
   Description: A split-layout hero with a unified code diff viewer mockup showing red removed and emerald added lines for React and Next.js featuring an announcement pill, feature checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-code-diff.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-2">

            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">

                @* Announcement pill *@
                <div class="mb-8">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">v3.0 launch</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">Now reviewing TypeScript</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Code review,<br />
                    automated
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
                    An AI reviewer that catches bugs, suggests refactors, and explains the reasoning —
                    right inside your pull request, before a human ever opens it.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[160px]">Try it free</ButtonCn>
                    <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">See an example</ButtonCn>
                </div>
            </div>

            @* Right — diff viewer mockup *@
            <div class="flex items-center p-6 lg:p-8">
                <div class="w-full overflow-hidden rounded-2xl border bg-muted/50" aria-hidden="true">

                    @* File header *@
                    <div class="flex items-center justify-between border-b bg-background/60 px-4 py-2.5">
                        <div class="flex items-center gap-2">
                            <div class="flex gap-1.5">
                                <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                                <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                                <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            </div>
                            <span class="ml-2 font-mono text-[11px] text-muted-foreground">@_fileName</span>
                        </div>
                        <div class="flex items-center gap-2 font-mono text-[10px]">
                            <span class="text-emerald-600 dark:text-emerald-500">+@_statsAdditions</span>
                            <span class="text-red-500 dark:text-red-400">−@_statsDeletions</span>
                        </div>
                    </div>

                    @* Diff body *@
                    <div class="overflow-x-auto bg-background/40 py-2 font-mono text-[11px] leading-relaxed">
                        @foreach (var line in _diffLines)
                        {
                            <div class="@Cn.Merge("flex items-start gap-3 px-4 py-0.5", line.Kind == "add" ? "bg-emerald-500/10" : "", line.Kind == "remove" ? "bg-red-500/10" : "")">
                                <span class="@Cn.Merge("w-3 select-none text-center", line.Kind == "add" ? "text-emerald-600 dark:text-emerald-500" : "", line.Kind == "remove" ? "text-red-500 dark:text-red-400" : "", line.Kind == "context" ? "text-muted-foreground/40" : "")">@_prefix[line.Kind]</span>
                                <span class="@Cn.Merge("whitespace-pre", line.Kind == "context" ? "text-muted-foreground/70" : "text-foreground/90")">@line.Text</span>
                            </div>
                        }
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private const string _fileName = "auth.ts";
    private const int _statsAdditions = 12;
    private const int _statsDeletions = 4;

    private record DiffLine(string Kind, string Text);

    private static readonly DiffLine[] _diffLines =
    [
        new("context", "export async function signIn(email: string, pw: string) {"),
        new("remove",  "  const user = await db.users.findOne({ email })"),
        new("remove",  "  if (user.password === pw) return user"),
        new("add",     "  const user = await db.users.findUnique({ where: { email } })"),
        new("add",     "  if (!user) throw new AuthError('not_found')"),
        new("add",     "  const ok = await argon2.verify(user.passwordHash, pw)"),
        new("add",     "  if (!ok) throw new AuthError('bad_password')"),
        new("add",     "  return user"),
        new("context", "}"),
    ];

    private static readonly string[] _features =
    [
        "Catches insecure patterns before they reach main",
        "Auto-fixes 80+ common refactor opportunities",
        "Reviews 5,000 lines per pull request in seconds",
    ];

    private static readonly Dictionary<string, string> _prefix = new()
    {
        ["add"] = "+",
        ["remove"] = "-",
        ["context"] = " ",
    };
}
