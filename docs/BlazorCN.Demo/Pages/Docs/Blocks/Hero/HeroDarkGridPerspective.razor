@* ============================================================
   Block: hero-dark-grid-perspective
   Title: HeroDarkGridPerspective
   Description: A dark-themed centered hero with a vanishing-point SVG perspective grid for React and Next.js featuring an announcement pill, bold headline, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-dark-grid-perspective.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-2xl border border-white/5 bg-zinc-950 px-6 py-12 text-center sm:px-10 sm:py-14 lg:py-16">
        @* Perspective grid backdrop *@
        <svg
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 h-full w-full"
            viewBox="0 0 800 500"
            preserveAspectRatio="xMidYMid slice">
            @* Radial lines emanating from the vanishing point *@
            @foreach (var tx in _radialTargets)
            {
                <line
                    x1="400"
                    y1="220"
                    x2="@tx"
                    y2="520"
                    stroke="currentColor"
                    stroke-width="1"
                    class="text-white/10" />
            }

            @* Horizon crossbars *@
            @foreach (var hl in _horizonLines)
            {
                var halfWidth = (hl.WidthPct * 800.0) / 2.0;
                var x1 = 400.0 - halfWidth;
                var x2 = 400.0 + halfWidth;
                <line
                    x1="@x1.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                    y1="@hl.Y"
                    x2="@x2.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                    y2="@hl.Y"
                    stroke="currentColor"
                    stroke-width="1"
                    class="text-white/10" />
            }

            @* Horizon line marker (subtle) *@
            <line
                x1="0"
                y1="220"
                x2="800"
                y2="220"
                stroke="currentColor"
                stroke-width="1"
                class="text-white/5" />
        </svg>

        @* Top-to-bottom fade so the grid is stronger at the bottom *@
        <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0"
            style="background:linear-gradient(to bottom, rgb(9 9 11) 0%, rgb(9 9 11 / 0.6) 40%, transparent 100%);">
        </div>

        <div class="relative z-10 flex flex-col items-center">
            @* Announcement pill *@
            <a
                href="#"
                class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/10 px-3 py-1 text-xs text-white transition-colors hover:bg-white/15">
                <span class="size-1.5 rounded-full bg-amber-400"></span>
                <span class="font-medium">Beta</span>
                <span class="text-white/40">&middot;</span>
                <span class="text-white/60">Now open to everyone</span>
                <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-white/60" />
            </a>

            @* Headline *@
            <h1 class="mt-6 text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
                The future of<br />building on the web
            </h1>

            @* Subtitle *@
            <p class="mt-5 max-w-md text-base leading-relaxed text-white/60 sm:text-lg">
                A modern toolchain for teams that care about craft. Built for performance, designed for
                clarity.
            </p>

            @* CTAs *@
            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[180px] bg-white text-zinc-950 hover:bg-white/90">Get started</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-[170px] border border-white/15 bg-transparent text-white hover:bg-white/10 hover:text-white">View pricing</ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly int[] _radialTargets =
        [-200, -120, -40, 40, 120, 200, 280, 360, 440, 520, 600, 680, 760, 840, 920, 1000];

    private record HorizonLine(int Y, double WidthPct);

    private static readonly HorizonLine[] _horizonLines =
    [
        new(500, 1.0),
        new(440, 0.82),
        new(390, 0.66),
        new(350, 0.52),
        new(318, 0.4),
        new(292, 0.3),
        new(272, 0.22),
        new(256, 0.16),
        new(244, 0.11),
        new(234, 0.07),
        new(228, 0.04),
    ];
}
