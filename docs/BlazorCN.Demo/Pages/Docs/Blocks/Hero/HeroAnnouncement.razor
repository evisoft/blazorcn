<section class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="mx-auto max-w-4xl text-center">
          @* Announcement banner *@
          <a
            class="mb-8 inline-flex items-center gap-3 rounded-full border border-primary/20 bg-primary/5 px-4 py-2 text-sm transition-colors hover:bg-primary/10"
            href="#"
          >
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary">
              <LucideSparklesCn Size="12" Class="h-3.5 w-3.5 text-primary-foreground" />
            </span>
            <span>
              <strong>New:</strong> Version 3.0 is here with AI-powered features
            </span>
            <LucideArrowRightCn Size="16" Class="h-4 w-4" />
          </a>

          <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
            The smarter way to <span class="text-primary">build products</span>
          </h1>

          <p class="mx-auto mb-10 max-w-2xl text-lg text-muted-foreground">
            Supercharge your workflow with intelligent automation, real-time collaboration, and
            powerful analytics—all in one platform.
          </p>

          @* CTA buttons *@
          <div class="mb-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
            <ButtonCn class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
              Get Started Free
              <LucideArrowRightCn Size="16" Class="h-4 w-4" />
            </ButtonCn>
            <ButtonCn class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
              See What's New
            </ButtonCn>
          </div>

          @* Secondary announcement / news items *@
          <div class="flex flex-wrap items-center justify-center gap-4 border-t pt-8">
            <div class="flex items-center gap-2 text-sm text-muted-foreground">
              <LucideMegaphoneCn Size="16" Class="h-4 w-4" />
              <span>Latest updates:</span>
            </div>
            <a class="text-sm text-primary hover:underline" href="#">
              AI Assistant Launch →
            </a>
            <a class="text-sm text-primary hover:underline" href="#">
              New Integrations →
            </a>
            <a class="text-sm text-primary hover:underline" href="#">
              Mobile App Beta →
            </a>
          </div>
        </div>
      </div>
    </section>

