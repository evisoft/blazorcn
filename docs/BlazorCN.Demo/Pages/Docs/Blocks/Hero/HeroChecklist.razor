@* ========================================
   Block: hero-checklist
   Title: Hero Checklist
   Description: Hero block with prominent checklist of benefits or features
   Dependencies: BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-checklist.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div class="flex flex-col justify-center">
                <BadgeCn Class="mb-6 w-fit gap-2" Variant="BadgeVariant.Secondary">
                    <LucideSparklesCn Size="14" Class="h-3.5 w-3.5" />
                    Everything Included
                </BadgeCn>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    One plan, <span class="text-primary">everything you need</span>
                </h1>

                <p class="mb-8 max-w-lg text-lg text-muted-foreground">
                    No complicated tiers or hidden fees. Get access to all features with our simple,
                    transparent pricing.
                </p>

                <div class="flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                        Start Free Trial
                        <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                        Compare Plans
                    </ButtonCn>
                </div>

                <p class="mt-6 text-sm text-muted-foreground">
                    Starting at <span class="font-semibold text-foreground">$29/month</span> • Cancel anytime
                </p>
            </div>

            <div class="flex items-center justify-center">
                <CardCn Class="w-full max-w-md">
                    <CardContentCn Class="p-6 sm:p-8">
                        <h2 class="mb-6 text-lg font-semibold">What's included:</h2>
                        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                            @foreach (var item in _checklistItems)
                            {
                                <li class="flex items-center gap-3">
                                    <div class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/10">
                                        <LucideCheckCn Size="12" Class="h-3 w-3 text-primary" />
                                    </div>
                                    <span class="text-sm">@item</span>
                                </li>
                            }
                        </ul>
                    </CardContentCn>
                </CardCn>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _checklistItems =
    [
        "Unlimited projects",
        "Custom domains",
        "Analytics dashboard",
        "Priority support",
        "Team collaboration",
        "API access",
        "99.9% uptime SLA",
        "SOC 2 certified",
    ];
}
