@* ============================================================
   Block: hero-split-calendar-booking
   Title: HeroSplitCalendarBooking
   Description: A split-layout hero with a calendar booking widget mockup showing month label, weekday strip, and time slot pills for React and Next.js featuring an announcement pill, feature checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-calendar-booking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-2">

            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">

                @* Announcement pill *@
                <div class="mb-8">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">New</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">Round-robin team links</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Scheduling<br />
                    without the back-and-forth
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
                    Share one link, let guests pick a time. We handle calendars, time zones, reminders,
                    and reschedules — so you stay focused on the meeting.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Get your link</ButtonCn>
                    <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">Book a demo</ButtonCn>
                </div>
            </div>

            @* Right — calendar booking widget mockup *@
            <div class="flex items-center p-6 lg:p-8">
                <div class="w-full overflow-hidden rounded-2xl border bg-muted/50" aria-hidden="true">

                    @* Widget chrome *@
                    <div class="flex items-center gap-2 border-b bg-background/60 px-4 py-2.5">
                        <div class="flex gap-1.5">
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                        </div>
                        <span class="ml-2 font-mono text-[10px] text-muted-foreground/60">
                            cal.example.com/demo
                        </span>
                    </div>

                    <div class="space-y-5 p-5 sm:p-6">

                        @* Month nav *@
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-semibold text-foreground">@_monthLabel</span>
                            <div class="flex items-center gap-1">
                                <span class="flex size-7 items-center justify-center rounded-md border bg-background text-muted-foreground">
                                    <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                                </span>
                                <span class="flex size-7 items-center justify-center rounded-md border bg-background text-muted-foreground">
                                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                                </span>
                            </div>
                        </div>

                        @* Weekday strip *@
                        <div class="grid grid-cols-5 gap-2">
                            @foreach (var day in _weekDays)
                            {
                                <div class="flex flex-col items-center gap-1.5">
                                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                        @day.Weekday
                                    </span>
                                    <span class="@Cn.Merge("flex size-9 items-center justify-center rounded-full border text-sm font-semibold tabular-nums", day.Selected ? "border-foreground bg-foreground text-background" : "border-border bg-background text-foreground/70")">
                                        @day.Date
                                    </span>
                                </div>
                            }
                        </div>

                        @* Time slot label and pills *@
                        <div class="border-t pt-4">
                            <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                Available times
                            </p>

                            <div class="mt-3 grid grid-cols-2 gap-2">
                                @foreach (var slot in _timeSlots)
                                {
                                    <span class="@Cn.Merge("flex h-9 items-center justify-center rounded-md border text-xs font-medium tabular-nums", slot.Selected ? "border-emerald-500 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400" : "border-border bg-background text-foreground/80")">
                                        @slot.Label
                                    </span>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private const string _monthLabel = "April 2026";

    private static readonly string[] _features =
    [
        "Bookings sync to Google, Outlook, and iCloud",
        "Auto-detect timezones for guests in 80+ countries",
        "Smart buffers and round-robin team scheduling",
    ];

    private record WeekDay(string Weekday, int Date, bool Selected = false);
    private record TimeSlot(string Label, bool Selected = false);

    private static readonly WeekDay[] _weekDays =
    [
        new("Mon", 13),
        new("Tue", 14),
        new("Wed", 15, true),
        new("Thu", 16),
        new("Fri", 17),
    ];

    private static readonly TimeSlot[] _timeSlots =
    [
        new("9:00 AM"),
        new("9:30 AM"),
        new("10:00 AM", true),
        new("2:00 PM"),
        new("2:30 PM"),
    ];
}
