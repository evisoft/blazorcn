@* ========================================
   Block: hero-avatar-group
   Title: Hero Avatar Group
   Description: Hero block with large avatar group and team-focused messaging
   Dependencies: AvatarCn, BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-avatar-group.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="mx-auto max-w-4xl text-center">
            <BadgeCn Class="mb-6 gap-2" Variant="BadgeVariant.Secondary">
                <LucideUsersCn Size="14" Class="h-3.5 w-3.5" />
                Meet Our Team
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                Built by a team that <span class="text-primary">cares</span>
            </h1>

            <p class="mx-auto mb-10 max-w-2xl text-lg text-muted-foreground">
                We're a passionate team of designers, engineers, and product people dedicated to helping
                you build better products faster.
            </p>

            <div class="mb-10 flex flex-col items-center justify-center gap-4">
                <div class="flex -space-x-4">
                    @foreach (var member in _teamMembers)
                    {
                        <AvatarCn Class="h-14 w-14 border-4 border-background sm:h-16 sm:w-16">
                            <AvatarImageCn Alt="@member.Name" Src="@member.Image" />
                            <AvatarFallbackCn>@member.Initials</AvatarFallbackCn>
                        </AvatarCn>
                    }
                    <div class="flex h-14 w-14 items-center justify-center rounded-full border-4 border-background bg-muted sm:h-16 sm:w-16">
                        <span class="text-sm font-semibold text-muted-foreground">+@_additionalCount</span>
                    </div>
                </div>
                <p class="text-sm text-muted-foreground">
                    @(_teamMembers.Length + _additionalCount) team members across 8 countries
                </p>
            </div>

            <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
                <ButtonCn Class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
                    Join Our Team
                    <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                </ButtonCn>
                <ButtonCn Class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                    Learn About Us
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Name, string Image, string Initials);

    private const int _additionalCount = 24;

    private static readonly TeamMember[] _teamMembers =
    [
        new("Sarah Chen", "https://i.pravatar.cc/150?img=1", "SC"),
        new("Michael Torres", "https://i.pravatar.cc/150?img=3", "MT"),
        new("Emily Watson", "https://i.pravatar.cc/150?img=5", "EW"),
        new("James Kim", "https://i.pravatar.cc/150?img=8", "JK"),
        new("Lisa Park", "https://i.pravatar.cc/150?img=9", "LP"),
        new("David Brown", "https://i.pravatar.cc/150?img=12", "DB"),
    ];
}
