@* ============================================================
   Block: hero-centered-progress-bar
   Title: HeroCenteredProgressBar
   Description: A centered hero with an animated progress bar, percentage display, and milestone markers for React and Next.js built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/hero/hero-centered-progress-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">

            @* Announcement pill *@
            <div class="mb-6 flex justify-center">
                <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium">Building in public</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">Follow our journey</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            @* Headline *@
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                We&apos;re almost there
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-lg text-lg leading-relaxed text-muted-foreground">
                A faster way to ship products is coming. Join 8,400+ early supporters who are helping
                shape what&apos;s next.
            </p>

            @* Progress section *@
            <div class="mx-auto mt-8 max-w-md">

                @* Percentage display *@
                <div class="mb-3 flex items-baseline justify-between">
                    <span class="text-sm font-medium text-muted-foreground">Progress to launch</span>
                    <span class="text-2xl font-semibold tabular-nums">@ProgressValue%</span>
                </div>

                @* Progress bar *@
                <div class="h-3 w-full overflow-hidden rounded-full bg-muted"
                     role="progressbar"
                     aria-valuenow="@ProgressValue"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    <div class="h-full rounded-full bg-foreground" style="@($"width:{ProgressValue}%")"></div>
                </div>

                @* Milestones *@
                <div class="mt-4 flex justify-between">
                    @foreach (var milestone in _milestones)
                    {
                        <div class="flex flex-col items-center gap-1">
                            <div class="@Cn.Merge("size-2 rounded-full", milestone.Reached ? "bg-foreground" : "bg-muted-foreground/25")"></div>
                            <span class="@Cn.Merge("text-[10px]", milestone.Reached ? "font-medium text-foreground" : "text-muted-foreground")">
                                @milestone.Label
                            </span>
                        </div>
                    }
                </div>
            </div>

            @* CTAs *@
            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[200px]">Get early access</ButtonCn>
                <ButtonCn Class="w-[220px]" Variant="ButtonVariant.Ghost">
                    <LucideIconCn Name="bell" Size="16" Class="size-4" /> Notify me at launch
                </ButtonCn>
            </div>

            @* Trust text *@
            <p class="mt-5 text-sm text-muted-foreground">
                No credit card required &middot; Free for early supporters
            </p>

        </div>
    </div>
</section>

@code {
    private const int ProgressValue = 73;

    private record Milestone(string Label, int Threshold, bool Reached);

    private static readonly Milestone[] _milestones =
    [
        new("Alpha",        25,  true),
        new("Private beta", 50,  true),
        new("Public beta",  75,  false),
        new("Launch",       100, false),
    ];
}
