@* ============================================================
   Block: hero-changelog
   Title: Hero Changelog
   Description: Hero block with recent changelog or updates preview
   Dependencies: BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-changelog.tsx
   ============================================================ *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div class="flex flex-col justify-center">
                <BadgeCn Class="mb-6 w-fit gap-2" Variant="BadgeVariant.Secondary">
                    <LucideBellCn Size="14" Class="h-3.5 w-3.5" />
                    Always Improving
                </BadgeCn>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    We ship <span class="text-primary">every week</span>
                </h1>

                <p class="mb-8 max-w-lg text-lg text-muted-foreground">
                    Our team is constantly improving the product based on your feedback. See what we've
                    been working on lately.
                </p>

                <div class="flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                        Get Started
                        <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                        View Full Changelog
                    </ButtonCn>
                </div>

                <p class="mt-6 text-sm text-muted-foreground">200+ updates shipped this year</p>
            </div>

            <div class="flex items-center justify-center">
                <CardCn Class="w-full max-w-md">
                    <CardContentCn Class="p-6">
                        <div class="mb-4 flex items-center justify-between">
                            <h3 class="font-semibold">Recent Updates</h3>
                            <a class="text-sm text-primary hover:underline" href="#">View all \u2192</a>
                        </div>

                        <div class="space-y-4">
                            @foreach (var update in _updates)
                            {
                                <div class="border-b pb-4 last:border-0 last:pb-0">
                                    <div class="mb-2 flex items-center justify-between">
                                        <BadgeCn Class="gap-1 text-xs" Variant="@update.BadgeVariant">
                                            @update.Label
                                        </BadgeCn>
                                        <span class="text-xs text-muted-foreground">@update.Date</span>
                                    </div>
                                    <h4 class="mb-1 font-medium">@update.Title</h4>
                                    <p class="text-sm text-muted-foreground">@update.Description</p>
                                </div>
                            }
                        </div>
                    </CardContentCn>
                </CardCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record UpdateItem(string Date, string Label, BadgeVariant BadgeVariant, string Title, string Description);

    private static readonly UpdateItem[] _updates =
    [
        new("Today", "New", BadgeVariant.Default, "AI-powered suggestions", "Get intelligent recommendations based on your workflow patterns."),
        new("2 days ago", "Improved", BadgeVariant.Secondary, "50% faster exports", "Optimized our export engine for lightning-fast file generation."),
        new("1 week ago", "Fixed", BadgeVariant.Outline, "Fixed sync issues", "Resolved edge cases causing sync delays on large workspaces."),
    ];
}
