@* ============================================================
   Block: hero-split-markdown-editor
   Title: HeroSplitMarkdownEditor
   Description: A split-layout hero with a dual-pane markdown editor mockup for React and Next.js featuring source and rendered preview panels, emerald checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-markdown-editor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">
                @* Announcement pill *@
                <div class="mb-8">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">New</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">MDX 3 components</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Write in markdown.
                    <br />
                    Publish anywhere.
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                    A distraction-free markdown editor with live preview, frontmatter, and exports that
                    drop straight into your Next.js site.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Start writing</ButtonCn>
                    <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">View docs</ButtonCn>
                </div>
            </div>

            @* Right — markdown editor mockup *@
            <div class="flex items-center p-6 lg:p-10">
                <div class="w-full overflow-hidden rounded-2xl border bg-muted/50" aria-hidden="true">
                    @* Window chrome with filename *@
                    <div class="flex items-center gap-2 border-b bg-background/60 px-4 py-2.5">
                        <div class="flex gap-1.5">
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                            <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                        </div>
                        <div class="ml-2 font-mono text-[10px] text-muted-foreground">post.md</div>
                    </div>

                    @* Two panels with thin divider *@
                    <div class="grid grid-cols-2 divide-x">
                        @* Left panel — raw markdown source *@
                        <div class="space-y-2 p-4 font-mono text-[10px] leading-relaxed text-muted-foreground/80">
                            <div class="text-muted-foreground/50">---</div>
                            <div>
                                <span class="text-muted-foreground/60">title:</span>
                                <span> Hello world</span>
                            </div>
                            <div>
                                <span class="text-muted-foreground/60">date:</span>
                                <span> 2026-04-08</span>
                            </div>
                            <div class="text-muted-foreground/50">---</div>
                            <div class="pt-1 text-foreground/80">
                                <span class="text-muted-foreground/60"># </span>Hello world
                            </div>
                            <div class="text-foreground/70">
                                A post with <span class="text-foreground/90">**bold**</span> text.
                            </div>
                            <div class="pt-1 text-foreground/70">- Ship fast</div>
                            <div class="text-foreground/70">- Write clean</div>
                            <div class="pt-1 text-muted-foreground/50">```ts</div>
                            <div class="text-foreground/70">
                                <span class="text-muted-foreground/60">const</span> x = <span class="text-muted-foreground/60">42</span>
                            </div>
                            <div class="text-muted-foreground/50">```</div>
                        </div>

                        @* Right panel — rendered preview *@
                        <div class="space-y-2 bg-background/40 p-4 text-[10px] leading-relaxed">
                            <div class="text-[13px] font-bold tracking-tight text-foreground">
                                Hello world
                            </div>
                            <div class="text-muted-foreground">
                                A post with <span class="font-semibold text-foreground">bold</span> text.
                            </div>
                            <ul class="space-y-1 pt-0.5 text-muted-foreground">
                                <li class="flex gap-1.5">
                                    <span class="text-muted-foreground/60">•</span>
                                    <span>Ship fast</span>
                                </li>
                                <li class="flex gap-1.5">
                                    <span class="text-muted-foreground/60">•</span>
                                    <span>Write clean</span>
                                </li>
                            </ul>
                            <div class="mt-1.5 rounded-md border bg-muted/60 px-2 py-1.5 font-mono text-foreground/80">
                                <span class="text-muted-foreground/70">const</span> x = <span class="text-muted-foreground/70">42</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Live preview with GitHub-flavored markdown",
        "Frontmatter support for Next.js MDX routes",
        "Export to clean, publication-ready HTML",
    ];
}
