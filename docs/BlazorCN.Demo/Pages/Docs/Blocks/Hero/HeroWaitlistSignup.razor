@* ========================================
   Block: hero-waitlist-signup
   Title: Hero Waitlist Signup
   Description: Hero with waitlist signup form, progress indicator showing spots left, and urgency messaging
   Dependencies: AvatarCn, BadgeCn, ButtonCn, InputCn, ProgressCn
   Source: original/blocks/hero/hero-waitlist-signup.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    @* Background pattern *@
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:14px_24px]"></div>

    <div class="container mx-auto px-4 py-24 md:py-32 lg:py-40">
        <div class="mx-auto max-w-2xl text-center">
            @* Urgency badge *@
            <BadgeCn Class="mb-8 gap-2 px-4 py-2" Variant="BadgeVariant.Secondary">
                <LucideSparklesCn Size="14" Class="h-3.5 w-3.5 text-yellow-500" />
                <span>Only @(_spotsTotal - _spotsTaken) spots left in our beta</span>
            </BadgeCn>

            @* Headline *@
            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                Be first to experience the future
            </h1>

            @* Subtitle *@
            <p class="mx-auto mb-10 max-w-lg text-lg text-muted-foreground">
                Join the waitlist for early access. We're launching soon and you don't want to
                miss it.
            </p>

            @* Signup form or success message *@
            @if (_isSubmitted)
            {
                <div class="mx-auto max-w-md rounded-xl border bg-card p-8 text-center">
                    <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/30">
                        <LucideSparklesCn Size="24" Class="h-6 w-6 text-green-600 dark:text-green-400" />
                    </div>
                    <h2 class="mb-2 text-xl font-semibold">You're on the list!</h2>
                    <p class="text-muted-foreground">
                        We'll notify you when it's your turn. Check your email for confirmation.
                    </p>
                </div>
            }
            else
            {
                <div class="mx-auto max-w-md">
                    <div class="flex flex-col gap-3 sm:flex-row">
                        <InputCn Class="h-12"
                                 Placeholder="Enter your email"
                                 Type="email"
                                 @bind-Value="_email" />
                        <ButtonCn Class="h-12 shrink-0" Size="ButtonSize.Lg" @onclick="HandleSubmit">
                            Join Waitlist
                        </ButtonCn>
                    </div>

                    @* Progress indicator *@
                    <div class="mt-6 space-y-2">
                        <ProgressCn Class="h-2" Value="@_progress" aria-label="Progress" />
                        <p class="text-sm text-muted-foreground">
                            <span class="font-medium text-foreground">@_spotsTaken</span> of @_spotsTotal spots claimed
                        </p>
                    </div>
                </div>
            }

            @* Social proof *@
            <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <div class="flex -space-x-2">
                    @foreach (var avatar in _recentSignups)
                    {
                        <AvatarCn Class="h-8 w-8 border-2 border-background">
                            <AvatarImageCn Alt="Recent signup" Src="@avatar.Src" />
                            <AvatarFallbackCn Class="text-xs">@avatar.Fallback</AvatarFallbackCn>
                        </AvatarCn>
                    }
                </div>
                <p class="text-sm text-muted-foreground">
                    Join @(_spotsTaken)+ others waiting for launch
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record AvatarInfo(string Src, string Fallback);

    private string _email = "";
    private bool _isSubmitted;

    private const int _spotsTotal = 1000;
    private const int _spotsTaken = 847;
    private double _progress = (double)_spotsTaken / _spotsTotal * 100;

    private static readonly AvatarInfo[] _recentSignups =
    [
        new("https://i.pravatar.cc/150?img=10", "AK"),
        new("https://i.pravatar.cc/150?img=11", "BL"),
        new("https://i.pravatar.cc/150?img=12", "CM"),
    ];

    private void HandleSubmit()
    {
        if (!string.IsNullOrEmpty(_email) && _email.Contains('@'))
        {
            _isSubmitted = true;
        }
    }
}
