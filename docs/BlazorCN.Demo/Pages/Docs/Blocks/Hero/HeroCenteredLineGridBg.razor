@* ============================================================
   Block: hero-centered-line-grid-bg
   Title: HeroCenteredLineGridBg
   Description: A centered hero with a decorative SVG diagonal cross-hatching line grid background for React and Next.js featuring an announcement pill, bold headline, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-line-grid-bg.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-2xl border bg-card">
        @* Diagonal line grid SVG background with radial fade mask *@
        <svg
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 h-full w-full text-muted-foreground/40 [mask-image:radial-gradient(ellipse_60%_70%_at_50%_40%,black,transparent)]"
            xmlns="http://www.w3.org/2000/svg">
            <defs>
                <pattern
                    id="diagonal-lines-a"
                    width="24"
                    height="24"
                    patternUnits="userSpaceOnUse"
                    patternTransform="rotate(45)">
                    <line
                        x1="0"
                        y1="0"
                        x2="0"
                        y2="24"
                        stroke="currentColor"
                        stroke-width="1"
                        stroke-opacity="0.35" />
                </pattern>
                <pattern
                    id="diagonal-lines-b"
                    width="24"
                    height="24"
                    patternUnits="userSpaceOnUse"
                    patternTransform="rotate(-45)">
                    <line
                        x1="0"
                        y1="0"
                        x2="0"
                        y2="24"
                        stroke="currentColor"
                        stroke-width="1"
                        stroke-opacity="0.35" />
                </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#diagonal-lines-a)" />
            <rect width="100%" height="100%" fill="url(#diagonal-lines-b)" />
        </svg>

        <div class="relative px-6 py-10 text-center sm:px-8 sm:py-12 lg:py-14">
            @* Announcement pill *@
            <div class="mb-6 flex justify-center">
                <a
                    href="#"
                    class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium">Launch week</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">SDK 2.0 is out</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            @* Headline *@
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                APIs that scale<br />as fast as you do
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground sm:mt-5 sm:text-lg">
                A typed, end-to-end platform for building, shipping, and scaling backend services
                without the infra overhead.
            </p>

            @* Feature checklist *@
            <ul class="mx-auto mt-6 inline-flex flex-col items-start gap-2.5">
                @foreach (var feature in _features)
                {
                    <li class="flex items-center gap-3">
                        <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                        <span class="text-sm text-foreground">@feature</span>
                    </li>
                }
            </ul>

            @* CTAs *@
            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[180px]">Start building</ButtonCn>
                <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">View docs</ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Typed end-to-end from schema to UI",
        "Auto-generated client SDKs in 12 languages",
        "Zero-config edge deployment",
    ];
}
