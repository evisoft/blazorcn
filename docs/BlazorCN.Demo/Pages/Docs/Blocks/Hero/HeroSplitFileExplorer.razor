@* ============================================================
   Block: hero-split-file-explorer
   Title: HeroSplitFileExplorer
   Description: A split-layout hero with a VS Code-style file explorer tree mockup for React and Next.js featuring a path breadcrumb, expanded folders, per-extension file icons, an active file highlight, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-file-explorer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="grid lg:grid-cols-2">

      @* Left — copy *@
      <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">

        @* Announcement pill *@
        <div class="mb-8">
          <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="font-medium">Editor 1.0</span>
            <span class="text-muted-foreground">·</span>
            <span class="text-muted-foreground">Monorepo workspaces shipped</span>
            <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
          </a>
        </div>

        @* Headline *@
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          The editor that<br />
          loves monorepos
        </h1>

        @* Subtitle *@
        <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
          A code editor built for the way modern teams actually ship — one tree, every repo, and
          fuzzy search that never slows down.
        </p>

        @* Feature checklist *@
        <ul class="mt-6 space-y-2.5">
          @foreach (var feature in _features)
          {
            <li class="flex items-center gap-3">
              <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
              <span class="text-sm text-foreground">@feature</span>
            </li>
          }
        </ul>

        @* CTAs *@
        <div class="mt-8 flex items-center gap-3">
          <ButtonCn Class="w-[180px]">Download editor</ButtonCn>
          <ButtonCn Class="w-[180px]" Variant="ButtonVariant.Ghost">Browse extensions</ButtonCn>
        </div>
      </div>

      @* Right — file explorer mockup *@
      <div class="flex items-center p-6 lg:p-8">
        <div class="w-full overflow-hidden rounded-2xl border bg-muted/50" aria-hidden="true">

          @* Breadcrumb header *@
          <div class="flex items-center justify-between border-b bg-background/60 px-4 py-2.5">
            <div class="flex items-center gap-2">
              <div class="flex gap-1.5">
                <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                <span class="size-2 rounded-full bg-muted-foreground/15"></span>
              </div>
              <span class="ml-2 font-mono text-[10px] text-muted-foreground">@_breadcrumb</span>
            </div>
            <span class="text-[10px] uppercase tracking-wider text-muted-foreground">Explorer</span>
          </div>

          @* Explorer body *@
          <div class="bg-background/40 py-2">
            @* Workspace root *@
            <div class="flex items-center gap-1.5 px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
              <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
              @_projectName
            </div>

            @* Folders *@
            @foreach (var entry in _tree)
            {
              <div>
                <div class="flex items-center gap-1.5 px-4 py-1 font-mono text-[11px] text-foreground">
                  <LucideIconCn Name="chevron-down" Size="12" Class="size-3 text-muted-foreground" />
                  <LucideIconCn Name="folder" Size="14" Class="size-3.5 text-muted-foreground" />
                  <span>@entry.Name</span>
                </div>
                @foreach (var file in entry.Children)
                {
                  var isActive = file.Name == _activeFile;
                  var iconName = _extIconName[file.Ext];
                  var iconColor = _extColor[file.Ext];
                  <div class="@Cn.Merge("relative flex items-center gap-2 py-1 pl-9 pr-3 font-mono text-[11px]", isActive ? "bg-blue-500/10 text-foreground" : "text-muted-foreground")">
                    @if (isActive)
                    {
                      <span class="absolute inset-y-0 left-0 w-0.5 bg-blue-500"></span>
                    }
                    <LucideIconCn Name="@iconName" Size="14" Class="@Cn.Merge("size-3.5 shrink-0", iconColor)" />
                    <span class="truncate">@file.Name</span>
                  </div>
                }
              </div>
            }
          </div>

          @* Footer status *@
          <div class="flex items-center justify-between border-t bg-background/60 px-4 py-2 font-mono text-[10px] text-muted-foreground">
            <span class="inline-flex items-center gap-1.5">
              <span class="size-1.5 rounded-full bg-emerald-500"></span>
              main
            </span>
            <span>9 files · 4 folders</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

@code {
  private const string _projectName = "my-app";
  private const string _breadcrumb = "my-app / src / components / Button.tsx";
  private const string _activeFile = "Button.tsx";

  private static readonly string[] _features =
  [
    "Instant fuzzy search across 10,000 files",
    "Multi-root workspaces with linked monorepos",
    "Tree sync scoped to your git branch",
  ];

  private record FileEntry(string Name, string Ext);
  private record FolderEntry(string Name, FileEntry[] Children);

  private static readonly FolderEntry[] _tree =
  [
    new("src",        [ new("index.ts", "ts"),   new("app.tsx", "tsx") ]),
    new("components", [ new("Button.tsx", "tsx"), new("Card.tsx", "tsx") ]),
    new("pages",      [ new("index.tsx", "tsx"),  new("about.tsx", "tsx") ]),
    new("lib",        [ new("utils.ts", "ts"),    new("config.json", "json"), new("README.md", "md") ]),
  ];

  // Lucide icon names per extension
  private static readonly Dictionary<string, string> _extIconName = new()
  {
    ["tsx"]  = "file-code-2",
    ["ts"]   = "file-code",
    ["json"] = "braces",
    ["md"]   = "file-text",
  };

  private static readonly Dictionary<string, string> _extColor = new()
  {
    ["tsx"]  = "text-blue-500 dark:text-blue-400",
    ["ts"]   = "text-blue-500 dark:text-blue-400",
    ["json"] = "text-amber-500 dark:text-amber-400",
    ["md"]   = "text-muted-foreground",
  };
}
