@* ============================================================
   Block: hero-centered-shimmer-headline
   Title: HeroCenteredShimmerHeadline
   Description: A centered hero with a CSS shimmer animated headline for React and Next.js featuring an announcement pill, dual ShadcnioButton CTAs, and a four-column stats footer bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-shimmer-headline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">

      @* Announcement pill *@
      <div class="mb-6 flex justify-center">
        <a
          href="#"
          class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted"
        >
          <span class="size-1.5 rounded-full bg-emerald-500"></span>
          <span class="font-medium">Just launched</span>
          <span class="text-muted-foreground">&middot;</span>
          <span class="text-muted-foreground">Platform v3.0 is here</span>
          <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
        </a>
      </div>

      @* Shimmer headline *@
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        <span>Build something</span>
        <br />
        <span
          class="inline-block bg-clip-text text-transparent"
          style="background-image:linear-gradient(110deg, hsl(var(--foreground)) 35%, hsl(var(--foreground) / 0.4) 50%, hsl(var(--foreground)) 65%);background-size:200% 100%;animation:hero-shimmer 3s ease-in-out infinite;-webkit-background-clip:text;"
        >
          extraordinary
        </span>
      </h1>

      @* Inline keyframes *@
      <style>
        @@keyframes hero-shimmer {
          0% { background-position: 200% center; }
          100% { background-position: -200% center; }
        }
      </style>

      @* Subtitle *@
      <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-muted-foreground sm:text-lg">
        The modern platform for teams who ship fast. Design, build, and deploy in a single
        workflow with zero configuration.
      </p>

      @* CTAs *@
      <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <ButtonCn Class="w-[200px]">Get started free</ButtonCn>
        <ButtonCn Class="w-[200px]" Variant="ButtonVariant.Ghost">View documentation</ButtonCn>
      </div>

      @* Social proof text *@
      <p class="mt-5 text-sm text-muted-foreground">
        No credit card required &middot; Free for small teams
      </p>
    </div>

    @* Stats bar *@
    <div class="border-t bg-muted/30 px-6 py-6 sm:px-10 sm:py-8">
      <div class="mx-auto grid max-w-3xl grid-cols-2 gap-6 md:grid-cols-4 md:gap-8">
        @foreach (var stat in _stats)
        {
          <div class="text-center">
            <p class="text-2xl font-semibold tabular-nums">@stat.Value</p>
            <p class="mt-1 text-xs text-muted-foreground">@stat.Label</p>
          </div>
        }
      </div>
    </div>
  </div>
</section>

@code {
  private record Stat(string Value, string Label);

  private static readonly Stat[] _stats =
  [
    new("50K+", "Active users"),
    new("99.9%", "Uptime"),
    new("150ms", "Avg. response"),
    new("4.9/5", "User rating"),
  ];
}
