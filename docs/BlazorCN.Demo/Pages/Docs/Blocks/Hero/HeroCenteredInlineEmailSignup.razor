@* ============================================================
   Block: hero-centered-inline-email-signup
   Title: HeroCenteredInlineEmailSignup
   Description: A centered hero with inline email signup form and avatar social proof for React and Next.js featuring an announcement pill, waitlist counter, and ShadcnioButton submit built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-inline-email-signup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="px-6 py-10 text-center sm:px-12 sm:py-12 lg:py-14">

            @* Announcement pill *@
            <div>
                <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium">Launching soon</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">Join the early access</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            @* Headline *@
            <h1 class="mx-auto mt-6 max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl">
                Stop managing work.<br />
                Start shipping it.
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-lg text-lg leading-relaxed text-muted-foreground">
                The workspace that eliminates busywork so your team can focus on what actually moves the
                needle.
            </p>

            @* Email signup form *@
            <div class="mx-auto mt-8 max-w-md">
                @if (_isSubmitted)
                {
                    <div class="rounded-lg border bg-muted/30 px-5 py-4">
                        <div class="flex items-center justify-center gap-2">
                            <LucideIconCn Name="check" Size="16" Class="size-4 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                            <span class="text-sm font-medium">You're on the list</span>
                        </div>
                        <p class="mt-1 text-xs text-muted-foreground">
                            We'll email you when early access opens.
                        </p>
                    </div>
                }
                else
                {
                    <form class="flex flex-col gap-2 sm:flex-row" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                        <InputCn
                            Type="email"
                            Placeholder="Enter your work email"
                            @bind-Value="_email"
                            required="required"
                            Disabled="@_isLoading"
                            Class="h-12 flex-1" />
                        <ButtonCn type="submit" Disabled="@_isLoading" Class="w-[180px] shrink-0">
                            @if (_isLoading)
                            {
                                <LucideIconCn Name="loader-2" Size="16" Class="size-4 animate-spin" />
                            }
                            else
                            {
                                <span>Join waitlist</span>
                            }
                        </ButtonCn>
                    </form>
                }
            </div>

            @* Social proof *@
            <div class="mt-6 flex items-center justify-center gap-3">
                <div class="flex -space-x-2" aria-hidden="true">
                    @foreach (var i in Enumerable.Range(0, 5))
                    {
                        <div class="size-8 rounded-full border-2 border-background bg-muted"></div>
                    }
                </div>
                <p class="text-sm text-muted-foreground">
                    <span class="font-semibold tabular-nums text-foreground">2,847</span> founders on
                    the waitlist
                </p>
            </div>

            @* Trust text *@
            <p class="mt-3 text-xs text-muted-foreground">
                Free during beta &middot; No credit card required
            </p>

        </div>
    </div>
</section>

@code {
    private string _email = "";
    private bool _isLoading;
    private bool _isSubmitted;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrEmpty(_email)) return;
        _isLoading = true;
        await Task.Delay(1500);
        _isLoading = false;
        _isSubmitted = true;
    }
}
