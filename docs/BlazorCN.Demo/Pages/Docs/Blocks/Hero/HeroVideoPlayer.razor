@* ========================================
   Block: hero-video-player
   Title: Hero Video Player
   Description: Hero block with prominent video player and play button
   Dependencies: BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-video-player.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            @* Left content *@
            <div class="flex flex-col justify-center">
                <BadgeCn Class="mb-6 w-fit" Variant="BadgeVariant.Secondary">
                    Watch the Demo
                </BadgeCn>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    See how it works in <span class="text-primary">90 seconds</span>
                </h1>

                <p class="mb-8 max-w-lg text-lg text-muted-foreground">
                    Skip the sales pitch. Watch our quick demo to see exactly how our platform can
                    transform your workflow.
                </p>

                @* Video stats *@
                <div class="mb-8 flex flex-wrap items-center gap-6 text-sm text-muted-foreground">
                    <div class="flex items-center gap-2">
                        <LucideClockCn Size="16" Class="h-4 w-4" />
                        <span>1:30 min</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideUsersCn Size="16" Class="h-4 w-4" />
                        <span>50K+ views</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideStarCn Size="16" Class="h-4 w-4 fill-yellow-400 text-yellow-400" />
                        <span>4.9 rating</span>
                    </div>
                </div>

                <div class="flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                        Start Free Trial
                        <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                        View All Features
                    </ButtonCn>
                </div>
            </div>

            @* Right - Video player *@
            <div class="flex items-center justify-center">
                <CardCn Class="w-full overflow-hidden shadow-2xl">
                    <CardContentCn Class="p-0">
                        @* Video container *@
                        <div class="relative aspect-video cursor-pointer bg-gradient-to-br from-zinc-900 to-zinc-800">
                            @if (_isPlaying)
                            {
                                @* Playing state placeholder *@
                                <div class="absolute inset-0 flex items-center justify-center bg-black">
                                    <div class="text-center text-white">
                                        <div class="mx-auto mb-2 h-8 w-8 animate-spin rounded-full border-2 border-white/30 border-t-white"></div>
                                        <p class="text-sm text-white/60">Video would play here</p>
                                    </div>
                                </div>
                                <button type="button"
                                        aria-label="Pause video"
                                        @onclick="@(() => _isPlaying = false)"
                                        class="absolute inset-0 z-10 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring"></button>
                            }
                            else
                            {
                                @* Thumbnail placeholder *@
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <div class="absolute left-8 top-8 h-12 w-32 rounded bg-white/10"></div>
                                    <div class="absolute bottom-8 right-8 h-20 w-40 rounded-lg bg-white/5"></div>
                                    <div class="absolute left-1/4 top-1/3 h-16 w-16 rounded-full bg-primary/20"></div>
                                </div>

                                @* Play button *@
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <button type="button"
                                            aria-label="Play video"
                                            @onclick="@(() => _isPlaying = true)"
                                            class="group flex h-20 w-20 items-center justify-center rounded-full bg-primary text-primary-foreground shadow-lg transition-transform hover:scale-110">
                                        <LucidePlayCn Size="32" Class="h-8 w-8 translate-x-0.5" />
                                    </button>
                                </div>

                                @* Duration badge *@
                                <div class="absolute bottom-4 right-4">
                                    <BadgeCn Class="bg-black/60 text-white" Variant="BadgeVariant.Secondary">
                                        1:30
                                    </BadgeCn>
                                </div>
                            }
                        </div>

                        @* Video info bar *@
                        <div class="flex items-center justify-between border-t bg-muted/50 px-4 py-3">
                            <div>
                                <p class="text-sm font-medium">Product Demo</p>
                                <p class="text-xs text-muted-foreground">
                                    See the full platform walkthrough
                                </p>
                            </div>
                            <ButtonCn Class="gap-2" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                <LucidePlayCn Size="12" Class="h-3 w-3" />
                                Watch Now
                            </ButtonCn>
                        </div>
                    </CardContentCn>
                </CardCn>
            </div>
        </div>

        @* Bottom testimonial *@
        <div class="mt-16 text-center">
            <p class="text-muted-foreground italic">
                "This demo sold me in the first 30 seconds. Best product video I've ever seen."
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
                &#x2014; Sarah K., Head of Product at TechCorp
            </p>
        </div>
    </div>
</section>

@code {
    private bool _isPlaying;
}
