@* ========================================
   Block: hero-counters
   Title: Hero Counters
   Description: Hero block with live or animated social proof counters
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-counters.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="mx-auto max-w-5xl text-center">
            <BadgeCn Class="mb-6 gap-2" Variant="BadgeVariant.Secondary">
                <LucideTrendingUpCn Size="14" Class="h-3.5 w-3.5" />
                Trusted Worldwide
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                The numbers speak for <span class="text-primary">themselves</span>
            </h1>

            <p class="mx-auto mb-12 max-w-2xl text-lg text-muted-foreground">
                Join millions of users and thousands of companies who trust us to power their most
                critical workflows.
            </p>

            <div class="mb-12 grid grid-cols-2 gap-8 md:grid-cols-4">
                @foreach (var stat in _stats)
                {
                    <div class="text-center">
                        <div class="text-4xl font-bold tracking-tight text-primary sm:text-5xl">@stat.Value</div>
                        <div class="mt-2 font-medium">@stat.Label</div>
                        <div class="text-sm text-muted-foreground">@stat.Subtext</div>
                    </div>
                }
            </div>

            <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
                <ButtonCn Class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
                    Join Them Today
                    <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                </ButtonCn>
                <ButtonCn Class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                    Read Case Studies
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Stat(string Value, string Label, string Subtext);

    private static readonly Stat[] _stats =
    [
        new("10M+", "Active Users", "across 150 countries"),
        new("$2.5B", "Processed", "in transactions"),
        new("99.99%", "Uptime", "last 12 months"),
        new("4.9/5", "Rating", "from 50K+ reviews"),
    ];
}
