@* ============================================================
   Block: hero-countdown
   Title: Hero Countdown
   Description: Hero block with animated countdown timer, launch date display, and early access signup
   Dependencies: BadgeCn, ButtonCn, CardCn, InputCn
   Source: original/blocks/hero/hero-countdown.tsx
   ============================================================ *@

<section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_center,rgba(120,119,198,0.1)_0%,transparent_65%)]"></div>

    <div class="container mx-auto px-4 py-24 md:py-32 lg:py-40">
        <div class="mx-auto max-w-3xl text-center">
            <BadgeCn Class="mb-6 gap-2 px-4 py-2" Variant="BadgeVariant.Secondary">
                <LucideCalendarDaysCn Size="14" Class="h-3.5 w-3.5" />
                @_formattedDate
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                Something amazing is<br />
                <span class="text-primary">coming soon</span>
            </h1>

            <p class="mx-auto mb-12 max-w-xl text-lg text-muted-foreground">
                We're working on something special. Be the first to know when we launch and get
                exclusive early access benefits.
            </p>

            <div class="mb-12 grid grid-cols-4 gap-3 sm:gap-4 md:gap-6">
                @foreach (var unit in _timeUnits)
                {
                    <CardCn Class="border-2">
                        <CardContentCn Class="flex flex-col items-center justify-center p-4 sm:p-6">
                            <span class="text-3xl font-bold tabular-nums sm:text-4xl md:text-5xl">@unit.Value.ToString("D2")</span>
                            <span class="mt-1 text-xs font-medium uppercase tracking-wider text-muted-foreground sm:text-sm">@unit.Label</span>
                        </CardContentCn>
                    </CardCn>
                }
            </div>

            @if (_isSubscribed)
            {
                <CardCn Class="mx-auto max-w-md border-green-200 bg-green-50 dark:border-green-800 dark:bg-green-950/30">
                    <CardContentCn Class="p-6">
                        <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/50">
                            <LucideBellCn Size="20" Class="h-5 w-5 text-green-600 dark:text-green-400" />
                        </div>
                        <p class="font-semibold">You're on the list!</p>
                        <p class="text-sm text-muted-foreground">We'll notify you as soon as we launch.</p>
                    </CardContentCn>
                </CardCn>
            }
            else
            {
                <div class="mx-auto max-w-md">
                    <div class="flex flex-col gap-3 sm:flex-row">
                        <InputCn Class="h-12" Placeholder="Enter your email" Type="email" @bind-Value="_email" />
                        <ButtonCn Class="h-12 shrink-0 gap-2" Size="ButtonSize.Lg" @onclick="HandleSubmit">
                            Notify Me
                            <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                        </ButtonCn>
                    </div>
                    <p class="mt-4 text-sm text-muted-foreground">
                        Join 2,500+ others waiting for launch. No spam, promise.
                    </p>
                </div>
            }

            <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-3">
                @foreach (var feature in _features)
                {
                    <div class="text-center">
                        <h3 class="mb-1 font-semibold">@feature.Title</h3>
                        <p class="text-sm text-muted-foreground">@feature.Description</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TimeUnit(int Value, string Label);
    private record FeatureItem(string Title, string Description);

    private string _email = "";
    private bool _isSubscribed;

    private static readonly string _formattedDate = new DateTime(2025, 3, 1).ToString("dddd, MMMM d, yyyy");

    private TimeUnit[] _timeUnits =
    [
        new(42, "Days"),
        new(8, "Hours"),
        new(15, "Minutes"),
        new(30, "Seconds"),
    ];

    private static readonly FeatureItem[] _features =
    [
        new("Early Access", "Be the first to try new features"),
        new("Founder Pricing", "Lock in special launch pricing"),
        new("Priority Support", "Get help from the founding team"),
    ];

    private void HandleSubmit()
    {
        if (!string.IsNullOrEmpty(_email))
        {
            _isSubscribed = true;
        }
    }
}
