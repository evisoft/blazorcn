@* ============================================================
   Block: hero-centered-billing-toggle
   Title: HeroCenteredBillingToggle
   Description: A centered hero with a monthly/annual billing period toggle for React and Next.js featuring dynamic price transitions with AnimatePresence, emerald feature checklist, and ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-billing-toggle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">
      @* Headline *@
      <div>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          One plan, everything included
        </h1>
        <p class="mx-auto mt-4 max-w-sm text-base leading-relaxed text-muted-foreground">
          No tiers to compare. No features locked behind upgrades. Just one plan that scales
          with you.
        </p>
      </div>

      @* Billing toggle *@
      <div class="mt-8 inline-flex items-center gap-1 rounded-full border bg-muted/50 p-1">
        <button
          type="button"
          @onclick="@(() => _period = "monthly")"
          aria-pressed="@(_period == "monthly" ? "true" : "false")"
          class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _period == "monthly" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
        >
          Monthly
        </button>
        <button
          type="button"
          @onclick="@(() => _period = "annual")"
          aria-pressed="@(_period == "annual" ? "true" : "false")"
          class="@Cn.Merge("flex items-center gap-2 rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _period == "annual" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
        >
          Annual
          <span class="rounded-full bg-foreground px-1.5 py-0.5 text-[10px] font-medium text-background">
            -@_annualSavings%
          </span>
        </button>
      </div>
    </div>

    @* Plan card *@
    <div class="border-t px-6 py-8 sm:px-8 lg:px-12">
      @* Price *@
      <div class="mb-6 flex items-baseline justify-center gap-1.5">
        <span class="text-4xl font-bold tracking-tight tabular-nums sm:text-5xl">
          $@(_period == "monthly" ? _monthlyPrice : _annualPrice)
        </span>
        <span class="text-sm text-muted-foreground">/month</span>
      </div>

      @if (_period == "annual")
      {
        <p class="mb-6 text-center text-xs text-muted-foreground">
          $@(_annualPrice * 12) billed annually
        </p>
      }

      @* Features *@
      <ul class="mx-auto max-w-sm space-y-2.5">
        @foreach (var feature in _features)
        {
          <li class="flex items-start gap-3">
            <LucideIconCn Name="check" Size="16" StrokeWidth="3" Class="mt-0.5 size-4 shrink-0 text-emerald-600 dark:text-emerald-500" />
            <span class="text-sm text-foreground">@feature</span>
          </li>
        }
      </ul>

      @* CTA *@
      <div class="mt-8 flex flex-col items-center">
        <ButtonCn class="w-[200px]">Start free trial</ButtonCn>
        <p class="mt-3 text-xs text-muted-foreground">
          14-day free trial &middot; No credit card required
        </p>
      </div>
    </div>
  </div>
</section>

@code {
    private const int _monthlyPrice = 29;
    private const int _annualPrice = 24;
    private static readonly int _annualSavings = (int)Math.Round(((double)(_monthlyPrice - _annualPrice) / _monthlyPrice) * 100);

    private string _period = "monthly";

    private static readonly string[] _features =
    [
        "Unlimited projects & deployments",
        "Advanced analytics & reporting",
        "Priority support with 4-hour SLA",
        "Custom domains & SSL certificates",
        "Team collaboration with roles",
        "API access & webhook integrations",
    ];
}
