@* ========================================
   Block: hero-feature-badges
   Title: Hero Feature Badges
   Description: Hero block with split layout, feature badges, and profile avatars
   Long Description: Hero block with FAQ accordion and common questions
   Dependencies: AvatarCn, BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-feature-badges.tsx
   ======================================== *@

<section class="relative overflow-hidden">
      @* Subtle background pattern *@
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] dark:bg-[radial-gradient(#374151_1px,transparent_1px)]"></div>

      <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
          @* Left content *@
          <div class="flex flex-col justify-center">
            <BadgeCn class="mb-6 w-fit" Variant="BadgeVariant.Secondary">
              Trusted by 10,000+ teams
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
              Everything you need to <span class="text-primary">grow your business</span>
            </h1>

            <p class="mb-8 max-w-lg text-lg text-muted-foreground">
              The all-in-one platform that helps teams collaborate, ship faster, and deliver
              exceptional results. Start free, scale when ready.
            </p>

            <div class="mb-8 flex flex-col gap-3 sm:flex-row">
              <ButtonCn class="gap-2" Size="ButtonSize.Lg">
                Get Started Free
                <LucideArrowRightCn Size="16" Class="h-4 w-4" />
              </ButtonCn>
              <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                Book a Demo
              </ButtonCn>
            </div>

            @* Social proof *@
            <div class="flex items-center gap-4">
              <div class="flex -space-x-3">
                @foreach (var avatar in _AVATARS)
                {
                  <AvatarCn class="h-10 w-10 border-2 border-background">
                    <AvatarImageCn alt="User" src="@avatar.Src" />
                    <AvatarFallbackCn>@avatar.Fallback</AvatarFallbackCn>
                  </AvatarCn>
                }
              </div>
              <div class="text-sm">
                <div class="flex items-center gap-1">
                  @for (var i = 0; i < 5; i++)
                  {
                    <LucideCircleCheckCn Size="16" Class="h-4 w-4 fill-primary text-primary" />
                  }
                </div>
                <p class="text-muted-foreground">from 2,000+ reviews</p>
              </div>
            </div>
          </div>

          @* Right content - Feature grid *@
          <div class="grid grid-cols-2 gap-4">
            @foreach (var feature in _FEATURES)
            {
              <CardCn class="border-2">
                <CardContentCn class="p-6">
                  <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10">
                    <LucideZapCn Size="24" Class="h-6 w-6 text-primary" />
                  </div>
                  <h2 class="mb-1 font-semibold">@feature.Title</h2>
                  <p class="text-sm text-muted-foreground">@feature.Description</p>
                </CardContentCn>
              </CardCn>
            }
          </div>
        </div>
      </div>
    </section>

@code {
    private record AvatarData(string Src, string Fallback);
    private record FeatureData(string Title, string Description);

    private static readonly AvatarData[] _AVATARS = new[]
    {
        new AvatarData("https://i.pravatar.cc/150?img=1", "JD"),
        new AvatarData("https://i.pravatar.cc/150?img=2", "AS"),
        new AvatarData("https://i.pravatar.cc/150?img=3", "MK"),
        new AvatarData("https://i.pravatar.cc/150?img=4", "RW"),
    };

    private static readonly FeatureData[] _FEATURES = new[]
    {
        new FeatureData("Lightning Fast", "Built for speed and performance"),
        new FeatureData("Secure", "Enterprise-grade security"),
        new FeatureData("Team Ready", "Collaborate seamlessly"),
        new FeatureData("24/7 Support", "Always here to help"),
    };
}
