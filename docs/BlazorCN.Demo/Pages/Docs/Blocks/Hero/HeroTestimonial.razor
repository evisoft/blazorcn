@* ========================================
   Block: hero-testimonial
   Title: Hero Testimonial
   Description: Hero with integrated testimonial quote, avatar stack, and social proof metrics
   Long Description: Hero block with a grid of technology or integration icons
   Dependencies: AvatarCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-testimonial.tsx
   ======================================== *@

<section class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="mx-auto max-w-4xl text-center">
          @* Social proof header *@
          <div class="mb-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
            <div class="flex -space-x-3">
              @foreach (var avatar in _avatars)
              {
                <AvatarCn class="h-10 w-10 border-2 border-background">
                  <AvatarImageCn alt="User avatar" src="@avatar.Src" />
                  <AvatarFallbackCn>@avatar.Fallback</AvatarFallbackCn>
                </AvatarCn>
              }
            </div>
            <div class="flex items-center gap-1.5">
              <div class="flex">
                @for (var i = 0; i < 5; i++)
                {
                  <LucideStarCn Size="16" Class="h-4 w-4 fill-yellow-400 text-yellow-400" />
                }
              </div>
              <span class="text-sm text-muted-foreground">
                Loved by <strong class="text-foreground">2,000+</strong> developers
              </span>
            </div>
          </div>

          @* Headline *@
          <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
            The fastest way to build <span class="text-primary">production apps</span>
          </h1>

          @* Subtitle *@
          <p class="mx-auto mb-10 max-w-2xl text-lg text-muted-foreground sm:text-xl">
            Stop reinventing the wheel. Start with a solid foundation and ship your product in days,
            not months.
          </p>

          @* CTA buttons *@
          <div class="mb-16 flex flex-col items-center justify-center gap-4 sm:flex-row">
            <ButtonCn class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
              Start Free Trial
              <LucideArrowRightCn Size="16" Class="h-4 w-4" />
            </ButtonCn>
            <ButtonCn class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
              See How It Works
            </ButtonCn>
          </div>

          @* Featured testimonial *@
          <CardCn class="mx-auto max-w-2xl border-dashed">
            <CardContentCn class="p-6 sm:p-8">
              <blockquote class="mb-6 text-lg italic text-muted-foreground sm:text-xl">
                &ldquo;We shipped our entire product in 3 weeks using this platform. What would have
                taken months of backend work was done in days. Absolutely game-changing for our
                team.&rdquo;
              </blockquote>

              <div class="flex flex-col items-center gap-4 sm:flex-row">
                <AvatarCn class="h-12 w-12">
                  <AvatarImageCn alt="Sarah Chen" src="https://i.pravatar.cc/150?img=32" />
                  <AvatarFallbackCn>SC</AvatarFallbackCn>
                </AvatarCn>
                <div class="text-center sm:text-left">
                  <p class="font-semibold">Sarah Chen</p>
                  <p class="text-sm text-muted-foreground">
                    CTO at TechStart &#x2022; Series A Startup
                  </p>
                </div>
              </div>
            </CardContentCn>
          </CardCn>
        </div>
      </div>
    </section>

@code {
    private record AvatarData(string Src, string Fallback);

    private static readonly AvatarData[] _avatars = new[]
    {
        new AvatarData("https://i.pravatar.cc/150?img=1", "JD"),
        new AvatarData("https://i.pravatar.cc/150?img=2", "AS"),
        new AvatarData("https://i.pravatar.cc/150?img=3", "MK"),
        new AvatarData("https://i.pravatar.cc/150?img=4", "RW"),
    };
}
