@* ========================================
   Block: hero-code-snippet
   Title: Hero Code Snippet
   Description: Hero block with code snippet preview for developer tools
   Dependencies: BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-code-snippet.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div class="flex flex-col justify-center">
                <BadgeCn Class="mb-6 w-fit gap-2" Variant="BadgeVariant.Secondary">
                    <LucideTerminalCn Size="14" Class="h-3.5 w-3.5" />
                    Developer First
                </BadgeCn>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    Ship in <span class="text-primary">minutes</span>, not days
                </h1>

                <p class="mb-8 max-w-lg text-lg text-muted-foreground">
                    Our SDK is designed for developers who value simplicity. Get up and running with just
                    a few lines of code.
                </p>

                <div class="flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                        Get API Key
                        <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                        Read the Docs
                    </ButtonCn>
                </div>

                <div class="mt-8 flex items-center gap-4 text-sm text-muted-foreground">
                    <code class="rounded bg-muted px-2 py-1 font-mono text-xs">
                        npm install @@acme/sdk
                    </code>
                </div>
            </div>

            <div class="flex items-center justify-center">
                <CardCn Class="w-full max-w-lg overflow-hidden bg-zinc-950">
                    <CardContentCn Class="p-0">
                        <div class="flex items-center justify-between border-b border-zinc-800 px-4 py-3">
                            <div class="flex items-center gap-2">
                                <div class="flex gap-1.5">
                                    <div class="h-3 w-3 rounded-full bg-red-500"></div>
                                    <div class="h-3 w-3 rounded-full bg-yellow-500"></div>
                                    <div class="h-3 w-3 rounded-full bg-green-500"></div>
                                </div>
                                <span class="ml-2 text-xs text-zinc-500">index.ts</span>
                            </div>
                            <ButtonCn Class="h-8 gap-2 text-zinc-400 hover:bg-zinc-800 hover:text-zinc-100" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                @if (_copied)
                                {
                                    <LucideCheckCn Size="16" Class="h-4 w-4" />
                                    <span>Copied!</span>
                                }
                                else
                                {
                                    <LucideCopyCn Size="16" Class="h-4 w-4" />
                                    <span>Copy</span>
                                }
                            </ButtonCn>
                        </div>

                        <pre class="overflow-x-auto p-4"><code class="text-sm leading-relaxed"><span class="text-purple-400">import</span><span class="text-zinc-300"> { </span><span class="text-yellow-300">Client</span><span class="text-zinc-300"> } </span><span class="text-purple-400">from</span><span class="text-green-400"> '@@acme/sdk'</span>

<span class="text-purple-400">const</span><span class="text-zinc-300"> client = </span><span class="text-purple-400">new</span><span class="text-yellow-300"> Client</span><span class="text-zinc-300">({</span>
<span class="text-zinc-300">  apiKey: </span><span class="text-cyan-300">process</span><span class="text-zinc-300">.env.</span><span class="text-cyan-300">ACME_API_KEY</span>
<span class="text-zinc-300">})</span>

<span class="text-zinc-500">// That's it! Start making requests</span>
<span class="text-purple-400">const</span><span class="text-zinc-300"> users = </span><span class="text-purple-400">await</span><span class="text-zinc-300"> client.</span><span class="text-cyan-300">users</span><span class="text-zinc-300">.</span><span class="text-yellow-300">list</span><span class="text-zinc-300">()</span>
<span class="text-cyan-300">console</span><span class="text-zinc-300">.</span><span class="text-yellow-300">log</span><span class="text-zinc-300">(users)</span></code></pre>
                    </CardContentCn>
                </CardCn>
            </div>
        </div>
    </div>
</section>

@code {
    private bool _copied;
}
