@* ============================================================
   Block: hero-dashboard-preview
   Title: HeroDashboardPreview
   Description: A centered hero for React and Next.js with headline and CTAs above a wide browser frame mockup containing a crosshair dashboard placeholder built with ShadcnioButton and Tailwind CSS
   Source: original/blocks/hero/hero-dashboard-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        @* Text section *@
        <div class="px-6 pt-10 text-center sm:px-10 sm:pt-12 lg:pt-14">
            @* Announcement pill *@
            <div class="mb-5">
                <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium">What&apos;s new</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">Analytics v3 is here</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            @* Headline *@
            <h1 class="mx-auto max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl">
                Your entire business, one dashboard
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-muted-foreground sm:text-lg">
                Track revenue, users, and conversions in real time. Make data-driven decisions without
                the spreadsheet gymnastics.
            </p>

            @* CTAs *@
            <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[200px]">Start free trial</ButtonCn>
                <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">View live demo</ButtonCn>
            </div>

            @* Trust text *@
            <p class="mt-3 text-sm text-muted-foreground">
                Free 14-day trial &middot; No credit card required
            </p>
        </div>

        @* Browser frame mockup *@
        <div class="px-4 pb-4 pt-6 sm:px-6 sm:pb-6">
            <div class="overflow-hidden rounded-xl border bg-muted/30 shadow-sm" aria-hidden="true">
                @* Window chrome *@
                <div class="flex items-center gap-2 border-b bg-muted/50 px-4 py-2.5">
                    <div class="flex gap-1.5">
                        <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                        <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                        <span class="size-2 rounded-full bg-muted-foreground/15"></span>
                    </div>
                    <div class="ml-3 h-2 w-40 rounded-full bg-muted-foreground/[0.07]"></div>
                </div>

                @* Crosshair image placeholder *@
                <div class="flex aspect-[16/9] w-full items-center justify-center bg-muted/20">
                    <div class="relative flex items-center justify-center">
                        <div class="absolute size-32 rounded-full border border-muted-foreground/[0.06]"></div>
                        <div class="absolute size-20 rounded-full border border-muted-foreground/[0.08]"></div>
                        <div class="absolute h-px w-40 bg-muted-foreground/[0.06]"></div>
                        <div class="absolute h-40 w-px bg-muted-foreground/[0.06]"></div>
                        <div class="flex size-12 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                            <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/40" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
