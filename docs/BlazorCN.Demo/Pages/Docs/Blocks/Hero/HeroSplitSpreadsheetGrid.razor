@* ============================================================
   Block: hero-split-spreadsheet-grid
   Title: HeroSplitSpreadsheetGrid
   Description: A split-layout hero with a spreadsheet grid mockup for React and Next.js featuring a formula bar, column headers, numbered rows, an active cell with ring highlight, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-spreadsheet-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-2">

            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">

                @* Announcement pill *@
                <div class="mb-8">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-blue-500"></span>
                        <span class="font-medium">Formulas v2</span>
                        <span class="text-muted-foreground">·</span>
                        <span class="text-muted-foreground">Pivot tables are here</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Spreadsheets,<br />
                    reimagined
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                    The collaborative grid that replaces your tangle of files — formulas, pivot tables,
                    and live data sources in one place your whole team can edit.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[200px]">Start free trial</ButtonCn>
                    <ButtonCn Class="w-[160px]" Variant="ButtonVariant.Ghost">See templates</ButtonCn>
                </div>
            </div>

            @* Right — spreadsheet mockup *@
            <div class="flex items-center p-6 lg:p-8">
                <div class="w-full overflow-hidden rounded-2xl border bg-muted/50" aria-hidden="true">

                    @* Formula bar *@
                    <div class="flex items-center gap-2 border-b bg-background/60 px-3 py-2.5">
                        <span class="inline-flex size-5 items-center justify-center rounded border bg-muted/70 font-mono text-[10px] text-muted-foreground">
                            B2
                        </span>
                        <span class="h-4 w-px bg-border"></span>
                        <LucideIconCn Name="sigma" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-mono text-[11px] text-foreground">@_formula</span>
                    </div>

                    @* Grid *@
                    <div class="bg-background/40 font-mono text-[11px]">

                        @* Column headers *@
                        <div class="flex border-b bg-background/60">
                            <div class="w-8 shrink-0 border-r py-1.5 text-center text-[10px] text-muted-foreground"> </div>
                            @foreach (var col in _columns)
                            {
                                <div class="flex-1 border-r py-1.5 text-center text-[10px] text-muted-foreground last:border-r-0">
                                    @col
                                </div>
                            }
                        </div>

                        @* Rows *@
                        @foreach (var rowData in _rows)
                        {
                            var rIdx = rowData.Index;
                            var row = rowData;
                            <div class="flex border-b last:border-b-0">
                                <div class="w-8 shrink-0 border-r bg-background/60 py-1.5 text-center text-[10px] text-muted-foreground">
                                    @(rIdx + 1)
                                </div>
                                @* Col A *@
                                <div class="flex-1 border-r px-2 py-1.5 text-foreground">@row.Label</div>
                                @* Col B *@
                                <div class="relative flex-1 border-r px-2 py-1.5 text-right tabular-nums text-foreground">
                                    @row.B
                                    @if (rIdx == 1)
                                    {
                                        <span class="pointer-events-none absolute inset-0 rounded-[1px] ring-2 ring-inset ring-blue-500"></span>
                                    }
                                </div>
                                @* Col C *@
                                <div class="flex-1 border-r px-2 py-1.5 text-right tabular-nums text-muted-foreground">@row.C</div>
                                @* Col D *@
                                <div class="flex-1 px-2 py-1.5 text-right tabular-nums text-muted-foreground">@row.D</div>
                            </div>
                        }
                    </div>

                    @* Status bar *@
                    <div class="flex items-center justify-between border-t bg-background/60 px-3 py-2 font-mono text-[10px] text-muted-foreground">
                        <span class="inline-flex items-center gap-1.5">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            Synced
                        </span>
                        <span>
                            Sum: <span class="tabular-nums text-foreground">@_selectedTotal</span>
                        </span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private const string _formula = "=SUM(B2:B7)";
    private const string _selectedTotal = "122,090";

    private static readonly string[] _columns = ["A", "B", "C", "D"];

    private static readonly string[] _features =
    [
        "Real-time formulas across 50,000 cells per sheet",
        "Multiplayer cursors with conflict-free edits",
        "Import CSV, XLSX, and Google Sheets in one click",
    ];

    private record SpreadsheetRow(int Index, string Label, string B, string C, string D);

    private static readonly SpreadsheetRow[] _rows =
    [
        new(0, "Plan",      "Q1",     "Q2",     "Q3"),
        new(1, "Acme Co",   "42,800", "48,120", "51,440"),
        new(2, "Globex",    "31,200", "29,600", "34,780"),
        new(3, "Initech",   "18,450", "21,300", "22,910"),
        new(4, "Soylent",   "12,900", "15,220", "17,840"),
        new(5, "Umbrella",  "9,640",  "11,050", "12,300"),
        new(6, "Wayne Ent", "7,100",  "8,340",  "9,520"),
    ];
}
