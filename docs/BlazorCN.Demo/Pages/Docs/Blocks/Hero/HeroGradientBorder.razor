@* ============================================================
   Block: hero-gradient-border
   Title: HeroGradientBorder
   Description: A centered hero for React and Next.js with the main card wrapped in an animated CSS conic-gradient border that rotates using @property CSS animation with theme-aware color stops, built with ShadcnioButton and Tailwind CSS
   Source: original/blocks/hero/hero-gradient-border.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="text-center">
    @* Announcement pill *@
    <div class="mb-6">
      <a
        href="#"
        class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted"
      >
        <span class="size-1.5 rounded-full bg-emerald-500"></span>
        <span class="font-medium">Just shipped</span>
        <span class="text-muted-foreground">&middot;</span>
        <span class="text-muted-foreground">Platform v2.0</span>
        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
      </a>
    </div>

    @* Gradient border card *@
    <div class="gradient-border-wrapper relative rounded-xl p-[2px]">
      <div class="rounded-[11px] bg-card px-6 py-8 sm:px-10 sm:py-10 lg:py-12">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
          Build something
          <br />
          remarkable
        </h1>

        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
          The developer platform that helps you ship polished products faster. Powerful tools,
          beautiful defaults, zero configuration.
        </p>

        <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <ButtonCn Class="w-[180px]">Get started</ButtonCn>
          <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">Read the docs</ButtonCn>
        </div>

        @* Stats row *@
        <div class="mt-8 border-t pt-6">
          <div class="grid grid-cols-3 gap-4">
            @foreach (var stat in _stats)
            {
              <div class="text-center">
                <p class="text-xl font-semibold tabular-nums sm:text-2xl">@stat.Value</p>
                <p class="mt-0.5 text-xs text-muted-foreground">@stat.Label</p>
              </div>
            }
          </div>
        </div>
      </div>
    </div>

    <p class="mt-5 text-xs text-muted-foreground">
      Free for individuals &middot; Pro plans start at $19/mo
    </p>
  </div>
</section>

@* Animated gradient border styles *@
<style>
  .gradient-border-wrapper {
    background: conic-gradient(
      from var(--gradient-angle, 0deg),
      var(--primary) 0%,
      color-mix(in oklab, var(--primary) 30%, transparent) 25%,
      color-mix(in oklab, var(--primary) 8%, transparent) 50%,
      color-mix(in oklab, var(--primary) 30%, transparent) 75%,
      var(--primary) 100%
    );
    animation: rotate-gradient 4s linear infinite;
  }

  @@property --gradient-angle {
    syntax: "&lt;angle&gt;";
    initial-value: 0deg;
    inherits: false;
  }

  @@keyframes rotate-gradient {
    to {
      --gradient-angle: 360deg;
    }
  }

  @@media (prefers-reduced-motion: reduce) {
    .gradient-border-wrapper {
      animation: none;
      background: color-mix(in oklab, var(--primary) 25%, transparent);
    }
  }
</style>

@code {
  private record Stat(string Value, string Label);

  private static readonly Stat[] _stats =
  [
    new("99.99%", "Uptime SLA"),
    new("<50ms", "Avg response"),
    new("12k+", "Teams"),
  ];
}
