@* ============================================================
   Block: hero-social-proof-bar
   Title: HeroSocialProofBar
   Description: A centered hero with a three-section social proof footer bar combining an avatar stack, star rating, and trust badge for React and Next.js built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/hero/hero-social-proof-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        @* Hero content *@
        <div class="px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">
            @* Announcement pill *@
            <div class="mb-5">
                <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium">Trusted</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">Loved by 25,000+ teams</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            @* Headline *@
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                The platform teams
                <br />
                actually enjoy using
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-lg text-lg leading-relaxed text-muted-foreground">
                Stop fighting your tools. Start shipping faster with a platform designed for how
                modern teams actually work.
            </p>

            @* CTAs *@
            <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[200px]">Get started free</ButtonCn>
                <ButtonCn Class="w-[180px]" Variant="ButtonVariant.Ghost">Book a demo</ButtonCn>
            </div>
        </div>

        @* Social proof bar *@
        <div class="border-t bg-muted/30 px-6 py-5">
            <div class="mx-auto flex max-w-3xl flex-col items-center gap-5 sm:flex-row sm:justify-between">
                @* Avatar stack + count *@
                <div class="flex items-center gap-3">
                    <div class="flex -space-x-2">
                        @foreach (var i in Enumerable.Range(0, 5))
                        {
                            <div class="size-8 rounded-full border-2 border-background bg-muted"></div>
                        }
                    </div>
                    <div class="text-left">
                        <p class="text-sm font-semibold">25,000+</p>
                        <p class="text-xs text-muted-foreground">Active users</p>
                    </div>
                </div>

                @* Divider *@
                <div class="hidden h-8 w-px bg-border sm:block" aria-hidden="true"></div>

                @* Star rating *@
                <div class="flex items-center gap-2.5">
                    <div class="flex gap-0.5">
                        @foreach (var i in Enumerable.Range(0, 5))
                        {
                            <LucideIconCn Name="star" Size="16" Class="size-4 fill-foreground text-foreground" aria-hidden="true" />
                        }
                    </div>
                    <div class="text-left">
                        <p class="text-sm font-semibold">4.9/5</p>
                        <p class="text-xs text-muted-foreground">2,500+ reviews</p>
                    </div>
                </div>

                @* Divider *@
                <div class="hidden h-8 w-px bg-border sm:block" aria-hidden="true"></div>

                @* Trust badge *@
                <div class="flex items-center gap-2.5">
                    <div class="flex size-8 items-center justify-center rounded-full border bg-muted/50">
                        <LucideIconCn Name="check" Size="16" Class="size-4 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                    </div>
                    <div class="text-left">
                        <p class="text-sm font-semibold text-foreground">SOC 2 Type II</p>
                        <p class="text-xs text-muted-foreground">Verified compliant</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
