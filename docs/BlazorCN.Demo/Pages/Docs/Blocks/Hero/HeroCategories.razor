@* ========================================
   Block: hero-categories
   Title: Hero Categories
   Description: Hero block with category/use case grid for navigating to different sections
   Dependencies: BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-categories.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="mx-auto mb-12 max-w-3xl text-center">
            <BadgeCn Class="mb-6" Variant="BadgeVariant.Secondary">
                Explore by Category
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                Templates for <span class="text-primary">every industry</span>
            </h1>

            <p class="text-lg text-muted-foreground">
                Find the perfect starting point for your project. Browse our collection of
                professionally designed templates by category.
            </p>
        </div>

        <div class="mx-auto mb-12 max-w-5xl">
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                @foreach (var category in _categories)
                {
                    <CardCn Class="group cursor-pointer transition-all hover:border-primary hover:shadow-md">
                        <CardContentCn Class="p-4">
                            <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/20">
                                <span class="text-sm font-bold text-primary">@category.Icon</span>
                            </div>
                            <h3 class="mb-1 font-semibold">@category.Title</h3>
                            <p class="mb-2 text-sm text-muted-foreground">@category.Description</p>
                            <span class="text-xs text-primary">@category.Count</span>
                        </CardContentCn>
                    </CardCn>
                }
            </div>
        </div>

        <div class="text-center">
            <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
                <ButtonCn Class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
                    Browse All Templates
                    <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                </ButtonCn>
                <ButtonCn Class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                    Request Custom Design
                </ButtonCn>
            </div>

            <p class="mt-6 text-sm text-muted-foreground">
                12,000+ templates • New designs added weekly
            </p>
        </div>
    </div>
</section>

@code {
    private record Category(string Icon, string Title, string Description, string Count);

    private static readonly Category[] _categories =
    [
        new("\ud83d\udcbc", "Business", "Enterprise solutions", "2.4K templates"),
        new("\ud83c\udf93", "Education", "Learning & courses", "1.8K templates"),
        new("\u2764\ufe0f", "Healthcare", "Medical & wellness", "950 templates"),
        new("\ud83d\udecd\ufe0f", "E-commerce", "Online stores", "3.2K templates"),
        new("\ud83c\udfe0", "Real Estate", "Property listings", "780 templates"),
        new("\u2708\ufe0f", "Travel", "Booking & tourism", "1.1K templates"),
        new("\ud83c\udf74", "Restaurant", "Food & dining", "890 templates"),
        new("\ud83c\udfcb\ufe0f", "Fitness", "Gyms & wellness", "640 templates"),
    ];
}
