@* ========================================
   Block: hero-feature-cards
   Title: Hero Feature Cards
   Description: Hero with prominent feature cards, icon grid layout, and animated hover states
   Dependencies: ButtonCn, CardCn
   Source: original/blocks/hero/hero-feature-cards.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div class="flex flex-col justify-center">
                <p class="mb-4 text-sm font-medium uppercase tracking-wider text-primary">
                    Built for developers
                </p>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    Ship production-ready apps in minutes, not months
                </h1>

                <p class="mb-8 text-lg text-muted-foreground">
                    The complete backend platform with everything you need to build, deploy, and scale
                    modern applications. No infrastructure headaches.
                </p>

                <div class="flex flex-col gap-4 sm:flex-row">
                    <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                        Start Building
                        <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Ghost">
                        View Pricing
                    </ButtonCn>
                </div>

                <div class="mt-8 flex items-center gap-4 text-sm text-muted-foreground">
                    <div class="flex items-center gap-2">
                        <div class="h-2 w-2 rounded-full bg-green-500"></div>
                        Free tier available
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="h-2 w-2 rounded-full bg-green-500"></div>
                        No credit card required
                    </div>
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                @foreach (var feature in _features)
                {
                    <CardCn Class="transition-all duration-200 hover:-translate-y-1 hover:shadow-lg">
                        <CardHeaderCn Class="pb-2">
                            <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
                                <span class="text-sm font-bold text-primary">@feature.Icon</span>
                            </div>
                            <CardTitleCn Class="text-lg">@feature.Title</CardTitleCn>
                        </CardHeaderCn>
                        <CardContentCn>
                            <CardDescriptionCn Class="text-sm">@feature.Description</CardDescriptionCn>
                        </CardContentCn>
                    </CardCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record FeatureItem(string Icon, string Title, string Description);

    private static readonly FeatureItem[] _features =
    [
        new("\ud83d\uddc4\ufe0f", "Real-time Database", "Sync data across all clients instantly with built-in conflict resolution and offline support."),
        new("\ud83c\udf10", "Edge Functions", "Run serverless functions at the edge for ultra-low latency responses worldwide."),
        new("\ud83d\udee1\ufe0f", "Authentication", "Secure user auth with social logins, MFA, and fine-grained access control out of the box."),
        new("\u2699\ufe0f", "Workflows", "Automate complex processes with visual workflow builder and webhook integrations."),
    ];
}
