@* ============================================================
   Block: hero-centered-audience-tabs
   Title: HeroCenteredAudienceTabs
   Description: A centered hero with a segmented audience tab selector that swaps headline and subtitle per role for React and Next.js featuring animated cross-fade transitions, emerald checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-audience-tabs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="flex flex-col items-center px-6 py-10 text-center sm:px-8 lg:px-12 lg:py-12">

            @* Audience segmented control *@
            <div class="inline-flex items-center gap-1 rounded-full border bg-muted/50 p-1"
                 role="tablist"
                 aria-label="Select your role">
                @foreach (var audience in _audiences)
                {
                    var aud = audience;
                    var isActive = aud.Key == _activeKey;
                    <button type="button"
                            role="tab"
                            aria-selected="@isActive"
                            @onclick="@(() => _activeKey = aud.Key)"
                            class="relative rounded-full px-4 py-1.5 text-xs font-medium transition-colors">
                        @if (isActive)
                        {
                            <span class="absolute inset-0 rounded-full bg-background shadow-sm" aria-hidden="true"></span>
                        }
                        <span class="@(isActive ? "relative z-10 text-foreground" : "relative z-10 text-muted-foreground")">
                            @aud.Label
                        </span>
                    </button>
                }
            </div>

            @* Headline + subtitle region *@
            @{
                var active = _audiences.Find(a => a.Key == _activeKey) ?? _audiences[1];
            }
            <div aria-live="polite" class="w-full">
                <div>
                    <h1 class="mt-8 text-4xl font-bold tracking-tight sm:text-5xl">
                        @active.HeadlineTop
                        <br />
                        @active.HeadlineBottom
                    </h1>
                    <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                        @active.Subtitle
                    </p>

                    @* Feature checklist *@
                    <ul class="mx-auto mt-6 inline-flex flex-col items-start space-y-2.5 text-left">
                        @foreach (var feature in active.Features)
                        {
                            <li class="flex items-center gap-3">
                                <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                                <span class="text-sm text-foreground">@feature</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            @* CTA row *@
            <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-[150px]">Book a demo</ButtonCn>
            </div>

        </div>
    </div>
</section>

@code {
    private string _activeKey = "engineers";

    private record AudienceItem(
        string Key,
        string Label,
        string HeadlineTop,
        string HeadlineBottom,
        string Subtitle,
        string[] Features);

    private readonly List<AudienceItem> _audiences =
    [
        new AudienceItem(
            Key: "designers",
            Label: "Designers",
            HeadlineTop: "Design systems",
            HeadlineBottom: "that ship themselves.",
            Subtitle: "Keep tokens, components, and specs in perfect sync with the codebase. No more handoff guesswork.",
            Features:
            [
                "Figma tokens auto-sync to Tailwind",
                "Live preview of every component state",
                "One-click handoff to engineering",
            ]),
        new AudienceItem(
            Key: "engineers",
            Label: "Engineers",
            HeadlineTop: "Ship features,",
            HeadlineBottom: "not boilerplate.",
            Subtitle: "Type-safe components, zero-config theming, and a CLI that installs real source code into your repo.",
            Features:
            [
                "End-to-end TypeScript across the stack",
                "Source-first install, no hidden abstractions",
                "Tree-shakeable, framework-agnostic primitives",
            ]),
        new AudienceItem(
            Key: "product",
            Label: "Product",
            HeadlineTop: "From spec",
            HeadlineBottom: "to launch in days.",
            Subtitle: "Everything your team needs to prototype, test, and ship features without waiting on design or platform.",
            Features:
            [
                "Prototype real flows in under an hour",
                "A/B test variants without a PR",
                "Roadmap visibility from PRD to deploy",
            ]),
    ];
}
