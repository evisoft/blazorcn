@* ============================================================
   Block: hero-dark-centered
   Title: HeroDarkCentered
   Description: A dark-themed centered hero with concentric ring decoration and a light stats bar for React and Next.js featuring an announcement pill, bold headline, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-dark-centered.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        @* Dark section *@
        <div class="relative overflow-hidden bg-foreground px-8 py-14 text-center sm:py-20">
            @* Concentric ring decoration *@
            <div
                class="pointer-events-none absolute inset-0 flex items-center justify-center"
                aria-hidden="true">
                <div class="absolute size-[600px] rounded-full border border-background/[0.06]"></div>
                <div class="absolute size-[400px] rounded-full border border-background/[0.08]"></div>
                <div class="absolute size-[200px] rounded-full border border-background/[0.05]"></div>
            </div>

            <div class="relative z-10">
                @* Announcement pill *@
                <div class="mb-6 flex justify-center">
                    <a
                        href="#"
                        class="inline-flex items-center gap-2 rounded-full border border-background/20 px-3 py-1 text-xs transition-colors hover:bg-background/10">
                        <span class="size-1.5 rounded-full bg-background/60"></span>
                        <span class="font-medium text-background">Now available</span>
                        <span class="text-background/40">&middot;</span>
                        <span class="text-background/40">Creative suite v2</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-background/40" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="mx-auto max-w-2xl text-4xl font-bold tracking-tight text-background sm:text-5xl lg:text-6xl">
                    Design without<br />boundaries
                </h1>

                @* Subtitle *@
                <p class="mx-auto mt-5 max-w-lg text-lg leading-relaxed text-background/60">
                    Create stunning digital experiences with our intuitive design platform. No limits,
                    just pure creativity.
                </p>

                @* CTAs *@
                <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                    <button class="w-[180px] bg-background text-foreground hover:bg-background/90 inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-medium transition-colors">
                        Start creating
                    </button>
                    <button class="w-[180px] border border-background/20 bg-transparent text-background hover:bg-background/10 inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-medium transition-colors">
                        Watch demo
                    </button>
                </div>
            </div>
        </div>

        @* Light stats bar *@
        <div class="flex flex-wrap items-center justify-center gap-8 px-8 py-8">
            @foreach (var stat in _stats)
            {
                var isLast = stat.Label == _stats[_stats.Length - 1].Label;
                <div class="flex items-center gap-8">
                    <div class="text-center">
                        <p class="text-2xl font-semibold tabular-nums">@stat.Value</p>
                        <p class="text-xs text-muted-foreground">@stat.Label</p>
                    </div>
                    @if (!isLast)
                    {
                        <div class="hidden h-8 w-px bg-border sm:block" aria-hidden="true"></div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Stat(string Value, string Label);

    private static readonly Stat[] _stats =
    [
        new("50K+", "Active users"),
        new("99.9%", "Uptime"),
        new("24/7", "Support"),
    ];
}
