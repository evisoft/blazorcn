@* ========================================
   Block: hero-faq
   Title: Hero Faq
   Description: Hero block with FAQ accordion and common questions
   Dependencies: AccordionCn, BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-faq.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div class="flex flex-col justify-center">
                <BadgeCn Class="mb-6 w-fit gap-2" Variant="BadgeVariant.Secondary">
                    <LucideCircleQuestionMarkCn Size="14" Class="h-3.5 w-3.5" />
                    Common Questions
                </BadgeCn>

                <h2 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    Everything you need to <span class="text-primary">know</span>
                </h2>

                <p class="mb-8 max-w-lg text-lg text-muted-foreground">
                    Get answers to the most common questions about our platform. Still have questions? Our
                    team is here to help.
                </p>

                <div class="flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                        Get Started
                        <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                        Contact Support
                    </ButtonCn>
                </div>

                <div class="mt-8 flex flex-wrap gap-6 text-sm text-muted-foreground">
                    <div class="flex items-center gap-2">
                        <div class="h-2 w-2 rounded-full bg-green-500"></div>
                        14-day free trial
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="h-2 w-2 rounded-full bg-green-500"></div>
                        No credit card required
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="h-2 w-2 rounded-full bg-green-500"></div>
                        Cancel anytime
                    </div>
                </div>
            </div>

            <div class="flex flex-col justify-center">
                <AccordionCn Class="w-full">
                    @for (var i = 0; i < _faqItems.Length; i++)
                    {
                        var item = _faqItems[i];
                        <AccordionItemCn>
                            <AccordionTriggerCn Class="text-left">@item.Question</AccordionTriggerCn>
                            <AccordionContentCn Class="text-muted-foreground">@item.Answer</AccordionContentCn>
                        </AccordionItemCn>
                    }
                </AccordionCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record FaqItem(string Question, string Answer);

    private static readonly FaqItem[] _faqItems =
    [
        new("How long does it take to get started?", "You can be up and running in less than 5 minutes. Our setup wizard guides you through the process, and most users complete onboarding in a single session."),
        new("Is there a free trial available?", "Yes! We offer a 14-day free trial with full access to all features. No credit card required to start."),
        new("Can I cancel my subscription anytime?", "Absolutely. You can cancel your subscription at any time from your account settings. No questions asked, no hidden fees."),
        new("Do you offer support for teams?", "Yes, we have dedicated team plans with collaboration features, shared workspaces, and priority support. Contact us for enterprise pricing."),
        new("Is my data secure?", "Security is our top priority. We use industry-standard encryption, regular security audits, and are SOC 2 Type II certified."),
    ];
}
