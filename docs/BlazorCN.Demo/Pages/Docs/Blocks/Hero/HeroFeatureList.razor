@* ========================================
   Block: hero-feature-list
   Title: Hero Feature List
   Description: Hero block with prominent vertical feature list and icons
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-feature-list.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div class="flex flex-col justify-center">
                <BadgeCn Class="mb-6 w-fit" Variant="BadgeVariant.Secondary">
                    Why Choose Us
                </BadgeCn>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    Built for <span class="text-primary">performance</span>
                </h1>

                <p class="mb-8 max-w-lg text-lg text-muted-foreground">
                    We've obsessed over every detail so you can focus on what matters most—building great
                    products.
                </p>

                <div class="flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                        Get Started
                        <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                        See Documentation
                    </ButtonCn>
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                @foreach (var feature in _features)
                {
                    <div class="flex items-start gap-4 rounded-lg border bg-card p-4">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10">
                            <span class="text-sm font-bold text-primary">@feature.Icon</span>
                        </div>
                        <div>
                            <h2 class="font-semibold">@feature.Title</h2>
                            <p class="text-sm text-muted-foreground">@feature.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record FeatureItem(string Icon, string Title, string Description);

    private static readonly FeatureItem[] _features =
    [
        new("\u26a1", "Lightning Fast", "Sub-second response times globally"),
        new("\ud83d\udee1\ufe0f", "Enterprise Security", "SOC 2 Type II certified"),
        new("\ud83c\udf10", "Global CDN", "200+ edge locations worldwide"),
        new("\u23f0", "99.99% Uptime", "Industry-leading reliability"),
        new("\ud83d\udd12", "End-to-End Encryption", "Your data stays private"),
        new("\ud83d\udcca", "Real-Time Analytics", "Insights as they happen"),
    ];
}
