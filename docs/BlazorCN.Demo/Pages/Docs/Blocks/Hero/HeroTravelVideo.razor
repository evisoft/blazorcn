@* ========================================
   Block: hero-travel-video
   Title: Hero Travel Video
   Description: Hero with travel video background, glass card signup, and social proof elements
   Long Description: Hero block with a visual timeline showing product milestones or roadmap
   Dependencies: BadgeCn, ButtonCn, CardCn, InputCn
   Source: original/blocks/hero/hero-travel-video.tsx
   ======================================== *@

<section class="relative min-h-screen w-full overflow-hidden bg-black">
      @* Video background *@
      <video
        autoplay
        class="absolute inset-0 h-full w-full object-cover opacity-50"
        loop
        muted
      >
        <source
          src="https://cdn.pixabay.com/video/2020/05/25/40130-424930032_large.mp4"
          type="video/mp4"
        />
      </video>

      @* Gradient overlay *@
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/40"></div>

      @* Content *@
      <div class="container relative z-10 mx-auto flex min-h-screen flex-col items-center justify-center px-4 py-24">
        <div class="mx-auto max-w-4xl text-center">
          <BadgeCn class="mb-6 border-white/20 bg-white/10 text-white backdrop-blur-sm">
            <LucideStarCn Size="12" Class="mr-1.5 h-3 w-3 fill-yellow-400 text-yellow-400" />
            Now Available Worldwide
          </BadgeCn>

          <h1 class="mb-6 text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl lg:text-7xl">
            Discover the world
            <span class="bg-gradient-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent">
              together
            </span>
          </h1>

          <p class="mx-auto mb-12 max-w-2xl text-lg text-white/80 sm:text-xl">
            Plan unforgettable journeys with curated travel experiences. From hidden gems to iconic
            destinations, your adventure starts here.
          </p>

          @* Glass card with email signup *@
          <CardCn class="mx-auto max-w-md border-white/20 bg-white/10 backdrop-blur-lg">
            <CardContentCn class="p-6">
              <form class="flex flex-col gap-3 sm:flex-row">
                <InputCn
                  class="h-12 border-white/20 bg-white/10 text-white placeholder:text-white/50 focus-visible:ring-white/30"
                  Placeholder="Enter your email"
                  type="email"
                />
                <ButtonCn class="h-12 shrink-0 gap-2" Size="ButtonSize.Lg">
                  Get Started
                  <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                </ButtonCn>
              </form>
              <p class="mt-4 text-xs text-white/60">
                Join 50,000+ travelers. Start exploring today.
              </p>
            </CardContentCn>
          </CardCn>

          @* Watch demo button *@
          <div class="mt-12 flex items-center justify-center gap-4">
            <ButtonCn class="gap-2 text-white hover:bg-white/10" Size="ButtonSize.Lg" Variant="ButtonVariant.Ghost">
              <div class="flex h-10 w-10 items-center justify-center rounded-full border border-white/30 bg-white/10">
                <LucidePlayCn Size="16" Class="h-4 w-4 fill-white" />
              </div>
              Watch the Demo
            </ButtonCn>
          </div>

          @* Social proof *@
          <div class="mt-16 flex flex-wrap items-center justify-center gap-8 text-white/60">
            <div class="flex items-center gap-2">
              <div class="flex -space-x-2">
                @for (var i = 0; i < 4; i++)
                {
                  <div class="h-8 w-8 rounded-full border-2 border-black bg-gradient-to-br from-gray-300 to-gray-500"></div>
                }
              </div>
              <span class="text-sm">50K+ travelers</span>
            </div>
            <div class="flex items-center gap-1">
              @for (var i = 0; i < 5; i++)
              {
                <LucideStarCn Size="16" Class="h-4 w-4 fill-yellow-400 text-yellow-400" />
              }
              <span class="ml-1 text-sm">4.9/5 rating</span>
            </div>
          </div>
        </div>
      </div>
    </section>

@code {
}
