@* ============================================================
   Block: hero-split-social-proof-wall
   Title: HeroSplitSocialProofWall
   Description: A split-layout hero with a 3x3 grid social proof wall of mini testimonial cards for React and Next.js featuring an announcement pill, emerald feature checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-social-proof-wall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid lg:grid-cols-[1.05fr_1fr]">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">
                @* Announcement pill *@
                <div class="mb-6">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">G2 Leader</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">Spring 2026</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    The team behind
                    <br />
                    your best work
                </h1>

                @* Subtitle *@
                <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                    Join thousands of teams who have replaced the bloat with something they actually love
                    using every day.
                </p>

                @* Feature checklist *@
                <ul class="mt-6 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                    <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">Learn more</ButtonCn>
                </div>
            </div>

            @* Right — social proof wall *@
            <div class="flex items-center border-t bg-muted/40 p-5 sm:p-6 lg:border-l lg:border-t-0 lg:p-8" aria-hidden="true">
                <div class="grid w-full grid-cols-3 gap-px overflow-hidden rounded-xl border bg-border">
                    @foreach (var item in _wallTestimonialsIndexed)
                    {
                        var testimonial = item.Testimonial;
                        var isPinned = item.Index == PinnedIndex;
                        <div class="@(isPinned ? "relative flex flex-col justify-between bg-card p-3 ring-2 ring-inset ring-emerald-500/40 sm:p-4" : "flex flex-col justify-between bg-card p-3 sm:p-4")">
                            @if (isPinned)
                            {
                                <div class="mb-1.5 inline-flex items-center gap-1 self-start rounded-full bg-emerald-500/10 px-1.5 py-0.5 text-[9px] font-medium text-emerald-600 dark:text-emerald-500">
                                    <span class="size-1 rounded-full bg-emerald-500"></span>
                                    Featured
                                </div>
                            }
                            <p class="line-clamp-1 text-[11px] leading-snug text-foreground/80 sm:text-xs">
                                &ldquo;@testimonial.Snippet&rdquo;
                            </p>
                            <div class="mt-2 flex items-center gap-1.5">
                                <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium text-muted-foreground">
                                    @testimonial.Initials
                                </div>
                                <div class="min-w-0">
                                    <p class="truncate text-[10px] font-medium leading-tight">@testimonial.Name</p>
                                    <p class="truncate text-[9px] leading-tight text-muted-foreground">@testimonial.Role</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private const int PinnedIndex = 4;

    private static readonly string[] _features =
    [
        "Loved by 12,000+ engineering teams worldwide",
        "4.9 star average across verified review platforms",
        "92% of customers renew their annual subscription",
    ];

    private record WallTestimonial(string Id, string Name, string Role, string Snippet, string Initials);

    private static readonly WallTestimonial[] _wallTestimonials =
    [
        new("w1", "Sarah Chen",      "Eng Lead",   "Shipping faster than ever.",      "SC"),
        new("w2", "Marcus Rivera",   "Product",    "The UX is stunning.",              "MR"),
        new("w3", "Emily Zhao",      "CTO",        "Zero downtime migration.",         "EZ"),
        new("w4", "David Kim",       "Growth",     "Paid for itself in a month.",      "DK"),
        new("w5", "Lisa Okonkwo",    "Design Dir", "Nothing else comes close.",        "LO"),
        new("w6", "James Whitfield", "VP Eng",     "Team productive on day one.",      "JW"),
        new("w7", "Priya Nair",      "Ops Lead",   "Replaced three legacy tools.",     "PN"),
        new("w8", "Noah Bennett",    "Founder",    "Biggest launch ever, flawless.",   "NB"),
        new("w9", "Maya Okafor",     "Staff Eng",  "Support replies in minutes.",      "MO"),
    ];

    private record IndexedTestimonial(int Index, WallTestimonial Testimonial);

    private static readonly IndexedTestimonial[] _wallTestimonialsIndexed =
        _wallTestimonials.Select((t, i) => new IndexedTestimonial(i, t)).ToArray();
}
