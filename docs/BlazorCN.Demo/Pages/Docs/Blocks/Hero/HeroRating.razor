@* ============================================================
   Block: hero-rating
   Title: Hero Rating
   Description: Hero block with prominent star rating and review summary
   Long Description: Hero block with large highlighted quote from a notable figure or publication
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-rating.tsx
   ============================================================ *@

<section class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="mx-auto max-w-4xl text-center">
          @* Rating display *@
          <div class="mb-8 flex flex-col items-center justify-center gap-3">
            <div class="flex items-center gap-3">
              <div class="flex">
                @for (var i = 0; i < 5; i++)
                {
                  <LucideStarCn Size="20" Class="@($"h-5 w-5 {(i < _RATING ? "fill-yellow-400 text-yellow-400" : "fill-muted text-muted")}")" />
                }
              </div>
              <span class="text-2xl font-bold">@_RATING</span>
            </div>
            <p class="text-sm text-muted-foreground">
              Based on @_TOTAL_REVIEWS.ToString("N0") reviews
            </p>
            <div class="flex flex-wrap items-center justify-center gap-2">
              <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">
                G2 Leader 2024
              </BadgeCn>
              <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">
                Capterra Top Rated
              </BadgeCn>
              <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">
                Product Hunt #1
              </BadgeCn>
            </div>
          </div>

          <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
            The #1 rated platform for <span class="text-primary">modern teams</span>
          </h1>

          <p class="mx-auto mb-10 max-w-2xl text-lg text-muted-foreground">
            Join thousands of happy customers who trust us to power their business. See why we're
            the top-rated solution in our category.
          </p>

          @* CTA buttons *@
          <div class="mb-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
            <ButtonCn Class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
              Start Free Trial
              <LucideArrowRightCn Size="16" Class="h-4 w-4" />
            </ButtonCn>
            <ButtonCn Class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
              Read Reviews
            </ButtonCn>
          </div>

          @* Recent review snippet *@
          <div class="mx-auto max-w-md rounded-lg border bg-muted/50 p-4">
            <div class="mb-2 flex items-center justify-center gap-1">
              @for (var i = 0; i < 5; i++)
              {
                <LucideStarCn Size="16" Class="h-4 w-4 fill-yellow-400 text-yellow-400" />
              }
            </div>
            <p class="text-sm italic text-muted-foreground">
              Best tool we've ever used. Transformed our workflow completely.
            </p>
            <p class="mt-2 text-xs text-muted-foreground">
              — Sarah K., Product Manager at TechCorp
            </p>
          </div>
        </div>
      </div>
    </section>

@code {
    private const double _RATING = 4.9;
    private const int _TOTAL_REVIEWS = 2847;
}
