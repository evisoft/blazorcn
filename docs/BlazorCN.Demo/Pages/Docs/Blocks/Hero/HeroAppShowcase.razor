@* ========================================
   Block: hero-app-showcase
   Title: Hero App Showcase
   Description: Hero block with simple phone mockup and app store buttons
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-app-showcase.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div class="flex flex-col justify-center">
                <BadgeCn Class="mb-6 w-fit gap-2" Variant="BadgeVariant.Secondary">
                    <LucideStarCn Size="14" Class="h-3.5 w-3.5 fill-yellow-400 text-yellow-400" />
                    4.9 Rating on App Store
                </BadgeCn>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    Your productivity, <span class="text-primary">in your pocket</span>
                </h1>

                <p class="mb-8 max-w-lg text-lg text-muted-foreground">
                    Take control of your tasks, habits, and goals with our beautifully designed mobile
                    app. Available on iOS and Android.
                </p>

                <ul class="mb-8 grid grid-cols-2 gap-3">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-2 text-sm">
                            <LucideCheckCn Size="16" Class="h-4 w-4 text-primary" />
                            @feature
                        </li>
                    }
                </ul>

                <div class="flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="h-14 gap-3" Size="ButtonSize.Lg">
                        <svg aria-label="Apple App Store" class="h-6 w-6 fill-current" role="img" viewBox="0 0 24 24">
                            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
                        </svg>
                        <div class="text-left">
                            <div class="text-xs opacity-80">Download on the</div>
                            <div class="text-sm font-semibold">App Store</div>
                        </div>
                    </ButtonCn>
                    <ButtonCn Class="h-14 gap-3" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                        <svg aria-label="Google Play Store" class="h-6 w-6 fill-current" role="img" viewBox="0 0 24 24">
                            <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 010 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.802 8.99l-2.303 2.303-8.635-8.635z" />
                        </svg>
                        <div class="text-left">
                            <div class="text-xs opacity-80">Get it on</div>
                            <div class="text-sm font-semibold">Google Play</div>
                        </div>
                    </ButtonCn>
                </div>

                <p class="mt-6 text-sm text-muted-foreground">500,000+ downloads worldwide</p>
            </div>

            <div class="flex items-center justify-center">
                <div class="relative">
                    <div class="relative w-[280px] overflow-hidden rounded-[3rem] border-[12px] border-gray-900 bg-gray-900 shadow-2xl dark:border-gray-800 sm:w-[300px]">
                        <div class="absolute left-1/2 top-0 z-10 h-6 w-24 -translate-x-1/2 rounded-b-xl bg-gray-900 dark:bg-gray-800"></div>
                        <div class="aspect-[9/19.5] w-full overflow-hidden rounded-[2.2rem] bg-white">
                            <img alt="App screenshot" class="h-full w-full object-cover" height="800" src="https://images.unsplash.com/photo-1611162617474-5b21e879e113?auto=format&w=600&q=85" width="1200" />
                        </div>
                    </div>
                    <div class="absolute -bottom-4 left-1/2 h-4 w-32 -translate-x-1/2 rounded-full bg-black/20 blur-xl"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features = ["Offline support", "Push notifications", "Biometric login", "Dark mode"];
}
