@* ============================================================
   Block: hero-centered-uptime-rows
   Title: HeroCenteredUptimeRows
   Description: A centered hero with service uptime status rows for React and Next.js featuring an operational status banner, 30-day uptime bar charts, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-uptime-rows.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="px-6 py-8 text-center sm:px-12 sm:py-10 lg:py-12">
            @* Status banner *@
            <div class="mx-auto mb-6 inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="font-medium">All systems operational</span>
            </div>

            @* Headline *@
            <h1 class="mx-auto max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl">
                Infrastructure you can count on
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-lg text-lg leading-relaxed text-muted-foreground">
                99.99% uptime, globally distributed, and fully redundant. Your users never notice our
                infrastructure.
            </p>

            @* CTAs *@
            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[200px]">Start free trial</ButtonCn>
                <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">View SLA details</ButtonCn>
            </div>
        </div>

        @* Service status rows *@
        <div class="border-t">
            <div class="flex items-center justify-between border-b bg-muted/30 px-6 py-2.5 sm:px-8">
                <span class="text-xs font-medium text-muted-foreground">Service status</span>
                <span class="text-xs text-muted-foreground">Last 30 days</span>
            </div>

            <div class="divide-y">
                @foreach (var svc in _services)
                {
                    <div class="flex items-center gap-4 px-6 py-3 sm:px-8">
                        @* Service name + status *@
                        <div class="flex w-28 shrink-0 items-center gap-2 sm:w-36">
                            <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                            <span class="truncate text-sm font-medium">@svc.Name</span>
                        </div>

                        @* Uptime bar *@
                        <div class="flex flex-1 gap-px" aria-hidden="true">
                            @for (int i = 0; i < svc.Days.Length; i++)
                            {
                                var dayColor = _dayColors[svc.Days[i]];
                                var isFirst = i == 0;
                                var isLast = i == svc.Days.Length - 1;
                                <div class="@Cn.Merge("h-5 flex-1 rounded-[1px] opacity-80", dayColor, isFirst ? "rounded-l" : "", isLast ? "rounded-r" : "")"></div>
                            }
                        </div>

                        @* Status label *@
                        <span class="hidden w-24 text-right text-xs text-muted-foreground sm:block">
                            @_statusLabels[svc.Status]
                        </span>

                        @* Uptime pct *@
                        <span class="w-16 text-right text-xs tabular-nums text-muted-foreground">
                            @svc.Uptime
                        </span>
                    </div>
                }
            </div>

            @* Footer *@
            <div class="flex items-center justify-between border-t bg-muted/30 px-6 py-2.5 sm:px-8">
                <span class="text-xs text-muted-foreground">No incidents in the last 30 days</span>
                <a href="#" class="text-xs font-medium text-foreground hover:underline">View full status page</a>
            </div>
        </div>
    </div>
</section>

@code {
    private record Service(string Name, string Status, string Uptime, int[] Days);

    private static readonly string[] _dayColors = ["bg-red-500", "bg-amber-500", "bg-emerald-500"];

    private static readonly Dictionary<string, string> _statusLabels = new()
    {
        ["operational"] = "Operational",
        ["degraded"] = "Degraded",
        ["down"] = "Down",
    };

    private static readonly Service[] _services =
    [
        new("API", "operational", "99.99%", [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2]),
        new("Dashboard", "operational", "99.98%", [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 1, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2]),
        new("Webhooks", "operational", "99.97%", [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 1, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2]),
        new("CDN", "operational", "100%", [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2]),
        new("Authentication", "operational", "99.99%", [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2]),
    ];
}
