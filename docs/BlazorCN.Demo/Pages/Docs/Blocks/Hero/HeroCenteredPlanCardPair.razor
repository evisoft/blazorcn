@* ============================================================
   Block: hero-centered-plan-card-pair
   Title: HeroCenteredPlanCardPair
   Description: A centered hero with a two-column plan card comparison grid for React and Next.js featuring Free vs Pro tiers, emerald feature checklist with CheckIcon, and ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-plan-card-pair.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">

    @* Header *@
    <div class="px-6 pt-10 pb-8 text-center sm:px-8 lg:px-12">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Simple, honest pricing</h1>
      <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
        Start free and scale when you are ready. No hidden fees, no surprises.
      </p>
    </div>

    @* Plan cards *@
    <div class="grid gap-px bg-border md:grid-cols-2">
      @foreach (var plan in _plans)
      {
        <div class="flex flex-col bg-card p-6 sm:p-8">

          @* Plan header *@
          <div class="mb-5">
            <div class="flex items-center gap-2.5">
              <h2 class="text-sm font-medium">@plan.Name</h2>
              @if (plan.Highlighted)
              {
                <span class="rounded-full border bg-muted/50 px-2 py-0.5 text-[10px] font-medium text-muted-foreground">
                  Popular
                </span>
              }
            </div>
            <p class="mt-1 text-xs text-muted-foreground">@plan.Description</p>
          </div>

          @* Price *@
          <div class="mb-6 flex items-baseline gap-1">
            <span class="text-3xl font-bold tracking-tight">@plan.Price</span>
            <span class="text-sm text-muted-foreground">@plan.Period</span>
          </div>

          @* Features *@
          <ul class="mb-8 flex-1 space-y-2.5">
            @foreach (var feature in plan.Features)
            {
              <li class="flex items-start gap-3">
                <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                <span class="text-sm text-foreground">@feature</span>
              </li>
            }
          </ul>

          @* CTA *@
          <ButtonCn class="w-full" Variant="@(plan.Highlighted ? ButtonVariant.Default : ButtonVariant.Ghost)">
            @plan.CtaLabel
          </ButtonCn>
        </div>
      }
    </div>

    @* Trust footer *@
    <div class="border-t px-6 py-4 text-center">
      <p class="text-xs text-muted-foreground">
        14-day free trial on Pro &middot; No credit card required &middot; Cancel anytime
      </p>
    </div>

  </div>
</section>

@code {
    private record Plan(string Name, string Price, string Period, string Description, string[] Features, string CtaLabel, bool Highlighted);

    private static readonly Plan[] _plans =
    [
        new Plan(
            Name: "Free",
            Price: "$0",
            Period: "/month",
            Description: "For individuals and side projects",
            Features: ["Up to 3 projects", "1 GB storage", "Community support", "Basic analytics"],
            CtaLabel: "Get started",
            Highlighted: false
        ),
        new Plan(
            Name: "Pro",
            Price: "$19",
            Period: "/month",
            Description: "For teams shipping production apps",
            Features:
            [
                "Unlimited projects",
                "100 GB storage",
                "Priority support with 4-hour SLA",
                "Advanced analytics & reports",
                "Custom domains & branding",
            ],
            CtaLabel: "Start free trial",
            Highlighted: true
        ),
    ];
}
