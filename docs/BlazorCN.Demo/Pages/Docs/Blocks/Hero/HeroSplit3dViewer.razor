@* ============================================================
   Block: hero-split-3d-viewer
   Title: HeroSplit3dViewer
   Description: A split-layout hero with a dark 3D model viewer mockup for React and Next.js featuring an isometric SVG object, rotation gizmo, emerald checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-3d-viewer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="grid lg:grid-cols-2">

      @* Left — copy *@
      <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">

        @* Announcement pill *@
        <div class="mb-8">
          <a
            href="#"
            class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted"
          >
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="font-medium">v3.0</span>
            <span class="text-muted-foreground">·</span>
            <span class="text-muted-foreground">GPU ray tracing</span>
            <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
          </a>
        </div>

        @* Headline *@
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          Design in 3D<br />
          right in your browser.
        </h1>

        @* Subtitle *@
        <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
          A collaborative 3D editor that runs on WebGL. No installs, no GPU rig — just open the
          viewport and start building.
        </p>

        @* Feature checklist *@
        <ul class="mt-6 space-y-2.5">
          @foreach (var feature in _features)
          {
            <li class="flex items-center gap-3">
              <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
              <span class="text-sm text-foreground">@feature</span>
            </li>
          }
        </ul>

        @* CTAs *@
        <div class="mt-8 flex items-center gap-3">
          <ButtonCn Class="w-[180px]">Open editor</ButtonCn>
          <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">Watch demo</ButtonCn>
        </div>

      </div>

      @* Right — 3D viewer mockup *@
      <div class="flex items-center p-6 lg:p-10">
        <div
          class="relative w-full overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-950"
          aria-hidden="true"
        >
          @* Window chrome *@
          <div class="flex items-center gap-2 border-b border-zinc-800 bg-zinc-900/60 px-4 py-2.5">
            <div class="flex gap-1.5">
              <span class="size-2 rounded-full bg-zinc-700"></span>
              <span class="size-2 rounded-full bg-zinc-700"></span>
              <span class="size-2 rounded-full bg-zinc-700"></span>
            </div>
            <div class="ml-2 font-mono text-[10px] text-zinc-500">scene.gltf</div>
          </div>

          @* Viewport *@
          <div class="relative aspect-[4/3] w-full">

            @* Faint grid *@
            <svg
              aria-hidden="true"
              class="absolute inset-0 h-full w-full text-zinc-800"
              viewBox="0 0 400 300"
              preserveAspectRatio="xMidYMid slice"
            >
              <defs>
                <pattern id="viewer-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path
                    d="M 20 0 L 0 0 0 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="0.5"
                  />
                </pattern>
              </defs>
              <rect width="100%" height="100%" fill="url(#viewer-grid)" />
            </svg>

            @* Isometric cube SVG *@
            <svg
              aria-hidden="true"
              class="absolute left-1/2 top-1/2 h-[62%] w-[62%] -translate-x-1/2 -translate-y-1/2"
              viewBox="0 0 200 200"
              preserveAspectRatio="xMidYMid meet"
            >
              @* Top face *@
              <path
                d="M 100 30 L 170 65 L 100 100 L 30 65 Z"
                fill="#3f3f46"
                stroke="#52525b"
                stroke-width="1"
                stroke-linejoin="round"
              />
              @* Right face *@
              <path
                d="M 170 65 L 170 140 L 100 175 L 100 100 Z"
                fill="#27272a"
                stroke="#52525b"
                stroke-width="1"
                stroke-linejoin="round"
              />
              @* Left face *@
              <path
                d="M 30 65 L 30 140 L 100 175 L 100 100 Z"
                fill="#18181b"
                stroke="#52525b"
                stroke-width="1"
                stroke-linejoin="round"
              />
              @* Top highlight edge *@
              <path
                d="M 100 30 L 170 65"
                stroke="#71717a"
                stroke-width="1"
                stroke-linecap="round"
              />
            </svg>

            @* Rotation gizmo — bottom right corner *@
            <div class="absolute bottom-3 right-3">
              <svg aria-hidden="true" class="size-12" viewBox="0 0 60 60">
                @* Origin dot *@
                <circle cx="30" cy="30" r="2" fill="#a1a1aa" />
                @* X axis (red) *@
                <line
                  x1="30"
                  y1="30"
                  x2="52"
                  y2="38"
                  stroke="#ef4444"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
                <polygon points="52,38 48,36 49,40" fill="#ef4444" />
                <text
                  x="54"
                  y="42"
                  font-size="7"
                  fill="#ef4444"
                  font-family="ui-monospace, monospace"
                >X</text>
                @* Y axis (green) *@
                <line
                  x1="30"
                  y1="30"
                  x2="30"
                  y2="8"
                  stroke="#22c55e"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
                <polygon points="30,8 28,12 32,12" fill="#22c55e" />
                <text
                  x="33"
                  y="10"
                  font-size="7"
                  fill="#22c55e"
                  font-family="ui-monospace, monospace"
                >Y</text>
                @* Z axis (blue) *@
                <line
                  x1="30"
                  y1="30"
                  x2="8"
                  y2="38"
                  stroke="#3b82f6"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
                <polygon points="8,38 12,36 11,40" fill="#3b82f6" />
                <text
                  x="0"
                  y="42"
                  font-size="7"
                  fill="#3b82f6"
                  font-family="ui-monospace, monospace"
                >Z</text>
              </svg>
            </div>

            @* Info panel — top left *@
            <div class="absolute left-3 top-3 rounded-md border border-zinc-800 bg-zinc-900/80 px-2.5 py-1.5 font-mono text-[10px] text-zinc-400 backdrop-blur-sm">
              <div class="flex gap-2">
                <span class="text-zinc-500">verts</span>
                <span class="text-zinc-300">1,248</span>
              </div>
              <div class="flex gap-2">
                <span class="text-zinc-500">faces</span>
                <span class="text-zinc-300">624</span>
              </div>
            </div>

            @* View control buttons — top right *@
            <div class="absolute right-3 top-3 flex gap-1">
              <div class="size-6 rounded border border-zinc-800 bg-zinc-900/80 backdrop-blur-sm"></div>
              <div class="size-6 rounded border border-zinc-800 bg-zinc-900/80 backdrop-blur-sm"></div>
              <div class="size-6 rounded border border-zinc-800 bg-zinc-900/80 backdrop-blur-sm"></div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>

@code {
  private static readonly string[] _features =
  [
    "Real-time WebGL rendering at 60 fps",
    "Import GLTF, OBJ, and FBX in one drop",
    "Collaborative scene editing with live cursors",
  ];
}
