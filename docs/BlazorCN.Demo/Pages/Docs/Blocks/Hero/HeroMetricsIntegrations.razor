@* ========================================
   Block: hero-metrics-integrations
   Title: Hero Metrics Integrations
   Description: Hero block with split layout featuring metrics and integration logos
   Dependencies: BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-metrics-integrations.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div class="flex flex-col justify-center">
                <BadgeCn Class="mb-6 w-fit" Variant="BadgeVariant.Secondary">
                    Trusted Infrastructure
                </BadgeCn>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    Built for scale, <span class="text-primary">loved by teams</span>
                </h1>

                <p class="mb-8 max-w-lg text-lg text-muted-foreground">
                    Enterprise-grade reliability meets developer-friendly simplicity. Connect with your
                    favorite tools in minutes.
                </p>

                <div class="mb-8 grid grid-cols-2 gap-4">
                    @foreach (var metric in _metrics)
                    {
                        <div class="flex items-center gap-3">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10">
                                <span class="text-sm font-bold text-primary">@metric.Icon</span>
                            </div>
                            <div>
                                <div class="text-xl font-bold">@metric.Value</div>
                                <div class="text-sm text-muted-foreground">@metric.Label</div>
                            </div>
                        </div>
                    }
                </div>

                <div class="flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                        Start Building
                        <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                        View Integrations
                    </ButtonCn>
                </div>
            </div>

            <div class="flex items-center justify-center">
                <CardCn Class="w-full max-w-md">
                    <CardContentCn Class="p-6">
                        <p class="mb-6 text-center text-sm font-medium text-muted-foreground">
                            Integrates with tools you already use
                        </p>

                        <div class="grid grid-cols-4 gap-4">
                            @foreach (var name in _integrations)
                            {
                                <div class="flex h-16 items-center justify-center rounded-lg border bg-muted/50 transition-colors hover:bg-muted">
                                    <span class="text-xs font-medium text-muted-foreground">@name</span>
                                </div>
                            }
                        </div>

                        <p class="mt-6 text-center text-sm text-muted-foreground">
                            + 100 more integrations
                        </p>

                        <ButtonCn Class="mt-4 w-full" Variant="ButtonVariant.Outline">
                            Browse All Integrations
                        </ButtonCn>
                    </CardContentCn>
                </CardCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Metric(string Icon, string Value, string Label);

    private static readonly Metric[] _metrics =
    [
        new("\ud83d\udc65", "50K+", "Active teams"),
        new("\ud83c\udf10", "120+", "Countries"),
        new("\u26a1", "99.9%", "Uptime"),
        new("\ud83d\udcc8", "10M+", "API calls/day"),
    ];

    private static readonly string[] _integrations = ["Slack", "Notion", "Figma", "GitHub", "Jira", "Linear", "Asana", "Discord"];
}
