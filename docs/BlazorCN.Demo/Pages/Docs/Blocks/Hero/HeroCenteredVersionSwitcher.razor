@* ============================================================
   Block: hero-centered-version-switcher
   Title: HeroCenteredVersionSwitcher
   Description: A centered hero with a product version switcher pill control for React and Next.js featuring AnimatePresence cross-fade headlines, a what's new changelog snippet, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-version-switcher.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card px-6 py-10 sm:px-8 lg:px-12 lg:py-12">
        <div class="flex flex-col items-center text-center">

            @* Version switcher pill tablist *@
            <div class="inline-flex items-center gap-1 rounded-full border bg-muted/50 p-1"
                 role="tablist"
                 aria-label="Product version">
                @foreach (var version in _versions)
                {
                    var ver = version;
                    var isActive = ver.Id == _activeId;
                    <button type="button"
                            role="tab"
                            aria-selected="@isActive"
                            @onclick="@(() => _activeId = ver.Id)"
                            class="@Cn.Merge("relative inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium transition-colors", isActive ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                        <span>@ver.Label</span>
                        @if (ver.IsCurrent)
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-1.5 py-0.5 text-[10px] font-medium text-emerald-600 dark:text-emerald-500">
                                <span class="size-1 rounded-full bg-emerald-500"></span>
                                New
                            </span>
                        }
                    </button>
                }
            </div>

            @* Animated headline region *@
            @{
                var active = _versions.Find(v => v.Id == _activeId) ?? _versions[2];
            }
            <div class="relative mt-8 w-full" aria-live="polite">
                <div>
                    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                        @active.Headline
                        <br />
                        <span class="text-muted-foreground">@active.Highlight</span>
                    </h1>
                    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
                        @active.Subtitle
                    </p>
                </div>
            </div>

            @* CTA row *@
            <div class="mt-8 flex items-center gap-3">
                <ButtonCn Class="w-[180px]">Get started</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-[150px]">Read docs</ButtonCn>
            </div>

            @* Changelog card *@
            <div class="mt-8 w-full">
                <div class="mx-auto max-w-md rounded-xl border bg-muted/50 p-4 text-left">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-medium">What&rsquo;s new in @active.Label</span>
                        <span class="text-[10px] uppercase tracking-wider text-muted-foreground">Changelog</span>
                    </div>
                    <ul class="mt-3 space-y-2">
                        @foreach (var entry in active.Changelog)
                        {
                            <li class="flex items-start gap-2 text-xs">
                                <LucideIconCn Name="plus" Size="12" Class="mt-0.5 size-3 shrink-0 text-emerald-600 dark:text-emerald-500" />
                                <span class="text-foreground">@entry</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private string _activeId = "v3";

    private record VersionItem(
        string Id,
        string Label,
        bool IsCurrent,
        string Headline,
        string Highlight,
        string Subtitle,
        string[] Changelog);

    private readonly List<VersionItem> _versions =
    [
        new VersionItem(
            Id: "v1",
            Label: "v1",
            IsCurrent: false,
            Headline: "A simple rules engine",
            Highlight: "for your first MVP",
            Subtitle: "The original release. A focused rules engine with YAML configuration, CLI deploys, and a handful of integrations to get teams off the ground.",
            Changelog:
            [
                "YAML-based rule authoring",
                "CLI deployment to staging",
                "Slack and email actions",
            ]),
        new VersionItem(
            Id: "v2",
            Label: "v2",
            IsCurrent: false,
            Headline: "A visual rules builder",
            Highlight: "that scales with your team",
            Subtitle: "Dragged in graph UI, versioning, and role-based access. v2 brought non-engineers into the loop and added the first audit logs for compliance teams.",
            Changelog:
            [
                "Visual drag-and-drop builder",
                "Versioned rule history with diffs",
                "Role-based access for reviewers",
            ]),
        new VersionItem(
            Id: "v3",
            Label: "v3 — Now",
            IsCurrent: true,
            Headline: "An AI-native decision platform",
            Highlight: "for ambitious product teams",
            Subtitle: "Agentic evaluations, native time-travel debugging, and SOC 2 Type II out of the box. v3 is the release we wish we had shipped three years ago.",
            Changelog:
            [
                "Agent-based rule evaluation with tracing",
                "Time-travel debugging across environments",
                "SOC 2 Type II and HIPAA ready",
            ]),
    ];
}
