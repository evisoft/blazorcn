@* ========================================
   Block: hero-before-after
   Title: Hero Before After
   Description: Hero block with before/after comparison using a slider
   Dependencies: BadgeCn, ButtonCn, CardCn, SliderCn
   Source: original/blocks/hero/hero-before-after.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div class="flex flex-col justify-center">
                <BadgeCn Class="mb-6 w-fit gap-2" Variant="BadgeVariant.Secondary">
                    <LucideArrowLeftRightCn Size="14" Class="h-3.5 w-3.5" />
                    See the Difference
                </BadgeCn>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                    Transform your workflow <span class="text-primary">instantly</span>
                </h1>

                <p class="mb-8 max-w-lg text-lg text-muted-foreground">
                    Drag the slider to see how our tool transforms messy, unorganized data into clean,
                    actionable insights in seconds.
                </p>

                <div class="flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                        Try It Free
                        <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                        Watch Demo
                    </ButtonCn>
                </div>

                <p class="mt-6 text-sm text-muted-foreground">
                    No signup required • See results in 30 seconds
                </p>
            </div>

            <div class="flex items-center justify-center">
                <CardCn Class="w-full max-w-md overflow-hidden">
                    <CardContentCn Class="p-0">
                        <div class="relative h-64 overflow-hidden">
                            <div class="absolute inset-0 bg-gradient-to-br from-primary/20 to-primary/5 p-6">
                                <div class="space-y-3">
                                    <div class="h-4 w-3/4 rounded bg-primary/30"></div>
                                    <div class="h-4 w-1/2 rounded bg-primary/30"></div>
                                    <div class="mt-6 grid grid-cols-3 gap-2">
                                        <div class="h-16 rounded-lg bg-primary/20"></div>
                                        <div class="h-16 rounded-lg bg-primary/20"></div>
                                        <div class="h-16 rounded-lg bg-primary/20"></div>
                                    </div>
                                    <div class="mt-4 h-3 w-full rounded bg-primary/20"></div>
                                    <div class="h-3 w-2/3 rounded bg-primary/20"></div>
                                </div>
                                <span class="absolute bottom-4 right-4 text-xs font-medium text-primary">After</span>
                            </div>

                            <div class="absolute inset-0 bg-muted p-6" style="clip-path: inset(0 @((100 - _sliderValue).ToString(System.Globalization.CultureInfo.InvariantCulture))% 0 0)">
                                <div class="space-y-3">
                                    <div class="h-4 w-full rounded bg-muted-foreground/20"></div>
                                    <div class="h-4 w-4/5 rounded bg-muted-foreground/20"></div>
                                    <div class="h-4 w-3/5 rounded bg-muted-foreground/20"></div>
                                    <div class="mt-6 h-20 rounded-lg bg-muted-foreground/10"></div>
                                    <div class="h-4 w-full rounded bg-muted-foreground/20"></div>
                                    <div class="h-4 w-1/2 rounded bg-muted-foreground/20"></div>
                                </div>
                                <span class="absolute bottom-4 left-4 text-xs font-medium text-muted-foreground">Before</span>
                            </div>

                            <div class="absolute top-0 h-full w-0.5 bg-primary" style="left: @(_sliderValue.ToString(System.Globalization.CultureInfo.InvariantCulture))%">
                                <div class="absolute left-1/2 top-1/2 flex h-8 w-8 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-primary text-primary-foreground shadow-lg">
                                    <LucideArrowLeftRightCn Size="16" Class="h-4 w-4" />
                                </div>
                            </div>
                        </div>

                        <div class="border-t p-4">
                            <SliderCn Class="w-full" Max="100" Step="1" Value="_sliderValue" ValueChanged="@(v => _sliderValue = v)" aria-label="Compare before and after" />
                            <p class="mt-2 text-center text-xs text-muted-foreground">
                                Drag to compare before and after
                            </p>
                        </div>
                    </CardContentCn>
                </CardCn>
            </div>
        </div>
    </div>
</section>

@code {
    private double _sliderValue = 50;
}
