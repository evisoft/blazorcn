@* ============================================================
   Block: hero-centered-crosshatch-bg
   Title: HeroCenteredCrosshatchBg
   Description: A centered hero with an editorial crosshatch SVG pattern background for React and Next.js featuring an announcement pill, bold headline, subtitle, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-crosshatch-bg.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-2xl border bg-card">
        @* Crosshatch pattern background *@
        <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0"
            style="mask-image:radial-gradient(ellipse 70% 65% at 50% 45%, transparent 10%, black 90%);-webkit-mask-image:radial-gradient(ellipse 70% 65% at 50% 45%, transparent 10%, black 90%);">
            <svg
                aria-hidden="true"
                class="h-full w-full text-foreground/[0.08]"
                width="100%"
                height="100%"
                preserveAspectRatio="xMidYMid slice">
                <defs>
                    <pattern
                        id="hero-crosshatch"
                        x="0"
                        y="0"
                        width="14"
                        height="14"
                        patternUnits="userSpaceOnUse">
                        @* Forward slashes (\) *@
                        <path
                            d="M -2 16 L 16 -2 M -2 32 L 32 -2 M 12 30 L 30 12"
                            stroke="currentColor"
                            stroke-width="1"
                            fill="none" />
                        @* Back slashes (/) *@
                        <path
                            d="M -2 -2 L 16 16 M 0 -4 L 18 14 M 12 -4 L 30 14"
                            stroke="currentColor"
                            stroke-width="1"
                            fill="none" />
                    </pattern>
                </defs>
                <rect width="100%" height="100%" fill="url(#hero-crosshatch)" />
            </svg>
        </div>

        @* Content *@
        <div class="relative z-10 px-6 py-10 text-center sm:px-8 sm:py-12 lg:px-12">
            <div>
                @* Announcement pill *@
                <div class="mb-6 flex justify-center">
                    <a
                        href="#"
                        class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Issue 24</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">Spring edition is live</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Stories worth<br />reading slowly.
                </h1>

                @* Subtitle *@
                <p class="mx-auto mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                    An independent editorial magazine for design, craft, and the people who still care
                    about the long form.
                </p>
            </div>

            @* CTAs *@
            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[180px]">Start reading</ButtonCn>
                <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">Browse archive</ButtonCn>
            </div>
        </div>
    </div>
</section>

