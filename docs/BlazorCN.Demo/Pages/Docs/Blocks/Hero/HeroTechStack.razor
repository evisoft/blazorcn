@* ========================================
   Block: hero-tech-stack
   Title: Hero Tech Stack
   Description: Hero block with a grid of technology or integration icons
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-tech-stack.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="mx-auto max-w-4xl text-center">
            <BadgeCn Class="mb-6" Variant="BadgeVariant.Secondary">
                For Developers
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                Works with your <span class="text-primary">favorite stack</span>
            </h1>

            <p class="mx-auto mb-10 max-w-2xl text-lg text-muted-foreground">
                Native integrations with the tools you already use. No plugins, no configuration&#x2014;just
                connect and go.
            </p>

            @* Tech icon grid *@
            <div class="mx-auto mb-10 grid max-w-md grid-cols-4 gap-4 sm:max-w-lg sm:gap-6">
                @foreach (var tech in _techIcons)
                {
                    <div class="flex flex-col items-center gap-2 rounded-lg border bg-card p-4 transition-colors hover:bg-muted">
                        <span class="text-2xl">@tech.Icon</span>
                        <span class="text-xs text-muted-foreground">@tech.Name</span>
                    </div>
                }
            </div>

            <p class="mb-8 text-sm text-muted-foreground">And 50+ more integrations available</p>

            <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
                <ButtonCn Class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
                    View All Integrations
                    <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                </ButtonCn>
                <ButtonCn Class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                    Read the Docs
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record TechIcon(string Icon, string Name);

    private static readonly TechIcon[] _techIcons =
    [
        new("\ud83d\udcbb", "TypeScript"),
        new("\ud83d\uddc3\ufe0f", "PostgreSQL"),
        new("\u2601\ufe0f", "AWS"),
        new("\ud83d\udda5\ufe0f", "Node.js"),
        new("\ud83c\udf10", "GraphQL"),
        new("\ud83d\udd12", "OAuth"),
        new("\ud83e\udde0", "Redis"),
        new("\ud83d\udce6", "Docker"),
    ];
}
