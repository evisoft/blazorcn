@* ========================================
   Block: hero-animated-gradient
   Title: Hero Animated Gradient
   Description: Hero block with animated gradient background, floating shapes, and modern glassmorphism card
   Long Description: Centered hero with static gradient
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-animated-gradient.tsx
   ======================================== *@

<section class="relative min-h-screen w-full overflow-hidden">
      @* Animated gradient background *@
      <div class="absolute inset-0 bg-gradient-to-br from-violet-500 via-purple-500 to-indigo-600 animate-gradient-shift"></div>

      @* Floating shapes *@
      <div class="absolute inset-0 overflow-hidden">
        <div class="absolute -top-40 -left-40 h-80 w-80 rounded-full bg-white/10 blur-3xl animate-float"></div>
        <div class="absolute top-1/4 -right-20 h-60 w-60 rounded-full bg-pink-300/20 blur-3xl animate-float-delayed"></div>
        <div class="absolute -bottom-40 left-1/3 h-96 w-96 rounded-full bg-blue-300/20 blur-3xl animate-float-slow"></div>
      </div>

      @* Overlay for better text contrast *@
      <div class="absolute inset-0 bg-black/20"></div>

      @* Content *@
      <div class="relative z-10 flex min-h-screen items-center justify-center px-4 py-20">
        <div class="w-full max-w-3xl">
          @* Glassmorphism card *@
          <div class="rounded-3xl border border-white/20 bg-white/10 p-8 backdrop-blur-xl sm:p-12 md:p-16">
            <div class="text-center">
              <BadgeCn
                class="mb-6 border-white/20 bg-white/20 text-white hover:bg-white/30"
                Variant="BadgeVariant.Secondary"
              >
                <LucideSparklesCn Size="12" Class="mr-2 h-3.5 w-3.5" />
                Now Available
              </BadgeCn>

              <h1 class="mb-6 text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
                Design without
                <br />
                <span class="bg-gradient-to-r from-white via-white/90 to-white/70 bg-clip-text text-transparent">
                  boundaries
                </span>
              </h1>

              <p class="mx-auto mb-10 max-w-xl text-lg text-white/80 sm:text-xl">
                Create stunning digital experiences with our intuitive design platform. No limits,
                just pure creativity.
              </p>

              <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
                <ButtonCn
                  class="w-full gap-2 bg-white text-purple-600 hover:bg-white/90 sm:w-auto"
                  Size="ButtonSize.Lg"
                >
                  Start Creating
                  <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                </ButtonCn>
                <ButtonCn
                  class="w-full border-white/30 bg-transparent text-white hover:bg-white/10 sm:w-auto"
                  Size="ButtonSize.Lg"
                  Variant="ButtonVariant.Outline"
                >
                  Watch Demo
                </ButtonCn>
              </div>
            </div>
          </div>

          @* Bottom stats *@
          <div class="mt-8 flex flex-wrap items-center justify-center gap-8 text-center text-white/70">
            <div>
              <p class="text-2xl font-bold text-white">50K+</p>
              <p class="text-sm">Active Users</p>
            </div>
            <div class="hidden h-8 w-px bg-white/20 sm:block"></div>
            <div>
              <p class="text-2xl font-bold text-white">99.9%</p>
              <p class="text-sm">Uptime</p>
            </div>
            <div class="hidden h-8 w-px bg-white/20 sm:block"></div>
            <div>
              <p class="text-2xl font-bold text-white">24/7</p>
              <p class="text-sm">Support</p>
            </div>
          </div>
        </div>
      </div>

      @* CSS for animations *@
      <style>
        @@keyframes gradient-shift {
          0%, 100% {
            background-position: 0% 50%;
          }
          50% {
            background-position: 100% 50%;
          }
        }

        @@keyframes float {
          0%, 100% {
            transform: translateY(0) translateX(0);
          }
          50% {
            transform: translateY(-20px) translateX(10px);
          }
        }

        .animate-gradient-shift {
          background-size: 200% 200%;
          animation: gradient-shift 15s ease infinite;
        }

        .animate-float {
          animation: float 20s ease-in-out infinite;
        }

        .animate-float-delayed {
          animation: float 25s ease-in-out infinite;
          animation-delay: -5s;
        }

        .animate-float-slow {
          animation: float 30s ease-in-out infinite;
          animation-delay: -10s;
        }

        @@media (prefers-reduced-motion: reduce) {
          .animate-gradient-shift,
          .animate-float,
          .animate-float-delayed,
          .animate-float-slow {
            animation: none;
          }
        }
      </style>
    </section>

