@* ============================================================
   Block: hero-split-phone-mockup
   Title: HeroSplitPhoneMockup
   Description: A split-layout hero with a phone frame mockup for React and Next.js featuring a dynamic island notch, crosshair placeholder, dual app store ShadcnioButton CTAs, and avatar stack social proof built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-phone-mockup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid md:grid-cols-2">
            @* Left -- copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">
                @* Announcement pill *@
                <div class="mb-5">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Now available</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">Version 3.0 is live</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
                    Your world,
                    <br />
                    in your pocket
                </h1>

                @* Subtitle *@
                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    A beautifully crafted mobile experience that puts everything you need at your
                    fingertips. Fast, intuitive, and always with you.
                </p>

                @* App store buttons *@
                <div class="mt-7 flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="w-[180px]">
                        <LucideIconCn Name="smartphone" Size="16" Class="size-4" />
                        App Store
                    </ButtonCn>
                    <ButtonCn Class="w-[180px]" Variant="ButtonVariant.Ghost">
                        <LucideIconCn Name="smartphone" Size="16" Class="size-4" />
                        Google Play
                    </ButtonCn>
                </div>

                @* Social proof *@
                <div class="mt-6 flex items-center gap-3">
                    <div class="flex -space-x-2">
                        @foreach (var i in _avatarIndices)
                        {
                            <div class="size-7 rounded-full border-2 border-background bg-muted"></div>
                        }
                    </div>
                    <p class="text-sm text-muted-foreground">
                        <span class="font-semibold text-foreground">2M+</span> downloads
                    </p>
                </div>
            </div>

            @* Right -- phone mockup *@
            <div class="flex items-center justify-center bg-muted p-8 md:p-10" aria-hidden="true">
                <div class="relative h-[440px] w-[220px] rounded-[2.5rem] border-[6px] border-foreground/90 bg-background shadow-lg">
                    @* Notch / Dynamic Island *@
                    <div class="absolute left-1/2 top-0 z-10 h-5 w-20 -translate-x-1/2 rounded-b-xl bg-foreground/90"></div>

                    @* Screen content -- crosshair placeholder *@
                    <div class="flex h-full w-full items-center justify-center overflow-hidden rounded-[2rem] bg-muted">
                        <div class="relative flex items-center justify-center">
                            <div class="absolute size-24 rounded-full border border-muted-foreground/[0.06]"></div>
                            <div class="absolute size-16 rounded-full border border-muted-foreground/[0.08]"></div>
                            <div class="absolute h-px w-32 bg-muted-foreground/[0.06]"></div>
                            <div class="absolute h-32 w-px bg-muted-foreground/[0.06]"></div>
                            <div class="flex size-10 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                                <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
                            </div>
                        </div>
                    </div>

                    @* Home indicator *@
                    <div class="absolute bottom-2 left-1/2 h-1 w-16 -translate-x-1/2 rounded-full bg-foreground/20"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly int[] _avatarIndices = [0, 1, 2, 3, 4];
}
