@* ============================================================
   Block: hero-split-video-player
   Title: HeroSplitVideoPlayer
   Description: A split-layout hero with a 16:9 video player mockup for React and Next.js featuring an announcement pill, headline, emerald feature checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-video-player.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="grid md:grid-cols-2">

      @* Left - copy *@
      <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">

        @* Announcement pill *@
        <div class="mb-5">
          <a
            href="#"
            class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted"
          >
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="font-medium">New destinations</span>
            <span class="text-muted-foreground">&middot;</span>
            <span class="text-muted-foreground">Southeast Asia 2025</span>
            <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
          </a>
        </div>

        @* Headline *@
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Discover the world,<br />
          one story at a time
        </h1>

        @* Subtitle *@
        <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
          Plan unforgettable journeys with curated travel experiences. From hidden gems to
          iconic landmarks, your next adventure starts here.
        </p>

        @* Feature checklist *@
        <ul class="mt-6 space-y-2.5">
          @foreach (var feature in _features)
          {
            <li class="flex items-center gap-3">
              <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
              <span class="text-sm text-foreground">@feature</span>
            </li>
          }
        </ul>

        @* CTAs *@
        <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row">
          <ButtonCn class="w-[170px]">Start planning</ButtonCn>
          <ButtonCn class="w-[210px]" Variant="ButtonVariant.Ghost">Browse destinations</ButtonCn>
        </div>

      </div>

      @* Right - video player mockup *@
      <div
        class="relative flex items-center justify-center bg-muted p-6 md:p-8"
        aria-hidden="true"
      >
        <div class="w-full overflow-hidden rounded-2xl border bg-card">

          @* Video canvas *@
          <div class="relative flex aspect-[16/9] w-full items-center justify-center bg-muted/50">

            @* Decorative circles *@
            <div class="absolute size-32 rounded-full border border-muted-foreground/[0.05]"></div>
            <div class="absolute size-20 rounded-full border border-muted-foreground/[0.07]"></div>

            @* Play button *@
            <div class="relative flex size-14 items-center justify-center rounded-full border border-muted-foreground/10 bg-background/80">
              <LucideIconCn Name="play" Size="20" Class="ml-0.5 size-5 text-muted-foreground/60" />
            </div>

            @* Duration badge *@
            <div class="absolute bottom-3 right-3 rounded bg-foreground/80 px-1.5 py-0.5 font-mono text-[10px] text-background">
              2:34
            </div>

          </div>

          @* Progress bar *@
          <div class="flex items-center gap-3 border-t px-4 py-2.5">
            <div class="h-1 flex-1 rounded-full bg-muted">
              <div class="h-1 w-1/3 rounded-full bg-foreground/30"></div>
            </div>
            <span class="font-mono text-[10px] text-muted-foreground">0:48 / 2:34</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

@code {
  private static readonly string[] _features =
  [
    "Curated itineraries from local experts",
    "Instant booking with flexible cancellation",
    "Offline access to guides and maps",
  ];
}
