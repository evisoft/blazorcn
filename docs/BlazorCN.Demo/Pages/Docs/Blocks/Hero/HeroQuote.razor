@* ========================================
   Block: hero-quote
   Title: Hero Quote
   Description: Hero block with large highlighted quote from a notable figure or publication
   Long Description: Hero block with progress indicators showing goals or milestones achieved
   Dependencies: AvatarCn, BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-quote.tsx
   ======================================== *@

<section class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="mx-auto max-w-4xl text-center">
          <BadgeCn class="mb-8" Variant="BadgeVariant.Secondary">
            Featured In TechCrunch
          </BadgeCn>

          @* Quote *@
          <div class="relative mb-10">
            <LucideQuoteCn Class="mx-auto mb-6 h-12 w-12 text-primary/20" />
            <blockquote class="text-2xl font-medium leading-relaxed sm:text-3xl md:text-4xl">
              "This is the <span class="text-primary">future of productivity</span>. I've never
              seen a tool that so elegantly solves such a complex problem."
            </blockquote>
          </div>

          @* Attribution *@
          <div class="mb-10 flex flex-col items-center justify-center gap-4">
            <AvatarCn class="h-16 w-16 border-2 border-primary/20">
              <AvatarImageCn alt="Sarah Johnson" src="https://i.pravatar.cc/150?img=32" />
              <AvatarFallbackCn>SJ</AvatarFallbackCn>
            </AvatarCn>
            <div>
              <div class="font-semibold">Sarah Johnson</div>
              <div class="text-sm text-muted-foreground">
                CEO at TechCorp • Former Google VP
              </div>
            </div>
          </div>

          @* Secondary quote sources *@
          <div class="mb-10 flex flex-wrap items-center justify-center gap-6 border-t border-b py-6">
            <span class="text-sm text-muted-foreground">Also featured in:</span>
            <span class="font-semibold">Forbes</span>
            <span class="font-semibold">Wired</span>
            <span class="font-semibold">The Verge</span>
            <span class="font-semibold">Product Hunt</span>
          </div>

          @* CTA buttons *@
          <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
            <ButtonCn class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
              See Why They Love Us
              <LucideArrowRightCn Size="16" Class="h-4 w-4" />
            </ButtonCn>
            <ButtonCn class="w-full sm:w-auto" Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
              Read Press Coverage
            </ButtonCn>
          </div>
        </div>
      </div>
    </section>

