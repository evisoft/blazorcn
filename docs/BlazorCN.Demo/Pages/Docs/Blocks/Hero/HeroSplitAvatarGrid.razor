@* ============================================================
   Block: hero-split-avatar-grid
   Title: HeroSplitAvatarGrid
   Description: A split-layout hero with a 2x2 circular avatar grid for React and Next.js featuring a headline, subtitle, team metadata, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-avatar-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid md:grid-cols-2">
            @* Left — copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">
                <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                    Built by people
                    <br />
                    who care deeply
                </h1>

                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    We are a small, passionate team on a mission to help developers build better products.
                    Every feature is crafted with intention.
                </p>

                <div class="mt-8 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Join our team</ButtonCn>
                    <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">Read our story</ButtonCn>
                </div>

                <p class="mt-4 text-xs text-muted-foreground">
                    @_team.Length core members &middot; 4 countries &middot; 1 mission
                </p>
            </div>

            @* Right — 2x2 avatar grid *@
            <div class="flex items-center justify-center bg-muted/30 px-6 py-8 md:px-10 md:py-10">
                <div class="grid grid-cols-2 gap-6 sm:gap-8">
                    @foreach (var member in _team)
                    {
                        <div class="flex flex-col items-center text-center">
                            @* Avatar placeholder *@
                            <div class="size-20 rounded-full border-2 border-background bg-muted sm:size-24"></div>

                            @* Name and role *@
                            <p class="mt-3 text-sm font-medium">@member.Name</p>
                            <p class="text-xs text-muted-foreground">@member.Role</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Name, string Role);

    private static readonly TeamMember[] _team =
    [
        new("Alex Rivera", "CEO & Co-founder"),
        new("Jordan Patel", "CTO"),
        new("Morgan Chen", "Head of Design"),
        new("Casey Brooks", "Engineering Lead"),
    ];
}
