@* ============================================================
   Block: hero-split-quote-panel
   Title: HeroSplitQuotePanel
   Description: A reverse split-layout hero with a decorative blockquote panel on the left and headline with emerald feature checklist on the right for React and Next.js built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/hero/hero-split-quote-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid md:grid-cols-2">
            @* Left — quote panel *@
            <div class="flex flex-col justify-center bg-muted/40 px-6 py-8 sm:px-10 md:py-10 lg:px-14 lg:py-12">
                @* Decorative quote mark *@
                <span aria-hidden="true" class="select-none font-serif text-6xl leading-none text-muted-foreground/20">
                    &ldquo;
                </span>

                @* Quote text *@
                <blockquote class="-mt-2" cite="#">
                    <p class="text-xl font-medium leading-relaxed tracking-tight sm:text-2xl">
                        @_quote.Text
                    </p>
                </blockquote>

                @* Attribution *@
                <div class="mt-6 flex items-center gap-3">
                    <div class="size-10 rounded-full bg-muted"></div>
                    <div>
                        <p class="text-sm font-medium">@_quote.Author</p>
                        <p class="text-xs text-muted-foreground">
                            @_quote.Role, @_quote.Company
                        </p>
                    </div>
                </div>

                @* Social proof row *@
                <div class="mt-6 flex items-center gap-3 border-t pt-5">
                    <div class="flex -space-x-2">
                        @foreach (var i in Enumerable.Range(0, 4))
                        {
                            <div class="size-7 rounded-full border-2 border-background bg-muted"></div>
                        }
                    </div>
                    <p class="text-xs text-muted-foreground">
                        Trusted by <span class="font-semibold text-foreground">2,400+</span> teams
                    </p>
                </div>
            </div>

            @* Right — headline and CTAs *@
            <div class="flex flex-col justify-center px-6 py-8 sm:px-10 md:py-10 lg:px-14 lg:py-12">
                @* Announcement pill *@
                <div class="mb-5">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Now available</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">v3.0 released</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
                    Ship faster without<br />
                    the complexity
                </h1>

                @* Subtitle *@
                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    The modern deployment platform that your engineering team will actually enjoy using.
                    From commit to production in minutes.
                </p>

                @* Feature checklist *@
                <ul class="mt-5 space-y-2.5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-3">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                            <span class="text-sm text-foreground">@feature</span>
                        </li>
                    }
                </ul>

                @* CTAs *@
                <div class="mt-7 flex items-center gap-3">
                    <ButtonCn Class="w-[200px]">Start free trial</ButtonCn>
                    <ButtonCn Class="w-[180px]" Variant="ButtonVariant.Ghost">Book a demo</ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record QuoteData(string Text, string Author, string Role, string Company);

    private static readonly QuoteData _quote = new(
        "It replaced three tools in our stack overnight. Our team ships twice as fast now.",
        "Elena Vasquez",
        "VP of Engineering",
        "Meridian Systems"
    );

    private static readonly string[] _features =
    [
        "Cut deployment time by 60%",
        "Zero-downtime migrations",
        "SOC 2 Type II certified",
    ];
}
