@* ============================================================
   Block: hero-case-study
   Title: HeroCaseStudy
   Description: A reverse split-layout hero for React and Next.js with a large pull quote panel on the left and a structured before-and-after metrics panel on the right, with dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-case-study.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid md:grid-cols-[1.2fr,1fr]">
            @* Left — large quote area *@
            <div class="flex flex-col justify-center px-6 py-8 sm:px-10 md:py-10 lg:px-14 lg:py-12">
                @* Pill *@
                <div class="mb-5">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Case study</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">@_caseStudy.Company</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
                    Real results from<br />
                    real engineering teams
                </h1>

                @* Quote *@
                <blockquote class="mt-6 border-l-2 border-muted-foreground/20 pl-4">
                    <p class="text-lg leading-relaxed text-muted-foreground italic">
                        &ldquo;@_caseStudy.Quote&rdquo;
                    </p>
                </blockquote>

                @* Attribution *@
                <div class="mt-5 flex items-center gap-3">
                    <div class="flex size-9 items-center justify-center rounded-full bg-muted text-xs font-medium text-muted-foreground">
                        @_caseStudy.Person.Initials
                    </div>
                    <div>
                        <p class="text-sm font-medium">@_caseStudy.Person.Name</p>
                        <p class="text-xs text-muted-foreground">
                            @_caseStudy.Person.Role, @_caseStudy.Company
                        </p>
                    </div>
                </div>

                @* CTAs *@
                <div class="mt-7 flex items-center gap-3">
                    <ButtonCn Class="w-[180px]">Read full story</ButtonCn>
                    <ButtonCn Class="w-[180px]" Variant="ButtonVariant.Ghost">Start free trial</ButtonCn>
                </div>
            </div>

            @* Right — metrics panel *@
            <div class="flex flex-col border-t bg-muted/30 md:border-l md:border-t-0">
                @* Company header *@
                <div class="flex items-center gap-3 border-b px-6 py-4">
                    <div class="flex size-8 items-center justify-center rounded-md bg-foreground text-[10px] font-bold text-background">
                        @_caseStudy.CompanyInitials
                    </div>
                    <div>
                        <p class="text-sm font-medium">@_caseStudy.Company</p>
                        <p class="text-xs text-muted-foreground">@_caseStudy.CompanyDetail</p>
                    </div>
                </div>

                @* Metrics *@
                <div class="flex flex-1 flex-col divide-y">
                    @foreach (var metric in _caseStudy.Metrics)
                    {
                        <div class="flex flex-1 flex-col justify-center px-6 py-5">
                            <p class="text-xs font-medium text-muted-foreground">@metric.Label</p>
                            <div class="mt-2 flex items-baseline gap-3">
                                <span class="text-2xl font-semibold tabular-nums">@metric.After</span>
                                <span class="text-sm text-muted-foreground line-through">@metric.Before</span>
                            </div>
                            <div class="mt-2">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-medium">
                                    @metric.Improvement
                                </BadgeCn>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record PersonInfo(string Name, string Role, string Initials);
    private record Metric(string Label, string Before, string After, string Improvement);
    private record CaseStudyData(
        string Company,
        string CompanyInitials,
        string CompanyDetail,
        PersonInfo Person,
        string Quote,
        Metric[] Metrics
    );

    private static readonly CaseStudyData _caseStudy = new(
        Company: "Meridian Systems",
        CompanyInitials: "MS",
        CompanyDetail: "Series C · 120 engineers",
        Person: new PersonInfo(
            Name: "Elena Vasquez",
            Role: "Head of Platform Engineering",
            Initials: "EV"
        ),
        Quote: "We cut our incident response time from hours to minutes. The migration paid for itself in the first quarter alone.",
        Metrics: [
            new Metric("Incident response", "4.2 hrs", "8 min", "97% faster"),
            new Metric("Monthly infra spend", "$84K", "$31K", "63% savings"),
            new Metric("Deploy frequency", "2x / week", "12x / day", "42x increase"),
        ]
    );
}
