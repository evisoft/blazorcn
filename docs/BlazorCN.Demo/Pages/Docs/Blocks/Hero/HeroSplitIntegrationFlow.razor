@* ============================================================
   Block: hero-split-integration-flow
   Title: HeroSplitIntegrationFlow
   Description: A split-layout hero with an integration flow diagram for React and Next.js featuring source cards connecting to a central metrics panel, announcement pill, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-integration-flow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid md:grid-cols-2">
            @* Left -- copy *@
            <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-14 lg:py-12">
                @* Announcement pill *@
                <div class="mb-5">
                    <a href="#"
                       class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">New</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">200+ data connectors</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
                    Every data source,
                    <br />
                    one dashboard
                </h1>

                @* Subtitle *@
                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                    Connect databases, APIs, and services into a unified metrics layer. See everything
                    that matters in one place.
                </p>

                @* CTAs *@
                <div class="mt-6 flex items-center gap-3">
                    <ButtonCn Class="w-[190px]">Start connecting</ButtonCn>
                    <ButtonCn Class="w-[190px]" Variant="ButtonVariant.Ghost">View integrations</ButtonCn>
                </div>

                @* Trust line *@
                <p class="mt-5 text-xs text-muted-foreground">
                    SOC 2 compliant &middot; GDPR ready &middot; 99.9% uptime SLA
                </p>
            </div>

            @* Right -- integration flow diagram *@
            <div class="relative flex min-h-[380px] items-center justify-center bg-muted p-6 md:p-8"
                 aria-hidden="true">
                <div class="flex w-full max-w-[320px] items-center gap-4">
                    @* Source cards column *@
                    <div class="flex shrink-0 flex-col gap-3">
                        @foreach (var src in _sources)
                        {
                            <div class="flex items-center gap-2.5 rounded-lg border bg-card px-3 py-2.5">
                                <div class="flex size-7 items-center justify-center rounded-md bg-muted">
                                    <LucideIconCn Name="@src.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                                </div>
                                <span class="text-xs font-medium">@src.Name</span>
                            </div>
                        }
                    </div>

                    @* Connecting lines *@
                    <div class="flex flex-1 flex-col items-center justify-center gap-3">
                        @foreach (var src in _sources)
                        {
                            <div class="h-px w-full origin-left bg-border"></div>
                        }
                    </div>

                    @* Central metrics card *@
                    <div class="shrink-0 overflow-hidden rounded-lg border bg-card">
                        <div class="flex items-center gap-2 border-b px-3 py-2">
                            <LucideIconCn Name="bar-chart-3" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-xs font-medium">Metrics</span>
                        </div>
                        <div class="space-y-2.5 p-3">
                            @foreach (var metric in _metrics)
                            {
                                <div>
                                    <p class="text-[10px] text-muted-foreground">@metric.Label</p>
                                    <p class="text-sm font-semibold tabular-nums">@metric.Value</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Source(string Name, string Icon);
    private record Metric(string Label, string Value);

    private static readonly Source[] _sources =
    [
        new("Database", "database"),
        new("Cloud API", "cloud"),
        new("Email", "mail"),
    ];

    private static readonly Metric[] _metrics =
    [
        new("Events/sec", "12.4K"),
        new("Sources", "38"),
        new("Uptime", "99.9%"),
    ];
}
