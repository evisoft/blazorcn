@* ========================================
   Block: hero-pricing-toggle
   Title: Hero Pricing Toggle
   Description: Hero block with side-by-side pricing tiers and billing toggle
   Long Description: Hero block with pricing teaser showing starting price and key value prop
   Dependencies: BadgeCn, ButtonCn, CardCn, TabsCn
   Source: original/blocks/hero/hero-pricing-toggle.tsx
   ======================================== *@

<section class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="mx-auto max-w-5xl">
          @* Header *@
          <div class="mb-12 text-center">
            <BadgeCn class="mb-6" Variant="BadgeVariant.Secondary">
              Simple, Transparent Pricing
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
              Start free, scale as you <span class="text-primary">grow</span>
            </h1>

            <p class="mx-auto mb-8 max-w-2xl text-lg text-muted-foreground">
              No hidden fees. No surprises. Choose the plan that fits your needs and upgrade
              anytime.
            </p>

            @* Billing toggle *@
            <div class="flex items-center justify-center gap-4">
              <div class="inline-flex items-center rounded-lg border p-1">
                <button type="button" class="@(Cn.Merge("rounded-md px-3 py-1.5 text-sm font-medium transition-colors", (_billing == "monthly" ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:text-foreground")))" @onclick="@(() => _billing = "monthly")">Monthly</button>
                <button type="button" class="@(Cn.Merge("rounded-md px-3 py-1.5 text-sm font-medium transition-colors", (_billing == "yearly" ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:text-foreground")))" @onclick="@(() => _billing = "yearly")">
                  Yearly
                  <BadgeCn class="ml-2 text-xs">
                    Save 17%
                  </BadgeCn>
                </button>
              </div>
            </div>
          </div>

          @* Pricing cards *@
          <div class="grid gap-8 md:grid-cols-2">
            @foreach (var plan in _PLANS)
            {
              <CardCn
                class="@(Cn.Merge("relative flex flex-col", (plan.Popular ? "border-primary shadow-lg" : "")))"
              >
                @if (plan.Popular)
                {
                  <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                    <BadgeCn class="gap-1">
                      <LucideSparklesCn Size="12" Class="h-3 w-3" />
                      Most Popular
                    </BadgeCn>
                  </div>
                }
                <CardHeaderCn class="pb-4">
                  <CardTitleCn class="text-xl">@plan.Name</CardTitleCn>
                  <CardDescriptionCn>@plan.Description</CardDescriptionCn>
                </CardHeaderCn>

                <CardContentCn class="flex flex-1 flex-col">
                  @* Price *@
                  <div class="mb-6">
                    <div class="flex items-baseline gap-1">
                      <span class="text-4xl font-bold">
                        $@(_billing == "yearly" ? plan.YearlyPrice : plan.MonthlyPrice)
                      </span>
                      <span class="text-muted-foreground">/month</span>
                    </div>
                    @if (plan.MonthlyPrice > 0 && _billing == "yearly")
                    {
                      <p class="mt-1 text-sm text-muted-foreground">
                        $@(plan.YearlyPrice * 12) billed annually
                      </p>
                    }
                    @if (plan.MonthlyPrice == 0)
                    {
                      <p class="mt-1 text-sm text-muted-foreground">Free forever</p>
                    }
                  </div>

                  @* Features *@
                  <ul class="mb-8 flex-1 space-y-3">
                    @foreach (var feature in plan.Features)
                    {
                      <li class="flex items-center gap-3">
                        <div class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/10">
                          <LucideCheckCn Size="12" Class="h-3 w-3 text-primary" />
                        </div>
                        <span class="text-sm">@feature</span>
                      </li>
                    }
                  </ul>

                  @* CTA *@
                  <ButtonCn
                    class="w-full gap-2"
                    Size="ButtonSize.Lg"
                    Variant="@(plan.Popular ? ButtonVariant.Default : ButtonVariant.Outline)"
                  >
                    @plan.Cta
                    <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                  </ButtonCn>
                </CardContentCn>
              </CardCn>
            }
          </div>

          @* Enterprise *@
          <div class="mt-12 rounded-lg border bg-muted/50 p-6 text-center">
            <p class="text-muted-foreground">
              <span class="font-medium text-foreground">Need more?</span> Our Enterprise plan
              includes custom limits, SSO, dedicated support, and SLAs.
              <a class="text-primary hover:underline" href="#">
                Contact sales &#x2192;
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>

@code {
    private string _billing = "monthly";

    private record PlanData(string Name, string Description, int MonthlyPrice, int YearlyPrice, bool Popular, string Cta, string[] Features);

    private static readonly PlanData[] _PLANS = new[]
    {
        new PlanData("Free", "For individuals and small projects", 0, 0, false, "Get Started Free", new[] { "Up to 3 projects", "Basic analytics", "Community support", "1 GB storage" }),
        new PlanData("Pro", "For growing teams and businesses", 29, 24, true, "Start Free Trial", new[] { "Unlimited projects", "Advanced analytics", "Priority support", "100 GB storage", "Custom integrations", "Team collaboration" }),
    };
}
