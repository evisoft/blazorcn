@* ============================================================
   Block: hero-centered-roi-calculator
   Title: HeroCenteredRoiCalculator
   Description: A centered hero with an interactive ROI calculator slider for React and Next.js featuring a shadcn/ui Slider input, a NumberFlow animated savings output, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-roi-calculator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card px-6 py-10 text-center sm:px-8 sm:py-12 lg:px-12">
    @* Announcement pill *@
    <div class="flex justify-center">
      <a
        href="#"
        class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted"
      >
        <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-500" />
        <span class="font-medium">2026 ROI report</span>
        <span class="text-muted-foreground">&middot;</span>
        <span class="text-muted-foreground">Average payback: 4 months</span>
        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
      </a>
    </div>

    @* Headline *@
    <h1 class="mt-5 text-4xl font-bold tracking-tight sm:text-5xl">
      See what your team
      <br />
      could be saving
    </h1>

    @* Subtitle *@
    <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
      Drag the slider to match your team size and see your estimated annual savings update in
      real time.
    </p>

    @* Calculator panel *@
    <div class="mx-auto mt-8 max-w-md">
      @* Slider with team size label *@
      <div class="text-left">
        <div class="flex items-baseline justify-between">
          <label for="roi-team-size" class="text-xs font-medium text-muted-foreground">
            Team size
          </label>
          <span class="text-sm font-semibold tabular-nums text-foreground">
            @_teamSize @(_teamSize == 1 ? "seat" : "seats")
          </span>
        </div>
        <SliderCn id="roi-team-size"
          Class="mt-3"
          Min="@_minTeam"
          Max="@_maxTeam"
          Step="1"
          Value="@((double)_teamSize)"
          ValueChanged="@((double v) => _teamSize = (int)v)"
          aria-label="Team size"
        />
        <div class="mt-1.5 flex items-center justify-between text-[10px] text-muted-foreground/70">
          <span>@_minTeam</span>
          <span>@_maxTeam+</span>
        </div>
      </div>

      @* Big savings number *@
      <div class="mt-7 rounded-xl border bg-muted/40 px-4 py-5">
        <div class="text-5xl font-bold tabular-nums tracking-tight text-foreground sm:text-6xl">
          $@CalculateSavings(_teamSize).ToString("N0")
        </div>
        <p class="mt-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">
          Estimated annual savings
        </p>
      </div>
    </div>

    @* CTAs *@
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <ButtonCn Class="w-[180px]">Get started</ButtonCn>
      <ButtonCn Variant="ButtonVariant.Ghost" Class="w-[170px]">Talk to sales</ButtonCn>
    </div>
  </div>
</section>

@code {
    private const int _perSeatSaving = 850;
    private const int _automationBonus = 5000;
    private const int _minTeam = 5;
    private const int _maxTeam = 100;
    private const int _defaultTeam = 25;

    private int _teamSize = _defaultTeam;

    private static int CalculateSavings(int teamSize) => teamSize * _perSeatSaving + _automationBonus;
}
