@* ============================================================
   Block: hero-centered-compatibility-matrix
   Title: HeroCenteredCompatibilityMatrix
   Description: A centered hero with a compact platform compatibility matrix table for React and Next.js featuring an announcement pill, dual ShadcnioButton CTAs, and emerald check or muted dash cells built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-compatibility-matrix.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card px-6 py-10 sm:px-8 lg:px-12 lg:py-12">
        <div class="flex flex-col items-center text-center">

            @* Announcement pill *@
            <a class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted"
               href="#">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="font-medium">Platform</span>
                <span class="text-muted-foreground">&middot;</span>
                <span class="text-muted-foreground">Android biometric auth is live</span>
                <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
            </a>

            <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl">
                One SDK.
                <br />
                <span class="text-muted-foreground">Every device your users own.</span>
            </h1>

            <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
                Ship native experiences across desktop and mobile from a single codebase. Broad platform
                coverage with thoughtfully scoped feature parity where it matters.
            </p>

            @* CTA buttons *@
            <div class="mt-8 flex items-center gap-3">
                <ButtonCn Class="w-[180px]">Install the SDK</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-[170px]">Read the docs</ButtonCn>
            </div>

            @* Compatibility matrix table *@
            <div class="mt-8 w-full overflow-hidden rounded-xl border bg-muted/50">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="border-b bg-background/40">
                            <th class="px-3 py-2 font-medium text-muted-foreground" scope="col">
                                Platform
                            </th>
                            @foreach (var cap in _capabilities)
                            {
                                <th class="px-2 py-2 text-center font-medium text-muted-foreground sm:px-3"
                                    scope="col">
                                    @cap.Label
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < _platforms.Length; i++)
                        {
                            var platform = _platforms[i];
                            var isLast = i == _platforms.Length - 1;
                            <tr class="@(isLast ? "" : "border-b border-border/60")">
                                <th class="px-3 py-2.5 font-medium text-foreground" scope="row">
                                    @platform.Name
                                </th>
                                @foreach (var cap in _capabilities)
                                {
                                    var capId = cap.Id;
                                    var supported = platform.Support.TryGetValue(capId, out var s) && s;
                                    <td class="px-2 py-2.5 text-center sm:px-3">
                                        @if (supported)
                                        {
                                            <span aria-label="@($"{platform.Name} supports {cap.Label}")"
                                                  class="inline-flex size-5 items-center justify-center rounded-full bg-emerald-500/10"
                                                  role="img">
                                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-500" StrokeWidth="3" aria-hidden="true" />
                                            </span>
                                        }
                                        else
                                        {
                                            <span aria-label="@($"{platform.Name} does not support {cap.Label}")"
                                                  class="inline-flex size-5 items-center justify-center rounded-full bg-muted"
                                                  role="img">
                                                <LucideIconCn Name="minus" Size="12" Class="size-3 text-muted-foreground" aria-hidden="true" />
                                            </span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</section>

@code {
    private record Capability(string Id, string Label);

    private record Platform(string Id, string Name, Dictionary<string, bool> Support);

    private static readonly Capability[] _capabilities =
    [
        new Capability("native", "Native SDK"),
        new Capability("push", "Push"),
        new Capability("offline", "Offline sync"),
        new Capability("biometric", "Biometric auth"),
    ];

    private static readonly Platform[] _platforms =
    [
        new Platform("macos", "macOS", new Dictionary<string, bool>
        {
            ["native"] = true, ["push"] = true, ["offline"] = true, ["biometric"] = true
        }),
        new Platform("windows", "Windows", new Dictionary<string, bool>
        {
            ["native"] = true, ["push"] = true, ["offline"] = true, ["biometric"] = false
        }),
        new Platform("linux", "Linux", new Dictionary<string, bool>
        {
            ["native"] = true, ["push"] = false, ["offline"] = true, ["biometric"] = false
        }),
        new Platform("ios", "iOS", new Dictionary<string, bool>
        {
            ["native"] = true, ["push"] = true, ["offline"] = true, ["biometric"] = true
        }),
        new Platform("android", "Android", new Dictionary<string, bool>
        {
            ["native"] = true, ["push"] = true, ["offline"] = true, ["biometric"] = true
        }),
    ];
}
