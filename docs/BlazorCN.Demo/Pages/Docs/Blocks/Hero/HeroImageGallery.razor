@* ========================================
   Block: hero-image-gallery
   Title: Hero Image Gallery
   Description: Hero block with interactive image gallery and lightbox preview
   Dependencies: BadgeCn, ButtonCn, DialogCn
   Source: original/blocks/hero/hero-image-gallery.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div class="flex flex-col justify-center">
                <BadgeCn Class="mb-6 w-fit" Variant="BadgeVariant.Secondary">
                    Featured Work
                </BadgeCn>

                <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
                    Crafting digital<br />
                    <span class="text-primary">experiences</span>
                </h1>

                <p class="mb-8 max-w-lg text-lg text-muted-foreground">
                    We design and build beautiful digital products that help brands connect with their
                    audience. From concept to launch, we bring visions to life.
                </p>

                <div class="mb-8 flex flex-col gap-4 sm:flex-row">
                    <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                        View Portfolio
                        <LucideArrowRightCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
                        Our Process
                    </ButtonCn>
                </div>

                <div class="grid grid-cols-3 gap-4 border-t pt-8">
                    <div>
                        <p class="text-3xl font-bold">200+</p>
                        <p class="text-sm text-muted-foreground">Projects</p>
                    </div>
                    <div>
                        <p class="text-3xl font-bold">50+</p>
                        <p class="text-sm text-muted-foreground">Clients</p>
                    </div>
                    <div>
                        <p class="text-3xl font-bold">15+</p>
                        <p class="text-sm text-muted-foreground">Awards</p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <button type="button"
                        class="group relative col-span-2 aspect-[4/3] overflow-hidden rounded-2xl sm:col-span-1 sm:row-span-2 sm:aspect-auto sm:h-full"
                        @onclick="@(() => _selectedImage = _galleryImages[0].Src)">
                    <img alt="@_galleryImages[0].Alt" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                         height="800" src="@_galleryImages[0].Src" width="1200" />
                    <div class="absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/20"></div>
                    <div class="absolute inset-0 flex items-center justify-center opacity-0 transition-opacity group-hover:opacity-100">
                        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-white/90 shadow-lg">
                            <LucideZoomInCn Size="20" Class="h-5 w-5 text-gray-900" />
                        </div>
                    </div>
                </button>

                @foreach (var image in _galleryImages[1..])
                {
                    <button type="button"
                            class="group relative aspect-square overflow-hidden rounded-2xl"
                            @onclick="@(() => _selectedImage = image.Src)">
                        <img alt="@image.Alt" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                             height="800" src="@image.Src" width="1200" />
                        <div class="absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/20"></div>
                        <div class="absolute inset-0 flex items-center justify-center opacity-0 transition-opacity group-hover:opacity-100">
                            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white/90 shadow-lg">
                                <LucideZoomInCn Size="16" Class="h-4 w-4 text-gray-900" />
                            </div>
                        </div>
                    </button>
                }
            </div>
        </div>
    </div>

    <DialogCn @bind-Open="_dialogOpen">
        <DialogContentCn Class="max-w-4xl border-none bg-transparent p-0 shadow-none">
            <DialogTitleCn Class="sr-only">Image Preview</DialogTitleCn>
            @if (_selectedImage != null)
            {
                <img alt="Gallery preview" class="h-auto w-full rounded-lg" height="800" src="@_selectedImage" width="1200" />
            }
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private record GalleryImage(string Src, string Alt);

    private string? _selectedImage;
    private bool _dialogOpen
    {
        get => _selectedImage != null;
        set { if (!value) _selectedImage = null; }
    }

    private static readonly GalleryImage[] _galleryImages =
    [
        new("https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&w=1200&q=85", "Abstract colorful design"),
        new("https://images.unsplash.com/photo-1558591710-4b4a1ae0f04d?auto=format&w=800&q=85", "Geometric patterns"),
        new("https://images.unsplash.com/photo-1557672172-298e090bd0f1?auto=format&w=800&q=85", "Fluid art design"),
        new("https://images.unsplash.com/photo-1579546929518-9e396f3cc809?auto=format&w=800&q=85", "Gradient waves"),
    ];
}
