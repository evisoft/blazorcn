@* ============================================================
   Block: hero-dark-mode-toggle
   Title: HeroDarkModeToggle
   Description: A split-layout hero for React and Next.js with a theme preview toggle showing stacked light and dark mini cards with skeleton UI elements built with the ShadcnioButton component and Tailwind CSS
   Source: original/blocks/hero/hero-dark-mode-toggle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="grid md:grid-cols-2">

            @* Left -- text content *@
            <div class="flex flex-col justify-center px-6 py-8 sm:px-10 md:py-10 lg:px-14">

                @* Announcement pill *@
                <div class="mb-5">
                    <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium">Theming</span>
                        <span class="text-muted-foreground">&middot;</span>
                        <span class="text-muted-foreground">Full dark mode support</span>
                        <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    </a>
                </div>

                @* Headline *@
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
                    Beautiful in<br />
                    every theme
                </h1>

                @* Subtitle *@
                <p class="mt-4 max-w-sm text-base leading-relaxed text-muted-foreground">
                    Every component is designed for both light and dark. Toggle the preview to see the
                    attention to detail in every pixel.
                </p>

                @* Toggle control *@
                <div class="mt-5 flex items-center gap-3">
                    <LucideIconCn Name="sun" Size="16" Class="@Cn.Merge("size-4 transition-colors", !_isDark ? "text-foreground" : "text-muted-foreground/50")" />
                    <button type="button" aria-label="Toggle theme preview"
                        class="relative h-6 w-11 rounded-full bg-muted transition-colors"
                        @onclick="@(() => _isDark = !_isDark)">
                        <span class="@Cn.Merge("absolute top-0.5 left-0.5 size-5 rounded-full bg-foreground shadow-sm transition-transform duration-200", _isDark ? "translate-x-5" : "translate-x-0")"></span>
                    </button>
                    <LucideIconCn Name="moon" Size="16" Class="@Cn.Merge("size-4 transition-colors", _isDark ? "text-foreground" : "text-muted-foreground/50")" />
                </div>

                @* CTAs *@
                <div class="mt-7 flex flex-col items-start gap-3 sm:flex-row">
                    <ButtonCn class="w-[200px]">Browse components</ButtonCn>
                    <ButtonCn class="w-[160px]" Variant="ButtonVariant.Ghost">View themes</ButtonCn>
                </div>
            </div>

            @* Right -- theme preview cards *@
            <div class="flex flex-col justify-center gap-3 bg-muted/40 p-6 md:p-8" aria-hidden="true">

                @* Light theme card *@
                <div class="@Cn.Merge("overflow-hidden rounded-xl border bg-card shadow-sm transition-all duration-300", !_isDark ? "scale-[1.02] ring-2 ring-foreground/10" : "opacity-60 scale-[0.98]")">
                    @* Card header *@
                    <div class="flex items-center gap-2 border-b px-4 py-2.5">
                        <LucideIconCn Name="sun" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-[10px] font-medium text-muted-foreground uppercase tracking-wider">Light</span>
                    </div>
                    @* Skeleton content *@
                    <div class="space-y-3 p-4">
                        <div class="flex items-center gap-3">
                            <div class="size-8 rounded-full bg-muted"></div>
                            <div class="flex-1 space-y-1.5">
                                <div class="h-2 w-3/5 rounded-full bg-muted"></div>
                                <div class="h-1.5 w-2/5 rounded-full bg-muted/70"></div>
                            </div>
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <div class="h-10 rounded-md bg-muted/70"></div>
                            <div class="h-10 rounded-md bg-muted/50"></div>
                            <div class="h-10 rounded-md bg-muted/60"></div>
                        </div>
                        <div class="flex gap-2">
                            <div class="h-2 w-1/4 rounded-full bg-muted/50"></div>
                            <div class="h-2 w-1/3 rounded-full bg-muted/40"></div>
                        </div>
                    </div>
                </div>

                @* Dark theme card *@
                <div class="@Cn.Merge("overflow-hidden rounded-xl border border-foreground/10 bg-foreground shadow-sm transition-all duration-300", _isDark ? "scale-[1.02] ring-2 ring-foreground/10" : "opacity-60 scale-[0.98]")">
                    @* Card header *@
                    <div class="flex items-center gap-2 border-b border-background/10 px-4 py-2.5">
                        <LucideIconCn Name="moon" Size="12" Class="size-3 text-background/40" />
                        <span class="text-[10px] font-medium text-background/40 uppercase tracking-wider">Dark</span>
                    </div>
                    @* Skeleton content *@
                    <div class="space-y-3 p-4">
                        <div class="flex items-center gap-3">
                            <div class="size-8 rounded-full bg-background/10"></div>
                            <div class="flex-1 space-y-1.5">
                                <div class="h-2 w-3/5 rounded-full bg-background/10"></div>
                                <div class="h-1.5 w-2/5 rounded-full bg-background/[0.06]"></div>
                            </div>
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <div class="h-10 rounded-md bg-background/[0.07]"></div>
                            <div class="h-10 rounded-md bg-background/[0.05]"></div>
                            <div class="h-10 rounded-md bg-background/[0.06]"></div>
                        </div>
                        <div class="flex gap-2">
                            <div class="h-2 w-1/4 rounded-full bg-background/[0.05]"></div>
                            <div class="h-2 w-1/3 rounded-full bg-background/[0.04]"></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private bool _isDark = false;
}
