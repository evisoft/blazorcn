@* ============================================================
   Block: hero-split-org-chart
   Title: HeroSplitOrgChart
   Description: A split-layout hero with an organizational chart tree mockup for React and Next.js featuring a three-level node hierarchy, SVG connection lines, emerald checklist, and dual ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-split-org-chart.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="grid lg:grid-cols-2">

      @* Left — copy *@
      <div class="flex flex-col justify-center px-8 py-10 sm:px-12 lg:px-16 lg:py-12">

        @* Announcement pill *@
        <div class="mb-8">
          <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="font-medium">New</span>
            <span class="text-muted-foreground">·</span>
            <span class="text-muted-foreground">HRIS sync is live</span>
            <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
          </a>
        </div>

        @* Headline *@
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          See how your<br />team is wired.
        </h1>

        @* Subtitle *@
        <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
          A living org chart that stays in sync with your HRIS. Explore reporting lines, skills,
          and open roles in one place.
        </p>

        @* Feature checklist *@
        <ul class="mt-6 space-y-2.5">
          @foreach (var feature in _features)
          {
            <li class="flex items-center gap-3">
              <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
              <span class="text-sm text-foreground">@feature</span>
            </li>
          }
        </ul>

        @* CTAs *@
        <div class="mt-8 flex items-center gap-3">
          <ButtonCn Class="w-[180px]">Get started</ButtonCn>
          <ButtonCn Class="w-[160px]" Variant="ButtonVariant.Ghost">Book a demo</ButtonCn>
        </div>

      </div>

      @* Right — org chart mockup *@
      <div class="flex items-center p-6 lg:p-10">
        <div class="relative w-full overflow-hidden rounded-2xl border bg-muted/50 p-6" aria-hidden="true">

          @* Connection lines *@
          <svg aria-hidden="true"
               class="pointer-events-none absolute inset-0 h-full w-full text-muted-foreground/25"
               viewBox="0 0 400 300"
               preserveAspectRatio="none">
            @* CEO trunk down *@
            <path d="M 200 55 L 200 100" stroke="currentColor" stroke-width="1" fill="none" />
            @* Horizontal bar to three VPs *@
            <path d="M 75 100 L 325 100" stroke="currentColor" stroke-width="1" fill="none" />
            @* VP drops *@
            <path d="M 75 100 L 75 130" stroke="currentColor" stroke-width="1" fill="none" />
            <path d="M 200 100 L 200 130" stroke="currentColor" stroke-width="1" fill="none" />
            <path d="M 325 100 L 325 130" stroke="currentColor" stroke-width="1" fill="none" />
            @* VP trunk to reports *@
            <path d="M 75 170 L 75 200" stroke="currentColor" stroke-width="1" fill="none" />
            <path d="M 200 170 L 200 200" stroke="currentColor" stroke-width="1" fill="none" />
            <path d="M 325 170 L 325 200" stroke="currentColor" stroke-width="1" fill="none" />
            @* Horizontal split for report pairs *@
            <path d="M 40 200 L 110 200" stroke="currentColor" stroke-width="1" fill="none" />
            <path d="M 165 200 L 235 200" stroke="currentColor" stroke-width="1" fill="none" />
            <path d="M 290 200 L 360 200" stroke="currentColor" stroke-width="1" fill="none" />
            @* Report drops *@
            <path d="M 40 200 L 40 225" stroke="currentColor" stroke-width="1" fill="none" />
            <path d="M 110 200 L 110 225" stroke="currentColor" stroke-width="1" fill="none" />
            <path d="M 165 200 L 165 225" stroke="currentColor" stroke-width="1" fill="none" />
            <path d="M 235 200 L 235 225" stroke="currentColor" stroke-width="1" fill="none" />
            <path d="M 290 200 L 290 225" stroke="currentColor" stroke-width="1" fill="none" />
            <path d="M 360 200 L 360 225" stroke="currentColor" stroke-width="1" fill="none" />
          </svg>

          @* Nodes layer *@
          <div class="relative flex flex-col gap-7">

            @* Level 1 — CEO *@
            <div class="flex justify-center">
              @OrgCard(_ceo, "md")
            </div>

            @* Level 2 — VPs *@
            <div class="grid grid-cols-3 gap-2">
              @foreach (var vp in _vps)
              {
                <div class="flex justify-center">
                  @OrgCard(vp, "md")
                </div>
              }
            </div>

            @* Level 3 — Reports *@
            <div class="grid grid-cols-3 gap-2">
              @foreach (var pair in _reports)
              {
                <div class="flex justify-center gap-1.5">
                  @foreach (var report in pair)
                  {
                    @OrgCard(report, "sm")
                  }
                </div>
              }
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>

@code {
  private static readonly string[] _features =
  [
    "Auto-sync with BambooHR, Rippling, and HRIS",
    "Drag-and-drop reporting structure edits",
    "Public team pages with avatar and bio",
  ];

  private record OrgNode(string Name, string Role, string Initial);

  private static readonly OrgNode _ceo = new("Ava Chen", "CEO", "A");

  private static readonly OrgNode[] _vps =
  [
    new("Mateo Rivera", "VP Engineering", "M"),
    new("Lena Park", "VP Design", "L"),
    new("Jordan Kim", "VP Sales", "J"),
  ];

  private static readonly OrgNode[][] _reports =
  [
    [new("Priya Sen", "Platform Lead", "P"), new("Noah Schmidt", "Mobile Lead", "N")],
    [new("Iris Huang", "Brand Lead", "I"), new("Omar Hassan", "Product Lead", "O")],
    [new("Sara Lopez", "Enterprise", "S"), new("Theo Grant", "Mid-market", "T")],
  ];

  private RenderFragment OrgCard(OrgNode node, string size) => __builder =>
  {
    var avatarSize = size == "md" ? "size-7" : "size-6";
    var nameClass = size == "md" ? "text-[11px]" : "text-[10px]";
    var roleClass = size == "md" ? "text-[9px]" : "text-[8px]";
    __builder.OpenElement(0, "div");
    __builder.AddAttribute(1, "class", "flex items-center gap-2 rounded-lg border bg-background/80 px-2.5 py-1.5 shadow-sm");
    __builder.OpenElement(2, "div");
    __builder.AddAttribute(3, "class", $"flex {avatarSize} shrink-0 items-center justify-center rounded-full bg-muted-foreground/10 font-semibold text-[10px] text-foreground");
    __builder.AddContent(4, node.Initial);
    __builder.CloseElement();
    __builder.OpenElement(5, "div");
    __builder.AddAttribute(6, "class", "min-w-0 leading-tight");
    __builder.OpenElement(7, "div");
    __builder.AddAttribute(8, "class", $"{nameClass} font-semibold text-foreground");
    __builder.AddContent(9, node.Name);
    __builder.CloseElement();
    __builder.OpenElement(10, "div");
    __builder.AddAttribute(11, "class", $"{roleClass} text-muted-foreground");
    __builder.AddContent(12, node.Role);
    __builder.CloseElement();
    __builder.CloseElement();
    __builder.CloseElement();
  };
}
