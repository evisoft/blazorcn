@* ============================================================
   Block: hero-dark-install-command
   Title: HeroDarkInstallCommand
   Description: A dark-themed centered hero for React and Next.js with a star count badge, terminal install command with copy-to-clipboard button, dual ShadcnioButton CTAs, and a light stats footer bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-dark-install-command.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">

    @* Dark hero area *@
    <div class="bg-foreground px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">

      @* Star count badge *@
      <div class="mb-6 flex justify-center">
        <a
          href="#"
          class="inline-flex items-center gap-2 rounded-full border border-background/20 px-3.5 py-1.5 text-sm transition-colors hover:bg-background/10"
        >
          <LucideIconCn Name="star" Size="14" Class="size-3.5 text-background/60" />
          <span class="font-semibold tabular-nums text-background">32,400+</span>
          <span class="text-background/40">stars on GitHub</span>
        </a>
      </div>

      @* Headline *@
      <h1 class="text-4xl font-bold tracking-tight text-background sm:text-5xl">
        Build better software,
        <br />
        together
      </h1>

      @* Subtitle *@
      <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-background/50 sm:text-lg">
        Free, open source, and community-driven. Ship accessible, performant interfaces with
        components that just work.
      </p>

      @* Terminal install command *@
      <div class="mx-auto mt-7 max-w-sm">
        <div class="flex items-center justify-between rounded-lg border border-background/10 bg-background/5 px-4 py-3">
          <code class="font-mono text-sm text-background/60">
            <span class="text-background/25">$ </span>
            @_installCmd
          </code>
          <button
            type="button"
            @onclick="HandleCopy"
            class="ml-3 flex shrink-0 items-center gap-1.5 rounded px-2 py-1 text-xs text-background/40 transition-colors hover:bg-background/10 hover:text-background/70"
          >
            @if (_copied)
            {
              <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-400" />
              <span>Copied</span>
            }
            else
            {
              <LucideIconCn Name="copy" Size="12" Class="size-3" />
              <span>Copy</span>
            }
          </button>
        </div>
      </div>

      @* CTAs *@
      <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <ButtonCn Class="w-[210px] bg-background text-foreground hover:bg-background/90">
          <LucideIconCn Name="star" Size="16" Class="size-4" />
          Star on GitHub
        </ButtonCn>
        <ButtonCn Class="w-[170px] border border-background/20 bg-transparent text-background hover:bg-background/10">
          <LucideIconCn Name="book-open" Size="16" Class="size-4" />
          Read docs
        </ButtonCn>
      </div>
    </div>

    @* Stats bar -- light area *@
    <div class="border-t px-6 py-6 sm:px-10 sm:py-8">
      <div class="flex flex-wrap items-center justify-center gap-8">
        @foreach (var stat in _stats)
        {
          var s = stat;
          <div class="flex items-center gap-8">
            <div class="flex items-center gap-2">
              <LucideIconCn Name="@s.Icon" Size="16" Class="size-4 text-muted-foreground" />
              <span class="text-lg font-semibold tabular-nums">@s.Value</span>
              <span class="text-xs text-muted-foreground">@s.Label</span>
            </div>
            @if (s.ShowDivider)
            {
              <div class="hidden h-6 w-px bg-border sm:block"></div>
            }
          </div>
        }
      </div>
    </div>

  </div>
</section>

@code {
  private const string _installCmd = "npx create-acme-app@latest";
  private bool _copied;

  private record Stat(string Icon, string Value, string Label, bool ShowDivider);

  private static readonly Stat[] _stats =
  [
    new("star",     "32.4K", "Stars",        true),
    new("git-fork", "4.2K",  "Forks",        true),
    new("heart",    "380+",  "Contributors", false),
  ];

  private async Task HandleCopy()
  {
    _copied = true;
    await Task.Delay(2000);
    _copied = false;
  }
}
