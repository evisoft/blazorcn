@* ========================================
   Block: hero-pricing
   Title: Hero Pricing
   Description: Hero with pricing teaser, comparison highlight, and value proposition badge
   Long Description: Hero block with notification/alert style preview showing real-time updates
   Dependencies: BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-pricing.tsx
   ======================================== *@

<section class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:py-28 lg:py-36">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
          @* Left column - Content *@
          <div class="flex flex-col justify-center">
            <BadgeCn class="mb-6 w-fit gap-2" Variant="BadgeVariant.Outline">
              <LucideSparklesCn Size="12" Class="h-3.5 w-3.5 text-yellow-500" />
              Limited time offer
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
              Everything you need, at a price you&apos;ll love
            </h1>

            <p class="mb-8 text-lg text-muted-foreground">
              Get enterprise-grade features without the enterprise price tag. No hidden fees, no
              surprises—just powerful tools that help you ship faster.
            </p>

            @* Feature list *@
            <ul class="mb-8 space-y-3">
              @foreach (var feature in _features)
              {
                <li class="flex items-center gap-3">
                  <div class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/10">
                    <LucideCheckCn Size="12" Class="h-3 w-3 text-primary" />
                  </div>
                  <span class="text-muted-foreground">@feature</span>
                </li>
              }
            </ul>

            <ButtonCn class="w-full gap-2 sm:w-auto" Size="ButtonSize.Lg">
              Start Free Trial
              <LucideArrowRightCn Size="16" Class="h-4 w-4" />
            </ButtonCn>

            <p class="mt-4 text-sm text-muted-foreground">
              No credit card required. Cancel anytime.
            </p>
          </div>

          @* Right column - Pricing card *@
          <div class="flex items-center justify-center lg:justify-end">
            <CardCn class="w-full max-w-sm border-2 shadow-xl">
              <CardContentCn class="p-8">
                @* Savings badge *@
                <BadgeCn class="mb-6 bg-green-100 text-green-700 hover:bg-green-100 dark:bg-green-900/30 dark:text-green-400">
                  Save 40%
                </BadgeCn>

                @* Price display *@
                <div class="mb-6">
                  <div class="flex items-baseline gap-2">
                    <span class="text-5xl font-bold tracking-tight">$29</span>
                    <span class="text-muted-foreground">/month</span>
                  </div>
                  <p class="mt-1 text-muted-foreground">
                    <span class="text-lg line-through">$49</span>
                    <span class="ml-2">billed annually</span>
                  </p>
                </div>

                @* What's included *@
                <div class="mb-8 space-y-3">
                  <p class="text-sm font-medium">Everything included:</p>
                  <ul class="space-y-2">
                    @foreach (var feature in _features.Take(4))
                    {
                      <li class="flex items-center gap-2 text-sm">
                        <LucideCheckCn Size="16" Class="h-4 w-4 text-green-500" />
                        @feature
                      </li>
                    }
                    <li class="flex items-center gap-2 text-sm text-muted-foreground">
                      <LucideCheckCn Size="16" Class="h-4 w-4" /> + 20 more features
                    </li>
                  </ul>
                </div>

                @* CTA *@
                <ButtonCn class="w-full" Size="ButtonSize.Lg">
                  Get Started Now
                </ButtonCn>

                @* Trust signals *@
                <div class="mt-6 flex items-center justify-center gap-4 text-xs text-muted-foreground">
                  <span>14-day free trial</span>
                  <span>&#x2022;</span>
                  <span>Cancel anytime</span>
                </div>
              </CardContentCn>
            </CardCn>
          </div>
        </div>
      </div>
    </section>

@code {
    private static readonly string[] _features = new[]
    {
        "Unlimited projects",
        "Priority support",
        "Advanced analytics",
        "Custom integrations",
        "Team collaboration",
    };
}
