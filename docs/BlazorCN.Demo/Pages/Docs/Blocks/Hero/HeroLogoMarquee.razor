@* ============================================================
   Block: hero-logo-marquee
   Title: Hero Logo Marquee
   Description: Hero block with scrolling marquee of trusted company logos
   Long Description: Hero with social proof counters
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/hero/hero-logo-marquee.tsx
   ============================================================ *@

<section class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:py-28">
        @* Header *@
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <BadgeCn Class="mb-6" Variant="BadgeVariant.Secondary">
            Trusted Worldwide
          </BadgeCn>

          <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
            Powering the world's <span class="text-primary">best teams</span>
          </h1>

          <p class="mb-8 text-lg text-muted-foreground">
            From startups to Fortune 500 companies, teams everywhere trust us to power their most
            important work.
          </p>

          <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
            <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
              Join Them Today
              <LucideArrowRightCn Size="16" Class="h-4 w-4" />
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">
              View Case Studies
            </ButtonCn>
          </div>
        </div>

        @* Logo Marquee *@
        <div class="relative mt-16">
          @* Gradient overlays *@
          <div class="pointer-events-none absolute left-0 top-0 z-10 h-full w-24 bg-gradient-to-r from-background to-transparent"></div>
          <div class="pointer-events-none absolute right-0 top-0 z-10 h-full w-24 bg-gradient-to-l from-background to-transparent"></div>

          @* Row 1 - scrolling left *@
          <div class="mb-4 flex overflow-hidden">
            <div class="animate-marquee flex gap-4">
              @foreach (var logo in _LOGOS_ROW_1)
              {
                <div class="flex h-12 w-32 shrink-0 items-center justify-center rounded-lg border bg-card px-4">
                  <span class="text-sm font-semibold text-muted-foreground">@logo</span>
                </div>
              }
            </div>
            <div aria-hidden="true" class="animate-marquee flex gap-4">
              @foreach (var logo in _LOGOS_ROW_1)
              {
                <div class="flex h-12 w-32 shrink-0 items-center justify-center rounded-lg border bg-card px-4">
                  <span class="text-sm font-semibold text-muted-foreground">@logo</span>
                </div>
              }
            </div>
          </div>

          @* Row 2 - scrolling right *@
          <div class="flex overflow-hidden">
            <div class="animate-marquee-reverse flex gap-4">
              @foreach (var logo in _LOGOS_ROW_2)
              {
                <div class="flex h-12 w-32 shrink-0 items-center justify-center rounded-lg border bg-card px-4">
                  <span class="text-sm font-semibold text-muted-foreground">@logo</span>
                </div>
              }
            </div>
            <div aria-hidden="true" class="animate-marquee-reverse flex gap-4">
              @foreach (var logo in _LOGOS_ROW_2)
              {
                <div class="flex h-12 w-32 shrink-0 items-center justify-center rounded-lg border bg-card px-4">
                  <span class="text-sm font-semibold text-muted-foreground">@logo</span>
                </div>
              }
            </div>
          </div>
        </div>

        @* Stats *@
        <div class="mx-auto mt-12 flex max-w-2xl flex-wrap items-center justify-center gap-8 text-center">
          <div>
            <div class="text-3xl font-bold">500+</div>
            <div class="text-sm text-muted-foreground">Enterprise clients</div>
          </div>
          <div>
            <div class="text-3xl font-bold">50M+</div>
            <div class="text-sm text-muted-foreground">Users worldwide</div>
          </div>
          <div>
            <div class="text-3xl font-bold">99.9%</div>
            <div class="text-sm text-muted-foreground">Uptime SLA</div>
          </div>
        </div>
      </div>

      <style>
        @@keyframes marquee {
          0% {
            transform: translateX(0);
          }
          100% {
            transform: translateX(-100%);
          }
        }
        @@keyframes marquee-reverse {
          0% {
            transform: translateX(-100%);
          }
          100% {
            transform: translateX(0);
          }
        }
        .animate-marquee {
          animation: marquee 30s linear infinite;
        }
        .animate-marquee-reverse {
          animation: marquee-reverse 30s linear infinite;
        }
      </style>
    </section>

@code {
    private static readonly string[] _LOGOS_ROW_1 = new[]
    {
        "Vercel", "Stripe", "Linear", "Notion", "Figma", "GitHub", "Slack", "Discord"
    };

    private static readonly string[] _LOGOS_ROW_2 = new[]
    {
        "Shopify", "Twilio", "Supabase", "Railway", "Planetscale", "Resend", "Turso", "Neon"
    };
}
