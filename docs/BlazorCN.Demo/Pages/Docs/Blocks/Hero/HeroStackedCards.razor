@* ============================================================
   Block: hero-stacked-cards
   Title: HeroStackedCards
   Description: A centered hero with three overlapping fanned-out cards for React and Next.js featuring an announcement pill, dual ShadcnioButton CTAs, and crosshair placeholders built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-stacked-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="px-6 py-10 text-center sm:px-10 sm:py-12 lg:py-14">
            @* Announcement pill *@
            <div class="mb-5 flex justify-center">
                <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium">Introducing v3.0</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">Redesigned from scratch</span>
                    <LucideArrowUpRightCn Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            @* Headline *@
            <h1 class="mx-auto max-w-xl text-4xl font-bold tracking-tight sm:text-5xl">
                Everything your team needs, beautifully organized
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-muted-foreground sm:text-lg">
                Stop switching between apps. Every tool your team relies on lives in one platform,
                always in sync.
            </p>

            @* CTAs *@
            <div class="mt-8 flex items-center justify-center gap-3">
                <ButtonCn Class="w-[200px]">Start free trial</ButtonCn>
                <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">View demo</ButtonCn>
            </div>
        </div>

        @* Stacked cards *@
        <div class="px-6 pb-8 sm:px-10" aria-hidden="true">
            <div class="relative mx-auto flex max-w-3xl items-start justify-center">
                @foreach (var card in _cards)
                {
                    var indexVal = card.Index;
                    <div class="@Cn.Merge(indexVal == 0 ? "-mr-8" : "", indexVal == 2 ? "-ml-8" : "", card.Rotation, card.TranslateY, card.Shadow, "w-[38%] shrink-0 overflow-hidden rounded-xl border bg-card transition-transform duration-300")"
                         style="@($"z-index:{card.ZIndex}")">
                        @* Card header *@
                        <div class="flex items-center gap-1.5 border-b bg-muted/40 px-3 py-2">
                            <span class="size-1.5 rounded-full bg-muted-foreground/15"></span>
                            <span class="size-1.5 rounded-full bg-muted-foreground/15"></span>
                            <span class="size-1.5 rounded-full bg-muted-foreground/15"></span>
                            <span class="ml-1.5 text-[10px] text-muted-foreground">@card.Label</span>
                        </div>

                        @* Crosshair placeholder *@
                        <div class="flex aspect-[4/3] w-full items-center justify-center bg-muted/30">
                            <div class="relative flex items-center justify-center">
                                <div class="absolute size-14 rounded-full border border-muted-foreground/[0.06]"></div>
                                <div class="absolute size-8 rounded-full border border-muted-foreground/[0.08]"></div>
                                <div class="absolute h-px w-20 bg-muted-foreground/[0.06]"></div>
                                <div class="absolute h-20 w-px bg-muted-foreground/[0.06]"></div>
                                <div class="flex size-5 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                                    <LucideImageCn Size="10" Class="size-2.5 text-muted-foreground/40" />
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record StackedCard(int Index, string Label, string Rotation, string TranslateY, int ZIndex, string Shadow);

    private static readonly StackedCard[] _cards =
    [
        new(0, "Dashboard", "rotate-[-3deg]", "translate-y-2", 10, "shadow-md"),
        new(1, "Analytics", "rotate-0", "-translate-y-1", 20, "shadow-lg"),
        new(2, "Reports", "rotate-[3deg]", "translate-y-2", 10, "shadow-md"),
    ];
}
