@* ============================================================
   Block: hero-centered-star-rating
   Title: HeroCenteredStarRating
   Description: A centered hero with a five-star rating display, numeric score, review-platform badge row, and featured review footer for React and Next.js built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/hero/hero-centered-star-rating.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="px-6 py-8 text-center sm:px-8 sm:py-10 lg:px-12 lg:py-12">
      @* Rating display *@
      <div class="mb-6 flex flex-col items-center gap-2">
        <div class="flex items-center gap-3">
          @* StarRating for RATING (default size) *@
          <div class="flex items-center gap-0.5" role="img" aria-label="@($"Rated {_RATING} out of 5 stars")">
            @foreach (var star in _stars)
            {
              var starVal = star;
              <LucideStarCn
                aria-hidden="true"
                Size="20"
                Class="@Cn.Merge("size-5", starVal <= (int)Math.Round(_RATING) ? "fill-foreground text-foreground" : "fill-muted text-muted")" />
            }
          </div>
          <span class="text-2xl font-semibold tabular-nums">@_RATING</span>
        </div>
        <p class="text-sm text-muted-foreground">
          Based on @_TOTAL_REVIEWS.ToString("N0") verified reviews
        </p>
      </div>

      @* Headline *@
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        The top-rated platform<br />for modern teams
      </h1>

      @* Subtitle *@
      <p class="mx-auto mt-4 max-w-lg text-lg leading-relaxed text-muted-foreground">
        Thousands of teams trust us to streamline their workflows. See why we&apos;re the
        highest-rated solution in our category.
      </p>

      @* Platform badges *@
      <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
        @foreach (var platform in _platforms)
        {
          <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1.5 px-3 py-1 text-xs">
            <LucideStarCn Size="12" Class="size-3 fill-foreground text-foreground" aria-hidden="true" />
            @platform.Name
            <span class="text-muted-foreground">@platform.Score</span>
          </BadgeCn>
        }
      </div>

      @* CTAs *@
      <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <ButtonCn Class="w-[200px]">Start free trial</ButtonCn>
        <ButtonCn Class="w-[170px]" Variant="ButtonVariant.Ghost">Read all reviews</ButtonCn>
      </div>
    </div>

    @* Featured review *@
    <div class="border-t bg-muted/30 px-6 py-6 sm:px-10">
      <div class="mx-auto max-w-lg text-center">
        @* StarRating for REVIEW (small size) *@
        <div class="flex items-center gap-0.5" role="img" aria-label="@($"Rated {_review.Stars} out of 5 stars")">
          @foreach (var star in _stars)
          {
            var starVal = star;
            <LucideStarCn
              aria-hidden="true"
              Size="14"
              Class="@Cn.Merge("size-3.5", starVal <= _review.Stars ? "fill-foreground text-foreground" : "fill-muted text-muted")" />
          }
        </div>
        <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
          &ldquo;@_review.Text&rdquo;
        </p>
        <p class="mt-2 text-xs text-muted-foreground">
          @_review.Author, @_review.Role
        </p>
      </div>
    </div>
  </div>
</section>

@code {
    private const double _RATING = 4.9;
    private const int _TOTAL_REVIEWS = 3241;

    private static readonly int[] _stars = [1, 2, 3, 4, 5];

    private record Platform(string Name, string Score);

    private static readonly Platform[] _platforms =
    [
        new("G2 Leader 2026", "4.9"),
        new("Capterra Top Rated", "4.8"),
        new("Trustpilot Excellent", "4.9"),
    ];

    private record ReviewItem(string Text, string Author, string Role, int Stars);

    private static readonly ReviewItem _review = new(
        "Switched our entire team over in a single afternoon. The onboarding experience is the best I have seen in enterprise software.",
        "James Thornton",
        "CTO at Arcline",
        5
    );
}
