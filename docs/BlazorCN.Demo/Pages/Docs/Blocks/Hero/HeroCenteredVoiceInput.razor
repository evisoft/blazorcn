@* ============================================================
   Block: hero-centered-voice-input
   Title: HeroCenteredVoiceInput
   Description: A centered hero with a voice input widget mockup for React and Next.js featuring an announcement pill, headline, dual ShadcnioButton CTAs, a pulsing microphone button, and an animated waveform visualizer built with shadcn/ui and Tailwind CSS
   Source: original/blocks/hero/hero-centered-voice-input.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        <div class="px-6 py-10 text-center sm:px-8 sm:py-12 lg:px-12">
            @* Announcement pill *@
            <div class="mb-6 flex justify-center">
                <a href="#" class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs transition-colors hover:bg-muted">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium">New</span>
                    <span class="text-muted-foreground">&middot;</span>
                    <span class="text-muted-foreground">Real-time transcription is live</span>
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                </a>
            </div>

            @* Headline *@
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                Just say it.
                <br />
                We&apos;ll handle the rest.
            </h1>

            @* Subtitle *@
            <p class="mx-auto mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                Speak naturally in 40+ languages and get clean, punctuated text in under a second.
            </p>

            @* CTAs *@
            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <ButtonCn Class="w-[180px]">Try it free</ButtonCn>
                <ButtonCn Class="w-[150px]" Variant="ButtonVariant.Ghost">Learn more</ButtonCn>
            </div>

            @* Voice input widget *@
            <div aria-hidden="true" class="mt-10 flex justify-center">
                <div class="flex w-full max-w-md items-center gap-4 rounded-2xl border bg-muted/50 px-4 py-3">
                    @* Microphone button with pulsing active ring *@
                    <div class="relative flex shrink-0 items-center justify-center">
                        @* Pulsing outer ring *@
                        <span class="absolute inline-block size-12 animate-ping rounded-full bg-foreground/10"></span>
                        @* Mic button *@
                        <span class="relative flex size-11 animate-pulse items-center justify-center rounded-full bg-foreground text-background shadow-sm ring-4 ring-foreground/10">
                            <LucideIconCn Name="mic" Size="16" Class="size-4" />
                        </span>
                    </div>

                    @* Waveform + label *@
                    <div class="flex min-w-0 flex-1 flex-col gap-1.5">
                        @* Waveform *@
                        <div class="flex h-8 items-center gap-[3px]">
                            @foreach (var bar in _waveformBars)
                            {
                                <span class="inline-block w-[3px] animate-pulse rounded-full bg-foreground/70"
                                      style="@($"height:{bar.BaseHeight}%;animation-delay:{bar.Delay}s")"></span>
                            }
                        </div>

                        @* Listening label *@
                        <div class="flex items-center gap-2">
                            <span class="inline-block size-1.5 animate-pulse rounded-full bg-emerald-500"></span>
                            <span class="text-xs font-medium text-muted-foreground">Listening&#8230;</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record WaveformBar(string Id, int BaseHeight, double Delay);

    private static readonly WaveformBar[] _waveformBars =
    [
        new("b01", 30, 0),
        new("b02", 55, 0.05),
        new("b03", 80, 0.1),
        new("b04", 45, 0.15),
        new("b05", 65, 0.2),
        new("b06", 90, 0.25),
        new("b07", 50, 0.3),
        new("b08", 35, 0.35),
        new("b09", 70, 0.4),
        new("b10", 85, 0.45),
        new("b11", 60, 0.5),
        new("b12", 40, 0.55),
        new("b13", 75, 0.6),
        new("b14", 95, 0.05),
        new("b15", 55, 0.1),
        new("b16", 30, 0.15),
        new("b17", 65, 0.2),
        new("b18", 80, 0.25),
        new("b19", 45, 0.3),
        new("b20", 70, 0.35),
        new("b21", 55, 0.4),
        new("b22", 35, 0.45),
        new("b23", 60, 0.5),
        new("b24", 40, 0.55),
    ];
}
