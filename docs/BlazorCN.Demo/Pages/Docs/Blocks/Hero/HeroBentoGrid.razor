@* ========================================
   Block: hero-bento-grid
   Title: Hero Bento Grid
   Description: Hero block with bento-style grid showcasing multiple features
   Dependencies: BadgeCn, ButtonCn, CardCn
   Source: original/blocks/hero/hero-bento-grid.tsx
   ======================================== *@

<section class="relative overflow-hidden">
    <div class="container mx-auto px-4 py-20 md:py-28">
        <div class="mx-auto mb-12 max-w-3xl text-center">
            <BadgeCn Class="mb-6" Variant="BadgeVariant.Secondary">
                All-in-One Platform
            </BadgeCn>

            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">
                Everything you need to <span class="text-primary">succeed</span>
            </h1>

            <p class="mb-8 text-lg text-muted-foreground">
                A complete toolkit designed to help you build, launch, and scale your product faster
                than ever.
            </p>

            <ButtonCn Class="gap-2" Size="ButtonSize.Lg">
                Get Started
                <LucideArrowRightCn Size="16" Class="h-4 w-4" />
            </ButtonCn>
        </div>

        <div class="mx-auto max-w-5xl">
            <div class="grid gap-4 md:grid-cols-4">
                @foreach (var feature in _features)
                {
                    <CardCn Class="@(feature.Size == "large" ? "md:col-span-2" : "md:col-span-1")">
                        <CardContentCn Class="flex h-full flex-col p-6">
                            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
                                <span class="text-sm font-bold text-primary">@feature.Icon</span>
                            </div>
                            <h3 class="mb-2 font-semibold">@feature.Title</h3>
                            <p class="text-sm text-muted-foreground">@feature.Description</p>
                        </CardContentCn>
                    </CardCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record FeatureItem(string Icon, string Title, string Description, string Size);

    private static readonly FeatureItem[] _features =
    [
        new("\u26a1", "Lightning Fast", "Sub-millisecond response times with our globally distributed edge network.", "large"),
        new("\ud83d\udee1\ufe0f", "Secure by Default", "Enterprise-grade security built in.", "small"),
        new("\ud83d\udcca", "Real-time Analytics", "Instant insights into your data.", "small"),
        new("\ud83d\udc65", "Team Collaboration", "Work together seamlessly with real-time sync and commenting.", "large"),
        new("\u23f0", "24/7 Support", "Always here to help.", "small"),
        new("\u2728", "AI Powered", "Smart suggestions everywhere.", "small"),
    ];
}
