@* ============================================================
   Block: kanban-conversion-tracker
   Title: KanbanConversionTracker
   Description: React conversion optimization dashboard kanban for Next.js with experiment metrics, A/B test tracking, uplift percentages, and mini kanban columns using shadcn/ui, CountUp, and Tailwind CSS
   Source: original/blocks/kanban/kanban-conversion-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="flask-conical" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Conversion Tracker</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_experiments.Length experiments
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_winCount wins
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @(_concluded.Length - _winCount) losses
                </span>
            </div>
        </div>

        @* Metrics Grid *@
        <div class="grid grid-cols-2 gap-3 border-b p-4 sm:grid-cols-4">
            @* Conversion Rate *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">Conversion Rate</span>
                </div>
                <span class="font-semibold text-2xl tabular-nums text-emerald-600 dark:text-emerald-400">
                    @(_overallConversion.ToString("F1"))%
                </span>
            </div>
            @* A/B Test Wins *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">A/B Test Wins</span>
                </div>
                <span class="font-semibold text-2xl tabular-nums text-foreground">
                    @_winCount
                </span>
            </div>
            @* Running *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="flask-conical" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">Running</span>
                </div>
                <span class="font-semibold text-2xl tabular-nums text-amber-600 dark:text-amber-400">
                    @_runningCount
                </span>
            </div>
            @* Avg Uplift *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="beaker" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">Avg Uplift</span>
                </div>
                <span class="font-semibold text-2xl tabular-nums text-emerald-600 dark:text-emerald-400">
                    +@(_avgUplift.ToString("F1"))%
                </span>
            </div>
        </div>

        @* Experiment Completion Progress *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Experiment completion</span>
                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                    @_concluded.Length / @_experiments.Length concluded
                </span>
            </div>
            <div class="cn-progress relative flex h-2 w-full items-center overflow-x-hidden"
                 role="progressbar"
                 aria-valuenow="@_completionRate"
                 aria-valuemin="0"
                 aria-valuemax="100">
                <div class="cn-progress-indicator h-full bg-blue-500 transition-all duration-700"
                     style="@($"width:{_completionRate}%")">
                </div>
            </div>
        </div>

        @* Mini Kanban Board *@
        <div class="border-b p-4">
            <div class="grid grid-cols-3 gap-3">
                @foreach (var col in _columns)
                {
                    var colExperiments = _experiments.Where(e => e.Stage == col.Id).ToArray();
                    <div class="rounded-md border">
                        @* Column Header *@
                        <div class="flex items-center gap-1.5 border-b px-2.5 py-2">
                            <span class="@Cn.Merge("size-1.5 rounded-full", col.Dot)"></span>
                            <span class="font-medium text-xs">@col.Label</span>
                            <span class="ml-auto font-mono text-muted-foreground/60 text-[10px] tabular-nums">
                                @colExperiments.Length
                            </span>
                        </div>
                        @* Mini Cards *@
                        <div class="flex flex-col gap-0.5 p-1.5">
                            @foreach (var exp in colExperiments)
                            {
                                <div class="flex items-center gap-1.5 rounded px-2 py-1.5 transition-colors hover:bg-muted/50">
                                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", GetDotColor(exp))"></span>
                                    <span class="min-w-0 flex-1 truncate text-xs">@exp.Name</span>
                                    @if (exp.Uplift != 0)
                                    {
                                        <span class="@Cn.Merge("shrink-0 font-mono text-[10px] tabular-nums", exp.Uplift > 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                            @(exp.Uplift > 0 ? "+" : "")@(exp.Uplift)%
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                3 stages · @_winCount/@_concluded.Length win rate
            </span>
            <span class="font-mono text-muted-foreground/60 text-xs tabular-nums">
                +@(_avgUplift.ToString("F1"))% avg uplift
            </span>
        </div>
    </div>
</section>

@code {
    private record Experiment(string Id, string Name, string Stage, double Uplift, bool? IsWinner, string Page);
    private record KanbanColumn(string Id, string Label, string Dot);

    private static readonly Experiment[] _experiments =
    [
        new("e1", "CTA button color red vs blue", "hypothesis", 0,    null,  "/pricing"),
        new("e2", "Hero headline A vs B",          "hypothesis", 0,    null,  "/home"),
        new("e3", "Shorter checkout form",         "hypothesis", 0,    null,  "/checkout"),
        new("e4", "Social proof badges",           "testing",    4.2,  null,  "/product"),
        new("e5", "Sticky add-to-cart bar",        "testing",    2.8,  null,  "/product"),
        new("e6", "One-click upsell modal",        "testing",    1.5,  null,  "/cart"),
        new("e7", "Trust seal placement",          "concluded",  6.1,  true,  "/checkout"),
        new("e8", "Video testimonials",            "concluded",  3.8,  true,  "/home"),
        new("e9", "Exit intent popup",             "concluded",  -1.2, false, "/pricing"),
    ];

    private static readonly KanbanColumn[] _columns =
    [
        new("hypothesis", "Hypothesis", "bg-blue-500"),
        new("testing",    "Testing",    "bg-amber-500"),
        new("concluded",  "Concluded",  "bg-emerald-500"),
    ];

    private Experiment[] _concluded    => _experiments.Where(e => e.Stage == "concluded").ToArray();
    private Experiment[] _winners      => _concluded.Where(e => e.IsWinner == true).ToArray();
    private Experiment[] _testing      => _experiments.Where(e => e.Stage == "testing").ToArray();
    private int          _winCount     => _winners.Length;
    private int          _runningCount => _testing.Length;
    private double       _avgUplift    => _winners.Length > 0 ? _winners.Sum(e => e.Uplift) / _winners.Length : 0;
    private double       _overallConversion => 3.2 + _avgUplift;
    private int          _completionRate    => (int)Math.Round((double)_concluded.Length / _experiments.Length * 100);

    private static string GetDotColor(Experiment exp)
    {
        if (exp.Stage == "concluded")
            return exp.IsWinner == true ? "bg-emerald-500" : "bg-red-500";
        if (exp.Stage == "testing")
            return "bg-amber-500";
        return "bg-blue-500";
    }
}
