@* ============================================================
   Block: kanban-prospect-manager
   Title: KanbanProspectManager
   Description: React sales prospect kanban for Next.js with ultra-compact cards, HoverCard detail popups showing company, role, last interaction, interest level, deal potential, and notes using shadcn/ui HoverCard and Tailwind CSS.
   Source: original/blocks/kanban/kanban-prospect-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Prospect Manager</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_prospects.Length prospects
                </BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs">Hover to preview</span>
        </div>

        @* Columns *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var col in _columns)
            {
                var colProspects = _prospects.Where(p => p.Stage == col.Stage).ToArray();
                <div>
                    @* Column Header *@
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", col.Dot)"></span>
                        <span class="font-medium text-xs">@col.Label</span>
                        <span class="ml-auto font-mono text-[10px] text-muted-foreground/60 tabular-nums">
                            @colProspects.Length
                        </span>
                    </div>

                    @* Cards *@
                    <div>
                        @for (var i = 0; i < colProspects.Length; i++)
                        {
                            var prospect = colProspects[i];
                            var isLast = i == colProspects.Length - 1;
                            <HoverCardCn OpenDelay="200" CloseDelay="100">
                                <HoverCardTriggerCn Class="block w-full">
                                    <div class="@Cn.Merge("flex w-full cursor-default items-center gap-2 px-3 py-2 text-left transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full opacity-40", col.Dot)"></span>
                                        <span class="min-w-0 flex-1 truncate text-xs">@prospect.Name</span>
                                        <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium text-muted-foreground">
                                            @prospect.Initials
                                        </span>
                                    </div>
                                </HoverCardTriggerCn>
                                <HoverCardContentCn Side="FloatingSide.Right" Align="FloatingAlign.Start" Class="w-72 p-0">
                                    <div class="border-b px-3 py-2.5">
                                        <span class="font-medium text-sm">@prospect.Name</span>
                                        <div class="mt-0.5 flex items-center gap-1.5 text-muted-foreground text-xs">
                                            <span>@prospect.Role</span>
                                            <span>at</span>
                                            <span class="font-medium text-foreground">@prospect.Company</span>
                                        </div>
                                    </div>
                                    <div class="space-y-2 px-3 py-2.5">
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Last interaction</span>
                                            <span class="font-medium">@prospect.LastInteraction</span>
                                        </div>
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Interest level</span>
                                            <span class="flex items-center gap-1.5 font-medium">
                                                <span class="@Cn.Merge("size-1.5 rounded-full", GetInterestDot(prospect.Interest))"></span>
                                                @prospect.Interest
                                            </span>
                                        </div>
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Deal potential</span>
                                            <span class="font-medium tabular-nums">@prospect.DealPotential</span>
                                        </div>
                                    </div>
                                    <div class="border-t bg-muted/30 px-3 py-2">
                                        <span class="text-muted-foreground text-xs">Notes</span>
                                        <p class="mt-0.5 text-xs leading-relaxed">@prospect.Notes</p>
                                    </div>
                                </HoverCardContentCn>
                            </HoverCardCn>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_prospects.Count(p => p.Stage == "hot") hot prospects
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 8 min ago</span>
        </div>
    </div>
</section>

@code {
