@* ============================================================
   Block: kanban-inventory-flow
   Title: KanbanInventoryFlow
   Description: React split-panel inventory kanban for Next.js with order tracking columns, shipment details, SKU metadata, and supplier info using shadcn/ui and Tailwind CSS.
   Source: original/blocks/kanban/kanban-inventory-flow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Inventory Flow</h2>
            <span class="text-xs text-muted-foreground">@_items.Length items</span>
            <span class="text-xs text-muted-foreground">·</span>
            <span class="text-xs text-muted-foreground">
                @(_items.Sum(i => i.Quantity).ToString("N0")) total units
            </span>
        </div>

        @* Board + Detail *@
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr_1fr_minmax(280px,1.2fr)]">
            @* Columns *@
            @foreach (var col in _columns)
            {
                var colStatus = col.Status;
                var colItems = _items.Where(i => i.Status == colStatus).ToArray();
                var colIdx = System.Array.IndexOf(_columns, col);
                <div class="@Cn.Merge("min-h-[500px] bg-card", colIdx < 2 ? "border-r" : "")">
                    <div class="flex items-center gap-2 border-b px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", GetStatusDot(colStatus))"></span>
                        <span class="text-xs font-medium">@col.Label</span>
                        <span class="ml-auto text-xs text-muted-foreground">@colItems.Length</span>
                    </div>
                    <div class="divide-y">
                        @foreach (var it in colItems)
                        {
                            var item = it;
                            <button type="button" @onclick="@(() => _selectedId = item.Id)"
                                class="@Cn.Merge("flex w-full items-center gap-2.5 px-3 py-2.5 text-left transition-colors hover:bg-muted/50", _selectedId == item.Id ? "bg-muted/50 ring-2 ring-foreground ring-inset" : "")">
                                <span class="min-w-0 flex-1">
                                    <span class="block truncate text-sm font-medium">@item.Name</span>
                                    <span class="block font-mono text-xs text-muted-foreground">@item.Sku</span>
                                </span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs font-normal tabular-nums">
                                    @item.Quantity
                                </BadgeCn>
                            </button>
                        }
                    </div>
                </div>
            }

            @* Detail Panel *@
            <div class="min-h-[500px] border-l bg-muted/20">
                @{
                    var selected = _items.FirstOrDefault(i => i.Id == _selectedId);
                }
                @if (selected != null)
                {
                    <div>
                        <div class="border-b px-4 py-3">
                            <h3 class="text-sm font-medium">@selected.Name</h3>
                            <div class="mt-1.5 flex items-center gap-2">
                                <span class="@Cn.Merge("size-1.5 rounded-full", GetStatusDot(selected.Status))"></span>
                                <span class="text-xs text-muted-foreground capitalize">
                                    @selected.Status.Replace("-", " ")
                                </span>
                                <span class="text-xs text-muted-foreground">·</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                    @selected.Category
                                </BadgeCn>
                            </div>
                        </div>

                        <div class="border-b px-4 py-3">
                            <div class="space-y-2.5">
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideIconCn Name="hash" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">SKU</span>
                                    <span class="ml-auto font-mono font-medium">@selected.Sku</span>
                                </div>
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideIconCn Name="box" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">Quantity</span>
                                    <span class="ml-auto font-medium tabular-nums">
                                        @selected.Quantity.ToString("N0") @selected.Unit
                                    </span>
                                </div>
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideIconCn Name="warehouse" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">Supplier</span>
                                    <span class="ml-auto font-medium">@selected.Supplier</span>
                                </div>
                            </div>
                        </div>

                        <div class="border-b px-4 py-3">
                            <div class="space-y-2.5">
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideIconCn Name="truck" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">Tracking</span>
                                    <span class="ml-auto font-mono font-medium">
                                        @if (selected.TrackingNumber == "Pending")
                                        {
                                            <span class="text-muted-foreground">Pending</span>
                                        }
                                        else
                                        {
                                            @selected.TrackingNumber
                                        }
                                    </span>
                                </div>
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">
                                        @(selected.Status == "received" ? "Received" : "Expected")
                                    </span>
                                    <span class="ml-auto font-medium">@selected.ExpectedDate</span>
                                </div>
                            </div>
                        </div>

                        <div class="border-b px-4 py-3">
                            <span class="text-xs font-medium text-muted-foreground">Shipment timeline</span>
                            <div class="mt-3 space-y-3">
                                @{
                                    var statusOrder = new System.Collections.Generic.Dictionary<string, int>
                                    {
                                        ["ordered"] = 0,
                                        ["in-transit"] = 1,
                                        ["received"] = 2,
                                    };
                                    var stepLabels = new System.Collections.Generic.Dictionary<string, string>
                                    {
                                        ["ordered"] = "Order placed",
                                        ["in-transit"] = "Shipped",
                                        ["received"] = "Delivered",
                                    };
                                    var currentStep = statusOrder.TryGetValue(selected.Status, out var cs) ? cs : 0;
                                }
                                @foreach (var stepEntry in _timelineSteps)
                                {
                                    var step = stepEntry;
                                    var stepIdx = statusOrder.TryGetValue(step, out var si) ? si : 0;
                                    var isComplete = stepIdx <= currentStep;
                                    var stepLabel = stepLabels.TryGetValue(step, out var sl) ? sl : step;
                                    <div class="flex items-center gap-3">
                                        <span class="@Cn.Merge("size-2 rounded-full", isComplete ? GetStatusDot(step) : "bg-muted")"></span>
                                        <span class="@Cn.Merge("text-xs", isComplete ? "font-medium" : "text-muted-foreground")">
                                            @stepLabel
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="flex gap-2 px-4 py-3">
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View shipment</ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">Edit item</ButtonCn>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex h-[500px] items-center justify-center px-4">
                        <p class="text-sm text-muted-foreground">Select an item to view details</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private string? _selectedId = "i4";

    private static readonly string[] _timelineSteps = ["ordered", "in-transit", "received"];

    private record InventoryItem(
        string Id,
        string Name,
        string Sku,
        int Quantity,
        string Unit,
        string Supplier,
        string Status,
        string TrackingNumber,
        string ExpectedDate,
        string Category
    );

    private record ColumnDef(string Status, string Label);

    private static readonly InventoryItem[] _items =
    [
        new("i1",  "Brushless DC Motor 48V",       "MTR-48V-BL-200",     150,  "units",  "Shenzhen MotoTech",     "ordered",    "Pending",             "Apr 22", "Electronics"),
        new("i2",  "Stainless Steel Bearings 6205", "BRG-SS-6205-ZZ",     500,  "units",  "Koyo Industrial",       "ordered",    "Pending",             "Apr 18", "Mechanical"),
        new("i3",  "Lithium Polymer Cells 3.7V",    "BAT-LIPO-3700",      2000, "cells",  "EVE Energy",            "ordered",    "Pending",             "Apr 25", "Power"),
        new("i4",  "Aluminum Heatsink Profile",     "HSK-AL-6063-T5",     300,  "meters", "Alcoa Extrusion",       "in-transit", "1Z999AA10123456784",  "Apr 10", "Thermal"),
        new("i5",  "Silicone Gasket Sheet 2mm",     "GSK-SI-2MM-RED",     80,   "sheets", "Freudenberg Sealing",   "in-transit", "794644790132",        "Apr 8",  "Sealing"),
        new("i6",  "PCB Assembly - Control Board",  "PCB-CTRL-V4-REV2",   250,  "boards", "JLCPCB",                "in-transit", "SF1234567890",        "Apr 12", "Electronics"),
        new("i7",  "Nylon Cable Ties 200mm",        "CBL-TIE-NYL-200",    5000, "pieces", "HellermannTyton",       "in-transit", "3SXYZ1234567",        "Apr 9",  "Fasteners"),
        new("i8",  "Epoxy Resin ER-4210",           "CHM-EPX-4210-1L",    120,  "liters", "Huntsman Advanced",     "received",   "1Z999AA10198765432",  "Mar 28", "Chemicals"),
        new("i9",  "Copper Bus Bar 10x40mm",        "COP-BAR-10X40-C110", 60,   "meters", "Luvata",                "received",   "794644790456",        "Mar 25", "Electrical"),
        new("i10", "Vibration Dampener Mounts",     "VBR-MNT-M8-45SH",   400,  "units",  "Trelleborg",            "received",   "SF9876543210",        "Mar 22", "Mechanical"),
    ];

    private static readonly ColumnDef[] _columns =
    [
        new("ordered",    "Ordered"),
        new("in-transit", "In Transit"),
        new("received",   "Received"),
    ];

    private static string GetStatusDot(string status) => status switch
    {
        "ordered"    => "bg-blue-500",
        "in-transit" => "bg-amber-500",
        "received"   => "bg-emerald-500",
        _            => "",
    };
}
