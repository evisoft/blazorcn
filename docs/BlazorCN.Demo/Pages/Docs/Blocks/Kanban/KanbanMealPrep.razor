@* ============================================================
   Block: kanban-meal-prep
   Title: KanbanMealPrep
   Description: React kanban meal prep planner for Next.js with vertical accordion columns, meal type badges, prep times, serving counts, and staggered animations using shadcn/ui Accordion and Tailwind CSS
   Source: original/blocks/kanban/kanban-meal-prep.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Meal Prep</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_meals.Length meals
                </BadgeCn>
            </div>
            <div class="flex items-center gap-2">
                <span class="font-semibold text-sm tabular-nums">@_totalServings</span>
                <span class="text-muted-foreground text-xs">servings ready</span>
            </div>
        </div>

        @* Accordion columns *@
        <div class="px-4 py-3">
            <AccordionCn>
                @foreach (var col in _columns)
                {
                    var colMeals = _meals.Where(m => m.Status == col.Id).ToArray();
                    var colServings = colMeals.Sum(m => m.Servings);
                    var isEaten = col.Id == "eaten";
                    var isDefault = col.Id == "prepping";
                    <AccordionItemCn DefaultOpen="@isDefault">
                        <AccordionTriggerCn Class="py-3 hover:no-underline">
                            <div class="flex items-center gap-2">
                                <span class="text-muted-foreground">
                                    <LucideIconCn Name="@col.Icon" Size="14" Class="size-3.5" />
                                </span>
                                <span class="font-medium text-sm">@col.Label</span>
                                <span class="text-muted-foreground/60 text-xs">@colMeals.Length</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs tabular-nums">@colServings srv</span>
                            </div>
                        </AccordionTriggerCn>
                        <AccordionContentCn Class="pb-2">
                            <div class="overflow-hidden rounded-md border">
                                @for (var i = 0; i < colMeals.Length; i++)
                                {
                                    var meal = colMeals[i];
                                    var isLast = i == colMeals.Length - 1;
                                    var dotClass = col.Dot;
                                    var titleClass = isEaten ? "text-muted-foreground line-through" : "font-medium";
                                    var typeColor = MealTypeColor(meal.Type);
                                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dotClass)"></span>
                                        <div class="min-w-0 flex-1">
                                            <span class="@Cn.Merge("block truncate text-sm", titleClass)">@meal.Title</span>
                                            <span class="text-muted-foreground/60 text-xs">@meal.PrepTime · @meal.Servings @(meal.Servings == 1 ? "serving" : "servings")</span>
                                        </div>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("shrink-0 font-normal text-[10px]", typeColor)">
                                            @meal.Type
                                        </BadgeCn>
                                    </div>
                                }
                            </div>
                        </AccordionContentCn>
                    </AccordionItemCn>
                }
            </AccordionCn>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <div class="flex items-center gap-3">
                @foreach (var col in _columns)
                {
                    var colCount = _meals.Count(m => m.Status == col.Id);
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", col.Dot)"></span>
                        @colCount
                    </span>
                }
            </div>
            <span class="text-muted-foreground/60 text-xs">Week of Mar 24</span>
        </div>
    </div>
</section>

@code {
    private record Meal(string Id, string Title, string Status, string Type, string PrepTime, int Servings);
    private record Column(string Id, string Label, string Icon, string Dot);

    private static readonly Meal[] _meals =
    [
        new("1",  "Overnight oats with berries",      "ideas",    "Breakfast", "10 min", 2),
        new("2",  "Thai basil chicken stir-fry",      "ideas",    "Dinner",    "25 min", 4),
        new("3",  "Greek yogurt parfait",             "ideas",    "Snack",     "5 min",  1),
        new("4",  "Chicken Caesar salad wraps",       "prepping", "Lunch",     "15 min", 3),
        new("5",  "Banana protein pancakes",          "prepping", "Breakfast", "20 min", 4),
        new("6",  "Salmon teriyaki bowl",             "prepping", "Dinner",    "30 min", 2),
        new("7",  "Turkey meatball marinara",         "ready",    "Dinner",    "35 min", 6),
        new("8",  "Quinoa veggie power bowl",         "ready",    "Lunch",     "20 min", 4),
        new("9",  "Egg muffin cups",                  "ready",    "Breakfast", "25 min", 6),
        new("10", "Lemon herb grilled chicken",       "eaten",    "Dinner",    "30 min", 4),
        new("11", "Mediterranean hummus plate",       "eaten",    "Lunch",     "10 min", 2),
    ];

    private static readonly Column[] _columns =
    [
        new("ideas",    "Recipe Ideas", "lightbulb",       "bg-zinc-400"),
        new("prepping", "Prepping",     "cooking-pot",     "bg-amber-500"),
        new("ready",    "Ready",        "package-check",   "bg-emerald-500"),
        new("eaten",    "Eaten",        "utensils-crossed","bg-blue-500"),
    ];

    private int _totalServings => _meals.Where(m => m.Status == "ready").Sum(m => m.Servings);

    private static string MealTypeColor(string type) => type switch
    {
        "Breakfast" => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        "Lunch"     => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        "Dinner"    => "bg-violet-500/10 text-violet-700 dark:text-violet-400",
        "Snack"     => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        _           => ""
    };
}
