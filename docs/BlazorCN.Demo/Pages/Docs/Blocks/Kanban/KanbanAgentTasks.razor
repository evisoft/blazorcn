@* ============================================================
   Block: kanban-agent-tasks
   Title: KanbanAgentTasks
   Description: React kanban support agent task swimlane board for Next.js with avatar rows, ticket priority dots, customer names, and resolution tracking using shadcn/ui Avatar and Tailwind CSS
   Source: original/blocks/kanban/kanban-agent-tasks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Support Queue</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_tickets.Length tickets · @_tickets.Count(t => t.Status == "resolved") resolved
                    </p>
                </div>
                <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        Urgent
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        High
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-blue-500"></span>
                        Normal
                    </span>
                </div>
            </div>
        </div>

        @* Column headers *@
        <div class="grid grid-cols-[160px_1fr_1fr_1fr_1fr_48px] border-b bg-muted/30">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Agent</span>
            </div>
            @foreach (var s in _statuses)
            {
                <div class="px-3 py-2">
                    <span class="font-medium text-muted-foreground text-xs">@s.Label</span>
                </div>
            }
            <div class="px-2 py-2">
                <span class="font-medium text-muted-foreground text-xs">#</span>
            </div>
        </div>

        @* Swimlane rows *@
        <div>
            @for (var i = 0; i < _agents.Length; i++)
            {
                var agent = _agents[i];
                var isLast = i == _agents.Length - 1;
                var agentTickets = _tickets.Where(t => t.AgentId == agent.Id).ToArray();
                <div class="@Cn.Merge("grid grid-cols-[160px_1fr_1fr_1fr_1fr_48px] items-start", !isLast ? "border-b" : "")">
                    @* Avatar cell *@
                    <div class="flex items-center gap-2.5 px-4 py-3">
                        <AvatarCn Class="size-7">
                            <AvatarFallbackCn Class="text-[10px]">@agent.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0">
                            <p class="truncate font-medium text-sm">@agent.Name</p>
                            <p class="truncate text-muted-foreground text-xs">@agent.Team</p>
                        </div>
                    </div>

                    @* Status cells *@
                    @foreach (var s in _statuses)
                    {
                        var cellTickets = agentTickets.Where(t => t.Status == s.Key).ToArray();
                        <div class="min-h-[60px] px-2 py-2.5">
                            @if (cellTickets.Length > 0)
                            {
                                <div class="flex flex-col gap-1.5">
                                    @foreach (var ticket in cellTickets)
                                    {
                                        <div class="flex items-center gap-2 rounded-md bg-muted/50 px-2.5 py-1.5 transition-colors hover:bg-muted">
                                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", PriorityDotClass(ticket.Priority))"></span>
                                            <div class="flex min-w-0 flex-1 items-center gap-1.5">
                                                <span class="shrink-0 font-mono text-muted-foreground text-[10px]">@ticket.TicketId</span>
                                                <span class="truncate text-xs">@ticket.Title</span>
                                            </div>
                                            <span class="shrink-0 text-muted-foreground text-[10px]">@ticket.Customer</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="flex min-h-[36px] items-center justify-center rounded-md border border-dashed border-muted-foreground/20">
                                    <span class="text-muted-foreground/40 text-xs">—</span>
                                </div>
                            }
                        </div>
                    }

                    @* Count cell *@
                    <div class="flex items-center justify-center py-3">
                        <span class="font-medium text-muted-foreground text-xs tabular-nums">@agentTickets.Length</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StatusItem(string Key, string Label);
    private record AgentItem(string Id, string Name, string Initials, string Team);
    private record TicketItem(string Id, string TicketId, string Title, string AgentId, string Status, string Priority, string Customer);

    private static readonly StatusItem[] _statuses =
    [
        new("queue", "Queue"),
        new("active", "Active"),
        new("waiting", "Waiting"),
        new("resolved", "Resolved"),
