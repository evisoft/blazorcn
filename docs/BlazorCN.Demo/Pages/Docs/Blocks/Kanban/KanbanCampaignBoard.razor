@* ============================================================
   Block: kanban-campaign-board
   Title: KanbanCampaignBoard
   Description: React kanban board for Next.js with marketing campaign columns, budget tracking, and a Sheet side panel showing channel mix, KPIs, performance metrics, and timeline using shadcn/ui Sheet and Tailwind CSS.
   Source: original/blocks/kanban/kanban-campaign-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="megaphone" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Campaign Board</h2>
            <span class="text-xs text-muted-foreground">@_campaigns.Length campaigns</span>
            <span class="text-xs text-muted-foreground">·</span>
            <span class="text-xs text-muted-foreground">
                @FormatCurrency(_campaigns.Sum(c => c.Budget)) total budget
            </span>
        </div>

        @* Kanban columns *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var col in _columns)
            {
                var colCampaigns = _campaigns.Where(c => c.Stage == col.Stage).ToArray();
                var colBudget = colCampaigns.Sum(c => c.Budget);
                <div class="min-h-[480px]">
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", StageDotClass(col.Stage))"></span>
                        <span class="text-xs font-medium">@col.Label</span>
                        <span class="ml-auto text-xs text-muted-foreground tabular-nums">
                            @FormatCurrency(colBudget)
                        </span>
                    </div>
                    <div class="divide-y">
                        @foreach (var campaign in colCampaigns)
                        {
                            var camp = campaign;
                            <button type="button"
                                    @onclick="@(() => _selectedId = camp.Id)"
                                    class="@Cn.Merge("flex w-full flex-col gap-1 border-l-4 px-3 py-2.5 text-left transition-colors hover:bg-muted/50", StageBorderClass(camp.Stage), _selectedId == camp.Id ? "bg-muted/50 ring-2 ring-foreground ring-inset" : "")">
                                <span class="truncate text-sm font-medium">@camp.Name</span>
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var ch in camp.Channels.Take(2))
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@ch</BadgeCn>
                                    }
                                    @if (camp.Channels.Length > 2)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">+@(camp.Channels.Length - 2)</BadgeCn>
                                    }
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-xs text-muted-foreground tabular-nums">
                                        @FormatCurrency(camp.Budget)
                                    </span>
                                    <span class="ml-auto flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium text-muted-foreground">
                                        @camp.Initials
                                    </span>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@* Sheet side panel *@
<SheetCn Open="@(_selectedCampaign != null)" OpenChanged="@(v => { if (!v) _selectedId = null; })">
    <SheetContentCn Class="overflow-y-auto sm:max-w-md">
        @if (_selectedCampaign != null)
        {
            var sel = _selectedCampaign;
            <SheetHeaderCn>
                <SheetTitleCn Class="text-sm font-medium">@sel.Name</SheetTitleCn>
                <SheetDescriptionCn>
                    <span class="flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", StageDotClass(sel.Stage))"></span>
                        <span class="capitalize text-xs">@sel.Stage</span>
                    </span>
                </SheetDescriptionCn>
            </SheetHeaderCn>

            @* Description *@
            <div class="border-b px-4 pb-4">
                <p class="text-sm leading-relaxed text-muted-foreground">
                    @sel.Description
                </p>
            </div>

            @* Channels *@
            <div class="border-b px-4 py-4">
                <span class="text-xs font-medium text-muted-foreground">Channels</span>
                <div class="mt-2 flex flex-wrap gap-1.5">
                    @foreach (var ch in sel.Channels)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">@ch</BadgeCn>
                    }
                </div>
            </div>

            @* Budget *@
            <div class="border-b px-4 py-4">
                <span class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                    <LucideIconCn Name="dollar-sign" Size="14" Class="size-3.5" />
                    Budget
                </span>
                <div class="mt-2 space-y-2">
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Total</span>
                        <span class="font-semibold tabular-nums">@FormatCurrency(sel.Budget)</span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Spent</span>
                        <span class="font-medium tabular-nums">@FormatCurrency(sel.Spent)</span>
                    </div>
                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="@Cn.Merge("h-full rounded-full transition-all", BudgetBarColor(sel.Spent, sel.Budget))"
                             style="@($"width:{BudgetPct(sel.Spent, sel.Budget)}%")">
                        </div>
                    </div>
                    <div class="flex items-center justify-between text-xs text-muted-foreground">
                        <span>@BudgetPct(sel.Spent, sel.Budget)% utilized</span>
                        <span class="tabular-nums">@FormatCurrency(sel.Budget - sel.Spent) remaining</span>
                    </div>
                </div>
            </div>

            @* KPIs *@
            <div class="border-b px-4 py-4">
                <span class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                    <LucideIconCn Name="target" Size="14" Class="size-3.5" />
                    KPIs
                </span>
                <div class="mt-2 space-y-1.5">
                    @foreach (var kpi in sel.Kpis)
                    {
                        <div class="flex items-center gap-2 text-xs">
                            <span class="size-1 rounded-full bg-foreground/30"></span>
                            <span>@kpi</span>
                        </div>
                    }
                </div>
            </div>

            @* Performance metrics *@
            <div class="border-b px-4 py-4">
                <span class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                    <LucideIconCn Name="bar-chart-3" Size="14" Class="size-3.5" />
                    Performance
                </span>
                <div class="mt-2 grid grid-cols-2 gap-3">
                    @foreach (var m in sel.Metrics)
                    {
                        <div class="rounded-md bg-muted/50 p-2.5">
                            <span class="block text-[10px] text-muted-foreground">@m.Label</span>
                            <span class="block text-sm font-semibold tabular-nums">@m.Value</span>
                        </div>
                    }
                </div>
            </div>

            @* Timeline *@
            <div class="border-b px-4 py-4">
                <span class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                    <LucideIconCn Name="calendar" Size="14" Class="size-3.5" />
                    Timeline
                </span>
                <div class="mt-2 flex items-center justify-between text-xs">
                    <span>@sel.StartDate</span>
                    <div class="mx-3 h-px flex-1 bg-border"></div>
                    <span>@sel.EndDate</span>
                </div>
                <div class="mt-1.5 flex items-center justify-between text-xs text-muted-foreground">
                    <span>Start</span>
                    <span>End</span>
                </div>
            </div>

            @* Owner *@
            <div class="px-4 py-4">
                <span class="text-xs font-medium text-muted-foreground">Owner</span>
                <div class="mt-2 flex items-center gap-2">
                    <span class="flex size-6 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                        @sel.Initials
                    </span>
                    <span class="text-xs font-medium">@sel.Owner</span>
                </div>
            </div>

            @* Actions *@
            <div class="flex gap-2 border-t px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Edit campaign
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">
                    View report
                </ButtonCn>
            </div>
        }
    </SheetContentCn>
</SheetCn>

@code {
