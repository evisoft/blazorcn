    private record Campaign(
        string Id, string Name, string Stage, string[] Channels,
        int Budget, int Spent, string StartDate, string EndDate,
        string Owner, string Initials, string[] Kpis, Metric[] Metrics, string Description);
    private record KanbanColumn(string Stage, string Label);

    private string? _selectedId;
    private Campaign? _selectedCampaign => _campaigns.FirstOrDefault(c => c.Id == _selectedId);

