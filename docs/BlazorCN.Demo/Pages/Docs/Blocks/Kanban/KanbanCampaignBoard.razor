        new("c4",  "Retargeting Optimization",   "active",
            ["Google Ads", "Meta Ads"],
            28000, 16400, "Mar 10", "Apr 30", "James Lin", "JL",
            ["8% CTR", "4.2% conversion rate", "$28 CPA"],
            [new("Impressions","340K"), new("CTR","7.8%"), new("Conversions","486"), new("CPA","$31.40")],
            "A/B testing new retargeting ad creatives and audience segments for site visitors who viewed product pages but did not convert. Testing dynamic product ads versus lifestyle imagery."),
        new("c5",  "SEO Content Sprint",          "active",
            ["Organic Search", "Blog"],
            12000, 7200, "Feb 15", "Apr 30", "Priya Patel", "PP",
            ["30 articles published", "50K organic visits", "Top 10 for 15 keywords"],
            [new("Articles","22"), new("Organic visits","38.4K"), new("Keywords top 10","11"), new("Avg position","7.2")],
            "Targeted content production sprint focused on high-intent buyer keywords in the project management and productivity tool categories. Each article includes comparison tables and CTAs."),
        new("c6",  "Partner Referral Program",    "active",
            ["Email", "In-App", "Partner Portal"],
            22000, 14600, "Mar 1", "May 15", "Sarah Kim", "SK",
            ["150 referrals", "20% signup rate", "$45 CAC"],
            [new("Referrals","98"), new("Signups","24"), new("Revenue","$18.2K"), new("CAC","$52")],
            "Incentivized referral campaign for existing agency partners. Two-tier reward structure with $200 per qualified signup and $500 per converted customer within 30 days."),
