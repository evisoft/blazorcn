    ];

    private static readonly KanbanColumn[] _columns =
    [
        new("planning",  "Planning"),
        new("active",    "Active"),
        new("paused",    "Paused"),
        new("completed", "Completed"),
    ];

    private static string StageDotClass(string stage) => stage switch
    {
        "planning"  => "bg-blue-500",
        "active"    => "bg-emerald-500",
        "paused"    => "bg-amber-500",
        "completed" => "bg-zinc-400",
        _           => ""
    };

    private static string StageBorderClass(string stage) => stage switch
    {
        "planning"  => "border-l-blue-500",
        "active"    => "border-l-emerald-500",
        "paused"    => "border-l-amber-500",
        "completed" => "border-l-zinc-400",
        _           => ""
    };

    private static int BudgetPct(int spent, int budget) =>
        budget == 0 ? 0 : Math.Min(100, (int)Math.Round((double)spent / budget * 100));

    private static string BudgetBarColor(int spent, int budget)
    {
        var ratio = budget == 0 ? 0.0 : (double)spent / budget;
        return ratio > 0.9 ? "bg-red-500" : ratio > 0.7 ? "bg-amber-500" : "bg-emerald-500";
    }

    private static string FormatCurrency(int value)
    {
        if (value >= 1000)
            return $"${value / 1000}K";
        return $"${value}";
    }
}
