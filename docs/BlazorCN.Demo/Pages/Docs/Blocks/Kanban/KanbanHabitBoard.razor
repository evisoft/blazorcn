@* ============================================================
   Block: kanban-habit-board
   Title: KanbanHabitBoard
   Description: React kanban habit tracker board for Next.js with tab navigation, streak counters, frequency badges, category labels, and staggered card animations using shadcn/ui Tabs and Tailwind CSS
   Source: original/blocks/kanban/kanban-habit-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Habit Board</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_habits.Length habits
                </BadgeCn>
            </div>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="flame" Size="12" Class="size-3 text-amber-500" />
                <span class="tabular-nums">@_totalActiveStreak</span>
                <span>total streak days</span>
            </div>
        </div>

        @* Tabs *@
        <div class="px-4 py-3">
            <TabsCn DefaultValue="active">
                <TabsListCn Class="w-full">
                    @foreach (var col in _columns)
                    {
                        var colId = col.Id;
                        <TabsTriggerCn Value="@colId" Class="h-8 gap-1.5 text-xs">
                            <LucideIconCn Name="@col.Icon" Size="14" Class="size-3.5" />
                            @col.Label
                            <span class="text-muted-foreground/60 text-[10px]">@GetCount(colId)</span>
                        </TabsTriggerCn>
                    }
                </TabsListCn>

                @foreach (var col in _columns)
                {
                    var colId = col.Id;
                    var columnHabits = _habits.Where(h => h.Stage == colId).ToArray();
                    var isDropped = colId == "dropped";
                    var isMastered = colId == "mastered";
                    <TabsContentCn Value="@colId" Class="mt-0">
                        <div class="mt-3 overflow-hidden rounded-md border">
                            @for (var i = 0; i < columnHabits.Length; i++)
                            {
                                var habit = columnHabits[i];
                                var isLast = i == columnHabits.Length - 1;
                                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                                    <span class="@Cn.Merge("size-2 shrink-0 rounded-full", GetCategoryDot(habit.Category))"></span>
                                    <div class="min-w-0 flex-1">
                                        <span class="@Cn.Merge("text-sm", isDropped ? "text-muted-foreground line-through" : "font-medium")">
                                            @habit.Name
                                        </span>
                                        <p class="mt-0.5 text-muted-foreground text-xs">@habit.Category</p>
                                    </div>
                                    <div class="flex shrink-0 items-center gap-2">
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                                            @GetFrequencyLabel(habit.Frequency)
                                        </BadgeCn>
                                        @if (habit.Streak > 0)
                                        {
                                            <span class="@Cn.Merge("flex items-center gap-1 text-xs tabular-nums", isMastered ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">
                                                <LucideIconCn Name="flame" Size="12" Class="size-3" />
                                                @habit.Streak@("d")
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </TabsContentCn>
                }
            </TabsCn>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @GetCount("mastered") mastered · @GetCount("active") active
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated just now</span>
        </div>
    </div>
</section>

@code {
    private record HabitItem(string Id, string Name, int Streak, string Frequency, string Category, string Stage);
    private record ColumnItem(string Id, string Label, string Icon);

    private static readonly ColumnItem[] _columns =
    [
        new("active",   "Active",   "flame"),
        new("building", "Building", "sparkles"),
        new("mastered", "Mastered", "trophy"),
        new("dropped",  "Dropped",  "x-circle"),
    ];

    private static readonly HabitItem[] _habits =
    [
        new("1",  "Morning meditation",      23,  "daily",   "Mindfulness", "active"),
        new("2",  "Read 20 pages",           15,  "daily",   "Learning",    "active"),
        new("3",  "Drink 8 glasses of water",31,  "daily",   "Health",      "active"),
        new("4",  "Strength training",       8,   "3x/week", "Fitness",     "building"),
        new("5",  "Journal before bed",      5,   "daily",   "Mindfulness", "building"),
        new("6",  "Practice Spanish",        3,   "daily",   "Learning",    "building"),
        new("7",  "No phone before 9 AM",    12,  "daily",   "Wellness",    "building"),
        new("8",  "Daily walk — 30 min",     90,  "daily",   "Fitness",     "mastered"),
        new("9",  "Make bed every morning",  120, "daily",   "Routine",     "mastered"),
        new("10", "Weekly meal prep",        14,  "weekly",  "Health",      "mastered"),
        new("11", "Cold showers",            0,   "daily",   "Wellness",    "dropped"),
        new("12", "Wake up at 5 AM",         0,   "daily",   "Routine",     "dropped"),
    ];

    private int _totalActiveStreak = _habits.Where(h => h.Stage == "active").Sum(h => h.Streak);

    private int GetCount(string stage) => _habits.Count(h => h.Stage == stage);

    private static string GetCategoryDot(string category) => category switch
    {
        "Mindfulness" => "bg-violet-500",
        "Learning"    => "bg-blue-500",
        "Health"      => "bg-emerald-500",
        "Fitness"     => "bg-amber-500",
        "Wellness"    => "bg-cyan-500",
        "Routine"     => "bg-pink-500",
        _             => "bg-muted-foreground",
    };

    private static string GetFrequencyLabel(string frequency) => frequency switch
    {
        "daily"   => "Daily",
        "weekly"  => "Weekly",
        "3x/week" => "3x/week",
        _         => frequency,
    };
}
