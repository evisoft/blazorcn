@* ============================================================
   Block: kanban-patent-tracker
   Title: KanbanPatentTracker
   Description: React patent portfolio kanban for Next.js with lifecycle stage columns, compact cards, and Dialog detail overlay showing inventors, filing date, claims count, jurisdiction, and status using shadcn/ui Dialog and Tailwind CSS.
   Source: original/blocks/kanban/kanban-patent-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Patent Portfolio</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_patents.Length patents
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_patents.Count(p => p.Stage == "granted") granted
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">
                    @_patents.Sum(p => p.ClaimsCount) total claims
                </span>
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var col in _columns)
            {
                var colStage = col.Stage;
                var colPatents = _patents.Where(p => p.Stage == colStage).ToArray();
                <div>
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _stageDot.TryGetValue(colStage, out var dot) ? dot : "")"></span>
                        <span class="font-medium text-muted-foreground text-xs">@col.Label</span>
                        <span class="text-muted-foreground/60 text-xs">@colPatents.Length</span>
                    </div>
                    <div>
                        @for (int i = 0; i < colPatents.Length; i++)
                        {
                            var patent = colPatents[i];
                            var isLast = i == colPatents.Length - 1;
                            <div class="@(isLast ? "" : "border-b")">
                                <button
                                    type="button"
                                    @onclick="@(() => _selectedId = patent.Id)"
                                    class="flex w-full items-center gap-2.5 px-3 py-2.5 text-left transition-colors hover:bg-muted/50">
                                    <span class="min-w-0 flex-1">
                                        <span class="block truncate font-medium text-sm">@patent.Title</span>
                                        <span class="block text-muted-foreground text-xs">
                                            @patent.Jurisdiction@(patent.ClaimsCount > 0 ? $" · {patent.ClaimsCount} claims" : "")
                                        </span>
                                    </span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_patents.Count(p => p.Stage == "examination") in examination
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 1 hour ago</span>
        </div>
    </div>

    @* Dialog *@
    <DialogCn Open="@(_selectedId != null)" OpenChanged="@((bool v) => { if (!v) _selectedId = null; })">
        <DialogContentCn Class="max-w-md p-0">
            @{
                var selected = _patents.FirstOrDefault(p => p.Id == _selectedId);
            }
            @if (selected != null)
            {
                <DialogHeaderCn Class="border-b px-4 py-3">
                    <DialogTitleCn Class="font-medium text-sm">@selected.Title</DialogTitleCn>
                    <DialogDescriptionCn Class="flex items-center gap-2 text-xs">
                        <LucideIconCn Name="scale" Size="12" Class="size-3" />
                        @selected.Assignee
                    </DialogDescriptionCn>
                </DialogHeaderCn>

                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @selected.Jurisdiction
                        </BadgeCn>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @selected.TechnologyArea
                        </BadgeCn>
                    </div>
                    <div class="mt-1.5 flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _stageDot.TryGetValue(selected.Stage, out var selDot) ? selDot : "")"></span>
                        <span class="text-muted-foreground text-xs capitalize">@selected.Stage</span>
                    </div>
                </div>

                <div class="border-b px-4 py-3">
                    <div class="space-y-2.5">
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">Inventors</span>
                            <span class="ml-auto text-right font-medium">@string.Join(", ", selected.Inventors)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(selected.FilingDate))
                        {
                            <div class="flex items-center gap-2 text-xs">
                                <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="text-muted-foreground">Filed</span>
                                <span class="ml-auto font-medium">@selected.FilingDate</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(selected.PatentNumber))
                        {
                            <div class="flex items-center gap-2 text-xs">
                                <LucideIconCn Name="hash" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="text-muted-foreground">Patent number</span>
                                <span class="ml-auto font-mono font-medium">@selected.PatentNumber</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(selected.ApplicationNumber))
                        {
                            <div class="flex items-center gap-2 text-xs">
                                <LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="text-muted-foreground">Application</span>
                                <span class="ml-auto font-mono font-medium">@selected.ApplicationNumber</span>
                            </div>
                        }
                        @if (selected.ClaimsCount > 0)
                        {
                            <div class="flex items-center gap-2 text-xs">
                                <LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="text-muted-foreground">Claims</span>
                                <span class="ml-auto font-medium tabular-nums">@selected.ClaimsCount</span>
                            </div>
                        }
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="globe" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">Jurisdiction</span>
                            <span class="ml-auto font-medium">@selected.Jurisdiction</span>
                        </div>
                    </div>
                </div>

                <div class="border-b px-4 py-3">
                    <span class="font-medium text-muted-foreground text-xs">Status</span>
                    <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">
                        @selected.StatusNotes
                    </p>
                </div>

                <div class="flex gap-2 px-4 py-3">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Edit patent
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-muted-foreground text-xs">
                        Move stage
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="ml-auto h-7 text-muted-foreground text-xs">
                        Archive
                    </ButtonCn>
                </div>
            }
        </DialogContentCn>
    </DialogCn>
</section>

@code {
