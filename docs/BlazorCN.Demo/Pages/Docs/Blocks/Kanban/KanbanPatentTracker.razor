    private record Patent(
        string Id,
        string Title,
        string[] Inventors,
        string Stage,
        string FilingDate,
        string? PatentNumber,
        string ApplicationNumber,
        int ClaimsCount,
        string Jurisdiction,
        string StatusNotes,
        string Assignee,
        string TechnologyArea
    );

    private record Column(string Stage, string Label);

