@* ============================================================
   Block: kanban-deadline-tracker
   Title: KanbanDeadlineTracker
   Description: React deadline-aware kanban board for Next.js with timeline header, urgency indicators, and dependency tracking using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-deadline-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar-clock" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Deadline Tracker</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_tasks.Length tasks
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                @if (_overdueCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-xs text-red-600 dark:text-red-400">
                        <LucideIconCn Name="alert-triangle" Size="12" Class="size-3" />
                        @_overdueCount overdue
                    </span>
                }
                @if (_todayCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-xs text-amber-600 dark:text-amber-400">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        @_todayCount due today
                    </span>
                }
            </div>
        </div>

        @* Timeline header *@
        <div class="border-b bg-muted/30 px-4 py-2.5">
            <div class="flex items-center">
                @foreach (var dateItem in _timelineDates)
                {
                    var idx = dateItem.Index;
                    var date = dateItem.Date;
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <span class="@Cn.Merge("font-mono text-[10px]", idx == _todayIndex ? "font-semibold text-foreground" : idx < _todayIndex ? "text-muted-foreground/60" : "text-muted-foreground")">
                            @date
                        </span>
                        <span class="@Cn.Merge("size-1.5 rounded-full", idx == _todayIndex ? "bg-foreground" : idx < _todayIndex ? "bg-muted-foreground/30" : "bg-muted-foreground/20")"></span>
                    </div>
                }
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-4">
            @foreach (var col in _columns)
            {
                var colId = col.Id;
                var colTasks = _tasks.Where(t => t.Status == colId).OrderBy(t => _urgencyOrder[t.Urgency]).ToArray();
                var isLast = col.Id == _columns[_columns.Length - 1].Id;
                <div class="@Cn.Merge(!isLast ? "border-r" : "")">
                    @* Column header *@
                    <div class="flex items-center gap-2 border-b px-3 py-2.5">
                        <span class="font-medium text-xs">@col.Label</span>
                        <span class="ml-auto font-mono text-muted-foreground/60 text-xs">@colTasks.Length</span>
                    </div>

                    @* Cards *@
                    <div class="flex flex-col gap-1 p-2">
                        @foreach (var task in colTasks)
                        {
                            var uc = _urgencyConfig[task.Urgency];
                            <div class="overflow-hidden rounded-md transition-colors hover:bg-muted/50">
                                @* Urgency bar *@
                                <div class="@Cn.Merge("h-0.5", uc.Bar)"></div>
                                <div class="px-2.5 py-2">
                                    <div class="flex items-start gap-2">
                                        <div class="min-w-0 flex-1">
                                            <span class="line-clamp-2 text-xs font-medium">@task.Title</span>
                                            <div class="mt-1 flex items-center gap-1.5">
                                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", uc.Dot)"></span>
                                                <span class="@Cn.Merge("text-[10px]", uc.Text)">@task.UrgencyLabel</span>
                                            </div>
                                            @if (task.Dependency != null)
                                            {
                                                <div class="mt-1 flex items-center gap-1 text-muted-foreground/60">
                                                    <LucideIconCn Name="link" Size="10" Class="size-2.5" />
                                                    <span class="truncate text-[10px]">@task.Dependency</span>
                                                </div>
                                            }
                                        </div>
                                        <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium">
                                            @task.Initials
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (colTasks.Length == 0)
                        {
                            <div class="rounded-md border border-dashed border-muted-foreground/20 px-2 py-3 text-center text-muted-foreground/40 text-xs">
                                Empty
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                4 columns · @(_tasks.Count(t => t.Status == "complete")) of @_tasks.Length complete
            </span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span> Overdue
                </span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span> Today
                </span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span> This week
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record Task(string Id, string Title, string Owner, string Initials, string DueDate, string Urgency, string UrgencyLabel, string Status, string? Dependency = null);
    private record Column(string Id, string Label);
    private record UrgencyStyle(string Dot, string Text, string Bar);
    private record TimelineDate(int Index, string Date);

    private static readonly string[] _rawTimelineDates = ["Mar 28", "Mar 29", "Mar 30", "Mar 31", "Apr 1", "Apr 2", "Apr 3"];
    private static readonly int _todayIndex = 4;

    private static readonly TimelineDate[] _timelineDates =
    [
        new(0, "Mar 28"),
        new(1, "Mar 29"),
        new(2, "Mar 30"),
        new(3, "Mar 31"),
        new(4, "Apr 1"),
        new(5, "Apr 2"),
        new(6, "Apr 3"),
    ];

    private static readonly Column[] _columns =
    [
        new("upcoming",    "Upcoming"),
        new("in-progress", "In Progress"),
        new("blocked",     "Blocked"),
        new("complete",    "Complete"),
    ];

    private static readonly Dictionary<string, UrgencyStyle> _urgencyConfig = new()
    {
        ["overdue"] = new("bg-red-500",             "text-red-600 dark:text-red-400",     "bg-red-500"),
        ["today"]   = new("bg-amber-500",           "text-amber-600 dark:text-amber-400", "bg-amber-500"),
        ["week"]    = new("bg-blue-500",            "text-blue-600 dark:text-blue-400",   "bg-blue-500"),
        ["future"]  = new("bg-muted-foreground/40", "text-muted-foreground",              "bg-muted-foreground/30"),
    };

    private static readonly Dictionary<string, int> _urgencyOrder = new()
    {
        ["overdue"] = 0,
        ["today"]   = 1,
        ["week"]    = 2,
        ["future"]  = 3,
    };

    private static readonly Task[] _tasks =
    [
        new("d1",  "Finalize API contracts",          "Sarah Chen",    "SC", "Mar 28", "overdue", "2d overdue",      "in-progress", "Schema review"),
        new("d2",  "Database migration scripts",       "Marcus Rivera", "MR", "Mar 29", "overdue", "1d overdue",      "blocked",     "API contracts"),
        new("d3",  "Auth service integration",         "Priya Patel",   "PP", "Apr 1",  "today",   "Due today",       "in-progress"),
        new("d4",  "Load testing suite",               "James O'Brien", "JO", "Apr 1",  "today",   "Due today",       "upcoming",    "Auth service"),
        new("d5",  "Payment webhook handlers",         "Sarah Chen",    "SC", "Apr 2",  "week",    "1 day left",      "upcoming"),
        new("d6",  "Email notification templates",     "Marcus Rivera", "MR", "Apr 3",  "week",    "2 days left",     "upcoming"),
        new("d7",  "Dashboard analytics widgets",      "Priya Patel",   "PP", "Apr 3",  "week",    "2 days left",     "in-progress"),
        new("d8",  "CI pipeline optimization",         "James O'Brien", "JO", "Apr 5",  "future",  "Apr 5",           "upcoming",    "Load testing"),
        new("d9",  "User onboarding flow",             "Sarah Chen",    "SC", "Apr 7",  "future",  "Apr 7",           "upcoming"),
        new("d10", "Rate limiter middleware",          "Marcus Rivera", "MR", "Mar 30", "overdue", "Overdue by 1d",   "blocked",     "API contracts"),
        new("d11", "Search indexing service",          "Priya Patel",   "PP", "Mar 28", "overdue", "Completed",       "complete"),
        new("d12", "Stripe checkout integration",      "James O'Brien", "JO", "Mar 30", "overdue", "Completed",       "complete"),
        new("d13", "CSV export feature",               "Sarah Chen",    "SC", "Mar 29", "overdue", "Completed",       "complete"),
    ];

    private int _overdueCount => _tasks.Count(t => t.Urgency == "overdue" && t.Status != "complete");
    private int _todayCount => _tasks.Count(t => t.Urgency == "today");
}
