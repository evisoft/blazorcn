@* ============================================================
   Block: kanban-reading-queue
   Title: KanbanReadingQueue
   Description: React kanban reading list manager for Next.js with tab navigation, genre badges, author metadata, reading progress, and staggered animations using shadcn/ui Tabs and Tailwind CSS
   Source: original/blocks/kanban/kanban-reading-queue.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Reading Queue</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_items.Length items
                </BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs">
                @_totalPages.ToString("N0") pages read
            </span>
        </div>

        @* Tabs *@
        <div class="px-4 py-3">
            <TabsCn DefaultValue="to-read">
                <TabsListCn Class="w-full">
                    @foreach (var col in _columns)
                    {
                        var count = GetCount(col.Id);
                        <TabsTriggerCn Value="@col.Id" Class="h-8 gap-1.5 text-xs">
                            <LucideIconCn Name="@col.IconName" Size="14" Class="size-3.5" />
                            @col.Label
                            <span class="text-muted-foreground/60 text-[10px]">@count</span>
                        </TabsTriggerCn>
                    }
                </TabsListCn>

                @foreach (var col in _columns)
                {
                    var columnItems = _items.Where(i => i.Status == col.Id).ToArray();
                    var isFinished = col.Id == "finished";
                    <TabsContentCn Value="@col.Id" Class="mt-0">
                        <div class="mt-3 overflow-hidden rounded-md border">
                            @for (var idx = 0; idx < columnItems.Length; idx++)
                            {
                                var item = columnItems[idx];
                                var isLast = idx == columnItems.Length - 1;
                                var finished = isFinished;
                                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="@Cn.Merge("truncate text-sm", finished ? "text-muted-foreground line-through" : "font-medium")">
                                                @item.Title
                                            </span>
                                        </div>
                                        <p class="mt-0.5 truncate text-muted-foreground text-xs">
                                            @item.Author
                                        </p>
                                    </div>
                                    <div class="flex shrink-0 items-center gap-2">
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-normal text-[10px]", GenreColor(item.Genre))">
                                            @item.Genre
                                        </BadgeCn>
                                        <span class="text-muted-foreground/60 text-xs tabular-nums">
                                            @item.Pages
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    </TabsContentCn>
                }
            </TabsCn>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @GetCount("finished") of @_items.Length finished
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 2 hours ago</span>
        </div>
    </div>
</section>

@code {
    private record ReadingItem(string Id, string Title, string Author, string Genre, string Pages, string Status);
    private record ColumnDef(string Id, string Label, string IconName);

    private static readonly ReadingItem[] _items =
    [
        new("1",  "Thinking, Fast and Slow",              "Daniel Kahneman",   "Psychology",  "499 pages", "to-read"),
        new("2",  "The Design of Everyday Things",        "Don Norman",        "Design",      "368 pages", "to-read"),
        new("3",  "Sapiens: A Brief History of Humankind","Yuval Noah Harari", "History",     "443 pages", "to-read"),
        new("4",  "Dune",                                 "Frank Herbert",     "Sci-Fi",      "688 pages", "to-read"),
        new("5",  "Project Hail Mary",                    "Andy Weir",         "Sci-Fi",      "476 pages", "reading"),
        new("6",  "The Pragmatic Programmer",             "David Thomas",      "Tech",        "352 pages", "reading"),
        new("7",  "Meditations",                          "Marcus Aurelius",   "Philosophy",  "256 pages", "reading"),
        new("8",  "Atomic Habits",                        "James Clear",       "Self-Help",   "320 pages", "finished"),
        new("9",  "Deep Work",                            "Cal Newport",       "Productivity","296 pages", "finished"),
        new("10", "The Midnight Library",                 "Matt Haig",         "Fiction",     "288 pages", "finished"),
        new("11", "Educated",                             "Tara Westover",     "Memoir",      "334 pages", "finished"),
        new("12", "Range",                                "David Epstein",     "Science",     "352 pages", "finished"),
    ];

    private static readonly ColumnDef[] _columns =
    [
        new("to-read",  "To Read",  "book-open"),
        new("reading",  "Reading",  "book-marked"),
        new("finished", "Finished", "book-check"),
    ];

    private int _totalPages => _items
        .Where(i => i.Status == "finished")
        .Sum(i => int.Parse(i.Pages.Split(' ')[0]));

    private int GetCount(string status) => _items.Count(i => i.Status == status);

    private static string GenreColor(string genre) => genre switch
    {
        "Psychology"  => "bg-violet-500/10 text-violet-700 dark:text-violet-400",
        "Design"      => "bg-pink-500/10 text-pink-700 dark:text-pink-400",
        "History"     => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        "Sci-Fi"      => "bg-cyan-500/10 text-cyan-700 dark:text-cyan-400",
        "Tech"        => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        "Philosophy"  => "bg-indigo-500/10 text-indigo-700 dark:text-indigo-400",
        "Self-Help"   => "bg-orange-500/10 text-orange-700 dark:text-orange-400",
        "Productivity"=> "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        "Fiction"     => "bg-rose-500/10 text-rose-700 dark:text-rose-400",
        "Memoir"      => "bg-teal-500/10 text-teal-700 dark:text-teal-400",
        "Science"     => "bg-sky-500/10 text-sky-700 dark:text-sky-400",
        _             => "",
    };
}
