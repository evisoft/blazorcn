@* ============================================================
   Block: kanban-knowledge-base
   Title: KanbanKnowledgeBase
   Description: React kanban knowledge base board for Next.js with shadcn/ui Command palette search, real-time card filtering, highlighted matches, and four-column article pipeline using Tailwind CSS
   Source: original/blocks/kanban/kanban-knowledge-base.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Knowledge Base</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_articles.Length articles
                </BadgeCn>
            </div>
            <div class="relative">
                <button
                    type="button"
                    class="flex h-7 items-center gap-1.5 rounded-md border bg-muted/50 px-2.5 text-muted-foreground text-xs transition-colors hover:bg-muted"
                    @onclick="@(() => { _open = !_open; if (!_open) _search = ""; })"
                >
                    <LucideIconCn Name="search" Size="12" Class="size-3" />
                    Search articles
                </button>
                @if (_open)
                {
                    <div class="absolute right-0 top-9 z-50 w-72 rounded-md border bg-popover p-0 shadow-md">
                        <div class="flex items-center border-b px-3">
                            <LucideIconCn Name="search" Size="16" Class="mr-2 size-4 shrink-0 opacity-50" />
                            <input
                                type="text"
                                placeholder="Search titles, tags, authors..."
                                class="flex h-10 w-full rounded-md bg-transparent py-3 text-sm outline-none placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50"
                                value="@_search"
                                @oninput="@((e) => _search = e.Value?.ToString() ?? "")"
                            />
                        </div>
                        <div class="max-h-72 overflow-y-auto overflow-x-hidden">
                            @{
                                var matchedArticles = string.IsNullOrWhiteSpace(_search)
                                    ? System.Array.Empty<Article>()
                                    : _articles.Where(a =>
                                        a.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                                        a.Tags.Any(t => t.Contains(_search, StringComparison.OrdinalIgnoreCase)) ||
                                        a.Author.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToArray();
                            }
                            @if (!string.IsNullOrWhiteSpace(_search) && matchedArticles.Length == 0)
                            {
                                <div class="py-6 text-center text-sm text-muted-foreground">No matching articles.</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_search) && matchedArticles.Length > 0)
                            {
                                <div class="overflow-hidden p-1">
                                    <div class="px-2 py-1.5 text-xs font-medium text-muted-foreground">Articles</div>
                                    @foreach (var art in matchedArticles)
                                    {
                                        var article = art;
                                        <button
                                            type="button"
                                            class="relative flex w-full cursor-default select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground"
                                            @onclick="@(() => _open = false)"
                                        >
                                            <LucideIconCn Name="file-edit" Size="14" Class="size-3.5 text-muted-foreground" />
                                            <div class="min-w-0 flex-1 text-left">
                                                <span class="block truncate text-sm">@article.Title</span>
                                                <span class="text-muted-foreground text-xs">@article.Author · @string.Join(", ", article.Tags)</span>
                                            </div>
                                        </button>
                                    }
                                </div>
                            }
                            <div class="overflow-hidden p-1">
                                <div class="px-2 py-1.5 text-xs font-medium text-muted-foreground">Quick Actions</div>
                                <button type="button" class="relative flex w-full cursor-default select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground" @onclick="@(() => _open = false)">
                                    <LucideIconCn Name="send" Size="14" Class="size-3.5 text-muted-foreground" />
                                    Move to Published
                                </button>
                                <button type="button" class="relative flex w-full cursor-default select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground" @onclick="@(() => _open = false)">
                                    <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                                    Assign author
                                </button>
                                <button type="button" class="relative flex w-full cursor-default select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground" @onclick="@(() => _open = false)">
                                    <LucideIconCn Name="tag" Size="14" Class="size-3.5 text-muted-foreground" />
                                    Add tag
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var col in _columns)
            {
                var colArticles = _articles.Where(a => a.Status == col.Id).ToArray();
                var matchedIds = string.IsNullOrWhiteSpace(_search)
                    ? null
                    : new HashSet<string>(_articles
                        .Where(a =>
                            a.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                            a.Tags.Any(t => t.Contains(_search, StringComparison.OrdinalIgnoreCase)) ||
                            a.Author.Contains(_search, StringComparison.OrdinalIgnoreCase))
                        .Select(a => a.Id));
                <div>
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@col.Icon" Size="14" Class="size-3.5" />
                        </span>
                        <span class="font-medium text-muted-foreground text-xs">@col.Title</span>
                        <span class="text-muted-foreground/60 text-xs">@colArticles.Length</span>
                    </div>
                    <div class="p-2">
                        <div class="flex flex-col gap-1.5">
                            @foreach (var art in colArticles)
                            {
                                var article = art;
                                var isMatch = matchedIds == null || matchedIds.Contains(article.Id);
                                var isDimmed = matchedIds != null && !matchedIds.Contains(article.Id);
                                <div class="@Cn.Merge("rounded-md border bg-card p-2.5 transition-all hover:bg-muted/50", (isMatch && matchedIds != null) ? "ring-2 ring-foreground" : "", isDimmed ? "opacity-30" : "")">
                                    <span class="mb-1 block font-medium text-sm leading-tight">@article.Title</span>
                                    <div class="mb-1.5 flex flex-wrap gap-1">
                                        @foreach (var tag in article.Tags)
                                        {
                                            <span class="rounded bg-muted/50 px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">@tag</span>
                                        }
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium text-muted-foreground">
                                            @article.AuthorInitials
                                        </span>
                                        <span class="text-muted-foreground text-xs">
                                            @article.WordCount.ToString("N0") words
                                        </span>
                                    </div>
                                </div>
                            }
                            @if (colArticles.Length == 0)
                            {
                                <div class="py-8 text-center text-muted-foreground/60 text-xs">
                                    No articles
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @(_articles.Count(a => a.Status == "published")) published · @(_articles.Count(a => a.Status == "review")) in review
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 4 min ago</span>
        </div>
    </div>
</section>

@code {
    private record Article(string Id, string Title, string Status, string[] Tags, string Author, string AuthorInitials, int WordCount);
    private record KbColumn(string Id, string Title, string Icon);

    private static readonly Article[] _articles =
    [
        new("kb1",  "Getting started with API authentication", "draft",     ["api", "auth"],          "Sarah Chen",   "SC", 1240),
        new("kb2",  "Webhook event reference guide",           "draft",     ["webhooks", "events"],   "Marcus Rivera", "MR", 890),
        new("kb3",  "Rate limiting best practices",            "draft",     ["api", "limits"],        "Priya Patel",  "PP", 650),
        new("kb4",  "Migrating from REST to GraphQL",          "review",    ["graphql", "migration"], "James Liu",    "JL", 2100),
        new("kb5",  "Custom dashboard widget tutorial",        "review",    ["dashboard", "tutorial"],"Sarah Chen",   "SC", 1800),
        new("kb6",  "SSO configuration for enterprise",        "review",    ["sso", "enterprise"],    "Nina Okafor",  "NO", 1560),
        new("kb7",  "Billing and subscription FAQ",            "published", ["billing", "faq"],       "Marcus Rivera", "MR", 980),
        new("kb8",  "Error codes and troubleshooting",         "published", ["errors", "debug"],      "Priya Patel",  "PP", 2340),
        new("kb9",  "Data export and compliance guide",        "published", ["data", "compliance"],   "James Liu",    "JL", 1750),
        new("kb10", "Team permissions and roles overview",     "published", ["teams", "roles"],       "Nina Okafor",  "NO", 1120),
        new("kb11", "Legacy API v1 deprecation notice",        "archived",  ["api", "deprecated"],    "Sarah Chen",   "SC", 420),
        new("kb12", "Old onboarding flow walkthrough",         "archived",  ["onboarding", "legacy"], "Marcus Rivera", "MR", 1600),
        new("kb13", "SDK installation and quickstart",         "draft",     ["sdk", "quickstart"],    "James Liu",    "JL", 780),
    ];

    private static readonly KbColumn[] _columns =
    [
        new("draft",     "Draft",     "file-edit"),
        new("review",    "Review",    "file-pen"),
        new("published", "Published", "send"),
        new("archived",  "Archived",  "archive"),
    ];

    private bool _open = false;
    private string _search = "";
}
