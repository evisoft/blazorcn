@* ============================================================
   Block: kanban-card-sorting
   Title: KanbanCardSorting
   Description: React UX card sorting kanban for Next.js with three sorting columns, drag-and-drop using @dnd-kit, category tags, and user vote counts built with shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-card-sorting.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Card Sort Exercise</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_cards.Length cards
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var cat in _categories)
                {
                    var catName = cat;
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", CategoryDotClass(catName))"></span>
                        @_cards.Count(c => c.Category == catName)
                    </span>
                }
            </div>
        </div>

        @* Board *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var column in _columns)
            {
                var col = column;
                var colCards = _cards.Where(c => c.Group == col.Id).ToArray();
                <div class="min-w-0">
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="font-medium text-muted-foreground text-xs">@col.Label</span>
                        <span class="text-muted-foreground/60 text-xs">@colCards.Length</span>
                    </div>
                    <div class="flex flex-col gap-1.5 p-2">
                        @foreach (var card in colCards)
                        {
                            <div class="flex items-center gap-2 rounded-md border bg-card px-3 py-2.5 transition-colors hover:bg-muted/50">
                                <button type="button" class="shrink-0 cursor-grab touch-none text-muted-foreground/60 active:cursor-grabbing" aria-label="@($"Reorder {card.Label}")">
                                    <LucideIconCn Name="grip-vertical" Size="14" Class="size-3.5" />
                                </button>
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", CategoryDotClass(card.Category))"></span>
                                <div class="min-w-0 flex-1">
                                    <span class="font-medium text-sm">@card.Label</span>
                                </div>
                                <span class="text-muted-foreground text-[10px]">@card.Category</span>
                                <span class="flex items-center gap-1 text-muted-foreground/60 text-[10px] tabular-nums">
                                    <LucideIconCn Name="users" Size="10" Class="size-2.5" />
                                    @card.Votes
                                </span>
                            </div>
                        }
                        @if (colCards.Length == 0)
                        {
                            <div class="rounded-md border border-dashed border-muted-foreground/20 px-2 py-6 text-center text-muted-foreground/40 text-xs">
                                Drop cards here
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_sortedCount of @_cards.Length sorted
            </span>
            <span class="text-muted-foreground/60 text-xs">
                @(_unsortedCount == 0 ? "All cards sorted" : $"{_unsortedCount} remaining")
            </span>
        </div>
    </div>
</section>

@code {
    private record CardItem(string Id, string Label, string Group, string Category, int Votes);
    private record Column(string Id, string Label);

    private static readonly CardItem[] _cards =
    [
        new("c1",  "Global search bar",          "unsorted", "Navigation", 12),
        new("c2",  "Breadcrumb trail",            "unsorted", "Navigation",  8),
        new("c3",  "User profile page",           "unsorted", "Content",    15),
        new("c4",  "Notification preferences",    "unsorted", "Settings",    6),
        new("c5",  "Activity feed",               "unsorted", "Social",     11),
        new("c6",  "Shopping cart",               "unsorted", "Commerce",   14),
        new("c7",  "Dark mode toggle",            "unsorted", "Settings",    9),
        new("c8",  "Comment thread",              "group-a",  "Social",     10),
        new("c9",  "Product comparison",          "group-a",  "Commerce",    7),
        new("c10", "Sidebar navigation",          "group-a",  "Navigation", 13),
        new("c11", "Rich text editor",            "group-a",  "Content",     5),
        new("c12", "Wishlist",                    "group-b",  "Commerce",    8),
        new("c13", "Two-factor setup",            "group-b",  "Settings",    4),
        new("c14", "Share dialog",                "group-b",  "Social",     11),
        new("c15", "Tag filter chips",            "group-b",  "Content",     6),
    ];

    private static readonly Column[] _columns =
    [
        new("unsorted", "Unsorted"),
        new("group-a",  "Group A"),
        new("group-b",  "Group B"),
    ];

    private static readonly string[] _categories = ["Navigation", "Content", "Settings", "Social", "Commerce"];

    private int _unsortedCount => _cards.Count(c => c.Group == "unsorted");
    private int _sortedCount => _cards.Length - _unsortedCount;

    private static string CategoryDotClass(string category) => category switch
    {
        "Navigation" => "bg-blue-500",
        "Content"    => "bg-emerald-500",
        "Settings"   => "bg-amber-500",
        "Social"     => "bg-violet-500",
        "Commerce"   => "bg-red-500",
        _            => ""
    };
}
