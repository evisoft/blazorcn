    private static string StageDotClass(string stage) => stage switch
    {
        "received"    => "bg-blue-500",
        "in-progress" => "bg-amber-500",
        "review"      => "bg-violet-500",
        "approved"    => "bg-emerald-500",
        _             => ""
    };

    private static string StageBorderClass(string stage) => stage switch
    {
        "received"    => "border-l-blue-500",
        "in-progress" => "border-l-amber-500",
        "review"      => "border-l-violet-500",
        "approved"    => "border-l-emerald-500",
        _             => ""
    };

    private static string PriorityDotClass(string priority) => priority switch
    {
        "urgent" => "bg-red-500",
        "high"   => "bg-amber-500",
        "normal" => "bg-zinc-400",
        _        => ""
    };
