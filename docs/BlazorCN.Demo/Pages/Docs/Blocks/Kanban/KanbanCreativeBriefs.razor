@* ============================================================
   Block: kanban-creative-briefs
   Title: KanbanCreativeBriefs
   Description: React kanban board for Next.js with creative brief workflow columns and a Sheet side panel showing brand details, objectives, target audience, assets, and feedback using shadcn/ui Sheet and Tailwind CSS.
   Source: original/blocks/kanban/kanban-creative-briefs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="palette" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Creative Briefs</h2>
            <span class="text-xs text-muted-foreground">@_briefs.Length briefs</span>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_briefs.Count(b => b.Priority == "urgent")
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_briefs.Count(b => b.Priority == "high")
                </span>
            </div>
        </div>

        @* Kanban columns *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var col in _columns)
            {
                var colBriefs = _briefs.Where(b => b.Stage == col.Stage).ToArray();
                <div class="min-h-[480px]">
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", StageDotClass(col.Stage))"></span>
                        <span class="text-xs font-medium">@col.Label</span>
                        <span class="ml-auto text-xs text-muted-foreground">@colBriefs.Length</span>
                    </div>
                    <div class="divide-y">
                        @foreach (var brief in colBriefs)
                        {
                            var item = brief;
                            <button type="button"
                                    @onclick="@(() => _selectedId = item.Id)"
                                    class="@Cn.Merge("flex w-full flex-col gap-1 border-l-4 px-3 py-2.5 text-left transition-colors hover:bg-muted/50", StageBorderClass(item.Stage), _selectedId == item.Id ? "bg-muted/50 ring-2 ring-foreground ring-inset" : "")">
                                <span class="truncate text-sm font-medium">@item.Title</span>
                                <span class="truncate text-xs text-muted-foreground">@item.Brand</span>
                                <div class="flex items-center gap-2">
                                    <span class="@Cn.Merge("size-1.5 rounded-full", PriorityDotClass(item.Priority))"></span>
                                    <span class="text-xs text-muted-foreground">@item.DueDate</span>
                                    <span class="ml-auto flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium text-muted-foreground">
                                        @item.Initials
                                    </span>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@* Sheet side panel *@
<SheetCn Open="@(_selectedBrief != null)" OpenChanged="@(v => { if (!v) _selectedId = null; })">
    <SheetContentCn Class="overflow-y-auto sm:max-w-md">
        @if (_selectedBrief != null)
        {
            var sel = _selectedBrief;
            <SheetHeaderCn>
                <SheetTitleCn Class="text-sm font-medium">@sel.Title</SheetTitleCn>
                <SheetDescriptionCn>
                    <span class="flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", StageDotClass(sel.Stage))"></span>
                        <span class="capitalize text-xs">@sel.Stage.Replace("-", " ")</span>
                        <span class="text-xs text-muted-foreground">·</span>
                        <span class="flex items-center gap-1 text-xs">
                            <span class="@Cn.Merge("size-1.5 rounded-full", PriorityDotClass(sel.Priority))"></span>
                            @sel.Priority
                        </span>
                    </span>
                </SheetDescriptionCn>
            </SheetHeaderCn>

            @* Brand & Due date *@
            <div class="border-b px-4 pb-4">
                <div class="space-y-2">
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Brand</span>
                        <span class="font-medium">@sel.Brand</span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Due</span>
                        <span class="font-medium">@sel.DueDate</span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Assignee</span>
                        <span class="flex items-center gap-1.5 font-medium">
                            <span class="flex size-5 items-center justify-center rounded-full bg-muted text-[9px] text-muted-foreground">
                                @sel.Initials
                            </span>
                            @sel.Assignee
                        </span>
                    </div>
                </div>
            </div>

            @* Objectives *@
            <div class="border-b px-4 py-4">
                <span class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                    <LucideIconCn Name="target" Size="14" Class="size-3.5" />
                    Objectives
                </span>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                    @sel.Objectives
                </p>
            </div>

            @* Target audience *@
            <div class="border-b px-4 py-4">
                <span class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                    <LucideIconCn Name="users" Size="14" Class="size-3.5" />
                    Target Audience
                </span>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                    @sel.TargetAudience
                </p>
            </div>

            @* Required assets *@
            <div class="border-b px-4 py-4">
                <span class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                    <LucideIconCn Name="image" Size="14" Class="size-3.5" />
                    Required Assets
                </span>
                <div class="mt-2 space-y-1.5">
                    @foreach (var asset in sel.Assets)
                    {
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="file-text" Size="12" Class="size-3 text-muted-foreground/40" />
                            <span>@asset</span>
                        </div>
                    }
                </div>
            </div>

            @* Feedback thread *@
            <div class="px-4 py-4">
                <span class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                    <LucideIconCn Name="message-circle" Size="14" Class="size-3.5" />
                    Feedback
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@sel.Feedback.Length</BadgeCn>
                </span>
                <div class="mt-3 space-y-3">
                    @foreach (var entry in sel.Feedback)
                    {
                        var fb = entry;
                        <div class="rounded-md bg-muted/50 p-3">
                            <div class="flex items-center gap-2">
                                <span class="flex size-5 items-center justify-center rounded-full bg-muted text-[9px] font-medium text-muted-foreground">
                                    @fb.Initials
                                </span>
                                <span class="text-xs font-medium">@fb.Author</span>
                                <span class="ml-auto text-[10px] text-muted-foreground">@fb.Time</span>
                            </div>
                            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                                @fb.Message
                            </p>
                        </div>
                    }
                </div>
            </div>

            @* Actions *@
            <div class="flex gap-2 border-t px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Edit brief
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">
                    Add feedback
                </ButtonCn>
            </div>
        }
    </SheetContentCn>
</SheetCn>

@code {
