@* ============================================================
   Block: kanban-investment-tracker
   Title: KanbanInvestmentTracker
   Description: React portfolio management kanban for Next.js with ultra-compact cards, HoverCard detail popups showing entry price, current value, return percentage, allocation, and investment thesis using shadcn/ui HoverCard and Tailwind CSS.
   Source: original/blocks/kanban/kanban-investment-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Portfolio Tracker</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_investments.Length assets
                </BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs">Hover to preview</span>
        </div>

        @* Columns *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var col in _columns)
            {
                var colInvestments = _investments.Where(inv => inv.Stage == col.Stage).ToArray();
                <div>
                    @* Column Header *@
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", col.Dot)"></span>
                        <span class="font-medium text-xs">@col.Label</span>
                        <span class="ml-auto font-mono text-[10px] text-muted-foreground/60 tabular-nums">
                            @colInvestments.Length
                        </span>
                    </div>

                    @* Cards *@
                    <div>
                        @for (var i = 0; i < colInvestments.Length; i++)
                        {
                            var inv = colInvestments[i];
                            var isLast = i == colInvestments.Length - 1;
                            var colDot = col.Dot;
                            <HoverCardCn OpenDelay="200" CloseDelay="100">
                                <HoverCardTriggerCn Class="@Cn.Merge("flex w-full cursor-default items-center gap-2 px-3 py-2 text-left transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full opacity-40", colDot)"></span>
                                    <span class="min-w-0 flex-1 truncate text-xs">@inv.Ticker</span>
                                    @if (inv.Stage != "watching")
                                    {
                                        <span class="@Cn.Merge("shrink-0 font-mono text-[10px] tabular-nums", inv.ReturnPct > 0 ? "text-emerald-600 dark:text-emerald-400" : inv.ReturnPct < 0 ? "text-red-600 dark:text-red-400" : "text-muted-foreground/60")">
                                            @(inv.ReturnPct > 0 ? "+" : "")@inv.ReturnPct%
                                        </span>
                                    }
                                </HoverCardTriggerCn>
                                <HoverCardContentCn Side="FloatingSide.Right" Align="FloatingAlign.Start" Class="w-72 p-0">
                                    <div class="border-b px-3 py-2.5">
                                        <div class="flex items-center gap-2">
                                            <span class="font-medium text-sm">@inv.Name</span>
                                        </div>
                                        <div class="mt-0.5 flex items-center gap-1.5">
                                            <span class="font-mono text-muted-foreground text-xs">@inv.Ticker</span>
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">@inv.AssetClass</BadgeCn>
                                        </div>
                                    </div>
                                    <div class="space-y-2 px-3 py-2.5">
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Entry price</span>
                                            <span class="font-medium tabular-nums">@inv.EntryPrice</span>
                                        </div>
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Current value</span>
                                            <span class="font-medium tabular-nums">@inv.CurrentValue</span>
                                        </div>
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Return</span>
                                            <span class="@Cn.Merge("font-medium tabular-nums", inv.ReturnPct > 0 ? "text-emerald-600 dark:text-emerald-400" : inv.ReturnPct < 0 ? "text-red-600 dark:text-red-400" : "text-muted-foreground")">
                                                @(inv.ReturnPct > 0 ? "+" : "")@inv.ReturnPct%
                                            </span>
                                        </div>
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Allocation</span>
                                            <span class="font-medium tabular-nums">@inv.Allocation</span>
                                        </div>
                                    </div>
                                    <div class="border-t bg-muted/30 px-3 py-2">
                                        <span class="text-muted-foreground text-xs">Thesis</span>
                                        <p class="mt-0.5 text-xs leading-relaxed">@inv.Thesis</p>
                                    </div>
                                </HoverCardContentCn>
                            </HoverCardCn>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_investments.Count(inv => inv.Stage == "holding") core holdings
            </span>
            <span class="text-muted-foreground/60 text-xs">Prices as of close</span>
        </div>
    </div>
</section>

