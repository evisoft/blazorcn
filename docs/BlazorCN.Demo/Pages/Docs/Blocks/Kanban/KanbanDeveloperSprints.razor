@* ============================================================
   Block: kanban-developer-sprints
   Title: KanbanDeveloperSprints
   Description: React kanban developer sprint swimlane board for Next.js with avatar rows, PR status columns, ticket IDs, and merge tracking using shadcn/ui Avatar and Tailwind CSS
   Source: original/blocks/kanban/kanban-developer-sprints.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Sprint 24 — Developer View</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_tasks.Length tasks · @_tasks.Count(t => t.Status == "merged") merged
                    </p>
                </div>
                <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        High
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        Medium
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-blue-500"></span>
                        Low
                    </span>
                </div>
            </div>
        </div>

        @* Column headers *@
        <div class="grid grid-cols-[160px_1fr_1fr_1fr_1fr_48px] border-b bg-muted/30">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Developer</span>
            </div>
            @foreach (var s in _statuses)
            {
                <div class="px-3 py-2">
                    <span class="font-medium text-muted-foreground text-xs">@s.Label</span>
                </div>
            }
            <div class="px-2 py-2">
                <span class="font-medium text-muted-foreground text-xs">#</span>
            </div>
        </div>

        @* Swimlane rows *@
        <div>
            @for (int i = 0; i < _developers.Length; i++)
            {
                var dev = _developers[i];
                var devTasks = _tasks.Where(t => t.DeveloperId == dev.Id).ToArray();
                var isLast = i == _developers.Length - 1;
                <div class="@Cn.Merge("grid grid-cols-[160px_1fr_1fr_1fr_1fr_48px] items-start", !isLast ? "border-b" : "")">
                    @* Avatar cell *@
                    <div class="flex items-center gap-2.5 px-4 py-3">
                        <AvatarCn Class="size-7">
                            <AvatarFallbackCn Class="text-[10px]">@dev.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0">
                            <p class="truncate font-medium text-sm">@dev.Name</p>
                            <p class="truncate text-muted-foreground text-xs">@dev.Focus</p>
                        </div>
                    </div>

                    @* Status cells *@
                    @foreach (var s in _statuses)
                    {
                        var statusKey = s.Key;
                        var cellTasks = devTasks.Where(t => t.Status == statusKey).ToArray();
                        <div class="min-h-[60px] px-2 py-2.5">
                            @if (cellTasks.Length > 0)
                            {
                                <div class="flex flex-col gap-1.5">
                                    @foreach (var task in cellTasks)
                                    {
                                        <div class="flex items-center gap-2 rounded-md bg-muted/50 px-2.5 py-1.5 transition-colors hover:bg-muted">
                                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _priorityDot[task.Priority])"></span>
                                            <div class="flex min-w-0 flex-1 items-center gap-1.5">
                                                <span class="shrink-0 font-mono text-muted-foreground text-[10px]">@task.TicketId</span>
                                                <span class="truncate text-xs">@task.Title</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(task.PrNumber))
                                            {
                                                <span class="flex shrink-0 items-center gap-0.5 text-muted-foreground text-[10px]">
                                                    <LucideIconCn Name="git-pull-request" Size="10" Class="size-2.5" />
                                                    @task.PrNumber
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="flex min-h-[36px] items-center justify-center rounded-md border border-dashed border-muted-foreground/20">
                                    <span class="text-muted-foreground/40 text-xs">—</span>
                                </div>
                            }
                        </div>
                    }

                    @* Count cell *@
                    <div class="flex items-center justify-center py-3">
                        <span class="font-medium text-muted-foreground text-xs tabular-nums">@devTasks.Length</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StatusConfig(string Key, string Label);

    private record Developer(string Id, string Name, string Initials, string Focus);

    private record Task(
        string Id,
        string TicketId,
        string Title,
        string DeveloperId,
        string Status,
        string Priority,
        string PrNumber
    );

    private static readonly StatusConfig[] _statuses =
    [
        new("assigned", "Assigned"),
        new("coding", "Coding"),
        new("pr_open", "PR Open"),
        new("merged", "Merged"),
    ];

    private static readonly Dictionary<string, string> _priorityDot = new()
    {
        ["high"] = "bg-red-500",
        ["medium"] = "bg-amber-500",
        ["low"] = "bg-blue-500",
