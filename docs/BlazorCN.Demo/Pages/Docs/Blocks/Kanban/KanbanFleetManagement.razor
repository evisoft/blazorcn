@* ============================================================
   Block: kanban-fleet-management
   Title: KanbanFleetManagement
   Description: React dual-view fleet management kanban for Next.js with Switch toggle between board and table views using shadcn/ui Table, Switch, and Tailwind CSS.
   Source: original/blocks/kanban/kanban-fleet-management.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="truck" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Fleet Management</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    @_vehicles.Length vehicles
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-3">
                    @foreach (var col in _columnsConfig)
                    {
                        var colStatus = col.Status;
                        <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span class="@Cn.Merge("size-1.5 rounded-full", GetStatusDot(colStatus))"></span>
                            @_vehicles.Count(v => v.Status == colStatus)
                        </span>
                    }
                </div>
                <div class="mx-1 h-4 w-px bg-border"></div>
                <div class="flex items-center gap-2">
                    <span class="text-xs text-muted-foreground">
                        @(_isTableView ? "Table" : "Board")
                    </span>
                    <SwitchCn Size="SwitchSize.Sm" Checked="@_isTableView" CheckedChanged="@((bool v) => _isTableView = v)" />
                </div>
            </div>
        </div>

        @* Content *@
        @if (_isTableView)
        {
            @* Table View *@
            <TableCn>
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-10">
                            <span class="sr-only">Status</span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Vehicle ID
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Type
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Driver
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Mileage
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Next Service
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var vehicle in _vehicles)
                    {
                        <TableRowCn>
                            <TableCellCn>
                                <span class="@Cn.Merge("inline-block size-2 rounded-full", GetStatusDot(vehicle.Status))"></span>
                            </TableCellCn>
                            <TableCellCn Class="font-mono text-sm font-medium">@vehicle.VehicleId</TableCellCn>
                            <TableCellCn>
                                <span class="flex items-center gap-1.5 text-muted-foreground">
                                    <LucideIconCn Name="@GetTypeIconName(vehicle.Type)" Size="12" Class="size-3 text-muted-foreground" />
                                    @vehicle.Type
                                </span>
                            </TableCellCn>
                            <TableCellCn>
                                @if (!string.IsNullOrEmpty(vehicle.Driver))
                                {
                                    <span>@vehicle.Driver</span>
                                }
                                else
                                {
                                    <span class="text-muted-foreground/60">--</span>
                                }
                            </TableCellCn>
                            <TableCellCn Class="font-mono text-xs tabular-nums">@vehicle.Mileage mi</TableCellCn>
                            <TableCellCn>
                                <span class="@Cn.Merge("text-xs", GetNextServiceClass(vehicle.NextService))">
                                    @vehicle.NextService
                                </span>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        }
        else
        {
            @* Board View *@
            <div class="grid grid-cols-4 divide-x">
                @foreach (var column in _columnsConfig)
                {
                    var colStatus = column.Status;
                    var colLabel = column.Label;
                    var colVehicles = _vehicles.Where(v => v.Status == colStatus).ToArray();
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                            <span class="@Cn.Merge("size-1.5 rounded-full", GetStatusDot(colStatus))"></span>
                            <span class="text-xs font-medium text-muted-foreground">@colLabel</span>
                            <span class="text-xs text-muted-foreground/60">@colVehicles.Length</span>
                        </div>
                        <div class="p-2">
                            <div class="flex flex-col gap-1.5">
                                @foreach (var vehicle in colVehicles)
                                {
                                    <div class="rounded-md border bg-card p-2.5 transition-colors hover:bg-muted/50">
                                        <div class="mb-1.5 flex items-start gap-2">
                                            <LucideIconCn Name="@GetStatusIconName(vehicle.Status)" Size="14" Class="@GetStatusIconClass(vehicle.Status)" />
                                            <div class="min-w-0 flex-1">
                                                <span class="block font-mono text-sm font-medium leading-tight">@vehicle.VehicleId</span>
                                                <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                                    <LucideIconCn Name="@GetTypeIconName(vehicle.Type)" Size="12" Class="size-3 text-muted-foreground" />
                                                    @vehicle.Type
                                                </span>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-2 pl-5.5">
                                            @if (!string.IsNullOrEmpty(vehicle.Driver))
                                            {
                                                <span class="text-xs text-muted-foreground">@vehicle.Driver</span>
                                            }
                                            else
                                            {
                                                <span class="text-xs text-muted-foreground/60">Unassigned</span>
                                            }
                                            <span class="text-muted-foreground/40">@("·")</span>
                                            <span class="font-mono text-xs text-muted-foreground tabular-nums">@vehicle.Mileage mi</span>
                                            <span class="text-muted-foreground/40">@("·")</span>
                                            <span class="@Cn.Merge("text-xs", GetNextServiceClass(vehicle.NextService))">
                                                @vehicle.NextService
                                            </span>
                                        </div>
                                    </div>
                                }
                                @if (colVehicles.Length == 0)
                                {
                                    <div class="py-8 text-center text-xs text-muted-foreground/60">
                                        No vehicles
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_vehicles.Count(v => v.Status == "in-use") vehicles on the road
            </span>
            <span class="text-xs text-muted-foreground/60">Updated 2 min ago</span>
        </div>
    </div>
</section>

@code {
    private bool _isTableView = false;

    private record Vehicle(string Id, string VehicleId, string Status, string Type, string Driver, string Mileage, string NextService);
    private record ColumnConfig(string Status, string Label);

    private static readonly Vehicle[] _vehicles =
    [
        new("v1",  "FL-001", "available",      "Sedan", "",            "24,100", "Apr 15"),
        new("v2",  "FL-002", "available",      "EV",    "",            "12,800", "May 1"),
        new("v3",  "FL-003", "available",      "SUV",   "",            "38,200", "Apr 22"),
        new("v4",  "FL-004", "in-use",         "Truck", "Mike Torres", "67,400", "Apr 10"),
        new("v5",  "FL-005", "in-use",         "Van",   "Sarah Kim",   "52,100", "Apr 28"),
        new("v6",  "FL-006", "in-use",         "Sedan", "James Park",  "31,600", "May 5"),
        new("v7",  "FL-007", "in-use",         "EV",    "Lisa Chen",   "8,900",  "Jun 1"),
        new("v8",  "FL-008", "maintenance",    "Truck", "",            "89,300", "In shop"),
        new("v9",  "FL-009", "maintenance",    "Van",   "",            "74,500", "In shop"),
        new("v10", "FL-010", "maintenance",    "SUV",   "",            "45,200", "In shop"),
        new("v11", "FL-011", "decommissioned", "Sedan", "",            "142,800","N/A"),
        new("v12", "FL-012", "decommissioned", "Truck", "",            "198,500","N/A"),
    ];

    private static readonly ColumnConfig[] _columnsConfig =
    [
        new("available",      "Available"),
        new("in-use",         "In Use"),
        new("maintenance",    "Maintenance"),
        new("decommissioned", "Decommissioned"),
    ];

    private static string GetStatusDot(string status) => status switch
    {
        "available"      => "bg-emerald-500",
        "in-use"         => "bg-blue-500",
        "maintenance"    => "bg-amber-500",
        "decommissioned" => "bg-zinc-400",
        _                => "",
    };

    private static string GetStatusIconName(string status) => status switch
    {
        "available"      => "check-circle-2",
        "in-use"         => "fuel",
        "maintenance"    => "wrench",
        "decommissioned" => "x-circle",
        _                => "circle",
    };

    private static string GetStatusIconClass(string status) => status switch
    {
        "available"      => "size-3.5 text-emerald-500",
        "in-use"         => "size-3.5 text-blue-500",
        "maintenance"    => "size-3.5 text-amber-500",
        "decommissioned" => "size-3.5 text-zinc-400",
        _                => "size-3.5",
    };

    private static string GetTypeIconName(string type) => type switch
    {
        "Sedan" => "car",
        "SUV"   => "car",
        "Van"   => "truck",
        "Truck" => "truck",
        "EV"    => "fuel",
        _       => "car",
    };

    private static string GetNextServiceClass(string nextService) => nextService switch
    {
        "In shop" => "text-amber-500",
        "N/A"     => "text-muted-foreground/60",
        _         => "text-muted-foreground",
    };
}
