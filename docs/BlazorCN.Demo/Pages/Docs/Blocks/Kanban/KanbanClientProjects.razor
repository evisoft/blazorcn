@* ============================================================
   Block: kanban-client-projects
   Title: KanbanClientProjects
   Description: React kanban board for Next.js with client project columns, budget tracking, and a Sheet side panel showing project details, deliverables, and activity using shadcn/ui Sheet and Tailwind CSS.
   Source: original/blocks/kanban/kanban-client-projects.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="briefcase" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Client Projects</h2>
            <span class="text-xs text-muted-foreground">@_projects.Length projects</span>
            <span class="text-xs text-muted-foreground">·</span>
            <span class="text-xs text-muted-foreground">
                @FormatCurrency(_projects.Sum(p => p.Budget)) total budget
            </span>
        </div>

        @* Kanban columns *@
        <div class="grid grid-cols-5 divide-x">
            @foreach (var col in _columns)
            {
                var colStage = col.Stage;
                var colProjects = _projects.Where(p => p.Stage == colStage).ToArray();
                var colBudget = colProjects.Sum(p => p.Budget);
                <div class="min-h-[480px]">
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _stageDot.TryGetValue(colStage, out var dot) ? dot : "")"></span>
                        <span class="text-xs font-medium">@col.Label</span>
                        <span class="ml-auto text-xs text-muted-foreground tabular-nums">
                            @FormatCurrency(colBudget)
                        </span>
                    </div>
                    <div class="divide-y">
                        @foreach (var proj in colProjects)
                        {
                            var project = proj;
                            var isSelected = _selectedId == project.Id;
                            <button
                                type="button"
                                @onclick="@(() => _selectedId = project.Id)"
                                class="@Cn.Merge("flex w-full flex-col gap-1 border-l-4 px-3 py-2.5 text-left transition-colors hover:bg-muted/50", _stageBorder.TryGetValue(project.Stage, out var border) ? border : "", isSelected ? "bg-muted/50 ring-2 ring-foreground ring-inset" : "")">
                                <span class="truncate text-sm font-medium">@project.Name</span>
                                <span class="truncate text-xs text-muted-foreground">
                                    @project.Client
                                </span>
                                <div class="flex items-center gap-2">
                                    <span class="text-xs text-muted-foreground tabular-nums">
                                        @FormatCurrency(project.Budget)
                                    </span>
                                    <span class="ml-auto flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium text-muted-foreground">
                                        @project.Initials
                                    </span>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@* Sheet side panel *@
<SheetCn Open="@(_selectedId != null)" OpenChanged="@(v => { if (!v) _selectedId = null; })">
    <SheetOverlayCn />
    <SheetContentCn Side="SheetSide.Right" Class="overflow-y-auto sm:max-w-md">
        @{
            var sel = _projects.FirstOrDefault(p => p.Id == _selectedId);
        }
        @if (sel != null)
        {
            <SheetHeaderCn>
                <SheetTitleCn Class="text-sm font-medium">@sel.Name</SheetTitleCn>
                <SheetDescriptionCn>
                    <span class="flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _stageDot.TryGetValue(sel.Stage, out var selDot) ? selDot : "")"></span>
                        <span class="capitalize text-xs">@sel.Stage</span>
                    </span>
                </SheetDescriptionCn>
            </SheetHeaderCn>

            @* Client info *@
            <div class="border-b px-4 pb-4">
                <span class="text-xs font-medium text-muted-foreground">Client</span>
                <div class="mt-2 space-y-2">
                    <div class="flex items-center gap-2 text-xs">
                        <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span>@sel.Client</span>
                    </div>
                    <div class="flex items-center gap-2 text-xs">
                        <LucideIconCn Name="mail" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-muted-foreground">@sel.ClientEmail</span>
                    </div>
                    <div class="flex items-center gap-2 text-xs">
                        <LucideIconCn Name="phone" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-muted-foreground">@sel.ClientPhone</span>
                    </div>
                </div>
            </div>

            @* Budget & timeline *@
            <div class="border-b px-4 py-4">
                <span class="text-xs font-medium text-muted-foreground">Budget &amp; Timeline</span>
                <div class="mt-2 space-y-2.5">
                    <div class="flex items-center justify-between text-xs">
                        <span class="flex items-center gap-2">
                            <LucideIconCn Name="dollar-sign" Size="14" Class="size-3.5 text-muted-foreground" />
                            Budget
                        </span>
                        <span class="font-semibold tabular-nums">
                            @FormatCurrency(sel.Budget)
                        </span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Spent</span>
                        <span class="font-medium tabular-nums">
                            @FormatCurrency(sel.Spent)
                        </span>
                    </div>
                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        @{
                            var ratio = sel.Budget > 0 ? (double)sel.Spent / sel.Budget : 0;
                            var barColor = ratio > 0.9 ? "bg-red-500" : ratio > 0.7 ? "bg-amber-500" : "bg-emerald-500";
                            var barWidth = Math.Min(100, (int)Math.Round(ratio * 100));
                        }
                        <div class="@Cn.Merge("h-full rounded-full transition-all", barColor)"
                             style="@($"width:{barWidth}%")">
                        </div>
                    </div>
                    <div class="flex items-center justify-between text-xs text-muted-foreground">
                        <span class="flex items-center gap-2">
                            <LucideIconCn Name="calendar" Size="14" Class="size-3.5" />
                            @sel.StartDate
                        </span>
                        <span>@sel.DueDate</span>
                    </div>
                </div>
            </div>

            @* Deliverables *@
            <div class="border-b px-4 py-4">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-muted-foreground">Deliverables</span>
                    <span class="text-xs text-muted-foreground tabular-nums">
                        @sel.Deliverables.Count(d => d.Done)/@sel.Deliverables.Length
                    </span>
                </div>
                <div class="mt-2 space-y-2">
                    @foreach (var deliv in sel.Deliverables)
                    {
                        <div class="flex items-center gap-2 text-xs">
                            @if (deliv.Done)
                            {
                                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="circle" Size="14" Class="size-3.5 text-muted-foreground/40" />
                            }
                            <span class="@Cn.Merge(deliv.Done ? "text-muted-foreground line-through" : "")">
                                @deliv.Label
                            </span>
                        </div>
                    }
                </div>
            </div>

            @* Assignee *@
            <div class="border-b px-4 py-4">
                <span class="text-xs font-medium text-muted-foreground">Assignee</span>
                <div class="mt-2 flex items-center gap-2">
                    <span class="flex size-6 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                        @sel.Initials
                    </span>
                    <span class="text-xs font-medium">@sel.Assignee</span>
                </div>
            </div>

            @* Activity *@
            <div class="px-4 py-4">
                <span class="text-xs font-medium text-muted-foreground">Recent Activity</span>
                <div class="mt-2 space-y-3">
                    @foreach (var act in sel.Activity)
                    {
                        <div class="flex flex-col gap-0.5">
                            <span class="text-xs">@act.Text</span>
                            <span class="text-xs text-muted-foreground">@act.Time</span>
                        </div>
                    }
                </div>
            </div>

            @* Actions *@
            <div class="flex gap-2 border-t px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Edit project
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">
                    Message client
                </ButtonCn>
            </div>
        }
    </SheetContentCn>
</SheetCn>

