@* ============================================================
   Block: kanban-sprint-timeline
   Title: KanbanSprintTimeline
   Description: React sprint timeline kanban board for Next.js with date range header, story point tracking, and sprint boundary columns using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-sprint-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="iteration-ccw" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Sprint Timeline</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Sprint 14
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="zap" Size="12" Class="size-3" />
                    @_currentPoints pts this sprint
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">@_totalPoints pts total</span>
            </div>
        </div>

        @* Timeline header *@
        <div class="border-b bg-muted/30 px-4 py-2.5">
            <div class="flex items-center">
                @for (int i = 0; i < _timelineDates.Length; i++)
                {
                    var date = _timelineDates[i];
                    var idx = i;
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <span class="@Cn.Merge("font-mono text-[10px]", idx == _todayIndex ? "font-semibold text-foreground" : idx < _todayIndex ? "text-muted-foreground/60" : "text-muted-foreground")">
                            @date
                        </span>
                        <span class="@Cn.Merge("size-1.5 rounded-full", idx == _todayIndex ? "bg-foreground" : idx < _todayIndex ? "bg-muted-foreground/30" : "bg-muted-foreground/20")">
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-3">
            @for (int ci = 0; ci < _columns.Length; ci++)
            {
                var col = _columns[ci];
                var colIndex = ci;
                var colStories = _stories.Where(s => s.Sprint == col.Id).OrderBy(s => _urgencyOrder[s.Urgency]).ToArray();
                var colPoints = colStories.Sum(s => s.Points);
                var isLast = colIndex == _columns.Length - 1;
                <div class="@Cn.Merge(!isLast ? "border-r" : "")">
                    @* Column header *@
                    <div class="border-b px-3 py-2.5">
                        <div class="flex items-center justify-between">
                            <span class="font-medium text-xs">@col.Label</span>
                            <span class="font-mono text-muted-foreground/60 text-xs">@colStories.Length</span>
                        </div>
                        <div class="mt-0.5 flex items-center justify-between">
                            <span class="font-mono text-[10px] text-muted-foreground">@col.DateRange</span>
                            <span class="font-mono text-[10px] text-muted-foreground tabular-nums">@(colPoints) pts</span>
                        </div>
                    </div>

                    @* Cards *@
                    <div class="flex flex-col gap-1 p-2">
                        @foreach (var story in colStories)
                        {
                            var uc = _urgencyConfig[story.Urgency];
                            <div class="overflow-hidden rounded-md transition-colors hover:bg-muted/50">
                                @* Urgency bar *@
                                <div class="@Cn.Merge("h-0.5", uc.Bar)"></div>
                                <div class="px-2.5 py-2">
                                    <div class="flex items-start gap-2">
                                        <div class="min-w-0 flex-1">
                                            <span class="line-clamp-2 text-xs font-medium">@story.Title</span>

                                            @* Urgency + remaining *@
                                            <div class="mt-1 flex items-center gap-1.5">
                                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", uc.Dot)"></span>
                                                <span class="@Cn.Merge("text-[10px]", uc.Text)">@story.UrgencyLabel</span>
                                            </div>

                                            @* Sprint time + points *@
                                            <div class="mt-1 flex items-center justify-between">
                                                <span class="text-[10px] text-muted-foreground">@story.DaysRemaining</span>
                                                <span class="font-mono text-[10px] text-muted-foreground tabular-nums">@(story.Points)p</span>
                                            </div>
                                        </div>

                                        <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium">
                                            @story.Initials
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (colStories.Length == 0)
                        {
                            <div class="rounded-md border border-dashed border-muted-foreground/20 px-2 py-3 text-center text-muted-foreground/40 text-xs">
                                Empty
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_stories.Length stories · 3 sprints
            </span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span> At risk
                </span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span> Today
                </span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span> This week
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record Story(string Id, string Title, string Sprint, int Points, string Assignee, string Initials, string Urgency, string UrgencyLabel, string DaysRemaining);
    private record SprintColumn(string Id, string Label, string DateRange);
    private record UrgencyStyle(string Dot, string Text, string Bar);

    private static readonly string[] _timelineDates = ["Mar 28", "Mar 29", "Mar 30", "Mar 31", "Apr 1", "Apr 2", "Apr 3"];
    private const int _todayIndex = 4;

    private static readonly SprintColumn[] _columns =
    [
        new("current", "This Sprint", "Mar 24 – Apr 4"),
        new("next",    "Next Sprint", "Apr 7 – Apr 18"),
        new("backlog", "Backlog",     "Unscheduled"),
    ];

    private static readonly Dictionary<string, UrgencyStyle> _urgencyConfig = new()
    {
        ["overdue"] = new("bg-red-500",             "text-red-600 dark:text-red-400",     "bg-red-500"),
        ["today"]   = new("bg-amber-500",           "text-amber-600 dark:text-amber-400", "bg-amber-500"),
        ["week"]    = new("bg-blue-500",            "text-blue-600 dark:text-blue-400",   "bg-blue-500"),
        ["future"]  = new("bg-muted-foreground/40", "text-muted-foreground",              "bg-muted-foreground/30"),
    };

    private static readonly Dictionary<string, int> _urgencyOrder = new()
    {
        ["overdue"] = 0,
        ["today"]   = 1,
        ["week"]    = 2,
        ["future"]  = 3,
    };

    private static readonly Story[] _stories =
    [
        new("s1",  "Implement OAuth2 PKCE flow",           "current", 8,  "Sarah Chen",    "SC", "overdue", "At risk",      "3d left in sprint"),
        new("s2",  "WebSocket reconnection logic",          "current", 5,  "Marcus Rivera", "MR", "today",   "Due today",    "3d left in sprint"),
        new("s3",  "Dashboard chart filters",               "current", 3,  "Priya Patel",   "PP", "week",    "3 days left",  "3d left in sprint"),
        new("s4",  "Email template builder",                "current", 5,  "James O'Brien", "JO", "week",    "3 days left",  "3d left in sprint"),
        new("s5",  "API rate limiter refactor",             "current", 3,  "Sarah Chen",    "SC", "week",    "3 days left",  "3d left in sprint"),
        new("s6",  "Notification preference center",        "next",    5,  "Marcus Rivera", "MR", "future",  "Apr 7–18",     "Next sprint"),
        new("s7",  "Search indexing pipeline v2",           "next",    8,  "Priya Patel",   "PP", "future",  "Apr 7–18",     "Next sprint"),
        new("s8",  "Role-based access controls",            "next",    5,  "James O'Brien", "JO", "future",  "Apr 7–18",     "Next sprint"),
        new("s9",  "Billing page redesign",                 "next",    3,  "Sarah Chen",    "SC", "future",  "Apr 7–18",     "Next sprint"),
        new("s10", "GraphQL federation gateway",            "backlog", 13, "Marcus Rivera", "MR", "future",  "Unscheduled",  "Backlog"),
        new("s11", "Mobile push notification service",      "backlog", 8,  "Priya Patel",   "PP", "future",  "Unscheduled",  "Backlog"),
        new("s12", "Data export compliance module",         "backlog", 5,  "James O'Brien", "JO", "future",  "Unscheduled",  "Backlog"),
    ];

    private int _totalPoints => _stories.Sum(s => s.Points);
    private int _currentPoints => _stories.Where(s => s.Sprint == "current").Sum(s => s.Points);
}
