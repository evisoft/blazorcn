@* ============================================================
   Block: kanban-product-catalog
   Title: KanbanProductCatalog
   Description: React dual-view product catalog kanban for Next.js with Switch toggle between board and table views using shadcn/ui Table, Switch, and Tailwind CSS.
   Source: original/blocks/kanban/kanban-product-catalog.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shopping-bag" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Product Catalog</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    @_products.Length products
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-3">
                    @foreach (var col in _columns)
                    {
                        var column = col;
                        <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span class="@Cn.Merge("size-1.5 rounded-full", StatusDotClass(column.Status))"></span>
                            @_products.Count(p => p.Status == column.Status)
                        </span>
                    }
                </div>
                <div class="mx-1 h-4 w-px bg-border"></div>
                <div class="flex items-center gap-2">
                    <span class="text-xs text-muted-foreground">
                        @(_isTableView ? "Table" : "Board")
                    </span>
                    <SwitchCn @bind-Checked="@_isTableView" aria-label="Toggle table view" />
                </div>
            </div>
        </div>

        @* Content *@
        @if (_isTableView)
        {
            <TableCn>
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-10">
                            <span class="sr-only">Status</span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Product Name
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Category
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Price
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Stock
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Updated
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var product in _products)
                    {
                        var prod = product;
                        <TableRowCn>
                            <TableCellCn>
                                <span class="@Cn.Merge("inline-block size-2 rounded-full", StatusDotClass(prod.Status))"></span>
                            </TableCellCn>
                            <TableCellCn Class="font-medium">@prod.Name</TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@prod.Category</TableCellCn>
                            <TableCellCn Class="font-mono text-xs">@prod.Price</TableCellCn>
                            <TableCellCn>
                                <span class="@Cn.Merge("tabular-nums", prod.Stock == 0 ? "text-muted-foreground" : "")">
                                    @prod.Stock
                                </span>
                            </TableCellCn>
                            <TableCellCn Class="text-muted-foreground text-xs">@prod.Updated</TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        }
        else
        {
            <div class="grid grid-cols-4 divide-x">
                @foreach (var col in _columns)
                {
                    var column = col;
                    var colProducts = _products.Where(p => p.Status == column.Status).ToArray();
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                            <span class="@Cn.Merge("size-1.5 rounded-full", StatusDotClass(column.Status))"></span>
                            <span class="text-xs font-medium text-muted-foreground">@column.Label</span>
                            <span class="text-xs text-muted-foreground/60">@colProducts.Length</span>
                        </div>
                        <div class="p-2">
                            <div class="flex flex-col gap-1.5">
                                @foreach (var product in colProducts)
                                {
                                    var prod = product;
                                    <div class="rounded-md border bg-card p-2.5 transition-colors hover:bg-muted/50">
                                        <div class="mb-1.5 flex items-start gap-2">
                                            <LucideIconCn Name="@StatusIconName(prod.Status)" Size="14" Class="@Cn.Merge("size-3.5", StatusIconClass(prod.Status))" />
                                            <span class="min-w-0 flex-1 text-sm font-medium leading-tight">@prod.Name</span>
                                        </div>
                                        <div class="flex items-center gap-2 pl-5.5">
                                            <span class="text-xs text-muted-foreground">@prod.Category</span>
                                            <span class="text-muted-foreground/40">·</span>
                                            <span class="font-mono text-xs text-muted-foreground">@prod.Price</span>
                                            @if (prod.Stock > 0)
                                            {
                                                <span class="text-muted-foreground/40">·</span>
                                                <span class="text-xs text-muted-foreground">@prod.Stock in stock</span>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (colProducts.Length == 0)
                                {
                                    <div class="py-8 text-center text-xs text-muted-foreground/60">
                                        No products
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @(_products.Count(p => p.Status == "active")) active products
            </span>
            <span class="text-xs text-muted-foreground/60">Updated 3 min ago</span>
        </div>
    </div>
</section>

@code {
    private record Product(string Id, string Name, string Status, string Category, string Price, int Stock, string Updated);
    private record Column(string Status, string Label);

    private static readonly Product[] _products =
    [
        new("p1",  "Ergonomic Desk Chair",       "draft",        "Furniture",   "$349.00", 0,   "Mar 28"),
        new("p2",  "Wireless Keyboard Pro",       "draft",        "Electronics", "$89.99",  0,   "Mar 27"),
        new("p3",  "Standing Desk Mat",           "draft",        "Accessories", "$45.00",  0,   "Mar 26"),
        new("p4",  "USB-C Hub 7-Port",            "active",       "Electronics", "$59.99",  142, "Mar 25"),
        new("p5",  "Noise Canceling Headphones",  "active",       "Electronics", "$279.00", 87,  "Mar 24"),
        new("p6",  @"Laptop Backpack 15""",       "active",       "Accessories", "$79.99",  234, "Mar 23"),
        new("p7",  "Mechanical Keyboard TKL",     "active",       "Electronics", "$129.00", 56,  "Mar 22"),
        new("p8",  "Monitor Arm Single",          "active",       "Furniture",   "$149.00", 198, "Mar 21"),
        new("p9",  "Webcam 4K Ultra",             "discontinued", "Electronics", "$199.00", 12,  "Mar 20"),
        new("p10", "Desk Organizer Set",          "discontinued", "Accessories", "$34.99",  5,   "Mar 19"),
        new("p11", "LED Desk Lamp V1",            "discontinued", "Furniture",   "$69.00",  3,   "Mar 18"),
        new("p12", "Bluetooth Speaker Mini",      "archived",     "Electronics", "$39.99",  0,   "Mar 17"),
        new("p13", "Cable Management Kit",        "archived",     "Accessories", "$19.99",  0,   "Mar 16"),
        new("p14", "Mouse Pad XL V1",             "archived",     "Accessories", "$24.99",  0,   "Mar 15"),
    ];

    private static readonly Column[] _columns =
    [
        new("draft",        "Draft"),
        new("active",       "Active"),
        new("discontinued", "Discontinued"),
        new("archived",     "Archived"),
    ];

    private bool _isTableView = false;

    private static string StatusDotClass(string status) => status switch
    {
        "draft"        => "bg-zinc-400",
        "active"       => "bg-emerald-500",
        "discontinued" => "bg-amber-500",
        "archived"     => "bg-red-500",
        _              => ""
    };

    private static string StatusIconName(string status) => status switch
    {
        "draft"        => "box",
        "active"       => "check-circle-2",
        "discontinued" => "pause-circle",
        "archived"     => "archive",
        _              => "circle"
    };

    private static string StatusIconClass(string status) => status switch
    {
        "draft"        => "text-muted-foreground",
        "active"       => "text-emerald-500",
        "discontinued" => "text-amber-500",
        "archived"     => "text-red-500",
        _              => "text-muted-foreground"
    };
}
