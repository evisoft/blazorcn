@* ============================================================
   Block: kanban-writer-assignments
   Title: KanbanWriterAssignments
   Description: React kanban content writer assignment swimlane board for Next.js with avatar rows, word count targets, content type badges, and publishing status using shadcn/ui Avatar and Tailwind CSS
   Source: original/blocks/kanban/kanban-writer-assignments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Writer Assignments</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_tasks.Length pieces · @(_tasks.Count(t => t.Status == "published")) published
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">Blog</BadgeCn>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">Guide</BadgeCn>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">Case Study</BadgeCn>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">Newsletter</BadgeCn>
                </div>
            </div>
        </div>

        @* Column headers *@
        <div class="grid grid-cols-[160px_1fr_1fr_1fr_1fr_48px] border-b bg-muted/30">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Writer</span>
            </div>
            @foreach (var s in _statuses)
            {
                var st = s;
                <div class="px-3 py-2">
                    <span class="font-medium text-muted-foreground text-xs">@st.Label</span>
                </div>
            }
            <div class="px-2 py-2">
                <span class="font-medium text-muted-foreground text-xs">#</span>
            </div>
        </div>

        @* Swimlane rows *@
        <div>
            @foreach (var w in _writers)
            {
                var writer = w;
                var writerTasks = _tasks.Where(t => t.WriterId == writer.Id).ToArray();
                var isLast = writer.Id == _writers[_writers.Length - 1].Id;
                <div class="@Cn.Merge("grid grid-cols-[160px_1fr_1fr_1fr_1fr_48px] items-start", !isLast ? "border-b" : "")">
                    @* Avatar cell *@
                    <div class="flex items-center gap-2.5 px-4 py-3">
                        <AvatarCn Class="size-7">
                            <AvatarFallbackCn Class="text-[10px]">@writer.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0">
                            <p class="truncate font-medium text-sm">@writer.Name</p>
                            <p class="truncate text-muted-foreground text-xs">@writer.Beat</p>
                        </div>
                    </div>

                    @* Status cells *@
                    @foreach (var s in _statuses)
                    {
                        var status = s;
                        var cellTasks = writerTasks.Where(t => t.Status == status.Key).ToArray();
                        <div class="min-h-[60px] px-2 py-2.5">
                            @if (cellTasks.Length > 0)
                            {
                                <div class="flex flex-col gap-1.5">
                                    @foreach (var ct in cellTasks)
                                    {
                                        var task = ct;
                                        <div class="flex items-center gap-2 rounded-md bg-muted/50 px-2.5 py-1.5 transition-colors hover:bg-muted">
                                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", PriorityDotClass(task.Priority))"></span>
                                            <div class="flex min-w-0 flex-1 items-center gap-1.5">
                                                <span class="min-w-0 flex-1 truncate text-xs">@task.Title</span>
                                            </div>
                                            <span class="shrink-0 font-mono text-muted-foreground text-[10px]">@(FormatWordCount(task.WordCount))w</span>
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-[10px] px-1.5 py-0">
                                                @task.ContentType
                                            </BadgeCn>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="flex min-h-[36px] items-center justify-center rounded-md border border-dashed border-muted-foreground/20">
                                    <span class="text-muted-foreground/40 text-xs">—</span>
                                </div>
                            }
                        </div>
                    }

                    @* Count cell *@
                    <div class="flex items-center justify-center py-3">
                        <span class="font-medium text-muted-foreground text-xs tabular-nums">@writerTasks.Length</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StatusDef(string Key, string Label);
    private record Writer(string Id, string Name, string Initials, string Beat);
    private record Task(string Id, string Title, string WriterId, string Status, string ContentType, int WordCount, string Priority);

    private static readonly StatusDef[] _statuses =
    [
        new("assigned",  "Assigned"),
        new("writing",   "Writing"),
        new("editing",   "Editing"),
        new("published", "Published"),
    ];

    private static readonly Writer[] _writers =
    [
        new("w1", "Claire Dubois",  "CD", "Product"),
        new("w2", "Sam Ortiz",      "SO", "Engineering"),
        new("w3", "Priya Sharma",   "PS", "Marketing"),
        new("w4", "Leo Tanaka",     "LT", "Customer Stories"),
    ];

    private static readonly Task[] _tasks =
    [
        new("t1",  "API versioning best practices",      "w1", "writing",   "Guide",      2500, "high"),
        new("t2",  "Q1 product changelog",               "w1", "editing",   "Blog",       1200, "medium"),
        new("t3",  "Getting started with webhooks",      "w1", "published", "Guide",      3000, "low"),
        new("t4",  "Migrating from REST to GraphQL",     "w2", "writing",   "Guide",      4000, "high"),
        new("t5",  "Performance tuning PostgreSQL",      "w2", "assigned",  "Blog",       1800, "medium"),
        new("t6",  "CI/CD pipeline deep dive",           "w2", "published", "Guide",      3500, "low"),
        new("t7",  "2026 developer survey results",      "w3", "editing",   "Blog",       2000, "high"),
        new("t8",  "Email nurture sequence copy",        "w3", "writing",   "Newsletter",  800, "medium"),
        new("t9",  "Launch announcement for v3",         "w3", "assigned",  "Blog",       1500, "high"),
        new("t10", "SEO landing page refresh",           "w3", "published", "Blog",       1000, "low"),
        new("t11", "Acme Corp migration story",          "w4", "writing",   "Case Study", 2500, "high"),
        new("t12", "Startup spotlight: Helios",          "w4", "editing",   "Case Study", 2000, "medium"),
        new("t13", "Enterprise onboarding guide",        "w4", "assigned",  "Guide",      3000, "medium"),
        new("t14", "Monthly product newsletter",         "w1", "assigned",  "Newsletter",  600, "medium"),
        new("t15", "Community contributor spotlight",    "w4", "published", "Blog",       1200, "low"),
    ];

    private static string PriorityDotClass(string priority) => priority switch
    {
        "high"   => "bg-red-500",
        "medium" => "bg-amber-500",
        "low"    => "bg-blue-500",
        _        => "",
    };

    private static string FormatWordCount(int count)
    {
        if (count >= 1000)
        {
            double k = count / 1000.0;
            return k % 1 == 0 ? $"{(int)k}k" : $"{k:0.0}k";
        }
        return count.ToString();
    }
}
