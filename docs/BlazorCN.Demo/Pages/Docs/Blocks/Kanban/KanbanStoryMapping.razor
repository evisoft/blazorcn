@* ============================================================
   Block: kanban-story-mapping
   Title: KanbanStoryMapping
   Description: React user story mapping kanban for Next.js with four hierarchy columns, drag-and-drop reordering using @dnd-kit, parent breadcrumbs, and acceptance criteria counts built with shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-story-mapping.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layers" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Story Map</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_items.Length items
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var column in _columns)
                {
                    var col = column;
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", LevelDotClass(col.Id))"></span>
                        @_items.Count(i => i.Level == col.Id)
                    </span>
                }
                <span class="text-muted-foreground/40">|</span>
                <span class="text-muted-foreground text-xs">@_totalAC AC total</span>
            </div>
        </div>

        @* Board *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var column in _columns)
            {
                var col = column;
                var colItems = _items.Where(i => i.Level == col.Id).ToArray();
                <div class="min-w-0">
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", LevelDotClass(col.Id))"></span>
                        <span class="font-medium text-muted-foreground text-xs">@col.Label</span>
                        <span class="text-muted-foreground/60 text-xs">@colItems.Length</span>
                    </div>
                    <div class="flex flex-col gap-1.5 p-2">
                        @foreach (var item in colItems)
                        {
                            <div class="rounded-md border bg-card p-2.5 transition-colors hover:bg-muted/50">
                                @if (item.Parent != null)
                                {
                                    <div class="mb-1 flex items-center gap-1 text-muted-foreground/60 text-[10px]">
                                        <LucideIconCn Name="chevron-right" Size="10" Class="size-2.5" />
                                        <span class="truncate">@item.Parent</span>
                                    </div>
                                }
                                <div class="flex items-start gap-1.5">
                                    <button type="button" class="mt-0.5 shrink-0 cursor-grab touch-none text-muted-foreground/60 active:cursor-grabbing" aria-label="@($"Reorder {item.Title}")">
                                        <LucideIconCn Name="grip-vertical" Size="14" Class="size-3.5" />
                                    </button>
                                    <span class="min-w-0 flex-1 font-medium text-sm leading-tight">@item.Title</span>
                                </div>
                                <div class="mt-1.5 flex items-center gap-2 pl-5">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                        @item.Size
                                    </BadgeCn>
                                    <span class="text-muted-foreground text-[10px]">@item.AcceptanceCriteria AC</span>
                                </div>
                            </div>
                        }
                        @if (colItems.Length == 0)
                        {
                            <div class="rounded-md border border-dashed border-muted-foreground/20 px-2 py-6 text-center text-muted-foreground/40 text-xs">
                                Drop here
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">@_columns.Length hierarchy levels</span>
            <span class="text-muted-foreground/60 text-xs">Drag cards across levels</span>
        </div>
    </div>
</section>

@code {
    private record StoryItem(string Id, string Title, string Level, string? Parent, int AcceptanceCriteria, string Size);
    private record Column(string Id, string Label);

    private static readonly StoryItem[] _items =
    [
        new("e1",  "User Onboarding",                         "epic",    null,                                  12, "XL"),
        new("e2",  "Payment Processing",                      "epic",    null,                                   8, "L"),
        new("e3",  "Team Collaboration",                      "epic",    null,                                  10, "XL"),
        new("s1",  "Sign-up with email and password",         "story",   "User Onboarding",                     5, "M"),
        new("s2",  "Social login with Google and GitHub",     "story",   "User Onboarding",                     4, "M"),
        new("s3",  "Checkout flow with Stripe",               "story",   "Payment Processing",                  6, "L"),
        new("s4",  "Invite team members via email",           "story",   "Team Collaboration",                  3, "S"),
        new("t1",  "Build registration form with validation", "task",    "User Onboarding > Sign-up",           3, "M"),
        new("t2",  "Implement OAuth2 PKCE flow",              "task",    "User Onboarding > Social login",      4, "L"),
        new("t3",  "Integrate Stripe Elements for card input","task",    "Payment > Checkout flow",             3, "M"),
        new("t4",  "Build invitation email template",         "task",    "Collaboration > Invite members",      2, "S"),
        new("st1", "Add password strength meter",             "subtask", "Sign-up > Registration form",         1, "XS"),
        new("st2", "Handle OAuth error states",               "subtask", "Social login > OAuth2 PKCE",          2, "S"),
        new("st3", "Format currency display per locale",      "subtask", "Checkout > Stripe Elements",          1, "XS"),
    ];

    private static readonly Column[] _columns =
    [
        new("epic",    "Epic"),
        new("story",   "Story"),
        new("task",    "Task"),
        new("subtask", "Subtask"),
    ];

    private int _totalAC => _items.Sum(i => i.AcceptanceCriteria);

    private static string LevelDotClass(string level) => level switch
    {
        "epic"    => "bg-violet-500",
        "story"   => "bg-blue-500",
        "task"    => "bg-amber-500",
        "subtask" => "bg-zinc-400",
        _         => ""
    };
}
