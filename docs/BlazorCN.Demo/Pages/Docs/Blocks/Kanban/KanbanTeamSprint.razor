@* ============================================================
   Block: kanban-team-sprint
   Title: KanbanTeamSprint
   Description: React swimlane kanban sprint board for Next.js with team member rows, status columns, and animated task chips using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-team-sprint.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Sprint 24</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_tasks.Length tasks
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    High
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    Medium
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    Low
                </span>
            </div>
        </div>

        @* Grid *@
        <div class="overflow-x-auto">
            @* Column headers *@
            <div class="grid grid-cols-[200px_1fr_1fr_1fr] border-b bg-muted/30">
                <div class="px-4 py-2.5">
                    <span class="font-medium text-muted-foreground text-xs">Team Member</span>
                </div>
                @foreach (var s in _statuses)
                {
                    <div class="border-l px-4 py-2.5">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-muted-foreground text-xs">@s.Label</span>
                            <span class="font-mono text-muted-foreground/60 text-xs">
                                @TotalByStatus(s.Id)
                            </span>
                        </div>
                    </div>
                }
            </div>

            @* Swimlane rows *@
            @foreach (var member in _members)
            {
                var isLast = member.Id == _members[_members.Length - 1].Id;
                <div class="@Cn.Merge("grid grid-cols-[200px_1fr_1fr_1fr]", !isLast ? "border-b" : "")">
                    @* Member label *@
                    <div class="flex items-start gap-2.5 px-4 py-3">
                        <AvatarCn Class="size-6">
                            <AvatarFallbackCn Class="text-[10px]">@member.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0">
                            <span class="font-medium text-sm">@member.Name</span>
                            <p class="text-muted-foreground text-xs">
                                @(_tasks.Count(t => t.Assignee == member.Id)) tasks
                            </p>
                        </div>
                    </div>

                    @* Status cells *@
                    @foreach (var s in _statuses)
                    {
                        var cellTasks = GetTasksForCell(member.Id, s.Id);
                        <div class="@Cn.Merge("border-l px-3 py-2.5", cellTasks.Length == 0 ? "bg-muted/20" : "")">
                            <div class="flex flex-col gap-1.5">
                                @if (cellTasks.Length == 0)
                                {
                                    <div class="rounded-md border border-dashed border-muted-foreground/20 px-2 py-1.5 text-center text-muted-foreground/40 text-xs">
                                        No tasks
                                    </div>
                                }
                                @foreach (var task in cellTasks)
                                {
                                    <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2 py-1 transition-colors hover:bg-muted">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", PriorityDotClass(task.Priority))"></span>
                                        <span class="truncate text-xs">@task.Title</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_members.Length members · @TotalByStatus("done") of @_tasks.Length complete
            </span>
            <span class="font-mono text-muted-foreground/60 text-xs">
                @(Math.Round((double)TotalByStatus("done") / _tasks.Length * 100))% done
            </span>
        </div>
    </div>
</section>

@code {
    private record Member(string Id, string Name, string Initials);
    private record Status(string Id, string Label);
    private record Task(string Id, string Title, string Assignee, string TaskStatus, string Priority);

    private static readonly Member[] _members =
    [
        new("sarah",  "Sarah Chen",     "SC"),
        new("marcus", "Marcus Rivera",  "MR"),
        new("priya",  "Priya Patel",    "PP"),
        new("james",  "James O'Brien",  "JO"),
    ];

    private static readonly Status[] _statuses =
    [
        new("todo",  "Todo"),
        new("doing", "In Progress"),
        new("done",  "Done"),
    ];

    private static readonly Task[] _tasks =
    [
        new("t1",  "Design token system migration",   "sarah",  "doing", "high"),
        new("t2",  "API rate limiter middleware",      "sarah",  "todo",  "medium"),
        new("t3",  "Update onboarding flow copy",      "sarah",  "done",  "low"),
        new("t4",  "WebSocket reconnection logic",     "marcus", "doing", "high"),
        new("t5",  "Audit logging for admin panel",    "marcus", "todo",  "medium"),
        new("t6",  "Fix date picker timezone bug",     "marcus", "done",  "high"),
        new("t7",  "Database index optimization",      "marcus", "done",  "medium"),
        new("t8",  "Accessibility audit for forms",    "priya",  "todo",  "high"),
        new("t9",  "Storybook component docs",         "priya",  "doing", "low"),
        new("t10", "E2E test for checkout flow",       "priya",  "done",  "medium"),
        new("t11", "Stripe webhook retry logic",       "priya",  "todo",  "medium"),
        new("t12", "Redis cache invalidation",         "james",  "todo",  "high"),
        new("t13", "CI pipeline parallelization",      "james",  "doing", "medium"),
        new("t14", "Docker image size reduction",      "james",  "done",  "low"),
        new("t15", "Sentry error grouping rules",      "james",  "done",  "medium"),
    ];

    private static Task[] GetTasksForCell(string assignee, string status)
        => _tasks.Where(t => t.Assignee == assignee && t.TaskStatus == status).ToArray();

    private static int TotalByStatus(string status)
        => _tasks.Count(t => t.TaskStatus == status);

    private static string PriorityDotClass(string priority) => priority switch
    {
        "high"   => "bg-red-500",
        "medium" => "bg-amber-500",
        "low"    => "bg-blue-500",
        _        => ""
    };
}
