@* ============================================================
   Block: kanban-vendor-tracker
   Title: KanbanVendorTracker
   Description: React kanban vendor management tracker for Next.js with sidebar filters for category, budget tier, and rating, four-column vendor pipeline, and animated cards using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-vendor-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="handshake" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Vendor Tracker</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @GetFiltered().Length vendors
                </BadgeCn>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <span>Annual spend</span>
                <span class="font-medium tabular-nums text-foreground">
                    @FormatCost(GetFiltered().Sum(v => v.AnnualCost))
                </span>
            </div>
        </div>

        @* Body *@
        <div class="flex">
            @* Sidebar filters *@
            <div class="w-48 shrink-0 border-r">
                @* Category *@
                <div class="border-b p-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">Category</span>
                    <div class="flex flex-col gap-0.5">
                        @foreach (var cat in _vendorCategories)
                        {
                            var c = cat;
                            <ButtonCn Variant="@(_activeCategories.Contains(c) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 justify-start gap-2 text-xs"
                                      OnClick="@(() => ToggleCategory(c))">
                                <LucideIconCn Name="@GetCategoryIconName(c)" Size="12" Class="size-3 text-muted-foreground" />
                                @c
                            </ButtonCn>
                        }
                    </div>
                </div>

                @* Budget Tier *@
                <div class="border-b p-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">Budget Tier</span>
                    <div class="flex flex-col gap-0.5">
                        @foreach (var tier in _budgetTiers)
                        {
                            var b = tier;
                            <ButtonCn Variant="@(_activeBudgets.Contains(b) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 justify-start text-xs"
                                      OnClick="@(() => ToggleBudget(b))">
                                @b
                            </ButtonCn>
                        }
                    </div>
                </div>

                @* Rating *@
                <div class="p-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">Rating</span>
                    <div class="flex flex-col gap-0.5">
                        @foreach (var rat in _ratings)
                        {
                            var r = rat;
                            <ButtonCn Variant="@(_activeRatings.Contains(r) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 justify-start gap-2 text-xs"
                                      OnClick="@(() => ToggleRating(r))">
                                <span class="flex items-center gap-0.5">
                                    @for (int i = 0; i < r; i++)
                                    {
                                        <LucideIconCn Name="star" Size="10" Class="size-2.5 fill-amber-400 text-amber-400" />
                                    }
                                </span>
                                @($"{r}.0")
                            </ButtonCn>
                        }
                    </div>
                </div>
            </div>

            @* Board columns *@
            <div class="grid flex-1 grid-cols-4 divide-x">
                @foreach (var col in _columns)
                {
                    var column = col;
                    var colVendors = GetFiltered().Where(v => v.Stage == column.Id).ToArray();
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                            <span class="text-muted-foreground">
                                <LucideIconCn Name="@column.IconName" Size="14" Class="size-3.5" />
                            </span>
                            <span class="font-medium text-muted-foreground text-xs">@column.Title</span>
                            <span class="text-muted-foreground/60 text-xs">@colVendors.Length</span>
                        </div>
                        <div class="p-2">
                            <div class="flex flex-col gap-1.5">
                                @foreach (var vendor in colVendors)
                                {
                                    var v = vendor;
                                    <div class="rounded-md border bg-card p-2.5 transition-colors hover:bg-muted/50">
                                        <div class="mb-1.5 flex items-start gap-2">
                                            <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", GetCategoryDot(v.Category))"></span>
                                            <div class="min-w-0 flex-1">
                                                <span class="block font-medium text-sm leading-tight">@v.Name</span>
                                                <span class="block truncate text-muted-foreground text-xs">@v.Product</span>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-2 pl-3.5">
                                            <span class="font-mono text-muted-foreground text-xs tabular-nums">
                                                @FormatCost(v.AnnualCost)/yr
                                            </span>
                                            <span class="text-muted-foreground/40">·</span>
                                            <span class="flex items-center gap-0.5">
                                                @for (int i = 0; i < v.Rating; i++)
                                                {
                                                    <LucideIconCn Name="star" Size="10" Class="size-2.5 fill-amber-400 text-amber-400" />
                                                }
                                            </span>
                                        </div>
                                    </div>
                                }
                                @if (colVendors.Length == 0)
                                {
                                    <div class="py-8 text-center text-muted-foreground/60 text-xs">
                                        No vendors
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @GetFiltered().Count(v => v.Stage == "active") active vendors
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 15 min ago</span>
        </div>
    </div>
</section>

@code {
    private record Vendor(string Id, string Name, string Product, string Stage, string Category, int AnnualCost, int Rating, string ContactName);
    private record ColumnDef(string Id, string Title, string IconName);

    private static readonly Vendor[] _vendors =
    [
        new("1",  "Vercel",           "Hosting Platform",     "active",      "SaaS",     24000,  5, "Sarah L."),
        new("2",  "Datadog",          "Monitoring Suite",     "active",      "SaaS",     36000,  4, "Tom B."),
        new("3",  "Dell Technologies","Server Hardware",      "active",      "Hardware", 85000,  4, "Mike R."),
        new("4",  "Figma",            "Design Tool",          "contracted",  "SaaS",      7200,  5, "Ava K."),
        new("5",  "Deloitte",         "Security Audit",       "contracted",  "Services", 52000,  4, "James H."),
        new("6",  "Cisco",            "Network Equipment",    "contracted",  "Hardware", 41000,  3, "Lisa M."),
        new("7",  "Linear",           "Project Tracker",      "evaluating",  "SaaS",      4800,  5, "Noah D."),
        new("8",  "Accenture",        "Cloud Migration",      "evaluating",  "Services",120000, 4, "Priya S."),
        new("9",  "Lenovo",           "Workstation Laptops",  "evaluating",  "Hardware", 28000,  3, "Dan W."),
        new("10", "Neon",             "Serverless Postgres",  "prospecting", "SaaS",      9600,  4, "Alex T."),
        new("11", "TopTal",           "Staff Augmentation",   "prospecting", "Services",180000, 3, "Emma F."),
    ];

    private static readonly ColumnDef[] _columns =
    [
        new("prospecting", "Prospecting", "search"),
        new("evaluating",  "Evaluating",  "star"),
        new("contracted",  "Contracted",  "handshake"),
        new("active",      "Active",      "check-circle-2"),
    ];

    private static readonly string[] _vendorCategories = ["SaaS", "Hardware", "Services"];
    private static readonly string[] _budgetTiers = ["Under 10K", "10K-50K", "50K+"];
    private static readonly int[] _ratings = [5, 4, 3];

    private HashSet<string> _activeCategories = [];
    private HashSet<string> _activeBudgets = [];
    private HashSet<int> _activeRatings = [];

    private Vendor[] GetFiltered()
    {
        return _vendors.Where(v =>
        {
            if (_activeCategories.Count > 0 && !_activeCategories.Contains(v.Category)) return false;
            if (_activeBudgets.Count > 0 && !_activeBudgets.Any(tier => MatchesBudget(v.AnnualCost, tier))) return false;
            if (_activeRatings.Count > 0 && !_activeRatings.Contains(v.Rating)) return false;
            return true;
        }).ToArray();
    }

    private static bool MatchesBudget(int cost, string tier) => tier switch
    {
        "Under 10K" => cost < 10000,
        "10K-50K"   => cost >= 10000 && cost <= 50000,
        _           => cost > 50000,
    };

    private static string FormatCost(int amount)
    {
        if (amount >= 1000)
        {
            var k = amount / 1000.0;
            return amount % 1000 == 0 ? $"${k:0}K" : $"${k:0.#}K";
        }
        return $"${amount}";
    }

    private static string GetCategoryIconName(string category) => category switch
    {
        "SaaS"     => "cloud",
        "Hardware" => "hard-drive",
        _          => "wrench",
    };

    private static string GetCategoryDot(string category) => category switch
    {
        "SaaS"     => "bg-blue-500",
        "Hardware" => "bg-amber-500",
        _          => "bg-emerald-500",
    };

    private void ToggleCategory(string c)
    {
        if (!_activeCategories.Add(c)) _activeCategories.Remove(c);
    }

    private void ToggleBudget(string b)
    {
        if (!_activeBudgets.Add(b)) _activeBudgets.Remove(b);
    }

    private void ToggleRating(int r)
    {
        if (!_activeRatings.Add(r)) _activeRatings.Remove(r);
    }
}
