            null, 6),
        new("f4", "Webhook retry with exponential backoff", "planned", "high", 118,
            "Sarah Kim", "SK",
            "Webhook deliveries currently fail silently after one attempt. Implement automatic retries with exponential backoff and a dead letter queue for persistently failing endpoints.",
            "Retry schedule: 30s, 2min, 15min, 1h, 6h. Store failed payloads in dead letter table. Add webhook delivery log UI.",
            "#287", 14),
        new("f5", "Custom field types for forms", "planned", "medium", 94,
            "Omar Hassan", "OH",
            "Users need to define custom field types beyond text, number, and date. Requested types include rating scales, file uploads, signature capture, and conditional logic fields.",
            "Start with rating and file upload. Conditional logic is a separate epic. Use a plugin architecture for extensibility.",
            null, 11),
        new("f6", "API rate limit dashboard", "planned", "low", 41,
            "Nina Okafor", "NO",
            "Developers want a dashboard showing their current API usage, remaining quota, and historical consumption patterns to plan around rate limits.",
            "Pull from Redis rate limiter counters. Show 24h rolling window chart and per-endpoint breakdown.",
            null, 5),
        new("f7", "Real-time collaboration cursors", "building", "high", 203,
            "Liam Chen", "LC",
            "Show other users' cursors and selections in real-time when multiple people edit the same document, similar to Google Docs or Figma multiplayer.",
            "Using Yjs CRDT with WebSocket provider. Cursor colors assigned per user session. Presence list in top-right corner.",
            "#312", 27),
        new("f8", "SSO with SAML 2.0", "building", "high", 176,
            "Rachel Ford", "RF",
            "Enterprise customers require SAML 2.0 single sign-on integration with identity providers like Okta, Azure AD, and OneLogin for centralized authentication.",
            "Using passport-saml. SP-initiated flow complete. Working on IdP-initiated flow and JIT user provisioning.",
            "#298", 22),
        new("f9", "Audit log with filtering", "building", "medium", 89,
            "Tom Briggs", "TB",
            "Compliance teams need a searchable audit log of all user actions including login events, data changes, permission modifications, and export activities.",
