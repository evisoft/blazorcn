@* ============================================================
   Block: kanban-feature-requests
   Title: KanbanFeatureRequests
   Description: React kanban feature request board for Next.js with expandable inline cards showing vote counts, requester info, implementation notes, and linked PRs using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-feature-requests.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Feature Requests</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_features.Length requests
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                    @_features.Sum(f => f.Votes) votes
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_features.Count(f => f.Priority == "high")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_features.Count(f => f.Priority == "medium")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_features.Count(f => f.Priority == "low")
                </span>
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var col in _columnConfig)
            {
                var colId = col.Id;
                var columnFeatures = _features.Where(f => f.Status == colId).ToArray();
                <div>
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2.5">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@col.IconName" Size="14" Class="size-3.5" />
                        </span>
                        <span class="font-medium text-muted-foreground text-xs">@col.Title</span>
                        <span class="text-muted-foreground/60 text-xs">@columnFeatures.Length</span>
                    </div>

                    <div>
                        @for (int i = 0; i < columnFeatures.Length; i++)
                        {
                            var feature = columnFeatures[i];
                            var isLast = i == columnFeatures.Length - 1;
                            var isExpanded = _expanded == feature.Id;
                            var featureId = feature.Id;
                            var priorityDotClass = _priorityDot.TryGetValue(feature.Priority, out var dot) ? dot : "";
                            <div class="@(isLast ? "" : "border-b")">
                                <button
                                    type="button"
                                    @onclick="@(() => ToggleExpanded(featureId))"
                                    class="flex w-full items-center gap-2.5 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", priorityDotClass)"></span>
                                    <span class="min-w-0 flex-1 truncate font-medium text-sm">
                                        @feature.Title
                                    </span>
                                    <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                                        @feature.Votes
                                    </span>
                                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="px-4 pb-4">
                                        <p class="mb-3 text-muted-foreground text-sm leading-relaxed">
                                            @feature.Description
                                        </p>

                                        <div class="mb-3 flex items-center gap-3">
                                            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                                @feature.RequesterInitials
                                            </span>
                                            <span class="text-xs">@feature.Requester</span>
                                            <span class="text-muted-foreground text-xs">·</span>
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                                                <span class="tabular-nums">@feature.Votes</span>
                                            </span>
                                            <span class="text-muted-foreground text-xs">·</span>
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                                <span class="tabular-nums">@feature.CommentCount</span>
                                            </span>
                                        </div>

                                        <div class="rounded-md bg-muted/50 p-3">
                                            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                                Implementation notes
                                            </span>
                                            <p class="text-sm leading-relaxed">@feature.Notes</p>
                                        </div>

                                        @if (feature.LinkedPR != null)
                                        {
                                            <div class="mt-2 flex items-center gap-1.5 text-muted-foreground text-xs">
                                                <LucideIconCn Name="git-pull-request" Size="12" Class="size-3" />
                                                <span class="font-mono">@feature.LinkedPR</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_features.Count(f => f.Status == "building") in progress
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 5 min ago</span>
        </div>
    </div>
</section>

@code {
    private string? _expanded = null;

    private record FeatureRequest(
        string Id,
        string Title,
        string Status,
        string Priority,
        int Votes,
        string Requester,
        string RequesterInitials,
        string Description,
        string Notes,
        string? LinkedPR,
        int CommentCount
    );

    private record ColumnConfig(string Id, string Title, string IconName);

    private static readonly Dictionary<string, string> _priorityDot = new()
    {
        ["high"] = "bg-red-500",
        ["medium"] = "bg-amber-500",
        ["low"] = "bg-blue-500",
    };

    private static readonly ColumnConfig[] _columnConfig =
    [
        new("requested", "Requested", "lightbulb"),
        new("planned", "Planned", "message-square"),
        new("building", "Building", "wrench"),
    ];

    private static readonly FeatureRequest[] _features =
    [
        new("f1", "Dark mode for email templates", "requested", "high", 142,
