@* ============================================================
   Block: kanban-sales-overview
   Title: KanbanSalesOverview
   Description: React sales dashboard kanban for Next.js with pipeline metrics, win rate, deal size tracking, and mini kanban columns using shadcn/ui, CountUp, and Tailwind CSS
   Source: original/blocks/kanban/kanban-sales-overview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="dollar-sign" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Sales Overview</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Q1 2026
                </BadgeCn>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">@_deals.Length deals</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">@_pipelineProgress% closed</span>
            </div>
        </div>

        @* Metrics Grid *@
        <div class="grid grid-cols-2 gap-3 border-b p-4 sm:grid-cols-4">
            @foreach (var metric in _metrics)
            {
                var m = metric;
                <div class="rounded-md bg-muted/50 p-3">
                    <div class="mb-1.5 flex items-center gap-1.5">
                        <LucideIconCn Name="@m.Icon" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-muted-foreground text-xs">@m.Label</span>
                    </div>
                    <span class="@Cn.Merge("font-semibold text-2xl tabular-nums", m.Color)">
                        @m.FormattedValue
                    </span>
                </div>
            }
        </div>

        @* Pipeline Progress *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Pipeline progress</span>
                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                    @FormatCurrency(_closedValue) / @FormatCurrency(_totalPipeline)
                </span>
            </div>
            <ProgressCn Value="@_pipelineProgress" Class="h-2" aria-label="Progress" />
        </div>

        @* Mini Kanban Board *@
        <div class="border-b p-4">
            <div class="grid grid-cols-4 gap-3">
                @foreach (var col in _columns)
                {
                    var colStage = col.Stage;
                    var colDeals = System.Array.FindAll(_deals, d => d.Stage == colStage);
                    <div class="rounded-md border">
                        @* Column Header *@
                        <div class="flex items-center gap-1.5 border-b px-2.5 py-2">
                            <span class="@Cn.Merge("size-1.5 rounded-full", col.Dot)"></span>
                            <span class="font-medium text-xs">@col.Label</span>
                            <span class="ml-auto font-mono text-muted-foreground/60 text-[10px] tabular-nums">
                                @colDeals.Length
                            </span>
                        </div>
                        @* Mini Cards *@
                        <div class="flex flex-col gap-0.5 p-1.5">
                            @foreach (var deal in colDeals)
                            {
                                var d = deal;
                                <div class="flex items-center gap-1.5 rounded px-2 py-1.5 transition-colors hover:bg-muted/50">
                                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full opacity-40", col.Dot)"></span>
                                    <span class="min-w-0 flex-1 truncate text-xs">@d.Company</span>
                                    <span class="shrink-0 font-mono text-muted-foreground/60 text-[10px] tabular-nums">
                                        @FormatCurrency(d.Value)
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                4 stages · @_closedCount of @_deals.Length closed
            </span>
            <span class="font-mono text-muted-foreground/60 text-xs tabular-nums">
                @FormatCurrency(_closedValue) revenue
            </span>
        </div>
    </div>
</section>

@code {
    private record Deal(string Id, string Company, int Value, string Stage);
    private record Column(string Stage, string Label, string Dot);
    private record Metric(string Label, string FormattedValue, string Icon, string Color);

    private static readonly Deal[] _deals =
    [
        new("d1",  "Meridian Healthcare",  48000,  "lead"),
        new("d2",  "Vertex Logistics",     32000,  "lead"),
        new("d3",  "Pinnacle Finance",     85000,  "lead"),
        new("d4",  "Catalyst EdTech",      62000,  "qualified"),
        new("d5",  "Stratos Cloud",        120000, "qualified"),
        new("d6",  "Bloom Retail",         28000,  "qualified"),
        new("d7",  "Atlas Manufacturing",  95000,  "proposal"),
        new("d8",  "Neon Digital",         18500,  "proposal"),
        new("d9",  "Horizon Energy",       156000, "closed"),
        new("d10", "Summit Analytics",     42000,  "closed"),
        new("d11", "CoreBridge Systems",   73000,  "closed"),
        new("d12", "Apex Ventures",        54000,  "closed"),
    ];

    private static readonly Column[] _columns =
    [
        new("lead",      "Lead",      "bg-blue-500"),
        new("qualified", "Qualified", "bg-amber-500"),
        new("proposal",  "Proposal",  "bg-purple-500"),
        new("closed",    "Closed",    "bg-emerald-500"),
    ];

    private int _totalPipeline;
    private int _winRate;
    private int _avgDealSize;
    private int _closedCount;
    private int _closedValue;
    private int _pipelineProgress;
    private Metric[] _metrics = [];

    protected override void OnInitialized()
    {
        _totalPipeline = 0;
        foreach (var d in _deals) _totalPipeline += d.Value;

        var closedDeals = System.Array.FindAll(_deals, d => d.Stage == "closed");
        _closedCount = closedDeals.Length;
        _winRate = (int)Math.Round((double)_closedCount / _deals.Length * 100);
        _avgDealSize = (int)Math.Round((double)_totalPipeline / _deals.Length);

        _closedValue = 0;
        foreach (var d in closedDeals) _closedValue += d.Value;

        _pipelineProgress = (int)Math.Round((double)_closedValue / _totalPipeline * 100);

        _metrics =
        [
            new("Total Pipeline", $"${_totalPipeline:N0}",  "dollar-sign", "text-foreground"),
            new("Win Rate",       $"{_winRate}%",            "target",      "text-emerald-600 dark:text-emerald-400"),
            new("Avg Deal Size",  $"${_avgDealSize:N0}",     "percent",     "text-foreground"),
            new("Deals Closed",   $"{_closedCount}",         "trophy",      "text-emerald-600 dark:text-emerald-400"),
        ];
    }

    private static string FormatCurrency(int value)
    {
        if (value >= 1000)
            return $"${value / 1000}k";
        return $"${value:N0}";
    }
}
