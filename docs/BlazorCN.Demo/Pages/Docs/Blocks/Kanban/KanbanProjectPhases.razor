@* ============================================================
   Block: kanban-project-phases
   Title: KanbanProjectPhases
   Description: React kanban project phases tracker for Next.js with vertical accordion columns, due dates, owner initials, completion percentage, and staggered animations using shadcn/ui Accordion and Tailwind CSS
   Source: original/blocks/kanban/kanban-project-phases.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Project Phases</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_deliverables.Length deliverables
                </BadgeCn>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">Avg</span>
                <span class="@Cn.Merge("font-semibold text-sm tabular-nums", CompletionColor(_avgCompletion))">
                    @_avgCompletion%
                </span>
            </div>
        </div>

        @* Accordion columns *@
        <div class="px-4 py-3">
            <AccordionCn>
                @foreach (var col in _columns)
                {
                    var column = col;
                    var colDeliverables = _deliverables.Where(d => d.Phase == column.Id).ToArray();
                    var colAvg = colDeliverables.Length > 0
                        ? (int)Math.Round(colDeliverables.Average(d => (double)d.Completion))
                        : 0;
                    <AccordionItemCn DefaultOpen="@(column.Id == "development")">
                        <AccordionTriggerCn Class="py-3 hover:no-underline">
                            <div class="flex items-center gap-2">
                                <span class="text-muted-foreground">
                                    <LucideIconCn Name="@column.Icon" Size="14" Class="size-3.5" />
                                </span>
                                <span class="font-medium text-sm">@column.Label</span>
                                <span class="text-muted-foreground/60 text-xs">@colDeliverables.Length</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="@Cn.Merge("text-xs tabular-nums", CompletionColor(colAvg))">
                                    @colAvg%
                                </span>
                            </div>
                        </AccordionTriggerCn>
                        <AccordionContentCn Class="pb-2">
                            <div class="overflow-hidden rounded-md border">
                                @for (var idx = 0; idx < colDeliverables.Length; idx++)
                                {
                                    var item = colDeliverables[idx];
                                    var isLast = idx == colDeliverables.Length - 1;
                                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", column.Dot)"></span>
                                        <span class="min-w-0 flex-1 truncate font-medium text-sm">@item.Title</span>
                                        <span class="shrink-0 text-muted-foreground/60 text-xs tabular-nums">@item.DueDate</span>
                                        <span class="@Cn.Merge("shrink-0 text-xs tabular-nums", CompletionColor(item.Completion))">
                                            @item.Completion%
                                        </span>
                                        <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                            @item.Owner
                                        </span>
                                    </div>
                                }
                            </div>
                        </AccordionContentCn>
                    </AccordionItemCn>
                }
            </AccordionCn>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <div class="flex items-center gap-3">
                @foreach (var col in _columns)
                {
                    var column = col;
                    var cnt = _deliverables.Count(d => d.Phase == column.Id);
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", column.Dot)"></span>
                        @cnt
                    </span>
                }
            </div>
            <span class="text-muted-foreground/60 text-xs">Target: May 12</span>
        </div>
    </div>
</section>

@code {
    private record Deliverable(string Id, string Title, string Phase, string DueDate, string Owner, int Completion);
    private record Column(string Id, string Label, string Icon, string Dot);

    private static readonly Deliverable[] _deliverables =
    [
        new("1",  "User research interviews",     "discovery",   "Apr 5",  "EM", 100),
        new("2",  "Competitive analysis report",  "discovery",   "Apr 8",  "LS",  75),
        new("3",  "Wireframe user flows",          "design",      "Apr 12", "KR",  60),
        new("4",  "Design system components",      "design",      "Apr 15", "KR",  40),
        new("5",  "High-fidelity mockups",         "design",      "Apr 18", "LS",  20),
        new("6",  "API endpoint scaffolding",      "development", "Apr 22", "JT",  80),
        new("7",  "Authentication module",         "development", "Apr 25", "JT",  55),
        new("8",  "Dashboard frontend build",      "development", "Apr 28", "EM",  30),
        new("9",  "Unit test coverage",            "testing",     "May 2",  "LS",  45),
        new("10", "Integration testing suite",     "testing",     "May 5",  "JT",  10),
        new("11", "Performance audit",             "testing",     "May 7",  "EM",   0),
        new("12", "Deployment pipeline setup",     "launch",      "May 10", "JT",   0),
        new("13", "Launch checklist review",       "launch",      "May 12", "EM",   0),
    ];

    private static readonly Column[] _columns =
    [
        new("discovery",   "Discovery",   "search",          "bg-violet-500"),
        new("design",      "Design",      "pen-tool",        "bg-pink-500"),
        new("development", "Development", "code",            "bg-blue-500"),
        new("testing",     "Testing",     "flask-conical",   "bg-amber-500"),
        new("launch",      "Launch",      "rocket",          "bg-emerald-500"),
    ];

    private int _avgCompletion =>
        (int)Math.Round(_deliverables.Average(d => (double)d.Completion));

    private static string CompletionColor(int pct)
    {
        if (pct >= 100) return "text-emerald-600 dark:text-emerald-400";
        if (pct >= 50)  return "text-amber-600 dark:text-amber-400";
        return "text-muted-foreground";
    }
}
