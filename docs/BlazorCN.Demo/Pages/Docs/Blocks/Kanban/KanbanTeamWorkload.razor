@* ============================================================
   Block: kanban-team-workload
   Title: KanbanTeamWorkload
   Description: React kanban team workload swimlane board for Next.js with avatar rows, status columns, priority dots, and task counts using shadcn/ui Avatar and Tailwind CSS
   Source: original/blocks/kanban/kanban-team-workload.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Team Workload</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_tasks.Length tasks across @_members.Length members
                    </p>
                </div>
                <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        High
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        Medium
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-blue-500"></span>
                        Low
                    </span>
                </div>
            </div>
        </div>

        @* Column headers *@
        <div class="grid grid-cols-[160px_1fr_1fr_1fr_1fr_48px] border-b bg-muted/30">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Member</span>
            </div>
            @foreach (var s in _statuses)
            {
                <div class="px-3 py-2">
                    <span class="font-medium text-muted-foreground text-xs">@s.Label</span>
                </div>
            }
            <div class="px-2 py-2">
                <span class="font-medium text-muted-foreground text-xs">#</span>
            </div>
        </div>

        @* Swimlane rows *@
        <div>
            @foreach (var member in _members)
            {
                var memberTasks = _tasks.Where(t => t.AssigneeId == member.Id).ToArray();
                var isLast = member.Id == _members[_members.Length - 1].Id;
                <div class="@Cn.Merge("grid grid-cols-[160px_1fr_1fr_1fr_1fr_48px] items-start", !isLast ? "border-b" : "")">
                    @* Avatar cell *@
                    <div class="flex items-center gap-2.5 px-4 py-3">
                        <AvatarCn Class="size-7">
                            <AvatarFallbackCn Class="text-[10px]">@member.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0">
                            <p class="truncate font-medium text-sm">@member.Name</p>
                            <p class="truncate text-muted-foreground text-xs">@member.Role</p>
                        </div>
                    </div>

                    @* Status cells *@
                    @foreach (var s in _statuses)
                    {
                        var cellTasks = memberTasks.Where(t => t.Status == s.Key).ToArray();
                        <div class="min-h-[60px] px-2 py-2.5">
                            @if (cellTasks.Length > 0)
                            {
                                <div class="flex flex-col gap-1.5">
                                    @foreach (var task in cellTasks)
                                    {
                                        <div class="flex items-center gap-2 rounded-md bg-muted/50 px-2.5 py-1.5 transition-colors hover:bg-muted">
                                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", GetPriorityDot(task.Priority))"></span>
                                            <span class="truncate text-xs">@task.Title</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="flex min-h-[36px] items-center justify-center rounded-md border border-dashed border-muted-foreground/20">
                                    <span class="text-muted-foreground/40 text-xs">—</span>
                                </div>
                            }
                        </div>
                    }

                    @* Count cell *@
                    <div class="flex items-center justify-center py-3">
                        <span class="font-medium text-muted-foreground text-xs tabular-nums">
                            @memberTasks.Length
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StatusDef(string Key, string Label);
    private record TeamMember(string Id, string Name, string Initials, string Role);
    private record Task(string Id, string Title, string AssigneeId, string Status, string Priority);

    private static readonly StatusDef[] _statuses =
    [
        new("todo",        "To Do"),
        new("in_progress", "In Progress"),
        new("review",      "Review"),
        new("done",        "Done"),
    ];

    private static readonly TeamMember[] _members =
    [
        new("m1", "Sarah Chen",    "SC", "Frontend Lead"),
        new("m2", "Marcus Rivera", "MR", "Backend Engineer"),
        new("m3", "Aisha Patel",   "AP", "Full Stack"),
        new("m4", "James Okafor", "JO", "DevOps"),
        new("m5", "Lena Novak",    "LN", "QA Engineer"),
    ];

    private static readonly Task[] _tasks =
    [
        new("t1",  "Migrate auth to OAuth2",            "m1", "in_progress", "high"),
        new("t2",  "Fix modal z-index issue",            "m1", "review",      "medium"),
        new("t3",  "Add pagination to users table",      "m1", "done",        "low"),
        new("t4",  "Set up Redis caching layer",         "m2", "in_progress", "high"),
        new("t5",  "Optimize SQL queries for reports",   "m2", "todo",        "medium"),
        new("t6",  "API rate limiter middleware",         "m2", "review",      "high"),
        new("t7",  "Build notification preferences UI",  "m3", "todo",        "medium"),
        new("t8",  "Webhook retry logic",                "m3", "in_progress", "high"),
        new("t9",  "Email template rendering",           "m3", "done",        "low"),
        new("t10", "Stripe invoice sync",                "m3", "review",      "medium"),
        new("t11", "Terraform module for staging",       "m4", "todo",        "high"),
        new("t12", "CI pipeline caching",                "m4", "in_progress", "medium"),
        new("t13", "Secrets rotation automation",        "m4", "todo",        "high"),
        new("t14", "Write E2E tests for checkout",       "m5", "in_progress", "high"),
        new("t15", "Regression suite for settings",      "m5", "todo",        "medium"),
        new("t16", "Performance benchmark report",       "m5", "done",        "low"),
        new("t17", "Accessibility audit fixes",          "m1", "todo",        "medium"),
