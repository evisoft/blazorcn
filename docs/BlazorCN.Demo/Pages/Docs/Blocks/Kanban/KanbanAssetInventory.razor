@* ============================================================
   Block: kanban-asset-inventory
   Title: KanbanAssetInventory
   Description: React dual-view IT asset inventory kanban for Next.js with Switch toggle between board and table views using shadcn/ui Table, Switch, and Tailwind CSS.
   Source: original/blocks/kanban/kanban-asset-inventory.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="laptop" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Asset Inventory</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    @_assets.Length assets
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-3">
                    @foreach (var col in _columnsConfig)
                    {
                        var colStatus = col.Status;
                        <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span class="@Cn.Merge("size-1.5 rounded-full", GetStatusDot(colStatus))"></span>
                            @_assets.Count(a => a.Status == colStatus)
                        </span>
                    }
                </div>
                <div class="mx-1 h-4 w-px bg-border"></div>
                <div class="flex items-center gap-2">
                    <span class="text-xs text-muted-foreground">
                        @(_isTableView ? "Table" : "Board")
                    </span>
                    <SwitchCn Size="SwitchSize.Sm" Checked="@_isTableView" CheckedChanged="@((bool v) => _isTableView = v)" aria-label="Toggle table view" />
                </div>
            </div>
        </div>

        @* Content *@
        @if (_isTableView)
        {
            @* Table View *@
            <TableCn>
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-10">
                            <span class="sr-only">Status</span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Asset Name
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Type
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Serial No
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Assigned To
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Location
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var asset in _assets)
                    {
                        <TableRowCn>
                            <TableCellCn>
                                <span class="@Cn.Merge("inline-block size-2 rounded-full", GetStatusDot(asset.Status))"></span>
                            </TableCellCn>
                            <TableCellCn Class="font-medium">@asset.Name</TableCellCn>
                            <TableCellCn>
                                <span class="flex items-center gap-1.5 text-muted-foreground">
                                    <LucideIconCn Name="@GetTypeIconName(asset.Type)" Size="12" Class="size-3 text-muted-foreground" />
                                    @asset.Type
                                </span>
                            </TableCellCn>
                            <TableCellCn Class="font-mono text-xs text-muted-foreground">@asset.Serial</TableCellCn>
                            <TableCellCn>
                                @if (!string.IsNullOrEmpty(asset.AssignedTo))
                                {
                                    <span>@asset.AssignedTo</span>
                                }
                                else
                                {
                                    <span class="text-muted-foreground/60">--</span>
                                }
                            </TableCellCn>
                            <TableCellCn Class="text-muted-foreground text-xs">@asset.Location</TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        }
        else
        {
            @* Board View *@
            <div class="grid grid-cols-4 divide-x">
                @foreach (var column in _columnsConfig)
                {
                    var colStatus = column.Status;
                    var colLabel = column.Label;
                    var colAssets = _assets.Where(a => a.Status == colStatus).ToArray();
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                            <span class="@Cn.Merge("size-1.5 rounded-full", GetStatusDot(colStatus))"></span>
                            <span class="text-xs font-medium text-muted-foreground">@colLabel</span>
                            <span class="text-xs text-muted-foreground/60">@colAssets.Length</span>
                        </div>
                        <div class="p-2">
                            <div class="flex flex-col gap-1.5">
                                @foreach (var asset in colAssets)
                                {
                                    <div class="rounded-md border bg-card p-2.5 transition-colors hover:bg-muted/50">
                                        <div class="mb-1.5 flex items-start gap-2">
                                            <LucideIconCn Name="@GetStatusIconName(asset.Status)" Size="14" Class="@GetStatusIconClass(asset.Status)" />
                                            <span class="min-w-0 flex-1 text-sm font-medium leading-tight">@asset.Name</span>
                                        </div>
                                        <div class="flex items-center gap-2 pl-5.5">
                                            <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                                <LucideIconCn Name="@GetTypeIconName(asset.Type)" Size="12" Class="size-3 text-muted-foreground" />
                                                @asset.Type
                                            </span>
                                            <span class="text-muted-foreground/40">@("·")</span>
                                            <span class="font-mono text-xs text-muted-foreground">@asset.Serial.Substring(asset.Serial.Length - 4)</span>
                                            @if (!string.IsNullOrEmpty(asset.AssignedTo))
                                            {
                                                <span class="text-muted-foreground/40">@("·")</span>
                                                <span class="truncate text-xs text-muted-foreground">@asset.AssignedTo</span>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (colAssets.Length == 0)
                                {
                                    <div class="py-8 text-center text-xs text-muted-foreground/60">
                                        No assets
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_assets.Count(a => a.Status == "assigned") assets currently assigned
            </span>
            <span class="text-xs text-muted-foreground/60">Updated 8 min ago</span>
        </div>
    </div>
</section>

@code {
    private bool _isTableView = false;

    private record Asset(string Id, string Name, string Status, string Type, string Serial, string AssignedTo, string Location);
    private record ColumnConfig(string Status, string Label);

    private static readonly Asset[] _assets =
    [
        new("a1", "MacBook Pro 16\" M3", "available", "Laptop", "SN-MP16-4821", "", "IT Storage A"),
        new("a2", "Dell XPS 15", "available", "Laptop", "SN-DX15-7734", "", "IT Storage A"),
        new("a3", "iPhone 15 Pro", "available", "Phone", "SN-IP15-9012", "", "IT Storage B"),
        new("a4", "MacBook Air M2", "assigned", "Laptop", "SN-MA13-2156", "Sarah Chen", "Floor 3"),
        new("a5", "Dell UltraSharp 27\"", "assigned", "Monitor", "SN-DU27-6543", "Marcus Rivera", "Floor 2"),
        new("a6", "LG 34\" Curved", "assigned", "Monitor", "SN-LG34-3387", "Emily Watson", "Floor 4"),
        new("a7", "ThinkPad X1 Carbon", "assigned", "Laptop", "SN-TX1C-1198", "James Park", "Floor 2"),
        new("a8", "Samsung Galaxy S24", "assigned", "Phone", "SN-SG24-4455", "Nina Patel", "Floor 3"),
        new("a9", "Dell PowerEdge R750", "maintenance", "Server", "SN-PE75-8801", "", "Server Room"),
        new("a10", "HP EliteDesk 800", "maintenance", "Desktop", "SN-HE80-2267", "", "IT Workshop"),
        new("a11", "MacBook Pro 14\" M1", "retired", "Laptop", "SN-MP14-1023", "", "Decom Storage"),
        new("a12", "Dell OptiPlex 7080", "retired", "Desktop", "SN-DO70-5544", "", "Decom Storage"),
        new("a13", "iPhone 12 Pro", "retired", "Phone", "SN-IP12-3378", "", "Decom Storage"),
    ];

    private static readonly ColumnConfig[] _columnsConfig =
    [
        new("available", "Available"),
        new("assigned", "Assigned"),
        new("maintenance", "Maintenance"),
        new("retired", "Retired"),
    ];

    private static string GetStatusDot(string status) => status switch
    {
        "available" => "bg-emerald-500",
        "assigned" => "bg-blue-500",
        "maintenance" => "bg-amber-500",
        "retired" => "bg-zinc-400",
        _ => "",
    };

    private static string GetStatusIconName(string status) => status switch
    {
        "available" => "check-circle-2",
        "assigned" => "user",
        "maintenance" => "wrench",
        "retired" => "x-circle",
        _ => "circle",
    };

    private static string GetStatusIconClass(string status) => status switch
    {
        "available" => "size-3.5 text-emerald-500",
        "assigned" => "size-3.5 text-blue-500",
        "maintenance" => "size-3.5 text-amber-500",
        "retired" => "size-3.5 text-zinc-400",
        _ => "size-3.5",
    };

    private static string GetTypeIconName(string type) => type switch
    {
        "Laptop" => "laptop",
        "Monitor" => "monitor",
        "Phone" => "smartphone",
        "Server" => "server",
        "Desktop" => "hard-drive",
        _ => "box",
    };
}
