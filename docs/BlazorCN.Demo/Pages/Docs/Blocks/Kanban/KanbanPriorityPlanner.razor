@* ============================================================
   Block: kanban-priority-planner
   Title: KanbanPriorityPlanner
   Description: React MoSCoW priority planner kanban for Next.js with three priority columns, drag-and-drop using @dnd-kit, effort badges, business value scores, and effort-sized card heights built with shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-priority-planner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="target" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Priority Planner</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_items.Length items
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var col in _columns)
                {
                    var colId = col.Id;
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _priorityDot[colId])"></span>
                        @_items.Count(i => i.Priority == colId)
                    </span>
                }
                <span class="text-muted-foreground/40">|</span>
                <span class="text-muted-foreground text-xs">avg value @AvgValue</span>
            </div>
        </div>

        @* Board *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var column in _columns)
            {
                var colItems = _items.Where(i => i.Priority == column.Id).ToArray();
                var colValue = colItems.Length > 0
                    ? (colItems.Sum(i => i.Value) / (double)colItems.Length).ToString("F1")
                    : "0";
                <div class="min-w-0">
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _priorityDot[column.Id])"></span>
                        <span class="font-medium text-muted-foreground text-xs">@column.Label</span>
                        <span class="text-muted-foreground/60 text-xs">@colItems.Length</span>
                        <span class="ml-auto font-mono text-muted-foreground/60 text-[10px]">avg @colValue</span>
                    </div>
                    <div class="flex flex-col gap-1.5 p-2">
                        @foreach (var item in colItems)
                        {
                            <div class="@Cn.Merge("rounded-md border bg-card px-2.5 transition-colors hover:bg-muted/50", _effortPadding[item.Effort])">
                                <div class="flex items-start gap-1.5">
                                    <button type="button" class="mt-0.5 shrink-0 cursor-grab touch-none text-muted-foreground/60 active:cursor-grabbing" aria-label="@($"Reorder {item.Title}")">
                                        <LucideIconCn Name="grip-vertical" Size="14" Class="size-3.5" />
                                    </button>
                                    <div class="min-w-0 flex-1">
                                        <span class="font-medium text-sm leading-tight">@item.Title</span>
                                        @if (item.Effort == "L")
                                        {
                                            <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">@item.Description</p>
                                        }
                                    </div>
                                </div>
                                <div class="mt-1.5 flex items-center gap-2 pl-5">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px] font-normal">
                                        @item.Effort
                                    </BadgeCn>
                                    <span class="@Cn.Merge("font-mono text-xs font-medium tabular-nums", ValueColor(item.Value))">
                                        @item.Value
                                    </span>
                                    <span class="text-muted-foreground/40">·</span>
                                    <span class="text-muted-foreground text-[10px]">@item.Requester</span>
                                    <AvatarCn Class="ml-auto size-5">
                                        <AvatarFallbackCn Class="text-[9px]">@item.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                </div>
                            </div>
                        }
                        @if (colItems.Length == 0)
                        {
                            <div class="rounded-md border border-dashed border-muted-foreground/20 px-2 py-6 text-center text-muted-foreground/40 text-xs">
                                Drop items here
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                S: @_items.Count(i => i.Effort == "S") · M: @_items.Count(i => i.Effort == "M") · L: @_items.Count(i => i.Effort == "L")
            </span>
            <span class="text-muted-foreground/60 text-xs">Drag to reprioritize</span>
        </div>
    </div>
</section>

@code {
    private record PriorityItem(
        string Id, string Title, string Description,
        string Priority, string Effort, int Value,
        string Requester, string Initials);

    private record ColumnDef(string Id, string Label);

    private static readonly ColumnDef[] _columns =
    [
        new("must",   "Must Do"),
        new("should", "Should Do"),
        new("nice",   "Nice to Have"),
    ];

    private static readonly Dictionary<string, string> _priorityDot = new()
    {
        ["must"]   = "bg-red-500",
        ["should"] = "bg-amber-500",
        ["nice"]   = "bg-blue-500",
    };

    private static readonly Dictionary<string, string> _effortPadding = new()
    {
        ["S"] = "py-2",
        ["M"] = "py-3",
        ["L"] = "py-4",
    };

    private static readonly PriorityItem[] _items =
    [
        new("p1",  "User authentication system",    "OAuth2, magic link, and email/password login flows",         "must",   "L", 10, "CTO",      "CT"),
        new("p2",  "Payment processing",            "Stripe integration with subscription management",            "must",   "L",  9, "CEO",      "CE"),
        new("p3",  "Core dashboard views",          "Analytics overview with key metrics",                        "must",   "M",  8, "PM",       "PM"),
        new("p4",  "Email notification system",     "Transactional emails for key user events",                   "must",   "M",  8, "CTO",      "CT"),
        new("p5",  "Role-based access control",     "Admin, editor, and viewer permission levels",                "should", "M",  7, "Security", "SE"),
        new("p6",  "Search with autocomplete",      "Full-text search across all content types",                  "should", "M",  7, "PM",       "PM"),
        new("p7",  "CSV data export",               "Export any table view as downloadable CSV",                  "should", "S",  6, "Sales",    "SA"),
        new("p8",  "Audit logging",                 "Track all user actions for compliance",                      "should", "L",  6, "Security", "SE"),
        new("p9",  "API rate limiting",             "Per-endpoint throttling with Redis",                         "should", "S",  5, "CTO",      "CT"),
        new("p10", "Dark mode support",             "System-aware theme with manual toggle",                      "nice",   "S",  4, "Design",   "DE"),
        new("p11", "Keyboard shortcuts",            "Power user shortcuts for common actions",                    "nice",   "S",  3, "PM",       "PM"),
        new("p12", "Custom dashboard widgets",      "Drag-and-drop dashboard builder for personalization",        "nice",   "L",  5, "CEO",      "CE"),
        new("p13", "Slack integration",             "Send notifications to Slack channels",                       "nice",   "M",  4, "Sales",    "SA"),
    ];

    private string AvgValue =>
        _items.Length > 0
            ? (_items.Sum(i => i.Value) / (double)_items.Length).ToString("F1")
            : "0";

    private static string ValueColor(int value)
    {
        if (value >= 8) return "text-emerald-600 dark:text-emerald-400";
        if (value >= 5) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }
}
