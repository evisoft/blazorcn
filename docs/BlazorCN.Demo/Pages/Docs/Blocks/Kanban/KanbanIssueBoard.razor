@* ============================================================
   Block: kanban-issue-board
   Title: KanbanIssueBoard
   Description: React split-panel issue tracker kanban for Next.js with severity indicators, reproduction steps, fix status, and component tagging using shadcn/ui and Tailwind CSS.
   Source: original/blocks/kanban/kanban-issue-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="bug" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Issue Board</h2>
            <span class="text-xs text-muted-foreground">@_issues.Length issues</span>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_issues.Count(i => i.Severity == "critical")
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_issues.Count(i => i.Severity == "high")
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_issues.Count(i => i.Severity == "medium")
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-zinc-400"></span>
                    @_issues.Count(i => i.Severity == "low")
                </span>
            </div>
        </div>

        @* Board + Detail *@
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr_1fr_minmax(280px,1.2fr)]">
            @* Columns *@
            @foreach (var col in _columns)
            {
                var colStatus = col.Status;
                var colIssues = _issues.Where(i => i.Status == colStatus).ToArray();
                var colIdx = System.Array.IndexOf(_columns, col);
                <div class="@Cn.Merge("min-h-[500px] bg-card", colIdx < 2 ? "border-r" : "")">
                    <div class="flex items-center gap-2 border-b px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _statusDot.TryGetValue(col.Status, out var sd) ? sd : "")"></span>
                        <span class="text-xs font-medium">@col.Label</span>
                        <span class="ml-auto text-xs text-muted-foreground">@colIssues.Length</span>
                    </div>
                    <div class="divide-y">
                        @foreach (var issue in colIssues)
                        {
                            var issueId = issue.Id;
                            <button
                                type="button"
                                @onclick="@(() => SelectIssue(issueId))"
                                class="@Cn.Merge("flex w-full items-center gap-2.5 px-3 py-2.5 text-left transition-colors hover:bg-muted/50", _selectedId == issueId ? "bg-muted/50 ring-2 ring-foreground ring-inset" : "")">
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _severityDot.TryGetValue(issue.Severity, out var sevDot) ? sevDot : "")"></span>
                                <span class="min-w-0 flex-1 truncate text-sm font-medium">@issue.Title</span>
                                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                    @issue.Initials
                                </span>
                            </button>
                        }
                    </div>
                </div>
            }

            @* Detail Panel *@
            <div class="min-h-[500px] border-l bg-muted/20">
                @if (_selected != null)
                {
                    var sel = _selected;
                    <div>
                        <div class="border-b px-4 py-3">
                            <h3 class="text-sm font-medium">@sel.Title</h3>
                            <div class="mt-1.5 flex items-center gap-2">
                                <span class="@Cn.Merge("size-1.5 rounded-full", _statusDot.TryGetValue(sel.Status, out var selSd) ? selSd : "")"></span>
                                <span class="text-xs text-muted-foreground capitalize">@sel.Status</span>
                            </div>
                        </div>

                        <div class="border-b px-4 py-3">
                            <div class="space-y-2.5">
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">Severity</span>
                                    <span class="ml-auto flex items-center gap-1.5 font-medium capitalize">
                                        <span class="@Cn.Merge("size-1.5 rounded-full", _severityDot.TryGetValue(sel.Severity, out var selSevDot) ? selSevDot : "")"></span>
                                        @sel.Severity
                                    </span>
                                </div>
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">Reporter</span>
                                    <span class="ml-auto font-medium">@sel.Reporter</span>
                                </div>
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideIconCn Name="component" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">Component</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto text-xs font-normal">
                                        @sel.Component
                                    </BadgeCn>
                                </div>
                            </div>
                        </div>

                        <div class="border-b px-4 py-3">
                            <span class="text-xs font-medium text-muted-foreground">Description</span>
                            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">@sel.Description</p>
                        </div>

                        <div class="border-b px-4 py-3">
                            <span class="text-xs font-medium text-muted-foreground">Steps to reproduce</span>
                            <ol class="mt-1.5 space-y-1.5">
                                @for (int stepIdx = 0; stepIdx < sel.StepsToReproduce.Length; stepIdx++)
                                {
                                    var step = sel.StepsToReproduce[stepIdx];
                                    var num = stepIdx + 1;
                                    <li class="flex gap-2 text-sm leading-relaxed text-muted-foreground">
                                        <span class="shrink-0 font-mono text-xs text-muted-foreground/60">@(num).</span>
                                        @step
                                    </li>
                                }
                            </ol>
                        </div>

                        @if (!string.IsNullOrEmpty(sel.FixNote))
                        {
                            <div class="border-b px-4 py-3">
                                <span class="text-xs font-medium text-muted-foreground">
                                    @(sel.Status == "fixed" ? "Resolution" : "Investigation notes")
                                </span>
                                <div class="mt-1.5 rounded-md bg-muted/50 px-3 py-2">
                                    <p class="text-sm leading-relaxed">@sel.FixNote</p>
                                </div>
                            </div>
                        }

                        <div class="flex gap-2 px-4 py-3">
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Edit issue</ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">Add comment</ButtonCn>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex h-[500px] items-center justify-center px-4">
                        <p class="text-sm text-muted-foreground">Select an issue to view details</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
