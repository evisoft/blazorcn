@* ============================================================
   Block: kanban-ticket-queue
   Title: KanbanTicketQueue
   Description: React kanban support ticket queue for Next.js with mono-font ticket IDs, severity indicators, compact list rows, and staggered entrance animations using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-ticket-queue.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Ticket Queue</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_tickets.Length tickets
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_tickets.Count(t => t.Severity == "critical")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_tickets.Count(t => t.Severity == "high")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_tickets.Count(t => t.Severity == "normal")
                </span>
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var col in _columnConfig)
            {
                var column = col;
                var colTickets = _tickets.Where(t => t.Status == column.Id).ToArray();
                <div>
                    @* Column header *@
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2.5">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@column.IconName" Size="14" Class="size-3.5" />
                        </span>
                        <span class="font-medium text-muted-foreground text-xs">@column.Title</span>
                        <span class="text-muted-foreground/60 text-xs">@colTickets.Length</span>
                    </div>

                    @* Ticket rows *@
                    <div>
                        @for (int idx = 0; idx < colTickets.Length; idx++)
                        {
                            var ticket = colTickets[idx];
                            var isLast = idx == colTickets.Length - 1;
                            <div class="@Cn.Merge("flex items-center gap-2.5 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _severityDot.TryGetValue(ticket.Severity, out var dot) ? dot : "")"></span>
                                <span class="shrink-0 font-mono text-muted-foreground text-xs">@ticket.TicketId</span>
                                <span class="min-w-0 flex-1 truncate font-medium text-sm">@ticket.Title</span>
                                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                    @ticket.Assignee
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_tickets.Count(t => t.Status == "resolved") resolved this week
            </span>
            <span class="text-muted-foreground/60 text-xs">Last triaged 5 min ago</span>
        </div>
    </div>
</section>

@code {
    private record Ticket(
        string Id,
        string TicketId,
        string Title,
        string Status,
        string Severity,
        string Assignee
    );

    private record ColumnConfig(string Id, string Title, string IconName);

    private static readonly Dictionary<string, string> _severityDot = new()
    {
        ["critical"] = "bg-red-500",
        ["high"] = "bg-amber-500",
        ["normal"] = "bg-blue-500",
    };

    private static readonly ColumnConfig[] _columnConfig =
    [
        new("open", "Open", "circle-alert"),
        new("in-progress", "In Progress", "clock"),
        new("resolved", "Resolved", "check-circle-2"),
    ];

    private static readonly Ticket[] _tickets =
    [
        new("1", "TK-001", "Login page returns 500 on Safari", "open", "critical", "MR"),
        new("2", "TK-007", "CSV export missing last column", "open", "high", "LC"),
        new("3", "TK-012", "Password reset email not received", "open", "critical", "AW"),
        new("4", "TK-003", "Webhook payload dropping headers", "in-progress", "critical", "TN"),
        new("5", "TK-009", "Dashboard chart tooltip cut off", "in-progress", "normal", "SK"),
        new("6", "TK-015", "Search returns stale results after edit", "in-progress", "high", "MR"),
        new("7", "TK-002", "Fixed timezone offset in reports", "resolved", "high", "LC"),
        new("8", "TK-005", "Resolved duplicate notification bug", "resolved", "normal", "AW"),
        new("9", "TK-010", "Patched XSS in comment field", "resolved", "critical", "TN"),
    ];
}
