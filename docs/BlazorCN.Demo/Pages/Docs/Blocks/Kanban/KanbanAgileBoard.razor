@* ============================================================
   Block: kanban-agile-board
   Title: KanbanAgileBoard
   Description: React agile kanban board for Next.js with five pipeline columns, drag-and-drop card reordering using @dnd-kit, story points, type badges, and assignee avatars built with shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-agile-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Sprint 18 Board</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_stories.Length stories
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    Feature
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    Bug
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-zinc-400"></span>
                    Task
                </span>
                <span class="text-muted-foreground/40">|</span>
                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                    @_totalPoints pts
                </span>
            </div>
        </div>

        @* Board *@
        <div class="grid grid-cols-5 divide-x">
            @foreach (var col in _columns)
            {
                var colStories = _stories.Where(s => s.Status == col.Id).ToArray();
                var colPoints = colStories.Sum(s => s.Points);
                <div class="min-w-0">
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="font-medium text-muted-foreground text-xs">@col.Label</span>
                        <span class="text-muted-foreground/60 text-xs">@colStories.Length</span>
                        <span class="ml-auto font-mono text-muted-foreground/60 text-[10px]">@(colPoints)pt</span>
                    </div>
                    <div class="flex flex-col gap-1.5 p-2">
                        @foreach (var story in colStories)
                        {
                            <div class="@Cn.Merge("rounded-md border border-t-2 bg-card p-2.5 transition-colors hover:bg-muted/50", TypeBorderClass(story.Type))">
                                <div class="mb-1.5 flex items-start gap-1.5">
                                    <button type="button" class="mt-0.5 shrink-0 cursor-grab touch-none text-muted-foreground/60 active:cursor-grabbing" aria-label="@($"Reorder {story.Title}")">
                                        <LucideIconCn Name="grip-vertical" Size="14" Class="size-3.5" />
                                    </button>
                                    <span class="min-w-0 flex-1 font-medium text-sm leading-tight">@story.Title</span>
                                </div>
                                <div class="flex items-center gap-2 pl-5">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px] font-normal">
                                        @(story.Points)pt
                                    </BadgeCn>
                                    <span class="text-muted-foreground text-xs">@story.Type</span>
                                    <AvatarCn Class="ml-auto size-5">
                                        <AvatarFallbackCn Class="text-[9px]">@story.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                </div>
                            </div>
                        }
                        @if (colStories.Length == 0)
                        {
                            <div class="rounded-md border border-dashed border-muted-foreground/20 px-2 py-6 text-center text-muted-foreground/40 text-xs">
                                Drop here
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @(_stories.Count(s => s.Status == "done")) of @_stories.Length complete
            </span>
            <span class="text-muted-foreground/60 text-xs">Drag cards to update status</span>
        </div>
    </div>
</section>

@code {
    private record Story(string Id, string Title, string Status, int Points, string Type, string Assignee, string Initials);
    private record Column(string Id, string Label);

    private static readonly Story[] _stories =
    [
        new("s1",  "OAuth2 PKCE authentication flow",        "backlog",      8, "Feature", "Sarah Chen",   "SC"),
        new("s2",  "Fix timezone offset in date picker",     "backlog",      3, "Bug",     "Marcus Webb",  "MW"),
        new("s3",  "Migrate CI config to GitHub Actions",    "backlog",      2, "Task",    "Priya Patel",  "PP"),
        new("s4",  "Search autocomplete with debounce",      "ready",        5, "Feature", "James Liu",    "JL"),
        new("s5",  "API rate limit headers missing",         "ready",        3, "Bug",     "Sarah Chen",   "SC"),
        new("s6",  "Real-time collaboration cursors",        "in-dev",       8, "Feature", "Marcus Webb",  "MW"),
        new("s7",  "Database connection pool leak",          "in-dev",       5, "Bug",     "James Liu",    "JL"),
        new("s8",  "Notification preference center",         "in-dev",       5, "Feature", "Priya Patel",  "PP"),
        new("s9",  "Webhook retry with exponential backoff", "code-review",  5, "Feature", "Sarah Chen",   "SC"),
        new("s10", "Audit npm dependency vulnerabilities",   "code-review",  2, "Task",    "Marcus Webb",  "MW"),
        new("s11", "Stripe subscription webhook handler",    "done",         5, "Feature", "James Liu",    "JL"),
        new("s12", "Dark mode toggle persistence",           "done",         3, "Feature", "Priya Patel",  "PP"),
    ];

    private static readonly Column[] _columns =
    [
        new("backlog",     "Backlog"),
        new("ready",       "Ready"),
        new("in-dev",      "In Dev"),
        new("code-review", "Code Review"),
        new("done",        "Done"),
    ];

    private int _totalPoints => _stories.Sum(s => s.Points);

    private static string TypeBorderClass(string type) => type switch
    {
        "Feature" => "border-t-blue-500",
        "Bug"     => "border-t-red-500",
        "Task"    => "border-t-zinc-400",
        _         => ""
    };
}
