@* ============================================================
   Block: kanban-code-reviews
   Title: KanbanCodeReviews
   Description: React kanban code review board for Next.js with expandable inline cards showing PR details, file change counts, reviewer comments, and monospace code snippet previews using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-code-reviews.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Code Reviews</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_pullRequests.Length PRs
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="git-pull-request" Size="12" Class="size-3" />
                    @_pullRequests.Count(p => p.Status == "open") open
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="git-merge" Size="12" Class="size-3" />
                    @_pullRequests.Count(p => p.Status == "merged") merged
                </span>
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var col in _columns)
            {
                var colId = col.Id;
                var columnPRs = _pullRequests.Where(p => p.Status == colId).ToArray();
                <div>
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2.5">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@col.IconName" Size="14" Class="size-3.5" />
                        </span>
                        <span class="font-medium text-muted-foreground text-xs">@col.Title</span>
                        <span class="text-muted-foreground/60 text-xs">@columnPRs.Length</span>
                    </div>

                    <div>
                        @for (int i = 0; i < columnPRs.Length; i++)
                        {
                            var pr = columnPRs[i];
                            var isLast = i == columnPRs.Length - 1;
                            var isExpanded = _expanded == pr.Id;
                            var prId = pr.Id;
                            <div class="@(isLast ? "" : "border-b")">
                                <button
                                    type="button"
                                    @onclick="@(() => ToggleExpanded(prId))"
                                    class="flex w-full items-center gap-2.5 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                                    <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                        @pr.AuthorInitials
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <span class="block truncate font-medium text-sm">@pr.Title</span>
                                        <span class="font-mono text-muted-foreground text-xs">@pr.PrNumber</span>
                                    </div>
                                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="px-4 pb-4">
                                        <p class="mb-3 text-muted-foreground text-sm leading-relaxed">@pr.Description</p>

                                        @* Author + Reviewer + Stats *@
                                        <div class="mb-3 flex flex-wrap items-center gap-3">
                                            <div class="flex items-center gap-1.5">
                                                <span class="font-medium text-muted-foreground text-xs">Author</span>
                                                <span class="text-xs">@pr.Author</span>
                                            </div>
                                            <span class="text-muted-foreground text-xs">·</span>
                                            <div class="flex items-center gap-1.5">
                                                <span class="font-medium text-muted-foreground text-xs">Reviewer</span>
                                                <span class="text-xs">@pr.Reviewer</span>
                                            </div>
                                            <span class="text-muted-foreground text-xs">·</span>
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="file" Size="12" Class="size-3" />
                                                @pr.FilesChanged files
                                            </span>
                                            <span class="font-mono text-emerald-600 text-xs dark:text-emerald-400">+@pr.Additions</span>
                                            <span class="font-mono text-red-600 text-xs dark:text-red-400">-@pr.Deletions</span>
                                        </div>

                                        @* Reviewer comment *@
                                        @if (!string.IsNullOrEmpty(pr.ReviewerComment))
                                        {
                                            <div class="mb-3 rounded-md bg-muted/50 p-3">
                                                <div class="mb-1.5 flex items-center gap-1.5">
                                                    <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium text-muted-foreground">
                                                        @pr.ReviewerInitials
                                                    </span>
                                                    <span class="font-medium text-muted-foreground text-xs">Review comment</span>
                                                </div>
                                                <p class="text-sm leading-relaxed">@pr.ReviewerComment</p>
                                            </div>
                                        }

                                        @* Code snippet *@
                                        <div>
                                            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">Code preview</span>
                                            <div class="overflow-x-auto rounded-md bg-zinc-950 p-3">
                                                <pre class="font-mono text-sm leading-relaxed text-zinc-100"><code>@pr.CodeSnippet</code></pre>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_pullRequests.Count(p => p.Status == "reviewing") awaiting review
            </span>
            <span class="text-muted-foreground/60 text-xs">Synced 3 min ago</span>
        </div>
    </div>
</section>

@code {
    private string? _expanded = null;

    private record PullRequest(
        string Id,
        string PrNumber,
        string Title,
        string Status,
        string Author,
        string AuthorInitials,
        string Reviewer,
        string ReviewerInitials,
        int FilesChanged,
        int Additions,
        int Deletions,
        string Description,
        string ReviewerComment,
        string CodeSnippet
    );

    private record ColumnConfig(string Id, string Title, string IconName);

