@* ============================================================
   Block: kanban-startup-pipeline
   Title: KanbanStartupPipeline
   Description: React startup deal flow kanban for Next.js with ultra-compact cards, HoverCard detail popups showing industry, funding ask, traction metrics, and team size using shadcn/ui HoverCard and Tailwind CSS.
   Source: original/blocks/kanban/kanban-startup-pipeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Startup Pipeline</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_startups.Length companies
                </BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs">Hover to preview</span>
        </div>

        @* Columns *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var col in _columns)
            {
                var colStage = col.Stage;
                var colStartups = System.Array.FindAll(_startups, s => s.Stage == colStage);
                <div>
                    @* Column Header *@
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", col.Dot)"></span>
                        <span class="font-medium text-xs">@col.Label</span>
                        <span class="ml-auto font-mono text-[10px] text-muted-foreground/60 tabular-nums">
                            @colStartups.Length
                        </span>
                    </div>

                    @* Cards *@
                    <div>
                        @for (int i = 0; i < colStartups.Length; i++)
                        {
                            var startup = colStartups[i];
                            var idx = i;
                            var colLen = colStartups.Length;
                            <HoverCardCn OpenDelay="200" CloseDelay="100">
                                <HoverCardTriggerCn Class="block w-full">
                                    <div class="@Cn.Merge("flex w-full cursor-default items-center gap-2 px-3 py-2 text-left transition-colors hover:bg-muted/50", idx < colLen - 1 ? "border-b" : "")">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full opacity-40", col.Dot)"></span>
                                        <span class="min-w-0 flex-1 truncate text-xs">@startup.Name</span>
                                        <span class="shrink-0 text-[10px] text-muted-foreground/60">
                                            @startup.Lead
                                        </span>
                                    </div>
                                </HoverCardTriggerCn>
                                <HoverCardContentCn Side="FloatingSide.Right" Align="FloatingAlign.Start" Class="w-72 p-0">
                                    <div class="border-b px-3 py-2.5">
                                        <div class="flex items-center gap-2">
                                            <span class="font-medium text-sm">@startup.Name</span>
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-[10px]">
                                                @startup.FundingStage
                                            </BadgeCn>
                                        </div>
                                        <span class="text-muted-foreground text-xs">@startup.Industry</span>
                                    </div>
                                    <div class="space-y-2 px-3 py-2.5">
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Funding ask</span>
                                            <span class="font-medium tabular-nums">@startup.FundingAsk</span>
                                        </div>
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Team size</span>
                                            <span class="font-medium tabular-nums">@startup.TeamSize</span>
                                        </div>
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Last contact</span>
                                            <span class="font-medium">@startup.LastContact</span>
                                        </div>
                                    </div>
                                    <div class="border-t bg-muted/30 px-3 py-2">
                                        <span class="text-muted-foreground text-xs">Traction</span>
                                        <p class="mt-0.5 text-xs leading-relaxed">@startup.Traction</p>
                                    </div>
                                </HoverCardContentCn>
                            </HoverCardCn>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @System.Array.FindAll(_startups, s => s.Stage == "term-sheet").Length at term sheet
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 5 min ago</span>
        </div>
    </div>
</section>

@code {
