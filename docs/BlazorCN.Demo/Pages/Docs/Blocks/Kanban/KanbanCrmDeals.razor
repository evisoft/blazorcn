@* ============================================================
   Block: kanban-crm-deals
   Title: KanbanCrmDeals
   Description: React split-panel CRM pipeline kanban for Next.js with deal columns, contact details, deal values, and probability indicators using shadcn/ui and Tailwind CSS.
   Source: original/blocks/kanban/kanban-crm-deals.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Deal Pipeline</h2>
            <span class="text-xs text-muted-foreground">@_deals.Length deals</span>
            <span class="text-xs text-muted-foreground">·</span>
            <span class="text-xs text-muted-foreground">
                @FormatCurrency(_deals.Sum(d => d.Value)) total
            </span>
        </div>

        @* Board + Detail *@
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr_1fr_minmax(280px,1.2fr)]">
            @* Columns *@
            @foreach (var col in _columns)
            {
                var colStage = col.Stage;
                var colDeals = _deals.Where(d => d.Stage == colStage).ToArray();
                var colValue = colDeals.Sum(d => d.Value);
                var colIdx = System.Array.IndexOf(_columns, col);
                <div class="@Cn.Merge("min-h-[500px] bg-card", colIdx < 2 ? "border-r" : "")">
                    <div class="flex items-center gap-2 border-b px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _stageDot.TryGetValue(colStage, out var dot) ? dot : "")"></span>
                        <span class="text-xs font-medium">@col.Label</span>
                        <span class="ml-auto text-xs text-muted-foreground tabular-nums">
                            @FormatCurrency(colValue)
                        </span>
                    </div>
                    <div class="divide-y">
                        @foreach (var deal in colDeals)
                        {
                            var item = deal;
                            var isSelected = _selectedId == item.Id;
                            <button
                                type="button"
                                @onclick="@(() => _selectedId = item.Id)"
                                class="@Cn.Merge("flex w-full items-center gap-2.5 px-3 py-2.5 text-left transition-colors hover:bg-muted/50", isSelected ? "bg-muted/50 ring-2 ring-foreground ring-inset" : "")">
                                <span class="min-w-0 flex-1">
                                    <span class="block truncate text-sm font-medium">@item.Company</span>
                                    <span class="block text-xs text-muted-foreground tabular-nums">
                                        @FormatCurrency(item.Value)
                                    </span>
                                </span>
                                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                    @item.Initials
                                </span>
                            </button>
                        }
                    </div>
                </div>
            }

            @* Detail Panel *@
            <div class="min-h-[500px] border-l bg-muted/20">
                @{
                    var selected = _deals.FirstOrDefault(d => d.Id == _selectedId);
                }
                @if (selected != null)
                {
                    <div class="border-b px-4 py-3">
                        <h3 class="text-sm font-medium">@selected.Company</h3>
                        <div class="mt-1.5 flex items-center gap-2">
                            <span class="@Cn.Merge("size-1.5 rounded-full", _stageDot.TryGetValue(selected.Stage, out var selDot) ? selDot : "")"></span>
                            <span class="text-xs text-muted-foreground capitalize">
                                @selected.Stage
                            </span>
                        </div>
                    </div>

                    <div class="border-b px-4 py-3">
                        <div class="space-y-2.5">
                            <div class="flex items-center gap-2 text-xs">
                                <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="text-muted-foreground">Contact</span>
                                <span class="ml-auto font-medium">@selected.Contact</span>
                            </div>
                            <div class="flex items-center gap-2 text-xs">
                                <LucideIconCn Name="mail" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="text-muted-foreground">Email</span>
                                <span class="ml-auto font-medium">@selected.Email</span>
                            </div>
                            <div class="flex items-center gap-2 text-xs">
                                <LucideIconCn Name="phone" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="text-muted-foreground">Phone</span>
                                <span class="ml-auto font-medium">@selected.Phone</span>
                            </div>
                        </div>
                    </div>

                    <div class="border-b px-4 py-3">
                        <div class="space-y-2.5">
                            <div class="flex items-center gap-2 text-xs">
                                <LucideIconCn Name="dollar-sign" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="text-muted-foreground">Deal value</span>
                                <span class="ml-auto font-semibold tabular-nums">
                                    @FormatCurrency(selected.Value)
                                </span>
                            </div>
                            <div class="flex items-center gap-2 text-xs">
                                <LucideIconCn Name="building" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="text-muted-foreground">Probability</span>
                                <span class="ml-auto font-medium tabular-nums">
                                    @selected.Probability%
                                </span>
                            </div>
                        </div>
                        <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                            @{
                                var probColor = selected.Probability == 100
                                    ? "bg-emerald-500"
                                    : selected.Probability >= 50
                                        ? "bg-amber-500"
                                        : "bg-blue-500";
                            }
                            <div class="@Cn.Merge("h-full rounded-full transition-all", probColor)"
                                 style="@($"width:{selected.Probability}%")">
                            </div>
                        </div>
                    </div>

                    <div class="border-b px-4 py-3">
                        <span class="text-xs font-medium text-muted-foreground">Notes</span>
                        <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                            @selected.Notes
                        </p>
                    </div>

                    <div class="border-b px-4 py-3">
                        <span class="text-xs font-medium text-muted-foreground">Next action</span>
                        <div class="mt-1.5 rounded-md bg-muted/50 px-3 py-2">
                            <p class="text-sm">@selected.NextAction</p>
                        </div>
                    </div>

                    <div class="flex gap-2 px-4 py-3">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                            Edit deal
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">
                            Log activity
                        </ButtonCn>
                    </div>
                }
                else
                {
                    <div class="flex h-[500px] items-center justify-center px-4">
                        <p class="text-sm text-muted-foreground">Select a deal to view details</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
