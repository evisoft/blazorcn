@* ============================================================
   Block: kanban-sprint-capacity
   Title: KanbanSprintCapacity
   Description: React sprint capacity kanban board for Next.js with progress bars, WIP limits, and story point tracking using shadcn/ui Progress and Tailwind CSS
   Source: original/blocks/kanban/kanban-sprint-capacity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Board header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="zap" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Sprint 12 Capacity</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_totalItems/@_totalCapacity slots
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="activity" Size="12" Class="size-3" />
                    @_totalPoints pts
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="flame" Size="12" Class="size-3" />
                    @_velocity pts/sprint
                </span>
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-4">
            @foreach (var col in _columns)
            {
                var colStories = _stories.Where(s => s.Status == col.Id).ToArray();
                var count = colStories.Length;
                var ratio = (double)count / col.Capacity;
                var percent = Math.Min(ratio * 100.0, 100.0);
                var colPoints = colStories.Sum(s => s.Points);
                var isLast = col.Id == _columns[_columns.Length - 1].Id;
                <div class="@Cn.Merge(!isLast ? "border-r" : "")">
                    @* Column header with progress *@
                    <div class="border-b px-3 py-3">
                        <div class="mb-2 flex items-center justify-between">
                            <span class="font-medium text-sm">@col.Label</span>
                            <span class="@Cn.Merge("font-mono text-xs tabular-nums", GetProgressTextColor(ratio))">
                                @count/@col.Capacity
                            </span>
                        </div>
                        <div class="cn-progress relative flex h-2 w-full items-center overflow-x-hidden rounded-full bg-secondary" role="progressbar" aria-valuenow="@((int)Math.Round(percent))" aria-valuemin="0" aria-valuemax="100">
                            <div class="@Cn.Merge("cn-progress-indicator h-full transition-all duration-700", GetProgressColor(ratio))" style="@($"width:{Math.Round(percent, 1)}%")"></div>
                        </div>
                        <div class="mt-1.5 flex items-center justify-between">
                            <span class="text-muted-foreground text-xs">@colPoints pts</span>
                            @if (ratio > 1)
                            {
                                <span class="font-medium text-red-600 text-xs dark:text-red-400">
                                    Over limit!
                                </span>
                            }
                        </div>
                    </div>

                    @* Cards *@
                    <div class="flex flex-col gap-1 p-2">
                        @foreach (var story in colStories)
                        {
                            <div class="flex items-center gap-2 rounded-md px-2.5 py-2 transition-colors hover:bg-muted/50">
                                <div class="min-w-0 flex-1">
                                    <span class="line-clamp-1 text-xs">@story.Title</span>
                                </div>
                                <span class="font-mono text-muted-foreground/60 text-[10px]">
                                    @(story.Points)p
                                </span>
                                <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium">
                                    @story.Assignee
                                </span>
                            </div>
                        }
                        @if (colStories.Length == 0)
                        {
                            <div class="rounded-md border border-dashed border-muted-foreground/20 px-2 py-3 text-center text-muted-foreground/40 text-xs">
                                Empty
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                4 columns · @_stories.Count(s => s.Status == "done") of @_totalItems complete
            </span>
            <span class="font-mono text-muted-foreground/60 text-xs">
                @(Math.Round((double)_stories.Count(s => s.Status == "done") / _totalItems * 100))% done
            </span>
        </div>
    </div>
</section>

@code {
    private record Story(string Id, string Title, string Assignee, string Status, int Points);
    private record Column(string Id, string Label, int Capacity);

    private static readonly Column[] _columns =
    [
        new("backlog",   "Backlog",   8),
        new("in-sprint", "In Sprint", 5),
        new("active",    "Active",    5),
        new("done",      "Done",      8),
    ];

    private static readonly Story[] _stories =
    [
        new("s1",  "User auth flow redesign",    "SC", "active",    5),
        new("s2",  "API pagination endpoint",    "MR", "active",    3),
        new("s3",  "Dashboard chart filters",    "PP", "active",    3),
        new("s4",  "Email template builder",     "JO", "in-sprint", 5),
        new("s5",  "Webhook retry mechanism",    "SC", "in-sprint", 3),
        new("s6",  "Role-based permissions",     "MR", "in-sprint", 5),
        new("s7",  "Search indexing service",    "PP", "backlog",   8),
        new("s8",  "File upload progress UI",    "JO", "backlog",   3),
        new("s9",  "Rate limiting middleware",   "SC", "backlog",   2),
        new("s10", "CSV export feature",         "MR", "done",      3),
        new("s11", "Onboarding wizard steps",    "PP", "done",      5),
        new("s12", "Password reset flow",        "JO", "done",      2),
        new("s13", "Notification preferences",   "SC", "done",      3),
        new("s14", "Dark mode toggle",           "MR", "done",      1),
    ];

    private const int _velocity = 34;

    private int _totalItems => _stories.Length;
    private int _totalCapacity => _columns.Sum(c => c.Capacity);
    private int _totalPoints => _stories.Sum(s => s.Points);

    private static string GetProgressColor(double ratio)
    {
        if (ratio > 1) return "bg-red-500";
        if (ratio >= 0.7) return "bg-amber-500";
        return "bg-emerald-500";
    }

    private static string GetProgressTextColor(double ratio)
    {
        if (ratio > 1) return "text-red-600 dark:text-red-400";
        if (ratio >= 0.7) return "text-amber-600 dark:text-amber-400";
        return "text-emerald-600 dark:text-emerald-400";
    }
}
