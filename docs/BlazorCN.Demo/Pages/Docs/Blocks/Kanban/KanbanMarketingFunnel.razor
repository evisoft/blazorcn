@* ============================================================
   Block: kanban-marketing-funnel
   Title: KanbanMarketingFunnel
   Description: React marketing funnel dashboard kanban for Next.js with lead metrics, conversion rates, cost per lead tracking, and mini campaign columns using shadcn/ui, CountUp, and Tailwind CSS
   Source: original/blocks/kanban/kanban-marketing-funnel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="megaphone" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Marketing Funnel</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    March 2026
                </BadgeCn>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">@_campaigns.Length campaigns</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">
                    $@_totalSpend.ToString("N0") spend
                </span>
            </div>
        </div>

        @* Metrics Grid *@
        <div class="grid grid-cols-2 gap-3 border-b p-4 sm:grid-cols-4">
            @* Total Leads *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">Total Leads</span>
                </div>
                <span class="font-semibold text-2xl tabular-nums text-foreground">
                    @_totalLeads.ToString("N0")
                </span>
            </div>
            @* Conversion Rate *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="target" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">Conversion Rate</span>
                </div>
                <span class="font-semibold text-2xl tabular-nums text-emerald-600 dark:text-emerald-400">
                    @_conversionRate%
                </span>
            </div>
            @* Cost per Lead *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="dollar-sign" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">Cost per Lead</span>
                </div>
                <span class="font-semibold text-2xl tabular-nums text-foreground">
                    $@_costPerLead
                </span>
            </div>
            @* MQLs *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="megaphone" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">MQLs</span>
                </div>
                <span class="font-semibold text-2xl tabular-nums text-amber-600 dark:text-amber-400">
                    @_mqls.ToString("N0")
                </span>
            </div>
        </div>

        @* Funnel Progress *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Funnel throughput</span>
                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                    @_decisionLeads / @_totalLeads leads converted
                </span>
            </div>
            <div class="cn-progress relative flex h-2 w-full items-center overflow-x-hidden"
                 role="progressbar"
                 aria-valuenow="@_funnelProgress"
                 aria-valuemin="0"
                 aria-valuemax="100">
                <div class="cn-progress-indicator h-full bg-emerald-500 transition-all duration-700"
                     style="@($"width:{_funnelProgress}%")">
                </div>
            </div>
        </div>

        @* Mini Kanban Board *@
        <div class="border-b p-4">
            <div class="grid grid-cols-3 gap-3">
                @foreach (var col in _columns)
                {
                    var colCampaigns = _campaigns.Where(c => c.Stage == col.Id).ToArray();
                    var colLeads = colCampaigns.Sum(c => c.Leads);
                    <div class="rounded-md border">
                        @* Column Header *@
                        <div class="flex items-center gap-1.5 border-b px-2.5 py-2">
                            <span class="@Cn.Merge("size-1.5 rounded-full", col.Dot)"></span>
                            <span class="font-medium text-xs">@col.Label</span>
                            <span class="ml-auto font-mono text-muted-foreground/60 text-[10px] tabular-nums">
                                @colLeads.ToString("N0")
                            </span>
                        </div>
                        @* Mini Cards *@
                        <div class="flex flex-col gap-0.5 p-1.5">
                            @foreach (var campaign in colCampaigns)
                            {
                                <div class="flex items-center gap-1.5 rounded px-2 py-1.5 transition-colors hover:bg-muted/50">
                                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full opacity-40", col.Dot)"></span>
                                    <span class="min-w-0 flex-1 truncate text-xs">@campaign.Name</span>
                                    <span class="shrink-0 font-mono text-muted-foreground/60 text-[10px] tabular-nums">
                                        @campaign.Leads
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                3 stages · @_campaigns.Length active campaigns
            </span>
            <span class="font-mono text-muted-foreground/60 text-xs tabular-nums">
                $@_costPerLead avg CPL
            </span>
        </div>
    </div>
</section>

@code {
    private record Campaign(string Id, string Name, string Stage, int Leads, int Spend, string Channel);
    private record KanbanColumn(string Id, string Label, string Dot);

    private static readonly Campaign[] _campaigns =
    [
        new("c1",  "Blog SEO Sprint",       "awareness",     340, 2400, "Organic"),
        new("c2",  "LinkedIn Ads Q1",       "awareness",     280, 8500, "Paid Social"),
        new("c3",  "YouTube Pre-roll",      "awareness",     190, 6200, "Video"),
        new("c4",  "Webinar Series",        "consideration", 145, 3100, "Events"),
        new("c5",  "Email Nurture Flow",    "consideration", 210,  800, "Email"),
        new("c6",  "Case Study Retarget",   "consideration",  95, 4200, "Display"),
        new("c7",  "Comparison Pages",      "consideration", 120, 1500, "Content"),
        new("c8",  "Free Trial CTA",        "decision",       88, 3600, "Website"),
        new("c9",  "Demo Request Push",     "decision",       64, 5100, "Paid Search"),
        new("c10", "Partner Referrals",     "decision",       52, 1200, "Referral"),
    ];

    private static readonly KanbanColumn[] _columns =
    [
        new("awareness",     "Awareness",     "bg-blue-500"),
        new("consideration", "Consideration", "bg-amber-500"),
        new("decision",      "Decision",      "bg-emerald-500"),
    ];

    private int _totalLeads      => _campaigns.Sum(c => c.Leads);
    private int _totalSpend      => _campaigns.Sum(c => c.Spend);
    private int _decisionLeads   => _campaigns.Where(c => c.Stage == "decision").Sum(c => c.Leads);
    private int _conversionRate  => (int)Math.Round((double)_decisionLeads / _totalLeads * 100);
    private int _costPerLead     => (int)Math.Round((double)_totalSpend / _totalLeads);
    private int _mqls            => _campaigns.Where(c => c.Stage == "consideration" || c.Stage == "decision").Sum(c => c.Leads);
    private int _funnelProgress  => (int)Math.Round((double)_decisionLeads / _totalLeads * 100);
}
