@* ============================================================
   Block: kanban-product-backlog
   Title: KanbanProductBacklog
   Description: React kanban product backlog for Next.js with sidebar filters for priority, type, and team, four-column board layout, and animated card entrance using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-product-backlog.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Product Backlog</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_filtered.Length items
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var p in _priorities)
                {
                    var priority = p;
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", PriorityDotClass(priority))"></span>
                        @_filtered.Count(i => i.Priority == priority)
                    </span>
                }
            </div>
        </div>

        @* Body *@
        <div class="flex">
            @* Sidebar filters *@
            <div class="w-48 shrink-0 border-r">
                @* Priority *@
                <div class="border-b p-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">Priority</span>
                    <div class="flex flex-col gap-0.5">
                        @foreach (var p in _priorities)
                        {
                            var priority = p;
                            <ButtonCn Variant="@(_activePriorities.Contains(priority) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 justify-start gap-2 text-xs"
                                      OnClick="@(() => TogglePriority(priority))">
                                <span class="@Cn.Merge("size-1.5 rounded-full", PriorityDotClass(priority))"></span>
                                @priority
                            </ButtonCn>
                        }
                    </div>
                </div>

                @* Type *@
                <div class="border-b p-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">Type</span>
                    <div class="flex flex-col gap-0.5">
                        @foreach (var t in _types)
                        {
                            var typeName = t;
                            <ButtonCn Variant="@(_activeTypes.Contains(typeName) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 justify-start gap-2 text-xs"
                                      OnClick="@(() => ToggleType(typeName))">
                                <LucideIconCn Name="@TypeIconName(typeName)" Size="12" Class="size-3 text-muted-foreground" />
                                @typeName
                            </ButtonCn>
                        }
                    </div>
                </div>

                @* Team *@
                <div class="p-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">Team</span>
                    <div class="flex flex-col gap-0.5">
                        @foreach (var t in _teams)
                        {
                            var teamName = t;
                            <ButtonCn Variant="@(_activeTeams.Contains(teamName) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 justify-start text-xs"
                                      OnClick="@(() => ToggleTeam(teamName))">
                                @teamName
                            </ButtonCn>
                        }
                    </div>
                </div>
            </div>

            @* Board columns *@
            <div class="grid flex-1 grid-cols-4 divide-x">
                @foreach (var col in _columns)
                {
                    var column = col;
                    var colItems = _filtered.Where(i => i.Status == column.Id).ToArray();
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                            <span class="text-muted-foreground">
                                <LucideIconCn Name="@column.Icon" Size="14" Class="size-3.5" />
                            </span>
                            <span class="font-medium text-muted-foreground text-xs">@column.Title</span>
                            <span class="text-muted-foreground/60 text-xs">@colItems.Length</span>
                        </div>
                        <div class="p-2">
                            <div class="flex flex-col gap-1.5">
                                @foreach (var item in colItems)
                                {
                                    <div class="rounded-md border bg-card p-2.5 transition-colors hover:bg-muted/50">
                                        <div class="mb-1.5 flex items-start gap-2">
                                            <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", PriorityDotClass(item.Priority))"></span>
                                            <span class="min-w-0 flex-1 font-medium text-sm leading-tight">@item.Title</span>
                                        </div>
                                        <div class="flex items-center gap-2 pl-3.5">
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="@TypeIconName(item.Type)" Size="12" Class="size-3 text-muted-foreground" />
                                                @item.Type
                                            </span>
                                            <span class="text-muted-foreground/40">·</span>
                                            <span class="text-muted-foreground text-xs">@item.Team</span>
                                        </div>
                                    </div>
                                }
                                @if (colItems.Length == 0)
                                {
                                    <div class="py-8 text-center text-muted-foreground/60 text-xs">
                                        No items
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_filtered.Count(i => i.Status == "shipped") of @_filtered.Length shipped
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 5 min ago</span>
        </div>
    </div>
</section>

@code {
    private record Item(string Id, string Title, string Status, string Priority, string Type, string Team);
    private record Column(string Id, string Title, string Icon);

    private static readonly Item[] _items =
    [
        new("1",  "OAuth2 social login flow",          "icebox",   "P1", "Feature", "Backend"),
        new("2",  "Fix date picker timezone bug",       "icebox",   "P0", "Bug",     "Frontend"),
        new("3",  "Migrate CI to GitHub Actions",       "icebox",   "P3", "Chore",   "Backend"),
        new("4",  "Push notification opt-in screen",    "icebox",   "P2", "Feature", "Mobile"),
        new("5",  "Implement search autocomplete",      "next-up",  "P1", "Feature", "Frontend"),
        new("6",  "Database connection pool leak",      "next-up",  "P0", "Bug",     "Backend"),
        new("7",  "Upgrade React to v19",               "next-up",  "P2", "Chore",   "Frontend"),
        new("8",  "Offline mode data sync",             "next-up",  "P1", "Feature", "Mobile"),
        new("9",  "Real-time collaboration cursors",    "in-dev",   "P1", "Feature", "Frontend"),
        new("10", "Fix API rate limit headers",         "in-dev",   "P0", "Bug",     "Backend"),
        new("11", "Biometric login for iOS",            "in-dev",   "P2", "Feature", "Mobile"),
        new("12", "Audit npm dependencies",             "in-dev",   "P3", "Chore",   "Frontend"),
        new("13", "Stripe subscription webhooks",       "shipped",  "P0", "Feature", "Backend"),
        new("14", "Dark mode toggle",                   "shipped",  "P2", "Feature", "Frontend"),
        new("15", "Fix Android crash on low memory",    "shipped",  "P0", "Bug",     "Mobile"),
        new("16", "Add Sentry error tracking",          "shipped",  "P1", "Chore",   "Backend"),
    ];

    private static readonly Column[] _columns =
    [
        new("icebox",   "Icebox",  "box"),
        new("next-up",  "Next Up", "circle-dot"),
        new("in-dev",   "In Dev",  "settings"),
        new("shipped",  "Shipped", "rocket"),
    ];

    private static readonly string[] _priorities = ["P0", "P1", "P2", "P3"];
    private static readonly string[] _types      = ["Feature", "Bug", "Chore"];
    private static readonly string[] _teams      = ["Frontend", "Backend", "Mobile"];

    private readonly HashSet<string> _activePriorities = [];
    private readonly HashSet<string> _activeTypes      = [];
    private readonly HashSet<string> _activeTeams      = [];

    private Item[] _filtered => _items.Where(i =>
        (_activePriorities.Count == 0 || _activePriorities.Contains(i.Priority)) &&
        (_activeTypes.Count      == 0 || _activeTypes.Contains(i.Type))          &&
        (_activeTeams.Count      == 0 || _activeTeams.Contains(i.Team))
    ).ToArray();

    private void TogglePriority(string p)
    {
        if (!_activePriorities.Remove(p)) _activePriorities.Add(p);
    }

    private void ToggleType(string t)
    {
        if (!_activeTypes.Remove(t)) _activeTypes.Add(t);
    }

    private void ToggleTeam(string t)
    {
        if (!_activeTeams.Remove(t)) _activeTeams.Add(t);
    }

    private static string PriorityDotClass(string priority) => priority switch
    {
        "P0" => "bg-red-500",
        "P1" => "bg-amber-500",
        "P2" => "bg-blue-500",
        "P3" => "bg-zinc-400",
        _    => ""
    };

    private static string TypeIconName(string type) => type switch
    {
        "Feature" => "layers",
        "Bug"     => "bug",
        "Chore"   => "wrench",
        _         => "layers"
    };
}
