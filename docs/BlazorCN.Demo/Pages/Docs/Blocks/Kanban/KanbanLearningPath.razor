@* ============================================================
   Block: kanban-learning-path
   Title: KanbanLearningPath
   Description: React kanban learning progress tracker for Next.js with vertical accordion columns, source labels, hours spent, difficulty badges, and staggered animations using shadcn/ui Accordion and Tailwind CSS
   Source: original/blocks/kanban/kanban-learning-path.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Learning Path</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_items.Length skills
                </BadgeCn>
            </div>
            <div class="flex items-center gap-2">
                <span class="font-semibold text-sm tabular-nums">@_totalHours h</span>
                <span class="text-muted-foreground text-xs">logged</span>
            </div>
        </div>

        @* Accordion columns *@
        <div class="px-4 py-3">
            <AccordionCn>
                @foreach (var col in _columns)
                {
                    var colItems = _items.Where(i => i.Status == col.Id).ToArray();
                    var colHours = colItems.Sum(i => i.Hours);
                    var isMastered = col.Id == "mastered";
                    var isDefaultOpen = col.Id == "studying";
                    <AccordionItemCn DefaultOpen="@isDefaultOpen">
                        <AccordionTriggerCn Class="py-3 hover:no-underline">
                            <div class="flex items-center gap-2">
                                <span class="text-muted-foreground">
                                    <LucideIconCn Name="@col.IconName" Size="14" Class="size-3.5" />
                                </span>
                                <span class="font-medium text-sm">@col.Label</span>
                                <span class="text-muted-foreground/60 text-xs">@colItems.Length</span>
                                @if (colHours > 0)
                                {
                                    <span class="text-muted-foreground text-xs">·</span>
                                    <span class="text-muted-foreground text-xs tabular-nums">@(colHours)h</span>
                                }
                            </div>
                        </AccordionTriggerCn>
                        <AccordionContentCn Class="pb-2">
                            <div class="overflow-hidden rounded-md border">
                                @for (var idx = 0; idx < colItems.Length; idx++)
                                {
                                    var item = colItems[idx];
                                    var isLast = idx == colItems.Length - 1;
                                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", col.Dot)"></span>
                                        <div class="min-w-0 flex-1">
                                            <span class="@Cn.Merge("block truncate text-sm", isMastered ? "text-muted-foreground line-through" : "font-medium")">
                                                @item.Title
                                            </span>
                                            <span class="text-muted-foreground/60 text-xs">
                                                @item.Source
                                            </span>
                                        </div>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("shrink-0 font-normal text-[10px]", DifficultyColor(item.Difficulty))">
                                            @item.Difficulty
                                        </BadgeCn>
                                        @if (item.Hours > 0)
                                        {
                                            <span class="shrink-0 text-muted-foreground/60 text-xs tabular-nums">@(item.Hours)h</span>
                                        }
                                    </div>
                                }
                            </div>
                        </AccordionContentCn>
                    </AccordionItemCn>
                }
            </AccordionCn>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @(_masteredCount) of @(_items.Length) mastered
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 1 day ago</span>
        </div>
    </div>
</section>

@code {
    private record LearningItem(string Id, string Title, string Status, string Source, int Hours, string Difficulty);
    private record ColumnItem(string Id, string Label, string IconName, string Dot);

    private static readonly LearningItem[] _items =
    [
        new("1",  "Rust Ownership & Borrowing",      "queued",     "YouTube",  0,  "Advanced"),
        new("2",  "GraphQL Schema Design",            "queued",     "Udemy",    0,  "Intermediate"),
        new("3",  "Kubernetes Pod Networking",        "queued",     "Docs",     0,  "Advanced"),
        new("4",  "React Server Components",          "studying",   "Docs",     6,  "Intermediate"),
        new("5",  "PostgreSQL Query Optimization",    "studying",   "Book",     12, "Advanced"),
        new("6",  "Figma Auto Layout",                "studying",   "YouTube",  3,  "Beginner"),
        new("7",  "TypeScript Generics",              "practicing", "Udemy",    18, "Intermediate"),
        new("8",  "Docker Multi-Stage Builds",        "practicing", "Docs",     8,  "Intermediate"),
        new("9",  "Tailwind CSS Grid Layouts",        "practicing", "YouTube",  5,  "Beginner"),
        new("10", "Git Interactive Rebase",           "mastered",   "Book",     4,  "Beginner"),
        new("11", "JavaScript Promises & Async",      "mastered",   "Coursera", 22, "Intermediate"),
        new("12", "CSS Flexbox Fundamentals",         "mastered",   "YouTube",  10, "Beginner"),
    ];

    private static readonly ColumnItem[] _columns =
    [
        new("queued",     "Queued",     "list-todo",  "bg-zinc-400"),
        new("studying",   "Studying",   "book-open",  "bg-blue-500"),
        new("practicing", "Practicing", "hammer",     "bg-amber-500"),
        new("mastered",   "Mastered",   "star",       "bg-emerald-500"),
    ];

    private int _totalHours => _items.Sum(i => i.Hours);
    private int _masteredCount => _items.Count(i => i.Status == "mastered");

    private static string DifficultyColor(string difficulty) => difficulty switch
    {
        "Beginner"     => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        "Intermediate" => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        "Advanced"     => "bg-red-500/10 text-red-700 dark:text-red-400",
        _              => "",
    };
}
