@* ============================================================
   Block: kanban-personal-tasks
   Title: KanbanPersonalTasks
   Description: React kanban personal task manager for Next.js with tab navigation, priority indicators, due labels, staggered card animations, and compact list layout using shadcn/ui Tabs and Tailwind CSS
   Source: original/blocks/kanban/kanban-personal-tasks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Personal Tasks</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_tasks.Length tasks
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_tasks.Count(t => t.Priority == "high")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_tasks.Count(t => t.Priority == "medium")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_tasks.Count(t => t.Priority == "low")
                </span>
            </div>
        </div>

        @* Tabs *@
        <div class="px-4 py-3">
            <TabsCn DefaultValue="today">
                <TabsListCn Class="w-full">
                    @foreach (var col in _columns)
                    {
                        var colId = col.Id;
                        <TabsTriggerCn Value="@colId" Class="h-8 gap-1.5 text-xs">
                            @col.Label
                            <span class="text-muted-foreground/60 text-[10px]">@GetCount(colId)</span>
                        </TabsTriggerCn>
                    }
                </TabsListCn>

                @foreach (var col in _columns)
                {
                    var colId = col.Id;
                    var columnTasks = _tasks.Where(t => t.Column == colId).ToArray();
                    var isDone = colId == "done";
                    <TabsContentCn Value="@colId" Class="mt-0">
                        <div class="mt-3 overflow-hidden rounded-md border">
                            @for (var i = 0; i < columnTasks.Length; i++)
                            {
                                var task = columnTasks[i];
                                var isLast = i == columnTasks.Length - 1;
                                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                                    @if (isDone)
                                    {
                                        <LucideIconCn Name="check-circle-2" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="circle" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground/60" />
                                    }
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _priorityDot[task.Priority])"></span>
                                            <span class="@Cn.Merge("truncate text-sm", isDone ? "text-muted-foreground line-through" : "font-medium")">
                                                @task.Title
                                            </span>
                                        </div>
                                        <p class="mt-0.5 truncate text-muted-foreground text-xs">
                                            @task.Note
                                        </p>
                                    </div>
                                    <span class="shrink-0 text-muted-foreground/60 text-xs">
                                        @task.Due
                                    </span>
                                </div>
                            }
                        </div>
                    </TabsContentCn>
                }
            </TabsCn>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_tasks.Count(t => t.Column == "done") of @_tasks.Length completed
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 5 min ago</span>
        </div>
    </div>
</section>

@code {
    private record TaskItem(string Id, string Title, string Note, string Column, string Priority, string Due);
    private record ColumnItem(string Id, string Label);

    private static readonly Dictionary<string, string> _priorityDot = new()
    {
        ["high"]   = "bg-red-500",
        ["medium"] = "bg-amber-500",
        ["low"]    = "bg-blue-500",
    };

    private static readonly ColumnItem[] _columns =
    [
        new("today",   "Today"),
        new("week",    "This Week"),
        new("someday", "Someday"),
        new("done",    "Done"),
    ];

    private static readonly TaskItem[] _tasks =
    [
        new("1",  "Buy groceries",          "Milk, eggs, bread, spinach",          "today",   "high",   "Today"),
        new("2",  "Go to the gym",          "Leg day — squats and lunges",         "today",   "medium", "Today"),
        new("3",  "Call dentist office",    "Reschedule cleaning to next month",   "today",   "high",   "Today"),
        new("4",  "Read chapter 5",         "Atomic Habits — identity-based habits","today",  "low",    "Today"),
        new("5",  "Pay electricity bill",   "Due amount is $142.30",               "week",    "high",   "Thursday"),
        new("6",  "Schedule oil change",    "Honda dealership on Oak St",          "week",    "medium", "Friday"),
        new("7",  "Write thank-you card",   "For Sarah's housewarming gift",       "week",    "low",    "Saturday"),
        new("8",  "Organize desk drawer",   "Sort cables, toss old receipts",      "week",    "low",    "Sunday"),
        new("9",  "Learn basic Spanish",    "Duolingo — 15 min per day",           "someday", "low",    "No rush"),
        new("10", "Repaint bedroom wall",   "Pick a neutral warm tone",            "someday", "medium", "No rush"),
        new("11", "Finished laundry",       "Washed, dried, and folded",           "done",    "medium", "Completed"),
        new("12", "Submitted rent payment", "April rent — auto-pay confirmed",     "done",    "high",   "Completed"),
        new("13", "Vacuumed living room",   "Under couch and behind TV",           "done",    "low",    "Completed"),
        new("14", "Returned library books", "Three books, no late fees",           "done",    "low",    "Completed"),
    ];

    private int GetCount(string column) => _tasks.Count(t => t.Column == column);
}
