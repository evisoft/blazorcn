@* ============================================================
   Block: kanban-brand-assets
   Title: KanbanBrandAssets
   Description: React kanban board for brand asset management with color-coded left-border cards indicating asset type, 3-column pipeline layout using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-brand-assets.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Brand Assets</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_assets.Length requests
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span>@_assets.Count(a => a.Status == "delivered") delivered</span>
                <span class="text-muted-foreground/60">·</span>
                <span>@_assets.Count(a => a.Status == "in-production") in production</span>
            </div>
        </div>

        @* Color Legend *@
        <div class="flex items-center gap-4 border-b bg-muted/30 px-4 py-2">
            @foreach (var cat in _categories)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", cat.DotColor)"></span>
                    @cat.Label
                </span>
            }
        </div>

        @* Columns *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var column in _columns)
            {
                var columnAssets = _assets.Where(a => a.Status == column.Id).ToArray();
                <div>
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2.5">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@column.IconName" Size="14" Class="size-3.5" />
                        </span>
                        <span class="font-medium text-muted-foreground text-xs">@column.Title</span>
                        <span class="text-muted-foreground/60 text-xs">@columnAssets.Length</span>
                    </div>

                    <div class="p-2 space-y-1.5">
                        @foreach (var asset in columnAssets)
                        {
                            var cat = GetCategoryConfig(asset.Category);
                            <div class="@Cn.Merge("rounded-md border border-l-4 bg-card px-3 py-2.5 transition-colors hover:bg-muted/50", cat.BorderColor)">
                                <div class="flex items-center gap-2">
                                    <div class="min-w-0 flex-1">
                                        <span class="block truncate font-medium text-sm">@asset.Title</span>
                                        <span class="text-muted-foreground text-xs">@asset.Meta</span>
                                    </div>
                                    <AvatarCn Class="size-6 shrink-0">
                                        <AvatarFallbackCn Class="text-[10px]">@asset.RequesterInitials</AvatarFallbackCn>
                                    </AvatarCn>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_assets.Count(a => a.Status == "requested") requested · @_assets.Count(a => a.Status == "in-production") producing · @_assets.Count(a => a.Status == "delivered") delivered
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 12 min ago</span>
        </div>
    </div>
</section>

@code {
    private record CategoryConfig(string Id, string Label, string BorderColor, string DotColor);
    private record Asset(string Id, string Title, string Status, string Category, string Requester, string RequesterInitials, string Meta);
    private record ColumnConfig(string Id, string Title, string IconName);

    private static readonly CategoryConfig[] _categories =
    [
        new("logo",        "Logo",        "border-l-blue-500",    "bg-blue-500"),
        new("guidelines",  "Guidelines",  "border-l-purple-500",  "bg-purple-500"),
        new("templates",   "Templates",   "border-l-amber-500",   "bg-amber-500"),
        new("photography", "Photography", "border-l-emerald-500", "bg-emerald-500"),
        new("video",       "Video",       "border-l-rose-500",    "bg-rose-500"),
    ];

    private static readonly Asset[] _assets =
    [
        new("ba1",  "App icon refresh for iOS and Android",  "requested",     "logo",        "Amy Chen",   "AC", "Multi-platform"),
        new("ba2",  "Social media brand guidelines v2",       "requested",     "guidelines",  "Tom Reeves", "TR", "PDF format"),
        new("ba3",  "Conference booth backdrop photo",        "requested",     "photography", "Lisa Park",  "LP", "8ft x 10ft"),
        new("ba4",  "Product launch teaser video",            "requested",     "video",       "Dan Ortiz",  "DO", "30 seconds"),
        new("ba5",  "Investor deck template update",          "in-production", "templates",   "Amy Chen",   "AC", "Keynote + PPT"),
        new("ba6",  "Monochrome logo variants",               "in-production", "logo",        "Tom Reeves", "TR", "SVG + PNG"),
        new("ba7",  "Team headshot photography session",      "in-production", "photography", "Lisa Park",  "LP", "24 portraits"),
        new("ba8",  "Email signature template",               "in-production", "templates",   "Dan Ortiz",  "DO", "HTML format"),
        new("ba9",  "Brand voice and tone guide",             "delivered",     "guidelines",  "Amy Chen",   "AC", "v1.0 final"),
        new("ba10", "Product walkthrough video",              "delivered",     "video",       "Tom Reeves", "TR", "2 min 15 sec"),
        new("ba11", "Primary logo with tagline",              "delivered",     "logo",        "Lisa Park",  "LP", "All formats"),
    ];

    private static readonly ColumnConfig[] _columns =
    [
        new("requested",     "Requested",     "file-text"),
        new("in-production", "In Production", "package"),
        new("delivered",     "Delivered",     "image"),
    ];

    private static CategoryConfig GetCategoryConfig(string category)
    {
        return Array.Find(_categories, c => c.Id == category) ?? _categories[0];
    }
}
