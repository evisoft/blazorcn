@* ============================================================
   Block: kanban-opportunity-board
   Title: KanbanOpportunityBoard
   Description: React business opportunity kanban for Next.js with ultra-compact cards, HoverCard detail popups showing market size, competition level, effort required, and potential revenue using shadcn/ui HoverCard and Tailwind CSS.
   Source: original/blocks/kanban/kanban-opportunity-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="lightbulb" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Opportunity Board</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_opportunities.Length opportunities
                </BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs">Hover to preview</span>
        </div>

        @* Columns *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var col in _columns)
            {
                var colStage = col.Stage;
                var colOpps = System.Array.FindAll(_opportunities, o => o.Stage == colStage);
                <div>
                    @* Column Header *@
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", col.Dot)"></span>
                        <span class="font-medium text-xs">@col.Label</span>
                        <span class="ml-auto font-mono text-[10px] text-muted-foreground/60 tabular-nums">
                            @colOpps.Length
                        </span>
                    </div>

                    @* Cards *@
                    <div>
                        @for (int i = 0; i < colOpps.Length; i++)
                        {
                            var opp = colOpps[i];
                            var idx = i;
                            var colLen = colOpps.Length;
                            <HoverCardCn OpenDelay="200" CloseDelay="100">
                                <HoverCardTriggerCn Class="block w-full">
                                    <div class="@Cn.Merge("flex w-full cursor-default items-center gap-2 px-3 py-2 text-left transition-colors hover:bg-muted/50", idx < colLen - 1 ? "border-b" : "")">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full opacity-40", col.Dot)"></span>
                                        <span class="min-w-0 flex-1 truncate text-xs">@opp.Title</span>
                                    </div>
                                </HoverCardTriggerCn>
                                <HoverCardContentCn Side="FloatingSide.Right" Align="FloatingAlign.Start" Class="w-72 p-0">
                                    <div class="border-b px-3 py-2.5">
                                        <span class="font-medium text-sm">@opp.Title</span>
                                        <div class="mt-0.5">
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                                                @opp.Category
                                            </BadgeCn>
                                        </div>
                                    </div>
                                    <div class="space-y-2 px-3 py-2.5">
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Market size</span>
                                            <span class="font-medium tabular-nums">@opp.MarketSize</span>
                                        </div>
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Competition</span>
                                            <span class="flex items-center gap-1.5 font-medium">
                                                <span class="@Cn.Merge("size-1.5 rounded-full", _competitionDot[opp.Competition])"></span>
                                                @opp.Competition
                                            </span>
                                        </div>
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Effort</span>
                                            <span class="font-medium">@opp.Effort</span>
                                        </div>
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Revenue potential</span>
                                            <span class="font-medium tabular-nums">@opp.PotentialRevenue</span>
                                        </div>
                                    </div>
                                    <div class="border-t bg-muted/30 px-3 py-2">
                                        <span class="text-muted-foreground text-xs">Notes</span>
                                        <p class="mt-0.5 text-xs leading-relaxed">@opp.Notes</p>
                                    </div>
                                </HoverCardContentCn>
                            </HoverCardCn>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @System.Array.FindAll(_opportunities, o => o.Stage == "won").Length won this quarter
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 20 min ago</span>
        </div>
    </div>
</section>

@code {
    private record Opportunity(
        string Id,
        string Title,
        string Stage,
        string MarketSize,
        string Competition,
        string Effort,
        string PotentialRevenue,
        string Notes,
        string Category
    );

    private record Column(string Stage, string Label, string Dot);

    private static readonly Column[] _columns =
    [
        new("identified",  "Identified",  "bg-blue-500"),
        new("researching", "Researching", "bg-amber-500"),
        new("pursuing",    "Pursuing",    "bg-purple-500"),
        new("won",         "Won",         "bg-emerald-500"),
    ];

    private static readonly Dictionary<string, string> _competitionDot = new()
    {
        ["Low"]    = "bg-emerald-500",
