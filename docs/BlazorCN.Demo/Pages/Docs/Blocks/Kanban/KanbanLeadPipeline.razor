@* ============================================================
   Block: kanban-lead-pipeline
   Title: KanbanLeadPipeline
   Description: React lead management dashboard kanban for Next.js with lead metrics, contact rates, response tracking, and mini kanban columns using shadcn/ui, CountUp, and Tailwind CSS
   Source: original/blocks/kanban/kanban-lead-pipeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="inbox" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Lead Pipeline</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_leads.Length leads
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var col in _columns)
                {
                    var count = _leads.Count(l => l.Stage == col.Id);
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", col.Dot)"></span>
                        @count
                    </span>
                }
            </div>
        </div>

        @* Metrics Grid *@
        <div class="grid grid-cols-2 gap-3 border-b p-4 sm:grid-cols-4">
            @* New Leads Today *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="inbox" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">New Leads Today</span>
                </div>
                <span class="font-semibold text-2xl tabular-nums text-blue-600 dark:text-blue-400">
                    @_newLeads.Length
                </span>
            </div>
            @* Contacted *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="mail-check" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">Contacted</span>
                </div>
                <span class="font-semibold text-2xl tabular-nums text-foreground">
                    @_contactedPercent%
                </span>
            </div>
            @* Response Rate *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="message-circle" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">Response Rate</span>
                </div>
                <span class="font-semibold text-2xl tabular-nums text-amber-600 dark:text-amber-400">
                    @_responseRate%
                </span>
            </div>
            @* Qualified Leads *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="user-check" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">Qualified Leads</span>
                </div>
                <span class="font-semibold text-2xl tabular-nums text-emerald-600 dark:text-emerald-400">
                    @_qualifiedCount
                </span>
            </div>
        </div>

        @* Lead Progress *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Pipeline conversion</span>
                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                    @_wonCount / @_leads.Length won
                </span>
            </div>
            <div class="cn-progress relative flex h-2 w-full items-center overflow-x-hidden"
                 role="progressbar"
                 aria-valuenow="@_pipelineProgress"
                 aria-valuemin="0"
                 aria-valuemax="100">
                <div class="cn-progress-indicator h-full bg-emerald-500 transition-all duration-700"
                     style="@($"width:{_pipelineProgress}%")">
                </div>
            </div>
        </div>

        @* Mini Kanban Board *@
        <div class="border-b p-4">
            <div class="grid grid-cols-4 gap-3">
                @foreach (var col in _columns)
                {
                    var colLeads = _leads.Where(l => l.Stage == col.Id).ToArray();
                    <div class="rounded-md border">
                        @* Column Header *@
                        <div class="flex items-center gap-1.5 border-b px-2.5 py-2">
                            <span class="@Cn.Merge("size-1.5 rounded-full", col.Dot)"></span>
                            <span class="font-medium text-xs">@col.Label</span>
                            <span class="ml-auto font-mono text-muted-foreground/60 text-[10px] tabular-nums">
                                @colLeads.Length
                            </span>
                        </div>
                        @* Mini Cards *@
                        <div class="flex flex-col gap-0.5 p-1.5">
                            @foreach (var lead in colLeads)
                            {
                                <div class="flex items-center gap-1.5 rounded px-2 py-1.5 transition-colors hover:bg-muted/50">
                                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full opacity-40", col.Dot)"></span>
                                    <span class="min-w-0 flex-1 truncate text-xs">@lead.Name</span>
                                    <span class="shrink-0 font-mono text-muted-foreground/60 text-[10px] tabular-nums">
                                        @lead.Source
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                4 stages · @_wonCount of @_leads.Length converted
            </span>
            <span class="font-mono text-muted-foreground/60 text-xs tabular-nums">
                @_pipelineProgress% win rate
            </span>
        </div>
    </div>
</section>

@code {
    private record Lead(string Id, string Name, string Company, string Stage, string Source);
    private record KanbanColumn(string Id, string Label, string Dot);

    private static readonly Lead[] _leads =
    [
        new("l1",  "Sarah Mitchell", "Acme Corp",     "new",       "Website"),
        new("l2",  "James Chen",     "TechFlow",      "new",       "LinkedIn"),
        new("l3",  "Maria Garcia",   "DataSync",      "new",       "Referral"),
        new("l4",  "Alex Turner",    "CloudBase",     "new",       "Webinar"),
        new("l5",  "Priya Patel",    "Nexus AI",      "contacted", "LinkedIn"),
        new("l6",  "Tom Harris",     "ShipFast",      "contacted", "Cold Email"),
        new("l7",  "Emma Wilson",    "GrowthLab",     "contacted", "Website"),
        new("l8",  "David Kim",      "Quantum Pay",   "qualified", "Referral"),
        new("l9",  "Lisa Brown",     "Elevate HR",    "qualified", "Website"),
        new("l10", "Ryan O'Brien",   "ScaleOps",      "qualified", "LinkedIn"),
        new("l11", "Nina Kowalski",  "FinStack",      "qualified", "Webinar"),
        new("l12", "Carlos Mendez",  "BrightPath",    "won",       "Referral"),
        new("l13", "Anna Johansson", "PulseMetrics",  "won",       "Website"),
        new("l14", "Mike Thompson",  "EdgeCore",      "won",       "Cold Email"),
    ];

    private static readonly KanbanColumn[] _columns =
    [
        new("new",       "New",       "bg-blue-500"),
        new("contacted", "Contacted", "bg-amber-500"),
        new("qualified", "Qualified", "bg-purple-500"),
        new("won",       "Won",       "bg-emerald-500"),
    ];

    private Lead[]  _newLeads           => _leads.Where(l => l.Stage == "new").ToArray();
    private Lead[]  _contactedOrBeyond  => _leads.Where(l => l.Stage != "new").ToArray();
    private int     _contactedPercent   => (int)Math.Round((double)_contactedOrBeyond.Length / _leads.Length * 100);
    private Lead[]  _qualifiedOrWon     => _leads.Where(l => l.Stage == "qualified" || l.Stage == "won").ToArray();
    private int     _responseRate       => (int)Math.Round((double)_qualifiedOrWon.Length / _contactedOrBeyond.Length * 100);
    private int     _qualifiedCount     => _leads.Count(l => l.Stage == "qualified");
    private int     _wonCount           => _leads.Count(l => l.Stage == "won");
    private int     _pipelineProgress   => (int)Math.Round((double)_wonCount / _leads.Length * 100);
}
