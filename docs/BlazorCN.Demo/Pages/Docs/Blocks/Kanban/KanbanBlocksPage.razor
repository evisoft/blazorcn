    private const string KanbanWriterAssignmentsCode = @"<section class=""mx-auto w-full max-w-6xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @* Header *@
        <div class=""border-b px-4 py-3"">
