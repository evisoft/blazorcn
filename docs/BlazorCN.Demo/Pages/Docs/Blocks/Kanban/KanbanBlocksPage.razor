                                            @epCard.Version
                                        </span>
                                        @if (epCard.IsBreaking)
                                        {
                                            <span class=""size-1.5 rounded-full bg-red-500""></span>
                                            <span class=""text-[10px] text-red-600 dark:text-red-400"">
                                                breaking
                                            </span>
