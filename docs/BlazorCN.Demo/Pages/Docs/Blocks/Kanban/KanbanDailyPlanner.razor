@* ============================================================
   Block: kanban-daily-planner
   Title: KanbanDailyPlanner
   Description: React kanban daily schedule planner for Next.js with tab navigation for time-of-day columns, time slots, duration badges, location labels, and staggered animations using shadcn/ui Tabs and Tailwind CSS
   Source: original/blocks/kanban/kanban-daily-planner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Daily Planner</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_activities.Length activities
                </BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs">Tuesday, March 25</span>
        </div>

        @* Tabs *@
        <div class="px-4 py-3">
            <TabsCn DefaultValue="morning">
                <TabsListCn Class="w-full">
                    @foreach (var col in _columns)
                    {
                        var colId = col.Id;
                        <TabsTriggerCn Value="@colId" Class="h-8 gap-1.5 text-xs">
                            <LucideIconCn Name="@col.Icon" Size="14" Class="size-3.5" />
                            @col.Label
                            <span class="text-muted-foreground/60 text-[10px]">@GetCount(colId)</span>
                        </TabsTriggerCn>
                    }
                </TabsListCn>

                @foreach (var col in _columns)
                {
                    var colId = col.Id;
                    var columnActivities = _activities.Where(a => a.Period == colId).ToArray();
                    var isDone = colId == "completed";
                    <TabsContentCn Value="@colId" Class="mt-0">
                        <div class="mt-3 overflow-hidden rounded-md border">
                            @for (var i = 0; i < columnActivities.Length; i++)
                            {
                                var activity = columnActivities[i];
                                var isLast = i == columnActivities.Length - 1;
                                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                                    <span class="mt-0.5 shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                                        @activity.Time
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <span class="@Cn.Merge("text-sm", isDone ? "text-muted-foreground line-through" : "font-medium")">
                                            @activity.Task
                                        </span>
                                        @if (activity.Location != null)
                                        {
                                            <p class="mt-0.5 flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                                @activity.Location
                                            </p>
                                        }
                                    </div>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-[10px]">
                                        @activity.Duration
                                    </BadgeCn>
                                </div>
                            }
                        </div>
                    </TabsContentCn>
                }
            </TabsCn>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @GetCount("completed") of @_activities.Length completed
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 10 min ago</span>
        </div>
    </div>
</section>

@code {
    private record ActivityItem(string Id, string Task, string Time, string Duration, string? Location, string Period);
    private record ColumnItem(string Id, string Label, string Icon);

    private static readonly ColumnItem[] _columns =
    [
        new("morning",   "Morning",   "sunrise"),
        new("afternoon", "Afternoon", "sun"),
        new("evening",   "Evening",   "moon-star"),
        new("completed", "Done",      "circle-check-big"),
    ];

    private static readonly ActivityItem[] _activities =
    [
        new("1",  "Morning run",                "6:30 AM",  "45 min", "Riverside Trail", "morning"),
        new("2",  "Prepare breakfast",          "7:30 AM",  "20 min", null,              "morning"),
        new("3",  "Team standup",               "9:00 AM",  "15 min", "Zoom",            "morning"),
        new("4",  "Deep work — feature build",  "9:30 AM",  "2 hr",   null,              "morning"),
        new("5",  "Lunch with Alex",            "12:00 PM", "1 hr",   "Cafe Luna",       "afternoon"),
        new("6",  "Code review PRs",            "1:30 PM",  "45 min", null,              "afternoon"),
        new("7",  "Client sync call",           "2:30 PM",  "30 min", "Google Meet",     "afternoon"),
        new("8",  "Write documentation",        "3:15 PM",  "1 hr",   null,              "afternoon"),
        new("9",  "Grocery shopping",           "6:00 PM",  "40 min", "Whole Foods",     "evening"),
        new("10", "Cook dinner",                "7:00 PM",  "45 min", null,              "evening"),
        new("11", "Read before bed",            "9:00 PM",  "30 min", null,              "evening"),
        new("12", "Sent weekly report",         "11:00 AM", "30 min", null,              "completed"),
        new("13", "Booked dentist appointment", "8:00 AM",  "5 min",  null,              "completed"),
    ];

    private int GetCount(string period) => _activities.Count(a => a.Period == period);
}
