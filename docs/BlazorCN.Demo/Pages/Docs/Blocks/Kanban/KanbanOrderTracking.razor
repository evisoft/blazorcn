@* ============================================================
   Block: kanban-order-tracking
   Title: KanbanOrderTracking
   Description: React kanban order tracking board for Next.js with order number prefixes, dollar amounts, customer names, and staggered entrance animations using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-order-tracking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Order Tracking</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_orders.Length orders
                </BadgeCn>
            </div>
            <span class="font-medium text-muted-foreground text-xs tabular-nums">
                @FormatAmount(_totalRevenue) total
            </span>
        </div>

        @* Columns *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var col in _columnConfig)
            {
                var colOrders = _orders.Where(o => o.Status == col.Id).ToArray();
                var colTotal = colOrders.Sum(o => o.Amount);
                <div>
                    @* Column header *@
                    <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2.5">
                        <div class="flex items-center gap-2">
                            <span class="text-muted-foreground">
                                <LucideIconCn Name="@col.IconName" Size="14" Class="size-3.5" />
                            </span>
                            <span class="font-medium text-muted-foreground text-xs">@col.Title</span>
                            <span class="text-muted-foreground/60 text-xs">@colOrders.Length</span>
                        </div>
                        <span class="text-muted-foreground/60 text-xs tabular-nums">
                            @FormatAmount(colTotal)
                        </span>
                    </div>

                    @* Order rows *@
                    <div>
                        @for (int i = 0; i < colOrders.Length; i++)
                        {
                            var order = colOrders[i];
                            var isLast = i == colOrders.Length - 1;
                            <div class="@Cn.Merge("flex items-center gap-2.5 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                                <span class="shrink-0 font-mono text-muted-foreground text-xs">
                                    @order.OrderId
                                </span>
                                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                    @order.CustomerInitials
                                </span>
                                <div class="min-w-0 flex-1">
                                    <span class="block truncate font-medium text-sm">
                                        @order.Product
                                    </span>
                                    <span class="block truncate text-muted-foreground text-xs">
                                        @order.Customer
                                    </span>
                                </div>
                                <span class="shrink-0 font-medium text-sm tabular-nums">
                                    @FormatAmount(order.Amount)
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @(_orders.Count(o => o.Status == "delivered")) delivered this week
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 2 min ago</span>
        </div>
    </div>
</section>

@code {
    private record Order(string Id, string OrderId, string Customer, string CustomerInitials, string Product, double Amount, string Status);
    private record ColumnDef(string Id, string Title, string IconName);

    private static readonly Order[] _orders =
    [
        new("1",  "ORD-1041", "Emma Thompson",   "ET", "Wireless Headphones",  89.99,  "processing"),
        new("2",  "ORD-1042", "James Lee",        "JL", "USB-C Hub Adapter",    45.0,   "processing"),
        new("3",  "ORD-1043", "Sofia Garcia",     "SG", "Mechanical Keyboard",  159.99, "processing"),
        new("4",  "ORD-1044", "Ryan Chen",        "RC", "Monitor Stand",        34.5,   "processing"),
        new("5",  "ORD-1035", "Mia Johnson",      "MJ", "Webcam HD Pro",        74.99,  "shipped"),
        new("6",  "ORD-1036", "Noah Williams",    "NW", "Desk Lamp LED",        52.0,   "shipped"),
        new("7",  "ORD-1037", "Ava Brown",        "AB", "Laptop Sleeve 14in",   29.99,  "shipped"),
        new("8",  "ORD-1028", "Liam Davis",       "LD", "Bluetooth Speaker",    119.99, "delivered"),
        new("9",  "ORD-1029", "Olivia Martinez",  "OM", "Wireless Mouse",       39.99,  "delivered"),
        new("10", "ORD-1030", "Ethan Wilson",     "EW", "Phone Charger Pad",    24.99,  "delivered"),
        new("11", "ORD-1031", "Isabella Moore",   "IM", "Cable Organizer Set",  18.5,   "delivered"),
    ];

    private static readonly ColumnDef[] _columnConfig =
    [
        new("processing", "Processing", "package"),
        new("shipped",    "Shipped",    "truck"),
        new("delivered",  "Delivered",  "package-check"),
    ];

    private double _totalRevenue => _orders.Sum(o => o.Amount);

    private static string FormatAmount(double amount) =>
        $"${amount:N2}";
}
