@* ============================================================
   Block: kanban-designer-pipeline
   Title: KanbanDesignerPipeline
   Description: React kanban design team pipeline swimlane board for Next.js with avatar rows, project type badges, design status columns, and delivery tracking using shadcn/ui Avatar and Tailwind CSS
   Source: original/blocks/kanban/kanban-designer-pipeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-medium text-sm">Design Pipeline</h2>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_tasks.Length projects · @_tasks.Count(t => t.Status == "delivered") delivered
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">UI</BadgeCn>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">Brand</BadgeCn>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">Motion</BadgeCn>
                </div>
            </div>
        </div>

        @* Column headers *@
        <div class="grid grid-cols-[160px_1fr_1fr_1fr_1fr_48px] border-b bg-muted/30">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Designer</span>
            </div>
            @foreach (var s in _statuses)
            {
                <div class="px-3 py-2">
                    <span class="font-medium text-muted-foreground text-xs">@s.Label</span>
                </div>
            }
            <div class="px-2 py-2">
                <span class="font-medium text-muted-foreground text-xs">#</span>
            </div>
        </div>

        @* Swimlane rows *@
        <div>
            @foreach (var designer in _designers)
            {
                var designerTasks = _tasks.Where(t => t.DesignerId == designer.Id).ToArray();
                var isLast = designer.Id == _designers[_designers.Length - 1].Id;
                <div class="@Cn.Merge("grid grid-cols-[160px_1fr_1fr_1fr_1fr_48px] items-start", !isLast ? "border-b" : "")">
                    @* Avatar cell *@
                    <div class="flex items-center gap-2.5 px-4 py-3">
                        <AvatarCn Class="size-7">
                            <AvatarFallbackCn Class="text-[10px]">@designer.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0">
                            <p class="truncate font-medium text-sm">@designer.Name</p>
                            <p class="truncate text-muted-foreground text-xs">@designer.Specialty</p>
                        </div>
                    </div>

                    @* Status cells *@
                    @foreach (var s in _statuses)
                    {
                        var cellTasks = designerTasks.Where(t => t.Status == s.Key).ToArray();
                        <div class="min-h-[60px] px-2 py-2.5">
                            @if (cellTasks.Length > 0)
                            {
                                <div class="flex flex-col gap-1.5">
                                    @foreach (var task in cellTasks)
                                    {
                                        var dotColor = GetPriorityDot(task.Priority);
                                        <div class="flex items-center gap-2 rounded-md bg-muted/50 px-2.5 py-1.5 transition-colors hover:bg-muted">
                                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dotColor)"></span>
                                            <span class="min-w-0 flex-1 truncate text-xs">@task.Title</span>
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-[10px] px-1.5 py-0">@task.ProjectType</BadgeCn>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="flex min-h-[36px] items-center justify-center rounded-md border border-dashed border-muted-foreground/20">
                                    <span class="text-muted-foreground/40 text-xs">—</span>
                                </div>
                            }
                        </div>
                    }

                    @* Count cell *@
                    <div class="flex items-center justify-center py-3">
                        <span class="font-medium text-muted-foreground text-xs tabular-nums">@designerTasks.Length</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StatusItem(string Key, string Label);
    private record DesignerItem(string Id, string Name, string Initials, string Specialty);
    private record TaskItem(string Id, string Title, string DesignerId, string Status, string ProjectType, string Priority);

    private static readonly StatusItem[] _statuses =
    [
        new("briefed",   "Briefed"),
        new("designing", "Designing"),
        new("feedback",  "Feedback"),
        new("delivered", "Delivered"),
    ];

    private static readonly DesignerItem[] _designers =
    [
        new("d1", "Maya Lin",     "ML", "Product Design"),
        new("d2", "Felix Moreau", "FM", "Brand Design"),
        new("d3", "Zara Ahmed",   "ZA", "Motion Design"),
        new("d4", "Niko Petrov",  "NP", "UI Design"),
    ];

    private static readonly TaskItem[] _tasks =
    [
        new("t1",  "Settings page redesign",           "d1", "designing", "UI",    "high"),
        new("t2",  "Onboarding flow illustrations",    "d1", "feedback",  "Brand", "medium"),
        new("t3",  "Mobile nav component",             "d1", "delivered", "UI",    "low"),
        new("t4",  "Brand guidelines v2",              "d2", "designing", "Brand", "high"),
        new("t5",  "Social media templates",           "d2", "briefed",   "Brand", "medium"),
        new("t6",  "Conference booth banner",          "d2", "delivered", "Brand", "low"),
        new("t7",  "Hero section animation",           "d3", "designing", "Motion","high"),
        new("t8",  "Loading state micro-interactions", "d3", "feedback",  "Motion","medium"),
        new("t9",  "Product launch video",             "d3", "briefed",   "Motion","high"),
        new("t10", "Dashboard widget library",         "d4", "designing", "UI",    "high"),
        new("t11", "Dark mode color tokens",           "d4", "feedback",  "UI",    "medium"),
        new("t12", "Icon set expansion",               "d4", "briefed",   "UI",    "low"),
        new("t13", "Email campaign template",          "d2", "feedback",  "Brand", "medium"),
        new("t14", "Data viz chart styles",            "d1", "briefed",   "UI",    "medium"),
    ];

    private static string GetPriorityDot(string priority) => priority switch
    {
        "high"   => "bg-red-500",
        "medium" => "bg-amber-500",
        _        => "bg-blue-500",
    };
}
