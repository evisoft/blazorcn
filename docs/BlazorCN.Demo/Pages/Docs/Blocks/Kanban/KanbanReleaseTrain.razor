@* ============================================================
   Block: kanban-release-train
   Title: KanbanReleaseTrain
   Description: React swimlane kanban board for Next.js with release version rows, development phase columns, and feature chips using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-release-train.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Release Train</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_features.Length features
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    Feature
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    Fix
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Improvement
                </span>
            </div>
        </div>

        @* Grid *@
        <div class="overflow-x-auto">
            @* Column headers *@
            <div class="grid grid-cols-[180px_1fr_1fr_1fr_1fr] border-b bg-muted/30">
                <div class="px-4 py-2.5">
                    <span class="font-medium text-muted-foreground text-xs">Release</span>
                </div>
                @foreach (var s in _statuses)
                {
                    <div class="border-l px-4 py-2.5">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-muted-foreground text-xs">@s.Label</span>
                            <span class="font-mono text-muted-foreground/60 text-xs">@TotalByStatus(s.Id)</span>
                        </div>
                    </div>
                }
            </div>

            @* Swimlane rows *@
            @foreach (var release in _releases)
            {
                var isLast = release.Id == _releases[_releases.Length - 1].Id;
                var relFeatures = _features.Where(f => f.Release == release.Id).ToArray();
                var releasedCount = relFeatures.Count(f => f.Status == "released");
                <div class="@Cn.Merge("grid grid-cols-[180px_1fr_1fr_1fr_1fr]", !isLast ? "border-b" : "")">
                    @* Release label *@
                    <div class="flex items-start gap-2.5 px-4 py-3">
                        <LucideIconCn Name="tag" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="font-medium font-mono text-sm">@release.Version</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                                    @_typeLabel[release.Type]
                                </BadgeCn>
                            </div>
                            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                <span>@release.TargetDate</span>
                                <span>·</span>
                                <span>@releasedCount/@relFeatures.Length</span>
                            </div>
                        </div>
                    </div>

                    @* Status cells *@
                    @foreach (var s in _statuses)
                    {
                        var cellFeatures = _features.Where(f => f.Release == release.Id && f.Status == s.Id).ToArray();
                        <div class="@Cn.Merge("border-l px-3 py-2.5", cellFeatures.Length == 0 ? "bg-muted/20" : "")">
                            <div class="flex flex-col gap-1.5">
                                @if (cellFeatures.Length == 0)
                                {
                                    <div class="rounded-md border border-dashed border-muted-foreground/20 px-2 py-1.5 text-center text-muted-foreground/40 text-xs">
                                        None
                                    </div>
                                }
                                @foreach (var feature in cellFeatures)
                                {
                                    <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2 py-1 transition-colors hover:bg-muted">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _categoryDot[feature.Category])"></span>
                                        <span class="truncate text-xs">@feature.Title</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_releases.Length releases · @TotalByStatus("released") of @_features.Length shipped
            </span>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="git-branch" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-mono text-muted-foreground/60 text-xs">
                    @TotalByStatus("developing") in development
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record Release(string Id, string Version, string TargetDate, string Type);
    private record Feature(string Id, string Title, string Release, string Status, string Category);
    private record StatusItem(string Id, string Label);

    private static readonly Release[] _releases =
    [
        new("v21", "v2.1", "Apr 15", "patch"),
        new("v22", "v2.2", "May 1",  "minor"),
        new("v23", "v2.3", "Jun 10", "minor"),
        new("v30", "v3.0", "Aug 1",  "major"),
    ];

    private static readonly StatusItem[] _statuses =
    [
        new("planned",    "Planned"),
        new("developing", "Developing"),
        new("testing",    "Testing"),
        new("released",   "Released"),
    ];

    private static readonly Feature[] _features =
    [
        new("f1",  "Fix CSV export encoding",      "v21", "testing",    "fix"),
        new("f2",  "Patch auth token refresh",      "v21", "released",   "fix"),
        new("f3",  "Improve search indexing",       "v21", "released",   "improvement"),
        new("f4",  "Webhook retry with backoff",    "v22", "developing", "feature"),
        new("f5",  "Bulk user import",              "v22", "planned",    "feature"),
        new("f6",  "Audit log filtering",           "v22", "developing", "improvement"),
        new("f7",  "Custom dashboard layouts",      "v22", "testing",    "feature"),
        new("f8",  "GraphQL subscriptions",         "v23", "planned",    "feature"),
        new("f9",  "Multi-tenant isolation",        "v23", "developing", "feature"),
        new("f10", "Performance profiler tool",     "v23", "planned",    "improvement"),
        new("f11", "Real-time collaboration",       "v30", "planned",    "feature"),
        new("f12", "Plugin architecture",           "v30", "planned",    "feature"),
        new("f13", "AI-powered search",             "v30", "developing", "feature"),
        new("f14", "New permissions model",         "v30", "planned",    "feature"),
        new("f15", "Edge deployment support",       "v23", "planned",    "improvement"),
        new("f16", "Batch API endpoints",           "v22", "planned",    "feature"),
    ];

    private static readonly Dictionary<string, string> _categoryDot = new()
    {
        ["feature"]     = "bg-blue-500",
        ["fix"]         = "bg-red-500",
        ["improvement"] = "bg-emerald-500",
    };

    private static readonly Dictionary<string, string> _typeLabel = new()
    {
        ["patch"] = "Patch",
        ["minor"] = "Minor",
        ["major"] = "Major",
    };

    private int TotalByStatus(string status) => _features.Count(f => f.Status == status);
}
