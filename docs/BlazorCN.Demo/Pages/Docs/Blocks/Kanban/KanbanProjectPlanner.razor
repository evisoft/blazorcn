@* ============================================================
   Block: kanban-project-planner
   Title: KanbanProjectPlanner
   Description: React split-panel kanban board for Next.js with three project columns and a detail panel showing task metadata, progress bars, and tags using shadcn/ui and Tailwind CSS.
   Source: original/blocks/kanban/kanban-project-planner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="folder-kanban" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Project Planner</h2>
            <span class="text-xs text-muted-foreground">@_tasks.Length tasks</span>
        </div>

        @* Board + Detail *@
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr_1fr_minmax(280px,1.2fr)]">
            @* Columns *@
            @foreach (var col in _columns)
            {
                var colTasks = _tasks.Where(t => t.Status == col.Status).ToArray();
                var isLast = col.Status == "complete";
                <div class="@Cn.Merge("min-h-[500px] bg-card", !isLast ? "border-r" : "")">
                    <div class="flex items-center gap-2 border-b px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", StatusDotClass(col.Status))"></span>
                        <span class="text-xs font-medium">@col.Label</span>
                        <span class="ml-auto text-xs text-muted-foreground">@colTasks.Length</span>
                    </div>
                    <div class="divide-y">
                        @foreach (var task in colTasks)
                        {
                            var taskItem = task;
                            <button
                                type="button"
                                @onclick="@(() => _selectedId = taskItem.Id)"
                                class="@Cn.Merge("flex w-full items-center gap-2.5 px-3 py-2.5 text-left transition-colors hover:bg-muted/50", _selectedId == taskItem.Id ? "bg-muted/50 ring-2 ring-foreground ring-inset" : "")">
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", PriorityDotClass(taskItem.Priority))"></span>
                                <span class="min-w-0 flex-1 truncate text-sm font-medium">@taskItem.Title</span>
                                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                    @taskItem.Initials
                                </span>
                            </button>
                        }
                    </div>
                </div>
            }

            @* Detail Panel *@
            <div class="min-h-[500px] border-l bg-muted/20">
                @{
                    var selected = _tasks.FirstOrDefault(t => t.Id == _selectedId);
                }
                @if (selected != null)
                {
                    <div>
                        <div class="border-b px-4 py-3">
                            <h3 class="text-sm font-medium">@selected.Title</h3>
                            <div class="mt-1.5 flex items-center gap-2">
                                <span class="@Cn.Merge("size-1.5 rounded-full", StatusDotClass(selected.Status))"></span>
                                <span class="text-xs text-muted-foreground capitalize">@selected.Status.Replace("-", " ")</span>
                            </div>
                        </div>

                        <div class="border-b px-4 py-3">
                            <div class="space-y-2.5">
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">Assignee</span>
                                    <span class="ml-auto font-medium">@selected.Assignee</span>
                                </div>
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideIconCn Name="circle-dot" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">Priority</span>
                                    <span class="ml-auto flex items-center gap-1.5 font-medium capitalize">
                                        <span class="@Cn.Merge("size-1.5 rounded-full", PriorityDotClass(selected.Priority))"></span>
                                        @selected.Priority
                                    </span>
                                </div>
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">Due date</span>
                                    <span class="ml-auto font-medium">@selected.DueDate</span>
                                </div>
                            </div>
                        </div>

                        <div class="border-b px-4 py-3">
                            <span class="text-xs font-medium text-muted-foreground">Description</span>
                            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">@selected.Description</p>
                        </div>

                        <div class="border-b px-4 py-3">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-medium text-muted-foreground">Progress</span>
                                <span class="text-xs font-medium tabular-nums">@(selected.Progress)%</span>
                            </div>
                            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                <div
                                    class="@Cn.Merge("h-full rounded-full transition-all", selected.Progress == 100 ? "bg-emerald-500" : "bg-foreground")"
                                    style="@($"width:{selected.Progress}%")">
                                </div>
                            </div>
                        </div>

                        <div class="border-b px-4 py-3">
                            <span class="text-xs font-medium text-muted-foreground">Tags</span>
                            <div class="mt-1.5 flex flex-wrap gap-1.5">
                                @foreach (var tag in selected.Tags)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                        <LucideIconCn Name="tag" Size="12" Class="mr-1 size-3" />
                                        @tag
                                    </BadgeCn>
                                }
                            </div>
                        </div>

                        <div class="flex gap-2 px-4 py-3">
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Edit task</ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">Archive</ButtonCn>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex h-[500px] items-center justify-center px-4">
                        <p class="text-sm text-muted-foreground">Select a card to view details</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Task(string Id, string Title, string Status, string Assignee, string Initials, string Priority, string DueDate, string Description, int Progress, string[] Tags);
    private record KanbanColumn(string Status, string Label);

    private static readonly Task[] _tasks =
    [
        new("t1",  "Implement OAuth2 PKCE flow",          "todo",        "Sarah Chen",  "SC", "critical", "Apr 15", "Add PKCE-based OAuth2 authentication flow for single-page applications. Must support Google, GitHub, and custom OIDC providers with token refresh.",                                0,   ["auth", "security"]),
        new("t2",  "Design system token migration",        "todo",        "Marcus Webb", "MW", "high",     "Apr 18", "Migrate all hardcoded color values to design tokens. Update 47 components to reference the new token system for theme consistency.",                                              0,   ["design", "refactor"]),
        new("t3",  "Add CSV export to reports",            "todo",        "Priya Patel", "PP", "medium",   "Apr 22", "Allow users to export any report view as CSV. Support custom column selection, date range filtering, and large dataset streaming.",                                               0,   ["feature", "reports"]),
        new("t4",  "WebSocket connection pooling",         "in-progress", "James Liu",   "JL", "high",     "Apr 10", "Implement connection pooling for WebSocket clients to reduce server load. Target 60% reduction in open connections during peak traffic.",                                         65,  ["performance", "backend"]),
        new("t5",  "Notification preference center",       "in-progress", "Sarah Chen",  "SC", "medium",   "Apr 12", "Build a settings page where users can configure notification channels per event type. Support email, push, SMS, and Slack delivery.",                                            40,  ["feature", "settings"]),
        new("t6",  "API rate limiter refactor",            "in-progress", "Marcus Webb", "MW", "critical", "Apr 8",  "Replace fixed-window rate limiting with sliding window algorithm. Add per-endpoint configuration and Redis-backed distributed counting.",                                         80,  ["backend", "security"]),
        new("t7",  "Dashboard accessibility audit",        "in-progress", "Priya Patel", "PP", "high",     "Apr 14", "Run WCAG 2.1 AA compliance audit on all dashboard views. Fix contrast issues, missing ARIA labels, and keyboard navigation gaps.",                                               55,  ["a11y", "dashboard"]),
        new("t8",  "Stripe webhook idempotency",           "complete",    "James Liu",   "JL", "critical", "Mar 28", "Added idempotency keys to all Stripe webhook handlers. Duplicate events are now detected and skipped within a 24-hour window.",                                                  100, ["payments", "backend"]),
        new("t9",  "Search indexing pipeline v2",          "complete",    "Sarah Chen",  "SC", "high",     "Mar 25", "Rebuilt the full-text search pipeline with trigram matching and BM25 relevance scoring. Average query time reduced from 340ms to 45ms.",                                         100, ["search", "performance"]),
        new("t10", "CI pipeline optimization",             "complete",    "Marcus Webb", "MW", "medium",   "Mar 20", "Parallelized test suites and added build caching. Total CI time reduced from 18 minutes to 6 minutes on average.",                                                               100, ["devops", "ci"]),
    ];

    private static readonly KanbanColumn[] _columns =
    [
        new("todo",        "Todo"),
        new("in-progress", "In Progress"),
        new("complete",    "Complete"),
    ];

    private string _selectedId = "t4";

    private static string StatusDotClass(string status) => status switch
    {
        "todo"        => "bg-blue-500",
        "in-progress" => "bg-amber-500",
        "complete"    => "bg-emerald-500",
        _             => ""
    };

    private static string PriorityDotClass(string priority) => priority switch
    {
        "critical" => "bg-red-500",
        "high"     => "bg-amber-500",
        "medium"   => "bg-blue-500",
        "low"      => "bg-zinc-400",
        _          => ""
    };
}
