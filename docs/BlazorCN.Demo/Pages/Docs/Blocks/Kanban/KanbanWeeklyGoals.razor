@* ============================================================
   Block: kanban-weekly-goals
   Title: KanbanWeeklyGoals
   Description: React kanban weekly goal tracker for Next.js with vertical accordion columns, category badges, target metrics, and staggered card animations using shadcn/ui Accordion and Tailwind CSS
   Source: original/blocks/kanban/kanban-weekly-goals.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Weekly Goals</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_goals.Length goals
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var col in _columns)
                {
                    var colId = col.Id;
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", col.Dot)"></span>
                        @GetCount(colId)
                    </span>
                }
            </div>
        </div>

        @* Accordion columns *@
        <div class="px-4 py-3">
            <AccordionCn>
                @foreach (var col in _columns)
                {
                    var colId = col.Id;
                    var columnGoals = _goals.Where(g => g.Status == colId).ToArray();
                    var isComplete = colId == "complete";
                    <AccordionItemCn DefaultOpen="@(colId == "in-progress")">
                        <AccordionTriggerCn Class="py-3 hover:no-underline">
                            <div class="flex items-center gap-2">
                                <span class="text-muted-foreground">
                                    <LucideIconCn Name="@col.Icon" Size="14" Class="size-3.5" />
                                </span>
                                <span class="font-medium text-sm">@col.Label</span>
                                <span class="text-muted-foreground/60 text-xs">@columnGoals.Length</span>
                            </div>
                        </AccordionTriggerCn>
                        <AccordionContentCn Class="pb-2">
                            <div class="overflow-hidden rounded-md border">
                                @for (var i = 0; i < columnGoals.Length; i++)
                                {
                                    var goal = columnGoals[i];
                                    var isLast = i == columnGoals.Length - 1;
                                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", col.Dot)"></span>
                                        <span class="@Cn.Merge("min-w-0 flex-1 truncate text-sm", isComplete ? "text-muted-foreground line-through" : "font-medium")">
                                            @goal.Title
                                        </span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("shrink-0 font-normal text-[10px]", GetCategoryColor(goal.Category))">
                                            @goal.Category
                                        </BadgeCn>
                                        <span class="shrink-0 text-muted-foreground/60 text-xs tabular-nums">
                                            @goal.Target
                                        </span>
                                    </div>
                                }
                            </div>
                        </AccordionContentCn>
                    </AccordionItemCn>
                }
            </AccordionCn>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @GetCount("complete") of @_goals.Length complete
            </span>
            <span class="text-muted-foreground/60 text-xs">Week of Mar 24</span>
        </div>
    </div>
</section>

@code {
    private record Goal(string Id, string Title, string Status, string Category, string Target);
    private record Column(string Id, string Label, string Icon, string Dot);

    private static readonly Column[] _columns =
    [
        new("not-started",  "Not Started",  "flag",        "bg-zinc-400"),
        new("in-progress",  "In Progress",  "target",      "bg-amber-500"),
        new("complete",     "Complete",     "trophy",      "bg-emerald-500"),
        new("carried-over", "Carried Over", "rotate-ccw",  "bg-red-500"),
    ];

    private static readonly Goal[] _goals =
    [
        new("1",  "Ship landing page redesign",        "not-started",  "Work",     "1 page"),
        new("2",  "Read 3 chapters of Atomic Habits",  "not-started",  "Personal", "3 chapters"),
        new("3",  "Meal prep for the week",            "not-started",  "Health",   "5 meals"),
        new("4",  "Write API documentation",           "in-progress",  "Work",     "12 endpoints"),
        new("5",  "Run 15 miles total",                "in-progress",  "Health",   "15 miles"),
        new("6",  "Organize garage shelves",           "in-progress",  "Personal", "4 shelves"),
        new("7",  "Close 3 customer deals",            "complete",     "Work",     "3 deals"),
        new("8",  "Meditate every morning",            "complete",     "Health",   "7 sessions"),
        new("9",  "Fix leaking kitchen faucet",        "complete",     "Personal", "1 fix"),
        new("10", "Complete TypeScript course",        "complete",     "Work",     "8 modules"),
        new("11", "Batch cook protein meals",          "carried-over", "Health",   "6 servings"),
        new("12", "Set up home office monitor arm",    "carried-over", "Personal", "1 setup"),
    ];

    private int GetCount(string status) => _goals.Count(g => g.Status == status);

    private static string GetCategoryColor(string category) => category switch
    {
        "Work"     => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        "Personal" => "bg-violet-500/10 text-violet-700 dark:text-violet-400",
        "Health"   => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        _          => "",
    };
}
