@* ============================================================
   Block: kanban-due-date-board
   Title: KanbanDueDateBoard
   Description: React assignment due date kanban board for Next.js with timeline header, urgency indicators, and grade tracking using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-due-date-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="graduation-cap" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Due Date Board</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_assignments.Length assignments
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                @if (_overdueCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-xs text-red-600 dark:text-red-400">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @_overdueCount overdue
                    </span>
                }
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="book-open" Size="12" Class="size-3" />
                    @_gradedCount graded
                </span>
            </div>
        </div>

        @* Timeline header *@
        <div class="border-b bg-muted/30 px-4 py-2.5">
            <div class="flex items-center">
                @foreach (var dateItem in _timelineDates)
                {
                    var idx = dateItem.Index;
                    var date = dateItem.Date;
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <span class="@Cn.Merge("font-mono text-[10px]", idx == _todayIndex ? "font-semibold text-foreground" : idx < _todayIndex ? "text-muted-foreground/60" : "text-muted-foreground")">
                            @date
                        </span>
                        <span class="@Cn.Merge("size-1.5 rounded-full", idx == _todayIndex ? "bg-foreground" : idx < _todayIndex ? "bg-muted-foreground/30" : "bg-muted-foreground/20")"></span>
                    </div>
                }
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-4">
            @foreach (var col in _columns)
            {
                var colId = col.Id;
                var colAssignments = _assignments.Where(a => a.Status == colId).OrderBy(a => _urgencyOrder[a.Urgency]).ToArray();
                var isLast = col.Id == _columns[_columns.Length - 1].Id;
                <div class="@Cn.Merge(!isLast ? "border-r" : "")">
                    @* Column header *@
                    <div class="flex items-center gap-2 border-b px-3 py-2.5">
                        <span class="font-medium text-xs">@col.Label</span>
                        <span class="ml-auto font-mono text-muted-foreground/60 text-xs">@colAssignments.Length</span>
                    </div>

                    @* Cards *@
                    <div class="flex flex-col gap-1 p-2">
                        @foreach (var assignment in colAssignments)
                        {
                            var uc = _urgencyConfig[assignment.Urgency];
                            var subjectCls = _subjectColor.TryGetValue(assignment.Subject, out var sc) ? sc : "bg-muted text-muted-foreground";
                            <div class="overflow-hidden rounded-md transition-colors hover:bg-muted/50">
                                @* Urgency bar *@
                                <div class="@Cn.Merge("h-0.5", uc.Bar)"></div>
                                <div class="px-2.5 py-2">
                                    <div class="flex items-start gap-2">
                                        <div class="min-w-0 flex-1">
                                            <span class="line-clamp-2 text-xs font-medium">@assignment.Title</span>

                                            @* Subject tag *@
                                            <div class="mt-1">
                                                <span class="@Cn.Merge("inline-block rounded px-1 py-0.5 text-[10px] font-medium", subjectCls)">
                                                    @assignment.Subject
                                                </span>
                                            </div>

                                            @* Due date + urgency *@
                                            <div class="mt-1 flex items-center gap-1.5">
                                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", uc.Dot)"></span>
                                                <span class="@Cn.Merge("text-[10px]", uc.Text)">@assignment.UrgencyLabel</span>
                                            </div>

                                            @* Student *@
                                            <div class="mt-1 flex items-center gap-1.5">
                                                <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-muted text-[8px] font-medium">
                                                    @assignment.Initials
                                                </span>
                                                <span class="truncate text-[10px] text-muted-foreground">@assignment.Student</span>
                                            </div>
                                        </div>

                                        @* Grade badge *@
                                        @if (assignment.Grade != null && assignment.GradePercent.HasValue)
                                        {
                                            <span class="@Cn.Merge("shrink-0 rounded px-1.5 py-0.5 text-[10px] font-semibold tabular-nums", GradeColor(assignment.GradePercent.Value))">
                                                @assignment.Grade
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        @if (colAssignments.Length == 0)
                        {
                            <div class="rounded-md border border-dashed border-muted-foreground/20 px-2 py-3 text-center text-muted-foreground/40 text-xs">
                                Empty
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                4 columns · @_gradedCount of @_assignments.Length graded
            </span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span> Overdue
                </span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span> Today
                </span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span> This week
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record Assignment(string Id, string Title, string Subject, string DueDate, string Urgency, string UrgencyLabel, string Student, string Initials, string Status, string? Grade = null, int? GradePercent = null);
    private record Column(string Id, string Label);
    private record UrgencyStyle(string Dot, string Text, string Bar);
    private record TimelineDate(int Index, string Date);

    private static readonly int _todayIndex = 4;

    private static readonly TimelineDate[] _timelineDates =
    [
        new(0, "Mar 28"),
        new(1, "Mar 29"),
        new(2, "Mar 30"),
        new(3, "Mar 31"),
        new(4, "Apr 1"),
        new(5, "Apr 2"),
        new(6, "Apr 3"),
    ];

    private static readonly Column[] _columns =
    [
        new("not-started", "Not Started"),
        new("working",     "Working"),
        new("submitted",   "Submitted"),
        new("graded",      "Graded"),
    ];

    private static readonly Dictionary<string, UrgencyStyle> _urgencyConfig = new()
    {
        ["overdue"] = new("bg-red-500",             "text-red-600 dark:text-red-400",     "bg-red-500"),
        ["today"]   = new("bg-amber-500",           "text-amber-600 dark:text-amber-400", "bg-amber-500"),
        ["week"]    = new("bg-blue-500",            "text-blue-600 dark:text-blue-400",   "bg-blue-500"),
        ["future"]  = new("bg-muted-foreground/40", "text-muted-foreground",              "bg-muted-foreground/30"),
    };

    private static readonly Dictionary<string, int> _urgencyOrder = new()
    {
        ["overdue"] = 0,
        ["today"]   = 1,
        ["week"]    = 2,
        ["future"]  = 3,
    };

    private static readonly Dictionary<string, string> _subjectColor = new()
    {
        ["Math"]    = "bg-blue-500/10 text-blue-700 dark:text-blue-300",
        ["English"] = "bg-emerald-500/10 text-emerald-700 dark:text-emerald-300",
        ["Science"] = "bg-amber-500/10 text-amber-700 dark:text-amber-300",
        ["History"] = "bg-violet-500/10 text-violet-700 dark:text-violet-300",
        ["CS"]      = "bg-rose-500/10 text-rose-700 dark:text-rose-300",
    };

    private static string GradeColor(int percent)
    {
        if (percent >= 90) return "bg-emerald-500/10 text-emerald-700 dark:text-emerald-300";
        if (percent >= 80) return "bg-blue-500/10 text-blue-700 dark:text-blue-300";
        if (percent >= 70) return "bg-amber-500/10 text-amber-700 dark:text-amber-300";
        return "bg-red-500/10 text-red-700 dark:text-red-300";
    }

    private static readonly Assignment[] _assignments =
    [
        new("a1",  "Linear equations problem set",    "Math",    "Mar 28", "overdue", "2d overdue",  "Emma Wilson",   "EW", "not-started"),
        new("a2",  "Shakespeare essay draft",          "English", "Apr 1",  "today",   "Due today",   "Liam Chen",     "LC", "working"),
        new("a3",  "Chemical bonding lab report",      "Science", "Apr 1",  "today",   "Due today",   "Sofia Martinez","SM", "working"),
        new("a4",  "World War II timeline project",    "History", "Mar 30", "overdue", "1d overdue",  "Noah Park",     "NP", "submitted"),
        new("a5",  "Python sorting algorithms",        "CS",      "Apr 2",  "week",    "1 day left",  "Emma Wilson",   "EW", "working"),
        new("a6",  "Geometry proofs worksheet",        "Math",    "Apr 3",  "week",    "2 days left", "Liam Chen",     "LC", "not-started"),
        new("a7",  "Persuasive speech outline",        "English", "Apr 5",  "future",  "Apr 5",       "Sofia Martinez","SM", "not-started"),
        new("a8",  "Photosynthesis experiment",        "Science", "Apr 7",  "future",  "Apr 7",       "Noah Park",     "NP", "not-started"),
        new("a9",  "Calculus derivatives quiz",        "Math",    "Mar 29", "overdue", "Graded",      "Emma Wilson",   "EW", "graded",    "A",  95),
        new("a10", "Poetry analysis essay",            "English", "Mar 27", "overdue", "Graded",      "Liam Chen",     "LC", "graded",    "B+", 87),
        new("a11", "Periodic table quiz",              "Science", "Mar 28", "overdue", "Graded",      "Sofia Martinez","SM", "graded",    "A-", 92),
        new("a12", "Civil rights movement report",     "History", "Mar 26", "overdue", "Graded",      "Noah Park",     "NP", "graded",    "C+", 78),
        new("a13", "Binary search implementation",     "CS",      "Mar 30", "overdue", "1d overdue",  "Liam Chen",     "LC", "submitted"),
        new("a14", "Renaissance art presentation",     "History", "Apr 2",  "week",    "1 day left",  "Emma Wilson",   "EW", "working"),
    ];

    private int _overdueCount => _assignments.Count(a => a.Urgency == "overdue" && a.Status != "graded" && a.Status != "submitted");
    private int _gradedCount => _assignments.Count(a => a.Status == "graded");
}
