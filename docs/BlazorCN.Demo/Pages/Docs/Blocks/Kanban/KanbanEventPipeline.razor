@* ============================================================
   Block: kanban-event-pipeline
   Title: KanbanEventPipeline
   Description: React kanban event planning pipeline for Next.js with sidebar filters for event type, quarter, and budget, four-column board layout, and animated cards using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-event-pipeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Event Pipeline</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_filtered.Length events
                </BadgeCn>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <span>Total budget</span>
                <span class="font-medium tabular-nums text-foreground">
                    @FormatBudget(_filtered.Sum(e => e.Budget))
                </span>
            </div>
        </div>

        @* Body *@
        <div class="flex">
            @* Sidebar filters *@
            <div class="w-48 shrink-0 border-r">
                @* Event Type *@
                <div class="border-b p-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">
                        Event Type
                    </span>
                    <div class="flex flex-col gap-0.5">
                        @foreach (var t in _eventTypes)
                        {
                            var etype = t;
                            <ButtonCn Variant="@(_activeTypes.Contains(etype) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 justify-start gap-2 text-xs"
                                      OnClick="@(() => ToggleType(etype))">
                                <LucideIconCn Name="@EventTypeIconName(etype)" Size="12" Class="size-3 text-muted-foreground" />
                                @etype
                            </ButtonCn>
                        }
                    </div>
                </div>

                @* Quarter *@
                <div class="border-b p-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">Quarter</span>
                    <div class="flex flex-col gap-0.5">
                        @foreach (var q in _quarters)
                        {
                            var quarter = q;
                            <ButtonCn Variant="@(_activeQuarters.Contains(quarter) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 justify-start text-xs"
                                      OnClick="@(() => ToggleQuarter(quarter))">
                                @quarter
                            </ButtonCn>
                        }
                    </div>
                </div>

                @* Budget *@
                <div class="p-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">Budget</span>
                    <div class="flex flex-col gap-0.5">
                        @foreach (var b in _budgetTiers)
                        {
                            var budget = b;
                            <ButtonCn Variant="@(_activeBudgets.Contains(budget) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 justify-start text-xs"
                                      OnClick="@(() => ToggleBudget(budget))">
                                @budget
                            </ButtonCn>
                        }
                    </div>
                </div>
            </div>

            @* Board columns *@
            <div class="grid flex-1 grid-cols-4 divide-x">
                @foreach (var col in _columns)
                {
                    var column = col;
                    var colItems = _filtered.Where(e => e.Status == column.Id).ToArray();
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                            <span class="text-muted-foreground">
                                <LucideIconCn Name="@column.IconName" Size="14" Class="size-3.5" />
                            </span>
                            <span class="font-medium text-muted-foreground text-xs">
                                @column.Title
                            </span>
                            <span class="text-muted-foreground/60 text-xs">@colItems.Length</span>
                        </div>
                        <div class="p-2">
                            <div class="flex flex-col gap-1.5">
                                @foreach (var ev in colItems)
                                {
                                    var item = ev;
                                    <div class="rounded-md border bg-card p-2.5 transition-colors hover:bg-muted/50">
                                        <div class="mb-1.5 flex items-start gap-2">
                                            <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", EventTypeDot(item.EventType))"></span>
                                            <span class="min-w-0 flex-1 font-medium text-sm leading-tight">
                                                @item.Title
                                            </span>
                                        </div>
                                        <div class="flex items-center gap-2 pl-3.5">
                                            <span class="text-muted-foreground text-xs">@item.Quarter</span>
                                            <span class="text-muted-foreground/40">·</span>
                                            <span class="font-mono text-muted-foreground text-xs tabular-nums">
                                                @FormatBudget(item.Budget)
                                            </span>
                                            <span class="text-muted-foreground/40">·</span>
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="users" Size="12" Class="size-3" />
                                                @item.Attendees
                                            </span>
                                        </div>
                                    </div>
                                }
                                @if (colItems.Length == 0)
                                {
                                    <div class="py-8 text-center text-muted-foreground/60 text-xs">
                                        No events
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @(_filtered.Count(e => e.Status == "completed")) of @_filtered.Length completed
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 8 min ago</span>
        </div>
    </div>
</section>

@code {
    private record EventItem(
        string Id,
        string Title,
        string Status,
        string EventType,
        string Quarter,
        int Budget,
        int Attendees
    );

    private record ColumnDef(string Id, string Title, string IconName);

    private static readonly EventItem[] _events =
    [
        new("1",  "Developer Conf 2026",        "ideation",  "Conference", "Q3", 45000, 500),
        new("2",  "React Patterns Workshop",    "ideation",  "Workshop",   "Q2",  3500,  30),
        new("3",  "Product Launch Webinar",     "ideation",  "Webinar",    "Q1",  1200, 200),
        new("4",  "Design Systems Summit",      "planning",  "Conference", "Q4", 28000, 300),
        new("5",  "TypeScript Deep Dive",       "planning",  "Workshop",   "Q2",  4800,  25),
        new("6",  "Q2 Investor Update",         "planning",  "Webinar",    "Q2",   800,  50),
        new("7",  "Cloud Infrastructure Day",   "confirmed", "Conference", "Q3", 35000, 400),
        new("8",  "Accessibility Bootcamp",     "confirmed", "Workshop",   "Q1",  6200,  40),
        new("9",  "API Best Practices Talk",    "confirmed", "Webinar",    "Q1",   950, 150),
        new("10", "Startup Pitch Night",        "completed", "Conference", "Q1", 12000, 200),
        new("11", "UX Research Methods",        "completed", "Workshop",   "Q1",  3200,  20),
        new("12", "Monthly Community Call",     "completed", "Webinar",    "Q1",     0,  85),
    ];

    private static readonly ColumnDef[] _columns =
    [
        new("ideation",  "Ideation",  "lightbulb"),
        new("planning",  "Planning",  "clipboard-list"),
        new("confirmed", "Confirmed", "calendar"),
        new("completed", "Completed", "check-circle-2"),
    ];

    private static readonly string[] _eventTypes = ["Conference", "Workshop", "Webinar"];
    private static readonly string[] _quarters    = ["Q1", "Q2", "Q3", "Q4"];
    private static readonly string[] _budgetTiers = ["Under 5K", "5K-20K", "20K+"];

    private readonly HashSet<string> _activeTypes   = [];
    private readonly HashSet<string> _activeQuarters = [];
    private readonly HashSet<string> _activeBudgets  = [];

    private EventItem[] _filtered => _events.Where(ev =>
        (_activeTypes.Count == 0    || _activeTypes.Contains(ev.EventType)) &&
        (_activeQuarters.Count == 0 || _activeQuarters.Contains(ev.Quarter)) &&
        (_activeBudgets.Count == 0  || _activeBudgets.Any(tier => MatchesBudget(ev.Budget, tier)))
    ).ToArray();

    private void ToggleType(string value)
    {
        if (!_activeTypes.Add(value)) _activeTypes.Remove(value);
    }

    private void ToggleQuarter(string value)
    {
        if (!_activeQuarters.Add(value)) _activeQuarters.Remove(value);
    }

    private void ToggleBudget(string value)
    {
        if (!_activeBudgets.Add(value)) _activeBudgets.Remove(value);
    }

    private static bool MatchesBudget(int budget, string tier) => tier switch
    {
        "Under 5K" => budget < 5000,
        "5K-20K"   => budget >= 5000 && budget <= 20000,
        _          => budget > 20000,
    };

    private static string FormatBudget(int amount)
    {
        if (amount == 0) return "Free";
        if (amount >= 1000)
        {
            var k = amount / 1000.0;
            return amount % 1000 == 0 ? $"${(int)k}K" : $"${k:F1}K";
        }
        return $"${amount}";
    }

    private static string EventTypeIconName(string eventType) => eventType switch
    {
        "Conference" => "mic",
        "Workshop"   => "users",
        _            => "monitor",
    };

    private static string EventTypeDot(string eventType) => eventType switch
    {
        "Conference" => "bg-violet-500",
        "Workshop"   => "bg-emerald-500",
        _            => "bg-blue-500",
    };
}
