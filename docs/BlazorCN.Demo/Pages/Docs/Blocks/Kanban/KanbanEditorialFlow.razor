@* ============================================================
   Block: kanban-editorial-flow
   Title: KanbanEditorialFlow
   Description: React kanban board for Next.js with editorial workflow columns and a Sheet side panel showing article details, author info, SEO keywords, editor notes, and publish schedule using shadcn/ui Sheet and Tailwind CSS.
   Source: original/blocks/kanban/kanban-editorial-flow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Editorial Flow</h2>
            <span class="text-xs text-muted-foreground">@_articles.Length articles</span>
            <span class="text-xs text-muted-foreground">·</span>
            <span class="text-xs text-muted-foreground">
                @(_articles.Sum(a => a.WordCount).ToString("N0")) words total
            </span>
        </div>

        @* Kanban columns *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var col in _columns)
            {
                var column = col;
                var colArticles = _articles.Where(a => a.Stage == column.Stage).ToArray();
                <div class="min-h-[480px]">
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", StageDotClass(column.Stage))"></span>
                        <span class="text-xs font-medium">@column.Label</span>
                        <span class="ml-auto text-xs text-muted-foreground">@colArticles.Length</span>
                    </div>
                    <div class="divide-y">
                        @foreach (var art in colArticles)
                        {
                            var article = art;
                            <button type="button"
                                    class="@Cn.Merge("flex w-full flex-col gap-1 border-l-4 px-3 py-2.5 text-left transition-colors hover:bg-muted/50", StageBorderClass(article.Stage), _selectedId == article.Id ? "bg-muted/50 ring-2 ring-foreground ring-inset" : "")"
                                    @onclick="@(() => _selectedId = article.Id)">
                                <span class="line-clamp-2 text-sm font-medium leading-tight">@article.Title</span>
                                <div class="flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                        @CategoryLabel(article.Category)
                                    </BadgeCn>
                                    <span class="text-xs text-muted-foreground tabular-nums">
                                        @(article.WordCount > 0 ? $"{(article.WordCount / 1000.0):F1}K" : "--") words
                                    </span>
                                    <span class="ml-auto flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium text-muted-foreground">
                                        @article.AuthorInitials
                                    </span>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @* Sheet side panel *@
    <SheetCn Open="@(_selectedId != null)" OpenChanged="@((open) => { if (!open) _selectedId = null; })">
        <SheetContentCn Class="overflow-y-auto sm:max-w-md">
            @if (_selected != null)
            {
                var sel = _selected;
                <SheetHeaderCn>
                    <SheetTitleCn Class="text-sm font-medium leading-tight">@sel.Title</SheetTitleCn>
                    <SheetDescriptionCn>
                        <span class="flex items-center gap-2">
                            <span class="@Cn.Merge("size-1.5 rounded-full", StageDotClass(sel.Stage))"></span>
                            <span class="capitalize text-xs">@sel.Stage</span>
                            <span class="text-xs text-muted-foreground">·</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                @CategoryLabel(sel.Category)
                            </BadgeCn>
                        </span>
                    </SheetDescriptionCn>
                </SheetHeaderCn>

                @* Excerpt *@
                <div class="border-b px-4 pb-4">
                    <p class="text-sm leading-relaxed text-muted-foreground">@sel.Excerpt</p>
                </div>

                @* Author & Editor *@
                <div class="border-b px-4 py-4">
                    <div class="space-y-2.5">
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">Author</span>
                            <span class="ml-auto flex items-center gap-1.5 font-medium">
                                <span class="flex size-5 items-center justify-center rounded-full bg-muted text-[9px] text-muted-foreground">
                                    @sel.AuthorInitials
                                </span>
                                @sel.Author
                            </span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="pen-line" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">Editor</span>
                            <span class="ml-auto flex items-center gap-1.5 font-medium">
                                <span class="flex size-5 items-center justify-center rounded-full bg-muted text-[9px] text-muted-foreground">
                                    @sel.EditorInitials
                                </span>
                                @sel.Editor
                            </span>
                        </div>
                    </div>
                </div>

                @* Word count *@
                <div class="border-b px-4 py-4">
                    <span class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                        <LucideIconCn Name="file-text" Size="14" Class="size-3.5" />
                        Word Count
                    </span>
                    <div class="mt-2 space-y-2">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Current</span>
                            <span class="font-semibold tabular-nums">@sel.WordCount.ToString("N0")</span>
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Target</span>
                            <span class="font-medium tabular-nums">@sel.TargetWords.ToString("N0")</span>
                        </div>
                        <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                            <div class="@Cn.Merge("h-full rounded-full transition-all", sel.WordCount >= sel.TargetWords ? "bg-emerald-500" : "bg-foreground")"
                                 style="@($"width:{Math.Min(100, sel.TargetWords > 0 ? (int)Math.Round((double)sel.WordCount / sel.TargetWords * 100) : 0)}%")">
                            </div>
                        </div>
                    </div>
                </div>

                @* SEO Keywords *@
                <div class="border-b px-4 py-4">
                    <span class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                        <LucideIconCn Name="hash" Size="14" Class="size-3.5" />
                        SEO Keywords
                    </span>
                    <div class="mt-2 flex flex-wrap gap-1.5">
                        @foreach (var kw in sel.SeoKeywords)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">@kw</BadgeCn>
                        }
                    </div>
                </div>

                @* Publish schedule *@
                <div class="border-b px-4 py-4">
                    <span class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                        <LucideIconCn Name="calendar" Size="14" Class="size-3.5" />
                        Publish Schedule
                    </span>
                    <div class="mt-2 rounded-md bg-muted/50 p-3">
                        <span class="text-sm font-medium">@sel.PublishDate</span>
                        <span class="ml-2 text-xs text-muted-foreground">
                            @(sel.Stage == "published" ? "Published" : "Scheduled")
                        </span>
                    </div>
                </div>

                @* Editor notes *@
                <div class="px-4 py-4">
                    <span class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                        <LucideIconCn Name="message-square" Size="14" Class="size-3.5" />
                        Editor Notes
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@sel.Notes.Length</BadgeCn>
                    </span>
                    @if (sel.Notes.Length > 0)
                    {
                        <div class="mt-3 space-y-3">
                            @foreach (var note in sel.Notes)
                            {
                                var n = note;
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="flex items-center gap-2">
                                        <span class="flex size-5 items-center justify-center rounded-full bg-muted text-[9px] font-medium text-muted-foreground">
                                            @n.Initials
                                        </span>
                                        <span class="text-xs font-medium">@n.Author</span>
                                        <span class="ml-auto text-[10px] text-muted-foreground">@n.Time</span>
                                    </div>
                                    <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">@n.Note</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="mt-2 text-xs text-muted-foreground">No notes yet</p>
                    }
                </div>

                @* Actions *@
                <div class="flex gap-2 border-t px-4 py-3">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Edit article</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">Add note</ButtonCn>
                </div>
            }
        </SheetContentCn>
    </SheetCn>
</section>

@code {
    private record EditorNote(string Author, string Initials, string Note, string Time);

    private record Article(
        string Id,
        string Title,
        string Stage,
        string Author,
        string AuthorInitials,
        string Category,
        int WordCount,
        int TargetWords,
        string[] SeoKeywords,
        string PublishDate,
        string Editor,
        string EditorInitials,
        string Excerpt,
        EditorNote[] Notes
    );

    private record ColumnDef(string Stage, string Label);

    private static readonly Article[] _articles =
    [
        new("a1",  "Building Type-Safe APIs with tRPC and Zod",                          "pitch",     "Marcus Webb",   "MW", "engineering", 0,    2500, ["tRPC tutorial", "type-safe API", "Zod validation"],                              "Apr 25", "Sarah Chen",  "SC", "A practical guide to building end-to-end type-safe APIs using tRPC with Zod schema validation in a Next.js application.",                                                                                                        [new("Sarah Chen",  "SC", "Strong topic. Include a comparison with REST and GraphQL in the intro.",                                      "1 day ago")]),
        new("a2",  "Why We Switched from Microservices to a Modular Monolith",           "pitch",     "Priya Patel",   "PP", "engineering", 0,    3000, ["modular monolith", "microservices migration", "system architecture"],            "May 2",  "Sarah Chen",  "SC", "An honest post-mortem on migrating 14 microservices back to a modular monolith and the 40% reduction in operational complexity.",                                                                                                  [new("Sarah Chen",  "SC", "This will resonate. Add concrete metrics on deploy time and incident response.",                              "3 hours ago")]),
        new("a3",  "Designing Accessible Data Tables for Complex Datasets",              "pitch",     "Liam Chen",     "LC", "design",      0,    2000, ["accessible data table", "WCAG table", "React table accessibility"],              "May 8",  "James Liu",   "JL", "How to build data tables that handle sorting, filtering, and pagination while maintaining full keyboard navigation and screen reader support.",                                                                                     []),
        new("a4",  "Edge Functions: When to Use Them and When Not To",                  "writing",   "James Liu",     "JL", "engineering", 1400, 2200, ["edge functions", "serverless edge", "Vercel edge runtime"],                      "Apr 18", "Sarah Chen",  "SC", "A decision framework for choosing between edge functions, serverless functions, and traditional servers based on latency requirements, data locality, and cold start tolerance.",                                                  [new("Sarah Chen",  "SC", "Good progress. The benchmark section needs real numbers, not estimates.",                                     "6 hours ago")]),
        new("a5",  "Product-Led Growth Playbook for Developer Tools",                   "writing",   "Omar Hassan",   "OH", "marketing",   1800, 3500, ["product-led growth", "developer tools marketing", "PLG playbook"],               "Apr 22", "James Liu",   "JL", "A comprehensive framework for applying product-led growth strategies specifically to developer tools, with case studies from Linear, Vercel, and Railway.",                                                                      [new("James Liu",   "JL", "The Linear case study is excellent. Can you add a Railway section too?",                                     "2 days ago"), new("Omar Hassan", "OH", "Working on it. Railway section draft coming tomorrow.",                                               "1 day ago")]),
        new("a6",  "How We Reduced Bundle Size by 65% with Dynamic Imports",            "writing",   "Nina Okafor",   "NO", "engineering", 900,  2000, ["bundle size optimization", "dynamic imports", "code splitting React"],           "Apr 28", "Sarah Chen",  "SC", "A step-by-step walkthrough of our bundle optimization journey, including the tooling we used to analyze, split, and lazy-load 340 components.",                                                                                      []),
        new("a7",  "Design Tokens at Scale: Lessons from Rebuilding Our System",        "editing",   "Rachel Ford",   "RF", "design",      2800, 2800, ["design tokens", "design system", "token architecture"],                          "Apr 14", "James Liu",   "JL", "What we learned migrating 47 components to a token-based design system, including naming conventions, multi-theme support, and tooling integration.",                                                                                 [new("James Liu",   "JL", "Final pass. Tighten the intro paragraph and add a TLDR summary at the top.",                                  "4 hours ago"), new("Rachel Ford", "RF", "Done. Also added the token naming diagram you suggested.",                                              "2 hours ago")]),
        new("a8",  "Announcing Our Open Source Component Library",                      "editing",   "Sarah Chen",    "SC", "company",     1600, 1500, ["open source components", "React component library", "shadcn alternative"],       "Apr 12", "James Liu",   "JL", "Introducing our open source component library with 200+ production-ready React components, built on Radix primitives and Tailwind CSS.",                                                                                            [new("James Liu",   "JL", "Slightly over target word count. Cut the comparison table or move it to a follow-up post.",                   "5 hours ago")]),
        new("a9",  "Measuring Developer Experience: Metrics That Actually Matter",      "editing",   "Priya Patel",   "PP", "product",     2400, 2500, ["developer experience metrics", "DX measurement", "DORA metrics"],               "Apr 16", "Sarah Chen",  "SC", "Beyond DORA metrics: a framework for measuring developer experience that covers tooling satisfaction, cognitive load, and time-to-first-commit.",                                                                                    [new("Sarah Chen",  "SC", "Strong piece. The cognitive load section could use one more concrete example.",                               "8 hours ago")]),
        new("a10", "Server Components Changed How We Think About Data Fetching",        "published", "Marcus Webb",   "MW", "engineering", 2200, 2200, ["React Server Components", "RSC data fetching", "Next.js server components"],     "Apr 1",  "Sarah Chen",  "SC", "How adopting React Server Components eliminated 80% of our client-side data fetching code and simplified our component architecture.",                                                                                                 [new("Sarah Chen",  "SC", "Published. Strong engagement in the first 24 hours.",                                                        "1 day ago")]),
        new("a11", "The Complete Guide to Next.js Middleware",                           "published", "James Liu",     "JL", "engineering", 3200, 3000, ["Next.js middleware", "edge middleware tutorial", "middleware patterns"],          "Mar 28", "James Liu",   "JL", "Everything you need to know about Next.js middleware: authentication guards, geolocation redirects, A/B testing, and rate limiting at the edge.",                                                                                   [new("James Liu",   "JL", "Top performer this quarter. 12K organic visits in the first week.",                                           "5 days ago")]),
        new("a12", "Our Approach to Incremental Migration from REST to GraphQL",        "published", "Nina Okafor",   "NO", "engineering", 2600, 2500, ["REST to GraphQL migration", "incremental GraphQL", "API migration strategy"],    "Mar 22", "Sarah Chen",  "SC", "How we migrated 40 REST endpoints to GraphQL incrementally without a single day of downtime, using a gateway pattern and automated schema generation.",                                                                                [new("Sarah Chen",  "SC", "Published. Picked up by JavaScript Weekly newsletter.",                                                      "1 week ago")]),
    ];

    private static readonly ColumnDef[] _columns =
    [
        new("pitch",     "Pitch"),
        new("writing",   "Writing"),
        new("editing",   "Editing"),
        new("published", "Published"),
    ];

    private string? _selectedId = null;

    private Article? _selected => _selectedId != null ? _articles.FirstOrDefault(a => a.Id == _selectedId) : null;

    private static string StageDotClass(string stage) => stage switch
    {
        "pitch"     => "bg-blue-500",
        "writing"   => "bg-amber-500",
        "editing"   => "bg-violet-500",
        "published" => "bg-emerald-500",
        _           => "",
    };

    private static string StageBorderClass(string stage) => stage switch
    {
        "pitch"     => "border-l-blue-500",
        "writing"   => "border-l-amber-500",
        "editing"   => "border-l-violet-500",
        "published" => "border-l-emerald-500",
        _           => "",
    };

    private static string CategoryLabel(string category) => category switch
    {
        "engineering" => "Eng",
        "product"     => "Prod",
        "marketing"   => "Mktg",
        "design"      => "Design",
        "company"     => "Co",
        _             => category,
    };
}
