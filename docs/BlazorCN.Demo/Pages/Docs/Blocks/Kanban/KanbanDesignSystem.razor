@* ============================================================
   Block: kanban-design-system
   Title: KanbanDesignSystem
   Description: React kanban board for design system tasks with color-coded left-border category cards, 3-column layout, and a color legend bar using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-design-system.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="palette" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Design System</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_tasks.Length tasks
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span>@_tasks.Count(t => t.Status == "released") released</span>
                <span class="text-muted-foreground/60">·</span>
                <span>@_tasks.Count(t => t.Status == "building") in progress</span>
            </div>
        </div>

        @* Color Legend *@
        <div class="flex items-center gap-4 border-b bg-muted/30 px-4 py-2">
            @foreach (var cat in _categories)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", cat.DotColor)"></span>
                    @cat.Label
                </span>
            }
        </div>

        @* Columns *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var col in _columns)
            {
                var colTasks = _tasks.Where(t => t.Status == col.Id).ToArray();
                <div>
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2.5">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@col.IconName" Size="14" Class="size-3.5" />
                        </span>
                        <span class="font-medium text-muted-foreground text-xs">@col.Title</span>
                        <span class="text-muted-foreground/60 text-xs">@colTasks.Length</span>
                    </div>
                    <div class="p-2 space-y-1.5">
                        @foreach (var task in colTasks)
                        {
                            var cat = GetCategoryConfig(task.Category);
                            <div class="@Cn.Merge("rounded-md border border-l-4 bg-card px-3 py-2.5 transition-colors hover:bg-muted/50", cat.BorderColor)">
                                <div class="flex items-center gap-2">
                                    <div class="min-w-0 flex-1">
                                        <span class="block truncate font-medium text-sm">@task.Title</span>
                                        <span class="text-muted-foreground text-xs">@task.Meta</span>
                                    </div>
                                    <AvatarCn Class="size-6 shrink-0">
                                        <AvatarFallbackCn Class="text-[10px]">@task.AssigneeInitials</AvatarFallbackCn>
                                    </AvatarCn>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_tasks.Count(t => t.Status == "proposed") proposed · @_tasks.Count(t => t.Status == "building") building · @_tasks.Count(t => t.Status == "released") released
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 5 min ago</span>
        </div>
    </div>
</section>

@code {
    private record TaskItem(string Id, string Title, string Status, string Category, string Assignee, string AssigneeInitials, string Meta);
    private record CategoryConfig(string Id, string Label, string BorderColor, string DotColor);
    private record ColumnConfig(string Id, string Title, string IconName);

    private static readonly CategoryConfig[] _categories =
    [
        new("typography", "Typography", "border-l-blue-500",    "bg-blue-500"),
        new("color",      "Color",      "border-l-purple-500",  "bg-purple-500"),
        new("layout",     "Layout",     "border-l-amber-500",   "bg-amber-500"),
        new("components", "Components", "border-l-emerald-500", "bg-emerald-500"),
        new("icons",      "Icons",      "border-l-rose-500",    "bg-rose-500"),
    ];

    private static readonly ColumnConfig[] _columns =
    [
        new("proposed", "Proposed", "type"),
        new("building", "Building", "blocks"),
        new("released", "Released", "layers"),
    ];

    private static readonly TaskItem[] _tasks =
    [
        new("ds1",  "Define heading scale for marketing pages", "proposed", "typography", "Mia Torres",   "MT", "6 variants"),
        new("ds2",  "Accessible color palette for data viz",    "proposed", "color",      "Unassigned",   "??", "12 swatches"),
        new("ds3",  "Grid system documentation",                "proposed", "layout",     "Sam Lee",      "SL", "Responsive specs"),
        new("ds4",  "Icon audit for duplicate glyphs",          "proposed", "icons",      "Priya Shah",   "PS", "285 icons"),
        new("ds5",  "Build reusable modal component",           "building", "components", "Jake Dunn",    "JD", "3 sizes"),
        new("ds6",  "Implement fluid type scale",               "building", "typography", "Mia Torres",   "MT", "clamp() based"),
        new("ds7",  "Dark mode token mapping",                  "building", "color",      "Ava Kim",      "AK", "48 tokens"),
        new("ds8",  "Sidebar layout primitive",                 "building", "layout",     "Sam Lee",      "SL", "Collapsible"),
        new("ds9",  "Button component variants",                "released", "components", "Jake Dunn",    "JD", "v1.2.0"),
        new("ds10", "Brand color primitives",                   "released", "color",      "Ava Kim",      "AK", "v1.0.0"),
        new("ds11", "Icon sprite generation pipeline",          "released", "icons",      "Priya Shah",   "PS", "v2.1.0"),
        new("ds12", "Spacing scale with 4px base",              "released", "layout",     "Sam Lee",      "SL", "v1.0.0"),
    ];

    private static CategoryConfig GetCategoryConfig(string category)
        => Array.Find(_categories, c => c.Id == category) ?? _categories[0];
}
