@* ============================================================
   Block: kanban-resource-matrix
   Title: KanbanResourceMatrix
   Description: React swimlane kanban board for Next.js with resource type rows, allocation status columns, and team member chips using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-resource-matrix.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Resource Allocation</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_teamMembers.Length members
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Available
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    Assigned
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    Overloaded
                </span>
            </div>
        </div>

        @* Grid *@
        <div class="overflow-x-auto">
            @* Column headers *@
            <div class="grid grid-cols-[180px_1fr_1fr_1fr] border-b bg-muted/30">
                <div class="px-4 py-2.5">
                    <span class="font-medium text-muted-foreground text-xs">Resource Type</span>
                </div>
                @foreach (var s in _allocationStatuses)
                {
                    <div class="border-l px-4 py-2.5">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-muted-foreground text-xs">@s.Label</span>
                            <span class="font-mono text-muted-foreground/60 text-xs">@TotalByAllocation(s.Id)</span>
                        </div>
                    </div>
                }
            </div>

            @* Swimlane rows *@
            @foreach (var resType in _resourceTypes)
            {
                var typeMembers = _teamMembers.Where(m => m.Resource == resType.Id).ToArray();
                var isLast = resType.Id == _resourceTypes[_resourceTypes.Length - 1].Id;
                <div class="@Cn.Merge("grid grid-cols-[180px_1fr_1fr_1fr]", !isLast ? "border-b" : "")">
                    @* Resource type label *@
                    <div class="flex items-start gap-2.5 px-4 py-3">
                        <div class="flex size-6 shrink-0 items-center justify-center rounded bg-muted font-mono text-[10px] text-muted-foreground">
                            @resType.Code
                        </div>
                        <div class="min-w-0">
                            <span class="font-medium text-sm">@resType.Name</span>
                            <p class="text-muted-foreground text-xs">@typeMembers.Length people</p>
                        </div>
                    </div>

                    @* Allocation cells *@
                    @foreach (var s in _allocationStatuses)
                    {
                        var cellMembers = _teamMembers.Where(m => m.Resource == resType.Id && m.Allocation == s.Id).ToArray();
                        <div class="@Cn.Merge("border-l px-3 py-2.5", cellMembers.Length == 0 ? "bg-muted/20" : "")">
                            <div class="flex flex-col gap-1.5">
                                @if (cellMembers.Length == 0)
                                {
                                    <div class="rounded-md border border-dashed border-muted-foreground/20 px-2 py-1.5 text-center text-muted-foreground/40 text-xs">
                                        None
                                    </div>
                                }
                                @foreach (var member in cellMembers)
                                {
                                    <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2 py-1 transition-colors hover:bg-muted">
                                        <AvatarCn Class="size-5">
                                            <AvatarFallbackCn Class="text-[9px]">@member.Initials</AvatarFallbackCn>
                                        </AvatarCn>
                                        <span class="truncate text-xs">@member.Name</span>
                                        @if (member.Project != null)
                                        {
                                            <span class="ml-auto shrink-0 font-mono text-[10px] text-muted-foreground">@member.Project</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_resourceTypes.Length teams · @TotalByAllocation("available") available
            </span>
            @if (_overloadedCount > 0)
            {
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="triangle-alert" Size="12" Class="size-3 text-amber-500" />
                    <span class="text-muted-foreground text-xs">@_overloadedCount overloaded</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ResourceType(string Id, string Name, string Code);
    private record AllocationStatus(string Id, string Label);
    private record TeamMember(string Id, string Name, string Initials, string Resource, string Allocation, string? Project = null);

    private static readonly ResourceType[] _resourceTypes =
    [
        new("frontend", "Frontend", "FE"),
        new("backend",  "Backend",  "BE"),
        new("devops",   "DevOps",   "DO"),
        new("qa",       "QA",       "QA"),
    ];

    private static readonly AllocationStatus[] _allocationStatuses =
    [
        new("available",  "Available"),
        new("assigned",   "Assigned"),
        new("overloaded", "Overloaded"),
    ];

    private static readonly TeamMember[] _teamMembers =
    [
        new("m1",  "Anika Sharma", "AS", "frontend", "assigned",   "Atlas"),
        new("m2",  "Tom Walker",   "TW", "frontend", "available"),
        new("m3",  "Lena Kim",     "LK", "frontend", "overloaded", "3 projects"),
        new("m4",  "Diego Ruiz",   "DR", "backend",  "assigned",   "Beacon"),
        new("m5",  "Mia Chen",     "MC", "backend",  "assigned",   "Cipher"),
        new("m6",  "Raj Gupta",    "RG", "backend",  "overloaded", "4 projects"),
        new("m7",  "Eva Novak",    "EN", "devops",   "assigned",   "Platform"),
        new("m8",  "Sam Lee",      "SL", "devops",   "available"),
        new("m9",  "Olga Petrov",  "OP", "devops",   "assigned",   "Infra"),
        new("m10", "Kai Tanaka",   "KT", "qa",       "available"),
        new("m11", "Noor Ali",     "NA", "qa",       "assigned",   "Delta"),
        new("m12", "Chris Park",   "CP", "qa",       "overloaded", "5 projects"),
    ];

    private int TotalByAllocation(string allocation) =>
        _teamMembers.Count(m => m.Allocation == allocation);

    private int _overloadedCount => _teamMembers.Count(m => m.Allocation == "overloaded");
}
