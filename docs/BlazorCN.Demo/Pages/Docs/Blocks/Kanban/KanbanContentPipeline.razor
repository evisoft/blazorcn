@* ============================================================
   Block: kanban-content-pipeline
   Title: KanbanContentPipeline
   Description: React split-panel content workflow kanban for Next.js with editorial columns, article metadata, SEO scores, and category tags using shadcn/ui and Tailwind CSS.
   Source: original/blocks/kanban/kanban-content-pipeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="pen-line" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Content Pipeline</h2>
            <span class="text-xs text-muted-foreground">@_articles.Length articles</span>
            <span class="text-xs text-muted-foreground">·</span>
            <span class="text-xs text-muted-foreground">
                @(_articles.Sum(a => a.WordCount).ToString("N0")) words total
            </span>
        </div>

        @* Board + Detail *@
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr_1fr_minmax(280px,1.2fr)]">
            @* Columns *@
            @foreach (var col in _columns)
            {
                var column = col;
                var colArticles = _articles.Where(a => a.Status == column.Status).ToArray();
                var isNotLast = column.Status != "published";
                <div class="@Cn.Merge("min-h-[500px] bg-card", isNotLast ? "border-r" : "")">
                    <div class="flex items-center gap-2 border-b px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", StatusDotClass(column.Status))"></span>
                        <span class="text-xs font-medium">@column.Label</span>
                        <span class="ml-auto text-xs text-muted-foreground">@colArticles.Length</span>
                    </div>
                    <div class="divide-y">
                        @foreach (var art in colArticles)
                        {
                            var article = art;
                            <button type="button"
                                    class="@Cn.Merge("flex w-full items-center gap-2.5 px-3 py-2.5 text-left transition-colors hover:bg-muted/50", _selectedId == article.Id ? "bg-muted/50 ring-2 ring-foreground ring-inset" : "")"
                                    @onclick="@(() => _selectedId = article.Id)">
                                <span class="min-w-0 flex-1">
                                    <span class="block truncate text-sm font-medium">@article.Title</span>
                                    <span class="block text-xs text-muted-foreground">@article.Author</span>
                                </span>
                                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                    @article.Initials
                                </span>
                            </button>
                        }
                    </div>
                </div>
            }

            @* Detail Panel *@
            <div class="min-h-[500px] border-l bg-muted/20">
                @if (_selected != null)
                {
                    var sel = _selected;
                    <div>
                        <div class="border-b px-4 py-3">
                            <h3 class="text-sm font-medium">@sel.Title</h3>
                            <div class="mt-1.5 flex items-center gap-2">
                                <span class="@Cn.Merge("size-1.5 rounded-full", StatusDotClass(sel.Status))"></span>
                                <span class="text-xs text-muted-foreground capitalize">@sel.Status</span>
                            </div>
                        </div>

                        <div class="border-b px-4 py-3">
                            <div class="space-y-2.5">
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">Author</span>
                                    <span class="ml-auto font-medium">@sel.Author</span>
                                </div>
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideIconCn Name="type" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">Word count</span>
                                    <span class="ml-auto font-medium tabular-nums">@sel.WordCount.ToString("N0")</span>
                                </div>
                                <div class="flex items-center gap-2 text-xs">
                                    <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">@(sel.Status == "published" ? "Published" : "Scheduled")</span>
                                    <span class="ml-auto font-medium">@sel.PublishDate</span>
                                </div>
                            </div>
                        </div>

                        <div class="border-b px-4 py-3">
                            <div class="flex items-center justify-between">
                                <span class="flex items-center gap-2 text-xs">
                                    <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="text-muted-foreground">SEO score</span>
                                </span>
                                <span class="@Cn.Merge("text-sm font-semibold tabular-nums", SeoScoreClass(sel.SeoScore))">
                                    @sel.SeoScore
                                </span>
                            </div>
                            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                <div class="@Cn.Merge("h-full rounded-full transition-all", SeoBarClass(sel.SeoScore))"
                                     style="@($"width:{sel.SeoScore}%")">
                                </div>
                            </div>
                        </div>

                        <div class="border-b px-4 py-3">
                            <span class="text-xs font-medium text-muted-foreground">Description</span>
                            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">@sel.Description</p>
                        </div>

                        <div class="border-b px-4 py-3">
                            <span class="text-xs font-medium text-muted-foreground">Categories</span>
                            <div class="mt-1.5 flex flex-wrap gap-1.5">
                                @foreach (var cat in sel.Categories)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                        <LucideIconCn Name="tag" Size="12" Class="mr-1 size-3" />
                                        @cat
                                    </BadgeCn>
                                }
                            </div>
                        </div>

                        <div class="flex gap-2 px-4 py-3">
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Edit article</ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">Preview</ButtonCn>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex h-[500px] items-center justify-center px-4">
                        <p class="text-sm text-muted-foreground">Select an article to view details</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Article(
        string Id,
        string Title,
        string Status,
        string Author,
        string Initials,
        int WordCount,
        int SeoScore,
        string PublishDate,
        string Description,
        string[] Categories
    );

    private record ColumnDef(string Status, string Label);

    private static readonly Article[] _articles =
    [
        new("a1",  "Building Accessible Forms with React Hook Form",        "draft",     "Elena Vasquez", "EV", 1240, 45, "Apr 18", "A comprehensive guide to creating accessible form patterns using React Hook Form and ARIA attributes. Covers validation, error announcements, and keyboard navigation for complex multi-step forms.",          ["React", "Accessibility"]),
        new("a2",  "Server Components vs Client Components: When to Use Each", "draft",  "David Kim",     "DK",  890, 62, "Apr 20", "A practical decision framework for choosing between server and client components in Next.js. Includes performance benchmarks, bundle size comparisons, and real-world migration examples.",              ["Next.js", "Performance"]),
        new("a3",  "Designing Token Systems for Multi-Brand Products",      "draft",     "Sophie Laurent","SL", 2100, 38, "Apr 22", "How to architect a design token system that supports multiple brands, themes, and platforms. Walks through naming conventions, token hierarchies, and build tooling.",                                 ["Design Systems", "CSS"]),
        new("a4",  "Zero-Downtime Database Migrations in Production",       "draft",     "Marcus Obi",    "MO",  650, 55, "Apr 25", "Step-by-step strategies for running schema migrations on live databases without service interruptions. Covers expand-and-contract patterns, backward-compatible changes, and rollback plans.",  ["Database", "DevOps"]),
        new("a5",  "Optimistic UI Patterns for Real-Time Applications",     "review",    "Elena Vasquez", "EV", 3200, 78, "Apr 12", "Implementing optimistic updates with rollback strategies in React applications. Covers useOptimistic, server action integration, and conflict resolution for collaborative editing.",               ["React", "UX"]),
        new("a6",  "Edge Runtime: What It Means for Your API Routes",       "review",    "David Kim",     "DK", 2800, 82, "Apr 14", "A deep dive into edge runtime constraints and capabilities for API routes. Benchmarks cold start times, memory limits, and supported Node.js APIs across Vercel, Cloudflare, and Deno Deploy.",  ["Edge", "Infrastructure"]),
        new("a7",  "Type-Safe API Layers with tRPC and Zod",                "review",    "Sophie Laurent","SL", 2450, 71, "Apr 16", "Building end-to-end type-safe APIs using tRPC procedures with Zod schema validation. Includes patterns for error handling, middleware chains, and subscription endpoints.",                       ["TypeScript", "API"]),
        new("a8",  "The Complete Guide to CSS Container Queries",           "published", "Marcus Obi",    "MO", 4100, 92, "Mar 28", "Everything you need to know about CSS container queries, from basic syntax to advanced responsive component patterns. Includes browser support tables and progressive enhancement strategies.", ["CSS", "Responsive"]),
        new("a9",  "Streaming SSR: Architecture and Trade-offs",            "published", "Elena Vasquez", "EV", 3600, 88, "Mar 25", "How streaming server-side rendering improves Time to First Byte and Largest Contentful Paint. Covers Suspense boundaries, loading states, and selective hydration strategies.",                 ["Performance", "Next.js"]),
        new("a10", "Building a Design System Component Library from Scratch","published", "David Kim",     "DK", 5200, 95, "Mar 20", "A step-by-step guide to creating a production-ready component library with Radix primitives, Tailwind CSS, and automated visual regression testing. Covers publishing, versioning, and documentation.", ["Design Systems", "Components"]),
    ];

    private static readonly ColumnDef[] _columns =
    [
        new("draft",     "Draft"),
        new("review",    "Review"),
        new("published", "Published"),
    ];

    private string _selectedId = "a5";

    private Article? _selected => _articles.FirstOrDefault(a => a.Id == _selectedId);

    private static string StatusDotClass(string status) => status switch
    {
        "draft"     => "bg-blue-500",
        "review"    => "bg-amber-500",
        "published" => "bg-emerald-500",
        _           => "",
    };

    private static string SeoScoreClass(int score) => score >= 80
        ? "text-emerald-600 dark:text-emerald-400"
        : score >= 50
            ? "text-amber-600 dark:text-amber-400"
            : "text-red-600 dark:text-red-400";

    private static string SeoBarClass(int score) => score >= 80
        ? "bg-emerald-500"
        : score >= 50
            ? "bg-amber-500"
            : "bg-red-500";
}
