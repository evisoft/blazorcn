@* ============================================================
   Block: kanban-support-tickets
   Title: KanbanSupportTickets
   Description: React kanban support ticket tracker for Next.js with sidebar filters for priority, category, and SLA status, four-column ticket stages, and animated cards using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-support-tickets.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-alert" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Support Tickets</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_filtered.Length tickets
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                @if (_breachedCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-red-600 text-xs dark:text-red-400">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @_breachedCount SLA breached
                    </span>
                }
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_filtered.Count(t => t.SlaStatus == "On Track") on track
                </span>
            </div>
        </div>

        @* Body *@
        <div class="flex">
            @* Sidebar filters *@
            <div class="w-48 shrink-0 border-r">
                @* Priority *@
                <div class="border-b p-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">Priority</span>
                    <div class="flex flex-col gap-0.5">
                        @foreach (var p in _priorityLevels)
                        {
                            var priority = p;
                            <ButtonCn Variant="@(_activePriorities.Contains(priority) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 justify-start gap-2 text-xs"
                                      OnClick="@((MouseEventArgs e) => TogglePriority(priority))">
                                <span class="@Cn.Merge("size-1.5 rounded-full", _priorityDot.TryGetValue(priority, out var pd) ? pd : "")"></span>
                                @priority
                            </ButtonCn>
                        }
                    </div>
                </div>

                @* Category *@
                <div class="border-b p-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">Category</span>
                    <div class="flex flex-col gap-0.5">
                        @foreach (var c in _categories)
                        {
                            var cat = c;
                            <ButtonCn Variant="@(_activeCategories.Contains(cat) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 justify-start gap-2 text-xs"
                                      OnClick="@((MouseEventArgs e) => ToggleCategory(cat))">
                                @if (cat == "Billing")
                                {
                                    <LucideIconCn Name="credit-card" Size="12" Class="size-3 text-muted-foreground" />
                                }
                                else if (cat == "Technical")
                                {
                                    <LucideIconCn Name="monitor" Size="12" Class="size-3 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideIconCn Name="user" Size="12" Class="size-3 text-muted-foreground" />
                                }
                                @cat
                            </ButtonCn>
                        }
                    </div>
                </div>

                @* SLA Status *@
                <div class="p-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">SLA Status</span>
                    <div class="flex flex-col gap-0.5">
                        @foreach (var s in _slaStatuses)
                        {
                            var sla = s;
                            <ButtonCn Variant="@(_activeSla.Contains(sla) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 justify-start gap-2 text-xs"
                                      OnClick="@((MouseEventArgs e) => ToggleSla(sla))">
                                <span class="@Cn.Merge("size-1.5 rounded-full", _slaDot.TryGetValue(sla, out var sd) ? sd : "")"></span>
                                @sla
                            </ButtonCn>
                        }
                    </div>
                </div>
            </div>

            @* Board columns *@
            <div class="grid flex-1 grid-cols-4 divide-x">
                @foreach (var col in _columns)
                {
                    var column = col;
                    var colTickets = _filtered.Where(t => t.Stage == column.Id).ToArray();
                    var isClosed = column.Id == "closed";
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                            <span class="text-muted-foreground">
                                <LucideIconCn Name="@column.IconName" Size="14" Class="size-3.5" />
                            </span>
                            <span class="font-medium text-muted-foreground text-xs">@column.Title</span>
                            <span class="text-muted-foreground/60 text-xs">@colTickets.Length</span>
                        </div>
                        <div class="p-2">
                            <div class="flex flex-col gap-1.5">
                                @foreach (var ticket in colTickets)
                                {
                                    <div class="rounded-md border bg-card p-2.5 transition-colors hover:bg-muted/50">
                                        <div class="mb-1.5 flex items-start gap-2">
                                            <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", _priorityDot.TryGetValue(ticket.Priority, out var tdot) ? tdot : "")"></span>
                                            <div class="min-w-0 flex-1">
                                                <span class="@Cn.Merge("block font-medium text-sm leading-tight", isClosed ? "text-muted-foreground line-through" : "")">
                                                    @ticket.Subject
                                                </span>
                                                <span class="block font-mono text-muted-foreground text-xs">@ticket.Id</span>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-2 pl-3.5">
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                @if (ticket.Category == "Billing")
                                                {
                                                    <LucideIconCn Name="credit-card" Size="12" Class="size-3 text-muted-foreground" />
                                                }
                                                else if (ticket.Category == "Technical")
                                                {
                                                    <LucideIconCn Name="monitor" Size="12" Class="size-3 text-muted-foreground" />
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="user" Size="12" Class="size-3 text-muted-foreground" />
                                                }
                                                @ticket.Category
                                            </span>
                                            <span class="text-muted-foreground/40">·</span>
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <span class="@Cn.Merge("size-1 rounded-full", _slaDot.TryGetValue(ticket.SlaStatus, out var sladot) ? sladot : "")"></span>
                                                @ticket.OpenedAgo
                                            </span>
                                        </div>
                                    </div>
                                }
                                @if (colTickets.Length == 0)
                                {
                                    <div class="py-8 text-center text-muted-foreground/60 text-xs">
                                        No tickets
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_filtered.Count(t => t.Stage == "closed") of @_filtered.Length resolved
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 2 min ago</span>
        </div>
    </div>
</section>

@code {
    private record Ticket(
        string Id,
        string Subject,
        string Customer,
        string Stage,
        string Priority,
        string Category,
        string SlaStatus,
        string OpenedAgo
    );

    private record ColumnConfig(string Id, string Title, string IconName);

    private static readonly Dictionary<string, string> _priorityDot = new()
    {
        ["Urgent"] = "bg-red-500",
        ["High"] = "bg-amber-500",
        ["Medium"] = "bg-blue-500",
        ["Low"] = "bg-zinc-400",
    };

    private static readonly Dictionary<string, string> _slaDot = new()
    {
        ["On Track"] = "bg-emerald-500",
        ["At Risk"] = "bg-amber-500",
        ["Breached"] = "bg-red-500",
    };

    private static readonly string[] _priorityLevels = ["Urgent", "High", "Medium", "Low"];
    private static readonly string[] _categories = ["Billing", "Technical", "Account"];
    private static readonly string[] _slaStatuses = ["On Track", "At Risk", "Breached"];

    private static readonly ColumnConfig[] _columns =
    [
        new("new", "New", "inbox"),
        new("assigned", "Assigned", "circle-dot"),
        new("escalated", "Escalated", "alert-circle"),
        new("closed", "Closed", "check-circle-2"),
    ];

    private static readonly Ticket[] _tickets =
    [
        new("TK-1001", "Cannot process payment", "Sarah M.", "new", "Urgent", "Billing", "At Risk", "15 min"),
        new("TK-1002", "Dashboard loading error", "James R.", "new", "High", "Technical", "On Track", "32 min"),
        new("TK-1003", "Wrong billing amount", "Nina P.", "new", "Medium", "Billing", "On Track", "1 hr"),
        new("TK-1004", "API rate limit exceeded", "DevTeam Inc.", "assigned", "High", "Technical", "On Track", "2 hr"),
        new("TK-1005", "Account locked out", "Michael T.", "assigned", "Urgent", "Account", "At Risk", "45 min"),
        new("TK-1006", "SSO configuration issue", "Acme Corp.", "assigned", "Medium", "Technical", "On Track", "4 hr"),
        new("TK-1007", "Duplicate charges on invoice", "Laura K.", "escalated", "Urgent", "Billing", "Breached", "6 hr"),
        new("TK-1008", "Data export failing", "StartupXYZ", "escalated", "High", "Technical", "Breached", "8 hr"),
        new("TK-1009", "Team seat limit incorrect", "BigCo Ltd.", "escalated", "Medium", "Account", "At Risk", "5 hr"),
        new("TK-1010", "Webhook delivery failures", "DevShop", "closed", "High", "Technical", "On Track", "1 day"),
        new("TK-1011", "Refund request processed", "Emily S.", "closed", "Low", "Billing", "On Track", "2 days"),
        new("TK-1012", "Password reset not working", "Raj V.", "closed", "Medium", "Account", "On Track", "1 day"),
        new("TK-1013", "Custom domain SSL error", "Agency Pro", "assigned", "Low", "Technical", "On Track", "3 hr"),
    ];

    private HashSet<string> _activePriorities = [];
    private HashSet<string> _activeCategories = [];
    private HashSet<string> _activeSla = [];

    private Ticket[] _filtered => _tickets.Where(t =>
        (_activePriorities.Count == 0 || _activePriorities.Contains(t.Priority)) &&
        (_activeCategories.Count == 0 || _activeCategories.Contains(t.Category)) &&
        (_activeSla.Count == 0 || _activeSla.Contains(t.SlaStatus))
    ).ToArray();

    private int _breachedCount => _filtered.Count(t => t.SlaStatus == "Breached");

    private void TogglePriority(string value)
    {
        if (!_activePriorities.Add(value))
            _activePriorities.Remove(value);
    }

    private void ToggleCategory(string value)
    {
        if (!_activeCategories.Add(value))
            _activeCategories.Remove(value);
    }

    private void ToggleSla(string value)
    {
        if (!_activeSla.Add(value))
            _activeSla.Remove(value);
    }
}
