@* ============================================================
   Block: kanban-workflow-builder
   Title: KanbanWorkflowBuilder
   Description: React workflow automation kanban for Next.js with four stage columns, drag-and-drop step reordering using @dnd-kit, service icons, and connection indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-workflow-builder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="workflow" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Workflow Builder</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_steps.Length steps
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs">@_serviceCount services</span>
                <span class="text-muted-foreground/40">|</span>
                <span class="text-muted-foreground text-xs">@_columns.Length stages</span>
            </div>
        </div>

        @* Board *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var col in _columns)
            {
                var colIdx = Array.IndexOf(_columns, col);
                var colSteps = _steps.Where(s => s.Stage == col.Id).ToArray();
                var isLastStage = colIdx == _columns.Length - 1;
                <div class="min-w-0">
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@col.IconName" Size="14" Class="size-3.5" />
                        </span>
                        <span class="font-medium text-muted-foreground text-xs">@col.Label</span>
                        <span class="text-muted-foreground/60 text-xs">@colSteps.Length</span>
                    </div>
                    <div class="flex flex-col gap-1.5 p-2 transition-colors">
                        @foreach (var step in colSteps)
                        {
                            var stepItem = step;
                            <div class="rounded-md border bg-card p-2.5 transition-colors hover:bg-muted/50">
                                <div class="flex items-start gap-1.5">
                                    <button type="button" class="mt-0.5 shrink-0 cursor-grab touch-none text-muted-foreground/60 active:cursor-grabbing" aria-label="@($"Reorder {stepItem.Name}")">
                                        <LucideIconCn Name="grip-vertical" Size="14" Class="size-3.5" />
                                    </button>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="@TypeIconName(stepItem.Type)" Size="12" Class="size-3 text-muted-foreground" />
                                            <span class="min-w-0 flex-1 truncate font-medium text-sm">@stepItem.Name</span>
                                        </div>
                                        <div class="mt-1 flex items-center gap-2 pl-[18px]">
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                                @stepItem.Service
                                            </BadgeCn>
                                        </div>
                                    </div>
                                </div>
                                @if (!isLastStage)
                                {
                                    <div class="mt-1.5 flex justify-end pr-1">
                                        <LucideIconCn Name="chevron-right" Size="12" Class="size-3 text-muted-foreground/30" />
                                    </div>
                                }
                            </div>
                        }
                        @if (colSteps.Length == 0)
                        {
                            <div class="rounded-md border border-dashed border-muted-foreground/20 px-2 py-6 text-center text-muted-foreground/40 text-xs">
                                Drop step here
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @(_steps.Count(s => s.Stage == "complete")) of @_steps.Length steps complete
            </span>
            <span class="text-muted-foreground/60 text-xs">Drag steps between stages</span>
        </div>
    </div>
</section>

@code {
    private record WorkflowStep(string Id, string Name, string Stage, string Type, string Service);
    private record Column(string Id, string Label, string IconName);

    private static readonly WorkflowStep[] _steps =
    [
        new("w1",  "New form submission",      "trigger",   "webhook",   "Typeform"),
        new("w2",  "Stripe payment received",  "trigger",   "webhook",   "Stripe"),
        new("w3",  "Check email domain",       "condition", "filter",    "Internal"),
        new("w4",  "Validate payment amount",  "condition", "filter",    "Stripe"),
        new("w5",  "Route by plan tier",       "condition", "filter",    "Internal"),
        new("w6",  "Send welcome email",       "action",    "email",     "SendGrid"),
        new("w7",  "Create CRM contact",       "action",    "api",       "Salesforce"),
        new("w8",  "Post to Slack channel",    "action",    "notify",    "Slack"),
        new("w9",  "Update user record",       "action",    "api",       "PostgreSQL"),
        new("w10", "Log to analytics",         "complete",  "transform", "Segment"),
        new("w11", "Archive webhook payload",  "complete",  "transform", "S3"),
    ];

    private static readonly Column[] _columns =
    [
        new("trigger",   "Trigger",   "zap"),
        new("condition", "Condition", "filter"),
        new("action",    "Action",    "bolt"),
        new("complete",  "Complete",  "play"),
    ];

    private int _serviceCount => _steps.Select(s => s.Service).Distinct().Count();

    private static string TypeIconName(string type) => type switch
    {
        "webhook"   => "webhook",
        "email"     => "mail",
        "filter"    => "filter",
        "api"       => "bolt",
        "notify"    => "message-square",
        "transform" => "workflow",
        _           => "circle"
    };
}
