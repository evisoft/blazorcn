@* ============================================================
   Block: kanban-job-applications
   Title: KanbanJobApplications
   Description: React job search tracker kanban for Next.js with application stage columns, compact cards, and Dialog detail overlay showing company, role, salary, recruiter, and interview notes using shadcn/ui Dialog and Tailwind CSS.
   Source: original/blocks/kanban/kanban-job-applications.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="briefcase" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Job Applications</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_applications.Length applications
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_applications.Count(a => a.Stage == "offer") offers
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">
                    @_applications.Count(a => a.Remote) remote
                </span>
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var col in _columns)
            {
                var colStage = col.Stage;
                var colApps = _applications.Where(a => a.Stage == colStage).ToArray();
                <div>
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _stageDot.TryGetValue(colStage, out var dot) ? dot : "")"></span>
                        <span class="font-medium text-muted-foreground text-xs">@col.Label</span>
                        <span class="text-muted-foreground/60 text-xs">@colApps.Length</span>
                    </div>
                    <div>
                        @for (int i = 0; i < colApps.Length; i++)
                        {
                            var app = colApps[i];
                            var isLast = i == colApps.Length - 1;
                            <div class="@(isLast ? "" : "border-b")">
                                <button
                                    type="button"
                                    @onclick="@(() => _selectedId = app.Id)"
                                    class="flex w-full items-center gap-2.5 px-3 py-2.5 text-left transition-colors hover:bg-muted/50">
                                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", app.Remote ? "bg-emerald-500" : "bg-muted-foreground/40")"></span>
                                    <span class="min-w-0 flex-1">
                                        <span class="block truncate font-medium text-sm">@app.Company</span>
                                        <span class="block truncate text-muted-foreground text-xs">@app.Role</span>
                                    </span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_applications.Count(a => a.Stage == "interview") in interview stage
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 3 min ago</span>
        </div>
    </div>

    @* Dialog *@
    <DialogCn Open="@(_selectedId != null)" OpenChanged="@((bool v) => { if (!v) _selectedId = null; })">
        <DialogContentCn Class="max-w-md p-0">
            @{
                var selected = _applications.FirstOrDefault(a => a.Id == _selectedId);
            }
            @if (selected != null)
            {
                <DialogHeaderCn Class="border-b px-4 py-3">
                    <DialogTitleCn Class="font-medium text-sm">@selected.Role</DialogTitleCn>
                    <DialogDescriptionCn Class="flex items-center gap-2 text-xs">
                        <LucideIconCn Name="building" Size="12" Class="size-3" />
                        @selected.Company
                    </DialogDescriptionCn>
                </DialogHeaderCn>

                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-2">
                        <span class="font-semibold text-lg tabular-nums">
                            @FormatSalary(selected.SalaryMin, selected.SalaryMax)
                        </span>
                        @if (selected.Remote)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                Remote
                            </BadgeCn>
                        }
                    </div>
                    <div class="mt-1.5 flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _stageDot.TryGetValue(selected.Stage, out var selDot) ? selDot : "")"></span>
                        <span class="text-muted-foreground text-xs capitalize">
                            @(selected.Stage == "phone" ? "Phone Screen" : selected.Stage)
                        </span>
                        <span class="text-muted-foreground text-xs">·</span>
                        <span class="text-muted-foreground text-xs">Applied @selected.AppliedDate</span>
                    </div>
                </div>

                <div class="border-b px-4 py-3">
                    <div class="space-y-2.5">
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="map-pin" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">Location</span>
                            <span class="ml-auto font-medium">@selected.Location</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">Recruiter</span>
                            <span class="ml-auto font-medium">@selected.Recruiter</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="dollar-sign" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">Salary range</span>
                            <span class="ml-auto font-medium tabular-nums">
                                @FormatSalary(selected.SalaryMin, selected.SalaryMax)
                            </span>
                        </div>
                    </div>
                </div>

                @if (selected.InterviewDates.Length > 0)
                {
                    <div class="border-b px-4 py-3">
                        <span class="font-medium text-muted-foreground text-xs">Interview dates</span>
                        <div class="mt-2 space-y-1.5">
                            @foreach (var date in selected.InterviewDates)
                            {
                                <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                                    <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="font-medium text-sm">@date</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="border-b px-4 py-3">
                    <span class="font-medium text-muted-foreground text-xs">Notes</span>
                    <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">@selected.Notes</p>
                </div>

                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-2 text-xs">
                        <LucideIconCn Name="external-link" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-muted-foreground">Application</span>
                        <span class="ml-auto truncate font-mono text-muted-foreground text-xs">
                            @selected.ApplicationUrl
                        </span>
                    </div>
                </div>

                <div class="flex gap-2 px-4 py-3">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Edit
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-muted-foreground text-xs">
                        Move stage
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="ml-auto h-7 text-muted-foreground text-xs">
                        Archive
                    </ButtonCn>
                </div>
            }
        </DialogContentCn>
    </DialogCn>
</section>

@code {
