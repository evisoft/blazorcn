@* ============================================================
   Block: kanban-employee-onboarding
   Title: KanbanEmployeeOnboarding
   Description: React dual-view employee onboarding kanban for Next.js with Switch toggle between board and table views using shadcn/ui Table, Switch, and Tailwind CSS.
   Source: original/blocks/kanban/kanban-employee-onboarding.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="user-plus" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Employee Onboarding</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    @_employees.Length new hires
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-3">
                    @foreach (var col in _columnsConfig)
                    {
                        var colStatus = col.Status;
                        <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span class="@Cn.Merge("size-1.5 rounded-full", StatusDotClass(colStatus))"></span>
                            @_employees.Count(e => e.Status == colStatus)
                        </span>
                    }
                </div>
                <div class="mx-1 h-4 w-px bg-border"></div>
                <div class="flex items-center gap-2">
                    <span class="text-xs text-muted-foreground">
                        @(_isTableView ? "Table" : "Board")
                    </span>
                    <SwitchCn Size="SwitchSize.Sm" Checked="@_isTableView" CheckedChanged="@((bool v) => _isTableView = v)" />
                </div>
            </div>
        </div>

        @* Content *@
        @if (_isTableView)
        {
            <TableCn>
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-10">
                            <span class="sr-only">Status</span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Name
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Department
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Start Date
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Buddy
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                        <TableHeadCn>
                            <span class="flex items-center gap-1">
                                Progress
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var emp in _employees)
                    {
                        <TableRowCn>
                            <TableCellCn>
                                <span class="@Cn.Merge("inline-block size-2 rounded-full", StatusDotClass(emp.Status))"></span>
                            </TableCellCn>
                            <TableCellCn Class="font-medium">@emp.Name</TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@emp.Department</TableCellCn>
                            <TableCellCn Class="text-muted-foreground text-xs">@emp.StartDate</TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@emp.Buddy</TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <div class="h-1.5 w-16 overflow-hidden rounded-full bg-muted">
                                        <div class="@Cn.Merge("h-full rounded-full", ProgressColor(emp.Progress))"
                                             style="@($"width:{emp.Progress}%")"></div>
                                    </div>
                                    <span class="font-mono text-xs text-muted-foreground tabular-nums">@(emp.Progress)%</span>
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        }
        else
        {
            <div class="grid grid-cols-4 divide-x">
                @foreach (var column in _columnsConfig)
                {
                    var colStatus = column.Status;
                    var colEmployees = _employees.Where(e => e.Status == colStatus).ToArray();
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                            <span class="@Cn.Merge("size-1.5 rounded-full", StatusDotClass(colStatus))"></span>
                            <span class="text-xs font-medium text-muted-foreground">@column.Label</span>
                            <span class="text-xs text-muted-foreground/60">@colEmployees.Length</span>
                        </div>
                        <div class="p-2">
                            <div class="flex flex-col gap-1.5">
                                @foreach (var emp in colEmployees)
                                {
                                    <div class="rounded-md border bg-card p-2.5 transition-colors hover:bg-muted/50">
                                        <div class="mb-1.5 flex items-start gap-2">
                                            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                                @emp.Initials
                                            </span>
                                            <div class="min-w-0 flex-1">
                                                <span class="block text-sm font-medium leading-tight">@emp.Name</span>
                                                <span class="text-xs text-muted-foreground">@emp.Department</span>
                                            </div>
                                            @if (emp.Status == "pre-boarding")
                                            {
                                                <LucideIconCn Name="clipboard-list" Size="14" Class="size-3.5 text-zinc-400" />
                                            }
                                            else if (emp.Status == "week-1")
                                            {
                                                <LucideIconCn Name="play-circle" Size="14" Class="size-3.5 text-blue-500" />
                                            }
                                            else if (emp.Status == "training")
                                            {
                                                <LucideIconCn Name="users" Size="14" Class="size-3.5 text-amber-500" />
                                            }
                                            else if (emp.Status == "completed")
                                            {
                                                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                                            }
                                        </div>
                                        <div class="pl-8">
                                            <div class="mb-1.5 flex items-center gap-2">
                                                <span class="text-xs text-muted-foreground">Start: @emp.StartDate</span>
                                                <span class="text-muted-foreground/40">·</span>
                                                <span class="text-xs text-muted-foreground">Buddy: @emp.Buddy</span>
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                                                    <div class="@Cn.Merge("h-full rounded-full", ProgressColor(emp.Progress))"
                                                         style="@($"width:{emp.Progress}%")"></div>
                                                </div>
                                                <span class="font-mono text-[10px] text-muted-foreground tabular-nums">@(emp.Progress)%</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (colEmployees.Length == 0)
                                {
                                    <div class="py-8 text-center text-xs text-muted-foreground/60">
                                        No employees
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @(_employees.Count(e => e.Status == "completed")) of @_employees.Length onboarding completed
            </span>
            <span class="text-xs text-muted-foreground/60">Updated 5 min ago</span>
        </div>
    </div>
</section>

@code {
    private record Employee(string Id, string Name, string Initials, string Status, string Department, string StartDate, string Buddy, int Progress);
    private record ColumnConfig(string Status, string Label);

    private static readonly Employee[] _employees =
    [
        new("e1",  "Rachel Kim",     "RK", "pre-boarding", "Engineering", "Apr 7",  "Tom H.",   10),
        new("e2",  "David Chen",     "DC", "pre-boarding", "Design",      "Apr 7",  "Lisa M.",  15),
        new("e3",  "Maria Santos",   "MS", "pre-boarding", "Marketing",   "Apr 14", "Jake R.",   5),
        new("e4",  "James Wilson",   "JW", "week-1",       "Engineering", "Mar 31", "Sarah L.", 35),
        new("e5",  "Anika Patel",    "AP", "week-1",       "Sales",       "Mar 31", "Mike D.",  40),
        new("e6",  "Lucas Berg",     "LB", "week-1",       "Product",     "Mar 31", "Emma W.",  30),
        new("e7",  "Yuki Tanaka",    "YT", "training",     "Engineering", "Mar 17", "Alex P.",  70),
        new("e8",  "Omar Hassan",    "OH", "training",     "Engineering", "Mar 17", "Nina S.",  75),
        new("e9",  "Sophie Laurent", "SL", "training",     "Design",      "Mar 17", "Chris T.", 65),
        new("e10", "Carlos Rivera",  "CR", "completed",    "Sales",       "Mar 3",  "Jen K.",  100),
        new("e11", "Emily Foster",   "EF", "completed",    "Engineering", "Mar 3",  "Dan M.",  100),
    ];

    private static readonly ColumnConfig[] _columnsConfig =
    [
        new("pre-boarding", "Pre-boarding"),
        new("week-1",       "Week 1"),
        new("training",     "Training"),
        new("completed",    "Completed"),
    ];

    private bool _isTableView = false;

    private static string StatusDotClass(string status) => status switch
    {
        "pre-boarding" => "bg-zinc-400",
        "week-1"       => "bg-blue-500",
        "training"     => "bg-amber-500",
        "completed"    => "bg-emerald-500",
        _              => ""
    };

    private static string ProgressColor(int pct)
    {
        if (pct >= 100) return "bg-emerald-500";
        if (pct >= 60)  return "bg-amber-500";
        if (pct >= 30)  return "bg-blue-500";
        return "bg-zinc-400";
    }
}
