@* ============================================================
   Block: kanban-contract-lifecycle
   Title: KanbanContractLifecycle
   Description: React contract management kanban for Next.js with lifecycle stage columns, compact cards, and Dialog detail overlay showing parties, value, dates, renewal terms, and key clauses using shadcn/ui Dialog and Tailwind CSS.
   Source: original/blocks/kanban/kanban-contract-lifecycle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Contracts</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_contracts.Length contracts
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs">
                    @FormatCurrency(_activeValue) active value
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_contracts.Count(c => c.Stage == "negotiation") in negotiation
                </span>
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var col in _columns)
            {
                var colStage = col.Stage;
                var colContracts = _contracts.Where(c => c.Stage == colStage).ToArray();
                <div>
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _stageDot.TryGetValue(colStage, out var dot) ? dot : "")"></span>
                        <span class="font-medium text-muted-foreground text-xs">@col.Label</span>
                        <span class="text-muted-foreground/60 text-xs">@colContracts.Length</span>
                    </div>
                    <div>
                        @for (int i = 0; i < colContracts.Length; i++)
                        {
                            var contract = colContracts[i];
                            var isLast = i == colContracts.Length - 1;
                            <div class="@(isLast ? "" : "border-b")">
                                <button
                                    type="button"
                                    @onclick="@(() => _selectedId = contract.Id)"
                                    class="flex w-full items-center gap-2.5 px-3 py-2.5 text-left transition-colors hover:bg-muted/50">
                                    <span class="min-w-0 flex-1">
                                        <span class="block truncate font-medium text-sm">@contract.Title</span>
                                        <span class="block text-muted-foreground text-xs">
                                            @contract.Type@(contract.Value > 0 ? $" · {FormatCurrency(contract.Value)}" : "")
                                        </span>
                                    </span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_contracts.Count(c => c.Stage == "expired") expired
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 30 min ago</span>
        </div>
    </div>

    @* Dialog *@
    <DialogCn Open="@(_selectedId != null)" OpenChanged="@((bool v) => { if (!v) _selectedId = null; })">
        <DialogContentCn Class="max-w-md p-0">
            @{
                var selected = _contracts.FirstOrDefault(c => c.Id == _selectedId);
            }
            @if (selected != null)
            {
                <DialogHeaderCn Class="border-b px-4 py-3">
                    <DialogTitleCn Class="font-medium text-sm">@selected.Title</DialogTitleCn>
                    <DialogDescriptionCn Class="flex items-center gap-2 text-xs">
                        <LucideIconCn Name="scale" Size="12" Class="size-3" />
                        @selected.Type agreement
                    </DialogDescriptionCn>
                </DialogHeaderCn>

                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-2">
                        @if (selected.Value > 0)
                        {
                            <span class="font-semibold text-2xl tabular-nums">@FormatCurrency(selected.Value)</span>
                        }
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @selected.Type
                        </BadgeCn>
                    </div>
                    <div class="mt-1.5 flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _stageDot.TryGetValue(selected.Stage, out var selDot) ? selDot : "")"></span>
                        <span class="text-muted-foreground text-xs capitalize">@selected.Stage</span>
                    </div>
                </div>

                <div class="border-b px-4 py-3">
                    <div class="space-y-2.5">
                        <div class="flex items-start gap-2 text-xs">
                            <LucideIconCn Name="users" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                            <span class="text-muted-foreground">Parties</span>
                            <span class="ml-auto text-right font-medium">@string.Join(" & ", selected.Parties)</span>
                        </div>
                        @if (selected.Value > 0)
                        {
                            <div class="flex items-center gap-2 text-xs">
                                <LucideIconCn Name="dollar-sign" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="text-muted-foreground">Value</span>
                                <span class="ml-auto font-medium tabular-nums">@FormatCurrency(selected.Value)</span>
                            </div>
                        }
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">Start</span>
                            <span class="ml-auto font-medium">@selected.StartDate</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">End</span>
                            <span class="ml-auto font-medium">@selected.EndDate</span>
                        </div>
                        <div class="flex items-start gap-2 text-xs">
                            <LucideIconCn Name="refresh-cw" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                            <span class="shrink-0 text-muted-foreground">Renewal</span>
                            <span class="ml-auto text-right font-medium">@selected.RenewalTerms</span>
                        </div>
                    </div>
                </div>

                <div class="border-b px-4 py-3">
                    <span class="font-medium text-muted-foreground text-xs">Key clauses</span>
                    <div class="mt-2 rounded-md bg-muted/50 p-3">
                        <ul class="space-y-1.5">
                            @foreach (var clause in selected.KeyClauses)
                            {
                                <li class="flex items-start gap-2 text-sm leading-relaxed">
                                    <span class="mt-2 size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                    @clause
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="border-b px-4 py-3">
                    <span class="font-medium text-muted-foreground text-xs">Notes</span>
                    <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">@selected.Notes</p>
                </div>

                <div class="flex gap-2 px-4 py-3">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Edit contract
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-muted-foreground text-xs">
                        Move stage
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="ml-auto h-7 text-muted-foreground text-xs">
                        Archive
                    </ButtonCn>
                </div>
            }
        </DialogContentCn>
    </DialogCn>
</section>

@code {
