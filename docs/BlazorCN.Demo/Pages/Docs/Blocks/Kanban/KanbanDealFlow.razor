@* ============================================================
   Block: kanban-deal-flow
   Title: KanbanDealFlow
   Description: React investment deal tracking kanban for Next.js with ultra-compact cards, HoverCard detail popups showing sector, valuation, lead partner, key terms, and timeline using shadcn/ui HoverCard and Tailwind CSS.
   Source: original/blocks/kanban/kanban-deal-flow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="handshake" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Deal Flow</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_deals.Length deals
                </BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs">Hover to preview</span>
        </div>

        @* Columns *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var col in _columns)
            {
                var colStage = col.Stage;
                var colDeals = System.Array.FindAll(_deals, d => d.Stage == colStage);
                <div>
                    @* Column Header *@
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", col.Dot)"></span>
                        <span class="font-medium text-xs">@col.Label</span>
                        <span class="ml-auto font-mono text-[10px] text-muted-foreground/60 tabular-nums">
                            @colDeals.Length
                        </span>
                    </div>

                    @* Cards *@
                    <div>
                        @for (int i = 0; i < colDeals.Length; i++)
                        {
                            var deal = colDeals[i];
                            var idx = i;
                            var colLen = colDeals.Length;
                            <HoverCardCn OpenDelay="200" CloseDelay="100">
                                <HoverCardTriggerCn Class="block w-full">
                                    <div class="@Cn.Merge("flex w-full cursor-default items-center gap-2 px-3 py-2 text-left transition-colors hover:bg-muted/50", idx < colLen - 1 ? "border-b" : "")">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full opacity-40", col.Dot)"></span>
                                        <span class="min-w-0 flex-1 truncate text-xs">@deal.Name</span>
                                    </div>
                                </HoverCardTriggerCn>
                                <HoverCardContentCn Side="FloatingSide.Right" Align="FloatingAlign.Start" Class="w-72 p-0">
                                    <div class="border-b px-3 py-2.5">
                                        <div class="flex items-center gap-2">
                                            <span class="min-w-0 flex-1 font-medium text-sm">@deal.Name</span>
                                        </div>
                                        <div class="mt-0.5 flex items-center gap-1.5">
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                                                @deal.Type
                                            </BadgeCn>
                                            <span class="text-[10px] text-muted-foreground">@deal.Sector</span>
                                        </div>
                                    </div>
                                    <div class="space-y-2 px-3 py-2.5">
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Valuation</span>
                                            <span class="font-medium tabular-nums">@deal.Valuation</span>
                                        </div>
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Lead partner</span>
                                            <span class="font-medium">@deal.LeadPartner</span>
                                        </div>
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-muted-foreground">Timeline</span>
                                            <span class="font-medium">@deal.Timeline</span>
                                        </div>
                                    </div>
                                    <div class="border-t bg-muted/30 px-3 py-2">
                                        <span class="text-muted-foreground text-xs">Key terms</span>
                                        <p class="mt-0.5 text-xs leading-relaxed">@deal.KeyTerms</p>
                                    </div>
                                </HoverCardContentCn>
                            </HoverCardCn>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @System.Array.FindAll(_deals, d => d.Stage == "negotiating").Length in negotiation
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 15 min ago</span>
        </div>
    </div>
</section>

@code {
    private record Deal(
        string Id,
        string Name,
        string Stage,
        string Sector,
        string Valuation,
        string LeadPartner,
        string KeyTerms,
        string Timeline,
        string Type
    );

    private record Column(string Stage, string Label, string Dot);

    private static readonly Column[] _columns =
    [
