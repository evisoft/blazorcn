@* ============================================================
   Block: kanban-impact-effort
   Title: KanbanImpactEffort
   Description: React impact-effort 2x2 prioritization matrix for Next.js with quick wins, major projects, fill-ins, and time sinks quadrants using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-impact-effort.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="target" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Impact vs Effort</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_features.Length features
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var q in _quadrants)
                {
                    var qId = q.Id;
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", q.Dot)"></span>
                        @GetCount(qId)
                    </span>
                }
            </div>
        </div>

        @* Axis labels *@
        <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">
                Low Effort &rarr; High Effort
            </span>
            <span class="font-medium text-muted-foreground text-xs">&uarr; High Impact</span>
        </div>

        @* 2x2 Grid *@
        <div class="grid grid-cols-2">
            @for (var qIndex = 0; qIndex < _quadrants.Length; qIndex++)
            {
                var q = _quadrants[qIndex];
                var qFeatures = _features.Where(f => f.Quadrant == q.Id).ToArray();
                var isTop = qIndex < 2;
                var isLeft = qIndex % 2 == 0;
                <div class="@Cn.Merge("min-h-[180px] p-3", q.Bg, isLeft ? "border-r" : "", isTop ? "border-b" : "")">
                    @* Quadrant label *@
                    <div class="mb-2.5 flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", q.Dot)"></span>
                        <span class="font-medium text-sm">@q.Label</span>
                        <span class="text-muted-foreground text-xs">@q.Description</span>
                    </div>

                    @* Feature chips *@
                    <div class="flex flex-col gap-1">
                        @foreach (var feature in qFeatures)
                        {
                            <div class="flex items-center gap-2 rounded-md bg-card/80 px-2.5 py-1.5 transition-colors hover:bg-card">
                                <span class="min-w-0 flex-1 truncate text-xs">@feature.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-[10px] px-1.5 py-0">
                                    @feature.Type
                                </BadgeCn>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                4 quadrants · @_features.Length features
            </span>
            <span class="text-muted-foreground text-xs">
                <span class="inline-flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @GetCount("quick-wins") quick wins
                </span>
            </span>
        </div>
    </div>
</section>

@code {
    private record QuadrantConfig(string Id, string Label, string Description, string Bg, string Dot);
    private record FeatureItem(string Id, string Title, string Type, string Quadrant);

    private static readonly QuadrantConfig[] _quadrants =
    [
        new("quick-wins",     "Quick Wins",     "High Impact + Low Effort",  "bg-emerald-500/5", "bg-emerald-500"),
        new("major-projects", "Major Projects", "High Impact + High Effort", "bg-blue-500/5",    "bg-blue-500"),
        new("fill-ins",       "Fill-ins",       "Low Impact + Low Effort",   "bg-amber-500/5",   "bg-amber-500"),
        new("time-sinks",     "Time Sinks",     "Low Impact + High Effort",  "bg-red-500/5",     "bg-red-500"),
    ];

    private static readonly FeatureItem[] _features =
    [
        new("f1",  "Add dark mode toggle to settings",       "UX",        "quick-wins"),
        new("f2",  "Enable CSV export on all tables",        "Feature",   "quick-wins"),
        new("f3",  "Auto-save draft forms on blur",          "UX",        "quick-wins"),
        new("f4",  "Add keyboard shortcuts overlay",         "DX",        "quick-wins"),
        new("f5",  "Real-time collaborative editing",        "Feature",   "major-projects"),
        new("f6",  "Multi-tenant workspace isolation",       "Infra",     "major-projects"),
        new("f7",  "AI-powered search and suggestions",      "AI",        "major-projects"),
        new("f8",  "Custom reporting dashboard builder",     "Feature",   "major-projects"),
        new("f9",  "Update empty state illustrations",       "Design",    "fill-ins"),
        new("f10", "Add tooltips to toolbar icons",          "UX",        "fill-ins"),
        new("f11", "Improve loading skeleton fidelity",      "UX",        "fill-ins"),
        new("f12", "Full audit log with replay viewer",      "Compliance","time-sinks"),
        new("f13", "Custom email template WYSIWYG editor",   "Feature",   "time-sinks"),
        new("f14", "Legacy API v1 backward compatibility",   "Infra",     "time-sinks"),
    ];

    private int GetCount(string quadrant) => _features.Count(f => f.Quadrant == quadrant);
}
