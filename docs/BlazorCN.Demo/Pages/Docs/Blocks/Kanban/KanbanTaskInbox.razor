@* ============================================================
   Block: kanban-task-inbox
   Title: KanbanTaskInbox
   Description: React kanban task inbox for Next.js with circle checkbox icons, strikethrough on completed items, staggered entrance animations, and compact list layout using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-task-inbox.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Task Inbox</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_tasks.Length tasks
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_tasks.Count(t => t.Priority == "high")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_tasks.Count(t => t.Priority == "medium")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_tasks.Count(t => t.Priority == "low")
                </span>
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var col in _columns)
            {
                var colTasks = _tasks.Where(t => t.Status == col.Id).ToArray();
                var isDone = col.Id == "done";
                <div>
                    @* Column header *@
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2.5">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@col.IconName" Size="14" Class="size-3.5" />
                        </span>
                        <span class="font-medium text-muted-foreground text-xs">@col.Title</span>
                        <span class="text-muted-foreground/60 text-xs">@colTasks.Length</span>
                    </div>

                    @* Tasks *@
                    <div>
                        @for (var i = 0; i < colTasks.Length; i++)
                        {
                            var task = colTasks[i];
                            var isLast = i == colTasks.Length - 1;
                            <div class="@Cn.Merge("flex items-center gap-2.5 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                                @* Checkbox icon *@
                                @if (task.Status == "done")
                                {
                                    <LucideIconCn Name="circle-check" Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else if (task.Status == "today")
                                {
                                    <LucideIconCn Name="circle-dot" Size="16" Class="size-4 text-foreground" />
                                }
                                else
                                {
                                    <LucideIconCn Name="circle" Size="16" Class="size-4 text-muted-foreground/60" />
                                }
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", PriorityDotClass(task.Priority))"></span>
                                <span class="@Cn.Merge("min-w-0 flex-1 truncate text-sm", isDone ? "text-muted-foreground line-through" : "font-medium")">
                                    @task.Title
                                </span>
                                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                    @task.Assignee
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_tasks.Count(t => t.Status == "done") of @_tasks.Length completed
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 3 min ago</span>
        </div>
    </div>
</section>

@code {
    private record TaskItem(string Id, string Title, string Status, string Assignee, string Priority);
    private record ColumnItem(string Id, string Title, string IconName);

    private static readonly TaskItem[] _tasks =
    [
        new("1",  "Reply to Sarah's contract email",    "inbox", "JD", "high"),
        new("2",  "Review Q2 budget spreadsheet",       "inbox", "JD", "medium"),
        new("3",  "Schedule dentist appointment",       "inbox", "JD", "low"),
        new("4",  "Read API migration proposal",        "inbox", "JD", "medium"),
        new("5",  "Call insurance about claim",         "today", "JD", "high"),
        new("6",  "Prepare slide deck for standup",     "today", "JD", "high"),
        new("7",  "Update project timeline in Notion",  "today", "JD", "medium"),
        new("8",  "Send invoice to Acme Corp",          "today", "JD", "medium"),
        new("9",  "Submitted expense report",           "done",  "JD", "low"),
        new("10", "Booked flight to Denver",            "done",  "JD", "medium"),
        new("11", "Finished onboarding checklist",      "done",  "JD", "low"),
        new("12", "Merged auth hotfix PR",              "done",  "JD", "high"),
    ];

    private static readonly ColumnItem[] _columns =
    [
        new("inbox", "Inbox", "inbox"),
        new("today", "Today", "sun"),
        new("done",  "Done",  "check-circle-2"),
    ];

    private static string PriorityDotClass(string priority) => priority switch
    {
        "high"   => "bg-red-500",
        "medium" => "bg-amber-500",
        _        => "bg-blue-500",
    };
}
