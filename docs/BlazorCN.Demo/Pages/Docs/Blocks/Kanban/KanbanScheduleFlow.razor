@* ============================================================
   Block: kanban-schedule-flow
   Title: KanbanScheduleFlow
   Description: React scheduling workflow kanban board for Next.js with timeline header, urgency indicators, and attendee tracking using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-schedule-flow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Schedule Flow</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_events.Length events
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                    @_totalAttendees attendees
                </span>
                <span class="text-muted-foreground text-xs">@_confirmedCount confirmed</span>
            </div>
        </div>

        @* Timeline header *@
        <div class="border-b bg-muted/30 px-4 py-2.5">
            <div class="flex items-center">
                @foreach (var td in _timelineDates)
                {
                    var i = td.Index;
                    var date = td.Label;
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <span class="@Cn.Merge("font-mono text-[10px]", i == _todayIndex ? "font-semibold text-foreground" : i < _todayIndex ? "text-muted-foreground/60" : "text-muted-foreground")">
                            @date
                        </span>
                        <span class="@Cn.Merge("size-1.5 rounded-full", i == _todayIndex ? "bg-foreground" : i < _todayIndex ? "bg-muted-foreground/30" : "bg-muted-foreground/20")"></span>
                    </div>
                }
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-4">
            @foreach (var col in _columns)
            {
                var colIndex = Array.IndexOf(_columns, col);
                var colEvents = _events.Where(e => e.Status == col.Id).OrderBy(e => UrgencyOrder(e.Urgency)).ToArray();
                var isLast = colIndex == _columns.Length - 1;
                <div class="@Cn.Merge(!isLast ? "border-r" : "")">
                    @* Column header *@
                    <div class="flex items-center gap-2 border-b px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", StatusDotClass(col.Id))"></span>
                        <span class="font-medium text-xs">@col.Label</span>
                        <span class="ml-auto font-mono text-muted-foreground/60 text-xs">@colEvents.Length</span>
                    </div>

                    @* Cards *@
                    <div class="flex flex-col gap-1 p-2">
                        @foreach (var evt in colEvents)
                        {
                            var dotClass = UrgencyDotClass(evt.Urgency);
                            var textClass = UrgencyTextClass(evt.Urgency);
                            var barClass = UrgencyBarClass(evt.Urgency);
                            <div class="overflow-hidden rounded-md transition-colors hover:bg-muted/50">
                                @* Urgency bar *@
                                <div class="@Cn.Merge("h-0.5", barClass)"></div>

                                <div class="px-2.5 py-2">
                                    <span class="line-clamp-2 text-xs font-medium">@evt.Name</span>

                                    @* Urgency label *@
                                    <div class="mt-1 flex items-center gap-1.5">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dotClass)"></span>
                                        <span class="@Cn.Merge("text-[10px]", textClass)">@evt.UrgencyLabel</span>
                                    </div>

                                    @* Date + time *@
                                    <div class="mt-1 flex items-center gap-1 text-muted-foreground">
                                        <LucideIconCn Name="clock" Size="10" Class="size-2.5" />
                                        <span class="text-[10px]">@evt.Date · @evt.DateTime</span>
                                    </div>

                                    @* Location *@
                                    <div class="mt-0.5 flex items-center gap-1 text-muted-foreground">
                                        <LucideIconCn Name="map-pin" Size="10" Class="size-2.5" />
                                        <span class="truncate text-[10px]">@evt.Location</span>
                                    </div>

                                    @* Attendees *@
                                    <div class="mt-1 flex items-center gap-1 text-muted-foreground">
                                        <LucideIconCn Name="users" Size="10" Class="size-2.5" />
                                        <span class="text-[10px]">@evt.Attendees attendees</span>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (colEvents.Length == 0)
                        {
                            <div class="rounded-md border border-dashed border-muted-foreground/20 px-2 py-3 text-center text-muted-foreground/40 text-xs">
                                Empty
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                4 stages · @(_events.Count(e => e.Status == "completed")) of @_events.Length completed
            </span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span> Overdue
                </span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span> Today
                </span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span> This week
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record ScheduleEvent(string Id, string Name, string DateTime, string Date, string Location, int Attendees, string Urgency, string UrgencyLabel, string Status);
    private record Column(string Id, string Label);
    private record TimelineDate(int Index, string Label);

    private static readonly string[] _rawTimelineDates = ["Mar 28", "Mar 29", "Mar 30", "Mar 31", "Apr 1", "Apr 2", "Apr 3"];
    private static readonly int _todayIndex = 4;

    private static readonly TimelineDate[] _timelineDates =
    [
        new(0, "Mar 28"),
        new(1, "Mar 29"),
        new(2, "Mar 30"),
        new(3, "Mar 31"),
        new(4, "Apr 1"),
        new(5, "Apr 2"),
        new(6, "Apr 3"),
    ];

    private static readonly Column[] _columns =
    [
        new("requested", "Requested"),
        new("tentative",  "Tentative"),
        new("confirmed",  "Confirmed"),
        new("completed",  "Completed"),
    ];

    private static readonly ScheduleEvent[] _events =
    [
        new("e1",  "Q2 planning offsite",          "9:00 AM",  "Apr 1",  "Main conference room", 12, "today",  "Today",       "confirmed"),
        new("e2",  "Design review sync",           "2:00 PM",  "Apr 1",  "Room 204",              5, "today",  "Today",       "confirmed"),
        new("e3",  "Client demo presentation",     "10:30 AM", "Apr 2",  "Zoom",                  8, "week",   "1 day left",  "tentative"),
        new("e4",  "Investor board meeting",       "3:00 PM",  "Apr 3",  "Boardroom A",          15, "week",   "2 days left", "tentative"),
        new("e5",  "Engineering all-hands",        "11:00 AM", "Apr 3",  "Auditorium",           45, "week",   "2 days left", "requested"),
        new("e6",  "Product launch rehearsal",     "1:00 PM",  "Apr 5",  "Studio B",             10, "future", "Apr 5",       "requested"),
        new("e7",  "Team building workshop",       "9:30 AM",  "Apr 8",  "Off-site venue",       30, "future", "Apr 8",       "requested"),
        new("e8",  "Sprint retrospective",         "4:00 PM",  "Mar 28", "Room 101",              8, "overdue","Completed",   "completed"),
        new("e9",  "Sales pipeline review",        "10:00 AM", "Mar 29", "Zoom",                  6, "overdue","Completed",   "completed"),
        new("e10", "Security audit kickoff",       "2:30 PM",  "Mar 30", "Room 305",              4, "overdue","Completed",   "completed"),
        new("e11", "Vendor contract negotiation",  "11:00 AM", "Mar 30", "Room 202",              3, "overdue","Overdue",     "tentative"),
    ];

    private int _confirmedCount => _events.Count(e => e.Status == "confirmed");
    private int _totalAttendees => _events.Where(e => e.Status != "completed").Sum(e => e.Attendees);

    private static int UrgencyOrder(string urgency) => urgency switch
    {
        "overdue" => 0,
        "today"   => 1,
        "week"    => 2,
        "future"  => 3,
        _         => 99,
    };

    private static string UrgencyDotClass(string urgency) => urgency switch
    {
        "overdue" => "bg-red-500",
        "today"   => "bg-amber-500",
        "week"    => "bg-blue-500",
        "future"  => "bg-muted-foreground/40",
        _         => "",
    };

    private static string UrgencyTextClass(string urgency) => urgency switch
    {
        "overdue" => "text-red-600 dark:text-red-400",
        "today"   => "text-amber-600 dark:text-amber-400",
        "week"    => "text-blue-600 dark:text-blue-400",
        "future"  => "text-muted-foreground",
        _         => "",
    };

    private static string UrgencyBarClass(string urgency) => urgency switch
    {
        "overdue" => "bg-red-500",
        "today"   => "bg-amber-500",
        "week"    => "bg-blue-500",
        "future"  => "bg-muted-foreground/30",
        _         => "",
    };

    private static string StatusDotClass(string status) => status switch
    {
        "requested" => "bg-blue-500",
        "tentative" => "bg-amber-500",
        "confirmed" => "bg-emerald-500",
        "completed" => "bg-muted-foreground/40",
        _           => "",
    };
}
