@* ============================================================
   Block: kanban-shopping-tracker
   Title: KanbanShoppingTracker
   Description: React kanban shopping wishlist tracker for Next.js with tab navigation, price display, store labels, category badges, and staggered card animations using shadcn/ui Tabs and Tailwind CSS
   Source: original/blocks/kanban/kanban-shopping-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Shopping Tracker</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_products.Length items
                </BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs">
                Cart:&nbsp;<span class="font-medium tabular-nums text-foreground">$@_cartTotal.ToString("F2")</span>
            </span>
        </div>

        @* Tabs *@
        <div class="px-4 py-3">
            <TabsCn DefaultValue="wishlist">
                <TabsListCn Class="w-full">
                    @foreach (var col in _columns)
                    {
                        var count = GetCount(col.Id);
                        <TabsTriggerCn Value="@col.Id" Class="h-8 gap-1.5 text-xs">
                            <LucideIconCn Name="@col.IconName" Size="14" Class="size-3.5" />
                            @col.Label
                            <span class="text-muted-foreground/60 text-[10px]">@count</span>
                        </TabsTriggerCn>
                    }
                </TabsListCn>

                @foreach (var col in _columns)
                {
                    var columnProducts = _products.Where(p => p.Status == col.Id).ToArray();
                    var isPurchased = col.Id == "purchased";
                    <TabsContentCn Value="@col.Id" Class="mt-0">
                        <div class="mt-3 overflow-hidden rounded-md border">
                            @for (var idx = 0; idx < columnProducts.Length; idx++)
                            {
                                var product = columnProducts[idx];
                                var isLast = idx == columnProducts.Length - 1;
                                var purchased = isPurchased;
                                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="@Cn.Merge("truncate text-sm", purchased ? "text-muted-foreground line-through" : "font-medium")">
                                                @product.Name
                                            </span>
                                        </div>
                                        <p class="mt-0.5 text-muted-foreground text-xs">@product.Store</p>
                                    </div>
                                    <div class="flex shrink-0 items-center gap-2">
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-normal text-[10px]", CategoryColor(product.Category))">
                                            @product.Category
                                        </BadgeCn>
                                        <span class="font-medium text-sm tabular-nums">@product.Price</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </TabsContentCn>
                }
            </TabsCn>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @GetCount("purchased") of @_products.Length purchased
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 1 hour ago</span>
        </div>
    </div>
</section>

@code {
    private record Product(string Id, string Name, string Price, string Store, string Category, string Status);
    private record ColumnDef(string Id, string Label, string IconName);

    private static readonly Product[] _products =
    [
        new("1",  "Sony WH-1000XM5 Headphones",   "$348.00",  "Amazon",    "Electronics", "wishlist"),
        new("2",  "Wool Overcoat — Charcoal",       "$189.00",  "Uniqlo",    "Clothing",    "wishlist"),
        new("3",  "Ceramic Pour-Over Set",          "$42.00",   "MoMA Store","Home",        "wishlist"),
        new("4",  "Running Shoes — React Infinity", "$160.00",  "Nike",      "Clothing",    "wishlist"),
        new("5",  "Mechanical Keyboard — HHKB Pro", "$275.00",  "Amazon",    "Electronics", "in-cart"),
        new("6",  "Linen Bedsheet Set — Queen",     "$129.00",  "Brooklinen","Home",        "in-cart"),
        new("7",  "Portable SSD — 2TB",             "$89.99",   "Best Buy",  "Electronics", "in-cart"),
        new("8",  "Cast Iron Skillet — 12 inch",    "$34.95",   "Lodge",     "Home",        "purchased"),
        new("9",  "Merino Wool Hoodie",             "$128.00",  "Outlier",   "Clothing",    "purchased"),
        new("10", "USB-C Hub — 7-port",             "$49.99",   "Anker",     "Electronics", "purchased"),
        new("11", "Desk Lamp — LED Architect",      "$67.00",   "IKEA",      "Home",        "purchased"),
    ];

    private static readonly ColumnDef[] _columns =
    [
        new("wishlist",  "Wishlist",  "heart"),
        new("in-cart",   "In Cart",   "shopping-cart"),
        new("purchased", "Purchased", "package-check"),
    ];

    private double _cartTotal => _products
        .Where(p => p.Status == "in-cart")
        .Sum(p => double.Parse(p.Price.Replace("$", "").Replace(",", "")));

    private int GetCount(string status) => _products.Count(p => p.Status == status);

    private static string CategoryColor(string category) => category switch
    {
        "Electronics" => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        "Clothing"    => "bg-violet-500/10 text-violet-700 dark:text-violet-400",
        "Home"        => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        _             => "",
    };
}
