@* ============================================================
   Block: kanban-eisenhower-matrix
   Title: KanbanEisenhowerMatrix
   Description: React Eisenhower urgent-important 2x2 matrix grid for Next.js with quadrant zones, task chips, and framer-motion entrance animations using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-eisenhower-matrix.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="grid" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Eisenhower Matrix</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_tasks.Length tasks
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var q in _quadrants)
                {
                    var qId = q.Id;
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", q.Dot)"></span>
                        @GetCount(qId)
                    </span>
                }
            </div>
        </div>

        @* Axis labels *@
        <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Urgent &rarr;</span>
            <span class="font-medium text-muted-foreground text-xs">&uarr; Important</span>
        </div>

        @* 2x2 Grid *@
        <div class="grid grid-cols-2">
            @for (var qIndex = 0; qIndex < _quadrants.Length; qIndex++)
            {
                var q = _quadrants[qIndex];
                var qTasks = _tasks.Where(t => t.Quadrant == q.Id).ToArray();
                var isTop = qIndex < 2;
                var isLeft = qIndex % 2 == 0;
                <div class="@Cn.Merge("min-h-[180px] p-3", q.Bg, isLeft ? "border-r" : "", isTop ? "border-b" : "")">
                    @* Quadrant label *@
                    <div class="mb-2.5 flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", q.Dot)"></span>
                        <span class="font-medium text-sm">@q.Label</span>
                        <span class="text-muted-foreground text-xs">@q.Description</span>
                    </div>

                    @* Task chips *@
                    <div class="flex flex-col gap-1">
                        @foreach (var task in qTasks)
                        {
                            <div class="flex items-center gap-2 rounded-md bg-card/80 px-2.5 py-1.5 transition-colors hover:bg-card">
                                <span class="min-w-0 flex-1 truncate text-xs">@task.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-[10px] px-1.5 py-0">
                                    @task.Tag
                                </BadgeCn>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                4 quadrants · @GetCount("do-first") urgent
            </span>
            <span class="font-mono text-muted-foreground/60 text-xs">
                @GetCount("eliminate") to eliminate
            </span>
        </div>
    </div>
</section>

@code {
    private record QuadrantConfig(string Id, string Label, string Description, string Bg, string Dot);
    private record TaskItem(string Id, string Title, string Tag, string Quadrant);

    private static readonly QuadrantConfig[] _quadrants =
    [
        new("do-first",  "Do First",  "Urgent + Important",         "bg-red-500/5",     "bg-red-500"),
        new("schedule",  "Schedule",  "Not Urgent + Important",     "bg-blue-500/5",    "bg-blue-500"),
        new("delegate",  "Delegate",  "Urgent + Not Important",     "bg-amber-500/5",   "bg-amber-500"),
        new("eliminate", "Eliminate", "Not Urgent + Not Important", "bg-emerald-500/5", "bg-emerald-500"),
    ];

    private static readonly TaskItem[] _tasks =
    [
        new("t1",  "Fix production outage on payments",  "P0",       "do-first"),
        new("t2",  "Resolve customer data breach alert", "Security", "do-first"),
        new("t3",  "Patch critical auth vulnerability",  "P0",       "do-first"),
        new("t4",  "Submit compliance audit by Friday",  "Legal",    "do-first"),
        new("t5",  "Design new onboarding flow",         "Product",  "schedule"),
        new("t6",  "Write Q2 OKR proposals",             "Strategy", "schedule"),
        new("t7",  "Plan database migration to v2",      "Infra",    "schedule"),
        new("t8",  "Research AI integration options",    "R&D",      "schedule"),
        new("t9",  "Update meeting room calendar",       "Admin",    "delegate"),
        new("t10", "Process expense reports batch",      "Finance",  "delegate"),
        new("t11", "Schedule vendor demo calls",         "Sales",    "delegate"),
        new("t12", "Order new team laptops",             "IT",       "delegate"),
        new("t13", "Reorganize shared drive folders",    "Admin",    "eliminate"),
        new("t14", "Attend optional all-hands recap",    "Meeting",  "eliminate"),
        new("t15", "Review outdated wiki pages",         "Docs",     "eliminate"),
        new("t16", "Clean up unused Slack channels",     "Admin",    "eliminate"),
    ];

    private int GetCount(string quadrant) => _tasks.Count(t => t.Quadrant == quadrant);
}
