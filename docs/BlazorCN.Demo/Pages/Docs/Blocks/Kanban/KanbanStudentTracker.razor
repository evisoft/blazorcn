@* ============================================================
   Block: kanban-student-tracker
   Title: KanbanStudentTracker
   Description: React dual-view student progress tracker kanban for Next.js with Switch toggle between board and table views using shadcn/ui Table, Switch, and Tailwind CSS.
   Source: original/blocks/kanban/kanban-student-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="graduation-cap" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Student Tracker</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    @_students.Length students
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-3">
                    @foreach (var col in _columnsConfig)
                    {
                        var colCount = _students.Count(s => s.Status == col.Status);
                        <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span class="@Cn.Merge("size-1.5 rounded-full", StatusDotClass(col.Status))"></span>
                            @colCount
                        </span>
                    }
                </div>
                <div class="mx-1 h-4 w-px bg-border"></div>
                <div class="flex items-center gap-2">
                    <span class="text-xs text-muted-foreground">
                        @(_isTableView ? "Table" : "Board")
                    </span>
                    <SwitchCn Checked="@_isTableView" CheckedChanged="@((bool v) => _isTableView = v)" />
                </div>
            </div>
        </div>

        @* Content *@
        @if (_isTableView)
        {
            @* Table View *@
            <table class="w-full caption-bottom text-sm">
                <thead class="[&_tr]:border-b">
                    <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
                        <th class="h-10 w-10 px-2 text-left align-middle font-medium text-muted-foreground">
                            <span class="sr-only">Status</span>
                        </th>
                        <th class="h-10 px-2 text-left align-middle font-medium text-muted-foreground">
                            <span class="flex items-center gap-1">
                                Student Name
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </th>
                        <th class="h-10 px-2 text-left align-middle font-medium text-muted-foreground">
                            <span class="flex items-center gap-1">
                                Program
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </th>
                        <th class="h-10 px-2 text-left align-middle font-medium text-muted-foreground">
                            <span class="flex items-center gap-1">
                                GPA
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </th>
                        <th class="h-10 px-2 text-left align-middle font-medium text-muted-foreground">
                            <span class="flex items-center gap-1">
                                Advisor
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </th>
                        <th class="h-10 px-2 text-left align-middle font-medium text-muted-foreground">
                            <span class="flex items-center gap-1">
                                Expected Grad
                                <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3 text-muted-foreground/60" />
                            </span>
                        </th>
                    </tr>
                </thead>
                <tbody class="[&_tr:last-child]:border-0">
                    @foreach (var student in _students)
                    {
                        <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
                            <td class="p-2 align-middle">
                                <span class="@Cn.Merge("inline-block size-2 rounded-full", StatusDotClass(student.Status))"></span>
                            </td>
                            <td class="p-2 align-middle font-medium">@student.Name</td>
                            <td class="p-2 align-middle text-muted-foreground">@student.Program</td>
                            <td class="p-2 align-middle">
                                <span class="@Cn.Merge("font-mono text-xs font-medium", GpaDotClass(student.Gpa))">
                                    @student.Gpa
                                </span>
                            </td>
                            <td class="p-2 align-middle text-muted-foreground">@student.Advisor</td>
                            <td class="p-2 align-middle text-muted-foreground text-xs">@student.ExpectedGrad</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            @* Board View *@
            <div class="grid grid-cols-4 divide-x">
                @foreach (var column in _columnsConfig)
                {
                    var colStudents = _students.Where(s => s.Status == column.Status).ToArray();
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                            <span class="@Cn.Merge("size-1.5 rounded-full", StatusDotClass(column.Status))"></span>
                            <span class="text-xs font-medium text-muted-foreground">@column.Label</span>
                            <span class="text-xs text-muted-foreground/60">@colStudents.Length</span>
                        </div>
                        <div class="p-2">
                            <div class="flex flex-col gap-1.5">
                                @foreach (var student in colStudents)
                                {
                                    <div class="rounded-md border bg-card p-2.5 transition-colors hover:bg-muted/50">
                                        <div class="mb-1.5 flex items-start gap-2">
                                            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                                @student.Initials
                                            </span>
                                            <div class="min-w-0 flex-1">
                                                <span class="block text-sm font-medium leading-tight">@student.Name</span>
                                                <span class="text-xs text-muted-foreground">@student.Program</span>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-2 pl-8">
                                            <span class="@Cn.Merge("font-mono text-xs font-medium", GpaDotClass(student.Gpa))">
                                                @student.Gpa
                                            </span>
                                            <span class="text-muted-foreground/40">·</span>
                                            <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                                <LucideIconCn Name="user" Size="12" Class="size-3" />
                                                @student.Advisor
                                            </span>
                                            <span class="text-muted-foreground/40">·</span>
                                            <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                                <LucideIconCn Name="book-open" Size="12" Class="size-3" />
                                                @student.ExpectedGrad
                                            </span>
                                        </div>
                                    </div>
                                }
                                @if (colStudents.Length == 0)
                                {
                                    <div class="py-8 text-center text-xs text-muted-foreground/60">
                                        No students
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @(_students.Count(s => s.Status == "graduated")) graduated this term
            </span>
            <span class="text-xs text-muted-foreground/60">Updated 12 min ago</span>
        </div>
    </div>
</section>

@code {
    private record Student(string Id, string Name, string Initials, string Status, string Program, string Gpa, string Advisor, string ExpectedGrad);
    private record ColumnConfig(string Status, string Label);

    private static readonly Student[] _students =
    [
        new("s1",  "Alex Thompson",   "AT", "enrolled",    "Computer Science", "3.8", "Dr. Kim",   "May 2027"),
        new("s2",  "Priya Sharma",    "PS", "enrolled",    "Data Science",     "3.6", "Dr. Lee",   "Dec 2027"),
        new("s3",  "Jordan Martinez", "JM", "enrolled",    "Cybersecurity",    "3.4", "Dr. Patel", "May 2028"),
        new("s4",  "Sophie Chen",     "SC", "in-progress", "Computer Science", "3.9", "Dr. Kim",   "May 2026"),
        new("s5",  "Marcus Johnson",  "MJ", "in-progress", "Data Science",     "3.5", "Dr. Lee",   "Dec 2026"),
        new("s6",  "Emma Williams",   "EW", "in-progress", "UX Design",        "3.7", "Dr. Novak", "May 2026"),
        new("s7",  "Kai Nakamura",    "KN", "completing",  "Computer Science", "3.6", "Dr. Kim",   "May 2026"),
        new("s8",  "Olivia Brown",    "OB", "completing",  "Data Science",     "3.8", "Dr. Lee",   "May 2026"),
        new("s9",  "Liam O'Brien",    "LO", "completing",  "Cybersecurity",    "3.3", "Dr. Patel", "May 2026"),
        new("s10", "Aisha Patel",     "AP", "graduated",   "Computer Science", "3.9", "Dr. Kim",   "Dec 2025"),
        new("s11", "Noah Garcia",     "NG", "graduated",   "UX Design",        "3.7", "Dr. Novak", "Dec 2025"),
        new("s12", "Fatima Al-Rashid","FA", "graduated",   "Data Science",     "4.0", "Dr. Lee",   "Dec 2025"),
    ];

    private static readonly ColumnConfig[] _columnsConfig =
    [
        new("enrolled",    "Enrolled"),
        new("in-progress", "In Progress"),
        new("completing",  "Completing"),
        new("graduated",   "Graduated"),
    ];

    private bool _isTableView = false;

    private static string StatusDotClass(string status) => status switch
    {
        "enrolled"    => "bg-blue-500",
        "in-progress" => "bg-amber-500",
        "completing"  => "bg-purple-500",
        "graduated"   => "bg-emerald-500",
        _             => ""
    };

    private static string GpaDotClass(string gpa)
    {
        var val = double.Parse(gpa, System.Globalization.CultureInfo.InvariantCulture);
        if (val >= 3.8) return "text-emerald-500";
        if (val >= 3.5) return "text-blue-500";
        if (val >= 3.0) return "text-amber-500";
        return "text-red-500";
    }
}
