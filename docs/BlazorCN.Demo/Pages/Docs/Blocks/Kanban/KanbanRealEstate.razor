        new("p6", "215 Pine Street Unit 4B", "Portland, OR", "showing", 340000, 1100, 2, 1,
            "Lisa Chen", "LC", "Condo", 2019, [],
            "Modern finishes, in-unit laundry. Parking included. Two serious buyers after open house."),
        new("p7", "4200 Ridgewood Ave", "Nashville, TN", "offer", 475000, 2600, 4, 3,
