@* ============================================================
   Block: kanban-real-estate
   Title: KanbanRealEstate
   Description: React property listings kanban for Next.js with stage columns, compact cards, and Dialog detail overlay showing address, price, specs, agent info, and offer history using shadcn/ui Dialog and Tailwind CSS.
   Source: original/blocks/kanban/kanban-real-estate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="home" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Property Pipeline</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_properties.Length listings
                </BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs">
                @FormatCurrency(_properties.Sum(p => p.Price)) total value
            </span>
        </div>

        @* Columns *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var col in _columns)
            {
                var colStage = col.Stage;
                var colProperties = _properties.Where(p => p.Stage == colStage).ToArray();
                <div>
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _stageDot.TryGetValue(colStage, out var dot) ? dot : "")"></span>
                        <span class="font-medium text-muted-foreground text-xs">@col.Label</span>
                        <span class="text-muted-foreground/60 text-xs">@colProperties.Length</span>
                    </div>
                    <div>
                        @for (int i = 0; i < colProperties.Length; i++)
                        {
                            var property = colProperties[i];
                            var isLast = i == colProperties.Length - 1;
                            <div class="@(isLast ? "" : "border-b")">
                                <button
                                    type="button"
                                    @onclick="@(() => _selectedId = property.Id)"
                                    class="flex w-full items-center gap-2.5 px-3 py-2.5 text-left transition-colors hover:bg-muted/50">
                                    <span class="min-w-0 flex-1">
                                        <span class="block truncate font-medium text-sm">@property.Address</span>
                                        <span class="block text-muted-foreground text-xs tabular-nums">
                                            @FormatCurrency(property.Price)
                                        </span>
                                    </span>
                                    <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                        @property.AgentInitials
                                    </span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_properties.Count(p => p.Stage == "offer") pending offers
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 10 min ago</span>
        </div>
    </div>

    @* Dialog *@
    <DialogCn Open="@(_selectedId != null)" OpenChanged="@((bool v) => { if (!v) _selectedId = null; })">
        <DialogContentCn Class="max-w-md p-0">
            @{
                var selected = _properties.FirstOrDefault(p => p.Id == _selectedId);
            }
            @if (selected != null)
            {
                <DialogHeaderCn Class="border-b px-4 py-3">
                    <DialogTitleCn Class="font-medium text-sm">@selected.Address</DialogTitleCn>
                    <DialogDescriptionCn Class="flex items-center gap-2 text-xs">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        @selected.City
                    </DialogDescriptionCn>
                </DialogHeaderCn>

                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-2">
                        <span class="font-semibold text-2xl tabular-nums">
                            @FormatCurrency(selected.Price)
                        </span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @selected.Type
                        </BadgeCn>
                    </div>
                    <div class="mt-1.5 flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _stageDot.TryGetValue(selected.Stage, out var selDot) ? selDot : "")"></span>
                        <span class="text-muted-foreground text-xs capitalize">@selected.Stage</span>
                        <span class="text-muted-foreground text-xs">·</span>
                        <span class="text-muted-foreground text-xs">Built @selected.YearBuilt</span>
                    </div>
                </div>

                <div class="border-b px-4 py-3">
                    <div class="space-y-2.5">
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="ruler" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">Sq. Ft.</span>
                            <span class="ml-auto font-medium tabular-nums">
                                @selected.Sqft.ToString("N0")
                            </span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="bed-double" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">Bedrooms</span>
                            <span class="ml-auto font-medium tabular-nums">@selected.Bedrooms</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="bath" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">Bathrooms</span>
                            <span class="ml-auto font-medium tabular-nums">@selected.Bathrooms</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">Listing agent</span>
                            <span class="ml-auto font-medium">@selected.Agent</span>
                        </div>
                    </div>
                </div>

                @if (selected.Offers.Length > 0)
                {
                    <div class="border-b px-4 py-3">
                        <span class="font-medium text-muted-foreground text-xs">
                            Offers (@(selected.Offers.Length))
                        </span>
                        <div class="mt-2 space-y-2">
                            @foreach (var offer in selected.Offers)
                            {
                                <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                                    <LucideIconCn Name="dollar-sign" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="min-w-0 flex-1">
                                        <span class="block font-medium text-sm tabular-nums">
                                            @FormatCurrency(offer.Amount)
                                        </span>
                                        <span class="block text-muted-foreground text-xs">@offer.Buyer</span>
                                    </span>
                                    <span class="shrink-0 text-muted-foreground text-xs">@offer.Date</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="border-b px-4 py-3">
                    <span class="font-medium text-muted-foreground text-xs">Notes</span>
                    <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">
                        @selected.Notes
                    </p>
                </div>

                <div class="flex gap-2 px-4 py-3">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Edit listing
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-muted-foreground text-xs">
                        Move stage
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="ml-auto h-7 text-muted-foreground text-xs">
                        Archive
                    </ButtonCn>
                </div>
            }
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private string? _selectedId = null;

    private record Offer(string Buyer, int Amount, string Date);

    private record Property(
        string Id,
        string Address,
        string City,
        string Stage,
        int Price,
        int Sqft,
        int Bedrooms,
        int Bathrooms,
        string Agent,
        string AgentInitials,
        string Type,
        int YearBuilt,
        Offer[] Offers,
        string Notes
    );

    private record Column(string Stage, string Label);

    private static readonly Dictionary<string, string> _stageDot = new()
    {
        ["new"]     = "bg-blue-500",
        ["showing"] = "bg-amber-500",
