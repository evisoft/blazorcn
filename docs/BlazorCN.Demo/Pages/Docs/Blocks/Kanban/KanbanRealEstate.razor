        new("p3", "88 Harbor View Lane", "San Diego, CA", "new", 1250000, 2800, 3, 3,
            "Lisa Chen", "LC", "Condo", 2020, [],
            "Ocean views from primary suite. Building has concierge service and rooftop deck."),
        new("p4", "320 Maple Court", "Denver, CO", "showing", 395000, 1800, 3, 2,
