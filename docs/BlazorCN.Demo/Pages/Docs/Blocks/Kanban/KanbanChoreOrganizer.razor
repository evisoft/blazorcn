@* ============================================================
   Block: kanban-chore-organizer
   Title: KanbanChoreOrganizer
   Description: React kanban household chore organizer for Next.js with vertical accordion columns, room labels, frequency badges, and assignee avatars using shadcn/ui Accordion and Tailwind CSS
   Source: original/blocks/kanban/kanban-chore-organizer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Chore Board</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_chores.Length chores
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var col in _columns)
                {
                    var colCount = _chores.Count(c => c.Status == col.Id);
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", col.Dot)"></span>
                        @colCount
                    </span>
                }
            </div>
        </div>

        @* Accordion columns *@
        <div class="px-4 py-3">
            <AccordionCn>
                @foreach (var col in _columns)
                {
                    var columnChores = _chores.Where(c => c.Status == col.Id).ToArray();
                    var isDone = col.Id == "done";
                    var isDefault = col.Id == "todo";
                    <AccordionItemCn DefaultOpen="@isDefault">
                        <AccordionTriggerCn Class="py-3 hover:no-underline">
                            <div class="flex items-center gap-2">
                                <span class="text-muted-foreground">
                                    <LucideIconCn Name="@col.Icon" Size="14" Class="size-3.5" />
                                </span>
                                <span class="font-medium text-sm">@col.Label</span>
                                <span class="text-muted-foreground/60 text-xs">@columnChores.Length</span>
                            </div>
                        </AccordionTriggerCn>
                        <AccordionContentCn Class="pb-2">
                            <div class="overflow-hidden rounded-md border">
                                @for (var i = 0; i < columnChores.Length; i++)
                                {
                                    var chore = columnChores[i];
                                    var isLast = i == columnChores.Length - 1;
                                    var dotClass = col.Dot;
                                    var titleClass = isDone ? "text-muted-foreground line-through" : "font-medium";
                                    var freqColor = FrequencyColor(chore.Frequency);
                                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dotClass)"></span>
                                        <div class="min-w-0 flex-1">
                                            <span class="@Cn.Merge("block truncate text-sm", titleClass)">@chore.Title</span>
                                            <span class="text-muted-foreground/60 text-xs">@chore.Room</span>
                                        </div>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("shrink-0 font-normal text-[10px]", freqColor)">
                                            @chore.Frequency
                                        </BadgeCn>
                                        <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                            @chore.Assignee
                                        </span>
                                    </div>
                                }
                            </div>
                        </AccordionContentCn>
                    </AccordionItemCn>
                }
            </AccordionCn>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @(_chores.Count(c => c.Status == "done")) of @_chores.Length done
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 15 min ago</span>
        </div>
    </div>
</section>

@code {
    private record Chore(string Id, string Title, string Status, string Room, string Frequency, string Assignee);
    private record Column(string Id, string Label, string Icon, string Dot);

    private static readonly Chore[] _chores =
    [
        new("1",  "Vacuum living room carpet",   "todo",  "Living Room", "Weekly",  "AJ"),
        new("2",  "Wipe kitchen counters",        "todo",  "Kitchen",     "Daily",   "MK"),
        new("3",  "Take out recycling bins",      "todo",  "Garage",      "Weekly",  "AJ"),
        new("4",  "Clean bathroom mirrors",       "todo",  "Bathroom",    "Weekly",  "SL"),
        new("5",  "Water indoor plants",          "todo",  "Living Room", "Weekly",  "MK"),
        new("6",  "Mop kitchen floor",            "doing", "Kitchen",     "Weekly",  "AJ"),
        new("7",  "Sort mail and shred junk",     "doing", "Office",      "Daily",   "SL"),
        new("8",  "Load dishwasher",              "doing", "Kitchen",     "Daily",   "MK"),
        new("9",  "Scrub shower tiles",           "doing", "Bathroom",    "Monthly", "AJ"),
        new("10", "Empty all trash cans",         "done",  "Whole House", "Weekly",  "SL"),
        new("11", "Fold and put away laundry",    "done",  "Bedroom",     "Weekly",  "MK"),
        new("12", "Dust bookshelves",             "done",  "Living Room", "Monthly", "AJ"),
        new("13", "Wipe stovetop and oven",       "done",  "Kitchen",     "Weekly",  "SL"),
        new("14", "Organize pantry shelves",      "done",  "Kitchen",     "Monthly", "MK"),
    ];

    private static readonly Column[] _columns =
    [
        new("todo",  "To Do", "circle",       "bg-zinc-400"),
        new("doing", "Doing", "loader",       "bg-amber-500"),
        new("done",  "Done",  "circle-check", "bg-emerald-500"),
    ];

    private static string FrequencyColor(string frequency) => frequency switch
    {
        "Daily"   => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        "Weekly"  => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        "Monthly" => "bg-violet-500/10 text-violet-700 dark:text-violet-400",
        _         => ""
    };
}
