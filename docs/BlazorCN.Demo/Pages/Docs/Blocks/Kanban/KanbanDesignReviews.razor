@* ============================================================
   Block: kanban-design-reviews
   Title: KanbanDesignReviews
   Description: React kanban design review pipeline for Next.js with expandable inline cards showing reviewer comments, revision counts, and approval checklists using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-design-reviews.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="palette" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Design Reviews</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_designs.Length submissions
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                    @_designs.Sum(d => d.RevisionCount) revisions
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">
                    @_designs.Count(d => d.Status == "approved") approved
                </span>
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var col in _columns)
            {
                var colId = col.Id;
                var columnDesigns = _designs.Where(d => d.Status == colId).ToArray();
                <div>
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2.5">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@col.IconName" Size="14" Class="size-3.5" />
                        </span>
                        <span class="font-medium text-muted-foreground text-xs">@col.Title</span>
                        <span class="text-muted-foreground/60 text-xs">@columnDesigns.Length</span>
                    </div>

                    <div>
                        @for (int i = 0; i < columnDesigns.Length; i++)
                        {
                            var design = columnDesigns[i];
                            var isLast = i == columnDesigns.Length - 1;
                            var isExpanded = _expanded == design.Id;
                            var designId = design.Id;
                            var checklistDone = design.Checklist.Count(c => c.Checked);
                            <div class="@(isLast ? "" : "border-b")">
                                <button
                                    type="button"
                                    @onclick="@(() => ToggleExpanded(designId))"
                                    class="flex w-full items-center gap-2.5 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                                    <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                        @design.DesignerInitials
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <span class="block truncate font-medium text-sm">@design.Title</span>
                                        <span class="text-muted-foreground text-xs">
                                            @(design.RevisionCount > 0 ? $"v{design.RevisionCount + 1}" : "v1") · @checklistDone/@design.Checklist.Length
                                        </span>
                                    </div>
                                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="px-4 pb-4">
                                        <p class="mb-3 text-muted-foreground text-sm leading-relaxed">@design.Description</p>

                                        @* Designer + Reviewer *@
                                        <div class="mb-3 flex items-center gap-3">
                                            <div class="flex items-center gap-1.5">
                                                <span class="font-medium text-muted-foreground text-xs">Designer</span>
                                                <span class="text-xs">@design.Designer</span>
                                            </div>
                                            <span class="text-muted-foreground text-xs">·</span>
                                            <div class="flex items-center gap-1.5">
                                                <span class="font-medium text-muted-foreground text-xs">Reviewer</span>
                                                <span class="text-xs">@design.Reviewer</span>
                                            </div>
                                            @if (design.RevisionCount > 0)
                                            {
                                                <span class="text-muted-foreground text-xs">·</span>
                                                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                                                    @design.RevisionCount @(design.RevisionCount == 1 ? "revision" : "revisions")
                                                </span>
                                            }
                                        </div>

                                        @* Reviewer comment *@
                                        @if (!string.IsNullOrEmpty(design.ReviewerComment))
                                        {
                                            <div class="mb-3 rounded-md bg-muted/50 p-3">
                                                <div class="mb-1.5 flex items-center gap-1.5">
                                                    <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium text-muted-foreground">
                                                        @design.ReviewerInitials
                                                    </span>
                                                    <span class="font-medium text-muted-foreground text-xs">Reviewer feedback</span>
                                                </div>
                                                <p class="text-sm leading-relaxed">@design.ReviewerComment</p>
                                            </div>
                                        }

                                        @* Checklist *@
                                        <div>
                                            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                                Approval checklist · @checklistDone/@design.Checklist.Length
                                            </span>
                                            <div class="space-y-1">
                                                @foreach (var item in design.Checklist)
                                                {
                                                    <div class="flex items-center gap-2">
                                                        @if (item.Checked)
                                                        {
                                                            <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                                                        }
                                                        else
                                                        {
                                                            <LucideIconCn Name="circle" Size="14" Class="size-3.5 text-muted-foreground/40" />
                                                        }
                                                        <span class="@Cn.Merge("text-xs", item.Checked ? "text-muted-foreground" : "")">
                                                            @item.Label
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_designs.Count(d => d.Status == "in-review") pending review
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 8 min ago</span>
        </div>
    </div>
</section>

@code {
