    private record ChecklistItem(string Label, bool Checked);

    private record DesignSubmission(
        string Id,
        string Title,
        string Status,
        string Designer,
        string DesignerInitials,
        string Reviewer,
        string ReviewerInitials,
        string Description,
        int RevisionCount,
        string ReviewerComment,
        ChecklistItem[] Checklist
    );

    private record ColumnConfig(string Id, string Title, string IconName);

    private static readonly ColumnConfig[] _columns =
    [
