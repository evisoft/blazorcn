@* ============================================================
   Block: kanban-style-audit
   Title: KanbanStyleAudit
   Description: React kanban board for style consistency audits with color-coded left-border cards by finding type, 3-column workflow using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-style-audit.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Style Audit</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_findings.Length findings
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span>@_findings.Count(f => f.Status == "verified") verified</span>
                <span class="text-muted-foreground/60">·</span>
                <span>@_findings.Count(f => f.Status == "found") open</span>
            </div>
        </div>

        @* Color Legend *@
        <div class="flex items-center gap-4 border-b bg-muted/30 px-4 py-2">
            @foreach (var cat in _categories)
            {
                var c = cat;
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", c.DotColor)"></span>
                    @c.Label
                </span>
            }
        </div>

        @* Columns *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var col in _columns)
            {
                var column = col;
                var columnFindings = _findings.Where(f => f.Status == column.Id).ToArray();
                <div>
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2.5">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@column.Icon" Size="14" Class="size-3.5" />
                        </span>
                        <span class="font-medium text-muted-foreground text-xs">@column.Title</span>
                        <span class="text-muted-foreground/60 text-xs">@columnFindings.Length</span>
                    </div>

                    <div class="p-2 space-y-1.5">
                        @foreach (var finding in columnFindings)
                        {
                            var f = finding;
                            var catConfig = GetCategoryConfig(f.Category);
                            <div class="@Cn.Merge("rounded-md border border-l-4 bg-card px-3 py-2.5 transition-colors hover:bg-muted/50", catConfig.BorderColor)">
                                <div class="flex items-center gap-2">
                                    <div class="min-w-0 flex-1">
                                        <span class="block truncate font-medium text-sm">@f.Title</span>
                                        <span class="text-muted-foreground text-xs">@f.Meta</span>
                                    </div>
                                    <AvatarCn Class="size-6 shrink-0">
                                        <AvatarFallbackCn Class="text-[10px]">@f.AssigneeInitials</AvatarFallbackCn>
                                    </AvatarCn>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_findings.Count(f => f.Status == "found") found · @_findings.Count(f => f.Status == "fixing") fixing · @_findings.Count(f => f.Status == "verified") verified
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 15 min ago</span>
        </div>
    </div>
</section>

@code {
    private sealed class AuditFinding
    {
        public string Id { get; init; } = "";
        public string Title { get; init; } = "";
        public string Status { get; init; } = "";
        public string Category { get; init; } = "";
        public string Assignee { get; init; } = "";
        public string AssigneeInitials { get; init; } = "";
        public string Meta { get; init; } = "";
    }

    private sealed class CategoryConfig
    {
        public string Id { get; init; } = "";
        public string Label { get; init; } = "";
        public string BorderColor { get; init; } = "";
        public string DotColor { get; init; } = "";
    }

    private sealed record ColumnDef(string Id, string Title, string Icon);

    private static readonly CategoryConfig[] _categories =
    [
        new() { Id = "inconsistency", Label = "Inconsistency", BorderColor = "border-l-blue-500",    DotColor = "bg-blue-500"    },
        new() { Id = "accessibility", Label = "Accessibility",  BorderColor = "border-l-purple-500",  DotColor = "bg-purple-500"  },
        new() { Id = "performance",   Label = "Performance",    BorderColor = "border-l-amber-500",   DotColor = "bg-amber-500"   },
        new() { Id = "mobile",        Label = "Mobile",         BorderColor = "border-l-emerald-500", DotColor = "bg-emerald-500" },
        new() { Id = "dark-mode",     Label = "Dark Mode",      BorderColor = "border-l-rose-500",    DotColor = "bg-rose-500"    },
    ];

    private static readonly ColumnDef[] _columns =
    [
        new("found",    "Found",    "search"),
        new("fixing",   "Fixing",   "wrench"),
        new("verified", "Verified", "check-circle-2"),
    ];

    private static readonly AuditFinding[] _findings =
    [
        new() { Id = "sa1",  Title = "Button border-radius varies across pages",         Status = "found",    Category = "inconsistency", Assignee = "Hana Lee",   AssigneeInitials = "HL", Meta = "4px vs 6px vs 8px" },
        new() { Id = "sa2",  Title = "Color contrast fails WCAG AA on muted text",       Status = "found",    Category = "accessibility", Assignee = "Unassigned", AssigneeInitials = "??", Meta = "Ratio 3.8:1"       },
        new() { Id = "sa3",  Title = "Unused CSS variables increase bundle size",         Status = "found",    Category = "performance",   Assignee = "Marco Voss", AssigneeInitials = "MV", Meta = "32 unused vars"    },
        new() { Id = "sa4",  Title = "Sidebar overlaps content below 768px",             Status = "found",    Category = "mobile",        Assignee = "Yuki Ito",   AssigneeInitials = "YI", Meta = "iPad portrait"     },
        new() { Id = "sa5",  Title = "Card shadows invisible in dark mode",               Status = "found",    Category = "dark-mode",     Assignee = "Hana Lee",   AssigneeInitials = "HL", Meta = "Elevation lost"    },
        new() { Id = "sa6",  Title = "Heading font-weight inconsistent in modals",        Status = "fixing",   Category = "inconsistency", Assignee = "Marco Voss", AssigneeInitials = "MV", Meta = "500 vs 600"        },
        new() { Id = "sa7",  Title = "Focus ring missing on dropdown trigger",            Status = "fixing",   Category = "accessibility", Assignee = "Yuki Ito",   AssigneeInitials = "YI", Meta = "Keyboard nav"      },
        new() { Id = "sa8",  Title = "Large CSS selector specificity wars",               Status = "fixing",   Category = "performance",   Assignee = "Hana Lee",   AssigneeInitials = "HL", Meta = "12 overrides"      },
        new() { Id = "sa9",  Title = "Touch targets too small on mobile nav",             Status = "fixing",   Category = "mobile",        Assignee = "Marco Voss", AssigneeInitials = "MV", Meta = "32px to 44px"      },
        new() { Id = "sa10", Title = "Spacing scale standardized to 4px grid",           Status = "verified", Category = "inconsistency", Assignee = "Yuki Ito",   AssigneeInitials = "YI", Meta = "All pages"         },
        new() { Id = "sa11", Title = "Alt text added to all decorative images",           Status = "verified", Category = "accessibility", Assignee = "Hana Lee",   AssigneeInitials = "HL", Meta = "aria-hidden"       },
        new() { Id = "sa12", Title = "Dark mode surface colors use semantic tokens",      Status = "verified", Category = "dark-mode",     Assignee = "Marco Voss", AssigneeInitials = "MV", Meta = "8 tokens fixed"    },
        new() { Id = "sa13", Title = "Render-blocking CSS eliminated from above-fold",   Status = "verified", Category = "performance",   Assignee = "Yuki Ito",   AssigneeInitials = "YI", Meta = "LCP improved"      },
    ];

    private CategoryConfig GetCategoryConfig(string category)
    {
        return Array.Find(_categories, c => c.Id == category) ?? _categories[0];
    }
}
