@* ============================================================
   Block: kanban-revenue-board
   Title: KanbanRevenueBoard
   Description: React revenue tracking dashboard kanban for Next.js with MRR metrics, ARR growth, churn rate, net revenue retention, and mini account columns using shadcn/ui, CountUp, and Tailwind CSS
   Source: original/blocks/kanban/kanban-revenue-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="dollar-sign" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Revenue Board</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_accounts.Length accounts
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @FormatMrr(_expandingMrr)
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @FormatMrr(_stableMrr)
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @FormatMrr(_atRiskMrr)
                </span>
            </div>
        </div>

        @* Metrics Grid *@
        <div class="grid grid-cols-2 gap-3 border-b p-4 sm:grid-cols-4">
            @* MRR *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="dollar-sign" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">MRR</span>
                </div>
                <span class="font-semibold text-2xl tabular-nums text-foreground">
                    $@_totalMrr.ToString("N0")
                </span>
            </div>
            @* ARR Growth *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">ARR Growth</span>
                </div>
                <span class="font-semibold text-2xl tabular-nums text-emerald-600 dark:text-emerald-400">
                    @_arrGrowth.ToString("F1")%
                </span>
            </div>
            @* Churn Rate *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="trending-down" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">Churn Rate</span>
                </div>
                <span class="font-semibold text-2xl tabular-nums text-red-600 dark:text-red-400">
                    @_churnRate.ToString("F1")%
                </span>
            </div>
            @* Net Revenue Retention *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">Net Revenue Retention</span>
                </div>
                <span class="@Cn.Merge("font-semibold text-2xl tabular-nums", _nrr >= 100 ? "text-emerald-600 dark:text-emerald-400" : "text-amber-600 dark:text-amber-400")">
                    @_nrr%
                </span>
            </div>
        </div>

        @* Revenue Health Progress *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Revenue health</span>
                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                    @_healthyPercent% healthy
                </span>
            </div>
            <div class="cn-progress relative flex h-2 w-full items-center overflow-x-hidden"
                 role="progressbar" aria-label="Revenue health"
                 aria-valuenow="@_healthyPercent"
                 aria-valuemin="0"
                 aria-valuemax="100">
                <div class="@Cn.Merge("cn-progress-indicator h-full transition-all duration-700", _healthyPercent >= 80 ? "bg-emerald-500" : (_healthyPercent >= 60 ? "bg-amber-500" : "bg-red-500"))"
                     style="@($"width:{_healthyPercent}%")">
                </div>
            </div>
        </div>

        @* Mini Kanban Board *@
        <div class="border-b p-4">
            <div class="grid grid-cols-3 gap-3">
                @foreach (var col in _columns)
                {
                    var colAccounts = _accounts.Where(a => a.Health == col.Id).ToArray();
                    var colMrr = colAccounts.Sum(a => a.Mrr);
                    <div class="rounded-md border">
                        @* Column Header *@
                        <div class="flex items-center gap-1.5 border-b px-2.5 py-2">
                            <span class="@Cn.Merge("size-1.5 rounded-full", col.Dot)"></span>
                            <span class="font-medium text-xs">@col.Label</span>
                            <span class="ml-auto font-mono text-muted-foreground/60 text-[10px] tabular-nums">
                                @FormatMrr(colMrr)
                            </span>
                        </div>
                        @* Mini Cards *@
                        <div class="flex flex-col gap-0.5 p-1.5">
                            @foreach (var account in colAccounts)
                            {
                                <div class="flex items-center gap-1.5 rounded px-2 py-1.5 transition-colors hover:bg-muted/50">
                                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full opacity-40", col.Dot)"></span>
                                    <span class="min-w-0 flex-1 truncate text-xs">@account.Name</span>
                                    <span class="shrink-0 font-mono text-muted-foreground/60 text-[10px] tabular-nums">
                                        @FormatMrr(account.Mrr)
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                3 segments · @_accounts.Length active accounts
            </span>
            <span class="font-mono text-muted-foreground/60 text-xs tabular-nums">
                @FormatMrr(_totalMrr)/mo
            </span>
        </div>
    </div>
</section>

@code {
    private record Account(string Id, string Name, int Mrr, string Health, int Seats);
    private record KanbanColumn(string Id, string Label, string Dot);

    private static readonly Account[] _accounts =
    [
        new("a1",  "Meridian Healthcare",  4800,  "expanding", 45),
        new("a2",  "Vertex Logistics",     3200,  "expanding", 28),
        new("a3",  "Pinnacle Finance",     8500,  "expanding", 120),
        new("a4",  "Catalyst EdTech",      6200,  "expanding", 65),
        new("a5",  "Stratos Cloud",        12000, "stable",    200),
        new("a6",  "Bloom Retail",         2800,  "stable",    18),
        new("a7",  "Atlas Manufacturing",  9500,  "stable",    85),
        new("a8",  "Neon Digital",         1850,  "stable",    12),
        new("a9",  "Horizon Energy",       5600,  "at-risk",   42),
        new("a10", "Summit Analytics",     3100,  "at-risk",   22),
        new("a11", "CoreBridge Systems",   4200,  "at-risk",   35),
    ];

    private static readonly KanbanColumn[] _columns =
    [
        new("expanding", "Expanding", "bg-emerald-500"),
        new("stable",    "Stable",    "bg-blue-500"),
        new("at-risk",   "At Risk",   "bg-red-500"),
    ];

    private int    _totalMrr      => _accounts.Sum(a => a.Mrr);
    private int    _expandingMrr  => _accounts.Where(a => a.Health == "expanding").Sum(a => a.Mrr);
    private int    _stableMrr     => _accounts.Where(a => a.Health == "stable").Sum(a => a.Mrr);
    private int    _atRiskMrr     => _accounts.Where(a => a.Health == "at-risk").Sum(a => a.Mrr);
    private double _arrGrowth     => 24.3;
    private double _churnRate     => 3.8;
    private int    _nrr           => (int)Math.Round((double)(_expandingMrr + _stableMrr) / _totalMrr * 100);
    private int    _healthyPercent => (int)Math.Round((double)(_expandingMrr + _stableMrr) / _totalMrr * 100);

    private static string FormatMrr(int value)
    {
        if (value >= 1000)
            return $"${(value / 1000.0).ToString("F1")}k";
        return $"${value}";
    }
}
