@* ============================================================
   Block: kanban-testing-queue
   Title: KanbanTestingQueue
   Description: React kanban QA testing queue for Next.js with expandable inline cards showing test steps, expected versus actual results, and environment info using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-testing-queue.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="beaker" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Testing Queue</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_testCases.Length cases
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_testCases.Count(t => t.Priority == "critical")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_testCases.Count(t => t.Priority == "high")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_testCases.Count(t => t.Priority == "medium")
                </span>
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var col in _columnConfig)
            {
                var column = col;
                var columnCases = _testCases.Where(t => t.Status == column.Id).ToArray();
                <div>
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2.5">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@column.IconName" Size="14" Class="size-3.5" />
                        </span>
                        <span class="font-medium text-muted-foreground text-xs">@column.Title</span>
                        <span class="text-muted-foreground/60 text-xs">@columnCases.Length</span>
                    </div>

                    <div>
                        @foreach (var tc in columnCases)
                        {
                            var testCase = tc;
                            var isExpanded = _expanded == testCase.Id;
                            var isLast = Array.IndexOf(columnCases, testCase) == columnCases.Length - 1;
                            <div class="@Cn.Merge(!isLast ? "border-b" : "")">
                                <button type="button"
                                        class="flex w-full items-center gap-2.5 px-4 py-2.5 text-left transition-colors hover:bg-muted/50"
                                        @onclick="@(() => ToggleExpanded(testCase.Id))">
                                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", GetPriorityDot(testCase.Priority))"></span>
                                    <div class="min-w-0 flex-1">
                                        <span class="block truncate font-medium text-sm">@testCase.Title</span>
                                        <span class="font-mono text-muted-foreground text-xs">@testCase.CaseId</span>
                                    </div>
                                    <LucideIconCn Name="chevron-right"
                                                  Size="16"
                                                  Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="px-4 pb-4">
                                        @* Tester + Environment *@
                                        <div class="mb-3 flex flex-wrap items-center gap-3">
                                            <div class="flex items-center gap-1.5">
                                                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                                    @testCase.TesterInitials
                                                </span>
                                                <span class="text-xs">@testCase.Tester</span>
                                            </div>
                                            <span class="text-muted-foreground text-xs">·</span>
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="monitor" Size="12" Class="size-3" />
                                                @testCase.Environment
                                            </span>
                                            @if (!string.IsNullOrEmpty(testCase.Duration))
                                            {
                                                <span class="text-muted-foreground text-xs">·</span>
                                                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                                    @testCase.Duration
                                                </span>
                                            }
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs">
                                                @testCase.Priority
                                            </BadgeCn>
                                        </div>

                                        @* Test steps *@
                                        <div class="mb-3">
                                            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                                Test steps
                                            </span>
                                            <ol class="space-y-1 pl-4 text-sm leading-relaxed">
                                                @foreach (var step in testCase.Steps)
                                                {
                                                    <li class="list-decimal text-muted-foreground">@step</li>
                                                }
                                            </ol>
                                        </div>

                                        @* Expected result *@
                                        <div class="mb-3 rounded-md bg-muted/50 p-3">
                                            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                                Expected result
                                            </span>
                                            <p class="text-sm leading-relaxed">@testCase.ExpectedResult</p>
                                        </div>

                                        @* Actual result *@
                                        @if (!string.IsNullOrEmpty(testCase.ActualResult))
                                        {
                                            <div class="rounded-md bg-muted/50 p-3">
                                                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                                    Actual result
                                                </span>
                                                <p class="text-sm leading-relaxed">@testCase.ActualResult</p>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_testCases.Count(t => t.Status == "passed") of @_testCases.Length passed
            </span>
            <span class="text-muted-foreground/60 text-xs">Last run 4 min ago</span>
        </div>
    </div>
</section>

@code {
