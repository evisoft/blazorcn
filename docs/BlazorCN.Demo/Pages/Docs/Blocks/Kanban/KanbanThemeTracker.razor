@* ============================================================
   Block: kanban-theme-tracker
   Title: KanbanThemeTracker
   Description: React kanban board for theme and styling changes with color-coded left-border cards by token type, 3-column workflow using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-theme-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="swatch-book" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Theme Tracker</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_changes.Length changes
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span>@(_changes.Count(c => c.Status == "applied")) applied</span>
                <span class="text-muted-foreground/60">·</span>
                <span>@(_changes.Count(c => c.Status == "testing")) testing</span>
            </div>
        </div>

        @* Color Legend *@
        <div class="flex items-center gap-4 border-b bg-muted/30 px-4 py-2">
            @foreach (var cat in _categories)
            {
                var catItem = cat;
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", catItem.DotColor)"></span>
                    @catItem.Label
                </span>
            }
        </div>

        @* Columns *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var col in _columns)
            {
                var column = col;
                var columnChanges = _changes.Where(c => c.Status == column.Id).ToArray();
                <div>
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2.5">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@column.IconName" Size="14" Class="size-3.5" />
                        </span>
                        <span class="font-medium text-muted-foreground text-xs">@column.Title</span>
                        <span class="text-muted-foreground/60 text-xs">@columnChanges.Length</span>
                    </div>

                    <div class="p-2 space-y-1.5">
                        @foreach (var chg in columnChanges)
                        {
                            var change = chg;
                            var catCfg = GetCategoryConfig(change.Category);
                            <div class="@Cn.Merge("rounded-md border border-l-4 bg-card px-3 py-2.5 transition-colors hover:bg-muted/50", catCfg.BorderColor)">
                                <div class="flex items-center gap-2">
                                    <div class="min-w-0 flex-1">
                                        <span class="block truncate font-medium text-sm">@change.Title</span>
                                        <span class="text-muted-foreground text-xs">@change.Meta</span>
                                    </div>
                                    <AvatarCn Class="size-6 shrink-0">
                                        <AvatarFallbackCn Class="text-[10px]">@change.AuthorInitials</AvatarFallbackCn>
                                    </AvatarCn>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @(_changes.Count(c => c.Status == "proposed")) proposed · @(_changes.Count(c => c.Status == "testing")) testing · @(_changes.Count(c => c.Status == "applied")) applied
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 7 min ago</span>
        </div>
    </div>
</section>

@code {
    private record ThemeChange(string Id, string Title, string Status, string Category, string Author, string AuthorInitials, string Meta);
    private record CategoryConfig(string Id, string Label, string BorderColor, string DotColor);
    private record ColumnDef(string Id, string Title, string IconName);

    private static readonly CategoryConfig[] _categories =
    [
        new("colors",     "Colors",     "border-l-blue-500",    "bg-blue-500"),
        new("spacing",    "Spacing",    "border-l-purple-500",  "bg-purple-500"),
        new("typography", "Typography", "border-l-amber-500",   "bg-amber-500"),
        new("shadows",    "Shadows",    "border-l-emerald-500", "bg-emerald-500"),
        new("borders",    "Borders",    "border-l-rose-500",    "bg-rose-500"),
    ];

    private static readonly ThemeChange[] _changes =
    [
        new("tc1",  "Reduce primary blue saturation by 10%",  "proposed", "colors",     "Ravi Gupta",   "RG", "Brand alignment"),
        new("tc2",  "Increase base spacing from 4px to 5px",  "proposed", "spacing",    "Unassigned",   "??", "Layout impact: high"),
        new("tc3",  "Switch body font to Inter Variable",      "proposed", "typography", "Zoe Adams",    "ZA", "Performance gain"),
        new("tc4",  "Add elevation-4 shadow token",            "testing",  "shadows",    "Ravi Gupta",   "RG", "Modal dialogs"),
        new("tc5",  "Standardize border-radius to 3 tiers",   "testing",  "borders",    "Kai Nakamura", "KN", "sm/md/lg"),
        new("tc6",  "Dark mode surface color adjustments",     "testing",  "colors",     "Zoe Adams",    "ZA", "12 tokens"),
        new("tc7",  "Compact spacing scale for data tables",   "testing",  "spacing",    "Ravi Gupta",   "RG", "Dense variant"),
        new("tc8",  "Monospace font for code blocks",          "applied",  "typography", "Kai Nakamura", "KN", "JetBrains Mono"),
        new("tc9",  "Subtle inner shadow for inputs",          "applied",  "shadows",    "Zoe Adams",    "ZA", "inset 0 1px 2px"),
        new("tc10", "Semantic color tokens for alerts",        "applied",  "colors",     "Ravi Gupta",   "RG", "4 severity levels"),
    ];

    private static readonly ColumnDef[] _columns =
    [
        new("proposed", "Proposed", "lightbulb"),
        new("testing",  "Testing",  "flask-conical"),
        new("applied",  "Applied",  "check-circle-2"),
    ];

    private CategoryConfig GetCategoryConfig(string category) =>
        _categories.FirstOrDefault(c => c.Id == category) ?? _categories[0];
}
