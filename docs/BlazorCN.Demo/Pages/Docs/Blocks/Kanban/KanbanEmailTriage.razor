@* ============================================================
   Block: kanban-email-triage
   Title: KanbanEmailTriage
   Description: React kanban email triage board for Next.js with sender initials, time-received labels, compact list rows, and staggered animations using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-email-triage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Email Triage</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_emails.Length emails
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_emails.Count(e => e.Status == "unread") unread
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_emails.Count(e => e.Status == "flagged") flagged
                </span>
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var col in _columnConfig)
            {
                var columnEmails = _emails.Where(e => e.Status == col.Id).ToArray();
                <div>
                    @* Column header *@
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2.5">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@col.IconName" Size="14" Class="size-3.5" />
                        </span>
                        <span class="font-medium text-muted-foreground text-xs">@col.Title</span>
                        <span class="text-muted-foreground/60 text-xs">@columnEmails.Length</span>
                    </div>

                    @* Email rows *@
                    <div>
                        @for (var i = 0; i < columnEmails.Length; i++)
                        {
                            var email = columnEmails[i];
                            var isLast = i == columnEmails.Length - 1;
                            <div class="@Cn.Merge("flex items-center gap-2.5 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                    @email.SenderInitials
                                </span>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-1.5">
                                        <span class="truncate font-medium text-sm">@email.Sender</span>
                                    </div>
                                    <p class="truncate text-muted-foreground text-xs">@email.Subject</p>
                                </div>
                                <span class="shrink-0 text-muted-foreground/60 text-[11px]">
                                    @email.Time
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_emails.Count(e => e.Status == "archived") archived this week
            </span>
            <span class="text-muted-foreground/60 text-xs">Synced 1 min ago</span>
        </div>
    </div>
</section>

@code {
    private record EmailItem(string Id, string Sender, string SenderInitials, string Subject, string Time, string Status);
    private record ColumnItem(string Id, string Title, string IconName);

    private static readonly EmailItem[] _emails =
    [
        new("1",  "Lisa Chen",    "LC", "Updated design specs for v2 launch",           "9:14 AM",  "unread"),
        new("2",  "Mark Rivera",  "MR", "Re: Database migration timeline",               "8:52 AM",  "unread"),
        new("3",  "Support Bot",  "SB", "Weekly error digest — 3 new issues",            "8:30 AM",  "unread"),
        new("4",  "Amy Walsh",    "AW", "Can we move Friday's demo to 2pm?",             "Yesterday","unread"),
        new("5",  "DevOps Alert", "DA", "Production CPU at 92% — auto-scaling triggered","7:45 AM",  "flagged"),
        new("6",  "Tom Nguyen",   "TN", "Contract renewal needs signature by EOD",       "Yesterday","flagged"),
        new("7",  "Sarah Kim",    "SK", "Quarterly board deck — final review",           "Mar 28",   "flagged"),
        new("8",  "GitHub",       "GH", "PR #412 merged into main",                      "Mar 28",   "archived"),
        new("9",  "Jira",         "JI", "Sprint 14 retrospective notes posted",          "Mar 27",   "archived"),
        new("10", "Priya Patel",  "PP", "Thanks for the quick turnaround!",              "Mar 27",   "archived"),
    ];

    private static readonly ColumnItem[] _columnConfig =
    [
        new("unread",   "Unread",   "mail"),
        new("flagged",  "Flagged",  "flag"),
        new("archived", "Archived", "archive"),
    ];
}
