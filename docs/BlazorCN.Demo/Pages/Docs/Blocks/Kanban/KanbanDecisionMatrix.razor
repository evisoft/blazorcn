@* ============================================================
   Block: kanban-decision-matrix
   Title: KanbanDecisionMatrix
   Description: React decision-making 2x2 matrix grid for Next.js with confidence-value quadrants, decision chips, and action badges using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-decision-matrix.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="compass" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Decision Matrix</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_decisions.Length decisions
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var q in _quadrants)
                {
                    var qId = q.Id;
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", q.Dot)"></span>
                        @GetCount(qId)
                    </span>
                }
            </div>
        </div>

        @* Axis labels *@
        <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Confidence Level &rarr;</span>
            <span class="font-medium text-muted-foreground text-xs">&uarr; Potential Value</span>
        </div>

        @* 2x2 Grid *@
        <div class="grid grid-cols-2">
            @for (var qIndex = 0; qIndex < _quadrants.Length; qIndex++)
            {
                var q = _quadrants[qIndex];
                var qDecisions = _decisions.Where(d => d.Quadrant == q.Id).ToArray();
                var isTop = qIndex < 2;
                var isLeft = qIndex % 2 == 0;
                <div class="@Cn.Merge("min-h-[170px] p-3", q.Bg, isLeft ? "border-r" : "", isTop ? "border-b" : "")">
                    @* Quadrant label *@
                    <div class="mb-2.5 flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", q.Dot)"></span>
                        <span class="font-medium text-sm">@q.Label</span>
                        <span class="text-muted-foreground text-xs">@q.Description</span>
                    </div>

                    @* Decision chips *@
                    <div class="flex flex-col gap-1">
                        @foreach (var decision in qDecisions)
                        {
                            <div class="flex items-center gap-2 rounded-md bg-card/80 px-2.5 py-1.5 transition-colors hover:bg-card">
                                <span class="min-w-0 flex-1 truncate text-xs">@decision.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-[10px] px-1.5 py-0">
                                    @decision.Domain
                                </BadgeCn>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                4 quadrants · @_decisions.Length decisions
            </span>
            <span class="text-muted-foreground text-xs">
                <span class="inline-flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_proceedCount ready to proceed
                </span>
            </span>
        </div>
    </div>
</section>

@code {
    private record QuadrantConfig(string Id, string Label, string Description, string Bg, string Dot);
    private record Decision(string Id, string Title, string Domain, string Quadrant);

    private static readonly QuadrantConfig[] _quadrants =
    [
        new("proceed-now",   "Proceed Now",   "High Confidence + High Value", "bg-emerald-500/5", "bg-emerald-500"),
        new("research-more", "Research More", "Low Confidence + High Value",  "bg-blue-500/5",    "bg-blue-500"),
        new("pilot-test",    "Pilot Test",    "High Confidence + Low Value",  "bg-amber-500/5",   "bg-amber-500"),
        new("defer",         "Defer",         "Low Confidence + Low Value",   "bg-red-500/5",     "bg-red-500"),
    ];

    private static readonly Decision[] _decisions =
    [
        new("d1",  "Migrate primary database to Aurora",       "Infra",     "proceed-now"),
        new("d2",  "Hire senior ML engineer for search",       "Hiring",    "proceed-now"),
        new("d3",  "Renew AWS contract at 3-year rate",        "Finance",   "proceed-now"),
        new("d4",  "Expand into European market",              "Strategy",  "research-more"),
        new("d5",  "Adopt GraphQL for public API",             "API",       "research-more"),
        new("d6",  "Acquire competitor analytics startup",     "M&A",       "research-more"),
        new("d7",  "Launch freemium tier for startups",        "Pricing",   "pilot-test"),
        new("d8",  "Switch from Slack to Teams internally",    "Ops",       "pilot-test"),
        new("d9",  "Replace Jenkins with GitHub Actions",      "DevOps",    "pilot-test"),
        new("d10", "Build in-house CRM from scratch",          "Product",   "defer"),
        new("d11", "Open physical office in Tokyo",            "Expansion", "defer"),
    ];

    private int _proceedCount => GetCount("proceed-now");

    private int GetCount(string quadrant) => _decisions.Count(d => d.Quadrant == quadrant);
}
