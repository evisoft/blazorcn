@* ============================================================
   Block: kanban-production-schedule
   Title: KanbanProductionSchedule
   Description: React kanban board for Next.js with production scheduling columns and a Sheet side panel showing order details, product specs, materials, QC results, and shipping info using shadcn/ui Sheet and Tailwind CSS.
   Source: original/blocks/kanban/kanban-production-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="cog" Size="16" Class="size-4 text-muted-foreground" />
            <h2 class="text-sm font-medium">Production Schedule</h2>
            <span class="text-xs text-muted-foreground">@_orders.Length orders</span>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @(_orders.Count(o => o.Priority == "rush")) rush
                </span>
            </div>
        </div>

        @* Kanban columns *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var col in _columns)
            {
                var column = col;
                var colOrders = _orders.Where(o => o.Stage == column.Stage).ToArray();
                var colQty = colOrders.Sum(o => o.Quantity);
                <div class="min-h-[480px]">
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", StageDotClass(column.Stage))"></span>
                        <span class="text-xs font-medium">@column.Label</span>
                        <span class="ml-auto text-xs text-muted-foreground tabular-nums">
                            @colQty.ToString("N0") total
                        </span>
                    </div>
                    <div class="divide-y">
                        @foreach (var ord in colOrders)
                        {
                            var order = ord;
                            <button type="button"
                                    class="@Cn.Merge("flex w-full flex-col gap-1 border-l-4 px-3 py-2.5 text-left transition-colors hover:bg-muted/50", StageBorderClass(order.Stage), _selectedId == order.Id ? "bg-muted/50 ring-2 ring-foreground ring-inset" : "")"
                                    @onclick="@(() => _selectedId = order.Id)">
                                <span class="truncate text-sm font-medium">@order.Product</span>
                                <span class="font-mono text-xs text-muted-foreground">
                                    @order.OrderNumber
                                </span>
                                <div class="flex items-center gap-2">
                                    <span class="@Cn.Merge("size-1.5 rounded-full", PriorityDotClass(order.Priority))"></span>
                                    <span class="text-xs text-muted-foreground tabular-nums">
                                        @order.Quantity.ToString("N0") @order.Unit
                                    </span>
                                    <span class="ml-auto flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium text-muted-foreground">
                                        @order.Initials
                                    </span>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @* Sheet side panel *@
    <SheetCn Open="@(_selectedId != null)" OpenChanged="@((open) => { if (!open) _selectedId = null; })">
        <SheetContentCn Class="overflow-y-auto sm:max-w-md">
            @if (_selected != null)
            {
                var sel = _selected;
                <SheetHeaderCn>
                    <SheetTitleCn Class="text-sm font-medium">@sel.Product</SheetTitleCn>
                    <SheetDescriptionCn>
                        <span class="flex items-center gap-2">
                            <span class="font-mono text-xs">@sel.OrderNumber</span>
                            <span class="text-xs text-muted-foreground">·</span>
                            <span class="@Cn.Merge("size-1.5 rounded-full", StageDotClass(sel.Stage))"></span>
                            <span class="capitalize text-xs">@sel.Stage.Replace("-", " ")</span>
                        </span>
                    </SheetDescriptionCn>
                </SheetHeaderCn>

                @* Order details *@
                <div class="border-b px-4 pb-4">
                    <span class="text-xs font-medium text-muted-foreground">Order Details</span>
                    <div class="mt-2 space-y-2">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Customer</span>
                            <span class="font-medium">@sel.Customer</span>
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Quantity</span>
                            <span class="font-medium tabular-nums">
                                @sel.Quantity.ToString("N0") @sel.Unit
                            </span>
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Priority</span>
                            <span class="flex items-center gap-1.5 font-medium capitalize">
                                <span class="@Cn.Merge("size-1.5 rounded-full", PriorityDotClass(sel.Priority))"></span>
                                @sel.Priority
                            </span>
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Due date</span>
                            <span class="font-medium">@sel.DueDate</span>
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Assignee</span>
                            <span class="flex items-center gap-1.5 font-medium">
                                <span class="flex size-5 items-center justify-center rounded-full bg-muted text-[9px] text-muted-foreground">
                                    @sel.Initials
                                </span>
                                @sel.Assignee
                            </span>
                        </div>
                    </div>
                </div>

                @* Product specs *@
                <div class="border-b px-4 py-4">
                    <span class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                        <LucideIconCn Name="ruler" Size="14" Class="size-3.5" />
                        Product Specifications
                    </span>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                        @sel.Specs
                    </p>
                </div>

                @* Materials *@
                <div class="border-b px-4 py-4">
                    <span class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                        <LucideIconCn Name="box" Size="14" Class="size-3.5" />
                        Materials
                    </span>
                    <div class="mt-2 space-y-1.5">
                        @foreach (var mat in sel.Materials)
                        {
                            <div class="flex items-center gap-2 text-xs">
                                <span class="size-1 rounded-full bg-foreground/30"></span>
                                <span>@mat</span>
                            </div>
                        }
                    </div>
                </div>

                @* QC results *@
                <div class="border-b px-4 py-4">
                    <span class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                        <LucideIconCn Name="clipboard-check" Size="14" Class="size-3.5" />
                        Quality Check Results
                    </span>
                    @if (sel.QcChecks.Length > 0)
                    {
                        <div class="mt-2 space-y-2">
                            @foreach (var chk in sel.QcChecks)
                            {
                                var check = chk;
                                <div class="flex items-center gap-2 text-xs">
                                    @if (check.Passed)
                                    {
                                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="x-circle" Size="14" Class="size-3.5 text-red-500" />
                                    }
                                    <span class="@Cn.Merge("", !check.Passed ? "font-medium text-red-600 dark:text-red-400" : "")">
                                        @check.Label
                                    </span>
                                    <span class="ml-auto text-[10px] text-muted-foreground">
                                        @(check.Passed ? "Pass" : "Fail")
                                    </span>
                                </div>
                            }
                            <div class="mt-1 rounded-md bg-muted/50 p-2.5">
                                <span class="text-xs font-medium tabular-nums">
                                    @sel.QcChecks.Count(c => c.Passed)/@sel.QcChecks.Length passed
                                </span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="mt-2 text-xs text-muted-foreground">Pending quality inspection</p>
                    }
                </div>

                @* Shipping info *@
                <div class="px-4 py-4">
                    <span class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
                        <LucideIconCn Name="truck" Size="14" Class="size-3.5" />
                        Shipping
                    </span>
                    <div class="mt-2 space-y-2">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Method</span>
                            <span class="font-medium">@sel.ShippingMethod</span>
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Tracking</span>
                            <span class="font-mono text-[10px]">@sel.TrackingNumber</span>
                        </div>
                        <div class="rounded-md bg-muted/50 p-2.5">
                            <span class="block text-[10px] text-muted-foreground">Ship to</span>
                            <span class="block text-xs">@sel.ShippingAddress</span>
                        </div>
                    </div>
                </div>

                @* Actions *@
                <div class="flex gap-2 border-t px-4 py-3">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Update status</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">Print label</ButtonCn>
                </div>
            }
        </SheetContentCn>
    </SheetCn>
</section>

@code {
