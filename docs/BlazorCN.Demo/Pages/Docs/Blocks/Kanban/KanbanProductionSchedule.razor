        new("in-production", "In Production"),
        new("quality-check", "Quality Check"),
        new("shipped",       "Shipped"),
    ];

    private string? _selectedId = null;

    private ProductionOrder? _selected => _selectedId != null ? _orders.FirstOrDefault(o => o.Id == _selectedId) : null;

    private static string StageDotClass(string stage) => stage switch
    {
        "queued"        => "bg-blue-500",
        "in-production" => "bg-amber-500",
        "quality-check" => "bg-violet-500",
        "shipped"       => "bg-emerald-500",
        _               => "",
    };

    private static string StageBorderClass(string stage) => stage switch
    {
        "queued"        => "border-l-blue-500",
        "in-production" => "border-l-amber-500",
        "quality-check" => "border-l-violet-500",
        "shipped"       => "border-l-emerald-500",
        _               => "",
    };

    private static string PriorityDotClass(string priority) => priority switch
    {
        "rush"     => "bg-red-500",
        "standard" => "bg-zinc-400",
        "low"      => "bg-blue-400",
