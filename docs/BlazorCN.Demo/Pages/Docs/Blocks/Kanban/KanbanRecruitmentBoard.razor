@* ============================================================
   Block: kanban-recruitment-board
   Title: KanbanRecruitmentBoard
   Description: React kanban recruitment pipeline for Next.js with sidebar filters for department, seniority, and location, four-column hiring stages, and animated candidate cards using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-recruitment-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="briefcase" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Recruitment Board</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_filtered.Length candidates
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var sen in _seniorities)
                {
                    var s = sen;
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", SeniorityDotClass(s))"></span>
                        @_filtered.Count(c => c.Seniority == s)
                    </span>
                }
            </div>
        </div>

        @* Body *@
        <div class="flex">
            @* Sidebar filters *@
            <div class="w-48 shrink-0 border-r">
                @* Department *@
                <div class="border-b p-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">
                        Department
                    </span>
                    <div class="flex flex-col gap-0.5">
                        @foreach (var dep in _departments)
                        {
                            var d = dep;
                            <ButtonCn Variant="@(_activeDepartments.Contains(d) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 justify-start text-xs"
                                      OnClick="@(() => ToggleDepartment(d))">
                                @d
                            </ButtonCn>
                        }
                    </div>
                </div>

                @* Seniority *@
                <div class="border-b p-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">
                        Seniority
                    </span>
                    <div class="flex flex-col gap-0.5">
                        @foreach (var sen in _seniorities)
                        {
                            var s = sen;
                            <ButtonCn Variant="@(_activeSeniorities.Contains(s) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 justify-start gap-2 text-xs"
                                      OnClick="@(() => ToggleSeniority(s))">
                                <span class="@Cn.Merge("size-1.5 rounded-full", SeniorityDotClass(s))"></span>
                                @s
                            </ButtonCn>
                        }
                    </div>
                </div>

                @* Location *@
                <div class="p-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">Location</span>
                    <div class="flex flex-col gap-0.5">
                        @foreach (var loc in _locations)
                        {
                            var l = loc;
                            <ButtonCn Variant="@(_activeLocations.Contains(l) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 justify-start gap-2 text-xs"
                                      OnClick="@(() => ToggleLocation(l))">
                                @if (l == "Remote")
                                {
                                    <LucideIconCn Name="globe" Size="12" Class="size-3 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-muted-foreground" />
                                }
                                @l
                            </ButtonCn>
                        }
                    </div>
                </div>
            </div>

            @* Board columns *@
            <div class="grid flex-1 grid-cols-4 divide-x">
                @foreach (var col in _columns)
                {
                    var column = col;
                    var colCandidates = _filtered.Where(c => c.Stage == column.Id).ToArray();
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                            <span class="text-muted-foreground">
                                <LucideIconCn Name="@column.IconName" Size="14" Class="size-3.5" />
                            </span>
                            <span class="font-medium text-muted-foreground text-xs">
                                @column.Title
                            </span>
                            <span class="text-muted-foreground/60 text-xs">@colCandidates.Length</span>
                        </div>
                        <div class="p-2">
                            <div class="flex flex-col gap-1.5">
                                @foreach (var cand in colCandidates)
                                {
                                    var candidate = cand;
                                    <div class="rounded-md border bg-card p-2.5 transition-colors hover:bg-muted/50">
                                        <div class="mb-1.5 flex items-start gap-2">
                                            <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", SeniorityDotClass(candidate.Seniority))"></span>
                                            <div class="min-w-0 flex-1">
                                                <span class="block font-medium text-sm leading-tight">
                                                    @candidate.Name
                                                </span>
                                                <span class="block truncate text-muted-foreground text-xs">
                                                    @candidate.Role
                                                </span>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-2 pl-3.5">
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                @if (candidate.Location == "Remote")
                                                {
                                                    <LucideIconCn Name="globe" Size="12" Class="size-3 text-muted-foreground" />
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-muted-foreground" />
                                                }
                                                @candidate.Location
                                            </span>
                                            <span class="text-muted-foreground/40">·</span>
                                            <span class="text-muted-foreground text-xs">
                                                @(candidate.AppliedDaysAgo)d ago
                                            </span>
                                        </div>
                                    </div>
                                }
                                @if (colCandidates.Length == 0)
                                {
                                    <div class="py-8 text-center text-muted-foreground/60 text-xs">
                                        No candidates
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_filtered.Count(c => c.Stage == "offer") offers pending
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 12 min ago</span>
        </div>
    </div>
</section>

@code {
    private record Candidate(string Id, string Name, string Role, string Stage, string Department, string Seniority, string Location, int AppliedDaysAgo);
    private record Column(string Id, string Title, string IconName);

    private static readonly Candidate[] _candidates =
    [
        new("1",  "Alice Chen",     "Frontend Engineer",   "applied",   "Engineering", "Mid",    "Remote", 2),
        new("2",  "Marcus Webb",    "Product Designer",    "applied",   "Design",      "Senior", "Onsite", 1),
        new("3",  "Priya Sharma",   "Growth Marketer",     "applied",   "Marketing",   "Junior", "Remote", 4),
        new("4",  "David Kim",      "Backend Engineer",    "screening", "Engineering", "Senior", "Onsite", 7),
        new("5",  "Lena Kowalski",  "UX Researcher",       "screening", "Design",      "Mid",    "Remote", 5),
        new("6",  "James Okafor",   "Product Manager",     "screening", "Product",     "Senior", "Onsite", 6),
        new("7",  "Sofia Martinez", "Content Strategist",  "screening", "Marketing",   "Mid",    "Remote", 8),
        new("8",  "Ryan Tanaka",    "Full-Stack Engineer", "interview", "Engineering", "Mid",    "Remote", 12),
        new("9",  "Emma Liu",       "Brand Designer",      "interview", "Design",      "Junior", "Onsite", 10),
        new("10", "Noah Williams",  "DevOps Engineer",     "interview", "Engineering", "Senior", "Remote", 14),
        new("11", "Zara Ahmed",     "Product Analyst",     "interview", "Product",     "Junior", "Remote", 11),
        new("12", "Ethan Brooks",   "Platform Engineer",   "offer",     "Engineering", "Senior", "Onsite", 21),
        new("13", "Mia Johnson",    "Design Lead",         "offer",     "Design",      "Senior", "Remote", 18),
        new("14", "Leo Fischer",    "SEO Specialist",      "offer",     "Marketing",   "Mid",    "Onsite", 16),
    ];

    private static readonly Column[] _columns =
    [
        new("applied",   "Applied",   "file-text"),
        new("screening", "Screening", "scan-search"),
        new("interview", "Interview", "user"),
        new("offer",     "Offer",     "send"),
    ];

    private static readonly string[] _departments  = ["Engineering", "Design", "Product", "Marketing"];
    private static readonly string[] _seniorities  = ["Junior", "Mid", "Senior"];
    private static readonly string[] _locations    = ["Remote", "Onsite"];

    private readonly HashSet<string> _activeDepartments  = [];
    private readonly HashSet<string> _activeSeniorities  = [];
    private readonly HashSet<string> _activeLocations    = [];

    private Candidate[] _filtered => _candidates.Where(c =>
        (_activeDepartments.Count  == 0 || _activeDepartments.Contains(c.Department)) &&
        (_activeSeniorities.Count  == 0 || _activeSeniorities.Contains(c.Seniority))  &&
        (_activeLocations.Count    == 0 || _activeLocations.Contains(c.Location))
    ).ToArray();

    private void ToggleDepartment(string d)
    {
        if (!_activeDepartments.Remove(d)) _activeDepartments.Add(d);
    }

    private void ToggleSeniority(string s)
    {
        if (!_activeSeniorities.Remove(s)) _activeSeniorities.Add(s);
    }

    private void ToggleLocation(string l)
    {
        if (!_activeLocations.Remove(l)) _activeLocations.Add(l);
    }

    private static string SeniorityDotClass(string seniority) => seniority switch
    {
        "Junior" => "bg-blue-500",
        "Mid"    => "bg-amber-500",
        "Senior" => "bg-emerald-500",
        _        => ""
    };
}
