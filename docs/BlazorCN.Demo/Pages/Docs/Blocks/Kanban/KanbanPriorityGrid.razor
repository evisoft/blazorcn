@* ============================================================
   Block: kanban-priority-grid
   Title: KanbanPriorityGrid
   Description: React business priority 2x2 matrix grid for Next.js with customer value and strategic importance axes, initiative chips, and category badges using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-priority-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layout-grid" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Business Priority Grid</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_initiatives.Length initiatives
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var q in _quadrants)
                {
                    var qId = q.Id;
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", q.Dot)"></span>
                        @GetCount(qId)
                    </span>
                }
            </div>
        </div>

        @* Axis labels *@
        <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Customer Value &rarr;</span>
            <span class="font-medium text-muted-foreground text-xs">&uarr; Strategic Importance</span>
        </div>

        @* 2x2 Grid *@
        <div class="grid grid-cols-2">
            @for (var qIndex = 0; qIndex < _quadrants.Length; qIndex++)
            {
                var q = _quadrants[qIndex];
                var qInitiatives = _initiatives.Where(i => i.Quadrant == q.Id).ToArray();
                var isTop = qIndex < 2;
                var isLeft = qIndex % 2 == 0;
                <div class="@Cn.Merge("min-h-[180px] p-3", q.Bg, isLeft ? "border-r" : "", isTop ? "border-b" : "")">
                    @* Quadrant label *@
                    <div class="mb-2.5 flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", q.Dot)"></span>
                        <span class="font-medium text-sm">@q.Label</span>
                        <span class="text-muted-foreground text-xs">@q.Description</span>
                    </div>

                    @* Initiative chips *@
                    <div class="flex flex-col gap-1">
                        @foreach (var initiative in qInitiatives)
                        {
                            <div class="flex items-center gap-2 rounded-md bg-card/80 px-2.5 py-1.5 transition-colors hover:bg-card">
                                <span class="min-w-0 flex-1 truncate text-xs">@initiative.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-[10px] px-1.5 py-0">
                                    @initiative.Category
                                </BadgeCn>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                4 quadrants · @_initiatives.Length initiatives
            </span>
            <span class="text-muted-foreground text-xs">
                <span class="inline-flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @GetCount("revenue-critical") revenue critical
                </span>
            </span>
        </div>
    </div>
</section>

@code {
    private record QuadrantConfig(string Id, string Label, string Description, string Bg, string Dot);
    private record Initiative(string Id, string Title, string Category, string Quadrant);

    private static readonly QuadrantConfig[] _quadrants =
    [
        new("revenue-critical",   "Revenue Critical",   "High Value + High Strategic", "bg-red-500/5",     "bg-red-500"),
        new("growth-opportunity", "Growth Opportunity", "Low Value + High Strategic",  "bg-blue-500/5",    "bg-blue-500"),
        new("maintenance",        "Maintenance",        "High Value + Low Strategic",  "bg-amber-500/5",   "bg-amber-500"),
        new("technical-debt",     "Technical Debt",     "Low Value + Low Strategic",   "bg-emerald-500/5", "bg-emerald-500"),
    ];

    private static readonly Initiative[] _initiatives =
    [
        new("i1",  "Enterprise SSO integration",          "Auth",      "revenue-critical"),
        new("i2",  "Usage-based billing migration",        "Billing",   "revenue-critical"),
        new("i3",  "SLA monitoring and uptime dashboard",  "Ops",       "revenue-critical"),
        new("i4",  "Self-serve plan upgrade flow",         "Growth",    "revenue-critical"),
        new("i5",  "Mobile app for field teams",           "Platform",  "growth-opportunity"),
        new("i6",  "Partner marketplace and integrations", "Ecosystem", "growth-opportunity"),
        new("i7",  "AI copilot for workflow automation",   "AI",        "growth-opportunity"),
        new("i8",  "Security patch for auth tokens",       "Security",  "maintenance"),
        new("i9",  "Database query performance tuning",    "Infra",     "maintenance"),
        new("i10", "Customer support SLA compliance",      "Support",   "maintenance"),
        new("i11", "Migrate legacy cron jobs to queues",   "Infra",     "technical-debt"),
        new("i12", "Remove deprecated API v1 endpoints",   "API",       "technical-debt"),
        new("i13", "Consolidate duplicate UI components",  "Frontend",  "technical-debt"),
    ];

    private int GetCount(string quadrant) => _initiatives.Count(i => i.Quadrant == quadrant);
}
