@* ============================================================
   Block: kanban-grant-proposals
   Title: KanbanGrantProposals
   Description: React grant management kanban for Next.js with proposal stage columns, compact cards, and Dialog detail overlay showing funding body, amount, PI, deadline, and abstract using shadcn/ui Dialog and Tailwind CSS.
   Source: original/blocks/kanban/kanban-grant-proposals.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="graduation-cap" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Grant Proposals</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_grants.Length proposals
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs">
                    @FormatCurrency(_grants.Where(g => g.Stage == "awarded").Sum(g => g.Amount)) awarded
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">
                    @FormatCurrency(_grants.Sum(g => g.Amount)) total
                </span>
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-4 divide-x">
            @foreach (var col in _columns)
            {
                var colStage = col.Stage;
                var colGrants = _grants.Where(g => g.Stage == colStage).ToArray();
                <div>
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-3 py-2.5">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _stageDot.TryGetValue(colStage, out var dot) ? dot : "")"></span>
                        <span class="font-medium text-muted-foreground text-xs">@col.Label</span>
                        <span class="text-muted-foreground/60 text-xs">@colGrants.Length</span>
                    </div>
                    <div>
                        @for (int i = 0; i < colGrants.Length; i++)
                        {
                            var grant = colGrants[i];
                            var isLast = i == colGrants.Length - 1;
                            <div class="@(isLast ? "" : "border-b")">
                                <button
                                    type="button"
                                    @onclick="@(() => _selectedId = grant.Id)"
                                    class="flex w-full items-center gap-2.5 px-3 py-2.5 text-left transition-colors hover:bg-muted/50">
                                    <span class="min-w-0 flex-1">
                                        <span class="block truncate font-medium text-sm">@grant.Title</span>
                                        <span class="block text-muted-foreground text-xs tabular-nums">
                                            @FormatCurrency(grant.Amount)
                                        </span>
                                    </span>
                                    <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                        @grant.PiInitials
                                    </span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_grants.Count(g => g.Stage == "review") under review
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 15 min ago</span>
        </div>
    </div>

    @* Dialog *@
    <DialogCn Open="@(_selectedId != null)" OpenChanged="@((bool v) => { if (!v) _selectedId = null; })">
        <DialogContentCn Class="max-w-md p-0">
            @{
                var selected = _grants.FirstOrDefault(g => g.Id == _selectedId);
            }
            @if (selected != null)
            {
                <DialogHeaderCn Class="border-b px-4 py-3">
                    <DialogTitleCn Class="font-medium text-sm">@selected.Title</DialogTitleCn>
                    <DialogDescriptionCn Class="flex items-center gap-2 text-xs">
                        <LucideIconCn Name="book-open" Size="12" Class="size-3" />
                        @selected.FundingBody
                    </DialogDescriptionCn>
                </DialogHeaderCn>

                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-2">
                        <span class="font-semibold text-2xl tabular-nums">
                            @FormatCurrency(selected.Amount)
                        </span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @selected.Duration
                        </BadgeCn>
                    </div>
                    <div class="mt-1.5 flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _stageDot.TryGetValue(selected.Stage, out var selDot) ? selDot : "")"></span>
                        <span class="text-muted-foreground text-xs capitalize">
                            @(selected.Stage == "review" ? "Under Review" : selected.Stage)
                        </span>
                    </div>
                </div>

                <div class="border-b px-4 py-3">
                    <div class="space-y-2.5">
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">Principal Investigator</span>
                            <span class="ml-auto font-medium">@selected.Pi</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="clipboard-list" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">Department</span>
                            <span class="ml-auto font-medium">@selected.Department</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">Deadline</span>
                            <span class="ml-auto font-medium">@selected.Deadline</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <LucideIconCn Name="dollar-sign" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">Amount</span>
                            <span class="ml-auto font-medium tabular-nums">
                                @FormatCurrency(selected.Amount)
                            </span>
                        </div>
                    </div>
                </div>

                <div class="border-b px-4 py-3">
                    <span class="font-medium text-muted-foreground text-xs">Abstract</span>
                    <div class="mt-2 rounded-md bg-muted/50 p-3">
                        <p class="text-sm leading-relaxed">@selected.Abstract</p>
                    </div>
                </div>

                <div class="border-b px-4 py-3">
                    <span class="font-medium text-muted-foreground text-xs">Status notes</span>
                    <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">
                        @selected.StatusNotes
                    </p>
                </div>

                <div class="flex gap-2 px-4 py-3">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Edit proposal
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-muted-foreground text-xs">
                        Move stage
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="ml-auto h-7 text-muted-foreground text-xs">
                        Archive
                    </ButtonCn>
                </div>
            }
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private string? _selectedId;

    private record Grant(
        string Id,
        string Title,
        string FundingBody,
        string Stage,
        int Amount,
        string Pi,
        string PiInitials,
        string Department,
        string Deadline,
        string Abstract,
        string StatusNotes,
        string Duration
    );

    private record Column(string Stage, string Label);

