@* ============================================================
   Block: kanban-feedback-sorter
   Title: KanbanFeedbackSorter
   Description: React kanban feedback sorter for Next.js with star ratings, truncated feedback snippets, compact list rows, and staggered entrance animations using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-feedback-sorter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Feedback Sorter</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_feedback.Length items
                </BadgeCn>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-amber-600 text-xs dark:text-amber-400">&#9733;</span>
                <span class="font-medium text-muted-foreground text-xs tabular-nums">
                    @_avgRating avg
                </span>
            </div>
        </div>

        @* Columns *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var column in _columnConfig)
            {
                var col = column;
                var columnItems = _feedback.Where(f => f.Status == col.Id).ToArray();
                <div>
                    @* Column header *@
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2.5">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@col.IconName" Size="14" Class="size-3.5" />
                        </span>
                        <span class="font-medium text-muted-foreground text-xs">@col.Title</span>
                        <span class="text-muted-foreground/60 text-xs">@columnItems.Length</span>
                    </div>

                    @* Feedback rows *@
                    <div>
                        @for (var i = 0; i < columnItems.Length; i++)
                        {
                            var item = columnItems[i];
                            var isLast = i == columnItems.Length - 1;
                            <div class="@Cn.Merge("flex items-start gap-2.5 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground">
                                    @item.UserInitials
                                </span>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-1.5">
                                        <span class="truncate font-medium text-sm">@item.User</span>
                                        <span class="@Cn.Merge("shrink-0 text-xs tabular-nums", RatingColor(item.Rating))">
                                            &#9733; @item.Rating.ToString("0.0")
                                        </span>
                                    </div>
                                    <p class="mt-0.5 line-clamp-1 text-muted-foreground text-xs">
                                        @item.Snippet
                                    </p>
                                </div>
                                <span class="mt-0.5 shrink-0 rounded bg-muted px-1.5 py-0.5 font-medium text-muted-foreground text-[10px]">
                                    @item.Category
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_feedback.Count(f => f.Status == "actioned") actioned this month
            </span>
            <span class="text-muted-foreground/60 text-xs">Last reviewed 8 min ago</span>
        </div>
    </div>
</section>

@code {
    private record FeedbackItem(string Id, string User, string UserInitials, double Rating, string Snippet, string Status, string Category);
    private record ColumnConfig(string Id, string Title, string IconName);

    private static readonly FeedbackItem[] _feedback =
    [
        new("1",  "Alex Rivera",   "AR", 4.5, "Love the new dashboard layout, much easier to find what I need",         "new",       "UX"),
        new("2",  "Jordan Park",   "JP", 2.0, "Export keeps failing on large datasets over 10k rows",                   "new",       "Bug"),
        new("3",  "Taylor Kim",    "TK", 3.5, "Would be great to have keyboard shortcuts for common actions",           "new",       "Feature"),
        new("4",  "Morgan Chen",   "MC", 1.5, "Mobile app crashes every time I open settings page",                    "new",       "Bug"),
        new("5",  "Casey Liu",     "CL", 5.0, "Best onboarding flow I have ever experienced, really smooth",           "reviewing", "UX"),
        new("6",  "Drew Santos",   "DS", 3.0, "Search results could be more relevant, lots of noise",                  "reviewing", "Feature"),
        new("7",  "Sam Patel",     "SP", 4.0, "Dark mode is great but some charts are hard to read",                   "reviewing", "UX"),
        new("8",  "Riley Ward",    "RW", 4.2, "Added team sharing — this was the top-voted request",                   "actioned",  "Feature"),
        new("9",  "Quinn Foster",  "QF", 2.5, "Fixed the slow loading on the analytics page, much better",             "actioned",  "Performance"),
        new("10", "Avery Nash",    "AN", 4.8, "The new notification settings give me exactly the control I wanted",    "actioned",  "Feature"),
    ];

    private static readonly ColumnConfig[] _columnConfig =
    [
        new("new",       "New",       "sparkles"),
        new("reviewing", "Reviewing", "eye"),
        new("actioned",  "Actioned",  "check-circle-2"),
    ];

    private string _avgRating => (_feedback.Sum(f => f.Rating) / _feedback.Length).ToString("0.0");

    private static string RatingColor(double rating)
    {
        if (rating >= 4) return "text-amber-600 dark:text-amber-400";
        if (rating >= 3) return "text-muted-foreground";
        return "text-red-600 dark:text-red-400";
    }
}
