@* ============================================================
   Block: kanban-multi-project
   Title: KanbanMultiProject
   Description: React swimlane kanban board for Next.js with project rows, planning status columns, and compact task chips using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-multi-project.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="folder-kanban" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Project Portfolio</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_projects.Length projects
                </BadgeCn>
            </div>
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layers" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">@_tasks.Length tasks total</span>
            </div>
        </div>

        @* Grid *@
        <div class="overflow-x-auto">
            @* Column headers *@
            <div class="grid grid-cols-[200px_1fr_1fr_1fr] border-b bg-muted/30">
                <div class="px-4 py-2.5">
                    <span class="font-medium text-muted-foreground text-xs">Project</span>
                </div>
                @foreach (var s in _statuses)
                {
                    <div class="border-l px-4 py-2.5">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-muted-foreground text-xs">@s.Label</span>
                            <span class="font-mono text-muted-foreground/60 text-xs">@TotalByStatus(s.Id)</span>
                        </div>
                    </div>
                }
            </div>

            @* Swimlane rows *@
            @foreach (var project in _projects)
            {
                var isLast = project.Id == _projects[_projects.Length - 1].Id;
                var projectTasks = _tasks.Where(t => t.Project == project.Id).ToArray();
                var completedCount = projectTasks.Count(t => t.Status == "complete");
                <div class="@Cn.Merge("grid grid-cols-[200px_1fr_1fr_1fr]", !isLast ? "border-b" : "")">
                    @* Project label *@
                    <div class="flex items-start gap-2.5 px-4 py-3">
                        <span class="@Cn.Merge("mt-1 size-2 shrink-0 rounded-full", project.Color)"></span>
                        <div class="min-w-0">
                            <span class="font-medium text-sm">@project.Name</span>
                            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                <span class="font-mono">@project.Code</span>
                                <span>·</span>
                                <span>@completedCount/@projectTasks.Length</span>
                            </div>
                        </div>
                    </div>

                    @* Status cells *@
                    @foreach (var s in _statuses)
                    {
                        var cellTasks = GetTasksForCell(project.Id, s.Id);
                        <div class="@Cn.Merge("border-l px-3 py-2.5", cellTasks.Length == 0 ? "bg-muted/20" : "")">
                            <div class="flex flex-col gap-1.5">
                                @if (cellTasks.Length == 0)
                                {
                                    <div class="rounded-md border border-dashed border-muted-foreground/20 px-2 py-1.5 text-center text-muted-foreground/40 text-xs">
                                        No tasks
                                    </div>
                                }
                                @foreach (var task in cellTasks)
                                {
                                    <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2 py-1 transition-colors hover:bg-muted">
                                        <span class="truncate text-xs">@task.Title</span>
                                        @if (task.Tag != null)
                                        {
                                            <span class="ml-auto shrink-0 font-mono text-[10px] text-muted-foreground">@task.Tag</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_projects.Length projects · @TotalByStatus("complete") of @_tasks.Length complete
            </span>
            <span class="font-mono text-muted-foreground/60 text-xs">
                @(Math.Round((double)TotalByStatus("complete") / _tasks.Length * 100))% done
            </span>
        </div>
    </div>
</section>

@code {
    private record Project(string Id, string Name, string Code, string Color);
    private record KanbanTask(string Id, string Title, string Project, string Status, string? Tag);
    private record Status(string Id, string Label);

    private static readonly Project[] _projects =
    [
        new("atlas",  "Atlas Platform",      "ATL", "bg-blue-500"),
        new("beacon", "Beacon Analytics",    "BCN", "bg-emerald-500"),
        new("cipher", "Cipher Security",     "CPH", "bg-amber-500"),
        new("delta",  "Delta Mobile",        "DLT", "bg-purple-500"),
        new("echo",   "Echo Integrations",   "ECH", "bg-red-500"),
    ];

    private static readonly Status[] _statuses =
    [
        new("planning", "Planning"),
        new("active",   "Active"),
        new("complete", "Complete"),
    ];

    private static readonly KanbanTask[] _tasks =
    [
        new("t1",  "Define API schema v2",       "atlas",  "planning", "Backend"),
        new("t2",  "User auth migration",         "atlas",  "active",   "Auth"),
        new("t3",  "Landing page redesign",       "atlas",  "complete", "Frontend"),
        new("t4",  "Dashboard wireframes",        "beacon", "planning", "Design"),
        new("t5",  "Event tracking pipeline",     "beacon", "active",   "Data"),
        new("t6",  "Funnel visualization",        "beacon", "active",   "Frontend"),
        new("t7",  "Penetration test scope",      "cipher", "planning", "Security"),
        new("t8",  "SSO implementation",          "cipher", "active",   "Auth"),
        new("t9",  "Audit log export",            "cipher", "complete", "Backend"),
        new("t10", "Push notification system",    "delta",  "planning", "Mobile"),
        new("t11", "Offline sync engine",         "delta",  "active",   "Mobile"),
        new("t12", "Webhook relay service",       "echo",   "complete", "Infra"),
    ];

    private KanbanTask[] GetTasksForCell(string project, string status) =>
        _tasks.Where(t => t.Project == project && t.Status == status).ToArray();

    private int TotalByStatus(string status) =>
        _tasks.Count(t => t.Status == status);
}
