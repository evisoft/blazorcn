@* ============================================================
   Block: kanban-risk-assessment
   Title: KanbanRiskAssessment
   Description: React risk assessment 2x2 matrix grid for Next.js with likelihood-impact quadrants, risk chips, and severity indicators using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-risk-assessment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-alert" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Risk Assessment Matrix</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_risks.Length risks
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var q in _quadrants)
                {
                    var qId = q.Id;
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", q.Dot)"></span>
                        @GetRiskCount(qId)
                    </span>
                }
            </div>
        </div>

        @* Axis labels *@
        <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Likelihood &rarr;</span>
            <span class="font-medium text-muted-foreground text-xs">&uarr; Impact</span>
        </div>

        @* 2x2 Grid *@
        <div class="grid grid-cols-2">
            @for (var qIndex = 0; qIndex < _quadrants.Length; qIndex++)
            {
                var q = _quadrants[qIndex];
                var qRisks = _risks.Where(r => r.Quadrant == q.Id).ToArray();
                var isTop = qIndex < 2;
                var isLeft = qIndex % 2 == 0;
                <div class="@Cn.Merge("min-h-[170px] p-3", q.Bg, isLeft ? "border-r" : "", isTop ? "border-b" : "")">
                    @* Quadrant label *@
                    <div class="mb-2.5 flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", q.Dot)"></span>
                        <span class="font-medium text-sm">@q.Label</span>
                        <span class="text-muted-foreground text-xs">@q.Description</span>
                    </div>

                    @* Risk chips *@
                    <div class="flex flex-col gap-1">
                        @foreach (var risk in qRisks)
                        {
                            <div class="flex items-center gap-2 rounded-md bg-card/80 px-2.5 py-1.5 transition-colors hover:bg-card">
                                <span class="min-w-0 flex-1 truncate text-xs">@risk.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-[10px] px-1.5 py-0">
                                    @risk.Category
                                </BadgeCn>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                4 quadrants · @_risks.Length total risks
            </span>
            <span class="text-muted-foreground text-xs">
                <span class="inline-flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @GetRiskCount("critical") critical
                </span>
            </span>
        </div>
    </div>
</section>

@code {
    private record QuadrantConfig(string Id, string Label, string Description, string Bg, string Dot);
    private record RiskItem(string Id, string Title, string Category, string Quadrant);

    private static readonly QuadrantConfig[] _quadrants =
    [
        new("critical", "Critical", "High Likelihood + High Impact",  "bg-red-500/5",     "bg-red-500"),
        new("monitor",  "Monitor",  "Low Likelihood + High Impact",   "bg-amber-500/5",   "bg-amber-500"),
        new("mitigate", "Mitigate", "High Likelihood + Low Impact",   "bg-blue-500/5",    "bg-blue-500"),
        new("accept",   "Accept",   "Low Likelihood + Low Impact",    "bg-emerald-500/5", "bg-emerald-500"),
    ];

    private static readonly RiskItem[] _risks =
    [
        new("r1",  "Supply chain single-vendor dependency",      "Operations", "critical"),
        new("r2",  "Ransomware attack on core systems",          "Cyber",      "critical"),
        new("r3",  "Key engineer attrition during migration",    "People",     "critical"),
        new("r4",  "Regulatory fine from GDPR non-compliance",   "Legal",      "monitor"),
        new("r5",  "Competitor launches disruptive product",     "Market",     "monitor"),
        new("r6",  "Data center natural disaster event",         "Infra",      "monitor"),
        new("r7",  "API rate limit exceeded during peak",        "Technical",  "mitigate"),
        new("r8",  "Third-party SDK deprecation notice",         "Technical",  "mitigate"),
        new("r9",  "Customer support backlog during launch",     "Operations", "mitigate"),
        new("r10", "Minor brand guideline inconsistency",        "Brand",      "accept"),
        new("r11", "Office lease renewal cost increase",         "Finance",    "accept"),
        new("r12", "Internal tool UI regression on edge case",   "Technical",  "accept"),
    ];

    private int GetRiskCount(string quadrant) => _risks.Count(r => r.Quadrant == quadrant);
}
