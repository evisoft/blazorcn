@* ============================================================
   Block: kanban-ui-components
   Title: KanbanUiComponents
   Description: React kanban board for component library management with color-coded left-border cards by component type, 3-column workflow using shadcn/ui and Tailwind CSS
   Source: original/blocks/kanban/kanban-ui-components.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layout-grid" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Component Library</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_components.Length components
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span>@_components.Count(c => c.Status == "published") published</span>
                <span class="text-muted-foreground/60">·</span>
                <span>@_components.Count(c => c.Status == "development") in dev</span>
            </div>
        </div>

        @* Color Legend *@
        <div class="flex items-center gap-4 border-b bg-muted/30 px-4 py-2">
            @foreach (var cat in _categories)
            {
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", cat.DotColor)"></span>
                    @cat.Label
                </span>
            }
        </div>

        @* Columns *@
        <div class="grid grid-cols-3 divide-x">
            @foreach (var col in _columns)
            {
                var colComponents = _components.Where(c => c.Status == col.Id).ToArray();
                <div>
                    <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2.5">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@col.IconName" Size="14" Class="size-3.5" />
                        </span>
                        <span class="font-medium text-muted-foreground text-xs">@col.Title</span>
                        <span class="text-muted-foreground/60 text-xs">@colComponents.Length</span>
                    </div>
                    <div class="p-2 space-y-1.5">
                        @foreach (var comp in colComponents)
                        {
                            var cat = GetCategoryConfig(comp.Category);
                            <div class="@Cn.Merge("rounded-md border border-l-4 bg-card px-3 py-2.5 transition-colors hover:bg-muted/50", cat.BorderColor)">
                                <div class="flex items-center gap-2">
                                    <div class="min-w-0 flex-1">
                                        <span class="block truncate font-medium text-sm">@comp.Title</span>
                                        <span class="text-muted-foreground text-xs">@comp.Meta</span>
                                    </div>
                                    <AvatarCn Class="size-6 shrink-0">
                                        <AvatarFallbackCn Class="text-[10px]">@comp.OwnerInitials</AvatarFallbackCn>
                                    </AvatarCn>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_components.Count(c => c.Status == "backlog") backlog · @_components.Count(c => c.Status == "development") developing · @_components.Count(c => c.Status == "published") published
            </span>
            <span class="text-muted-foreground/60 text-xs">Updated 3 min ago</span>
        </div>
    </div>
</section>

@code {
    private record ComponentItem(string Id, string Title, string Status, string Category, string Owner, string OwnerInitials, string Meta);
    private record CategoryConfig(string Id, string Label, string BorderColor, string DotColor);
    private record ColumnConfig(string Id, string Title, string IconName);

    private static readonly CategoryConfig[] _categories =
    [
        new("form",         "Form",         "border-l-blue-500",    "bg-blue-500"),
        new("navigation",   "Navigation",   "border-l-purple-500",  "bg-purple-500"),
        new("data-display", "Data Display", "border-l-amber-500",   "bg-amber-500"),
        new("feedback",     "Feedback",     "border-l-emerald-500", "bg-emerald-500"),
        new("layout",       "Layout",       "border-l-rose-500",    "bg-rose-500"),
    ];

    private static readonly ColumnConfig[] _columns =
    [
        new("backlog",     "Backlog",     "list"),
        new("development", "Development", "blocks"),
        new("published",   "Published",   "check-circle-2"),
    ];

    private static readonly ComponentItem[] _components =
    [
        new("uc1",  "Multi-step form wizard",        "backlog",     "form",         "Nora Blake",  "NB", "RFC drafted"),
        new("uc2",  "Command palette with search",   "backlog",     "navigation",   "Unassigned",  "??", "Requested"),
        new("uc3",  "Virtualized data table",        "backlog",     "data-display", "Eric Lau",    "EL", "10k+ rows"),
        new("uc4",  "Notification toast stack",      "backlog",     "feedback",     "Unassigned",  "??", "Auto-dismiss"),
        new("uc5",  "Responsive masonry grid",       "backlog",     "layout",       "Suki Tanaka", "ST", "CSS grid"),
        new("uc6",  "Date range picker",             "development", "form",         "Nora Blake",  "NB", "75% complete"),
        new("uc7",  "Breadcrumb with overflow menu", "development", "navigation",   "Jay Patel",   "JP", "A11y testing"),
        new("uc8",  "Skeleton loader variants",      "development", "feedback",     "Eric Lau",    "EL", "4 variants"),
        new("uc9",  "Sticky sidebar layout",         "development", "layout",       "Suki Tanaka", "ST", "Scroll sync"),
        new("uc10", "Select with autocomplete",      "published",   "form",         "Nora Blake",  "NB", "v2.0.1"),
        new("uc11", "Tab bar with indicators",       "published",   "navigation",   "Jay Patel",   "JP", "v1.3.0"),
        new("uc12", "Stat card with sparkline",      "published",   "data-display", "Eric Lau",    "EL", "v1.1.0"),
        new("uc13", "Inline alert banner",           "published",   "feedback",     "Suki Tanaka", "ST", "v1.0.0"),
        new("uc14", "Split pane resizable",          "published",   "layout",       "Jay Patel",   "JP", "v1.2.0"),
    ];

    private static CategoryConfig GetCategoryConfig(string category)
        => Array.Find(_categories, c => c.Id == category) ?? _categories[0];
}
