@* ============================================================
   Block: stepper-single-line
   Title: StepperSingleLine
   Description: A typography-only stepper where all steps appear on one line with checkmarks, strikethrough, and inline navigation built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-single-line.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Database migration</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                Step @(_activeStep + 1) of @_steps.Length
            </span>
        </div>

        @* Single-line step display *@
        <div class="border-b px-4 py-4">
            <div class="flex flex-wrap items-center gap-1 font-mono text-sm">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var isCompleted = index < _activeStep;
                    var isActive = index == _activeStep;
                    <span class="flex items-center gap-1">
                        @if (index > 0)
                        {
                            <span class="mx-1 text-muted-foreground/30 select-none">&rarr;</span>
                        }
                        @if (isCompleted)
                        {
                            var capturedIndex = index;
                            <button
                                type="button"
                                @onclick="@(() => SetActiveStep(capturedIndex))"
                                class="inline-flex items-center gap-1 text-muted-foreground/60 line-through decoration-muted-foreground/30 transition-colors hover:text-muted-foreground">
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500 no-underline" />
                                @stp.Label
                            </button>
                        }
                        else if (isActive)
                        {
                            <span class="font-semibold text-blue-600 dark:text-blue-400">@stp.Label</span>
                        }
                        else
                        {
                            <span class="text-muted-foreground/40">@stp.Label</span>
                        }
                    </span>
                }
            </div>
        </div>

        @* Active step content *@
        <div class="border-b px-4 py-4">
            <div class="mb-1">
                <span class="font-medium text-sm">@_steps[_activeStep].Heading</span>
            </div>
            <p class="text-muted-foreground text-sm leading-relaxed">
                @_steps[_activeStep].Description
            </p>
            <div class="mt-3 rounded-md bg-zinc-950 px-3 py-2">
                <code class="font-mono text-sm text-zinc-300">$ @_steps[_activeStep].Command</code>
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" Disabled="@(_activeStep == 0)" OnClick="HandleBack">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" Disabled="@(_activeStep == _steps.Length - 1)" OnClick="HandleNext">
                @(_activeStep == _steps.Length - 1 ? "Finish" : "Next")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Heading, string Description, string Command);

    private static readonly StepItem[] _steps =
    [
        new("Init", "Initialize database",
            "Create the PostgreSQL database instance and configure connection pooling. Sets up the database URL environment variable and verifies connectivity from the application server.",
            "bun db:init"),
        new("Schema", "Define schema",
            "Write the Prisma schema with all models, relations, and indexes. Includes User, Workspace, Session, and Purchase models with proper cascade deletes and unique constraints.",
            "bun db:generate"),
        new("Seed", "Seed data",
            "Populate the database with initial records for development. Creates sample users with different subscription tiers, workspaces with team members, and test transactions for Stripe integration testing.",
            "bun db:seed"),
        new("Migrate", "Run migrations",
            "Apply all pending migrations to synchronize the database schema with the Prisma models. Generates a timestamped migration file and runs it against the target environment.",
            "bun db:migrate"),
        new("Verify", "Verify integrity",
            "Run validation checks to confirm all tables exist, foreign keys are intact, and seed data is accessible. Executes a health check query on each model and reports any schema drift.",
            "bun db:verify"),
    ];

    private int _activeStep = 2;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void SetActiveStep(int index)
    {
        _activeStep = index;
    }
}
