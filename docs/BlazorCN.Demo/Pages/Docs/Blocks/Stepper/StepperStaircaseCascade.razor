@* ============================================================
   Block: stepper-staircase-cascade
   Title: StepperStaircaseCascade
   Description: A staircase cascade stepper with progressively indented steps, vertical dotted connectors, expandable detail panels, and status tracking built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-staircase-cascade.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Incident resolution</span>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Step <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
                </BadgeCn>
            </div>
        </div>

        @* Staircase *@
        <div class="border-b py-4">
            @foreach (var stp in _steps)
            {
                var idx = Array.IndexOf(_steps, stp);
                var isCompleted = idx < _activeStep;
                var isActive = idx == _activeStep;
                var isUpcoming = idx > _activeStep;
                var indent = idx * 32;
                <div>
                    @* Dotted connector from previous step *@
                    @if (idx > 0)
                    {
                        <div class="flex items-stretch" style="@($"padding-left:{indent - 16}px;")">
                            <div class="ml-4 flex w-8 justify-center">
                                <div class="@Cn.Merge("w-px border-l border-dashed transition-colors duration-300", isCompleted || isActive ? "border-emerald-500/50 dark:border-emerald-600/50" : "border-muted-foreground/20")"
                                     style="height:16px;"></div>
                            </div>
                        </div>
                    }

                    @* Stair row *@
                    <div style="@($"padding-left:{indent}px;")">
                        <button
                            type="button"
                            @onclick="@(() => HandleStepClick(idx))"
                            disabled="@(isUpcoming ? "disabled" : null)"
                            class="@Cn.Merge("mx-4 flex w-[calc(100%-2rem)] items-center gap-3 rounded-md px-3 py-2.5 text-left transition-all duration-200", isActive ? "bg-muted/50" : isCompleted ? "cursor-pointer hover:bg-muted/30" : "cursor-default opacity-60")">

                            @* Step number circle *@
                            <span class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full text-xs tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-blue-500 text-white dark:bg-blue-600" : "border border-muted-foreground/25 text-muted-foreground")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <span>@(idx + 1)</span>
                                }
                            </span>

                            @* Step info *@
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="@Cn.Merge("font-medium text-sm", isActive || isCompleted ? "text-foreground" : "text-muted-foreground")">
                                        @stp.Label
                                    </span>
                                    <span class="@Cn.Merge("rounded-full px-1.5 py-0.5 font-mono text-xs", isCompleted ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : isActive ? "bg-blue-500/10 text-blue-600 dark:text-blue-400" : "text-muted-foreground")">
                                        @stp.Status
                                    </span>
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-xs">@stp.Description</p>
                            </div>

                            @* Assignee *@
                            <span class="shrink-0 text-muted-foreground text-xs">@stp.Assignee</span>
                        </button>

                        @* Expanded detail for active step *@
                        @if (isActive)
                        {
                            <div class="mx-4 mt-1 rounded-md bg-muted/30 p-3" style="margin-left:56px;">
                                <p class="text-sm leading-relaxed">@stp.Detail</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeStep == 0)" OnClick="HandleBack">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeStep == _steps.Length - 1)" OnClick="HandleNext">
                @(_activeStep == _steps.Length - 1 ? "Close ticket" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Description, string Detail, string Status, string Assignee);

    private static readonly StepItem[] _steps =
    [
        new("Intake", "Receive and log the incoming request",
            "Request received via support portal. Ticket #SR-4821 created automatically. Customer details verified against CRM. Priority set based on SLA tier: Enterprise.",
            "Logged", "System"),
        new("Triage", "Assess urgency and categorize the issue",
            "Issue categorized as performance degradation. Impact analysis shows 12% of API requests affected. Severity elevated to P2 based on customer tier and blast radius.",
            "Assessed", "Sarah K."),
        new("Assignment", "Route to the appropriate team member",
            "Routed to backend engineering based on service ownership matrix. Assigned to senior engineer with relevant domain expertise. On-call notified as secondary.",
            "Routed", "Alex M."),
        new("Processing", "Investigate and implement the resolution",
            "Root cause identified: N+1 query in dashboard aggregation endpoint. Fix implemented with batch query optimization. Latency reduced from 2.3s to 180ms in staging.",
            "In progress", "Alex M."),
        new("Resolution", "Verify the fix and confirm with stakeholders",
            "Fix deployed to production via canary release. Monitoring confirms latency back to baseline. Customer notified with root cause summary and prevention measures.",
            "Pending", "Sarah K."),
        new("Closure", "Document findings and close the ticket",
            "Post-incident review documented. Query optimization added to engineering best practices. Automated alert configured to detect similar N+1 patterns in future.",
            "Pending", "System"),
    ];

    private int _activeStep = 3;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
