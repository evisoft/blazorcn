@* ============================================================
   Block: stepper-animated-transitions
   Title: StepperAnimatedTransitions
   Description: A multi-step wizard with smooth CSS transitions between steps featuring sliding content, animated step indicators, and scaling circle highlights built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-animated-transitions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Setup wizard</span>
            <span class="font-medium text-muted-foreground text-xs tabular-nums">
                Step @(_activeStep + 1) of @_steps.Length
            </span>
        </div>

        @* Step indicator with sliding highlight *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
                {
                    var idx = entry.Index;
                    var step = entry.Step;
                    var isActive = idx == _activeStep;
                    var isCompleted = idx < _activeStep;
                    var isLast = idx == _steps.Length - 1;

                    var circleWidth = isActive ? 40 : 32;
                    var circleHeight = isActive ? 40 : 32;
                    var circleBg = isCompleted
                        ? "var(--color-emerald-500)"
                        : isActive
                            ? "var(--color-foreground)"
                            : "transparent";
                    var circleColor = (isCompleted || isActive)
                        ? "var(--color-background)"
                        : "var(--color-muted-foreground)";
                    var circleBorder = (!isCompleted && !isActive)
                        ? "2px solid color-mix(in srgb, var(--color-muted-foreground) 30%, transparent)"
                        : "2px solid transparent";
                    var circleTransform = isActive ? "scale(1)" : "scale(0.85)";
                    var labelColor = isActive ? "var(--color-foreground)" : "var(--color-muted-foreground)";
                    var labelOpacity = isActive ? "1" : "0.7";
                    var lineWidth = idx < _activeStep ? "100%" : "0%";

                    var capturedIdx = idx;

                    <div class="flex flex-1 items-center @(isLast ? "last:flex-none" : "")">
                        <div class="flex flex-col items-center gap-2">
                            <button
                                type="button" aria-label="@($"Step {idx + 1}: {step.Label}")"
                                @onclick="@(() => NavigateTo(capturedIdx))"
                                class="group relative flex flex-col items-center gap-2">
                                <span
                                    class="flex items-center justify-center rounded-full transition-all duration-300 ease-out"
                                    style="@($"width:{circleWidth}px;height:{circleHeight}px;background-color:{circleBg};color:{circleColor};border:{circleBorder};transform:{circleTransform}")">
                                    @if (isCompleted)
                                    {
                                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                    }
                                    else
                                    {
                                        <span class="text-xs">
                                            <LucideIconCn Name="@step.IconName" Size="16" Class="size-4" />
                                        </span>
                                    }
                                </span>
                            </button>
                            <span
                                class="text-center font-medium text-xs transition-all duration-300"
                                style="@($"color:{labelColor};opacity:{labelOpacity}")">
                                @step.Label
                            </span>
                        </div>

                        @* Connecting line with fill animation *@
                        @if (!isLast)
                        {
                            <div class="mx-2 mb-7 h-0.5 flex-1 overflow-hidden rounded-full bg-muted-foreground/10">
                                <div
                                    class="h-full rounded-full bg-emerald-500 transition-all duration-500 ease-out"
                                    style="@($"width:{lineWidth}")">
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Overall progress bar *@
            <div class="mt-4 h-1 w-full overflow-hidden rounded-full bg-muted-foreground/10">
                <div
                    class="h-full rounded-full bg-foreground transition-all duration-500 ease-out"
                    style="@($"width:{_progressWidth}%")">
                </div>
            </div>
        </div>

        @* Animated content area *@
        <div class="relative overflow-hidden">
            <div
                class="px-4 py-5 transition-all duration-300 ease-out"
                style="@($"opacity:{(_isTransitioning ? "0" : "1")};transform:{(_isTransitioning ? (_direction == "forward" ? "translateX(-20px)" : "translateX(20px)") : "translateX(0)")}")">
                <div class="mb-1 flex items-center gap-2">
                    <span class="text-muted-foreground">
                        <LucideIconCn Name="@_steps[_displayStep].IconName" Size="16" Class="size-4" />
                    </span>
                    <span class="font-medium text-sm">@_steps[_displayStep].Title</span>
                </div>
                <p class="mb-4 text-muted-foreground text-xs">@_steps[_displayStep].Description</p>

                <div class="space-y-2">
                    @foreach (var fieldEntry in _steps[_displayStep].Fields.Select((f, i) => new { Field = f, Index = i }))
                    {
                        var fi = fieldEntry.Index;
                        var field = fieldEntry.Field;
                        var delay = _isTransitioning ? "0ms" : $"{fi * 50}ms";
                        var fieldOpacity = _isTransitioning ? "0" : "1";
                        var fieldTransform = _isTransitioning ? "translateY(8px)" : "translateY(0)";

                        <div
                            class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5 transition-all duration-300 ease-out"
                            style="@($"opacity:{fieldOpacity};transform:{fieldTransform};transition-delay:{delay}")">
                            <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                            <span class="text-sm">@field.Value</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>

            @* Dot indicators *@
            <div class="flex items-center gap-2">
                @foreach (var dotEntry in _steps.Select((s, i) => new { Step = s, Index = i }))
                {
                    var di = dotEntry.Index;
                    var dotWidth = di == _activeStep ? 16 : 6;
                    var dotBg = di == _activeStep
                        ? "var(--color-foreground)"
                        : di < _activeStep
                            ? "var(--color-emerald-500)"
                            : "color-mix(in srgb, var(--color-muted-foreground) 25%, transparent)";

                    <span
                        class="rounded-full transition-all duration-300 ease-out"
                        style="@($"width:{dotWidth}px;height:6px;background-color:{dotBg}")">
                    </span>
                }
            </div>

            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Finish" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepField(string Label, string Value);
    private record StepItem(string Label, string IconName, string Title, string Description, StepField[] Fields);

    private int _activeStep = 0;
    private string _direction = "forward";
    private bool _isTransitioning = false;
    private int _displayStep = 0;

    private double _progressWidth => _steps.Length > 1 ? (double)_activeStep / (_steps.Length - 1) * 100 : 0;

    private static readonly StepItem[] _steps =
    [
        new("Welcome", "sparkles", "Welcome to Acme",
            "Let's get your workspace set up in a few quick steps.",
            [
                new("Workspace", "acme-team"),
                new("Plan", "Team (5 seats)"),
                new("Region", "US East"),
            ]),
        new("Personalize", "user", "Personalize your experience",
            "Tell us a bit about how you work so we can tailor defaults.",
            [
                new("Role", "Engineering Manager"),
                new("Team size", "8 members"),
                new("Primary language", "TypeScript"),
                new("Framework", "Next.js"),
            ]),
        new("Connect", "link", "Connect your tools",
            "Link the services your team already uses.",
            [
                new("GitHub", "acme-org — Connected"),
                new("Slack", "#engineering — Connected"),
                new("Vercel", "acme-prod — Connected"),
                new("Linear", "Pending authorization"),
            ]),
        new("Ready", "rocket", "You're all set",
            "Your workspace is configured and ready to go.",
            [
                new("Workspace URL", "acme-team.app.acme.com"),
                new("Members invited", "5 of 8 accepted"),
                new("Integrations", "3 active, 1 pending"),
                new("First project", "Design System v3"),
            ]),
    ];

    private System.Threading.Timer? _timer;

    private void NavigateTo(int index)
    {
        if (index == _activeStep || _isTransitioning) return;
        _direction = index > _activeStep ? "forward" : "backward";
        _isTransitioning = true;
        _activeStep = index;

        _timer?.Dispose();
        _timer = new System.Threading.Timer(_ =>
        {
            _displayStep = index;
            _isTransitioning = false;
            InvokeAsync(StateHasChanged);
        }, null, 150, System.Threading.Timeout.Infinite);
    }

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
            NavigateTo(_activeStep + 1);
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
            NavigateTo(_activeStep - 1);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
