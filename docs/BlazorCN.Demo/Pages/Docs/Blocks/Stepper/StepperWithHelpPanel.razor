@* ============================================================
   Block: stepper-with-help-panel
   Title: StepperWithHelpPanel
   Description: A two-panel stepper wizard with vertical step navigation on the left and a contextual help sidebar on the right that displays step-specific tips, warnings, and documentation links built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-with-help-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-alert" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Integration setup</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Split layout *@
        <div class="flex">
            @* Left panel — stepper + content *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Step indicators *@
                <div class="flex-1 px-4 py-4">
                    <div class="mb-4 flex items-center gap-3">
                        @for (var i = 0; i < _steps.Length; i++)
                        {
                            var idx = i;
                            var stp = _steps[idx];
                            var isActive = idx == _activeStep;
                            var isCompleted = idx < _activeStep;
                            <div class="flex flex-1 items-center last:flex-none">
                                <button
                                    type="button"
                                    @onclick="@(() => _activeStep = idx)"
                                    class="flex flex-col items-center gap-1.5">
                                    <span class="@Cn.Merge("flex size-7 items-center justify-center rounded-full font-medium text-xs tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-foreground text-background" : "border-2 border-muted-foreground/25 text-muted-foreground")">
                                        @if (isCompleted)
                                        {
                                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                                        }
                                        else
                                        {
                                            <span>@(idx + 1)</span>
                                        }
                                    </span>
                                    <span class="@Cn.Merge("max-w-20 text-center text-xs leading-tight", isActive ? "font-medium text-foreground" : "text-muted-foreground")">
                                        @stp.Label
                                    </span>
                                </button>

                                @if (idx < _steps.Length - 1)
                                {
                                    <div class="mx-1.5 mb-6 h-0.5 flex-1 overflow-hidden rounded-full bg-muted-foreground/10">
                                        <div
                                            class="h-full rounded-full bg-emerald-500 transition-all duration-300"
                                            style="@ProgressWidth(idx)">
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @* Active step content *@
                    <div class="mb-4 h-px bg-border"></div>
                    <div>
                        <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
                        <p class="mt-0.5 mb-3 text-muted-foreground text-xs">
                            @_steps[_activeStep].Description
                        </p>
                        <div class="space-y-2">
                            @foreach (var fld in _steps[_activeStep].Fields)
                            {
                                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                                    <span class="font-medium text-muted-foreground text-xs">@fld.Label</span>
                                    <span class="@Cn.Merge("text-sm", fld.Mono ? "font-mono text-xs text-muted-foreground" : "")">
                                        @fld.Value
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* Navigation *@
                <div class="h-px bg-border"></div>
                <div class="flex items-center justify-between px-4 py-3">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                        <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                        Back
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                        @(_activeStep == _steps.Length - 1 ? "Go live" : "Continue")
                        @if (_activeStep < _steps.Length - 1)
                        {
                            <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                        }
                    </ButtonCn>
                </div>
            </div>

            @* Right panel — contextual help *@
            <div class="w-64 shrink-0 border-l bg-muted/20">
                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="book-open" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="font-medium text-xs">Help</span>
                    </div>
                </div>

                @* Help content *@
                <div class="border-b px-4 py-3">
                    <span class="mb-1 block font-medium text-xs">@CurrentHelp.Title</span>
                    <p class="text-muted-foreground text-xs leading-relaxed">@CurrentHelp.Summary</p>
                </div>

                @* Tips *@
                <div class="border-b px-4 py-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">
                        Tips and warnings
                    </span>
                    <div class="space-y-2.5">
                        @foreach (var tip in CurrentHelp.Tips)
                        {
                            <div class="flex items-start gap-2">
                                <span class="mt-0.5">
                                    <LucideIconCn Name="@TipIconName(tip.Icon)" Size="12" Class="@TipIconClass(tip.Icon)" />
                                </span>
                                <span class="text-xs leading-relaxed">@tip.Text</span>
                            </div>
                        }
                    </div>
                </div>

                @* Links *@
                <div class="px-4 py-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">
                        Documentation
                    </span>
                    <div class="space-y-1.5">
                        @foreach (var lnk in CurrentHelp.Links)
                        {
                            <div class="flex items-center gap-1.5 rounded-md px-2 py-1.5 transition-colors hover:bg-muted/50">
                                <LucideIconCn Name="external-link" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                                <span class="text-xs">@lnk.Label</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private enum TipIconType { Tip, Warning, Info }

    private record StepField(string Label, string Value, bool Mono = false);
    private record StepItem(string Label, string Description, StepField[] Fields);
    private record HelpTip(TipIconType Icon, string Text);
    private record HelpLink(string Label, string Href);
    private record HelpContentItem(string Title, string Summary, HelpTip[] Tips, HelpLink[] Links);

    private static readonly StepItem[] _steps =
    [
        new("API credentials", "Generate your API key and secret",
        [
            new("API key", "pk_live_a1b2c3d4e5f6", true),
            new("API secret", "sk_live_••••••••••••", true),
            new("Environment", "Production"),
            new("Rate limit", "1,000 req/min"),
        ]),
        new("Webhook setup", "Configure your webhook endpoint",
        [
            new("Endpoint URL", "https://acme.com/api/webhooks", true),
            new("Signing secret", "whsec_••••••••", true),
            new("Events", "12 event types selected"),
            new("Status", "Pending verification"),
        ]),
        new("Event filtering", "Choose which events to receive",
        [
            new("Payment events", "payment.created, payment.completed, payment.failed"),
            new("Customer events", "customer.created, customer.updated"),
            new("Subscription events", "subscription.created, subscription.canceled"),
            new("Delivery mode", "At least once"),
        ]),
        new("Testing", "Verify your integration works",
        [
            new("Test event sent", "payment.completed"),
            new("Response status", "200 OK"),
            new("Response time", "142ms"),
            new("Signature verified", "Valid"),
        ]),
    ];

    private static readonly HelpContentItem[] _helpContent =
    [
        new("API credentials",
            "Your API keys authenticate requests to the platform. Keep your secret key confidential and never expose it in client-side code.",
        [
            new(TipIconType.Warning, "Never commit API keys to version control. Use environment variables instead."),
            new(TipIconType.Tip, "Use test mode keys (pk_test_) during development. Switch to live keys only in production."),
            new(TipIconType.Info, "Rate limits apply per API key. Contact support to increase limits for high-volume use cases."),
            new(TipIconType.Tip, "Rotate your secret key every 90 days as a security best practice."),
        ],
        [
            new("Authentication guide", "#"),
            new("API key best practices", "#"),
            new("Rate limiting reference", "#"),
        ]),
        new("Webhook configuration",
            "Webhooks deliver real-time event notifications to your server. Your endpoint must respond with a 2xx status within 30 seconds.",
        [
            new(TipIconType.Warning, "Always verify webhook signatures to prevent replay attacks and spoofed events."),
            new(TipIconType.Tip, "Return a 200 response immediately, then process the event asynchronously in a background job."),
            new(TipIconType.Info, "Failed deliveries are retried 5 times with exponential backoff over 24 hours."),
            new(TipIconType.Warning, "Your endpoint must be publicly accessible. Localhost URLs are not supported in production."),
        ],
        [
            new("Webhook security guide", "#"),
            new("Handling retries", "#"),
            new("Signature verification", "#"),
        ]),
        new("Event filtering",
            "Subscribe only to the events your integration needs. Fewer event types means less noise and lower processing overhead.",
        [
            new(TipIconType.Tip, "Start with just the events you need. You can add more later without re-creating the webhook."),
            new(TipIconType.Info, "Event payloads include a type field so you can route events to different handlers in your code."),
            new(TipIconType.Tip, "Use wildcard subscriptions (payment.*) during development to see all available event data."),
            new(TipIconType.Warning, "Some events are high-frequency. Subscribing to all events in production may overwhelm your server."),
        ],
        [
            new("Event types catalog", "#"),
            new("Event payload reference", "#"),
            new("Filtering strategies", "#"),
        ]),
        new("Integration testing",
            "Send test events to verify your endpoint handles webhooks correctly before going live. Test mode uses simulated data that mirrors production payloads.",
        [
            new(TipIconType.Tip, "Use the CLI tool to send test events locally: acme webhook test --event payment.completed"),
            new(TipIconType.Info, "Test events have an is_test: true field so your handler can distinguish them from real events."),
            new(TipIconType.Tip, "Check response times. Endpoints slower than 5 seconds may experience timeout issues in production."),
            new(TipIconType.Warning, "Ensure your handler is idempotent. The same event may be delivered more than once."),
        ],
        [
            new("Testing CLI reference", "#"),
            new("Idempotency guide", "#"),
            new("Troubleshooting webhooks", "#"),
        ]),
    ];

    private int _activeStep = 1;

    private HelpContentItem CurrentHelp => _helpContent[_activeStep];

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1) _activeStep++;
    }

    private void HandleBack()
    {
        if (_activeStep > 0) _activeStep--;
    }

    private string ProgressWidth(int idx) => idx < _activeStep ? "width:100%;" : "width:0%;";

    private static string TipIconName(TipIconType icon) => icon switch
    {
        TipIconType.Warning => "alert-triangle",
        TipIconType.Info => "info",
        _ => "lightbulb"
    };

    private static string TipIconClass(TipIconType icon) => icon switch
    {
        TipIconType.Warning => "size-3 shrink-0 text-red-500",
        TipIconType.Info => "size-3 shrink-0 text-blue-500",
        _ => "size-3 shrink-0 text-amber-500"
    };
}
