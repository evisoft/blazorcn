@* ============================================================
   Block: stepper-responsive-adaptive
   Title: StepperResponsiveAdaptive
   Description: A dual-layout stepper showing horizontal and vertical formats simultaneously with synchronized navigation, layout comparison, and adaptive design built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-responsive-adaptive.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Adaptive stepper</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Horizontal layout *@
        <div class="border-b px-4 py-4">
            <div class="mb-2 flex items-center gap-1.5">
                <LucideIconCn Name="monitor" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Desktop layout</span>
            </div>

            <div class="rounded-md border border-dashed border-muted-foreground/20 px-4 py-5">
                <div class="flex items-center justify-between">
                    @for (var i = 0; i < _steps.Length; i++)
                    {
                        var idx = i;
                        var stp = _steps[i];
                        var isActive = idx == _activeStep;
                        var isCompleted = idx < _activeStep;
                        <div class="flex flex-1 items-center last:flex-none">
                            <div class="flex flex-col items-center gap-2">
                                <button
                                    type="button" aria-label="@($"Step {idx + 1}: {stp.Label}")"
                                    @onclick="@(() => _activeStep = idx)"
                                    class="relative">
                                    <span class="@Cn.Merge("flex size-9 items-center justify-center rounded-full font-medium text-xs tabular-nums transition-all duration-300", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-foreground text-background ring-4 ring-foreground/10" : "border-2 border-muted-foreground/25 text-muted-foreground")">
                                        @if (isCompleted)
                                        {
                                            <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                        }
                                        else
                                        {
                                            <span>@(idx + 1)</span>
                                        }
                                    </span>
                                </button>
                                <span class="@Cn.Merge("max-w-16 text-center text-xs leading-tight transition-colors duration-200", isActive ? "font-medium text-foreground" : "text-muted-foreground")">
                                    @stp.Label
                                </span>
                            </div>

                            @if (idx < _steps.Length - 1)
                            {
                                <div class="mx-2.5 mb-7 h-0.5 flex-1 overflow-hidden rounded-full bg-muted-foreground/10">
                                    <div
                                        class="h-full rounded-full bg-emerald-500 transition-all duration-500 ease-out"
                                        style="@($"width:{(idx < _activeStep ? "100%" : "0%")}")">
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Vertical layout (mobile preview) *@
        <div class="border-b px-4 py-4">
            <div class="mb-2 flex items-center gap-1.5">
                <LucideIconCn Name="smartphone" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Mobile layout</span>
            </div>

            <div class="rounded-md border border-dashed border-muted-foreground/20 p-4">
                <div class="space-y-0">
                    @for (var i = 0; i < _steps.Length; i++)
                    {
                        var idx = i;
                        var stp = _steps[i];
                        var isActive = idx == _activeStep;
                        var isCompleted = idx < _activeStep;
                        var isLast = idx == _steps.Length - 1;
                        <div class="flex gap-3">
                            @* Vertical line + circle *@
                            <div class="flex flex-col items-center">
                                <button
                                    type="button" aria-label="@($"Step {idx + 1}: {stp.Label}")"
                                    @onclick="@(() => _activeStep = idx)"
                                    class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full font-medium text-xs tabular-nums transition-all duration-300", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-foreground text-background" : "border-2 border-muted-foreground/25 text-muted-foreground")">
                                    @if (isCompleted)
                                    {
                                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                                    }
                                    else
                                    {
                                        <span>@(idx + 1)</span>
                                    }
                                </button>
                                @if (!isLast)
                                {
                                    <div class="my-1 w-0.5 flex-1 rounded-full bg-muted-foreground/10">
                                        <div
                                            class="w-full rounded-full bg-emerald-500 transition-all duration-500"
                                            style="@($"height:{(idx < _activeStep ? "100%" : "0%")}")">
                                        </div>
                                    </div>
                                }
                            </div>

                            @* Content *@
                            <div class="@Cn.Merge("min-w-0 flex-1", isLast ? "pb-0" : "pb-4")">
                                <span class="@Cn.Merge("block font-medium text-xs transition-colors duration-200", isActive ? "text-foreground" : "text-muted-foreground")">
                                    @stp.Label
                                </span>
                                <span class="block text-muted-foreground text-xs opacity-70">
                                    @stp.Description
                                </span>
                                @if (isActive)
                                {
                                    <div class="mt-2 rounded-md bg-muted/50 px-3 py-2">
                                        <span class="text-xs leading-relaxed">@stp.Detail</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Active step content *@
        <div class="border-b px-4 py-4">
            <div class="mb-1">
                <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
            </div>
            <p class="mb-3 text-muted-foreground text-xs">@_steps[_activeStep].Description</p>
            <div class="rounded-md bg-muted/50 px-3 py-2.5">
                <span class="text-sm leading-relaxed">@_steps[_activeStep].Detail</span>
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeStep == 0)" OnClick="HandleBack">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>

            <div class="flex items-center gap-1.5">
                @for (var i = 0; i < _steps.Length; i++)
                {
                    var idx = i;
                    <span class="@Cn.Merge("size-1.5 rounded-full transition-all duration-300", idx == _activeStep ? "bg-foreground" : idx < _activeStep ? "bg-emerald-500" : "bg-muted-foreground/25")"></span>
                }
            </div>

            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeStep == _steps.Length - 1)" OnClick="HandleNext">
                @(_activeStep == _steps.Length - 1 ? "Complete" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Description, string Detail);

    private static readonly StepItem[] _steps =
    [
        new("Account", "Create your credentials", "Email, password, and two-factor authentication setup"),
        new("Profile", "Personal information", "Display name, avatar, bio, and timezone preferences"),
        new("Settings", "Workspace configuration", "Theme, notifications, language, and default project"),
        new("Done", "Setup complete", "Review your configuration and start using the platform"),
    ];

    private int _activeStep = 1;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }
}
