@* ============================================================
   Block: stepper-account-setup
   Title: StepperAccountSetup
   Description: A split-panel account creation wizard with vertical sidebar steps and contextual form content for credentials, profile, preferences, and welcome built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-account-setup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex">
            @* Sidebar *@
            <div class="w-56 shrink-0 border-r">
                <div class="border-b px-4 py-3">
                    <div class="font-medium text-sm">Account setup</div>
                    <p class="text-muted-foreground text-xs tabular-nums">
                        @_completed.Count of @_steps.Length complete
                    </p>
                </div>

                <div class="py-1">
                    @foreach (var stp in _steps)
                    {
                        var stepId = stp.Id;
                        var isActive = _activeStep == stepId;
                        var isCompleted = _completed.Contains(stepId);
                        <button
                            type="button"
                            @onclick="@(() => _activeStep = stepId)"
                            class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors", isActive ? "bg-muted/50" : "hover:bg-muted/30")">
                            <span class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full transition-colors", isCompleted ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : isActive ? "bg-foreground text-background" : "bg-muted text-muted-foreground")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideIconCn Name="@stp.IconName" Size="14" Class="size-3.5" />
                                }
                            </span>
                            <div class="min-w-0 flex-1">
                                <div class="@Cn.Merge("truncate text-xs font-medium", isActive ? "text-foreground" : "text-muted-foreground")">
                                    @stp.Label
                                </div>
                                <div class="truncate text-muted-foreground/60 text-[10px]">
                                    @stp.Description
                                </div>
                            </div>
                        </button>
                    }
                </div>

                @* Sidebar footer progress *@
                <div class="border-t px-4 py-3">
                    <div class="flex h-1.5 gap-1">
                        @foreach (var stp in _steps)
                        {
                            var stepId = stp.Id;
                            var isCompleted = _completed.Contains(stepId);
                            var isActive = _activeStep == stepId;
                            <span class="@Cn.Merge("flex-1 rounded-full transition-colors", isCompleted ? "bg-emerald-500" : isActive ? "bg-foreground/30" : "bg-muted")"></span>
                        }
                    </div>
                </div>
            </div>

            @* Content panel *@
            <div class="flex flex-1 flex-col">
                @* Content header *@
                <div class="flex items-center justify-between border-b px-6 py-4">
                    <div>
                        <div class="font-medium text-sm">@ActiveContent.Title</div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@ActiveContent.Subtitle</p>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                        Step <span class="tabular-nums">@(ActiveIndex + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
                    </BadgeCn>
                </div>

                @* Fields *@
                <div class="flex-1 px-6 py-4">
                    <div class="space-y-2">
                        @foreach (var field in ActiveContent.Fields)
                        {
                            <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                                <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                                <span class="@Cn.Merge("text-sm", field.Masked ? "tracking-wider text-muted-foreground" : "")">
                                    @field.Value
                                </span>
                            </div>
                        }
                    </div>

                    @* Completed step summaries *@
                    @if (_activeStep != "credentials" && _completed.Count > 0)
                    {
                        <div class="mt-4 space-y-1.5">
                            <span class="text-muted-foreground text-xs">Completed steps</span>
                            @foreach (var stp in _steps)
                            {
                                var stepId = stp.Id;
                                @if (_completed.Contains(stepId))
                                {
                                    <div class="flex items-center gap-2 rounded-md px-3 py-1.5">
                                        <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                                        <span class="text-muted-foreground text-xs">@stp.Label</span>
                                        <span class="text-muted-foreground/50 text-xs">— @_stepContent[stepId].Fields[0].Value</span>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>

                @* Content footer *@
                <div class="flex items-center justify-between border-t px-6 py-3">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(ActiveIndex == 0)" OnClick="HandleBack">
                        Previous
                    </ButtonCn>
                    @if (_activeStep == "welcome")
                    {
                        <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="HandleGoToDashboard">
                            Go to dashboard
                        </ButtonCn>
                    }
                    else
                    {
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="MarkCompleteAndNext">
                            Save &amp; continue
                        </ButtonCn>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Id, string Label, string Description, string IconName);
    private record FieldItem(string Label, string Value, bool Masked = false);
    private record StepContent(string Title, string Subtitle, FieldItem[] Fields);

    private static readonly StepItem[] _steps =
    [
        new("credentials", "Credentials", "Email and password", "key"),
        new("profile", "Profile", "Your personal details", "user"),
        new("preferences", "Preferences", "Customize your experience", "settings"),
        new("welcome", "Welcome", "You are all set", "rocket"),
    ];

    private static readonly Dictionary<string, StepContent> _stepContent = new()
    {
        ["credentials"] = new StepContent(
            "Create your account",
            "Enter your email and choose a secure password.",
            [
                new("Email address", "alex.chen@company.com"),
                new("Password", "••••••••••••", true),
                new("Confirm password", "••••••••••••", true),
            ]),
        ["profile"] = new StepContent(
            "Your profile",
            "Tell us a bit about yourself.",
            [
                new("Full name", "Alex Chen"),
                new("Job title", "Product Designer"),
                new("Company", "Meridian Labs"),
                new("Location", "San Francisco, CA"),
            ]),
        ["preferences"] = new StepContent(
            "Preferences",
            "Customize how you use the platform.",
            [
                new("Theme", "System default"),
                new("Language", "English (US)"),
                new("Email notifications", "Weekly digest"),
                new("Two-factor auth", "Enabled via authenticator"),
            ]),
        ["welcome"] = new StepContent(
            "Welcome aboard, Alex",
            "Your account is ready. Here is a summary of your setup.",
            [
                new("Account", "alex.chen@company.com"),
                new("Name", "Alex Chen"),
                new("Role", "Product Designer at Meridian Labs"),
                new("Security", "2FA enabled"),
            ]),
    };

    private string _activeStep = "credentials";
    private readonly HashSet<string> _completed = [];

    private int ActiveIndex => Array.FindIndex(_steps, s => s.Id == _activeStep);
    private StepContent ActiveContent => _stepContent[_activeStep];

    private void MarkCompleteAndNext()
    {
        _completed.Add(_activeStep);
        var nextIndex = ActiveIndex + 1;
        if (nextIndex < _steps.Length)
        {
            _activeStep = _steps[nextIndex].Id;
        }
    }

    private void HandleBack()
    {
        var idx = ActiveIndex;
        if (idx > 0)
        {
            _activeStep = _steps[idx - 1].Id;
        }
    }

    private void HandleGoToDashboard()
    {
        _completed.Add(_activeStep);
    }
}
