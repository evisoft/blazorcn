@* ============================================================
   Block: stepper-size-weighted
   Title: StepperSizeWeighted
   Description: A horizontal stepper with proportionally sized step circles reflecting task complexity, time estimates, connecting lines, and active step highlighting built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-size-weighted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Project setup</span>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs tabular-nums">
                    @ProgressPercent% effort complete
                </span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Step @(_activeStep + 1)/@_steps.Length
                </BadgeCn>
            </div>
        </div>

        @* Weighted progress bar *@
        <div class="h-1 w-full bg-muted">
            <div
                class="h-full bg-blue-500 transition-all duration-500 ease-out dark:bg-blue-400"
                style="@($"width:{ProgressPercent}%")"
            />
        </div>

        @* Size-weighted stepper *@
        <div class="border-b px-6 py-8">
            <div class="flex items-center justify-between">
                @foreach (var stp in _steps)
                {
                    var idx = Array.IndexOf(_steps, stp);
                    var isCompleted = idx < _activeStep;
                    var isActive = idx == _activeStep;
                    var isUpcoming = idx > _activeStep;
                    var circleClass = _sizeMap[stp.Weight].Circle;
                    var textClass = _sizeMap[stp.Weight].Text;
                    var checkClass = _sizeMap[stp.Weight].Check;
                    var checkSize = stp.Weight == 1 ? 14 : stp.Weight == 2 ? 16 : 20;
                    <div class="flex flex-1 items-center justify-center last:flex-none first:justify-start last:justify-end">
                        <div class="flex flex-col items-center gap-2">
                            @* Weighted circle *@
                            <button
                                type="button" aria-label="@($"Step {idx + 1}: {stp.Label}")"
                                @onclick="@(() => HandleStepClick(idx))"
                                disabled="@(isUpcoming ? "disabled" : null)"
                                class="@Cn.Merge("flex shrink-0 items-center justify-center rounded-full font-medium tabular-nums transition-all duration-300", circleClass, textClass, isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600 cursor-pointer" : isActive ? "bg-blue-500 text-white ring-4 ring-blue-500/20 shadow-lg shadow-blue-500/15 dark:bg-blue-600 dark:ring-blue-400/20 cursor-pointer" : "border-2 border-muted-foreground/20 text-muted-foreground cursor-default")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="@checkSize" Class="@checkClass" />
                                }
                                else
                                {
                                    <span>@(idx + 1)</span>
                                }
                            </button>

                            @* Label and time *@
                            <div class="flex flex-col items-center text-center">
                                <span class="@Cn.Merge("text-xs", isActive ? "font-medium text-foreground" : isCompleted ? "text-foreground/70" : "text-muted-foreground")">
                                    @stp.Label
                                </span>
                                <span class="mt-0.5 text-muted-foreground text-xs tabular-nums">
                                    @stp.TimeEstimate
                                </span>
                            </div>
                        </div>

                        @* Connecting line *@
                        @if (idx < _steps.Length - 1)
                        {
                            <div class="mx-2 mb-10 h-0.5 flex-1">
                                <div class="@Cn.Merge("h-full rounded-full transition-colors duration-300", idx < _activeStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/15")"></div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Weight legend *@
            <div class="mt-6 flex items-center justify-center gap-4">
                @foreach (var w in new[] { 1, 2, 3 })
                {
                    var legendLabel = w == 1 ? "Light" : w == 2 ? "Medium" : "Heavy";
                    var dotSize = w == 1 ? "size-2" : w == 2 ? "size-3" : "size-4";
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("rounded-full border border-muted-foreground/20", dotSize)"></span>
                        @legendLabel
                    </span>
                }
            </div>
        </div>

        @* Step content *@
        <div class="border-b px-4 py-4">
            <div class="mb-1 flex items-center gap-2">
                <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Weight: @_steps[_activeStep].Weight/@TotalWeight
                </BadgeCn>
            </div>
            <p class="mb-3 text-muted-foreground text-xs">@_steps[_activeStep].Description</p>
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-sm leading-relaxed">@_steps[_activeStep].Detail</p>
            </div>
        </div>

        @* Footer navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" Disabled="@(_activeStep == 0)" OnClick="HandleBack">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" Disabled="@(_activeStep == _steps.Length - 1)" OnClick="HandleNext">
                @(_activeStep == _steps.Length - 1 ? "Deploy" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, int Weight, string TimeEstimate, string Description, string Detail);

    private static readonly Dictionary<int, (string Circle, string Text, string Check)> _sizeMap = new()
    {
        { 1, ("size-8", "text-xs", "size-3.5") },
        { 2, ("size-11", "text-sm", "size-4") },
        { 3, ("size-14", "text-base", "size-5") },
    };

    private static readonly StepItem[] _steps =
    [
        new("Quick setup", 1, "~1 min", "Name and initialize your project",
            "Enter a project name, choose a region, and initialize the repository. This step auto-detects your framework and suggests optimal default settings."),
        new("Data entry", 3, "~10 min", "Configure schemas, fields, and relationships",
            "Define your data models, set up field types and validations, configure relationships between entities, and import any existing data. This is the most complex step — take your time to get the schema right."),
        new("Review", 2, "~5 min", "Validate configuration and preview",
            "Review all configured settings, data models, and relationships. Preview the generated API endpoints and admin interface. Run automated checks to catch potential issues before deployment."),
        new("Approval", 1, "~1 min", "Confirm and deploy to production",
            "Final confirmation before deploying. Review the summary of all changes, acknowledge the deployment scope, and trigger the production build pipeline."),
    ];

    private static int TotalWeight => _steps.Sum(s => s.Weight);

    private int _activeStep = 1;

    private int ProgressPercent
    {
        get
        {
            var completed = _steps.Take(_activeStep).Sum(s => s.Weight);
            return (int)Math.Round((double)completed / TotalWeight * 100);
        }
    }

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
