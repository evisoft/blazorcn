@* ============================================================
   Block: stepper-compact-inline
   Title: StepperCompactInline
   Description: A single-line inline stepper with text-based navigation, step counter, and arrow controls built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-compact-inline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Inline navigation — the core of this component *@
        <div class="flex items-center border-b px-2 py-2.5">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 shrink-0 p-0" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
            </ButtonCn>

            <div class="flex min-w-0 flex-1 items-center justify-center gap-2">
                <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 font-medium text-muted-foreground text-[11px] tabular-nums">
                    @(_activeStep + 1)/@_steps.Length
                </span>
                <span class="truncate font-medium text-sm">@_steps[_activeStep].Title</span>
            </div>

            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 shrink-0 p-0" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
            </ButtonCn>
        </div>

        @* Content *@
        <div class="border-b px-6 py-6">
            <div class="mx-auto max-w-md">
                <span class="font-medium text-sm">@_steps[_activeStep].Heading</span>
                <p class="mt-2 text-muted-foreground text-sm leading-relaxed">
                    @_steps[_activeStep].Description
                </p>
            </div>
        </div>

        @* Fields *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                @foreach (var field in _steps[_activeStep].Fields)
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                        <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                        <span class="text-sm">@field.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Footer action *@
        <div class="flex items-center justify-between px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @(_activeStep == _steps.Length - 1
                    ? "All steps complete"
                    : $"{_steps.Length - 1 - _activeStep} steps remaining")
            </span>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Submit" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FieldItem(string Label, string Value);
    private record StepItem(string Title, string Heading, string Description, FieldItem[] Fields);

    private static readonly StepItem[] _steps =
    [
        new("Email", "Enter your email",
            "We will use this as your primary login and for sending account notifications. You can add more emails later from your settings.",
        [
            new("Email", "alex@example.com"),
            new("Verified", "Pending verification"),
        ]),
        new("Name", "Your display name",
            "This is how you will appear to other team members in comments, mentions, and shared documents. Use your real name for easy identification.",
        [
            new("First name", "Alex"),
            new("Last name", "Johnson"),
        ]),
        new("Password", "Create a password",
            "Choose a strong password with at least 12 characters. Include a mix of uppercase, lowercase, numbers, and symbols for maximum security.",
        [
            new("Strength", "Strong"),
            new("Requirements", "12+ chars, mixed case"),
        ]),
        new("Preferences", "Set your preferences",
            "Configure your default workspace theme, notification preferences, and language. All settings sync across your devices automatically.",
        [
            new("Theme", "System"),
            new("Notifications", "Email + push"),
            new("Language", "English (US)"),
        ]),
        new("Done", "Account ready",
            "Your account is fully configured. You can start creating projects, inviting collaborators, and exploring templates right away.",
        [
            new("Account", "Active"),
            new("Plan", "Free tier"),
        ]),
    ];

    private int _activeStep = 1;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }
}
