@* ============================================================
   Block: stepper-compact-card
   Title: StepperCompactCard
   Description: A small-footprint card stepper widget with dot indicators, micro-navigation buttons, and contextual step content built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-compact-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="mx-auto max-w-sm overflow-hidden rounded-lg border bg-card">
        @* Header with dots *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            @* Dot indicators *@
            <div class="flex items-center gap-1.5">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var isCompleted = index < _activeStep;
                    var isActive = index == _activeStep;
                    <button
                        type="button"
                        @onclick="@(() => { if (index <= _activeStep) _activeStep = index; })"
                        disabled="@(index > _activeStep)"
                        class="@Cn.Merge("shrink-0 rounded-full transition-all duration-300", isActive ? "h-2 w-5 bg-blue-500 dark:bg-blue-400" : isCompleted ? "size-2 cursor-pointer bg-emerald-500 hover:bg-emerald-600 dark:bg-emerald-400" : "size-2 cursor-default bg-muted-foreground/20")">
                    </button>
                }
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                @(_activeStep + 1)/@_steps.Length
            </BadgeCn>
        </div>

        @* Step content *@
        <div class="border-b px-4 py-5">
            <div class="mb-1 flex items-center gap-2">
                <span class="font-medium text-xs text-muted-foreground uppercase tracking-wider">
                    @CurrentStep.Label
                </span>
            </div>
            <h3 class="font-medium text-sm">@CurrentStep.Title</h3>
            <p class="mt-1.5 text-muted-foreground text-xs leading-relaxed">
                @CurrentStep.Description
            </p>

            @* Detail value *@
            <div class="mt-4 flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2.5">
                @if (_isLastStep)
                {
                    <LucideIconCn Name="check" Size="14" Class="size-3.5 shrink-0 text-emerald-500" />
                }
                else
                {
                    <span class="size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                }
                <span class="font-medium text-sm">@CurrentStep.Detail</span>
            </div>
        </div>

        @* Footer with micro-navigation *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="12" Class="size-3" />
                Back
            </ButtonCn>

            @* Step labels as text *@
            <span class="text-muted-foreground/60 text-xs">@CurrentStep.Label</span>

            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" OnClick="HandleNext" Disabled="@_isLastStep">
                @(_isLastStep ? "Done" : "Next")
                @if (!_isLastStep)
                {
                    <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Title, string Description, string Detail);

    private static readonly StepItem[] _steps =
    [
        new("Name", "What should we call you?", "Your display name across the platform.", "Morgan Chen"),
        new("Email", "Your email address", "Used for notifications and account recovery.", "morgan@acme.com"),
        new("Role", "Select your role", "Helps us personalize your experience.", "Full-stack developer"),
        new("Done", "You are all set", "Your profile is ready. Welcome aboard.", "Account activated"),
    ];

    private int _activeStep = 1;

    private StepItem CurrentStep => _steps[_activeStep];
    private bool _isLastStep => _activeStep == _steps.Length - 1;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }
}
