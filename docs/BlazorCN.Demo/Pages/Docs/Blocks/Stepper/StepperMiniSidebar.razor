@* ============================================================
   Block: stepper-mini-sidebar
   Title: StepperMiniSidebar
   Description: A narrow sidebar stepper with numbered circles connected by a vertical line, hover tooltips, and a wide content panel built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-mini-sidebar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Workspace setup</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @(_activeStep + 1)/@(_steps.Length)
            </span>
        </div>

        <div class="flex">
            @* Mini sidebar rail *@
            <div class="flex w-14 shrink-0 flex-col items-center border-r py-4">
                @foreach (var stepItem in _steps)
                {
                    var index = Array.IndexOf(_steps, stepItem);
                    var isCompleted = index < _activeStep;
                    var isActive = index == _activeStep;
                    var isLast = index == _steps.Length - 1;
                    var capturedIndex = index;
                    <div class="relative flex flex-col items-center">
                        @* Step circle *@
                        <div class="group relative">
                            <button
                                type="button"
                                @onclick="@(() => _activeStep = capturedIndex)"
                                @onmouseenter="@(() => _hoveredStep = capturedIndex)"
                                @onmouseleave="@(() => _hoveredStep = null)"
                                class="@Cn.Merge("relative z-10 flex size-8 items-center justify-center rounded-full text-xs font-medium tabular-nums transition-all", isCompleted ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 cursor-pointer" : isActive ? "bg-blue-500/10 text-blue-600 ring-1 ring-blue-500/30 dark:text-blue-400 dark:ring-blue-400/30" : "bg-muted text-muted-foreground/50 cursor-pointer hover:text-muted-foreground")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    @(index + 1)
                                }
                            </button>

                            @* Hover tooltip *@
                            @if (_hoveredStep == capturedIndex)
                            {
                                <span class="pointer-events-none absolute top-1/2 left-full z-20 ml-2 -translate-y-1/2 whitespace-nowrap rounded-md bg-foreground px-2 py-1 text-background text-xs">
                                    @stepItem.Label
                                </span>
                            }
                        </div>

                        @* Connecting line *@
                        @if (!isLast)
                        {
                            <div class="@Cn.Merge("h-4 w-px", index < _activeStep ? "bg-emerald-500/30" : index == _activeStep ? "bg-blue-500/20" : "bg-border")"></div>
                        }
                    </div>
                }
            </div>

            @* Content panel *@
            <div class="flex flex-1 flex-col">
                @* Step heading *@
                <div class="border-b px-5 py-4">
                    <div class="font-medium text-sm">@_steps[_activeStep].Title</div>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_steps[_activeStep].Description</p>
                </div>

                @* Step fields *@
                <div class="flex-1 px-5 py-3">
                    @for (int fi = 0; fi < _steps[_activeStep].Fields.Length; fi++)
                    {
                        var field = _steps[_activeStep].Fields[fi];
                        var isLastField = fi == _steps[_activeStep].Fields.Length - 1;
                        <div class="@Cn.Merge("flex items-center justify-between py-2.5", !isLastField ? "border-b" : "")">
                            <span class="text-muted-foreground text-xs">@field.Label</span>
                            <span class="font-medium text-sm">@field.Value</span>
                        </div>
                    }
                </div>

                @* Footer navigation *@
                <div class="flex items-center justify-between border-t px-5 py-3">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                        <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                        Back
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                        @(_activeStep == _steps.Length - 1 ? "Launch" : "Continue")
                        @if (_activeStep < _steps.Length - 1)
                        {
                            <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                        }
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record StepField(string Label, string Value);
    private record StepItem(string Id, string Label, string Title, string Description, StepField[] Fields);

    private int _activeStep = 2;
    private int? _hoveredStep = null;

    private static readonly StepItem[] _steps =
    [
        new("workspace", "Workspace", "Create workspace", "Set up your team workspace with a name and URL slug.",
        [
            new("Workspace name", "Acme Inc"),
            new("URL", "acme.app.com"),
            new("Plan", "Team (5 seats)"),
        ]),
        new("members", "Members", "Invite members", "Add your team members and assign their roles.",
        [
            new("Admin", "sarah@acme.com"),
            new("Developer", "alex@acme.com"),
            new("Developer", "jordan@acme.com"),
        ]),
        new("integrations", "Integrations", "Connect tools", "Link your existing tools for seamless workflows.",
        [
            new("Source control", "GitHub"),
            new("Communication", "Slack"),
            new("Issue tracking", "Linear"),
        ]),
        new("security", "Security", "Security settings", "Configure authentication and access policies.",
        [
            new("SSO provider", "Google Workspace"),
            new("2FA requirement", "Required for admins"),
            new("Session timeout", "7 days"),
        ]),
        new("billing", "Billing", "Billing details", "Set up payment method and billing information.",
        [
            new("Payment method", "Visa ending 4242"),
            new("Billing email", "billing@acme.com"),
            new("Billing cycle", "Yearly"),
        ]),
        new("launch", "Launch", "Launch workspace", "Review your settings and activate the workspace.",
        [
            new("Status", "Ready to launch"),
            new("Members notified", "3 invitations queued"),
            new("Estimated setup", "Under 1 minute"),
        ]),
    ];

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1) _activeStep++;
    }

    private void HandleBack()
    {
        if (_activeStep > 0) _activeStep--;
    }
}
