@* ============================================================
   Block: stepper-clickable-jump
   Title: StepperClickableJump
   Description: A non-linear horizontal stepper with click-to-jump navigation, visited step tracking, and direct access to any step built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-clickable-jump.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Project workflow</span>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_visitedSteps.Count of @_steps.Length visited
                </span>
            </div>
        </div>

        @* Stepper — clickable jump navigation *@
        <div class="border-b px-4 py-5">
            <div class="flex items-center justify-between">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var isActive = index == _activeStep;
                    var isVisited = _visitedSteps.Contains(index) && !isActive;
                    <div class="flex flex-1 items-center last:flex-none">
                        @* Step circle + label *@
                        <div class="flex flex-col items-center gap-2">
                            <button
                                type="button"
                                @onclick="@(() => HandleStepClick(index))"
                                class="@Cn.Merge("relative flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-full font-medium text-xs tabular-nums transition-all duration-200", isActive ? "bg-blue-500 text-white ring-2 ring-blue-500 ring-offset-2 ring-offset-card dark:bg-blue-600 dark:ring-blue-400" : isVisited ? "bg-foreground/10 text-foreground dark:bg-foreground/20" : "border-2 border-muted-foreground/20 text-muted-foreground")">
                                @if (isVisited)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <span>@(index + 1)</span>
                                }

                                @* Visited indicator dot *@
                                @if (isVisited)
                                {
                                    <span class="absolute -top-0.5 -right-0.5 size-2.5 rounded-full border-2 border-card bg-emerald-500"></span>
                                }
                            </button>
                            <span class="@Cn.Merge("max-w-16 text-center font-medium text-xs leading-tight", isActive ? "text-foreground" : "text-muted-foreground")">
                                @stp.Label
                            </span>
                        </div>

                        @* Connecting line *@
                        @if (index < _steps.Length - 1)
                        {
                            <div class="mx-1.5 mb-6 h-0.5 flex-1">
                                <div class="@Cn.Merge("h-full rounded-full transition-colors duration-300", _visitedSteps.Contains(index) && _visitedSteps.Contains(index + 1) ? "bg-foreground/20" : "bg-muted-foreground/15")"></div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Hint *@
            <p class="mt-4 text-center text-muted-foreground text-xs">
                Click any step to jump directly — no sequential order required
            </p>
        </div>

        @* Step content *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <div>
                    <span class="font-medium text-sm">@Current.Label</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@Current.Description</p>
                </div>
                @if (_visitedSteps.Contains(_activeStep))
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        Visited
                    </BadgeCn>
                }
            </div>
            <div class="space-y-2">
                @foreach (var field in Current.Content)
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                        <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                        <span class="text-right text-sm">@field.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Complete" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FieldItem(string Label, string Value);
    private record StepItem(string Label, string Description, FieldItem[] Content);

    private static readonly StepItem[] _steps =
    [
        new("Overview", "Project scope and objectives",
        [
            new("Project name", "Design System v3"),
            new("Objective", "Unify component library across 4 products"),
            new("Timeline", "Q2 2026 — 12 weeks"),
        ]),
        new("Requirements", "Functional and technical needs",
        [
            new("Core components", "48 primitives, 120 compositions"),
            new("Framework support", "React 19, Next.js 16"),
            new("Accessibility", "WCAG 2.2 AA compliance"),
        ]),
        new("Design", "Visual language and tokens",
        [
            new("Design tokens", "Colors, spacing, typography, radii"),
            new("Figma library", "Auto-synced with code via Tokens Studio"),
            new("Theme support", "Light, dark, and high-contrast modes"),
        ]),
        new("Implementation", "Development and code review",
        [
            new("Build system", "Turborepo + tsup bundling"),
            new("Testing", "Vitest unit + Playwright visual regression"),
            new("Documentation", "Fumadocs MDX with live previews"),
        ]),
        new("Testing", "QA and user acceptance",
        [
            new("Unit coverage", "94% statement coverage"),
            new("Visual regression", "1,200 snapshots across 3 viewports"),
            new("a11y audit", "Zero critical issues, 2 minor warnings"),
        ]),
        new("Release", "Versioning and rollout",
        [
            new("Version", "3.0.0 (semver major)"),
            new("Changelog", "48 new components, 12 breaking changes"),
            new("Migration guide", "Codemod + step-by-step docs"),
        ]),
    ];

    private int _activeStep = 2;
    private HashSet<int> _visitedSteps = [0, 1, 2];

    private StepItem Current => _steps[_activeStep];

    private void HandleStepClick(int index)
    {
        _activeStep = index;
        _visitedSteps.Add(index);
    }

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            HandleStepClick(_activeStep + 1);
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            HandleStepClick(_activeStep - 1);
        }
    }
}
