@* ============================================================
   Block: stepper-building-blocks
   Title: StepperBuildingBlocks
   Description: A vertical stacking block stepper where completed steps form solid blocks, the active step shows a placement outline, and upcoming steps are ghosted above built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-building-blocks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layers" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Build progress</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Layer <span class="tabular-nums">@(_currentBlock + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Building blocks tower *@
        <div class="border-b px-4 py-6">
            <div class="mx-auto max-w-sm">
                @* Blocks — rendered top to bottom (last step at top) *@
                <div class="flex flex-col gap-1.5">
                    @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }).Reverse())
                    {
                        var index = entry.Index;
                        var step = entry.Step;
                        var isCompleted = index < _currentBlock;
                        var isActive = index == _currentBlock;
                        var isUpcoming = index > _currentBlock;

                        <button
                            type="button"
                            @onclick="@(() => SetBlock(index))"
                            class="@Cn.Merge("group relative flex items-center gap-3 rounded-md px-4 py-3 text-left transition-all duration-300", isCompleted ? "cursor-pointer border border-emerald-500/30 bg-emerald-500/8 hover:bg-emerald-500/12 dark:border-emerald-600/30 dark:bg-emerald-600/8" : isActive ? "cursor-pointer border-2 border-blue-500 bg-blue-500/5 shadow-sm shadow-blue-500/10 dark:border-blue-400 dark:bg-blue-500/8" : "cursor-pointer border border-dashed border-muted-foreground/15 bg-transparent opacity-50 hover:opacity-70")"
                            style="@(isActive ? "transform:translateX(4px)" : "transform:none")">

                            @* Block number / check *@
                            <div class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded transition-all duration-300", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-blue-500 text-white dark:bg-blue-600" : "border border-muted-foreground/20 text-muted-foreground")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <span class="font-medium text-xs tabular-nums">@(index + 1)</span>
                                }
                            </div>

                            @* Label *@
                            <div class="min-w-0 flex-1">
                                <span class="@Cn.Merge("font-medium text-sm", isActive ? "text-foreground" : isUpcoming ? "text-muted-foreground/60" : "text-foreground")">
                                    @step.Label
                                </span>
                                <p class="@Cn.Merge("mt-0.5 text-xs", isUpcoming ? "text-muted-foreground/40" : "text-muted-foreground")">
                                    @step.Description
                                </p>
                            </div>

                            @* Status indicator *@
                            @if (isActive)
                            {
                                <div class="flex items-center gap-1.5">
                                    <span class="size-1.5 rounded-full bg-blue-500 dark:bg-blue-400"></span>
                                    <span class="text-muted-foreground text-xs">Placing</span>
                                </div>
                            }
                            @if (isCompleted)
                            {
                                <span class="text-muted-foreground text-xs">Built</span>
                            }
                        </button>
                    }
                </div>

                @* Foundation base *@
                <div class="mt-2 flex items-center justify-center rounded-md border-2 border-muted-foreground/10 bg-muted/30 px-4 py-1.5">
                    <span class="font-mono text-muted-foreground/50 text-xs tracking-widest uppercase">
                        Ground level
                    </span>
                </div>
            </div>
        </div>

        @* Block detail *@
        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <span class="font-medium text-sm">@_steps[_currentBlock].Label</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@_steps[_currentBlock].Description</p>
            </div>
            <div class="rounded-md bg-muted/50 p-3">
                <span class="font-medium text-muted-foreground text-xs">Deliverables</span>
                <p class="mt-1 text-sm leading-relaxed">@_steps[_currentBlock].Detail</p>
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_currentBlock == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Previous
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_currentBlock == _steps.Length - 1)">
                @(_currentBlock == _steps.Length - 1 ? "Complete" : "Place next")
                @if (_currentBlock < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record BuildStep(string Label, string Description, string Detail);

    private int _currentBlock = 2;

    private static readonly BuildStep[] _steps =
    [
        new("Foundation", "Infrastructure and base setup", "Database provisioned, CI/CD pipeline configured, environment variables set"),
        new("Structure", "Core architecture and data models", "API layer built, authentication integrated, data models migrated"),
        new("Interior", "Features and business logic", "Dashboard complete, user management ready, notification system live"),
        new("Finishing", "Polish and optimization", "Performance tuned, accessibility reviewed, responsive design verified"),
        new("Inspection", "Testing and final approval", "QA passed, security audit clean, stakeholder sign-off received"),
    ];

    private void HandleNext()
    {
        if (_currentBlock < _steps.Length - 1)
        {
            _currentBlock++;
        }
    }

    private void HandleBack()
    {
        if (_currentBlock > 0)
        {
            _currentBlock--;
        }
    }

    private void SetBlock(int index)
    {
        _currentBlock = index;
    }
}
