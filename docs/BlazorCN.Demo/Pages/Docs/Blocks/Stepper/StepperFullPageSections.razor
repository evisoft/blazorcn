@* ============================================================
   Block: stepper-full-page-sections
   Title: StepperFullPageSections
   Description: A full-height scrollable section stepper with sticky dot navigation, section dividers, and step content built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-full-page-sections.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Sticky dot nav *@
        <div class="sticky top-0 z-10 flex items-center justify-between border-b bg-card/95 px-4 py-3 backdrop-blur-sm">
            <span class="font-medium text-sm">Getting started</span>
            <div class="flex items-center gap-3">
                @for (int i = 0; i < _sections.Length; i++)
                {
                    var sec = _sections[i];
                    var index = i;
                    var isActive = _activeSection == index;
                    var isCompleted = _completed.Contains(index);
                    <button type="button" aria-label="@($"Step {index + 1}: {sec.Label}")" @onclick="@(() => _activeSection = index)" class="group flex items-center gap-1.5">
                        <span class="@Cn.Merge("flex size-5 items-center justify-center rounded-full text-xs font-medium tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white" : isActive ? "ring-2 ring-blue-500 ring-offset-1 ring-offset-card bg-blue-500 text-white" : "bg-muted text-muted-foreground group-hover:bg-muted-foreground/20")">
                            @if (isCompleted)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                            }
                            else
                            {
                                @(index + 1)
                            }
                        </span>
                        <span class="@Cn.Merge("hidden text-xs sm:inline", isActive ? "font-medium text-foreground" : "text-muted-foreground")">
                            @sec.Label
                        </span>
                    </button>
                }
            </div>
        </div>

        @* Scrollable sections *@
        <div class="max-h-[520px] overflow-y-auto">
            @for (int i = 0; i < _sections.Length; i++)
            {
                var sec = _sections[i];
                var index = i;
                var isActive = _activeSection == index;
                var isCompleted = _completed.Contains(index);

                <div>
                    @* Section divider with step number *@
                    @if (index > 0)
                    {
                        <div class="flex items-center gap-3 px-4">
                            <div class="h-px flex-1 bg-border"></div>
                            <span class="font-medium text-muted-foreground/40 text-xs tabular-nums">@(index + 1)/@(_sections.Length)</span>
                            <div class="h-px flex-1 bg-border"></div>
                        </div>
                    }

                    @* Section content *@
                    <div class="@Cn.Merge("px-4 py-6 transition-opacity duration-200", isActive ? "opacity-100" : "opacity-50")">
                        <div class="mb-1 flex items-center gap-2.5">
                            <span class="@(isActive ? "text-foreground" : "text-muted-foreground")">
                                <LucideIconCn Name="@sec.IconName" Size="16" Class="size-4" />
                            </span>
                            <span class="font-medium text-sm">@sec.Title</span>
                            @if (isCompleted)
                            {
                                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                            }
                        </div>
                        <p class="mb-4 pl-[26px] text-muted-foreground text-xs">@sec.Description</p>

                        <div class="pl-[26px]">
                            @for (int j = 0; j < sec.Content.Length; j++)
                            {
                                var item = sec.Content[j];
                                var itemIndex = j;
                                <div class="@Cn.Merge("flex items-center justify-between py-2", itemIndex < sec.Content.Length - 1 ? "border-b" : "")">
                                    <span class="text-muted-foreground text-xs">@item.Label</span>
                                    <span class="font-medium text-sm">@item.Value</span>
                                </div>
                            }
                        </div>

                        @if (isActive && !isCompleted)
                        {
                            <div class="mt-4 pl-[26px]">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@(() => MarkComplete(index))">
                                    @(index < _sections.Length - 1 ? "Continue" : "Finish setup")
                                </ButtonCn>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer progress *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @_completed.Count of @_sections.Length completed
            </span>
            <div class="flex items-center gap-1">
                @for (int i = 0; i < _sections.Length; i++)
                {
                    var index = i;
                    var isCompleted = _completed.Contains(index);
                    var isCurrentActive = _activeSection == index;
                    <div class="@Cn.Merge("h-1 rounded-full transition-colors duration-300", isCompleted ? "bg-emerald-500" : isCurrentActive ? "bg-blue-500" : "bg-muted-foreground/15")" style="width:32px"></div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ContentItem(string Label, string Value);
    private record SectionItem(string Id, string Label, string IconName, string Title, string Description, ContentItem[] Content);

    private static readonly SectionItem[] _sections =
    [
        new("welcome", "Welcome", "sparkles",
            "Welcome to Acme",
            "Let's get your account set up in a few quick steps. This should take about 3 minutes.",
            [
                new("Platform", "Acme Cloud Pro"),
                new("Plan", "Team (5 seats)"),
                new("Trial period", "14 days remaining"),
                new("Support", "Priority email + chat"),
            ]),
        new("about", "About you", "user",
            "Tell us about yourself",
            "This helps us personalize your experience and recommend the right features.",
            [
                new("Full name", "Jordan Rivera"),
                new("Role", "Engineering Manager"),
                new("Company", "Acme Corp"),
                new("Team size", "12-25 people"),
                new("Experience", "3+ years with similar tools"),
            ]),
        new("goals", "Your goals", "target",
            "What are your goals?",
            "Select the outcomes that matter most so we can tailor your dashboard.",
            [
                new("Primary goal", "Improve deployment speed"),
                new("Secondary goal", "Reduce downtime"),
                new("Key metric", "Mean time to recovery"),
                new("Integration", "GitHub + Slack + PagerDuty"),
                new("Timeline", "Results within 30 days"),
            ]),
        new("plan", "Your plan", "rocket",
            "Here's your plan",
            "Based on your inputs, we've generated a personalized getting-started plan.",
            [
                new("Week 1", "Connect repos and configure CI/CD"),
                new("Week 2", "Set up monitoring and alerts"),
                new("Week 3", "Onboard team members"),
                new("Week 4", "Review metrics and optimize"),
                new("Milestone", "First deployment under 5 minutes"),
            ]),
    ];

    private int _activeSection = 0;
    private readonly HashSet<int> _completed = [];

    private void MarkComplete(int index)
    {
        _completed.Add(index);
        if (index < _sections.Length - 1)
        {
            _activeSection = index + 1;
        }
    }
}
