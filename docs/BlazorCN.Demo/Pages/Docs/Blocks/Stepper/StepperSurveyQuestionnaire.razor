@* ============================================================
   Block: stepper-survey-questionnaire
   Title: StepperSurveyQuestionnaire
   Description: A one-question-per-step survey stepper with selectable answer cards, progress tracking, and focused question layout built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-survey-questionnaire.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Developer Survey</span>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">
                    <span class="tabular-nums">@_selectedAnswers.Count</span> of <span class="tabular-nums">@_questions.Length</span> answered
                </span>
            </div>
        </div>

        @* Progress bar *@
        <div class="h-1 w-full bg-muted">
            <div
                class="h-full bg-foreground transition-all duration-500"
                style="@(FormattableString.Invariant($"width:{((_currentQuestion + 1.0) / _questions.Length) * 100}%"))">
            </div>
        </div>

        @* Question *@
        <div class="border-b px-4 py-5">
            <div class="mb-1 flex items-center gap-2">
                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                    Q@(_currentQuestion + 1)
                </span>
                <span class="text-muted-foreground text-xs">/</span>
                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                    @_questions.Length
                </span>
            </div>
            <h2 class="font-medium text-sm">@_questions[_currentQuestion].Question</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                @_questions[_currentQuestion].Subtitle
            </p>
        </div>

        @* Answer options *@
        <div class="border-b px-4 py-4">
            <div class="space-y-2">
                @foreach (var answer in _questions[_currentQuestion].Answers)
                {
                    var answerIdx = Array.IndexOf(_questions[_currentQuestion].Answers, answer);
                    var capturedIdx = answerIdx;
                    int selVal;
                    var isSelected = _selectedAnswers.TryGetValue(_currentQuestion, out selVal) && selVal == answerIdx;
                    <button
                        type="button"
                        @onclick="@(() => HandleSelectAnswer(capturedIdx))"
                        class="@Cn.Merge("flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left transition-all duration-150", isSelected ? "bg-foreground/5 ring-1 ring-foreground/20" : "bg-muted/50 hover:bg-muted/80")">
                        <div
                            class="@Cn.Merge("flex size-5 shrink-0 items-center justify-center rounded-full border transition-all duration-150", isSelected ? "border-foreground bg-foreground" : "border-muted-foreground/30")">
                            @if (isSelected)
                            {
                                <LucideIconCn Name="check-circle" Size="12" Class="size-3 text-background" />
                            }
                        </div>
                        <span class="@Cn.Merge("text-sm", isSelected ? "font-medium" : "text-muted-foreground")">
                            @answer
                        </span>
                    </button>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_currentQuestion == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Previous
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(!_selectedAnswers.ContainsKey(_currentQuestion) || _currentQuestion == _questions.Length - 1)">
                @(_currentQuestion == _questions.Length - 1 ? "Submit survey" : "Next question")
                @if (_currentQuestion < _questions.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record QuestionItem(string Question, string Subtitle, string[] Answers);

    private static readonly QuestionItem[] _questions =
    [
        new("How did you first hear about us?",
            "Select the option that best describes how you found us",
            ["Search engine (Google, Bing)", "Social media (Twitter, LinkedIn)", "Recommendation from a colleague", "Blog post or article", "Developer conference or meetup"]),
        new("What is your primary role?",
            "This helps us tailor our product to your needs",
            ["Frontend developer", "Full-stack developer", "Design engineer", "Product manager", "Engineering manager"]),
        new("How large is your development team?",
            "Including both full-time and contract developers",
            ["Solo developer", "2-5 people", "6-20 people", "21-100 people", "100+ people"]),
        new("Which framework do you primarily use?",
            "Select your main production framework",
            ["Next.js", "Remix", "Astro", "Vite + React", "Other"]),
        new("What feature matters most to you?",
            "Choose the capability you value the highest",
            ["Pre-built UI components", "Design system consistency", "Performance optimization", "Accessibility compliance", "Developer experience"]),
        new("How likely are you to recommend us?",
            "Based on your experience so far",
            ["Extremely likely", "Very likely", "Somewhat likely", "Not very likely", "Too early to say"]),
    ];

    private int _currentQuestion = 0;
    private Dictionary<int, int> _selectedAnswers = new() { [0] = 2 };

    private void HandleSelectAnswer(int answerIndex)
    {
        _selectedAnswers[_currentQuestion] = answerIndex;
    }

    private void HandleNext()
    {
        if (_currentQuestion < _questions.Length - 1)
        {
            _currentQuestion++;
        }
    }

    private void HandleBack()
    {
        if (_currentQuestion > 0)
        {
            _currentQuestion--;
        }
    }
}
