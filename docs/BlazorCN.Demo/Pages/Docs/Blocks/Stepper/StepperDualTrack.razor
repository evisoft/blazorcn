@* ============================================================
   Block: stepper-dual-track
   Title: StepperDualTrack
   Description: A dual-track parallel stepper with synchronized frontend and backend tracks, horizontal bridge connectors, and a merged deployment step built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-dual-track.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Parallel development</span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="tabular-nums">@TotalCompleted</span> completed
                </span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    <span class="tabular-nums">@(TotalStepsCount - TotalCompleted)</span> remaining
                </BadgeCn>
            </div>
        </div>

        @* Dual tracks *@
        <div class="border-b px-6 py-6">
            @* Track headers *@
            <div class="mb-4 grid grid-cols-[1fr_80px_1fr] gap-0">
                <div class="text-center">
                    <span class="font-medium text-xs text-muted-foreground uppercase tracking-wider">
                        @_tracks[0].Name
                    </span>
                </div>
                <div></div>
                <div class="text-center">
                    <span class="font-medium text-xs text-muted-foreground uppercase tracking-wider">
                        @_tracks[1].Name
                    </span>
                </div>
            </div>

            @* Track rows *@
            @for (int rowIndex = 0; rowIndex < _tracks[0].Steps.Length; rowIndex++)
            {
                var ri = rowIndex;
                var leftStep = _tracks[0].Steps[ri];
                var rightStep = _tracks[1].Steps[ri];
                var leftCompleted = ri < _activeSteps[0];
                var leftActive = ri == _activeSteps[0];
                var leftUpcoming = ri > _activeSteps[0];
                var rightCompleted = ri < _activeSteps[1];
                var rightActive = ri == _activeSteps[1];
                var rightUpcoming = ri > _activeSteps[1];
                var bridgeComplete = leftCompleted && rightCompleted;

                <div>
                    <div class="grid grid-cols-[1fr_80px_1fr] items-center gap-0">
                        @* Left track step *@
                        <button
                            type="button"
                            @onclick="@(() => HandleStepClick(0, ri))"
                            disabled="@leftUpcoming"
                            class="@Cn.Merge("flex items-center gap-2.5 rounded-md px-3 py-2.5 text-left transition-colors", _selectedTrack == 0 && _selectedStep == ri ? "bg-muted/50" : leftUpcoming ? "cursor-default opacity-50" : "cursor-pointer hover:bg-muted/30")">
                            <span class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full text-xs tabular-nums transition-all duration-200", leftCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : leftActive ? "bg-blue-500 text-white dark:bg-blue-600" : "border border-muted-foreground/25 text-muted-foreground")">
                                @if (leftCompleted)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <span>@(ri + 1)</span>
                                }
                            </span>
                            <div class="min-w-0 flex-1">
                                <span class="@Cn.Merge("block font-medium text-sm", leftActive || leftCompleted ? "text-foreground" : "text-muted-foreground")">
                                    @leftStep.Label
                                </span>
                                <span class="block text-muted-foreground text-xs">
                                    @leftStep.Description
                                </span>
                            </div>
                        </button>

                        @* Bridge connector *@
                        <div class="flex flex-col items-center justify-center">
                            <div class="@Cn.Merge("h-px w-full transition-colors duration-300", bridgeComplete ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/15")"></div>
                            <span class="@Cn.Merge("mt-1 text-center font-mono text-muted-foreground leading-tight", bridgeComplete ? "text-xs" : "text-xs opacity-50")" style="font-size:9px">
                                @_bridgeLabels[ri]
                            </span>
                        </div>

                        @* Right track step *@
                        <button
                            type="button"
                            @onclick="@(() => HandleStepClick(1, ri))"
                            disabled="@rightUpcoming"
                            class="@Cn.Merge("flex items-center gap-2.5 rounded-md px-3 py-2.5 text-left transition-colors", _selectedTrack == 1 && _selectedStep == ri ? "bg-muted/50" : rightUpcoming ? "cursor-default opacity-50" : "cursor-pointer hover:bg-muted/30")">
                            <span class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full text-xs tabular-nums transition-all duration-200", rightCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : rightActive ? "bg-blue-500 text-white dark:bg-blue-600" : "border border-muted-foreground/25 text-muted-foreground")">
                                @if (rightCompleted)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <span>@(ri + 1)</span>
                                }
                            </span>
                            <div class="min-w-0 flex-1">
                                <span class="@Cn.Merge("block font-medium text-sm", rightActive || rightCompleted ? "text-foreground" : "text-muted-foreground")">
                                    @rightStep.Label
                                </span>
                                <span class="block text-muted-foreground text-xs">
                                    @rightStep.Description
                                </span>
                            </div>
                        </button>
                    </div>

                    @* Vertical connectors between rows *@
                    @if (ri < _tracks[0].Steps.Length - 1)
                    {
                        <div class="grid grid-cols-[1fr_80px_1fr] gap-0">
                            <div class="flex justify-center py-1">
                                <div class="@Cn.Merge("h-4 w-px transition-colors duration-300", leftCompleted ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/15")"></div>
                            </div>
                            <div></div>
                            <div class="flex justify-center py-1">
                                <div class="@Cn.Merge("h-4 w-px transition-colors duration-300", rightCompleted ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/15")"></div>
                            </div>
                        </div>
                    }
                </div>
            }

            @* Merge connectors *@
            <div class="grid grid-cols-[1fr_80px_1fr] gap-0">
                <div class="flex justify-center py-1">
                    <div class="@Cn.Merge("h-6 w-px transition-colors duration-300", MergeReady ? "bg-emerald-500/50" : "bg-muted-foreground/15")"></div>
                </div>
                <div></div>
                <div class="flex justify-center py-1">
                    <div class="@Cn.Merge("h-6 w-px transition-colors duration-300", MergeReady ? "bg-emerald-500/50" : "bg-muted-foreground/15")"></div>
                </div>
            </div>

            @* Diagonal merge lines via SVG *@
            <div class="relative flex justify-center">
                <svg width="100%" height="24" viewBox="0 0 400 24" preserveAspectRatio="none" fill="none">
                    <title>Merge connector lines</title>
                    <line x1="100" y1="0" x2="200" y2="24" stroke="@MergeLineStroke" stroke-width="1" opacity="@MergeLineOpacity" />
                    <line x1="300" y1="0" x2="200" y2="24" stroke="@MergeLineStroke" stroke-width="1" opacity="@MergeLineOpacity" />
                </svg>
            </div>

            @* Merge step *@
            <div class="flex justify-center">
                <div class="@Cn.Merge("flex items-center gap-2.5 rounded-md px-4 py-2.5 transition-colors", MergeReady ? "bg-muted/50" : "opacity-50")">
                    <span class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full transition-all duration-200", MergeReady ? "bg-foreground text-background" : "border border-muted-foreground/25 text-muted-foreground")">
                        <LucideIconCn Name="git-merge" Size="16" Class="size-4" />
                    </span>
                    <div>
                        <span class="@Cn.Merge("block font-medium text-sm", MergeReady ? "text-foreground" : "text-muted-foreground")">
                            @_mergeStep.Label
                        </span>
                        <span class="block text-muted-foreground text-xs">@_mergeStep.Description</span>
                    </div>
                </div>
            </div>
        </div>

        @* Selected step detail *@
        @if (_selectedTrack != null && _selectedStep != null)
        {
            <div class="border-b px-4 py-3">
                <div class="rounded-md bg-muted/50 p-3">
                    <div class="mb-1 flex items-center gap-2">
                        <span class="font-medium text-xs text-muted-foreground uppercase tracking-wider">
                            @_tracks[_selectedTrack.Value].Name
                        </span>
                        <span class="text-muted-foreground text-xs">·</span>
                        <span class="font-medium text-sm">
                            @_tracks[_selectedTrack.Value].Steps[_selectedStep.Value].Label
                        </span>
                    </div>
                    <p class="text-muted-foreground text-xs">
                        @_tracks[_selectedTrack.Value].Steps[_selectedStep.Value].Description
                    </p>
                    <div class="mt-2 flex items-center gap-2">
                        <span class="@GetStatusBadgeClass()">
                            @_tracks[_selectedTrack.Value].Steps[_selectedStep.Value].Status
                        </span>
                    </div>
                </div>
            </div>
        }

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" OnClick="@(() => HandleAdvanceTrack(0))" Disabled="@(_activeSteps[0] >= _tracks[0].Steps.Length - 1)">
                    <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
                    Frontend
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" OnClick="@(() => HandleAdvanceTrack(1))" Disabled="@(_activeSteps[1] >= _tracks[1].Steps.Length - 1)">
                    <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
                    Backend
                </ButtonCn>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(!MergeReady)">
                <LucideIconCn Name="git-merge" Size="14" Class="size-3.5" />
                Deploy
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TrackStep(string Label, string Description, string Status);
    private record Track(string Name, TrackStep[] Steps);

    private static readonly Track[] _tracks =
    [
        new("Frontend",
        [
            new("UI design", "Figma designs and design tokens", "Completed"),
            new("Components", "Build component library", "Completed"),
            new("Integration", "Connect to API endpoints", "In progress"),
        ]),
        new("Backend",
        [
            new("API design", "OpenAPI spec and contracts", "Completed"),
            new("Database", "Schema, migrations, and seeds", "Completed"),
            new("Services", "Business logic and auth", "In progress"),
        ]),
    ];

    private static readonly TrackStep _mergeStep = new("Deploy", "Unified deployment to production", "Pending");
    private static readonly string[] _bridgeLabels = ["Design handoff", "Schema sync", "E2E testing"];

    private int[] _activeSteps = [2, 2];
    private int? _selectedTrack = 0;
    private int? _selectedStep = 2;

    private bool MergeReady => _activeSteps[0] >= _tracks[0].Steps.Length - 1 && _activeSteps[1] >= _tracks[1].Steps.Length - 1;
    private int TotalCompleted => _activeSteps[0] + _activeSteps[1];
    private int TotalStepsCount => _tracks[0].Steps.Length + _tracks[1].Steps.Length + 1;
    private string MergeLineStroke => MergeReady ? "rgb(16 185 129)" : "rgb(115 115 115)";
    private string MergeLineOpacity => MergeReady ? "0.5" : "0.15";

    private void HandleStepClick(int trackIndex, int stepIndex)
    {
        if (stepIndex <= _activeSteps[trackIndex])
        {
            _selectedTrack = trackIndex;
            _selectedStep = stepIndex;
        }
    }

    private void HandleAdvanceTrack(int trackIndex)
    {
        if (_activeSteps[trackIndex] < _tracks[trackIndex].Steps.Length - 1)
        {
            _activeSteps[trackIndex] = _activeSteps[trackIndex] + 1;
        }
    }

    private string GetStatusBadgeClass()
    {
        if (_selectedTrack == null || _selectedStep == null)
            return "rounded-full px-1.5 py-0.5 font-mono text-xs text-muted-foreground";
        var stepIdx = _selectedStep.Value;
        var trackIdx = _selectedTrack.Value;
        if (stepIdx < _activeSteps[trackIdx])
            return "rounded-full px-1.5 py-0.5 font-mono text-xs bg-emerald-500/10 text-emerald-600 dark:text-emerald-400";
        if (stepIdx == _activeSteps[trackIdx])
            return "rounded-full px-1.5 py-0.5 font-mono text-xs bg-blue-500/10 text-blue-600 dark:text-blue-400";
        return "rounded-full px-1.5 py-0.5 font-mono text-xs text-muted-foreground";
    }
}
