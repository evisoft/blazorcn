@* ============================================================
   Block: stepper-checkmark-trail
   Title: StepperCheckmarkTrail
   Description: A horizontal checkmark trail stepper with connected circles, animated state transitions, and form-style step content built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-checkmark-trail.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Account Setup</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Step @(_activeStep + 1) of @_steps.Length
            </BadgeCn>
        </div>

        @* Checkmark trail *@
        <div class="border-b px-6 py-6">
            <div class="flex items-center">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var isCompleted = index < _activeStep;
                    var isActive = index == _activeStep;
                    var isUpcoming = index > _activeStep;
                    <div class="flex flex-1 items-center last:flex-none">
                        @* Circle + label group *@
                        <div class="flex flex-col items-center gap-2">
                            <button
                                type="button" aria-label="@($"Step {index + 1}: {stp.Label}")"
                                @onclick="@(() => HandleStepClick(index))"
                                disabled="@(isUpcoming ? "disabled" : null)"
                                class="@Cn.Merge("flex size-9 shrink-0 items-center justify-center rounded-full transition-all duration-300", isCompleted ? "bg-emerald-500 shadow-sm cursor-pointer dark:bg-emerald-600" : isActive ? "border-2 border-blue-500 bg-blue-500/10 shadow-sm shadow-blue-500/10 cursor-pointer dark:border-blue-400 dark:bg-blue-400/10" : "border-2 border-muted-foreground/20 cursor-default")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="size-4 text-white" />
                                }
                                else
                                {
                                    <span class="@Cn.Merge("font-medium text-xs tabular-nums", isActive ? "text-blue-600 dark:text-blue-400" : "text-muted-foreground/50")">
                                        @(index + 1)
                                    </span>
                                }
                            </button>
                            <span class="@Cn.Merge("whitespace-nowrap text-xs", isActive ? "font-medium text-foreground" : isCompleted ? "font-medium text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">
                                @stp.Label
                            </span>
                        </div>

                        @* Connecting line *@
                        @if (index < _steps.Length - 1)
                        {
                            <div class="mx-1.5 mb-6 h-0.5 flex-1">
                                <div class="@Cn.Merge("h-full rounded-full transition-colors duration-500", index < _activeStep ? "bg-emerald-500 dark:bg-emerald-600" : index == _activeStep ? "bg-gradient-to-r from-blue-500/50 to-muted-foreground/15 dark:from-blue-400/50" : "bg-muted-foreground/15")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Step content (form-style) *@
        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
            </div>
            <div class="space-y-2">
                @foreach (var field in _steps[_activeStep].Fields)
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                        <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                        <div class="flex items-center gap-2">
                            @if (field.FieldType == FieldType.Tag)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@field.Value</BadgeCn>
                            }
                            else if (field.FieldType == FieldType.Masked)
                            {
                                <span class="font-mono text-muted-foreground text-sm">@field.Value</span>
                            }
                            else
                            {
                                <span class="text-sm">@field.Value</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeStep == 0)" OnClick="HandleBack">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeStep == _steps.Length - 1)" OnClick="HandleNext">
                @(_activeStep == _steps.Length - 1 ? "Complete" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private enum FieldType { Text, Masked, Tag }

    private record FieldItem(string Label, string Value, FieldType FieldType = FieldType.Text);
    private record StepItem(string Label, FieldItem[] Fields);

    private static readonly StepItem[] _steps =
    [
        new("Identity",
        [
            new("Full name", "Morgan Chen"),
            new("Date of birth", "March 14, 1992"),
            new("Nationality", "United States"),
        ]),
        new("Security",
        [
            new("Password strength", "Strong", FieldType.Tag),
            new("Two-factor auth", "Authenticator app"),
            new("Recovery email", "m****n@backup.com", FieldType.Masked),
        ]),
        new("Preferences",
        [
            new("Language", "English (US)"),
            new("Timezone", "UTC-5 Eastern"),
            new("Notifications", "Email + Push"),
        ]),
        new("Verification",
        [
            new("Email verified", "Confirmed", FieldType.Tag),
            new("Phone number", "+1 (***) ***-7890", FieldType.Masked),
            new("ID document", "Uploaded", FieldType.Tag),
        ]),
        new("Done",
        [
            new("Account status", "Active", FieldType.Tag),
            new("Setup completed", "March 24, 2026"),
            new("Access level", "Full member"),
        ]),
    ];

    private int _activeStep = 2;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
