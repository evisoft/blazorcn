@* ============================================================
   Block: stepper-undo-history
   Title: StepperUndoHistory
   Description: A stepper wizard with undo and redo navigation that records step transitions in a visible history log built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-undo-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with undo/redo *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Document workflow</span>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" OnClick="HandleUndo" Disabled="@(!CanUndo)">
                    <LucideIconCn Name="corner-up-left" Size="14" Class="size-3.5" />
                    Undo
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" OnClick="HandleRedo" Disabled="@(!CanRedo)">
                    Redo
                    <LucideIconCn Name="corner-up-right" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @* Step indicators *@
        <div class="border-b px-6 py-5">
            <div class="flex items-center">
                @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
                {
                    var step = entry.Step;
                    var index = entry.Index;
                    var isCompleted = index < CurrentStep;
                    var isActive = index == CurrentStep;
                    var isLast = index == _steps.Length - 1;

                    <div class="flex flex-1 items-center last:flex-none">
                        <div class="flex flex-col items-center gap-1.5">
                            <button
                                type="button" aria-label="@($"Step {index + 1}: {step.Label}")"
                                @onclick="@(() => HandleStepClick(index))"
                                class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full text-xs transition-all duration-200 cursor-pointer", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-foreground text-background" : "border border-muted-foreground/25 text-muted-foreground hover:border-muted-foreground/50")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <span class="font-medium tabular-nums">@(index + 1)</span>
                                }
                            </button>
                            <span class="@Cn.Merge("text-center font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                @step.Label
                            </span>
                        </div>

                        @if (!isLast)
                        {
                            <div class="mx-2 mb-6 h-px flex-1">
                                <div class="@Cn.Merge("h-full rounded-full transition-colors duration-300", index < CurrentStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Current step content *@
        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_steps[CurrentStep].Label</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                        Step @(CurrentStep + 1) of @_steps.Length
                    </BadgeCn>
                </div>
                <p class="mt-0.5 text-muted-foreground text-xs">@_steps[CurrentStep].Description</p>
            </div>
            <div class="rounded-md bg-muted/30 px-3 py-2.5">
                <span class="text-muted-foreground text-xs">
                    Complete this step or use undo/redo to navigate
                </span>
            </div>
        </div>

        @* History panel toggle *@
        <div class="border-b">
            <button
                type="button"
                @onclick="@(() => _showHistory = !_showHistory)"
                class="flex w-full items-center gap-2 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                <LucideIconCn Name="history" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Navigation history</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-1 font-normal text-xs tabular-nums">
                    @(_historyIndex + 1)
                </BadgeCn>
                <div class="ml-auto">
                    @if (_showHistory)
                    {
                        <LucideIconCn Name="chevron-down" Size="14" Class="size-3.5 text-muted-foreground/60" />
                    }
                    else
                    {
                        <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/60" />
                    }
                </div>
            </button>

            @if (_showHistory)
            {
                <div class="max-h-[200px] overflow-y-auto border-t">
                    @foreach (var he in VisibleHistory.Select((e, i) => new { Entry = e, Idx = i }))
                    {
                        var histEntry = he.Entry;
                        var isCurrentEntry = he.Idx == 0;

                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2", isCurrentEntry ? "bg-muted/30" : "")">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", isCurrentEntry ? "bg-foreground" : "bg-muted-foreground/30")"></span>
                            <span class="@Cn.Merge("flex-1 text-xs", isCurrentEntry ? "font-medium text-foreground" : "text-muted-foreground")">
                                @histEntry.Action
                            </span>
                            <span class="font-mono text-muted-foreground/60 text-xs">
                                @histEntry.Timestamp
                            </span>
                        </div>
                    }
                </div>
            }
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(CurrentStep == 0)">
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(CurrentStep == _steps.Length - 1)">
                @(CurrentStep == _steps.Length - 1 ? "Finish" : "Continue")
                @if (CurrentStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Id, string Label, string Description);
    private record HistoryEntry(int FromStep, int ToStep, string Timestamp, string Action);

    private static readonly StepItem[] _steps =
    [
        new("draft", "Draft", "Create and edit your document content"),
        new("edit", "Edit", "Revise formatting, structure, and clarity"),
        new("review", "Review", "Get feedback from reviewers and stakeholders"),
        new("approve", "Approve", "Final sign-off from authorized approvers"),
        new("publish", "Publish", "Release the document to its audience"),
    ];

    private List<HistoryEntry> _history =
    [
        new(-1, 0, "10:00 AM", "Started at Draft"),
        new(0, 1, "10:12 AM", "Advanced to Edit"),
        new(1, 2, "10:24 AM", "Advanced to Review"),
    ];

    private int _historyIndex = 2;
    private bool _showHistory = false;

    private int CurrentStep => _history[_historyIndex].ToStep;
    private bool CanUndo => _historyIndex > 0;
    private bool CanRedo => _historyIndex < _history.Count - 1;

    private IEnumerable<HistoryEntry> VisibleHistory => _history.Take(_historyIndex + 1).Reverse();

    private void NavigateToStep(int targetStep)
    {
        var currentStep = CurrentStep;
        if (targetStep == currentStep || targetStep < 0 || targetStep >= _steps.Length) return;

        var direction = targetStep > currentStep ? "Advanced to" : "Returned to";
        var newEntry = new HistoryEntry(currentStep, targetStep, "Just now", $"{direction} {_steps[targetStep].Label}");

        _history = _history.Take(_historyIndex + 1).Append(newEntry).ToList();
        _historyIndex = _history.Count - 1;
    }

    private void HandleUndo()
    {
        if (CanUndo) _historyIndex--;
    }

    private void HandleRedo()
    {
        if (CanRedo) _historyIndex++;
    }

    private void HandleNext()
    {
        if (CurrentStep < _steps.Length - 1)
            NavigateToStep(CurrentStep + 1);
    }

    private void HandleBack()
    {
        if (CurrentStep > 0)
            NavigateToStep(CurrentStep - 1);
    }

    private void HandleStepClick(int index)
    {
        NavigateToStep(index);
    }
}
