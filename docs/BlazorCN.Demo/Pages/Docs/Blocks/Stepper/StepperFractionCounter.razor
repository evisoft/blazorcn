@* ============================================================
   Block: stepper-fraction-counter
   Title: StepperFractionCounter
   Description: A minimalist fraction-display stepper wizard with large typographic step counter, progress bar, and arrow navigation built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-fraction-counter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Fraction display + navigation arrows *@
        <div class="flex items-center justify-between border-b px-4 py-5">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
            </ButtonCn>

            <div class="flex flex-col items-center gap-1">
                <div class="flex items-baseline gap-1.5">
                    <span class="font-semibold text-4xl tabular-nums">@(_activeStep + 1)</span>
                    <span class="font-light text-2xl text-muted-foreground/40">/</span>
                    <span class="font-light text-2xl text-muted-foreground/60 tabular-nums">@_steps.Length</span>
                </div>
                <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
            </div>

            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-8 p-0" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
            </ButtonCn>
        </div>

        @* Progress bar *@
        <div class="h-1 w-full bg-muted">
            <div
                class="h-full bg-foreground transition-all duration-500 ease-out"
                style="@($"width:{(_activeStep + 1.0) / _steps.Length * 100:F1}%")"
            ></div>
        </div>

        @* Step indicators *@
        <div class="flex items-center justify-between border-b px-6 py-3">
            @foreach (var stp in _steps)
            {
                var idx = Array.IndexOf(_steps, stp);
                var isCompleted = idx < _activeStep;
                var isActive = idx == _activeStep;
                var capturedIdx = idx;
                <button
                    type="button"
                    @onclick="@(() => HandleStepClick(capturedIdx))"
                    class="@Cn.Merge("flex size-6 items-center justify-center rounded-full text-xs tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white cursor-pointer dark:bg-emerald-600" : isActive ? "bg-foreground text-background cursor-pointer" : "border border-muted-foreground/25 text-muted-foreground cursor-default")">
                    @if (isCompleted)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                    }
                    else
                    {
                        <span>@(idx + 1)</span>
                    }
                </button>
            }
        </div>

        @* Content *@
        <div class="border-b px-4 py-4">
            <p class="mb-3 text-muted-foreground text-xs">@_steps[_activeStep].Description</p>
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-sm leading-relaxed">@_steps[_activeStep].Detail</p>
            </div>
        </div>

        @* Footer navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @(_activeStep == 0 ? "Getting started" : _activeStep == _steps.Length - 1 ? "Final step" : $"{_steps.Length - _activeStep - 1} steps remaining")
            </span>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Finish" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Description, string Detail);

    private static readonly StepItem[] _steps =
    [
        new("Select template",
            "Choose a starter template for your site",
            "Pick from blog, portfolio, e-commerce, or documentation templates. Each comes pre-configured with optimized layouts, responsive breakpoints, and accessibility best practices."),
        new("Customize layout",
            "Adjust the structure and navigation",
            "Configure your header style, sidebar placement, footer layout, and page grid. Drag sections to reorder them and toggle visibility for mobile and desktop breakpoints."),
        new("Add content",
            "Create pages and populate with your content",
            "Use the block editor to add hero sections, feature grids, testimonials, and pricing tables. Import existing content from Markdown, Notion, or a CMS via our integration connectors."),
        new("Configure SEO",
            "Set metadata, sitemaps, and social previews",
            "Define page titles, meta descriptions, and Open Graph images for every page. Auto-generate XML sitemaps and configure canonical URLs for proper search engine indexing."),
        new("Publish site",
            "Review and deploy to production",
            "Run a final audit for broken links, missing alt text, and performance issues. Deploy to your custom domain with automatic SSL, edge caching, and global CDN distribution."),
    ];

    private int _activeStep = 1;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
