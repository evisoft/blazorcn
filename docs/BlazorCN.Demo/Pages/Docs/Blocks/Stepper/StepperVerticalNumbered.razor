@* ============================================================
   Block: stepper-vertical-numbered
   Title: StepperVerticalNumbered
   Description: A vertical numbered stepper with connecting lines, expandable step content, and completion tracking built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-vertical-numbered.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Workspace setup</span>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_currentStep of @_steps.Length complete
                </span>
            </div>
        </div>

        @* Steps *@
        <div class="px-4 py-4">
            @for (int i = 0; i < _steps.Length; i++)
            {
                var idx = i;
                var step = _steps[idx];
                var isCompleted = idx < _currentStep;
                var isActive = idx == _currentStep;
                var isUpcoming = idx > _currentStep;
                var isLast = idx == _steps.Length - 1;
                var lineMinHeight = isActive ? "80px" : "24px";
                <div class="flex gap-4">
                    @* Circle + Line column *@
                    <div class="flex flex-col items-center">
                        @* Circle *@
                        <button
                            type="button"
                            @onclick="@(() => HandleStepClick(idx))"
                            disabled="@isUpcoming"
                            class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full font-medium text-xs tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600 cursor-pointer" : isActive ? "bg-blue-500 text-white ring-4 ring-blue-500/20 dark:bg-blue-600 dark:ring-blue-400/20 cursor-pointer" : "border border-muted-foreground/25 text-muted-foreground cursor-default")">
                            @if (isCompleted)
                            {
                                <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                            }
                            else
                            {
                                <span>@(idx + 1)</span>
                            }
                        </button>

                        @* Connecting line *@
                        @if (!isLast)
                        {
                            <div
                                class="@Cn.Merge("my-1 w-0.5 flex-1 rounded-full transition-colors duration-300", isCompleted ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/15")"
                                style="@("min-height:" + lineMinHeight)">
                            </div>
                        }
                    </div>

                    @* Content column *@
                    <div class="@Cn.Merge("pb-6", isLast ? "pb-0" : "")">
                        <div class="flex items-center gap-2 pt-1">
                            <span class="@Cn.Merge("font-medium text-sm", isUpcoming ? "text-muted-foreground" : "text-foreground")">
                                @step.Label
                            </span>
                            @if (isCompleted)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    @step.Status
                                </BadgeCn>
                            }
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>

                        @* Expanded content for active step *@
                        @if (isActive)
                        {
                            <div class="mt-3">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <p class="text-sm leading-relaxed">@step.Detail</p>
                                </div>
                                <div class="mt-3">
                                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleContinue" Disabled="@(_currentStep == _steps.Length - 1)">
                                        @(_currentStep == _steps.Length - 1 ? "Finish" : "Continue")
                                        @if (_currentStep < _steps.Length - 1)
                                        {
                                            <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                                        }
                                    </ButtonCn>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StepData(string Label, string Description, string Detail, string Status);

    private static readonly StepData[] _steps =
    [
        new("Create account", "Sign up with your email and set a password",
            "Your account has been created with alex@example.com. A strong password was set with two-factor authentication enabled.",
            "Email verified"),
        new("Verify email", "Confirm your email address via the link we sent",
            "A verification link was sent to alex@example.com. Click the link in the email to confirm your account and unlock all features.",
            "Link sent"),
        new("Set up workspace", "Name your workspace and configure basic settings",
            "Choose a name for your workspace, set the default timezone, and configure notification preferences for your team.",
            "Pending"),
        new("Invite team", "Add team members by email or share an invite link",
            "Invite collaborators by entering their email addresses. You can assign roles like Admin, Editor, or Viewer to control access levels.",
            "Pending"),
        new("Go live", "Review your setup and launch your workspace",
            "Everything is configured. Review your workspace settings, team members, and integrations before going live.",
            "Pending"),
    ];

    private int _currentStep = 2;

    private void HandleContinue()
    {
        if (_currentStep < _steps.Length - 1)
        {
            _currentStep++;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _currentStep)
        {
            _currentStep = index;
        }
    }
}
