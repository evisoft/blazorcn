@* ============================================================
   Block: stepper-animated-pulse
   Title: StepperAnimatedPulse
   Description: A horizontal stepper with a pulsing active step indicator, emerald completion dots, connecting lines, and step content built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-animated-pulse.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Service provisioning</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                Step @(_activeStep + 1) of @_steps.Length
            </span>
        </div>

        @* Stepper with pulse animation *@
        <div class="border-b px-6 py-8">
            <div class="flex items-center">
                @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
                {
                    var idx = entry.Index;
                    var step = entry.Step;
                    var isCompleted = idx < _activeStep;
                    var isActive = idx == _activeStep;
                    var isUpcoming = idx > _activeStep;

                    <div class="flex flex-1 items-center last:flex-none">
                        <div class="flex flex-col items-center gap-3">
                            @* Dot with pulse ring *@
                            <button
                                type="button"
                                @onclick="@(() => HandleStepClick(idx))"
                                disabled="@isUpcoming"
                                class="@Cn.Merge("relative flex items-center justify-center", isUpcoming ? "cursor-default" : "cursor-pointer")">

                                @* Pulse ring for active step *@
                                @if (isActive)
                                {
                                    <span class="absolute size-10 animate-pulse rounded-full bg-blue-500/20 dark:bg-blue-400/20"></span>
                                }

                                @* Outer ring for active *@
                                @if (isActive)
                                {
                                    <span class="absolute size-7 rounded-full ring-2 ring-blue-500/30 dark:ring-blue-400/30"></span>
                                }

                                @* Dot *@
                                <span class="@Cn.Merge("relative z-10 flex size-5 items-center justify-center rounded-full transition-all duration-300", isCompleted ? "bg-emerald-500 dark:bg-emerald-600" : isActive ? "bg-blue-500 shadow-lg shadow-blue-500/25 dark:bg-blue-400 dark:shadow-blue-400/25" : "border-2 border-muted-foreground/20 bg-card")">
                                    @if (isCompleted)
                                    {
                                        <LucideIconCn Name="check" Size="12" Class="size-3 text-white" />
                                    }
                                </span>
                            </button>

                            @* Label *@
                            <div class="flex flex-col items-center text-center">
                                <span class="@Cn.Merge("text-xs", isActive ? "font-medium text-foreground" : isCompleted ? "text-foreground/70" : "text-muted-foreground")">
                                    @step.Label
                                </span>
                                <span class="mt-0.5 max-w-[100px] text-muted-foreground text-xs leading-tight">
                                    @step.Description
                                </span>
                            </div>
                        </div>

                        @* Connecting line *@
                        @if (idx < _steps.Length - 1)
                        {
                            <div class="mx-3 mb-12 h-0.5 flex-1">
                                <div class="@Cn.Merge("h-full rounded-full transition-colors duration-500", idx < _activeStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/15")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Active step content *@
        @{
            var current = _steps[_activeStep];
        }
        <div class="border-b px-4 py-4">
            <div class="mb-1 font-medium text-sm">@current.Label</div>
            <p class="mb-3 text-muted-foreground text-xs">@current.Description</p>
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-sm leading-relaxed">@current.Detail</p>
            </div>
        </div>

        @* Footer navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Complete" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Description, string Detail);

    private int _activeStep = 1;

    private static readonly StepItem[] _steps =
    [
        new("Authenticate", "Verify your identity",
            "Sign in with your credentials or SSO provider. Multi-factor authentication is required for this operation. You will receive a verification code via your registered authenticator app."),
        new("Authorize", "Grant resource permissions",
            "Review and approve the requested permissions for this service. Scopes include read access to user profiles, write access to project settings, and admin access to billing. Each scope can be individually toggled."),
        new("Provision", "Allocate resources and configure",
            "Provisioning your dedicated environment with compute, storage, and networking resources. This includes setting up isolated database instances, configuring DNS records, and establishing VPN tunnels to your infrastructure."),
        new("Verify", "Run post-setup validation",
            "Execute end-to-end health checks across all provisioned services. Verify API connectivity, database replication, authentication flows, and monitoring integrations. A detailed report will be generated upon completion."),
    ];

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
