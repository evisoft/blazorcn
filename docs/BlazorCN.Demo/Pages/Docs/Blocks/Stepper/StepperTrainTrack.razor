@* ============================================================
   Block: stepper-train-track
   Title: StepperTrainTrack
   Description: A railroad-inspired stepper wizard with parallel track lines, cross-ties, and station markers at each step built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-train-track.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="train-front" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Project railway</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Station <span class="tabular-nums">@(_activeStation + 1)</span> of <span class="tabular-nums">@_stations.Length</span>
            </BadgeCn>
        </div>

        @* Train track *@
        <div class="border-b px-6 py-8">
            <div class="relative">
                @* Rails — two parallel lines *@
                <div class="absolute top-[18px] right-4 left-4 flex flex-col gap-[10px]">
                    <div class="h-[2px] rounded-full bg-muted-foreground/20"></div>
                    <div class="h-[2px] rounded-full bg-muted-foreground/20"></div>
                </div>

                @* Progress fill on rails *@
                <div class="absolute top-[18px] left-4 flex flex-col gap-[10px] transition-all duration-500"
                     style="@ProgressStyle">
                    <div class="h-[2px] rounded-full bg-emerald-500 dark:bg-emerald-600"></div>
                    <div class="h-[2px] rounded-full bg-emerald-500 dark:bg-emerald-600"></div>
                </div>

                @* Cross-ties between rails *@
                <div class="absolute top-[16px] right-6 left-6">
                    <div class="flex justify-between">
                        @for (var i = 0; i < 21; i++)
                        {
                            <div class="h-[18px] w-[3px] rounded-sm bg-muted-foreground/10"></div>
                        }
                    </div>
                </div>

                @* Stations *@
                <div class="relative flex items-center justify-between">
                    @foreach (var station in _stations)
                    {
                        var stationItem = station;
                        var idx = Array.IndexOf(_stations, stationItem);
                        var isCompleted = idx < _activeStation;
                        var isActive = idx == _activeStation;
                        var isUpcoming = idx > _activeStation;
                        <div class="flex flex-col items-center gap-3">
                            @* Station platform *@
                            <button
                                type="button" aria-label="@($"Step {idx + 1}: {stationItem.Label}")"
                                @onclick="@(() => HandleStationClick(idx))"
                                class="@Cn.Merge("relative z-10 flex size-10 items-center justify-center rounded-lg border-2 transition-all duration-300", isCompleted ? "cursor-pointer border-emerald-500 bg-emerald-500 text-white dark:border-emerald-600 dark:bg-emerald-600" : isActive ? "cursor-pointer border-blue-500 bg-blue-500 text-white shadow-md shadow-blue-500/20 dark:border-blue-400 dark:bg-blue-600 dark:shadow-blue-400/20" : "cursor-pointer border-muted-foreground/20 bg-card text-muted-foreground hover:border-muted-foreground/40")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="size-4" />
                                }
                                else if (isActive)
                                {
                                    <div class="size-3 rounded-full bg-white"></div>
                                }
                                else
                                {
                                    <div class="@Cn.Merge("size-2.5 rounded-full", isUpcoming ? "bg-muted-foreground/30" : "bg-muted-foreground")"></div>
                                }
                            </button>

                            @* Station label *@
                            <span class="@Cn.Merge("max-w-[80px] text-center text-xs leading-tight font-medium", isActive ? "text-foreground" : "text-muted-foreground")">
                                @stationItem.Label
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Station detail *@
        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <span class="font-medium text-sm">@_stations[_activeStation].Label</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@_stations[_activeStation].Description</p>
            </div>
            <div class="rounded-md bg-muted/50 p-3">
                <span class="font-medium text-muted-foreground text-xs">Status</span>
                <p class="mt-1 text-sm leading-relaxed">@_stations[_activeStation].Detail</p>
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeStation == 0)" OnClick="HandleBack">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Previous
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeStation == _stations.Length - 1)" OnClick="HandleNext">
                @(_activeStation == _stations.Length - 1 ? "Arrive" : "Next station")
                @if (_activeStation < _stations.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Station(string Label, string Description, string Detail);

    private static readonly Station[] _stations =
    [
        new("Departure", "Project kickoff and requirements gathering", "Stakeholder interviews completed, scope document signed off"),
        new("Station Alpha", "Architecture design and technical planning", "System diagram finalized, tech stack confirmed, sprint plan created"),
        new("Station Bravo", "Core feature implementation", "API endpoints built, database schema deployed, auth integrated"),
        new("Station Charlie", "Testing and quality assurance", "Unit tests at 94% coverage, E2E tests passing, load testing complete"),
        new("Terminal", "Deployment and launch", "Production environment ready, monitoring configured, rollback plan set"),
    ];

    private int _activeStation = 2;

    private string ProgressStyle => _activeStation == 0
        ? "width:0%"
        : FormattableString.Invariant($"width:calc({(_activeStation * 100.0 / (_stations.Length - 1)):F4}% - 16px)");

    private void HandleNext()
    {
        if (_activeStation < _stations.Length - 1)
        {
            _activeStation++;
        }
    }

    private void HandleBack()
    {
        if (_activeStation > 0)
        {
            _activeStation--;
        }
    }

    private void HandleStationClick(int index)
    {
        _activeStation = index;
    }
}
