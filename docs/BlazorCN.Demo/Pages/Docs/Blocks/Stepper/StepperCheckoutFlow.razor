@* ============================================================
   Block: stepper-checkout-flow
   Title: StepperCheckoutFlow
   Description: A complete e-commerce checkout stepper wizard with cart, shipping, payment, and confirmation steps built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-checkout-flow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Checkout</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Step <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Step indicators *@
        <div class="border-b px-6 py-5">
            <div class="flex items-center">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var isCompleted = index < _activeStep;
                    var isActive = index == _activeStep;
                    var isUpcoming = index > _activeStep;
                    <div class="flex flex-1 items-center last:flex-none">
                        <div class="flex flex-col items-center gap-1.5">
                            <button
                                type="button" aria-label="@($"Step {index + 1}: {stp.Label}")"
                                @onclick="@(() => HandleStepClick(index))"
                                disabled="@isUpcoming"
                                class="@Cn.Merge("flex size-9 shrink-0 items-center justify-center rounded-full transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600 cursor-pointer" : isActive ? "ring-2 ring-foreground/20 ring-offset-2 ring-offset-card bg-foreground text-background cursor-pointer" : "border border-muted-foreground/25 text-muted-foreground cursor-default")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <LucideIconCn Name="@stp.IconName" Size="14" Class="size-3.5" />
                                }
                            </button>
                            <span class="@Cn.Merge("text-center font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                @stp.Label
                            </span>
                        </div>

                        @if (index < _steps.Length - 1)
                        {
                            <div class="mx-3 mb-5 h-px flex-1">
                                <div class="@Cn.Merge("h-full transition-colors duration-300", index < _activeStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Step content *@
        <div class="border-b">
            @if (_activeStep == 0)
            {
                <div>
                    @foreach (var cartItem in _cartItems)
                    {
                        var cartIndex = Array.IndexOf(_cartItems, cartItem);
                        <div class="@Cn.Merge("flex items-center justify-between px-4 py-3", cartIndex < _cartItems.Length - 1 ? "border-b" : "")">
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@cartItem.Name</span>
                                <p class="mt-0.5 text-muted-foreground text-xs">
                                    @cartItem.Variant · Qty @cartItem.Qty
                                </p>
                            </div>
                            <span class="shrink-0 font-medium text-sm tabular-nums">@cartItem.Price</span>
                        </div>
                    }
                </div>
            }

            @if (_activeStep == 1)
            {
                <div class="px-4 py-4">
                    <div class="mb-3">
                        <span class="font-medium text-sm">Shipping address</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Where should we deliver your order?
                        </p>
                    </div>
                    <div class="space-y-2">
                        @foreach (var field in _shippingFields)
                        {
                            <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                                <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                                <span class="text-sm">@field.Value</span>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_activeStep == 2)
            {
                <div class="px-4 py-4">
                    <div class="mb-3">
                        <span class="font-medium text-sm">Payment method</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Your payment information is encrypted and secure.
                        </p>
                    </div>
                    <div class="space-y-2">
                        @foreach (var field in _paymentFields)
                        {
                            <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                                <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                                <span class="text-sm">@field.Value</span>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_activeStep == 3)
            {
                <div class="px-4 py-6">
                    <div class="mx-auto max-w-sm text-center">
                        <div class="mx-auto mb-3 flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="20" Class="size-5 text-emerald-600 dark:text-emerald-400" />
                        </div>
                        <span class="font-medium text-sm">Order confirmed</span>
                        <p class="mt-1 text-muted-foreground text-xs">
                            Order #ORD-28491 has been placed. You will receive a confirmation email at
                            jordan@@example.com with tracking details.
                        </p>
                    </div>
                </div>
            }
        </div>

        @* Order summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Subtotal</span>
                <span class="text-sm tabular-nums">$149.00</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Shipping</span>
                <span class="text-sm tabular-nums">Free</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Tax</span>
                <span class="text-sm tabular-nums">$12.67</span>
            </div>
            <div class="mt-2 flex items-center justify-between border-t pt-2">
                <span class="font-medium text-sm">Total</span>
                <span class="font-semibold text-sm tabular-nums">$161.67</span>
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == 2 ? "Place order" : _activeStep == 3 ? "Done" : "Continue")
                @if (_activeStep < 2)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string IconName);
    private record CartItem(string Name, string Variant, int Qty, string Price);
    private record FieldItem(string Label, string Value);

    private static readonly StepItem[] _steps =
    [
        new("Cart", "shopping-cart"),
        new("Shipping", "truck"),
        new("Payment", "credit-card"),
        new("Confirmation", "package-check"),
    ];

    private static readonly CartItem[] _cartItems =
    [
        new("Minimal Desk Lamp", "Matte Black", 1, "$89.00"),
        new("Ceramic Mug Set", "Warm Grey, Pack of 4", 1, "$42.00"),
        new("Linen Notebook", "A5, Dot Grid", 2, "$18.00"),
    ];

    private static readonly FieldItem[] _shippingFields =
    [
        new("Full name", "Jordan Rivera"),
        new("Address", "814 Oak Street, Apt 3B"),
        new("City", "Portland, OR 97205"),
        new("Country", "United States"),
        new("Phone", "+1 (503) 555-0142"),
    ];

    private static readonly FieldItem[] _paymentFields =
    [
        new("Card number", "**** **** **** 8291"),
        new("Expiry", "11/28"),
        new("Cardholder", "Jordan Rivera"),
        new("Billing address", "Same as shipping"),
    ];

    private int _activeStep = 0;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
