@* ============================================================
   Block: stepper-inline-breadcrumb
   Title: StepperInlineBreadcrumb
   Description: A breadcrumb-style stepper with chevron separators, completion checkmarks, clickable navigation, and step content panel built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-inline-breadcrumb.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Workspace configuration</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @(_activeStep + 1) of @_steps.Length
            </span>
        </div>

        @* Breadcrumb trail *@
        <div class="border-b px-4 py-3">
            <nav class="flex flex-wrap items-center gap-1">
                @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
                {
                    var idx = entry.Index;
                    var step = entry.Step;
                    var isCompleted = idx < _activeStep;
                    var isActive = idx == _activeStep;
                    var capturedIdx = idx;

                    <span class="flex items-center gap-1">
                        @if (idx > 0)
                        {
                            <LucideIconCn Name="chevron-right" Size="12" Class="size-3 shrink-0 text-muted-foreground/30" />
                        }
                        @if (isCompleted)
                        {
                            <button type="button" @onclick="@(() => _activeStep = capturedIdx)" class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-xs text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground">
                                @step.Label
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                            </button>
                        }
                        else if (isActive)
                        {
                            <span class="inline-flex items-center rounded bg-muted/60 px-1.5 py-0.5 font-medium text-xs text-foreground">
                                @step.Label
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-1.5 py-0.5 text-muted-foreground/40 text-xs">
                                @step.Label
                            </span>
                        }
                    </span>
                }
            </nav>
        </div>

        @* Step content *@
        <div class="border-b px-4 py-4">
            <div class="mb-1">
                <span class="font-medium text-sm">@_steps[_activeStep].Title</span>
            </div>
            <p class="text-muted-foreground text-xs leading-relaxed">@_steps[_activeStep].Description</p>
        </div>

        @* Step fields *@
        <div class="border-b">
            @foreach (var fEntry in _steps[_activeStep].Fields.Select((f, i) => new { Field = f, Index = i }))
            {
                var fIdx = fEntry.Index;
                var field = fEntry.Field;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", fIdx < _steps[_activeStep].Fields.Length - 1 ? "border-b" : "")">
                    <span class="text-muted-foreground text-xs">@field.Label</span>
                    <div class="flex items-center gap-2">
                        @if (field.Status == "ok")
                        {
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        }
                        @if (field.Status == "warn")
                        {
                            <span class="size-1.5 rounded-full bg-amber-500"></span>
                        }
                        <span class="font-medium text-sm">@field.Value</span>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Confirm" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FieldData(string Label, string Value, string? Status = null);
    private record StepData(string Id, string Label, string Title, string Description, FieldData[] Fields);

    private int _activeStep = 2;

    private static readonly StepData[] _steps =
    [
        new("workspace", "Workspace", "Workspace settings",
            "Configure the workspace name, visibility, and default preferences for all members.",
            [
                new("Name", "Acme Engineering"),
                new("Visibility", "Private"),
                new("Default role", "Member"),
            ]),
        new("team", "Team", "Team configuration",
            "Manage team structure, groups, and organizational hierarchy for access control.",
            [
                new("Teams", "3 teams created", "ok"),
                new("Members", "12 active members", "ok"),
                new("Pending invites", "2 pending", "warn"),
            ]),
        new("permissions", "Permissions", "Permission policies",
            "Define role-based access control rules and resource-level permissions.",
            [
                new("Admin access", "2 users"),
                new("Developer access", "8 users"),
                new("Viewer access", "4 users"),
            ]),
        new("audit", "Audit log", "Audit log settings",
            "Configure event logging, retention policies, and compliance export schedules.",
            [
                new("Logging", "All events", "ok"),
                new("Retention", "90 days"),
                new("Export schedule", "Weekly to S3"),
            ]),
        new("confirm", "Confirm", "Review and confirm",
            "Verify all settings before applying changes to the workspace.",
            [
                new("Changes", "4 sections updated", "ok"),
                new("Affected users", "12 members notified"),
                new("Effective", "Immediately on confirm"),
            ]),
    ];

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }
}
