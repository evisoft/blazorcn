@* ============================================================
   Block: stepper-tabbed-content
   Title: StepperTabbedContent
   Description: A horizontal tab stepper with icons, active underline indicator, emerald completion checks, and swappable content panels built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-tabbed-content.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Project setup</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                @_completed.Count/@_steps.Length complete
            </BadgeCn>
        </div>

        @* Tab bar with icons *@
        <div class="flex border-b">
            @foreach (var stp in _steps)
            {
                var step = stp;
                var isActive = _activeTab == step.Id;
                var isCompleted = _completed.Contains(step.Id);
                <button
                    type="button"
                    @onclick="@(() => _activeTab = step.Id)"
                    class="@Cn.Merge("relative flex flex-1 items-center justify-center gap-2 px-3 py-3 transition-colors", isActive ? "text-foreground" : isCompleted ? "text-foreground/70 hover:text-foreground" : "text-muted-foreground hover:text-foreground/70")">
                    <span class="relative">
                        @if (isCompleted && !isActive)
                        {
                            <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-500" />
                        }
                        else
                        {
                            <span class="@(isActive ? "text-blue-500" : "")">
                                <LucideIconCn Name="@step.Icon" Size="16" Class="size-4" />
                            </span>
                        }
                    </span>
                    <span class="hidden font-medium text-xs sm:inline">@step.Label</span>
                    @if (isActive)
                    {
                        <span class="absolute inset-x-0 bottom-0 h-0.5 bg-blue-500"></span>
                    }
                </button>
            }
        </div>

        @* Content area *@
        <div class="px-4 py-4">
            <div class="mb-1 font-medium text-sm">@ActiveContent.Title</div>
            <p class="mb-4 text-muted-foreground text-xs">@ActiveContent.Description</p>

            <div>
                @for (var i = 0; i < ActiveContent.Items.Length; i++)
                {
                    var itm = ActiveContent.Items[i];
                    <div class="@Cn.Merge("flex items-center justify-between py-2.5", i < ActiveContent.Items.Length - 1 ? "border-b" : "")">
                        <span class="text-muted-foreground text-xs">@itm.Label</span>
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@itm.Value</span>
                            @if (!string.IsNullOrEmpty(itm.Tag))
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 px-1.5 font-normal text-[10px]">
                                    @itm.Tag
                                </BadgeCn>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(ActiveIndex == 0)" OnClick="HandleBack">
                Back
            </ButtonCn>
            <div class="flex items-center gap-1.5">
                @foreach (var stp in _steps)
                {
                    var step = stp;
                    <span class="@Cn.Merge("size-1.5 rounded-full transition-colors", _activeTab == step.Id ? "bg-blue-500" : _completed.Contains(step.Id) ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                }
            </div>
            @if (ActiveIndex < _steps.Length - 1)
            {
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="MarkCompleteAndNext">
                    Continue
                </ButtonCn>
            }
            else
            {
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="DeployNow">
                    Deploy now
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record StepItem(string Id, string Label, string Icon);
    private record ContentItem(string Label, string Value, string? Tag = null);
    private record StepContent(string Title, string Description, ContentItem[] Items);

    private static readonly StepItem[] _steps =
    [
        new("overview", "Overview", "layout-grid"),
        new("settings", "Settings", "settings"),
        new("members", "Members", "users"),
        new("deploy", "Deploy", "rocket"),
    ];

    private static readonly Dictionary<string, StepContent> _stepContent = new()
    {
        ["overview"] = new("Project overview", "General settings and project metadata.",
        [
            new("Project name", "acme-storefront"),
            new("Framework", "Next.js 16", "Latest"),
            new("Repository", "github.com/acme/storefront"),
            new("Created", "Feb 12, 2026"),
            new("Last deploy", "2 hours ago"),
        ]),
        ["settings"] = new("Environment settings", "Environment variables and build configuration.",
        [
            new("Node version", "22.x"),
            new("Build command", "next build"),
            new("Output directory", ".next"),
            new("Env variables", "12 configured", "3 secret"),
            new("Root directory", "/"),
        ]),
        ["members"] = new("Team members", "Manage who has access to this project.",
        [
            new("Jordan Rivera", "Owner"),
            new("Sam Chen", "Developer"),
            new("Alex Park", "Developer"),
            new("Taylor Kim", "Viewer"),
            new("Pending invites", "2 invitations sent"),
        ]),
        ["deploy"] = new("Deployment", "Review and deploy your project to production.",
        [
            new("Target", "Production"),
            new("Branch", "main"),
            new("Commit", "a3f29b1 — Update hero section"),
            new("Build time", "~48 seconds", "Estimated"),
            new("Domains", "acme.com, www.acme.com"),
        ]),
    };

    private string _activeTab = "overview";
    private readonly HashSet<string> _completed = new();

    private int ActiveIndex => Array.FindIndex(_steps, s => s.Id == _activeTab);
    private StepContent ActiveContent => _stepContent[_activeTab];

    private void MarkCompleteAndNext()
    {
        _completed.Add(_activeTab);
        var nextIndex = ActiveIndex + 1;
        if (nextIndex < _steps.Length)
        {
            _activeTab = _steps[nextIndex].Id;
        }
    }

    private void HandleBack()
    {
        var idx = ActiveIndex;
        if (idx > 0)
        {
            _activeTab = _steps[idx - 1].Id;
        }
    }

    private void DeployNow()
    {
        _completed.Add(_activeTab);
    }
}
