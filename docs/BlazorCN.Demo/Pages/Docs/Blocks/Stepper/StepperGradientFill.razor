@* ============================================================
   Block: stepper-gradient-fill
   Title: StepperGradientFill
   Description: A horizontal stepper with a gradient progress bar from emerald to blue, circular step markers, and smooth fill transitions built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-gradient-fill.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Deployment pipeline</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @(_activeStep + 1) of @_steps.Length
            </span>
        </div>

        @* Gradient progress bar with markers *@
        <div class="border-b px-6 py-8">
            <div class="relative">
                @* Track background *@
                <div class="h-2 w-full rounded-full bg-muted"></div>

                @* Gradient fill *@
                <div
                    class="absolute top-0 left-0 h-2 rounded-full transition-all duration-500 ease-out"
                    style="@($"width:{_fillPercentage}%; background:linear-gradient(to right, #10b981, #3b82f6)")"
                ></div>

                @* Step markers *@
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var idx = index;
                    var isCompleted = index < _activeStep;
                    var isActive = index == _activeStep;
                    var position = (index / (double)(_steps.Length - 1)) * 100;
                    <button
                        type="button"
                        @onclick="@(() => HandleStepClick(idx))"
                        class="absolute top-1/2 -translate-x-1/2 -translate-y-1/2"
                        style="@($"left:{position}%")"
                    >
                        <span class="@Cn.Merge("flex size-8 items-center justify-center rounded-full font-medium text-xs tabular-nums transition-all duration-300", isCompleted ? "bg-emerald-500 text-white shadow-sm dark:bg-emerald-600 cursor-pointer" : isActive ? "bg-blue-500 text-white shadow-md ring-4 ring-blue-500/20 dark:bg-blue-600 dark:ring-blue-400/20 cursor-pointer" : "border-2 border-muted-foreground/20 bg-card text-muted-foreground cursor-default")">
                            @if (isCompleted)
                            {
                                <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                            }
                            else
                            {
                                <span>@(index + 1)</span>
                            }
                        </span>
                    </button>
                }
            </div>

            @* Labels below markers *@
            <div class="mt-7 flex justify-between">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var isActive = index == _activeStep;
                    var isCompleted = index < _activeStep;
                    <span class="@Cn.Merge("max-w-[80px] text-center text-xs", isActive ? "font-medium text-foreground" : isCompleted ? "text-foreground/70" : "text-muted-foreground")">
                        @stp.Label
                    </span>
                }
            </div>
        </div>

        @* Step content *@
        <div class="border-b px-4 py-4">
            <div class="mb-1 font-medium text-sm">@_steps[_activeStep].Label</div>
            <p class="mb-3 text-muted-foreground text-xs">@_steps[_activeStep].Description</p>
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-sm leading-relaxed">@_steps[_activeStep].Detail</p>
            </div>
        </div>

        @* Footer navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" Disabled="@(_activeStep == 0)" OnClick="HandleBack">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <div class="flex items-center gap-1.5">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    <span class="@Cn.Merge("size-1.5 rounded-full transition-colors", index == _activeStep ? "bg-blue-500" : index < _activeStep ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                }
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" Disabled="@(_activeStep == _steps.Length - 1)" OnClick="HandleNext">
                @(_activeStep == _steps.Length - 1 ? "Finish" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Description, string Detail);

    private static readonly StepItem[] _steps =
    [
        new("Initialize",
            "Set up your project environment",
            "Configure the project directory, install dependencies, and initialize version control. The CLI scaffolds your project structure with all necessary configuration files."),
        new("Configure",
            "Define settings and integrations",
            "Set up environment variables, database connections, authentication providers, and third-party service integrations. All secrets are encrypted and stored securely."),
        new("Validate",
            "Run checks and tests",
            "Execute the validation suite to verify database connections, API endpoints, authentication flows, and environment configuration. Any issues are flagged with actionable fix suggestions."),
        new("Execute",
            "Deploy and run the pipeline",
            "Trigger the deployment pipeline with automatic building, testing, and staging. Preview deployments are created for every branch with unique URLs for team review."),
        new("Complete",
            "Verify and finalize",
            "Run post-deployment checks including smoke tests, performance benchmarks, and uptime monitoring. Generate a deployment report with key metrics and share with your team."),
    ];

    private int _activeStep = 2;

    private double _fillPercentage => (_activeStep / (double)(_steps.Length - 1)) * 100;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
