@* ============================================================
   Block: stepper-zigzag-path
   Title: StepperZigzagPath
   Description: A zigzag path stepper wizard with alternating left-right steps connected by diagonal lines, progress tracking, and expandable content built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-zigzag-path.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Project workflow</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Phase <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Zigzag steps *@
        <div class="border-b px-6 py-6">
            <div class="relative">
                @foreach (var stp in _steps)
                {
                    var idx = Array.IndexOf(_steps, stp);
                    var isCompleted = idx < _activeStep;
                    var isActive = idx == _activeStep;
                    var isUpcoming = idx > _activeStep;
                    var isEven = idx % 2 == 0;
                    var isLast = idx == _steps.Length - 1;
                    <div>
                        @* Step row *@
                        <div class="@Cn.Merge("flex items-start gap-3", isEven ? "justify-start" : "flex-row-reverse")">
                            @* Step node *@
                            <button
                                type="button"
                                @onclick="@(() => HandleStepClick(idx))"
                                disabled="@(isUpcoming ? "disabled" : null)"
                                class="@Cn.Merge("flex size-9 shrink-0 items-center justify-center rounded-full font-medium text-sm tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600 cursor-pointer" : isActive ? "bg-blue-500 text-white ring-4 ring-blue-500/20 dark:bg-blue-600 dark:ring-blue-400/20 cursor-pointer" : "border-2 border-muted-foreground/25 text-muted-foreground cursor-default")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="size-4" />
                                }
                                else
                                {
                                    <span>@(idx + 1)</span>
                                }
                            </button>

                            @* Step content card *@
                            <div class="@Cn.Merge("max-w-[280px] rounded-md px-3 py-2.5 transition-colors", isActive ? "bg-muted/50" : isCompleted ? "bg-muted/30" : "bg-transparent", isEven ? "text-left" : "text-right")">
                                <span class="@Cn.Merge("font-medium text-sm", isActive || isCompleted ? "text-foreground" : "text-muted-foreground")">
                                    @stp.Label
                                </span>
                                <p class="mt-0.5 text-muted-foreground text-xs">@stp.Description</p>
                                @if (isActive)
                                {
                                    <p class="mt-2 text-sm leading-relaxed">@stp.Detail</p>
                                }
                            </div>
                        </div>

                        @* Diagonal connector *@
                        @if (!isLast)
                        {
                            <div class="flex justify-center py-1">
                                <svg width="200" height="32" viewBox="0 0 200 32" fill="none" class="text-muted-foreground/20">
                                    <title>@($"Connection from {stp.Label} to {_steps[idx + 1].Label}")</title>
                                    <path
                                        d="@(isEven ? "M 40 0 C 60 16, 140 16, 160 32" : "M 160 0 C 140 16, 60 16, 40 32")"
                                        stroke="@(isCompleted ? "rgb(16 185 129)" : "currentColor")"
                                        stroke-width="2"
                                        stroke-dasharray="@(isUpcoming ? "4 4" : "none")"
                                        fill="none" />
                                </svg>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeStep == 0)" OnClick="HandleBack">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeStep == _steps.Length - 1)" OnClick="HandleNext">
                @(_activeStep == _steps.Length - 1 ? "Complete" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Description, string Detail);

    private static readonly StepItem[] _steps =
    [
        new("Discovery", "Research and requirements gathering",
            "Stakeholder interviews completed. 12 user personas identified. Competitive analysis covers 5 market leaders. Requirements document finalized with 47 user stories."),
        new("Strategy", "Planning and architecture decisions",
            "Technical architecture selected: microservices with event-driven communication. Sprint planning complete for 6 two-week sprints. Risk assessment identifies 3 high-priority mitigations."),
        new("Execution", "Development and implementation",
            "Core API endpoints built and tested. Frontend components integrated with design system. CI/CD pipeline configured with automated testing on every push to main branch."),
        new("Analysis", "Testing and quality assurance",
            "Load testing shows 2,400 requests per second at p99 latency of 180ms. Security audit passed with zero critical findings. Accessibility score at 98/100 across all pages."),
        new("Optimization", "Performance tuning and launch",
            "Bundle size reduced by 34% with code splitting. Database queries optimized with composite indexes. CDN configured across 12 edge regions. Launch checklist complete."),
    ];

    private int _activeStep = 2;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
