@* ============================================================
   Block: stepper-premium-showcase
   Title: StepperPremiumShowcase
   Description: An all-in-one premium stepper wizard with numbered step indicators, progress bar, contextual tips panel, draft save indicator, and full keyboard navigation built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-premium-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with step counter *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">New project</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">
                    Step <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_wizardSteps.Length</span>
                </span>
            </div>
            <div class="flex items-center gap-2">
                <span class="@Cn.Merge("text-xs transition-opacity duration-300", _draftSaved ? "text-muted-foreground" : "text-muted-foreground/50")">
                    @(_draftSaved ? "Draft saved" : "Saving...")
                </span>
                <span class="@Cn.Merge("size-1.5 rounded-full transition-colors duration-300", _draftSaved ? "bg-emerald-500" : "bg-amber-500")"></span>
            </div>
        </div>

        @* Horizontal step indicator *@
        <div class="flex items-center justify-between border-b px-4 py-4">
            @for (int i = 0; i < _wizardSteps.Length; i++)
            {
                var step = _wizardSteps[i];
                var index = i;
                var isComplete = index < _activeStep;
                var isCurrent = index == _activeStep;
                var disabledAttr = index > _activeStep ? "disabled" : null;
                <div class="flex items-center">
                    <button
                        type="button" aria-label="@($"Step {index + 1}: {step.Label}")"
                        @onclick="@(() => { if (index <= _activeStep) _activeStep = index; })"
                        disabled="@disabledAttr"
                        class="@Cn.Merge("flex items-center gap-2", index > _activeStep ? "cursor-default" : "cursor-pointer")">
                        <span class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full text-xs transition-all duration-200", isComplete ? "bg-emerald-500 text-white dark:bg-emerald-600" : isCurrent ? "bg-foreground text-background" : "border border-muted-foreground/25 text-muted-foreground")">
                            @if (isComplete)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                            }
                            else
                            {
                                <LucideIconCn Name="@step.IconName" Size="12" Class="size-3" />
                            }
                        </span>
                        <span class="@Cn.Merge("hidden text-xs sm:inline", isCurrent ? "font-medium text-foreground" : "text-muted-foreground")">
                            @step.ShortLabel
                        </span>
                    </button>
                    @if (index < _wizardSteps.Length - 1)
                    {
                        <div class="@Cn.Merge("mx-2 hidden h-px w-6 sm:block lg:w-10", isComplete ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")"></div>
                    }
                </div>
            }
        </div>

        @* Content area: split layout *@
        <div class="flex">
            @* Left: Step content *@
            <div class="min-w-0 flex-1 border-r px-5 py-4">
                <div class="mb-4">
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">@_wizardSteps[_activeStep].Label</span>
                        @if (_isLastStep)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Final step</BadgeCn>
                        }
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_wizardSteps[_activeStep].Description</p>
                </div>

                <div class="space-y-2">
                    @foreach (var field in _wizardSteps[_activeStep].Fields)
                    {
                        var f = field;
                        <div class="rounded-md bg-muted/30 px-3 py-2.5">
                            <div class="flex items-center justify-between">
                                <span class="font-medium text-muted-foreground text-xs">@f.Label</span>
                                <span class="text-sm">@f.Value</span>
                            </div>
                            @if (!string.IsNullOrEmpty(f.Note))
                            {
                                <p class="mt-1 text-muted-foreground text-xs">@f.Note</p>
                            }
                        </div>
                    }
                </div>
            </div>

            @* Right: Tips panel *@
            <div class="hidden w-64 shrink-0 md:block">
                <div class="px-4 py-4">
                    <div class="mb-3 flex items-center gap-1.5">
                        <LucideIconCn Name="info" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-medium text-muted-foreground text-xs">Tips</span>
                    </div>
                    <div class="space-y-3">
                        @foreach (var tip in _wizardSteps[_activeStep].Tips)
                        {
                            var t = tip;
                            <div class="rounded-md bg-muted/30 p-3">
                                <span class="block font-medium text-xs">@t.Title</span>
                                <p class="mt-1 text-muted-foreground text-xs leading-relaxed">@t.Description</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Progress bar *@
        <div class="h-0.5 w-full bg-muted/50">
            <div
                class="h-full bg-foreground transition-all duration-500"
                style="@($"width:{_progressPercent}%")">
            </div>
        </div>

        @* Footer navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-3">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeStep == 0)" OnClick="HandleBack">
                    <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                    Back
                </ButtonCn>
                <div class="h-4 w-px bg-border"></div>
                <button
                    type="button"
                    class="text-muted-foreground text-xs transition-colors hover:text-foreground"
                    @onclick="HandleSaveDraft">
                    Save draft
                </button>
            </div>
            <div class="flex items-center gap-3">
                <span class="hidden text-muted-foreground text-xs sm:inline tabular-nums">
                    @((int)Math.Round(_progressPercent))% complete
                </span>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext">
                    @if (_isLastStep)
                    {
                        <LucideIconCn Name="rocket" Size="12" Class="size-3" />
                        <text>Launch project</text>
                    }
                    else
                    {
                        <text>Continue</text>
                        <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                    }
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record StepField(string Label, string Value, string? Note = null);
    private record StepTip(string Title, string Description);
    private record WizardStep(string Label, string ShortLabel, string Description, string IconName, StepField[] Fields, StepTip[] Tips);

    private static readonly WizardStep[] _wizardSteps =
    [
        new("Project name", "Name", "Choose a name and identifier for your project", "type",
            [
                new("Project name", "Acme Dashboard"),
                new("Slug", "acme-dashboard", "Used in URLs and API paths"),
                new("Description", "Internal analytics and reporting platform"),
                new("Visibility", "Team only"),
            ],
            [
                new("Naming convention", "Use lowercase with hyphens for the slug. It cannot be changed after deployment."),
                new("Visibility", "Team only restricts access to workspace members. Public projects are visible to anyone with the URL."),
            ]),
        new("Template", "Template", "Start from a pre-built template or blank project", "layout-template",
            [
                new("Template", "SaaS Starter Kit"),
                new("Includes", "Auth, Billing, Dashboard, API"),
                new("Framework", "Next.js 16 (App Router)"),
                new("Styling", "Tailwind CSS 4 + shadcn/ui"),
            ],
            [
                new("SaaS Starter Kit", "Includes authentication, Stripe billing, admin dashboard, and API routes out of the box."),
                new("Customization", "All template files are fully editable. Remove or modify any included feature after creation."),
            ]),
        new("Database", "DB", "Configure your database connection and ORM", "database",
            [
                new("Provider", "PostgreSQL (Neon Serverless)"),
                new("ORM", "Prisma 6"),
                new("Connection pooling", "Enabled (PgBouncer)"),
                new("Region", "US East (Virginia)"),
            ],
            [
                new("Serverless databases", "Neon provides instant branching for preview deployments. Each PR gets its own database branch."),
                new("Connection pooling", "Required for serverless functions. PgBouncer manages connection limits automatically."),
            ]),
        new("Auth provider", "Auth", "Set up authentication and access control", "key",
            [
                new("Provider", "Better Auth"),
                new("OAuth providers", "Google, GitHub"),
                new("Magic link", "Enabled (Resend)"),
                new("Session duration", "7 days"),
            ],
            [
                new("Better Auth", "Framework-agnostic auth with built-in adapters for Prisma, rate limiting, and session management."),
                new("OAuth setup", "You will need to create OAuth apps in Google Cloud Console and GitHub Developer Settings."),
            ]),
        new("Deployment", "Deploy", "Configure build and deployment settings", "cloud",
            [
                new("Platform", "Vercel"),
                new("Build command", "next build"),
                new("Region", "US East (iad1)"),
                new("Preview deployments", "Enabled (every PR)"),
            ],
            [
                new("Edge functions", "API routes can run on the Edge for lower latency. Add export const runtime = 'edge' to opt in."),
                new("Environment variables", "Production secrets are encrypted and only accessible during build and runtime. Never commit them to git."),
            ]),
        new("Launch", "Launch", "Review everything and launch your project", "rocket",
            [
                new("Project", "Acme Dashboard"),
                new("Template", "SaaS Starter Kit (Next.js 16)"),
                new("Database", "PostgreSQL on Neon (US East)"),
                new("Auth", "Better Auth (Google, GitHub, Magic Link)"),
                new("Deploy target", "Vercel (US East, Preview enabled)"),
            ],
            [
                new("After launch", "Your project will be live at acme-dashboard.vercel.app within 60 seconds. Custom domain can be added later."),
                new("Next steps", "Clone the repo, run the dev server, and start building. The template includes a getting started guide."),
            ]),
    ];

    private int _activeStep = 2;
    private bool _draftSaved = true;

    private double _progressPercent => ((_activeStep + 1.0) / _wizardSteps.Length) * 100.0;
    private bool _isLastStep => _activeStep == _wizardSteps.Length - 1;

    private async Task HandleNext()
    {
        if (_activeStep < _wizardSteps.Length - 1)
        {
            _activeStep++;
            _draftSaved = false;
            StateHasChanged();
            await Task.Delay(800);
            _draftSaved = true;
        }
    }

    private async Task HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
            _draftSaved = false;
            StateHasChanged();
            await Task.Delay(800);
            _draftSaved = true;
        }
    }

    private async Task HandleSaveDraft()
    {
        _draftSaved = false;
        StateHasChanged();
        await Task.Delay(800);
        _draftSaved = true;
    }
}
