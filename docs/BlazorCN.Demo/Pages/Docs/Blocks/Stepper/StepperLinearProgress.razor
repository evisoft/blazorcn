@* ============================================================
   Block: stepper-linear-progress
   Title: StepperLinearProgress
   Description: A linear progress bar stepper with diamond markers, animated fill, and step content built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-linear-progress.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Data Pipeline</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Step <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Progress bar with markers *@
        <div class="border-b px-6 pb-8 pt-10">
            <div class="relative">
                @* Background track *@
                <div class="h-1.5 w-full rounded-full bg-muted-foreground/15"></div>

                @* Filled track *@
                <div
                    class="absolute top-0 left-0 h-1.5 rounded-full bg-emerald-500 transition-all duration-500 ease-out dark:bg-emerald-600"
                    style="@($"width:{ProgressPercent}%")">
                </div>

                @* Active segment pulse *@
                @if (_activeStep < _steps.Length - 1)
                {
                    <div
                        class="absolute top-0 h-1.5 rounded-full bg-blue-500/40 transition-all duration-500 ease-out dark:bg-blue-400/40"
                        style="@($"left:{ProgressPercent}%;width:{SegmentWidth}%")">
                    </div>
                }

                @* Diamond markers *@
                @foreach (var stp in _steps)
                {
                    var idx = Array.IndexOf(_steps, stp);
                    var isCompleted = idx < _activeStep;
                    var isActive = idx == _activeStep;
                    var isUpcoming = idx > _activeStep;
                    var position = _steps.Length > 1 ? (double)idx / (_steps.Length - 1) * 100 : 0.0;
                    var capturedIdx = idx;
                    <div
                        class="absolute top-1/2 -translate-x-1/2 -translate-y-1/2"
                        style="@($"left:{position}%")">
                        <button
                            type="button"
                            @onclick="@(() => HandleMarkerClick(capturedIdx))"
                            disabled="@isUpcoming"
                            class="@Cn.Merge("flex size-7 items-center justify-center rotate-45 rounded-sm transition-all duration-300", isCompleted ? "bg-emerald-500 shadow-sm dark:bg-emerald-600 cursor-pointer" : isActive ? "bg-blue-500 shadow-md shadow-blue-500/25 ring-4 ring-blue-500/20 dark:bg-blue-600 dark:ring-blue-400/20 cursor-pointer" : "border-2 border-muted-foreground/25 bg-card cursor-default")">
                            <span class="-rotate-45">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-white" />
                                }
                                else
                                {
                                    <span class="@Cn.Merge("font-medium text-xs tabular-nums", isActive ? "text-white" : "text-muted-foreground")">
                                        @(idx + 1)
                                    </span>
                                }
                            </span>
                        </button>

                        @* Label below marker *@
                        <div class="-rotate-0 mt-3 flex flex-col items-center text-center">
                            <span class="@Cn.Merge("whitespace-nowrap font-medium text-xs", isActive ? "text-foreground" : isCompleted ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">
                                @stp.Label
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Step content *@
        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@_steps[_activeStep].Description</p>
            </div>
            <p class="mb-4 text-muted-foreground text-sm leading-relaxed">
                @_steps[_activeStep].Detail
            </p>
            <div class="space-y-2">
                @foreach (var stat in _stepStats[_activeStep])
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                        <span class="font-medium text-muted-foreground text-xs">@stat.Label</span>
                        <span class="font-medium text-sm tabular-nums">@stat.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Publish" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Description, string Detail);
    private record StatItem(string Label, string Value);

    private static readonly StepItem[] _steps =
    [
        new("Upload", "Select files to process",
            "Drag and drop your files or browse to select. Supported formats include CSV, JSON, and XML up to 50 MB each."),
        new("Process", "Transform and validate data",
            "Files are parsed, validated against your schema, and transformed into the target format. Invalid rows are flagged for review."),
        new("Review", "Check results before publishing",
            "Preview the processed output, resolve any flagged issues, and confirm the data meets your quality requirements."),
        new("Publish", "Deploy to production",
            "Push the validated data to your production environment. A rollback snapshot is created automatically before deployment."),
    ];

    private static readonly StatItem[][] _stepStats =
    [
        [new("Files selected", "3"), new("Total size", "12.4 MB"), new("Format", "CSV")],
        [new("Rows parsed", "48,291"), new("Valid rows", "47,856"), new("Flagged", "435")],
        [new("Issues resolved", "412"), new("Remaining", "23"), new("Quality score", "98.2%")],
        [new("Target", "prod-us-east"), new("Records", "48,268"), new("Est. time", "~45s")],
    ];

    private int _activeStep = 1;

    private double ProgressPercent => _steps.Length > 1 ? (double)_activeStep / (_steps.Length - 1) * 100 : 0;
    private double SegmentWidth => _steps.Length > 1 ? 100.0 / (_steps.Length - 1) : 100.0;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleMarkerClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
