@* ============================================================
   Block: stepper-accordion-expand
   Title: StepperAccordionExpand
   Description: An accordion-style stepper where the active step expands to reveal form content while completed and upcoming steps stay collapsed built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-accordion-expand.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Application form</span>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_activeStep of @_steps.Length complete
                </span>
            </div>
        </div>

        @* Steps *@
        <div>
            @foreach (var stepEntry in _steps.Select((s, i) => new { Step = s, Index = i }))
            {
                var idx = stepEntry.Index;
                var step = stepEntry.Step;
                var isCompleted = idx < _activeStep;
                var isActive = idx == _activeStep;
                var isUpcoming = idx > _activeStep;
                var isLast = idx == _steps.Length - 1;

                <div class="@(isLast ? "" : "border-b")">
                    @* Step header row *@
                    <button
                        type="button"
                        @onclick="@(() => HandleStepClick(idx))"
                        disabled="@isUpcoming"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors", isUpcoming ? "cursor-default opacity-50" : isActive ? "bg-muted/30" : "cursor-pointer hover:bg-muted/50")">

                        @* Step indicator *@
                        <span class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full text-xs tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-foreground text-background" : "border border-muted-foreground/25 text-muted-foreground")">
                            @if (isCompleted)
                            {
                                <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                            }
                            else if (isUpcoming)
                            {
                                <LucideIconCn Name="lock" Size="12" Class="size-3" />
                            }
                            else
                            {
                                <span>@(idx + 1)</span>
                            }
                        </span>

                        @* Step text *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", (isActive || isCompleted) ? "text-foreground" : "text-muted-foreground")">
                                    @step.Label
                                </span>
                                @if (isCompleted)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Completed</BadgeCn>
                                }
                            </div>
                            @if (isCompleted)
                            {
                                <p class="mt-0.5 truncate text-muted-foreground text-xs">@step.Summary</p>
                            }
                            else
                            {
                                <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>
                            }
                        </div>

                        @* Chevron *@
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isActive ? "rotate-90" : "")" />
                    </button>

                    @* Expanded content *@
                    @if (isActive)
                    {
                        <div class="border-t bg-muted/20 px-4 py-4">
                            <div class="space-y-2 pl-10">
                                @foreach (var field in step.Fields)
                                {
                                    <div class="flex items-center justify-between rounded-md bg-background/80 px-3 py-2.5">
                                        <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                                        <span class="text-sm">@field.Value</span>
                                    </div>
                                }

                                <div class="pt-2">
                                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleContinue" Disabled="@(_activeStep == _steps.Length - 1)">
                                        @(_activeStep == _steps.Length - 1 ? "Submit application" : "Continue")
                                        @if (_activeStep < _steps.Length - 1)
                                        {
                                            <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                                        }
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StepField(string Label, string Value);
    private record StepItem(string Label, string Description, string Summary, StepField[] Fields);

    private int _activeStep = 2;

    private static readonly StepItem[] _steps =
    [
        new("Personal details", "Full name, email, phone, and date of birth",
            "Alex Johnson, alex@example.com, +1 (555) 234-5678",
            [
                new("Full name", "Alex Johnson"),
                new("Email address", "alex@example.com"),
                new("Phone number", "+1 (555) 234-5678"),
                new("Date of birth", "March 15, 1992"),
            ]),
        new("Employment", "Current employer, role, and work history",
            "Senior Engineer at Acme Corp, 4 years",
            [
                new("Current employer", "Acme Corporation"),
                new("Job title", "Senior Software Engineer"),
                new("Years at company", "4 years"),
                new("Annual income", "$145,000"),
            ]),
        new("Education", "Degrees, institutions, and certifications",
            "BS Computer Science, MIT, 2014",
            [
                new("Degree", "Bachelor of Science"),
                new("Major", "Computer Science"),
                new("Institution", "Massachusetts Institute of Technology"),
                new("Graduation year", "2014"),
            ]),
        new("References", "Professional references and contact information",
            "2 references provided",
            [
                new("Reference 1", "Sarah Chen, VP Engineering"),
                new("Contact 1", "sarah.chen@acme.com"),
                new("Reference 2", "Michael Park, CTO"),
                new("Contact 2", "m.park@techcorp.io"),
            ]),
        new("Submit", "Review your application and submit",
            "Application submitted",
            [
                new("Applicant", "Alex Johnson"),
                new("Position", "Senior Software Engineer"),
                new("Education", "BS Computer Science, MIT"),
                new("References", "2 professional references"),
            ]),
    ];

    private void HandleContinue()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
