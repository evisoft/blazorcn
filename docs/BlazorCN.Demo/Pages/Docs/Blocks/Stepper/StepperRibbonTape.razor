@* ============================================================
   Block: stepper-ribbon-tape
   Title: StepperRibbonTape
   Description: A ribbon tape stepper with a winding horizontal band, segment-based progress coloring, and fold effects built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-ribbon-tape.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Production pipeline</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Stage <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Ribbon *@
        <div class="border-b px-4 py-6">
            @* Ribbon band *@
            <div class="relative">
                @* Top row: segments flowing left to right *@
                <div class="flex">
                    @foreach (var stp in _steps)
                    {
                        var step = stp;
                        var index = Array.IndexOf(_steps, step);
                        var isCompleted = index < _activeStep;
                        var isActive = index == _activeStep;
                        var isUpcoming = index > _activeStep;
                        var isLast = index == _steps.Length - 1;
                        <div class="flex flex-1 items-stretch">
                            @* Segment *@
                            <button
                                type="button"
                                @onclick="@(() => HandleStepClick(index))"
                                disabled="@(isUpcoming ? "disabled" : null)"
                                class="@Cn.Merge("relative flex w-full flex-col items-center justify-center rounded-sm px-1 py-3 transition-all duration-300", isCompleted ? "bg-emerald-500/10 dark:bg-emerald-500/15 cursor-pointer" : isActive ? "bg-blue-500/10 dark:bg-blue-500/15 cursor-pointer" : "bg-muted/30 cursor-default")">
                                @* Step indicator *@
                                <span class="@Cn.Merge("mb-1.5 flex size-7 items-center justify-center rounded-full text-xs tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-blue-500 text-white ring-2 ring-blue-500/30 dark:bg-blue-600" : "border border-muted-foreground/25 text-muted-foreground")">
                                    @if (isCompleted)
                                    {
                                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                                    }
                                    else
                                    {
                                        <span>@(index + 1)</span>
                                    }
                                </span>

                                @* Label *@
                                <span class="@Cn.Merge("text-center font-medium text-xs", isActive ? "text-foreground" : isCompleted ? "text-foreground" : "text-muted-foreground")">
                                    @step.Label
                                </span>

                                @* Duration *@
                                <span class="mt-0.5 font-mono text-muted-foreground text-xs">
                                    @step.Duration
                                </span>

                                @* Bottom edge line (ribbon edge) *@
                                <div class="@Cn.Merge("absolute bottom-0 left-0 right-0 h-0.5 transition-colors duration-300", isCompleted ? "bg-emerald-500 dark:bg-emerald-600" : isActive ? "bg-blue-500 dark:bg-blue-600" : "bg-muted-foreground/15")"></div>

                                @* Top edge line (ribbon edge) *@
                                <div class="@Cn.Merge("absolute top-0 left-0 right-0 h-0.5 transition-colors duration-300", isCompleted ? "bg-emerald-500 dark:bg-emerald-600" : isActive ? "bg-blue-500 dark:bg-blue-600" : "bg-muted-foreground/15")"></div>
                            </button>

                            @* Fold between segments *@
                            @if (!isLast)
                            {
                                <div class="relative flex w-2 shrink-0 items-center">
                                    <div class="@Cn.Merge("h-full w-px transition-colors duration-300", isCompleted ? "bg-emerald-500/30" : "bg-muted-foreground/10")"></div>
                                    @* Fold diamond *@
                                    <div class="@Cn.Merge("absolute left-1/2 top-1/2 size-1.5 -translate-x-1/2 -translate-y-1/2 rotate-45 transition-colors duration-300", isCompleted ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")"></div>
                                </div>
                            }
                        </div>
                    }
                </div>

                @* Tick marks along the bottom *@
                <div class="mt-1 flex justify-between px-2">
                    @for (int i = 0; i < 21; i++)
                    {
                        <div class="@Cn.Merge("h-1 w-px", i % 5 == 0 ? "bg-muted-foreground/30" : "bg-muted-foreground/10")"></div>
                    }
                </div>
            </div>

            @* Active step detail *@
            <div class="mt-4 rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center justify-between">
                    <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
                    <span class="font-mono text-muted-foreground text-xs">@_steps[_activeStep].Duration</span>
                </div>
                <p class="text-muted-foreground text-xs">@_steps[_activeStep].Description</p>
                <p class="mt-2 text-sm leading-relaxed">@_steps[_activeStep].Detail</p>
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Ship it" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepData(string Label, string Description, string Detail, string Duration);

    private static readonly StepData[] _steps =
    [
        new("Measure", "Define scope and specifications",
            "Requirements mapped to 5 epics with 34 user stories. Acceptance criteria defined. Technical feasibility confirmed for all critical paths.",
            "3 days"),
        new("Cut", "Break down into deliverables",
            "Epics split into 12 sprint-sized deliverables. Dependencies identified and sequenced. Resource allocation finalized across 3 teams.",
            "2 days"),
        new("Assemble", "Build and integrate components",
            "Core modules implemented: auth, data layer, and UI framework. Integration tests passing at 94%. API contracts validated against OpenAPI spec.",
            "14 days"),
        new("Finish", "QA, polish, and documentation",
            "End-to-end tests cover 23 critical user flows. Documentation site generated with 48 pages. Performance benchmarks meet all SLA targets.",
            "5 days"),
        new("Deliver", "Deploy and hand off to stakeholders",
            "Blue-green deployment executed with zero downtime. Stakeholder demo completed successfully. Support runbook handed off to operations team.",
            "1 day"),
    ];

    private int _activeStep = 2;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
