@* ============================================================
   Block: stepper-micro-dots
   Title: StepperMicroDots
   Description: A micro dot stepper with hover-reveal labels, color-coded states, and minimal footprint built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-micro-dots.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Pipeline</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @(_activeStep + 1) of @_steps.Length
            </span>
        </div>

        @* Micro dots *@
        <div class="flex items-center justify-center border-b px-4 py-4">
            <div class="relative flex items-center gap-1">
                @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
                {
                    var idx = entry.Index;
                    var step = entry.Step;
                    var isCompleted = idx < _activeStep;
                    var isActive = idx == _activeStep;
                    var isHovered = _hoveredDot == idx;

                    var dotClass = Cn.Merge(
                        "block rounded-full transition-all duration-200",
                        isActive
                            ? "size-2.5 bg-blue-500 shadow-[0_0_6px_rgba(59,130,246,0.4)] dark:bg-blue-400 dark:shadow-[0_0_6px_rgba(96,165,250,0.4)]"
                            : isCompleted
                                ? "size-2 bg-emerald-500 hover:bg-emerald-600 dark:bg-emerald-400"
                                : "size-2 bg-muted-foreground/20 hover:bg-muted-foreground/35");

                    var labelClass = Cn.Merge(
                        "pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-foreground/90 px-2 py-1 font-medium text-background text-[10px] transition-opacity duration-150",
                        isHovered ? "opacity-100" : "opacity-0");

                    <div class="group relative">
                        @* Hover label *@
                        <span class="@labelClass">@step.Name</span>

                        @* Dot *@
                        <button
                            type="button" aria-label="@($"Step {idx + 1}: {step.Name}")"
                            @onclick="@(() => SetActiveStep(idx))"
                            @onmouseenter="@((Microsoft.AspNetCore.Components.Web.MouseEventArgs e) => SetHoveredDot(idx))"
                            @onmouseleave="@((Microsoft.AspNetCore.Components.Web.MouseEventArgs e) => ClearHoveredDot())"
                            class="inline-flex size-6 items-center justify-center">
                            <span class="@dotClass"></span>
                        </button>
                    </div>
                }
            </div>
        </div>

        @* Content *@
        <div class="border-b px-6 py-6">
            <div class="flex items-start justify-between gap-4">
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">@_steps[_activeStep].Heading</span>
                        @if (_activeStep < _steps.Length - 1)
                        {
                            <span class="text-muted-foreground/50 text-xs">@_steps[_activeStep].Name</span>
                        }
                    </div>
                    <p class="mt-2 text-muted-foreground text-sm leading-relaxed">
                        @_steps[_activeStep].Description
                    </p>
                    <p class="mt-3 text-muted-foreground/60 text-xs">@_steps[_activeStep].Detail</p>
                </div>
                @if (_activeStep < _steps.Length)
                {
                    <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2 py-1">
                        @if (_activeStep > 0)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500 dark:text-emerald-400" />
                        }
                        <span class="text-muted-foreground text-xs tabular-nums">
                            @_activeStep/@(_steps.Length - 1)
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Complete" : "Next")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Name, string Heading, string Description, string Detail);

    private int _activeStep = 2;
    private int? _hoveredDot = null;

    private static readonly StepItem[] _steps =
    [
        new("Init",
            "Initialize project",
            "Scaffold the project structure with the recommended directory layout. Includes configuration files for TypeScript, ESLint, and your package manager.",
            "Estimated time: 30 seconds"),
        new("Config",
            "Configure environment",
            "Set up environment variables, database connection strings, and API keys. Values are encrypted at rest and scoped per deployment environment.",
            "3 variables required"),
        new("Build",
            "Build pipeline",
            "Define your build steps including compilation, bundling, and asset optimization. The pipeline runs automatically on each push to the main branch.",
            "Average build time: 42s"),
        new("Test",
            "Run test suite",
            "Execute unit tests, integration tests, and end-to-end checks. Coverage reports are generated automatically and compared against the minimum threshold.",
            "Coverage threshold: 80%"),
        new("Deploy",
            "Deploy to production",
            "Ship your application to the production environment with zero-downtime deployment. Automatic rollback triggers if health checks fail within the first 5 minutes.",
            "Region: us-east-1"),
        new("Monitor",
            "Enable monitoring",
            "Activate real-time performance monitoring, error tracking, and uptime alerts. Dashboards are pre-configured with the most important metrics for your stack.",
            "Alerts configured for 3 channels"),
    ];

    private void SetActiveStep(int index)
    {
        _activeStep = index;
    }

    private void SetHoveredDot(int index)
    {
        _hoveredDot = index;
    }

    private void ClearHoveredDot()
    {
        _hoveredDot = null;
    }

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }
}
