@* ============================================================
   Block: stepper-draft-saved
   Title: StepperDraftSaved
   Description: A multi-step form stepper with auto-save indicators, draft status per step, and global save state display built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-draft-saved.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with global save status *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">New article</span>
                <span class="text-muted-foreground text-xs">
                    @(_saveStatuses.Count(s => s == SaveStatus.Saved)) of @_steps.Length saved
                </span>
            </div>
            <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="cloud" Size="14" Class="size-3.5" />
                    <span>Last saved 2 min ago</span>
                </div>
            </div>
        </div>

        @* Step indicators with save status *@
        <div class="border-b px-6 py-5">
            <div class="flex items-center">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var status = _saveStatuses[index];
                    var isActive = index == _activeStep;
                    var isSaved = status == SaveStatus.Saved;
                    var isPending = status == SaveStatus.Pending;
                    var isDraft = status == SaveStatus.Draft;
                    var isSaving = status == SaveStatus.Saving;
                    var lastSavedIdx = Array.LastIndexOf(_saveStatuses, SaveStatus.Saved);
                    var isAccessible = index <= Math.Max(_activeStep, lastSavedIdx + 1);
                    var btnDisabled = !isAccessible ? "disabled" : null;
                    <div class="flex flex-1 items-center last:flex-none">
                        <div class="flex flex-col items-center gap-1.5">
                            <button
                                type="button" aria-label="@($"Step {index + 1}: {stp.Label}")"
                                @onclick="@(() => HandleStepClick(index))"
                                disabled="@btnDisabled"
                                class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full text-xs tabular-nums transition-all duration-200", (isSaved && !isActive) ? "bg-emerald-500 text-white dark:bg-emerald-600 cursor-pointer" : isActive ? "bg-foreground text-background cursor-pointer" : isPending ? "border border-dashed border-muted-foreground/30 text-muted-foreground cursor-default" : isDraft ? "border border-dashed border-amber-500/50 text-amber-600 dark:text-amber-400 cursor-pointer" : "border border-muted-foreground/25 text-muted-foreground cursor-default")">
                                @if (isSaved && !isActive)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else if (isSaving)
                                {
                                    <LucideIconCn Name="loader" Size="14" Class="size-3.5 animate-spin" />
                                }
                                else
                                {
                                    <span class="font-medium">@(index + 1)</span>
                                }
                            </button>
                            <div class="flex flex-col items-center">
                                <span class="@Cn.Merge("text-center font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                    @stp.Label
                                </span>
                                @if (!isActive)
                                {
                                    <span class="@Cn.Merge("mt-0.5 text-center text-xs", GetSaveStatusClass(status))">
                                        @GetSaveStatusLabel(status)
                                    </span>
                                }
                            </div>
                        </div>

                        @if (index < _steps.Length - 1)
                        {
                            <div class="mx-3 mb-8 h-px flex-1">
                                <div class="@Cn.Merge("h-full transition-colors duration-300", isSaved ? "bg-emerald-500 dark:bg-emerald-600" : (isDraft || isSaving) ? "bg-amber-500/40" : "bg-muted-foreground/20", (isPending || isDraft) ? "border-t border-dashed border-muted-foreground/20 bg-transparent" : "")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Active step content *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <div>
                    <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_steps[_activeStep].Description
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    @if (_saveStatuses[_activeStep] == SaveStatus.Saving)
                    {
                        <span class="flex items-center gap-1.5 text-blue-600 text-xs dark:text-blue-400">
                            <LucideIconCn Name="loader" Size="12" Class="size-3 animate-spin" />
                            Saving...
                        </span>
                    }
                    else if (_saveStatuses[_activeStep] == SaveStatus.Saved)
                    {
                        <span class="flex items-center gap-1.5 text-emerald-600 text-xs dark:text-emerald-400">
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                            Saved
                        </span>
                    }
                    else if (_saveStatuses[_activeStep] == SaveStatus.Draft)
                    {
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="HandleSaveNow">
                            <LucideIconCn Name="cloud" Size="12" Class="size-3" />
                            Save now
                        </ButtonCn>
                    }
                </div>
            </div>
            <div class="space-y-2">
                @foreach (var field in _stepContent[_activeStep])
                {
                    <div class="@Cn.Merge("flex items-center justify-between rounded-md px-3 py-2.5", _saveStatuses[_activeStep] == SaveStatus.Pending ? "border border-dashed border-muted-foreground/15 bg-muted/20" : "bg-muted/30")">
                        <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                        <span class="@Cn.Merge("text-sm", _saveStatuses[_activeStep] == SaveStatus.Pending ? "text-muted-foreground" : "")">
                            @(_saveStatuses[_activeStep] == SaveStatus.Pending ? "—" : field.Value)
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeStep == 0)" OnClick="HandleBack">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeStep == _steps.Length - 1)" OnClick="HandleNext">
                @(_activeStep == _steps.Length - 1 ? "Publish" : "Save & continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private enum SaveStatus { Saved, Saving, Draft, Pending }

    private record StepItem(string Label, string Description);
    private record FieldItem(string Label, string Value);

    private static readonly StepItem[] _steps =
    [
        new("Title & description", "Name your content and write a summary"),
        new("Media upload", "Add images, video, or attachments"),
        new("Tags & categories", "Organize with labels and groups"),
        new("Publishing options", "Schedule, visibility, and distribution"),
    ];

    private static readonly FieldItem[][] _stepContent =
    [
        [
            new("Title", "Getting Started with Server Components"),
            new("Slug", "getting-started-server-components"),
            new("Description", "A practical guide to React Server Components in Next.js"),
            new("Author", "Sarah Chen"),
        ],
        [
            new("Cover image", "cover-rsc-guide.webp (uploaded)"),
            new("Open Graph image", "og-rsc-guide.png (uploaded)"),
            new("Video embed", "None"),
            new("Attachments", "1 file (code-samples.zip)"),
        ],
        [
            new("Category", "Engineering"),
            new("Tags", "React, Next.js, RSC, Tutorial"),
            new("Series", "React Fundamentals (Part 3 of 5)"),
            new("Reading time", "8 min"),
        ],
        [
            new("Status", "Draft"),
            new("Publish date", "Not scheduled"),
            new("Visibility", "Public"),
            new("Newsletter", "Include in weekly digest"),
        ],
    ];

    private int _activeStep = 2;
    private SaveStatus[] _saveStatuses = [SaveStatus.Saved, SaveStatus.Saved, SaveStatus.Draft, SaveStatus.Pending];

    private string GetSaveStatusLabel(SaveStatus status) => status switch
    {
        SaveStatus.Saved => "Saved",
        SaveStatus.Saving => "Saving...",
        SaveStatus.Draft => "Draft",
        SaveStatus.Pending => "Not started",
        _ => ""
    };

    private string GetSaveStatusClass(SaveStatus status) => status switch
    {
        SaveStatus.Saved => "text-emerald-600 dark:text-emerald-400",
        SaveStatus.Saving => "text-blue-600 dark:text-blue-400",
        SaveStatus.Draft => "text-amber-600 dark:text-amber-400",
        SaveStatus.Pending => "text-muted-foreground",
        _ => ""
    };

    private async Task HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            var savingStep = _activeStep;
            _saveStatuses[savingStep] = SaveStatus.Saving;
            _activeStep++;
            StateHasChanged();
            await Task.Delay(800);
            _saveStatuses[savingStep] = SaveStatus.Saved;
            StateHasChanged();
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        var lastSavedIdx = Array.LastIndexOf(_saveStatuses, SaveStatus.Saved);
        var isAccessible = index <= Math.Max(_activeStep, lastSavedIdx + 1);
        if (isAccessible)
        {
            _activeStep = index;
        }
    }

    private async Task HandleSaveNow()
    {
        var savingStep = _activeStep;
        _saveStatuses[savingStep] = SaveStatus.Saving;
        StateHasChanged();
        await Task.Delay(1200);
        _saveStatuses[savingStep] = SaveStatus.Saved;
        StateHasChanged();
    }
}
