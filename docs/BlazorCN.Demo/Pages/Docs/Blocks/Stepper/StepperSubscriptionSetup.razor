@* ============================================================
   Block: stepper-subscription-setup
   Title: StepperSubscriptionSetup
   Description: A subscription plan setup wizard with plan selection cards, billing cycle toggle, add-on checkboxes, and activation summary built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-subscription-setup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Subscription setup</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Step <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Step indicators *@
        <div class="border-b px-6 py-5">
            <div class="flex items-center">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var isCompleted = index < _activeStep;
                    var isActive = index == _activeStep;
                    var isUpcoming = index > _activeStep;
                    <div class="flex flex-1 items-center last:flex-none">
                        <div class="flex flex-col items-center gap-1.5">
                            <button
                                type="button"
                                @onclick="@(() => HandleStepClick(index))"
                                disabled="@isUpcoming"
                                class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full font-medium text-xs tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white cursor-pointer dark:bg-emerald-600" : isActive ? "bg-foreground text-background cursor-pointer" : "border border-muted-foreground/25 text-muted-foreground cursor-default")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <span>@(index + 1)</span>
                                }
                            </button>
                            <span class="@Cn.Merge("whitespace-nowrap text-center font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                @stp.Label
                            </span>
                        </div>

                        @if (index < _steps.Length - 1)
                        {
                            <div class="mx-3 mb-5 h-px flex-1">
                                <div class="@Cn.Merge("h-full transition-colors duration-300", index < _activeStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Step content *@
        <div class="border-b px-4 py-4">
            @if (_activeStep == 0)
            {
                <div>
                    <div class="mb-3">
                        <span class="font-medium text-sm">Choose your plan</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@_steps[0].Description</p>
                    </div>
                    <div class="space-y-2">
                        @foreach (var pl in _plans)
                        {
                            var plan = pl;
                            var isPlanSelected = _selectedPlan == plan.Id;
                            var planStepPrice = _billingCycle == "monthly" ? plan.MonthlyPrice : plan.YearlyPrice;
                            <button
                                type="button"
                                @onclick="@(() => SetSelectedPlan(plan.Id))"
                                class="@Cn.Merge("flex w-full items-start gap-3 rounded-md px-3 py-3 text-left transition-all duration-150", isPlanSelected ? "bg-foreground/5 ring-1 ring-foreground/20" : "bg-muted/50 hover:bg-muted/80")">
                                <div class="@Cn.Merge("mt-0.5 flex size-4 shrink-0 items-center justify-center rounded-full border transition-all duration-150", isPlanSelected ? "border-foreground bg-foreground" : "border-muted-foreground/30")">
                                    @if (isPlanSelected)
                                    {
                                        <LucideIconCn Name="check" Size="10" Class="size-2.5 text-background" />
                                    }
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="@Cn.Merge("text-sm", isPlanSelected ? "font-medium" : "text-muted-foreground")">
                                            @plan.Name
                                        </span>
                                        @if (plan.Popular)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                                                <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                                                Popular
                                            </BadgeCn>
                                        }
                                    </div>
                                    <span class="text-muted-foreground text-xs">@plan.Description</span>
                                    <div class="mt-1.5 flex flex-wrap gap-x-3 gap-y-0.5">
                                        @foreach (var feat in plan.Features)
                                        {
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                                                @feat
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="shrink-0 text-right">
                                    <span class="font-semibold text-sm tabular-nums">$@planStepPrice</span>
                                    <span class="text-muted-foreground text-xs">/@Interval</span>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            }

            @if (_activeStep == 1)
            {
                <div>
                    <div class="mb-3">
                        <span class="font-medium text-sm">Billing cycle</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@_steps[1].Description</p>
                    </div>
                    <div class="space-y-2">
                        <button
                            type="button"
                            @onclick="SetMonthlyBilling"
                            class="@Cn.Merge("flex w-full items-center justify-between rounded-md px-3 py-3 text-left transition-all duration-150", _billingCycle == "monthly" ? "bg-foreground/5 ring-1 ring-foreground/20" : "bg-muted/50 hover:bg-muted/80")">
                            <div class="flex items-center gap-3">
                                <div class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border transition-all duration-150", _billingCycle == "monthly" ? "border-foreground bg-foreground" : "border-muted-foreground/30")">
                                    @if (_billingCycle == "monthly")
                                    {
                                        <LucideIconCn Name="check" Size="10" Class="size-2.5 text-background" />
                                    }
                                </div>
                                <div>
                                    <span class="@Cn.Merge("block text-sm", _billingCycle == "monthly" ? "font-medium" : "text-muted-foreground")">
                                        Monthly billing
                                    </span>
                                    <span class="text-muted-foreground text-xs">Pay month-to-month, cancel anytime</span>
                                </div>
                            </div>
                            <span class="font-semibold text-sm tabular-nums">
                                $@CurrentPlan.MonthlyPrice<span class="font-normal text-muted-foreground text-xs">/mo</span>
                            </span>
                        </button>

                        <button
                            type="button"
                            @onclick="SetYearlyBilling"
                            class="@Cn.Merge("flex w-full items-center justify-between rounded-md px-3 py-3 text-left transition-all duration-150", _billingCycle == "yearly" ? "bg-foreground/5 ring-1 ring-foreground/20" : "bg-muted/50 hover:bg-muted/80")">
                            <div class="flex items-center gap-3">
                                <div class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border transition-all duration-150", _billingCycle == "yearly" ? "border-foreground bg-foreground" : "border-muted-foreground/30")">
                                    @if (_billingCycle == "yearly")
                                    {
                                        <LucideIconCn Name="check" Size="10" Class="size-2.5 text-background" />
                                    }
                                </div>
                                <div>
                                    <span class="@Cn.Merge("block text-sm", _billingCycle == "yearly" ? "font-medium" : "text-muted-foreground")">
                                        Yearly billing
                                    </span>
                                    <span class="text-muted-foreground text-xs">Pay annually and save ~17%</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-emerald-600 text-xs dark:text-emerald-400">
                                    Save $@(CurrentPlan.MonthlyPrice * 12 - CurrentPlan.YearlyPrice)
                                </BadgeCn>
                                <span class="font-semibold text-sm tabular-nums">
                                    $@CurrentPlan.YearlyPrice<span class="font-normal text-muted-foreground text-xs">/yr</span>
                                </span>
                            </div>
                        </button>
                    </div>
                </div>
            }

            @if (_activeStep == 2)
            {
                <div>
                    <div class="mb-3">
                        <span class="font-medium text-sm">Add-ons</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@_steps[2].Description</p>
                    </div>
                    <div class="space-y-2">
                        @foreach (var ao in _addOns)
                        {
                            var addOnItem = ao;
                            var isAddOnSelected = _selectedAddOns.Contains(addOnItem.Id);
                            var addOnPrice = _billingCycle == "monthly" ? addOnItem.MonthlyPrice : addOnItem.YearlyPrice;
                            <button
                                type="button"
                                @onclick="@(() => ToggleAddOn(addOnItem.Id))"
                                class="@Cn.Merge("flex w-full items-center justify-between rounded-md px-3 py-3 text-left transition-all duration-150", isAddOnSelected ? "bg-foreground/5 ring-1 ring-foreground/20" : "bg-muted/50 hover:bg-muted/80")">
                                <div class="flex items-center gap-3">
                                    <div class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-sm border transition-all duration-150", isAddOnSelected ? "border-foreground bg-foreground" : "border-muted-foreground/30")">
                                        @if (isAddOnSelected)
                                        {
                                            <LucideIconCn Name="check" Size="10" Class="size-2.5 text-background" />
                                        }
                                    </div>
                                    <div>
                                        <span class="@Cn.Merge("block text-sm", isAddOnSelected ? "font-medium" : "text-muted-foreground")">
                                            @addOnItem.Name
                                        </span>
                                        <span class="text-muted-foreground text-xs">@addOnItem.Description</span>
                                    </div>
                                </div>
                                <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                                    +$@addOnPrice/@Interval
                                </span>
                            </button>
                        }
                    </div>
                </div>
            }

            @if (_activeStep == 3)
            {
                <div>
                    <div class="mb-3">
                        <span class="font-medium text-sm">Subscription summary</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">Review your selections before activating</p>
                    </div>
                    <div class="space-y-2">
                        <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                            <span class="font-medium text-muted-foreground text-xs">Plan</span>
                            <div class="flex items-center gap-2">
                                <span class="text-sm">@CurrentPlan.Name</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    @_billingCycle
                                </BadgeCn>
                            </div>
                        </div>
                        <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                            <span class="font-medium text-muted-foreground text-xs">Plan cost</span>
                            <span class="font-mono text-sm tabular-nums">$@PlanPrice/@Interval</span>
                        </div>
                        @if (_selectedAddOns.Count > 0)
                        {
                            <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                                <span class="font-medium text-muted-foreground text-xs">Add-ons (@_selectedAddOns.Count)</span>
                                <span class="font-mono text-sm tabular-nums">+$@AddOnTotal/@Interval</span>
                            </div>
                        }
                        @if (_selectedAddOns.Count > 0)
                        {
                            <div class="pl-3">
                                @foreach (var ao in _addOns.Where(a => _selectedAddOns.Contains(a.Id)))
                                {
                                    var summaryItem = ao;
                                    <div class="flex items-center gap-1.5 py-0.5 text-muted-foreground text-xs">
                                        <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                                        @summaryItem.Name
                                    </div>
                                }
                            </div>
                        }
                        <div class="mt-2 flex items-center justify-between rounded-md bg-foreground/5 px-3 py-3">
                            <span class="font-medium text-sm">Total</span>
                            <span class="font-semibold text-lg tabular-nums">
                                $@Total<span class="font-normal text-muted-foreground text-xs">/@Interval</span>
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Navigation + total *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs">
                    <span class="font-semibold text-foreground tabular-nums">$@Total</span>/@Interval
                </span>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                    @(_activeStep == _steps.Length - 1 ? "Activate subscription" : "Continue")
                    @if (_activeStep < _steps.Length - 1)
                    {
                        <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                    }
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Description);
    private record Plan(string Id, string Name, int MonthlyPrice, int YearlyPrice, string Description, string[] Features, bool Popular = false);
    private record AddOnItem(string Id, string Name, int MonthlyPrice, int YearlyPrice, string Description);

    private static readonly StepItem[] _steps =
    [
        new("Choose plan", "Select the right plan for you"),
        new("Billing cycle", "Monthly or yearly billing"),
        new("Add-ons", "Enhance your subscription"),
        new("Activate", "Review and confirm"),
    ];

    private static readonly Plan[] _plans =
    [
        new("basic", "Basic", 12, 120, "For individuals getting started", ["5 projects", "10 GB storage", "Email support"]),
        new("pro", "Pro", 29, 290, "For professionals and small teams", ["Unlimited projects", "100 GB storage", "Priority support", "API access"], true),
        new("enterprise", "Enterprise", 79, 790, "For organizations at scale", ["Unlimited everything", "1 TB storage", "Dedicated support", "SSO & SAML", "Custom contracts"]),
    ];

    private static readonly AddOnItem[] _addOns =
    [
        new("analytics", "Advanced analytics", 8, 80, "Detailed usage metrics and reports"),
        new("backup", "Automated backups", 5, 50, "Daily snapshots with 30-day retention"),
        new("whitelabel", "White-label branding", 15, 150, "Remove branding and use your own domain"),
        new("ai", "AI assistant", 12, 120, "AI-powered suggestions and automation"),
    ];

    private int _activeStep = 0;
    private string _selectedPlan = "pro";
    private string _billingCycle = "monthly";
    private List<string> _selectedAddOns = ["analytics"];

    private Plan CurrentPlan => _plans.First(p => p.Id == _selectedPlan);
    private int PlanPrice => _billingCycle == "monthly" ? CurrentPlan.MonthlyPrice : CurrentPlan.YearlyPrice;
    private int AddOnTotal => _addOns.Where(a => _selectedAddOns.Contains(a.Id)).Sum(a => _billingCycle == "monthly" ? a.MonthlyPrice : a.YearlyPrice);
    private int Total => PlanPrice + AddOnTotal;
    private string Interval => _billingCycle == "monthly" ? "mo" : "yr";

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }

    private void SetSelectedPlan(string id) => _selectedPlan = id;
    private void SetMonthlyBilling() => _billingCycle = "monthly";
    private void SetYearlyBilling() => _billingCycle = "yearly";

    private void ToggleAddOn(string id)
    {
        if (_selectedAddOns.Contains(id))
        {
            _selectedAddOns.Remove(id);
        }
        else
        {
            _selectedAddOns.Add(id);
        }
    }
}
