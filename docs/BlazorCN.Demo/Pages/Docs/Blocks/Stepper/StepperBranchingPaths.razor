@* ============================================================
   Block: stepper-branching-paths
   Title: StepperBranchingPaths
   Description: A multi-step stepper wizard with a decision fork that branches into two parallel paths before merging for a final step built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-branching-paths.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Deployment wizard</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                <span class="tabular-nums">@(_phase + 1)</span> of <span class="tabular-nums">@TotalPhases</span>
            </BadgeCn>
        </div>

        @* Visual step indicator with branch *@
        <div class="border-b px-4 py-5">
            @* Linear start *@
            <div class="flex items-center gap-2">
                @* Step 1: Setup *@
                <div class="flex items-center gap-2">
                    <button
                        type="button"
                        @onclick="@(() => _phase = 0)"
                        class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full text-xs transition-all duration-200", _phase > 0 ? "bg-emerald-500 text-white dark:bg-emerald-600 cursor-pointer" : _phase == 0 ? "bg-foreground text-background cursor-pointer" : "border border-muted-foreground/25 text-muted-foreground cursor-default")">
                        @if (_phase > 0)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                        }
                        else
                        {
                            <span class="font-medium">1</span>
                        }
                    </button>
                    <span class="@Cn.Merge("font-medium text-xs", _phase == 0 ? "text-foreground" : "text-muted-foreground")">
                        Setup
                    </span>
                </div>

                <div class="@Cn.Merge("h-px w-8", _phase > 0 ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")" />

                @* Step 2: Choice (branch point) *@
                <div class="flex items-center gap-2">
                    <div class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full text-xs transition-all duration-200", _phase > 1 ? "bg-emerald-500 text-white dark:bg-emerald-600" : _phase == 1 ? "bg-foreground text-background" : "border border-muted-foreground/25 text-muted-foreground")">
                        @if (_phase > 1)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                        }
                        else
                        {
                            <LucideIconCn Name="git-branch" Size="12" Class="size-3" />
                        }
                    </div>
                </div>

                @* Branch fork visual *@
                <div class="flex flex-1 flex-col gap-1.5">
                    @* Path A *@
                    <div class="flex items-center gap-2">
                        <div class="@Cn.Merge("h-px w-6", _phase > 1 && _pathChoice == "self-hosted" ? "bg-emerald-500 dark:bg-emerald-600" : _phase > 1 && _pathChoice == "cloud" ? "bg-muted-foreground/10" : "bg-muted-foreground/20")" />
                        <div class="flex items-center gap-1.5">
                            <div class="@Cn.Merge("flex size-5 items-center justify-center rounded-full text-xs transition-all duration-200", _pathChoice == "self-hosted" && _phase > 3 ? "bg-emerald-500 text-white dark:bg-emerald-600" : _pathChoice == "self-hosted" && _phase >= 2 ? "bg-foreground text-background" : "border border-muted-foreground/20 text-muted-foreground")">
                                <LucideIconCn Name="server" Size="10" Class="size-2.5" />
                            </div>
                            <span class="@Cn.Merge("text-xs", _pathChoice == "self-hosted" && _phase >= 2 ? "font-medium text-foreground" : "text-muted-foreground")">
                                Self-hosted
                            </span>
                        </div>
                        <div class="@Cn.Merge("h-px w-4", _pathChoice == "self-hosted" && _phase > 3 ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/10")" />
                    </div>

                    @* Path B *@
                    <div class="flex items-center gap-2">
                        <div class="@Cn.Merge("h-px w-6", _phase > 1 && _pathChoice == "cloud" ? "bg-emerald-500 dark:bg-emerald-600" : _phase > 1 && _pathChoice == "self-hosted" ? "bg-muted-foreground/10" : "bg-muted-foreground/20")" />
                        <div class="flex items-center gap-1.5">
                            <div class="@Cn.Merge("flex size-5 items-center justify-center rounded-full text-xs transition-all duration-200", _pathChoice == "cloud" && _phase > 3 ? "bg-emerald-500 text-white dark:bg-emerald-600" : _pathChoice == "cloud" && _phase >= 2 ? "bg-foreground text-background" : "border border-muted-foreground/20 text-muted-foreground")">
                                <LucideIconCn Name="cloud" Size="10" Class="size-2.5" />
                            </div>
                            <span class="@Cn.Merge("text-xs", _pathChoice == "cloud" && _phase >= 2 ? "font-medium text-foreground" : "text-muted-foreground")">
                                Cloud
                            </span>
                        </div>
                        <div class="@Cn.Merge("h-px w-4", _pathChoice == "cloud" && _phase > 3 ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/10")" />
                    </div>
                </div>

                @* Merge point: Finalize *@
                <div class="@Cn.Merge("h-px w-4", _phase > 3 ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")" />
                <div class="flex items-center gap-2">
                    <div class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full text-xs transition-all duration-200", _phase == 4 ? "bg-foreground text-background" : "border border-muted-foreground/25 text-muted-foreground")">
                        <span class="font-medium text-xs">5</span>
                    </div>
                    <span class="@Cn.Merge("font-medium text-xs", _phase == 4 ? "text-foreground" : "text-muted-foreground")">
                        Finalize
                    </span>
                </div>
            </div>
        </div>

        @* Content *@
        <div class="border-b px-4 py-4">
            @if (_phase == 1)
            {
                <div class="mb-4">
                    <span class="font-medium text-sm">Choose deployment model</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Select how you want to deploy your application
                    </p>
                </div>
                <div class="space-y-2">
                    <button
                        type="button"
                        @onclick="@(() => HandleChoosePath("self-hosted"))"
                        class="@Cn.Merge("flex w-full items-center gap-3 rounded-md px-3 py-3 text-left transition-colors hover:bg-muted/50", _pathChoice == "self-hosted" ? "bg-muted/50 ring-1 ring-foreground/10" : "bg-muted/20")">
                        <div class="flex size-8 items-center justify-center rounded-full bg-muted/80">
                            <LucideIconCn Name="server" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="flex-1">
                            <span class="font-medium text-sm">Self-hosted</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                Deploy on your own infrastructure with full control
                            </p>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="size-4 text-muted-foreground/60" />
                    </button>
                    <button
                        type="button"
                        @onclick="@(() => HandleChoosePath("cloud"))"
                        class="@Cn.Merge("flex w-full items-center gap-3 rounded-md px-3 py-3 text-left transition-colors hover:bg-muted/50", _pathChoice == "cloud" ? "bg-muted/50 ring-1 ring-foreground/10" : "bg-muted/20")">
                        <div class="flex size-8 items-center justify-center rounded-full bg-muted/80">
                            <LucideIconCn Name="cloud" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="flex-1">
                            <span class="font-medium text-sm">Cloud</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                Managed hosting with automatic scaling and updates
                            </p>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="size-4 text-muted-foreground/60" />
                    </button>
                </div>
            }
            else
            {
                <div class="mb-3 flex items-center gap-2">
                    <div>
                        <span class="font-medium text-sm">@GetPhaseLabel()</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @if (_phase == 0)
                            {
                                @: Name and team configuration
                            }
                            else if (_phase == 2 || _phase == 3)
                            {
                                @GetCurrentPathStepDescription()
                            }
                            else if (_phase == 4)
                            {
                                @: Review and activate your deployment
                            }
                        </p>
                    </div>
                    @if (_pathChoice != null && _phase >= 2 && _phase <= 3)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs">
                            @(_pathChoice == "self-hosted" ? "Self-hosted" : "Cloud")
                        </BadgeCn>
                    }
                </div>
                <div class="space-y-2">
                    @if (_phase == 0)
                    {
                        foreach (var field in _linearStep0Fields)
                        {
                            <div class="flex items-center justify-between rounded-md bg-muted/30 px-3 py-2.5">
                                <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                                <span class="text-sm">@field.Value</span>
                            </div>
                        }
                    }
                    @if (_phase == 2 || _phase == 3)
                    {
                        var contentFields = GetCurrentPathContentFields(_phase - 2);
                        foreach (var field in contentFields)
                        {
                            <div class="flex items-center justify-between rounded-md bg-muted/30 px-3 py-2.5">
                                <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                                <span class="text-sm">@field.Value</span>
                            </div>
                        }
                    }
                    @if (_phase == 4 && _pathChoice != null)
                    {
                        var finalFields = GetFinalContentFields(_pathChoice);
                        foreach (var field in finalFields)
                        {
                            <div class="flex items-center justify-between rounded-md bg-muted/30 px-3 py-2.5">
                                <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                                <span class="text-sm">@field.Value</span>
                            </div>
                        }
                    }
                </div>
            }
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_phase == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            @if (_phase != 1)
            {
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_phase == TotalPhases - 1)">
                    @(_phase == TotalPhases - 1 ? "Deploy" : "Continue")
                    @if (_phase < TotalPhases - 1)
                    {
                        <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                    }
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private const int TotalPhases = 5;

    private int _phase = 1;
    private string? _pathChoice = null;

    private record FieldData(string Label, string Value);

    private static readonly FieldData[] _linearStep0Fields =
    [
        new("Project name", "Acme Platform"),
        new("Team", "Engineering (12 members)"),
        new("Environment", "Production"),
    ];

    private static readonly FieldData[][] _pathAContent =
    [
        [
            new("OS", "Ubuntu 22.04 LTS"),
            new("CPU / RAM", "8 vCPU / 32 GB"),
            new("Storage", "500 GB NVMe SSD"),
            new("Network", "10 Gbps private subnet"),
        ],
        [
            new("Install method", "Docker Compose"),
            new("Database", "PostgreSQL 16 (bundled)"),
            new("TLS certificate", "Let's Encrypt (auto)"),
            new("Backup schedule", "Daily at 02:00 UTC"),
        ],
    ];

    private static readonly FieldData[][] _pathBContent =
    [
        [
            new("Region", "US East (Virginia)"),
            new("Tier", "Pro ($79/month)"),
            new("Availability", "Multi-AZ redundancy"),
            new("Compliance", "SOC 2 Type II"),
        ],
        [
            new("Custom domain", "app.acme.com"),
            new("SSO provider", "Okta (SAML 2.0)"),
            new("Data retention", "90 days"),
            new("Support tier", "Priority (4h SLA)"),
        ],
    ];

    private static readonly FieldData[] _finalSelfHostedFields =
    [
        new("Project", "Acme Platform"),
        new("Deployment", "Self-hosted (Docker)"),
        new("Server", "8 vCPU / 32 GB, Ubuntu 22.04"),
        new("Status", "Ready to deploy"),
    ];

    private static readonly FieldData[] _finalCloudFields =
    [
        new("Project", "Acme Platform"),
        new("Deployment", "Cloud (US East, Pro)"),
        new("Domain", "app.acme.com"),
        new("Status", "Ready to provision"),
    ];

    private static readonly string[] _pathAStepDescriptions =
    [
        "Server requirements and provisioning",
        "Deploy to your servers",
    ];

    private static readonly string[] _pathBStepDescriptions =
    [
        "Select cloud region and tier",
        "Cloud-specific settings",
    ];

    private string GetPhaseLabel()
    {
        if (_phase == 0) return "Project setup";
        if (_phase == 1) return "Choose deployment";
        if (_phase == 2) return _pathChoice == "self-hosted" ? "Infrastructure" : "Region";
        if (_phase == 3) return _pathChoice == "self-hosted" ? "Installation" : "Configuration";
        return "Finalize";
    }

    private string GetCurrentPathStepDescription()
    {
        var idx = _phase - 2;
        if (_pathChoice == "self-hosted" && idx >= 0 && idx < _pathAStepDescriptions.Length)
            return _pathAStepDescriptions[idx];
        if (_pathChoice == "cloud" && idx >= 0 && idx < _pathBStepDescriptions.Length)
            return _pathBStepDescriptions[idx];
        return string.Empty;
    }

    private FieldData[] GetCurrentPathContentFields(int idx)
    {
        if (_pathChoice == "self-hosted" && idx >= 0 && idx < _pathAContent.Length)
            return _pathAContent[idx];
        if (_pathChoice == "cloud" && idx >= 0 && idx < _pathBContent.Length)
            return _pathBContent[idx];
        return [];
    }

    private FieldData[] GetFinalContentFields(string choice)
    {
        if (choice == "self-hosted") return _finalSelfHostedFields;
        if (choice == "cloud") return _finalCloudFields;
        return [];
    }

    private void HandleNext()
    {
        if (_phase < TotalPhases - 1)
            _phase++;
    }

    private void HandleBack()
    {
        if (_phase > 0)
        {
            if (_phase == 2 && _pathChoice != null)
                _phase = 1;
            else
                _phase--;
        }
    }

    private void HandleChoosePath(string path)
    {
        _pathChoice = path;
        _phase = 2;
    }
}
