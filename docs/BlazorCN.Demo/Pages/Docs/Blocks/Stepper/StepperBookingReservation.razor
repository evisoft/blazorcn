@* ============================================================
   Block: stepper-booking-reservation
   Title: StepperBookingReservation
   Description: A multi-step hotel booking reservation wizard with date selection, room choice, guest details, and confirmation steps plus a persistent booking summary built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-booking-reservation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Book your stay</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Step <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Step indicators *@
        <div class="border-b px-6 py-5">
            <div class="flex items-center">
                @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
                {
                    var idx = entry.Index;
                    var step = entry.Step;
                    var isCompleted = idx < _activeStep;
                    var isActive = idx == _activeStep;
                    var isUpcoming = idx > _activeStep;

                    <div class="flex flex-1 items-center last:flex-none">
                        <div class="flex flex-col items-center gap-1.5">
                            <button
                                type="button" aria-label="@($"Step {idx + 1}: {step.Label}")"
                                @onclick="@(() => HandleStepClick(idx))"
                                disabled="@isUpcoming"
                                class="@Cn.Merge("flex size-9 shrink-0 items-center justify-center rounded-full transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600 cursor-pointer" : isActive ? "ring-2 ring-foreground/20 ring-offset-2 ring-offset-card bg-foreground text-background cursor-pointer" : "border border-muted-foreground/25 text-muted-foreground cursor-default")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <LucideIconCn Name="@step.IconName" Size="14" Class="size-3.5" />
                                }
                            </button>
                            <span class="@Cn.Merge("text-center font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                @step.Label
                            </span>
                        </div>

                        @if (idx < _steps.Length - 1)
                        {
                            <div class="mx-3 mb-5 h-px flex-1">
                                <div class="@Cn.Merge("h-full transition-colors duration-300", idx < _activeStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Step content *@
        <div class="border-b">
            @* Dates step *@
            @if (_activeStep == 0)
            {
                <div class="px-4 py-4">
                    <div class="mb-3">
                        <span class="font-medium text-sm">Select your dates</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Choose check-in and check-out dates for your stay.
                        </p>
                    </div>
                    <div class="space-y-2">
                        <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                            <span class="font-medium text-muted-foreground text-xs">Check-in</span>
                            <span class="text-sm">Fri, Jun 13, 2026</span>
                        </div>
                        <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                            <span class="font-medium text-muted-foreground text-xs">Check-out</span>
                            <span class="text-sm">Mon, Jun 16, 2026</span>
                        </div>
                        <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                            <span class="font-medium text-muted-foreground text-xs">Duration</span>
                            <span class="text-sm">3 nights</span>
                        </div>
                        <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                            <span class="font-medium text-muted-foreground text-xs">Guests</span>
                            <span class="text-sm">2 adults</span>
                        </div>
                    </div>
                </div>
            }

            @* Room step *@
            @if (_activeStep == 1)
            {
                <div class="px-4 py-4">
                    <div class="mb-3">
                        <span class="font-medium text-sm">Choose your room</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Select a room type for your 3-night stay.
                        </p>
                    </div>
                    <div class="space-y-2">
                        @foreach (var room in _rooms)
                        {
                            var roomItem = room;
                            var isSelected = _selectedRoom == roomItem.Id;
                            <button
                                type="button"
                                @onclick="@(() => _selectedRoom = roomItem.Id)"
                                class="@Cn.Merge("w-full rounded-md px-3 py-3 text-left transition-colors", isSelected ? "bg-foreground/5 ring-1 ring-foreground/15" : "bg-muted/50 hover:bg-muted/80")">
                                <div class="flex items-start justify-between">
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="font-medium text-sm">@roomItem.Name</span>
                                            @if (isSelected)
                                            {
                                                <span class="size-1.5 rounded-full bg-emerald-500" />
                                            }
                                        </div>
                                        <p class="mt-0.5 text-muted-foreground text-xs">@roomItem.Description</p>
                                        <div class="mt-1.5 flex items-center gap-2">
                                            @foreach (var feature in roomItem.Features)
                                            {
                                                <span class="text-muted-foreground text-[10px]">@feature</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="shrink-0 text-right">
                                        <span class="font-semibold text-sm tabular-nums">@roomItem.PricePerNight</span>
                                        <p class="text-muted-foreground text-[10px]">per night</p>
                                    </div>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            }

            @* Guest details step *@
            @if (_activeStep == 2)
            {
                <div class="px-4 py-4">
                    <div class="mb-3">
                        <span class="font-medium text-sm">Guest details</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Provide the primary guest information.
                        </p>
                    </div>
                    <div class="space-y-2">
                        @foreach (var field in _guestFields)
                        {
                            <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                                <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                                <span class="text-sm">@field.Value</span>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Confirmation step *@
            @if (_activeStep == 3)
            {
                <div class="px-4 py-6">
                    <div class="mx-auto max-w-sm text-center">
                        <div class="mx-auto mb-3 flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="20" Class="size-5 text-emerald-600 dark:text-emerald-400" />
                        </div>
                        <span class="font-medium text-sm">Booking confirmed</span>
                        <p class="mt-1 text-muted-foreground text-xs">
                            Confirmation #BK-84210 has been sent to @("mia.tanaka@@email.com"). Check-in is at 3:00
                            PM on Fri, Jun 13.
                        </p>
                    </div>
                </div>
            }
        </div>

        @* Booking summary bar *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3 text-xs">
                <span class="text-muted-foreground">Jun 13 – 16</span>
                <span class="text-muted-foreground">·</span>
                <span class="text-muted-foreground">3 nights</span>
                <span class="text-muted-foreground">·</span>
                <span class="text-muted-foreground">@CurrentRoom.Name</span>
                <span class="ml-auto font-semibold text-sm tabular-nums">$@(int.Parse(CurrentRoom.PricePerNight.Replace("$", "")) * 3)</span>
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == 2 ? "Confirm booking" : _activeStep == 3 ? "Done" : "Continue")
                @if (_activeStep < 2)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string IconName);
    private record RoomOption(string Id, string Name, string Description, string PricePerNight, string[] Features);
    private record GuestField(string Label, string Value);

    private int _activeStep = 0;
    private string _selectedRoom = "deluxe";

    private static readonly StepItem[] _steps =
    [
        new("Dates", "calendar"),
        new("Room", "bed-double"),
        new("Guest details", "user"),
        new("Confirm", "check"),
    ];

    private static readonly RoomOption[] _rooms =
    [
        new("standard", "Standard Room", "Comfortable room with city view", "$149", ["Queen bed", "City view", "Free Wi-Fi"]),
        new("deluxe", "Deluxe Suite", "Spacious suite with separate living area", "$249", ["King bed", "Ocean view", "Lounge access"]),
        new("penthouse", "Penthouse", "Premium top-floor suite with terrace", "$449", ["King bed", "Panoramic view", "Private terrace"]),
    ];

    private static readonly GuestField[] _guestFields =
    [
        new("Full name", "Mia Tanaka"),
        new("Email", "mia.tanaka@email.com"),
        new("Phone", "+1 (415) 555-0198"),
        new("Special requests", "High floor, non-smoking"),
    ];

    private RoomOption CurrentRoom => _rooms.FirstOrDefault(r => r.Id == _selectedRoom) ?? _rooms[1];

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
            _activeStep++;
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
            _activeStep--;
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
            _activeStep = index;
    }
}
