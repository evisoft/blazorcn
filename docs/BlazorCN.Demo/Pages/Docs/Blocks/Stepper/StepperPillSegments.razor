@* ============================================================
   Block: stepper-pill-segments
   Title: StepperPillSegments
   Description: A segmented control stepper with pill-shaped buttons, active segment highlighting, completion indicators, and swappable content panels built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-pill-segments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with progress *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <div class="font-medium text-sm">Pipeline configuration</div>
                <p class="text-muted-foreground text-xs">
                    Step @(_activeIndex + 1) of @_steps.Length
                </p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                @_completed.Count/@_steps.Length complete
            </BadgeCn>
        </div>

        @* Segmented control *@
        <div class="border-b px-4 py-3">
            <div class="flex gap-1 rounded-lg bg-muted/50 p-1">
                @foreach (var stp in _steps)
                {
                    var step = stp;
                    var isActive = _activeSegment == step.Id;
                    var isCompleted = _completed.Contains(step.Id);
                    <button
                        type="button"
                        @onclick="@(() => { _activeSegment = step.Id; })"
                        class="@Cn.Merge("flex flex-1 items-center justify-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition-all", isActive ? "bg-card text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground/70")">
                        @if (isCompleted && !isActive)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="@step.IconName" Size="14" Class="size-3.5" />
                        }
                        <span class="hidden sm:inline">@step.Label</span>
                    </button>
                }
            </div>
        </div>

        @* Content area *@
        <div class="px-4 py-4">
            <div class="mb-1 font-medium text-sm">@ActiveContent.Title</div>
            <p class="mb-4 text-muted-foreground text-xs">@ActiveContent.Description</p>

            <div>
                @foreach (var itm in ActiveContent.Items)
                {
                    var itemIndex = Array.IndexOf(ActiveContent.Items, itm);
                    <div class="@Cn.Merge("flex items-center justify-between py-2.5", itemIndex < ActiveContent.Items.Length - 1 ? "border-b" : "")">
                        <span class="text-muted-foreground text-xs">@itm.Label</span>
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@itm.Value</span>
                            @if (itm.Status is not null)
                            {
                                <span class="@Cn.Merge("size-1.5 rounded-full", _statusColors[itm.Status])"></span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(_activeIndex == 0)" OnClick="HandleBack">
                Back
            </ButtonCn>
            <div class="flex items-center gap-1">
                @foreach (var stp in _steps)
                {
                    var step = stp;
                    <span
                        class="@Cn.Merge("h-1 flex-1 rounded-full transition-colors", _completed.Contains(step.Id) ? "bg-emerald-500" : _activeSegment == step.Id ? "bg-blue-500" : "bg-muted-foreground/20")"
                        style="width:32px">
                    </span>
                }
            </div>
            @if (_activeIndex < _steps.Length - 1)
            {
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="MarkCompleteAndNext">
                    Continue
                </ButtonCn>
            }
            else
            {
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="MarkComplete">
                    Deploy pipeline
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record StepDef(string Id, string Label, string IconName);
    private record StepItem(string Label, string Value, string? Status = null);
    private record StepDetail(string Title, string Description, StepItem[] Items);

    private static readonly StepDef[] _steps =
    [
        new("source", "Source", "database"),
        new("transform", "Transform", "arrow-right-left"),
        new("destination", "Destination", "hard-drive"),
        new("schedule", "Schedule", "clock"),
    ];

    private static readonly Dictionary<string, StepDetail> _stepContent = new()
    {
        ["source"] = new("Data source", "Select and configure the data source for your pipeline.",
        [
            new("Provider", "PostgreSQL", "connected"),
            new("Host", "db.acme.internal:5432", "connected"),
            new("Database", "analytics_prod"),
            new("Schema", "public"),
            new("Tables", "12 selected"),
        ]),
        ["transform"] = new("Transformations", "Define how data should be transformed during the pipeline run.",
        [
            new("Deduplication", "Enabled on email field", "configured"),
            new("Null handling", "Replace with defaults"),
            new("Type casting", "Auto-detect from schema", "configured"),
            new("Column mapping", "8 of 12 mapped"),
            new("Filters", "WHERE active = true"),
        ]),
        ["destination"] = new("Destination", "Choose where the transformed data will be stored.",
        [
            new("Provider", "BigQuery", "connected"),
            new("Project", "acme-data-warehouse"),
            new("Dataset", "analytics"),
            new("Write mode", "Append"),
            new("Partitioning", "By ingestion date", "configured"),
        ]),
        ["schedule"] = new("Schedule", "Set when and how often the pipeline should run.",
        [
            new("Frequency", "Every 6 hours"),
            new("Start time", "00:00 UTC"),
            new("Retry policy", "3 retries with backoff", "configured"),
            new("Timeout", "30 minutes"),
            new("Alert on failure", "team-data@acme.com"),
        ]),
    };

    private static readonly Dictionary<string, string> _statusColors = new()
    {
        ["connected"] = "bg-emerald-500",
        ["configured"] = "bg-blue-500",
        ["pending"] = "bg-amber-500",
    };

    private string _activeSegment = "source";
    private HashSet<string> _completed = [];

    private int _activeIndex => Array.FindIndex(_steps, s => s.Id == _activeSegment);
    private StepDetail ActiveContent => _stepContent[_activeSegment];

    private void MarkCompleteAndNext()
    {
        _completed.Add(_activeSegment);
        var nextIndex = _activeIndex + 1;
        if (nextIndex < _steps.Length)
        {
            _activeSegment = _steps[nextIndex].Id;
        }
    }

    private void MarkComplete()
    {
        _completed.Add(_activeSegment);
    }

    private void HandleBack()
    {
        var idx = _activeIndex;
        if (idx > 0)
        {
            _activeSegment = _steps[idx - 1].Id;
        }
    }
}
