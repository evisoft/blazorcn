@* ============================================================
   Block: stepper-with-minimap
   Title: StepperWithMinimap
   Description: A long vertical stepper with a clickable minimap header showing a bird's-eye view of all steps as colored rectangles with the current position highlighted for quick navigation built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-with-minimap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="map" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Enterprise setup</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_activeStep of @_steps.Length completed
                </span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                    @((int)Math.Round((_activeStep + 1.0) / _steps.Length * 100))%
                </BadgeCn>
            </div>
        </div>

        @* Minimap *@
        <div class="border-b px-4 py-3">
            <div class="mb-1.5 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Minimap</span>
                <span class="text-muted-foreground text-xs">
                    Step @(_activeStep + 1): @_steps[_activeStep].Label
                </span>
            </div>

            @* Minimap segments *@
            <div class="flex items-end gap-1">
                @foreach (var stepItem in _steps)
                {
                    var idx = Array.IndexOf(_steps, stepItem);
                    var capturedIdx = idx;
                    var isActive = idx == _activeStep;
                    var isCompleted = idx < _activeStep;
                    var barBg = isCompleted
                        ? "var(--color-emerald-500)"
                        : isActive
                            ? "var(--color-foreground)"
                            : "color-mix(in srgb, var(--color-muted-foreground) 15%, transparent)";
                    var barHeight = isActive ? 20 : 12;
                    <button
                        type="button"
                        @onclick="@(() => _activeStep = capturedIdx)"
                        class="group relative flex-1"
                        aria-label="@($"Jump to step {idx + 1}: {stepItem.Label}")">
                        @* Segment bar *@
                        <div
                            class="w-full rounded-sm transition-all duration-200"
                            style="@($"height:{barHeight}px;background-color:{barBg}")">
                        </div>

                        @* Active indicator label *@
                        @if (isActive)
                        {
                            <div class="absolute -bottom-5 left-1/2 -translate-x-1/2 whitespace-nowrap">
                                <span class="font-medium text-foreground text-xs">@(idx + 1)</span>
                            </div>
                        }

                        @* Hover tooltip effect *@
                        <div class="pointer-events-none absolute -top-6 left-1/2 -translate-x-1/2 whitespace-nowrap rounded bg-foreground px-1.5 py-0.5 text-background text-xs opacity-0 transition-opacity duration-150 group-hover:opacity-100">
                            @stepItem.Label
                        </div>
                    </button>
                }
            </div>

            @* Step number labels below minimap *@
            <div class="mt-6 flex items-center gap-1">
                @foreach (var stepItem in _steps)
                {
                    var idx = Array.IndexOf(_steps, stepItem);
                    <div class="flex-1 text-center">
                        @if (idx < _activeStep)
                        {
                            <LucideIconCn Name="check" Size="12" Class="mx-auto size-3 text-emerald-500" />
                        }
                        else
                        {
                            <span class="@Cn.Merge("font-medium text-xs tabular-nums", idx == _activeStep ? "text-foreground" : "text-muted-foreground/40")">
                                @(idx + 1)
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        @* Current step detail *@
        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <div class="flex items-center gap-2">
                    <span class="flex size-6 items-center justify-center rounded-full bg-foreground font-medium text-background text-xs tabular-nums">
                        @(_activeStep + 1)
                    </span>
                    <div>
                        <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
                        <p class="text-muted-foreground text-xs">@_steps[_activeStep].Description</p>
                    </div>
                </div>
            </div>

            <div class="space-y-2">
                @foreach (var field in _steps[_activeStep].Fields)
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                        <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                        <span class="text-sm">@field.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Vertical step list (compact) *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">All steps</span>
            <div class="grid grid-cols-2 gap-x-4 gap-y-1.5">
                @foreach (var stepItem in _steps)
                {
                    var idx = Array.IndexOf(_steps, stepItem);
                    var capturedIdx = idx;
                    var isActive = idx == _activeStep;
                    var isCompleted = idx < _activeStep;
                    <button
                        type="button"
                        @onclick="@(() => _activeStep = capturedIdx)"
                        class="@Cn.Merge("flex items-center gap-2 rounded-md px-2 py-1.5 text-left transition-colors", isActive ? "bg-muted/50" : "hover:bg-muted/30")">
                        @if (isCompleted)
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                        }
                        else if (isActive)
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-foreground"></span>
                        }
                        else
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-muted-foreground/25"></span>
                        }
                        <span class="@Cn.Merge("truncate text-xs", isActive ? "font-medium text-foreground" : "text-muted-foreground")">
                            @stepItem.Label
                        </span>
                    </button>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>

            <div class="flex items-center gap-1">
                @foreach (var stepItem in _steps)
                {
                    var idx = Array.IndexOf(_steps, stepItem);
                    var isActive = idx == _activeStep;
                    var isCompleted = idx < _activeStep;
                    <span class="@Cn.Merge("rounded-full transition-all duration-200", isActive ? "h-1.5 w-3 bg-foreground" : isCompleted ? "size-1.5 bg-emerald-500" : "size-1.5 bg-muted-foreground/25")"></span>
                }
            </div>

            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Finish" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepField(string Label, string Value);
    private record StepData(string Label, string Description, StepField[] Fields);

    private int _activeStep = 3;

    private static readonly StepData[] _steps =
    [
        new("Organization", "Company name and legal entity",
        [
            new("Company name", "Acme Technologies Inc."),
            new("Legal entity", "Delaware C-Corp"),
            new("Tax ID", "XX-XXXXXXX (verified)"),
        ]),
        new("Admin account", "Primary administrator credentials",
        [
            new("Admin email", "admin@acme.com"),
            new("Role", "Organization Owner"),
            new("Two-factor auth", "Hardware key (YubiKey)"),
        ]),
        new("Security policy", "Authentication and access rules",
        [
            new("SSO provider", "Okta SAML 2.0"),
            new("Password policy", "12+ chars, rotation 90 days"),
            new("Session timeout", "30 minutes idle"),
        ]),
        new("Team members", "Invite and assign roles",
        [
            new("Invitations sent", "24 members"),
            new("Accepted", "18 of 24"),
            new("Roles assigned", "3 admins, 21 members"),
        ]),
        new("Billing", "Plan and payment configuration",
        [
            new("Plan", "Organization ($159/month)"),
            new("Payment method", "ACH bank transfer"),
            new("Billing contact", "finance@acme.com"),
        ]),
        new("Integrations", "Connect external services",
        [
            new("GitHub", "acme-org (42 repos)"),
            new("Slack", "acme-hq workspace"),
            new("Jira", "acme.atlassian.net"),
        ]),
        new("Compliance", "Regulatory and audit settings",
        [
            new("Data residency", "US East (SOC 2)"),
            new("Audit logging", "Enabled, 1-year retention"),
            new("DPA signed", "Yes, on file"),
        ]),
        new("Review", "Confirm all settings",
        [
            new("Organization", "Acme Technologies Inc."),
            new("Members", "24 invited, 18 active"),
            new("Plan", "Organization — $159/month"),
            new("Integrations", "3 connected"),
            new("Compliance", "SOC 2 region, audit logging on"),
        ]),
    ];

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1) _activeStep++;
    }

    private void HandleBack()
    {
        if (_activeStep > 0) _activeStep--;
    }
}
