@* ============================================================
   Block: stepper-review-confirmation
   Title: StepperReviewConfirmation
   Description: A multi-step form wizard with a final review and summary step showing all collected data with inline edit navigation built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-review-confirmation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Place order</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Step <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Step indicators *@
        <div class="border-b px-6 py-5">
            <div class="flex items-center">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var isCompleted = index < _activeStep;
                    var isActive = index == _activeStep;
                    <div class="flex flex-1 items-center last:flex-none">
                        <div class="flex flex-col items-center gap-1.5">
                            <button
                                type="button"
                                @onclick="@(() => HandleStepClick(index))"
                                class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full text-xs tabular-nums transition-all duration-200 cursor-pointer", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-foreground text-background" : "border border-muted-foreground/25 text-muted-foreground")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <span class="font-medium">@(index + 1)</span>
                                }
                            </button>
                            <span class="@Cn.Merge("text-center font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                @stp.Label
                            </span>
                        </div>

                        @if (index < _steps.Length - 1)
                        {
                            <div class="mx-3 mb-5 h-px flex-1">
                                <div class="@Cn.Merge("h-full transition-colors duration-300", index < _activeStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Content *@
        @if (_activeStep == _steps.Length - 1)
        {
            <div class="border-b">
                @* Review header *@
                <div class="px-4 pt-4 pb-2">
                    <span class="font-medium text-sm">Review your order</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Please verify the information below before confirming
                    </p>
                </div>

                @* Review sections *@
                @foreach (var sec in _reviewSections)
                {
                    var captured = sec;
                    <div>
                        <SeparatorCn />
                        <div class="px-4 py-3">
                            <div class="mb-2.5 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="flex size-5 items-center justify-center rounded-full bg-emerald-500 dark:bg-emerald-600">
                                        <LucideIconCn Name="check" Size="12" Class="size-3 text-white" />
                                    </span>
                                    <span class="font-medium text-sm">@captured.Title</span>
                                </div>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2 text-xs text-muted-foreground" OnClick="@(() => HandleEditSection(captured.StepIndex))">
                                    <LucideIconCn Name="pencil" Size="12" Class="size-3" />
                                    Edit
                                </ButtonCn>
                            </div>
                            <div class="ml-7 space-y-1.5">
                                @foreach (var itm in captured.Items)
                                {
                                    <div class="flex items-center justify-between">
                                        <span class="text-muted-foreground text-xs">@itm.Label</span>
                                        <span class="text-sm">@itm.Value</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @* Order total *@
                <SeparatorCn />
                <div class="px-4 py-3">
                    <div class="flex items-center justify-between rounded-md bg-muted/30 px-3 py-2.5">
                        <span class="font-medium text-sm">Order total</span>
                        <span class="font-semibold text-sm tabular-nums">$149.00</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="border-b px-4 py-4">
                <div class="mb-3">
                    <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_steps[_activeStep].Description
                    </p>
                </div>
                <div class="space-y-2">
                    @foreach (var field in _stepContent[_activeStep])
                    {
                        <div class="flex items-center justify-between rounded-md bg-muted/30 px-3 py-2.5">
                            <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                            <span class="text-sm">@field.Value</span>
                        </div>
                    }
                </div>
            </div>
        }

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            @if (_activeStep == _steps.Length - 1)
            {
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Confirm &amp; submit
                </ButtonCn>
            }
            else
            {
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext">
                    Continue
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record StepDef(string Label, string Description);
    private record FieldItem(string Label, string Value);
    private record ReviewSection(int StepIndex, string Title, FieldItem[] Items);

    private static readonly StepDef[] _steps =
    [
        new("Personal info", "Your name and contact details"),
        new("Address", "Shipping and billing address"),
        new("Payment method", "How you want to pay"),
        new("Review & confirm", "Verify everything before submitting"),
    ];

    private static readonly FieldItem[][] _stepContent =
    [
        [
            new("Full name", "Jordan Rivera"),
            new("Email", "jordan@example.com"),
            new("Phone", "+1 (555) 987-6543"),
            new("Date of birth", "March 14, 1992"),
        ],
        [
            new("Street", "1428 Elm Street, Apt 4B"),
            new("City", "Portland"),
            new("State / ZIP", "OR 97201"),
            new("Country", "United States"),
        ],
        [
            new("Payment type", "Credit card"),
            new("Card number", "**** **** **** 8291"),
            new("Expiry", "11/27"),
            new("Billing address", "Same as shipping"),
        ],
    ];

    private static readonly ReviewSection[] _reviewSections =
    [
        new(0, "Personal info",
        [
            new("Name", "Jordan Rivera"),
            new("Email", "jordan@example.com"),
            new("Phone", "+1 (555) 987-6543"),
        ]),
        new(1, "Shipping address",
        [
            new("Address", "1428 Elm Street, Apt 4B"),
            new("City / State", "Portland, OR 97201"),
            new("Country", "United States"),
        ]),
        new(2, "Payment",
        [
            new("Method", "Visa ending in 8291"),
            new("Expiry", "11/27"),
            new("Billing", "Same as shipping"),
        ]),
    ];

    private int _activeStep = 3;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        _activeStep = index;
    }

    private void HandleEditSection(int stepIndex)
    {
        _activeStep = stepIndex;
    }
}
