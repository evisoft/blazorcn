@* ============================================================
   Block: stepper-with-descriptions
   Title: StepperWithDescriptions
   Description: A horizontal stepper with titles and description lines below each step, connected by progress lines, built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-with-descriptions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Project setup</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Step <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Stepper with descriptions *@
        <div class="border-b px-6 py-6">
            <div class="flex items-start">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var isCompleted = index < _activeStep;
                    var isActive = index == _activeStep;
                    var isUpcoming = index > _activeStep;
                    <div class="flex flex-1 items-start last:flex-none">
                        @* Step circle + label + description *@
                        <div class="flex flex-col items-center gap-2">
                            <button
                                type="button" aria-label="@($"Step {index + 1}: {stp.Label}")"
                                @onclick="@(() => HandleStepClick(index))"
                                disabled="@isUpcoming"
                                class="@Cn.Merge("flex size-9 shrink-0 items-center justify-center rounded-full font-medium text-sm tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600 cursor-pointer" : isActive ? "ring-2 ring-blue-500 ring-offset-2 ring-offset-card bg-blue-500 text-white dark:bg-blue-600 dark:ring-blue-400 cursor-pointer" : "border-2 border-muted-foreground/25 text-muted-foreground cursor-default")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="size-4" />
                                }
                                else
                                {
                                    <span>@(index + 1)</span>
                                }
                            </button>

                            <div class="flex max-w-[120px] flex-col items-center text-center">
                                <span class="@Cn.Merge("font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                    @stp.Label
                                </span>
                                <span class="@Cn.Merge("mt-0.5 leading-tight transition-colors duration-200", isActive ? "text-foreground text-xs" : isCompleted ? "text-emerald-600 text-[11px] dark:text-emerald-400" : "text-muted-foreground/60 text-[11px]")">
                                    @(isCompleted ? stp.CompletedNote : stp.Description)
                                </span>
                            </div>
                        </div>

                        @* Connecting line *@
                        @if (index < _steps.Length - 1)
                        {
                            <div class="mx-2 mt-[18px] h-0.5 flex-1">
                                <div class="@Cn.Merge("h-full rounded-full transition-colors duration-300", index < _activeStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Step content *@
        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@_steps[_activeStep].Description</p>
            </div>
            <div class="space-y-2">
                @foreach (var field in _stepContent[_activeStep])
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                        <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                        <span class="text-sm">@field.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Launch project" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Description, string CompletedNote);
    private record FieldItem(string Label, string Value);

    private static readonly StepItem[] _steps =
    [
        new("Plan", "Choose your subscription tier", "Pro plan selected"),
        new("Team", "Add team members and roles", "4 members invited"),
        new("Config", "Set up workspace settings", "Workspace configured"),
        new("Launch", "Go live with your project", "Ready to launch"),
    ];

    private static readonly FieldItem[][] _stepContent =
    [
        [
            new("Selected plan", "Pro — $39/month"),
            new("Billing cycle", "Annual (save 20%)"),
            new("Seats included", "5 team members"),
        ],
        [
            new("Team name", "Acme Engineering"),
            new("Members invited", "4 of 5 seats used"),
            new("Default role", "Editor"),
        ],
        [
            new("Workspace name", "acme-prod"),
            new("Region", "US East (Virginia)"),
            new("Notifications", "Email + Slack"),
        ],
        [
            new("Domain", "app.acme.io"),
            new("SSL certificate", "Auto-provisioned"),
            new("Status", "Ready for deployment"),
        ],
    ];

    private int _activeStep = 1;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
