@* ============================================================
   Block: stepper-condensed-timeline
   Title: StepperCondensedTimeline
   Description: A high-density vertical timeline stepper with single-row steps, tiny dot indicators, and expandable detail panel built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-condensed-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Deployment pipeline</span>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_completedCount/@_steps.Length
                </BadgeCn>
            </div>
        </div>

        @* Timeline rows *@
        <div>
            @foreach (var stp in _steps)
            {
                var index = Array.IndexOf(_steps, stp);
                var isSelected = _selectedStep == stp.Id;
                var isLast = index == _steps.Length - 1;
                var rowBorder = (!isLast && !isSelected) ? "border-b" : "";
                <div class="@rowBorder">
                    <button
                        type="button"
                        @onclick="@(() => ToggleStep(stp.Id))"
                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        @* Dot with vertical line *@
                        <div class="relative flex shrink-0 items-center justify-center">
                            <span class="@Cn.Merge("size-1.5 rounded-full", DotColor(stp.Status))" />
                            @if (!isLast)
                            {
                                <span class="absolute top-3 left-1/2 h-5 w-px -translate-x-1/2 bg-border" />
                            }
                        </div>

                        @* Title *@
                        <span class="@Cn.Merge("min-w-0 flex-1 truncate text-sm", stp.Status == StepStatus.Active ? "font-medium text-foreground" : stp.Status == StepStatus.Completed ? "text-muted-foreground" : "text-muted-foreground/60")">
                            @if (stp.Status == StepStatus.Completed)
                            {
                                <LucideIconCn Name="check" Size="12" Class="mr-1.5 inline size-3 text-emerald-500" />
                            }
                            @stp.Title
                        </span>

                        @* Timestamp *@
                        <span class="shrink-0 text-muted-foreground/60 text-xs">
                            @stp.Timestamp
                        </span>

                        @* Status label *@
                        <span class="@Cn.Merge("shrink-0 text-xs", stp.Status == StepStatus.Active ? "font-medium text-blue-600 dark:text-blue-400" : stp.Status == StepStatus.Completed ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground/50")">
                            @stp.StatusLabel
                        </span>

                        <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 shrink-0 text-muted-foreground/40 transition-transform duration-200", isSelected ? "rotate-90" : "")" />
                    </button>

                    @* Expanded detail *@
                    @if (isSelected)
                    {
                        var detailBorder = !isLast ? "border-b" : "";
                        <div class="@Cn.Merge("px-4 pb-3 pl-9", detailBorder)">
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="text-muted-foreground text-sm leading-relaxed">@stp.Detail</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @_completedCount of @_steps.Length steps completed
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                View logs
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private enum StepStatus { Completed, Active, Upcoming }

    private record StepItem(string Id, string Title, StepStatus Status, string StatusLabel, string Detail, string Timestamp);

    private static readonly StepItem[] _steps =
    [
        new("create", "Created project", StepStatus.Completed, "Done",
            "Initialized repository with Next.js 16 template, configured TypeScript strict mode, and set up the project structure with app directory routing.",
            "2 min ago"),
        new("members", "Added members", StepStatus.Completed, "Done",
            "Invited 3 team members with developer roles and 1 product manager with viewer access. All invitations accepted within 24 hours.",
            "5 min ago"),
        new("ci", "Configured CI", StepStatus.Completed, "Done",
            "Set up GitHub Actions pipeline with lint, type-check, test, and build stages. Added branch protection rules requiring all checks to pass before merge.",
            "12 min ago"),
        new("deploy", "First deploy", StepStatus.Active, "In progress",
            "Building production bundle and deploying to the staging environment. Edge functions enabled for the US East region. Expected completion in under 2 minutes.",
            "Just now"),
        new("monitor", "Monitoring enabled", StepStatus.Upcoming, "Pending",
            "Configure real-time error tracking, performance monitoring, and uptime alerts. Integrates with Slack for instant notifications on anomalies.",
            "Upcoming"),
        new("domain", "Custom domain", StepStatus.Upcoming, "Pending",
            "Map a custom domain to your deployment. Automatic SSL certificate provisioning and DNS verification included. Supports wildcard subdomains.",
            "Upcoming"),
    ];

    private string? _selectedStep = "deploy";

    private int _completedCount => Array.FindAll(_steps, s => s.Status == StepStatus.Completed).Length;

    private void ToggleStep(string id)
    {
        _selectedStep = _selectedStep == id ? null : id;
    }

    private static string DotColor(StepStatus status) => status switch
    {
        StepStatus.Completed => "bg-emerald-500",
        StepStatus.Active => "bg-blue-500",
        _ => "bg-muted-foreground/30",
    };
}
