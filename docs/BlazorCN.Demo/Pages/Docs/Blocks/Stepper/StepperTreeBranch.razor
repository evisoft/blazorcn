@* ============================================================
   Block: stepper-tree-branch
   Title: StepperTreeBranch
   Description: A tree-trunk stepper with alternating left-right branch nodes, organic connecting lines, and growth-themed progress tracking built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-tree-branch.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Project growth</span>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
                </BadgeCn>
            </div>
        </div>

        @* Tree *@
        <div class="border-b px-4 py-6">
            <div class="relative mx-auto max-w-md">
                @for (int i = 0; i < _steps.Length; i++)
                {
                    var step = _steps[i];
                    var index = i;
                    var isCompleted = index < _activeStep;
                    var isActive = index == _activeStep;
                    var isUpcoming = index > _activeStep;
                    var isEven = index % 2 == 0;
                    var isLast = index == _steps.Length - 1;

                    <div class="relative flex items-stretch">
                        @* Left branch content *@
                        <div class="flex flex-1 justify-end pr-4">
                            @if (isEven)
                            {
                                <div class="flex items-start gap-3">
                                    <div class="max-w-[200px] rounded-md px-3 py-2 text-right">
                                        <span class="@Cn.Merge("font-medium text-sm", (isActive || isCompleted) ? "text-foreground" : "text-muted-foreground")">
                                            @step.Label
                                        </span>
                                        <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>
                                        @if (isActive)
                                        {
                                            <p class="mt-2 text-muted-foreground/80 text-xs leading-relaxed">
                                                @step.Detail
                                            </p>
                                        }
                                        <span class="mt-1 inline-block font-mono text-muted-foreground text-xs">
                                            @step.Metric
                                        </span>
                                    </div>

                                    @* Branch line *@
                                    <div class="@Cn.Merge("mt-3 h-0.5 w-8 shrink-0 rounded-full transition-colors duration-300", isCompleted ? "bg-emerald-500 dark:bg-emerald-600" : isActive ? "bg-blue-500 dark:bg-blue-600" : "bg-muted-foreground/15")" />
                                </div>
                            }
                        </div>

                        @* Center trunk column *@
                        <div class="relative flex flex-col items-center">
                            @* Trunk segment above node *@
                            @if (index > 0)
                            {
                                <div class="@Cn.Merge("h-4 w-1 transition-colors duration-300", (isCompleted || isActive) ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/15")" />
                            }

                            @* Node *@
                            <button
                                type="button"
                                @onclick="@(() => HandleStepClick(index))"
                                disabled="@DisabledAttr(isUpcoming)"
                                class="@Cn.Merge("relative z-10 flex size-9 shrink-0 items-center justify-center rounded-full font-medium text-sm tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600 cursor-pointer" : isActive ? "bg-blue-500 text-white ring-4 ring-blue-500/20 dark:bg-blue-600 dark:ring-blue-400/20 cursor-pointer" : "border-2 border-muted-foreground/25 text-muted-foreground cursor-default")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="leaf" Size="16" Class="size-4" />
                                }
                                else
                                {
                                    <span>@(index + 1)</span>
                                }
                            </button>

                            @* Trunk segment below node *@
                            @if (!isLast)
                            {
                                <div class="@Cn.Merge("w-1 flex-1 transition-colors duration-300", isCompleted ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/15")"
                                     style="@($"min-height:{(isActive ? "64px" : "32px")}")" />
                            }
                        </div>

                        @* Right branch content *@
                        <div class="flex flex-1 justify-start pl-4">
                            @if (!isEven)
                            {
                                <div class="flex items-start gap-3">
                                    @* Branch line *@
                                    <div class="@Cn.Merge("mt-3 h-0.5 w-8 shrink-0 rounded-full transition-colors duration-300", isCompleted ? "bg-emerald-500 dark:bg-emerald-600" : isActive ? "bg-blue-500 dark:bg-blue-600" : "bg-muted-foreground/15")" />

                                    <div class="max-w-[200px] rounded-md px-3 py-2 text-left">
                                        <span class="@Cn.Merge("font-medium text-sm", (isActive || isCompleted) ? "text-foreground" : "text-muted-foreground")">
                                            @step.Label
                                        </span>
                                        <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>
                                        @if (isActive)
                                        {
                                            <p class="mt-2 text-muted-foreground/80 text-xs leading-relaxed">
                                                @step.Detail
                                            </p>
                                        }
                                        <span class="mt-1 inline-block font-mono text-muted-foreground text-xs">
                                            @step.Metric
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Harvest" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private int _activeStep = 2;

    private record TreeStep(string Label, string Description, string Detail, string Metric);

    private static readonly TreeStep[] _steps =
    [
        new(
            "Seed",
            "Project initialization and ideation",
            "Repository created with monorepo structure. Design tokens defined. Brand guidelines documented. Initial wireframes approved by stakeholders.",
            "14 tasks completed"
        ),
        new(
            "Sprout",
            "Foundation and core infrastructure",
            "Database schema designed with 23 tables. Authentication system integrated with SSO support. CI/CD pipeline operational with 4-minute build times.",
            "31 tasks completed"
        ),
        new(
            "Growth",
            "Feature development and iteration",
            "Dashboard module with 8 chart types. User management with role-based access. Real-time notifications via WebSocket. File upload with CDN delivery.",
            "67 tasks completed"
        ),
        new(
            "Bloom",
            "Polish, testing, and refinement",
            "96% test coverage across unit and integration suites. Performance budget met: LCP under 1.2s, CLS under 0.05. Accessibility audit passed at AA level.",
            "28 tasks remaining"
        ),
        new(
            "Harvest",
            "Launch and post-launch optimization",
            "Production deployment across 3 regions. Monitoring dashboards configured. Runbook documented for on-call engineers. Post-launch retrospective scheduled.",
            "Launch ready"
        ),
    ];

    private static string? DisabledAttr(bool disabled) => disabled ? "disabled" : null;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
            _activeStep++;
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
            _activeStep--;
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
            _activeStep = index;
    }
}
