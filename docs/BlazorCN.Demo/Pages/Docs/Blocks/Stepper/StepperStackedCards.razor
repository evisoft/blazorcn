@* ============================================================
   Block: stepper-stacked-cards
   Title: StepperStackedCards
   Description: An overlapping stacked card stepper where the active step is displayed on top with upcoming cards peeking behind to create a visual depth effect built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-stacked-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Subscription setup</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Step <span class="tabular-nums">@(_currentStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Progress indicator *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                @foreach (var stepItem in _steps)
                {
                    var idx = Array.IndexOf(_steps, stepItem);
                    var isCompleted = idx < _currentStep;
                    var isActive = idx == _currentStep;
                    <div class="flex items-center gap-3">
                        <span class="@Cn.Merge("flex size-5 shrink-0 items-center justify-center rounded-full text-xs tabular-nums", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-foreground text-background" : "border border-muted-foreground/25 text-muted-foreground")">
                            @if (isCompleted)
                            {
                                <LucideIconCn Name="check" Size="10" Class="size-2.5" />
                            }
                            else
                            {
                                <span class="text-[10px]">@(idx + 1)</span>
                            }
                        </span>
                        @if (idx < _steps.Length - 1)
                        {
                            <div class="@Cn.Merge("h-px w-6", isCompleted ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")"></div>
                        }
                    </div>
                }
                <span class="ml-auto text-muted-foreground text-xs">@ActiveStepData.Label</span>
            </div>
        </div>

        @* Stacked cards area *@
        <div class="px-4 py-4">
            @* Completed strips *@
            @if (CompletedSteps.Length > 0)
            {
                <div class="mb-3 space-y-1.5">
                    @foreach (var pair in CompletedSteps.Select((s, i) => (Step: s, Index: i)))
                    {
                        var capturedIndex = pair.Index;
                        var step = pair.Step;
                        <button type="button" @onclick="@(() => SetStep(capturedIndex))"
                                class="flex w-full items-center gap-2.5 rounded-md bg-muted/30 px-3 py-2 text-left transition-colors hover:bg-muted/50">
                            <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500 text-white dark:bg-emerald-600">
                                <LucideIconCn Name="check" Size="10" Class="size-2.5" />
                            </span>
                            <span class="font-medium text-xs">@step.Label</span>
                            <span class="text-muted-foreground text-xs">·</span>
                            <span class="min-w-0 flex-1 truncate text-muted-foreground text-xs">@step.Summary</span>
                        </button>
                    }
                </div>
            }

            @* Active card + upcoming stack *@
            <div class="relative">
                @* Upcoming card shadows (max 2 visible) *@
                @foreach (var upcomingPair in UpcomingSteps.Take(2).Select((s, i) => (Step: s, Index: i)))
                {
                    var ui = upcomingPair.Index;
                    var translateY = (ui + 1) * 8;
                    var scaleVal = 1.0 - (ui + 1) * 0.03;
                    var zIdx = 10 - (ui + 1);
                    var opacityVal = 1.0 - (ui + 1) * 0.25;
                    <div class="absolute inset-x-0 top-0 rounded-lg border bg-card"
                         style="@($"transform: translateY({translateY}px) scale({scaleVal:F2}); z-index: {zIdx}; opacity: {opacityVal:F2}; height: 100%;")">
                    </div>
                }

                @* Active card *@
                <div class="relative z-10 rounded-lg border bg-card"
                     style="box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.05)">
                    <div class="border-b px-4 py-3">
                        <div class="flex items-center gap-2">
                            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-foreground text-xs text-background tabular-nums">
                                @(_currentStep + 1)
                            </span>
                            <div>
                                <span class="font-medium text-sm">@ActiveStepData.Label</span>
                                <p class="text-muted-foreground text-xs">@ActiveStepData.Description</p>
                            </div>
                        </div>
                    </div>

                    <div class="px-4 py-3">
                        <div class="space-y-2">
                            @foreach (var field in ActiveStepData.Fields)
                            {
                                <div class="flex items-center justify-between rounded-md bg-muted/30 px-3 py-2.5">
                                    <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                                    <span class="text-sm">@field.Value</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="flex items-center justify-between border-t px-4 py-3">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" OnClick="HandleBack" Disabled="@(_currentStep == 0)">
                            <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                            Back
                        </ButtonCn>
                        <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1 px-3 text-xs" OnClick="HandleNext" Disabled="@(_currentStep == _steps.Length - 1)">
                            @(_currentStep == _steps.Length - 1 ? "Complete" : "Next")
                            @if (_currentStep < _steps.Length - 1)
                            {
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                            }
                        </ButtonCn>
                    </div>
                </div>
            </div>

            @* Bottom spacing for stacked cards visual *@
            @if (UpcomingSteps.Length > 0)
            {
                var h = Math.Min(UpcomingSteps.Length, 2) * 8;
                <div style="@($"height: {h}px;")"></div>
            }
        </div>
    </div>
</section>

@code {
    private record Step(string Label, string Description, string Summary, FieldItem[] Fields);
    private record FieldItem(string Label, string Value);

    private static readonly Step[] _steps =
    [
        new("Choose plan", "Select the subscription that fits your needs", "Team plan — $79/month",
        [
            new("Selected plan", "Team"),
            new("Seats included", "Up to 10 members"),
            new("Monthly price", "$79.00"),
            new("Features", "Unlimited projects, API access, Priority support"),
        ]),
        new("Customize", "Configure add-ons and preferences", "2 add-ons selected — $30/month",
        [
            new("Extra storage", "100 GB (+$15/month)"),
            new("Custom domain", "Enabled (+$15/month)"),
            new("Advanced analytics", "Not selected"),
            new("Add-on total", "$30.00/month"),
        ]),
        new("Payment", "Enter your billing information", "Visa ending in 4242",
        [
            new("Card number", "**** **** **** 4242"),
            new("Expiration", "09/28"),
            new("Cardholder", "Alex Johnson"),
            new("Billing address", "742 Evergreen Terrace, Springfield IL"),
        ]),
        new("Confirmation", "Review your order and complete purchase", "Order confirmed",
        [
            new("Plan", "Team — $79.00/month"),
            new("Add-ons", "Storage + Domain — $30.00/month"),
            new("Total", "$109.00/month"),
            new("Payment", "Visa ending in 4242"),
        ]),
    ];

    private int _currentStep = 1;

    private Step[] CompletedSteps => _steps[.._currentStep];
    private Step ActiveStepData => _steps[_currentStep];
    private Step[] UpcomingSteps => _steps[(_currentStep + 1)..];

    private void SetStep(int index)
    {
        _currentStep = index;
    }

    private void HandleNext()
    {
        if (_currentStep < _steps.Length - 1)
        {
            _currentStep++;
        }
    }

    private void HandleBack()
    {
        if (_currentStep > 0)
        {
            _currentStep--;
        }
    }
}
