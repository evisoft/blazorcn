@* ============================================================
   Block: stepper-with-preview
   Title: StepperWithPreview
   Description: A two-panel stepper wizard with a vertical step navigator and live preview panel that updates as configuration options change built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-with-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Theme builder</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">
                    Step <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_stepsConfig.Length</span>
                </span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="eye" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Live preview</span>
            </div>
        </div>

        @* Split layout *@
        <div class="flex min-h-[420px]">
            @* Left: Step navigator + content *@
            <div class="flex w-72 shrink-0 flex-col border-r">
                @* Step list *@
                <div class="flex-1">
                    <div class="py-1">
                        @for (var i = 0; i < _stepsConfig.Length; i++)
                        {
                            var idx = i;
                            var step = _stepsConfig[idx];
                            var isComplete = idx < _activeStep;
                            var isActive = idx == _activeStep;
                            var isUpcoming = idx > _activeStep;
                            <button
                                type="button"
                                @onclick="@(() => { if (!isUpcoming) _activeStep = idx; })"
                                disabled="@isUpcoming"
                                class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors", isActive ? "bg-muted/50" : isUpcoming ? "cursor-default opacity-50" : "cursor-pointer hover:bg-muted/30")">
                                <span class="@Cn.Merge("flex size-6 shrink-0 items-center justify-center rounded-full text-xs transition-all duration-200", isComplete ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-foreground text-background" : "border border-muted-foreground/30 text-muted-foreground")">
                                    @if (isComplete)
                                    {
                                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="@step.Icon" Size="12" Class="size-3" />
                                    }
                                </span>
                                <div class="min-w-0 flex-1">
                                    <span class="@Cn.Merge("block truncate font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                        @step.Label
                                    </span>
                                    <span class="block truncate text-muted-foreground text-xs opacity-70">
                                        @step.Description
                                    </span>
                                </div>
                            </button>
                        }
                    </div>

                    @* Active step options *@
                    @if (CurrentStep.Options.Length > 0)
                    {
                        <div class="h-px bg-border"></div>
                        <div class="space-y-3 px-4 py-3">
                            @foreach (var option in CurrentStep.Options)
                            {
                                var opt = option;
                                <div>
                                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                        @opt.Label
                                    </span>
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var choice in opt.Options)
                                        {
                                            var ch = choice;
                                            var optId = opt.Id;
                                            <button
                                                type="button"
                                                @onclick="@(() => HandleOptionChange(optId, ch))"
                                                class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _config[opt.Id] == ch ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground hover:bg-muted")">
                                                @ch
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @* Export step summary *@
                    @if (_isLastStep)
                    {
                        <div class="h-px bg-border"></div>
                        <div class="space-y-1.5 px-4 py-3">
                            <span class="block font-medium text-muted-foreground text-xs">
                                Configuration summary
                            </span>
                            @foreach (var kvp in _config)
                            {
                                <div class="flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">@kvp.Key</span>
                                    <span class="font-medium text-xs">@kvp.Value</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                @* Navigation *@
                <div class="h-px bg-border"></div>
                <div class="flex items-center justify-between px-4 py-3">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                        <LucideIconCn Name="chevron-left" Size="12" Class="size-3" />
                        Back
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="HandleNext" Disabled="@_isLastStep">
                        @(_isLastStep ? "Export" : "Next")
                        @if (!_isLastStep)
                        {
                            <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
                        }
                    </ButtonCn>
                </div>
            </div>

            @* Right: Live preview *@
            <div class="flex min-w-0 flex-1 flex-col">
                <div class="flex items-center justify-between border-b px-4 py-2">
                    <span class="text-muted-foreground text-xs">Preview</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @_config["width"]
                    </BadgeCn>
                </div>
                <div class="flex-1 bg-muted/20 p-4">
                    @* Mock page preview *@
                    <div class="@Cn.Merge("h-full overflow-hidden border", PreviewRadius, PreviewBg, PreviewBorder)">
                        <div class="@Cn.Merge("flex flex-col", PreviewSpacing)">
                            @* Mock navbar *@
                            <div class="@Cn.Merge("flex items-center justify-between border-b pb-3", PreviewBorder)">
                                <div class="flex items-center gap-2">
                                    <div class="@Cn.Merge("size-5", PreviewRadius, PreviewAccent)"></div>
                                    <span class="@Cn.Merge("font-medium text-xs", PreviewText)">Acme</span>
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="@Cn.Merge("text-xs", PreviewMuted)">Features</span>
                                    <span class="@Cn.Merge("text-xs", PreviewMuted)">Pricing</span>
                                    <div class="@Cn.Merge("h-6 px-3 flex items-center text-xs text-white", PreviewRadius, PreviewAccent)">
                                        Sign up
                                    </div>
                                </div>
                            </div>

                            @* Mock hero *@
                            <div class="py-4 text-center">
                                <div class="@Cn.Merge("mx-auto mb-2 font-semibold", HeroTextSize, PreviewText)">
                                    Build faster with components
                                </div>
                                <div class="@Cn.Merge("mx-auto text-xs", PreviewMuted)">
                                    A library of production-ready UI blocks
                                </div>
                                <div class="mt-3 flex justify-center gap-2">
                                    <div class="@Cn.Merge("h-7 px-4 flex items-center text-xs text-white", PreviewRadius, PreviewAccent)">
                                        Get started
                                    </div>
                                    <div class="@Cn.Merge("h-7 px-4 flex items-center text-xs border", PreviewRadius, PreviewBorder, PreviewText)">
                                        Learn more
                                    </div>
                                </div>
                            </div>

                            @* Mock cards grid *@
                            <div class="grid grid-cols-3 gap-2">
                                @foreach (var cardLabel in _cardLabels)
                                {
                                    <div class="@Cn.Merge("border p-3", PreviewRadius, PreviewBorder)">
                                        <div class="@Cn.Merge("mb-1 size-4", PreviewRadius, PreviewAccent, "opacity-20")"></div>
                                        <div class="@Cn.Merge("font-medium text-xs", PreviewText)">@cardLabel</div>
                                        <div class="@Cn.Merge("mt-0.5 text-xs", PreviewMuted)">Ready to use</div>
                                    </div>
                                }
                            </div>

                            @* Mock input *@
                            <div class="@Cn.Merge("flex items-center gap-2 border p-2", PreviewRadius, PreviewBorder)">
                                <span class="@Cn.Merge("flex-1 text-xs", PreviewMuted)">Enter your email...</span>
                                <div class="@Cn.Merge("h-6 px-3 flex items-center text-xs text-white", PreviewRadius, PreviewAccent)">
                                    Subscribe
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ConfigOption(string Id, string Label, string DefaultValue, string[] Options);
    private record StepCfg(string Label, string Description, string Icon, ConfigOption[] Options);

    private static readonly StepCfg[] _stepsConfig =
    [
        new("Layout", "Page structure and spacing", "layout",
        [
            new("layout", "Layout type", "Single column", ["Single column", "Sidebar", "Two column"]),
            new("width", "Max width", "1280px", ["960px", "1280px", "Full width"]),
            new("spacing", "Spacing", "Comfortable", ["Compact", "Comfortable", "Spacious"]),
        ]),
        new("Colors", "Theme and accent colors", "palette",
        [
            new("theme", "Theme", "Light", ["Light", "Dark", "System"]),
            new("accent", "Accent", "Neutral", ["Neutral", "Blue", "Emerald", "Rose"]),
            new("radius", "Border radius", "Medium", ["None", "Small", "Medium", "Large"]),
        ]),
        new("Typography", "Fonts and text sizing", "type",
        [
            new("heading", "Heading font", "Inter", ["Inter", "Cal Sans", "Satoshi", "System"]),
            new("body", "Body font", "Inter", ["Inter", "Geist", "System"]),
            new("scale", "Type scale", "Default", ["Compact", "Default", "Large"]),
        ]),
        new("Components", "UI elements and density", "puzzle",
        [
            new("buttons", "Button style", "Filled", ["Filled", "Outline", "Ghost"]),
            new("inputs", "Input style", "Bordered", ["Bordered", "Underline", "Filled"]),
            new("density", "Density", "Default", ["Compact", "Default", "Relaxed"]),
        ]),
        new("Export", "Generate your configuration", "columns", []),
    ];

    private static readonly string[] _cardLabels = ["Auth", "Payments", "Analytics"];

    private int _activeStep = 0;

    private Dictionary<string, string> _config = new()
    {
        ["layout"] = "Single column",
        ["width"] = "1280px",
        ["spacing"] = "Comfortable",
        ["theme"] = "Light",
        ["accent"] = "Neutral",
        ["radius"] = "Medium",
        ["heading"] = "Inter",
        ["body"] = "Inter",
        ["scale"] = "Default",
        ["buttons"] = "Filled",
        ["inputs"] = "Bordered",
        ["density"] = "Default",
    };

    private StepCfg CurrentStep => _stepsConfig[_activeStep];
    private bool _isLastStep => _activeStep == _stepsConfig.Length - 1;

    private string PreviewRadius => _config.TryGetValue("radius", out var r) ? r switch
    {
        "None" => "rounded-none",
        "Small" => "rounded",
        "Large" => "rounded-xl",
        _ => "rounded-md",
    } : "rounded-md";

    private string PreviewAccent => _config.TryGetValue("accent", out var a) ? a switch
    {
        "Blue" => "bg-blue-500",
        "Emerald" => "bg-emerald-500",
        "Rose" => "bg-rose-500",
        _ => "bg-foreground",
    } : "bg-foreground";

    private string PreviewBg => _config.TryGetValue("theme", out var t1) && t1 == "Dark" ? "bg-zinc-950" : "bg-white";
    private string PreviewText => _config.TryGetValue("theme", out var t2) && t2 == "Dark" ? "text-zinc-100" : "text-zinc-900";
    private string PreviewMuted => _config.TryGetValue("theme", out var t3) && t3 == "Dark" ? "text-zinc-500" : "text-zinc-400";
    private string PreviewBorder => _config.TryGetValue("theme", out var t4) && t4 == "Dark" ? "border-zinc-800" : "border-zinc-200";

    private string PreviewSpacing => _config.TryGetValue("spacing", out var sp) ? sp switch
    {
        "Compact" => "p-3 gap-2",
        "Spacious" => "p-6 gap-5",
        _ => "p-4 gap-3",
    } : "p-4 gap-3";

    private string HeroTextSize => _config.TryGetValue("scale", out var sc) ? sc switch
    {
        "Large" => "text-lg",
        "Compact" => "text-xs",
        _ => "text-sm",
    } : "text-sm";

    private void HandleOptionChange(string id, string value)
    {
        _config[id] = value;
    }

    private void HandleNext()
    {
        if (_activeStep < _stepsConfig.Length - 1)
            _activeStep++;
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
            _activeStep--;
    }
}
