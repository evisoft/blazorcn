@* ============================================================
   Block: stepper-inline-editing
   Title: StepperInlineEditing
   Description: A customizable stepper with inline-editable step titles and descriptions, pencil icon triggers, and save/cancel actions built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-inline-editing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Project setup</span>
            <div class="flex items-center gap-2">
                @if (_editCount > 0)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <span class="tabular-nums">@_editCount</span>
                        @(_editCount == 1 ? "edit" : "edits")
                    </BadgeCn>
                }
                <span class="text-muted-foreground text-xs tabular-nums">
                    Step @(_activeStep + 1) of @_steps.Count
                </span>
            </div>
        </div>

        @* Steps list *@
        <div>
            @foreach (var (stp, index) in _steps.Select((s, i) => (s, i)))
            {
                var step = stp;
                var idx = index;
                var isActive = idx == _activeStep;
                var isEditing = _editingId == step.Id;
                var isLast = idx == _steps.Count - 1;
                <div class="@Cn.Merge(isLast ? "" : "border-b", isActive ? "bg-muted/20" : "")">
                    @if (isEditing)
                    {
                        @* Edit mode *@
                        <div class="px-4 py-3">
                            <div class="flex items-center gap-3">
                                <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-foreground text-xs text-background tabular-nums">
                                    @(idx + 1)
                                </span>
                                <div class="min-w-0 flex-1 space-y-2">
                                    <InputCn @bind-Value="_editTitle" Placeholder="Step title" Class="h-8 text-sm" />
                                    <InputCn @bind-Value="_editDescription" Placeholder="Step description" Class="h-8 text-xs text-muted-foreground" />
                                    <div class="flex items-center gap-1.5 pt-1">
                                        <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1 px-2.5 text-xs" OnClick="SaveEditing" Disabled="@(_editTitle.Trim() == "")">
                                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                                            Save
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2.5 text-xs" OnClick="CancelEditing">
                                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                                            Cancel
                                        </ButtonCn>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @* Display mode *@
                        <div class="flex items-center gap-3 px-4 py-3 transition-colors">
                            @* Step number *@
                            <button
                                type="button" aria-label="@($"Step {idx + 1}: {step.Title}")"
                                @onclick="@(() => { _activeStep = idx; })"
                                class="@Cn.Merge("flex size-7 shrink-0 cursor-pointer items-center justify-center rounded-full text-xs tabular-nums transition-all duration-200", isActive ? "bg-foreground text-background" : "border border-muted-foreground/25 text-muted-foreground")">
                                @(idx + 1)
                            </button>

                            @* Step text *@
                            <div class="min-w-0 flex-1">
                                <span class="@Cn.Merge("font-medium text-sm", isActive ? "text-foreground" : "text-muted-foreground")">
                                    @step.Title
                                </span>
                                <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>
                            </div>

                            @* Edit button *@
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" Class="shrink-0 text-muted-foreground/60 hover:text-foreground" OnClick="@(() => StartEditing(step))" aria-label="Edit">
                                <LucideIconCn Name="pencil" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    }
                </div>
            }
        </div>

        @* Active step detail *@
        <div class="border-t px-4 py-4">
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center justify-between">
                    <span class="font-medium text-muted-foreground text-xs">Current step</span>
                    <span class="text-muted-foreground text-xs tabular-nums">
                        Step @(_activeStep + 1)
                    </span>
                </div>
                <p class="font-medium text-sm">@_steps[_activeStep].Title</p>
                <p class="mt-0.5 text-muted-foreground text-sm leading-relaxed">
                    @_steps[_activeStep].Description
                </p>
            </div>
        </div>

        @* Footer hint *@
        <div class="flex items-center justify-center border-t px-4 py-2.5">
            <span class="flex items-center gap-1.5 text-muted-foreground/60 text-xs">
                <LucideIconCn Name="pencil" Size="12" Class="size-3" />
                Click the pencil icon to customize any step
            </span>
        </div>
    </div>
</section>

@code {
    private record EditableStep(string Id, string Title, string Description);

    private List<EditableStep> _steps =
    [
        new("scope", "Define scope", "Identify deliverables, milestones, and success criteria"),
        new("budget", "Set budget", "Allocate resources, estimate costs, and set contingency"),
        new("team", "Assign team", "Select team members, define roles, and set availability"),
        new("kickoff", "Kick off", "Schedule kickoff meeting, share project brief, and align goals"),
    ];

    private int _activeStep = 1;
    private string? _editingId = null;
    private string _editTitle = "";
    private string _editDescription = "";
    private int _editCount = 0;

    private void StartEditing(EditableStep step)
    {
        _editingId = step.Id;
        _editTitle = step.Title;
        _editDescription = step.Description;
    }

    private void CancelEditing()
    {
        _editingId = null;
        _editTitle = "";
        _editDescription = "";
    }

    private void SaveEditing()
    {
        if (_editingId == null || _editTitle.Trim() == "") return;

        for (int i = 0; i < _steps.Count; i++)
        {
            if (_steps[i].Id == _editingId)
            {
                _steps[i] = _steps[i] with { Title = _editTitle.Trim(), Description = _editDescription.Trim() };
                break;
            }
        }
        _editCount++;
        _editingId = null;
        _editTitle = "";
        _editDescription = "";
    }
}
