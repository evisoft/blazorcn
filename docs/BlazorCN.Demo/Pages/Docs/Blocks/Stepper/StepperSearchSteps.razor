@* ============================================================
   Block: stepper-search-steps
   Title: StepperSearchSteps
   Description: A stepper wizard with a search bar to filter and quickly navigate to any step in a long workflow built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-search-steps.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Project configuration</span>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_activeStep of @_steps.Length complete
                </span>
            </div>
        </div>

        @* Search bar *@
        <div class="flex items-center gap-2 border-b px-4 py-2.5">
            <LucideIconCn Name="search" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
            <input
                type="text"
                value="@_searchQuery"
                @oninput="@((ChangeEventArgs e) => _searchQuery = e.Value?.ToString() ?? "")"
                placeholder="Search steps..."
                class="h-7 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground/50" />
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                <button
                    type="button" aria-label="Clear search"
                    @onclick="@(() => _searchQuery = "")"
                    class="flex size-5 items-center justify-center rounded text-muted-foreground/60 transition-colors hover:text-muted-foreground">
                    <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                </button>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                    @FilteredSteps.Length found
                </BadgeCn>
            }
        </div>

        @* Step list *@
        <div class="max-h-[400px] overflow-y-auto">
            @{
                var filteredSteps = FilteredSteps;
            }
            @if (filteredSteps.Length == 0)
            {
                <div class="px-4 py-8 text-center">
                    <p class="text-muted-foreground text-sm">No steps match your search</p>
                    <p class="mt-1 text-muted-foreground/60 text-xs">Try a different keyword</p>
                </div>
            }
            @foreach (var stp in filteredSteps)
            {
                var step = stp;
                var originalIndex = System.Array.FindIndex(_steps, s => s.Id == step.Id);
                var isCompleted = originalIndex < _activeStep;
                var isActive = originalIndex == _activeStep;
                var isUpcoming = originalIndex > _activeStep;
                <div class="border-b last:border-b-0">
                    <button
                        type="button"
                        @onclick="@(() => HandleStepClick(originalIndex))"
                        disabled="@isUpcoming"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors", isUpcoming ? "cursor-default opacity-50" : isActive ? "bg-muted/30" : "cursor-pointer hover:bg-muted/50")">
                        @* Step indicator *@
                        <span class="@Cn.Merge("flex size-6 shrink-0 items-center justify-center rounded-full text-xs transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-foreground text-background" : "border border-muted-foreground/25 text-muted-foreground")">
                            @if (isCompleted)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                            }
                            else
                            {
                                <span class="font-medium tabular-nums">@(originalIndex + 1)</span>
                            }
                        </span>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("text-sm", isActive ? "font-medium" : "")">
                                    @HighlightMatch(step.Label, _searchQuery)
                                </span>
                                <span class="text-muted-foreground/40 text-xs">@step.Category</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @HighlightMatch(step.Description, _searchQuery)
                            </p>
                        </div>

                        @if (isActive)
                        {
                            <LucideIconCn Name="chevron-right" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                        }
                        @if (isCompleted)
                        {
                            <span class="text-muted-foreground text-xs">Done</span>
                        }
                    </button>
                </div>
            }
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-xs text-muted-foreground">Current:</span>
                <span class="text-xs">@_steps[_activeStep].Label</span>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="HandleContinue" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Finish" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Id, string Label, string Description, string Category);

    private static readonly StepItem[] _steps =
    [
        new("project-name", "Project name", "Set your project name and slug identifier", "General"),
        new("team-members", "Team members", "Invite collaborators and assign roles", "General"),
        new("authentication", "Authentication provider", "Configure OAuth, SAML, or email login methods", "Security"),
        new("permissions", "Role permissions", "Define access levels and resource restrictions", "Security"),
        new("database", "Database connection", "Connect PostgreSQL, MySQL, or MongoDB instance", "Infrastructure"),
        new("storage", "File storage", "Configure S3, GCS, or local file storage buckets", "Infrastructure"),
        new("domain", "Custom domain", "Map your domain and configure DNS records", "Deployment"),
        new("ssl", "SSL certificate", "Provision TLS certificate for HTTPS encryption", "Deployment"),
        new("environment", "Environment variables", "Set secrets and configuration for each environment", "Deployment"),
        new("notifications", "Notification channels", "Configure email, Slack, and webhook alerts", "Integrations"),
        new("monitoring", "Monitoring setup", "Enable error tracking, logs, and uptime checks", "Integrations"),
        new("review", "Review and deploy", "Verify all settings and push to production", "Final"),
    ];

    private int _activeStep = 4;
    private string _searchQuery = "";

    private StepItem[] FilteredSteps
    {
        get
        {
            var q = _searchQuery.Trim();
            if (string.IsNullOrEmpty(q)) return _steps;
            var lower = q.ToLowerInvariant();
            return System.Array.FindAll(_steps, s =>
                s.Label.ToLowerInvariant().Contains(lower) ||
                s.Description.ToLowerInvariant().Contains(lower) ||
                s.Category.ToLowerInvariant().Contains(lower));
        }
    }

    private void HandleStepClick(int stepIndex)
    {
        if (stepIndex <= _activeStep)
            _activeStep = stepIndex;
    }

    private void HandleContinue()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
            _searchQuery = "";
        }
    }

    private static MarkupString HighlightMatch(string text, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
            return (MarkupString)System.Net.WebUtility.HtmlEncode(text);
        var lowerText = text.ToLowerInvariant();
        var lowerQuery = query.ToLowerInvariant();
        var idx = lowerText.IndexOf(lowerQuery, StringComparison.Ordinal);
        if (idx == -1)
            return (MarkupString)System.Net.WebUtility.HtmlEncode(text);
        var before = System.Net.WebUtility.HtmlEncode(text[..idx]);
        var match = System.Net.WebUtility.HtmlEncode(text.Substring(idx, query.Length));
        var after = System.Net.WebUtility.HtmlEncode(text[(idx + query.Length)..]);
        return (MarkupString)$"{before}<span class=\"rounded-sm bg-yellow-200/60 px-0.5 dark:bg-yellow-500/20\">{match}</span>{after}";
    }
}
