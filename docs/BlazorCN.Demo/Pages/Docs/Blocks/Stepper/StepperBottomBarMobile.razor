@* ============================================================
   Block: stepper-bottom-bar-mobile
   Title: StepperBottomBarMobile
   Description: A mobile-optimized stepper with full-width content area, fixed bottom navigation bar with step dots, back/next buttons, and step counter built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-bottom-bar-mobile.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[500px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="@_steps[_currentStep].IconName" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">@_steps[_currentStep].Label</span>
            </div>
        </div>

        @* Content area *@
        <div class="flex-1 overflow-y-auto px-4 py-4" tabindex="0" role="group" aria-label="Step details">
            @{
                var content = _stepData[_steps[_currentStep].Id];
            }
            <div class="mb-1 font-medium text-sm">@content.Title</div>
            <p class="mb-5 text-muted-foreground text-xs">@content.Description</p>

            <div class="space-y-4">
                @foreach (var field in content.Fields)
                {
                    <div class="space-y-1.5">
                        <span class="text-muted-foreground text-xs font-medium">@field.Label</span>
                        <div class="flex h-9 items-center rounded-md border bg-muted/30 px-3 text-sm">
                            @field.Value
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Bottom bar *@
        <div class="border-t bg-card">
            @* Step counter + dots *@
            <div class="flex flex-col items-center gap-2 px-4 pt-3 pb-1">
                <span class="text-muted-foreground text-xs tabular-nums">
                    Step @(_currentStep + 1) of @_steps.Length
                </span>
                <div class="flex items-center gap-0.5">
                    @foreach (var dotEntry in _steps.Select((s, i) => new { Step = s, Index = i }))
                    {
                        var dotIndex = dotEntry.Index;
                        <button
                            type="button" aria-label="@($"Step {dotIndex + 1}: {dotEntry.Step.Label}")"
                            @onclick="@(() => _currentStep = dotIndex)"
                            class="inline-flex size-6 items-center justify-center">
                            <span class="@Cn.Merge("size-2 rounded-full transition-all", dotIndex == _currentStep ? "scale-125 bg-blue-500" : dotIndex < _currentStep ? "bg-emerald-500" : "bg-muted-foreground/25")"></span>
                        </button>
                    }
                </div>
            </div>

            @* Navigation buttons *@
            <div class="flex items-center justify-between px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs" Disabled="@(_currentStep == 0)" OnClick="HandleBack">
                    <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                    Back
                </ButtonCn>
                @if (_currentStep < _steps.Length - 1)
                {
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs" OnClick="HandleNext">
                        Next
                        <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                    </ButtonCn>
                }
                else
                {
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Complete setup
                    </ButtonCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Id, string Label, string IconName);
    private record FormField(string Label, string Value, string FieldType);
    private record StepData(string Title, string Description, FormField[] Fields);

    private int _currentStep = 0;

    private static readonly StepItem[] _steps =
    [
        new("info", "Your info", "user"),
        new("preferences", "Preferences", "sliders-horizontal"),
        new("customize", "Customize", "palette"),
        new("confirm", "Confirm", "check-circle-2"),
    ];

    private static readonly Dictionary<string, StepData> _stepData = new()
    {
        ["info"] = new("Your information", "Tell us about yourself so we can personalize your experience.",
        [
            new("Full name", "Alex Morgan", "text"),
            new("Email", "alex@acme.com", "text"),
            new("Role", "Product Designer", "select"),
            new("Company", "Acme Inc.", "text"),
        ]),
        ["preferences"] = new("Preferences", "Set your default preferences for the workspace.",
        [
            new("Language", "English (US)", "select"),
            new("Timezone", "America/New_York (EST)", "select"),
            new("Date format", "MM/DD/YYYY", "select"),
            new("Start of week", "Monday", "select"),
        ]),
        ["customize"] = new("Customize workspace", "Make the workspace feel like yours.",
        [
            new("Theme", "System default", "select"),
            new("Sidebar position", "Left", "select"),
            new("Compact mode", "Off", "toggle"),
            new("Notification sound", "Subtle ping", "select"),
        ]),
        ["confirm"] = new("Confirm setup", "Review your choices before we set everything up.",
        [
            new("Name", "Alex Morgan", "text"),
            new("Workspace", "Acme Inc.", "text"),
            new("Theme", "System default", "text"),
            new("Timezone", "EST (UTC-5)", "text"),
        ]),
    };

    private void HandleBack()
    {
        if (_currentStep > 0)
            _currentStep--;
    }

    private void HandleNext()
    {
        if (_currentStep < _steps.Length - 1)
            _currentStep++;
    }
}
