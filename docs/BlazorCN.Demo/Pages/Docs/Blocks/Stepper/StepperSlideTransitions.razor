@* ============================================================
   Block: stepper-slide-transitions
   Title: StepperSlideTransitions
   Description: A horizontal slider stepper with left and right arrow navigation, position indicator bar, step counter, and smooth content transitions built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-slide-transitions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Position indicator bar *@
        <div class="h-1 w-full bg-muted-foreground/10">
            <div
                class="h-full rounded-r-full bg-blue-500 transition-all duration-300"
                style="@(FormattableString.Invariant($"width:{_progressPercent}%"))">
            </div>
        </div>

        @* Header with step counter and step labels *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2.5">
                <span class="text-muted-foreground">
                    <LucideIconCn Name="@_steps[_currentStep].IconName" Size="16" Class="size-4" />
                </span>
                <span class="font-medium text-sm">@_steps[_currentStep].Label</span>
            </div>
            <span class="font-medium text-muted-foreground text-xs tabular-nums">
                @(_currentStep + 1) / @_steps.Length
            </span>
        </div>

        @* Step dots *@
        <div class="flex items-center justify-center gap-4 border-b px-4 py-2.5">
            @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
            {
                var idx = entry.Index;
                var step = entry.Step;
                var isActive = idx == _currentStep;
                var isDotCompleted = _completed.Contains(idx);
                var capturedIdx = idx;
                var dotClass = isActive
                    ? "flex size-2 items-center justify-center rounded-full transition-all duration-200 scale-125 bg-blue-500"
                    : isDotCompleted
                        ? "flex size-2 items-center justify-center rounded-full transition-all duration-200 bg-emerald-500"
                        : "flex size-2 items-center justify-center rounded-full transition-all duration-200 bg-muted-foreground/25 group-hover:bg-muted-foreground/40";
                var labelClass = isActive
                    ? "hidden text-xs sm:inline font-medium text-foreground"
                    : "hidden text-xs sm:inline text-muted-foreground";

                <button
                    type="button"
                    @onclick="@(() => NavigateToDot(capturedIdx))"
                    class="group flex items-center gap-1.5">
                    <span class="@dotClass"></span>
                    <span class="@labelClass">@step.Label</span>
                </button>
            }
        </div>

        @* Slide content area *@
        <div class="relative overflow-hidden">
            <div class="px-4 py-5">
                <div class="mb-1 font-medium text-sm">@_steps[_currentStep].Title</div>
                <p class="mb-4 text-muted-foreground text-xs">@_steps[_currentStep].Description</p>

                <div>
                    @foreach (var itemEntry in _steps[_currentStep].Items.Select((it, i) => new { Item = it, Index = i }))
                    {
                        var ii = itemEntry.Index;
                        var itm = itemEntry.Item;
                        var itemClass = ii < _steps[_currentStep].Items.Length - 1
                            ? "flex items-center justify-between py-2.5 border-b"
                            : "flex items-center justify-between py-2.5";

                        <div class="@itemClass">
                            <span class="text-muted-foreground text-xs">@itm.Label</span>
                            <span class="font-medium text-sm">@itm.Value</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Navigation footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs" OnClick="GoPrev" Disabled="@(_currentStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Previous
            </ButtonCn>

            @* Completed indicator *@
            <div class="flex items-center gap-1.5">
                @foreach (var footEntry in _steps.Select((s, i) => new { Step = s, Index = i }))
                {
                    var fi = footEntry.Index;
                    var footCompleted = _completed.Contains(fi);
                    var dotSpanClass = fi == _currentStep
                        ? "size-1 rounded-full bg-blue-500"
                        : "size-1 rounded-full bg-muted-foreground/25";

                    <span class="flex items-center">
                        @if (footCompleted)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                        }
                        else
                        {
                            <span class="@dotSpanClass"></span>
                        }
                    </span>
                }
            </div>

            @if (_currentStep < _steps.Length - 1)
            {
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs" OnClick="GoNext">
                    Next
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                </ButtonCn>
            }
            else
            {
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" OnClick="Publish">
                    Publish page
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record StepItemData(string Label, string Value);
    private record StepData(string Id, string Label, string IconName, string Title, string Description, StepItemData[] Items);

    private int _currentStep = 0;
    private HashSet<int> _completed = new();

    private double _progressPercent => ((double)(_currentStep + 1) / _steps.Length) * 100;

    private static readonly StepData[] _steps =
    [
        new("template", "Choose template", "layout-template", "Select a template",
            "Pick a starting point for your page.",
            [
                new("Selected template", "Marketing Landing"),
                new("Category", "Landing Pages"),
                new("Sections included", "Hero, Features, CTA, Footer"),
                new("Responsive", "Mobile + Desktop"),
                new("Color scheme", "Neutral / Monochrome"),
            ]),
        new("content", "Edit content", "pen-tool", "Edit your content",
            "Customize the text, images, and layout.",
            [
                new("Headline", "Ship faster with Acme"),
                new("Subheading", "The developer platform for modern teams"),
                new("CTA button", "Get started free"),
                new("Hero image", "dashboard-preview.webp"),
                new("Sections edited", "3 of 4"),
            ]),
        new("preview", "Preview", "file-text", "Preview your page",
            "Review how it looks across devices.",
            [
                new("Desktop", "1440px — Looks great"),
                new("Tablet", "768px — Looks great"),
                new("Mobile", "375px — Looks great"),
                new("Lighthouse score", "98 / 100"),
                new("Accessibility", "All checks passed"),
            ]),
        new("publish", "Publish", "globe", "Publish your page",
            "Make your page live on the web.",
            [
                new("Domain", "acme.com/launch"),
                new("SSL certificate", "Auto-provisioned"),
                new("CDN", "Global edge network"),
                new("Analytics", "Enabled"),
                new("SEO meta tags", "Title + description set"),
            ]),
    ];

    private void NavigateToDot(int index)
    {
        if (index <= _currentStep || _completed.Contains(index))
            _currentStep = index;
    }

    private void GoNext()
    {
        _completed.Add(_currentStep);
        if (_currentStep < _steps.Length - 1)
            _currentStep++;
    }

    private void GoPrev()
    {
        if (_currentStep > 0)
            _currentStep--;
    }

    private void Publish()
    {
        _completed.Add(_currentStep);
    }
}
