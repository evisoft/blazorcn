@* ============================================================
   Block: stepper-minimal-line
   Title: StepperMinimalLine
   Description: An ultra-minimal line stepper with tick marks, subtle labels, and maximum whitespace built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-minimal-line.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Setup</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @(_activeStep + 1) / @_steps.Length
            </span>
        </div>

        @* Minimal line with ticks *@
        <div class="border-b px-8 py-8">
            <div class="relative flex items-center justify-between">
                @* The line *@
                <div class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-muted-foreground/20"></div>
                @* Progress fill *@
                <div
                    class="absolute top-1/2 left-0 h-px -translate-y-1/2 bg-foreground/40 transition-all duration-500"
                    style="@GetProgressWidth()">
                </div>

                @* Tick marks *@
                @foreach (var stp in _steps)
                {
                    var idx = Array.IndexOf(_steps, stp);
                    var isCompleted = idx < _activeStep;
                    var isActive = idx == _activeStep;
                    var capturedIdx = idx;
                    <button
                        type="button"
                        @onclick="@(() => SetActiveStep(capturedIdx))"
                        class="group relative z-10 flex flex-col items-center gap-3">
                        @* Tick *@
                        <div class="@Cn.Merge("rounded-full transition-all duration-200", isActive ? "h-4 w-1.5 bg-blue-500 dark:bg-blue-400" : (isCompleted ? "h-2.5 w-1 bg-foreground/60" : "h-2 w-0.5 bg-muted-foreground/30"))"></div>
                        @* Label *@
                        <span class="@Cn.Merge("absolute top-full mt-3 whitespace-nowrap text-xs transition-colors", isActive ? "font-medium text-foreground" : (isCompleted ? "text-muted-foreground" : "text-muted-foreground/50"))">
                            @stp.Label
                        </span>
                    </button>
                }
            </div>
        </div>

        @* Content *@
        <div class="border-b px-6 py-6">
            <div class="mx-auto max-w-md">
                <span class="font-medium text-sm">@_steps[_activeStep].Heading</span>
                <p class="mt-2 text-muted-foreground text-sm leading-relaxed">
                    @_steps[_activeStep].Description
                </p>
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Finish" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Heading, string Description);

    private static readonly StepItem[] _steps =
    [
        new("Start", "Getting started",
            "Welcome to the setup process. We will walk you through each step to configure your workspace. This should only take a couple of minutes to complete."),
        new("Step 2", "Connect your account",
            "Link your existing accounts to enable seamless data synchronization. We support all major providers including Google, GitHub, and Slack for instant integration."),
        new("Step 3", "Set preferences",
            "Choose your default theme, notification frequency, and timezone. These settings apply across all your devices and can be adjusted anytime from the settings panel."),
        new("Step 4", "Invite your team",
            "Add team members by email to start collaborating. Each member gets their own workspace view with shared access to projects, documents, and real-time editing."),
        new("End", "All done",
            "Your workspace is fully configured and ready. Start creating your first project or explore the template gallery to find a starting point that fits your workflow."),
    ];

    private int _activeStep = 0;

    private string GetProgressWidth()
    {
        if (_activeStep == 0)
            return "width:0%";
        var pct = (_activeStep / (double)(_steps.Length - 1)) * 100.0;
        return $"width:{pct:0.##}%";
    }

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
            _activeStep++;
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
            _activeStep--;
    }

    private void SetActiveStep(int index)
    {
        _activeStep = index;
    }
}
