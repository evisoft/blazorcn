@* ============================================================
   Block: stepper-due-dates
   Title: StepperDueDates
   Description: A vertical stepper with due date labels, overdue indicators, and project timeline tracking built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-due-dates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Project timeline</span>
                @if (OverdueCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-xs">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        <span class="text-red-600 dark:text-red-400">@OverdueCount overdue</span>
                    </span>
                }
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Deadline: Apr 1</span>
            </div>
        </div>

        @* Steps *@
        <div class="px-4 py-4">
            @for (int i = 0; i < _steps.Length; i++)
            {
                var stp = _steps[i];
                var index = i;
                var isSelected = index == _selectedStep;
                var isLast = index == _steps.Length - 1;

                <div class="flex gap-4">
                    @* Circle + Line column *@
                    <div class="flex flex-col items-center">
                        <button
                            type="button" aria-label="@($"Step {index + 1}: {stp.Label}")"
                            @onclick="@(() => HandleStepClick(index))"
                            class="@Cn.Merge("flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-full font-medium text-xs tabular-nums transition-all duration-200", CircleClass(stp.Status))">
                            @if (stp.Status == StepStatus.Completed)
                            {
                                <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                            }
                            else if (stp.Status == StepStatus.Overdue)
                            {
                                <LucideIconCn Name="alert-circle" Size="14" Class="size-3.5" />
                            }
                            else
                            {
                                <span>@(index + 1)</span>
                            }
                        </button>

                        @if (!isLast)
                        {
                            <div
                                class="@Cn.Merge("my-1 w-0.5 flex-1 rounded-full transition-colors duration-300", LineClass(stp.Status))"
                                style="@GetLineStyle(isSelected)">
                            </div>
                        }
                    </div>

                    @* Content column *@
                    <div class="@(isLast ? "pb-0" : "pb-6")">
                        <div class="flex items-center gap-2 pt-1">
                            <span class="@Cn.Merge("font-medium text-sm", stp.Status == StepStatus.Upcoming ? "text-muted-foreground" : "text-foreground")">
                                @stp.Label
                            </span>

                            @* Due date / status badge *@
                            @if (stp.Status == StepStatus.Completed)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-emerald-600 text-xs dark:text-emerald-400">
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                    Done @stp.CompletedDate
                                </BadgeCn>
                            }
                            else if (stp.Status == StepStatus.Overdue)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 border-red-500/20 bg-red-500/10 font-normal text-red-600 text-xs dark:text-red-400">
                                    <LucideIconCn Name="alert-circle" Size="12" Class="size-3" />
                                    Overdue — due @stp.DueDate
                                </BadgeCn>
                            }
                            else
                            {
                                <span class="flex items-center gap-1 text-muted-foreground/60 text-xs">
                                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                    Due @stp.DueDate
                                </span>
                            }
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@stp.Description</p>

                        @* Expanded detail for selected step *@
                        @if (isSelected)
                        {
                            <div class="mt-3">
                                <div class="@Cn.Merge("rounded-md p-3", stp.Status == StepStatus.Overdue ? "bg-red-500/10" : "bg-muted/50")">
                                    <p class="text-sm leading-relaxed">@stp.Detail</p>
                                </div>
                                @if (stp.Status != StepStatus.Completed)
                                {
                                    <div class="mt-3">
                                        <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_selectedStep == _steps.Length - 1)" OnClick="HandleContinue">
                                            @(stp.Status == StepStatus.Overdue ? "Mark complete" : "View next")
                                            <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                                        </ButtonCn>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum StepStatus { Completed, Overdue, Active, Upcoming }

    private record StepItem(
        string Label,
        string Description,
        string DueDate,
        StepStatus Status,
        string? CompletedDate,
        string Detail
    );

    private static readonly StepItem[] _steps =
    [
        new("Requirements", "Gather specs and define scope", "Mar 15", StepStatus.Completed, "Mar 14",
            "All requirements documented and signed off. 12 user stories defined with acceptance criteria. Scope locked for v1 release."),
        new("Design", "UI/UX mockups and design system", "Mar 20", StepStatus.Completed, "Mar 19",
            "Figma designs finalized for all 8 screens. Design tokens exported. Component library specced with 24 components."),
        new("Development", "Build frontend and backend services", "Mar 25", StepStatus.Overdue, null,
            "API endpoints 90% complete. Frontend views for dashboard and settings done. Auth flow and billing integration still in progress."),
        new("Testing", "QA, integration, and load testing", "Mar 28", StepStatus.Upcoming, null,
            "Test plan prepared with 45 test cases. Staging environment configured. Load testing scripts ready for 1,000 concurrent users."),
        new("Launch", "Deploy to production and announce", "Apr 1", StepStatus.Upcoming, null,
            "Deployment checklist finalized. DNS and SSL pre-configured. Launch announcement drafted for blog and social channels."),
    ];

    private int _selectedStep = 2;

    private int OverdueCount => Array.FindAll(_steps, s => s.Status == StepStatus.Overdue).Length;

    private static string GetLineStyle(bool isSelected) =>
        isSelected ? "min-height:100px" : "min-height:24px";

    private static string CircleClass(StepStatus status) => status switch
    {
        StepStatus.Completed => "bg-emerald-500 text-white dark:bg-emerald-600",
        StepStatus.Overdue   => "bg-red-500 text-white dark:bg-red-600",
        StepStatus.Active    => "bg-blue-500 text-white ring-4 ring-blue-500/20 dark:bg-blue-600 dark:ring-blue-400/20",
        StepStatus.Upcoming  => "border border-muted-foreground/25 text-muted-foreground",
        _                    => ""
    };

    private static string LineClass(StepStatus status) => status switch
    {
        StepStatus.Completed => "bg-emerald-500 dark:bg-emerald-600",
        StepStatus.Overdue   => "bg-red-500/40",
        _                    => "bg-muted-foreground/15"
    };

    private void HandleStepClick(int index)
    {
        _selectedStep = index;
    }

    private void HandleContinue()
    {
        if (_selectedStep < _steps.Length - 1)
        {
            _selectedStep++;
        }
    }
}
