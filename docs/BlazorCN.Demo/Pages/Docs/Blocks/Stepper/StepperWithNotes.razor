@* ============================================================
   Block: stepper-with-notes
   Title: StepperWithNotes
   Description: A vertical stepper with expandable team notes and comment counts per step built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-with-notes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Project workflow</span>
            <div class="flex items-center gap-2">
                <LucideIconCn Name="message-square" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs tabular-nums">@_totalNotes notes</span>
            </div>
        </div>

        @* Steps *@
        <div>
            @foreach (var stepEntry in _steps.Select((s, i) => new { Step = s, Index = i }))
            {
                var idx = stepEntry.Index;
                var step = stepEntry.Step;
                var isCompleted = step.Status == "completed";
                var isActive = step.Status == "active";
                var isExpanded = _expandedStep == idx;
                var isLast = idx == _steps.Length - 1;
                var noteCount = step.Notes.Length;

                <div class="@(isLast ? "" : "border-b")">
                    @* Step row *@
                    <button
                        type="button"
                        @onclick="@(() => ToggleStep(idx))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">

                        @* Status circle *@
                        <div class="flex size-7 shrink-0 items-center justify-center">
                            @if (isCompleted)
                            {
                                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500 dark:bg-emerald-600">
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-white" />
                                </div>
                            }
                            else if (isActive)
                            {
                                <div class="flex size-6 items-center justify-center rounded-full border-2 border-blue-500 bg-blue-500/10 dark:border-blue-400 dark:bg-blue-400/10">
                                    <span class="font-medium text-blue-600 text-xs tabular-nums dark:text-blue-400">@(idx + 1)</span>
                                </div>
                            }
                            else
                            {
                                <div class="flex size-6 items-center justify-center rounded-full border border-muted-foreground/20">
                                    <span class="text-muted-foreground text-xs tabular-nums">@(idx + 1)</span>
                                </div>
                            }
                        </div>

                        @* Label + description *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", step.Status == "upcoming" ? "text-muted-foreground" : "text-foreground")">
                                    @step.Label
                                </span>
                                @if (noteCount > 0)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                                        <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                        @noteCount
                                    </BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>
                        </div>

                        @* Chevron *@
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @* Expanded notes *@
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-14">
                            @if (noteCount > 0)
                            {
                                <div class="space-y-2">
                                    @foreach (var note in step.Notes)
                                    {
                                        <div class="rounded-md bg-muted/50 p-3">
                                            <div class="mb-1.5 flex items-center gap-2">
                                                <span class="@Cn.Merge("flex size-5 shrink-0 items-center justify-center rounded-full text-[10px] font-medium", InitialsColor(note.Initials))">
                                                    @note.Initials
                                                </span>
                                                <span class="font-medium text-xs">@note.Author</span>
                                                <span class="text-muted-foreground text-xs">@note.Time</span>
                                            </div>
                                            <p class="text-sm leading-relaxed">@note.Text</p>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="rounded-md bg-muted/50 p-3">
                                    <p class="text-muted-foreground text-sm">
                                        No notes yet. Notes will appear here as team members add them.
                                    </p>
                                </div>
                            }
                            <div class="mt-3">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                                    <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                    Add note
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record NoteItem(string Id, string Author, string Initials, string Text, string Time);
    private record StepItem(string Label, string Description, string Status, NoteItem[] Notes);

    private int _expandedStep = 2;

    private static readonly StepItem[] _steps =
    [
        new("Kickoff", "Define project scope, goals, and timeline", "completed",
        [
            new("n1", "Sarah Kim", "SK", "Confirmed Q2 deadline with stakeholders. Budget approved for the full scope including external audit.", "5 days ago"),
            new("n2", "Alex Chen", "AC", "Added risk assessment document to the shared drive. Three high-priority risks identified.", "4 days ago"),
            new("n3", "Jordan Lee", "JL", "Team availability confirmed. Marcus will join part-time starting next week after his current sprint wraps up.", "3 days ago"),
        ]),
        new("Design review", "Review wireframes, prototypes, and design specs", "completed",
        [
            new("n4", "Taylor Reeves", "TR", "Figma prototype updated with the new navigation flow. Please review the mobile breakpoints.", "2 days ago"),
            new("n5", "Sarah Kim", "SK", "Accessibility review passed. Color contrast ratios meet WCAG AA. One minor spacing issue on the settings page.", "1 day ago"),
        ]),
        new("Implementation", "Build features, integrate APIs, and write tests", "active",
        [
            new("n6", "Alex Chen", "AC", "API endpoints for user management are live on staging. Auth middleware needs one more round of testing before we connect the frontend.", "3 hours ago"),
        ]),
        new("QA testing", "End-to-end testing, regression, and performance checks", "upcoming", []),
    ];

    private int _totalNotes => _steps.Sum(s => s.Notes.Length);

    private static string InitialsColor(string initials) => initials switch
    {
        "SK" => "bg-blue-500/15 text-blue-700 dark:bg-blue-400/15 dark:text-blue-300",
        "AC" => "bg-emerald-500/15 text-emerald-700 dark:bg-emerald-400/15 dark:text-emerald-300",
        "JL" => "bg-amber-500/15 text-amber-700 dark:bg-amber-400/15 dark:text-amber-300",
        "TR" => "bg-purple-500/15 text-purple-700 dark:bg-purple-400/15 dark:text-purple-300",
        _ => "bg-muted text-muted-foreground",
    };

    private void ToggleStep(int index)
    {
        _expandedStep = _expandedStep == index ? -1 : index;
    }
}
