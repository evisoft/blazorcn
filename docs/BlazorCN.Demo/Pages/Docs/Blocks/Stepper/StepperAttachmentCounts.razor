@* ============================================================
   Block: stepper-attachment-counts
   Title: StepperAttachmentCounts
   Description: A vertical stepper with file attachment indicators, file type labels, and upload areas per step built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-attachment-counts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Document workflow</span>
            <div class="flex items-center gap-2">
                <LucideIconCn Name="paperclip" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_totalFiles files attached
                </span>
            </div>
        </div>

        @* Steps *@
        <div>
            @foreach (var stepEntry in _steps.Select((s, i) => new { Step = s, Index = i }))
            {
                var idx = stepEntry.Index;
                var step = stepEntry.Step;
                var isCompleted = step.Status == "completed";
                var isActive = step.Status == "active";
                var isExpanded = _expandedStep == idx;
                var isLast = idx == _steps.Length - 1;
                var fileCount = step.Files.Length;

                <div class="@(isLast ? "" : "border-b")">
                    @* Step row *@
                    <button
                        type="button"
                        @onclick="@(() => ToggleStep(idx))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">

                        @* Status circle *@
                        <div class="flex size-7 shrink-0 items-center justify-center">
                            @if (isCompleted)
                            {
                                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500 dark:bg-emerald-600">
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-white" />
                                </div>
                            }
                            else if (isActive)
                            {
                                <div class="flex size-6 items-center justify-center rounded-full border-2 border-blue-500 bg-blue-500/10 dark:border-blue-400 dark:bg-blue-400/10">
                                    <span class="font-medium text-blue-600 text-xs tabular-nums dark:text-blue-400">@(idx + 1)</span>
                                </div>
                            }
                            else
                            {
                                <div class="flex size-6 items-center justify-center rounded-full border border-muted-foreground/20">
                                    <span class="text-muted-foreground text-xs tabular-nums">@(idx + 1)</span>
                                </div>
                            }
                        </div>

                        @* Label + description *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", step.Status == "upcoming" ? "text-muted-foreground" : "text-foreground")">
                                    @step.Label
                                </span>
                                @if (fileCount > 0)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                                        <LucideIconCn Name="paperclip" Size="12" Class="size-3" />
                                        @fileCount
                                    </BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>
                        </div>

                        @* Chevron *@
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @* Expanded file list *@
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-14">
                            @if (fileCount > 0)
                            {
                                <div class="space-y-1.5">
                                    @foreach (var file in step.Files)
                                    {
                                        var cfg = GetFileTypeConfig(file.FileType);
                                        <div class="flex items-center gap-3 rounded-md bg-muted/50 px-3 py-2.5">
                                            <LucideIconCn Name="@cfg.IconName" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                            <div class="min-w-0 flex-1">
                                                <span class="truncate font-mono text-sm">@file.Name</span>
                                            </div>
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-normal text-[10px]", cfg.Color)">
                                                @cfg.Label
                                            </BadgeCn>
                                            <span class="shrink-0 text-muted-foreground text-xs tabular-nums">@file.Size</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="rounded-md border border-dashed border-muted-foreground/20 p-4">
                                    <div class="flex flex-col items-center gap-2 text-center">
                                        <LucideIconCn Name="upload" Size="20" Class="size-5 text-muted-foreground/50" />
                                        <p class="text-muted-foreground text-xs">No files attached yet</p>
                                    </div>
                                </div>
                            }
                            <div class="mt-3">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                                    <LucideIconCn Name="upload" Size="12" Class="size-3" />
                                    Upload file
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Attachment(string Name, string FileType, string Size);
    private record StepItem(string Label, string Description, string Status, Attachment[] Files);

    private record FileTypeConfig(string Label, string Color, string IconName);

    private int _expandedStep = 2;

    private static readonly StepItem[] _steps =
    [
        new("Brief", "Upload project brief and scope documents", "completed",
        [
            new("project-brief.pdf", "pdf", "2.4 MB"),
            new("scope-of-work.docx", "docx", "186 KB"),
        ]),
        new("Deliverables", "Submit design files and assets for review", "completed",
        [
            new("homepage-final.fig", "fig", "12.8 MB"),
            new("hero-banner.png", "png", "3.1 MB"),
            new("component-specs.xlsx", "xlsx", "420 KB"),
        ]),
        new("Review", "Stakeholder review with annotated feedback", "active",
        [
            new("review-notes.pdf", "pdf", "540 KB"),
        ]),
        new("Sign-off", "Final approval signatures and sign-off documents", "upcoming",
        []),
    ];

    private int _totalFiles => _steps.Sum(s => s.Files.Length);

    private static FileTypeConfig GetFileTypeConfig(string fileType) => fileType switch
    {
        "pdf"  => new("PDF",  "bg-red-500/10 text-red-700 dark:text-red-300",     "file-text"),
        "docx" => new("DOCX", "bg-blue-500/10 text-blue-700 dark:text-blue-300",   "file-text"),
        "png"  => new("PNG",  "bg-emerald-500/10 text-emerald-700 dark:text-emerald-300", "image"),
        "xlsx" => new("XLSX", "bg-green-500/10 text-green-700 dark:text-green-300", "file"),
        "fig"  => new("FIG",  "bg-purple-500/10 text-purple-700 dark:text-purple-300", "file"),
        _      => new(fileType.ToUpperInvariant(), "", "file"),
    };

    private void ToggleStep(int index)
    {
        _expandedStep = _expandedStep == index ? -1 : index;
    }
}
