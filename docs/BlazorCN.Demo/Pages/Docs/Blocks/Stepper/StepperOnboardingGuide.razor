@* ============================================================
   Block: stepper-onboarding-guide
   Title: StepperOnboardingGuide
   Description: A friendly app onboarding wizard stepper with horizontal dot progress, illustration placeholders, step descriptions, and skip/continue navigation built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-onboarding-guide.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">@_current.Title</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                Step @(_activeStep + 1) of @_steps.Length
            </BadgeCn>
        </div>

        @* Dot progress *@
        <div class="flex items-center justify-center gap-2 border-b px-4 py-3">
            @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
            {
                var idx = entry.Index;
                var isCompleted = idx < _activeStep;
                var isActive = idx == _activeStep;

                var dotClass = Cn.Merge(
                    "shrink-0 rounded-full transition-all duration-300",
                    isActive
                        ? "h-2.5 w-8 bg-foreground"
                        : isCompleted
                            ? "size-2.5 cursor-pointer bg-emerald-500 hover:bg-emerald-600 dark:bg-emerald-400 dark:hover:bg-emerald-300"
                            : "size-2 cursor-default bg-muted-foreground/25");

                <button
                    type="button" aria-label="@($"Step {idx + 1}: {entry.Step.Title}")"
                    @onclick="@(() => HandleDotClick(idx))"
                    disabled="@(idx > _activeStep)"
                    class="@dotClass">
                </button>
            }
        </div>

        @* Step content *@
        <div class="border-b px-6 py-6">
            @* Illustration placeholder *@
            <div class="mx-auto mb-5 flex h-32 max-w-sm items-center justify-center rounded-lg bg-muted/50">
                <LucideIconCn Name="@_current.IconName" Size="24" Class="size-6 text-muted-foreground/60" />
            </div>

            @* Text content *@
            <div class="mx-auto max-w-sm text-center">
                <h3 class="font-medium text-base">@_current.Heading</h3>
                <p class="mt-2 text-muted-foreground text-sm leading-relaxed">
                    @_current.Description
                </p>
            </div>

            @* Action + skip buttons *@
            <div class="mx-auto mt-5 flex max-w-sm flex-col items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext">
                    @_current.Action
                    <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5" />
                </ButtonCn>
                @if (_current.Skippable)
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-muted-foreground text-xs" OnClick="HandleNext">
                        <LucideIconCn Name="skip-forward" Size="12" Class="size-3" />
                        Skip for now
                    </ButtonCn>
                }
            </div>
        </div>

        @* Footer navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(_activeStep == 0)" OnClick="HandleBack">
                Back
            </ButtonCn>
            <span class="text-muted-foreground/60 text-xs">
                @(_activeStep < _steps.Length - 1
                    ? $"{_steps.Length - _activeStep - 1} steps remaining"
                    : "Setup complete")
            </span>
        </div>
    </div>
</section>

@code {
    private record OnboardingStep(string Title, string Heading, string Description, string Action, bool Skippable, string IconName);

    private int _activeStep = 0;

    private static readonly OnboardingStep[] _steps =
    [
        new("Welcome",
            "Welcome to Meridian",
            "Your new workspace is ready. This quick setup takes less than 2 minutes and helps us tailor the experience to your team. You can always change these settings later.",
            "Get started",
            false,
            "sparkles"),
        new("Integrations",
            "Connect your tools",
            "Link your existing tools to keep everything in sync. We support Slack for notifications, GitHub for code changes, Linear for issue tracking, and Figma for design handoffs.",
            "Connect tools",
            true,
            "link"),
        new("Team",
            "Invite your team",
            "Collaboration works best with your whole team onboard. Send email invites or share a link. Team members get access to shared projects, real-time editing, and comment threads.",
            "Send invites",
            true,
            "users"),
        new("Ready",
            "You're all set!",
            "Your workspace is configured and ready to go. Start by creating your first project from the dashboard, or explore the template gallery for pre-built starting points tailored to your workflow.",
            "Go to dashboard",
            false,
            "party-popper"),
    ];

    private OnboardingStep _current => _steps[_activeStep];

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleDotClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
