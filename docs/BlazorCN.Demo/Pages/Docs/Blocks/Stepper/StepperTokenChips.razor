@* ============================================================
   Block: stepper-token-chips
   Title: StepperTokenChips
   Description: A chip-based stepper with clickable rounded pill tokens, color-coded states, and inline status built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-token-chips.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Data pipeline</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                Step @(_activeStep + 1) of @(_steps.Length)
            </BadgeCn>
        </div>

        @* Token chips row *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap items-center gap-1.5">
                @for (var index = 0; index < _steps.Length; index++)
                {
                    var i = index;
                    var step = _steps[i];
                    var isCompleted = i < _activeStep;
                    var isActive = i == _activeStep;
                    <button
                        type="button"
                        @onclick="@(() => _activeStep = i)"
                        class="@Cn.Merge("flex shrink-0 items-center gap-1 rounded-full px-3 py-1 text-xs transition-all duration-200", isActive ? "bg-blue-500 font-medium text-white shadow-sm dark:bg-blue-600" : isCompleted ? "border border-emerald-500/40 bg-emerald-500/5 text-emerald-600 hover:bg-emerald-500/10 dark:border-emerald-400/30 dark:text-emerald-400" : "bg-muted/60 text-muted-foreground hover:bg-muted")">
                        @if (isCompleted)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3 shrink-0" />
                        }
                        @step.Label
                    </button>
                }
            </div>
        </div>

        @* Content *@
        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_steps[_activeStep].Heading</span>
                </div>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                    @_steps[_activeStep].Description
                </p>
            </div>

            @* Stats *@
            <div class="space-y-2">
                @foreach (var stat in _steps[_activeStep].Stats)
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                        <span class="font-medium text-muted-foreground text-xs">@stat.Label</span>
                        <span class="font-mono text-sm">@stat.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Complete" : "Next")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepStat(string Label, string Value);
    private record StepDef(string Label, string Heading, string Description, StepStat[] Stats);

    private static readonly StepDef[] _steps =
    [
        new("Source", "Data source",
            "Connect to your data source. We support PostgreSQL, MySQL, MongoDB, REST APIs, and CSV file uploads. Connections are tested automatically after configuration.",
            [
                new("Type", "PostgreSQL"),
                new("Host", "db.acme.io:5432"),
                new("Tables", "24 detected"),
            ]),
        new("Transform", "Transform rules",
            "Define how your data should be cleaned and transformed. Map source columns to target fields, apply type conversions, and set default values for missing entries.",
            [
                new("Mappings", "18 fields"),
                new("Conversions", "3 type casts"),
                new("Defaults", "5 fallback values"),
            ]),
        new("Validate", "Validation checks",
            "Run validation rules against your transformed data. Check for required fields, unique constraints, format patterns, and referential integrity before loading.",
            [
                new("Rules", "12 active"),
                new("Sample rows", "1,000 tested"),
                new("Pass rate", "99.2%"),
            ]),
        new("Load", "Load to destination",
            "Configure the target destination and loading strategy. Choose between full replace, incremental append, or merge-on-key for each sync run.",
            [
                new("Destination", "Warehouse (BigQuery)"),
                new("Strategy", "Merge on primary key"),
                new("Schedule", "Every 6 hours"),
            ]),
        new("Verify", "Post-load verification",
            "Verify the loaded data matches expectations. Row counts are compared between source and destination, checksums validated, and sample queries executed.",
            [
                new("Row count", "142,847 rows"),
                new("Checksum", "Match confirmed"),
                new("Query tests", "8 passed"),
            ]),
    ];

    private int _activeStep = 2;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
            _activeStep++;
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
            _activeStep--;
    }
}
