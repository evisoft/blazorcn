@* ============================================================
   Block: stepper-percentage-display
   Title: StepperPercentageDisplay
   Description: A data migration stepper with large percentage indicator, full-width progress bar, step details, and navigation controls built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-percentage-display.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with percentage *@
        <div class="flex items-start justify-between border-b px-4 py-4">
            <div class="flex items-baseline gap-3">
                <span class="font-semibold text-4xl tabular-nums">@Percentage%</span>
                <div class="flex flex-col">
                    <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
                    <span class="text-muted-foreground text-xs">
                        Step @(_activeStep + 1) of @_steps.Length
                    </span>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @(_activeStep == _steps.Length - 1 ? "Complete" : _activeStep == 0 ? "Not started" : "In progress")
            </BadgeCn>
        </div>

        @* Progress bar *@
        <div class="h-1 w-full bg-muted">
            <div
                class="h-full bg-blue-500 transition-all duration-500 ease-out dark:bg-blue-400"
                style="@($"width:{Percentage}%")"
            ></div>
        </div>

        @* Step list *@
        <div class="border-b">
            @for (var i = 0; i < _steps.Length; i++)
            {
                var idx = i;
                var stp = _steps[i];
                var isCompleted = idx < _activeStep;
                var isActive = idx == _activeStep;
                var isLast = idx == _steps.Length - 1;
                <button
                    type="button"
                    @onclick="@(() => HandleStepClick(idx))"
                    class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors", isActive ? "bg-muted/50" : "hover:bg-muted/30", !isLast ? "border-b" : "", idx > _activeStep ? "cursor-default" : "cursor-pointer")">
                    <span class="@Cn.Merge("flex size-6 shrink-0 items-center justify-center rounded-full text-xs", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-blue-500 text-white dark:bg-blue-600" : "border border-muted-foreground/25 text-muted-foreground")">
                        @if (isCompleted)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                        }
                        else
                        {
                            <span class="tabular-nums">@(idx + 1)</span>
                        }
                    </span>
                    <div class="min-w-0 flex-1">
                        <span class="@Cn.Merge("text-xs", isActive ? "font-medium text-foreground" : isCompleted ? "text-foreground" : "text-muted-foreground")">
                            @stp.Label
                        </span>
                    </div>
                    @if (isCompleted)
                    {
                        <span class="text-emerald-600 text-xs dark:text-emerald-400">Done</span>
                    }
                    @if (isActive)
                    {
                        <span class="size-1.5 rounded-full bg-blue-500 dark:bg-blue-400"></span>
                    }
                </button>
            }
        </div>

        @* Active step content *@
        <div class="border-b px-4 py-4">
            <p class="mb-3 text-muted-foreground text-sm leading-relaxed">@_steps[_activeStep].Detail</p>
            <div class="grid grid-cols-3 gap-3">
                @foreach (var stat in _steps[_activeStep].Stats)
                {
                    <div class="rounded-md bg-muted/50 p-2.5">
                        <span class="block font-semibold text-sm tabular-nums">@stat.Value</span>
                        <span class="text-muted-foreground text-xs">@stat.Label</span>
                    </div>
                }
            </div>
        </div>

        @* Footer navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Finish" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepStat(string Label, string Value);
    private record StepItem(string Label, string Description, string IconName, string Detail, StepStat[] Stats);

    private static readonly StepItem[] _steps =
    [
        new("Data import",
            "Connect and import source data",
            "database",
            "Connect to your source database and select the tables and schemas to migrate. We support PostgreSQL, MySQL, MongoDB, and CSV imports.",
            [
                new("Tables selected", "24"),
                new("Total rows", "1.2M"),
                new("Estimated size", "840 MB"),
            ]),
        new("Field mapping",
            "Map source fields to destination schema",
            "arrow-right-left",
            "Review the auto-detected field mappings between source and destination schemas. Adjust data types, rename columns, and configure transformations.",
            [
                new("Auto-mapped", "186"),
                new("Needs review", "12"),
                new("Unmapped", "3"),
            ]),
        new("Validation",
            "Run pre-migration data checks",
            "search-check",
            "Execute validation rules against your data to catch issues before migration. Checks include type compatibility, constraint violations, and referential integrity.",
            [
                new("Rules passed", "48"),
                new("Warnings", "5"),
                new("Errors", "0"),
            ]),
        new("Migration",
            "Execute the data migration",
            "git-merge",
            "Run the migration with automatic batching, retry logic, and progress tracking. Data is transferred in parallel streams with checkpointing for fault tolerance.",
            [
                new("Batch size", "10,000"),
                new("Parallelism", "4x"),
                new("Est. duration", "12 min"),
            ]),
        new("Verification",
            "Verify data integrity post-migration",
            "shield-check",
            "Compare row counts, checksums, and sample records between source and destination. Generate a verification report with detailed pass/fail status for each table.",
            [
                new("Tables verified", "24"),
                new("Row match", "100%"),
                new("Checksum", "Passed"),
            ]),
    ];

    private int _activeStep = 1;

    private int Percentage => (int)Math.Round((double)_activeStep / (_steps.Length - 1) * 100);

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
