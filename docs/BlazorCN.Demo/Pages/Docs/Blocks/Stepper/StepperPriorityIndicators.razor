@* ============================================================
   Block: stepper-priority-indicators
   Title: StepperPriorityIndicators
   Description: A vertical stepper with color-coded priority dots and labels showing critical, high, medium, and low urgency per step built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-priority-indicators.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Release pipeline</span>
            <div class="flex items-center gap-3">
                @foreach (var p in _priorities)
                {
                    var cfg = GetPriorityConfig(p);
                    var cnt = _steps.Count(s => s.Priority == p);
                    @if (cnt > 0)
                    {
                        <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                            <span class="@Cn.Merge("size-1.5 rounded-full", cfg.Dot)"></span>
                            @cnt
                        </span>
                    }
                }
            </div>
        </div>

        @* Priority legend *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            @foreach (var p in _priorities)
            {
                var cfg = GetPriorityConfig(p);
                <span class="flex items-center gap-1.5">
                    <span class="@Cn.Merge("size-2 rounded-full", cfg.Dot, cfg.Ring)"></span>
                    <span class="@Cn.Merge("text-xs", cfg.Text)">@cfg.Label</span>
                </span>
            }
        </div>

        @* Steps *@
        <div>
            @foreach (var stepEntry in _steps.Select((s, i) => new { Step = s, Index = i }))
            {
                var idx = stepEntry.Index;
                var step = stepEntry.Step;
                var isCompleted = step.Status == "completed";
                var isActive = step.Status == "active";
                var isSelected = _selectedStep == idx;
                var isLast = idx == _steps.Length - 1;
                var cfg = GetPriorityConfig(step.Priority);

                <div class="@(isLast ? "" : "border-b")">
                    @* Step row *@
                    <button
                        type="button"
                        @onclick="@(() => ToggleStep(idx))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">

                        @* Status circle *@
                        <div class="flex size-7 shrink-0 items-center justify-center">
                            @if (isCompleted)
                            {
                                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500 dark:bg-emerald-600">
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-white" />
                                </div>
                            }
                            else if (isActive)
                            {
                                <div class="flex size-6 items-center justify-center rounded-full border-2 border-blue-500 bg-blue-500/10 dark:border-blue-400 dark:bg-blue-400/10">
                                    <span class="font-medium text-blue-600 text-xs tabular-nums dark:text-blue-400">@(idx + 1)</span>
                                </div>
                            }
                            else
                            {
                                <div class="flex size-6 items-center justify-center rounded-full border border-muted-foreground/20">
                                    <span class="text-muted-foreground text-xs tabular-nums">@(idx + 1)</span>
                                </div>
                            }
                        </div>

                        @* Label + description + priority *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", step.Status == "upcoming" ? "text-muted-foreground" : "text-foreground")">
                                    @step.Label
                                </span>
                                <span class="flex items-center gap-1.5">
                                    <span class="@Cn.Merge("size-2 rounded-full", cfg.Dot, cfg.Ring)"></span>
                                    <span class="@Cn.Merge("text-xs", cfg.Text)">@cfg.Label</span>
                                </span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>
                        </div>

                        @* Chevron *@
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isSelected ? "rotate-90" : "")" />
                    </button>

                    @* Expanded detail *@
                    @if (isSelected)
                    {
                        <div class="px-4 pb-4 pl-14">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="mb-2 flex items-center gap-2">
                                    <span class="@Cn.Merge("font-medium text-xs", cfg.Text)">
                                        @cfg.Label priority
                                    </span>
                                    @if (isCompleted)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Resolved</BadgeCn>
                                    }
                                    @if (isActive)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">In progress</BadgeCn>
                                    }
                                </div>
                                <p class="text-sm leading-relaxed">@step.Detail</p>
                            </div>
                            @if (isActive)
                            {
                                <div class="mt-3 flex items-center gap-2">
                                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                                        Mark complete
                                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                                        Reassign
                                    </ButtonCn>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Description, string Priority, string Status, string Detail);
    private record PriorityConfig(string Label, string Dot, string Text, string Ring);

    private int _selectedStep = 1;

    private static readonly string[] _priorities = ["critical", "high", "medium", "low"];

    private static readonly StepItem[] _steps =
    [
        new("Security patch", "Apply CVE-2026-4821 fix to authentication module", "critical", "completed",
            "Patched the authentication bypass vulnerability in the OAuth2 flow. Updated bcrypt to v5.1.1 and rotated all affected API keys. Penetration test confirmed the fix."),
        new("API migration", "Migrate from REST v2 to v3 with breaking changes", "high", "active",
            "Deprecation notices sent to all API consumers. 14 of 23 endpoints migrated. Rate limiting updated for the new schema. Client SDKs need one more release cycle."),
        new("UI refresh", "Update component library to the latest design tokens", "medium", "upcoming",
            "Swap to the new color palette and spacing scale. Update 42 components to use CSS variables instead of hardcoded values. Regression test all critical user flows."),
        new("Documentation", "Update API docs and developer guides for v3", "low", "upcoming",
            "Rewrite the getting started guide, add migration examples for each breaking change, and update the OpenAPI spec with the new endpoint schemas."),
        new("Code cleanup", "Remove deprecated helpers and unused dependencies", "low", "upcoming",
            "Remove 8 deprecated utility functions, 3 unused npm packages, and clean up 12 TODO comments. Run dead code analysis and update the bundle size report."),
    ];

    private static PriorityConfig GetPriorityConfig(string priority) => priority switch
    {
        "critical" => new("Critical", "bg-red-500",             "text-red-700 dark:text-red-300",     "animate-pulse"),
        "high"     => new("High",     "bg-amber-500",           "text-amber-700 dark:text-amber-300", ""),
        "medium"   => new("Medium",   "bg-blue-500",            "text-blue-700 dark:text-blue-300",   ""),
        "low"      => new("Low",      "bg-muted-foreground/40", "text-muted-foreground",              ""),
        _          => new(priority,   "",                       "",                                   ""),
    };

    private void ToggleStep(int index)
    {
        _selectedStep = _selectedStep == index ? -1 : index;
    }
}
