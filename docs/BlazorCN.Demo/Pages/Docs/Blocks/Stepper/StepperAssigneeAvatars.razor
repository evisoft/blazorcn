@* ============================================================
   Block: stepper-assignee-avatars
   Title: StepperAssigneeAvatars
   Description: A horizontal stepper with assignee avatar circles, overlapping avatar groups, and colored rings for step status built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-assignee-avatars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Sprint workflow</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Step <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Stepper with avatars *@
        <div class="border-b px-6 py-6">
            <div class="flex items-start">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var isCompleted = index < _activeStep;
                    var isActive = index == _activeStep;
                    var isUpcoming = index > _activeStep;
                    <div class="flex flex-1 items-start last:flex-none">
                        <div class="flex flex-col items-center gap-2.5">
                            @* Step circle *@
                            <button
                                type="button" aria-label="@($"Step {index + 1}: {stp.Label}")"
                                @onclick="@(() => HandleStepClick(index))"
                                disabled="@isUpcoming"
                                class="@Cn.Merge("flex size-9 shrink-0 items-center justify-center rounded-full font-medium text-sm tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600 cursor-pointer" : isActive ? "ring-2 ring-blue-500 ring-offset-2 ring-offset-card bg-blue-500 text-white dark:bg-blue-600 dark:ring-blue-400 cursor-pointer" : "border-2 border-muted-foreground/25 text-muted-foreground cursor-default")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="size-4" />
                                }
                                else
                                {
                                    <span>@(index + 1)</span>
                                }
                            </button>

                            @* Step label *@
                            <span class="@Cn.Merge("font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                @stp.Label
                            </span>

                            @* Assignee avatars *@
                            <div class="flex items-center -space-x-2">
                                @foreach (var assignee in stp.Assignees)
                                {
                                    <div
                                        class="@Cn.Merge("flex size-7 items-center justify-center rounded-full font-medium text-[10px] ring-2 ring-card transition-all duration-200", assignee.Color, isCompleted ? "ring-emerald-500/30" : isActive ? "ring-blue-500/30" : "")"
                                        title="@assignee.Name">
                                        @assignee.Initials
                                    </div>
                                }
                            </div>

                            @* Assignee name(s) *@
                            <span class="max-w-[100px] text-center text-[11px] text-muted-foreground leading-tight">
                                @string.Join(", ", stp.Assignees.Select(a => a.Name.Split(' ')[0]))
                            </span>
                        </div>

                        @* Connecting line *@
                        @if (index < _steps.Length - 1)
                        {
                            <div class="mx-2 mt-[18px] h-0.5 flex-1">
                                <div class="@Cn.Merge("h-full rounded-full transition-colors duration-300", index < _activeStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Step detail *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <div>
                    <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_steps[_activeStep].Description
                    </p>
                </div>
                <div class="flex items-center gap-1">
                    @foreach (var a in _steps[_activeStep].Assignees)
                    {
                        <div class="@Cn.Merge("flex size-6 items-center justify-center rounded-full font-medium text-[10px]", a.Color)">
                            @a.Initials
                        </div>
                    }
                </div>
            </div>

            @* Task list *@
            <div class="space-y-1.5">
                @foreach (var task in _stepDetails[_activeStep].Tasks)
                {
                    <div class="flex items-center gap-3 rounded-md bg-muted/50 px-3 py-2.5">
                        <div class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded border transition-colors", task.Done ? "border-emerald-500 bg-emerald-500 dark:border-emerald-600 dark:bg-emerald-600" : "border-muted-foreground/30")">
                            @if (task.Done)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-white" />
                            }
                        </div>
                        <span class="@Cn.Merge("text-sm", task.Done ? "text-muted-foreground line-through" : "text-foreground")">
                            @task.Label
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Complete" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Assignee(string Initials, string Name, string Color);
    private record StepItem(string Label, string Description, Assignee[] Assignees);
    private record TaskItem(string Label, bool Done);
    private record StepDetail(TaskItem[] Tasks);

    private static readonly StepItem[] _steps =
    [
        new("Research", "Market analysis and user interviews",
        [
            new("SK", "Sarah Kim", "bg-violet-100 text-violet-700 dark:bg-violet-900/50 dark:text-violet-300"),
        ]),
        new("Design", "Wireframes and visual design",
        [
            new("AW", "Alex Wu", "bg-sky-100 text-sky-700 dark:bg-sky-900/50 dark:text-sky-300"),
        ]),
        new("Build", "Frontend and backend development",
        [
            new("ML", "Marcus Lee", "bg-amber-100 text-amber-700 dark:bg-amber-900/50 dark:text-amber-300"),
            new("PR", "Priya Rao", "bg-rose-100 text-rose-700 dark:bg-rose-900/50 dark:text-rose-300"),
        ]),
        new("Ship", "Deploy and announce launch",
        [
            new("SK", "Sarah Kim", "bg-violet-100 text-violet-700 dark:bg-violet-900/50 dark:text-violet-300"),
        ]),
    ];

    private static readonly StepDetail[] _stepDetails =
    [
        new([
            new("Competitor analysis document", true),
            new("User interview synthesis", true),
            new("Market sizing report", true),
        ]),
        new([
            new("Low-fidelity wireframes", true),
            new("High-fidelity mockups", false),
            new("Design system tokens", false),
        ]),
        new([
            new("API endpoints", false),
            new("Frontend components", false),
            new("Database schema", false),
        ]),
        new([
            new("Staging deployment", false),
            new("Production deploy", false),
            new("Launch blog post", false),
        ]),
    ];

    private int _activeStep = 1;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
