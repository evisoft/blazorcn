@* ============================================================
   Block: stepper-file-upload-flow
   Title: StepperFileUploadFlow
   Description: A multi-step file upload wizard with drag-drop zone, file preview grid, configuration options, and upload progress bars built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-file-upload-flow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Upload files</span>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">
                    <span class="tabular-nums">@_files.Length</span> files
                </span>
                <span class="text-muted-foreground text-xs">&middot;</span>
                <span class="font-mono text-muted-foreground text-xs">@_totalSize</span>
            </div>
        </div>

        @* Step indicators *@
        <div class="border-b px-6 py-5">
            <div class="flex items-center">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var isCompleted = index < _activeStep;
                    var isActive = index == _activeStep;
                    var isUpcoming = index > _activeStep;
                    <div class="flex flex-1 items-center last:flex-none">
                        <div class="flex flex-col items-center gap-1.5">
                            <button
                                type="button" aria-label="@($"Step {index + 1}: {stp.Label}")"
                                @onclick="@(() => HandleStepClick(index))"
                                disabled="@isUpcoming"
                                class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full transition-all duration-200", isCompleted ? "bg-emerald-500 text-white cursor-pointer dark:bg-emerald-600" : isActive ? "bg-foreground text-background cursor-pointer" : "border border-muted-foreground/25 text-muted-foreground cursor-default")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <LucideIconCn Name="@stp.IconName" Size="14" Class="size-3.5" />
                                }
                            </button>
                            <span class="@Cn.Merge("whitespace-nowrap text-center font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                @stp.Label
                            </span>
                        </div>

                        @if (index < _steps.Length - 1)
                        {
                            <div class="mx-3 mb-5 h-px flex-1">
                                <div class="@Cn.Merge("h-full transition-colors duration-300", index < _activeStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Step content *@
        <div class="border-b px-4 py-4">
            @if (_activeStep == 0)
            {
                <div>
                    <div class="mb-3">
                        <span class="font-medium text-sm">Select files</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Drag and drop files or click to browse
                        </p>
                    </div>
                    <div class="flex flex-col items-center justify-center rounded-lg border-2 border-dashed border-muted-foreground/25 px-6 py-10 transition-colors hover:border-muted-foreground/40 hover:bg-muted/30">
                        <LucideIconCn Name="upload" Size="32" Class="mb-3 size-8 text-muted-foreground/50" />
                        <span class="font-medium text-sm">Drop files here</span>
                        <span class="mt-1 text-muted-foreground text-xs">
                            PNG, JPG, PDF, ZIP up to 25 MB each
                        </span>
                    </div>
                    <div class="mt-3 flex items-center gap-2 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="tabular-nums">@_files.Length</span> files selected &middot;
                        @_totalSize total
                    </div>
                </div>
            }

            @if (_activeStep == 1)
            {
                <div>
                    <div class="mb-3">
                        <span class="font-medium text-sm">Preview</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Review your selected files before upload
                        </p>
                    </div>
                    <div class="space-y-2">
                        @foreach (var file in _files)
                        {
                            <div class="flex items-center gap-3 rounded-md bg-muted/50 px-3 py-2.5">
                                <LucideIconCn Name="@GetFileIconName(file.Type)" Size="16" Class="size-4 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <span class="block truncate font-mono text-sm">@file.Name</span>
                                </div>
                                <span class="shrink-0 font-mono text-muted-foreground text-xs">@file.Size</span>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_activeStep == 2)
            {
                <div>
                    <div class="mb-3">
                        <span class="font-medium text-sm">Configure</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Set preferences for this upload batch
                        </p>
                    </div>
                    <div class="space-y-2">
                        @foreach (var option in _configOptions)
                        {
                            <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                                <span class="font-medium text-muted-foreground text-xs">@option.Label</span>
                                @if (option.Active.HasValue)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-normal text-xs", option.Active.Value ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">
                                        @option.Value
                                    </BadgeCn>
                                }
                                else
                                {
                                    <span class="font-mono text-muted-foreground text-sm">@option.Value</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_activeStep == 3)
            {
                <div>
                    <div class="mb-3 flex items-center justify-between">
                        <div>
                            <span class="font-medium text-sm">Uploading</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                <span class="tabular-nums">@_completedFiles</span> of
                                <span class="tabular-nums">@_files.Length</span> files complete
                            </p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                            67%
                        </BadgeCn>
                    </div>
                    <div class="space-y-3">
                        @foreach (var file in _files)
                        {
                            <div>
                                <div class="mb-1.5 flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="@GetFileIconName(file.Type)" Size="16" Class="size-4 text-muted-foreground" />
                                        <span class="truncate font-mono text-xs">@file.Name</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-muted-foreground text-xs tabular-nums">@(file.Progress)%</span>
                                        @if (file.Progress == 100)
                                        {
                                            <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                                        }
                                    </div>
                                </div>
                                <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                    <div
                                        class="@Cn.Merge("h-full rounded-full transition-all duration-500", file.Progress == 100 ? "bg-emerald-500 dark:bg-emerald-600" : "bg-foreground")"
                                        style="@($"width:{file.Progress}%")">
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Done" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private enum FileType { Image, Document, Spreadsheet }

    private record StepItem(string Label, string IconName, string Description);
    private record FileItem(string Name, string Size, FileType Type, int Progress);
    private record ConfigOption(string Label, string Value, bool? Active = null);

    private static readonly StepItem[] _steps =
    [
        new("Select files", "upload", "Choose files to upload"),
        new("Preview", "eye", "Review selected files"),
        new("Configure", "settings", "Set upload preferences"),
        new("Upload", "cloud-upload", "Upload and track progress"),
    ];

    private static readonly FileItem[] _files =
    [
        new("project-mockup.png", "2.4 MB", FileType.Image, 100),
        new("technical-spec.pdf", "890 KB", FileType.Document, 100),
        new("brand-assets.zip", "12.1 MB", FileType.Document, 72),
        new("analytics-report.xlsx", "1.3 MB", FileType.Spreadsheet, 45),
        new("hero-banner.jpg", "3.8 MB", FileType.Image, 18),
    ];

    private static readonly ConfigOption[] _configOptions =
    [
        new("Auto-compress images", "Enabled", true),
        new("Generate thumbnails", "Enabled", true),
        new("Overwrite duplicates", "Disabled", false),
        new("Upload destination", "/assets/uploads"),
        new("Max file size", "25 MB"),
    ];

    private const string _totalSize = "20.5 MB";
    private static readonly int _completedFiles = Array.FindAll(_files, f => f.Progress == 100).Length;

    private int _activeStep = 0;

    private static string GetFileIconName(FileType type) => type switch
    {
        FileType.Image => "image",
        FileType.Document => "file-text",
        FileType.Spreadsheet => "file",
        _ => "file",
    };

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
