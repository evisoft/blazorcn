@* ============================================================
   Block: stepper-milestone-flags
   Title: StepperMilestoneFlags
   Description: A flag and pennant marker stepper with raised, waving, and lowered states along a horizontal progress line built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-milestone-flags.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="flag" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Release milestones</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Milestone <span class="tabular-nums">@(_selectedMilestone + 1)</span> of <span class="tabular-nums">@_milestones.Length</span>
            </BadgeCn>
        </div>

        @* Flag track *@
        <div class="border-b px-6 py-6">
            <div class="relative">
                @* Ground line *@
                <div class="absolute bottom-[22px] right-0 left-0 h-[2px] bg-muted-foreground/15"></div>
                @* Progress fill *@
                <div
                    class="absolute bottom-[22px] left-0 h-[2px] bg-emerald-500 transition-all duration-500 dark:bg-emerald-600"
                    style="@ProgressStyle">
                </div>

                @* Flags *@
                <div class="relative flex items-end justify-between">
                    @foreach (var ms in _milestones)
                    {
                        var idx = Array.IndexOf(_milestones, ms);
                        var isCompleted = idx < _selectedMilestone;
                        var isActive = idx == _selectedMilestone;
                        var isUpcoming = idx > _selectedMilestone;
                        var poleHeight = isCompleted ? 56 : isActive ? 68 : 40;
                        var flagSize = isCompleted ? 28 : isActive ? 34 : 22;

                        <button
                            type="button"
                            @onclick="@(() => { _selectedMilestone = idx; })"
                            class="flex flex-col items-center gap-0 transition-all duration-300">
                            @* Flag pennant + pole *@
                            <div class="relative flex flex-col items-center">
                                @* Pennant *@
                                <div
                                    class="@Cn.Merge("relative mb-[-2px] flex items-center justify-center transition-all duration-300", isCompleted ? "text-emerald-500 dark:text-emerald-400" : isActive ? "text-blue-500 dark:text-blue-400" : "text-muted-foreground/30")"
                                    style="@PennantStyle(flagSize, isActive)">
                                    <svg
                                        viewBox="0 0 24 24"
                                        fill="currentColor"
                                        class="size-full"
                                        style="@SvgFilter(isActive)"
                                        aria-label="@($"{ms.Label} flag")">
                                        <title>@($"Flag for {ms.Label}")</title>
                                        <path d="M4 2 L4 6 L20 6 L16 10 L20 14 L4 14 L4 6" />
                                    </svg>
                                    @if (isCompleted)
                                    {
                                        <span class="absolute" style="left:30%;top:35%">
                                            <LucideIconCn Name="check" Size="12" Class="size-3 text-white" />
                                        </span>
                                    }
                                </div>

                                @* Pole *@
                                <div
                                    class="@Cn.Merge("w-[2px] rounded-full transition-all duration-300", isCompleted ? "bg-emerald-500 dark:bg-emerald-600" : isActive ? "bg-blue-500 dark:bg-blue-400" : "bg-muted-foreground/20")"
                                    style="@($"height:{poleHeight}px")">
                                </div>

                                @* Ground anchor *@
                                <div class="@Cn.Merge("size-3 rounded-full border-2 transition-all duration-300", isCompleted ? "border-emerald-500 bg-emerald-500 dark:border-emerald-600 dark:bg-emerald-600" : isActive ? "border-blue-500 bg-blue-500 dark:border-blue-400 dark:bg-blue-400" : "border-muted-foreground/20 bg-card")"></div>
                            </div>

                            @* Label *@
                            <span class="@Cn.Merge("mt-2 max-w-[80px] text-center text-xs leading-tight", isActive ? "font-medium text-foreground" : isUpcoming ? "text-muted-foreground/60" : "font-medium text-muted-foreground")">
                                @ms.Label
                            </span>
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Milestone detail *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <div>
                    <span class="font-medium text-sm">@_milestones[_selectedMilestone].Label</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_milestones[_selectedMilestone].Description</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">
                    @_milestones[_selectedMilestone].Date
                </BadgeCn>
            </div>
            <div class="space-y-1.5">
                @foreach (var achievement in _milestones[_selectedMilestone].Achievements)
                {
                    <div class="flex items-center gap-2.5 rounded-md bg-muted/50 px-3 py-2">
                        <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                        <span class="text-sm">@achievement</span>
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_selectedMilestone == 0)" OnClick="HandleBack">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Previous
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_selectedMilestone == _milestones.Length - 1)" OnClick="HandleNext">
                @(_selectedMilestone == _milestones.Length - 1 ? "Complete" : "Next milestone")
                @if (_selectedMilestone < _milestones.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Milestone(string Label, string Description, string Date, string[] Achievements);

    private static readonly Milestone[] _milestones =
    [
        new("Prototype complete", "Initial proof of concept validated with stakeholders", "Jan 15",
        [
            "Core architecture designed",
            "User flows mapped",
            "Technical feasibility confirmed",
        ]),
        new("Alpha release", "Internal testing build with core features", "Feb 12",
        [
            "Authentication system live",
            "Dashboard functional",
            "API endpoints deployed",
        ]),
        new("Beta testing", "External beta program with early adopters", "Mar 8",
        [
            "200 beta users onboarded",
            "Feedback collection active",
            "Performance benchmarks met",
        ]),
        new("RC build", "Release candidate with final polish", "Apr 1",
        [
            "All critical bugs resolved",
            "Security audit passed",
            "Documentation finalized",
        ]),
        new("General availability", "Public launch to all users", "Apr 20",
        [
            "Marketing launch prepared",
            "Support channels ready",
            "Monitoring dashboards live",
        ]),
    ];

    private int _selectedMilestone = 2;

    private string ProgressStyle =>
        FormattableString.Invariant($"width:{(double)_selectedMilestone / (_milestones.Length - 1) * 100:0.##}%");

    private static string PennantStyle(int flagSize, bool isActive) =>
        $"width:{flagSize}px;height:{flagSize}px;transform:{(isActive ? "translateY(-2px)" : "none")}";

    private static string SvgFilter(bool isActive) =>
        isActive ? "filter:drop-shadow(0 2px 4px rgba(59, 130, 246, 0.3))" : "filter:none";

    private void HandleNext()
    {
        if (_selectedMilestone < _milestones.Length - 1)
        {
            _selectedMilestone++;
        }
    }

    private void HandleBack()
    {
        if (_selectedMilestone > 0)
        {
            _selectedMilestone--;
        }
    }
}
