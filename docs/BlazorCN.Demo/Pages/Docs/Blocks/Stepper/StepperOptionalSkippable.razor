@* ============================================================
   Block: stepper-optional-skippable
   Title: StepperOptionalSkippable
   Description: A vertical stepper with optional and required steps, skip functionality, dashed connectors, and strikethrough labels built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-optional-skippable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Account setup</span>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs">
                    <span class="tabular-nums">@CompletedCount</span> completed
                </span>
                @if (SkippedCount > 0)
                {
                    <span class="text-muted-foreground text-xs">
                        <span class="tabular-nums">@SkippedCount</span> skipped
                    </span>
                }
            </div>
        </div>

        @* Steps *@
        <div class="px-4 py-4">
            @for (int idx = 0; idx < _steps.Length; idx++)
            {
                var step = _steps[idx];
                var index = idx;
                var isCompleted = index < _currentStep && !_skippedSteps.Contains(index);
                var isSkipped = _skippedSteps.Contains(index);
                var isActive = index == _currentStep;
                var isUpcoming = index > _currentStep;
                var isLast = index == _steps.Length - 1;

                <div class="flex gap-4">
                    @* Circle + Line column *@
                    <div class="flex flex-col items-center">
                        @* Circle *@
                        <button
                            type="button" aria-label="@($"Step {index + 1}: {step.Label}")"
                            @onclick="@(() => HandleStepClick(index))"
                            disabled="@isUpcoming"
                            class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full font-medium text-xs tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600 cursor-pointer" : isSkipped ? "border border-dashed border-muted-foreground/40 text-muted-foreground cursor-pointer" : isActive ? "bg-blue-500 text-white ring-4 ring-blue-500/20 dark:bg-blue-600 dark:ring-blue-400/20 cursor-pointer" : "border border-muted-foreground/25 text-muted-foreground cursor-default", step.Optional && !isCompleted && !isSkipped ? "border-dashed" : "")">
                            @if (isCompleted)
                            {
                                <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                            }
                            else if (isSkipped)
                            {
                                <LucideIconCn Name="minus" Size="14" Class="size-3.5" />
                            }
                            else
                            {
                                <span>@(index + 1)</span>
                            }
                        </button>

                        @* Connecting line *@
                        @if (!isLast)
                        {
                            var nextOptional = _steps[index + 1].Optional;
                            <div
                                class="@Cn.Merge("my-1 flex-1 transition-colors duration-300", isCompleted ? "w-0.5 rounded-full bg-emerald-500 dark:bg-emerald-600" : isSkipped ? "w-0 border-l-2 border-dashed border-muted-foreground/25" : nextOptional ? "w-0 border-l-2 border-dashed border-muted-foreground/15" : "w-0.5 rounded-full bg-muted-foreground/15")"
                                style="@($"min-height:{(isActive ? "100px" : "24px")}")">
                            </div>
                        }
                    </div>

                    @* Content column *@
                    <div class="@(isLast ? "pb-0" : "pb-6")">
                        <div class="flex items-center gap-2 pt-1">
                            <span class="@Cn.Merge("font-medium text-sm", isSkipped ? "text-muted-foreground line-through" : isActive || isCompleted ? "text-foreground" : "text-muted-foreground")">
                                @step.Label
                            </span>
                            @if (step.Optional && !isSkipped)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-muted-foreground text-xs">
                                    Optional
                                </BadgeCn>
                            }
                            @if (isSkipped)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-muted-foreground text-xs">
                                    Skipped
                                </BadgeCn>
                            }
                            @if (isCompleted)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-emerald-600 text-xs dark:text-emerald-400">
                                    Done
                                </BadgeCn>
                            }
                        </div>
                        <p class="@Cn.Merge("mt-0.5 text-xs", isSkipped ? "text-muted-foreground/50" : "text-muted-foreground")">
                            @step.Description
                        </p>

                        @* Active step content *@
                        @if (isActive)
                        {
                            <div class="mt-3">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <p class="text-sm leading-relaxed">@step.Detail</p>
                                </div>
                                <div class="mt-3 flex items-center gap-2">
                                    <ButtonCn
                                        Size="ButtonSize.Sm"
                                        Class="h-8 gap-1.5 text-xs"
                                        OnClick="HandleContinue"
                                        Disabled="@(_currentStep == _steps.Length - 1)">
                                        @(_currentStep == _steps.Length - 1 ? "Finish" : "Continue")
                                        @if (_currentStep < _steps.Length - 1)
                                        {
                                            <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                                        }
                                    </ButtonCn>
                                    @if (step.Optional)
                                    {
                                        <ButtonCn
                                            Variant="ButtonVariant.Ghost"
                                            Size="ButtonSize.Sm"
                                            Class="h-8 text-muted-foreground text-xs"
                                            OnClick="HandleSkip">
                                            Skip this step
                                        </ButtonCn>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StepData(string Label, string Description, bool Optional, string Detail);

    private static readonly StepData[] _steps =
    [
        new("Account", "Create your account with email and password", false,
            "Enter your email address and choose a secure password. We recommend using a password manager for a strong, unique password."),
        new("Profile photo", "Upload a profile picture for your account", true,
            "Upload a photo to help your team recognize you. Supports JPG, PNG, or WebP formats up to 5 MB. You can always add one later from settings."),
        new("Bio", "Tell others about yourself and your role", true,
            "Write a short bio describing your role and expertise. This appears on your public profile and in team directories. Maximum 280 characters."),
        new("Preferences", "Configure notifications and display settings", false,
            "Choose your notification preferences, default timezone, and display language. These settings affect how you receive updates and view dates across the platform."),
        new("Complete", "Review and finish your account setup", false,
            "Review all your settings before finishing. You can go back to any step to make changes. After completing setup, you will be taken to your dashboard."),
    ];

    private int _currentStep = 1;
    private HashSet<int> _skippedSteps = [];

    private int CompletedCount => Enumerable.Range(0, _currentStep).Count(i => !_skippedSteps.Contains(i));
    private int SkippedCount => _skippedSteps.Count;

    private void HandleContinue()
    {
        if (_currentStep < _steps.Length - 1)
        {
            _currentStep++;
        }
    }

    private void HandleSkip()
    {
        if (_steps[_currentStep].Optional && _currentStep < _steps.Length - 1)
        {
            _skippedSteps.Add(_currentStep);
            _currentStep++;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _currentStep)
        {
            _currentStep = index;
        }
    }
}
