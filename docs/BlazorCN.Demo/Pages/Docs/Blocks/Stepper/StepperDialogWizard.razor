@* ============================================================
   Block: stepper-dialog-wizard
   Title: StepperDialogWizard
   Description: A modal-style dialog wizard stepper with a progress bar, step title header, form content body, and contextual navigation buttons built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-dialog-wizard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Dialog header *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-sm">@_currentStep.Title</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_currentStep.Subtitle</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                    <span class="tabular-nums">@(_step + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
                </BadgeCn>
            </div>
        </div>

        @* Progress bar *@
        <div class="h-0.5 bg-muted">
            <div
                class="h-full bg-foreground transition-all duration-300 ease-out"
                style="@($"width:{_progress}%")"
            ></div>
        </div>

        @* Step dots *@
        <div class="flex items-center justify-center gap-1.5 border-b px-4 py-3">
            @foreach (var s in _steps)
            {
                var index = Array.IndexOf(_steps, s);
                var dotClass = index == _step
                    ? "scale-125 bg-foreground"
                    : index < _step
                        ? "bg-emerald-500 dark:bg-emerald-400 cursor-pointer"
                        : "bg-muted-foreground/25 cursor-default";
                <button
                    type="button"
                    @onclick="@(() => HandleDotClick(index))"
                    disabled="@(index > _step)"
                    class="@Cn.Merge("size-1.5 rounded-full transition-all duration-200", dotClass)"
                    aria-label="@($"Go to step {index + 1}: {s.Title}")"
                ></button>
            }
        </div>

        @* Content body *@
        <div class="px-4 py-4">
            <div class="space-y-2">
                @foreach (var field in _currentStep.Fields)
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/30 px-3 py-2.5">
                        <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                        <span class="@Cn.Merge("text-sm", field.Mono ? "font-mono text-xs" : "")">@field.Value</span>
                    </div>
                }
            </div>

            @* Status indicator on test step *@
            @if (_step == _steps.Length - 1)
            {
                <div class="mt-3 rounded-md bg-emerald-500/10 px-3 py-2.5">
                    <div class="flex items-center gap-2">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="font-medium text-emerald-700 text-xs dark:text-emerald-400">
                            Connection verified successfully
                        </span>
                    </div>
                </div>
            }
        </div>

        <hr class="border-border" />

        @* Footer actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_step == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <div class="flex items-center gap-2">
                @if (_step < _steps.Length - 1)
                {
                    <span class="text-muted-foreground text-xs">
                        @(_steps.Length - _step - 1) @(_steps.Length - _step - 1 == 1 ? "step" : "steps") remaining
                    </span>
                }
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" OnClick="HandleNext" Disabled="@(_step == _steps.Length - 1)">
                    @_buttonLabels[_step]
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record FieldItem(string Label, string Value, bool Mono = false);
    private record StepItem(string Title, string Subtitle, FieldItem[] Fields);

    private static readonly StepItem[] _steps =
    [
        new("API key", "Enter your API key to authenticate with the service",
        [
            new("API key", "sk_live_4eC39HqLyjWDarjtT1zdp7dc", true),
            new("Key name", "Production webhook"),
            new("Environment", "Production"),
            new("Permissions", "Read & Write"),
        ]),
        new("Webhook URL", "Specify the endpoint that will receive event payloads",
        [
            new("Endpoint URL", "https://api.acme.com/webhooks/events", true),
            new("Method", "POST"),
            new("Content type", "application/json"),
            new("Signing secret", "whsec_MbX2k...zY9p", true),
        ]),
        new("Events", "Select which events should trigger webhook deliveries",
        [
            new("payment.completed", "Enabled"),
            new("payment.failed", "Enabled"),
            new("subscription.created", "Enabled"),
            new("subscription.canceled", "Disabled"),
            new("invoice.sent", "Enabled"),
            new("refund.processed", "Disabled"),
        ]),
        new("Test connection", "Verify the webhook endpoint receives events correctly",
        [
            new("Test event", "payment.completed"),
            new("Endpoint", "https://api.acme.com/webhooks/events", true),
            new("Response status", "200 OK"),
            new("Response time", "142ms"),
            new("Payload delivered", "Yes — 1.2 KB"),
        ]),
    ];

    private static readonly string[] _buttonLabels = ["Next", "Next", "Next", "Finish"];

    private int _step = 0;

    private StepItem _currentStep => _steps[_step];
    private double _progress => ((_step + 1.0) / _steps.Length) * 100;

    private void HandleNext()
    {
        if (_step < _steps.Length - 1)
        {
            _step++;
        }
    }

    private void HandleBack()
    {
        if (_step > 0)
        {
            _step--;
        }
    }

    private void HandleDotClick(int index)
    {
        if (index <= _step)
        {
            _step = index;
        }
    }
}
