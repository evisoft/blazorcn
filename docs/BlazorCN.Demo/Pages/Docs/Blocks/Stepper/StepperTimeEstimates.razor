@* ============================================================
   Block: stepper-time-estimates
   Title: StepperTimeEstimates
   Description: A vertical stepper with estimated time badges per step, running time remaining total, and actual completion times built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-time-estimates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Onboarding</span>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="clock" Size="16" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs tabular-nums">
                    ~@_remainingMin min remaining
                </span>
            </div>
        </div>

        @* Steps *@
        <div class="px-4 py-4">
            @for (int i = 0; i < _steps.Length; i++)
            {
                var step = _steps[i];
                var index = i;
                var isCompleted = index < _currentStep;
                var isActive = index == _currentStep;
                var isUpcoming = index > _currentStep;
                var isLast = index == _steps.Length - 1;
                <div class="flex gap-4">
                    @* Circle + Line column *@
                    <div class="flex flex-col items-center">
                        <button
                            type="button" aria-label="@($"Step {index + 1}: {_steps[index].Label}")"
                            @onclick="@(() => HandleStepClick(index))"
                            disabled="@isUpcoming"
                            class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full font-medium text-xs tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600 cursor-pointer" : isActive ? "bg-blue-500 text-white ring-4 ring-blue-500/20 dark:bg-blue-600 dark:ring-blue-400/20 cursor-pointer" : "border border-muted-foreground/25 text-muted-foreground cursor-default")">
                            @if (isCompleted)
                            {
                                <LucideIconCn Name="check" Size="16" Class="size-3.5" />
                            }
                            else
                            {
                                <span>@(index + 1)</span>
                            }
                        </button>

                        @if (!isLast)
                        {
                            <div
                                class="@Cn.Merge("my-1 w-0.5 flex-1 rounded-full transition-colors duration-300", isCompleted ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/15")"
                                style="@($"min-height:{(isActive ? "80px" : "24px")}")">
                            </div>
                        }
                    </div>

                    @* Content column *@
                    <div class="@(isLast ? "pb-0" : "pb-6")">
                        <div class="flex items-center gap-2 pt-1">
                            <span class="@Cn.Merge("font-medium text-sm", (isActive || isCompleted) ? "text-foreground" : "text-muted-foreground")">
                                @step.Label
                            </span>

                            @* Time badge *@
                            @if (isCompleted && step.ActualTime != null)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-emerald-600 text-xs dark:text-emerald-400">
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                    @step.ActualTime
                                </BadgeCn>
                            }
                            else if (isActive)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                                    <LucideIconCn Name="clock" Size="12" Class="size-3" />~@step.EstimateMin min
                                </BadgeCn>
                            }
                            else
                            {
                                <span class="text-muted-foreground/60 text-xs tabular-nums">
                                    ~@step.EstimateMin min
                                </span>
                            }
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>

                        @* Expanded content for active step *@
                        @if (isActive)
                        {
                            <div class="mt-3">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="mb-2 flex items-center justify-between">
                                        <span class="font-medium text-muted-foreground text-xs">
                                            Estimated time
                                        </span>
                                        <span class="font-medium text-sm tabular-nums">
                                            @step.EstimateMin min
                                        </span>
                                    </div>
                                    <div class="h-1.5 overflow-hidden rounded-full bg-muted-foreground/15">
                                        <div
                                            class="h-full rounded-full bg-blue-500 transition-all duration-500 dark:bg-blue-600"
                                            style="width:0%">
                                        </div>
                                    </div>
                                    <p class="mt-2 text-muted-foreground text-xs">
                                        Take your time — this estimate is based on average completion.
                                    </p>
                                </div>
                                <div class="mt-3">
                                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleContinue" Disabled="@(_currentStep == _steps.Length - 1)">
                                        @(_currentStep == _steps.Length - 1 ? "Finish" : "Continue")
                                        @if (_currentStep < _steps.Length - 1)
                                        {
                                            <LucideIconCn Name="chevron-right" Size="16" Class="size-3.5" />
                                        }
                                    </ButtonCn>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Description, int EstimateMin, string? ActualTime);

    private static readonly StepItem[] _steps =
    [
        new("Account setup", "Create your account and verify email", 2, "1 min 48 sec"),
        new("Profile details", "Add your name, avatar, and bio", 5, "4 min 12 sec"),
        new("Team invites", "Invite collaborators by email", 3, null),
        new("Integration setup", "Connect GitHub, Slack, and other tools", 10, null),
        new("Final review", "Review settings and go live", 5, null),
    ];

    private int _currentStep = 2;

    private int _remainingMin => _steps.Skip(_currentStep).Sum(s => s.EstimateMin);

    private void HandleContinue()
    {
        if (_currentStep < _steps.Length - 1)
        {
            _currentStep++;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _currentStep)
        {
            _currentStep = index;
        }
    }
}
