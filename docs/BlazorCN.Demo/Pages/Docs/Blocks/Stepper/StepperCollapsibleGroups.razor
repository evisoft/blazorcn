@* ============================================================
   Block: stepper-collapsible-groups
   Title: StepperCollapsibleGroups
   Description: A grouped stepper wizard where steps are organized into collapsible sections with per-group progress tracking built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-collapsible-groups.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Project setup</span>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_activeStep of @_totalSteps complete
                </span>
            </div>
        </div>

        @* Overall progress bar *@
        <div class="border-b px-4 py-3">
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted/50">
                <div
                    class="h-full rounded-full bg-emerald-500 transition-all duration-300 dark:bg-emerald-600"
                    style="@(FormattableString.Invariant($"width:{(_activeStep * 100.0 / _totalSteps):F2}%"))">
                </div>
            </div>
        </div>

        @* Groups *@
        <div>
            @foreach (var grpEntry in _groups.Select((g, gi) => new { Grp = g, GrpIndex = gi }))
            {
                var grpIndex = grpEntry.GrpIndex;
                var grp = grpEntry.Grp;
                var isExpanded = _expandedGroups.Contains(grpIndex);
                var groupCompleted = GetGroupProgress(grpIndex);
                var groupTotal = grp.Steps.Length;
                var isGroupComplete = groupCompleted == groupTotal;
                var isLast = grpIndex == _groups.Length - 1;

                <div class="@((isLast && !isExpanded) ? "" : "border-b")">
                    @* Group header *@
                    <button
                        type="button"
                        @onclick="@(() => ToggleGroup(grpIndex))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">

                        @* Group indicator *@
                        <span class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full text-xs transition-all duration-200", isGroupComplete ? "bg-emerald-500 text-white dark:bg-emerald-600" : "border border-muted-foreground/25 text-muted-foreground")">
                            @if (isGroupComplete)
                            {
                                <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                            }
                            else
                            {
                                <span class="font-medium tabular-nums">@(grpIndex + 1)</span>
                            }
                        </span>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@grp.Label</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">@groupCompleted/@groupTotal</BadgeCn>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@grp.Description</p>
                        </div>

                        @if (isExpanded)
                        {
                            <LucideIconCn Name="chevron-down" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                        }
                        else
                        {
                            <LucideIconCn Name="chevron-right" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                        }
                    </button>

                    @* Expanded steps *@
                    @if (isExpanded)
                    {
                        <div>
                            @foreach (var stepEntry in grp.Steps.Select((s, si) => new { Step = s, StepIndex = si }))
                            {
                                var stepIndex = stepEntry.StepIndex;
                                var step = stepEntry.Step;
                                var idx = FlatIndex(grpIndex, stepIndex);
                                var isCompleted = idx < _activeStep;
                                var isActive = idx == _activeStep;
                                var isUpcoming = idx > _activeStep;
                                var isLastStep = stepIndex == grp.Steps.Length - 1;

                                <div>
                                    <button
                                        type="button"
                                        @onclick="@(() => HandleStepClick(grpIndex, stepIndex))"
                                        disabled="@isUpcoming"
                                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-2.5 pl-8 text-left transition-colors", isUpcoming ? "cursor-default opacity-50" : isActive ? "bg-muted/30" : "cursor-pointer hover:bg-muted/50")">

                                        @* Step indicator *@
                                        <span class="@Cn.Merge("flex size-5 shrink-0 items-center justify-center rounded-full text-xs transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-foreground text-background" : "border border-muted-foreground/20 text-muted-foreground")">
                                            @if (isCompleted)
                                            {
                                                <LucideIconCn Name="check" Size="10" Class="size-2.5" />
                                            }
                                            else
                                            {
                                                <span class="font-medium text-xs tabular-nums">@(stepIndex + 1)</span>
                                            }
                                        </span>

                                        <div class="min-w-0 flex-1">
                                            <span class="@Cn.Merge("text-sm", isActive ? "font-medium text-foreground" : "text-muted-foreground")">
                                                @step.Label
                                            </span>
                                            @if (isActive)
                                            {
                                                <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>
                                            }
                                        </div>

                                        @if (isCompleted)
                                        {
                                            <span class="text-muted-foreground text-xs">Done</span>
                                        }
                                    </button>

                                    @* Active step content *@
                                    @if (isActive)
                                    {
                                        <div class="px-4 pb-3 pl-16">
                                            <div class="rounded-md bg-muted/30 px-3 py-2.5">
                                                <span class="text-muted-foreground text-xs">Complete this step to continue</span>
                                            </div>
                                            <div class="mt-2">
                                                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="HandleContinue" Disabled="@(_activeStep == _totalSteps - 1)">
                                                    @(_activeStep == _totalSteps - 1 ? "Finish" : "Continue")
                                                    @if (_activeStep < _totalSteps - 1)
                                                    {
                                                        <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
                                                    }
                                                </ButtonCn>
                                            </div>
                                        </div>
                                    }

                                    @* Separator between steps within group *@
                                    @if (!isLastStep)
                                    {
                                        <div class="ml-8 border-b border-dashed"></div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StepItem(string Id, string Label, string Description);
    private record StepGroup(string Label, string Description, StepItem[] Steps);

    private int _activeStep = 3;
    private HashSet<int> _expandedGroups = [1];

    private static readonly StepGroup[] _groups =
    [
        new("Setup", "Initial project configuration",
        [
            new("create-account", "Create account", "Set up your user profile and credentials"),
            new("verify-email", "Verify email", "Confirm your email address via verification link"),
            new("set-password", "Set password", "Choose a secure password for your account"),
        ]),
        new("Configure", "Workspace and tool settings",
        [
            new("workspace", "Workspace settings", "Name your workspace and set defaults"),
            new("integrations", "Connect integrations", "Link third-party services and APIs"),
        ]),
        new("Launch", "Review and go live",
        [
            new("review", "Review configuration", "Verify all settings before deployment"),
            new("deploy", "Deploy project", "Push your project to production"),
        ]),
    ];

    private static readonly int _totalSteps = _groups.Sum(g => g.Steps.Length);

    private int FlatIndex(int groupIndex, int stepIndex)
    {
        var idx = 0;
        for (var g = 0; g < groupIndex; g++)
        {
            idx += _groups[g].Steps.Length;
        }
        return idx + stepIndex;
    }

    private int GetGroupProgress(int groupIndex)
    {
        var grp = _groups[groupIndex];
        var startIdx = FlatIndex(groupIndex, 0);
        var completed = 0;
        for (var i = 0; i < grp.Steps.Length; i++)
        {
            if (startIdx + i < _activeStep)
            {
                completed++;
            }
        }
        return completed;
    }

    private void ToggleGroup(int index)
    {
        if (_expandedGroups.Contains(index))
        {
            _expandedGroups.Remove(index);
        }
        else
        {
            _expandedGroups.Add(index);
        }
    }

    private void HandleStepClick(int groupIndex, int stepIndex)
    {
        var idx = FlatIndex(groupIndex, stepIndex);
        if (idx <= _activeStep)
        {
            _activeStep = idx;
        }
    }

    private void HandleContinue()
    {
        if (_activeStep < _totalSteps - 1)
        {
            var nextStep = _activeStep + 1;
            _activeStep = nextStep;

            // Auto-expand the group containing the next step
            var count = 0;
            for (var g = 0; g < _groups.Length; g++)
            {
                if (nextStep < count + _groups[g].Steps.Length)
                {
                    _expandedGroups.Add(g);
                    break;
                }
                count += _groups[g].Steps.Length;
            }
        }
    }
}
