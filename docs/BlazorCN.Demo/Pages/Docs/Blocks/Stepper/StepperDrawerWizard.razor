@* ============================================================
   Block: stepper-drawer-wizard
   Title: StepperDrawerWizard
   Description: A slide-out drawer panel wizard with segmented progress bar, step content, and navigation controls built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-drawer-wizard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Drawer header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2.5">
                <span class="text-muted-foreground">
                    <LucideIconCn Name="@_currentStep.IconName" Size="14" Class="size-3.5" />
                </span>
                <div>
                    <span class="font-medium text-sm">@_currentStep.Label</span>
                    <p class="text-muted-foreground text-xs">
                        Step @(_activeStep + 1) of @_steps.Length
                    </p>
                </div>
            </div>
            <ButtonCn aria-label="Close" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0">
                <LucideIconCn Name="x" Size="14" Class="size-3.5" />
            </ButtonCn>
        </div>

        @* Segmented progress bar *@
        <div class="flex gap-1 border-b px-4 py-2.5">
            @for (int i = 0; i < _steps.Length; i++)
            {
                var barClass = i < _activeStep
                    ? "bg-emerald-500"
                    : i == _activeStep
                        ? "bg-blue-500"
                        : "bg-muted-foreground/15";
                <div class="@Cn.Merge("h-1 flex-1 rounded-full transition-colors duration-300", barClass)"></div>
            }
        </div>

        @* Step content *@
        <div class="px-4 py-4">
            <p class="mb-4 text-muted-foreground text-xs">@_currentStep.Description</p>

            <div>
                @for (int i = 0; i < _currentContent.Items.Length; i++)
                {
                    var item = _currentContent.Items[i];
                    var isLast = i == _currentContent.Items.Length - 1;
                    <div class="@Cn.Merge("flex items-center justify-between py-2.5", isLast ? "" : "border-b")">
                        <span class="font-mono text-muted-foreground text-xs">@item.Label</span>
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@item.Value</span>
                            @if (!string.IsNullOrEmpty(item.Status))
                            {
                                <span class="@Cn.Merge("size-1.5 rounded-full", _statusDot[item.Status])"></span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Step quick nav *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center gap-2">
                @for (int i = 0; i < _steps.Length; i++)
                {
                    var stepIdx = i;
                    var isCompleted = stepIdx < _activeStep;
                    var isActive = stepIdx == _activeStep;
                    var btnClass = isActive
                        ? "bg-muted font-medium text-foreground"
                        : isCompleted
                            ? "text-muted-foreground hover:bg-muted/50"
                            : "cursor-default text-muted-foreground/50";
                    <button
                        type="button" aria-label="@($"Step {stepIdx + 1}: {_steps[stepIdx].Label}")"
                        @onclick="@(() => HandleNavClick(stepIdx))"
                        class="@Cn.Merge("flex items-center gap-1.5 rounded-md px-2 py-1 text-xs transition-colors", btnClass)"
                    >
                        @if (isCompleted)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                        }
                        else
                        {
                            <span class="tabular-nums">@(stepIdx + 1)</span>
                        }
                        <span class="hidden sm:inline">@_steps[stepIdx].Label</span>
                    </button>
                }
            </div>
        </div>

        @* Footer navigation *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                Back
            </ButtonCn>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                @(_activeStep + 1)/@_steps.Length
            </BadgeCn>
            @if (_activeStep < _steps.Length - 1)
            {
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="HandleNext">
                    Next
                    <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
                </ButtonCn>
            }
            else
            {
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="HandleNext">
                    Start import
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record StepDef(string Id, string Label, string Description, string IconName);
    private record ContentItem(string Label, string Value, string Status = "");
    private record StepContent(ContentItem[] Items);

    private static readonly StepDef[] _steps =
    [
        new("workspace", "Select workspace", "Choose the target workspace for your data import.", "database"),
        new("import", "Import data", "Upload or connect to your data source.", "file-spreadsheet"),
        new("mapping", "Map fields", "Match source columns to destination fields.", "git-merge"),
        new("confirm", "Confirm import", "Review your configuration and start the import.", "check"),
    ];

    private static readonly Dictionary<string, StepContent> _stepContent = new()
    {
        ["workspace"] = new(
        [
            new("Workspace", "Acme Production", "ready"),
            new("Region", "US East (Virginia)"),
            new("Storage used", "2.4 GB of 10 GB"),
            new("Tables", "18 existing tables"),
            new("Last import", "3 days ago"),
        ]),
        ["import"] = new(
        [
            new("Source type", "CSV upload"),
            new("File name", "customers_q4_2025.csv"),
            new("File size", "4.2 MB"),
            new("Rows detected", "12,847 rows"),
            new("Columns", "14 columns parsed", "ready"),
        ]),
        ["mapping"] = new(
        [
            new("customer_id → id", "Integer", "matched"),
            new("full_name → name", "String", "matched"),
            new("email_addr → email", "String", "matched"),
            new("signup_date → created_at", "Date", "matched"),
            new("ltv_amount → revenue", "Decimal", "pending"),
        ]),
        ["confirm"] = new(
        [
            new("Workspace", "Acme Production"),
            new("Source", "customers_q4_2025.csv"),
            new("Records", "12,847 rows"),
            new("Fields mapped", "5 of 5", "ready"),
            new("Estimated time", "~45 seconds"),
        ]),
    };

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["ready"] = "bg-emerald-500",
        ["matched"] = "bg-blue-500",
        ["pending"] = "bg-amber-500",
    };

    private int _activeStep = 1;

    private StepDef _currentStep => _steps[_activeStep];
    private StepContent _currentContent => _stepContent[_currentStep.Id];

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleNavClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
