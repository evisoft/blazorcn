@* ============================================================
   Block: stepper-comparison-paths
   Title: StepperComparisonPaths
   Description: A side-by-side A/B comparison stepper with two parallel paths for quick and advanced setup flows built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-comparison-paths.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Project setup</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @(_activePath?.Title)
            </BadgeCn>
        </div>

        @* Path selector columns *@
        <div class="grid grid-cols-2 border-b">
            @foreach (var path in _paths)
            {
                var p = path;
                var isSelected = _selectedPath == p.Id;
                var pathStep = _stepByPath.TryGetValue(p.Id, out var s) ? s : 0;
                <button
                    type="button"
                    @onclick="@(() => _selectedPath = p.Id)"
                    class="@Cn.Merge("relative px-4 py-4 text-left transition-colors", isSelected ? "bg-muted/30" : "opacity-50 hover:opacity-75", p.Id == "quick" ? "border-r" : "")">
                    @* Active indicator bar *@
                    @if (isSelected)
                    {
                        <div class="absolute inset-x-0 bottom-0 h-0.5 bg-foreground"></div>
                    }
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full transition-colors", isSelected ? "bg-foreground text-background" : "border border-muted-foreground/25 text-muted-foreground")">
                            <LucideIconCn Name="@p.IconName" Size="14" Class="size-3.5" />
                        </span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@p.Title</span>
                                @if (p.Recommended)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        Recommended
                                    </BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@p.Subtitle</p>
                            <div class="mt-2 flex items-center gap-1">
                                <span class="text-muted-foreground text-xs tabular-nums">
                                    @p.Steps.Length steps
                                </span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs tabular-nums">
                                    @pathStep done
                                </span>
                            </div>
                        </div>
                    </div>
                </button>
            }
        </div>

        @* Step indicators for active path *@
        @if (_activePath != null)
        {
            <div class="flex items-center gap-2 border-b px-4 py-3">
                @for (var i = 0; i < _activePath.Steps.Length; i++)
                {
                    var idx = i;
                    var step = _activePath.Steps[idx];
                    var isComplete = idx < _activeStepIndex;
                    var isCurrent = idx == _activeStepIndex;
                    var isUpcoming = idx > _activeStepIndex;
                    <div class="flex items-center gap-2">
                        <div class="flex items-center gap-1.5">
                            <span class="@Cn.Merge("flex size-5 shrink-0 items-center justify-center rounded-full text-xs tabular-nums transition-all duration-200", isComplete ? "bg-emerald-500 text-white dark:bg-emerald-600" : isCurrent ? "bg-foreground text-background" : "border border-muted-foreground/25 text-muted-foreground")">
                                @if (isComplete)
                                {
                                    <LucideIconCn Name="check" Size="10" Class="size-2.5" />
                                }
                                else
                                {
                                    <span class="text-xs">@(idx + 1)</span>
                                }
                            </span>
                            <span class="@Cn.Merge("text-xs", isCurrent ? "font-medium text-foreground" : "text-muted-foreground", isUpcoming ? "hidden sm:inline" : "")">
                                @step.Label
                            </span>
                        </div>
                        @if (idx < _activePath.Steps.Length - 1)
                        {
                            <div class="@Cn.Merge("h-px w-6", isComplete ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")"></div>
                        }
                    </div>
                }
            </div>
        }

        @* Step content *@
        @if (_activeStep != null)
        {
            <div class="border-b px-4 py-4">
                <div class="mb-3">
                    <span class="font-medium text-sm">@_activeStep.Label</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_activeStep.Description</p>
                </div>
                <div class="space-y-1.5">
                    @foreach (var field in _activeStep.Fields)
                    {
                        <div class="flex items-center justify-between rounded-md bg-muted/30 px-3 py-2.5">
                            <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                            <span class="text-sm">@field.Value</span>
                        </div>
                    }
                </div>
            </div>
        }

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStepIndex == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <div class="flex items-center gap-2">
                @if (_activePath != null && _activeStepIndex == _activePath.Steps.Length - 1)
                {
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                        <LucideIconCn Name="rocket" Size="12" Class="size-3" />
                        Deploy
                    </ButtonCn>
                }
                else
                {
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext">
                        Continue
                        <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                    </ButtonCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record FieldItem(string Label, string Value);

    private record PathStep(string Label, string Description, FieldItem[] Fields);

    private record SetupPath(string Id, string Title, string Subtitle, string IconName, bool Recommended, PathStep[] Steps);

    private static readonly SetupPath[] _paths =
    [
        new("quick", "Quick setup", "Sensible defaults, deploy in minutes", "zap", true,
        [
            new("Defaults", "Pre-configured for most projects",
            [
                new("Framework", "Next.js 16 (auto-detected)"),
                new("Build command", "next build"),
                new("Output directory", ".next"),
                new("Node version", "20.x LTS"),
            ]),
            new("Review", "Confirm your configuration",
            [
                new("Project", "acme-dashboard"),
                new("Region", "US East (auto)"),
                new("Environment variables", "3 imported from .env"),
                new("Domain", "acme-dashboard.vercel.app"),
            ]),
            new("Deploy", "One-click deployment",
            [
                new("Branch", "main"),
                new("Estimated build time", "~45 seconds"),
                new("Preview deployments", "Enabled"),
                new("Status", "Ready to deploy"),
            ]),
        ]),
        new("custom", "Custom setup", "Full control over every setting", "settings", false,
        [
            new("Select options", "Choose your runtime and framework",
            [
                new("Runtime", "Edge Functions"),
                new("Framework", "Next.js 16 (App Router)"),
                new("Package manager", "pnpm"),
                new("Monorepo", "Turborepo (packages/web)"),
            ]),
            new("Configure", "Fine-tune build and deployment",
            [
                new("Build command", "turbo build --filter=web"),
                new("Root directory", "packages/web"),
                new("Install command", "pnpm install --frozen-lockfile"),
                new("Node version", "22.x (specified in .nvmrc)"),
            ]),
            new("Environment", "Variables and secrets",
            [
                new("DATABASE_URL", "postgresql://***@neon.tech/prod"),
                new("NEXTAUTH_SECRET", "••••••••••••"),
                new("STRIPE_SECRET_KEY", "sk_live_••••••••"),
                new("Encryption", "AES-256 at rest"),
            ]),
            new("Finalize", "Review and deploy with custom config",
            [
                new("Project", "acme-dashboard (monorepo)"),
                new("Region", "US East + EU West (multi)"),
                new("Environment variables", "12 configured"),
                new("Custom domain", "app.acme.com (pending DNS)"),
            ]),
        ]),
    ];

    private string _selectedPath = "quick";
    private Dictionary<string, int> _stepByPath = new() { ["quick"] = 0, ["custom"] = 0 };

    private SetupPath? _activePath => Array.Find(_paths, p => p.Id == _selectedPath);
    private int _activeStepIndex => _stepByPath.TryGetValue(_selectedPath, out var s) ? s : 0;
    private PathStep? _activeStep => _activePath?.Steps.Length > _activeStepIndex ? _activePath.Steps[_activeStepIndex] : null;

    private void HandleNext()
    {
        if (_activePath != null && _activeStepIndex < _activePath.Steps.Length - 1)
        {
            _stepByPath[_selectedPath] = _activeStepIndex + 1;
        }
    }

    private void HandleBack()
    {
        if (_activeStepIndex > 0)
        {
            _stepByPath[_selectedPath] = _activeStepIndex - 1;
        }
    }
}
