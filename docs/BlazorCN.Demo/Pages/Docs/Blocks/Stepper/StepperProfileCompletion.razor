@* ============================================================
   Block: stepper-profile-completion
   Title: StepperProfileCompletion
   Description: A profile completion checklist stepper with a circular SVG progress ring, toggleable task rows, and dynamic percentage tracking built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-profile-completion.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Profile completion</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_statusLabel
            </BadgeCn>
        </div>

        @* Progress ring *@
        <div class="flex flex-col items-center border-b px-4 py-6">
            <div class="relative">
                <svg
                    width="@RingSize"
                    height="@RingSize"
                    class="-rotate-90"
                    role="img"
                    aria-label="@($"Profile completion: {_percentage}%")">
                    <title>Profile completion: @_percentage%</title>
                    <circle
                        cx="@(RingSize / 2)"
                        cy="@(RingSize / 2)"
                        r="@_radiusStr"
                        fill="none"
                        stroke-width="@StrokeWidth"
                        class="stroke-muted" />
                    <circle
                        cx="@(RingSize / 2)"
                        cy="@(RingSize / 2)"
                        r="@_radiusStr"
                        fill="none"
                        stroke-width="@StrokeWidth"
                        stroke-linecap="round"
                        stroke-dasharray="@_circumferenceStr"
                        stroke-dashoffset="@_offsetStr"
                        class="@Cn.Merge(_ringColor, "transition-all duration-500")" />
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span class="font-semibold text-2xl tabular-nums">@_percentage%</span>
                </div>
            </div>
            <div class="mt-3 flex items-center gap-2 text-center">
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_completedCount of @_totalCount tasks complete
                </span>
            </div>
        </div>

        @* Task checklist *@
        <div>
            @for (int i = 0; i < _tasks.Length; i++)
            {
                var task = _tasks[i];
                var isCompleted = _completedTasks.Contains(task.Id);
                var isLast = i == _tasks.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/30", isLast ? "" : "border-b")">
                    @* Completion indicator *@
                    <button
                        type="button"
                        @onclick="@(() => ToggleTask(task.Id))"
                        class="@Cn.Merge("flex size-6 shrink-0 items-center justify-center rounded-full border transition-all duration-200", isCompleted ? "border-emerald-500 bg-emerald-500 text-white dark:border-emerald-400 dark:bg-emerald-400" : "border-muted-foreground/30 hover:border-muted-foreground/50")">
                        @if (isCompleted)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                        }
                    </button>

                    @* Task info *@
                    <div class="min-w-0 flex-1">
                        <span class="@Cn.Merge("font-medium text-sm", isCompleted ? "text-muted-foreground line-through" : "text-foreground")">
                            @task.Title
                        </span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@task.Description</p>
                    </div>

                    @* Action *@
                    @if (!isCompleted)
                    {
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 shrink-0 text-xs" OnClick="@(() => ToggleTask(task.Id))">
                            @task.Action
                            <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
                        </ButtonCn>
                    }

                    @if (isCompleted)
                    {
                        <span class="shrink-0 text-emerald-600 text-xs dark:text-emerald-400">Done</span>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ProfileTask(string Id, string Title, string Description, string Action, bool DefaultCompleted);

    private const int RingSize = 120;
    private const int StrokeWidth = 8;
    private const double Radius = (RingSize - StrokeWidth) / 2.0;

    private static readonly ProfileTask[] _tasks =
    [
        new("basic-info", "Basic information", "Name, email, and phone number", "Edit", true),
        new("photo", "Profile photo", "Upload a profile picture", "Upload", true),
        new("bio", "Bio", "Write a short description about yourself", "Add", false),
        new("social", "Social links", "Twitter, LinkedIn, or personal website", "Add", false),
        new("verification", "Identity verification", "Verify your identity for full account access", "Verify", false),
    ];

    private HashSet<string> _completedTasks = new(
        _tasks.Where(t => t.DefaultCompleted).Select(t => t.Id)
    );

    private int _completedCount => _completedTasks.Count;
    private int _totalCount => _tasks.Length;
    private int _percentage => (int)Math.Round((double)_completedCount / _totalCount * 100);

    private static readonly double _circumferenceVal = 2 * Math.PI * Radius;
    private string _radiusStr => Radius.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    private string _circumferenceStr => _circumferenceVal.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    private string _offsetStr => (_circumferenceVal - (_percentage / 100.0) * _circumferenceVal).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private string _statusLabel => _percentage == 100 ? "Complete"
        : _percentage >= 60 ? "Almost there"
        : _percentage >= 40 ? "Getting started"
        : "Just begun";

    private string _ringColor => _percentage == 100
        ? "stroke-emerald-500 dark:stroke-emerald-400"
        : _percentage >= 60
        ? "stroke-blue-500 dark:stroke-blue-400"
        : "stroke-amber-500 dark:stroke-amber-400";

    private void ToggleTask(string taskId)
    {
        if (_completedTasks.Contains(taskId))
            _completedTasks.Remove(taskId);
        else
            _completedTasks.Add(taskId);
    }
}
