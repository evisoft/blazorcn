@* ============================================================
   Block: stepper-segmented-progress
   Title: StepperSegmentedProgress
   Description: A segmented progress bar stepper with colored step segments, labels, and detail content built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-segmented-progress.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Security Pipeline</span>
            <span class="font-medium text-muted-foreground text-xs tabular-nums">
                @(_activeStep + 1) / @_steps.Length
            </span>
        </div>

        @* Segmented progress bar *@
        <div class="border-b px-4 pb-6 pt-5">
            @* Segments *@
            <div class="flex gap-1.5">
                @for (int i = 0; i < _steps.Length; i++)
                {
                    var idx = i;
                    var isCompleted = i < _activeStep;
                    var isActive = i == _activeStep;
                    <button
                        type="button" aria-label="@($"Step {idx + 1}: {_steps[idx].Label}")"
                        @onclick="@(() => { if (idx <= _activeStep) _activeStep = idx; })"
                        disabled="@(i > _activeStep)"
                        class="@Cn.Merge("relative h-2 flex-1 rounded-full transition-all duration-400", isCompleted ? "bg-emerald-500 dark:bg-emerald-600 cursor-pointer" : isActive ? "bg-blue-500 dark:bg-blue-600 cursor-pointer" : "bg-muted-foreground/15 cursor-default")">
                    </button>
                }
            </div>

            @* Labels below segments *@
            <div class="mt-3 flex gap-1.5">
                @for (int i = 0; i < _steps.Length; i++)
                {
                    var isCompleted = i < _activeStep;
                    var isActive = i == _activeStep;
                    <div class="flex flex-1 items-center justify-center gap-1.5">
                        @if (isCompleted)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3 shrink-0 text-emerald-500 dark:text-emerald-400" />
                        }
                        <span class="@Cn.Merge("text-center text-xs", isActive ? "font-medium text-foreground" : isCompleted ? "font-medium text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">
                            @_steps[i].Label
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Step content *@
        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@_steps[_activeStep].Description</p>
            </div>

            @* Task list *@
            <div class="space-y-0">
                @for (int i = 0; i < _steps[_activeStep].Tasks.Length; i++)
                {
                    var task = _steps[_activeStep].Tasks[i];
                    var isLast = i == _steps[_activeStep].Tasks.Length - 1;
                    <div class="@Cn.Merge("flex items-center justify-between py-2.5", !isLast ? "border-b border-dashed" : "")">
                        <div class="flex items-center gap-2.5">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _taskStatusDot[task.Status])"></span>
                            <span class="text-sm">@task.Name</span>
                        </div>
                        <span class="text-muted-foreground text-xs">
                            @_taskStatusLabel[task.Status]
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Finish" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TaskItem(string Name, string Status);
    private record StepDef(string Label, string Description, TaskItem[] Tasks);

    private static readonly StepDef[] _steps =
    [
        new("Scan", "Discover and inventory all assets in the target environment",
        [
            new("Network discovery", "done"),
            new("Port scanning", "done"),
            new("Service detection", "done"),
        ]),
        new("Analyze", "Evaluate vulnerabilities and assess risk levels",
        [
            new("CVE matching", "done"),
            new("Risk scoring", "active"),
            new("Dependency audit", "pending"),
        ]),
        new("Optimize", "Apply patches and harden configurations",
        [
            new("Patch prioritization", "pending"),
            new("Config hardening", "pending"),
            new("Firewall rules", "pending"),
        ]),
        new("Deploy", "Roll out changes to staging and production",
        [
            new("Staging deployment", "pending"),
            new("Smoke tests", "pending"),
            new("Production rollout", "pending"),
        ]),
        new("Monitor", "Continuous observation and alerting post-deployment",
        [
            new("Health checks", "pending"),
            new("Alert rules", "pending"),
            new("Incident runbook", "pending"),
        ]),
    ];

    private static readonly Dictionary<string, string> _taskStatusDot = new()
    {
        ["done"] = "bg-emerald-500",
        ["active"] = "bg-blue-500",
        ["pending"] = "bg-muted-foreground/30",
    };

    private static readonly Dictionary<string, string> _taskStatusLabel = new()
    {
        ["done"] = "Done",
        ["active"] = "In progress",
        ["pending"] = "Pending",
    };

    private int _activeStep = 1;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }
}
