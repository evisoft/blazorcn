@* ============================================================
   Block: stepper-card-content
   Title: StepperCardContent
   Description: A card-based stepper wizard with numbered step indicators, connecting lines, and swappable content panels built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-card-content.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">New workspace</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Step <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Step indicators *@
        <div class="border-b px-6 py-5">
            <div class="flex items-center">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var isCompleted = index < _activeStep;
                    var isActive = index == _activeStep;
                    var isUpcoming = index > _activeStep;
                    <div class="flex flex-1 items-center last:flex-none">
                        <div class="flex flex-col items-center gap-1.5">
                            <button
                                type="button" aria-label="@($"Step {index + 1}: {stp.Label}")"
                                @onclick="@(() => HandleStepClick(index))"
                                disabled="@isUpcoming"
                                class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full font-medium text-xs tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600 cursor-pointer" : isActive ? "bg-foreground text-background cursor-pointer" : "border border-muted-foreground/25 text-muted-foreground cursor-default")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <span>@(index + 1)</span>
                                }
                            </button>
                            <span class="@Cn.Merge("text-center font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                @stp.Label
                            </span>
                        </div>

                        @if (index < _steps.Length - 1)
                        {
                            <div class="mx-3 mb-5 h-px flex-1">
                                <div class="@Cn.Merge("h-full transition-colors duration-300", index < _activeStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Content area *@
        <div class="border-b bg-muted/20 px-4 py-4">
            <div class="mb-4">
                <span class="font-medium text-sm">@ActiveContent.Heading</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@ActiveContent.Subtitle</p>
            </div>
            <div class="space-y-2">
                @foreach (var field in ActiveContent.Fields)
                {
                    <div class="flex items-center justify-between rounded-md bg-background/80 px-3 py-2.5">
                        <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                        <span class="text-sm">@field.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Launch" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Description);
    private record FieldItem(string Label, string Value);
    private record StepContent(string Heading, string Subtitle, FieldItem[] Fields);

    private static readonly StepItem[] _steps =
    [
        new("Organization", "Set up your org details"),
        new("Branding", "Colors, logo, and identity"),
        new("Domains", "Connect your custom domains"),
        new("Launch", "Review and go live"),
    ];

    private static readonly StepContent[] _stepContent =
    [
        new("Organization details", "Basic information about your organization",
        [
            new("Organization name", "Acme Corporation"),
            new("Industry", "Software & Technology"),
            new("Team size", "51-200 employees"),
            new("Timezone", "America/New_York (UTC-5)"),
        ]),
        new("Brand identity", "Customize the look and feel of your workspace",
        [
            new("Primary color", "#2563EB"),
            new("Logo", "acme-logo.svg (uploaded)"),
            new("Favicon", "favicon.ico (uploaded)"),
            new("Display font", "Inter"),
        ]),
        new("Custom domains", "Connect domains for your public-facing pages",
        [
            new("Primary domain", "app.acme.com"),
            new("Status", "DNS verified"),
            new("SSL certificate", "Auto-provisioned"),
            new("Redirect", "www → non-www"),
        ]),
        new("Launch checklist", "Review everything before going live",
        [
            new("Organization", "Acme Corporation"),
            new("Branding", "Custom theme applied"),
            new("Domain", "app.acme.com (verified)"),
            new("Status", "Ready to launch"),
        ]),
    ];

    private int _activeStep = 1;

    private StepContent ActiveContent => _stepContent[_activeStep];

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
