@* ============================================================
   Block: stepper-locked-gated
   Title: StepperLockedGated
   Description: A horizontal stepper with locked and unlocked step states, lock icons, gated progression, and unlock transitions built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-locked-gated.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Get started</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Step <span class="tabular-nums">@(_currentStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Stepper *@
        <div class="border-b px-6 py-6">
            <div class="flex items-center">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var isCompleted = index < _currentStep;
                    var isActive = index == _currentStep;
                    var isLocked = index > _currentStep;
                    <div class="flex flex-1 items-center last:flex-none">
                        @* Step circle + label *@
                        <div class="@Cn.Merge("flex flex-col items-center gap-2 transition-opacity duration-300", isLocked ? "opacity-40" : "opacity-100")">
                            <button
                                type="button"
                                @onclick="@(() => HandleStepClick(index))"
                                disabled="@(isLocked ? "disabled" : null)"
                                class="@Cn.Merge("flex size-9 shrink-0 items-center justify-center rounded-full font-medium text-sm tabular-nums transition-all duration-300", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600 cursor-pointer" : isActive ? "bg-blue-500 text-white ring-2 ring-blue-500 ring-offset-2 ring-offset-card dark:bg-blue-600 dark:ring-blue-400 cursor-pointer" : "border-2 border-muted-foreground/20 bg-muted/50 text-muted-foreground cursor-not-allowed")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="size-4" />
                                }
                                else if (isLocked)
                                {
                                    <LucideIconCn Name="lock" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <span>@(index + 1)</span>
                                }
                            </button>
                            <div class="flex flex-col items-center text-center">
                                <span class="@Cn.Merge("font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                    @stp.Label
                                </span>
                                @if (isLocked)
                                {
                                    <span class="mt-0.5 text-[10px] text-muted-foreground/60">Locked</span>
                                }
                            </div>
                        </div>

                        @* Connecting line *@
                        @if (index < _steps.Length - 1)
                        {
                            <div class="mx-2 mb-8 h-0.5 flex-1">
                                <div class="@Cn.Merge("h-full rounded-full transition-all duration-500", index < _currentStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/15")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Step content *@
        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <span class="font-medium text-sm">@_steps[_currentStep].Label</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@_steps[_currentStep].Description</p>
            </div>
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-sm leading-relaxed">@_steps[_currentStep].Detail</p>
            </div>

            @* Locked step hint *@
            @if (_currentStep < _steps.Length - 1)
            {
                <div class="mt-3 flex items-center gap-2 text-muted-foreground/60">
                    <LucideIconCn Name="lock" Size="12" Class="size-3" />
                    <span class="text-xs">
                        Complete this step to unlock <span class="font-medium text-muted-foreground">@_steps[_currentStep + 1].Label</span>
                    </span>
                </div>
            }
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_currentStep == 0)" OnClick="HandleBack">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_currentStep == _steps.Length - 1)" OnClick="HandleNext">
                @(_currentStep == _steps.Length - 1 ? "Get started" : "Complete step")
                @if (_currentStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Description, string Detail);

    private static readonly StepItem[] _steps =
    [
        new("Sign up", "Create your account",
            "Account created with alex@example.com. Password meets strength requirements with uppercase, lowercase, number, and special character."),
        new("Verify email", "Confirm your email address",
            "A 6-digit verification code was sent to alex@example.com. Enter the code below to confirm your email address and proceed."),
        new("Set password", "Choose a secure password",
            "Create a strong password with at least 12 characters. Include a mix of uppercase, lowercase, numbers, and special characters for maximum security."),
        new("Choose plan", "Select your subscription",
            "Choose from Free, Pro, or Enterprise plans. All plans include core features. Pro adds advanced analytics and priority support. Enterprise includes SSO and custom integrations."),
        new("Dashboard", "Access your workspace",
            "Your workspace is ready. You will be redirected to the dashboard where you can invite team members, create projects, and configure integrations."),
    ];

    private int _currentStep = 1;

    private void HandleNext()
    {
        if (_currentStep < _steps.Length - 1)
        {
            _currentStep++;
        }
    }

    private void HandleBack()
    {
        if (_currentStep > 0)
        {
            _currentStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _currentStep)
        {
            _currentStep = index;
        }
    }
}
