@* ============================================================
   Block: stepper-application-form
   Title: StepperApplicationForm
   Description: A professional job application form stepper with horizontal numbered steps, progress bar, structured form fields, and save draft functionality built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-application-form.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Job Application</span>
                <span class="text-muted-foreground text-xs">Staff Engineer — Platform</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Step <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Progress bar *@
        <div class="h-1 w-full bg-muted">
            <div
                class="h-full bg-foreground transition-all duration-500"
                style="@(FormattableString.Invariant($"width:{_progressPercent}%"))" />
        </div>

        @* Step indicators *@
        <div class="border-b px-4 py-5">
            <div class="flex items-center">
                @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
                {
                    var idx = entry.Index;
                    var step = entry.Step;
                    var isCompleted = idx < _activeStep;
                    var isActive = idx == _activeStep;
                    var isUpcoming = idx > _activeStep;

                    <div class="flex flex-1 items-center last:flex-none">
                        <div class="flex flex-col items-center gap-1.5">
                            <button
                                type="button" aria-label="@($"Step {idx + 1}: {step.Label}")"
                                @onclick="@(() => HandleStepClick(idx))"
                                disabled="@isUpcoming"
                                class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full font-medium text-xs tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white cursor-pointer dark:bg-emerald-600" : isActive ? "bg-foreground text-background cursor-pointer" : "border border-muted-foreground/25 text-muted-foreground cursor-default")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else if (isActive)
                                {
                                    <LucideIconCn Name="@step.IconName" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <span>@(idx + 1)</span>
                                }
                            </button>
                            <span class="@Cn.Merge("whitespace-nowrap text-center font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                @step.Label
                            </span>
                        </div>

                        @if (idx < _steps.Length - 1)
                        {
                            <div class="mx-2 mb-5 h-px flex-1">
                                <div class="@Cn.Merge("h-full transition-colors duration-300", idx < _activeStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Step content *@
        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@_steps[_activeStep].Description</p>
            </div>
            <div class="space-y-2">
                @foreach (var field in _stepFields[_activeStep])
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                        <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                        @if (field.FieldType == FieldType.Badge)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@field.Value</BadgeCn>
                        }
                        else if (field.FieldType == FieldType.Mono)
                        {
                            <span class="font-mono text-muted-foreground text-sm">@field.Value</span>
                        }
                        else
                        {
                            <span class="text-sm">@field.Value</span>
                        }
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleSaveDraft">
                    @if (_draftSaved)
                    {
                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                        @: Draft saved
                    }
                    else
                    {
                        <LucideIconCn Name="save" Size="14" Class="size-3.5" />
                        @: Save draft
                    }
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                    @(_activeStep == _steps.Length - 1 ? "Submit application" : "Continue")
                    @if (_activeStep < _steps.Length - 1)
                    {
                        <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                    }
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private enum FieldType { Text, Badge, Mono }

    private record FieldData(string Label, string Value, FieldType FieldType = FieldType.Text);
    private record StepItem(string Label, string IconName, string Description);

    private int _activeStep = 2;
    private bool _draftSaved = false;

    private double _progressPercent => ((_activeStep + 1.0) / _steps.Length) * 100;

    private static readonly StepItem[] _steps =
    [
        new("Personal", "user", "Contact information and identity"),
        new("Education", "book-open", "Academic background and qualifications"),
        new("Experience", "briefcase", "Professional history and skills"),
        new("Documents", "file-text", "Upload supporting documents"),
        new("Submit", "send", "Review and submit your application"),
    ];

    private static readonly Dictionary<int, FieldData[]> _stepFields = new()
    {
        [0] =
        [
            new("Full name", "Sarah Mitchell"),
            new("Email address", "sarah.mitchell@email.com", FieldType.Mono),
            new("Phone number", "+1 (415) 892-3041", FieldType.Mono),
            new("Location", "San Francisco, CA"),
            new("LinkedIn", "linkedin.com/in/sarahmitchell", FieldType.Mono),
        ],
        [1] =
        [
            new("Degree", "M.S. Computer Science"),
            new("University", "Stanford University"),
            new("Graduation year", "2021", FieldType.Mono),
            new("GPA", "3.87 / 4.00", FieldType.Mono),
            new("Honors", "Magna Cum Laude", FieldType.Badge),
        ],
        [2] =
        [
            new("Current role", "Senior Software Engineer"),
            new("Company", "Stripe"),
            new("Duration", "3 years 4 months"),
            new("Skills", "TypeScript, React, Go, PostgreSQL"),
            new("Level", "L5 Senior", FieldType.Badge),
        ],
        [3] =
        [
            new("Resume", "sarah-mitchell-resume.pdf", FieldType.Mono),
            new("Cover letter", "cover-letter-2026.pdf", FieldType.Mono),
            new("Portfolio", "portfolio-link.pdf", FieldType.Mono),
            new("References", "2 references attached", FieldType.Badge),
            new("Total size", "4.2 MB", FieldType.Mono),
        ],
        [4] =
        [
            new("Position", "Staff Engineer — Platform"),
            new("Applicant", "Sarah Mitchell"),
            new("Documents", "3 files uploaded", FieldType.Badge),
            new("Status", "Ready to submit", FieldType.Badge),
            new("Application ID", "APP-2026-04821", FieldType.Mono),
        ],
    };

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
            _draftSaved = false;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
            _draftSaved = false;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
            _draftSaved = false;
        }
    }

    private void HandleSaveDraft()
    {
        _draftSaved = true;
    }
}
