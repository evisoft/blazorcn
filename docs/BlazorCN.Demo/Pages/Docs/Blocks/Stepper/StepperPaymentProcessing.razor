@* ============================================================
   Block: stepper-payment-processing
   Title: StepperPaymentProcessing
   Description: A secure payment flow stepper with method selection, card details form, order verification, and completion confirmation built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-payment-processing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="lock" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Secure Checkout</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Step <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Step indicators *@
        <div class="border-b px-6 py-5">
            <div class="flex items-center">
                @foreach (var stp in _steps)
                {
                    var idx = Array.IndexOf(_steps, stp);
                    var isCompleted = idx < _activeStep;
                    var isActive = idx == _activeStep;
                    var isUpcoming = idx > _activeStep;
                    <div class="flex flex-1 items-center last:flex-none">
                        <div class="flex flex-col items-center gap-1.5">
                            <button
                                type="button"
                                @onclick="@(() => HandleStepClick(idx))"
                                disabled="@isUpcoming"
                                class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full font-medium text-xs tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white cursor-pointer dark:bg-emerald-600" : isActive ? "bg-foreground text-background cursor-pointer" : "border border-muted-foreground/25 text-muted-foreground cursor-default")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <span>@(idx + 1)</span>
                                }
                            </button>
                            <span class="@Cn.Merge("whitespace-nowrap text-center font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                @stp.Label
                            </span>
                        </div>

                        @if (idx < _steps.Length - 1)
                        {
                            <div class="mx-3 mb-5 h-px flex-1">
                                <div class="@Cn.Merge("h-full transition-colors duration-300", idx < _activeStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Step content *@
        <div class="border-b px-4 py-4">
            @if (_activeStep == 0)
            {
                <div>
                    <div class="mb-3">
                        <span class="font-medium text-sm">Payment method</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Select how you would like to pay
                        </p>
                    </div>
                    <div class="space-y-2">
                        @foreach (var method in _paymentMethods)
                        {
                            var mth = method;
                            var isSelected = _selectedMethod == mth.Id;
                            <button
                                type="button"
                                @onclick="@(() => _selectedMethod = mth.Id)"
                                class="@Cn.Merge("flex w-full items-center gap-3 rounded-md px-3 py-3 text-left transition-all duration-150", isSelected ? "bg-foreground/5 ring-1 ring-foreground/20" : "bg-muted/50 hover:bg-muted/80")">
                                <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-md transition-colors", isSelected ? "bg-foreground text-background" : "bg-muted")">
                                    <LucideIconCn Name="@mth.IconName" Size="16" Class="size-4" />
                                </div>
                                <div class="min-w-0 flex-1">
                                    <span class="@Cn.Merge("block text-sm", isSelected ? "font-medium" : "text-muted-foreground")">
                                        @mth.Label
                                    </span>
                                    <span class="text-muted-foreground text-xs">@mth.Description</span>
                                </div>
                                <div class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border transition-all duration-150", isSelected ? "border-foreground bg-foreground" : "border-muted-foreground/30")">
                                    @if (isSelected)
                                    {
                                        <LucideIconCn Name="check" Size="10" Class="size-2.5 text-background" />
                                    }
                                </div>
                            </button>
                        }
                    </div>
                </div>
            }

            @if (_activeStep == 1)
            {
                <div>
                    <div class="mb-3">
                        <span class="font-medium text-sm">@MethodLabel details</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Enter your payment information
                        </p>
                    </div>
                    <div class="space-y-2">
                        @foreach (var field in GetDetailsByMethod(_selectedMethod))
                        {
                            <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                                <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                                <span class="font-mono text-sm">@field.Value</span>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_activeStep == 2)
            {
                <div>
                    <div class="mb-3">
                        <span class="font-medium text-sm">Order summary</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Review your order before payment
                        </p>
                    </div>
                    <div class="space-y-2">
                        <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                            <span class="font-medium text-muted-foreground text-xs">Payment method</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @MethodLabel
                            </BadgeCn>
                        </div>
                        @foreach (var item in _orderSummary)
                        {
                            <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                                <span class="font-medium text-muted-foreground text-xs">@item.Label</span>
                                <span class="font-mono text-sm">@item.Value</span>
                            </div>
                        }
                        <SeparatorCn />
                        <div class="flex items-center justify-between px-3 py-1">
                            <span class="font-medium text-sm">Total</span>
                            <span class="font-semibold text-lg tabular-nums">$268.92</span>
                        </div>
                    </div>
                </div>
            }

            @if (_activeStep == 3)
            {
                <div class="flex flex-col items-center py-6 text-center">
                    <div class="mb-4 flex size-12 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="shield-check" Size="24" Class="size-6 text-emerald-600 dark:text-emerald-400" />
                    </div>
                    <span class="font-medium text-sm">Payment successful</span>
                    <p class="mt-1 max-w-xs text-muted-foreground text-xs">
                        Your payment of $268.92 has been processed. A confirmation email has been sent to
                        alex@@example.com.
                    </p>
                    <div class="mt-4 space-y-2 w-full max-w-xs">
                        <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                            <span class="font-medium text-muted-foreground text-xs">Transaction ID</span>
                            <span class="font-mono text-muted-foreground text-xs">TXN-2026-84921</span>
                        </div>
                        <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                            <span class="font-medium text-muted-foreground text-xs">Method</span>
                            <span class="text-xs">@MethodLabel</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0 || _activeStep == _steps.Length - 1)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @if (_activeStep == 2)
                {
                    <LucideIconCn Name="lock" Size="12" Class="size-3" />
                    @:Pay $268.92
                }
                else if (_activeStep == _steps.Length - 1)
                {
                    @:Done
                }
                else
                {
                    @:Continue
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Description);
    private record PaymentMethodItem(string Id, string Label, string Description, string IconName);
    private record FieldItem(string Label, string Value);

    private static readonly StepItem[] _steps =
    [
        new("Method", "Choose payment method"),
        new("Details", "Enter payment information"),
        new("Verify", "Review your order"),
        new("Complete", "Payment confirmation"),
    ];

    private static readonly PaymentMethodItem[] _paymentMethods =
    [
        new("card", "Credit or debit card", "Visa, Mastercard, Amex", "credit-card"),
        new("bank", "Bank transfer", "ACH direct debit", "building"),
        new("wallet", "Digital wallet", "Apple Pay, Google Pay", "wallet"),
    ];

    private static readonly FieldItem[] _cardDetails =
    [
        new("Card number", "**** **** **** 4242"),
        new("Expiry date", "09 / 28"),
        new("Cardholder name", "Alex Johnson"),
        new("CVC", "***"),
    ];

    private static readonly FieldItem[] _bankDetails =
    [
        new("Bank name", "Chase"),
        new("Routing number", "****6789"),
        new("Account number", "****3210"),
        new("Account holder", "Alex Johnson"),
    ];

    private static readonly FieldItem[] _walletDetails =
    [
        new("Wallet", "Apple Pay"),
        new("Device", "iPhone 16 Pro"),
        new("Card on file", "Visa ending in 4242"),
        new("Authentication", "Face ID"),
    ];

    private static readonly FieldItem[] _orderSummary =
    [
        new("Subtotal", "$249.00"),
        new("Tax", "$19.92"),
        new("Shipping", "Free"),
    ];

    private int _activeStep = 0;
    private string _selectedMethod = "card";

    private string MethodLabel =>
        _paymentMethods.FirstOrDefault(m => m.Id == _selectedMethod)?.Label ?? "Card";

    private FieldItem[] GetDetailsByMethod(string method) => method switch
    {
        "bank" => _bankDetails,
        "wallet" => _walletDetails,
        _ => _cardDetails,
    };

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
