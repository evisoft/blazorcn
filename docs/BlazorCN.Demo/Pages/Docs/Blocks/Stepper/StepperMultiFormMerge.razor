@* ============================================================
   Block: stepper-multi-form-merge
   Title: StepperMultiFormMerge
   Description: A parallel multi-form stepper with independent form sections that converge into a final submission step built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-multi-form-merge.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Application form</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">
                    <span class="tabular-nums">@_completedCount</span> of
                    <span class="tabular-nums">@_totalCount</span> sections complete
                </span>
            </div>
            <div class="flex items-center gap-1.5">
                @foreach (var formSec in _formSections)
                {
                    var dotClass = _completedSections.Contains(formSec.Id)
                        ? "bg-emerald-500"
                        : _expandedSection == formSec.Id
                            ? "bg-foreground"
                            : "bg-muted-foreground/30";
                    <span class="@Cn.Merge("size-1.5 rounded-full transition-colors duration-200", dotClass)" />
                }
            </div>
        </div>

        @* Progress bar *@
        <div class="h-0.5 w-full bg-muted/50">
            <div
                class="h-full bg-emerald-500 transition-all duration-500 dark:bg-emerald-600"
                style="@($"width:{(_completedCount * 100.0 / _totalCount):F0}%")" />
        </div>

        @* Parallel form sections *@
        <div class="grid gap-0 md:grid-cols-3">
            @foreach (var entry in _formSections.Select((s, i) => new { Sec = s, Index = i }))
            {
                var formSec = entry.Sec;
                var idx = entry.Index;
                var status = GetStatus(formSec.Id);
                var isExpanded = _expandedSection == formSec.Id;
                var isLast = idx == _formSections.Length - 1;
                var secId = formSec.Id;
                var containerClass = !isLast ? "border-b md:border-b-0 md:border-r" : "";
                var iconStatusClass = status == "complete"
                    ? "bg-emerald-500 text-white dark:bg-emerald-600"
                    : status == "active"
                        ? "bg-foreground text-background"
                        : "border border-muted-foreground/25 text-muted-foreground";
                var contentClass = isExpanded ? "block" : "hidden";
                var chevronClass = Cn.Merge("size-3.5 shrink-0 text-muted-foreground/60 transition-transform duration-200 md:hidden", isExpanded ? "rotate-180" : "");

                <div class="@containerClass">
                    @* Section header *@
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(secId))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full transition-all duration-200", iconStatusClass)">
                            @if (status == "complete")
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                            }
                            else
                            {
                                <LucideIconCn Name="@formSec.IconName" Size="12" Class="size-3" />
                            }
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="block truncate font-medium text-xs">@formSec.Title</span>
                            <span class="block truncate text-muted-foreground text-xs opacity-70">@formSec.Description</span>
                        </div>
                        <LucideIconCn Name="chevron-down" Size="14" Class="@chevronClass" />
                    </button>

                    @* Section content — always visible on md+, toggleable on mobile *@
                    <div class="@contentClass md:block">
                        <div class="space-y-1.5 px-4 pb-3">
                            @foreach (var field in formSec.Fields)
                            {
                                <div class="rounded-md bg-muted/30 px-3 py-2">
                                    <span class="block font-medium text-muted-foreground text-xs">@field.Label</span>
                                    <span class="block text-sm">@field.Value</span>
                                </div>
                            }

                            @* Section action *@
                            <div class="pt-1" @onclick:stopPropagation>
                                <ButtonCn
                                    Variant="@(status == "complete" ? ButtonVariant.Ghost : ButtonVariant.Outline)"
                                    Size="ButtonSize.Sm"
                                    Class="h-7 w-full gap-1.5 text-xs"
                                    OnClick="@(() => ToggleComplete(secId))">
                                    @if (status == "complete")
                                    {
                                        <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                                        @: Completed
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="circle-dot" Size="12" Class="size-3" />
                                        @: Mark complete
                                    }
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Merge indicator *@
        <div class="flex items-center justify-center border-t bg-muted/20 py-3">
            <div class="flex items-center gap-2 text-muted-foreground">
                <div class="h-px w-8 bg-muted-foreground/20" />
                <LucideIconCn Name="merge" Size="14" Class="size-3.5 rotate-180" />
                <div class="h-px w-8 bg-muted-foreground/20" />
            </div>
        </div>

        @* Final merge step *@
        <div class="border-t px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <div>
                    <span class="font-medium text-sm">Review &amp; submit</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @(_allComplete
                            ? "All sections complete. Ready to submit."
                            : $"Complete all {_totalCount} sections to unlock submission")
                    </p>
                </div>
                @if (_allComplete)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Ready</BadgeCn>
                }
            </div>

            @* Summary of all sections *@
            @if (_allComplete)
            {
                <div class="mb-3 space-y-1.5">
                    @foreach (var formSec in _formSections)
                    {
                        <div class="flex items-center justify-between rounded-md bg-muted/30 px-3 py-2">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                                <span class="font-medium text-xs">@formSec.Title</span>
                            </div>
                            <span class="text-muted-foreground text-xs">@formSec.Fields.Length fields</span>
                        </div>
                    }
                </div>
            }

            <ButtonCn
                Size="ButtonSize.Sm"
                Class="h-8 w-full text-xs"
                Disabled="@(!_allComplete || _submitted)"
                OnClick="HandleSubmit">
                @if (_submitted)
                {
                    <span class="flex items-center gap-1.5">
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        Application submitted
                    </span>
                }
                else
                {
                    @: Submit application
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FormFieldItem(string Label, string Value);
    private record FormSectionItem(string Id, string Title, string Description, string IconName, FormFieldItem[] Fields);

    private static readonly FormSectionItem[] _formSections =
    [
        new("personal", "Personal info", "Name, email, and contact details", "user",
        [
            new("Full name", "Sarah Chen"),
            new("Email", "sarah.chen@acme.com"),
            new("Phone", "+1 (415) 555-0142"),
            new("Location", "San Francisco, CA"),
        ]),
        new("experience", "Work experience", "Employment history and skills", "briefcase",
        [
            new("Current role", "Senior Engineer"),
            new("Company", "Acme Inc."),
            new("Years of experience", "8 years"),
            new("Primary skill", "Full-stack TypeScript"),
        ]),
        new("references", "References", "Professional references", "users",
        [
            new("Reference 1", "James Park, CTO at Vercel"),
            new("Reference 2", "Maria Lopez, VP Eng at Stripe"),
            new("Relationship", "Former managers"),
            new("Contact method", "Email preferred"),
        ]),
    ];

    private HashSet<string> _completedSections = new HashSet<string> { "personal" };
    private string? _expandedSection = "experience";
    private bool _submitted = false;

    private bool _allComplete => _formSections.All(s => _completedSections.Contains(s.Id));
    private int _completedCount => _completedSections.Count;
    private int _totalCount => _formSections.Length;

    private string GetStatus(string id)
    {
        if (_completedSections.Contains(id)) return "complete";
        if (_expandedSection == id) return "active";
        return "pending";
    }

    private void ToggleComplete(string id)
    {
        if (_completedSections.Contains(id))
            _completedSections.Remove(id);
        else
            _completedSections.Add(id);
    }

    private void ToggleExpanded(string id)
    {
        _expandedSection = _expandedSection == id ? null : id;
    }

    private void HandleSubmit()
    {
        _submitted = true;
    }
}
