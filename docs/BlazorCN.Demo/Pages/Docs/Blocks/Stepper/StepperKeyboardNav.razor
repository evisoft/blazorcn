@* ============================================================
   Block: stepper-keyboard-nav
   Title: StepperKeyboardNav
   Description: A keyboard-accessible stepper with visible shortcut badges, arrow key hints, and focus ring indicators for data pipeline workflows built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-keyboard-nav.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="keyboard" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Data pipeline</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                <span class="tabular-nums">@(_activeStep + 1)</span> of
                <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Stepper with kbd hints *@
        <div class="border-b px-6 py-6">
            <div class="flex items-center">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var isActive = index == _activeStep;
                    var isCompleted = index < _activeStep;
                    <div class="flex flex-1 items-center last:flex-none">
                        <div class="flex flex-col items-center gap-2">
                            @* Step circle with focus ring for active *@
                            <button
                                type="button" aria-label="@($"Step {index + 1}: {stp.Label}")"
                                @onclick="@(() => HandleStepChange(index))"
                                class="@Cn.Merge("relative flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-full font-medium text-sm tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-foreground text-background ring-2 ring-foreground ring-offset-2 ring-offset-card" : "border-2 border-muted-foreground/25 text-muted-foreground")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="size-4" />
                                }
                                else
                                {
                                    <span>@(index + 1)</span>
                                }

                                @* Kbd shortcut badge *@
                                <span class="absolute -top-2 -right-2 flex size-5 items-center justify-center rounded border bg-background font-mono text-[10px] text-muted-foreground shadow-sm">
                                    @(index + 1)
                                </span>
                            </button>

                            <span class="@Cn.Merge("font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                @stp.Label
                            </span>
                        </div>

                        @* Connecting line *@
                        @if (index < _steps.Length - 1)
                        {
                            <div class="mx-3 mb-6 h-0.5 flex-1">
                                <div class="@Cn.Merge("h-full rounded-full transition-colors duration-300", index < _activeStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Step content *@
        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <span class="font-medium text-sm">@Current.Label</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@Current.Description</p>
            </div>
            <div class="space-y-2">
                @foreach (var field in Current.Fields)
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                        <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                        <span class="text-right font-mono text-xs">@field.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Keyboard hint bar *@
        <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2">
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5">
                    <span class="inline-flex size-5 items-center justify-center rounded border bg-background font-mono text-[10px] text-muted-foreground shadow-sm">
                        <LucideIconCn Name="arrow-left" Size="10" Class="size-2.5" />
                    </span>
                    <span class="inline-flex size-5 items-center justify-center rounded border bg-background font-mono text-[10px] text-muted-foreground shadow-sm">
                        <LucideIconCn Name="arrow-right" Size="10" Class="size-2.5" />
                    </span>
                    <span class="text-muted-foreground text-xs">Navigate</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="inline-flex size-5 items-center justify-center rounded border bg-background font-mono text-[10px] text-muted-foreground shadow-sm">
                        1
                    </span>
                    <span class="text-muted-foreground text-xs">-</span>
                    <span class="inline-flex size-5 items-center justify-center rounded border bg-background font-mono text-[10px] text-muted-foreground shadow-sm">
                        4
                    </span>
                    <span class="text-muted-foreground text-xs">Jump to step</span>
                </div>
            </div>
            <span class="text-muted-foreground/60 text-xs">Keyboard shortcuts</span>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Deploy" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FieldItem(string Label, string Value);
    private record StepItem(string Label, string Description, FieldItem[] Fields);

    private static readonly StepItem[] _steps =
    [
        new("Source", "Configure data source connection",
        [
            new("Connection type", "PostgreSQL"),
            new("Host", "db.acme-prod.internal:5432"),
            new("Database", "analytics_warehouse"),
            new("Tables selected", "12 of 48"),
        ]),
        new("Transform", "Define transformation rules",
        [
            new("Transform engine", "dbt Core v1.8"),
            new("Models", "7 staging, 4 intermediate, 3 marts"),
            new("Tests defined", "32 schema tests, 8 data tests"),
            new("Materialization", "Incremental with 24h lookback"),
        ]),
        new("Validate", "Run data quality checks",
        [
            new("Quality framework", "Great Expectations"),
            new("Expectations", "28 rules across 3 suites"),
            new("Threshold", "99.5% pass rate required"),
            new("Alert channel", "#data-quality-alerts"),
        ]),
        new("Output", "Set destination and scheduling",
        [
            new("Destination", "BigQuery — analytics.prod"),
            new("Format", "Parquet with Snappy compression"),
            new("Schedule", "Daily at 02:00 UTC"),
            new("Retention", "90 days with 7-day snapshots"),
        ]),
    ];

    private int _activeStep = 1;

    private StepItem Current => _steps[_activeStep];

    private void HandleStepChange(int index)
    {
        if (index >= 0 && index < _steps.Length)
        {
            _activeStep = index;
        }
    }

    private void HandleNext() => HandleStepChange(_activeStep + 1);
    private void HandleBack() => HandleStepChange(_activeStep - 1);
}
