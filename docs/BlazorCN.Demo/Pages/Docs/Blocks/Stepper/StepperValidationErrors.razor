@* ============================================================
   Block: stepper-validation-errors
   Title: StepperValidationErrors
   Description: A horizontal stepper with validation error and warning indicators, inline error messages, and fix actions built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-validation-errors.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Application form</span>
            <div class="flex items-center gap-2">
                @if (_totalErrors > 0)
                {
                    <span class="flex items-center gap-1.5 text-xs">
                        <span class="size-1.5 rounded-full bg-red-500" />
                        <span class="tabular-nums text-muted-foreground">
                            @_totalErrors @(_totalErrors == 1 ? "error" : "errors")
                        </span>
                    </span>
                }
                @if (_totalWarnings > 0)
                {
                    <span class="flex items-center gap-1.5 text-xs">
                        <span class="size-1.5 rounded-full bg-amber-500" />
                        <span class="tabular-nums text-muted-foreground">
                            @_totalWarnings @(_totalWarnings == 1 ? "warning" : "warnings")
                        </span>
                    </span>
                }
            </div>
        </div>

        @* Stepper *@
        <div class="border-b px-6 py-6">
            <div class="flex items-center">
                @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
                {
                    var idx = entry.Index;
                    var step = entry.Step;
                    var isActive = idx == _activeStep;

                    <div class="flex flex-1 items-center last:flex-none">
                        @* Step circle + label *@
                        <div class="flex flex-col items-center gap-2">
                            <button
                                type="button" aria-label="@($"Step {idx + 1}: {step.Label}")"
                                @onclick="@(() => HandleStepClick(idx))"
                                class="@Cn.Merge("relative flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-full font-medium text-sm tabular-nums transition-all duration-200", GetStatusCircleClass(step.Status), isActive ? Cn.Merge("ring-2 ring-offset-2 ring-offset-card", GetActiveRingClass(step.Status)) : "")">
                                @if (step.Status == StepStatus.Pending)
                                {
                                    <span>@(idx + 1)</span>
                                }
                                else if (step.Status == StepStatus.Valid)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="size-4" />
                                }
                                else if (step.Status == StepStatus.Error)
                                {
                                    <LucideIconCn Name="x" Size="16" Class="size-4" />
                                }
                                else if (step.Status == StepStatus.Warning)
                                {
                                    <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5" />
                                }

                                @* Error/warning count badge *@
                                @if (step.ErrorCount > 0)
                                {
                                    <span class="absolute -top-1 -right-1 flex size-4 items-center justify-center rounded-full bg-red-600 font-medium text-[10px] text-white tabular-nums">
                                        @step.ErrorCount
                                    </span>
                                }
                                @if (step.WarningCount > 0 && step.ErrorCount == 0)
                                {
                                    <span class="absolute -top-1 -right-1 flex size-4 items-center justify-center rounded-full bg-amber-600 font-medium text-[10px] text-white tabular-nums">
                                        @step.WarningCount
                                    </span>
                                }
                            </button>
                            <span class="@Cn.Merge("text-center font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                @step.Label
                            </span>
                        </div>

                        @* Connecting line *@
                        @if (idx < _steps.Length - 1)
                        {
                            <div class="mx-2 mb-6 h-0.5 flex-1">
                                <div class="@Cn.Merge("h-full rounded-full transition-colors duration-300", GetStatusLineClass(step.Status))" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Validation details for active step *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <div>
                    <span class="font-medium text-sm">@_current.Label</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @GetStepDescription(_current)
                    </p>
                </div>
                @if (_current.Status == StepStatus.Valid)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-emerald-600 text-xs dark:text-emerald-400">
                        <LucideIconCn Name="check" Size="12" Class="mr-1 size-3" />
                        Valid
                    </BadgeCn>
                }
            </div>

            @* Issues list *@
            @if (_current.Issues.Length > 0)
            {
                <div class="space-y-2">
                    @foreach (var issue in _current.Issues)
                    {
                        <div class="@Cn.Merge("rounded-md p-3", issue.IssueSeverity == Severity.Error ? "bg-red-500/10" : "bg-amber-500/10")">
                            <div class="mb-1 flex items-center gap-2">
                                <span class="@Cn.Merge("size-1.5 rounded-full", issue.IssueSeverity == Severity.Error ? "bg-red-500" : "bg-amber-500")" />
                                <span class="font-medium text-xs">@issue.Field</span>
                            </div>
                            <p class="pl-3.5 text-muted-foreground text-sm leading-relaxed">
                                @issue.Message
                            </p>
                        </div>
                    }
                </div>
            }

            @* Empty state for valid *@
            @if (_current.Issues.Length == 0 && _current.Status == StepStatus.Valid)
            {
                <div class="rounded-md bg-emerald-500/10 p-3">
                    <p class="text-sm leading-relaxed">
                        All required fields have been filled in correctly. You can proceed to the next step
                        or go back to make changes.
                    </p>
                </div>
            }

            @* Empty state for pending *@
            @if (_current.Issues.Length == 0 && _current.Status == StepStatus.Pending)
            {
                <div class="rounded-md bg-muted/50 p-3">
                    <p class="text-muted-foreground text-sm leading-relaxed">
                        This step will be available after all previous steps pass validation.
                    </p>
                </div>
            }
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <div class="flex items-center gap-2">
                @if (_current.Status == StepStatus.Error)
                {
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 border-red-500/30 text-red-600 text-xs hover:bg-red-500/10 dark:text-red-400">
                        Fix errors
                    </ButtonCn>
                }
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1 || _current.Status == StepStatus.Error)">
                    @(_activeStep == _steps.Length - 1 ? "Submit" : "Continue")
                    @if (_activeStep < _steps.Length - 1)
                    {
                        <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                    }
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private enum StepStatus { Valid, Error, Warning, Pending }
    private enum Severity { Error, Warning }

    private record ValidationIssue(string Id, Severity IssueSeverity, string Field, string Message);
    private record StepData(string Label, StepStatus Status, int ErrorCount, int WarningCount, ValidationIssue[] Issues);

    private int _activeStep = 1;

    private static readonly StepData[] _steps =
    [
        new("Basic info", StepStatus.Valid, 0, 0, []),
        new("Contact", StepStatus.Error, 2, 0,
        [
            new("e1", Severity.Error, "Email address", "Invalid email format. Must include @ and a valid domain."),
            new("e2", Severity.Error, "Phone number", "Phone number must be at least 10 digits with country code."),
        ]),
        new("Documents", StepStatus.Warning, 0, 1,
        [
            new("w1", Severity.Warning, "ID verification", "Document uploaded but image quality is low. Consider re-uploading for faster review."),
        ]),
        new("Submit", StepStatus.Pending, 0, 0, []),
    ];

    private StepData _current => _steps[_activeStep];
    private int _totalErrors => _steps.Sum(s => s.ErrorCount);
    private int _totalWarnings => _steps.Sum(s => s.WarningCount);

    private static string GetStatusCircleClass(StepStatus status) => status switch
    {
        StepStatus.Valid => "bg-emerald-500 text-white dark:bg-emerald-600",
        StepStatus.Error => "bg-red-500 text-white dark:bg-red-600",
        StepStatus.Warning => "bg-amber-500 text-white dark:bg-amber-600",
        _ => "border-2 border-muted-foreground/25 text-muted-foreground",
    };

    private static string GetStatusLineClass(StepStatus status) => status switch
    {
        StepStatus.Valid => "bg-emerald-500 dark:bg-emerald-600",
        StepStatus.Error => "bg-red-500/40",
        StepStatus.Warning => "bg-amber-500/40",
        _ => "bg-muted-foreground/20",
    };

    private static string GetActiveRingClass(StepStatus status) => status switch
    {
        StepStatus.Error => "ring-red-500 dark:ring-red-400",
        StepStatus.Warning => "ring-amber-500 dark:ring-amber-400",
        StepStatus.Valid => "ring-emerald-500 dark:ring-emerald-400",
        _ => "ring-muted-foreground/40",
    };

    private static string GetStepDescription(StepData current) => current.Status switch
    {
        StepStatus.Valid => "All fields validated successfully",
        StepStatus.Error => $"{current.ErrorCount} validation {(current.ErrorCount == 1 ? "error" : "errors")} found",
        StepStatus.Warning => $"{current.WarningCount} {(current.WarningCount == 1 ? "warning" : "warnings")} to review",
        _ => "Complete previous steps to continue",
    };

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
            _activeStep++;
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
            _activeStep--;
    }

    private void HandleStepClick(int index)
    {
        _activeStep = index;
    }
}
