@* ============================================================
   Block: stepper-horizontal-icons
   Title: StepperHorizontalIcons
   Description: A horizontal icon-based stepper with unique icons per step, connecting lines, and step content area built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-horizontal-icons.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Account setup</span>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Configure your account in a few quick steps
            </p>
        </div>

        @* Stepper *@
        <div class="border-b px-8 py-6">
            <div class="flex items-center">
                @for (var i = 0; i < _steps.Length; i++)
                {
                    var index = i;
                    var step = _steps[index];
                    var isCompleted = index < _activeStep;
                    var isActive = index == _activeStep;
                    var isUpcoming = index > _activeStep;
                    <div class="flex flex-1 items-center last:flex-none">
                        <div class="flex flex-col items-center gap-2">
                            <button
                                type="button"
                                @onclick="@(() => HandleStepClick(index))"
                                disabled="@isUpcoming"
                                class="@Cn.Merge("flex size-10 shrink-0 items-center justify-center rounded-full transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600 cursor-pointer" : isActive ? "bg-blue-500 text-white ring-4 ring-blue-500/15 dark:bg-blue-600 dark:ring-blue-400/15 cursor-pointer" : "border border-muted-foreground/25 text-muted-foreground cursor-default")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="size-4" />
                                }
                                else
                                {
                                    <LucideIconCn Name="@step.IconName" Size="16" Class="size-4" />
                                }
                            </button>
                            <div class="flex flex-col items-center text-center">
                                <span class="@Cn.Merge("font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                    @step.Label
                                </span>
                                <span class="hidden text-muted-foreground text-[10px] sm:block">
                                    @step.Description
                                </span>
                            </div>
                        </div>

                        @* Connecting line *@
                        @if (index < _steps.Length - 1)
                        {
                            <div class="mx-3 mb-8 h-0.5 flex-1">
                                <div class="@Cn.Merge("h-full rounded-full transition-colors duration-300", index < _activeStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/15")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Content *@
        <div class="border-b px-4 py-4">
            <span class="font-medium text-sm">@_steps[_activeStep].Content.Heading</span>
            <div class="mt-3 space-y-2">
                @foreach (var item in _steps[_activeStep].Content.Items)
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                        <span class="font-medium text-muted-foreground text-xs">@item.Label</span>
                        <span class="text-sm">@item.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeStep == 0)" OnClick="HandleBack">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <div class="flex items-center gap-1.5">
                @for (var i = 0; i < _steps.Length; i++)
                {
                    var dotIndex = i;
                    <span class="@Cn.Merge("size-1.5 rounded-full transition-colors", dotIndex <= _activeStep ? "bg-foreground" : "bg-muted-foreground/30")"></span>
                }
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeStep == _steps.Length - 1)" OnClick="HandleNext">
                @(_activeStep == _steps.Length - 1 ? "Done" : "Next")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ContentItem(string Label, string Value);
    private record StepContent(string Heading, ContentItem[] Items);
    private record StepItem(string Label, string Description, string IconName, StepContent Content);

    private static readonly StepItem[] _steps =
    [
        new("Account", "Create your account", "user", new StepContent(
            "Account details",
            [
                new("Username", "alexjohnson"),
                new("Display name", "Alex Johnson"),
                new("Role", "Administrator"),
            ])),
        new("Notifications", "Configure alerts", "mail", new StepContent(
            "Notification preferences",
            [
                new("Email alerts", "Enabled"),
                new("Push notifications", "Critical only"),
                new("Weekly digest", "Every Monday"),
            ])),
        new("Billing", "Payment method", "credit-card", new StepContent(
            "Billing information",
            [
                new("Plan", "Pro — $29/mo"),
                new("Payment method", "Visa ending in 4242"),
                new("Next billing date", "April 15, 2026"),
            ])),
        new("Complete", "All set", "check-circle", new StepContent(
            "Setup complete",
            [
                new("Account", "alexjohnson"),
                new("Plan", "Pro — $29/mo"),
                new("Status", "Active"),
            ])),
    ];

    private int _activeStep = 1;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
            _activeStep++;
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
            _activeStep--;
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
            _activeStep = index;
    }
}
