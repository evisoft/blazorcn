@* ============================================================
   Block: stepper-analytics-sidebar
   Title: StepperAnalyticsSidebar
   Description: A two-panel stepper wizard with a vertical step navigation on the left and a live analytics dashboard sidebar on the right showing per-step metrics, completion rates, and drop-off data built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-analytics-sidebar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">User activation funnel</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@(_steps.Length)</span>
            </BadgeCn>
        </div>

        @* Split layout *@
        <div class="flex">
            @* Left panel — stepper *@
            <div class="flex min-w-0 flex-1 flex-col">
                @* Vertical stepper *@
                <div class="flex-1 px-4 py-4">
                    <div class="space-y-0">
                        @foreach (var stepItem in _steps)
                        {
                            var index = Array.IndexOf(_steps, stepItem);
                            var isActive = index == _activeStep;
                            var isCompleted = index < _activeStep;
                            var isLast = index == _steps.Length - 1;
                            var capturedIndex = index;
                            <div class="flex gap-3">
                                <div class="flex flex-col items-center">
                                    <button
                                        type="button" aria-label="@($"Step {index + 1}: {stepItem.Label}")"
                                        @onclick="@(() => _activeStep = capturedIndex)"
                                        class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full font-medium text-xs tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-foreground text-background" : "border-2 border-muted-foreground/25 text-muted-foreground")">
                                        @if (isCompleted)
                                        {
                                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                                        }
                                        else
                                        {
                                            <span>@(index + 1)</span>
                                        }
                                    </button>
                                    @if (!isLast)
                                    {
                                        <div class="my-1 h-6 w-0.5 rounded-full bg-muted-foreground/10">
                                            <div
                                                class="w-full rounded-full bg-emerald-500 transition-all duration-300"
                                                style="@($"height:{(index < _activeStep ? "100%" : "0%")}")">
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="@Cn.Merge("min-w-0 flex-1", isLast ? "pb-0" : "pb-3")">
                                    <span class="@Cn.Merge("block font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                        @stepItem.Label
                                    </span>
                                    <span class="block text-muted-foreground text-xs opacity-70">
                                        @stepItem.Description
                                    </span>
                                </div>
                            </div>
                        }
                    </div>

                    @* Active step content *@
                    <SeparatorCn Class="my-4" />
                    <div>
                        <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
                        <p class="mt-0.5 mb-3 text-muted-foreground text-xs">
                            @_steps[_activeStep].Description
                        </p>
                        <div class="space-y-2">
                            @foreach (var field in _steps[_activeStep].Fields)
                            {
                                <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                                    <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                                    <span class="text-sm">@field.Value</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* Navigation *@
                <SeparatorCn />
                <div class="flex items-center justify-between px-4 py-3">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                        <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                        Back
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                        @(_activeStep == _steps.Length - 1 ? "Complete" : "Continue")
                        @if (_activeStep < _steps.Length - 1)
                        {
                            <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                        }
                    </ButtonCn>
                </div>
            </div>

            @* Right panel — analytics *@
            <div class="w-64 shrink-0 border-l bg-muted/20">
                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="bar-chart-3" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="font-medium text-xs">Funnel analytics</span>
                    </div>
                </div>

                @* Overall stats *@
                <div class="border-b px-4 py-3">
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <span class="block text-muted-foreground text-xs">Completion</span>
                            <span class="font-semibold text-lg tabular-nums text-amber-600 dark:text-amber-400">
                                @_overallCompletion%
                            </span>
                        </div>
                        <div>
                            <span class="block text-muted-foreground text-xs">Sessions</span>
                            <span class="font-semibold text-lg tabular-nums">
                                @((_totalSessions / 1000.0).ToString("F1"))k
                            </span>
                        </div>
                    </div>
                    <div class="mt-2 flex items-center gap-2">
                        <span class="flex items-center gap-1 text-muted-foreground text-xs">
                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                            Avg: @_avgTotalTime
                        </span>
                    </div>
                </div>

                @* Per-step metrics for active step *@
                <div class="border-b px-4 py-3">
                    <div class="mb-2 flex items-center justify-between">
                        <span class="font-medium text-muted-foreground text-xs">
                            Step @(_activeStep + 1): @_steps[_activeStep].Label
                        </span>
                    </div>

                    <div class="space-y-2.5">
                        <div class="flex items-center justify-between">
                            <span class="text-muted-foreground text-xs">Avg. time</span>
                            <span class="font-medium text-xs tabular-nums">@_stepMetrics[_activeStep].AvgTime</span>
                        </div>
                        <div>
                            <div class="flex items-center justify-between">
                                <span class="text-muted-foreground text-xs">Completion</span>
                                <span class="font-medium text-xs tabular-nums">
                                    @_stepMetrics[_activeStep].CompletionRate%
                                </span>
                            </div>
                            <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-muted-foreground/10">
                                <div
                                    class="@Cn.Merge("h-full rounded-full transition-all duration-300", _stepMetrics[_activeStep].CompletionRate >= 80 ? "bg-emerald-500" : _stepMetrics[_activeStep].CompletionRate >= 60 ? "bg-amber-500" : "bg-red-500")"
                                    style="@($"width:{_stepMetrics[_activeStep].CompletionRate}%")">
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-muted-foreground text-xs">Drop-off</span>
                            <span class="@Cn.Merge("font-medium text-xs tabular-nums", _stepMetrics[_activeStep].DropOffRate >= 10 ? "text-red-600 dark:text-red-400" : "text-muted-foreground")">
                                @_stepMetrics[_activeStep].DropOffRate%
                            </span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-muted-foreground text-xs">Sessions</span>
                            <span class="font-medium text-xs tabular-nums">
                                @_stepMetrics[_activeStep].Sessions.ToString("N0")
                            </span>
                        </div>
                    </div>
                </div>

                @* Highlights *@
                <div class="px-4 py-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">
                        Highlights
                    </span>
                    <div class="space-y-2">
                        <div class="flex items-start gap-2">
                            <LucideIconCn Name="zap" Size="12" Class="mt-0.5 size-3 shrink-0 text-emerald-500" />
                            <span class="text-xs leading-relaxed">
                                <span class="font-medium">@_fastestStep</span> is the fastest step at @_stepMetrics[0].AvgTime avg
                            </span>
                        </div>
                        <div class="flex items-start gap-2">
                            <LucideIconCn Name="trending-down" Size="12" Class="mt-0.5 size-3 shrink-0 text-red-500" />
                            <span class="text-xs leading-relaxed">
                                <span class="font-medium">@_dropOffStep</span> has the highest drop-off at @_stepMetrics[2].DropOffRate%
                            </span>
                        </div>
                        <div class="flex items-start gap-2">
                            <LucideIconCn Name="trending-up" Size="12" Class="mt-0.5 size-3 shrink-0 text-emerald-500" />
                            <span class="text-xs leading-relaxed">
                                <span class="font-medium">Signup</span> conversion improved <span class="tabular-nums">+3.2%</span> this week
                            </span>
                        </div>
                        <div class="flex items-start gap-2">
                            <LucideIconCn Name="users" Size="12" Class="mt-0.5 size-3 shrink-0 text-muted-foreground" />
                            <span class="text-xs leading-relaxed">
                                <span class="tabular-nums">6,208</span> users reached the final step
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record StepField(string Label, string Value);
    private record StepItem(string Label, string Description, StepField[] Fields);
    private record StepMetric(string AvgTime, int CompletionRate, int DropOffRate, int Sessions);

    private int _activeStep = 2;

    private static readonly StepItem[] _steps =
    [
        new("Signup", "Account creation and email verification",
        [
            new("Email", "user@@acme.com"),
            new("Verification", "Code sent to inbox"),
            new("Password strength", "Strong (12+ chars)"),
        ]),
        new("Onboarding", "Team and workspace setup",
        [
            new("Workspace name", "Acme Engineering"),
            new("Team size", "10-50 members"),
            new("Industry", "SaaS / Developer Tools"),
        ]),
        new("Payment", "Plan selection and billing details",
        [
            new("Selected plan", "Team ($79/month)"),
            new("Payment method", "Visa ending in 4242"),
            new("Billing cycle", "Annual (save 20%)"),
        ]),
        new("Activation", "First project and integrations",
        [
            new("First project", "Production API"),
            new("Integration", "GitHub connected"),
            new("First deploy", "Preview deployed"),
        ]),
        new("Engaged", "Active usage confirmed",
        [
            new("DAU status", "Active 5 of last 7 days"),
            new("Features used", "8 of 12 core features"),
            new("Team invites", "4 members joined"),
        ]),
    ];

    private static readonly StepMetric[] _stepMetrics =
    [
        new("45s", 94, 6, 12840),
        new("2m 12s", 87, 7, 12067),
        new("3m 38s", 73, 14, 10498),
        new("1m 55s", 81, 8, 7664),
        new("—", 68, 13, 6208),
    ];

    private const int _totalSessions = 12840;
    private const int _overallCompletion = 48;
    private const string _avgTotalTime = "8m 30s";
    private const string _fastestStep = "Signup";
    private const string _dropOffStep = "Payment";

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1) _activeStep++;
    }

    private void HandleBack()
    {
        if (_activeStep > 0) _activeStep--;
    }
}
