@* ============================================================
   Block: stepper-parallel-tracks
   Title: StepperParallelTracks
   Description: A multi-track stepper wizard with independent parallel workflows that converge at a shared integration step built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-parallel-tracks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Release pipeline</span>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs tabular-nums">
                    @CompletedSteps of @TotalSteps complete
                </span>
                <div class="h-1.5 w-24 overflow-hidden rounded-full bg-muted/50">
                    <div
                        class="h-full rounded-full bg-emerald-500 transition-all duration-300 dark:bg-emerald-600"
                        style="@(FormattableString.Invariant($"width:{(double)CompletedSteps / TotalSteps * 100}%"))">
                    </div>
                </div>
            </div>
        </div>

        @* Parallel tracks *@
        <div class="grid grid-cols-3 divide-x border-b">
            @foreach (var trk in _tracks)
            {
                var track = trk;
                var progress = _trackProgress[track.Id];
                var isTrackComplete = progress == track.Steps.Length;

                <div>
                    @* Track header *@
                    <div class="flex items-center gap-2 border-b px-3 py-2.5">
                        <LucideIconCn Name="@track.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="font-medium text-sm">@track.Name</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("ml-auto font-normal text-xs tabular-nums", isTrackComplete ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "")">
                            @($"{progress}/{track.Steps.Length}")
                        </BadgeCn>
                    </div>

                    @* Track steps *@
                    <div>
                        @for (int si = 0; si < track.Steps.Length; si++)
                        {
                            var sIdx = si;
                            var step = track.Steps[sIdx];
                            var isCompleted = sIdx < progress;
                            var isActive = sIdx == progress;
                            var isUpcoming = sIdx > progress;
                            var isLast = sIdx == track.Steps.Length - 1;

                            <div class="@(isLast ? "" : "border-b border-dashed")">
                                <button
                                    type="button"
                                    @onclick="@(() => HandleStepClick(track.Id, sIdx))"
                                    disabled="@isUpcoming"
                                    class="@Cn.Merge("flex w-full items-center gap-2.5 px-3 py-2.5 text-left transition-colors", isUpcoming ? "cursor-default opacity-40" : isActive ? "bg-muted/30" : "cursor-pointer hover:bg-muted/50")">

                                    @* Step indicator *@
                                    <span class="@Cn.Merge("flex size-5 shrink-0 items-center justify-center rounded-full text-xs transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "bg-foreground text-background" : "border border-muted-foreground/20 text-muted-foreground")">
                                        @if (isCompleted)
                                        {
                                            <LucideIconCn Name="check" Size="10" Class="size-2.5" />
                                        }
                                        else
                                        {
                                            <span class="font-medium tabular-nums text-xs">@(sIdx + 1)</span>
                                        }
                                    </span>

                                    <span class="@Cn.Merge("text-sm", isActive ? "font-medium text-foreground" : isCompleted ? "text-muted-foreground" : "text-muted-foreground/60")">
                                        @step.Label
                                    </span>
                                </button>
                            </div>
                        }
                    </div>

                    @* Track action *@
                    <div class="border-t px-3 py-2.5">
                        @if (isTrackComplete)
                        {
                            <div class="flex items-center gap-1.5">
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500 dark:text-emerald-400" />
                                <span class="text-emerald-600 text-xs dark:text-emerald-400">Complete</span>
                            </div>
                        }
                        else
                        {
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 w-full gap-1 text-xs" OnClick="@(() => AdvanceTrack(track.Id))">
                                Advance
                                <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
                            </ButtonCn>
                        }
                    </div>
                </div>
            }
        </div>

        @* Convergence / Integration step *@
        <div class="px-4 py-4">
            <div class="mb-3 flex items-center gap-3">
                <div class="flex items-center gap-2">
                    @foreach (var trk in _tracks)
                    {
                        var track = trk;
                        var isComplete = _trackProgress[track.Id] == track.Steps.Length;
                        <span class="@Cn.Merge("size-1.5 rounded-full transition-colors", isComplete ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                    }
                </div>
                <div class="h-px flex-1 bg-muted-foreground/15"></div>
                <span class="@Cn.Merge("flex size-7 items-center justify-center rounded-full text-xs transition-all duration-200", _integrationComplete ? "bg-emerald-500 text-white dark:bg-emerald-600" : AllTracksComplete ? "bg-foreground text-background" : "border border-muted-foreground/25 text-muted-foreground")">
                    @if (_integrationComplete)
                    {
                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                    }
                    else
                    {
                        <span class="font-medium">*</span>
                    }
                </span>
                <div class="h-px flex-1 bg-muted-foreground/15"></div>
            </div>

            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-sm">Integration</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @(AllTracksComplete ? "All tracks complete. Ready to integrate." : "Waiting for all tracks to complete before integration")
                    </p>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" Disabled="@(!AllTracksComplete || _integrationComplete)" OnClick="@(() => { _integrationComplete = true; })">
                    @(_integrationComplete ? "Integrated" : "Integrate")
                    @if (!_integrationComplete)
                    {
                        <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
                    }
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record TrackStepData(string Id, string Label);
    private record TrackData(string Id, string Name, string Icon, TrackStepData[] Steps);

    private static readonly TrackData[] _tracks =
    [
        new("frontend", "Frontend", "code",
        [
            new("fe-scaffold", "Scaffold app"),
            new("fe-components", "Build components"),
            new("fe-styles", "Design system"),
            new("fe-testing", "Test suite"),
        ]),
        new("backend", "Backend", "server",
        [
            new("be-schema", "Database schema"),
            new("be-api", "API endpoints"),
            new("be-auth", "Authentication"),
        ]),
        new("devops", "DevOps", "container",
        [
            new("do-infra", "Infrastructure"),
            new("do-cicd", "CI/CD pipeline"),
        ]),
    ];

    private Dictionary<string, int> _trackProgress = new()
    {
        ["frontend"] = 2,
        ["backend"] = 1,
        ["devops"] = 1,
    };

    private bool _integrationComplete = false;

    private bool AllTracksComplete => _tracks.All(t => _trackProgress[t.Id] == t.Steps.Length);
    private int TotalSteps => _tracks.Sum(t => t.Steps.Length) + 1;
    private int CompletedSteps => _tracks.Sum(t => _trackProgress[t.Id]) + (_integrationComplete ? 1 : 0);

    private void HandleStepClick(string trackId, int stepIndex)
    {
        var currentProgress = _trackProgress[trackId];
        if (stepIndex <= currentProgress)
        {
            _trackProgress[trackId] = stepIndex;
        }
    }

    private void AdvanceTrack(string trackId)
    {
        var track = _tracks.First(t => t.Id == trackId);
        var current = _trackProgress[trackId];
        if (current < track.Steps.Length)
        {
            _trackProgress[trackId] = current + 1;
        }
    }
}
