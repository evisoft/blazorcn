@* ============================================================
   Block: stepper-circular-wheel
   Title: StepperCircularWheel
   Description: A radial wheel stepper with steps arranged on a circle perimeter, arc progress segments, and dynamic center content built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-circular-wheel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="compass" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Development cycle</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Phase <span class="tabular-nums">@(_activeStep + 1)</span> of <span class="tabular-nums">@_steps.Length</span>
            </BadgeCn>
        </div>

        @* Circular wheel *@
        <div class="border-b px-4 py-6">
            <div class="flex justify-center">
                <div class="relative" style="width:280px;height:280px;">
                    <svg viewBox="0 0 280 280" width="280" height="280" class="absolute inset-0"
                         aria-label="Circular progress wheel with step indicators">
                        <title>Development cycle wheel</title>

                        @* Background circle track *@
                        <circle cx="140" cy="140" r="105" fill="none" stroke="currentColor" stroke-width="2.5"
                                class="text-muted-foreground/10" />

                        @* Arc segments *@
                        @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
                        {
                            var idx = entry.Index;
                            var segStart = _startAngle + ((double)idx / _steps.Length) * 360.0 + 3.0;
                            var segEnd = _startAngle + ((double)(idx + 1) / _steps.Length) * 360.0 - 3.0;
                            var isSegmentCompleted = idx < _activeStep;
                            var arcClass = isSegmentCompleted
                                ? "transition-colors duration-500 text-emerald-500 dark:text-emerald-600"
                                : idx == _activeStep
                                    ? "transition-colors duration-500 text-blue-500 dark:text-blue-400"
                                    : "transition-colors duration-500 text-muted-foreground/15";
                            var arcD = DescribeArc(_cx, _cy, _radius, segStart, segEnd);
                            <path d="@arcD" fill="none" stroke="currentColor" stroke-width="3"
                                  stroke-linecap="round" class="@arcClass" />
                        }

                        @* Connector line from active dot to center *@
                        @{
                            var activePos = GetPosition(_activeStep, _steps.Length);
                        }
                        <line x1="@activePos.X.ToString("F2")" y1="@activePos.Y.ToString("F2")"
                              x2="140" y2="140"
                              stroke="currentColor" stroke-width="1" stroke-dasharray="3 3"
                              class="text-blue-500/20 dark:text-blue-400/20" />
                    </svg>

                    @* Center content *@
                    <div class="absolute inset-0 flex items-center justify-center">
                        <div class="flex flex-col items-center gap-1 text-center" style="max-width:120px;">
                            <span class="font-semibold text-2xl tabular-nums text-foreground">@(_activeStep + 1)</span>
                            <span class="font-medium text-sm text-foreground">@_steps[_activeStep].Label</span>
                            <span class="text-muted-foreground text-xs leading-tight">@_steps[_activeStep].Description</span>
                        </div>
                    </div>

                    @* Step dots on perimeter *@
                    @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
                    {
                        var idx = entry.Index;
                        var step = entry.Step;
                        var pos = GetPosition(idx, _steps.Length);
                        var isCompleted = idx < _activeStep;
                        var isActive = idx == _activeStep;
                        var dotClass = isCompleted
                            ? "flex items-center justify-center rounded-full transition-all duration-300 size-8 bg-emerald-500 text-white dark:bg-emerald-600"
                            : isActive
                                ? "flex items-center justify-center rounded-full transition-all duration-300 size-9 bg-blue-500 text-white shadow-lg shadow-blue-500/25 dark:bg-blue-600 dark:shadow-blue-400/25"
                                : "flex items-center justify-center rounded-full transition-all duration-300 size-8 border-2 border-muted-foreground/20 bg-card text-muted-foreground hover:border-muted-foreground/40";
                        var capturedIdx = idx;
                        <button type="button"
                                @onclick="@(() => SetActiveStep(capturedIdx))"
                                class="absolute -translate-x-1/2 -translate-y-1/2"
                                style="@($"left:{pos.X.ToString("F2")}px;top:{pos.Y.ToString("F2")}px;")">
                            <div class="@dotClass">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <span class="font-medium text-xs tabular-nums">@(idx + 1)</span>
                                }
                            </div>
                        </button>
                    }

                    @* Labels positioned outside the wheel *@
                    @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
                    {
                        var idx = entry.Index;
                        var step = entry.Step;
                        var labelRadius = _radius + 32.0;
                        var angle = _startAngle + ((double)idx / _steps.Length) * 360.0;
                        var rad = angle * Math.PI / 180.0;
                        var lx = _cx + labelRadius * Math.Cos(rad);
                        var ly = _cy + labelRadius * Math.Sin(rad);
                        var isActive = idx == _activeStep;
                        var labelClass = isActive
                            ? "absolute -translate-x-1/2 -translate-y-1/2 whitespace-nowrap text-xs font-medium text-foreground"
                            : "absolute -translate-x-1/2 -translate-y-1/2 whitespace-nowrap text-xs text-muted-foreground";
                        <span class="@labelClass" style="@($"left:{lx.ToString("F2")}px;top:{ly.ToString("F2")}px;")">
                            @step.Label
                        </span>
                    }
                </div>
            </div>
        </div>

        @* Step detail *@
        <div class="border-b px-4 py-4">
            <div class="rounded-md bg-muted/50 p-3">
                <span class="font-medium text-muted-foreground text-xs">Current progress</span>
                <p class="mt-1 text-sm leading-relaxed">@_steps[_activeStep].Detail</p>
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Previous
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Complete" : "Next phase")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record WheelStep(string Label, string Description, string Detail);

    private const double _cx = 140.0;
    private const double _cy = 140.0;
    private const double _radius = 105.0;
    private const double _startAngle = -90.0;

    private int _activeStep = 2;

    private static readonly WheelStep[] _steps =
    [
        new("Plan", "Define scope and requirements",
            "Stakeholder alignment complete, user stories written, roadmap drafted"),
        new("Design", "Create wireframes and prototypes",
            "Figma designs approved, component specs documented, design tokens set"),
        new("Build", "Develop core features",
            "Frontend scaffolded, API layer integrated, database schema deployed"),
        new("Test", "Quality assurance and validation",
            "Unit tests at 92% coverage, integration tests passing, QA sign-off"),
        new("Ship", "Deploy to production",
            "Staging verified, production deployed, monitoring alerts configured"),
        new("Iterate", "Gather feedback and improve",
            "Analytics reviewed, user interviews scheduled, v2 backlog prioritized"),
    ];

    private struct StepPosition
    {
        public double X { get; init; }
        public double Y { get; init; }
        public double Angle { get; init; }
    }

    private static StepPosition GetPosition(int index, int total)
    {
        var angle = _startAngle + ((double)index / total) * 360.0;
        var rad = angle * Math.PI / 180.0;
        return new StepPosition
        {
            X = _cx + _radius * Math.Cos(rad),
            Y = _cy + _radius * Math.Sin(rad),
            Angle = angle,
        };
    }

    private static string DescribeArc(double centerX, double centerY, double r, double startDeg, double endDeg)
    {
        var startRad = startDeg * Math.PI / 180.0;
        var endRad = endDeg * Math.PI / 180.0;
        var x1 = centerX + r * Math.Cos(startRad);
        var y1 = centerY + r * Math.Sin(startRad);
        var x2 = centerX + r * Math.Cos(endRad);
        var y2 = centerY + r * Math.Sin(endRad);
        var diff = endDeg - startDeg;
        var largeArc = diff > 180 ? 1 : 0;
        return $"M {x1.ToString("F4")} {y1.ToString("F4")} A {r} {r} 0 {largeArc} 1 {x2.ToString("F4")} {y2.ToString("F4")}";
    }

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void SetActiveStep(int index)
    {
        _activeStep = index;
    }
}
