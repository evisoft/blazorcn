@* ============================================================
   Block: stepper-breadcrumb-chevrons
   Title: StepperBreadcrumbChevrons
   Description: A breadcrumb-style stepper with chevron-shaped segments, progress tracking, and step content built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-breadcrumb-chevrons.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Checkout</span>
        </div>

        @* Breadcrumb stepper *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-0.5">
                @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
                {
                    var idx = entry.Index;
                    var step = entry.Step;
                    var isCompleted = idx < _currentStep;
                    var isActive = idx == _currentStep;
                    var isUpcoming = idx > _currentStep;
                    var isFirst = idx == 0;
                    var isLast = idx == _steps.Length - 1;

                    var clipPath = isFirst
                        ? "polygon(0 0, calc(100% - 8px) 0, 100% 50%, calc(100% - 8px) 100%, 0 100%)"
                        : isLast
                            ? "polygon(8px 0, 100% 0, 100% 100%, 8px 100%, 0 50%)"
                            : "polygon(8px 0, calc(100% - 8px) 0, 100% 50%, calc(100% - 8px) 100%, 8px 100%, 0 50%)";

                    var roundedClass = isFirst ? "rounded-l-md" : isLast ? "rounded-r-md" : "";

                    var colorClass = isCompleted
                        ? "bg-emerald-500/10 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-400 cursor-pointer"
                        : isActive
                            ? "bg-foreground text-background cursor-pointer"
                            : "bg-muted/50 text-muted-foreground cursor-default";

                    <button
                        type="button"
                        @onclick="@(() => HandleStepClick(idx))"
                        disabled="@isUpcoming"
                        class="@Cn.Merge("relative flex h-9 flex-1 items-center justify-center text-xs font-medium transition-colors duration-200", roundedClass, colorClass)"
                        style="@($"clip-path:{clipPath}")">
                        @if (isCompleted)
                        {
                            <span class="flex items-center gap-1">
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                                @step.Label
                            </span>
                        }
                        else
                        {
                            @step.Label
                        }
                    </button>
                }
            </div>
        </div>

        @* Content *@
        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <span class="font-medium text-sm">@_steps[_currentStep].Heading</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_steps[_currentStep].Description
                </p>
            </div>
            <div class="space-y-2">
                @foreach (var item in _steps[_currentStep].Items)
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                        <span class="font-medium text-muted-foreground text-xs">@item.Label</span>
                        <span class="text-sm">@item.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_currentStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <span class="text-muted-foreground text-xs tabular-nums">
                @(_currentStep + 1) / @_steps.Length
            </span>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_currentStep == _steps.Length - 1)">
                @(_currentStep == _steps.Length - 1 ? "Place order" : "Continue")
                @if (_currentStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Value);
    private record StepData(string Label, string Heading, string Description, StepItem[] Items);

    private int _currentStep = 2;

    private static readonly StepData[] _steps =
    [
        new("Cart", "Shopping cart", "Review the items in your cart",
            [
                new("Wireless Headphones", "$89.00"),
                new("USB-C Cable (2m)", "$12.00"),
                new("Subtotal", "$101.00"),
            ]),
        new("Shipping", "Shipping details", "Where should we send your order?",
            [
                new("Address", "742 Evergreen Terrace"),
                new("City", "Springfield, IL 62704"),
                new("Method", "Standard (5-7 days)"),
            ]),
        new("Payment", "Payment method", "How would you like to pay?",
            [
                new("Card", "Visa ending in 4242"),
                new("Billing address", "Same as shipping"),
                new("Total", "$101.00"),
            ]),
        new("Review", "Order review", "Confirm your order details",
            [
                new("Items", "2 products"),
                new("Shipping", "Free — Standard"),
                new("Total", "$101.00"),
            ]),
        new("Done", "Order confirmed", "Your order has been placed successfully",
            [
                new("Order number", "#ORD-28491"),
                new("Estimated delivery", "April 2-4, 2026"),
                new("Confirmation", "Sent to alex@example.com"),
            ]),
    ];

    private void HandleNext()
    {
        if (_currentStep < _steps.Length - 1)
        {
            _currentStep++;
        }
    }

    private void HandleBack()
    {
        if (_currentStep > 0)
        {
            _currentStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _currentStep)
        {
            _currentStep = index;
        }
    }
}
