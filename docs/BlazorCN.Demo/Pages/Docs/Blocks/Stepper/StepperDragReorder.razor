@* ============================================================
   Block: stepper-drag-reorder
   Title: StepperDragReorder
   Description: A vertical stepper with draggable reorderable steps using grip handles, up/down controls, and a reset button built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-drag-reorder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Design sprint</span>
            <div class="flex items-center gap-2">
                @if (_hasReordered)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        Custom order
                    </BadgeCn>
                }
                <span class="text-muted-foreground text-xs tabular-nums">@_steps.Count steps</span>
            </div>
        </div>

        @* Reorderable steps *@
        <div>
            @for (int i = 0; i < _steps.Count; i++)
            {
                var step = _steps[i];
                var isActive = step.Id == _activeStepId;
                var isLast = i == _steps.Count - 1;
                var idx = i;
                <div class="@Cn.Merge(isLast ? "" : "border-b", isActive ? "bg-muted/30" : "")">
                    <div class="flex items-center gap-2 px-2 py-2.5">
                        @* Grip handle + reorder buttons *@
                        <div class="flex shrink-0 flex-col items-center gap-0.5">
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" Class="size-5 text-muted-foreground" OnClick="@(() => MoveStep(idx, "up"))" Disabled="@(idx == 0)" aria-label="Scroll up">
                                <LucideIconCn Name="chevron-up" Size="12" Class="size-3" />
                            </ButtonCn>
                            <LucideIconCn Name="grip-vertical" Size="14" Class="size-3.5 text-muted-foreground/40" />
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" Class="size-5 text-muted-foreground" OnClick="@(() => MoveStep(idx, "down"))" Disabled="@(idx == _steps.Count - 1)" aria-label="Scroll down">
                                <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>

                        @* Step number *@
                        <span class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full text-xs tabular-nums transition-all duration-200", isActive ? "bg-foreground text-background" : "border border-muted-foreground/25 text-muted-foreground")">
                            @(idx + 1)
                        </span>

                        @* Step content *@
                        <button type="button" @onclick="@(() => _activeStepId = step.Id)" class="min-w-0 flex-1 text-left transition-colors hover:bg-muted/30 rounded-md px-2 py-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", isActive ? "text-foreground" : "text-muted-foreground")">
                                    @step.Label
                                </span>
                                @if (isActive)
                                {
                                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>
                        </button>

                        @* Duration estimate *@
                        <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                            @step.Estimate
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Active step detail *@
        @if (_activeIndex >= 0)
        {
            <div class="border-t px-4 py-4">
                <div class="rounded-md bg-muted/50 p-3">
                    <div class="mb-1.5 flex items-center justify-between">
                        <span class="font-medium text-muted-foreground text-xs">
                            Step @(_activeIndex + 1) — @_steps[_activeIndex].Label
                        </span>
                        <span class="text-muted-foreground text-xs tabular-nums">
                            @_steps[_activeIndex].Estimate
                        </span>
                    </div>
                    <p class="text-sm leading-relaxed">@_steps[_activeIndex].Description</p>
                </div>
            </div>
        }

        @* Footer controls *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="ResetOrder" Disabled="@(!_hasReordered)">
                <LucideIconCn Name="rotate-ccw" Size="14" Class="size-3.5" />
                Reset order
            </ButtonCn>
            <span class="text-muted-foreground/60 text-xs">Use arrows to reorder steps</span>
        </div>
    </div>
</section>

@code {
    private record WorkflowStep(string Id, string Label, string Description, string Estimate);

    private static readonly WorkflowStep[] _defaultSteps =
    [
        new("research", "Research", "Competitive analysis and user interviews", "1 week"),
        new("wireframe", "Wireframe", "Low-fidelity layouts and information architecture", "3 days"),
        new("prototype", "Prototype", "Interactive Figma prototype with transitions", "4 days"),
        new("test", "Test", "Usability testing with 8 participants", "3 days"),
        new("iterate", "Iterate", "Refine based on test findings and feedback", "2 days"),
    ];

    private List<WorkflowStep> _steps = new(_defaultSteps);
    private string _activeStepId = "prototype";
    private bool _hasReordered = false;

    private int _activeIndex => _steps.FindIndex(s => s.Id == _activeStepId);

    private void MoveStep(int index, string direction)
    {
        var newIndex = direction == "up" ? index - 1 : index + 1;
        if (newIndex < 0 || newIndex >= _steps.Count) return;
        var temp = _steps[index];
        _steps[index] = _steps[newIndex];
        _steps[newIndex] = temp;
        _hasReordered = true;
    }

    private void ResetOrder()
    {
        _steps = new(_defaultSteps);
        _hasReordered = false;
    }
}
