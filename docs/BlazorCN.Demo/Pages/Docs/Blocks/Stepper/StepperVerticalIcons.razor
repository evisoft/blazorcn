@* ============================================================
   Block: stepper-vertical-icons
   Title: StepperVerticalIcons
   Description: A vertical icon-based stepper with expandable content areas, status indicators, and connecting lines built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-vertical-icons.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Organization setup</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Complete all steps to launch your workspace
                </p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                ~@TotalTime min left
            </BadgeCn>
        </div>

        @* Steps *@
        <div class="px-4 py-4">
            @for (var i = 0; i < _steps.Length; i++)
            {
                var index = i;
                var step = _steps[index];
                var isCompleted = index < _activeStep;
                var isActive = index == _activeStep;
                var isUpcoming = index > _activeStep;
                var isLast = index == _steps.Length - 1;
                var lineStyle = $"min-height:{(isActive ? "96px" : "20px")}";

                <div class="flex gap-4">
                    @* Icon + Line column *@
                    <div class="flex flex-col items-center">
                        <button
                            type="button" aria-label="@($"Step {index + 1}: {step.Label}")"
                            @onclick="@(() => HandleStepClick(index))"
                            disabled="@isUpcoming"
                            class="@Cn.Merge("flex size-9 shrink-0 items-center justify-center rounded-full transition-all duration-200", isCompleted ? "bg-emerald-500/15 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-400 cursor-pointer" : isActive ? "bg-blue-500 text-white ring-4 ring-blue-500/15 dark:bg-blue-600 dark:ring-blue-400/15 cursor-pointer" : "border border-muted-foreground/20 text-muted-foreground cursor-default")">
                            @if (isCompleted)
                            {
                                <LucideIconCn Name="check" Size="16" Class="size-4" />
                            }
                            else
                            {
                                <LucideIconCn Name="@step.IconName" Size="16" Class="size-4" />
                            }
                        </button>

                        @if (!isLast)
                        {
                            <div
                                class="@Cn.Merge("my-1.5 w-0.5 flex-1 rounded-full transition-colors duration-300", isCompleted ? "bg-emerald-500/40 dark:bg-emerald-500/30" : "bg-muted-foreground/10")"
                                style="@lineStyle">
                            </div>
                        }
                    </div>

                    @* Content column *@
                    <div class="@(isLast ? "pb-0" : "pb-5")">
                        <div class="flex items-center gap-2 pt-1.5">
                            <span class="@Cn.Merge("font-medium text-sm", isUpcoming ? "text-muted-foreground" : "text-foreground")">
                                @step.Label
                            </span>
                            <span class="text-muted-foreground text-[10px] tabular-nums">
                                @step.TimeEstimate
                            </span>
                            @if (isCompleted)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">Done</BadgeCn>
                            }
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>

                        @if (isActive)
                        {
                            <div class="mt-3 space-y-3">
                                <div class="space-y-1.5">
                                    @foreach (var field in step.Fields)
                                    {
                                        <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                                            <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                                            <span class="text-xs">@field.Value</span>
                                        </div>
                                    }
                                </div>
                                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" Disabled="@isLast" OnClick="HandleContinue">
                                    @(isLast ? "Launch" : "Continue")
                                    @if (!isLast)
                                    {
                                        <LucideIconCn Name="chevron-right" Size="12" Class="size-3" />
                                    }
                                </ButtonCn>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StepField(string Label, string Value);
    private record StepItem(string Label, string Description, string IconName, string TimeEstimate, StepField[] Fields);

    private static readonly StepItem[] _steps =
    [
        new("Select plan", "Choose the right plan for your team size", "layout-grid", "1 min",
        [
            new("Plan", "Team — 10 seats"),
            new("Price", "$79/month"),
            new("Trial", "14 days free"),
        ]),
        new("Company details", "Enter your organization information", "building", "2 min",
        [
            new("Company", "Acme Inc."),
            new("Industry", "Software & Technology"),
            new("Size", "50-200 employees"),
        ]),
        new("Team members", "Invite your team to the workspace", "users", "3 min",
        [
            new("Invited", "4 members"),
            new("Pending", "2 invitations"),
            new("Roles", "2 Admins, 2 Editors"),
        ]),
        new("Integrations", "Connect your existing tools and services", "plug", "2 min",
        [
            new("Connected", "Slack, GitHub"),
            new("Available", "12 more integrations"),
            new("Webhooks", "Not configured"),
        ]),
        new("Launch", "Review everything and go live", "rocket", "1 min",
        [
            new("Status", "Ready to launch"),
            new("Team", "6 members"),
            new("Integrations", "2 connected"),
        ]),
    ];

    private int _activeStep = 2;

    private int TotalTime
    {
        get
        {
            int total = 0;
            for (int i = _activeStep; i < _steps.Length; i++)
            {
                var parts = _steps[i].TimeEstimate.Split(' ');
                if (parts.Length > 0 && int.TryParse(parts[0], out var n))
                    total += n;
            }
            return total;
        }
    }

    private void HandleContinue()
    {
        if (_activeStep < _steps.Length - 1)
            _activeStep++;
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
            _activeStep = index;
    }
}
