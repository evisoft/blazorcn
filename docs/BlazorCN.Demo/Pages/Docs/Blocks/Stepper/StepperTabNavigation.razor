@* ============================================================
   Block: stepper-tab-navigation
   Title: StepperTabNavigation
   Description: A multi-step wizard with horizontal tab buttons, active underline indicator, completion checks, and swappable content panels built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-tab-navigation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Tab bar *@
        <div class="flex border-b">
            @for (int si = 0; si < _steps.Length; si++)
            {
                var step = _steps[si];
                var stepNum = si + 1;
                var isActive = _activeTab == step.Id;
                var isCompleted = _completed.Contains(step.Id);
                <button
                    type="button"
                    @onclick="@(() => _activeTab = step.Id)"
                    class="@Cn.Merge("relative flex flex-1 items-center justify-center gap-1.5 px-4 py-3 text-xs font-medium transition-colors", isActive ? "text-foreground" : isCompleted ? "text-foreground/70 hover:text-foreground" : "text-muted-foreground hover:text-foreground/70")">
                    @if (isCompleted && !isActive)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                    }
                    else
                    {
                        <span class="text-muted-foreground tabular-nums">@stepNum</span>
                    }
                    @step.Label
                    @if (isActive)
                    {
                        <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-blue-500"></span>
                    }
                </button>
            }
        </div>

        @* Content area *@
        <div class="px-4 py-4">
            <div class="mb-1 font-medium text-sm">@ActiveContent.Title</div>
            <p class="mb-4 text-muted-foreground text-xs">@ActiveContent.Description</p>

            <div class="space-y-0">
                @for (int fi = 0; fi < ActiveContent.Fields.Length; fi++)
                {
                    var field = ActiveContent.Fields[fi];
                    var fieldIndex = fi;
                    <div class="@Cn.Merge("flex items-center justify-between py-2.5", fieldIndex < ActiveContent.Fields.Length - 1 ? "border-b" : "")">
                        <span class="text-muted-foreground text-xs">@field.Label</span>
                        <span class="font-medium text-sm">@field.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(ActiveIndex == 0)" OnClick="HandleBack">
                Back
            </ButtonCn>
            <div class="flex items-center gap-1.5">
                @foreach (var stp in _steps)
                {
                    var step = stp;
                    <span class="@Cn.Merge("size-1.5 rounded-full transition-colors", _activeTab == step.Id ? "bg-blue-500" : _completed.Contains(step.Id) ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                }
            </div>
            @if (ActiveIndex < _steps.Length - 1)
            {
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="MarkCompleteAndNext">
                    Continue
                </ButtonCn>
            }
            else
            {
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="MarkCurrentComplete">
                    Create project
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record StepItem(string Id, string Label);
    private record FieldItem(string Label, string Value);
    private record StepContentItem(string Title, string Description, FieldItem[] Fields);

    private static readonly StepItem[] _steps =
    [
        new("details", "Details"),
        new("permissions", "Permissions"),
        new("notifications", "Notifications"),
        new("review", "Review"),
    ];

    private static readonly StepContentItem[] _stepContents =
    [
        new("Project details", "Configure the basic information for your new project.",
        [
            new("Project name", "acme-dashboard"),
            new("Description", "Internal analytics dashboard for the Acme team"),
            new("Framework", "Next.js 16"),
            new("Region", "US East (Virginia)"),
        ]),
        new("Access permissions", "Control who can view and modify this project.",
        [
            new("Visibility", "Team members only"),
            new("Admin access", "Project owners"),
            new("Deploy access", "Developers and above"),
            new("Audit logging", "Enabled"),
        ]),
        new("Notification preferences", "Choose how you want to be notified about project events.",
        [
            new("Deploy success", "Email + Slack"),
            new("Deploy failure", "Email + Slack + PagerDuty"),
            new("PR comments", "Slack only"),
            new("Weekly digest", "Email on Mondays"),
        ]),
        new("Review configuration", "Verify your settings before creating the project.",
        [
            new("Project", "acme-dashboard"),
            new("Framework", "Next.js 16"),
            new("Team access", "4 members"),
            new("Notifications", "3 channels configured"),
        ]),
    ];

    private string _activeTab = "details";
    private HashSet<string> _completed = [];

    private int ActiveIndex => Array.FindIndex(_steps, s => s.Id == _activeTab);
    private StepContentItem ActiveContent => _stepContents[ActiveIndex];

    private void HandleBack()
    {
        var idx = ActiveIndex;
        if (idx > 0)
        {
            _activeTab = _steps[idx - 1].Id;
        }
    }

    private void MarkCompleteAndNext()
    {
        _completed.Add(_activeTab);
        var nextIndex = ActiveIndex + 1;
        if (nextIndex < _steps.Length)
        {
            _activeTab = _steps[nextIndex].Id;
        }
    }

    private void MarkCurrentComplete()
    {
        _completed.Add(_activeTab);
    }
}
