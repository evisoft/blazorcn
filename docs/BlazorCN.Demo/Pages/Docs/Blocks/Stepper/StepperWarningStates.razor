@* ============================================================
   Block: stepper-warning-states
   Title: StepperWarningStates
   Description: A vertical stepper with tiered warning levels, expandable detail panels, and amber accent borders built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-warning-states.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Deployment pipeline</span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="tabular-nums">@_doneCount</span> done
                </span>
                @if (_issueCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        <span class="tabular-nums">@_issueCount</span>
                        @(_issueCount == 1 ? "issue" : "issues")
                    </span>
                }
            </div>
        </div>

        @* Steps *@
        <div class="px-4 py-4">
            @foreach (var stepEntry in _steps.Select((s, i) => new { Step = s, Index = i }))
            {
                var idx = stepEntry.Index;
                var step = stepEntry.Step;
                var config = GetConfig(step.Status);
                var isExpanded = _expandedStep == idx;
                var isLast = idx == _steps.Length - 1;

                <div class="flex gap-4">
                    @* Circle + Line column *@
                    <div class="flex flex-col items-center">
                        <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full transition-all duration-200", config.Circle)">
                            <LucideIconCn Name="@config.IconName" Size="14" Class="size-3.5" />
                        </div>

                        @if (!isLast)
                        {
                            <div class="@Cn.Merge("my-1 w-0.5 flex-1 rounded-full transition-colors duration-300", config.Line)"
                                 style="@($"min-height:{(isExpanded ? "100px" : "24px")}")">
                            </div>
                        }
                    </div>

                    @* Content column *@
                    <div class="@(isLast ? "pb-0" : "pb-6")">
                        <button type="button" @onclick="@(() => HandleToggle(idx))" class="flex w-full items-center gap-2 text-left">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="@Cn.Merge("font-medium text-sm", step.Status == StepStatus.Pending ? "text-muted-foreground" : "text-foreground")">
                                        @step.Label
                                    </span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-normal text-xs", config.LabelColor)">
                                        @config.Label
                                    </BadgeCn>
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>
                            </div>
                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </button>

                        @* Expanded detail *@
                        @if (isExpanded)
                        {
                            <div class="@Cn.Merge("mt-3 rounded-md bg-muted/50 p-3", config.Accent)">
                                <p class="text-sm leading-relaxed">@step.Detail</p>
                                @if (step.Action != null)
                                {
                                    <div class="mt-3">
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                            @step.Action
                                        </ButtonCn>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum StepStatus { Done, Warning, Error, Pending }

    private record StepItem(string Label, string Description, StepStatus Status, string Detail, string? Action = null);

    private record StatusConfig(string IconName, string Circle, string Line, string Accent, string Label, string LabelColor);

    private int? _expandedStep = 1;

    private int _doneCount => _steps.Count(s => s.Status == StepStatus.Done);
    private int _issueCount => _steps.Count(s => s.Status == StepStatus.Warning || s.Status == StepStatus.Error);

    private static readonly StepItem[] _steps =
    [
        new("Environment check", "Verify runtime and system requirements", StepStatus.Done,
            "Node.js 20.11.0 detected, memory allocation at 4 GB, disk space sufficient. All environment variables loaded from .env.production. No conflicts found."),
        new("Dependencies", "Install and audit project dependencies", StepStatus.Warning,
            "3 packages have deprecated warnings: glob@7.2.3, inflight@1.0.6, rimraf@3.0.2. No security vulnerabilities found but these packages may lose support in future releases.",
            "View deprecated packages"),
        new("Configuration", "Validate deployment configuration files", StepStatus.Error,
            "Missing required environment variable DATABASE_URL in production config. The deployment cannot proceed until this is set in your environment or .env.production file.",
            "Open config"),
        new("Deployment", "Build and deploy to production servers", StepStatus.Pending,
            "Waiting for configuration issues to be resolved. Once all blockers are cleared, the build will compile assets and deploy to 3 production regions."),
        new("Verification", "Run health checks and smoke tests", StepStatus.Pending,
            "Post-deployment health checks will verify API endpoints, database connectivity, and CDN cache invalidation across all regions."),
    ];

    private static StatusConfig GetConfig(StepStatus status) => status switch
    {
        StepStatus.Done    => new("check",           "bg-emerald-500 text-white dark:bg-emerald-600",        "bg-emerald-500 dark:bg-emerald-600", "",                       "Complete", "text-emerald-600 dark:text-emerald-400"),
        StepStatus.Warning => new("alert-triangle",  "bg-amber-500 text-white dark:bg-amber-600",            "bg-amber-500/30",                    "border-l-2 border-amber-500", "Attention", "text-amber-600 dark:text-amber-400"),
        StepStatus.Error   => new("x-circle",        "bg-red-500 text-white dark:bg-red-600",                "bg-red-500/30",                      "border-l-2 border-red-500",   "Blocked",   "text-red-600 dark:text-red-400"),
        StepStatus.Pending => new("circle",          "border border-muted-foreground/25 text-muted-foreground", "bg-muted-foreground/15",           "",                       "Upcoming",  "text-muted-foreground"),
        _                  => new("circle",          "", "", "", "", ""),
    };

    private void HandleToggle(int index)
    {
        _expandedStep = _expandedStep == index ? null : index;
    }
}
