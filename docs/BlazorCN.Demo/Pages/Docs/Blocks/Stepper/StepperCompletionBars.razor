@* ============================================================
   Block: stepper-completion-bars
   Title: StepperCompletionBars
   Description: A vertical stepper with individual mini progress bars per step showing granular completion percentages built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-completion-bars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="font-medium text-sm">Pipeline progress</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_completedCount of @_steps.Length complete
                </BadgeCn>
            </div>
            <span class="font-semibold text-sm tabular-nums">@_overall%</span>
        </div>

        @* Overall progress bar *@
        <div class="border-b px-4 py-3">
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted-foreground/10">
                <div
                    class="h-full rounded-full bg-blue-500 transition-all duration-500 dark:bg-blue-400"
                    style="@($"width:{_overall}%")" />
            </div>
        </div>

        @* Steps *@
        <div>
            @foreach (var stepEntry in _steps.Select((s, i) => new { Step = s, Index = i }))
            {
                var idx = stepEntry.Index;
                var step = stepEntry.Step;
                var isCompleted = step.Progress == 100;
                var isActive = idx == _activeStep;
                var isNotStarted = step.Progress == 0;
                var isLast = idx == _steps.Length - 1;

                var barColor = isCompleted
                    ? "bg-emerald-500 dark:bg-emerald-400"
                    : step.Progress > 0
                        ? "bg-blue-500 dark:bg-blue-400"
                        : "bg-transparent";

                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => HandleStepClick(idx))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">

                        @* Status indicator *@
                        <div class="flex size-7 shrink-0 items-center justify-center">
                            @if (isCompleted)
                            {
                                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500 dark:bg-emerald-600">
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-white" />
                                </div>
                            }
                            else
                            {
                                <div class="@Cn.Merge("flex size-6 items-center justify-center rounded-full border text-xs tabular-nums", step.Progress > 0 ? "border-blue-500/30 bg-blue-500/10 font-medium text-blue-600 dark:border-blue-400/30 dark:bg-blue-400/10 dark:text-blue-400" : "border-muted-foreground/20 text-muted-foreground")">
                                    @(idx + 1)
                                </div>
                            }
                        </div>

                        @* Label + progress bar *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", isNotStarted ? "text-muted-foreground" : "text-foreground")">
                                    @step.Label
                                </span>
                                <span class="@Cn.Merge("ml-auto shrink-0 font-medium text-xs tabular-nums", isCompleted ? "text-emerald-600 dark:text-emerald-400" : step.Progress > 0 ? "text-blue-600 dark:text-blue-400" : "text-muted-foreground")">
                                    @step.Progress%
                                </span>
                            </div>
                            <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted-foreground/10">
                                <div
                                    class="@Cn.Merge("h-full rounded-full transition-all duration-500", barColor)"
                                    style="@($"width:{step.Progress}%")" />
                            </div>
                            <p class="mt-1.5 text-muted-foreground text-xs">@step.Description</p>
                        </div>

                        @* Chevron *@
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isActive ? "rotate-90" : "")" />
                    </button>

                    @* Expanded detail *@
                    @if (isActive)
                    {
                        <div class="px-4 pb-4 pl-14">
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="text-sm leading-relaxed">@step.Detail</p>
                            </div>
                            @if (!isCompleted && step.Progress > 0)
                            {
                                <div class="mt-3">
                                    <div @onclick:stopPropagation>
                                        <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleContinue">
                                            View next step
                                            <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                                        </ButtonCn>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Description, int Progress, string Detail);

    private int _activeStep = 2;

    private static readonly StepItem[] _steps =
    [
        new("Data collection",
            "Ingest raw datasets from all configured sources",
            100,
            "All 12 data sources connected. 48,320 records ingested from PostgreSQL, S3 buckets, and REST APIs. Schema validation passed with zero conflicts."),
        new("Data cleaning",
            "Normalize, deduplicate, and validate records",
            100,
            "Removed 1,204 duplicate records. Standardized date formats across 6 columns. Null values in 3 fields filled with median imputation. Final dataset: 47,116 clean records."),
        new("Model training",
            "Train the prediction model on the prepared dataset",
            60,
            "Training on 80/20 split. Epoch 12 of 20 complete. Current loss: 0.0342. Learning rate: 0.001 with cosine annealing schedule. GPU utilization at 94%."),
        new("Evaluation",
            "Run metrics, compare baselines, and validate accuracy",
            0,
            "Will evaluate accuracy, precision, recall, and F1 score against the holdout test set. Baseline comparison with previous model version included."),
        new("Deployment",
            "Package the model and deploy to production endpoints",
            0,
            "Will containerize the model, run integration tests, and deploy to the staging environment before promoting to production with canary rollout."),
    ];

    private int _overall => (int)Math.Round(_steps.Average(s => (double)s.Progress));
    private int _completedCount => _steps.Count(s => s.Progress == 100);

    private void HandleContinue()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleStepClick(int index)
    {
        _activeStep = index;
    }
}
