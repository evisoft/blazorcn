@code {
    private record StepItem(string Id, string Label, string Description);
    private record StepGroup(string Label, string Description, StepItem[] Steps);

    private int _activeStep = 3;
    private HashSet<int> _expandedGroups = [1];

    private static readonly StepGroup[] _groups =
    [
        new(""Setup"", ""Initial project configuration"",
        [
            new(""create-account"", ""Create account"", ""Set up your user profile and credentials""),
            new(""verify-email"", ""Verify email"", ""Confirm your email address via verification link""),
            new(""set-password"", ""Set password"", ""Choose a secure password for your account""),
        ]),
        new(""Configure"", ""Workspace and tool settings"",
        [
            new(""workspace"", ""Workspace settings"", ""Name your workspace and set defaults""),
            new(""integrations"", ""Connect integrations"", ""Link third-party services and APIs""),
        ]),
        new(""Launch"", ""Review and go live"",
        [
            new(""review"", ""Review configuration"", ""Verify all settings before deployment""),
            new(""deploy"", ""Deploy project"", ""Push your project to production""),
        ]),
    ];

    private static readonly int _totalSteps = _groups.Sum(g => g.Steps.Length);

    private int FlatIndex(int groupIndex, int stepIndex)
    {
        var idx = 0;
        for (var g = 0; g < groupIndex; g++)
        {
            idx += _groups[g].Steps.Length;
        }
        return idx + stepIndex;
    }

    private int GetGroupProgress(int groupIndex)
    {
        var grp = _groups[groupIndex];
        var startIdx = FlatIndex(groupIndex, 0);
        var completed = 0;
        for (var i = 0; i < grp.Steps.Length; i++)
        {
            if (startIdx + i < _activeStep)
            {
                completed++;
            }
        }
        return completed;
    }

    private void ToggleGroup(int index)
    {
        if (_expandedGroups.Contains(index))
        {
            _expandedGroups.Remove(index);
        }
        else
        {
            _expandedGroups.Add(index);
        }
    }

    private void HandleStepClick(int groupIndex, int stepIndex)
    {
        var idx = FlatIndex(groupIndex, stepIndex);
        if (idx <= _activeStep)
        {
            _activeStep = idx;
        }
    }

    private void HandleContinue()
    {
        if (_activeStep < _totalSteps - 1)
        {
            var nextStep = _activeStep + 1;
            _activeStep = nextStep;

            // Auto-expand the group containing the next step
            var count = 0;
            for (var g = 0; g < _groups.Length; g++)
            {
                if (nextStep < count + _groups[g].Steps.Length)
                {
                    _expandedGroups.Add(g);
                    break;
                }
                count += _groups[g].Steps.Length;
            }
        }
    }
}";

