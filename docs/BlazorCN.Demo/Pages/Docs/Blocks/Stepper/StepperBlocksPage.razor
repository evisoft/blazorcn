    private enum SaveStatus { Saved, Saving, Draft, Pending }

    private record StepItem(string Label, string Description);
    private record FieldItem(string Label, string Value);

    private static readonly StepItem[] _steps =
    [
        new(""Title & description"", ""Name your content and write a summary""),
        new(""Media upload"", ""Add images, video, or attachments""),
        new(""Tags & categories"", ""Organize with labels and groups""),
        new(""Publishing options"", ""Schedule, visibility, and distribution""),
    ];

    private static readonly FieldItem[][] _stepContent =
    [
        [
            new(""Title"", ""Getting Started with Server Components""),
            new(""Slug"", ""getting-started-server-components""),
            new(""Description"", ""A practical guide to React Server Components in Next.js""),
            new(""Author"", ""Sarah Chen""),
        ],
        [
            new(""Cover image"", ""cover-rsc-guide.webp (uploaded)""),
            new(""Open Graph image"", ""og-rsc-guide.png (uploaded)""),
            new(""Video embed"", ""None""),
            new(""Attachments"", ""1 file (code-samples.zip)""),
        ],
        [
            new(""Category"", ""Engineering""),
            new(""Tags"", ""React, Next.js, RSC, Tutorial""),
            new(""Series"", ""React Fundamentals (Part 3 of 5)""),
            new(""Reading time"", ""8 min""),
        ],
        [
            new(""Status"", ""Draft""),
            new(""Publish date"", ""Not scheduled""),
            new(""Visibility"", ""Public""),
            new(""Newsletter"", ""Include in weekly digest""),
        ],
    ];

    private int _activeStep = 2;
    private SaveStatus[] _saveStatuses = [SaveStatus.Saved, SaveStatus.Saved, SaveStatus.Draft, SaveStatus.Pending];

    private string GetSaveStatusLabel(SaveStatus status) => status switch
    {
        SaveStatus.Saved => ""Saved"",
        SaveStatus.Saving => ""Saving..."",
        SaveStatus.Draft => ""Draft"",
        SaveStatus.Pending => ""Not started"",
        _ => """"
    };

    private string GetSaveStatusClass(SaveStatus status) => status switch
    {
        SaveStatus.Saved => ""text-emerald-600 dark:text-emerald-400"",
        SaveStatus.Saving => ""text-blue-600 dark:text-blue-400"",
        SaveStatus.Draft => ""text-amber-600 dark:text-amber-400"",
        SaveStatus.Pending => ""text-muted-foreground"",
        _ => """"
    };

    private async Task HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            var savingStep = _activeStep;
            _saveStatuses[savingStep] = SaveStatus.Saving;
            _activeStep++;
            StateHasChanged();
            await Task.Delay(800);
            _saveStatuses[savingStep] = SaveStatus.Saved;
            StateHasChanged();
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        var lastSavedIdx = Array.LastIndexOf(_saveStatuses, SaveStatus.Saved);
        var isAccessible = index <= Math.Max(_activeStep, lastSavedIdx + 1);
        if (isAccessible)
        {
            _activeStep = index;
        }
    }

    private async Task HandleSaveNow()
    {
        var savingStep = _activeStep;
        _saveStatuses[savingStep] = SaveStatus.Saving;
        StateHasChanged();
        await Task.Delay(1200);
        _saveStatuses[savingStep] = SaveStatus.Saved;
        StateHasChanged();
    }
}";

