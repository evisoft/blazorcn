    private record EditableStep(string Id, string Title, string Description);

    private List<EditableStep> _steps =
    [
        new(""scope"", ""Define scope"", ""Identify deliverables, milestones, and success criteria""),
        new(""budget"", ""Set budget"", ""Allocate resources, estimate costs, and set contingency""),
        new(""team"", ""Assign team"", ""Select team members, define roles, and set availability""),
        new(""kickoff"", ""Kick off"", ""Schedule kickoff meeting, share project brief, and align goals""),
    ];

    private int _activeStep = 1;
    private string? _editingId = null;
    private string _editTitle = """";
    private string _editDescription = """";
    private int _editCount = 0;

    private void StartEditing(EditableStep step)
    {
        _editingId = step.Id;
        _editTitle = step.Title;
        _editDescription = step.Description;
    }

    private void CancelEditing()
    {
        _editingId = null;
        _editTitle = """";
        _editDescription = """";
    }

    private void SaveEditing()
    {
        if (_editingId == null || _editTitle.Trim() == """") return;

        for (int i = 0; i < _steps.Count; i++)
        {
            if (_steps[i].Id == _editingId)
            {
                _steps[i] = _steps[i] with { Title = _editTitle.Trim(), Description = _editDescription.Trim() };
                break;
            }
        }
        _editCount++;
        _editingId = null;
        _editTitle = """";
        _editDescription = """";
    }
}";

