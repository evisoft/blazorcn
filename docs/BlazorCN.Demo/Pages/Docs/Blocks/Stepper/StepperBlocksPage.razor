    private record StepItem(string Id, string Label, string Description, string Category);

    private static readonly StepItem[] _steps =
    [
        new(""project-name"", ""Project name"", ""Set your project name and slug identifier"", ""General""),
        new(""team-members"", ""Team members"", ""Invite collaborators and assign roles"", ""General""),
        new(""authentication"", ""Authentication provider"", ""Configure OAuth, SAML, or email login methods"", ""Security""),
        new(""permissions"", ""Role permissions"", ""Define access levels and resource restrictions"", ""Security""),
        new(""database"", ""Database connection"", ""Connect PostgreSQL, MySQL, or MongoDB instance"", ""Infrastructure""),
        new(""storage"", ""File storage"", ""Configure S3, GCS, or local file storage buckets"", ""Infrastructure""),
        new(""domain"", ""Custom domain"", ""Map your domain and configure DNS records"", ""Deployment""),
        new(""ssl"", ""SSL certificate"", ""Provision TLS certificate for HTTPS encryption"", ""Deployment""),
        new(""environment"", ""Environment variables"", ""Set secrets and configuration for each environment"", ""Deployment""),
        new(""notifications"", ""Notification channels"", ""Configure email, Slack, and webhook alerts"", ""Integrations""),
        new(""monitoring"", ""Monitoring setup"", ""Enable error tracking, logs, and uptime checks"", ""Integrations""),
        new(""review"", ""Review and deploy"", ""Verify all settings and push to production"", ""Final""),
    ];

    private int _activeStep = 4;
    private string _searchQuery = """";

    private StepItem[] FilteredSteps
    {
        get
        {
            var q = _searchQuery.Trim();
            if (string.IsNullOrEmpty(q)) return _steps;
            var lower = q.ToLowerInvariant();
            return System.Array.FindAll(_steps, s =>
                s.Label.ToLowerInvariant().Contains(lower) ||
                s.Description.ToLowerInvariant().Contains(lower) ||
                s.Category.ToLowerInvariant().Contains(lower));
        }
    }

    private void HandleStepClick(int stepIndex)
    {
        if (stepIndex <= _activeStep)
            _activeStep = stepIndex;
    }

    private void HandleContinue()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
            _searchQuery = """";
        }
    }

    private static MarkupString HighlightMatch(string text, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
            return (MarkupString)System.Net.WebUtility.HtmlEncode(text);
        var lowerText = text.ToLowerInvariant();
        var lowerQuery = query.ToLowerInvariant();
        var idx = lowerText.IndexOf(lowerQuery, StringComparison.Ordinal);
        if (idx == -1)
            return (MarkupString)System.Net.WebUtility.HtmlEncode(text);
        var before = System.Net.WebUtility.HtmlEncode(text[..idx]);
        var match = System.Net.WebUtility.HtmlEncode(text.Substring(idx, query.Length));
        var after = System.Net.WebUtility.HtmlEncode(text[(idx + query.Length)..]);
        return (MarkupString)$""{before}<span class=\""rounded-sm bg-yellow-200/60 px-0.5 dark:bg-yellow-500/20\"">{match}</span>{after}"";
    }
}";

