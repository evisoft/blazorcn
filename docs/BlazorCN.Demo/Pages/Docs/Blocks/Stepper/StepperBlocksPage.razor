        StepStatus.Review => ""bg-amber-500 text-white dark:bg-amber-600"",
        StepStatus.InProgress => ""bg-blue-500 text-white ring-4 ring-blue-500/20 dark:bg-blue-600 dark:ring-blue-400/20"",
