            {
                var idx = stepEntry.Index;
                var step = stepEntry.Step;
                var isCompleted = idx < _activeStep;
                var isActive = idx == _activeStep;
                var isUpcoming = idx > _activeStep;
                var isLast = idx == _steps.Length - 1;

                <div class=""@(isLast ? """" : ""border-b"")"">
                    @* Step header row *@
                    <button
                        type=""button""
                        @onclick=""@(() => HandleStepClick(idx))""
                        disabled=""@isUpcoming""
                        class=""@Cn.Merge(""flex w-full items-center gap-3 px-4 py-3 text-left transition-colors"", isUpcoming ? ""cursor-default opacity-50"" : isActive ? ""bg-muted/30"" : ""cursor-pointer hover:bg-muted/50"")"">

                        @* Step indicator *@
                        <span class=""@Cn.Merge(""flex size-7 shrink-0 items-center justify-center rounded-full text-xs tabular-nums transition-all duration-200"", isCompleted ? ""bg-emerald-500 text-white dark:bg-emerald-600"" : isActive ? ""bg-foreground text-background"" : ""border border-muted-foreground/25 text-muted-foreground"")"">
                            @if (isCompleted)
                            {
                                <LucideIconCn Name=""check"" Size=""14"" Class=""size-3.5"" />
                            }
                            else if (isUpcoming)
                            {
                                <LucideIconCn Name=""lock"" Size=""12"" Class=""size-3"" />
                            }
                            else
                            {
                                <span>@(idx + 1)</span>
                            }
                        </span>

                        @* Step text *@
                        <div class=""min-w-0 flex-1"">
                            <div class=""flex items-center gap-2"">
                                <span class=""@Cn.Merge(""font-medium text-sm"", (isActive || isCompleted) ? ""text-foreground"" : ""text-muted-foreground"")"">
                                    @step.Label
                                </span>
                                @if (isCompleted)
                                {
                                    <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs"">Completed</BadgeCn>
                                }
                            </div>
                            @if (isCompleted)
                            {
                                <p class=""mt-0.5 truncate text-muted-foreground text-xs"">@step.Summary</p>
                            }
                            else
                            {
                                <p class=""mt-0.5 text-muted-foreground text-xs"">@step.Description</p>
                            }
                        </div>

                        @* Chevron *@
                        <LucideIconCn Name=""chevron-right"" Size=""16"" Class=""@Cn.Merge(""size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200"", isActive ? ""rotate-90"" : """")"" />
                    </button>

                    @* Expanded content *@
                    @if (isActive)
                    {
                        <div class=""border-t bg-muted/20 px-4 py-4"">
                            <div class=""space-y-2 pl-10"">
                                @foreach (var field in step.Fields)
                                {
                                    <div class=""flex items-center justify-between rounded-md bg-background/80 px-3 py-2.5"">
                                        <span class=""font-medium text-muted-foreground text-xs"">@field.Label</span>
                                        <span class=""text-sm"">@field.Value</span>
                                    </div>
                                }

                                <div class=""pt-2"">
                                    <ButtonCn Size=""ButtonSize.Sm"" Class=""h-8 gap-1.5 text-xs"" OnClick=""HandleContinue"" Disabled=""@(_activeStep == _steps.Length - 1)"">
                                        @(_activeStep == _steps.Length - 1 ? ""Submit application"" : ""Continue"")
                                        @if (_activeStep < _steps.Length - 1)
                                        {
                                            <LucideIconCn Name=""chevron-right"" Size=""14"" Class=""size-3.5"" />
                                        }
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

