        new(""enterprise"", ""Enterprise"", 79, 790, ""For organizations at scale"", [""Unlimited everything"", ""1 TB storage"", ""Dedicated support"", ""SSO & SAML"", ""Custom contracts""]),
    ];

    private static readonly AddOnItem[] _addOns =
    [
        new(""analytics"", ""Advanced analytics"", 8, 80, ""Detailed usage metrics and reports""),
        new(""backup"", ""Automated backups"", 5, 50, ""Daily snapshots with 30-day retention""),
        new(""whitelabel"", ""White-label branding"", 15, 150, ""Remove branding and use your own domain""),
        new(""ai"", ""AI assistant"", 12, 120, ""AI-powered suggestions and automation""),
    ];

    private int _activeStep = 0;
