@code {
    private record SubStepItem(string Id, string Label);
    private record MainStepItem(string Id, string Label, string Description, SubStepItem[] SubSteps);

    private int _currentGlobal = 3;
    private HashSet<int> _expandedSteps = [1];

    private static readonly MainStepItem[] _mainSteps =
    [
        new(""setup"", ""Setup"", ""Install tools and configure environment"",
        [
            new(""install-deps"", ""Install dependencies""),
            new(""configure-env"", ""Configure environment""),
        ]),
        new(""build"", ""Build"", ""Compile, bundle, and optimize the project"",
        [
            new(""compile"", ""Compile source""),
            new(""bundle"", ""Bundle assets""),
            new(""optimize"", ""Optimize output""),
        ]),
        new(""test"", ""Test"", ""Run unit and end-to-end test suites"",
        [
            new(""unit-tests"", ""Unit tests""),
            new(""e2e-tests"", ""End-to-end tests""),
        ]),
        new(""deploy"", ""Deploy"", ""Stage and release to production"",
        [
            new(""stage"", ""Deploy to staging""),
            new(""production"", ""Deploy to production""),
        ]),
    ];

    private static readonly int _totalSubSteps = _mainSteps.Sum(s => s.SubSteps.Length);

    private int ActiveMainIdx => GetMainAndSub(_currentGlobal).MainIdx;
    private int ActiveSubIdx => GetMainAndSub(_currentGlobal).SubIdx;

    private int GetGlobalIndex(int mainIdx, int subIdx)
    {
        var idx = 0;
        for (var m = 0; m < mainIdx; m++)
        {
            idx += _mainSteps[m].SubSteps.Length;
        }
        return idx + subIdx;
    }

    private (int MainIdx, int SubIdx) GetMainAndSub(int globalIdx)
    {
        var count = 0;
        for (var m = 0; m < _mainSteps.Length; m++)
        {
            if (globalIdx < count + _mainSteps[m].SubSteps.Length)
            {
                return (m, globalIdx - count);
            }
            count += _mainSteps[m].SubSteps.Length;
        }
        return (_mainSteps.Length - 1, _mainSteps[_mainSteps.Length - 1].SubSteps.Length - 1);
    }

    private (int Completed, int Total) GetMainStepProgress(int mainIdx)
    {
        var startIdx = GetGlobalIndex(mainIdx, 0);
        var total = _mainSteps[mainIdx].SubSteps.Length;
        var completed = 0;
        for (var i = 0; i < total; i++)
        {
            if (startIdx + i < _currentGlobal)
            {
                completed++;
            }
        }
        return (completed, total);
    }

    private string GetMainStepStatus(int mainIdx)
    {
        var (completed, total) = GetMainStepProgress(mainIdx);
        if (completed == total) return ""completed"";
        var (activeMainIdx, _) = GetMainAndSub(_currentGlobal);
        if (mainIdx == activeMainIdx) return ""active"";
        if (GetGlobalIndex(mainIdx, 0) > _currentGlobal) return ""upcoming"";
        return ""active"";
    }

    private void ToggleExpand(int mainIdx)
    {
        if (_expandedSteps.Contains(mainIdx))
        {
            _expandedSteps.Remove(mainIdx);
        }
        else
        {
            _expandedSteps.Add(mainIdx);
        }
    }

    private void HandleSubStepClick(int mainIdx, int subIdx)
    {
        var globalIdx = GetGlobalIndex(mainIdx, subIdx);
        if (globalIdx <= _currentGlobal)
        {
            _currentGlobal = globalIdx;
        }
    }

    private void HandleContinue()
    {
        if (_currentGlobal < _totalSubSteps - 1)
        {
            var nextGlobal = _currentGlobal + 1;
            _currentGlobal = nextGlobal;

            // Auto-expand the main step containing the next sub-step
            var (mainIdx, _) = GetMainAndSub(nextGlobal);
            _expandedSteps.Add(mainIdx);
        }
    }
}";

