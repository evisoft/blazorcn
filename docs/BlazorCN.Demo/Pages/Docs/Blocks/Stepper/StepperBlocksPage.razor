@code {
    private record Waypoint(string Label, string Description, string Detail, int X, int Y);

    private static readonly Waypoint[] _waypoints =
    [
        new(""Start"",       ""Project initiation"",  ""Requirements finalized, team assembled, timeline approved by stakeholders"",                     60,  40),
        new(""Milestone 1"", ""Design complete"",      ""Wireframes approved, design system built, component library scaffolded"",                       220, 110),
        new(""Checkpoint"",  ""Mid-project review"",   ""Sprint retrospective done, backlog reprioritized, scope validated with client"",                  60, 180),
        new(""Milestone 2"", ""Feature freeze"",       ""All features implemented, integration tests passing, staging deployed"",                        220, 250),
        new(""Destination"", ""Production launch"",    ""Final QA signed off, production deployed, monitoring dashboards live"",                         140, 320),
    ];

    private static readonly string _pathD = BuildPath(_waypoints);

    private int _activeWaypoint = 2;

    private static string BuildPath(Waypoint[] points)
    {
        if (points.Length < 2) return """";
        var d = $""M {points[0].X} {points[0].Y}"";
        for (int i = 1; i < points.Length; i++)
        {
            var prev = points[i - 1];
            var curr = points[i];
            var cpX = (prev.X + curr.X) / 2;
            var cpY1 = prev.Y;
            var cpY2 = curr.Y;
            d += $"" C {cpX} {cpY1}, {cpX} {cpY2}, {curr.X} {curr.Y}"";
        }
        return d;
    }

    private void HandleNext()
    {
        if (_activeWaypoint < _waypoints.Length - 1)
            _activeWaypoint++;
    }

    private void HandleBack()
    {
        if (_activeWaypoint > 0)
            _activeWaypoint--;
    }
}";

