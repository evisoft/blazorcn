    private record WorkflowStep(string Id, string Label, string Description, string Estimate);

    private static readonly WorkflowStep[] _defaultSteps =
    [
        new(""research"", ""Research"", ""Competitive analysis and user interviews"", ""1 week""),
        new(""wireframe"", ""Wireframe"", ""Low-fidelity layouts and information architecture"", ""3 days""),
        new(""prototype"", ""Prototype"", ""Interactive Figma prototype with transitions"", ""4 days""),
        new(""test"", ""Test"", ""Usability testing with 8 participants"", ""3 days""),
        new(""iterate"", ""Iterate"", ""Refine based on test findings and feedback"", ""2 days""),
    ];

    private List<WorkflowStep> _steps = new(_defaultSteps);
    private string _activeStepId = ""prototype"";
    private bool _hasReordered = false;

    private int _activeIndex => _steps.FindIndex(s => s.Id == _activeStepId);

    private void MoveStep(int index, string direction)
    {
        var newIndex = direction == ""up"" ? index - 1 : index + 1;
        if (newIndex < 0 || newIndex >= _steps.Count) return;
        var temp = _steps[index];
        _steps[index] = _steps[newIndex];
        _steps[newIndex] = temp;
        _hasReordered = true;
    }

    private void ResetOrder()
    {
        _steps = new(_defaultSteps);
        _hasReordered = false;
    }
