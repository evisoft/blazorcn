@* ============================================================
   Block: stepper-change-history
   Title: StepperChangeHistory
   Description: A vertical stepper with last-modified timestamps, author attribution, and update indicators per step built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-change-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Document lifecycle</span>
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Last activity: @_lastActivityTime</span>
            </div>
        </div>

        @* Steps *@
        <div>
            @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
            {
                var idx = entry.Index;
                var step = entry.Step;
                var isCompleted = step.Status == "completed";
                var isActive = step.Status == "active";
                var isSelected = _selectedStep == idx;
                var isLast = idx == _steps.Length - 1;
                var hasRecentChange = step.LastChange?.IsRecent == true;

                <div class="@(isLast ? "" : "border-b")">
                    @* Step row *@
                    <button
                        type="button"
                        @onclick="@(() => ToggleStep(idx))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">

                        @* Status circle *@
                        <div class="flex size-7 shrink-0 items-center justify-center">
                            @if (isCompleted)
                            {
                                <div class="flex size-6 items-center justify-center rounded-full bg-emerald-500 dark:bg-emerald-600">
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-white" />
                                </div>
                            }
                            else if (isActive)
                            {
                                <div class="flex size-6 items-center justify-center rounded-full border-2 border-blue-500 bg-blue-500/10 dark:border-blue-400 dark:bg-blue-400/10">
                                    <span class="font-medium text-blue-600 text-xs tabular-nums dark:text-blue-400">@(idx + 1)</span>
                                </div>
                            }
                            else
                            {
                                <div class="flex size-6 items-center justify-center rounded-full border border-muted-foreground/20">
                                    <span class="text-muted-foreground text-xs tabular-nums">@(idx + 1)</span>
                                </div>
                            }
                        </div>

                        @* Label + last change *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", step.Status == "upcoming" ? "text-muted-foreground" : "text-foreground")">
                                    @step.Label
                                </span>
                                @if (hasRecentChange)
                                {
                                    <span class="size-1.5 rounded-full bg-blue-500 dark:bg-blue-400"></span>
                                }
                            </div>
                            @if (step.LastChange != null)
                            {
                                <p class="mt-0.5 text-muted-foreground text-xs">Updated @step.LastChange.Time by @step.LastChange.Author</p>
                            }
                            else
                            {
                                <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>
                            }
                        </div>

                        @* Chevron *@
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isSelected ? "rotate-90" : "")" />
                    </button>

                    @* Expanded detail + change history *@
                    @if (isSelected)
                    {
                        <div class="px-4 pb-4 pl-14">
                            @* Step description *@
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="text-sm leading-relaxed">@step.Detail</p>
                            </div>

                            @* Change history *@
                            @if (step.Changes.Length > 0)
                            {
                                <div class="mt-3">
                                    <div class="mb-2 flex items-center gap-1.5">
                                        <LucideIconCn Name="history" Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="font-medium text-muted-foreground text-xs">Change history</span>
                                    </div>
                                    <div class="space-y-1.5">
                                        @foreach (var change in step.Changes)
                                        {
                                            <div class="flex items-center gap-2.5 rounded-md px-2 py-1.5">
                                                <span class="@Cn.Merge("flex size-5 shrink-0 items-center justify-center rounded-full text-[10px] font-medium", InitialsColor(change.Initials))">
                                                    @change.Initials
                                                </span>
                                                <div class="min-w-0 flex-1">
                                                    <span class="text-sm">@change.Action</span>
                                                </div>
                                                <div class="flex shrink-0 items-center gap-1.5">
                                                    @if (change.IsRecent)
                                                    {
                                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">New</BadgeCn>
                                                    }
                                                    <span class="text-muted-foreground text-xs">@change.Time</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (step.Changes.Length == 0)
                            {
                                <div class="mt-3 rounded-md bg-muted/50 p-3">
                                    <p class="text-muted-foreground text-xs">
                                        No changes recorded yet. Updates will appear here once work begins.
                                    </p>
                                </div>
                            }

                            @if (isActive)
                            {
                                <div class="mt-3">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                                        <LucideIconCn Name="history" Size="12" Class="size-3" />
                                        View full history
                                    </ButtonCn>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ChangeItem(string Author, string Initials, string Action, string Time, bool IsRecent);
    private record StepItem(string Label, string Description, string Status, ChangeItem? LastChange, string Detail, ChangeItem[] Changes);

    private int _selectedStep = 2;

    private static readonly StepItem[] _steps =
    [
        new("Draft",
            "Initial document creation and content authoring",
            "completed",
            new("Sarah Kim", "SK", "Finalized draft content", "5 days ago", false),
            "Document created from the Q2 planning template. Executive summary, objectives, and timeline sections completed. Word count: 2,840. Ready for internal review.",
            [
                new("Sarah Kim", "SK", "Finalized draft content", "5 days ago", false),
                new("Sarah Kim", "SK", "Added timeline section", "6 days ago", false),
                new("Alex Chen", "AC", "Created initial document", "1 week ago", false),
            ]),
        new("Internal review",
            "Team review with tracked changes and comments",
            "completed",
            new("Jordan Lee", "JL", "Approved with minor edits", "2 days ago", false),
            "Reviewed by 3 team members. 8 comments resolved, 2 paragraphs rewritten for clarity. Budget figures updated to reflect the latest finance projections.",
            [
                new("Jordan Lee", "JL", "Approved with minor edits", "2 days ago", false),
                new("Taylor Reeves", "TR", "Resolved 5 comments", "3 days ago", false),
                new("Alex Chen", "AC", "Updated budget figures", "3 days ago", false),
            ]),
        new("Legal review",
            "Compliance check and legal language review",
            "active",
            new("Morgan Patel", "MP", "Updated liability clause in section 4", "3 hours ago", true),
            "Legal team reviewing sections 3-7 for compliance. Liability clause in section 4 updated to meet new regulatory requirements. Data handling addendum pending final review.",
            [
                new("Morgan Patel", "MP", "Updated liability clause in section 4", "3 hours ago", true),
                new("Morgan Patel", "MP", "Flagged data handling section", "6 hours ago", true),
                new("Sarah Kim", "SK", "Submitted for legal review", "1 day ago", false),
            ]),
        new("Final approval",
            "Executive sign-off and approval signatures",
            "upcoming",
            null,
            "Awaiting legal review completion. Will be sent to the VP of Engineering and CFO for final sign-off.",
            []),
        new("Published",
            "Document published and distributed to stakeholders",
            "upcoming",
            null,
            "Will be published to the internal wiki and emailed to all department heads once approved.",
            []),
    ];

    private string _lastActivityTime =>
        Array.Find(_steps, s => s.LastChange?.IsRecent == true)?.LastChange?.Time ?? "2 days ago";

    private void ToggleStep(int index)
    {
        _selectedStep = _selectedStep == index ? -1 : index;
    }

    private static string InitialsColor(string initials) => initials switch
    {
        "SK" => "bg-blue-500/15 text-blue-700 dark:bg-blue-400/15 dark:text-blue-300",
        "AC" => "bg-emerald-500/15 text-emerald-700 dark:bg-emerald-400/15 dark:text-emerald-300",
        "JL" => "bg-amber-500/15 text-amber-700 dark:bg-amber-400/15 dark:text-amber-300",
        "TR" => "bg-purple-500/15 text-purple-700 dark:bg-purple-400/15 dark:text-purple-300",
        "MP" => "bg-rose-500/15 text-rose-700 dark:bg-rose-400/15 dark:text-rose-300",
        _    => "bg-muted text-muted-foreground",
    };
}
