@* ============================================================
   Block: stepper-command-palette
   Title: StepperCommandPalette
   Description: A command palette style stepper navigator with search filtering and keyboard-driven step selection built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-command-palette.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Search header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="search" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
            <input
                type="text"
                value="@_search"
                @oninput="@((ChangeEventArgs e) => { _search = e.Value?.ToString() ?? ""; _highlightIndex = 0; })"
                @onkeydown="HandleKeyDown"
                placeholder="Search steps..."
                class="h-6 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground/50" />
            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs tabular-nums">
                @_completedSteps.Count/@_paletteSteps.Length
            </BadgeCn>
        </div>

        @* Step list *@
        <div class="max-h-[280px] overflow-y-auto">
            @if (FilteredSteps.Length == 0)
            {
                <div class="px-4 py-8 text-center text-muted-foreground text-xs">
                    No steps match &ldquo;@_search&rdquo;
                </div>
            }
            @{
                var filteredSteps = FilteredSteps;
            }
            @for (var i = 0; i < filteredSteps.Length; i++)
            {
                var step = filteredSteps[i];
                var index = i;
                var isActive = step.Id == _activeStepId;
                var isComplete = _completedSteps.Contains(step.Id);
                var isHighlighted = index == _highlightIndex;
                <button
                    type="button"
                    @onclick="@(() => _activeStepId = step.Id)"
                    @onmouseenter="@(() => _highlightIndex = index)"
                    class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors", isActive ? "bg-muted/50" : isHighlighted ? "bg-muted/30" : "hover:bg-muted/20")">
                    <span class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-md transition-all duration-200", isComplete ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : isActive ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground")">
                        @if (isComplete)
                        {
                            <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                        }
                        else
                        {
                            <LucideIconCn Name="@step.IconName" Size="14" Class="size-3.5" />
                        }
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("font-medium text-sm", isActive ? "text-foreground" : "text-foreground/80")">
                                @step.Label
                            </span>
                            @if (isComplete)
                            {
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            }
                        </div>
                        <span class="text-muted-foreground text-xs">@step.Description</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="rounded border border-muted-foreground/15 bg-muted/30 px-1.5 py-0.5 font-mono text-muted-foreground text-xs">
                            @step.Shortcut
                        </span>
                        @if (isActive)
                        {
                            <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/60" />
                        }
                    </div>
                </button>
            }
        </div>

        @* Active step content *@
        @{
            var activeStep = System.Array.Find(_paletteSteps, s => s.Id == _activeStepId);
        }
        @if (activeStep != null)
        {
            <div class="border-t px-4 py-4">
                <div class="mb-3 flex items-center justify-between">
                    <div>
                        <span class="font-medium text-sm">@activeStep.Label</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@activeStep.Description</p>
                    </div>
                    <ButtonCn Variant="@(_completedSteps.Contains(_activeStepId) ? ButtonVariant.Ghost : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="HandleMarkComplete">
                        @if (_completedSteps.Contains(_activeStepId))
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                            <span>Done</span>
                        }
                        else
                        {
                            <span>Mark done</span>
                        }
                    </ButtonCn>
                </div>
                <div class="space-y-1.5">
                    @foreach (var field in activeStep.Fields)
                    {
                        <div class="flex items-center justify-between rounded-md bg-muted/30 px-3 py-2.5">
                            <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                            <span class="text-sm">@field.Value</span>
                        </div>
                    }
                </div>
            </div>

            @* Footer with keyboard hints *@
            <div class="flex items-center justify-between border-t px-4 py-2.5">
                <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                        <span class="rounded border border-muted-foreground/15 bg-muted/30 px-1 py-0.5 font-mono text-xs leading-none">
                            &uarr;
                        </span>
                        <span class="rounded border border-muted-foreground/15 bg-muted/30 px-1 py-0.5 font-mono text-xs leading-none">
                            &darr;
                        </span>
                        navigate
                    </span>
                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                        <span class="rounded border border-muted-foreground/15 bg-muted/30 px-1.5 py-0.5 font-mono text-xs leading-none">
                            &crarr;
                        </span>
                        select
                    </span>
                </div>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_completedSteps.Count of @_paletteSteps.Length complete
                </span>
            </div>
        }
    </div>
</section>

@code {
    private record FieldItem(string Label, string Value);

    private record PaletteStep(string Id, string Label, string Description, string Shortcut, string IconName, FieldItem[] Fields);

    private static readonly PaletteStep[] _paletteSteps =
    [
        new("project", "Project settings", "Name, slug, and visibility", "1", "settings",
        [
            new("Project name", "Acme Platform"),
            new("Slug", "acme-platform"),
            new("Visibility", "Private"),
        ]),
        new("database", "Database", "Connection, pooling, and migrations", "2", "database",
        [
            new("Provider", "PostgreSQL (Neon)"),
            new("Connection pooling", "Enabled (25 connections)"),
            new("Migrations", "Prisma Migrate"),
        ]),
        new("auth", "Authentication", "Providers, sessions, and MFA", "3", "shield",
        [
            new("Provider", "Better Auth"),
            new("OAuth", "Google, GitHub"),
            new("MFA", "TOTP enabled"),
        ]),
        new("api", "API routes", "Endpoints, rate limits, and versioning", "4", "webhook",
        [
            new("Endpoints", "24 routes"),
            new("Rate limit", "100 req/min per IP"),
            new("Versioning", "URL path (/api/v1)"),
        ]),
        new("team", "Team members", "Invite members and assign roles", "5", "users",
        [
            new("Members", "8 active"),
            new("Pending invites", "2"),
            new("Roles", "Admin, Developer, Viewer"),
        ]),
        new("domains", "Custom domains", "Domain configuration and SSL", "6", "globe",
        [
            new("Primary", "app.acme.com"),
            new("SSL", "Auto-provisioned (Let's Encrypt)"),
            new("DNS status", "Verified"),
        ]),
        new("keys", "API keys", "Generate and manage access tokens", "7", "key",
        [
            new("Active keys", "3"),
            new("Last rotated", "14 days ago"),
            new("Scopes", "Read, Write, Admin"),
        ]),
        new("dashboard", "Dashboard layout", "Widgets, metrics, and default view", "8", "layout-dashboard",
        [
            new("Widgets", "6 configured"),
            new("Default view", "Overview"),
            new("Refresh interval", "30 seconds"),
        ]),
        new("deploy", "Deploy", "Build, preview, and production settings", "9", "rocket",
        [
            new("Target", "Vercel (Production)"),
            new("Build command", "next build"),
            new("Region", "US East (iad1)"),
        ]),
    ];

    private string _search = "";
    private string _activeStepId = "project";
    private HashSet<string> _completedSteps = ["project", "database"];
    private int _highlightIndex = 0;

    private PaletteStep[] FilteredSteps
    {
        get
        {
            var q = _search.Trim();
            if (string.IsNullOrEmpty(q)) return _paletteSteps;
            var lower = q.ToLowerInvariant();
            return System.Array.FindAll(_paletteSteps,
                s => s.Label.ToLowerInvariant().Contains(lower) || s.Description.ToLowerInvariant().Contains(lower));
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        var filtered = FilteredSteps;
        if (e.Key == "ArrowDown")
        {
            _highlightIndex = Math.Min(_highlightIndex + 1, filtered.Length - 1);
        }
        else if (e.Key == "ArrowUp")
        {
            _highlightIndex = Math.Max(_highlightIndex - 1, 0);
        }
        else if (e.Key == "Enter" && _highlightIndex >= 0 && _highlightIndex < filtered.Length)
        {
            _activeStepId = filtered[_highlightIndex].Id;
        }
    }

    private void HandleMarkComplete()
    {
        if (!string.IsNullOrEmpty(_activeStepId))
        {
            if (_completedSteps.Contains(_activeStepId))
                _completedSteps.Remove(_activeStepId);
            else
                _completedSteps.Add(_activeStepId);
        }
    }
}
