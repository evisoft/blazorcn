@* ============================================================
   Block: stepper-journey-map
   Title: StepperJourneyMap
   Description: A winding path stepper with SVG curved route, numbered waypoint markers, and animated progress trail built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-journey-map.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="map-pin" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Project journey</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Waypoint <span class="tabular-nums">@(_activeWaypoint + 1)</span> of <span class="tabular-nums">@_waypoints.Length</span>
            </BadgeCn>
        </div>

        @* Journey map *@
        <div class="border-b px-4 py-4">
            <div class="flex justify-center">
                <div class="relative" style="width:280px;height:360px">
                    <svg
                        viewBox="0 0 280 360"
                        width="280"
                        height="360"
                        fill="none"
                        class="absolute inset-0"
                        aria-label="Journey path connecting all waypoints">
                        <title>Journey path</title>
                        @* Background path *@
                        <path
                            d="@_pathD"
                            stroke="currentColor"
                            stroke-width="3"
                            stroke-linecap="round"
                            stroke-dasharray="8 6"
                            class="text-muted-foreground/15" />
                        @* Progress path *@
                        <path
                            d="@_pathD"
                            stroke="currentColor"
                            stroke-width="3"
                            stroke-linecap="round"
                            class="text-emerald-500 dark:text-emerald-600"
                            pathLength="100"
                            stroke-dasharray="100"
                            stroke-dashoffset="@(100.0 - (double)_activeWaypoint / (_waypoints.Length - 1) * 100.0)"
                            style="transition: stroke-dashoffset 0.6s ease" />
                    </svg>

                    @* Waypoint markers *@
                    @foreach (var wp in _waypoints)
                    {
                        var idx = Array.IndexOf(_waypoints, wp);
                        var isCompleted = idx < _activeWaypoint;
                        var isActive = idx == _activeWaypoint;
                        var isUpcoming = idx > _activeWaypoint;
                        var capturedIdx = idx;
                        <button
                            type="button"
                            @onclick="@(() => _activeWaypoint = capturedIdx)"
                            class="absolute -translate-x-1/2 -translate-y-1/2"
                            style="@($"left:{wp.X}px;top:{wp.Y}px")">
                            <div class="flex flex-col items-center gap-1.5">
                                <div class="@Cn.Merge("flex items-center justify-center rounded-full transition-all duration-300", isCompleted ? "size-9 bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "size-11 bg-blue-500 text-white shadow-lg shadow-blue-500/25 dark:bg-blue-600 dark:shadow-blue-400/25" : "size-9 border-2 border-muted-foreground/20 bg-card text-muted-foreground")">
                                    @if (isCompleted)
                                    {
                                        <LucideIconCn Name="flag" Size="14" Class="size-3.5" />
                                    }
                                    else
                                    {
                                        <span class="@Cn.Merge("font-medium tabular-nums", isActive ? "text-sm" : "text-xs")">
                                            @(idx + 1)
                                        </span>
                                    }
                                </div>
                                <span class="@Cn.Merge("whitespace-nowrap text-xs", isActive ? "font-medium text-foreground" : isUpcoming ? "text-muted-foreground/60" : "font-medium text-muted-foreground")">
                                    @wp.Label
                                </span>
                            </div>
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Waypoint detail *@
        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <span class="font-medium text-sm">@_waypoints[_activeWaypoint].Label</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@_waypoints[_activeWaypoint].Description</p>
            </div>
            <div class="rounded-md bg-muted/50 p-3">
                <span class="font-medium text-muted-foreground text-xs">Progress update</span>
                <p class="mt-1 text-sm leading-relaxed">@_waypoints[_activeWaypoint].Detail</p>
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeWaypoint == 0)" OnClick="HandleBack">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Previous
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" Disabled="@(_activeWaypoint == _waypoints.Length - 1)" OnClick="HandleNext">
                @(_activeWaypoint == _waypoints.Length - 1 ? "Complete" : "Next waypoint")
                @if (_activeWaypoint < _waypoints.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Waypoint(string Label, string Description, string Detail, int X, int Y);

    private static readonly Waypoint[] _waypoints =
    [
        new("Start",       "Project initiation",  "Requirements finalized, team assembled, timeline approved by stakeholders",                     60,  40),
        new("Milestone 1", "Design complete",      "Wireframes approved, design system built, component library scaffolded",                       220, 110),
        new("Checkpoint",  "Mid-project review",   "Sprint retrospective done, backlog reprioritized, scope validated with client",                  60, 180),
        new("Milestone 2", "Feature freeze",       "All features implemented, integration tests passing, staging deployed",                        220, 250),
        new("Destination", "Production launch",    "Final QA signed off, production deployed, monitoring dashboards live",                         140, 320),
    ];

    private static readonly string _pathD = BuildPath(_waypoints);

    private int _activeWaypoint = 2;

    private static string BuildPath(Waypoint[] points)
    {
        if (points.Length < 2) return "";
        var d = $"M {points[0].X} {points[0].Y}";
        for (int i = 1; i < points.Length; i++)
        {
            var prev = points[i - 1];
            var curr = points[i];
            var cpX = (prev.X + curr.X) / 2;
            var cpY1 = prev.Y;
            var cpY2 = curr.Y;
            d += $" C {cpX} {cpY1}, {cpX} {cpY2}, {curr.X} {curr.Y}";
        }
        return d;
    }

    private void HandleNext()
    {
        if (_activeWaypoint < _waypoints.Length - 1)
            _activeWaypoint++;
    }

    private void HandleBack()
    {
        if (_activeWaypoint > 0)
            _activeWaypoint--;
    }
}
