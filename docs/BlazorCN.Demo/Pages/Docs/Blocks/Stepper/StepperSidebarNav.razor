@* ============================================================
   Block: stepper-sidebar-nav
   Title: StepperSidebarNav
   Description: A two-panel stepper with a vertical sidebar navigation and content area showing form fields, step indicators, and completion tracking built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-sidebar-nav.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex">
            @* Sidebar *@
            <div class="w-56 shrink-0 border-r">
                @* Sidebar header *@
                <div class="border-b px-4 py-3">
                    <div class="font-medium text-sm">New project</div>
                    <p class="text-muted-foreground text-xs tabular-nums">
                        @_completed.Count of @_steps.Length complete
                    </p>
                </div>

                @* Step list *@
                <div class="py-1">
                    @foreach (var stepItem in _steps)
                    {
                        var step = stepItem;
                        var index = Array.IndexOf(_steps, step);
                        var isActive = _activeStep == step.Id;
                        var isCompleted = _completed.Contains(step.Id);
                        <button
                            type="button"
                            @onclick="@(() => _activeStep = step.Id)"
                            class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors", isActive ? "bg-muted/50" : "hover:bg-muted/30")">
                            <span class="@Cn.Merge("flex size-6 shrink-0 items-center justify-center rounded-full text-xs tabular-nums", isCompleted ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : isActive ? "bg-blue-500/10 text-blue-600 dark:text-blue-400" : "bg-muted text-muted-foreground")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    @(index + 1)
                                }
                            </span>
                            <div class="min-w-0 flex-1">
                                <div class="@Cn.Merge("truncate text-xs font-medium", isActive ? "text-foreground" : "text-muted-foreground")">
                                    @step.Label
                                </div>
                                <div class="truncate text-muted-foreground/60 text-[10px]">
                                    @step.Description
                                </div>
                            </div>
                            @if (isActive)
                            {
                                <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 shrink-0 text-muted-foreground/40" />
                            }
                        </button>
                    }
                </div>

                @* Sidebar footer - progress *@
                <div class="border-t px-4 py-3">
                    <div class="flex h-1.5 gap-1">
                        @foreach (var stepItem in _steps)
                        {
                            var step = stepItem;
                            <span class="@Cn.Merge("flex-1 rounded-full transition-colors", _completed.Contains(step.Id) ? "bg-emerald-500" : _activeStep == step.Id ? "bg-blue-500" : "bg-muted")"></span>
                        }
                    </div>
                </div>
            </div>

            @* Content panel *@
            <div class="flex flex-1 flex-col">
                @* Content header *@
                <div class="border-b px-6 py-4">
                    <div class="font-medium text-sm">@_currentContent.Title</div>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_currentContent.Subtitle</p>
                </div>

                @* Fields *@
                <div class="flex-1 px-6 py-4">
                    @for (int fi = 0; fi < _currentContent.Fields.Length; fi++)
                    {
                        var field = _currentContent.Fields[fi];
                        var isLastField = fi == _currentContent.Fields.Length - 1;
                        <div class="@Cn.Merge("flex items-start justify-between py-3", !isLastField ? "border-b" : "")">
                            <div>
                                <span class="text-muted-foreground text-xs">@field.Label</span>
                                @if (field.Hint != null)
                                {
                                    <p class="text-muted-foreground/60 text-[10px]">@field.Hint</p>
                                }
                            </div>
                            <span class="font-medium text-sm">@field.Value</span>
                        </div>
                    }
                </div>

                @* Content footer *@
                <div class="flex items-center justify-between border-t px-6 py-3">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="HandlePrevious" Disabled="@(_activeIndex == 0)">
                        Previous
                    </ButtonCn>
                    @if (_activeIndex < _steps.Length - 1)
                    {
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="MarkCompleteAndNext">
                            Save & continue
                        </ButtonCn>
                    }
                    else
                    {
                        <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="DeployProject">
                            Deploy project
                        </ButtonCn>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record StepField(string Label, string Value, string? Hint = null);
    private record StepContent(string Title, string Subtitle, StepField[] Fields);
    private record StepDef(string Id, string Label, string Description);

    private string _activeStep = "basics";
    private readonly HashSet<string> _completed = new();

    private static readonly StepDef[] _steps =
    [
        new("basics", "Project basics", "Name and framework"),
        new("team", "Team setup", "Members and roles"),
        new("repo", "Repository", "Git configuration"),
        new("cicd", "CI/CD pipeline", "Build and test"),
        new("deploy", "Deploy", "Environment setup"),
    ];

    private static readonly Dictionary<string, StepContent> _stepContent = new()
    {
        ["basics"] = new("Project basics", "Set up the core details for your new project.",
        [
            new("Project name", "acme-dashboard", "Lowercase, no spaces"),
            new("Framework", "Next.js 16 (App Router)"),
            new("Node version", "22.x"),
            new("Package manager", "bun"),
            new("Root directory", "./"),
        ]),
        ["team"] = new("Team setup", "Add team members and assign roles.",
        [
            new("Owner", "sarah@acme.com", "Full admin access"),
            new("Developer", "alex@acme.com"),
            new("Developer", "jordan@acme.com"),
            new("Viewer", "product-team@acme.com"),
            new("Invite link", "Enabled for acme.com domain"),
        ]),
        ["repo"] = new("Repository", "Connect your Git repository for version control.",
        [
            new("Provider", "GitHub"),
            new("Repository", "acme-org/acme-dashboard"),
            new("Branch", "main", "Production branch"),
            new("Auto-deploy", "On push to main"),
            new("PR previews", "Enabled"),
        ]),
        ["cicd"] = new("CI/CD pipeline", "Configure automated build, test, and deployment steps.",
        [
            new("Build command", "bun run build"),
            new("Install command", "bun install --frozen-lockfile"),
            new("Test command", "bun test"),
            new("Lint command", "bun biome check ."),
            new("Build timeout", "10 minutes"),
        ]),
        ["deploy"] = new("Deploy", "Configure your production environment and deploy.",
        [
            new("Environment", "Production"),
            new("Region", "US East (iad1)"),
            new("Domain", "dashboard.acme.com"),
            new("Environment vars", "12 configured", "Encrypted at rest"),
            new("Edge functions", "Enabled"),
        ]),
    };

    private int _activeIndex => Array.FindIndex(_steps, s => s.Id == _activeStep);
    private StepContent _currentContent => _stepContent[_activeStep];

    private void MarkCompleteAndNext()
    {
        _completed.Add(_activeStep);
        var nextIndex = _activeIndex + 1;
        if (nextIndex < _steps.Length)
        {
            _activeStep = _steps[nextIndex].Id;
        }
    }

    private void DeployProject()
    {
        _completed.Add(_activeStep);
    }

    private void HandlePrevious()
    {
        var idx = _activeIndex;
        if (idx > 0)
        {
            _activeStep = _steps[idx - 1].Id;
        }
    }
}
