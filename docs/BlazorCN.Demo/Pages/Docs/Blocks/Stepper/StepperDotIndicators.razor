@* ============================================================
   Block: stepper-dot-indicators
   Title: StepperDotIndicators
   Description: An ultra-minimal dot-based stepper with animated active dot, centered content, and arrow navigation built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-dot-indicators.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with step title *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">@_steps[_activeStep].Title</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @(_activeStep + 1) of @_steps.Length
            </span>
        </div>

        @* Content area *@
        <div class="border-b px-6 py-8">
            <div class="mx-auto max-w-md text-center">
                <h3 class="font-medium text-base">@_steps[_activeStep].Heading</h3>
                <p class="mt-3 text-muted-foreground text-sm leading-relaxed">
                    @_steps[_activeStep].Description
                </p>
                <p class="mt-4 text-muted-foreground/70 text-xs">@_steps[_activeStep].Hint</p>
            </div>
        </div>

        @* Dot indicators + navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn aria-label="Previous step" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 w-8 p-0" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
            </ButtonCn>

            @* Dots *@
            <div class="flex items-center gap-2">
                @foreach (var entry in _steps.Select((s, i) => new { Step = s, Index = i }))
                {
                    var idx = entry.Index;
                    var step = entry.Step;
                    var isCompleted = idx < _activeStep;
                    var isActive = idx == _activeStep;

                    var dotClass = Cn.Merge(
                        "shrink-0 rounded-full transition-all duration-300",
                        isActive
                            ? "h-2.5 w-7 bg-blue-500 dark:bg-blue-400"
                            : isCompleted
                                ? "size-2.5 bg-emerald-500 cursor-pointer hover:bg-emerald-600 dark:bg-emerald-400 dark:hover:bg-emerald-300"
                                : "size-2 bg-muted-foreground/25 cursor-default");

                    <button
                        type="button" aria-label="@($"Step {idx + 1}: {step.Title}")"
                        @onclick="@(() => HandleDotClick(idx))"
                        disabled="@(idx > _activeStep)"
                        class="@dotClass">
                    </button>
                }
            </div>

            <ButtonCn aria-label="Next step" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 w-8 p-0" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Title, string Heading, string Description, string Hint);

    private int _activeStep = 0;

    private static readonly StepItem[] _steps =
    [
        new("Welcome",
            "Welcome to your workspace",
            "Everything you need to build, ship, and iterate on products fast. We have set up a few things to get you started. This quick tour takes about 2 minutes.",
            "Press the arrow to continue"),
        new("Features tour",
            "Explore powerful features",
            "Real-time collaboration lets your team edit simultaneously. Version history tracks every change with one-click rollback. Integrations connect your favorite tools, from Slack to GitHub, in seconds.",
            "3 of your integrations are ready to connect"),
        new("Preferences",
            "Make it yours",
            "Choose your theme, set notification preferences, and configure your default workspace layout. These settings sync across all your devices and can be changed anytime from the settings panel.",
            "You can always update these later"),
        new("Get started",
            "You are all set",
            "Your workspace is configured and ready. Start by creating your first project, inviting team members, or exploring the template gallery for pre-built starting points.",
            "Your first project is just one click away"),
    ];

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleDotClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
