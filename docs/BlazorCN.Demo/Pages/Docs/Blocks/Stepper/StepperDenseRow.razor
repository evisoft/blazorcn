@* ============================================================
   Block: stepper-dense-row
   Title: StepperDenseRow
   Description: A dense horizontal row stepper with tightly packed step buttons, scroll overflow, and inline status built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-dense-row.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Configuration</span>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                    @_progress%
                </BadgeCn>
            </div>
        </div>

        @* Dense step row *@
        <div class="border-b px-3 py-3">
            <div class="flex gap-1 overflow-x-auto">
                @foreach (var item in _steps)
                {
                    var idx = Array.IndexOf(_steps, item);
                    var isCompleted = idx < _activeStep;
                    var isActive = idx == _activeStep;
                    var btnClass = Cn.Merge("flex shrink-0 items-center gap-1 rounded-md px-2.5 py-1.5 text-xs transition-colors",
                        isActive
                            ? "bg-blue-500 font-medium text-white dark:bg-blue-600"
                            : isCompleted
                                ? "bg-muted/60 text-emerald-600 hover:bg-muted dark:text-emerald-400"
                                : "bg-muted/40 text-muted-foreground hover:bg-muted/70");
                    var capturedIdx = idx;
                    <button type="button" @onclick="@(() => _activeStep = capturedIdx)" title="@item.Heading" class="@btnClass">
                        @if (isCompleted)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3 shrink-0" />
                        }
                        <span class="max-w-[80px] truncate">@item.Label</span>
                    </button>
                }
            </div>
        </div>

        @* Content *@
        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <span class="font-medium text-sm">@_steps[_activeStep].Heading</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@_steps[_activeStep].Description</p>
            </div>
            <div class="space-y-2">
                @foreach (var field in _steps[_activeStep].Fields)
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                        <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                        <span class="text-sm">@field.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <span class="text-muted-foreground text-xs tabular-nums">
                @(_activeStep + 1) of @_steps.Length
            </span>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Finish" : "Next")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FieldItem(string Label, string Value);
    private record StepItem(string Label, string Heading, string Description, FieldItem[] Fields);

    private static readonly StepItem[] _steps =
    [
        new("Auth", "Authentication", "Configure sign-in providers and session management.",
        [
            new("Provider", "OAuth 2.0 (Google)"),
            new("Session", "JWT — 7 day expiry"),
            new("MFA", "TOTP enabled"),
        ]),
        new("Profile", "User profile", "Set up user profile fields and avatar handling.",
        [
            new("Display name", "Required"),
            new("Avatar", "Gravatar fallback"),
            new("Bio", "Optional — 280 chars"),
        ]),
        new("Prefs", "Preferences", "Default settings for theme, language, and notifications.",
        [
            new("Theme", "System default"),
            new("Language", "English (US)"),
            new("Notifications", "Email + in-app"),
        ]),
        new("Team", "Team settings", "Workspace roles, invitations, and permission levels.",
        [
            new("Max members", "25 seats"),
            new("Default role", "Member"),
            new("Invite method", "Email link"),
        ]),
        new("Billing", "Billing setup", "Payment method, invoicing, and subscription tier.",
        [
            new("Plan", "Team — $79/mo"),
            new("Payment", "Visa ending 4242"),
            new("Billing cycle", "Monthly"),
        ]),
        new("API", "API configuration", "Rate limits, key management, and webhook endpoints.",
        [
            new("Rate limit", "1,000 req/min"),
            new("API keys", "2 active keys"),
            new("Webhooks", "3 endpoints"),
        ]),
        new("Security", "Security policies", "Password rules, IP allowlists, and audit logging.",
        [
            new("Password min", "12 characters"),
            new("IP allowlist", "Disabled"),
            new("Audit log", "90-day retention"),
        ]),
        new("Deploy", "Deployment", "Target environment, region, and rollback configuration.",
        [
            new("Environment", "Production"),
            new("Region", "us-east-1"),
            new("Rollback", "Automatic — 5 min"),
        ]),
    ];

    private int _activeStep = 3;

    private int _progress => (int)Math.Round((double)_activeStep / (_steps.Length - 1) * 100);

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }
}
