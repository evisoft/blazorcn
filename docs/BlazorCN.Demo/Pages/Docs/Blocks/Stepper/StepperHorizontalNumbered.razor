@* ============================================================
   Block: stepper-horizontal-numbered
   Title: StepperHorizontalNumbered
   Description: A horizontal numbered stepper wizard with clickable steps, progress tracking, and step content built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/stepper/stepper-horizontal-numbered.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Checkout</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Step @(_activeStep + 1) of @_steps.Length
            </BadgeCn>
        </div>

        @* Stepper *@
        <div class="border-b px-6 py-6">
            <div class="flex items-center">
                @foreach (var stp in _steps)
                {
                    var index = Array.IndexOf(_steps, stp);
                    var isCompleted = index < _activeStep;
                    var isActive = index == _activeStep;
                    var isUpcoming = index > _activeStep;
                    <div class="flex flex-1 items-center last:flex-none">
                        @* Step circle + label *@
                        <div class="flex flex-col items-center gap-2">
                            <button
                                type="button"
                                @onclick="@(() => HandleStepClick(index))"
                                disabled="@isUpcoming"
                                class="@Cn.Merge("flex size-9 shrink-0 items-center justify-center rounded-full font-medium text-sm tabular-nums transition-all duration-200", isCompleted ? "bg-emerald-500 text-white dark:bg-emerald-600" : isActive ? "ring-2 ring-blue-500 ring-offset-2 ring-offset-card bg-blue-500 text-white dark:bg-blue-600 dark:ring-blue-400" : "border-2 border-muted-foreground/25 text-muted-foreground", isUpcoming ? "cursor-default" : "cursor-pointer")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="size-4" />
                                }
                                else
                                {
                                    <span>@(index + 1)</span>
                                }
                            </button>
                            <div class="flex flex-col items-center text-center">
                                <span class="@Cn.Merge("font-medium text-xs", isActive ? "text-foreground" : "text-muted-foreground")">
                                    @stp.Label
                                </span>
                            </div>
                        </div>

                        @* Connecting line *@
                        @if (index < _steps.Length - 1)
                        {
                            <div class="mx-2 mb-6 h-0.5 flex-1">
                                <div class="@Cn.Merge("h-full rounded-full transition-colors duration-300", index < _activeStep ? "bg-emerald-500 dark:bg-emerald-600" : "bg-muted-foreground/20")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Step content *@
        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <span class="font-medium text-sm">@_steps[_activeStep].Label</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@_steps[_activeStep].Description</p>
            </div>
            <div class="space-y-3">
                @foreach (var field in _stepContent[_activeStep])
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                        <span class="font-medium text-muted-foreground text-xs">@field.Label</span>
                        <span class="text-sm">@field.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Navigation *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleBack" Disabled="@(_activeStep == 0)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" OnClick="HandleNext" Disabled="@(_activeStep == _steps.Length - 1)">
                @(_activeStep == _steps.Length - 1 ? "Submit" : "Continue")
                @if (_activeStep < _steps.Length - 1)
                {
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Label, string Description);
    private record FieldItem(string Label, string Value);

    private static readonly StepItem[] _steps =
    [
        new("Personal info", "Name, email, and phone number"),
        new("Address", "Shipping and billing address"),
        new("Payment", "Card details and billing"),
        new("Confirmation", "Review and submit your order"),
    ];

    private static readonly FieldItem[][] _stepContent =
    [
        [
            new("Full name", "Alex Johnson"),
            new("Email", "alex@example.com"),
            new("Phone", "+1 (555) 234-5678"),
        ],
        [
            new("Street address", "742 Evergreen Terrace"),
            new("City", "Springfield"),
            new("State / ZIP", "IL 62704"),
        ],
        [
            new("Card number", "**** **** **** 4242"),
            new("Expiry", "09/28"),
            new("Cardholder", "Alex Johnson"),
        ],
        [
            new("Order total", "$129.00"),
            new("Shipping", "Free — Standard (5-7 days)"),
            new("Payment", "Visa ending in 4242"),
        ],
    ];

    private int _activeStep = 1;

    private void HandleNext()
    {
        if (_activeStep < _steps.Length - 1)
        {
            _activeStep++;
        }
    }

    private void HandleBack()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }

    private void HandleStepClick(int index)
    {
        if (index <= _activeStep)
        {
            _activeStep = index;
        }
    }
}
