@* ============================================================
   Block: features-status-ops-board
   Title: FeaturesStatusOpsBoard
   Description: A status ops board features section for React and Next.js with service rows, status dots, response times, uptime percentages, and 30-day mini bar charts built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-status-ops-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Live status
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Reliability you can verify.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every service, every region, every minute — reported publicly and updated in real time.
            </p>
        </div>

        @* Overall banner *@
        <div class="mt-12 flex flex-wrap items-center justify-between gap-3 rounded-xl border bg-emerald-500/5 px-5 py-4">
            <div class="flex items-center gap-3">
                <span class="relative flex size-2.5">
                    <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-60"></span>
                    <span class="relative inline-flex size-2.5 rounded-full bg-emerald-500"></span>
                </span>
                <div>
                    <p class="text-sm font-medium text-foreground">
                        @(_allOperational ? "All systems operational" : "Partial service disruption")
                    </p>
                    <p class="text-xs text-muted-foreground">
                        Last checked 12 seconds ago · Next refresh in 48s
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2 text-xs font-medium text-emerald-700 dark:text-emerald-400">
                <LucideIconCn Name="circle-check-big" Size="14" Class="size-3.5" aria-hidden="true" />
                Healthy for 14 months
            </div>
        </div>

        @* Service rows *@
        <div class="mt-4 overflow-hidden rounded-xl border bg-card">
            @foreach (var (svc, index) in _services.Select((s, i) => (s, i)))
            {
                var isOperational = svc.Status == "operational";
                <div class="@(Cn.Merge("grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-3 px-5 py-4 sm:grid-cols-[1.6fr_auto_auto_auto] md:grid-cols-[1.6fr_auto_auto_1.3fr]", index > 0 ? "border-t" : ""))">
                    @* Service name + description *@
                    <div class="flex items-start gap-3">
                        <span aria-hidden="true" class="@(Cn.Merge("mt-1.5 size-2 shrink-0 rounded-full", isOperational ? "bg-emerald-500" : "bg-amber-500"))"></span>
                        <div class="min-w-0">
                            <h3 class="text-sm font-medium text-foreground">@svc.Name</h3>
                            <p class="mt-0.5 truncate text-xs text-muted-foreground">
                                @svc.Description
                            </p>
                        </div>
                    </div>

                    @* Response time *@
                    <div class="hidden text-right sm:block">
                        <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            Response
                        </div>
                        <div class="mt-0.5 font-mono text-xs tabular-nums text-foreground">
                            @svc.ResponseTime
                        </div>
                    </div>

                    @* Uptime *@
                    <div class="hidden text-right sm:block">
                        <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            Uptime
                        </div>
                        <div class="@(Cn.Merge("mt-0.5 font-mono text-xs tabular-nums", isOperational ? "text-foreground" : "text-amber-600 dark:text-amber-400"))">
                            @svc.Uptime
                        </div>
                    </div>

                    @* 30-day mini bar chart *@
                    <div aria-hidden="true" class="col-span-2 flex h-6 items-end gap-[2px] sm:col-span-1 md:justify-end">
                        @foreach (var (h, i) in svc.History.Select((v, idx) => (v, idx)))
                        {
                            <span class="@(Cn.Merge("h-full w-1 rounded-[1px]", h == 1 ? "bg-emerald-500/70" : "bg-amber-500/90"))"></span>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer legend *@
        <div class="mt-3 flex flex-wrap items-center justify-between gap-3 px-1 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
            <div class="flex items-center gap-4">
                <span class="inline-flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Operational
                </span>
                <span class="inline-flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    Degraded
                </span>
            </div>
            <span>30-day history · left to right</span>
        </div>

        @* CTA pair *@
        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <ButtonCn Class="w-full sm:w-[230px]">View status page</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[260px]">
                Subscribe to updates
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Service(string Id, string Name, string Description, string Status, string ResponseTime, string Uptime, int[] History);

    private static int[] Healthy() => Enumerable.Repeat(1, 30).ToArray();

    private static int[] WithIncidents(int[] indices)
    {
        var arr = Healthy();
        foreach (var i in indices)
            arr[i] = 0;
        return arr;
    }

    private static readonly Service[] _services =
    [
        new("api-gateway",  "API Gateway",   "Global request routing and auth enforcement.",      "operational", "38ms",  "99.99%",  Healthy()),
        new("edge-network", "Edge Network",  "34 PoPs serving cached and dynamic traffic.",       "operational", "12ms",  "100.00%", Healthy()),
        new("auth",         "Auth",          "OAuth, SSO, and session propagation.",              "operational", "24ms",  "99.98%",  WithIncidents([14])),
        new("database",     "Database",      "Primary cluster with read-replica fanout.",         "degraded",    "72ms",  "99.91%",  WithIncidents([27, 28])),
        new("storage",      "Storage",       "Durable blob and object storage tier.",             "operational", "46ms",  "99.97%",  WithIncidents([9])),
        new("analytics",    "Analytics",     "Events pipeline with sub-second streaming.",        "operational", "52ms",  "99.96%",  Healthy()),
    ];

    private bool _allOperational = _services.All(s => s.Status == "operational");
}
