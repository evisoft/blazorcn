@* ============================================================
   Block: features-book-chapter-toc
   Title: FeaturesBookChapterToc
   Description: A book chapter table of contents features section for React and Next.js with a serif title page and two-column chapter list with leader dots built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-book-chapter-toc.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                The primer
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Read it like a book.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Eight chapters on what we actually believe about building for the long run — each one
                standalone, none of them longer than a coffee.
            </p>
        </div>

        @* Book TOC *@
        <div class="mt-12 overflow-hidden rounded-xl border bg-card">
            @* Title page *@
            <div class="border-b-2 border-double border-foreground/60 bg-background px-8 py-10 text-center sm:py-12">
                <LucideIconCn Name="book-open" Size="20" aria-hidden="true" Class="mx-auto size-5 text-muted-foreground" />
                <h3 class="mt-5 font-serif text-3xl font-bold leading-tight tracking-tight text-foreground sm:text-4xl">
                    @_book.Title
                </h3>
                <p class="mx-auto mt-3 max-w-sm font-serif text-sm italic leading-relaxed text-muted-foreground sm:text-base">
                    @_book.Subtitle
                </p>
                <div aria-hidden="true" class="mx-auto mt-6 h-px w-16 bg-foreground/30"></div>
                <p class="mt-5 font-serif text-xs font-semibold uppercase tracking-[0.2em] text-foreground">
                    @_book.Author
                </p>
                <p class="mt-1 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    @_book.Publisher
                </p>
            </div>

            @* Contents heading *@
            <div class="flex items-center justify-between px-6 pb-2 pt-6">
                <p class="font-serif text-[11px] font-semibold uppercase tracking-[0.25em] text-foreground">
                    Contents
                </p>
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Eight chapters
                </p>
            </div>

            @* Two-column chapter list *@
            <ol class="grid grid-cols-1 md:grid-cols-2 md:divide-x">
                @foreach (var ch in _chapters)
                {
                    <li class="border-b px-6 py-4 last:border-b-0 md:[&:nth-last-child(2)]:border-b-0">
                        <div class="flex items-baseline gap-3">
                            <span aria-hidden="true" class="shrink-0 font-serif text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                                Ch. @ch.Numeral
                            </span>
                            <div class="flex min-w-0 flex-1 items-baseline gap-2">
                                <h3 class="shrink-0 font-serif text-sm font-semibold leading-snug tracking-tight text-foreground">
                                    @ch.Title
                                </h3>
                                <span aria-hidden="true" class="min-w-0 flex-1 translate-y-[-3px] truncate text-muted-foreground/40">
                                    ··························································
                                </span>
                                <span class="shrink-0 font-mono text-xs tabular-nums text-muted-foreground">
                                    @ch.Page
                                </span>
                            </div>
                        </div>
                        <p class="mt-1.5 pl-[3.25rem] font-serif text-xs italic leading-relaxed text-muted-foreground">
                            @ch.Pitch
                        </p>
                    </li>
                }
            </ol>

            @* Footer colophon *@
            <div class="flex items-center justify-between border-t bg-muted/30 px-6 py-3 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                <span>Index · Notes · Colophon</span>
                <span class="font-mono tabular-nums">VIII / VIII</span>
            </div>
        </div>

        @* CTA pair *@
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <ButtonCn Class="w-full sm:w-[200px]">Start reading</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[170px]">View index</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record BookMeta(string Title, string Subtitle, string Author, string Publisher);
    private record Chapter(string Id, string Numeral, string Title, string Pitch, string Page);

    private static readonly BookMeta _book = new(
        "The Platform Primer",
        "Eight chapters on building, shipping, and sleeping through the night.",
        "By the Engineering Desk",
        "Ship Press · First Edition · 2026"
    );

    private static readonly Chapter[] _chapters =
    [
        new("ch-1", "I",    "Laying the Foundations",       "On choosing a runtime, a database, and the handful of defaults you will not regret.",                                        "003"),
        new("ch-2", "II",   "Shipping Small, Shipping Often","Why the pull request smaller than a screenful is the unit of a healthy team.",                                               "024"),
        new("ch-3", "III",  "Observability Before Incidents","Traces, logs, and metrics as a form of literacy, not a form of insurance.",                                                  "051"),
        new("ch-4", "IV",   "The Honest Incident Review",    "A script for running a postmortem where nobody leaves the room feeling smaller.",                                             "078"),
        new("ch-5", "V",    "A Practical Guide to Flags",    "Rolling out changes with the calm of someone who knows where the off switch is.",                                            "102"),
        new("ch-6", "VI",   "Designing for the Edge",        "Why the fastest request is the one your users never noticed left their continent.",                                          "131"),
        new("ch-7", "VII",  "Paying Down the Right Debt",    "A field guide to the kinds of cleanup that pay for themselves by the end of the quarter.",                                   "158"),
        new("ch-8", "VIII", "An Appendix of Small Rituals",  "Standups, retros, and the weekly walk that matters more than any of them.",                                                  "184"),
    ];
}
