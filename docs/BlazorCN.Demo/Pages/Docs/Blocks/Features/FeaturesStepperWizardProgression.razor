@* ============================================================
   Block: features-stepper-wizard-progression
   Title: FeaturesStepperWizardProgression
   Description: A stepper wizard features section for React and Next.js showcasing an onboarding flow with a numbered step header, active step form mockup, progress bar, and navigation controls built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-stepper-wizard-progression.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-muted-foreground">
                <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                Guided onboarding, five steps
            </span>
            <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                From signup to shipping in minutes.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A five-step setup wizard that walks every new team through workspace, people,
                integrations, billing, and a final review — without ever leaving the flow.
            </p>
        </div>

        @* Wizard card *@
        <div class="mx-auto mt-10 overflow-hidden rounded-xl border bg-card shadow-sm">
            @* Stepper header *@
            <div class="border-b px-6 pb-8 pt-7 sm:px-10">
                <ol class="relative flex items-start justify-between">
                    @* Connector line (behind circles) *@
                    <div
                        aria-hidden="true"
                        class="absolute left-5 right-5 top-5 h-px bg-border sm:left-6 sm:right-6 sm:top-6">
                    </div>
                    <div
                        aria-hidden="true"
                        class="absolute left-5 top-5 h-px bg-foreground sm:left-6 sm:top-6"
                        style="@($"width: calc({_progressPercent}% - 0px); max-width: calc(100% - 40px);")">
                    </div>

                    @for (var i = 0; i < _steps.Length; i++)
                    {
                        var step = _steps[i];
                        var index = i;
                        var isCompleted = index < _activeStepIndex;
                        var isActive = index == _activeStepIndex;
                        <li aria-current="@(isActive ? "step" : null)" class="relative z-10 flex flex-col items-center">
                            @* Circle *@
                            <span class="relative flex size-10 items-center justify-center sm:size-12">
                                @if (isActive)
                                {
                                    <span aria-hidden="true" class="absolute inset-0 rounded-full border-2 border-foreground/30"></span>
                                }
                                <span class="@Cn.Merge("relative flex size-10 items-center justify-center rounded-full border text-sm font-semibold tabular-nums sm:size-12", isCompleted ? "border-foreground bg-foreground text-background" : isActive ? "border-foreground bg-background text-foreground" : "border-border bg-background text-muted-foreground")">
                                    @if (isCompleted)
                                    {
                                        <LucideIconCn Name="check" Size="20" Class="size-5" aria-hidden="true" />
                                    }
                                    else
                                    {
                                        @step.Index
                                    }
                                </span>
                            </span>

                            @* Label *@
                            <span class="mt-3 hidden text-center sm:block">
                                <span class="@Cn.Merge("block text-xs font-medium", (isActive || isCompleted) ? "text-foreground" : "text-muted-foreground")">
                                    @step.Label
                                </span>
                                <span class="mt-0.5 block text-[10px] text-muted-foreground">
                                    @step.Hint
                                </span>
                            </span>
                        </li>
                    }
                </ol>
            </div>

            @* Active step form mockup *@
            <div class="px-6 py-7 sm:px-10">
                <div class="mb-5">
                    <div class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                        <span>
                            Step @(_activeStepIndex + 1) of @(_steps.Length)
                        </span>
                        <span class="h-3 w-px bg-border" aria-hidden="true"></span>
                        <span>@(_steps[_activeStepIndex].Label)</span>
                    </div>
                    <h3 class="mt-2 text-lg font-semibold tracking-tight text-foreground">
                        Choose a plan that fits your team.
                    </h3>
                    <p class="mt-1 text-sm text-muted-foreground">
                        Seat count scales automatically — add teammates any time and only pay for what you
                        use.
                    </p>
                </div>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    @foreach (var field in _activeStepForm)
                    {
                        <div class="@(field.Span == "full" ? "sm:col-span-2" : "")">
                            <span class="mb-1.5 block text-xs font-medium text-foreground">
                                @field.Label
                            </span>
                            <div class="flex h-10 items-center rounded-md border bg-background px-3 text-sm text-muted-foreground">
                                @field.Placeholder
                            </div>
                            @if (!string.IsNullOrEmpty(field.Help))
                            {
                                <span class="mt-1.5 flex items-center gap-1.5 text-[11px] text-muted-foreground">
                                    <LucideIconCn Name="info" Size="12" Class="size-3" aria-hidden="true" />
                                    @field.Help
                                </span>
                            }
                        </div>
                    }
                </div>

                @* Progress bar + navigation *@
                <div class="mt-7 border-t pt-5">
                    <div class="flex items-center justify-between text-[11px] font-medium text-muted-foreground">
                        <span>
                            Step @(_activeStepIndex + 1) of @(_steps.Length)
                        </span>
                        <span class="tabular-nums">@_progressPercent% complete</span>
                    </div>
                    <div
                        role="progressbar"
                        aria-valuemin="0"
                        aria-valuemax="100"
                        aria-valuenow="@_progressPercent"
                        class="mt-2 h-1 w-full overflow-hidden rounded-full bg-muted">
                        <div
                            class="h-full rounded-full bg-foreground"
                            style="@($"width: {_progressPercent}%;")">
                        </div>
                    </div>

                    <div class="mt-5 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                        <button
                            type="button"
                            class="inline-flex items-center justify-center gap-2 rounded-md border bg-background px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/50">
                            <LucideIconCn Name="arrow-left" Size="16" Class="size-4" aria-hidden="true" />
                            Back
                        </button>
                        <button
                            type="button"
                            class="inline-flex items-center justify-center gap-2 rounded-md border border-foreground bg-foreground px-4 py-2 text-sm font-medium text-background transition-opacity hover:opacity-90">
                            Continue
                            <LucideIconCn Name="arrow-right" Size="16" Class="size-4" aria-hidden="true" />
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[180px]">Start setup</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[240px]">Watch walkthrough</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record WizardStep(string Id, int Index, string Label, string Hint);

    private record FormField(string Id, string Label, string Placeholder, string Help = "", string Span = "");

    private static readonly WizardStep[] _steps =
    [
        new("workspace", 1, "Workspace", "Name & URL"),
        new("team", 2, "Team", "Invite members"),
        new("integrations", 3, "Integrations", "Connect apps"),
        new("billing", 4, "Billing", "Choose plan"),
        new("review", 5, "Review", "Confirm setup"),
    ];

    private const int _activeStepIndex = 3; // 0-based -> "Billing" is step 4 of 5

    private static readonly FormField[] _activeStepForm =
    [
        new("plan", "Billing plan", "Team — $29 per seat / month", "You can change plans or cancel at any time.", "full"),
        new("seats", "Number of seats", "12 seats", "", "half"),
        new("cycle", "Billing cycle", "Annual (save 20%)", "", "half"),
        new("card", "Payment method", "Visa ending in 4242", "Processed securely. We never store your card number.", "full"),
    ];

    private static readonly int _progressPercent = (int)Math.Round((double)_activeStepIndex / (_steps.Length - 1) * 100);
}
