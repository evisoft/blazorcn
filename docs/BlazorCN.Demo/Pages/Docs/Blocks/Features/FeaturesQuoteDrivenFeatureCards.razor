@* ============================================================
   Block: features-quote-driven-feature-cards
   Title: FeaturesQuoteDrivenFeatureCards
   Description: A quote-driven feature card grid for React and Next.js where each card is a customer pull quote about one specific capability with decorative quote mark, italic quote, feature label, and author row built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-quote-driven-feature-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="flex flex-col items-center">

        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_headline.Eyebrow
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
                @_headline.Title
            </h2>
            <p class="mt-5 text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>
        </div>

        @* 2x3 quote card grid *@
        <div class="mt-12 grid w-full grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var card in _quoteCards)
            {
                <figure class="group relative flex flex-col rounded-xl border bg-card p-6 transition-all duration-300 hover:-translate-y-1 hover:border-foreground/20 hover:shadow-lg">

                    @* Decorative open quote mark *@
                    <span aria-hidden="true" class="font-serif text-5xl leading-none text-muted-foreground/30">
                        &ldquo;
                    </span>

                    @* Quote body *@
                    <blockquote class="mt-3 flex-1">
                        <p class="text-sm italic leading-relaxed text-foreground/90">@card.Quote</p>
                    </blockquote>

                    @* Divider *@
                    <div class="mt-5 h-px w-full bg-border"></div>

                    @* Feature label *@
                    <p class="mt-4 text-[11px] font-semibold uppercase tracking-[0.12em] text-muted-foreground">
                        @card.FeatureLabel
                    </p>

                    @* Author row *@
                    <figcaption class="mt-3 flex items-center gap-3">
                        <span aria-hidden="true" class="flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-[11px] font-semibold text-foreground">
                            @card.Initials
                        </span>
                        <cite class="flex flex-col not-italic">
                            <span class="text-sm font-medium text-foreground">@card.AuthorName</span>
                            <span class="text-xs text-muted-foreground">@card.AuthorRole, @card.AuthorCompany</span>
                        </cite>
                    </figcaption>
                </figure>
            }
        </div>

        @* Read more stories link *@
        <a href="#stories"
           class="group mt-10 inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">
            Read more customer stories
            <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5 transition-transform duration-200 group-hover:translate-x-0.5" />
        </a>

        @* Dual CTA *@
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <ButtonCn Class="w-full sm:w-[230px]">Start free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">Book a demo</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record QuoteCard(string Id, string Quote, string FeatureLabel, string AuthorName, string AuthorRole, string AuthorCompany, string Initials);

