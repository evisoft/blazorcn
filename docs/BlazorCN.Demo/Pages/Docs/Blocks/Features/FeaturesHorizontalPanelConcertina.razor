@* ============================================================
   Block: features-horizontal-panel-concertina
   Title: FeaturesHorizontalPanelConcertina
   Description: A horizontal panel concertina features section for React and Next.js with six side-by-side vertical panels, click-to-expand horizontal compression, rotated inactive labels, and an inline preview mockup built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-horizontal-panel-concertina.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div>
    @* Headline cluster *@
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <div class="flex items-center gap-2">
          <span class="flex size-6 items-center justify-center rounded-md border bg-background">
            <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-muted-foreground" />
          </span>
          <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
            The platform, end to end
          </span>
        </div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
          Six capabilities, one concertina.
        </h2>
        <p class="mt-3 text-base leading-relaxed text-muted-foreground">
          Click any panel to pull it forward. The others collapse into vertical strips so
          nothing ever leaves the viewport — your features keep each other company.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <ButtonCn Class="w-full sm:w-[200px]">Open the docs</ButtonCn>
      </div>
    </div>

    @* Concertina row *@
    <div class="mt-10 flex h-[420px] w-full gap-2 overflow-hidden rounded-xl border bg-card">
      @foreach (var panel in _panels)
      {
        var pnl = panel;
        var isActive = pnl.Id == _activeId;
        var btnFlexStyle = $"flex-grow:{(isActive ? 6 : 1)};flex-basis:0;transition:flex-grow 0.45s cubic-bezier(0.32,0.72,0,1)";
        var activeOpacity = isActive ? 1 : 0;
        var activeTransition = isActive ? "opacity 0.35s 0.15s ease" : "opacity 0.15s 0s ease";
        var activePointerEvents = isActive ? "auto" : "none";
        var collapsedOpacity = isActive ? 0 : 1;
        var collapsedTransition = isActive ? "opacity 0.15s 0s ease" : "opacity 0.25s 0.1s ease";
        var collapsedPointerEvents = isActive ? "none" : "auto";
        var activeStyleStr = $"opacity:{activeOpacity};transition:{activeTransition};pointer-events:{activePointerEvents}";
        var collapsedStyleStr = $"opacity:{collapsedOpacity};transition:{collapsedTransition};pointer-events:{collapsedPointerEvents}";
        var panelIndex = Array.IndexOf(_panels, pnl).ToString().PadLeft(2, '0');
        <button
          type="button"
          aria-expanded="@(isActive ? "true" : "false")"
          aria-label="@($"Expand {pnl.Label} panel")"
          @onclick="@(() => _activeId = pnl.Id)"
          style="@btnFlexStyle"
          class="@Cn.Merge(
            "relative h-full min-w-0 cursor-pointer overflow-hidden text-left",
            "border-r last:border-r-0",
            isActive ? "bg-background" : "bg-muted/30 hover:bg-muted/60"
          )"
        >
          @* Active state: full content *@
          <div
            class="absolute inset-0"
            style="@activeStyleStr"
          >
            @* Copy column + Preview column *@
            <div class="flex h-full flex-col gap-6 p-6 md:flex-row md:gap-8 md:p-8">
              @* Copy column *@
              <div class="flex flex-1 flex-col">
                <div class="flex items-center gap-2">
                  <span class="flex size-7 items-center justify-center rounded-md border bg-background">
                    <LucideIconCn Name="@pnl.IconName" Size="14" Class="size-3.5 text-foreground" />
                  </span>
                  <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    @pnl.Label
                  </span>
                </div>
                <h3 class="mt-4 text-xl font-semibold leading-tight text-foreground md:text-2xl">
                  @pnl.Headline
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">@pnl.Description</p>
                <ul class="mt-5 space-y-2">
                  @foreach (var bullet in pnl.Bullets)
                  {
                    <li class="flex items-start gap-2 text-sm text-foreground">
                      <span class="mt-[7px] size-1 rounded-full bg-foreground/70" />
                      <span>@bullet</span>
                    </li>
                  }
                </ul>
                <div class="mt-auto flex items-end justify-between gap-4 pt-6">
                  <div>
                    <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                      @pnl.MetricLabel
                    </div>
                    <div class="mt-1 font-mono text-xl font-semibold text-foreground tabular-nums">
                      @pnl.MetricValue
                    </div>
                  </div>
                </div>
              </div>

              @* Preview column *@
              <div class="hidden w-[240px] shrink-0 md:block">
                <div class="flex h-full flex-col overflow-hidden rounded-lg border bg-muted/40">
                  @* Mock chrome bar *@
                  <div class="flex items-center gap-1.5 border-b bg-background/50 px-3 py-2">
                    <span class="size-1.5 rounded-full bg-muted-foreground/30" />
                    <span class="size-1.5 rounded-full bg-muted-foreground/30" />
                    <span class="size-1.5 rounded-full bg-muted-foreground/30" />
                    <span class="ml-2 font-mono text-[9px] text-muted-foreground">
                      @(pnl.Id).pipeline
                    </span>
                  </div>
                  @* Mock content *@
                  <div class="flex flex-1 flex-col gap-2 p-3">
                    <div class="flex items-center justify-between">
                      <span class="font-mono text-[10px] text-muted-foreground">Status</span>
                      <span class="flex items-center gap-1 text-[10px] text-emerald-600 dark:text-emerald-400">
                        <span class="size-1.5 rounded-full bg-emerald-500" />
                        running
                      </span>
                    </div>
                    <div class="space-y-1">
                      @foreach (var bar in _bars)
                      {
                        var b = bar;
                        <div class="flex items-center gap-2">
                          <span class="font-mono text-[9px] text-muted-foreground tabular-nums">
                            @b.Label
                          </span>
                          <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                            <div
                              class="h-full rounded-full bg-foreground/80"
                              style="@($"width:{b.Width}%")"
                            />
                          </div>
                        </div>
                      }
                    </div>
                    <div class="mt-auto grid grid-cols-2 gap-2 border-t pt-2">
                      <div>
                        <div class="font-mono text-[9px] text-muted-foreground">In</div>
                        <div class="font-mono text-xs font-semibold text-foreground tabular-nums">
                          1,284
                        </div>
                      </div>
                      <div>
                        <div class="font-mono text-[9px] text-muted-foreground">Out</div>
                        <div class="font-mono text-xs font-semibold text-foreground tabular-nums">
                          1,281
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          @* Collapsed state: rotated label + icon *@
          <div
            class="absolute inset-0"
            style="@collapsedStyleStr"
          >
            <div class="flex h-full w-full flex-col items-center justify-between py-6">
              @* Top: index *@
              <span class="font-mono text-[10px] text-muted-foreground tabular-nums">
                @panelIndex
              </span>

              @* Middle: rotated label *@
              <div class="flex flex-1 items-center justify-center">
                <span
                  class="text-[11px] font-medium uppercase tracking-[0.2em] text-muted-foreground"
                  style="writing-mode:vertical-rl;transform:rotate(180deg)"
                >
                  @pnl.Label
                </span>
              </div>

              @* Bottom: icon *@
              <span class="flex size-7 items-center justify-center rounded-md border bg-background">
                <LucideIconCn Name="@pnl.IconName" Size="14" Class="size-3.5 text-muted-foreground" />
              </span>
            </div>
          </div>
        </button>
      }
    </div>

    @* Footer strip: index chips *@
    <div class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border bg-muted/30 px-4 py-3">
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
          Active
        </span>
        <span class="font-mono text-xs font-medium text-foreground">
          @(_panels.FirstOrDefault(p => p.Id == _activeId)?.Label)
        </span>
      </div>
      <div class="flex items-center gap-1.5">
        @foreach (var panel in _panels)
        {
          var pnl = panel;
          var isActive = pnl.Id == _activeId;
          <button
            type="button"
            aria-label="@($"Jump to {pnl.Label}")"
            @onclick="@(() => _activeId = pnl.Id)"
            class="@Cn.Merge(
              "h-1 rounded-full transition-all",
              isActive ? "w-8 bg-foreground" : "w-4 bg-muted-foreground/30"
            )"
          />
        }
      </div>
    </div>
  </div>
</section>

@code {
    private string _activeId = "observe";

    private record Panel(
        string Id,
        string IconName,
        string Label,
        string Headline,
        string Description,
        string[] Bullets,
        string MetricLabel,
        string MetricValue
    );

    private record Bar(string Label, int Width);

    private static readonly Bar[] _bars =
    [
        new Bar("01", 72),
        new Bar("02", 48),
        new Bar("03", 86),
        new Bar("04", 34),
        new Bar("05", 60),
    ];

    private static readonly Panel[] _panels =
    [
        new Panel(
