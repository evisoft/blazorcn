@* ============================================================
   Block: features-manifesto-split-quad-grid
   Title: FeaturesManifestoSplitQuadGrid
   Description: A manifesto-style split feature section for React and Next.js with a left-pinned headline and a 2x2 quad grid of icon-wrapper feature items on the right built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-manifesto-split-quad-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="rounded-2xl border bg-card p-8 sm:p-12 lg:p-14">
    <div class="grid gap-10 lg:grid-cols-[5fr_6fr] lg:gap-14">

      @* Left — Manifesto headline *@
      <div>
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
          @_headline.Eyebrow
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
          @_headline.Title
        </h2>
        <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground">
          @_headline.Subtitle
        </p>
        <div class="mt-8">
          <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
        </div>
      </div>

      @* Right — 2×2 icon-wrapper feature grid *@
      <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 sm:gap-8">
        @foreach (var feature in _features)
        {
          <div>
            <div aria-hidden="true" class="flex size-10 items-center justify-center rounded-lg bg-muted">
              <LucideIconCn Name="@feature.IconName" Size="20" Class="size-5 text-foreground" />
            </div>
            <h3 class="mt-4 text-base font-semibold text-foreground">@feature.Title</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              @feature.Description
            </p>
          </div>
        }
      </div>

    </div>
  </div>
</section>

@code {
  private record HeadlineData(string Eyebrow, string Title, string Subtitle);

  private record FeatureItem(string Id, string IconName, string Title, string Description);

  private static readonly HeadlineData _headline = new(
    "Our manifesto",
    "Software should feel invisible until you need it",
    "We believe products win when the interface disappears and the work takes center stage. Four principles guide everything we ship, and none of them are negotiable."
  );

  private static readonly FeatureItem[] _features =
  [
    new("speed", "bolt", "Speed as a feature",
      "Every interaction is benchmarked against a 50ms budget. If a screen takes longer to respond, we treat it as a bug and fix it before we ship anything else."),
    new("trust", "shield-check", "Trust by default",
      "SOC 2 Type II, SAML SSO, and audit logging are enabled on every plan. Security is not a pricing tier — it is the baseline your team deserves from day one."),
    new("craft", "sparkles", "Craft in the details",
      "Pixel alignment, keyboard affordances, and motion curves get the same engineering review as the APIs. If it feels rough, it is not ready to be in front of a customer."),
    new("clarity", "gauge", "Clarity over cleverness",
      "We name things the way customers describe them, we write error messages a human can act on, and we retire features that nobody uses instead of hiding them in menus."),
  ];
}
