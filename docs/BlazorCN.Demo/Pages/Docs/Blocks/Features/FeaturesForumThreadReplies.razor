@* ============================================================
   Block: features-forum-thread-replies
   Title: FeaturesForumThreadReplies
   Description: A forum thread replies features section for React and Next.js presenting capabilities as an OP post with upvoted indented replies in a Hacker News style discussion built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-forum-thread-replies.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-muted-foreground">
                <LucideIconCn Name="users" Size="12" Class="size-3" />
                Discussed by the team
            </span>
            <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Launch notes, peer reviewed.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The engineers behind each change explain what they shipped, what trade-offs they made,
                and what they are watching next — in their own words.
            </p>
        </div>

        @* Forum thread mockup *@
        <article class="mt-8 overflow-hidden rounded-xl border bg-card shadow-sm">
            @* OP Post *@
            <div class="flex gap-4 px-5 py-4">
                <div class="flex shrink-0 flex-col items-center gap-1">
                    @* UpvoteBadge for OP *@
                    <button
                        type="button"
                        aria-label="@($"Upvote original post, {_opPost.Upvotes} points")"
                        class="inline-flex items-center gap-1 rounded-md border bg-background px-2 py-1 font-mono font-medium text-muted-foreground hover:border-foreground/30 hover:text-foreground text-xs">
                        <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                        <span class="tabular-nums">@_opPost.Upvotes.ToString("N0")</span>
                    </button>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground">
                        <span class="flex size-5 items-center justify-center rounded-full bg-muted font-mono text-[10px] font-semibold text-foreground">
                            @_opPost.Initials
                        </span>
                        <span class="font-medium text-foreground">@_opPost.Author</span>
                        <span aria-hidden="true">•</span>
                        <span>@_opPost.TimeAgo</span>
                    </div>
                    <h3 class="mt-1.5 text-balance font-semibold leading-snug text-foreground">
                        @_opPost.Title
                    </h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">@_opPost.Body</p>
                    <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
                        <button
                            type="button"
                            class="inline-flex items-center gap-1 rounded-md px-2 py-1 hover:bg-muted/50">
                            <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                            <span>@(_replies.Length) replies</span>
                        </button>
                        <button
                            type="button"
                            class="inline-flex items-center gap-1 rounded-md px-2 py-1 hover:bg-muted/50">
                            <LucideIconCn Name="share" Size="12" Class="size-3" />
                            <span>Share</span>
                        </button>
                    </div>
                </div>
            </div>

            @* Replies *@
            <ol class="border-t bg-muted/20 px-5 py-3">
                @foreach (var reply in _replies)
                {
                    <li class="border-l-2 border-border pl-4 pt-3 first:pt-1">
                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground">
                            <span class="@Cn.Merge("flex size-5 items-center justify-center rounded-full font-mono text-[10px] font-semibold", reply.Accent)">
                                @reply.Initials
                            </span>
                            <span class="font-medium text-foreground">@reply.Author</span>
                            <span aria-hidden="true">•</span>
                            <span>@reply.TimeAgo</span>
                            <span aria-hidden="true">•</span>
                            @* UpvoteBadge (sm) for reply *@
                            <button
                                type="button"
                                aria-label="@($"Upvote reply from {reply.Author}, {reply.Upvotes} points")"
                                class="inline-flex items-center gap-1 rounded-md border bg-background px-1.5 py-0.5 font-mono font-medium text-muted-foreground hover:border-foreground/30 hover:text-foreground text-[11px]">
                                <LucideIconCn Name="arrow-up" Size="10" Class="size-2.5" />
                                <span class="tabular-nums">@reply.Upvotes.ToString("N0")</span>
                            </button>
                        </div>
                        <p class="mt-1.5 text-sm leading-relaxed text-foreground">@reply.Body</p>
                        <button
                            type="button"
                            class="mt-1.5 inline-flex items-center gap-1 text-[11px] font-medium text-muted-foreground hover:text-foreground">
                            <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                            reply
                        </button>
                    </li>
                }
            </ol>
        </article>

        @* CTAs *@
        <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[250px]">Read the full post</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[260px]">Join the discussion</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record OpPost(string Title, string Author, string Initials, string TimeAgo, int Upvotes, string Body);
    private record ForumReply(string Id, string Author, string Initials, string Accent, string TimeAgo, int Upvotes, string Body);

    private static readonly OpPost _opPost = new(
        Title: "We rebuilt the deploy pipeline from scratch. Here's what changed.",
        Author: "eng-maria",
        Initials: "EM",
        TimeAgo: "4 hours ago",
        Upvotes: 1284,
        Body: "After two years of patching the old queue-based runner, we tore it out. The new pipeline is built around immutable build artifacts, parallel region rollouts, and a typed event stream you can subscribe to. Median deploy time dropped from 3m40s to 47s. Happy to answer specifics below."
    );

    private static readonly ForumReply[] _replies =
    [
        new("r1", "platform-jonas", "PJ", "bg-blue-500/15 text-blue-600 dark:text-blue-400",    "3 hours ago", 412, "The parallel region rollout is the unsung hero. We run across seven regions and the old pipeline did them sequentially. Now we get the whole fleet in under 90 seconds with automatic health-gated promotion."),
        new("r2", "srechris",       "SC", "bg-emerald-500/15 text-emerald-600 dark:text-emerald-400", "3 hours ago", 276, "Immutable artifacts are a game changer for rollback. Every deploy ID maps to a signed tarball we can re-promote instantly. No more 'rebuild from main and hope the dependencies haven't drifted' at 2am."),
        new("r3", "dx-priya",       "DP", "bg-amber-500/15 text-amber-600 dark:text-amber-400",  "2 hours ago", 189, "The typed event stream deserves more attention. We plug it straight into our ChatOps bot so every 'build started / gate passed / canary healthy / fully promoted' event is first-class data. No more regex-scraping log lines to figure out where a deploy is."),
    ];
}
