@* ============================================================
   Block: features-progress-roadmap
   Title: Features Progress Roadmap
   Description: Features with completion progress bars showing rollout percentage. Built with Next.js, React, shadcn/ui, and Tailwind CSS.
   Long Description: Notification-style feature updates
   Dependencies: None
   Source: original/blocks/features/features-progress-roadmap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Feature Roadmap</span>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Track development progress for upcoming features
            </p>
        </div>

        <div class="divide-y">
            @foreach (var feature in _features)
            {
                <div class="px-4 py-3">
                    <div class="mb-2 flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@feature.Title</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@feature.Description</p>
                        </div>
                        <span class="@(Cn.Merge("shrink-0 text-xs", GetStatusColor(feature.Status)))">
                            @GetStatusLabel(feature.Status)
                        </span>
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div
                                class="@(Cn.Merge("h-full rounded-full transition-all", GetStatusBgColor(feature.Status)))"
                                style="@($"width: {feature.Progress}%")">
                            </div>
                        </div>
                        <span class="shrink-0 tabular-nums text-muted-foreground text-xs">
                            @(feature.Progress)%
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
            <div class="flex items-center gap-4 text-xs">
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-muted-foreground">Completed</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    <span class="text-muted-foreground">In Progress</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-purple-500"></span>
                    <span class="text-muted-foreground">Beta</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record FeatureProgress(string Title, string Description, string Status, int Progress);

    private static string GetStatusColor(string status) => status switch
    {
        "completed" => "text-emerald-600 dark:text-emerald-400",
        "in-progress" => "text-blue-600 dark:text-blue-400",
        "beta" => "text-purple-600 dark:text-purple-400",
        "planned" => "text-muted-foreground",
        _ => "text-muted-foreground",
    };

    private static string GetStatusBgColor(string status) => status switch
    {
        "completed" => "bg-emerald-500",
        "in-progress" => "bg-blue-500",
        "beta" => "bg-purple-500",
        "planned" => "bg-muted-foreground/40",
        _ => "bg-muted-foreground/40",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "completed" => "Completed",
        "in-progress" => "In Progress",
        "beta" => "Beta",
        "planned" => "Planned",
        _ => status,
    };

    private static readonly FeatureProgress[] _features =
    [
        new("Multi-language support", "Interface and content localization for 25+ languages", "completed", 100),
        new("Advanced search filters", "Boolean operators, date ranges, and custom field filtering", "completed", 100),
        new("Team collaboration workspace", "Shared projects, comments, and real-time activity feeds", "in-progress", 73),
        new("API v3 with GraphQL", "Modern GraphQL API with schema introspection and subscriptions", "beta", 92),
        new("Mobile offline mode", "Work without internet with automatic sync when connected", "in-progress", 58),
        new("AI-powered insights", "Automated recommendations and predictive analytics", "in-progress", 41),
        new("Custom workflow builder", "Visual workflow designer with conditional logic and triggers", "planned", 15),
        new("White-label customization", "Full branding control with custom domains and themes", "planned", 8),
    ];
}
