@* ============================================================
   Block: features-trading-card-collection-row
   Title: FeaturesTradingCardCollectionRow
   Description: A trading card collection row features section for React and Next.js with Magic the Gathering style cards, rarity stars, and power toughness stats built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-trading-card-collection-row.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Headline cluster *@
    <div class="text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Starter deck · Edition I
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Collect the platform you already ship with.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
        Every capability is a card. Every card is a commitment. Assemble the deck that fits how
        your team actually builds — no booster packs required.
      </p>
    </div>

    @* Trading cards row *@
    <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      @foreach (var card in _tradingCards)
      {
        var c = card;
        <article class="group relative flex aspect-[5/7] flex-col rounded-lg border-2 border-foreground/80 bg-card p-2 shadow-sm">
          @* Foil corner badge *@
          <span aria-hidden="true"
                class="absolute right-2 top-2 z-10 flex items-center gap-0.5 rounded-sm border border-amber-500/60 bg-amber-500/10 px-1.5 py-0.5 text-[8px] font-semibold uppercase tracking-wider text-amber-600">
            <LucideIconCn Name="gem" Size="8" Class="size-2" />
            @c.Foil
          </span>

          @* Header bar: name + rarity *@
          <div class="flex items-start justify-between gap-2 rounded-sm border border-foreground/20 bg-muted/40 px-2 py-1.5 pr-16">
            <h3 class="font-serif text-[13px] font-semibold leading-tight text-foreground">
              @c.Name
            </h3>
          </div>
          <div class="mt-1 flex justify-end px-1">
            @* Rarity stars *@
            <div role="img" class="flex items-center gap-0.5" aria-label="@($"Rarity {c.RarityLabel}")">
              @for (int i = 0; i < 5; i++)
              {
                var idx = i;
                <LucideIconCn Name="star" Size="10" Class="@(Cn.Merge("size-2.5", idx < c.Rarity ? "fill-amber-500 text-amber-500" : "fill-transparent text-muted-foreground/30"))" />
              }
            </div>
          </div>

          @* Illustration frame *@
          <div class="mt-2 flex aspect-[4/3] items-center justify-center rounded-sm border border-foreground/30 bg-muted/60">
            <LucideIconCn Name="@c.IconName" Size="32" Class="size-8 text-foreground/70" />
          </div>

          @* Type line *@
          <div class="mt-2 rounded-sm border border-foreground/20 bg-muted/40 px-2 py-1 font-serif text-[10px] italic text-muted-foreground">
            @c.TypeLine
          </div>

          @* Ability text *@
          <p class="mt-2 flex-1 px-1 text-[10px] leading-relaxed text-muted-foreground">
            @c.Ability
          </p>

          @* Footer: power / toughness stats *@
          <div class="mt-1 flex items-center justify-between border-t border-foreground/20 px-1 pt-1.5">
            <span class="text-[9px] font-medium uppercase tracking-wider text-muted-foreground">
              Stat
            </span>
            <span class="font-serif text-sm font-semibold tabular-nums text-foreground">
              @c.Power / @c.Toughness
            </span>
          </div>
        </article>
      }
    </div>

    @* CTA pair *@
    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <ButtonCn Class="w-full sm:w-[210px]">View full deck</ButtonCn>
      <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Build your own</ButtonCn>
    </div>
  </div>
</section>

@code {
    private record TradingCard(
        string Id,
        string IconName,
        string Name,
        string TypeLine,
        int Rarity,
        string RarityLabel,
        string Ability,
        string Power,
        string Toughness,
        string Foil);

    private static readonly TradingCard[] _tradingCards =
    [
        new("edge-runtime",   "cloud-lightning", "Edge Runtime",     "Infrastructure — Rare",    4, "Rare",     "Deploys your code to 320 edge regions instantly. When this enters play, cold starts become zero.",                           "99.9%", "48ms", "FOIL"),
        new("neural-search",  "brain-circuit",   "Neural Search",    "Creature — AI",            5, "Mythic",   "Vector search across 10M documents at hybrid-rank precision. Draw one relevance card each query.",                           "1.2M",  "12ms", "MYTHIC"),
        new("zero-trust",     "shield-check",    "Zero-Trust Gate",  "Enchantment — Policy",     3, "Uncommon", "Every request is signed, scoped, and replay-protected. Prevents all unauthorized access until end of turn.",                 "SOC 2", "ISO",  "HOLO"),
        new("forge-pipeline", "sword",           "Forge Pipeline",   "Artifact — Tool",          4, "Rare",     "Tap to commit, test, and ship to production. When Forge attacks, deployment rollbacks are blocked.",                         "3.1k",  "/min", "FOIL"),
    ];
}
