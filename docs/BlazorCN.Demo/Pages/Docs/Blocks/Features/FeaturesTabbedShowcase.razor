@* ============================================================
   Block: features-tabbed-showcase
   Title: Features Tabbed Showcase
   Description: Interactive tabbed feature section with benefit bullets and contextual descriptions
   Dependencies: TabsCn
   Source: original/blocks/features/features-tabbed-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Platform</p>
            <p class="mt-0.5 text-xs text-muted-foreground">One tool for the entire product design workflow</p>
        </div>

        <TabsCn DefaultValue="editor">
            <div class="border-b px-4 py-2">
                <TabsListCn>
                    @foreach (var tab in _tabs)
                    {
                        <TabsTriggerCn Value="@tab.Id" Class="text-xs">@tab.Label</TabsTriggerCn>
                    }
                </TabsListCn>
            </div>

            @foreach (var tab in _tabs)
            {
                <TabsContentCn Value="@tab.Id" Class="mt-0">
                    <div class="grid gap-4 p-4 md:grid-cols-2 md:gap-6">
                        <div>
                            <p class="text-sm font-medium">@tab.Title</p>
                            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">@tab.Description</p>
                            <ul class="mt-3 space-y-1.5">
                                @foreach (var benefit in tab.Benefits)
                                {
                                    <li class="flex items-center gap-2 text-xs">
                                        <span class="size-1 shrink-0 rounded-full bg-emerald-500"></span>
                                        @benefit
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="flex aspect-[4/3] items-center justify-center rounded-md border bg-muted/50">
                            <span class="text-xs text-muted-foreground/50">Screenshot</span>
                        </div>
                    </div>
                </TabsContentCn>
            }
        </TabsCn>
    </div>
</section>

@code {
    private record TabData(string Id, string Label, string Title, string Description, string[] Benefits);

    private static readonly TabData[] _tabs =
    [
        new("editor", "Design Editor", "A design editor that thinks like you do",
            "Pixel-perfect layouts with auto-layout, responsive breakpoints, and reusable design tokens. Go from wireframe to production-ready design without switching tools.",
            ["Auto-layout with smart spacing and alignment", "Responsive preview across device breakpoints", "Design token system with global style updates"]),
        new("devmode", "Dev Handoff", "Developer handoff without the back-and-forth",
            "Developers inspect designs, copy CSS, and export assets directly\u2014no separate handoff tool or spec document needed.",
            ["One-click CSS, React, and Tailwind export", "Asset export in SVG, PNG, and WebP formats", "Redline annotations with spacing measurements"]),
        new("collab", "Collaboration", "Real-time collaboration that scales",
            "Multiple designers and stakeholders work simultaneously with live cursors, inline comments, and version history.",
            ["Multiplayer editing with live cursors", "Threaded comments pinned to design elements", "Unlimited version history with named snapshots"]),
    ];
}
