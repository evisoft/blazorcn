@* ============================================================
   Block: features-lab-report-specimen-cards
   Title: FeaturesLabReportSpecimenCards
   Description: A lab report specimen card features section for React and Next.js with specimen code headers, crosshair illustrations, classification fields, and signature footers built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-lab-report-specimen-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <p class="font-mono text-xs font-medium uppercase tracking-[0.25em] text-muted-foreground">
                Lab report · Vol. IV
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Four specimens. One rigorous bench.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every capability ships with a signed analysis, a property profile, and a reviewer on the
                slip. No marketing varnish, no hand-waving — just the bench notes.
            </p>
        </div>

        @* Specimen grid *@
        <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2">
            @foreach (var specimen in _specimens)
            {
                <article id="@($"specimen-{specimen.Id}")"
                         class="group relative flex flex-col border-2 border-foreground/70 bg-card">
                    @* Dashed inner border *@
                    <div aria-hidden="true"
                         class="pointer-events-none absolute inset-1 border border-dashed border-foreground/15"></div>

                    @* Header bar *@
                    <header class="relative z-10 flex items-center justify-between gap-3 border-b border-foreground/70 bg-muted/40 px-4 py-2">
                        <div class="flex items-center gap-2">
                            <span aria-hidden="true" class="size-1.5 rounded-full bg-foreground"></span>
                            <dl class="flex items-center gap-1.5 font-mono text-[10px] font-medium uppercase tracking-wider text-foreground">
                                <dt class="sr-only">Specimen code</dt>
                                <dd>@specimen.Code</dd>
                            </dl>
                        </div>
                        <span class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
                            @specimen.CollectedOn
                        </span>
                    </header>

                    @* Illustration plate *@
                    <div class="relative z-10">
                        <div aria-hidden="true"
                             class="relative aspect-[16/7] w-full overflow-hidden border-y border-dashed border-foreground/20 bg-muted/30"
                             style="background-image:repeating-linear-gradient(45deg, transparent 0 8px, var(--color-muted-foreground, currentColor) 8px 8.5px);background-size:16px 16px;color:transparent;">
                            @* Crosshair rules *@
                            <div class="absolute inset-0">
                                <div class="absolute inset-x-4 top-1/2 h-px -translate-y-1/2 bg-foreground/20"></div>
                                <div class="absolute inset-y-4 left-1/2 w-px -translate-x-1/2 bg-foreground/20"></div>
                            </div>
                            @* Corner brackets *@
                            <div class="pointer-events-none absolute left-2 top-2 size-3 border-l border-t border-foreground/40"></div>
                            <div class="pointer-events-none absolute right-2 top-2 size-3 border-r border-t border-foreground/40"></div>
                            <div class="pointer-events-none absolute bottom-2 left-2 size-3 border-b border-l border-foreground/40"></div>
                            <div class="pointer-events-none absolute bottom-2 right-2 size-3 border-b border-r border-foreground/40"></div>
                            @* Centred icon *@
                            <div class="absolute inset-0 flex items-center justify-center">
                                <span class="flex size-10 items-center justify-center rounded-full border border-foreground/30 bg-background">
                                    <LucideIconCn Name="@specimen.IconName" Size="16" Class="size-4 text-foreground" />
                                </span>
                            </div>
                        </div>
                    </div>

                    @* Body *@
                    <div class="relative z-10 flex flex-1 flex-col gap-4 px-5 py-5">
                        <div>
                            <p class="font-mono text-[9px] font-medium uppercase tracking-[0.2em] text-muted-foreground">
                                Classification
                            </p>
                            <h3 class="mt-1 font-serif text-xl font-semibold leading-tight tracking-tight text-foreground">
                                @specimen.Classification
                            </h3>
                        </div>

                        <div>
                            <p class="font-mono text-[9px] font-medium uppercase tracking-[0.2em] text-muted-foreground">
                                Analysis
                            </p>
                            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                                @specimen.Analysis
                            </p>
                        </div>

                        <div>
                            <p class="font-mono text-[9px] font-medium uppercase tracking-[0.2em] text-muted-foreground">
                                Properties
                            </p>
                            <ul class="mt-2 flex flex-wrap gap-1.5">
                                @foreach (var tag in specimen.Properties)
                                {
                                    <li class="border border-foreground/40 px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-foreground">
                                        @tag
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    @* Signature footer *@
                    <footer class="relative z-10 flex items-end justify-between gap-3 border-t border-dashed border-foreground/30 px-5 py-3">
                        <div>
                            <p class="font-mono text-[9px] uppercase tracking-wider text-muted-foreground">
                                Reviewed by
                            </p>
                            <p class="mt-0.5 font-serif text-sm italic text-foreground">
                                @specimen.Approver
                            </p>
                        </div>
                        <div class="text-right">
                            <p class="font-mono text-[9px] uppercase tracking-wider text-muted-foreground">
                                Role
                            </p>
                            <p class="mt-0.5 text-[11px] font-medium text-foreground">
                                @specimen.ApproverRole
                            </p>
                        </div>
                    </footer>
                </article>
            }
        </div>

        @* CTA pair *@
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <ButtonCn Class="w-full sm:w-[260px]">Download the report</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[240px]">Inspect the bench</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Specimen(
        string Id,
        string Code,
        string CollectedOn,
        string Classification,
        string Analysis,
        string[] Properties,
        string Approver,
        string ApproverRole,
        string IconName);

    private static readonly Specimen[] _specimens =
    [
        new("dispatch", "SPM-01A", "2026.04.02", "Dispatch Core",
            "Sub-millisecond request routing with regional failover. Observed latency holds under 8ms at the 99th percentile across twelve weeks of continuous load.",
            ["latency", "failover", "autopilot", "edge"],
            "E. Marchetti", "Lead Analyst", "beaker"),
        new("lattice", "SPM-02B", "2026.04.03", "Lattice Cache",
            "Content-addressable memoisation layer with deterministic invalidation. Reduces database load by 64% on the reference workload without manual cache keys.",
            ["memoise", "invalidate", "p95", "read-heavy"],
            "J. Okafor", "Staff Engineer", "flask-conical"),
        new("aegis", "SPM-03C", "2026.04.04", "Aegis Audit Trail",
            "Tamper-evident event log signed with Ed25519, replicated across three regions. Every mutation is traceable to the originating service and actor.",
            ["signed", "replicated", "SOC 2", "immutable"],
            "R. Villanueva", "Security Lead", "microscope"),
        new("solvent", "SPM-04D", "2026.04.05", "Solvent Orchestrator",
            "Job scheduler with per-tenant fairness guarantees. Mixes interactive and batch workloads on the same pool without starving low-priority traffic.",
            ["scheduler", "fair-share", "bursty", "multi-tenant"],
            "S. Dalakos", "Platform Arch.", "droplet"),
    ];
}
