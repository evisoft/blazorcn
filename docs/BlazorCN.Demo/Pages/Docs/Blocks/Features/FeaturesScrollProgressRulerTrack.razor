@* ============================================================
   Block: features-scroll-progress-ruler-track
   Title: FeaturesScrollProgressRulerTrack
   Description: A scroll progress ruler track features section for React and Next.js with a sticky horizontal ruler, numbered tick marks, a sliding thumb indicator, and six IntersectionObserver-linked feature cards built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-scroll-progress-ruler-track.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline *@
        <div class="max-w-xl">
            <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                A measured tour
            </span>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                Measure progress as you scroll.
            </h2>
            <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                A sticky ruler keeps its eye on the page. Six capabilities below, and the thumb slides
                to whichever one you are reading. Click any tick to jump.
            </p>
        </div>

        @* Sticky ruler *@
        <div class="sticky top-4 z-10 mt-10">
            <div class="relative rounded-2xl border bg-background/95 px-6 py-5 shadow-sm backdrop-blur">

                @* Top meta row *@
                <div class="mb-3 flex items-center justify-between">
                    <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        Progress
                    </span>
                    <span class="font-mono text-[10px] text-muted-foreground tabular-nums">
                        @((_activeIndex + 1).ToString("D2")) of @(_total.ToString("D2"))
                    </span>
                </div>

                @* Track *@
                <div class="relative h-8">
                    @* Base line *@
                    <div
                        role="progressbar"
                        aria-valuemin="0"
                        aria-valuemax="@(_total - 1)"
                        aria-valuenow="@_activeIndex"
                        aria-label="Scroll progress"
                        class="absolute top-1/2 left-0 h-px w-full -translate-y-1/2 bg-border"></div>

                    @* Ticks *@
                    <div class="absolute inset-x-0 top-0 flex justify-between">
                        @foreach (var cap in _capabilities)
                        {
                            var idx = Array.IndexOf(_capabilities, cap);
                            var isActive = idx <= _activeIndex;
                            var isCurrentActive = idx == _activeIndex;
                            var capItem = cap;
                            <button
                                type="button"
                                aria-label="@($"Jump to {capItem.Title}")"
                                @onclick="@(() => SetActive(idx))"
                                class="group relative flex flex-col items-center">
                                <span class="@(Cn.Merge("mt-1 h-6 w-px transition-colors", isActive ? "bg-foreground" : "bg-border"))"></span>
                                <span class="@(Cn.Merge("mt-1 hidden font-mono text-[10px] tabular-nums transition-colors sm:block", isCurrentActive ? "font-semibold text-foreground" : "text-muted-foreground group-hover:text-foreground"))">
                                    @capItem.Number
                                </span>
                            </button>
                        }
                    </div>

                    @* Thumb *@
                    <div
                        class="pointer-events-none absolute top-1/2"
                        style="@($"left:{_thumbPercent}%;transform:translate(-50%,-50%)")">
                        <div class="flex items-center gap-2 rounded-full border bg-foreground px-3 py-1 text-background shadow-md">
                            <span class="size-1.5 rounded-full bg-background"></span>
                            <span class="font-mono text-[10px] font-semibold tabular-nums">
                                @_capabilities[_activeIndex].Number
                            </span>
                        </div>
                    </div>
                </div>

                @* Active label *@
                <div class="mt-4 flex items-baseline justify-between border-t pt-3">
                    <div class="min-w-0 flex-1 truncate text-sm font-medium text-foreground">
                        @_capabilities[_activeIndex].Title
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="w-full sm:w-[240px]" OnClick="@(() => SetActive(0))">
                        Reset
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Feature cards *@
        <div class="mt-8 flex flex-col gap-4">
            @foreach (var cap in _capabilities)
            {
                var capItem = cap;
                <div
                    id="@($"capability-{capItem.Id}")"
                    class="overflow-hidden rounded-2xl border bg-card">
                    <div class="grid grid-cols-1 gap-6 p-6 md:grid-cols-[auto_1fr] md:gap-8 md:p-8">
                        <div class="flex md:flex-col">
                            <div class="flex size-16 shrink-0 items-center justify-center rounded-xl border bg-muted/40">
                                <LucideIconCn Name="@capItem.Icon" Size="24" Class="size-6 text-foreground" aria-hidden="true" />
                            </div>
                            <div class="ml-4 flex flex-col justify-center md:ml-0 md:mt-4">
                                <span class="font-mono text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                                    Step
                                </span>
                                <span class="font-mono text-2xl font-semibold text-foreground tabular-nums">
                                    @capItem.Number
                                </span>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-xl font-semibold leading-tight text-foreground md:text-2xl">
                                @capItem.Title
                            </h3>
                            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                                @capItem.Description
                            </p>
                            <ul class="mt-5 flex flex-wrap gap-2">
                                @foreach (var h in capItem.Highlights)
                                {
                                    <li class="inline-flex items-center gap-1.5 rounded-full border bg-background px-2.5 py-1 text-[11px] font-medium text-foreground">
                                        <span class="size-1 rounded-full bg-foreground/60"></span>
                                        @h
                                    </li>
                                }
                            </ul>
                            <div class="mt-6 flex items-end justify-between border-t pt-4">
                                <div>
                                    <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                        @capItem.MetricLabel
                                    </div>
                                    <div class="mt-0.5 font-mono text-lg font-semibold text-foreground tabular-nums">
                                        @capItem.MetricValue
                                    </div>
                                </div>
                                <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                                    @capItem.Id
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Capability(string Id, string Number, string Title, string Description, string Icon, string MetricLabel, string MetricValue, string[] Highlights);

    private static readonly Capability[] _capabilities =
    [
        new("capture", "01", "Capture intent from every surface",
            "Drop a two-line script on any page and start collecting identified sessions, form submissions, and scroll depth. The SDK deduplicates events across devices so a single human reads as one person.",
            "funnel", "Sources connected", "38",
            ["Cross-device dedup", "Server-side ingest", "First-party storage"]),
        new("segment", "02", "Segment audiences with readable rules",
            "Build segments in plain English. 'Visited pricing in the last 14 days and did not sign up' becomes a typed predicate that compiles to SQL — readable by a marketer, performant for the engine.",
            "target", "Active segments", "142",
            ["Plain-English builder", "Live member count", "Predicate preview"]),
        new("orchestrate", "03", "Orchestrate campaigns across channels",
            "Drag triggers, waits, branches, and sends onto a canvas. Every node previews the audience size flowing through it so you catch dead paths before they ship to production.",
            "calendar-clock", "Avg flow depth", "7 steps",
            ["Visual canvas", "Live cohort preview", "Branching conditions"]),
        new("deliver", "04", "Deliver email that actually lands in the inbox",
            "Warm-up rotation, per-domain throttles, and deliverability scoring on every send. The engine learns which subject patterns trigger spam filters and suggests rewrites before you press send.",
            "mail", "Inbox rate", "98.4%",
            ["Per-domain throttles", "Spam-filter scoring", "AI subject rewrites"]),
        new("personalize", "05", "Personalize content at request time",
            "Every email and landing page resolves tokens from the profile graph at the moment of request. A returning visitor never sees a stale price, a stale product name, or a stale teammate avatar.",
            "bolt", "Token resolve", "12 ms",
            ["Realtime profile graph", "Fallback chains", "Preview-as-any-user"]),
        new("measure", "06", "Measure outcomes, not opens",
            "Tie every send to downstream conversion events. The attribution engine supports first-touch, last-touch, and linear — and lets you audit every credit back to the signal that produced it.",
            "inbox", "Attribution audit", "100%",
            ["Multi-touch models", "Audit trail", "Revenue reporting"]),
    ];

    private int _total => _capabilities.Length;
    private int _activeIndex = 0;
    private double _thumbPercent => _total > 1 ? (_activeIndex / (double)(_total - 1)) * 100.0 : 0.0;

    private void SetActive(int index)
    {
        _activeIndex = index;
    }
}
