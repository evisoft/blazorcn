@* ============================================================
   Block: features-api-endpoints
   Title: Features Api Endpoints
   Description: Features presented as API endpoint references with HTTP methods, perfect for API documentation and developer-focused Next.js sites.
   Long Description: Features Block Alternating Rows
   Dependencies: None
   Source: original/blocks/features/features-api-endpoints.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">API Reference</h2>
            <p class="mt-1 text-xs text-muted-foreground">Available endpoints and resources</p>
        </div>

        @{ var groupIndex = 0; }
        @foreach (var group in _groupedEndpoints)
        {
            <div class="@(Cn.Merge(groupIndex < _groupedEndpoints.Length - 1 ? "border-b" : ""))">
                <div class="px-4 py-3">
                    <h3 class="text-xs font-medium text-muted-foreground">@group.Resource</h3>
                </div>
                @{ var endpointIndex = 0; }
                @foreach (var endpoint in group.Endpoints)
                {
                    <div class="@(Cn.Merge(
                        "flex items-start gap-3 px-4 py-3",
                        endpointIndex < group.Endpoints.Length - 1 ? "border-b border-border/50" : ""
                    ))">
                        <span class="@(Cn.Merge(
                            "shrink-0 rounded px-2 py-1 font-mono text-xs",
                            GetMethodColor(endpoint.Method)
                        ))">
                            @endpoint.Method
                        </span>
                        <div class="min-w-0 flex-1">
                            <code class="text-sm font-mono text-foreground">@endpoint.Path</code>
                            <p class="mt-1 text-sm text-muted-foreground">@endpoint.Description</p>
                        </div>
                    </div>
                    endpointIndex++;
                }
            </div>
            groupIndex++;
        }
    </div>
</section>

@code {
    private record EndpointData(string Method, string Path, string Description, string Resource);
    private record EndpointGroup(string Resource, EndpointData[] Endpoints);

    private static string GetMethodColor(string method) => method switch
    {
        "GET" => "bg-emerald-500/10 text-emerald-500",
        "POST" => "bg-blue-500/10 text-blue-500",
        "PUT" => "bg-amber-500/10 text-amber-500",
        "DELETE" => "bg-red-500/10 text-red-500",
        _ => "bg-muted text-muted-foreground",
    };

    private static readonly EndpointData[] _endpoints =
    [
        new("GET", "/api/projects", "List all projects with pagination and filtering support.", "Projects"),
        new("POST", "/api/projects", "Create a new project with custom configuration and team assignments.", "Projects"),
        new("DELETE", "/api/projects/:id", "Permanently delete a project and all associated resources.", "Projects"),
        new("GET", "/api/deployments", "Retrieve deployment history with build logs and status information.", "Deployments"),
        new("POST", "/api/deployments", "Trigger a new deployment from a git branch or commit SHA.", "Deployments"),
        new("PUT", "/api/deployments/:id/rollback", "Rollback to a previous deployment version with zero downtime.", "Deployments"),
        new("GET", "/api/analytics/events", "Query analytics events with time-range filtering and aggregation.", "Analytics"),
        new("POST", "/api/analytics/events", "Send custom analytics events with arbitrary properties and metadata.", "Analytics"),
        new("GET", "/api/team/members", "List team members with role information and access permissions.", "Team"),
        new("POST", "/api/team/invites", "Invite new team members via email with role assignment.", "Team"),
    ];

    private static readonly EndpointGroup[] _groupedEndpoints = _endpoints
        .GroupBy(e => e.Resource)
        .Select(g => new EndpointGroup(g.Key, g.ToArray()))
        .ToArray();
}
