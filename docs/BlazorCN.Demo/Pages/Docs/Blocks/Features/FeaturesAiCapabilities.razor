@* ============================================================
   Block: features-ai-capabilities
   Title: Features AI Capabilities
   Description: AI and machine learning feature showcase with model info and performance metrics
   Dependencies: None
   Source: original/blocks/features/features-ai-capabilities.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <span class="text-sm font-medium">AI Capabilities</span>
            <p class="mt-0.5 text-xs text-muted-foreground">Machine learning models powering intelligent features</p>
        </div>

        <div class="divide-y">
            @foreach (var capability in _capabilities)
            {
                <div class="px-4 py-3">
                    <div class="mb-2 flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@capability.Name</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">@capability.Description</p>
                        </div>
                        <div class="shrink-0 text-right">
                            <div class="text-2xl font-semibold tabular-nums">@(capability.Accuracy.ToString("F1"))%</div>
                            <div class="mt-0.5 text-xs text-muted-foreground">@capability.Metric</div>
                        </div>
                    </div>
                    <div class="mt-2 flex items-center gap-2">
                        <span class="size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                        <span class="font-mono text-xs text-muted-foreground">@capability.Model</span>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">@_capabilities.Length AI models deployed in production</span>
                <button type="button" class="transition-colors hover:text-foreground">View API documentation</button>
            </div>
        </div>
    </div>
</section>

@code {
    private record AICapability(string Name, string Description, string Model, double Accuracy, string Metric);

    private static readonly AICapability[] _capabilities =
    [
        new("Natural language understanding", "Parse user intent and extract entities from conversational text", "transformer-xl-v3", 94.2, "F1 Score"),
        new("Sentiment analysis", "Detect emotional tone and sentiment in text across 12 languages", "bert-multilingual", 91.8, "Accuracy"),
        new("Image classification", "Identify objects, scenes, and concepts in images with high precision", "resnet-152", 96.4, "Top-5 Accuracy"),
        new("Text summarization", "Generate concise summaries from long-form documents and articles", "pegasus-large", 88.6, "ROUGE-L"),
        new("Anomaly detection", "Identify unusual patterns and outliers in time-series data", "lstm-autoencoder", 92.1, "AUC-ROC"),
        new("Speech recognition", "Transcribe audio to text with speaker diarization support", "wav2vec-2.0", 95.7, "WER"),
        new("Question answering", "Extract precise answers from document context using reading comprehension", "roberta-squad", 89.3, "EM Score"),
    ];
}
