@* ============================================================
   Block: features-month-contribution-heatmap
   Title: FeaturesMonthContributionHeatmap
   Description: A GitHub-style contribution heatmap features section for React and Next.js with a 7 by 26 square grid, intensity legend, shipped stat, and quarterly highlight list, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-month-contribution-heatmap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Header *@
    <div class="text-center">
      <p class="inline-flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-muted-foreground">
        <LucideIconCn Name="git-commit-horizontal" Size="14" Class="size-3.5" aria-hidden="true" />
        Shipping velocity
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        187 features shipped in the last 6 months.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
        Every square is a day we shipped. Every dark square is a day we shipped something
        material. Consistency is the feature.
      </p>
      <div class="mt-7 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-center">
        <ButtonCn Class="w-full sm:w-[210px]">Read changelog</ButtonCn>
        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">
          Follow updates
        </ButtonCn>
      </div>
    </div>

    @* Heatmap container *@
    <div class="mt-10 overflow-x-auto rounded-xl border bg-card p-5 sm:p-6">
      <div class="min-w-fit">
        @* Month labels row *@
        <div
          class="ml-8 grid gap-[3px] text-[10px] font-medium text-muted-foreground"
          style="@($"grid-template-columns: repeat({Weeks}, 0.75rem)")"
          aria-hidden="true">
          @for (var w = 0; w < Weeks; w++)
          {
            var weekIdx = w;
            var monthLabel = _monthLabels.Find(m => m.Week == weekIdx);
            <div class="col-span-1 h-3 overflow-visible whitespace-nowrap">
              @(monthLabel != null ? monthLabel.Label : "")
            </div>
          }
        </div>

        @* Day labels + grid *@
        <div class="mt-1 flex gap-2">
          <div class="flex flex-col gap-[3px] pt-[1px] text-[10px] font-medium text-muted-foreground">
            @for (var i = 0; i < _dayLabels.Length; i++)
            {
              var dayIdx = i;
              var vis = dayIdx % 2 == 0 ? "visible" : "hidden";
              <div class="flex h-3 w-6 items-center" style="@($"visibility:{vis}")">
                @_dayLabels[dayIdx]
              </div>
            }
          </div>
          <div
            class="grid gap-[3px]"
            style="@($"grid-template-columns: repeat({Weeks}, 0.75rem); grid-template-rows: repeat({Days}, 0.75rem); grid-auto-flow: column")">
            @foreach (var cell in _cells)
            {
              <div
                class="@(Cn.Merge("size-3 rounded-[2px]", IntensityStyle(cell.Level)))"
                aria-hidden="true">
              </div>
            }
          </div>
        </div>

        @* Legend *@
        <div class="mt-4 ml-8 flex items-center justify-end gap-1.5 text-[10px] font-medium text-muted-foreground">
          <span>Less</span>
          @for (var lvl = 0; lvl <= 4; lvl++)
          {
            var level = lvl;
            <span class="@(Cn.Merge("size-3 rounded-[2px]", IntensityStyle(level)))" aria-hidden="true"></span>
          }
          <span>More</span>
        </div>
      </div>
    </div>

    @* Quarterly highlights *@
    <div class="mt-8 grid gap-3 sm:grid-cols-3">
      @foreach (var h in _highlights)
      {
        <div class="rounded-lg border bg-card p-4">
          <div class="flex items-center justify-between text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
            <span>@h.Quarter</span>
            <span class="tabular-nums">@h.Date</span>
          </div>
          <h3 class="mt-2 text-sm font-semibold text-foreground">@h.Title</h3>
          <p class="mt-1 text-xs leading-relaxed text-muted-foreground">@h.Description</p>
        </div>
      }
    </div>
  </div>
</section>

@code {
    private const int Weeks = 26;
    private const int Days = 7;

    private static readonly string[] _dayLabels = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private static readonly List<MonthLabel> _monthLabels =
    [
        new MonthLabel(0,  "Nov"),
        new MonthLabel(5,  "Dec"),
        new MonthLabel(9,  "Jan"),
        new MonthLabel(13, "Feb"),
        new MonthLabel(17, "Mar"),
        new MonthLabel(22, "Apr"),
    ];

    private static readonly HeatCell[] _cells = BuildCells();

    private static readonly QuarterHighlight[] _highlights =
    [
        new QuarterHighlight("q4", "Nov 2025", "Week 47", "Multi-region read replicas",   "Sub-10ms P99 reads across every continent."),
        new QuarterHighlight("q1", "Jan 2026", "Week 03", "Attested build pipeline",       "Every release signed, logged, and reproducible."),
        new QuarterHighlight("q2", "Mar 2026", "Week 12", "Edge-native rate limits",       "Per-tenant quotas enforced at the edge tier."),
    ];

    private static HeatCell[] BuildCells()
    {
        var total = Days * Weeks;
        var result = new HeatCell[total];
        for (var i = 0; i < total; i++)
        {
            var day  = i % Days;
            var week = i / Days;
            result[i] = new HeatCell(day, week, IntensityFor(day, week));
        }
        return result;
    }

    private static int IntensityFor(int day, int week)
    {
        var weekend  = day >= 5 ? 1 : 0;
        var wave     = Math.Abs(Math.Sin((week + day * 0.3) * 0.55));
        var baseVal  = wave * 5;
        var adjusted = baseVal - weekend * 1.8;
        if (adjusted < 0.4) return 0;
        if (adjusted < 1.4) return 1;
        if (adjusted < 2.4) return 2;
        if (adjusted < 3.4) return 3;
        return 4;
    }

    private static string IntensityStyle(int level) => level switch
    {
        0 => "bg-muted",
        1 => "bg-muted-foreground/20",
        2 => "bg-muted-foreground/40",
        3 => "bg-muted-foreground/60",
        4 => "bg-foreground",
        _ => "bg-muted",
    };

    private record MonthLabel(int Week, string Label);
    private record HeatCell(int Day, int Week, int Level);
    private record QuarterHighlight(string Id, string Quarter, string Date, string Title, string Description);
}
