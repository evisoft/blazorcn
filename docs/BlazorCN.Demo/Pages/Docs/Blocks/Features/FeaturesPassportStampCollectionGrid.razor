@* ============================================================
   Block: features-passport-stamp-collection-grid
   Title: FeaturesPassportStampCollectionGrid
   Description: A passport stamp features section for React and Next.js arranging capabilities as rotated ink-stamp impressions on a lined passport page with serif typography and arched country labels built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-passport-stamp-collection-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-muted-foreground">
                <LucideIconCn Name="stamp" Size="12" Class="size-3" />
                Passport · Six entries
            </span>
            <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Every release, stamped into the record.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A passport page from two years of shipping — six stamps, six capabilities, and a product
                that has stopped looking like the one you first signed up for.
            </p>
        </div>

        @* Passport page *@
        <div class="mx-auto mt-10 max-w-2xl">
            <div class="relative overflow-hidden rounded-md border-2 bg-card p-6 shadow-sm sm:p-8"
                 style="background-image: repeating-linear-gradient(transparent 0, transparent 27px, var(--border) 27px, var(--border) 28px)">

                @* Page header *@
                <div class="relative flex items-start justify-between border-b-2 border-double border-border pb-4">
                    <div>
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="font-serif text-xs uppercase tracking-[0.18em] text-muted-foreground">
                                Shadcn Republic
                            </span>
                        </div>
                        <div class="mt-1 font-serif text-lg font-bold italic text-foreground">
                            Passport of Releases
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
                            Holder
                        </div>
                        <div class="font-serif text-xs font-semibold italic text-foreground">
                            The Customer
                        </div>
                    </div>
                </div>

                @* Stamp grid *@
                <div class="relative mt-6 grid grid-cols-2 gap-6 sm:grid-cols-3 sm:gap-8">
                    @foreach (var stamp in _stamps)
                    {
                        var s = stamp;
                        <article aria-label="@($"{s.Country} stamp, {s.Date}")" class="relative"
                                 style="@($"transform: rotate({s.Rotation}deg)")">
                            @if (s.Shape == "round")
                            {
                                @* Round stamp *@
                                <div class="relative flex aspect-square w-full items-center justify-center rounded-full border-2 border-dashed border-foreground p-3 text-foreground"
                                     style="@($"opacity: {s.Opacity.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}")">
                                    @* Inner ring *@
                                    <div class="absolute inset-2 rounded-full border border-foreground/60"></div>

                                    @* Arched country label *@
                                    <svg aria-hidden="true" viewBox="0 0 200 200" class="absolute inset-0 h-full w-full">
                                        <defs>
                                            <path id="@($"arc-{s.Id}")" d="M 30,100 A 70,70 0 0 1 170,100" fill="none" />
                                        </defs>
                                        <text fill="currentColor" font-family="serif" font-size="18" font-weight="700" letter-spacing="2">
                                            <textPath href="@($"#arc-{s.Id}")" startOffset="50%" textAnchor="middle">
                                                @s.Country
                                            </textPath>
                                        </text>
                                    </svg>

                                    @* Center content *@
                                    <div class="z-10 flex flex-col items-center gap-1 text-center">
                                        <LucideIconCn Name="@s.IconName" Size="24" Class="size-6" />
                                        <div class="font-mono text-[10px] font-bold uppercase tracking-widest">
                                            @s.Version
                                        </div>
                                        <div class="h-px w-8 bg-foreground/70"></div>
                                        <div class="font-serif text-[9px] uppercase tracking-wider">@s.Date</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @* Rect stamp *@
                                <div class="relative flex aspect-square w-full flex-col items-center justify-between rounded-sm border-2 border-dashed border-foreground p-3 text-foreground"
                                     style="@($"opacity: {s.Opacity.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}")">
                                    @* Inner frame *@
                                    <div class="absolute inset-1.5 rounded-sm border border-foreground/60"></div>

                                    <div class="z-10 flex w-full items-start justify-between">
                                        <span class="font-mono text-[9px] font-bold uppercase tracking-widest">APPROVED</span>
                                        <LucideIconCn Name="@s.IconName" Size="16" Class="size-4" />
                                    </div>

                                    <div class="z-10 text-center">
                                        <div class="font-serif text-[11px] font-bold uppercase leading-tight tracking-wider">
                                            @s.Country
                                        </div>
                                        <div class="mt-0.5 mx-auto h-px w-10 bg-foreground/70"></div>
                                        <div class="mt-0.5 font-mono text-[9px] uppercase tracking-widest">@s.Version</div>
                                    </div>

                                    <div class="z-10 flex w-full items-end justify-between">
                                        <span class="font-serif text-[8px] uppercase tracking-wider">@s.Date</span>
                                        <span class="font-mono text-[8px] uppercase">@s.ShortId</span>
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>

                @* Page footer *@
                <div class="mt-8 flex items-center justify-between border-t-2 border-double border-border pt-4">
                    <div class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
                        P. 14 / 32
                    </div>
                    <div class="flex items-center gap-1.5 font-serif text-[10px] uppercase tracking-wider text-muted-foreground">
                        <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                        Six destinations visited
                    </div>
                    <div class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
                        ID · SH-0042
                    </div>
                </div>
            </div>

            @* Recap list *@
            <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-3">
                @foreach (var stamp in _stamps)
                {
                    var s = stamp;
                    <li class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-foreground" aria-hidden="true"></span>
                        <span class="truncate">
                            @s.Version · @s.Country
                        </span>
                    </li>
                }
            </ul>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[260px]">
                <LucideIconCn Name="stamp" Size="16" Class="size-4" />
                Collect your stamps
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[290px]">
                Read the full changelog
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Stamp(
        string Id,
        string Country,
        string Location,
        string Date,
        string Version,
        string IconName,
        string Shape,
        int Rotation,
        double Opacity,
        string ShortId
    );

    private static readonly Stamp[] _stamps =
    [
        new("launch",   "GRAND LAUNCH",  "v1.0 GENERAL AVAILABILITY", "01 JAN 2024", "V1.0", "rocket",          "round", -6, 0.85, "LAU"),
        new("ai",       "AI ASSIST",     "INTELLIGENCE LAYER",        "14 MAR 2024", "V1.4", "wand-sparkles",   "rect",   4, 0.78, "AI"),
        new("realtime", "REALTIME SYNC", "LIVE COLLABORATION",        "22 JUN 2024", "V1.8", "zap",             "round", -3, 0.82, "REA"),
        new("security", "ZERO TRUST",    "SOC 2 · SSO · SCIM",        "08 SEP 2024", "V2.0", "shield-check",    "rect",  -5, 0.75, "ZER"),
        new("global",   "GLOBAL EDGE",   "38 REGIONS ONLINE",         "17 NOV 2024", "V2.2", "globe",           "round",  5, 0.80, "GLO"),
        new("awards",   "HALL OF FAME",  "PRODUCT OF THE YEAR",       "02 APR 2026", "V2.6", "award",           "rect",   3, 0.88, "HAL"),
    ];
}
