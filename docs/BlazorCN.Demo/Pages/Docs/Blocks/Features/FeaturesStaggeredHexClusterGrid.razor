@* ============================================================
   Block: features-staggered-hex-cluster-grid
   Title: FeaturesStaggeredHexClusterGrid
   Description: A staggered honeycomb cluster feature section for React and Next.js with six feature cells arranged in offset rows that form a distinctive hex silhouette and hover tooltips for descriptions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-staggered-hex-cluster-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="rounded-2xl border bg-card p-6 sm:p-12">

    @* Headline above the cluster *@
    <div class="text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Cluster of capabilities
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Six capabilities, one honeycomb
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
        Hover any cell to learn more. Each capability earned its spot in the cluster by showing up in every single customer interview we ran.
      </p>
    </div>

    @* Honeycomb cluster — two offset rows of 3 cells each *@
    <div class="mt-12 space-y-4 sm:mt-14">

      @* Row 1 (flush) *@
      <div class="grid grid-cols-3 gap-4">
        @foreach (var feat in _features.Take(3))
        {
          var featureItem = feat;
          var isActive1 = _activeId == featureItem.Id;
          <button type="button"
                  @onmouseenter="@(() => _activeId = featureItem.Id)"
                  @onfocus="@(() => _activeId = featureItem.Id)"
                  aria-label="@featureItem.Title"
                  class="@Cn.Merge("group flex aspect-square flex-col items-center justify-center gap-2 rounded-2xl border bg-card p-4 text-center transition-all duration-200 hover:-translate-y-0.5 hover:border-foreground/30 hover:bg-muted/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground/20", isActive1 ? "border-foreground/40 bg-muted/50" : "")">
            <span class="@Cn.Merge("flex size-10 items-center justify-center rounded-xl border bg-background transition-colors", isActive1 ? "border-foreground/40" : "")">
              <LucideIconCn Name="@featureItem.IconName" Size="20" Class="size-5 text-foreground" aria-hidden="true" />
            </span>
            <span class="text-xs font-semibold text-foreground sm:text-sm">
              @featureItem.Title
            </span>
          </button>
        }
      </div>

      @* Row 2 (offset by half a cell width on sm+, flush on mobile) *@
      <div class="grid grid-cols-3 gap-4 sm:translate-x-[calc((100%/3+1rem)/2)] sm:[grid-template-columns:repeat(3,calc((100%-2rem)/3))]">
        @foreach (var feat in _features.Skip(3).Take(3))
        {
          var featureItem = feat;
          var isActive2 = _activeId == featureItem.Id;
          <button type="button"
                  @onmouseenter="@(() => _activeId = featureItem.Id)"
                  @onfocus="@(() => _activeId = featureItem.Id)"
                  aria-label="@featureItem.Title"
                  class="@Cn.Merge("group flex aspect-square flex-col items-center justify-center gap-2 rounded-2xl border bg-card p-4 text-center transition-all duration-200 hover:-translate-y-0.5 hover:border-foreground/30 hover:bg-muted/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground/20", isActive2 ? "border-foreground/40 bg-muted/50" : "")">
            <span class="@Cn.Merge("flex size-10 items-center justify-center rounded-xl border bg-background transition-colors", isActive2 ? "border-foreground/40" : "")">
              <LucideIconCn Name="@featureItem.IconName" Size="20" Class="size-5 text-foreground" aria-hidden="true" />
            </span>
            <span class="text-xs font-semibold text-foreground sm:text-sm">
              @featureItem.Title
            </span>
          </button>
        }
      </div>
    </div>

    @* Tooltip-style active description *@
    @{
      var activeFeature = _features.FirstOrDefault(f => f.Id == _activeId) ?? _features[0];
    }
    <div class="mx-auto mt-10 max-w-lg rounded-xl border bg-muted/50 px-4 py-3 text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        @activeFeature.Title
      </p>
      <p class="mt-1.5 text-sm leading-relaxed text-foreground">
        @activeFeature.Description
      </p>
    </div>

    @* Bottom Learn more link *@
    <div class="mt-8 flex justify-center">
      <a href="#" class="group inline-flex items-center gap-1.5 text-sm font-medium text-foreground">
        Learn more about the cluster
        <LucideIconCn Name="arrow-right" Size="16" Class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
    </div>

  </div>
</section>

@code {
    private record FeatureData(string Id, string IconName, string Title, string Description);

    private static readonly FeatureData[] _features =
    [
        new("speed",    "bolt",        "Instant sync",        "Sub-50ms round trips on every keystroke. The UI never blocks on a network call, even on transatlantic connections."),
        new("security", "lock",        "Zero-trust access",   "SSO, SCIM, and single-tenant isolation on every paid plan with no enterprise tier surcharge required."),
        new("terminal", "terminal",    "Native CLI",          "A first-class command-line client that mirrors every action in the web dashboard for scriptable automation."),
        new("workflow", "waypoints",   "Composable flows",    "Chain typed actions with conditional steps and retry policies. No YAML pyramid, just TypeScript functions."),
        new("git",      "git-branch",  "Branch previews",     "Every pull request gets its own seeded preview environment within 40 seconds of the first push."),
        new("ai",       "sparkles",    "Suggest diffs",       "Contextual inline suggestions learn from your codebase patterns and never propose a line you would reject."),
    ];

    private string _activeId = _features[0].Id;
}
