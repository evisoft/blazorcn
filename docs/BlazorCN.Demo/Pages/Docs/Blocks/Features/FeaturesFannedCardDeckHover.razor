@* ============================================================
   Block: features-fanned-card-deck-hover
   Title: FeaturesFannedCardDeckHover
   Description: A fanned card deck hover features layout for React and Next.js with 5 overlapping rotated cards that spread horizontally on group hover built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-fanned-card-deck-hover.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="rounded-2xl border bg-card p-8 sm:p-12">

    @* Headline *@
    <div class="text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Interactive tour
      </p>
      <h2 class="mx-auto mt-3 max-w-xl text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Hover to explore the five pillars
      </h2>
      <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-muted-foreground sm:text-base">
        The deck fans out on hover so you can read each card without a single click. Settle in
        and the cards settle back.
      </p>
    </div>

    @* Card deck — desktop hover fan *@
    <div class="group relative mt-12 hidden h-[340px] items-center justify-center sm:flex">
      @foreach (var feat in _features)
      {
        var f = feat;
        var idx = Array.IndexOf(_features, f);
        <article
          class="@Cn.Merge("absolute flex h-[280px] w-[220px] flex-col rounded-xl border bg-card p-5 shadow-sm transition-transform duration-500 ease-out will-change-transform", _restTransforms[idx], _hoverTransforms[idx])"
          style="@($"z-index:{idx + 1}")"
        >
          <div aria-hidden="true" class="flex size-10 items-center justify-center rounded-lg bg-muted">
            <LucideIconCn Name="@f.IconName" Size="20" Class="size-5 text-foreground" />
          </div>
          <h3 class="mt-5 text-base font-semibold text-foreground">@f.Title</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            @f.Description
          </p>
          <p class="mt-auto pt-4 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
            0@(idx + 1) / 05
          </p>
        </article>
      }
    </div>

    @* Mobile fallback — stacked card list *@
    <div class="mt-10 flex flex-col gap-3 sm:hidden">
      @foreach (var feat in _features)
      {
        var f = feat;
        var idx = Array.IndexOf(_features, f);
        <article class="rounded-xl border bg-card p-5">
          <div class="flex items-start gap-4">
            <div aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted">
              <LucideIconCn Name="@f.IconName" Size="20" Class="size-5 text-foreground" />
            </div>
            <div>
              <h3 class="text-base font-semibold text-foreground">@f.Title</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                @f.Description
              </p>
              <p class="mt-3 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                0@(idx + 1) / 05
              </p>
            </div>
          </div>
        </article>
      }
    </div>

    @* Hint *@
    <p class="mt-10 text-center text-xs text-muted-foreground">
      Click any card to learn more — each primitive ships with its own documentation.
    </p>

  </div>
</section>

@code {
    private record Feature(string Id, string Title, string Description, string IconName);

    private static readonly Feature[] _features =
    [
        new("primitives", "Composable primitives",
            "Twelve low-level building blocks that snap together cleanly. Adopt one, all, or pick the five you need.",
            "boxes"),
        new("speed", "Sub-50ms interactions",
            "A local-first data layer syncs in the background so the UI never blocks on network round trips.",
            "gauge-circle"),
        new("layers", "Layered architecture",
            "Middleware, cache, queues, and CDN ship standalone so you can mix and replace independently.",
            "layers"),
        new("security", "Enterprise security",
            "SAML 2.0, SCIM provisioning, and SOC 2 Type II come standard on every paid plan with no setup call.",
            "lock"),
        new("polish", "Details that delight",
            "Sweat-the-small-stuff touches across every surface — from empty states to keyboard shortcuts.",
            "sparkles"),
    ];

    // Rest position transforms — cards stacked at center with subtle rotation
    private static readonly string[] _restTransforms =
    [
        "rotate-[-6deg] translate-x-[-18px]",
        "rotate-[-3deg] translate-x-[-9px]",
        "rotate-0 translate-x-0",
        "rotate-[3deg] translate-x-[9px]",
        "rotate-[6deg] translate-x-[18px]",
    ];

    // Hover position transforms — cards fan out horizontally and unrotate
    private static readonly string[] _hoverTransforms =
    [
        "sm:group-hover:rotate-0 sm:group-hover:translate-x-[-280px]",
        "sm:group-hover:rotate-0 sm:group-hover:translate-x-[-140px]",
        "sm:group-hover:rotate-0 sm:group-hover:translate-x-0",
        "sm:group-hover:rotate-0 sm:group-hover:translate-x-[140px]",
        "sm:group-hover:rotate-0 sm:group-hover:translate-x-[280px]",
    ];
}
