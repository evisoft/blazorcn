@* ============================================================
   Block: features-timeline-roadmap
   Title: Features Timeline Roadmap
   Description: Vertical timeline showing product capabilities as milestones with status indicators and version labels for React pages
   Long Description: Features Block Testimonial Features
   Dependencies: None
   Source: original/blocks/features/features-timeline-roadmap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Roadmap</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Our platform evolves with your needs — here is what we have shipped and what is coming
                next
            </p>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative space-y-0">
                @for (var i = 0; i < _milestones.Length; i++)
                {
                    var milestone = _milestones[i];
                    var isLast = i == _milestones.Length - 1;
                    <div class="relative flex gap-3 pb-6">
                        @* Line + Indicator *@
                        <div class="flex flex-col items-center">
                            <div class="@(Cn.Merge("size-3 shrink-0 rounded-full border-2", GetIndicatorClass(milestone.Status)))"></div>
                            @if (!isLast)
                            {
                                <div class="@(Cn.Merge("w-px flex-1", milestone.Step <= 3 ? "bg-primary" : "bg-border"))"></div>
                            }
                        </div>
                        @* Content *@
                        <div class="min-w-0 flex-1 -mt-0.5">
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-xs text-muted-foreground">
                                    @milestone.Version
                                </span>
                                <span class="text-sm">@milestone.Title</span>
                                <span class="@(Cn.Merge("text-xs font-medium", GetStatusColor(milestone.Status)))">
                                    @milestone.StatusLabel
                                </span>
                            </div>
                            <p class="mt-1 text-xs text-muted-foreground">
                                @milestone.Description
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Milestone(int Step, string Version, string Title, string Description, string Status, string StatusLabel);

    private static string GetIndicatorClass(string status) => status switch
    {
        "available" => "border-primary bg-primary",
        "beta" => "border-primary bg-background",
        _ => "border-muted-foreground/30 bg-background",
    };

    private static string GetStatusColor(string status) => status switch
    {
        "available" => "text-emerald-600 dark:text-emerald-400",
        "beta" => "text-amber-600 dark:text-amber-400",
        _ => "text-muted-foreground",
    };

    private static readonly Milestone[] _milestones =
    [
        new(1, "v1.0", "Core Analytics Engine",
            "Real-time event tracking, funnel analysis, and user segmentation with sub-second query performance.",
            "available", "Available"),
        new(2, "v1.2", "Custom Dashboards",
            "Drag-and-drop dashboard builder with 20+ chart types, shared views, and scheduled email reports.",
            "available", "Available"),
        new(3, "v2.0", "Predictive Insights",
            "ML models that forecast churn risk, conversion probability, and revenue trends from historical data.",
            "available", "Available"),
        new(4, "v2.1", "Session Replay",
            "Watch anonymized user sessions with click heatmaps, rage click detection, and error correlation.",
            "beta", "Beta"),
        new(5, "v2.2", "A/B Testing Engine",
            "Built-in experimentation with feature flags, multi-variate tests, and significance calculations.",
            "upcoming", "Coming Q2"),
        new(6, "v3.0", "Data Warehouse Sync",
            "Reverse ETL to push enriched data back to your CRM, marketing tools, and warehouse on schedule.",
            "upcoming", "Coming Q3"),
    ];
}
