@* ============================================================
   Block: features-command-menu-grouped-list
   Title: FeaturesCommandMenuGroupedList
   Description: A command menu features section for React and Next.js presenting capabilities inside a Cmd+K palette mockup with grouped rows, keyboard shortcuts, and live footer hints built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-command-menu-grouped-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-muted-foreground">
                <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                Press ⌘K anywhere
            </span>
            <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Every feature, one keystroke away.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A unified command palette that puts the whole platform behind a single shortcut — no
                context switching, no menu hunting, no tab overflow.
            </p>
        </div>

        @* Command menu mockup *@
        <div class="mx-auto mt-10 max-w-xl overflow-hidden rounded-xl border bg-card shadow-sm">
            @* Search input *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <LucideIconCn Name="search" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <span class="flex-1 text-sm text-muted-foreground">
                    Type a command or search...
                </span>
                <span aria-hidden="true" class="inline-flex h-5 min-w-5 items-center justify-center rounded border border-border bg-background px-1.5 font-mono text-[10px] font-medium text-muted-foreground">esc</span>
            </div>

            @* Grouped list *@
            <ul class="max-h-[420px] overflow-hidden">
                @{ int runningIndex = 0; }
                @foreach (var grp in _groups)
                {
                    <li>
                        <div class="px-4 pb-1 pt-3 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                            @grp.Label
                        </div>
                        <ul>
                            @foreach (var item in grp.Items)
                            {
                                var index = runningIndex++;
                                var isActive = index == 0;
                                <li class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isActive ? "bg-muted/60" : "")">
                                    <span class="flex size-8 shrink-0 items-center justify-center rounded-md border bg-background">
                                        <LucideIconCn Name="@item.IconName" Size="16" Class="size-4 text-foreground" />
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <div class="truncate text-sm font-medium text-foreground">
                                            @item.Title
                                        </div>
                                        <div class="truncate text-xs text-muted-foreground">
                                            @item.Description
                                        </div>
                                    </div>
                                    <div class="hidden shrink-0 items-center gap-1 sm:flex">
                                        @foreach (var key in item.Shortcut.Split(' '))
                                        {
                                            <span aria-hidden="true" class="inline-flex h-5 min-w-5 items-center justify-center rounded border border-border bg-background px-1.5 font-mono text-[10px] font-medium text-muted-foreground">@key</span>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    </li>
                }
            </ul>

            @* Footer hints *@
            <div class="flex flex-wrap items-center gap-3 border-t bg-muted/30 px-4 py-2.5 text-[11px] text-muted-foreground">
                <span class="flex items-center gap-1.5">
                    <span aria-hidden="true" class="inline-flex h-5 min-w-5 items-center justify-center rounded border border-border bg-background px-1.5 font-mono text-[10px] font-medium text-muted-foreground">
                        <LucideIconCn Name="arrow-up" Size="10" Class="size-2.5" />
                    </span>
                    <span aria-hidden="true" class="inline-flex h-5 min-w-5 items-center justify-center rounded border border-border bg-background px-1.5 font-mono text-[10px] font-medium text-muted-foreground">
                        <LucideIconCn Name="arrow-down" Size="10" Class="size-2.5" />
                    </span>
                    navigate
                </span>
                <span class="h-3 w-px bg-border" aria-hidden="true"></span>
                <span class="flex items-center gap-1.5">
                    <span aria-hidden="true" class="inline-flex h-5 min-w-5 items-center justify-center rounded border border-border bg-background px-1.5 font-mono text-[10px] font-medium text-muted-foreground">
                        <LucideIconCn Name="corner-down-left" Size="10" Class="size-2.5" />
                    </span>
                    select
                </span>
                <span class="h-3 w-px bg-border" aria-hidden="true"></span>
                <span class="flex items-center gap-1.5">
                    <span aria-hidden="true" class="inline-flex h-5 min-w-5 items-center justify-center rounded border border-border bg-background px-1.5 font-mono text-[10px] font-medium text-muted-foreground">esc</span>
                    close
                </span>
                <span class="ml-auto hidden sm:inline">9 of 42 commands</span>
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[250px]">View all shortcuts</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record CommandItem(string Id, string IconName, string Title, string Description, string Shortcut);
    private record CommandGroup(string Id, string Label, CommandItem[] Items);

    private static readonly CommandGroup[] _groups =
    [
        new("platform", "Platform",
        [
            new("deploy", "zap", "Deploy to production", "Ship the current branch to every region", "⌘ D"),
            new("logs", "terminal", "Tail live logs", "Stream structured logs across all services", "⌘ L"),
            new("branch", "git-branch", "Create preview branch", "Spin up an isolated preview environment", "G B"),
        ]),
        new("integrations", "Integrations",
        [
            new("database", "database", "Connect a database", "Postgres, MySQL, and MongoDB in one click", "I D"),
            new("webhook", "link", "Register a webhook", "Forward events to any HTTPS endpoint", "I W"),
            new("plugin", "plug", "Install a plugin", "Extend the runtime from the plugin marketplace", "I P"),
        ]),
        new("security", "Security",
        [
            new("rotate", "key-round", "Rotate API keys", "Mint fresh credentials with zero downtime", "S K"),
            new("audit", "shield-check", "Open audit log", "Signed trail of every production change", "S A"),
            new("members", "users", "Invite team member", "SSO provisioning with role presets", "S I"),
        ]),
    ];
}
