@* ============================================================
   Block: features-customer-quote-feature-split
   Title: FeaturesCustomerQuoteFeatureSplit
   Description: A customer quote split features section for React and Next.js with a left column headline, three CheckIcon bullets, dual ShadcnioButton CTAs, and a right column square image placeholder with a floating testimonial card overlay built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-customer-quote-feature-split.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">
        <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
            @* Left — headline + bullets + CTAs *@
            <div>
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    @_headline.Eyebrow
                </p>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                    @_headline.Title
                </h2>
                <p class="mt-5 max-w-lg text-base leading-relaxed text-muted-foreground">
                    @_headline.Subtitle
                </p>

                <ul class="mt-7 space-y-3">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-start gap-3">
                            <span aria-hidden="true" class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                            </span>
                            <span class="text-sm leading-relaxed text-foreground">@feature.Text</span>
                        </li>
                    }
                </ul>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[260px]">Read the case study</ButtonCn>
                </div>
            </div>

            @* Right — square image placeholder with floating testimonial overlay *@
            <div class="relative">
                <div aria-hidden="true" class="relative flex aspect-square w-full items-center justify-center overflow-hidden rounded-2xl bg-muted">
                    <div class="absolute size-40 rounded-full border border-muted-foreground/[0.06]"></div>
                    <div class="absolute size-24 rounded-full border border-muted-foreground/[0.08]"></div>
                    <div class="absolute h-px w-56 bg-muted-foreground/[0.06]"></div>
                    <div class="absolute h-56 w-px bg-muted-foreground/[0.06]"></div>
                    <div class="flex size-12 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                        <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/40" />
                    </div>
                </div>

                @* Floating testimonial card overlay *@
                <figure class="absolute bottom-4 right-4 max-w-[280px] rounded-xl border bg-card p-4 shadow-lg">
                    <blockquote class="text-sm italic leading-relaxed text-foreground">
                        &ldquo;@_testimonial.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-3 flex items-center gap-3 border-t pt-3">
                        <span aria-hidden="true" class="flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold text-foreground">
                            @_testimonial.Initials
                        </span>
                        <span class="flex flex-col">
                            <cite class="text-sm font-semibold not-italic text-foreground">@_testimonial.Name</cite>
                            <span class="text-xs text-muted-foreground">@_testimonial.Role</span>
                        </span>
                    </figcaption>
                </figure>
            </div>
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureItem(string Id, string Text);
    private record TestimonialData(string Quote, string Name, string Role, string Initials);

    private static readonly HeadlineData _headline = new(
        "Case study",
        "Ship every branch to a preview URL in under 40 seconds",
        "Edge Runtime builds, zero-config deploys, and real-time collaboration across every environment. The tooling teams at Linear, Vercel, and Raycast rely on to ship daily."
    );

    private static readonly FeatureItem[] _features =
    [
        new("edge-runtime", "Edge Runtime with 18 global regions"),
        new("zero-config", "Zero-config deploys from your Git provider"),
        new("collab", "Real-time collaboration on every preview URL"),
    ];

    private static readonly TestimonialData _testimonial = new(
        "We cut our preview build times from four minutes to thirty seconds. Our reviewers stopped context-switching and our velocity doubled in a quarter.",
        "Priya Raman",
        "Staff Engineer, Foundry",
        "PR"
    );
}
