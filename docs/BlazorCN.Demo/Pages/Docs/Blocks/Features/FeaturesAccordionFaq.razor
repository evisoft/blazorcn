@* ============================================================
   Block: features-accordion-faq
   Title: FeaturesAccordionFaq
   Description: A tabbed accordion feature section for React and Next.js with PillTabs category switching and shadcn/ui Accordion capability questions that expand to reveal feature details built with Tailwind CSS
   Source: original/blocks/features/features-accordion-faq.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card p-6 sm:p-10">

        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Features
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
                Explore the platform, one answer at a time
            </h2>
            <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-muted-foreground">
                Pick a category and tap a capability question to reveal how it works — no scrolling, no
                wall of text.
            </p>
        </div>

        @* Tabs (PillTabs -> pill-style buttons) *@
        <div class="mt-8 flex justify-center">
            <div class="inline-flex items-center gap-1 rounded-full border bg-muted p-1">
                @foreach (var tab in _tabs)
                {
                    var t = tab;
                    <button
                        type="button"
                        @onclick="@(() => HandleTabChange(t))"
                        class="@(Cn.Merge(
                            "rounded-full px-4 py-1.5 text-sm font-medium transition-colors",
                            _activeTab == t
                                ? "bg-background text-foreground shadow-sm"
                                : "text-muted-foreground hover:text-foreground"
                        ))"
                        aria-label="@t"
                    >
                        @_tabLabels[t]
                    </button>
                }
            </div>
        </div>

        @* Accordion *@
        <div class="mt-8">
            @{
                var activeGroup = System.Array.Find(_featureGroups, g => g.Id == _activeTab) ?? _featureGroups[0];
            }
            <AccordionCn>
                @for (var i = 0; i < activeGroup.Features.Length; i++)
                {
                    var feature = activeGroup.Features[i];
                    <AccordionItemCn Class="border-b-0" DefaultOpen="@(feature.Id == _activeFeature)">
                        <AccordionTriggerCn Class="gap-3 py-4 text-left hover:no-underline [&>svg]:size-4 [&>svg]:text-muted-foreground">
                            <span class="flex flex-1 items-center gap-3">
                                <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted">
                                    <LucideIconCn Name="@feature.IconName" Size="16" Class="size-4 text-muted-foreground" />
                                </span>
                                <span class="text-sm font-semibold text-foreground sm:text-base">
                                    @feature.Question
                                </span>
                            </span>
                        </AccordionTriggerCn>
                        <AccordionContentCn Class="pb-4">
                            <div class="pl-11">
                                <p class="text-sm leading-relaxed text-muted-foreground">
                                    @feature.Description
                                </p>
                                <ul class="mt-3 space-y-2">
                                    @foreach (var bullet in feature.Bullets)
                                    {
                                        <li class="flex items-start gap-2 text-xs text-muted-foreground">
                                            <span aria-hidden="true" class="mt-1.5 size-1 shrink-0 rounded-full bg-foreground/30"></span>
                                            <span>@bullet</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </AccordionContentCn>
                    </AccordionItemCn>
                }
            </AccordionCn>
        </div>

    </div>
</section>

@code {
    private record Feature(string Id, string IconName, string Question, string Description, string[] Bullets);
    private record FeatureGroup(string Id, string Label, Feature[] Features);

    private string _activeTab = "collaborate";
    private string _activeFeature = "co-editing";

    private static readonly string[] _tabs = ["collaborate", "automate", "govern"];

    private static readonly Dictionary<string, string> _tabLabels = new()
    {
        ["collaborate"] = "Collaborate",
        ["automate"] = "Automate",
        ["govern"] = "Govern",
    };

    private static readonly FeatureGroup[] _featureGroups =
    [
        new("collaborate", "Collaborate",
        [
            new("co-editing", "users", "How does real-time co-editing stay in sync?",
                "Every keystroke is merged through a CRDT engine that resolves concurrent edits without conflicts. Live cursors, presence avatars, and selection highlights update under 40ms for teams of any size.",
                ["Presence cursors with typing and selection state", "CRDT-based merge resolves concurrent edits", "Offline edits replay on reconnect with zero data loss"]),
            new("review-threads", "message-square", "Can reviewers leave comments tied to specific lines?",
                "Inline comment threads anchor to content blocks and follow edits as documents change. Reviewers tag teammates, resolve threads, and reopen them from the dashboard without losing context.",
                ["Anchored threads follow edits across revisions", "Slack and email notifications per mention", "Resolved threads archive with searchable history"]),
            new("version-history", "git-branch", "How do I roll back to a previous version?",
                "Every saved change is captured as a semantic version with author attribution. Restore any revision from the past 365 days with a single click, or diff two points in time side by side.",
                ["Unlimited revision history on every plan", "Named checkpoints for milestone releases", "Side-by-side diff viewer with author highlights"]),
            new("shared-libraries", "sparkles", "Can design tokens stay synced across projects?",
                "Shared component libraries publish tokens once and propagate updates to every connected project in real time. Override locally when you need to, then re-sync when ready.",
                ["Push updates propagate across all consumers", "Per-project overrides with diff banners", "Versioned releases with deprecation warnings"]),
        ]),
        new("automate", "Automate",
        [
            new("workflow-builder", "workflow", "How do I build workflows without writing code?",
                "A visual drag-and-drop canvas wires triggers, conditions, and actions into branching workflows. Test runs execute against sandbox data so you can iterate safely before going live.",
                ["200+ pre-built triggers and actions", "Branching logic with conditional evaluation", "Sandbox test runs with step-by-step logs"]),
            new("scheduled-jobs", "gauge", "Can jobs run on a schedule or on events?",
                "Schedule recurring jobs with cron expressions or trigger instantly from webhooks, database changes, and queue messages. Execution metrics surface in the run history for every invocation.",
                ["Cron expressions with timezone awareness", "Event-based triggers from 180+ integrations", "Retry policies with exponential backoff"]),
            new("webhook-relays", "webhook", "How do I transform payloads between tools?",
                "Webhook relays accept incoming payloads, transform them with JavaScript expressions, and forward to any downstream endpoint. No intermediate server or glue code required.",
                ["Inline JavaScript payload transformers", "Signed requests with rotating secrets", "Replay failed deliveries from the dashboard"]),
            new("cli-actions", "terminal", "Can I trigger workflows from the command line?",
                "The CLI mirrors every workflow action as a scriptable command so you can invoke automations from CI/CD pipelines, shell scripts, or local git hooks without leaving your terminal.",
                ["Scriptable commands for every action", "JSON output for pipeline integration", "Local git hooks with one-line install"]),
        ]),
        new("govern", "Govern",
        [
            new("rbac", "shield-check", "How granular are the permission controls?",
                "Role-based access control reaches all the way down to individual fields. Define custom roles, inherit from templates, and scope permissions by workspace, project, or document.",
                ["Field-level permissions with inheritance", "Custom roles scoped to projects or folders", "Bulk assignment from Okta or SCIM groups"]),
            new("audit-log", "key-round", "Is there an audit trail for compliance reporting?",
                "An immutable audit log captures every action across the workspace with actor, timestamp, IP address, and before/after state. Export as CSV or stream to your SIEM in real time.",
                ["Immutable append-only ledger", "CSV and JSON export with date filters", "Real-time streaming to Splunk or Datadog"]),
            new("residency", "globe", "Can I choose where my data is stored?",
                "Pick a primary region from US, EU, or APAC at workspace creation. All data at rest, backups, and processing stay within the chosen region to meet GDPR and local compliance requirements.",
                ["Region-pinned storage and compute", "Separate EU processor for GDPR workflows", "Data residency contract addendum on request"]),
            new("sso", "zap", "How do SSO and SCIM provisioning work?",
                "SAML 2.0 single sign-on integrates with Okta, Azure AD, Google Workspace, and any SAML provider. SCIM 2.0 automatically provisions, updates, and deprovisions users when your directory changes.",
                ["SAML 2.0 with Okta, Azure AD, Google", "SCIM 2.0 just-in-time provisioning", "Enforced 2FA via identity provider"]),
        ]),
    ];

    private void HandleTabChange(string tab)
    {
        _activeTab = tab;
        var nextGroup = System.Array.Find(_featureGroups, g => g.Id == tab);
        if (nextGroup != null)
        {
            _activeFeature = nextGroup.Features[0].Id;
        }
    }
}
