@* ============================================================
   Block: features-dock-magnifier-hover-bar
   Title: FeaturesDockMagnifierHoverBar
   Description: A dock magnifier hover bar features section for React and Next.js with macOS style icon magnification, bell curve distance falloff, and a synced active feature detail card built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-dock-magnifier-hover-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Headline cluster *@
    <div class="max-w-xl">
      <div class="flex items-center gap-2">
        <span class="flex size-6 items-center justify-center rounded-md border bg-background">
          <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-muted-foreground" />
        </span>
        <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
          The creative suite dock
        </span>
      </div>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Hover the dock to bring each feature forward.
      </h2>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">
        Every tool lives in a magnifying row. Sweep across the dock and the icon under your
        cursor lifts while its neighbors taper away in a soft bell curve.
      </p>
    </div>

    @* Active feature detail card *@
    @{ var active = _dockFeatures[_activeIndex]; }
    <div class="mt-10 overflow-hidden rounded-xl border bg-card">
      <div class="flex flex-col gap-6 p-6 md:flex-row md:gap-8 md:p-8">
        <div class="flex flex-1 flex-col">
          <div class="flex items-center gap-2">
            <span class="flex size-8 items-center justify-center rounded-md border bg-background">
              <LucideIconCn Name="@active.IconName" Size="16" Class="size-4 text-foreground" />
            </span>
            <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
              @active.Label
            </span>
            <span class="ml-auto font-mono text-[10px] text-muted-foreground tabular-nums">
              @($"{(_activeIndex + 1):D2}/{_dockFeatures.Length:D2}")
            </span>
          </div>
          <h3 class="mt-4 text-xl font-semibold leading-tight text-foreground md:text-2xl">
            @active.Headline
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            @active.Description
          </p>
          <ul class="mt-5 space-y-2">
            @foreach (var bullet in active.Bullets)
            {
              <li class="flex items-start gap-2 text-sm text-foreground">
                <span class="mt-[7px] size-1 rounded-full bg-foreground/70" />
                <span>@bullet</span>
              </li>
            }
          </ul>
        </div>

        <div class="hidden w-[200px] shrink-0 flex-col justify-between rounded-lg border bg-muted/40 p-5 md:flex">
          <div>
            <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
              @active.MetricLabel
            </div>
            <div class="mt-2 font-mono text-3xl font-semibold text-foreground tabular-nums">
              @active.MetricValue
            </div>
          </div>
          <div class="space-y-2">
            <div class="h-1 w-full overflow-hidden rounded-full bg-muted">
              <div
                class="h-full rounded-full bg-foreground/80 transition-all duration-300"
                style="@($"width:{(double)(_activeIndex + 1) / _dockFeatures.Length * 100:F1}%")"
              ></div>
            </div>
            <div class="flex items-center justify-between font-mono text-[9px] text-muted-foreground">
              <span>Suite progress</span>
              <span>@(_activeIndex + 1) / @_dockFeatures.Length</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    @* Dock *@
    <div class="mt-8">
      <div class="mx-auto flex w-fit items-end gap-3 rounded-2xl border bg-muted/40 px-5 py-3 shadow-sm backdrop-blur">
        @for (var i = 0; i < _dockFeatures.Length; i++)
        {
          var idx = i;
          var feat = _dockFeatures[idx];
          var isActive = idx == _activeIndex;
          <div class="group relative flex flex-col items-center focus:outline-none">
            <button
              type="button"
              aria-label="@($"{feat.Label}: {feat.Headline}")"
              @onmouseenter="@(() => _activeIndex = idx)"
              @onfocus="@(() => _activeIndex = idx)"
              @onclick="@(() => _activeIndex = idx)"
              class="@Cn.Merge(
                "flex flex-col items-center transition-transform duration-150 ease-out focus:outline-none",
                isActive ? "scale-125" : "hover:scale-110"
              )"
              style="transform-origin: 50% 100%;"
            >
              <span
                class="@Cn.Merge(
                  "flex items-center justify-center rounded-xl border bg-background shadow-sm transition-colors",
                  isActive ? "border-foreground/40" : "group-hover:border-foreground/40 group-focus-visible:ring-2 group-focus-visible:ring-foreground/30"
                )"
                style="width:44px;height:44px;"
              >
                <LucideIconCn Name="@feat.IconName" Size="20" Class="size-5 text-foreground transition-transform" />
              </span>
            </button>
            <span
              class="@Cn.Merge(
                "pointer-events-none absolute -top-8 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md border bg-background px-2 py-1 font-mono text-[10px] text-muted-foreground shadow-sm transition-opacity",
                isActive ? "opacity-100" : "opacity-0"
              )"
            >
              @feat.Label
            </span>
          </div>
        }
      </div>
    </div>

    @* Footer row *@
    <div class="mt-6 flex flex-col gap-3 rounded-lg border bg-muted/30 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-2">
        <LucideIconCn Name="clapperboard" Size="14" Class="size-3.5 text-muted-foreground" />
        <span class="text-xs text-muted-foreground">
          Eight tools, one magnifying row — follow your cursor to explore each.
        </span>
      </div>
      <div class="flex items-center gap-2">
        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Try every tool</ButtonCn>
        <ButtonCn Class="w-full sm:w-[230px]">Download the app</ButtonCn>
      </div>
    </div>
  </div>
</section>

@code {
    private int _activeIndex = 3;

    private record DockFeature(
        string Id,
        string IconName,
        string Label,
        string Headline,
        string Description,
        string[] Bullets,
        string MetricLabel,
        string MetricValue
    );

    private static readonly DockFeature[] _dockFeatures =
    [
        new DockFeature("brush", "brush", "Brush studio",
            "Brushes that respond to pressure",
            "Pen tilt, barrel rotation, and velocity are mapped to every dynamic property in real time.",
            ["2,048 pressure levels", "Barrel rotation", "Live stroke preview"],
            "Latency", "4 ms"),
        new DockFeature("vector", "pen-tool", "Vector path",
            "Vectors that stay sharp at any zoom",
            "A true Bezier engine keeps every anchor editable and exports crisp SVG with almost no noise.",
            ["True Bezier engine", "Anchor snapping", "SVG export"],
            "Zoom range", "0.1–64x"),
        new DockFeature("layers", "layers", "Layer stack",
            "Layers with cascading blend modes",
            "Non-destructive effect stacks let you reorder and remix without ever flattening the source.",
            ["Non-destructive FX", "Stack reordering", "Smart mask groups"],
            "Max layers", "1,024"),
        new DockFeature("type", "type", "Typography",
            "Typography with variable axes",
            "Variable fonts, optical kerning, and multi-line grid snapping make every headline read clean.",
            ["Variable axes", "Optical kerning", "Baseline grid"],
            "Glyph coverage", "142k"),
        new DockFeature("color", "palette", "Color lab",
            "Color that stays true across screens",
            "Wide gamut pipelines, perceptual mixing, and per-asset profiles keep your work honest.",
            ["Display-P3 native", "Perceptual mixing", "Profile tagging"],
            "Gamut", "Display-P3"),
        new DockFeature("image", "image", "Raster edit",
            "Raster editing without the crash",
            "Tiled compositing keeps memory flat even at 64 megapixel canvas sizes on everyday laptops.",
            ["Tiled compositor", "Lazy histograms", "Content-aware fill"],
            "Max canvas", "64 MP"),
        new DockFeature("motion", "film", "Timeline",
            "Timelines for motion design",
            "A dope sheet timeline brings keyframe curves and track overrides into the same document.",
            ["Dope sheet", "Curve editor", "Linked overrides"],
            "Playback", "60 fps"),
        new DockFeature("ai", "wand", "Magic",
            "Assisted edits that respect your style",
            "Tell the assistant what you want and it fills in the gaps using only your own palette and brushes.",
            ["Local style transfer", "Palette lock", "Undo-first design"],
            "Infer", "280 ms"),
    ];
}
