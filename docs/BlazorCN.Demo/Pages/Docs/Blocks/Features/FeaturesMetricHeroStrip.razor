@* ============================================================
   Block: features-metric-hero-strip
   Title: FeaturesMetricHeroStrip
   Description: A metric hero strip features section for React and Next.js with a full-width four-cell divided stat strip as the hero and a supporting three-column feature row built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-metric-hero-strip.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">

        @* Headline cluster *@
        <div class="px-6 pb-10 pt-10 text-center sm:px-10 sm:pb-12 sm:pt-14">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_headline.Eyebrow
            </p>
            <h2 class="mx-auto mt-3 max-w-2xl text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_headline.Title
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>
        </div>

        @* Full-width metric hero strip *@
        <div class="grid grid-cols-2 divide-x divide-y divide-border border-y bg-muted/30 md:grid-cols-4 md:divide-y-0">
            @foreach (var metric in _metrics)
            {
                <div class="flex flex-col items-center justify-center px-4 py-10 sm:py-14">
                    <span class="text-4xl font-bold tabular-nums tracking-tight text-foreground sm:text-5xl">
                        @metric.Value
                    </span>
                    <span class="mt-3 text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                        @metric.Label
                    </span>
                </div>
            }
        </div>

        @* Supporting three-column feature row *@
        <div class="grid grid-cols-1 gap-8 px-6 py-10 sm:px-10 sm:py-12 lg:grid-cols-3 lg:gap-10">
            @foreach (var feature in _features)
            {
                <div>
                    <div class="flex items-center gap-2.5">
                        <span aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted">
                            <LucideIconCn Name="@feature.Icon" Size="16" Class="size-4 text-foreground" />
                        </span>
                        <h3 class="text-base font-semibold text-foreground">@feature.Title</h3>
                    </div>
                    <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
                        @feature.Description
                    </p>
                </div>
            }
        </div>

        @* Centered CTA *@
        <div class="flex flex-col items-center justify-center border-t px-6 py-8 sm:px-10">
            <ButtonCn Class="w-full sm:w-[260px]">Explore the platform</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record MetricData(string Id, string Value, string Label);
    private record FeatureData(string Id, string Title, string Description, string Icon);

    private static readonly HeadlineData _headline = new(
        "Built for scale",
        "Numbers that prove the platform delivers",
        "Four headline metrics from production workloads, backed by three capabilities that keep them consistent at every tier."
    );

    private static readonly MetricData[] _metrics =
    [
        new("uptime",     "99.99%", "Measured uptime"),
        new("p95",        "42ms",   "Global p95 latency"),
        new("throughput", "10M+",   "Requests per second"),
        new("breaches",   "0",      "Breaches since 2019"),
    ];

    private static readonly FeatureData[] _features =
    [
        new("edge-runtime", "Edge-first runtime",     "Regional failover routes traffic to the nearest healthy node automatically.",                             "zap"),
        new("autoscale",    "Predictive autoscale",   "Capacity ramps ahead of traffic spikes instead of reacting after the queue fills.",                      "gauge"),
        new("hardened",     "Hardened by default",    "SOC 2, ISO 27001, and HIPAA controls enabled on every workload from day one.",                           "shield-check"),
    ];
}
