@* ============================================================
   Block: features-code-examples
   Title: Features Code Examples
   Description: A features block showcasing technical features with inline code snippets
   Dependencies: None
   Source: original/blocks/features/features-code-examples.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Developer-First Features</h2>
            <p class="mt-1 text-xs text-muted-foreground">Built for developers, by developers</p>
        </div>

        @for (var i = 0; i < _features.Length; i++)
        {
            var feature = _features[i];
            <div class="@(i < _features.Length - 1 ? "border-b" : "")">
                <div class="px-4 py-3">
                    <div class="flex items-start gap-3">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                        <div class="min-w-0 flex-1">
                            <h3 class="text-sm font-medium">@feature.Title</h3>
                            <p class="mt-1 text-xs text-muted-foreground">@feature.Description</p>
                        </div>
                    </div>
                </div>
                <div class="px-4 pb-3">
                    <div class="overflow-hidden rounded-md bg-zinc-950">
                        <pre class="overflow-x-auto p-3"><code class="font-mono text-xs text-zinc-50">@feature.Code</code></pre>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Feature(string Title, string Description, string Code);

    private static readonly Feature[] _features =
    [
        new("Simple initialization", "Get started with a single function call and minimal configuration",
            "import { init } from '@acme/sdk'\n\nconst client = init({ apiKey: process.env.API_KEY })"),
        new("Type-safe queries", "Full TypeScript support with autocomplete and compile-time validation",
            "const users = await client.users.list({\n  limit: 10,\n  status: 'active'\n})"),
        new("Real-time subscriptions", "Subscribe to live updates with automatic reconnection and backoff",
            "client.on('message', (data) => {\n  console.log('New message:', data)\n})"),
        new("Error handling", "Structured error responses with detailed context and retry guidance",
            "try {\n  await client.send(message)\n} catch (error) {\n  if (error.retryable) await retry()\n}"),
    ];
}
