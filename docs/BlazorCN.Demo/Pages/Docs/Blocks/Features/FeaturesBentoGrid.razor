@* ============================================================
   Block: features-bento-grid
   Title: Features Bento Grid
   Description: Asymmetric bento grid with hero card and accent cells for visually dynamic React feature showcases
   Long Description: Features with stats and testimonial
   Dependencies: None
   Source: original/blocks/features/features-bento-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Built for modern development teams</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Every tool your engineering team needs to plan, build, and ship great software
            </p>
        </div>

        <div class="grid gap-px bg-border md:grid-cols-2 lg:grid-cols-3 lg:grid-rows-2">
            @{ var featureIndex = 0; }
            @foreach (var feature in _features)
            {
                var isHero = featureIndex == 0;
                <div
                    class="@(Cn.Merge(
                        "bg-card px-4 py-4",
                        isHero ? "lg:col-span-2 lg:row-span-2 flex flex-col justify-center bg-muted/30" : ""
                    ))"
                >
                    <p class="@(Cn.Merge("font-medium", isHero ? "text-sm" : "text-sm"))">@feature.Title</p>
                    <p class="@(Cn.Merge(
                        "mt-1 text-muted-foreground leading-relaxed",
                        isHero ? "text-sm" : "text-xs"
                    ))">
                        @feature.Description
                    </p>
                </div>
                featureIndex++;
            }
        </div>
    </div>
</section>

@code {
    private record FeatureData(string Title, string Description);

    private static readonly FeatureData[] _features =
    [
        new("Issue Tracking", "Plan, track, and manage issues with sub-issue trees, custom views, and automated workflows that keep your team in flow."),
        new("Sprint Planning", "Organize work into cycles with automatic carry-over and velocity tracking."),
        new("Git Integration", "Link pull requests, branches, and commits directly to issues for full traceability."),
        new("Security & Compliance", "SOC 2 Type II certified with role-based access, audit logs, and SSO."),
        new("Analytics Dashboard", "Real-time metrics on cycle time, throughput, and team workload at a glance."),
    ];
}
