@* ============================================================
   Block: features-large-headline-side-checklist
   Title: FeaturesLargeHeadlineSideChecklist
   Description: A dominant oversized headline split feature section for React and Next.js with a huge left marketing headline, dual CTA row, and a single-column right checklist of five features built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-large-headline-side-checklist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-8 sm:p-12 lg:p-14">
        <div class="grid items-start gap-12 lg:grid-cols-[6fr_5fr] lg:gap-16">
            @* Left — Dominant headline *@
            <div>
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    @_headline.Eyebrow
                </p>
                <h2 class="mt-4 text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl">
                    @_headline.Title
                </h2>
                <p class="mt-6 max-w-lg text-base leading-relaxed text-muted-foreground">
                    @_headline.Subtitle
                </p>
                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">Book a demo</ButtonCn>
                </div>
            </div>

            @* Right — Single-column checklist *@
            <ul class="flex flex-col gap-7">
                @foreach (var feature in _features)
                {
                    <li>
                        <div class="flex items-start gap-3">
                            <span aria-hidden="true" class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <h3 class="text-base font-semibold text-foreground">@feature.Title</h3>
                                <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                                    @feature.Description
                                </p>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record Feature(string Id, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        "The manifesto",
        "Software that gets out of the way so your team can ship",
        "We stripped every feature that did not earn its place and invested the savings into the five below. Each one is battle-tested by teams deploying to production hundreds of times a day."
    );

    private static readonly Feature[] _features =
    [
        new("instant-rollback",
            "Instant rollback to any prior deploy",
            "Revert a broken release in under two seconds from the command menu — no CI rerun, no redeploy, no incident bridge."),
        new("preview-environments",
            "A preview environment for every pull request",
            "Reviewers click a link and land on a fully isolated stack with the PR's branch running against a fresh database seed."),
        new("zero-downtime-migrations",
            "Zero-downtime schema migrations",
            "Online DDL and shadow tables run in the background and flip atomically when the new schema is warm and validated."),
        new("audit-everything",
            "Every action audited by default",
            "Structured audit logs ship to your SIEM of choice with tamper-evident hashes — no feature flag, no extra tier to unlock."),
        new("pager-friendly",
            "Pager-friendly observability out of the box",
            "Actionable alerts only, tied to SLOs you configure once. No noise at 3am for metrics nobody owns."),
    ];
}
