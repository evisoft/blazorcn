@* ============================================================
   Block: features-card-ring-3d-rotating-carousel
   Title: FeaturesCardRing3dRotatingCarousel
   Description: A 3D rotating card ring carousel features section for React and Next.js with six perspective cards arranged in a circle, spring-animated ring rotation, and a dimmed off-axis treatment built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-card-ring-3d-rotating-carousel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div class="max-w-xl">
                <div class="flex items-center gap-2">
                    <span class="flex size-6 items-center justify-center rounded-md border bg-background">
                        <LucideIconCn Name="globe" Size="12" Class="size-3 text-muted-foreground" />
                    </span>
                    <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        Six regions on the wheel
                    </span>
                </div>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                    Your data, spun to you.
                </h2>
                <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                    Every region is a card on a 3D ring. Use the arrows to rotate through them — the
                    active card faces forward while the others recede with true perspective depth.
                </p>
            </div>
        </div>

        @* Ring stage *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-muted/20 p-6 md:p-10">
            <div class="relative mx-auto h-[360px] w-full max-w-[520px]" style="perspective:1400px">
                @* Ring container — rotates around Y axis *@
                <div class="relative h-full w-full"
                     style="@($"transform-style:preserve-3d; transform:rotateY({_ringRotation}deg); transition:transform 0.55s cubic-bezier(0.34,1.56,0.64,1)")">
                    @foreach (var regionItem in _regions)
                    {
                        var idx = Array.IndexOf(_regions, regionItem);
                        var cardAngle = idx * AnglePerCard;
                        var isActive = idx == _activeIndex;
                        var relAngle = ((cardAngle - (-_ringRotation) + 540) % 360) - 180;
                        var absAngle = Math.Abs(((relAngle + 180) % 360) - 180);
                        var dimFactor = Math.Min(absAngle / 180.0, 1.0);
                        var opacity = 1.0 - dimFactor * 0.65;
                        var blurPx = isActive ? 0.0 : dimFactor * 1.2;
                        var filterStr = isActive ? "none" : $"blur({blurPx:F2}px)";
                        var borderClass = isActive ? "border-foreground/20 shadow-lg" : "border-border";
                        var ariaHidden = isActive ? "false" : "true";

                        <div class="absolute inset-x-0 top-1/2 mx-auto h-[280px] w-[220px] -translate-y-1/2"
                             style="@($"transform:rotateY({cardAngle}deg) translateZ(280px); transform-style:preserve-3d")"
                             aria-hidden="@ariaHidden">
                            <div class="@Cn.Merge("flex h-full w-full flex-col overflow-hidden rounded-xl border bg-card p-5", borderClass)"
                                 style="@($"opacity:{opacity:F3}; filter:{filterStr}")">
                                @* Header row *@
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <span class="flex size-7 items-center justify-center rounded-md border bg-background font-mono text-[10px] font-medium text-foreground">
                                            @regionItem.Flag
                                        </span>
                                        <div>
                                            <div class="text-[9px] font-medium uppercase tracking-widest text-muted-foreground">
                                                @regionItem.Code
                                            </div>
                                        </div>
                                    </div>
                                    <span class="flex items-center gap-1 text-[9px] text-muted-foreground">
                                        <span class="@Cn.Merge("size-1.5 rounded-full", regionItem.Status == "operational" ? "bg-emerald-500" : "bg-amber-500")"></span>
                                        @regionItem.Status
                                    </span>
                                </div>

                                @* Name *@
                                <h3 class="mt-4 text-sm font-medium text-foreground">@regionItem.Name</h3>
                                <p class="mt-0.5 text-xs text-muted-foreground">@regionItem.City</p>

                                @* Metrics *@
                                <div class="mt-auto grid grid-cols-3 gap-2 border-t pt-4">
                                    <div>
                                        <div class="text-[9px] font-medium uppercase tracking-wider text-muted-foreground">
                                            p95
                                        </div>
                                        <div class="mt-0.5 font-mono text-xs font-medium text-foreground tabular-nums">
                                            @regionItem.LatencyP95
                                        </div>
                                    </div>
                                    <div>
                                        <div class="text-[9px] font-medium uppercase tracking-wider text-muted-foreground">
                                            Uptime
                                        </div>
                                        <div class="mt-0.5 font-mono text-xs font-medium text-foreground tabular-nums">
                                            @regionItem.Uptime
                                        </div>
                                    </div>
                                    <div>
                                        <div class="text-[9px] font-medium uppercase tracking-wider text-muted-foreground">
                                            Capacity
                                        </div>
                                        <div class="mt-0.5 font-mono text-xs font-medium text-foreground tabular-nums">
                                            @regionItem.Capacity
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Controls *@
            <div class="mt-6 flex items-center justify-between gap-4">
                <button type="button"
                        @onclick="@(() => Advance(-1))"
                        class="flex size-9 items-center justify-center rounded-md border bg-background text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                        aria-label="Previous region">
                    <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                </button>

                <div class="flex flex-1 items-center justify-center gap-0.5">
                    @foreach (var dotRegion in _regions)
                    {
                        var di = Array.IndexOf(_regions, dotRegion);
                        var dotActive = di == _activeIndex;
                        var dotIndex = di;
                        <button key="@($"dot-{dotRegion.Id}")"
                                type="button"
                                @onclick="@(() => _activeIndex = dotIndex)"
                                aria-label="@($"Jump to {dotRegion.Name}")"
                                class="inline-flex h-6 min-w-6 items-center justify-center">
                            <span class="@Cn.Merge("h-1.5 rounded-full transition-all", dotActive ? "w-8 bg-foreground" : "w-2 bg-muted-foreground/30 hover:bg-muted-foreground/60")"></span>
                        </button>
                    }
                </div>

                <button type="button"
                        @onclick="@(() => Advance(1))"
                        class="flex size-9 items-center justify-center rounded-md border bg-background text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                        aria-label="Next region">
                    <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                </button>
            </div>
        </div>

        @* Active region summary bar *@
        <div class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-lg border bg-card px-5 py-4">
            <div class="flex items-center gap-3">
                <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Now facing
                </span>
                <span class="font-mono text-xs font-medium text-foreground">
                    @_activeRegion.Code
                </span>
                <span class="text-xs text-muted-foreground">· @_activeRegion.City</span>
            </div>
            <div class="flex items-center gap-5 font-mono text-xs tabular-nums">
                <div class="flex items-center gap-1.5">
                    <span class="text-[9px] uppercase text-muted-foreground">p95</span>
                    <span class="text-foreground">@_activeRegion.LatencyP95</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="text-[9px] uppercase text-muted-foreground">Up</span>
                    <span class="text-foreground">@_activeRegion.Uptime</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="text-[9px] uppercase text-muted-foreground">Cap</span>
                    <span class="text-foreground">@_activeRegion.Capacity</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Region(
        string Id,
        string Code,
        string Name,
        string City,
        string LatencyP95,
        string Uptime,
        string Capacity,
        string Flag,
        string Status
    );

    private const int Total = 6;
    private const double AnglePerCard = 360.0 / Total;

    private static readonly Region[] _regions =
    [
        new("us-east",   "us-east-1",      "US East",      "Ashburn, Virginia",       "38 ms",  "99.998%", "84%", "US", "operational"),
        new("us-west",   "us-west-2",      "US West",      "Portland, Oregon",        "42 ms",  "99.996%", "71%", "US", "operational"),
        new("eu-central","eu-central-1",   "EU Central",   "Frankfurt, Germany",      "29 ms",  "99.999%", "62%", "DE", "operational"),
        new("ap-south",  "ap-southeast-1", "Asia Pacific", "Singapore",               "54 ms",  "99.992%", "89%", "SG", "degraded"),
        new("sa-east",   "sa-east-1",      "South America","São Paulo, Brazil",       "67 ms",  "99.994%", "58%", "BR", "operational"),
        new("af-south",  "af-south-1",     "Africa",       "Cape Town, South Africa", "82 ms",  "99.991%", "44%", "ZA", "operational"),
    ];

    private int _activeIndex = 0;

    private double _ringRotation => -_activeIndex * AnglePerCard;

    private Region _activeRegion => _regions[_activeIndex];

    private void Advance(int direction)
    {
        _activeIndex = (_activeIndex + direction + Total) % Total;
    }
}
