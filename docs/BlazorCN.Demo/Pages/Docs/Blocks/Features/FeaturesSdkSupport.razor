@* ============================================================
   Block: features-sdk-support
   Title: Features Sdk Support
   Description: SDK and programming language support matrix showing feature availability across different languages
   Long Description: Compliance certification matrix with status
   Dependencies: None
   Source: original/blocks/features/features-sdk-support.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
          <h2 class="text-sm font-medium">SDK Support Matrix</h2>
          <p class="mt-1 text-muted-foreground text-xs">
            Feature availability across programming languages
          </p>
        </div>

        <div class="overflow-x-auto">
          <div class="min-w-full">
            <div class="grid grid-cols-[200px_repeat(4,1fr)] border-b bg-muted/30">
              <div class="px-4 py-2.5">
                <span class="text-muted-foreground text-xs font-medium uppercase tracking-wide">
                  Feature
                </span>
              </div>
              @foreach (var lang in _languages)
              {
                <div class="border-l px-4 py-2.5 text-center">
                  <span class="text-muted-foreground text-xs font-medium uppercase tracking-wide">
                    @lang.Name
                  </span>
                </div>
              }
            </div>

            <div class="divide-y">
              @foreach (var feature in _features)
              {
                <div class="grid grid-cols-[200px_repeat(4,1fr)]">
                  <div class="px-4 py-2.5">
                    <span class="text-sm">@feature.Name</span>
                  </div>
                  @foreach (var lang in _languages)
                  {
                    var version = feature.Support.GetValueOrDefault(lang.Code, "\u2014");
                    var isSupported = version != "\u2014";
                    <div class="flex items-center justify-center border-l px-4 py-2.5">
                      <span class="@(Cn.Merge("font-mono text-xs tabular-nums", isSupported ? "text-foreground" : "text-muted-foreground"))">
                        @version
                      </span>
                    </div>
                  }
                </div>
              }
            </div>
          </div>
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
          <p class="text-muted-foreground text-xs">
            Version numbers reflect minimum required SDK version
          </p>
        </div>
      </div>
    </section>

@code {
    private record LanguageData(string Name, string Code);
    private record FeatureData(string Name, Dictionary<string, string> Support);

    private static readonly LanguageData[] _languages = new[]
    {
        new LanguageData("TypeScript", "ts"),
        new LanguageData("Python", "py"),
        new LanguageData("Go", "go"),
        new LanguageData("Ruby", "rb"),
    };

    private static readonly FeatureData[] _features = new[]
    {
        new FeatureData("Authentication", new Dictionary<string, string> { ["ts"] = "v3.2.0", ["py"] = "v2.8.0", ["go"] = "v1.5.0", ["rb"] = "v2.1.0" }),
        new FeatureData("File Upload", new Dictionary<string, string> { ["ts"] = "v3.1.0", ["py"] = "v2.7.0", ["go"] = "v1.4.0", ["rb"] = "\u2014" }),
        new FeatureData("Webhooks", new Dictionary<string, string> { ["ts"] = "v3.0.0", ["py"] = "v2.6.0", ["go"] = "v1.3.0", ["rb"] = "v2.0.0" }),
        new FeatureData("Streaming", new Dictionary<string, string> { ["ts"] = "v3.2.0", ["py"] = "v2.8.0", ["go"] = "\u2014", ["rb"] = "\u2014" }),
        new FeatureData("Batch Processing", new Dictionary<string, string> { ["ts"] = "v3.1.0", ["py"] = "v2.7.0", ["go"] = "v1.5.0", ["rb"] = "v2.1.0" }),
        new FeatureData("Real-time Updates", new Dictionary<string, string> { ["ts"] = "v3.2.0", ["py"] = "\u2014", ["go"] = "\u2014", ["rb"] = "\u2014" }),
        new FeatureData("Encryption", new Dictionary<string, string> { ["ts"] = "v3.0.0", ["py"] = "v2.6.0", ["go"] = "v1.4.0", ["rb"] = "v2.0.0" }),
    };
}
