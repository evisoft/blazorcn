@* ============================================================
   Block: features-pricing-tiers
   Title: Features Pricing Tiers
   Description: Feature comparison matrix showing which capabilities are available across pricing tiers
   Dependencies: TableCn
   Source: original/blocks/features/features-pricing-tiers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Feature Comparison</h2>
            <p class="mt-1 text-xs text-muted-foreground">Compare features across pricing tiers</p>
        </div>

        <div class="overflow-x-auto">
            <TableCn>
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-[50%]">Feature</TableHeadCn>
                        <TableHeadCn Class="text-center">Free</TableHeadCn>
                        <TableHeadCn Class="text-center">Pro</TableHeadCn>
                        <TableHeadCn Class="text-center">Enterprise</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var feature in _features)
                    {
                        <TableRowCn>
                            <TableCellCn Class="text-sm">@feature.Name</TableCellCn>
                            <TableCellCn Class="text-center">
                                @if (feature.Free)
                                {
                                    <LucideCheckCn Class="mx-auto h-4 w-4 text-emerald-500" Size="16" />
                                }
                                else
                                {
                                    <LucideMinusCn Class="mx-auto h-4 w-4 text-muted-foreground/30" Size="16" />
                                }
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                @if (feature.Pro)
                                {
                                    <LucideCheckCn Class="mx-auto h-4 w-4 text-emerald-500" Size="16" />
                                }
                                else
                                {
                                    <LucideMinusCn Class="mx-auto h-4 w-4 text-muted-foreground/30" Size="16" />
                                }
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                @if (feature.Enterprise)
                                {
                                    <LucideCheckCn Class="mx-auto h-4 w-4 text-emerald-500" Size="16" />
                                }
                                else
                                {
                                    <LucideMinusCn Class="mx-auto h-4 w-4 text-muted-foreground/30" Size="16" />
                                }
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>
    </div>
</section>

@code {
    private record Feature(string Name, bool Free, bool Pro, bool Enterprise);

    private static readonly Feature[] _features =
    [
        new("Unlimited projects", false, true, true),
        new("Advanced analytics", false, true, true),
        new("Custom domains", false, true, true),
        new("Team collaboration", false, false, true),
        new("SSO authentication", false, false, true),
        new("Priority support", false, false, true),
        new("SLA guarantee", false, false, true),
        new("Dedicated account manager", false, false, true),
        new("Custom integrations", false, false, true),
        new("Audit logs", false, false, true),
    ];
}
