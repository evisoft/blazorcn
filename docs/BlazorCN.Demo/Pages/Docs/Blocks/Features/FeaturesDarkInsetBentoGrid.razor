@* ============================================================
   Block: features-dark-inset-bento-grid
   Title: FeaturesDarkInsetBentoGrid
   Description: A dark inset bento grid feature section for React and Next.js with an inverted bg-foreground panel containing a centered headline and an asymmetric six-column bento grid of five feature cells with mixed col-span hero and supporting cells built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-dark-inset-bento-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10">

        @* Dark inset *@
        <div class="rounded-xl bg-foreground p-8 text-background sm:p-12">

            @* Centered header *@
            <div class="mx-auto max-w-2xl text-center">
                <p class="text-xs font-medium uppercase tracking-widest text-background/40">
                    @_headline.Eyebrow
                </p>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-background sm:text-4xl">
                    @_headline.Title
                </h2>
                <p class="mt-4 text-base leading-relaxed text-background/60">@_headline.Subtitle</p>
            </div>

            @* Bento grid *@
            <div class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:mt-12 lg:grid-cols-6">

                @* Hero cell — wide with chart mockup *@
                <article class="flex flex-col justify-between rounded-xl border border-background/10 bg-background/[0.05] p-6 sm:col-span-2 lg:col-span-4 lg:row-span-1">
                    <div>
                        <div class="flex items-center gap-2">
                            <span
                                aria-hidden="true"
                                class="flex size-9 items-center justify-center rounded-lg bg-background/10"
                            >
                                <LucideIconCn Name="activity" Size="16" Class="size-4 text-background/70" />
                            </span>
                            <span class="inline-flex items-center gap-1 rounded-full border border-background/15 bg-background/[0.04] px-2 py-0.5 font-mono text-[10px] text-background/60">
                                <span class="size-1 rounded-full bg-emerald-400"></span>
                                real-time
                            </span>
                        </div>
                        <h3 class="mt-4 text-lg font-semibold text-background">
                            Unified observability
                        </h3>
                        <p class="mt-2 max-w-md text-sm leading-relaxed text-background/60">
                            Traces, metrics, and logs from every primitive stream into a single timeline with
                            sub-second tail latency and 30 days of retention on the free tier.
                        </p>
                    </div>

                    @* Inline mini chart *@
                    <div
                        aria-hidden="true"
                        class="mt-6 rounded-lg border border-background/10 bg-background/[0.04] p-4"
                    >
                        <div class="mb-3 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <div class="h-1 w-16 rounded-full bg-background/15"></div>
                                <div class="h-1 w-10 rounded-full bg-background/10"></div>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <span class="font-mono text-[9px] text-background/40">p95</span>
                                <span class="font-mono text-[10px] font-semibold text-background/80">
                                    42ms
                                </span>
                            </div>
                        </div>
                        <div class="flex h-14 items-end gap-1">
                            @foreach (var bar in _heroChart)
                            {
                                <div
                                    class="flex-1 rounded-sm bg-background/25"
                                    style="@($"height:{bar}%")"
                                ></div>
                            }
                        </div>
                    </div>
                </article>

                @* Supporting feature cells *@
                @foreach (var feat in _features)
                {
                    <article class="@Cn.Merge("rounded-xl border border-background/10 bg-background/[0.05] p-5", feat.ColSpan)">
                        <span
                            aria-hidden="true"
                            class="flex size-9 items-center justify-center rounded-lg bg-background/10"
                        >
                            <LucideIconCn Name="@feat.IconName" Size="16" Class="size-4 text-background/70" />
                        </span>
                        <h3 class="mt-4 text-base font-semibold text-background">@feat.Title</h3>
                        <p class="mt-1.5 text-sm leading-relaxed text-background/60">
                            @feat.Description
                        </p>
                    </article>
                }

            </div>
        </div>

    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record BentoFeature(string Id, string IconName, string Title, string Description, string ColSpan);

    private static readonly HeadlineData _headline = new(
        "The platform",
        "Every primitive your team needs, in one runtime",
        "A cohesive stack of compute, storage, and observability primitives that speak the same protocol, share the same auth layer, and deploy from the same config file."
    );

    private static readonly int[] _heroChart = [38, 52, 44, 61, 48, 73, 66, 85, 72, 91];

    private static readonly BentoFeature[] _features =
    [
        new("edge-compute",    "zap",         "Edge compute",       "V8 isolates cold-start in under 30ms from 34 regions with automatic request routing to the nearest healthy node.",                              "lg:col-span-2"),
        new("managed-storage", "database",    "Managed Postgres",   "Point-in-time recovery, logical replication, and read replicas with a single psql-compatible connection string.",                               "lg:col-span-4"),
        new("git-deploys",     "git-branch",  "Git-native deploys", "Every branch gets a preview URL. Merges to main promote atomically with one audit log entry per rollout.",                                       "lg:col-span-3"),
        new("zero-trust",      "lock-keyhole","Zero-trust secrets",  "Scoped per environment, per team, per deploy — with SSO, SCIM, and hardware-key mTLS on every paid plan.",                                     "lg:col-span-3"),
    ];
}
