@* ============================================================
   Block: features-quadrant-plot-two-axis-map
   Title: FeaturesQuadrantPlotTwoAxisMap
   Description: A two-axis quadrant plot features section for React and Next.js with six plotted feature dots, click-to-select scatter interactions, dimmed neighbors, and a side detail panel built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-quadrant-plot-two-axis-map.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Headline cluster *@
    <div class="max-w-xl">
      <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
        Two axes, six features
      </span>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Power versus ease, plotted.
      </h2>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">
        Each workflow primitive sits on the map where its power and approachability meet. Click
        any dot to focus it — the neighbors recede and the sidebar tells its story.
      </p>
    </div>

    @* Chart + detail *@
    <div class="mt-10 grid gap-6 rounded-2xl border bg-card p-5 md:grid-cols-[1fr_240px] md:gap-8 md:p-6">
      @* Chart *@
      <div class="relative">
        <svg
          viewBox="@($"0 0 {ViewW} {ViewH}")"
          class="h-auto w-full"
          role="img"
          aria-labelledby="quadrant-plot-title"
        >
          <title id="quadrant-plot-title">
            @XAxisLabel versus @YAxisLabel feature positioning map
          </title>

          @* Plot background *@
          <rect
            x="@PaddingL"
            y="@PaddingT"
            width="@PlotW"
            height="@PlotH"
            class="fill-muted/40"
            rx="6"
          />

          @* Grid lines — quarters *@
          @foreach (var pct in new[] { 25, 50, 75 })
          {
            var gx = PaddingL + (pct / 100.0) * PlotW;
            var gy = PaddingT + (pct / 100.0) * PlotH;
            var isMid = pct == 50;
            <g>
              <line
                x1="@gx"
                y1="@PaddingT"
                x2="@gx"
                y2="@(PaddingT + PlotH)"
                class="@Cn.Merge("stroke-border", isMid ? "stroke-[1.25]" : "stroke-[0.5] opacity-60")"
                stroke-dasharray="@(isMid ? "0" : "3 3")"
              />
              <line
                x1="@PaddingL"
                y1="@gy"
                x2="@(PaddingL + PlotW)"
                y2="@gy"
                class="@Cn.Merge("stroke-border", isMid ? "stroke-[1.25]" : "stroke-[0.5] opacity-60")"
                stroke-dasharray="@(isMid ? "0" : "3 3")"
              />
            </g>
          }

          @* Quadrant labels *@
          <text
            x="@(PaddingL + 10)"
            y="@(PaddingT + 18)"
            class="fill-muted-foreground text-[10px] font-medium uppercase tracking-widest"
          >
            Visionaries
          </text>
          <text
            x="@(PaddingL + PlotW - 10)"
            y="@(PaddingT + 18)"
            text-anchor="end"
            class="fill-muted-foreground text-[10px] font-medium uppercase tracking-widest"
          >
            Leaders
          </text>
          <text
            x="@(PaddingL + 10)"
            y="@(PaddingT + PlotH - 10)"
            class="fill-muted-foreground text-[10px] font-medium uppercase tracking-widest"
          >
            Niche
          </text>
          <text
            x="@(PaddingL + PlotW - 10)"
            y="@(PaddingT + PlotH - 10)"
            text-anchor="end"
            class="fill-muted-foreground text-[10px] font-medium uppercase tracking-widest"
          >
            Challengers
          </text>

          @* Y-axis label — rotated *@
          <text
            x="14"
            y="@(PaddingT + PlotH / 2.0)"
            text-anchor="middle"
            transform="@($"rotate(-90, 14, {PaddingT + PlotH / 2.0})")"
            class="fill-foreground text-[11px] font-medium"
          >
            @YAxisLabel
          </text>

          @* Y axis ticks *@
          <text
            x="@(PaddingL - 8)"
            y="@(PaddingT + 6)"
            text-anchor="end"
            class="fill-muted-foreground font-mono text-[9px]"
          >
            high
          </text>
          <text
            x="@(PaddingL - 8)"
            y="@(PaddingT + PlotH - 2)"
            text-anchor="end"
            class="fill-muted-foreground font-mono text-[9px]"
          >
            low
          </text>

          @* X-axis label *@
          <text
            x="@(PaddingL + PlotW / 2.0)"
            y="@(ViewH - 12)"
            text-anchor="middle"
            class="fill-foreground text-[11px] font-medium"
          >
            @XAxisLabel
          </text>

          @* X axis ticks *@
          <text
            x="@PaddingL"
            y="@(PaddingT + PlotH + 16)"
            class="fill-muted-foreground font-mono text-[9px]"
          >
            low
          </text>
          <text
            x="@(PaddingL + PlotW)"
            y="@(PaddingT + PlotH + 16)"
            text-anchor="end"
            class="fill-muted-foreground font-mono text-[9px]"
          >
            high
          </text>

          @* Plotted dots *@
          @foreach (var feat in _features)
          {
            var f = feat;
            var cx = PaddingL + (f.X / 100.0) * PlotW;
            var cy = PaddingT + ((100.0 - f.Y) / 100.0) * PlotH;
            var isActive = f.Id == _activeId;
            var isHover = f.Id == _hoverId;
            var isDim = _activeId != f.Id && _hoverId != f.Id;
            var outerR = isActive ? 14 : (isHover ? 11 : 9);
            var innerR = isActive ? 6 : 4;
            var outerClass = isActive ? "fill-foreground/10 stroke-foreground" : "fill-background stroke-border";
            var innerClass = isActive ? "fill-foreground" : "fill-muted-foreground";
            var dotOpacity = isDim ? "0.45" : "1";
            var labelOpacity = isDim ? "0.5" : "1";
            var quadrantName = QuadrantFor(f.X, f.Y);
            <g>
              @* Invisible hit area for touch *@
              <circle
                cx="@cx"
                cy="@cy"
                r="18"
                class="cursor-pointer fill-transparent"
                @onclick="@(() => SetActive(f.Id))"
                @onmouseenter="@(() => _hoverId = f.Id)"
                @onmouseleave="@(() => _hoverId = null)"
                role="button"
                aria-label="@($"Select {f.Name}, in the {quadrantName} quadrant")"
                tabindex="0"
              />
              @* Dot outer ring *@
              <circle
                cx="@cx"
                cy="@cy"
                r="@outerR"
                class="@Cn.Merge("pointer-events-none", outerClass)"
                stroke-width="1.5"
                style="@($"opacity:{dotOpacity}")"
              />
              @* Dot center *@
              <circle
                cx="@cx"
                cy="@cy"
                r="@innerR"
                class="@Cn.Merge("pointer-events-none", innerClass)"
                style="@($"opacity:{dotOpacity}")"
              />
              @* Label below dot *@
              <text
                x="@cx"
                y="@(cy + 26)"
                text-anchor="middle"
                class="@Cn.Merge("pointer-events-none text-[10px] font-medium", isActive ? "fill-foreground" : "fill-muted-foreground")"
                style="@($"opacity:{labelOpacity}")"
              >
                @f.Name
              </text>
            </g>
          }
        </svg>
      </div>

      @* Detail panel *@
      @{ var active = _features.FirstOrDefault(f => f.Id == _activeId) ?? _features[0]; }
      @{ var activeQuadrant = QuadrantFor(active.X, active.Y); }
      <div class="flex flex-col gap-4 border-t pt-4 md:border-l md:border-t-0 md:pl-6 md:pt-0">
        <div>
          <div class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
            Focused
          </div>
          <div>
            <div class="mt-2 flex items-center gap-2">
              <span class="flex size-7 items-center justify-center rounded-md border bg-background">
                <LucideIconCn Name="@active.IconName" Size="14" Class="size-3.5 text-foreground" aria-hidden="true" />
              </span>
              <div>
                <div class="text-sm font-medium text-foreground">@active.Name</div>
                <div class="text-[10px] text-muted-foreground">
                  @active.Category
                </div>
              </div>
            </div>
            <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
              @active.Description
            </p>
          </div>
        </div>

        @* Coordinates + quadrant *@
        <div class="grid grid-cols-2 gap-3 rounded-lg border bg-muted/30 p-3">
          <div>
            <div class="text-[9px] font-medium uppercase tracking-wider text-muted-foreground">
              @XAxisLabel
            </div>
            <div class="mt-0.5 font-mono text-xs font-medium text-foreground tabular-nums">
              @active.X<span class="text-muted-foreground">/100</span>
            </div>
          </div>
          <div>
            <div class="text-[9px] font-medium uppercase tracking-wider text-muted-foreground">
              @YAxisLabel
            </div>
            <div class="mt-0.5 font-mono text-xs font-medium text-foreground tabular-nums">
              @active.Y<span class="text-muted-foreground">/100</span>
            </div>
          </div>
          <div class="col-span-2 border-t pt-2">
            <div class="text-[9px] font-medium uppercase tracking-wider text-muted-foreground">
              Quadrant
            </div>
            <div class="mt-0.5 text-xs font-medium capitalize text-foreground">
              @QuadrantLabel(activeQuadrant)
            </div>
          </div>
        </div>

        @* Metric *@
        <div class="mt-auto border-t pt-4">
          <div class="text-[9px] font-medium uppercase tracking-wider text-muted-foreground">
            @active.MetricLabel
          </div>
          <div class="mt-0.5 font-mono text-2xl font-semibold text-foreground tabular-nums">
            @active.MetricValue
          </div>
        </div>
      </div>
    </div>

    @* Footer chip row *@
    <div class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border bg-muted/30 px-4 py-3">
      <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
        Six primitives
      </span>
      <div class="flex flex-wrap items-center gap-1.5">
        @foreach (var feat in _features)
        {
          var f = feat;
          var isActive = f.Id == _activeId;
          <button
            type="button"
            @onclick="@(() => SetActive(f.Id))"
            class="@Cn.Merge(
              "rounded-full border px-2.5 py-0.5 text-[10px] font-medium transition-colors",
              isActive
                ? "border-foreground bg-foreground text-background"
                : "border-border bg-background text-muted-foreground hover:bg-muted"
            )"
          >
            @f.Name
          </button>
        }
      </div>
    </div>
  </div>
</section>

@code {
    private string _activeId = "actions";
    private string? _hoverId = null;

    private const string XAxisLabel = "Ease of use";
    private const string YAxisLabel = "Power";

    private const double PaddingL = 50;
    private const double PaddingR = 24;
    private const double PaddingT = 28;
    private const double PaddingB = 44;
    private const double ViewW = 560;
    private const double ViewH = 380;
    private const double PlotW = ViewW - PaddingL - PaddingR;
    private const double PlotH = ViewH - PaddingT - PaddingB;

    private void SetActive(string id)
    {
        _activeId = id;
    }

    private static string QuadrantFor(int x, int y)
    {
        if (x >= 50 && y >= 50) return "leaders";
        if (x < 50 && y >= 50) return "visionaries";
        if (x >= 50 && y < 50) return "challengers";
        return "niche";
    }

    private static string QuadrantLabel(string quadrant) => quadrant switch
    {
        "leaders" => "Leaders",
        "visionaries" => "Visionaries",
        "challengers" => "Challengers",
        _ => "Niche",
    };

    private record PlottedFeature(
        string Id,
        string Name,
        string Category,
        string Description,
        string IconName,
        int X,
        int Y,
        string MetricLabel,
        string MetricValue
    );

    private static readonly PlottedFeature[] _features =
    [
        new PlottedFeature(
            "triggers", "Triggers", "Ingress",
            "Webhooks, cron schedules, and event bus subscriptions with guaranteed at-least-once delivery and built-in deduplication. Declare a trigger in a single line and the platform handles retries, backoff, and dead-letter routing.",
            "zap", 82, 68, "Sources", "42"),
        new PlottedFeature(
            "filters", "Filters", "Selection",
            "Expression-based filtering with a small, auditable DSL that compiles to a JSON path plus typed predicates. Side-effect free, memoized per run, and composable without introducing new indirection.",
            "filter", 78, 42, "Ops", "24"),
        new PlottedFeature(
            "transforms", "Transforms", "Shaping",
            "Typed map and reduce functions that work on payloads of any shape. The compiler tracks provenance for every field so downstream consumers can always trace a value back to its source.",
            "shuffle", 58, 78, "Throughput", "1.2M/s"),
        new PlottedFeature(
            "actions", "Actions", "Egress",
            "Write to databases, HTTP endpoints, queues, and SaaS APIs with exponential backoff and idempotency keys. Every action is a named capability that you can swap between environments without code changes.",
            "sparkle", 72, 88, "Connectors", "186"),
        new PlottedFeature(
            "monitors", "Monitors", "Observability",
            "Alerting primitives built into the runtime. Define an SLO, a budget, and a window, and the platform derives the alert rules for you — including synthetic checks that exercise the full pipeline.",
            "activity", 42, 62, "Coverage", "98%"),
        new PlottedFeature(
            "governance", "Governance", "Policy",
            "Role-based access, policy-as-code, and tamper-evident audit logs for every workflow change. Every deploy is signed, every promotion leaves a trail, and every secret is scoped by intent.",
            "shield-check", 28, 82, "Policies", "74"),
    ];
}
