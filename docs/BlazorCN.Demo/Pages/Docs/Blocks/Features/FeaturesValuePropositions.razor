@* ============================================================
   Block: features-value-propositions
   Title: Features Value Propositions
   Description: A features block highlighting core value propositions with supporting features in a vertical layout
   Dependencies: None
   Source: original/blocks/features/features-value-propositions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Why Choose Us</h2>
            <p class="mt-1 text-xs text-muted-foreground">Core benefits that set us apart</p>
        </div>

        @for (var pi = 0; pi < _valueProps.Length; pi++)
        {
            var prop = _valueProps[pi];
            <div class="@(pi < _valueProps.Length - 1 ? "border-b" : "")">
                <div class="px-4 py-3">
                    <div class="flex items-center gap-2">
                        <span class="size-1.5 rounded-full bg-foreground"></span>
                        <h3 class="text-sm font-medium">@prop.Headline</h3>
                    </div>
                    <p class="mt-2 text-sm text-muted-foreground">@prop.Description</p>
                </div>
                <div>
                    @for (var pti = 0; pti < prop.Points.Length; pti++)
                    {
                        var point = prop.Points[pti];
                        <div class="@Cn.Merge("px-4 py-2.5", pti < prop.Points.Length - 1 ? "border-b border-muted/50" : "")">
                            <div class="flex items-start gap-3">
                                <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground"></span>
                                <p class="text-xs text-muted-foreground">@point</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record ValueProp(string Headline, string Description, string[] Points);

    private static readonly ValueProp[] _valueProps =
    [
        new("Ship Faster", "Reduce development time from months to days with pre-built components and automated workflows", [
            "Production-ready components that work out of the box",
            "Automated testing and deployment pipelines",
            "Real-time collaboration with instant preview environments",
        ]),
        new("Enterprise Security", "Bank-grade encryption and compliance frameworks that meet the highest industry standards", [
            "End-to-end encryption for data at rest and in transit",
            "SOC 2 Type II and ISO 27001 certified infrastructure",
            "Advanced threat detection with 24/7 monitoring",
            "Granular access controls and audit logging",
        ]),
        new("Infinite Scale", "Infrastructure that grows with you from prototype to millions of users without code changes", [
            "Auto-scaling that handles traffic spikes seamlessly",
            "Global CDN with edge caching in 200+ locations",
            "Database replication and automatic failover",
        ]),
    ];
}
