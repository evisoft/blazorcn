@* ============================================================
   Block: features-glossary-term-definition-grid
   Title: FeaturesGlossaryTermDefinitionGrid
   Description: A dictionary-style glossary grid features section for React and Next.js with serif terms, pronunciation guides, numbered definitions, and italic example sentences built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-glossary-term-definition-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <div class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1">
                <LucideIconCn Name="book-marked" Size="14" Class="size-3.5 text-muted-foreground" aria-hidden="true" />
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    The platform dictionary
                </p>
            </div>
            <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Say what you mean, precisely.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every concept in the platform has a proper definition. No marketing euphemisms, no
                ambiguous shorthand — just the words we agreed on.
            </p>
        </div>

        @* Glossary grid *@
        <div class="mt-12 grid grid-cols-1 gap-x-8 gap-y-8 md:grid-cols-2">
            @foreach (var letter in _sortedLetters)
            {
                var entries = _groups[letter];
                <div class="md:contents">
                    @* Alphabetical marker spans both columns on md *@
                    <div class="md:col-span-2">
                        <div class="flex items-center gap-4">
                            <h3 class="font-serif text-3xl font-semibold leading-none text-foreground">
                                @letter
                            </h3>
                            <div class="h-px flex-1 bg-border"></div>
                            <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground tabular-nums">
                                @(entries.Length) term@(entries.Length == 1 ? "" : "s")
                            </span>
                        </div>
                    </div>

                    @foreach (var entry in entries)
                    {
                        <div class="rounded-lg border-l-2 border-l-transparent pl-4 transition-colors hover:border-l-foreground">
                            <p class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                                <span class="font-serif text-xl font-bold leading-tight text-foreground">
                                    @entry.Term
                                </span>
                                <span class="font-mono text-xs text-muted-foreground">
                                    @entry.Pronunciation
                                </span>
                                <span class="font-serif text-xs italic text-muted-foreground">
                                    @entry.PartOfSpeech
                                </span>
                            </p>
                            <div class="mt-2">
                                <ol class="space-y-1.5">
                                    @for (var defIndex = 0; defIndex < entry.Definitions.Length; defIndex++)
                                    {
                                        var def = entry.Definitions[defIndex];
                                        var num = defIndex + 1;
                                        <li class="flex gap-2 text-sm leading-relaxed text-foreground">
                                            <span class="shrink-0 font-medium text-muted-foreground tabular-nums">
                                                @(num).
                                            </span>
                                            <span>@def</span>
                                        </li>
                                    }
                                </ol>
                                <p class="mt-3 border-l border-muted-foreground/30 pl-3 font-serif text-xs italic leading-relaxed text-muted-foreground">
                                    &ldquo;@entry.Example&rdquo;
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTA pair *@
        <div class="mt-12 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[280px]">Read the full glossary</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Suggest a term</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record GlossaryEntry(
        string Id,
        string Letter,
        string Term,
        string Pronunciation,
        string PartOfSpeech,
        string[] Definitions,
        string Example
    );

    private static readonly GlossaryEntry[] _glossary =
    [
        new("caching", "C", "Caching", "[ˈka-shiŋ]", "n.",
            [
                "The act of storing a computed response close to the user so that the next request avoids the origin entirely.",
                "A negotiated agreement between freshness and speed, usually governed by a tag or TTL.",
            ],
            "Tagged caching let the marketing page serve in under ten milliseconds worldwide."),
        new("deployment", "D", "Deployment", "[di-ˈplȯi-mənt]", "n.",
            [
                "The controlled promotion of an immutable build artifact from source to production traffic.",
                "A moment of trust between the team shipping code and the users receiving it.",
            ],
            "A green deployment is one that nobody on call ever has to think about."),
        new("encryption", "E", "Encryption", "[in-ˈkrip-shən]", "n.",
            [
                "The transformation of data into ciphertext so that only the intended recipient can recover it.",
                "A default, not a feature — applied at rest, in transit, and in backup without asking.",
            ],
            "End-to-end encryption makes the engineer on call as blind as the attacker."),
        new("failover", "F", "Failover", "[ˈfāl-ˌō-vər]", "n.",
            [
                "The automatic routing of traffic away from an unhealthy region toward a healthy one.",
                "A rehearsal the platform runs in production every single day.",
            ],
            "The us-east failover finished before the first Slack message landed."),
        new("observability", "O", "Observability", "[əb-ˌzər-və-ˈbi-lə-tē]", "n.",
            [
                "The property of a system that lets engineers answer questions they did not think to ask at build time.",
                "Logs, metrics, and traces stitched together around a shared request id.",
            ],
            "Good observability turns a midnight page into a five-minute fix."),
        new("scaling", "S", "Scaling", "[ˈskā-liŋ]", "v.",
            [
                "The act of adding capacity in response to demand, ideally before the user notices.",
                "A quiet art in which the best result is that nothing interesting happened.",
            ],
            "Autoscaling absorbed the Black Friday spike without a single deploy."),
    ];

    private static readonly Dictionary<string, GlossaryEntry[]> _groups =
        _glossary
            .GroupBy(e => e.Letter)
            .ToDictionary(g => g.Key, g => g.ToArray());

    private static readonly string[] _sortedLetters =
        _groups.Keys.OrderBy(k => k).ToArray();
}
