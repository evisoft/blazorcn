@* ============================================================
   Block: features-vs-competitor-comparison-table
   Title: FeaturesVsCompetitorComparisonTable
   Description: A vs competitor comparison table features section for React and Next.js with an 8-row 3-column feature parity table, brand versus competitor columns, and green check and red cross markers built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-vs-competitor-comparison-table.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10">
        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Compare
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                How we compare
            </h2>
            <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
                The features teams actually evaluate when they switch — side by side, every row with a
                verdict.
            </p>
        </div>

        @* Table *@
        <div class="mt-8 overflow-hidden rounded-xl border">
            <TableCn>
                <TableHeaderCn>
                    <TableRowCn Class="bg-muted/40 hover:bg-muted/40">
                        <TableHeadCn Class="h-12 px-5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                            Feature
                        </TableHeadCn>
                        <TableHeadCn Class="h-12 px-5 text-center text-sm font-semibold text-foreground">
                            @Brand
                        </TableHeadCn>
                        <TableHeadCn Class="h-12 px-5 text-center text-sm font-medium text-muted-foreground">
                            @Competitor
                        </TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var row in _comparisonRows)
                    {
                        <TableRowCn Class="border-b transition-colors last:border-b-0 hover:bg-muted/30">
                            <TableCellCn Class="px-5 py-4 text-sm font-medium text-foreground">
                                <span class="sr-only">
                                    @row.Feature: @Brand @DescribeCell(row.Us), @Competitor @DescribeCell(row.Them).
                                </span>
                                <span aria-hidden="true">@row.Feature</span>
                            </TableCellCn>
                            <TableCellCn Class="px-5 py-4 text-center text-sm">
                                @RenderUsCell(row.Us)
                            </TableCellCn>
                            <TableCellCn Class="px-5 py-4 text-center text-sm">
                                @RenderThemCell(row.Them)
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        @* Footnote *@
        <p class="mt-5 text-center text-xs text-muted-foreground">
            Compared against @Competitor Q1 2026 public pricing.
        </p>

        @* CTA row *@
        <div class="mt-7 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-center">
            <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">See pricing</ButtonCn>
        </div>
    </div>
</section>

@code {
    private const string Brand = "Meridian";
    private const string Competitor = "Parallax";

    private enum CellVariant { Check, Cross, Text }

    private record ComparisonCell(CellVariant Variant, string? Label = null);

    private record ComparisonRow(string Id, string Feature, ComparisonCell Us, ComparisonCell Them);

    private static readonly ComparisonRow[] _comparisonRows =
    [
        new("seats", "Team seats",
            new(CellVariant.Text, "Unlimited"),
            new(CellVariant.Text, "Up to 25")),
        new("sso", "SAML SSO on every plan",
            new(CellVariant.Check),
            new(CellVariant.Text, "Enterprise only")),
        new("rate-limits", "API rate limits",
            new(CellVariant.Text, "10k req/min"),
            new(CellVariant.Text, "1k req/min")),
        new("sla", "Uptime SLA",
            new(CellVariant.Text, "99.99%"),
            new(CellVariant.Text, "99.5%")),
        new("support", "24/7 priority support",
            new(CellVariant.Check),
            new(CellVariant.Cross)),
        new("residency", "EU + US data residency",
            new(CellVariant.Check),
            new(CellVariant.Text, "US only")),
        new("audit-log", "Audit log retention",
            new(CellVariant.Text, "7 years"),
            new(CellVariant.Text, "90 days")),
        new("scim", "SCIM provisioning",
            new(CellVariant.Check),
            new(CellVariant.Cross)),
    ];

    private static string DescribeCell(ComparisonCell cell) => cell.Variant switch
    {
        CellVariant.Check => "included",
        CellVariant.Cross => "not included",
        _ => cell.Label ?? ""
    };

    private RenderFragment RenderUsCell(ComparisonCell cell) => cell.Variant switch
    {
        CellVariant.Check => @<LucideIconCn Name="check" Size="20" Class="mx-auto size-5 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />,
        CellVariant.Cross => @<LucideIconCn Name="x" Size="20" Class="mx-auto size-5 stroke-[3] text-muted-foreground" aria-hidden="true" />,
        _ => @<span class="font-semibold text-foreground tabular-nums">@cell.Label</span>
    };

    private RenderFragment RenderThemCell(ComparisonCell cell) => cell.Variant switch
    {
        CellVariant.Check => @<LucideIconCn Name="check" Size="20" Class="mx-auto size-5 stroke-[3] text-muted-foreground" aria-hidden="true" />,
        CellVariant.Cross => @<LucideIconCn Name="x" Size="20" Class="mx-auto size-5 stroke-[3] text-red-500 dark:text-red-500" aria-hidden="true" />,
        _ => @<span class="text-muted-foreground tabular-nums">@cell.Label</span>
    };
}
