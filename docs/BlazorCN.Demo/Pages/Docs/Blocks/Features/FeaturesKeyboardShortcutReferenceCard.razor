@* ============================================================
   Block: features-keyboard-shortcut-reference-card
   Title: FeaturesKeyboardShortcutReferenceCard
   Description: A keyboard shortcut reference card features section for React and Next.js with a centered marketing headline, an eight-tile grid showing an icon action label and Kbd key badges per tile, and a footer with a See all shortcuts link plus ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-keyboard-shortcut-reference-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10">
        @* Headline cluster *@
        <div class="mx-auto max-w-xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_headline.Eyebrow
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_headline.Title
            </h2>
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>
        </div>

        @* Shortcut grid *@
        <div class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4">
            @foreach (var shortcut in _shortcuts)
            {
                <div class="flex flex-col items-center rounded-lg border bg-muted/30 p-4 text-center transition-colors hover:bg-muted/50">
                    <div aria-hidden="true" class="flex size-9 items-center justify-center rounded-lg bg-card text-muted-foreground shadow-sm ring-1 ring-border">
                        <LucideIconCn Name="@shortcut.IconName" Size="16" Class="size-4" />
                    </div>
                    <h3 class="mt-3 text-sm font-semibold text-foreground">@shortcut.Label</h3>
                    <p class="mt-0.5 text-[11px] text-muted-foreground">@shortcut.Description</p>
                    <div class="mt-3 flex items-center justify-center gap-1">
                        @for (var keyIdx = 0; keyIdx < shortcut.Keys.Length; keyIdx++)
                        {
                            var key = shortcut.Keys[keyIdx];
                            var idx = keyIdx;
                            <div class="flex items-center gap-1">
                                @if (idx > 0)
                                {
                                    <span class="text-[10px] text-muted-foreground/60">+</span>
                                }
                                <kbd class="inline-flex h-6 min-w-[24px] items-center justify-center rounded border border-border bg-background px-1.5 font-mono text-[11px] font-medium text-foreground">@key</kbd>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer row *@
        <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t pt-6 sm:flex-row">
            <a class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground" href="#all-shortcuts">
                <LucideIconCn Name="sparkles" Size="14" Class="size-3.5" />
                See all 40+ shortcuts
            </a>
            <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record ShortcutItem(string Id, string Label, string Description, string IconName, string[] Keys);

    private static readonly HeadlineData _headline = new(
        "Keyboard first",
        "Every action, one keystroke away",
        "Built by people who never touch the mouse. Here are eight of the forty-plus shortcuts shipped in every workspace."
    );

    private static readonly ShortcutItem[] _shortcuts =
    [
        new("command", "Command menu", "Run any action", "command", ["⌘", "K"]),
        new("switcher", "Quick switcher", "Jump to a file", "search", ["⌘", "P"]),
        new("new-file", "New file", "Create a blank doc", "file-plus", ["⌘", "N"]),
        new("find", "Find in file", "Search the buffer", "search", ["⌘", "F"]),
        new("git", "Git status", "Open the changes tab", "git-branch", ["⌘", "G"]),
        new("terminal", "Terminal", "Toggle the shell pane", "terminal", ["⌃", "`"]),
        new("settings", "Settings", "Open preferences", "settings", ["⌘", ","]),
        new("format", "Format document", "Run the formatter", "wand-sparkles", ["⇧", "⌥", "F"]),
    ];
}
