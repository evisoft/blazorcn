@* ============================================================
   Block: features-timeline-evolution-story
   Title: FeaturesTimelineEvolutionStory
   Description: A horizontal timeline evolution story features section for React and Next.js with five clickable year nodes along a top rail and a single detail card below that swaps with AnimatePresence built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-timeline-evolution-story.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                How we got here
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                Five years of compounding shipping
            </h2>
            <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                Every milestone removed a step from the daily loop. Pick a year to see what we shipped
                and how it moved the numbers.
            </p>
        </div>

        @* Horizontal timeline rail *@
        <div class="mt-10 px-2 sm:mt-12 sm:px-6">
            <div class="relative">
                @* Base rail *@
                <div aria-hidden="true" class="absolute top-5 right-0 left-0 h-px bg-border"></div>
                @* Progress line up to active *@
                <div
                    aria-hidden="true"
                    class="absolute top-5 left-0 h-px bg-foreground transition-all duration-[400ms] ease-out"
                    style="@($"width:{_progressPct}%")"
                ></div>

                @* Year nodes *@
                <div class="relative flex items-start justify-between">
                    @foreach (var milestone in _milestones)
                    {
                        var m = milestone;
                        var isActive = m.Year == _activeYear;
                        var isPast = Array.IndexOf(_milestones, m) < _activeIndex;
                        <button
                            aria-label="@($"View {m.Year} milestone")"
                            aria-pressed="@isActive.ToString().ToLower()"
                            class="group relative flex flex-col items-center gap-3 focus:outline-none"
                            type="button"
                            @onclick="@(() => SetActiveYear(m.Year))"
                        >
                            @* Node circle *@
                            <span class="@Cn.Merge("relative z-10 flex items-center justify-center rounded-full border bg-card transition-all duration-300", isActive ? "size-10 border-foreground ring-4 ring-foreground/10" : isPast ? "size-8 border-foreground/60 bg-foreground" : "size-8 border-border group-hover:border-foreground/50")">
                                @if (isActive)
                                {
                                    <span class="size-2 rounded-full bg-foreground"></span>
                                }
                                else if (isPast)
                                {
                                    <span class="size-1.5 rounded-full bg-background"></span>
                                }
                                else
                                {
                                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                                }
                            </span>

                            @* Year label *@
                            <span class="@Cn.Merge("text-xs font-semibold tabular-nums transition-colors sm:text-sm", isActive ? "text-foreground" : "text-muted-foreground group-hover:text-foreground")">
                                @m.Year
                            </span>
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Detail card *@
        <div class="mt-8 sm:mt-12">
            <div class="rounded-2xl border bg-card p-6 sm:p-10">
                <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-12">
                    @* Left: story *@
                    <div>
                        <div class="flex items-center gap-3">
                            <span class="flex size-11 items-center justify-center rounded-xl bg-muted">
                                <LucideIconCn Name="@_active.IconName" Size="20" Class="size-5 text-foreground" />
                            </span>
                            <div>
                                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                                    In @_active.Year we shipped
                                </p>
                                <h3 class="mt-0.5 text-xl font-semibold tracking-tight text-foreground sm:text-2xl">
                                    @_active.Title
                                </h3>
                            </div>
                        </div>
                        <p class="mt-5 text-sm leading-relaxed text-muted-foreground sm:text-base">
                            @_active.Story
                        </p>
                    </div>

                    @* Right: stat tile *@
                    <div class="rounded-xl border bg-muted/40 p-5 lg:w-56">
                        <p class="text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                            @_active.StatLabel
                        </p>
                        <div class="mt-3 flex items-baseline gap-2">
                            <span class="text-base font-medium text-muted-foreground line-through decoration-foreground/30">
                                @_active.StatBefore
                            </span>
                            <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground" />
                        </div>
                        <p class="mt-1 text-3xl font-bold tracking-tight text-foreground tabular-nums sm:text-4xl">
                            @_active.StatAfter
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Milestone(
        string Year,
        string IconName,
        string Title,
        string Story,
        string StatLabel,
        string StatBefore,
        string StatAfter
    );

    private static readonly Milestone[] _milestones =
    [
        new("2020", "git-branch",
            "Git-native CI, from day one",
            "We started with a radical bet: every build, test, and deploy should be driven by a commit, not a dashboard. No YAML hand-editing, no orchestration server, just a commit and a green check. The first version ran on a single box in a closet.",
            "Time to first green build", "22 min", "90 sec"),
        new("2021", "globe",
            "Preview environments on every pull request",
            "Reviewers kept asking teammates to clone branches locally just to see what a change looked like. We shipped ephemeral preview environments that boot in seconds so every PR carried its own live URL — the review comment that used to say 'LGTM' now says 'shipped'.",
            "PR review turnaround", "2.4 days", "3.1 hours"),
        new("2022", "layers",
            "Edge runtime across every region",
            "Cold starts on a traditional Node runtime were killing international traffic. We rewrote the execution layer around a V8 isolate pool that runs in 19 regions, so requests land on a worker in the same metro as the visitor. Latency became a solved problem.",
            "P95 cold-start latency", "680 ms", "12 ms"),
        new("2023", "sparkles",
            "Incremental builds that skip the unchanged",
            "Monorepos were rebuilding packages that nobody had touched in months. We shipped a content-addressable build cache that fingerprints every input and reuses results across machines, so the build only runs the parts that actually changed since the last commit.",
            "Full build wall time", "8 min", "45 sec"),
        new("2024", "code",
            "AI code review baked into the pipeline",
            "Reviewers were drowning in mechanical feedback — style, naming, dead imports. We added an in-pipeline reviewer that catches the boring stuff before a human ever opens the PR, so senior engineers spend their review budget on architecture, not semicolons.",
            "Mechanical review comments", "14 / PR", "0.3 / PR"),
    ];

    private string _activeYear = "2022";

    private int _activeIndex => Array.IndexOf(_milestones, _active);

    private Milestone _active => _milestones.First(m => m.Year == _activeYear);

    private double _progressPct => (_milestones.Length > 1)
        ? ((double)Array.IndexOf(_milestones, _active) / (_milestones.Length - 1)) * 100
        : 0;

    private void SetActiveYear(string year)
    {
        _activeYear = year;
    }
}
