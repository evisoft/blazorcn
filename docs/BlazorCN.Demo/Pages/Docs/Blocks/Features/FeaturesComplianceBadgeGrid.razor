@* ============================================================
   Block: features-compliance-badge-grid
   Title: FeaturesComplianceBadgeGrid
   Description: A compliance badge grid features section for React and Next.js with a 2x3 grid of certification seal cards each with a shield mark verified label and audit description built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-compliance-badge-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card p-8 sm:p-12">

        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_headline.Eyebrow
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_headline.Title
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>
        </div>

        @* Badge grid *@
        <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var badge in _badges)
            {
                <article class="flex flex-col items-center rounded-xl border bg-card p-6 text-center">

                    @* Shield seal *@
                    <div aria-hidden="true" class="relative flex size-14 items-center justify-center rounded-full bg-blue-500/10 ring-1 ring-inset ring-blue-500/20">
                        <LucideIconCn Name="shield-check" Size="28" Class="size-7 text-blue-600 dark:text-blue-500" />
                    </div>

                    <h3 class="mt-4 text-base font-semibold tracking-tight text-foreground">
                        @badge.Name
                    </h3>

                    @* Verified label *@
                    <span class="mt-2 inline-flex items-center gap-1 rounded-full border bg-muted/50 px-2 py-0.5 text-[11px] font-medium text-foreground">
                        <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                        Verified
                    </span>

                    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                        @badge.Description
                    </p>

                    <p class="mt-3 text-[11px] font-medium uppercase tracking-wider text-muted-foreground/70">
                        @badge.Scope
                    </p>

                </article>
            }
        </div>

        @* Compliance footer *@
        <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t pt-6 sm:flex-row sm:items-center">
            <p class="text-xs text-muted-foreground">
                Full audit reports and SOC 2 evidence available under NDA on request.
            </p>
            <a class="group inline-flex items-center gap-1.5 text-sm font-medium text-foreground hover:underline" href="#certifications">
                View all certifications
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
                    →
                </span>
            </a>
        </div>

    </div>
</section>

@code {
    private record Headline(string Eyebrow, string Title, string Subtitle);
    private record ComplianceBadge(string Id, string Name, string Description, string Scope);

    private static readonly Headline _headline = new(
        "Trust and compliance",
        "Enterprise-ready security",
        "Independently audited controls, transparent reporting, and the certifications your procurement team already knows by heart. Every badge below is backed by a full audit report available on request."
    );

    private static readonly ComplianceBadge[] _badges =
    [
        new("soc2", "SOC 2 Type II",
            "Annual third-party audit of security, availability, and confidentiality controls across the entire platform.",
            "Audited annually"),
        new("iso27001", "ISO 27001",
            "International standard for information security management systems, covering risk assessment and continuous improvement.",
            "Certified org-wide"),
        new("hipaa", "HIPAA",
            "Administrative, physical, and technical safeguards for handling protected health information for covered entities.",
            "BAA available"),
        new("gdpr", "GDPR",
            "Full compliance with EU data protection rules including data subject rights, breach notification, and DPO contact.",
            "EU region hosted"),
        new("ccpa", "CCPA",
            "California consumer privacy rights enforced including right to know, delete, and opt out of sale of personal data.",
            "US consumer rights"),
        new("pcidss", "PCI DSS",
            "Level 1 compliance for processing, storing, and transmitting cardholder data with quarterly network scans.",
            "Level 1 merchant"),
    ];
}
