@* ============================================================
   Block: features-stamped-number-card-grid
   Title: FeaturesStampedNumberCardGrid
   Description: A stamped number card grid feature section for React and Next.js with six cards in a 3-column layout each showing a large outlined number stamp behind title and description built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-stamped-number-card-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="rounded-2xl border bg-card p-6 sm:p-10">

    @* Header *@
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        @_headline.Eyebrow
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        @_headline.Title
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        @_headline.Subtitle
      </p>
    </div>

    @* Card grid *@
    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      @foreach (var feature in _features)
      {
        <article class="relative overflow-hidden rounded-xl border bg-card p-6">

          @* Stamped numeral *@
          <span aria-hidden="true"
                class="pointer-events-none absolute right-4 top-2 select-none text-5xl font-black leading-none tracking-tighter text-foreground/10">
            @feature.Stamp
          </span>

          @* Icon tag *@
          <div aria-hidden="true"
               class="relative flex size-9 items-center justify-center rounded-lg border bg-background">
            <LucideIconCn Name="@feature.Icon" Size="16" Class="size-4 text-foreground" />
          </div>

          @* Title + description *@
          <h3 class="relative mt-5 text-base font-semibold text-foreground">
            @feature.Title
          </h3>
          <p class="relative mt-2 text-sm leading-relaxed text-muted-foreground">
            @feature.Description
          </p>

        </article>
      }
    </div>

  </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureData(string Id, string Stamp, string Icon, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        Eyebrow: "The platform",
        Title: "Six pillars behind every shipped release",
        Subtitle: "A numbered tour of the capabilities teams reach for on day one and still rely on a year later."
    );

    private static readonly FeatureData[] _features =
    [
        new("workflow",     "01", "workflow",  "Unified workflows",
            "Replace a dozen disconnected tools with one surface where planning, shipping, and reviewing live side by side."),
        new("performance",  "02", "bolt",      "Sub-50ms response",
            "A local-first data layer keeps every interaction feeling instant, even on spotty airport wifi and older devices."),
        new("global",       "03", "globe",     "Global edge delivery",
            "Requests resolve at the nearest of 240 edge points so teams in Berlin and Buenos Aires share the same baseline."),
        new("security",     "04", "lock",      "Enterprise-grade security",
            "SOC 2 Type II, SAML SSO, SCIM provisioning, and per-tenant encryption keys are on every plan, not gated behind enterprise tiers."),
        new("composable",   "05", "layers",    "Composable building blocks",
            "Every primitive ships as a typed SDK so your team can drop features into existing apps without rewriting your stack."),
        new("intelligence", "06", "sparkles",  "Built-in intelligence",
            "Summaries, smart search, and suggested actions surface without an extra model bill or a separate vendor contract."),
    ];
}
