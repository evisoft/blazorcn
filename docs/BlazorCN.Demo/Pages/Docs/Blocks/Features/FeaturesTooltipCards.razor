@* ============================================================
   Block: features-tooltip-cards
   Title: Features Tooltip Cards
   Description: Feature grid with hover state revealing full descriptions and click to expand on mobile. Built with Next.js, React, shadcn/ui, and Tailwind CSS.
   Long Description: Sidebar navigation with detail panel
   Dependencies: None
   Source: original/blocks/features/features-tooltip-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
          <span class="font-medium text-sm">Platform Features</span>
          <p class="mt-0.5 text-muted-foreground text-xs">
            Hover or tap to learn more about each feature
          </p>
        </div>

        <div class="grid gap-3 p-4 sm:grid-cols-2 lg:grid-cols-3">
          @foreach (var feature in _features)
          {
            var isExpanded = _expandedId == feature.Id;
            var featureId = feature.Id;
            <button
              type="button"
              @onclick="@(() => _expandedId = isExpanded ? null : featureId)"
              class="@(Cn.Merge("group rounded-lg border p-4 text-left transition-all hover:bg-muted/50", isExpanded ? "bg-muted/50" : ""))"
            >
              <div class="mb-2 flex items-center gap-2">
                <span class="size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                <span class="text-muted-foreground text-xs">@feature.Category</span>
              </div>

              <div class="font-medium text-sm">@feature.Title</div>

              <div
                class="@(Cn.Merge(
                  "grid transition-all",
                  isExpanded
                    ? "mt-2 grid-rows-[1fr] opacity-100"
                    : "grid-rows-[0fr] opacity-0 sm:group-hover:mt-2 sm:group-hover:grid-rows-[1fr] sm:group-hover:opacity-100"
                ))"
              >
                <div class="overflow-hidden">
                  <p class="text-muted-foreground text-xs">@feature.Description</p>
                </div>
              </div>
            </button>
          }
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
          <div class="flex items-center justify-between text-xs">
            <span class="text-muted-foreground">@_features.Length features available</span>
            <button type="button" class="transition-colors hover:text-foreground">
              View all features
            </button>
          </div>
        </div>
      </div>
    </section>

@code {
    private string? _expandedId = null;

    private record FeatureData(string Id, string Title, string Description, string Category);

    private static readonly FeatureData[] _features = new[]
    {
        new FeatureData("templates", "Project templates", "Start quickly with pre-configured templates for common workflows and industry use cases", "Productivity"),
        new FeatureData("automation", "Smart automation", "Automate repetitive tasks with triggers, conditions, and actions that work together seamlessly", "Automation"),
        new FeatureData("reporting", "Custom reports", "Build and share custom reports with drag-and-drop visualization and scheduled delivery", "Analytics"),
        new FeatureData("collaboration", "Team collaboration", "Work together in real-time with comments, mentions, and activity feeds for every project", "Collaboration"),
        new FeatureData("integrations", "Third-party integrations", "Connect with 100+ tools including Slack, GitHub, Jira, and popular productivity apps", "Integration"),
        new FeatureData("mobile", "Mobile apps", "Access your work on iOS and Android with native apps designed for mobile productivity", "Mobile"),
        new FeatureData("security", "Enterprise security", "Bank-level encryption, SOC 2 compliance, and granular permission controls for your data", "Security"),
        new FeatureData("api", "Developer API", "Build custom integrations with our RESTful API and comprehensive SDK documentation", "Developer"),
        new FeatureData("backup", "Automatic backups", "Your data is automatically backed up every hour with point-in-time recovery options", "Reliability"),
    };
}
