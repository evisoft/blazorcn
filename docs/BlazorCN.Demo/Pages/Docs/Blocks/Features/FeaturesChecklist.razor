@* ============================================================
   Block: features-checklist
   Title: Features Checklist
   Description: Grouped feature checklist with category headers, ideal for product capabilities pages and comparison sections
   Dependencies: None
   Source: original/blocks/features/features-checklist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">What's Included</h2>
            <p class="mt-1 text-xs text-muted-foreground">Enterprise-grade features in every subscription</p>
        </div>

        @for (var ci = 0; ci < _categories.Length; ci++)
        {
            var category = _categories[ci];
            <div class="@(ci < _categories.Length - 1 ? "border-b" : "")">
                <div class="px-4 py-3">
                    <h3 class="text-xs font-medium text-muted-foreground">@category.Name</h3>
                </div>
                <div>
                    @for (var fi = 0; fi < category.Features.Length; fi++)
                    {
                        var feature = category.Features[fi];
                        <div class="@Cn.Merge("flex items-start gap-3 px-4 py-2", fi < category.Features.Length - 1 ? "border-b border-border/50" : "")">
                            <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                            <span class="text-sm">@feature</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record FeatureCategory(string Name, string[] Features);

    private static readonly FeatureCategory[] _categories =
    [
        new("Security", [
            "SOC 2 Type II compliance",
            "End-to-end encryption at rest and in transit",
            "Single sign-on with SAML 2.0",
            "Audit logs with 12-month retention",
            "Role-based access control",
            "IP allowlisting and geo-restrictions",
        ]),
        new("Performance", [
            "99.99% uptime SLA guarantee",
            "Global CDN with 200+ edge locations",
            "Sub-100ms API response times",
            "Automatic failover and redundancy",
            "Horizontal auto-scaling",
        ]),
        new("Integrations", [
            "REST and GraphQL APIs",
            "Native SDKs for 8 languages",
            "Zapier with 2,000+ app connections",
            "Webhooks with signature verification",
            "OAuth 2.0 and OpenID Connect",
            "Bi-directional Salesforce sync",
        ]),
        new("Developer Tools", [
            "Interactive API documentation",
            "Sandbox environments with test data",
            "CLI for local development",
            "TypeScript definitions included",
        ]),
    ];
}
