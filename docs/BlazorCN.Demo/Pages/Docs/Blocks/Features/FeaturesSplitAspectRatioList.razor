@* ============================================================
   Block: features-split-aspect-ratio-list
   Title: FeaturesSplitAspectRatioList
   Description: A split features section for React and Next.js with a tall portrait aspect 3 by 4 crosshair image placeholder beside an eyebrow, large headline, icon feature list, and dual ShadcnioButton CTA row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-split-aspect-ratio-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="grid items-center gap-10 lg:grid-cols-[5fr_7fr] lg:gap-14">

    @* Left — Tall portrait crosshair image placeholder *@
    <div class="order-1 lg:order-none">
      <div
        aria-hidden="true"
        class="relative flex aspect-[3/4] w-full items-center justify-center overflow-hidden rounded-2xl border bg-muted"
      >
        <div class="relative flex items-center justify-center">
          <div class="absolute size-32 rounded-full border border-muted-foreground/[0.06]"></div>
          <div class="absolute size-20 rounded-full border border-muted-foreground/[0.08]"></div>
          <div class="absolute h-px w-40 bg-muted-foreground/[0.06]"></div>
          <div class="absolute h-40 w-px bg-muted-foreground/[0.06]"></div>
          <div class="flex size-10 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
          </div>
        </div>
      </div>
    </div>

    @* Right — Headline, feature list, CTA row *@
    <div class="order-2 lg:order-none">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        @_headline.Eyebrow
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
        @_headline.Title
      </h2>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-muted-foreground">
        @_headline.Subtitle
      </p>

      <ul class="mt-9 space-y-6">
        @foreach (var feature in _features)
        {
          <li class="flex items-start gap-4">
            <span
              aria-hidden="true"
              class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted"
            >
              <LucideIconCn Name="@feature.IconName" Size="20" Class="size-5 text-muted-foreground" />
            </span>
            <div>
              <h3 class="text-base font-semibold text-foreground">@feature.Title</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                @feature.Description
              </p>
            </div>
          </li>
        }
      </ul>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">Read the docs</ButtonCn>
      </div>
    </div>

  </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureRow(string Id, string IconName, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        "Mobile-first",
        "Ship to every pocket without rewriting the stack",
        "A single codebase renders across every device your customers carry, with native feel on phones, tablets, and desktop sidebars alike."
    );

    private static readonly FeatureRow[] _features =
    [
        new("instant-load",    "zap",           "Instant cold start",
            "Edge-rendered shell hydrates in under 180 milliseconds so your first screen never feels like a loading spinner."),
        new("biometric-auth",  "lock",          "Biometric sign-in",
            "FaceID, TouchID, and passkey support out of the box with zero extra setup and no third-party identity provider."),
        new("offline-first",   "gauge",         "Offline-first sync",
            "Queued mutations replay automatically when the connection returns, so subway commutes never drop a single tap."),
        new("privacy-default", "shield-check",  "Privacy by default",
            "No tracking SDKs, no analytics pixels, and no third-party cookies ship with the client by default on every plan."),
    ];
}
