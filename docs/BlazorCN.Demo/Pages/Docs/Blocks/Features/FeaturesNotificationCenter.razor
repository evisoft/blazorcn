@* ============================================================
   Block: features-notification-center
   Title: Features Notification Center
   Description: Features styled as notification items with timestamp labels and recent-first ordering. Built with Next.js, React, shadcn/ui, and Tailwind CSS.
   Long Description: Feature rollout progress tracking
   Dependencies: None
   Source: original/blocks/features/features-notification-center.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
          <span class="font-medium text-sm">What's New</span>
          <p class="mt-0.5 text-muted-foreground text-xs">
            Latest features and improvements to the platform
          </p>
        </div>

        <div class="divide-y">
          @foreach (var notification in _notifications)
          {
            <div class="@(Cn.Merge("px-4 py-3 transition-colors", notification.IsNew ? "bg-muted/30" : ""))">
              <div class="mb-2 flex items-center gap-2">
                <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", GetCategoryColor(notification.Category)))"></span>
                <span class="text-muted-foreground text-xs">@notification.TimeLabel</span>
                @if (notification.IsNew)
                {
                  <span class="rounded bg-blue-500/10 px-1.5 py-0.5 font-medium text-blue-600 text-xs dark:text-blue-400">
                    New
                  </span>
                }
              </div>

              <div class="mb-1 font-medium text-sm">@notification.Title</div>
              <p class="text-muted-foreground text-xs">@notification.Description</p>

              <div class="mt-2">
                <span class="text-muted-foreground text-xs">
                  @GetCategoryLabel(notification.Category)
                </span>
              </div>
            </div>
          }
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
          <div class="flex items-center justify-between text-xs">
            <span class="text-muted-foreground">
              @(_notifications.Count(n => n.IsNew)) new updates this week
            </span>
            <button type="button" class="transition-colors hover:text-foreground">
              View all updates
            </button>
          </div>
        </div>
      </div>
    </section>

@code {
    private record NotificationData(string Title, string Description, string Category, string TimeLabel, bool IsNew);

    private static readonly NotificationData[] _notifications = new[]
    {
        new NotificationData("AI-Powered Search", "Natural language search across all your content", "feature", "2 hours ago", true),
        new NotificationData("Faster Builds", "Build times reduced by 40% with improved caching", "improvement", "Yesterday", true),
        new NotificationData("Team Dashboards", "Custom dashboards for team performance tracking", "feature", "3 days ago", false),
        new NotificationData("API Rate Limits", "Increased rate limits for Pro and Enterprise plans", "improvement", "1 week ago", false),
    };

    private static string GetCategoryColor(string category) => category switch
    {
        "feature" => "bg-blue-500",
        "improvement" => "bg-emerald-500",
        "fix" => "bg-amber-500",
        _ => "bg-gray-500",
    };

    private static string GetCategoryLabel(string category) => category switch
    {
        "feature" => "New Feature",
        "improvement" => "Improvement",
        "fix" => "Bug Fix",
        _ => category,
    };
}
