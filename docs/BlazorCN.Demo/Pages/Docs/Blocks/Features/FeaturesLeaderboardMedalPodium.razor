@* ============================================================
   Block: features-leaderboard-medal-podium
   Title: FeaturesLeaderboardMedalPodium
   Description: A leaderboard medal podium features section for React and Next.js with a three-tier Olympic podium, ranked scoreboard table, and trend arrows built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-leaderboard-medal-podium.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Headline *@
    <div class="text-center">
      <p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-muted-foreground">
        <LucideIconCn Name="trophy" Size="14" Class="size-3.5" aria-hidden="true" />
        Performance leaderboard
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        The features on the podium.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
        Ranked by real metrics from last quarter. No vanity numbers, no hand-picked wins — just
        the capabilities that moved the scoreboard.
      </p>
    </div>

    @* Podium *@
    <div class="mt-12 grid grid-cols-3 items-end gap-3 sm:gap-6">
      @foreach (var entry in _podium)
      {
        var podiumEntry = entry;
        var medal = _medalStyles[podiumEntry.Rank];
        var podiumHeight = _podiumHeights[podiumEntry.Rank];
        var romanNumeral = podiumEntry.Rank == 1 ? "I" : podiumEntry.Rank == 2 ? "II" : "III";
        <div class="flex flex-col items-center">
          @* Medal circle *@
          <div class="@Cn.Merge("flex size-12 items-center justify-center rounded-full font-bold ring-4 sm:size-14", medal.Bg, medal.Text, medal.Ring)">
            <span class="text-base sm:text-lg">@podiumEntry.Rank</span>
          </div>

          @* Label *@
          <h3 class="mt-4 line-clamp-2 text-center text-xs font-medium leading-snug text-foreground sm:text-sm">
            @podiumEntry.Feature
          </h3>
          <p class="mt-1 text-center text-xs tabular-nums text-muted-foreground sm:text-sm">
            @podiumEntry.Metric
          </p>

          @* Podium block *@
          <div class="@Cn.Merge("mt-3 flex w-full items-start justify-center rounded-t-md border-x border-t bg-muted/40 px-2 py-3", podiumHeight)">
            <span class="font-serif text-3xl font-bold tracking-tight text-muted-foreground/60 sm:text-4xl">
              @romanNumeral
            </span>
          </div>
        </div>
      }
    </div>

    @* Leaderboard table *@
    <div class="mt-10 overflow-hidden rounded-xl border bg-card">
      <div class="flex items-center justify-between border-b px-5 py-3">
        <div class="flex items-center gap-2">
          <LucideIconCn Name="medal" Size="16" Class="size-4 text-muted-foreground" aria-hidden="true" />
          <span class="text-sm font-medium text-foreground">Full standings</span>
        </div>
        <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
          Q1 · 2026
        </span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b bg-muted/30 text-left text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
              <th class="w-14 px-5 py-2.5">Rank</th>
              <th class="px-4 py-2.5">Feature</th>
              <th class="hidden px-4 py-2.5 text-right sm:table-cell">Delta</th>
              <th class="px-4 py-2.5 text-right">Metric</th>
              <th class="w-10 px-4 py-2.5 text-right">Trend</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var entry in _leaderboard)
            {
              var rowEntry = entry;
              var hasMedal = rowEntry.Rank <= 3;
              var rowMedal = hasMedal ? _medalStyles[rowEntry.Rank] : null;
              <tr class="border-b last:border-0 transition-colors hover:bg-muted/40">
                <td class="px-5 py-3">
                  <div class="flex items-center gap-2">
                    @if (hasMedal && rowMedal != null)
                    {
                      <span class="@Cn.Merge("flex size-6 items-center justify-center rounded-full text-xs font-bold", rowMedal.Bg, rowMedal.Text)">
                        @rowEntry.Rank
                      </span>
                    }
                    else
                    {
                      <span class="flex size-6 items-center justify-center text-xs font-medium tabular-nums text-muted-foreground">
                        @rowEntry.Rank
                      </span>
                    }
                  </div>
                </td>
                <td class="px-4 py-3 font-medium text-foreground">@rowEntry.Feature</td>
                <td class="hidden px-4 py-3 text-right tabular-nums text-muted-foreground sm:table-cell">@rowEntry.Delta</td>
                <td class="px-4 py-3 text-right font-medium tabular-nums text-foreground">@rowEntry.Metric</td>
                <td class="px-4 py-3 text-right">
                  @if (rowEntry.Trend == "up")
                  {
                    <span role="img" aria-label="rising" class="inline-flex items-center gap-1 text-emerald-600">
                      <LucideIconCn Name="arrow-up" Size="14" Class="size-3.5" aria-hidden="true" />
                    </span>
                  }
                  else if (rowEntry.Trend == "down")
                  {
                    <span role="img" aria-label="falling" class="inline-flex items-center gap-1 text-red-600">
                      <LucideIconCn Name="arrow-down" Size="14" Class="size-3.5" aria-hidden="true" />
                    </span>
                  }
                  else
                  {
                    <span role="img" aria-label="unchanged" class="inline-flex items-center gap-1 text-muted-foreground">
                      <LucideIconCn Name="minus" Size="14" Class="size-3.5" aria-hidden="true" />
                    </span>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>

    @* CTA *@
    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <ButtonCn Class="w-full sm:w-[240px]">See the benchmark</ButtonCn>
      <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">How we measure</ButtonCn>
    </div>
  </div>
</section>

@code {
    private record LeaderboardEntry(
        string Id,
        int Rank,
        string Feature,
        string Metric,
        string Delta,
        string Trend);

    private record MedalStyle(string Ring, string Bg, string Text, string Label);

    private static readonly LeaderboardEntry[] _leaderboard =
    [
        new("edge-cache",        1,  "Edge cache hit rate",    "94.2%",    "+3.1 pts",  "up"),
        new("cold-start",        2,  "Cold start latency",     "38 ms",    "-12 ms",    "up"),
        new("build-speed",       3,  "Incremental build time", "1.4 s",    "-0.6 s",    "up"),
        new("uptime",            4,  "Global uptime",          "99.98%",   "+0.02 pts", "up"),
        new("p95-response",      5,  "p95 response time",      "47 ms",    "-4 ms",     "up"),
        new("deploy-time",       6,  "Median deploy time",     "22 s",     "-3 s",      "up"),
        new("api-throughput",    7,  "API throughput",         "18.4k rps","+1.2k",     "up"),
        new("error-rate",        8,  "Error rate",             "0.012%",   "0.00 pts",  "flat"),
        new("time-to-first-byte",9,  "Time to first byte",     "88 ms",    "-2 ms",     "up"),
        new("bundle-size",       10, "Average bundle size",    "142 kB",   "+4 kB",     "down"),
    ];

    private static readonly Dictionary<int, MedalStyle> _medalStyles = new()
    {
        [1] = new("ring-amber-400/50",  "bg-amber-400",  "text-amber-950", "Gold"),
        [2] = new("ring-zinc-300/60",   "bg-zinc-300",   "text-zinc-900",  "Silver"),
        [3] = new("ring-orange-700/50", "bg-orange-700", "text-orange-50", "Bronze"),
    };

    private static readonly Dictionary<int, string> _podiumHeights = new()
    {
        [1] = "min-h-[180px]",
        [2] = "min-h-[130px]",
        [3] = "min-h-[100px]",
    };

    // Podium order: rank 2 (left), rank 1 (center), rank 3 (right)
    private LeaderboardEntry[] _podium = [];

    protected override void OnInitialized()
    {
        var ordered = new List<LeaderboardEntry>();
        var r2 = System.Array.Find(_leaderboard, e => e.Rank == 2);
        var r1 = System.Array.Find(_leaderboard, e => e.Rank == 1);
        var r3 = System.Array.Find(_leaderboard, e => e.Rank == 3);
        if (r2 != null) ordered.Add(r2);
        if (r1 != null) ordered.Add(r1);
        if (r3 != null) ordered.Add(r3);
        _podium = ordered.ToArray();
    }
}
