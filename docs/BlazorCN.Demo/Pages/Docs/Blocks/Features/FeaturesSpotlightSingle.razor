@* ============================================================
   Block: features-spotlight-single
   Title: Features Spotlight Single
   Description: Full-width spotlight section for one hero feature with inline metrics and testimonial
   Dependencies: None
   Source: original/blocks/features/features-spotlight-single.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Edge Network</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Deploy to the edge, instantly</p>
        </div>

        <div class="grid gap-4 p-4 md:grid-cols-2 md:gap-6">
            <div class="flex flex-col justify-between">
                <div>
                    <p class="text-sm leading-relaxed text-muted-foreground">
                        Your code runs within milliseconds of your users, across 300+ locations worldwide.
                        No configuration needed -- push your code and we handle the rest. Built on a
                        next-generation serverless runtime with automatic scaling and zero cold starts.
                    </p>

                    <div class="mt-4 grid grid-cols-3 gap-px overflow-hidden rounded-md border bg-border">
                        @foreach (var stat in _stats)
                        {
                            <div class="bg-card px-3 py-2 text-center">
                                <p class="text-sm font-semibold tabular-nums">@stat.Value</p>
                                <p class="text-xs text-muted-foreground">@stat.Label</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4 rounded-md bg-muted/50 p-3">
                    <p class="text-xs italic leading-relaxed text-muted-foreground">
                        &ldquo;Switching to edge deployment cut our p95 latency by 80%. Users in Asia and Europe now get the same snappy experience as those in the US.&rdquo;
                    </p>
                    <div class="mt-2">
                        <p class="text-xs font-medium">Sarah Chen</p>
                        <p class="text-xs text-muted-foreground">CTO at Streamline</p>
                    </div>
                </div>
            </div>

            <div class="flex aspect-[4/3] items-center justify-center rounded-md border bg-muted/50">
                <span class="text-xs text-muted-foreground/50">Product screenshot</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record Stat(string Value, string Label);

    private static readonly Stat[] _stats =
    [
        new("50ms", "Avg response time"),
        new("99.99%", "Uptime SLA"),
        new("300+", "Edge locations"),
    ];
}
