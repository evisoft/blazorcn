@* ============================================================
   Block: features-integration-directory
   Title: Features Integration Directory
   Description: A features block displaying available integrations in a connected grid layout
   Dependencies: None
   Source: original/blocks/features/features-integration-directory.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Available Integrations</h2>
            <p class="mt-1 text-xs text-muted-foreground">Connect with your favorite tools</p>
        </div>

        <div class="grid grid-cols-4 gap-px bg-border">
            @foreach (var integration in _integrations)
            {
                <div class="bg-card px-4 py-3 transition-colors hover:bg-muted/50">
                    <p class="text-sm font-medium">@integration.Name</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@integration.Category</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Integration(string Name, string Category);

    private static readonly Integration[] _integrations =
    [
        new("Stripe", "Payments"),
        new("Plaid", "Payments"),
        new("PayPal", "Payments"),
        new("Segment", "Analytics"),
        new("Mixpanel", "Analytics"),
        new("Amplitude", "Analytics"),
        new("Slack", "Communication"),
        new("Discord", "Communication"),
        new("Twilio", "Communication"),
        new("SendGrid", "Communication"),
        new("GitHub", "Development"),
        new("GitLab", "Development"),
        new("Vercel", "Development"),
        new("Netlify", "Development"),
        new("Mailchimp", "Marketing"),
        new("HubSpot", "Marketing"),
        new("Intercom", "Marketing"),
        new("Salesforce", "CRM"),
        new("Zendesk", "Support"),
        new("Jira", "Project"),
    ];
}
