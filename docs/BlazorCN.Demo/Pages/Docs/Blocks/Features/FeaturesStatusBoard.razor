@* ============================================================
   Block: features-status-board
   Title: Features Status Board
   Description: Feature availability dashboard showing rollout status with visual indicators and progress bars
   Long Description: Compliance certification matrix with status
   Dependencies: None
   Source: original/blocks/features/features-status-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Feature Availability</h2>
            <p class="mt-1 text-muted-foreground text-xs">
                Current rollout status and availability
            </p>
        </div>

        <div class="divide-y">
            @foreach (var feature in _features)
            {
                var color = GetStatusColor(feature.Status);
                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="text-sm font-medium">@feature.Name</div>
                            <div class="mt-0.5 text-muted-foreground text-xs">
                                @feature.Description
                            </div>
                        </div>
                        <div class="flex shrink-0 items-center gap-2">
                            <span class="@(Cn.Merge("size-1.5 rounded-full", color))"></span>
                            <span class="text-nowrap text-muted-foreground text-xs">
                                @GetStatusLabel(feature.Status)
                            </span>
                        </div>
                    </div>

                    @if (feature.Rollout > 0 && feature.Rollout < 100)
                    {
                        <div class="mt-2 flex items-center gap-2">
                            <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                                <div
                                    class="@(Cn.Merge("h-full transition-all", color))"
                                    style="@($"width: {feature.Rollout}%")">
                                </div>
                            </div>
                            <span class="text-muted-foreground text-xs tabular-nums">
                                @(feature.Rollout)%
                            </span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
            <p class="text-muted-foreground text-xs">
                Status updated daily &#x2022; Last check: 2 hours ago
            </p>
        </div>
    </div>
</section>

@code {
    private record Feature(string Name, string Description, string Status, int Rollout);

    private static string GetStatusColor(string status) => status switch
    {
        "ga" => "bg-emerald-500",
        "beta" => "bg-amber-500",
        "preview" => "bg-blue-500",
        "coming-soon" => "bg-muted-foreground/40",
        _ => "bg-muted-foreground/40",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "ga" => "Generally Available",
        "beta" => "Beta",
        "preview" => "Private Preview",
        "coming-soon" => "Coming Soon",
        _ => status,
    };

    private static readonly Feature[] _features =
    [
        new("Real-time Collaboration", "Multi-user editing with presence indicators", "ga", 100),
        new("Advanced Analytics", "Custom dashboards and data exports", "ga", 100),
        new("AI Code Completion", "Context-aware code suggestions", "beta", 75),
        new("Custom Workflows", "Build automation with visual editor", "beta", 60),
        new("SSO Enterprise", "SAML 2.0 and SCIM provisioning", "preview", 25),
        new("Edge Functions", "Serverless compute at the edge", "preview", 15),
        new("Mobile SDK", "Native iOS and Android libraries", "coming-soon", 0),
        new("Video Transcoding", "Automatic video format conversion", "coming-soon", 0),
    ];
}
