@* ============================================================
   Block: features-accordion-expandable
   Title: Features Accordion Expandable
   Description: Interactive accordion feature section with expandable descriptions and bullet points for product pages
   Dependencies: AccordionCn
   Source: original/blocks/features/features-accordion-expandable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Features</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Everything your team needs to create, manage, and deliver content at scale</p>
        </div>

        <div class="px-4">
            <AccordionCn>
                @for (var i = 0; i < _features.Length; i++)
                {
                    var feature = _features[i];
                    <AccordionItemCn DefaultOpen="@(i == 0)">
                        <AccordionTriggerCn Class="text-left text-sm">@feature.Title</AccordionTriggerCn>
                        <AccordionContentCn>
                            <p class="mb-3 text-xs leading-relaxed text-muted-foreground">@feature.Description</p>
                            <ul class="space-y-1.5">
                                @foreach (var bullet in feature.Bullets)
                                {
                                    <li class="flex items-center gap-2 text-xs">
                                        <span class="size-1 shrink-0 rounded-full bg-foreground/40"></span>
                                        @bullet
                                    </li>
                                }
                            </ul>
                        </AccordionContentCn>
                    </AccordionItemCn>
                }
            </AccordionCn>
        </div>
    </div>
</section>

@code {
    private record Feature(string Title, string Description, string[] Bullets);

    private static readonly Feature[] _features =
    [
        new("Intelligent Search", "Find any content across your workspace in milliseconds with full-text search, filters, and fuzzy matching.",
            ["Typo tolerance and fuzzy matching", "Search across 40+ file formats", "Saved searches with real-time alerts"]),
        new("Rich Content Editor", "A block-based editor for everything from notes to complex documents. Supports embeds, code blocks, and tables.",
            ["Slash commands for fast insertion", "Markdown shortcuts and keyboard-first UX", "Inline comments and suggestions"]),
        new("Multi-Channel Publishing", "Publish to your website, mobile app, and third-party platforms from a single source of truth.",
            ["REST API, GraphQL, and webhooks", "Localization for 60+ languages", "Scheduled publishing with timezone support"]),
        new("Content Analytics", "Track content performance across every channel with engagement metrics and conversion attribution.",
            ["Page-level and component-level analytics", "A/B testing for headlines and layouts", "Content freshness scoring"]),
        new("Governance & Workflows", "Enforce editorial standards with approval workflows, role-based permissions, and audit trails.",
            ["Multi-stage approval workflows", "Role-based access with field-level control", "Complete audit log for compliance"]),
    ];
}
