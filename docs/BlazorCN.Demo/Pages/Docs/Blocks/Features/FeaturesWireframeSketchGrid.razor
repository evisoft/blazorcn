@* ============================================================
   Block: features-wireframe-sketch-grid
   Title: FeaturesWireframeSketchGrid
   Description: A hand-drawn wireframe sketch grid features section for React and Next.js rendering four UI mockups with dashed sketchy borders, placeholder shapes, and handwritten captions, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-wireframe-sketch-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    <div class="mx-auto max-w-2xl text-center">
      <p class="inline-flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-muted-foreground">
        <LucideIconCn Name="pencil" Size="14" Class="size-3.5" />
        Sketched first
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Drawn before it was shipped.
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        Every screen started as a wireframe on a whiteboard. Here&apos;s a glimpse of the thinking
        behind the four flows users touch most.
      </p>
    </div>

    @* Wireframe grid *@
    <div class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2">
      @for (var i = 0; i < _wireframes.Length; i++)
      {
        var w = _wireframes[i];
        var stepNumber = (i + 1).ToString("D2");
        <div class="relative pt-5">
          @* Sketchy frame *@
          <div class="relative rounded-md border-2 border-dashed border-foreground/60 bg-background p-5 pt-6">
            @* Step number stamp — top-left inside the frame *@
            <span class="absolute left-4 top-3 font-mono text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
              Sketch / @stepNumber
            </span>

            <div class="mt-2 aspect-[10/7] w-full">
              @if (w.Type == "login")
              {
                <svg aria-hidden="true" viewBox="0 0 200 140" class="h-full w-full stroke-foreground/70" fill="none" stroke-width="1.4" stroke-linecap="round">
                  <title>Login wireframe</title>
                  <line x1="40" y1="24" x2="160" y2="24" stroke-width="2" />
                  <line x1="60" y1="32" x2="140" y2="32" stroke-dasharray="2 3" />
                  <rect x="40" y="50" width="120" height="14" rx="2" />
                  <line x1="48" y1="57" x2="100" y2="57" stroke-dasharray="2 2" />
                  <rect x="40" y="72" width="120" height="14" rx="2" />
                  <line x1="48" y1="79" x2="90" y2="79" stroke-dasharray="2 2" />
                  <rect x="40" y="96" width="120" height="14" rx="3" stroke-width="2" />
                  <line x1="86" y1="103" x2="114" y2="103" stroke-width="2" />
                  <circle cx="76" cy="124" r="5" />
                  <circle cx="100" cy="124" r="5" />
                  <circle cx="124" cy="124" r="5" />
                </svg>
              }
              else if (w.Type == "dashboard")
              {
                <svg aria-hidden="true" viewBox="0 0 200 140" class="h-full w-full stroke-foreground/70" fill="none" stroke-width="1.4" stroke-linecap="round">
                  <title>Dashboard wireframe</title>
                  <line x1="16" y1="18" x2="80" y2="18" stroke-width="2" />
                  <circle cx="184" cy="18" r="6" />
                  <rect x="16" y="36" width="52" height="30" rx="2" />
                  <line x1="22" y1="46" x2="44" y2="46" stroke-dasharray="2 2" />
                  <line x1="22" y1="56" x2="54" y2="56" stroke-width="2.5" />
                  <rect x="74" y="36" width="52" height="30" rx="2" />
                  <line x1="80" y1="46" x2="102" y2="46" stroke-dasharray="2 2" />
                  <line x1="80" y1="56" x2="112" y2="56" stroke-width="2.5" />
                  <rect x="132" y="36" width="52" height="30" rx="2" />
                  <line x1="138" y1="46" x2="160" y2="46" stroke-dasharray="2 2" />
                  <line x1="138" y1="56" x2="170" y2="56" stroke-width="2.5" />
                  <rect x="16" y="74" width="168" height="52" rx="2" />
                  <polyline points="24,116 44,96 64,104 84,82 104,90 124,72 144,86 164,66 180,78" stroke-width="1.8" />
                </svg>
              }
              else if (w.Type == "settings")
              {
                <svg aria-hidden="true" viewBox="0 0 200 140" class="h-full w-full stroke-foreground/70" fill="none" stroke-width="1.4" stroke-linecap="round">
                  <title>Settings wireframe</title>
                  <line x1="16" y1="20" x2="80" y2="20" stroke-width="2" />
                  <line x1="16" y1="28" x2="120" y2="28" stroke-dasharray="2 3" />
                  <line x1="16" y1="44" x2="184" y2="44" stroke-dasharray="2 2" />
                  <line x1="16" y1="54" x2="72" y2="54" stroke-width="2" />
                  <line x1="16" y1="62" x2="120" y2="62" stroke-dasharray="2 2" />
                  <rect x="156" y="52" width="28" height="14" rx="7" />
                  <circle cx="174" cy="59" r="5" />
                  <line x1="16" y1="78" x2="184" y2="78" stroke-dasharray="2 2" />
                  <line x1="16" y1="88" x2="84" y2="88" stroke-width="2" />
                  <line x1="16" y1="96" x2="110" y2="96" stroke-dasharray="2 2" />
                  <rect x="156" y="86" width="28" height="14" rx="7" />
                  <circle cx="166" cy="93" r="5" />
                  <line x1="16" y1="112" x2="184" y2="112" stroke-dasharray="2 2" />
                  <line x1="16" y1="122" x2="68" y2="122" stroke-width="2" />
                  <rect x="156" y="120" width="28" height="14" rx="7" />
                  <circle cx="174" cy="127" r="5" />
                </svg>
              }
              else
              {
                <svg aria-hidden="true" viewBox="0 0 200 140" class="h-full w-full stroke-foreground/70" fill="none" stroke-width="1.4" stroke-linecap="round">
                  <title>Onboarding wireframe</title>
                  <circle cx="40" cy="22" r="6" stroke-width="2" />
                  <line x1="46" y1="22" x2="94" y2="22" stroke-dasharray="2 3" />
                  <circle cx="100" cy="22" r="6" />
                  <line x1="106" y1="22" x2="154" y2="22" stroke-dasharray="2 3" />
                  <circle cx="160" cy="22" r="6" />
                  <line x1="40" y1="44" x2="160" y2="44" stroke-width="2" />
                  <line x1="60" y1="52" x2="140" y2="52" stroke-dasharray="2 3" />
                  <rect x="24" y="66" width="48" height="48" rx="3" />
                  <line x1="32" y1="104" x2="64" y2="104" stroke-dasharray="2 2" />
                  <circle cx="48" cy="84" r="8" />
                  <rect x="76" y="66" width="48" height="48" rx="3" stroke-width="2.2" />
                  <line x1="84" y1="104" x2="116" y2="104" stroke-dasharray="2 2" />
                  <polyline points="86,90 96,80 106,90 116,78" />
                  <rect x="128" y="66" width="48" height="48" rx="3" />
                  <line x1="136" y1="104" x2="168" y2="104" stroke-dasharray="2 2" />
                  <line x1="136" y1="78" x2="168" y2="78" />
                  <line x1="136" y1="86" x2="168" y2="86" />
                  <line x1="136" y1="94" x2="158" y2="94" />
                  <rect x="70" y="122" width="60" height="12" rx="3" stroke-width="2" />
                </svg>
              }
            </div>
          </div>

          @* Sticky-note annotation — hangs off the top-right corner *@
          <div class="pointer-events-none absolute -right-1 -top-1 flex items-start gap-1">
            <svg
              aria-hidden="true"
              viewBox="0 0 40 30"
              class="mt-3 size-8 shrink-0 stroke-foreground/55"
              fill="none"
              stroke-width="1.2"
              stroke-linecap="round"
            >
              <title>Annotation arrow</title>
              <path d="M38 4 Q 20 14, 6 20" stroke-dasharray="2 2" />
              <path d="M6 20 L 12 16" />
              <path d="M6 20 L 12 24" />
            </svg>
            <span class="max-w-[110px] rotate-[-2deg] rounded-sm border border-dashed border-foreground/30 bg-background px-2 py-1 font-serif text-[11px] italic leading-tight text-foreground/75 shadow-[2px_2px_0_0_rgba(0,0,0,0.04)] dark:shadow-[2px_2px_0_0_rgba(255,255,255,0.04)]">
              @w.Annotation
            </span>
          </div>

          @* Caption *@
          <div class="mt-4 pl-1">
            <h3 class="font-serif text-lg font-semibold italic tracking-tight">
              @w.Title
            </h3>
            <p class="mt-1 font-serif text-sm italic text-muted-foreground">
              &ldquo;@w.Caption&rdquo;
            </p>
          </div>
        </div>
      }
    </div>

    @* CTAs *@
    <div class="mt-12 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-center">
      <ButtonCn Class="w-full sm:w-[200px]">See the flows</ButtonCn>
      <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">Read the process</ButtonCn>
    </div>
  </div>
</section>

@code {
    private record WireframeItem(string Id, string Title, string Caption, string Annotation, string Type);

    private static readonly WireframeItem[] _wireframes =
    [
        new("login", "Login flow", "one tap, three providers, zero friction", "focus input on mount", "login"),
        new("dashboard", "Overview dashboard", "the metrics that matter, above the fold", "sparkline hover = scrub", "dashboard"),
        new("settings", "Team settings", "every toggle explains itself in plain English", "inline edit, no modals", "settings"),
        new("onboarding", "First-run onboarding", "pick a template, skip the blank page problem", "stepper, no back button lies", "onboarding"),
    ];
}
