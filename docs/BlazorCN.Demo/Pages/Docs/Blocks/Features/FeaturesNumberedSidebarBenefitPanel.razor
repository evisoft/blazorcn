@* ============================================================
   Block: features-numbered-sidebar-benefit-panel
   Title: FeaturesNumberedSidebarBenefitPanel
   Description: A numbered sidebar master-detail feature section for React and Next.js with 01 through 06 feature labels and a right-side detail panel showing an emerald CheckIcon benefit list built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-numbered-sidebar-benefit-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="border-b px-6 py-8 sm:px-10 sm:py-10">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Platform tour
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Six capabilities, picked in order
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground">
        Step through the platform from collaboration to developer API. Every stop tells you what
        it is, why it matters, and what you get out of the box.
      </p>
    </div>

    <div class="grid lg:grid-cols-[220px_1fr]">
      @* Left — numbered sidebar *@
      <nav aria-label="Platform features" class="border-b lg:border-b-0 lg:border-r">
        <ul class="flex flex-row overflow-x-auto lg:flex-col lg:overflow-visible">
          @foreach (var feature in _features)
          {
            var feat = feature;
            var isActive = feat.Id == _activeId;
            <li class="shrink-0 lg:shrink">
              <button
                type="button"
                aria-current="@(isActive ? "true" : null)"
                @onclick="@(() => _activeId = feat.Id)"
                class="@(Cn.Merge(
                  "group flex w-full items-center gap-3 px-5 py-4 text-left transition-colors lg:border-b lg:last:border-b-0",
                  isActive ? "bg-muted" : "bg-transparent hover:bg-muted/50"
                ))"
              >
                <span class="@(Cn.Merge(
                  "font-mono text-xs tabular-nums transition-colors",
                  isActive ? "text-foreground" : "text-muted-foreground"
                ))">
                  @feat.Number
                </span>
                <span class="@(Cn.Merge(
                  "text-sm font-medium transition-colors",
                  isActive ? "text-foreground" : "text-muted-foreground"
                ))">
                  @feat.Label
                </span>
                @if (isActive)
                {
                  <span aria-hidden="true" class="ml-auto hidden h-4 w-px bg-foreground lg:block"></span>
                }
              </button>
            </li>
          }
        </ul>
      </nav>

      @* Right — detail panel *@
      <div class="min-h-[360px] p-6 sm:p-10" aria-live="polite">
        @{ var active = _features.FirstOrDefault(f => f.Id == _activeId) ?? _features[0]; }
        <p class="font-mono text-xs text-muted-foreground">@active.Number / 06</p>
        <h3 class="mt-2 text-xl font-semibold tracking-tight text-foreground sm:text-2xl">
          @active.Title
        </h3>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground">
          @active.Description
        </p>
        <ul class="mt-8 space-y-3">
          @foreach (var benefit in active.Benefits)
          {
            <li class="flex items-start gap-3">
              <span aria-hidden="true" class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
              </span>
              <span class="text-sm leading-relaxed text-foreground">@benefit</span>
            </li>
          }
        </ul>
      </div>
    </div>
  </div>
</section>

@code {
    private string _activeId = "collaboration";

    private record FeatureItem(string Id, string Number, string Label, string Title, string Description, string[] Benefits);

    private static readonly FeatureItem[] _features =
    [
        new FeatureItem(
            "collaboration", "01", "Collaboration",
            "Ship together in a single shared workspace",
            "Every teammate sees the same state, same cursors, and same history. No more stale screenshots in Slack or conflicting branches that take a day to reconcile.",
            ["Live cursors and selections sync under 40ms", "Threaded comments pinned to any field or row", "Unlimited seats on every paid plan"]
        ),
        new FeatureItem(
            "security", "02", "Security",
            "Enterprise-grade controls without the enterprise tax",
            "SAML single sign-on, SCIM provisioning, row-level access policies, and SOC 2 Type II audit logs are available on every paid tier — no custom contract required.",
            ["SAML 2.0 and SCIM on every paid plan", "Field-level permissions with policy inheritance", "Immutable audit log retained for seven years"]
        ),
        new FeatureItem(
            "performance", "03", "Performance",
            "Local-first architecture keeps the UI instant",
            "A client-side data layer resolves reads from IndexedDB and streams writes in the background, so every click completes in under fifty milliseconds regardless of latency.",
            ["Sub-50ms interactions even on spotty networks", "Offline edits queue and sync on reconnect", "Performance budgets enforced in CI on every PR"]
        ),
        new FeatureItem(
            "automation", "04", "Automation",
            "Wire up workflows without writing glue code",
            "A visual rule builder compiles to deterministic server-side handlers. Triggers run on every event, with typed payloads, retries, and dead-letter queues handled for you.",
            ["Typed event payloads with schema validation", "Retry policies with exponential backoff", "Dead-letter queue for inspection and replay"]
        ),
        new FeatureItem(
            "analytics", "05", "Analytics",
            "Product telemetry without a separate warehouse",
            "Query any table with streaming SQL and render the results as charts inline. No export pipelines, no schema drift, no vendor waiting on a weekly refresh.",
            ["Streaming SQL over live production data", "Inline charts with one-click embed", "Materialized views auto-refresh in seconds"]
        ),
        new FeatureItem(
            "developer-api", "06", "Developer API",
            "A typed SDK that reads like your product",
            "Auto-generated TypeScript client updates on every schema change, with Zod runtime validators, JSDoc on every method, and a REPL playground scoped to your workspace.",
            ["Auto-generated TypeScript client per workspace", "Zod runtime validators shipped by default", "Scoped REPL for testing without a sandbox"]
        ),
    ];
}
