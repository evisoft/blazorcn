@* ============================================================
   Block: features-alternating-mockup-rows
   Title: FeaturesAlternatingMockupRows
   Description: An alternating image rows features section for React and Next.js with three zigzag rows each pairing text with a browser-chrome-style mockup placeholder URL bar three window buttons inline Learn more links and whileInView scroll reveals built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-alternating-mockup-rows.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    @* Section header *@
    <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Flagship features
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            Three capabilities your team reaches for daily
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted-foreground">
            Each feature earns its own row — a marketing headline, a paragraph of narrative, and a
            screenshot placeholder ready for the real UI to drop in.
        </p>
    </div>

    @* Alternating rows *@
    <div class="mt-16 space-y-16 sm:mt-20 sm:space-y-24">
        @for (var idx = 0; idx < _features.Length; idx++)
        {
            var feature = _features[idx];
            var imageLeft = idx % 2 == 1;
            var counter = $"0{idx + 1}";
            <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
                @* Text side *@
                <div class="@(imageLeft ? "lg:order-last" : "")">
                    <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                        @counter — Feature
                    </p>
                    <h3 class="mt-3 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
                        @feature.Title
                    </h3>
                    <p class="mt-4 max-w-lg text-base leading-relaxed text-muted-foreground">
                        @feature.Description
                    </p>
                    <a href="@feature.Href"
                       class="group mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground/20">
                        Learn more
                        <LucideIconCn Name="arrow-right" Size="16" Class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                    </a>
                </div>

                @* Browser-chrome mockup *@
                <div class="@(imageLeft ? "lg:order-first" : "")">
                    <div class="overflow-hidden rounded-xl border bg-card shadow-sm">
                        @* Chrome bar *@
                        <div class="flex items-center gap-2 border-b bg-muted/40 px-3 py-2.5">
                            <div class="flex items-center gap-1.5">
                                <span aria-hidden="true" class="size-2.5 rounded-full bg-muted-foreground/20"></span>
                                <span aria-hidden="true" class="size-2.5 rounded-full bg-muted-foreground/20"></span>
                                <span aria-hidden="true" class="size-2.5 rounded-full bg-muted-foreground/20"></span>
                            </div>
                            <div class="mx-auto flex min-w-0 items-center gap-1.5 rounded-md border bg-background px-2.5 py-1">
                                <span aria-hidden="true" class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                                <span class="truncate font-mono text-[11px] text-muted-foreground">
                                    @feature.MockupUrl
                                </span>
                            </div>
                            <div class="w-[52px] shrink-0" aria-hidden="true"></div>
                        </div>
                        @* Crosshair placeholder canvas *@
                        <div class="flex aspect-[4/3] w-full items-center justify-center bg-muted">
                            <div class="relative flex items-center justify-center">
                                <div aria-hidden="true" class="absolute size-28 rounded-full border border-muted-foreground/[0.06]"></div>
                                <div aria-hidden="true" class="absolute size-16 rounded-full border border-muted-foreground/[0.08]"></div>
                                <div aria-hidden="true" class="absolute h-px w-36 bg-muted-foreground/[0.06]"></div>
                                <div aria-hidden="true" class="absolute h-36 w-px bg-muted-foreground/[0.06]"></div>
                                <div class="flex size-9 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                                    <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" aria-hidden="true" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Feature(string Id, string Title, string Description, string Href, string MockupUrl);

    private static readonly Feature[] _features =
    [
        new("deploys",
            "Ship code without babysitting the deploy",
            "Every push triggers a preview URL in under 30 seconds with per-branch databases, seeded test data, and automatic teardown when the PR merges. Your team reviews product changes in staging that's identical to production, and broken deploys roll back the moment a health check fails.",
            "#deploys",
            "app.example.com/deployments"),
        new("observability",
            "Every request, traced end to end",
            "Structured logs, distributed traces, and real user metrics stream into a single query interface so you stop hopping between five dashboards to debug a slow request. Span-level latency, database explain plans, and user session replays sit on the same timeline — no instrumentation sprawl required.",
            "#observability",
            "app.example.com/traces"),
        new("collaborators",
            "Bring the whole team into the work",
            "Live cursors, threaded comments, and presence indicators turn solo workflows into a multiplayer canvas. Reviewers leave feedback directly on the component tree, stakeholders watch in realtime without a seat license, and every action is captured in a versioned history so nothing is ever lost.",
            "#collaborators",
            "app.example.com/workspace"),
    ];
}
