@* ============================================================
   Block: features-comparison-grid
   Title: Features Comparison Grid
   Description: Multi-product comparison grid with features down the side and products across the top. Built with Next.js, React, shadcn/ui, and Tailwind CSS.
   Long Description: SDK and language support matrix
   Dependencies: None
   Source: original/blocks/features/features-comparison-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
          <span class="font-medium text-sm">Plan Comparison</span>
          <p class="mt-0.5 text-muted-foreground text-xs">Compare features across all plans</p>
        </div>

        <div class="overflow-x-auto">
          <div class="min-w-[600px]">
            <div class="grid grid-cols-[2fr_repeat(4,1fr)] border-b">
              <div class="px-4 py-3"></div>
              @foreach (var product in _products)
              {
                <div class="@(Cn.Merge("border-l px-4 py-3 text-center", product.Highlight ? "bg-muted/30" : ""))">
                  <span class="font-medium text-sm">@product.Name</span>
                </div>
              }
            </div>

            <div class="divide-y">
              @{ var currentCategory = ""; }
              @foreach (var row in _featureRows)
              {
                var showCategory = row.Category != currentCategory;
                currentCategory = row.Category;

                <div>
                  @if (showCategory)
                  {
                    <div class="bg-muted/50 px-4 py-2">
                      <span class="font-medium text-muted-foreground text-xs">
                        @row.Category
                      </span>
                    </div>
                  }
                  <div class="grid grid-cols-[2fr_repeat(4,1fr)]">
                    <div class="px-4 py-3">
                      <span class="text-sm">@row.Name</span>
                    </div>
                    @{ var colIndex = 0; }
                    @foreach (var availability in row.Availability)
                    {
                      <div class="@(Cn.Merge("flex items-center justify-center border-l px-4 py-3", _products[colIndex].Highlight ? "bg-muted/30" : ""))">
                        <span class="@(Cn.Merge("text-sm", GetAvailabilityColor(availability)))">
                          @GetAvailabilitySymbol(availability)
                        </span>
                      </div>
                      colIndex++;
                    }
                  </div>
                </div>
              }
            </div>
          </div>
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
          <div class="flex items-center gap-4 text-xs">
            <div class="flex items-center gap-1.5">
              <span class="text-emerald-600 dark:text-emerald-400">&#x2713;</span>
              <span class="text-muted-foreground">Included</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-muted-foreground">Add-on</span>
              <span class="text-muted-foreground">Available as add-on</span>
            </div>
          </div>
        </div>
      </div>
    </section>

@code {
    private record ProductData(string Name, bool Highlight);
    private record FeatureRowData(string Category, string Name, string[] Availability);

    private static readonly ProductData[] _products = new[]
    {
        new ProductData("Free", false),
        new ProductData("Pro", true),
        new ProductData("Team", false),
        new ProductData("Enterprise", false),
    };

    private static readonly FeatureRowData[] _featureRows = new[]
    {
        new FeatureRowData("Core Features", "Project management", new[] { "included", "included", "included", "included" }),
        new FeatureRowData("Core Features", "Task automation", new[] { "not-available", "included", "included", "included" }),
        new FeatureRowData("Core Features", "Custom workflows", new[] { "not-available", "addon", "included", "included" }),
        new FeatureRowData("Collaboration", "Team workspaces", new[] { "not-available", "not-available", "included", "included" }),
        new FeatureRowData("Collaboration", "Real-time collaboration", new[] { "not-available", "not-available", "included", "included" }),
        new FeatureRowData("Collaboration", "Guest access", new[] { "not-available", "addon", "included", "included" }),
        new FeatureRowData("Integration", "API access", new[] { "not-available", "included", "included", "included" }),
        new FeatureRowData("Integration", "Webhooks", new[] { "not-available", "addon", "included", "included" }),
        new FeatureRowData("Integration", "SSO integration", new[] { "not-available", "not-available", "addon", "included" }),
        new FeatureRowData("Support", "Email support", new[] { "included", "included", "included", "included" }),
        new FeatureRowData("Support", "Priority support", new[] { "not-available", "not-available", "included", "included" }),
        new FeatureRowData("Support", "Dedicated account manager", new[] { "not-available", "not-available", "not-available", "included" }),
    };

    private static string GetAvailabilityColor(string availability) => availability switch
    {
        "included" => "text-emerald-600 dark:text-emerald-400",
        "addon" => "text-muted-foreground",
        _ => "text-muted-foreground/40",
    };

    private static string GetAvailabilitySymbol(string availability) => availability switch
    {
        "included" => "\u2713",
        "addon" => "Add-on",
        _ => "\u2014",
    };
}
