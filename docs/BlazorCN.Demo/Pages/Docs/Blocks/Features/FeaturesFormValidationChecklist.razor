@* ============================================================
   Block: features-form-validation-checklist
   Title: FeaturesFormValidationChecklist
   Description: A form validation features section for React and Next.js pairing a password creation form mockup with a live requirements checklist, strength meter, and semantic validation icons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-form-validation-checklist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-muted-foreground">
                <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                Safe by default
            </span>
            <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Security you can watch happen.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every password is validated against six rules in real time — no post-submit surprises,
                no guessing which requirement you missed.
            </p>
        </div>

        @* Validation card *@
        <div class="mt-10 overflow-hidden rounded-xl border bg-card shadow-sm">
            @* Card header *@
            <div class="flex items-center gap-3 border-b px-5 py-4">
                <span class="flex size-9 items-center justify-center rounded-md border bg-background">
                    <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-foreground" />
                </span>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium text-foreground">Create your account</div>
                    <div class="text-xs text-muted-foreground">
                        Pick a password that meets every rule on the right.
                    </div>
                </div>
            </div>

            @* Body: form + checklist *@
            <div class="grid grid-cols-1 gap-6 p-5 sm:grid-cols-2">
                @* Form fields *@
                <div class="space-y-4">
                    @foreach (var field in _fields)
                    {
                        <div>
                            <span class="mb-1.5 block text-xs font-medium text-foreground">
                                @field.Label
                            </span>
                            <div class="flex h-10 items-center rounded-md border bg-background px-3 font-mono text-sm text-muted-foreground">
                                @(field.Masked ? new string('•', field.Value.Length) : field.Value)
                            </div>
                        </div>
                    }
                </div>

                @* Checklist *@
                <div>
                    <div class="mb-3 flex items-center justify-between">
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                            Requirements
                        </span>
                        <span class="text-[11px] font-medium tabular-nums text-muted-foreground">
                            @_passedCount of @_totalCount met
                        </span>
                    </div>
                    <ul class="space-y-2.5">
                        @foreach (var rule in _rules)
                        {
                            <li aria-label="@(StatusWord(rule.State)): @rule.Label" class="flex items-center gap-2.5">
                                @if (rule.State == "passed")
                                {
                                    <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                        <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-500" />
                                    </span>
                                }
                                else if (rule.State == "failed")
                                {
                                    <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-amber-500/10">
                                        <LucideIconCn Name="x" Size="12" Class="size-3 text-amber-600 dark:text-amber-500" />
                                    </span>
                                }
                                else
                                {
                                    <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted">
                                        <LucideIconCn Name="circle" Size="10" Class="size-2.5 text-muted-foreground" />
                                    </span>
                                }
                                <span class="@Cn.Merge("text-xs", rule.State == "passed" ? "text-foreground line-through decoration-muted-foreground/40" : rule.State == "failed" ? "text-foreground" : "text-muted-foreground")">
                                    @rule.Label
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            @* Strength meter *@
            <div class="border-t bg-muted/30 px-5 py-4">
                <div class="flex items-center justify-between">
                    <span class="text-[11px] font-medium text-muted-foreground">
                        Password strength
                    </span>
                    <span class="@Cn.Merge("text-[11px] font-semibold tabular-nums", _strengthTone)">
                        @_strengthLabel
                    </span>
                </div>
                <div
                    role="progressbar"
                    aria-valuemin="0"
                    aria-valuemax="@_strengthSegments"
                    aria-valuenow="@_strengthLevel"
                    aria-label="@($"Password strength: {_strengthLabel}")"
                    class="mt-2 flex items-center gap-1.5">
                    @for (var i = 0; i < _strengthSegments; i++)
                    {
                        var idx = i;
                        var filled = idx < _strengthLevel;
                        <span class="@Cn.Merge("h-1.5 flex-1 origin-left rounded-full", filled ? _strengthToneBar : "bg-muted")"></span>
                    }
                </div>
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[210px]">Create account</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[250px]">View security docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record MockField(string Id, string Label, string Placeholder, string Value, bool Masked = false);
    private record ValidationRule(string Id, string Label, string State);

    private static readonly MockField[] _fields =
    [
        new("email", "Email address", "you@@company.com", "jordan@@linearly.app"),
        new("password", "Password", "Create a password", "Summer2026", true),
        new("confirm", "Confirm password", "Re-enter password", "Summer202", true),
    ];

    private static readonly ValidationRule[] _rules =
    [
        new("length", "At least 8 characters", "passed"),
        new("upper", "1 uppercase letter", "passed"),
        new("number", "1 number", "passed"),
        new("symbol", "1 special character", "failed"),
        new("match", "Matches confirmation", "failed"),
        new("common", "Not in common password list", "pending"),
    ];

    private static readonly int _passedCount = _rules.Count(r => r.State == "passed");
    private static readonly int _totalCount = _rules.Length;
    private const int _strengthSegments = 4;
    private static readonly int _strengthLevel = Math.Min(
        _strengthSegments,
        (int)Math.Ceiling((double)_passedCount / _totalCount * _strengthSegments));

    private static readonly string _strengthLabel =
        _strengthLevel <= 1 ? "Weak" :
        _strengthLevel == 2 ? "Fair" :
        _strengthLevel == 3 ? "Strong" : "Excellent";

    private static readonly string _strengthTone =
        _strengthLevel <= 1 ? "text-red-600 dark:text-red-500" :
        _strengthLevel == 2 ? "text-amber-600 dark:text-amber-500" :
        _strengthLevel == 3 ? "text-blue-600 dark:text-blue-500" :
        "text-emerald-600 dark:text-emerald-500";

    private static readonly string _strengthToneBar =
        _strengthLevel <= 1 ? "bg-red-500" :
        _strengthLevel == 2 ? "bg-amber-500" :
        _strengthLevel == 3 ? "bg-blue-500" : "bg-emerald-500";

    private static string StatusWord(string state) => state switch
    {
        "passed" => "Passed",
        "failed" => "Not yet",
        _ => "Checking",
    };
}
