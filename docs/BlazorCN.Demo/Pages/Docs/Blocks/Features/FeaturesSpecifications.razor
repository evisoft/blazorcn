@* ============================================================
   Block: features-specifications
   Title: Features Specifications
   Description: Technical specifications displayed as key-value pairs in a clean table format
   Dependencies: None
   Source: original/blocks/features/features-specifications.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Technical Specifications</h2>
            <p class="mt-1 text-xs text-muted-foreground">System limits and capabilities</p>
        </div>

        <div class="divide-y">
            @for (var i = 0; i < _specifications.Length; i++)
            {
                var spec = _specifications[i];
                <div class="@Cn.Merge("grid grid-cols-[1fr_auto] items-center gap-4 px-4 py-2.5", i % 2 == 0 ? "bg-muted/20" : "")">
                    <span class="text-sm">@spec.Name</span>
                    <span class="text-right text-sm font-medium tabular-nums">@spec.Value</span>
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
            <p class="text-xs text-muted-foreground">Specifications subject to change &bull; Last updated: March 2026</p>
        </div>
    </div>
</section>

@code {
    private record Specification(string Name, string Value);

    private static readonly Specification[] _specifications =
    [
        new("Max file size", "100 MB"),
        new("API rate limit", "1,000 requests/min"),
        new("Webhook timeout", "30 seconds"),
        new("Max batch size", "1,000 items"),
        new("Data retention", "90 days"),
        new("Concurrent connections", "100 per account"),
        new("Max team members", "Unlimited"),
        new("Storage quota", "1 TB per workspace"),
        new("Supported regions", "US, EU, APAC"),
        new("API version", "v2.1"),
        new("Response format", "JSON, XML"),
        new("Authentication", "OAuth 2.0, API key"),
    ];
}
