@* ============================================================
   Block: features-peek-drawer-hover-reveal-row
   Title: FeaturesPeekDrawerHoverRevealRow
   Description: A peek drawer hover reveal row features section for React and Next.js with four fixed-height support cards, hover-triggered slide-up drawers, and no layout reflow built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-peek-drawer-hover-reveal-row.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Headline cluster *@
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <div class="flex items-center gap-2">
          <span class="flex size-6 items-center justify-center rounded-md border bg-background">
            <LucideIconCn Name="life-buoy" Size="12" Class="size-3 text-muted-foreground" />
          </span>
          <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
            Support that scales with you
          </span>
        </div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
          Hover to peek, click to go deeper.
        </h2>
        <p class="mt-3 text-base leading-relaxed text-muted-foreground">
          Four ways to get help, one row that never reflows. Each card reveals its bullets and
          deep link as a drawer that slides up from the bottom — the row stays perfectly still.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">Compare plans</ButtonCn>
        <ButtonCn Class="w-full sm:w-[220px]">Contact support</ButtonCn>
      </div>
    </div>

    @* Card row *@
    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      @foreach (var card in _supportCards)
      {
        var c = card;
        var isHovered = _hoveredId == c.Id;
        <a
          href="@c.CtaHref"
          aria-label="@($"{c.Label}: {c.Headline}")"
          @onmouseenter="@(() => _hoveredId = c.Id)"
          @onmouseleave="@(() => { if (_hoveredId == c.Id) _hoveredId = null; })"
          @onfocus="@(() => _hoveredId = c.Id)"
          @onblur="@(() => { if (_hoveredId == c.Id) _hoveredId = null; })"
          style="height:280px"
          class="@Cn.Merge("group relative block overflow-hidden rounded-xl border bg-card transition-colors", isHovered ? "border-foreground/30" : "")"
        >
          @* Base content — always visible *@
          <div class="flex h-full flex-col gap-4 p-5">
            <div class="flex items-center justify-between">
              <span class="@Cn.Merge("flex size-9 items-center justify-center rounded-md border bg-background transition-colors", isHovered ? "border-foreground/40" : "")">
                <LucideIconCn Name="@c.IconName" Size="16" Class="size-4 text-foreground" />
              </span>
              <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                @c.Label
              </span>
            </div>

            <div>
              <h3 class="text-sm font-semibold leading-tight text-foreground">
                @c.Headline
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                @c.Summary
              </p>
            </div>

            <div class="mt-auto flex items-end justify-between gap-3">
              <div>
                <div class="text-[9px] font-medium uppercase tracking-wider text-muted-foreground">
                  @c.MetricLabel
                </div>
                <div class="mt-0.5 font-mono text-lg font-semibold text-foreground tabular-nums">
                  @c.MetricValue
                </div>
              </div>
              <span class="@Cn.Merge("flex items-center gap-1 text-[10px] font-medium text-muted-foreground transition-colors", isHovered ? "text-foreground" : "")">
                Peek
                <LucideIconCn Name="arrow-up-right" Size="12" Class="@Cn.Merge("size-3 transition-transform", isHovered ? "-translate-y-0.5 translate-x-0.5" : "")" />
              </span>
            </div>
          </div>

          @* Drawer — slides up from bottom *@
          <div
            style="@($"height:184px; transform: translateY({(isHovered ? "0%" : "100%")}); transition: transform 0.3s cubic-bezier(0.22,1,0.36,1); pointer-events:{(isHovered ? "auto" : "none")}")"
            class="pointer-events-none absolute inset-x-0 bottom-0 flex flex-col gap-3 border-t bg-background/95 p-5 backdrop-blur"
          >
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                What you get
              </span>
              <span class="flex items-center gap-1.5 font-mono text-[10px] text-emerald-600 dark:text-emerald-400">
                <span class="size-1 rounded-full bg-emerald-500"></span>
                live
              </span>
            </div>
            <ul class="space-y-1.5">
              @foreach (var bullet in c.Bullets)
              {
                <li class="flex items-start gap-2 text-[11px] leading-snug text-foreground">
                  <span class="mt-1 size-1 shrink-0 rounded-full bg-foreground/70"></span>
                  <span>@bullet</span>
                </li>
              }
            </ul>
            <div class="mt-auto flex items-center justify-between border-t pt-3">
              <span class="font-mono text-[10px] text-muted-foreground">
                @c.CtaHref
              </span>
              <span class="flex items-center gap-1 text-[11px] font-medium text-foreground">
                @c.CtaLabel
                <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3" />
              </span>
            </div>
          </div>
        </a>
      }
    </div>

    @* Footer strip *@
    <div class="mt-6 flex flex-col gap-3 rounded-lg border bg-muted/30 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-2">
        <LucideIconCn Name="headphones" Size="14" Class="size-3.5 text-muted-foreground" />
        <span class="text-xs text-muted-foreground">
          Average first response across all channels: under 2 minutes.
        </span>
      </div>
      <div class="flex items-center gap-3 font-mono text-[10px] text-muted-foreground">
        <span class="flex items-center gap-1.5">
          <span class="size-1.5 rounded-full bg-emerald-500"></span>
          Docs, chat, and priority online
        </span>
      </div>
    </div>
  </div>
</section>

@code {
    private record SupportCard(
        string Id,
        string IconName,
        string Label,
        string Headline,
        string Summary,
        string[] Bullets,
        string MetricLabel,
        string MetricValue,
        string CtaLabel,
        string CtaHref
    );

    private string? _hoveredId;

    private static readonly SupportCard[] _supportCards =
    [
        new("docs", "book-open", "Self-serve",
            "Docs written by the team that ships the code",
            "Searchable guides that update the same day a feature goes out — no waiting for a content sprint.",
            ["Docs versioned with every release", "Code samples linted against the SDK", "Inline 'was this helpful' feedback"],
            "Avg answer time", "18 s", "Open the docs", "#docs"),
        new("chat", "message-square-text", "Live chat",
            "Live chat with humans, not a triage bot",
            "A real support engineer picks up within a minute and stays with you until the ticket is closed.",
            ["First response under 60 seconds", "Zero handoffs between tiers", "Transcripts exported to your inbox"],
            "Median first reply", "42 s", "Start a conversation", "#chat"),
        new("community", "users", "Community",
            "A community forum moderated by the founders",
            "Post a question and the answer usually comes from someone who built the feature you are asking about.",
            ["Founders answer every top-level thread", "Weekly AMA with the eng team", "Accepted answers promoted into docs"],
            "Members active", "8.2 K", "Join the forum", "#community"),
        new("priority", "headphones", "Priority",
            "Priority support with a dedicated engineer",
            "Enterprise plans get a named contact, a shared Slack channel, and guaranteed response windows.",
            ["Named engineer on your account", "Shared Slack Connect channel", "99.9% SLA on first response"],
            "SLA response", "< 15 m", "Talk to sales", "#priority"),
    ];
}
