@* ============================================================
   Block: features-sticky-note-wall-grid
   Title: FeaturesStickyNoteWallGrid
   Description: A sticky note wall features section for React and Next.js with cork-board dotted background, rotated amber notes, pushpin markers, and handwritten-style titles built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-sticky-note-wall-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Headline cluster *@
    <div class="text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-muted-foreground">
        <LucideIconCn Name="sticky-note" Size="12" Class="size-3" aria-hidden="true" />
        Cork-board ready
      </span>
      <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        A wall where every idea sticks.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
        Six features, six sticky notes — pinned to the same board your team already thinks on.
        No toolbars, no panels, just the ideas themselves.
      </p>
    </div>

    @* Cork board *@
    <div
      class="relative mt-12 rounded-xl border bg-muted/40 p-8 sm:p-10"
      style="background-image:radial-gradient(circle, var(--border) 1px, transparent 1px);background-size:14px 14px;">
      <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 sm:gap-8">
        @foreach (var note in _notes)
        {
          <article class="@Cn.Merge("relative aspect-square rounded-sm bg-amber-100 p-4 shadow-md hover:-translate-y-0.5 hover:rotate-0 dark:bg-amber-950/40 transition-transform", note.Rotation)">
            @* Pushpin *@
            <div
              aria-hidden="true"
              class="absolute left-1/2 top-0 flex size-4 -translate-x-1/2 -translate-y-1.5 items-center justify-center">
              <div class="size-3 rounded-full bg-red-500 shadow-sm ring-2 ring-red-700/40"></div>
            </div>

            @* Icon *@
            <div class="flex items-center justify-between">
              <LucideIconCn Name="@note.IconName" Size="16" Class="size-4 text-amber-900 dark:text-amber-200" aria-hidden="true" />
              <span class="font-mono text-[9px] font-semibold uppercase tracking-wider text-amber-900/60 dark:text-amber-200/60">
                @note.Author
              </span>
            </div>

            @* Title + body *@
            <h3 class="mt-3 font-serif text-sm font-semibold leading-tight text-amber-950 dark:text-amber-100">
              @note.Title
            </h3>
            <p class="mt-1.5 font-serif text-[11px] leading-snug text-amber-900/80 dark:text-amber-200/70">
              @note.Body
            </p>
          </article>
        }
      </div>
    </div>

    @* CTAs *@
    <div class="mt-12 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <ButtonCn Class="w-full sm:w-[200px]">Start a board</ButtonCn>
      <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
        See example wall
      </ButtonCn>
    </div>
  </div>
</section>

@code {
  private record StickyNote(string Id, string IconName, string Title, string Body, string Author, string Rotation);

  private static readonly StickyNote[] _notes =
  [
    new("standup",  "users",          "Daily standups",      "Async updates that auto-summarize into a single Monday recap.",              "JM", "-rotate-2"),
    new("spark",    "lightbulb",      "Idea capture",        "Pin a thought in 3 seconds — voice, text, or Slack thread.",                "AR", "rotate-1"),
    new("ship",     "rocket",         "Ship tracking",       "Every launch pinned to the wall so the team sees what's live.",             "KL", "rotate-2"),
    new("focus",    "target",         "Weekly focus",        "Three priorities, always visible, never drifting.",                         "SM", "-rotate-1"),
    new("chat",     "message-square", "Threaded replies",    "Add comments right on the note without opening a side panel.",              "DV", "rotate-[1.5deg]"),
    new("automate", "zap",            "Quick automations",   "Turn any note into a recurring task with one click.",                       "TN", "rotate-[1.5deg]"),
  ];
}
