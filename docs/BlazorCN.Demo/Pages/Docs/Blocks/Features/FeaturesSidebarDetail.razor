@* ============================================================
   Block: features-sidebar-detail
   Title: Features Sidebar Detail
   Description: Vertical tab list with detail panel showing full feature descriptions. Built with Next.js, React, shadcn/ui, and Tailwind CSS.
   Long Description: Horizontal tab feature showcase
   Dependencies: None
   Source: original/blocks/features/features-sidebar-detail.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
          <span class="font-medium text-sm">Platform Features</span>
          <p class="mt-0.5 text-muted-foreground text-xs">
            Explore detailed documentation for each feature
          </p>
        </div>

        <div class="grid md:grid-cols-[200px_1fr]">
          <div class="border-b border-r md:border-b-0">
            <nav class="divide-y">
              @foreach (var feature in _features)
              {
                <button
                  type="button"
                  @onclick="@(() => _activeFeatureId = feature.Id)"
                  class="@(Cn.Merge(
                    "w-full px-4 py-3 text-left transition-colors",
                    _activeFeatureId == feature.Id ? "bg-muted/50" : "hover:bg-muted/30"
                  ))"
                >
                  <div class="text-sm">@feature.Title</div>
                  <div class="mt-0.5 text-muted-foreground text-xs">@feature.Category</div>
                </button>
              }
            </nav>
          </div>

          <div class="p-4">
            @{ var activeFeature = _features.FirstOrDefault(f => f.Id == _activeFeatureId); }
            @if (activeFeature != null)
            {
              <div>
                <div class="mb-3">
                  <div class="mb-1 font-medium text-sm">@activeFeature.Title</div>
                  <p class="text-muted-foreground text-xs">@activeFeature.Description</p>
                </div>

                <div class="space-y-2">
                  @foreach (var detail in activeFeature.Details)
                  {
                    <div class="flex gap-2">
                      <span class="mt-1.5 size-1 shrink-0 rounded-full bg-foreground/40"></span>
                      <span class="text-sm">@detail</span>
                    </div>
                  }
                </div>

                <div class="mt-4">
                  <button type="button" class="text-xs transition-colors hover:text-foreground">
                    Read full documentation &#x2192;
                  </button>
                </div>
              </div>
            }
          </div>
        </div>
      </div>
    </section>

@code {
    private string _activeFeatureId = "issue-tracking";

    private record FeatureData(string Id, string Title, string Category, string Description, string[] Details);

    private static readonly FeatureData[] _features = new[]
    {
        new FeatureData("issue-tracking", "Issue Tracking", "Planning", "Create, assign, and track issues with custom workflows.", new[] { "Custom fields and labels", "Sub-issues and dependencies", "Automated workflow rules", "Priority and status tracking" }),
        new FeatureData("ci-cd", "CI/CD Pipelines", "Development", "Automated build, test, and deployment workflows.", new[] { "Parallel test execution", "Multi-environment deploys", "Rollback capabilities", "Build artifact caching" }),
        new FeatureData("analytics", "Analytics", "Insights", "Real-time metrics and team performance insights.", new[] { "Cycle time tracking", "Throughput metrics", "Custom dashboards", "Export capabilities" }),
        new FeatureData("security", "Security", "Compliance", "Enterprise-grade security and access control.", new[] { "Role-based access control", "SSO integration", "Audit logs", "Data encryption" }),
    };
}
