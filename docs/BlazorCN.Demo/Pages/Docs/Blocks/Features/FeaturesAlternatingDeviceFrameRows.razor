@* ============================================================
   Block: features-alternating-device-frame-rows
   Title: FeaturesAlternatingDeviceFrameRows
   Description: An alternating feature rows features section for React and Next.js with a phone device frame mockup on the image side and a compact benefit bullet list on the text side built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-alternating-device-frame-rows.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-14">

        @* Section headline *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Built for mobile
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                Three flagship capabilities, engineered for the smallest screen first
            </h2>
            <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                Every feature below ships as a native-feeling mobile experience before it ever lands on
                the web — because that's where our users actually live.
            </p>
        </div>

        @* Alternating rows *@
        <div class="mt-14 space-y-16 sm:mt-16 sm:space-y-20">
            @for (var i = 0; i < _rows.Length; i++)
            {
                var row = _rows[i];
                var isReversed = i % 2 == 1;
                <article class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">

                    @* Text side *@
                    <div class="@(isReversed ? "lg:order-last" : "")">
                        <span class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-foreground">
                            <LucideIconCn Name="@row.IconName" Size="14" Class="size-3.5 text-muted-foreground" />
                            @row.Eyebrow
                        </span>
                        <h3 class="mt-4 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
                            @row.Title
                        </h3>
                        <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:text-base">
                            @row.Description
                        </p>
                        <ul class="mt-5 space-y-2.5">
                            @foreach (var bullet in row.Bullets)
                            {
                                <li class="flex items-start gap-2.5">
                                    <span aria-hidden="true" class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                        <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                    </span>
                                    <span class="text-sm text-muted-foreground">@bullet</span>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Phone frame side *@
                    <div class="flex items-center justify-center">
                        <div aria-hidden="true" class="relative aspect-[9/16] w-full max-w-[200px] overflow-hidden rounded-3xl border-8 border-foreground bg-muted">
                            @* Speaker notch *@
                            <div class="absolute left-1/2 top-2 h-1 w-12 -translate-x-1/2 rounded-full bg-foreground/40"></div>
                            @* Fake content rails *@
                            <div class="absolute inset-0 flex flex-col gap-2 p-4 pt-7">
                                <div class="h-3 w-2/3 rounded-full bg-muted-foreground/20"></div>
                                <div class="h-2 w-1/2 rounded-full bg-muted-foreground/15"></div>
                                <div class="mt-2 h-14 rounded-lg bg-muted-foreground/10"></div>
                                <div class="h-10 rounded-lg bg-muted-foreground/10"></div>
                                <div class="h-10 rounded-lg bg-muted-foreground/10"></div>
                                <div class="mt-auto flex items-center justify-around pb-1">
                                    <div class="size-2 rounded-full bg-muted-foreground/25"></div>
                                    <div class="size-2 rounded-full bg-muted-foreground/15"></div>
                                    <div class="size-2 rounded-full bg-muted-foreground/15"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                </article>
            }
        </div>

    </div>
</section>

@code {
    private record DeviceRow(string Id, string Eyebrow, string IconName, string Title, string Description, string[] Bullets);

    private static readonly DeviceRow[] _rows =
    [
        new(
            "offline-first",
            "Offline-first",
            "compass",
            "A native app that doesn't stop when the signal does",
            "Every interaction is served from a local SQLite cache first, then reconciled in the background when connectivity returns. Field teams keep moving through tunnels, warehouses, and remote sites without a single blocked tap.",
            [
                "Local-first SQLite cache on every screen",
                "Background sync with conflict-free replication",
                "Zero blocking network calls on the critical path",
            ]
        ),
        new(
            "push-notifications",
            "Live updates",
            "bell-ring",
            "Push notifications that actually feel worth unlocking for",
            "Quiet hours, batched summaries, and per-topic mute controls keep the notification tray calm. Only events that match a user's subscribed topics surface, and a single swipe dismisses an entire batch at once.",
            [
                "Per-topic subscription and mute toggles",
                "Quiet hours with per-day overrides",
                "Batched summaries, never individual pings",
            ]
        ),
        new(
            "biometric-auth",
            "Secure by default",
            "shield-check",
            "Biometric auth and encrypted storage, wired on day one",
            "Face ID and Touch ID gate every sensitive screen, and the on-device keychain wraps secrets with hardware-backed encryption. Sessions expire on background, and re-auth takes less than a second with a glance.",
            [
                "Hardware-backed keychain storage",
                "Face ID and Touch ID gating per screen",
                "Session auto-expiry on background",
            ]
        ),
    ];
}
