@* ============================================================
   Block: features-carousel-slider
   Title: Features Carousel Slider
   Description: Horizontal feature carousel with navigation arrows and responsive card sizing for browsing many features in React
   Long Description: Asymmetric bento grid with hero card and accent cells for visually dynamic React feature showcases
   Dependencies: CarouselCn, CarouselContentCn, CarouselItemCn, CarouselNextCn, CarouselPreviousCn
   Source: original/blocks/features/features-carousel-slider.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
          <p class="text-sm font-medium">AI Platform</p>
          <p class="mt-0.5 text-xs text-muted-foreground">
            From prototyping to production—everything you need to build and scale AI applications
          </p>
        </div>

        @* Carousel *@
        <div class="px-4 py-4">
          <CarouselCn>
            <CarouselContentCn Class="-ml-3">
              @foreach (var feature in _features)
              {
                <CarouselItemCn Class="basis-full pl-3 md:basis-1/2 lg:basis-1/3">
                  <div class="rounded-md border bg-muted/30 px-3 py-3">
                    <p class="text-sm font-medium">@feature.Title</p>
                    <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
                      @feature.Description
                    </p>
                  </div>
                </CarouselItemCn>
              }
            </CarouselContentCn>
            <div class="mt-3 flex items-center justify-center gap-2">
              <CarouselPreviousCn Class="static translate-y-0" />
              <CarouselNextCn Class="static translate-y-0" />
            </div>
          </CarouselCn>
        </div>
      </div>
    </section>

@code {
    private record FeatureInfo(string Title, string Description);

    private static readonly FeatureInfo[] _features =
    [
        new("Model Training", "Train and fine-tune models with your own data using our managed infrastructure."),
        new("API Gateway", "Unified API endpoint with automatic load balancing and rate limiting."),
        new("Vector Database", "Store and query high-dimensional embeddings with millisecond latency."),
        new("Prompt Engineering", "Visual prompt builder with version control and A/B testing."),
        new("Monitoring", "Real-time dashboards for model performance, latency, and cost tracking."),
        new("Deployment", "One-click deployment to edge locations worldwide with auto-scaling."),
    ];
}
