@* ============================================================
   Block: features-numbered-list
   Title: Features Numbered List
   Description: Sequential numbered feature list emphasizing feature priority and order, perfect for onboarding flows and step-by-step showcases
   Dependencies: None
   Source: original/blocks/features/features-numbered-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Core Capabilities</h2>
            <p class="mt-1 text-xs text-muted-foreground">Six features that make development faster</p>
        </div>

        @for (var i = 0; i < _features.Length; i++)
        {
            var feature = _features[i];
            <div class="@Cn.Merge("flex gap-4 px-4 py-4", i < _features.Length - 1 ? "border-b" : "")">
                <span class="shrink-0 text-2xl font-semibold tabular-nums text-muted-foreground/40">@((i + 1).ToString("D2"))</span>
                <div class="min-w-0 flex-1">
                    <h3 class="text-sm font-medium">@feature.Title</h3>
                    <p class="mt-1 text-sm text-muted-foreground">@feature.Description</p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Feature(string Title, string Description);

    private static readonly Feature[] _features =
    [
        new("AI-Powered Code Review", "Automatically detect bugs, security issues, and style violations with machine learning models trained on millions of repositories."),
        new("Instant Deploy Previews", "Every pull request gets a unique URL with full production environment. Share with stakeholders before merging."),
        new("Real-Time Collaboration", "Multiple developers can edit the same file simultaneously with cursor presence and live conflict resolution."),
        new("Edge Function Runtime", "Deploy serverless functions to 200+ locations worldwide with sub-50ms cold starts and automatic scaling."),
        new("Built-In Analytics", "Track page views, user sessions, and conversion events without third-party scripts or cookie consent."),
        new("Visual Regression Testing", "Automatically capture screenshots of every page and component. Detect unintended UI changes before deployment."),
    ];
}
