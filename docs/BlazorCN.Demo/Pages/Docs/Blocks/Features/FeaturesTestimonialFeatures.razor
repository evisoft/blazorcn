@* ============================================================
   Block: features-testimonial-features
   Title: Features Testimonial Features
   Description: A features block alternating between feature descriptions and customer testimonials built with Next.js, React, shadcn/ui, and Tailwind CSS
   Long Description: Statistics and metrics with social validation
   Dependencies: None
   Source: original/blocks/features/features-testimonial-features.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Features That Customers Love</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                See what teams are saying about our platform
            </p>
        </div>

        @for (var idx = 0; idx < _items.Count; idx++)
        {
            var item = _items[idx];
            <div class="@(idx < _items.Count - 1 ? "border-b" : "")">
                @if (item.Type == "feature")
                {
                    <div class="px-4 py-3">
                        <div class="flex items-start gap-3">
                            <span class="mt-1 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                            <div class="min-w-0 flex-1">
                                <h3 class="text-sm font-medium">@item.Title</h3>
                                <p class="mt-1 text-xs text-muted-foreground">@item.Description</p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="bg-muted/50 px-4 py-3">
                        <p class="text-sm text-muted-foreground">@item.Quote</p>
                        <div class="mt-2 flex items-center gap-2">
                            <div class="size-6 rounded-full bg-muted"></div>
                            <div>
                                <p class="text-xs font-medium">@item.Author</p>
                                <p class="text-xs text-muted-foreground">@item.Company</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record FeatureItem(string Type, string? Title = null, string? Description = null, string? Quote = null, string? Author = null, string? Company = null);

    private readonly List<FeatureItem> _items =
    [
        new("feature", Title: "Real-time collaboration", Description: "Work together seamlessly with live cursors, instant updates, and conflict-free editing across your entire team"),
        new("testimonial", Quote: "We went from emailing files back and forth to everyone working in the same document. Cut our review cycles from days to hours.", Author: "Sarah Chen", Company: "Apex Design Co"),
        new("feature", Title: "Advanced version control", Description: "Track every change with automatic snapshots, branch workflows, and the ability to restore any previous state"),
        new("testimonial", Quote: "The version history saved us when a client asked to revert to a design from three weeks ago. Found it in seconds.", Author: "Marcus Williams", Company: "Studio Forge"),
        new("feature", Title: "Component library sync", Description: "Share design systems across projects with automatic updates when components change, keeping everything consistent"),
        new("testimonial", Quote: "Our design system used to be a Figma file nobody looked at. Now it's built into the tool and updates propagate instantly.", Author: "Emily Rodriguez", Company: "TechFlow Inc"),
    ];
}
