@* ============================================================
   Block: features-architecture-flow-diagram
   Title: FeaturesArchitectureFlowDiagram
   Description: A horizontal architecture flow diagram feature section for React and Next.js showing five connected pipeline nodes with per-stage metrics built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-architecture-flow-diagram.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-14">

        @* Headline *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_headline.Eyebrow
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_headline.Title
            </h2>
            <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>
        </div>

        @* Flow diagram *@
        <div class="mt-12 sm:mt-14">
            <div class="flex flex-col items-stretch gap-6 sm:flex-row sm:items-center sm:justify-between sm:gap-2">
                @for (var i = 0; i < _flowNodes.Length; i++)
                {
                    var node = _flowNodes[i];
                    var idx = i;
                    <div class="contents">
                        <div class="flex flex-1 flex-col items-center">
                            <div class="flex w-full max-w-[150px] flex-col items-center rounded-xl border bg-background px-4 py-5 shadow-sm">
                                <span aria-hidden="true" class="flex size-10 items-center justify-center rounded-lg bg-muted">
                                    <LucideIconCn Name="@node.IconName" Size="20" Class="size-5 text-foreground" />
                                </span>
                                <h3 class="mt-3 text-sm font-semibold text-foreground">@node.Label</h3>
                                <p class="mt-0.5 text-xs text-muted-foreground">@node.Caption</p>
                            </div>
                        </div>

                        @if (idx < _flowNodes.Length - 1)
                        {
                            <div aria-hidden="true" class="hidden flex-1 origin-left items-center px-1 sm:flex">
                                <svg viewBox="0 0 100 12" preserveAspectRatio="none" class="h-3 w-full text-muted-foreground/50" aria-hidden="true">
                                    <title>Flow arrow</title>
                                    <line x1="0" y1="6" x2="92" y2="6" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 3" />
                                    <path d="M92 2 L98 6 L92 10 Z" fill="currentColor" />
                                </svg>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Metric tiles *@
            <dl class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-5 sm:gap-4">
                @foreach (var node in _flowNodes)
                {
                    <div class="rounded-lg border bg-muted/30 px-4 py-3">
                        <dt class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                            @node.MetricLabel
                        </dt>
                        <dd class="mt-1 text-xl font-semibold tabular-nums text-foreground">
                            @node.MetricValue
                        </dd>
                    </div>
                }
            </dl>
        </div>

        @* CTAs *@
        <div class="mt-12 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record HeadlineInfo(string Eyebrow, string Title, string Subtitle);
    private record FlowNode(string Id, string Label, string Caption, string IconName, string MetricLabel, string MetricValue);

    private static readonly HeadlineInfo _headline = new(
        "How it works",
        "From commit to user in under forty seconds",
        "Every push flows through the same deterministic pipeline. Watch your code move from source control to the edge without a single manual step or a single dropped build."
    );

    private static readonly FlowNode[] _flowNodes =
    [
        new("source", "Source", "Git push",      "git-branch", "Push time",   "1.2s"),
        new("build",  "Build",  "Turbo cache",   "zap",        "Build speed", "18s"),
        new("deploy", "Deploy", "Atomic swap",   "rocket",     "Deploy time", "4.8s"),
        new("edge",   "Edge",   "320 regions",   "cloud",      "Cache hit",   "98.4%"),
        new("user",   "User",   "First byte",    "user",       "TTFB",        "42ms"),
    ];
}
