@* ============================================================
   Block: features-shadow-lift-card-grid
   Title: FeaturesShadowLiftCardGrid
   Description: A shadow lift 2x3 card grid feature section for React and Next.js with six hover-lifting cards each containing a corner icon, title, description, and inline arrow link built with shadcn/ui, motion/react, and Tailwind CSS
   Source: original/blocks/features/features-shadow-lift-card-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            @_headline.Eyebrow
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            @_headline.Title
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted-foreground">@_headline.Subtitle</p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var feature in _features)
        {
            <div class="group relative rounded-2xl border bg-card p-5 shadow-sm transition-shadow duration-300 hover:shadow-md sm:p-6">
                <div class="flex size-10 items-center justify-center rounded-xl border bg-muted/50">
                    <LucideIconCn Name="@feature.IconName" Size="20" Class="size-5 text-foreground" aria-hidden="true" />
                </div>
                <h3 class="mt-5 text-base font-semibold text-foreground">@feature.Title</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                    @feature.Description
                </p>
                <span class="mt-5 inline-flex items-center gap-1.5 text-xs font-medium text-foreground">
                    Learn more
                    <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" />
                </span>
            </div>
        }
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);

    private record FeatureData(string Id, string IconName, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        Eyebrow: "What you get",
        Title: "Everything you need, nothing you don't",
        Subtitle: "Six focused capabilities that cover the full lifecycle from first commit to enterprise rollout without the ceremony of a legacy platform."
    );

    private static readonly FeatureData[] _features =
    [
        new("instant-deploys", "bolt", "Instant deploys",
            "Ship every push to a preview URL in under twelve seconds with zero configuration or cold starts."),
        new("edge-runtime", "gauge", "Edge-first runtime",
            "Route traffic to the nearest of thirty-two regions so every request feels local to the visitor."),
        new("soc2-ready", "shield-check", "SOC 2 ready",
            "Ship with audit logs, encryption at rest, and SSO on every plan including the free tier."),
        new("bring-your-stack", "puzzle", "Bring your stack",
            "First-class support for Next.js, Remix, Astro, and SvelteKit with framework-specific optimizations baked in."),
        new("zero-trust", "lock", "Zero-trust access",
            "Scope every deploy behind SSO, IP allowlists, and signed preview links that expire on a schedule you control."),
        new("ai-assist", "sparkles", "AI co-pilot",
            "Get inline suggestions for build errors, flaky tests, and slow routes pulled from your own deploy history."),
    ];
}
