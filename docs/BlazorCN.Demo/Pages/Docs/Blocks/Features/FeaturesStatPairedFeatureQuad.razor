@* ============================================================
   Block: features-stat-paired-feature-quad
   Title: FeaturesStatPairedFeatureQuad
   Description: A stat paired feature quad features section for React and Next.js with a 2x2 grid where each cell pairs a giant left column stat with a right column icon plus paragraph explaining the feature that produces that number built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-stat-paired-feature-quad.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">
        @* Headline cluster *@
        <div class="px-6 pb-10 pt-10 text-center sm:px-10 sm:pb-12 sm:pt-14">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_headline.Eyebrow
            </p>
            <h2 class="mx-auto mt-3 max-w-2xl text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_headline.Title
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>
        </div>

        @* 2x2 stat paired quad grid *@
        <div class="grid grid-cols-1 divide-y border-t sm:grid-cols-2 sm:divide-x sm:divide-y-0">
            @* Row 1 *@
            <div class="grid grid-cols-1 divide-y sm:col-span-2 sm:grid-cols-2 sm:divide-x sm:divide-y-0">
                @foreach (var pair in _pairs.Take(2))
                {
                    <div class="flex items-start gap-5 px-6 py-10 sm:px-8 sm:py-12">
                        <div class="w-20 shrink-0">
                            <span class="block text-3xl font-bold tabular-nums tracking-tight text-foreground sm:text-4xl">
                                @pair.Stat
                            </span>
                        </div>
                        <div class="flex-1">
                            <span aria-hidden="true" class="flex size-8 items-center justify-center rounded-lg bg-muted">
                                <LucideIconCn Name="@pair.IconName" Size="16" Class="size-4 text-foreground" />
                            </span>
                            <h3 class="mt-3 text-base font-semibold text-foreground">@pair.Title</h3>
                            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                                @pair.Description
                            </p>
                        </div>
                    </div>
                }
            </div>

            @* Row 2 *@
            <div class="grid grid-cols-1 divide-y border-t sm:col-span-2 sm:grid-cols-2 sm:divide-x sm:divide-y-0">
                @foreach (var pair in _pairs.Skip(2).Take(2))
                {
                    <div class="flex items-start gap-5 px-6 py-10 sm:px-8 sm:py-12">
                        <div class="w-20 shrink-0">
                            <span class="block text-3xl font-bold tabular-nums tracking-tight text-foreground sm:text-4xl">
                                @pair.Stat
                            </span>
                        </div>
                        <div class="flex-1">
                            <span aria-hidden="true" class="flex size-8 items-center justify-center rounded-lg bg-muted">
                                <LucideIconCn Name="@pair.IconName" Size="16" Class="size-4 text-foreground" />
                            </span>
                            <h3 class="mt-3 text-base font-semibold text-foreground">@pair.Title</h3>
                            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                                @pair.Description
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record PairData(string Id, string Stat, string Title, string Description, string IconName);

    private static readonly HeadlineData _headline = new(
        "The numbers",
        "Every feature tied to an outcome you can measure",
        "Four pairings that connect a capability to the metric it moves — so the value is obvious before the first demo call."
    );

    private static readonly PairData[] _pairs =
    [
        new("faster-builds", "10×", "Faster builds",
            "An incremental compile layer reuses cached artifacts across branches so CI time drops from twelve minutes to under ninety seconds on an average pull request.",
            "rocket"),
        new("uptime", "99.9%", "Measured uptime",
            "Regional failover and automated health checks reroute traffic within two seconds of a node becoming unhealthy so the status page stays green through infrastructure events.",
            "shield-check"),
        new("cost-savings", "47%", "Lower infra cost",
            "Predictive autoscale right-sizes capacity to actual demand and sheds idle workers during off-peak hours, cutting compute spend almost in half on the typical production workload.",
            "dollar-sign"),
        new("setup-time", "2m", "Setup to first deploy",
            "A single command bootstraps the project, provisions a preview environment, and pushes the initial build so new teams ship their first change in the time it takes to brew coffee.",
            "clock"),
    ];
}
