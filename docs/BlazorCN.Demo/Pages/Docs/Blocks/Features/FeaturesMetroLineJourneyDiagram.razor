@* ============================================================
   Block: features-metro-line-journey-diagram
   Title: FeaturesMetroLineJourneyDiagram
   Description: A metro line journey diagram features section for React and Next.js with a horizontal subway track, six station nodes, alternating top and bottom labels, and terminus markers built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-metro-line-journey-diagram.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Header *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Product Journey
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Six stops from idea to production.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every team rides the same line. Hop on at sign up, step off whenever you like, and your
                code is already running at the next station.
            </p>
        </div>

        @* Line name pill *@
        <div class="mt-10 flex items-center justify-center">
            <span class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                <span class="size-1.5 rounded-full bg-foreground"></span>
                @_lineName
            </span>
        </div>

        @* Horizontal metro diagram — md and up *@
        <div class="relative mt-10 hidden md:block">
            @* Origin label *@
            <div class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-2">
                <span class="rounded-md border bg-background px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                    @_origin
                </span>
            </div>
            @* Terminus label *@
            <div class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-2">
                <span class="rounded-md border bg-background px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                    @_terminus
                </span>
            </div>

            <div class="relative mx-16 h-56">
                @* Track *@
                <div class="absolute left-0 right-0 top-1/2 h-1 -translate-y-1/2 rounded-full bg-foreground"></div>

                @* Stations *@
                @foreach (var station in _stations)
                {
                    var pct = (station.Index / (_stations.Length - 1.0)) * 100.0;
                    var isTop = station.Index % 2 == 0;
                    <div class="absolute top-1/2" style="@($"left:{pct:F4}%;transform:translate(-50%,-50%)")">
                        @* Station circle *@
                        <div class="relative flex size-6 items-center justify-center rounded-full border-4 border-foreground bg-background">
                            <span class="size-1.5 rounded-full bg-foreground"></span>
                        </div>

                        @* Label (alternating top/bottom) *@
                        <div class="@(Cn.Merge("absolute left-1/2 w-36 -translate-x-1/2 text-center", isTop ? "bottom-full mb-4" : "top-full mt-4"))">
                            <div class="flex items-center justify-center gap-1.5">
                                <LucideIconCn Name="@station.IconName" Size="14" Class="size-3.5 text-foreground" />
                                <span class="text-sm font-semibold">@station.Title</span>
                            </div>
                            <p class="mt-1 text-[11px] leading-snug text-muted-foreground">
                                @station.Description
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Mobile vertical stack *@
        <ol class="relative mt-10 space-y-6 border-l-2 border-foreground pl-6 md:hidden">
            <li class="-ml-[29px] flex items-center gap-2">
                <span class="rounded-md border bg-background px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                    @_origin
                </span>
            </li>
            @foreach (var station in _stations)
            {
                <li class="relative">
                    <span class="absolute -left-[34px] top-0.5 flex size-5 items-center justify-center rounded-full border-4 border-foreground bg-background">
                        <span class="size-1 rounded-full bg-foreground"></span>
                    </span>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="@station.IconName" Size="14" Class="size-3.5 text-foreground" />
                        <span class="text-sm font-semibold">@station.Title</span>
                    </div>
                    <p class="mt-0.5 text-xs leading-snug text-muted-foreground">
                        @station.Description
                    </p>
                </li>
            }
            <li class="-ml-[29px] flex items-center gap-2">
                <span class="rounded-md border bg-background px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                    @_terminus
                </span>
            </li>
        </ol>

        @* CTA pair *@
        <div class="mt-12 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <ButtonCn Class="w-full sm:w-[240px]">Start the journey</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Read the guide</ButtonCn>
        </div>
    </div>
</section>

@code {
    private const string _lineName = "Platform Line";
    private const string _origin = "Sign Up";
    private const string _terminus = "Production";

    private record MetroStation(int Index, string Id, string Title, string Description, string IconName);

    private static readonly MetroStation[] _stations =
    [
        new(0, "onboard", "Onboard", "Sign up, link your repo, auto-detect stack.", "sparkles"),
        new(1, "build",   "Build",   "Cached builds with reproducible artifacts.",  "terminal"),
        new(2, "deploy",  "Deploy",  "Instant previews on every commit and PR.",     "cloud-upload"),
        new(3, "monitor", "Monitor", "Traces, logs, and errors in one timeline.",    "bar-chart-3"),
        new(4, "scale",   "Scale",   "Elastic regions absorb traffic automatically.","trending-up"),
        new(5, "ship",    "Ship",    "Release rings with instant rollback safety.",  "rocket"),
    ];
}
