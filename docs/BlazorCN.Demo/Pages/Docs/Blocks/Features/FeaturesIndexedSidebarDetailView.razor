@* ============================================================
   Block: features-indexed-sidebar-detail-view
   Title: FeaturesIndexedSidebarDetailView
   Description: An indexed sidebar master-detail features section for React and Next.js with lettered A to F index badges beside each sidebar item and a detail panel showing title description and three bullet benefits built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-indexed-sidebar-detail-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="grid lg:grid-cols-[240px_1fr]">

      @* Indexed sidebar *@
      <div class="flex flex-row gap-1 overflow-x-auto border-b bg-muted/30 p-3 lg:flex-col lg:gap-1 lg:overflow-visible lg:border-b-0 lg:border-r lg:p-4">
        <p class="hidden px-2 pb-2 text-xs font-medium uppercase tracking-widest text-muted-foreground lg:block">
          Index
        </p>
        @foreach (var feat in _features)
        {
          var feature = feat;
          var isActive = feature.Id == _activeId;
          <button
            type="button"
            @onclick="@(() => _activeId = feature.Id)"
            aria-pressed="@isActive.ToString().ToLower()"
            class="@Cn.Merge(
              "group flex shrink-0 items-center gap-3 rounded-lg px-2.5 py-2 text-left transition-colors",
              "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground/20",
              isActive
                ? "bg-foreground/5 text-foreground"
                : "text-muted-foreground hover:bg-muted/50 hover:text-foreground"
            )"
          >
            <span
              aria-hidden="true"
              class="@Cn.Merge(
                "flex size-6 shrink-0 items-center justify-center rounded-full text-[11px] font-semibold transition-colors",
                isActive ? "bg-foreground text-background" : "bg-muted text-muted-foreground"
              )"
            >
              @feature.Index
            </span>
            <span
              class="@Cn.Merge(
                "whitespace-nowrap text-sm lg:whitespace-normal",
                isActive ? "font-semibold" : "font-medium"
              )"
            >
              @feature.Title
            </span>
          </button>
        }
      </div>

      @* Detail panel *@
      <div class="relative p-8 sm:p-10 lg:p-12">
        @{ var active = _features.FirstOrDefault(f => f.Id == _activeId) ?? _features[0]; }
        <div>
          <div class="flex items-center gap-3">
            <span
              aria-hidden="true"
              class="flex size-7 items-center justify-center rounded-full bg-muted text-xs font-semibold text-muted-foreground"
            >
              @active.Index
            </span>
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
              Capability @active.Index
            </p>
          </div>
          <h3 class="mt-4 max-w-xl text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
            @active.Title
          </h3>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
            @active.Description
          </p>
          <ul class="mt-7 space-y-3">
            @foreach (var benefit in active.Benefits)
            {
              <li class="flex items-start gap-2.5">
                <span
                  aria-hidden="true"
                  class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10"
                >
                  <LucideIconCn Name="check" Size="12" StrokeWidth="3" Class="size-3 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                </span>
                <span class="text-sm leading-relaxed text-foreground">@benefit</span>
              </li>
            }
          </ul>
        </div>
      </div>

    </div>
  </div>
</section>

@code {
    private string _activeId = _features[0].Id;

    private record Feature(string Id, string Index, string Title, string Description, string[] Benefits);

    private static readonly Feature[] _features =
    [
        new Feature(
            "authentication",
            "A",
            "Authentication & identity",
            "Drop-in auth for every framework with magic links, passkeys, SAML, and social providers out of the box. Sessions, tokens, and refresh logic are handled by the SDK so your login screen is one component and your backend never touches a password hash.",
            [
                "Passkey support with WebAuthn on every plan",
                "SAML SSO and SCIM provisioning included",
                "Session revocation across devices in under 2s",
            ]
        ),
        new Feature(
            "billing",
            "B",
            "Billing & subscriptions",
            "A metered billing engine with proration, trials, coupons, tax handling, and dunning baked in. Plans are defined in code, published through the dashboard, and tied to usage counters the SDK emits directly from your application — no Stripe webhooks to wire up.",
            [
                "Usage-based metering with per-second precision",
                "Automatic VAT, GST, and sales-tax collection",
                "Smart dunning recovers 47% of failed charges",
            ]
        ),
        new Feature(
            "collaboration",
            "C",
            "Collaboration primitives",
            "Presence, live cursors, comments, and multiplayer editing shipped as framework-agnostic React hooks. A single provider wraps your app and every CRDT-backed primitive stays in sync across sessions, with conflict resolution handled by the edge network.",
            [
                "Sub-80ms cursor sync across continents",
                "Threaded comments with unread tracking",
                "CRDT conflict resolution with no merge UI",
            ]
        ),
        new Feature(
            "data",
            "D",
            "Data & persistence",
            "A typed ORM, a realtime query layer, and a managed Postgres cluster with point-in-time recovery — connected through a single URL. Queries stream to subscribed clients, migrations run in the background, and read replicas appear automatically as you scale.",
            [
                "Type-safe queries with zero boilerplate",
                "Realtime subscriptions on any SELECT",
                "Point-in-time recovery up to 35 days back",
            ]
        ),
        new Feature(
            "events",
            "E",
            "Events & workflows",
            "An event bus that delivers exactly-once, a workflow engine that resumes durably across deploys, and a scheduler that triggers functions on cron or time zone rules. Every run is observable, replayable, and wired to your existing Slack or Pagerduty channels.",
            [
                "Durable workflows survive deploys and restarts",
                "Exactly-once delivery with automatic dedupe",
                "One-click replay from any failure point",
            ]
        ),
        new Feature(
            "files",
            "F",
            "Files & media delivery",
            "Object storage, image transformation, and signed delivery URLs on a CDN that caches at 300+ edges. Uploads happen directly from the browser, variants are generated on demand, and access rules are defined in your application code instead of an S3 policy.",
            [
                "Direct-to-storage uploads with resumable TUS",
                "On-demand image resizing, WebP, and AVIF",
                "Signed URLs with per-user access rules",
            ]
        ),
    ];
}
