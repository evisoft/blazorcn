@* ============================================================
   Block: features-product-shelf-aisle-row
   Title: FeaturesProductShelfAisleRow
   Description: A product shelf aisle row features section for React and Next.js with stacked shelves, varying height product boxes, hanging price tags, and an end-of-aisle shopping cart built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-product-shelf-aisle-row.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Aisle 04 · Capabilities
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Features, stocked to the ceiling.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Grab what you need, skip what you don&apos;t. Every add-on is a boxed product on the
                shelf with a hanging price tag — no mystery bundles, no seat math.
            </p>
        </div>

        @* Retail aisle *@
        <div class="mt-12 overflow-hidden rounded-lg border bg-muted/20 p-5 sm:p-8">
            @* Fluorescent top light *@
            <div aria-hidden="true" class="mx-auto mb-6 h-0.5 w-full max-w-md rounded-full bg-foreground/15 shadow-[0_0_20px_rgba(255,255,255,0.15)]"></div>

            @* Top shelf *@
            <div class="relative">
                @* Shelf label *@
                <div class="mb-1 flex items-center justify-between px-1">
                    <h3 class="font-mono text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        Top shelf · Premium
                    </h3>
                    <span class="font-mono text-[10px] text-muted-foreground/70">
                        Aisle 04 · @(_topShelf.Length) items
                    </span>
                </div>

                @* Products on top shelf *@
                <div class="flex items-end justify-start gap-3 overflow-x-auto px-1 pb-0 sm:gap-5 sm:justify-center">
                    @foreach (var prod in _topShelf)
                    {
                        var product = prod;
                        <div class="relative flex flex-col items-center">
                            @* Product box *@
                            <button type="button" aria-label="@($"{product.Name} — {product.Tier} tier")"
                                class="@Cn.Merge("group relative flex w-24 flex-col items-center justify-between overflow-hidden rounded-sm border border-foreground/20 bg-card p-2 text-center transition-colors hover:border-foreground/40 hover:bg-muted/60 sm:w-28 sm:p-3", _heightClasses[product.Height])">
                                @* Top stripe branding *@
                                <div class="absolute inset-x-0 top-0 h-1 bg-foreground/10"></div>
                                <div class="absolute inset-x-0 top-1 flex justify-center">
                                    <span class="font-mono text-[8px] uppercase tracking-[0.2em] text-muted-foreground/70">
                                        @product.Tier
                                    </span>
                                </div>

                                <div class="mt-4 flex flex-1 flex-col items-center justify-center gap-1.5">
                                    <span class="flex size-8 items-center justify-center rounded-full border border-foreground/15 bg-background">
                                        <LucideIconCn Name="@product.IconName" Size="14" Class="size-3.5 text-foreground" aria-hidden="true" />
                                    </span>
                                    <span class="w-full truncate px-1 text-[11px] font-semibold leading-tight text-foreground sm:text-xs">
                                        @product.Name
                                    </span>
                                </div>

                                @* Bottom barcode *@
                                <div aria-hidden="true" class="mt-1 flex h-3 w-full items-end justify-center gap-[1px]">
                                    @foreach (var bar in _barcode)
                                    {
                                        var h = bar;
                                        <span class="w-[1px] bg-foreground/70" style="@($"height:{h * 3}px")"></span>
                                    }
                                </div>
                            </button>

                            @* Hanging string + price tag *@
                            <div aria-hidden="true" class="relative flex flex-col items-center">
                                <span class="h-4 w-px bg-foreground/25"></span>
                                <span class="relative inline-flex items-center gap-1 rounded-sm border border-foreground/25 bg-amber-500/10 px-2 py-0.5 font-mono text-[10px] font-semibold text-foreground shadow-[0_1px_0_rgba(0,0,0,0.05)]">
                                    <LucideIconCn Name="tag" Size="10" Class="size-2.5 text-foreground/70" />
                                    @product.Price
                                    <span class="absolute -left-1 top-1/2 size-1 -translate-y-1/2 rounded-full bg-foreground/30"></span>
                                </span>
                            </div>
                        </div>
                    }
                </div>

                @* Shelf ledge *@
                <div class="relative mt-1">
                    <div class="h-1 rounded-sm bg-foreground/15"></div>
                    <div class="h-1 bg-foreground/25"></div>
                    <div class="h-px bg-foreground/10"></div>
                </div>
            </div>

            @* Gap between shelves *@
            <div class="h-10 sm:h-14"></div>

            @* Bottom shelf *@
            <div class="relative">
                @* Shelf label *@
                <div class="mb-1 flex items-center justify-between px-1">
                    <h3 class="font-mono text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        Bottom shelf · Everyday
                    </h3>
                    <span class="font-mono text-[10px] text-muted-foreground/70">
                        Aisle 04 · @(_bottomShelf.Length) items
                    </span>
                </div>

                @* Products on bottom shelf *@
                <div class="flex items-end justify-start gap-3 overflow-x-auto px-1 pb-0 sm:gap-5 sm:justify-center">
                    @foreach (var prod in _bottomShelf)
                    {
                        var product = prod;
                        <div class="relative flex flex-col items-center">
                            @* Product box *@
                            <button type="button" aria-label="@($"{product.Name} — {product.Tier} tier")"
                                class="@Cn.Merge("group relative flex w-24 flex-col items-center justify-between overflow-hidden rounded-sm border border-foreground/20 bg-card p-2 text-center transition-colors hover:border-foreground/40 hover:bg-muted/60 sm:w-28 sm:p-3", _heightClasses[product.Height])">
                                @* Top stripe branding *@
                                <div class="absolute inset-x-0 top-0 h-1 bg-foreground/10"></div>
                                <div class="absolute inset-x-0 top-1 flex justify-center">
                                    <span class="font-mono text-[8px] uppercase tracking-[0.2em] text-muted-foreground/70">
                                        @product.Tier
                                    </span>
                                </div>

                                <div class="mt-4 flex flex-1 flex-col items-center justify-center gap-1.5">
                                    <span class="flex size-8 items-center justify-center rounded-full border border-foreground/15 bg-background">
                                        <LucideIconCn Name="@product.IconName" Size="14" Class="size-3.5 text-foreground" aria-hidden="true" />
                                    </span>
                                    <span class="w-full truncate px-1 text-[11px] font-semibold leading-tight text-foreground sm:text-xs">
                                        @product.Name
                                    </span>
                                </div>

                                @* Bottom barcode *@
                                <div aria-hidden="true" class="mt-1 flex h-3 w-full items-end justify-center gap-[1px]">
                                    @foreach (var bar in _barcode)
                                    {
                                        var h = bar;
                                        <span class="w-[1px] bg-foreground/70" style="@($"height:{h * 3}px")"></span>
                                    }
                                </div>
                            </button>

                            @* Hanging string + price tag *@
                            <div aria-hidden="true" class="relative flex flex-col items-center">
                                <span class="h-4 w-px bg-foreground/25"></span>
                                <span class="relative inline-flex items-center gap-1 rounded-sm border border-foreground/25 bg-amber-500/10 px-2 py-0.5 font-mono text-[10px] font-semibold text-foreground shadow-[0_1px_0_rgba(0,0,0,0.05)]">
                                    <LucideIconCn Name="tag" Size="10" Class="size-2.5 text-foreground/70" />
                                    @product.Price
                                    <span class="absolute -left-1 top-1/2 size-1 -translate-y-1/2 rounded-full bg-foreground/30"></span>
                                </span>
                            </div>
                        </div>
                    }

                    @* Shopping cart at the end of the bottom shelf *@
                    <div class="flex h-28 w-20 flex-col items-center justify-end sm:h-32">
                        <div class="flex size-14 items-center justify-center rounded-md border border-dashed border-foreground/25 bg-muted/40 sm:size-16">
                            <LucideIconCn Name="shopping-cart" Size="24" Class="size-6 text-foreground/70 sm:size-7" aria-hidden="true" />
                        </div>
                        <span class="mt-1 font-mono text-[9px] uppercase tracking-widest text-muted-foreground">
                            Cart · 0
                        </span>
                    </div>
                </div>

                @* Shelf ledge *@
                <div class="relative mt-1">
                    <div class="h-1 rounded-sm bg-foreground/15"></div>
                    <div class="h-1 bg-foreground/25"></div>
                    <div class="h-px bg-foreground/10"></div>
                </div>
            </div>

            @* Floor baseline *@
            <div class="mt-6 flex items-center justify-between border-t border-dashed border-foreground/15 pt-3">
                <span class="font-mono text-[10px] text-muted-foreground">
                    Open 24/7 · Free returns
                </span>
                <span class="font-mono text-[10px] text-muted-foreground">Self-checkout ahead</span>
            </div>
        </div>

        @* CTA pair *@
        <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[210px]">Start shopping</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Compare aisles</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ShelfProduct(string Id, string IconName, string Name, string Tier, string Price, string Height);

    private static readonly ShelfProduct[] _topShelf =
    [
        new("starter",   "box",         "Starter Pack", "Hobby",  "$9",  "md"),
        new("analytics", "bar-chart-3", "Analytics",    "Growth", "$24", "lg"),
        new("ai-boost",  "sparkles",    "AI Boost",     "Pro",    "$49", "xl"),
        new("cloud-sync","cloud",       "Cloud Sync",   "Growth", "$19", "sm"),
    ];

    private static readonly ShelfProduct[] _bottomShelf =
    [
        new("vault",     "lock",       "Vault",     "Pro",   "$29", "lg"),
        new("data-lake", "database",   "Data Lake", "Scale", "$79", "xl"),
        new("deploy",    "rocket",     "Deploy+",   "Pro",   "$14", "md"),
    ];

    private static readonly System.Collections.Generic.Dictionary<string, string> _heightClasses = new()
    {
        ["sm"] = "h-24 sm:h-28",
        ["md"] = "h-28 sm:h-32",
        ["lg"] = "h-32 sm:h-36",
        ["xl"] = "h-36 sm:h-40",
    };

    private static readonly int[] _barcode = [2, 3, 1, 3, 2, 1, 2, 3, 1, 2, 3, 1, 2];
}
