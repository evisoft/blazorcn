@* ============================================================
   Block: features-deployment-options
   Title: Features Deployment Options
   Description: Deployment option matrix comparing setup, scaling, compliance, and cost. Built with Next.js, React, shadcn/ui, and Tailwind CSS.
   Long Description: Compliance certification matrix
   Dependencies: None
   Source: original/blocks/features/features-deployment-options.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
          <span class="font-medium text-sm">Deployment Options</span>
          <p class="mt-0.5 text-muted-foreground text-xs">
            Choose the deployment model that fits your requirements
          </p>
        </div>

        <div class="divide-y">
          @foreach (var option in _deploymentOptions)
          {
            <div class="px-4 py-3">
              <div class="mb-3 flex items-start gap-2">
                <span class="@(Cn.Merge("mt-1 size-1.5 shrink-0 rounded-full", option.Highlight ? "bg-emerald-500" : "bg-muted-foreground/40"))"></span>
                <div class="min-w-0 flex-1">
                  <span class="font-medium text-sm">@option.Name</span>
                  <p class="mt-0.5 text-muted-foreground text-xs">@option.Description</p>
                </div>
              </div>

              <div class="ml-5 grid gap-2">
                <div class="flex items-baseline justify-between gap-4">
                  <span class="text-muted-foreground text-xs">Setup</span>
                  <span class="text-right text-xs">@option.Setup</span>
                </div>
                <div class="flex items-baseline justify-between gap-4">
                  <span class="text-muted-foreground text-xs">Scaling</span>
                  <span class="text-right text-xs">@option.Scaling</span>
                </div>
                <div class="flex items-baseline justify-between gap-4">
                  <span class="text-muted-foreground text-xs">Compliance</span>
                  <span class="text-right text-xs">@option.Compliance</span>
                </div>
                <div class="flex items-baseline justify-between gap-4">
                  <span class="text-muted-foreground text-xs">Cost</span>
                  <span class="text-right text-xs">@option.Cost</span>
                </div>
              </div>
            </div>
          }
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
          <div class="flex items-center justify-between text-xs">
            <div class="flex items-center gap-4">
              <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground">Recommended</span>
              </div>
            </div>
            <button type="button" class="transition-colors hover:text-foreground">
              Compare all options
            </button>
          </div>
        </div>
      </div>
    </section>

@code {
    private record DeploymentOption(string Name, string Description, bool Highlight, string Setup, string Scaling, string Compliance, string Cost);

    private static readonly DeploymentOption[] _deploymentOptions = new[]
    {
        new DeploymentOption("Cloud Hosted", "Fully managed cloud infrastructure", true, "Instant", "Auto-scaling", "SOC 2, GDPR", "From $29/mo"),
        new DeploymentOption("Self-Hosted", "Deploy on your own infrastructure", false, "1-2 hours", "Manual", "Full control", "License fee"),
        new DeploymentOption("Hybrid", "Mix of cloud and on-premise", false, "Custom", "Configurable", "Custom policies", "Custom pricing"),
    };
}
