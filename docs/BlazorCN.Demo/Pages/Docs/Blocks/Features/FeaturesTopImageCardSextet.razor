@* ============================================================
   Block: features-top-image-card-sextet
   Title: FeaturesTopImageCardSextet
   Description: A six-card feature grid for React and Next.js with a top image area on every card, a floating corner icon badge, and eyebrow headline above the grid built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-top-image-card-sextet.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">

        @* Header *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_headline.Eyebrow
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_headline.Title
            </h2>
            <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>
        </div>

        @* Grid *@
        <div class="mt-10 grid grid-cols-1 gap-5 sm:mt-12 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
            @foreach (var feat in _features)
            {
                <article class="overflow-hidden rounded-xl border bg-background">
                    @* Image area with floating icon *@
                    <div class="relative aspect-[16/10] w-full bg-muted">
                        @* ImagePlaceholder *@
                        <div aria-hidden="true" class="absolute inset-0 flex items-center justify-center">
                            <div class="relative flex items-center justify-center">
                                <div class="absolute size-24 rounded-full border border-muted-foreground/[0.06]"></div>
                                <div class="absolute size-14 rounded-full border border-muted-foreground/[0.08]"></div>
                                <div class="absolute h-px w-32 bg-muted-foreground/[0.06]"></div>
                                <div class="absolute h-32 w-px bg-muted-foreground/[0.06]"></div>
                                <div class="flex size-8 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                                    <LucideIconCn Name="image" Size="16" StrokeWidth="2" Class="size-4 text-muted-foreground/40" />
                                </div>
                            </div>
                        </div>
                        <div aria-hidden="true" class="absolute right-3 top-3 flex size-8 items-center justify-center rounded-lg border bg-card shadow-sm">
                            <LucideIconCn Name="@feat.IconName" Size="16" StrokeWidth="2" Class="size-4 text-foreground" />
                        </div>
                    </div>

                    @* Text area *@
                    <div class="p-5">
                        <h3 class="text-base font-semibold text-foreground">@feat.Title</h3>
                        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                            @feat.Description
                        </p>
                    </div>
                </article>
            }
        </div>

    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);

    private record FeatureData(string Id, string IconName, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        Eyebrow: "The platform",
        Title: "Every capability your team reaches for",
        Subtitle: "Six building blocks that cover the full lifecycle — from the first keystroke in local dev to the audit log a compliance officer reads at 2am. No surprise tiers, no feature flags behind enterprise sales."
    );

    private static readonly FeatureData[] _features =
    [
        new("edge-runtime", "zap", "Edge runtime, global by default",
            "Deploy to 34 regions with a single git push. Cold starts under 15ms, warm requests under 3ms, and zero config for geographic failover."),
        new("realtime-observability", "gauge", "Realtime observability",
            "Traces, logs, and metrics stream into a single timeline per request. Jump from a slow p99 to the exact line of code in two clicks."),
        new("soc2-audit", "shield-check", "SOC 2 Type II audited",
            "Annual third-party audits, customer-controlled data residency, and an SLA-backed incident response window of 15 minutes for critical issues."),
        new("granular-rbac", "lock", "Granular role-based access",
            "Custom roles with resource-level scopes, time-bound permission grants, and an audit trail of every action tied to a human or service principal."),
        new("usage-analytics", "bar-chart-3", "Usage analytics out of the box",
            "Ship with a pre-built analytics layer that tracks funnels, retention, and cohort behavior without piping events to a third-party warehouse."),
        new("workspace-isolation", "layers", "Workspace-level isolation",
            "Every workspace gets its own encryption key, network policy, and billing envelope so parallel projects never bleed into each other at runtime."),
    ];
}
