@* ============================================================
   Block: features-inset-border-card-grid
   Title: FeaturesInsetBorderCardGrid
   Description: An inset ring border card grid features section for React and Next.js with a centered eyebrow and marketing headline and a 3-column grid of six compact cards each using ring-1 ring-inset instead of a full border with a small rounded icon wrapper and two-line description built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-inset-border-card-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_headline.Eyebrow
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_headline.Title
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var feature in _features)
            {
                <div class="rounded-xl bg-card p-5 ring-1 ring-inset ring-border">
                    <div aria-hidden="true" class="flex size-8 items-center justify-center rounded-md bg-muted">
                        <LucideIconCn Name="@feature.IconName" Size="16" Class="size-4 text-foreground" />
                    </div>
                    <h3 class="mt-4 text-base font-semibold text-foreground">@feature.Title</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                        @feature.Description
                    </p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureData(string Id, string Title, string Description, string IconName);

    private static readonly HeadlineData _headline = new(
        "Platform",
        "A precise toolkit for teams that ship",
        "Six primitives that compose into whatever workflow your team already uses, without forcing a migration or a rewrite."
    );

    private static readonly FeatureData[] _features =
    [
        new("branch-preview", "Branch preview environments",
            "Every pull request ships its own isolated preview URL with a fresh database seed so reviewers can click through real flows.",
            "git-branch"),
        new("typed-sdk", "Typed end-to-end SDK",
            "A single generated client for TypeScript, Python, and Go that stays in sync with your schema on every deploy.",
            "code"),
        new("local-cli", "First-class local CLI",
            "Run production-parity environments on your laptop in under thirty seconds with a single shell command and zero flags.",
            "terminal"),
        new("managed-infra", "Managed infrastructure",
            "We run the control plane, you bring the code — scale to millions of requests without provisioning a single server.",
            "cloud"),
        new("secrets-vault", "Scoped secrets vault",
            "Per-environment secret injection with rotation policies, audit logs, and zero exposure to the repository.",
            "key"),
        new("workflow-engine", "Durable workflow engine",
            "Long-running workflows survive restarts, retry on failure, and stay observable end-to-end with zero boilerplate.",
            "workflow"),
    ];
}
