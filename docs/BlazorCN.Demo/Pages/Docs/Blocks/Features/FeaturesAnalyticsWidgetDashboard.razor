@* ============================================================
   Block: features-analytics-widget-dashboard
   Title: FeaturesAnalyticsWidgetDashboard
   Description: An analytics widget dashboard features section for React and Next.js with a line chart, uptime stat tile, weekly bar chart, and donut chart built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-analytics-widget-dashboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div>
    @* Headline *@
    <div class="text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Telemetry built in
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Every request, every region, every second.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
        Real-time observability surfaces in a single dashboard. Trace latency spikes to the
        function, not just the region.
      </p>
    </div>

    @* Widget grid *@
    <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
      @* Widget 1: Line chart (spans 2 cols on lg) *@
      <article class="flex flex-col rounded-xl border bg-card p-5 lg:col-span-2">
        <div class="flex items-start justify-between">
          <div>
            <h3 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
              Requests per second
            </h3>
            <div class="mt-2 flex items-baseline gap-2">
              <span class="text-2xl font-semibold tabular-nums tracking-tight">48,312</span>
              <span class="inline-flex items-center gap-0.5 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3" aria-hidden="true" />
                12.4%
              </span>
            </div>
          </div>
          <span class="rounded-md border bg-background px-2 py-1 font-mono text-[10px] text-muted-foreground">
            last 1h
          </span>
        </div>
        <div class="mt-4 flex-1">
          <svg aria-hidden="true" viewBox="0 0 270 80" preserveAspectRatio="none" class="h-24 w-full">
            <defs>
              <linearGradient id="area-fill-1" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="currentColor" stop-opacity="0.14" />
                <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
              </linearGradient>
            </defs>
            @* Gridlines *@
            @foreach (var gy in _gridLines)
            {
              <line x1="0" x2="270" y1="@gy" y2="@gy" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="2 3" />
            }
            <path d="@_areaPath" fill="url(#area-fill-1)" class="text-foreground" />
            <path d="@_linePath" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-foreground" />
            @for (int i = 0; i < _linePoints.Length; i++)
            {
              var pt = _linePoints[i];
              var r = i == _linePoints.Length - 1 ? 2.5 : 1.25;
              <circle cx="@pt.X" cy="@pt.Y" r="@r" class="fill-foreground" />
            }
          </svg>
        </div>
        <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
          Streaming metrics pipeline with sub-second propagation from edge to dashboard.
        </p>
      </article>

      @* Widget 2: Uptime stat tile *@
      <article class="flex flex-col rounded-xl border bg-card p-5">
        <h3 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
          Uptime
        </h3>
        <div class="mt-3 flex items-baseline gap-1.5">
          <span class="text-4xl font-semibold tabular-nums tracking-tight">99.98</span>
          <span class="text-lg font-semibold tabular-nums text-muted-foreground">%</span>
        </div>
        <div class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-emerald-600 dark:text-emerald-400">
          <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3" aria-hidden="true" />
          +0.04 vs last quarter
        </div>
        <div class="mt-auto flex items-end gap-0.5 pt-5">
          @foreach (var tick in _uptimeTicks)
          {
            <span class="flex-1 rounded-sm bg-foreground/20" style="@($"height:{tick}px")"></span>
          }
        </div>
        <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
          14 months of unbroken availability across every production region.
        </p>
      </article>

      @* Widget 3: Weekly bar chart *@
      <article class="flex flex-col rounded-xl border bg-card p-5">
        <h3 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
          Weekly throughput
        </h3>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl font-semibold tabular-nums tracking-tight">2.1B</span>
          <span class="text-xs text-muted-foreground">events</span>
        </div>
        <div class="mt-5 flex h-20 items-end gap-1.5">
          @foreach (var bar in _barData)
          {
            <div class="flex flex-1 flex-col items-center gap-1.5">
              <div class="w-full rounded-sm bg-foreground/80" style="@($"height:{bar.Value}%")"></div>
              <span class="text-[10px] font-medium text-muted-foreground">@bar.Label</span>
            </div>
          }
        </div>
        <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
          Auto-scaling absorbs weekday peaks with zero manual intervention.
        </p>
      </article>

      @* Widget 4: Donut chart (spans 2 cols on lg) *@
      <article class="flex flex-col rounded-xl border bg-card p-5 lg:col-span-2">
        <div class="flex flex-1 items-center gap-6">
          <div class="relative flex shrink-0 items-center justify-center">
            <svg aria-hidden="true" viewBox="0 0 72 72" class="size-24 -rotate-90">
              <circle cx="36" cy="36" r="@_donutRadius" fill="none" stroke="currentColor" stroke-opacity="0.12" stroke-width="8" />
              <circle cx="36" cy="36" r="@_donutRadius" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round"
                stroke-dasharray="@_donutCircumference" stroke-dashoffset="@_donutOffset" class="text-foreground" />
            </svg>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="text-lg font-semibold tabular-nums tracking-tight">
                @DonutValue%
              </span>
            </div>
          </div>
          <div class="flex-1">
            <h3 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
              Cache hit ratio
            </h3>
            <p class="mt-2 text-sm font-medium text-foreground">
              Edge cache serves most traffic.
            </p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Stale-while-revalidate tuning keeps origin requests quiet during peak hours.
            </p>
            <div class="mt-3 flex items-center gap-4 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
              <span class="inline-flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-foreground"></span>
                Served
              </span>
              <span class="inline-flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-foreground/15"></span>
                Origin
              </span>
            </div>
          </div>
        </div>
      </article>
    </div>

    @* CTA pair *@
    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <ButtonCn Class="w-full sm:w-[220px]">Explore metrics</ButtonCn>
      <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[170px]">View docs</ButtonCn>
    </div>
  </div>
</section>

@code {
    private record LinePoint(double X, double Y);
    private record BarDatum(string Label, int Value);

    private const int DonutValue = 73;
    private const double LineMaxY = 80;

    private static readonly LinePoint[] _linePoints =
    [
        new(0, 64), new(30, 58), new(60, 62), new(90, 48),
        new(120, 52), new(150, 38), new(180, 42), new(210, 28),
        new(240, 22), new(270, 14),
    ];

    private static readonly BarDatum[] _barData =
    [
        new("M", 42), new("T", 58), new("W", 71), new("T", 63),
        new("F", 85), new("S", 48), new("S", 36),
    ];

    private static readonly int[] _gridLines = [20, 40, 60];

    // Donut math
    private static readonly double _donutRadius = 28;
    private static readonly double _donutCircumference = 2 * Math.PI * _donutRadius;
    private static readonly double _donutOffset = _donutCircumference - (DonutValue / 100.0) * _donutCircumference;

    // Line chart paths
    private static readonly string _linePath = BuildLinePath();
    private static readonly string _areaPath = BuildAreaPath();

    // Uptime ticks: h = 4 + ((i * 7) % 18) for i = 0..17
    private static readonly int[] _uptimeTicks = BuildUptimeTicks();

    private static string BuildLinePath()
    {
        var parts = new System.Text.StringBuilder();
        for (int i = 0; i < _linePoints.Length; i++)
        {
            var p = _linePoints[i];
            parts.Append(i == 0 ? "M" : "L");
            parts.Append($" {p.X} {p.Y}");
            if (i < _linePoints.Length - 1) parts.Append(' ');
        }
        return parts.ToString();
    }

    private static string BuildAreaPath()
    {
        var last = _linePoints[_linePoints.Length - 1];
        return $"{BuildLinePath()} L {last.X} {LineMaxY} L 0 {LineMaxY} Z";
    }

    private static int[] BuildUptimeTicks()
    {
        var ticks = new int[18];
        for (int i = 0; i < 18; i++)
            ticks[i] = 4 + ((i * 7) % 18);
        return ticks;
    }
}
