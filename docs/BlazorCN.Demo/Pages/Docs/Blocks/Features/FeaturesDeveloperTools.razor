@* ============================================================
   Block: features-developer-tools
   Title: Features Developer Tools
   Description: A features block showcasing developer tool features with install commands
   Dependencies: None
   Source: original/blocks/features/features-developer-tools.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Developer Tools</h2>
            <p class="mt-1 text-xs text-muted-foreground">Everything you need to build and deploy</p>
        </div>

        @for (var i = 0; i < _tools.Length; i++)
        {
            var tool = _tools[i];
            <div class="@(i < _tools.Length - 1 ? "border-b" : "")">
                <div class="px-4 py-3">
                    <div class="flex items-start gap-3">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                        <div class="min-w-0 flex-1">
                            <p class="font-mono text-sm font-medium">@tool.Name</p>
                            <p class="mt-1 text-xs text-muted-foreground">@tool.Description</p>
                            <div class="mt-2 overflow-hidden rounded-md bg-muted/50">
                                <div class="px-3 py-2">
                                    <code class="font-mono text-xs text-muted-foreground">@tool.InstallCommand</code>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record DeveloperTool(string Name, string Description, string InstallCommand);

    private static readonly DeveloperTool[] _tools =
    [
        new("CLI", "Command-line interface for deployment, configuration, and project scaffolding", "npm install -g @acme/cli"),
        new("TypeScript SDK", "Fully typed client library with autocomplete, validation, and built-in error handling", "npm install @acme/sdk"),
        new("REST API", "RESTful API with OpenAPI spec, rate limiting, and automatic pagination support", "curl -H 'Authorization: Bearer $TOKEN' api.acme.com/v1"),
        new("GraphQL API", "Flexible GraphQL endpoint with schema introspection and real-time subscriptions", "npm install @acme/graphql-client"),
        new("Webhooks", "Event-driven notifications with retry logic, signature verification, and logs", "POST /webhooks/subscribe"),
        new("VS Code Extension", "IDE integration with IntelliSense, snippets, and inline documentation for rapid development", "code --install-extension acme.vscode-acme"),
    ];
}
