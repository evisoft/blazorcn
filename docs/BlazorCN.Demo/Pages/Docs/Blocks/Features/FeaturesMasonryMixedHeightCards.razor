@* ============================================================
   Block: features-masonry-mixed-height-cards
   Title: FeaturesMasonryMixedHeightCards
   Description: A Pinterest style masonry feature layout for React and Next.js with six mixed height cards that cascade across three columns using CSS columns and break-inside-avoid built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-masonry-mixed-height-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-14">

    @* Headline *@
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Everything you need
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Features that fit the shape of your work
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-muted-foreground sm:text-base">
        Some things need a paragraph. Some things need a number. Some things need a single line. This section lets each feature claim the space it actually needs.
      </p>
    </div>

    @* Masonry columns *@
    <div class="mt-10 columns-1 gap-4 md:columns-2 lg:columns-3 lg:gap-5">

      @* Card 1 — Tall: icon + title + 3 paragraph description *@
      <div class="mb-4 break-inside-avoid rounded-xl border bg-card p-5 sm:p-6">
        <span aria-hidden="true" class="flex size-9 items-center justify-center rounded-lg bg-muted text-foreground">
          <LucideIconCn Name="lock" Size="18" StrokeWidth="2" />
        </span>
        <h3 class="mt-4 text-base font-semibold text-foreground">End-to-end encryption</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Every document, message, and file is encrypted at rest with AES-256 and in transit
          with TLS 1.3. Keys are managed by a dedicated HSM and rotated every ninety days
          without any downtime or customer involvement.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          Customer-managed keys are available on the Enterprise plan with full audit trails so
          your compliance team can see exactly who accessed what and when.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          We undergo annual third-party penetration testing and publish the reports to customers
          under NDA.
        </p>
      </div>

      @* Card 2 — Short: icon + title + one liner *@
      <div class="mb-4 break-inside-avoid rounded-xl border bg-card p-5 sm:p-6">
        <div class="flex items-center gap-3">
          <span aria-hidden="true" class="flex size-9 items-center justify-center rounded-lg bg-muted text-foreground">
            <LucideIconCn Name="bolt" Size="18" StrokeWidth="2" />
          </span>
          <h3 class="text-base font-semibold text-foreground">Instant sync</h3>
        </div>
        <p class="mt-3 text-sm text-muted-foreground">
          Changes appear everywhere in under fifty milliseconds.
        </p>
      </div>

      @* Card 3 — Medium: icon + title + 2 sentence description + mini mockup *@
      <div class="mb-4 break-inside-avoid rounded-xl border bg-card p-5 sm:p-6">
        <span aria-hidden="true" class="flex size-9 items-center justify-center rounded-lg bg-muted text-foreground">
          <LucideIconCn Name="code" Size="18" StrokeWidth="2" />
        </span>
        <h3 class="mt-4 text-base font-semibold text-foreground">Developer API</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          A REST and GraphQL API covering every object in the platform. SDKs ship for
          TypeScript, Python, Go, and Ruby.
        </p>
        @* Mini mockup *@
        <div class="mt-4 overflow-hidden rounded-lg border bg-muted/40">
          <div class="flex items-center gap-1.5 border-b bg-background/50 px-3 py-1.5">
            <span class="size-1.5 rounded-full bg-foreground/20"></span>
            <span class="size-1.5 rounded-full bg-foreground/20"></span>
            <span class="size-1.5 rounded-full bg-foreground/20"></span>
            <span class="ml-2 font-mono text-[10px] text-muted-foreground">api.sh</span>
          </div>
          <div class="p-3 font-mono text-[11px] leading-relaxed">
            <p class="text-muted-foreground">$ curl api.example.com</p>
            <p class="text-foreground">@("{") "status": "ok" @("}")</p>
          </div>
        </div>
      </div>

      @* Card 4 — Tall: big stat + label + long description *@
      <div class="mb-4 break-inside-avoid rounded-xl border bg-card p-5 sm:p-6">
        <p class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
          Average uptime
        </p>
        <p class="mt-2 text-5xl font-bold tabular-nums tracking-tight text-foreground sm:text-6xl">
          99.99<span class="text-3xl text-muted-foreground">%</span>
        </p>
        <p class="mt-4 text-sm font-medium text-foreground">
          Measured across every region in the last twelve months.
        </p>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Our multi-region architecture routes around regional outages automatically, and our
          status page publishes incident postmortems within twenty-four hours of resolution.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          Enterprise customers get a written SLA with service credits tied directly to measured
          availability.
        </p>
      </div>

      @* Card 5 — Short: icon + title only *@
      <div class="mb-4 break-inside-avoid rounded-xl border bg-card p-5 sm:p-6">
        <div class="flex items-center gap-3">
          <span aria-hidden="true" class="flex size-9 items-center justify-center rounded-lg bg-muted text-foreground">
            <LucideIconCn Name="cloud" Size="18" StrokeWidth="2" />
          </span>
          <h3 class="text-base font-semibold text-foreground">Multi-cloud ready</h3>
        </div>
      </div>

      @* Card 6 — Medium: icon + title + quote pullout *@
      <div class="mb-4 break-inside-avoid rounded-xl border bg-card p-5 sm:p-6">
        <span aria-hidden="true" class="flex size-9 items-center justify-center rounded-lg bg-muted text-foreground">
          <LucideIconCn Name="users" Size="18" StrokeWidth="2" />
        </span>
        <h3 class="mt-4 text-base font-semibold text-foreground">
          Built for collaboration
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Realtime cursors, inline comments, and granular role permissions so teams of any size
          stay aligned.
        </p>
        <div class="mt-4 rounded-lg border-l-2 border-foreground/20 bg-muted/40 p-3">
          <LucideIconCn Name="quote" Size="14" StrokeWidth="2" Class="size-3.5 text-muted-foreground" />
          <p class="mt-1 text-sm italic leading-relaxed text-foreground">
            We replaced four tools with one and our ship cadence doubled in a single quarter.
          </p>
          <p class="mt-2 text-xs text-muted-foreground">Priya N. — Head of Product</p>
        </div>
      </div>

    </div>
  </div>
</section>
