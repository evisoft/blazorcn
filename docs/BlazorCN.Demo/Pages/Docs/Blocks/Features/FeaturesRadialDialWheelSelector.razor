@* ============================================================
   Block: features-radial-dial-wheel-selector
   Title: FeaturesRadialDialWheelSelector
   Description: A radial dial wheel selector features section for React and Next.js with a six-wedge SVG dial, click-to-select wedges, a spring-animated pointer needle, and a center detail panel built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-radial-dial-wheel-selector.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">

    @* Headline cluster *@
    <div class="max-w-xl">
        <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
            Six capability heads
        </span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            Turn the dial to a head.
        </h2>
        <p class="mt-3 text-base leading-relaxed text-muted-foreground">
            Every capability is a wedge on the same wheel. Click to rotate the needle — the hub
            always tells you exactly what the model is doing right now.
        </p>
    </div>

    @* Dial + legend *@
    <div class="mt-10 grid gap-8 rounded-2xl border bg-card p-6 md:grid-cols-[1fr_240px] md:gap-10 md:p-8">

        @* Dial *@
        <div class="flex items-center justify-center">
            <div
                class="relative w-full max-w-[420px]"
                role="radiogroup"
                aria-label="AI capability selector">

                <svg viewBox="0 0 400 400" class="h-auto w-full">
                    <title>AI capability dial</title>

                    @* Wedges *@
                    @foreach (var wedge in _wedges)
                    {
                        var i = Array.IndexOf(_wedges, wedge);
                        var isActive = i == _activeIndex;
                        var isHover = i == _hoverIndex;
                        var lp = WedgeLabelPosition(i);
                        var pathFill = isActive
                            ? ToneFill(wedge.Tone)
                            : isHover
                                ? "fill-muted stroke-border"
                                : "fill-muted/40 stroke-border";
                        var textFill = isActive ? "fill-foreground" : "fill-muted-foreground";
                        var captured = i;
                        <g>
                            <path
                                d="@WedgePath(i)"
                                class="@Cn.Merge("cursor-pointer transition-all duration-200", pathFill)"
                                stroke-width="1.5"
                                @onclick="@(() => _activeIndex = captured)"
                                @onmouseenter="@(() => _hoverIndex = captured)"
                                @onmouseleave="@(() => _hoverIndex = null)"
                                role="radio"
                                aria-checked="@(isActive ? "true" : "false")"
                                aria-label="@($"Select {wedge.Label}")"
                                tabindex="0" />
                            <text
                                x="@lp.X.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                y="@lp.Y.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                text-anchor="middle"
                                dominant-baseline="middle"
                                class="@Cn.Merge("pointer-events-none text-[11px] font-medium uppercase tracking-wider", textFill)">
                                @wedge.Label
                            </text>
                        </g>
                    }

                    @* Needle — static, rotated via transform *@
                    <g aria-hidden="true"
                       style="@(FormattableString.Invariant($"transform-origin:{Cx}px {Cy}px;transform:rotate({NeedleAngle()}deg);transition:transform 0.35s cubic-bezier(0.34,1.56,0.64,1)"))">
                        <line
                            x1="@Cx"
                            y1="@Cy"
                            x2="@Cx"
                            y2="@(Cy - RInner + 8)"
                            class="stroke-foreground"
                            stroke-width="2.5"
                            stroke-linecap="round" />
                        <circle cx="@Cx" cy="@(Cy - RInner + 8)" r="3" class="fill-foreground" />
                    </g>

                    @* Center hub *@
                    <circle
                        cx="@Cx"
                        cy="@Cy"
                        r="@(RInner - 6)"
                        class="fill-background stroke-border"
                        stroke-width="1" />
                    <circle cx="@Cx" cy="@Cy" r="4" class="fill-foreground" />
                </svg>

                @* Center overlay content (HTML, positioned over SVG hub) *@
                <div
                    class="pointer-events-none absolute inset-0 flex items-center justify-center"
                    aria-hidden="true">
                    @{
                        var activeWedge = _wedges[_activeIndex];
                        var hubWidth = (RInner * 2) / 2;
                    }
                    <div
                        class="flex flex-col items-center px-6 text-center"
                        style="@($"width:{hubWidth}px")">
                        <span class="flex size-8 items-center justify-center rounded-md border bg-card">
                            <LucideIconCn Name="@activeWedge.IconName" Size="16" Class="size-4 text-foreground" StrokeWidth="2" />
                        </span>
                        <div class="mt-2 text-[9px] font-medium uppercase tracking-widest text-muted-foreground">
                            @activeWedge.Label
                        </div>
                        <div class="mt-1 font-mono text-lg font-semibold text-foreground tabular-nums">
                            @activeWedge.MetricValue
                        </div>
                        <div class="text-[9px] text-muted-foreground">@activeWedge.MetricLabel</div>
                    </div>
                </div>

            </div>
        </div>

        @* Legend + active detail *@
        <div class="flex flex-col gap-6">

            @* Active detail *@
            <div>
                <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Now selected
                </div>
                @{
                    var detail = _wedges[_activeIndex];
                }
                <div>
                    <h3 class="mt-1.5 text-sm font-medium leading-snug text-foreground">
                        @detail.Headline
                    </h3>
                    <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                        @detail.Description
                    </p>
                </div>
            </div>

            @* Legend *@
            <div class="flex-1">
                <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    All heads
                </div>
                <ul class="mt-2 space-y-1">
                    @foreach (var wedge in _wedges)
                    {
                        var i = Array.IndexOf(_wedges, wedge);
                        var isActive = i == _activeIndex;
                        var captured = i;
                        var btnClass = isActive ? "bg-muted" : "hover:bg-muted/60";
                        var dotClass = isActive ? ToneDot(wedge.Tone) : "bg-muted-foreground/30";
                        var labelClass = isActive ? "flex-1 text-xs font-medium text-foreground" : "flex-1 text-xs text-muted-foreground";
                        <li>
                            <button
                                type="button"
                                @onclick="@(() => _activeIndex = captured)"
                                @onmouseenter="@(() => _hoverIndex = captured)"
                                @onmouseleave="@(() => _hoverIndex = null)"
                                class="@Cn.Merge("flex w-full items-center gap-2.5 rounded-md px-2 py-1.5 text-left transition-colors", btnClass)">
                                <span class="@Cn.Merge("size-1.5 rounded-full", dotClass)"></span>
                                <span class="@labelClass">@wedge.Label</span>
                                <span class="font-mono text-[10px] text-muted-foreground tabular-nums">@((i + 1).ToString().PadLeft(2, '0'))</span>
                            </button>
                        </li>
                    }
                </ul>
            </div>

            @* Rotate controls *@
            <div class="flex items-center justify-between gap-2 border-t pt-4">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Rotate
                </span>
                <div class="flex items-center gap-1">
                    <button
                        type="button"
                        @onclick="@(() => RotateBy(-1))"
                        class="flex size-7 items-center justify-center rounded-md border bg-background text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                        aria-label="Previous wedge">
                        &#8592;
                    </button>
                    <button
                        type="button"
                        @onclick="@(() => RotateBy(1))"
                        class="flex size-7 items-center justify-center rounded-md border bg-background text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                        aria-label="Next wedge">
                        &#8594;
                    </button>
                </div>
            </div>

        </div>
    </div>

</section>

@code {
    // Dial geometry constants
    private const int Cx = 200;
    private const int Cy = 200;
    private const int ROuter = 180;
    private const int RInner = 96;
    private const int SegmentCount = 6;
    private const double SegmentAngle = 360.0 / SegmentCount;
    private const double GapDeg = 1.5;

    private int _activeIndex = 0;
    private int? _hoverIndex = null;

    private record DialWedge(string Id, string Label, string IconName, string Headline, string Description, string MetricLabel, string MetricValue, string Tone);

    private static readonly DialWedge[] _wedges =
    [
        new("reasoning", "Reasoning", "brain-circuit",
            "Chain-of-thought built into every call",
            "The planner decomposes ambiguous prompts into ordered subgoals, executes each one against the right tool, and stitches the results back into a single grounded answer.",
            "Bench (MMLU)", "89.2", "emerald"),
        new("vision", "Vision", "eye",
            "Pixel-accurate scene understanding",
            "Upload raw frames, PDFs, or charts and get grounded bounding boxes, extracted tables, and OCR results in a single pass. Handles handwriting and rotated documents.",
            "OCR F1", "0.972", "blue"),
        new("code", "Code", "code",
            "Repository-aware code synthesis",
            "The code head ingests your lockfile, tsconfig, and public exports so suggestions compile on first run. Repairs broken imports and preserves your formatter's style.",
            "HumanEval", "92%", "emerald"),
        new("audio", "Audio", "audio-lines",
            "Real-time streaming speech and music",
            "Word-level timestamps at 150ms end-to-end latency, diarization for up to 16 speakers, and music stems that separate vocals from instruments without phase smearing.",
            "WER (en-US)", "3.4%", "blue"),
        new("memory", "Memory", "database",
            "Persistent context that survives sessions",
            "A built-in vector store scoped per user or workspace, automatic summarization that compresses stale turns, and a revocation API so deletion is always honored.",
            "Recall@10", "0.88", "amber"),
        new("tools", "Tools", "wrench",
            "Function calling with strict schemas",
            "Tool calls validate against your Zod schema before the model even sees the result. Structured outputs stream incrementally so your UI can render as the JSON lands.",
            "Valid JSON", "99.8%", "emerald"),
    ];

    private static string ToneDot(string tone) => tone switch
    {
        "emerald" => "bg-emerald-500",
        "blue"    => "bg-blue-500",
        "amber"   => "bg-amber-500",
        _         => "bg-muted-foreground/30",
    };

    private static string ToneFill(string tone) => tone switch
    {
        "emerald" => "fill-emerald-500/20 stroke-emerald-500",
        "blue"    => "fill-blue-500/20 stroke-blue-500",
        "amber"   => "fill-amber-500/20 stroke-amber-500",
        _         => "fill-muted/40 stroke-border",
    };

    private static (double X, double Y) Polar(int cx, int cy, double r, double angleDeg)
    {
        var rad = (angleDeg - 90.0) * Math.PI / 180.0;
        return (cx + r * Math.Cos(rad), cy + r * Math.Sin(rad));
    }

    private static string WedgePath(int index)
    {
        var startAngle = index * SegmentAngle + GapDeg / 2.0;
        var endAngle   = (index + 1) * SegmentAngle - GapDeg / 2.0;
        var (osx, osy) = Polar(Cx, Cy, ROuter, startAngle);
        var (oex, oey) = Polar(Cx, Cy, ROuter, endAngle);
        var (isx, isy) = Polar(Cx, Cy, RInner, startAngle);
        var (iex, iey) = Polar(Cx, Cy, RInner, endAngle);
        var largeArc   = endAngle - startAngle > 180 ? 1 : 0;

        return string.Join(" ", new[]
        {
            FormattableString.Invariant($"M {osx:F2} {osy:F2}"),
            FormattableString.Invariant($"A {ROuter} {ROuter} 0 {largeArc} 1 {oex:F2} {oey:F2}"),
            FormattableString.Invariant($"L {iex:F2} {iey:F2}"),
            FormattableString.Invariant($"A {RInner} {RInner} 0 {largeArc} 0 {isx:F2} {isy:F2}"),
            "Z",
        });
    }

    private static (double X, double Y) WedgeLabelPosition(int index)
    {
        var midAngle = index * SegmentAngle + SegmentAngle / 2.0;
        var r = (ROuter + RInner) / 2.0;
        return Polar(Cx, Cy, r, midAngle);
    }

    private double NeedleAngle() => _activeIndex * SegmentAngle + SegmentAngle / 2.0;

    private void RotateBy(int direction)
    {
        _activeIndex = (_activeIndex + direction + SegmentCount) % SegmentCount;
    }
}
