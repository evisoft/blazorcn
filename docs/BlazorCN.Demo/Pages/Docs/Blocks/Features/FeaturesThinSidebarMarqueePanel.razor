@* ============================================================
   Block: features-thin-sidebar-marquee-panel
   Title: FeaturesThinSidebarMarqueePanel
   Description: A thin icon-only sidebar master-detail features section for React and Next.js with a w-16 vertical icon rail, hover tooltips, and a large marquee text-3xl detail panel with crosshair image placeholder built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-thin-sidebar-marquee-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="grid lg:grid-cols-[64px_1fr]">
      @* Thin icon rail *@
      <div class="flex flex-row gap-1 overflow-x-auto border-b bg-muted/30 p-2 lg:flex-col lg:gap-2 lg:overflow-visible lg:border-b-0 lg:border-r lg:p-3">
        @foreach (var feat in _features)
        {
          var feature = feat;
          var isActive = feature.Id == _activeId;
          <button
            type="button"
            title="@feature.Title"
            aria-pressed="@(isActive ? "true" : "false")"
            @onclick="@(() => _activeId = feature.Id)"
            class="@Cn.Merge(
              "group relative flex size-10 shrink-0 items-center justify-center rounded-lg transition-colors",
              "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground/20",
              isActive
                ? "bg-foreground text-background"
                : "text-muted-foreground hover:bg-muted hover:text-foreground"
            )"
          >
            <span class="sr-only">@feature.Title</span>
            <LucideIconCn Name="@feature.Icon" Size="16" Class="size-4" />
          </button>
        }
      </div>

      @* Marquee detail panel *@
      <div class="relative p-8 sm:p-12 lg:p-14" aria-live="polite">
        @{
          var activeFeature = _features.FirstOrDefault(f => f.Id == _activeId) ?? _features[0];
          var activeIndex = System.Array.IndexOf(_features, activeFeature);
        }
        <div>
          <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Feature @(activeIndex + 1) of @_features.Length
          </p>
          <h2 class="mt-3 max-w-xl text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            @activeFeature.Title
          </h2>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-muted-foreground">
            @activeFeature.Description
          </p>

          @* Crosshair image placeholder *@
          <div class="mt-8 flex aspect-[4/3] w-full max-w-2xl items-center justify-center rounded-xl bg-muted">
            <div class="relative flex items-center justify-center">
              <div
                aria-hidden="true"
                class="absolute size-24 rounded-full border border-muted-foreground/[0.06]"
              />
              <div
                aria-hidden="true"
                class="absolute size-14 rounded-full border border-muted-foreground/[0.08]"
              />
              <div
                aria-hidden="true"
                class="absolute h-px w-32 bg-muted-foreground/[0.06]"
              />
              <div
                aria-hidden="true"
                class="absolute h-32 w-px bg-muted-foreground/[0.06]"
              />
              <div class="flex size-8 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

@code {
    private string _activeId = "realtime";

    private record Feature(string Id, string Icon, string Title, string Description);

    private static readonly Feature[] _features =
    [
        new Feature("realtime", "zap",
            "Realtime sync across every surface",
            "Changes propagate to every connected client in under 80ms through a persistent websocket mesh. Live cursors, presence, and collaborative edits land without polling — and reconnection queues keep offline sessions consistent when a laptop wakes up."),
        new Feature("edge", "globe",
            "Deployed to 300+ edge regions",
            "A single git push ships your app to the closest point of presence for every visitor on earth. Smart routing, cache warming, and automatic SSL mean response times stay under 50ms on every continent — without a platform engineer babysitting the infra."),
        new Feature("security", "shield",
            "Enterprise-grade security by default",
            "SOC 2 Type II, ISO 27001, and HIPAA BAAs come standard on every paid plan. SAML SSO, SCIM provisioning, per-organization KMS keys, and immutable audit logs are toggles — not upsells — so compliance teams stop being the bottleneck on rollout."),
        new Feature("workflow", "workflow",
            "Composable automation builder",
            "Chain triggers, conditions, and actions into visual pipelines that run on our edge workers. Every step is versioned, every run is replayable, and failures route to a Slack channel with a one-click retry — so automations feel like code without shipping code."),
        new Feature("analytics", "bar-chart-3",
            "First-party analytics you own",
            "Every event your product emits is stored in your workspace, queryable via SQL, and exportable to Snowflake, BigQuery, or S3. Dashboards are built in seconds, funnels are built without a data team, and GDPR deletion runs in the background."),
        new Feature("ai", "sparkles",
            "AI copilots wired into your data",
            "Semantic search, autocomplete, and retrieval-augmented chat are one line of code away. Bring your own OpenAI or Anthropic key, or use our managed inference with token-level billing and per-organization rate limits — no vector database plumbing required."),
    ];
}
