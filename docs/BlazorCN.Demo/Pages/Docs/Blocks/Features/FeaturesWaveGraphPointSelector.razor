@* ============================================================
   Block: features-wave-graph-point-selector
   Title: FeaturesWaveGraphPointSelector
   Description: A wave graph point selector features section for React and Next.js with an SVG smooth-curve line chart, six clickable data points, hover tooltips, and a detail panel that updates with the active milestone built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-wave-graph-point-selector.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Headline *@
    <div class="max-w-xl">
      <div class="flex items-center gap-2">
        <span class="flex size-6 items-center justify-center rounded-md border bg-background">
          <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-muted-foreground" />
        </span>
        <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
          The growth curve
        </span>
      </div>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Six milestones, one arc.
      </h2>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">
        Click any point on the curve to inspect the milestone. The trajectory is the story —
        activation leads retention which leads expansion.
      </p>
    </div>

    @* Chart frame *@
    <div class="mt-10 overflow-hidden rounded-xl border bg-card">
      <div class="relative px-6 py-6">
        @* Y-axis labels *@
        <div class="absolute left-3 top-6 flex h-[220px] flex-col justify-between py-5 text-[9px] font-medium text-muted-foreground">
          <span>High</span>
          <span>Mid</span>
          <span>Low</span>
        </div>

        @* SVG chart *@
        <div class="ml-6">
          <svg
            viewBox="0 0 600 220"
            class="h-[220px] w-full overflow-visible"
            role="img"
            aria-label="Growth milestone line chart with six interactive data points"
          >
            <title>Growth milestone curve from acquisition to expansion</title>

            @* Grid lines *@
            @foreach (var ratio in _gridRatios)
            {
              var gy = ChartPaddingTop + (ChartHeight - ChartPaddingTop - ChartPaddingBottom) * ratio;
              <line
                x1="@ChartPaddingX"
                y1="@(FormattableString.Invariant($"{gy}"))"
                x2="@(ChartWidth - ChartPaddingX)"
                y2="@(FormattableString.Invariant($"{gy}"))"
                class="stroke-muted"
                stroke-dasharray="2 4"
                stroke-width="1"
              />
            }

            @* Baseline *@
            <line
              x1="@ChartPaddingX"
              y1="@(ChartHeight - ChartPaddingBottom)"
              x2="@(ChartWidth - ChartPaddingX)"
              y2="@(ChartHeight - ChartPaddingBottom)"
              class="stroke-border"
              stroke-width="1"
            />

            @* Area fill *@
            <path
              d="@AreaPath"
              class="fill-foreground/5"
            />

            @* Spline *@
            <path
              d="@SplinePath"
              fill="none"
              class="stroke-foreground"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />

            @* Hover line *@
            @if (_hoverIndex.HasValue && _hoverIndex.Value != _activeIndex)
            {
              var hpt = Points[_hoverIndex.Value];
              <line
                x1="@(FormattableString.Invariant($"{hpt.X}"))"
                y1="@ChartPaddingTop"
                x2="@(FormattableString.Invariant($"{hpt.X}"))"
                y2="@(ChartHeight - ChartPaddingBottom)"
                class="stroke-muted-foreground/40"
                stroke-dasharray="2 3"
                stroke-width="1"
              />
            }

            @* Data points *@
            @foreach (var ms in _milestones)
            {
              var mi = ms;
              var idx = Array.IndexOf(_milestones, mi);
              var pt = Points[idx];
              var isActive = idx == _activeIndex;
              var isHover = idx == _hoverIndex;
              var dotClass = isActive
                ? "pointer-events-none transition-colors fill-foreground"
                : "pointer-events-none transition-colors fill-background stroke-foreground";
              var dotR = isActive ? 6 : (isHover ? 5 : 4);
              <g>
                @* Invisible larger hit target *@
                <circle
                  cx="@(FormattableString.Invariant($"{pt.X}"))"
                  cy="@(FormattableString.Invariant($"{pt.Y}"))"
                  r="18"
                  fill="transparent"
                  class="cursor-pointer"
                  @onmouseenter="@(() => _hoverIndex = idx)"
                  @onmouseleave="@(() => _hoverIndex = null)"
                  @onclick="@(() => _activeIndex = idx)"
                />
                @* Ring when active *@
                @if (isActive)
                {
                  <circle
                    cx="@(FormattableString.Invariant($"{pt.X}"))"
                    cy="@(FormattableString.Invariant($"{pt.Y}"))"
                    r="12"
                    class="fill-foreground/10"
                  />
                }
                @* Core dot *@
                <circle
                  cx="@(FormattableString.Invariant($"{pt.X}"))"
                  cy="@(FormattableString.Invariant($"{pt.Y}"))"
                  r="@dotR"
                  class="@dotClass"
                  stroke-width="2"
                />
              </g>
            }

            @* Active tooltip *@
            <g transform="@(FormattableString.Invariant($"translate({Points[_activeIndex].X},{Points[_activeIndex].Y})"))">
              <g transform="translate(0, -24)">
                <rect
                  x="-42"
                  y="-14"
                  width="84"
                  height="20"
                  rx="4"
                  class="fill-popover stroke-border"
                  stroke-width="1"
                />
                <text
                  x="0"
                  y="0"
                  text-anchor="middle"
                  class="fill-popover-foreground font-mono text-[10px]"
                >
                  @_milestones[_activeIndex].Week · @_milestones[_activeIndex].Value
                </text>
              </g>
            </g>
          </svg>

          @* X-axis labels *@
          <div class="mt-2 grid grid-cols-6 gap-1">
            @foreach (var ms in _milestones)
            {
              var mi = ms;
              var idx = Array.IndexOf(_milestones, mi);
              var isActive = idx == _activeIndex;
              <button
                type="button"
                @onclick="@(() => _activeIndex = idx)"
                aria-pressed="@(isActive ? @"true" : @"false")"
                class="@(Cn.Merge("text-center font-mono text-[10px] tabular-nums transition-colors", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground"))"
              >
                @mi.Week
              </button>
            }
          </div>
        </div>
      </div>

      @* Detail panel *@
      <div class="flex gap-6 border-t bg-muted/20 px-6 py-6">
        <div class="flex-1">
          <div class="flex items-center gap-2">
            <span class="flex size-7 items-center justify-center rounded-md border bg-background">
              <LucideIconCn Name="@_iconNames[_activeIndex]" Size="14" Class="size-3.5 text-foreground" />
            </span>
            <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
              @_milestones[_activeIndex].Week
            </span>
          </div>
          <h3 class="mt-3 text-lg font-semibold leading-tight text-foreground">
            @_milestones[_activeIndex].Title
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            @_milestones[_activeIndex].Description
          </p>
        </div>
        <div class="hidden w-[160px] shrink-0 flex-col justify-between rounded-lg border bg-background p-4 md:flex">
          <div>
            <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
              @_milestones[_activeIndex].MetricLabel
            </div>
            <div class="mt-1 font-mono text-2xl font-semibold text-foreground tabular-nums">
              @_milestones[_activeIndex].MetricValue
            </div>
          </div>
          <div class="flex items-center gap-1 text-xs font-medium text-emerald-600 dark:text-emerald-400">
            <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3" />
            <span class="tabular-nums">@_milestones[_activeIndex].Delta</span>
            <span class="text-muted-foreground">week-over-week</span>
          </div>
        </div>
      </div>
    </div>

    @* Footer *@
    <div class="mt-8 flex flex-col items-center gap-4">
      <p class="text-xs text-muted-foreground">
        Data points connect. Hover any dot to compare.
      </p>
      <div class="flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:items-center sm:justify-center">
        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[300px]">
          Read the growth playbook
        </ButtonCn>
        <ButtonCn Class="w-full sm:w-[260px]">
          Model your own curve
        </ButtonCn>
      </div>
    </div>
  </div>
</section>

@code {
    private record Milestone(
        string Id,
        string Week,
        int Value,
        string Title,
        string Description,
        string MetricLabel,
        string MetricValue,
        string Delta
    );

    private record SvgPoint(double X, double Y);

    private const int ChartWidth = 600;
    private const int ChartHeight = 220;
    private const int ChartPaddingX = 40;
    private const int ChartPaddingTop = 20;
    private const int ChartPaddingBottom = 30;

    private static readonly double[] _gridRatios = [0.25, 0.5, 0.75];

    private static readonly Milestone[] _milestones =
    [
        new("acquisition", "Week 1",  22, "Acquisition",
            "Visitors arrive from organic search, a Product Hunt launch, and a referral link from a public playground. First impressions measure dwell time, not just pageviews.",
            "Weekly signups", "1,284", "+28%"),
        new("activation",  "Week 2",  38, "Activation",
            "New accounts complete their first meaningful action inside ten minutes. We measure activation as 'reached the first aha moment' — not just 'finished signup'.",
            "Activation rate", "64%", "+11pts"),
        new("retention",   "Week 4",  54, "Retention",
            "Day 7 and day 28 cohorts stabilize. Weekly active users start looking like a flat line with a slight upward tilt — the sign of a healthy retention curve.",
            "D28 retention", "41%", "+6pts"),
        new("referral",    "Week 6",  68, "Referral",
            "Active users start inviting teammates. The viral coefficient breaks through 0.4 and referral traffic becomes a top-three acquisition channel by volume.",
            "K-factor", "0.42", "+0.18"),
        new("revenue",     "Week 8",  82, "Revenue",
            "Paid conversions arrive from the retained cohort. Median time-to-revenue from signup is 21 days and the annual plan is chosen 58% of the time at checkout.",
            "MRR", "$48.2k", "+32%"),
        new("expansion",   "Week 12", 94, "Expansion",
            "Existing accounts upgrade plans and add seats. Net revenue retention crosses 115% which is the threshold where growth compounds without new acquisition spend.",
            "NRR", "118%", "+14pts"),
    ];

    private static readonly string[] _iconNames =
    [
        "users",
        "zap",
        "repeat",
        "heart-handshake",
        "trending-up",
        "layers",
    ];

    private int _activeIndex = 2;
    private int? _hoverIndex = null;

    private SvgPoint[] Points
    {
        get
        {
            var usableWidth = ChartWidth - ChartPaddingX * 2.0;
            var usableHeight = ChartHeight - ChartPaddingTop - ChartPaddingBottom;
            var pts = new SvgPoint[_milestones.Length];
            for (var i = 0; i < _milestones.Length; i++)
            {
                pts[i] = new SvgPoint(
                    ChartPaddingX + (i / (double)(_milestones.Length - 1)) * usableWidth,
                    ChartPaddingTop + usableHeight - (_milestones[i].Value / 100.0) * usableHeight
                );
            }
            return pts;
        }
    }

    private string SplinePath
    {
        get
        {
            var points = Points;
            if (points.Length < 2) return "";
            var segments = new System.Text.StringBuilder();
            segments.Append(FormattableString.Invariant($"M {points[0].X:F2} {points[0].Y:F2}"));
            for (var i = 0; i < points.Length - 1; i++)
            {
                var p0 = i > 0 ? points[i - 1] : points[i];
                var p1 = points[i];
                var p2 = points[i + 1];
                var p3 = i + 2 < points.Length ? points[i + 2] : p2;
                var c1x = p1.X + (p2.X - p0.X) / 6.0;
                var c1y = p1.Y + (p2.Y - p0.Y) / 6.0;
                var c2x = p2.X - (p3.X - p1.X) / 6.0;
                var c2y = p2.Y - (p3.Y - p1.Y) / 6.0;
                segments.Append(FormattableString.Invariant($" C {c1x:F2} {c1y:F2}, {c2x:F2} {c2y:F2}, {p2.X:F2} {p2.Y:F2}"));
            }
            return segments.ToString();
        }
    }

    private string AreaPath
    {
        get
        {
            var points = Points;
            var spline = SplinePath;
            var lastX = points[points.Length - 1].X;
            var firstX = points[0].X;
            var bottomY = ChartHeight - ChartPaddingBottom;
            return FormattableString.Invariant($"{spline} L {lastX:F2} {bottomY} L {firstX:F2} {bottomY} Z");
        }
    }
}
