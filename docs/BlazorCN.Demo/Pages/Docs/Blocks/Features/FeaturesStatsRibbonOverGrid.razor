@* ============================================================
   Block: features-stats-ribbon-over-grid
   Title: FeaturesStatsRibbonOverGrid
   Description: A features section for React and Next.js with a compact pill-shaped stats ribbon above a three-cell feature grid and dual CTAs built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-stats-ribbon-over-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">

    @* Stats ribbon — compact pill-shaped credibility bar *@
    <div class="mx-auto flex w-fit max-w-full flex-col items-center gap-2 rounded-full bg-muted/50 px-6 py-3 sm:flex-row sm:gap-4">
      @foreach (var statItem in _stats)
      {
        var idx = Array.IndexOf(_stats, statItem);
        <div class="flex items-center gap-4">
          @if (idx > 0)
          {
            <span aria-hidden="true" class="hidden size-1 rounded-full bg-muted-foreground/50 sm:block"></span>
          }
          <span class="whitespace-nowrap text-xs font-medium text-foreground">@statItem</span>
        </div>
      }
    </div>

    @* Headline cluster *@
    <div class="mx-auto mt-8 max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        @_headline.Eyebrow
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        @_headline.Title
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        @_headline.Subtitle
      </p>
    </div>

    @* 3-cell feature grid *@
    <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-3 lg:gap-10">
      @foreach (var feature in _features)
      {
        <div class="rounded-xl border bg-card p-6">
          <div aria-hidden="true" class="flex size-10 items-center justify-center rounded-lg bg-muted">
            <LucideIconCn Name="@feature.IconName" Size="20" Class="size-5 text-foreground" />
          </div>
          <h3 class="mt-4 text-base font-semibold text-foreground">@feature.Title</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
            @feature.Description
          </p>
        </div>
      }
    </div>

    @* Dual CTA row *@
    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
      <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">See pricing</ButtonCn>
    </div>

  </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureData(string Id, string Title, string Description, string IconName);

    private static readonly HeadlineData _headline = new(
        "Platform overview",
        "Ship faster on infrastructure you can trust",
        "Three capabilities that cover deployment, visibility, and compliance — already powering product teams from early-stage startups to Fortune 500s."
    );

    private static readonly string[] _stats = ["10k+ teams", "99.9% uptime", "40+ integrations", "SOC 2 Type II"];

    private static readonly FeatureData[] _features =
    [
        new("deploy", "Zero-downtime deploys", "Blue-green rollouts and automatic rollbacks so every release ships without scheduled maintenance windows.", "layers"),
        new("observe", "Built-in observability", "Structured logs, traces, and metrics streamed to a unified dashboard with no agent installation required.", "line-chart"),
        new("comply", "Compliance by default", "SOC 2 Type II controls, region-locked data residency, and audit exports available on every paid plan.", "shield-check"),
    ];
}
