@* ============================================================
   Block: features-faq-style
   Title: Features FAQ Style
   Description: Features presented as question and answer pairs, ideal for educational content and feature explanations
   Dependencies: None
   Source: original/blocks/features/features-faq-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">How It Works</h2>
            <p class="mt-1 text-xs text-muted-foreground">Common questions about our features</p>
        </div>

        @for (var i = 0; i < _features.Length; i++)
        {
            var feature = _features[i];
            <div class="@Cn.Merge("px-4 py-4", i < _features.Length - 1 ? "border-b" : "")">
                <h3 class="text-sm font-medium">@feature.Question</h3>
                <p class="mt-2 text-sm text-muted-foreground">@feature.Answer</p>
            </div>
        }
    </div>
</section>

@code {
    private record FeatureQA(string Question, string Answer);

    private static readonly FeatureQA[] _features =
    [
        new("How does real-time collaboration work?",
            "Multiple team members can edit the same document simultaneously with operational transformation. You'll see live cursors showing who's editing where, with changes appearing instantly. Conflicts are resolved automatically using last-write-wins with undo support."),
        new("What makes the deployment process instant?",
            "We maintain a warm pool of pre-configured containers ready to accept your code. When you push changes, we diff your new build against the previous version and only transfer what changed. Most deployments complete in under 10 seconds from push to live."),
        new("How are analytics collected without cookies?",
            "We use server-side fingerprinting based on IP address, user agent, and timing patterns. This provides session tracking without storing identifiers on the client. All data is anonymized after 24 hours and aggregated for reporting."),
        new("What type of automation workflows can I create?",
            "Build multi-step workflows triggered by events like form submissions, scheduled times, or webhook calls. Each step can call external APIs, transform data, send notifications, or update your database. Conditional logic and loops are supported through a visual editor."),
        new("How does smart caching improve performance?",
            "Our ML model analyzes your traffic patterns to predict which pages users will visit next. We pre-populate edge caches based on these predictions. When content changes, the dependency graph automatically purges related cached entries without manual intervention."),
        new("Can I revert to previous versions of my content?",
            "Every change creates a snapshot with full version history. You can compare any two versions with a visual diff viewer, restore individual fields or entire documents, and create branches for major updates before merging them back to production."),
    ];
}
