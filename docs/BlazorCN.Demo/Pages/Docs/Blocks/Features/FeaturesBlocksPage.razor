    );

    private const int DurationSeconds = 102;
    private const string _durationDisplay = ""1:42"";

    private static readonly Chapter[] _chapters =
    [
        new(""signup"", ""0:00"", ""Create your workspace"",
            ""Sign up with email or SSO and spin up a workspace in under ten seconds. No credit card, no seat counting."",
