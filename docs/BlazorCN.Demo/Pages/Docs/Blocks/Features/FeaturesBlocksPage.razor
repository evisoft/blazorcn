                var value = bars[i];
                var barHeight = Math.Max(2.0, (value / 100.0) * svgHeight);
                var x = i * (barWidth + gap);
                var y = (svgHeight - barHeight) / 2.0;
                <rect x=""@x.ToString(""F2"")""
                      y=""@y.ToString(""F2"")""
                      width=""@barWidth.ToString(""F2"")""
                      height=""@barHeight.ToString(""F2"")""
