            [""Schema auto-detection"", ""OAuth connectors"", ""Dry-run preview""],
            ""settings"",
            [new(""Sources"", ""38""), new(""Connectors"", ""OAuth ready""), new(""Tables"", ""Auto-mapped"")]),

        new(""invite"", ""0:28"", ""Invite your teammates"",
            ""Drop a share link into Slack and the whole team lands inside the same workspace with role-based scopes applied."",
            [""Role templates"", ""Share link with scopes"", ""Slack deep link""],
            ""users"",
            [new(""Roles"", ""Admin, Editor, Viewer""), new(""Domain lock"", ""On""), new(""Invites sent"", ""12"")]),

        new(""first-action"", ""0:45"", ""Run your first action"",
            ""Trigger a workflow from the inline runner and watch it execute with live streaming logs and per-step diffs."",
            [""Streaming logs"", ""Per-step diff"", ""Rollback in one click""],
            ""zap"",
            [new(""Run duration"", ""1.2s""), new(""Steps"", ""6 / 6""), new(""Status"", ""Success"")]),

        new(""insights"", ""1:08"", ""Inspect the insights"",
            ""Auto-generated dashboards surface cohort activity, drop-off points, and the top fifty events without any config."",
            [""Cohort explorer"", ""Drop-off funnel"", ""Top event leaderboard""],
            ""bar-chart-3"",
            [new(""Dashboards"", ""Auto-built""), new(""Retention 7d"", ""64%""), new(""Top event"", ""run.complete"")]),

        new(""scale"", ""1:30"", ""Scale without the ops"",
            ""Promote to production and the fleet auto-scales against your latency budget. No cluster, no Terraform."",
            [""Latency SLO auto-scale"", ""Multi-region failover"", ""Zero-downtime deploys""],
            ""line-chart"",
            [new(""p95 latency"", ""42ms""), new(""Regions"", ""6 active""), new(""Uptime"", ""99.99%"")]),
    ];

    private int _activeIndex = 2;
    private bool _isPlaying = false;
    private double? _hoverPct = null;
    private int? _hoveredChapterIndex = null;
    // Running max of OffsetX seen on the track — used as width estimate so we can
    // compute a percentage without a JS getBoundingClientRect call.
    private double _trackWidthEstimate = 600;

    private double ActivePct => TimestampToPercent(_chapters[_activeIndex].Timestamp);

    private static int TimestampToSeconds(string stamp)
    {
        var parts = stamp.Split(':');
        return int.Parse(parts[0]) * 60 + int.Parse(parts[1]);
    }

    private static double TimestampToPercent(string stamp)
        => (double)TimestampToSeconds(stamp) / DurationSeconds * 100.0;

    private void SetActiveIndex(int index)
    {
        _activeIndex = index;
    }

    private void HandleTrackHover(MouseEventArgs e)
    {
        // Keep a running max to estimate the track element width without JS interop.
        if (e.OffsetX > _trackWidthEstimate)
            _trackWidthEstimate = e.OffsetX;

        var pct = Math.Max(0, Math.Min(100, e.OffsetX / _trackWidthEstimate * 100.0));
        _hoverPct = pct;

        // Find closest chapter to the hovered pct position.
        double closestDist = double.MaxValue;
        int closestIdx = 0;
        for (int ci = 0; ci < _chapters.Length; ci++)
        {
            var chapterPct = TimestampToPercent(_chapters[ci].Timestamp);
            var dist = Math.Abs(chapterPct - pct);
            if (dist < closestDist)
            {
                closestDist = dist;
                closestIdx = ci;
            }
        }
        _hoveredChapterIndex = closestIdx;
    }

    private void HandleTrackLeave()
    {
        _hoverPct = null;
        _hoveredChapterIndex = null;
    }

    private void HandleTrackClick(MouseEventArgs e)
    {
        // Jump to the chapter nearest to the clicked position on the track.
        var pct = Math.Max(0, Math.Min(100, e.OffsetX / _trackWidthEstimate * 100.0));
        double closestDist = double.MaxValue;
        int closestIdx = _activeIndex;
        for (int ci = 0; ci < _chapters.Length; ci++)
        {
            var chapterPct = TimestampToPercent(_chapters[ci].Timestamp);
            var dist = Math.Abs(chapterPct - pct);
            if (dist < closestDist)
            {
                closestDist = dist;
                closestIdx = ci;
            }
        }
        _activeIndex = closestIdx;
    }
}";

