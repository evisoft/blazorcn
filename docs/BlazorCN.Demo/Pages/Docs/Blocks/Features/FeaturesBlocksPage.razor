                    <p class=""mt-1.5 text-xs leading-relaxed text-muted-foreground"">@feature.Description</p>
                </div>
                <div class=""@(isReversed ? ""md:order-1"" : """")"">
                    <div class=""flex aspect-[16/10] items-center justify-center rounded-md border bg-muted/50"">
