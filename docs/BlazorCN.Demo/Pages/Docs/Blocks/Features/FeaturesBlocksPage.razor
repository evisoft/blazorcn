@code {
    private class FeatureNode
    {
        public string Id { get; set; } = """";
        public string Name { get; set; } = """";
        public string? Description { get; set; }
        public FeatureNode[]? Children { get; set; }
    }

    private HashSet<string> _expandedCategories = [];

    private void ToggleCategory(string id)
    {
        if (!_expandedCategories.Remove(id)) _expandedCategories.Add(id);
    }

    private RenderFragment RenderTreeNode(FeatureNode node, int level) => __builder =>
    {
        var hasChildren = node.Children is { Length: > 0 };
        var isExpanded = _expandedCategories.Contains(node.Id);

        <button type=""button""
                class=""@Cn.Merge(""flex w-full items-start gap-2 px-4 py-2.5 text-left transition-colors"", hasChildren ? ""hover:bg-muted/50"" : ""cursor-default"")""
                style=""padding-left: @(level * 16 + 16)px""
                @onclick=""@(() => { if (hasChildren) ToggleCategory(node.Id); })"">
            @if (hasChildren)
            {
                <LucideChevronRightCn Class=""@Cn.Merge(""mt-0.5 h-4 w-4 shrink-0 text-muted-foreground/60 transition-transform duration-200"", isExpanded ? ""rotate-90"" : """")"" Size=""16"" />
            }
            else
            {
                <span class=""h-4 w-4 shrink-0""></span>
            }
            <div class=""min-w-0 flex-1"">
                <div class=""@Cn.Merge(""text-sm"", hasChildren ? ""font-medium"" : """")"">@node.Name</div>
                @if (node.Description != null)
                {
                    <div class=""mt-0.5 text-xs text-muted-foreground"">@node.Description</div>
                }
            </div>
        </button>

        @if (hasChildren && isExpanded)
        {
            @foreach (var child in node.Children!)
            {
                @RenderTreeNode(child, level + 1)
            }
        }
    };

