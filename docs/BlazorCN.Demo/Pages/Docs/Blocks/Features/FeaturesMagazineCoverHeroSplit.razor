    private static readonly int[] _barHeights = [3, 2, 4, 1, 3, 5, 2, 3, 1, 4, 2, 5, 3, 1, 4];

    private static readonly InsideArticle[] _insideArticles =
    [
        new("inside-1", "12", "Cover story",
