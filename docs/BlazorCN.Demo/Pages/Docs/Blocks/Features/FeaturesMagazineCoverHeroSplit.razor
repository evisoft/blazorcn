@* ============================================================
   Block: features-magazine-cover-hero-split
   Title: FeaturesMagazineCoverHeroSplit
   Description: A magazine cover hero split features section for React and Next.js with a monogram cover art panel and an "Inside this issue" article list built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-magazine-cover-hero-split.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                The spring issue
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Six stories. One masthead.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every release gets the same editorial treatment — a cover you would read in a waiting
                room, and a contents list that tells you why.
            </p>
        </div>

        @* Magazine split *@
        <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-[2fr_3fr] lg:gap-8">
            @* Cover art panel *@
            <div class="relative flex flex-col overflow-hidden rounded-xl border bg-card">
                @* Top corner masthead *@
                <div class="absolute inset-x-0 top-0 flex items-start justify-between gap-3 border-b bg-background/80 px-5 py-4 backdrop-blur">
                    <div class="min-w-0">
                        <p class="font-serif text-[11px] font-semibold uppercase tracking-[0.25em] text-foreground">
                            @_cover.Title
                        </p>
                        <p class="mt-0.5 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                            @_cover.Volume · @_cover.Issue
                        </p>
                    </div>
                    <LucideIconCn Name="bookmark" Size="16" Class="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
                </div>

                @* Big monogram *@
                <div class="flex flex-1 items-center justify-center px-6 pb-16 pt-24 sm:pt-28">
                    <div aria-hidden="true" class="flex size-full min-h-[260px] items-center justify-center rounded-lg border-2 border-dashed border-foreground/15 bg-muted/30 sm:min-h-[320px]">
                        <span class="font-serif text-[140px] font-bold leading-none tracking-tighter text-foreground sm:text-[180px] lg:text-[200px]">
                            @_cover.Monogram
                        </span>
                    </div>
                </div>

                @* Bottom corner label *@
                <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 border-t bg-background/80 px-5 py-4 backdrop-blur">
                    <div class="min-w-0">
                        <p class="font-serif text-sm font-semibold italic leading-tight text-foreground">
                            @_cover.CornerNote
                        </p>
                        <p class="mt-0.5 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                            @_cover.Tagline
                        </p>
                    </div>
                    <div class="flex flex-col items-end gap-1.5">
                        <span aria-hidden="true" class="flex h-6 items-end gap-[2px]">
                            @foreach (var bar in _barHeights)
                            {
                                <span class="w-[2px] bg-foreground" style="@($"height:{bar * 4}px")"></span>
                            }
                        </span>
                        <span class="font-mono text-[9px] tabular-nums text-muted-foreground">
                            @_cover.Barcode · @_cover.PriceTag
                        </span>
                    </div>
                </div>
            </div>

            @* Inside this issue list *@
            <div class="flex flex-col rounded-xl border bg-card">
                <div class="flex items-baseline justify-between border-b px-6 py-5">
                    <div>
                        <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                            Contents
                        </p>
                        <h3 class="mt-1 font-serif text-2xl font-bold tracking-tight text-foreground">
                            Inside this issue
                        </h3>
                    </div>
                    <span class="hidden font-serif text-sm italic text-muted-foreground sm:inline">
                        Six stories
                    </span>
                </div>

                <ol class="flex flex-col">
                    @foreach (var article in _insideArticles)
                    {
                        <li class="flex items-start gap-5 border-b px-6 py-4 last:border-b-0">
                            <span class="mt-1 font-mono text-[11px] font-semibold tabular-nums text-muted-foreground">
                                P. @article.Page
                            </span>
                            <div class="min-w-0 flex-1">
                                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                                    @article.Kicker
                                </p>
                                <h4 class="mt-1 font-serif text-base font-semibold leading-snug tracking-tight text-foreground">
                                    @article.Headline
                                </h4>
                                <p class="mt-1.5 font-serif text-sm leading-relaxed text-muted-foreground">
                                    @article.Blurb
                                </p>
                                <p class="mt-2 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                    By @article.Byline
                                </p>
                            </div>
                        </li>
                    }
                </ol>
            </div>
        </div>

        @* CTA pair *@
        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <ButtonCn Class="w-full sm:w-[210px]">Read the issue</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[190px]">Past volumes</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record CoverData(
        string Title, string Tagline, string Volume, string Issue,
        string Monogram, string CornerNote, string PriceTag, string Barcode);

    private record InsideArticle(string Id, string Page, string Kicker, string Headline, string Blurb, string Byline);

    private static readonly CoverData _cover = new(
        Title: "Shipwright",
        Tagline: "The quarterly for engineering leaders",
