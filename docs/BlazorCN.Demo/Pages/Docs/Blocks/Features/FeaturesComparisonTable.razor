@* ============================================================
   Block: features-comparison-table
   Title: Features Comparison Table
   Description: Before-and-after comparison table with visual checkmarks and category groupings
   Dependencies: TableCn
   Source: original/blocks/features/features-comparison-table.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">The old way vs. Planwise</p>
            <p class="mt-0.5 text-xs text-muted-foreground">See how teams work before and after switching to a unified project management platform</p>
        </div>

        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="w-[180px] text-xs font-medium">Feature</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-red-600 dark:text-red-400">
                        <span class="flex items-center gap-1.5">
                            <LucideXCn Class="h-3 w-3" Size="12" />
                            Without
                        </span>
                    </TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-emerald-600 dark:text-emerald-400">
                        <span class="flex items-center gap-1.5">
                            <LucideCheckCn Class="h-3 w-3" Size="12" />
                            With Planwise
                        </span>
                    </TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var item in _rows)
                {
                    if (item.IsHeader)
                    {
                        <TableRowCn Class="bg-muted/30">
                            <TableCellCn ColSpan="3" Class="text-xs font-medium">@item.Label</TableCellCn>
                        </TableRowCn>
                    }
                    else
                    {
                        <TableRowCn>
                            <TableCellCn Class="text-xs font-medium">@item.Feature</TableCellCn>
                            <TableCellCn>
                                <div class="flex items-start gap-1.5">
                                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-red-500"></span>
                                    <span class="text-xs text-muted-foreground">@item.Without</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-start gap-1.5">
                                    <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                                    <span class="text-xs">@item.With</span>
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record ComparisonItem(bool IsHeader, string? Label = null, string? Feature = null, string? Without = null, string? With = null);

    private static readonly ComparisonItem[] _rows =
    [
        new(true, Label: "Project Planning"),
        new(false, Feature: "Task management", Without: "Scattered across spreadsheets and sticky notes", With: "Unified board with drag-and-drop prioritization"),
        new(false, Feature: "Timeline views", Without: "Manual Gantt charts that go stale instantly", With: "Auto-updating timelines synced to real progress"),
        new(false, Feature: "Resource allocation", Without: "Guesswork and over-committed team members", With: "Capacity planning with workload visibility"),
        new(true, Label: "Team Collaboration"),
        new(false, Feature: "Status updates", Without: "Weekly meetings just to share progress", With: "Async check-ins with automated status reports"),
        new(false, Feature: "Documentation", Without: "Lost in email threads and chat messages", With: "Embedded docs attached to every project"),
        new(false, Feature: "Decision tracking", Without: "No record of why decisions were made", With: "Decision log with context and stakeholders"),
        new(true, Label: "Reporting & Insights"),
        new(false, Feature: "Progress reports", Without: "Hours spent compiling data from multiple tools", With: "One-click reports generated in real time"),
        new(false, Feature: "Risk identification", Without: "Problems discovered too late to fix", With: "AI-powered risk alerts before deadlines slip"),
    ];
}
