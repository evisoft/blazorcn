@* ============================================================
   Block: features-testimonial-embedded-split
   Title: FeaturesTestimonialEmbeddedSplit
   Description: A split features section for React and Next.js with three CheckIcon bullets, an inline testimonial quote embedded between bullets as a border-l-2 pulled quote, and a crosshair image placeholder built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-testimonial-embedded-split.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">
        <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
            @* Left — Headline + bullets with embedded quote *@
            <div class="order-2 lg:order-1">
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    @_headline.Eyebrow
                </p>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
                    @_headline.Title
                </h2>
                <p class="mt-4 max-w-lg text-base leading-relaxed text-muted-foreground">
                    @_headline.Subtitle
                </p>

                <ul class="mt-7 space-y-5">
                    @* Bullet 1 *@
                    <li class="flex gap-3">
                        <span aria-hidden="true" class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                        </span>
                        <div>
                            <h3 class="text-sm font-semibold text-foreground">@_features[0].Title</h3>
                            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">@_features[0].Description</p>
                        </div>
                    </li>

                    @* Bullet 2 *@
                    <li class="flex gap-3">
                        <span aria-hidden="true" class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                        </span>
                        <div>
                            <h3 class="text-sm font-semibold text-foreground">@_features[1].Title</h3>
                            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">@_features[1].Description</p>
                        </div>
                    </li>

                    @* Embedded quote — border-l-2 pulled quote between bullets 2 and 3 *@
                    <li class="list-none">
                        <blockquote class="border-l-2 border-foreground pl-4">
                            <p class="text-sm italic leading-relaxed text-foreground">
                                &ldquo;@_testimonial.Quote&rdquo;
                            </p>
                            <cite class="mt-2 block text-xs not-italic text-muted-foreground">
                                — @_testimonial.Cite
                            </cite>
                        </blockquote>
                    </li>

                    @* Bullet 3 *@
                    <li class="flex gap-3">
                        <span aria-hidden="true" class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                        </span>
                        <div>
                            <h3 class="text-sm font-semibold text-foreground">@_features[2].Title</h3>
                            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">@_features[2].Description</p>
                        </div>
                    </li>
                </ul>
            </div>

            @* Right — Crosshair image placeholder *@
            <div class="order-1 flex aspect-[4/3] w-full items-center justify-center rounded-xl bg-muted lg:order-2">
                <div aria-hidden="true" class="relative flex items-center justify-center">
                    <div class="absolute size-24 rounded-full border border-muted-foreground/[0.06]"></div>
                    <div class="absolute size-14 rounded-full border border-muted-foreground/[0.08]"></div>
                    <div class="absolute h-px w-32 bg-muted-foreground/[0.06]"></div>
                    <div class="absolute h-32 w-px bg-muted-foreground/[0.06]"></div>
                    <div class="flex size-8 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                        <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureData(string Id, string Title, string Description);
    private record TestimonialData(string Quote, string Cite);

    private static readonly HeadlineData _headline = new(
        "Trusted by builders",
        "A platform that stays out of your way",
        "Three capabilities that keep developers in flow, without ceremony, without meetings, without a services contract."
    );

    private static readonly FeatureData[] _features =
    [
        new("local-dev", "Local development parity",
            "Run the exact production stack on your laptop with a single command, no virtualization layer required."),
        new("git-native", "Git-native configuration",
            "Every environment, secret, and feature flag lives in your repository and moves with your branches."),
        new("pricing", "Predictable usage-based pricing",
            "No seat fees, no enterprise upsell, no surprise line items when your traffic spikes on launch day."),
    ];

    private static readonly TestimonialData _testimonial = new(
        "It finally feels like the tools are serving the engineers instead of the other way around. We shipped two full quarters of roadmap in six weeks.",
        "Marcus Alvarez, Engineering Lead at Orbital Freight"
    );
}
