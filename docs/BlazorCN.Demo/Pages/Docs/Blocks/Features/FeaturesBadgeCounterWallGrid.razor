@* ============================================================
   Block: features-badge-counter-wall-grid
   Title: FeaturesBadgeCounterWallGrid
   Description: A wide 4x2 grid features section for React and Next.js displaying eight notification channel cards each with a bell icon, tabular counter, channel name, last message preview, unread red dot indicator, and mark all read button, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-badge-counter-wall-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div>
    @* Headline cluster *@
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Unified Inbox
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Every channel your customers touch, counted and cleared.
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        Route, triage, and resolve from one surface — with live counters per channel so nothing
        waits in a queue your team forgot to check.
      </p>
      <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-center">
        <ButtonCn Class="w-full sm:w-[200px]">Start routing</ButtonCn>
        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">
          Browse channels
        </ButtonCn>
      </div>
    </div>

    @* Badge counter grid *@
    <div class="mt-12 grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      @foreach (var ch in _channels)
      {
        <article
          aria-label="@($"{ch.Name} channel with {ch.Count} unread")"
          class="relative flex flex-col rounded-xl border bg-card p-5">
          @* Top row: icon + unread dot *@
          <div class="flex items-start justify-between">
            <div class="flex size-10 items-center justify-center rounded-lg bg-muted">
              <LucideIconCn Name="@ch.IconName" Size="20" Class="size-5 text-foreground" />
            </div>
            @if (ch.Unread)
            {
              <span
                aria-hidden="true"
                class="mt-1 inline-flex size-2 shrink-0 rounded-full bg-red-500" />
            }
          </div>

          @* Big counter *@
          <div class="mt-5 flex items-baseline gap-1.5">
            <span class="font-mono text-4xl font-semibold tabular-nums tracking-tight text-foreground">
              @PadCount(ch.Count)
            </span>
            <span class="text-xs font-medium text-muted-foreground">unread</span>
          </div>

          @* Channel name *@
          <h3 class="mt-1 text-sm font-semibold text-foreground">@ch.Name</h3>

          @* Last message preview *@
          <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-muted-foreground">
            @ch.Preview
          </p>

          @* Footer: timestamp + mark all read *@
          <div class="mt-4 flex items-center justify-between border-t border-border pt-3">
            <span class="text-[10px] tabular-nums text-muted-foreground">
              @ch.Timestamp
            </span>
            <button
              type="button"
              aria-label="@($"Mark all {ch.Name} as read")"
              disabled="@(ch.Count == 0 ? "disabled" : null)"
              class="text-[11px] font-medium text-foreground transition-colors hover:text-muted-foreground disabled:cursor-not-allowed disabled:text-muted-foreground/60">
              Mark all read
            </button>
          </div>
        </article>
      }
    </div>
  </div>
</section>

@code {
  private record ChannelCounter(string Id, string Name, string IconName, int Count, string Preview, string Timestamp, bool Unread);

  private static readonly ChannelCounter[] _channels =
  [
    new("email",   "Email",     "mail",          248, "Priya shared the Q2 roadmap deck",        "2m ago",  true),
    new("slack",   "Slack",     "slack",           42, "#incidents: db-primary recovered",        "6m ago",  true),
    new("sms",     "SMS",       "smartphone",       7, "Your verification code is 489201",        "11m ago", true),
    new("in-app",  "In-app",    "bell",            19, "3 teammates mentioned you today",         "18m ago", true),
    new("push",    "Push",      "send",             0, "All caught up — no pending pushes",       "1h ago",  false),
    new("chat",    "Live chat", "message-square",  14, "Nora: Is the refund flow working now?",   "24m ago", true),
    new("voice",   "Voice",     "phone",            3, "Missed call from +1 (415) 555-0164",      "42m ago", true),
    new("support", "Support",   "headphones",       0, "Queue clear — SLA healthy",               "2h ago",  false),
  ];

  private static string PadCount(int count) => count.ToString().PadLeft(2, '0');
}
