@* ============================================================
   Block: features-keyboard-shortcuts
   Title: Features Keyboard Shortcuts
   Description: A keyboard shortcut reference guide with kbd-styled key combinations and grouped categories
   Dependencies: None
   Source: original/blocks/features/features-keyboard-shortcuts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Keyboard Shortcuts</h2>
            <p class="mt-1 text-xs text-muted-foreground">Quick reference for common actions</p>
        </div>

        <div>
            @for (var ci = 0; ci < _categories.Length; ci++)
            {
                var category = _categories[ci];
                <div>
                    <div class="border-b bg-muted/30 px-4 py-2">
                        <h3 class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@category.Name</h3>
                    </div>
                    <div class="@(ci < _categories.Length - 1 ? "border-b" : "")">
                        @for (var si = 0; si < category.Shortcuts.Length; si++)
                        {
                            var shortcut = category.Shortcuts[si];
                            <div class="@Cn.Merge("grid grid-cols-[auto_1fr] items-center gap-4 px-4 py-2.5", si < category.Shortcuts.Length - 1 ? "border-b border-border/40" : "")">
                                <div class="flex items-center gap-1">
                                    @for (var ki = 0; ki < shortcut.Keys.Length; ki++)
                                    {
                                        var key = shortcut.Keys[ki];
                                        <div class="flex items-center gap-1">
                                            <kbd class="inline-flex h-5 min-w-[20px] items-center justify-center rounded border border-border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground">@key</kbd>
                                            @if (ki < shortcut.Keys.Length - 1)
                                            {
                                                <span class="text-xs text-muted-foreground">+</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <span class="text-sm">@shortcut.Action</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Shortcut(string[] Keys, string Action);
    private record ShortcutCategory(string Name, Shortcut[] Shortcuts);

    private static readonly ShortcutCategory[] _categories =
    [
        new("Navigation", [
            new(["\u2318", "K"], "Open command palette"),
            new(["\u2318", "P"], "Quick file search"),
            new(["\u2318", "B"], "Toggle sidebar"),
            new(["\u2318", "\\"], "Focus on search"),
        ]),
        new("Editing", [
            new(["\u2318", "S"], "Save changes"),
            new(["\u2318", "Z"], "Undo"),
            new(["\u2318", "\u21e7", "Z"], "Redo"),
            new(["\u2318", "D"], "Duplicate line"),
            new(["\u2318", "/"], "Toggle comment"),
        ]),
        new("View", [
            new(["\u2318", "+"], "Zoom in"),
            new(["\u2318", "-"], "Zoom out"),
            new(["\u2318", "0"], "Reset zoom"),
            new(["\u2318", "\u21e7", "P"], "Toggle preview"),
        ]),
        new("Terminal", [
            new(["\u2303", "`"], "Toggle terminal"),
            new(["\u2303", "\u21e7", "`"], "New terminal"),
            new(["\u2318", "\u2303", "C"], "Clear terminal"),
        ]),
    ];
}
