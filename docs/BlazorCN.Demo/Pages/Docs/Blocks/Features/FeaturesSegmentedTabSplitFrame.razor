@* ============================================================
   Block: features-segmented-tab-split-frame
   Title: FeaturesSegmentedTabSplitFrame
   Description: A segmented tab split frame features section for React and Next.js with PillTabs navigation above a browser chrome wrapped split card containing a text panel and a mini dashboard mockup with fake chart bars built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-segmented-tab-split-frame.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Centered headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Platform
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                See every signal without switching tabs
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The same dashboard your team lives in, wired to the capability you care about most today. Switch between tabs to preview the views shipped in the last quarter.
            </p>
        </div>

        @* Tab navigation — PillTabs rendered as pill button group *@
        <div class="mt-8 flex justify-center">
            <div class="inline-flex items-center gap-1 rounded-full border bg-muted/50 p-1" role="tablist" aria-label="Dashboard view">
                @foreach (var tab in _tabs)
                {
                    var tabItem = tab;
                    <button
                        role="tab"
                        aria-selected="@(_activeTab == tabItem.Id ? "true" : "false")"
                        class="@Cn.Merge("inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _activeTab == tabItem.Id ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _activeTab = tabItem.Id)">
                        <LucideIconCn Name="@tabItem.Icon" Size="14" Class="size-3.5" />
                        @tabItem.Label
                    </button>
                }
            </div>
        </div>

        @* Browser chrome wrapped split card *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card shadow-sm">
            @* Browser chrome header *@
            <div aria-hidden="true" class="flex items-center gap-3 border-b bg-muted/40 px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <span class="size-2.5 rounded-full bg-muted-foreground/25"></span>
                    <span class="size-2.5 rounded-full bg-muted-foreground/25"></span>
                    <span class="size-2.5 rounded-full bg-muted-foreground/25"></span>
                </div>
                <div class="flex flex-1 items-center justify-center">
                    <div class="inline-flex max-w-md items-center gap-2 truncate rounded-md border bg-background px-3 py-1 font-mono text-[11px] text-muted-foreground">
                        <LucideIconCn Name="lock" Size="12" Class="size-3 shrink-0 text-muted-foreground/60" />
                        <span class="truncate">@ActiveFeature.BrowserUrl</span>
                    </div>
                </div>
                @* Spacer to balance the traffic dots *@
                <div class="w-[46px]"></div>
            </div>

            @* Split content *@
            <div class="grid lg:grid-cols-[5fr_6fr]">
                @* Left — text *@
                <div class="flex flex-col justify-center p-6 sm:p-10 lg:p-12">
                    <span class="inline-flex w-fit items-center gap-1.5 rounded-full border bg-muted/50 px-2.5 py-1 text-[11px] font-medium text-foreground">
                        <LucideIconCn Name="@ActiveTab.Icon" Size="12" Class="size-3 text-muted-foreground" />
                        @ActiveTab.Label
                    </span>
                    <h3 class="mt-4 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
                        @ActiveFeature.Title
                    </h3>
                    <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                        @ActiveFeature.Description
                    </p>
                    <p class="mt-6 text-xs font-medium uppercase tracking-widest text-muted-foreground">
                        @ActiveFeature.Summary
                    </p>
                </div>

                @* Right — mini dashboard mockup *@
                <div class="relative border-t bg-muted/30 p-6 sm:p-8 lg:border-t-0 lg:border-l lg:p-10">
                    <div class="flex h-full flex-col">
                        @* Mini dashboard card *@
                        <div class="flex-1 rounded-xl border bg-card p-5">
                            @* Dashboard header *@
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                                        Last 7 days
                                    </p>
                                    <p class="mt-1 text-sm font-semibold text-foreground">
                                        @ActiveFeature.Summary
                                    </p>
                                </div>
                                <div class="flex items-center gap-1">
                                    <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                                    <span class="text-[11px] font-medium text-muted-foreground">Live</span>
                                </div>
                            </div>

                            @* Fake chart bars *@
                            <div aria-hidden="true" class="mt-5 flex h-24 items-end gap-1.5 border-b border-dashed pb-1">
                                @foreach (var metric in ActiveFeature.Metrics)
                                {
                                    <div class="flex-1 rounded-t-sm bg-foreground/80" style="@($"height:{metric.Bar}%")"></div>
                                }
                                @for (int fi = 0; fi < 8; fi++)
                                {
                                    var fillerHeight = 30 + ((fi * 13) % 55);
                                    <div class="flex-1 rounded-t-sm bg-muted-foreground/15" style="@($"height:{fillerHeight}%")"></div>
                                }
                            </div>

                            @* Metrics list *@
                            <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3">
                                @foreach (var metric in ActiveFeature.Metrics)
                                {
                                    <div class="flex items-center justify-between border-b border-dashed pb-2">
                                        <dt class="text-xs text-muted-foreground">@metric.Label</dt>
                                        <dd class="font-mono text-xs font-semibold tabular-nums text-foreground">@metric.Value</dd>
                                    </div>
                                }
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Metric(string Label, string Value, int Bar);
    private record FeatureContent(string BrowserUrl, string Title, string Description, string Summary, Metric[] Metrics);
    private record TabInfo(string Id, string Label, string Icon);

    private string _activeTab = "performance";

    private static readonly TabInfo[] _tabs =
    [
        new("performance", "Performance", "zap"),
        new("security", "Security", "lock"),
        new("analytics", "Analytics", "bar-chart-3"),
    ];

    private static readonly Dictionary<string, FeatureContent> _features = new()
    {
        ["performance"] = new FeatureContent(
            "app.acme.dev/observability",
            "Latency budgets you can actually defend",
            "Track p50, p95, and p99 response times across every service and page, and set budgets that page on-call before a user ever sees a slow response.",
            "Real-time latency monitoring",
            [
                new("p50 latency", "42 ms", 28),
                new("p95 latency", "180 ms", 62),
                new("p99 latency", "310 ms", 84),
                new("Error rate", "0.04%", 12),
            ]
        ),
        ["security"] = new FeatureContent(
            "app.acme.dev/security/posture",
            "Posture reviews that pass the first time",
            "A single pane for SOC 2, ISO 27001, and HIPAA controls with evidence collection automated and reviewers notified the moment a control drifts.",
            "Compliance control coverage",
            [
                new("Controls passing", "142 / 148", 96),
                new("Evidence fresh", "98%", 92),
                new("Open findings", "3", 18),
                new("Review readiness", "Ready", 88),
            ]
        ),
        ["analytics"] = new FeatureContent(
            "app.acme.dev/analytics/overview",
            "Product analytics that answer the real question",
            "Track funnels, retention, and experiment lift in one place, share dashboards with stakeholders, and answer one-off questions without writing SQL.",
            "Weekly active user growth",
            [
                new("Weekly actives", "128.4k", 78),
                new("Retention D30", "64%", 58),
                new("Avg session", "8m 12s", 46),
                new("Conversion", "12.8%", 38),
            ]
        ),
    };

    private FeatureContent ActiveFeature => _features[_activeTab];
    private TabInfo ActiveTab => System.Array.Find(_tabs, t => t.Id == _activeTab) ?? _tabs[0];
}
