@* ============================================================
   Block: features-anchored-headline-grid
   Title: FeaturesAnchoredHeadlineGrid
   Description: An anchored headline split feature section for React and Next.js with a large left-pinned marketing headline and a 2x2 CheckIcon reinforcement grid on the right built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-anchored-headline-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-8 sm:p-12 lg:p-14">
        <div class="grid gap-10 lg:grid-cols-[5fr_6fr] lg:gap-14">
            @* Left — Anchored headline *@
            <div>
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    @_headline.Eyebrow
                </p>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
                    @_headline.Title
                </h2>
                <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground">
                    @_headline.Subtitle
                </p>
                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="w-full sm:w-[230px]">Start free trial</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">Read the docs</ButtonCn>
                </div>
            </div>

            @* Right — 2x2 feature grid *@
            <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 sm:gap-8">
                @foreach (var feat in _features)
                {
                    <div>
                        <div class="flex items-center gap-2.5">
                            <span aria-hidden="true" class="flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                <LucideIconCn Name="check" Size="12" StrokeWidth="3" Class="size-3 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                            </span>
                            <h3 class="text-base font-semibold text-foreground">@feat.Title</h3>
                        </div>
                        <p class="mt-2 pl-[30px] text-sm leading-relaxed text-muted-foreground">
                            @feat.Description
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record Feature(string Id, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        "Built for scale",
        "The tools your team needs, without the bloat",
        "Four capabilities that matter more than a hundred features nobody uses. Everything your team reaches for daily, nothing that sits untouched in a settings menu."
    );

    private static readonly Feature[] _features =
    [
        new("keyboard-first", "Keyboard-first navigation",
            "Every action reachable from the command menu in under two keystrokes. No mouse required to run the product end to end."),
        new("local-first", "Sub-50ms interactions",
            "A local-first data layer syncs changes in the background so the UI never blocks on network round trips, even on spotty connections."),
        new("single-tenant", "Dedicated infrastructure",
            "Single-tenant deployments with isolated databases and private networking for regulated industries and enterprise customers."),
        new("zero-config-sso", "Zero-config SSO",
            "SAML 2.0 and SCIM provisioning available on every paid plan with no enterprise tier surcharge and no setup call required."),
    ];
}
