@* ============================================================
   Block: features-radar-chart-capability-trio
   Title: FeaturesRadarChartCapabilityTrio
   Description: A three-column radar chart features section for React and Next.js rendering pure-SVG spider charts across five capability axes per panel, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-radar-chart-capability-trio.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div>
    @* Header *@
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Capability scorecard
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Three surfaces, one coherent story.
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        Rated across the five axes our customers told us matter most. No cherry-picking, no
        hidden footnotes — just the shape of the platform as it ships today.
      </p>
    </div>

    @* Radar trio *@
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      @foreach (var cap in _capabilities)
      {
        <div class="flex flex-col items-center rounded-xl border bg-card p-6 text-center">
          <div class="flex w-full items-center justify-center">
            @{ var (polygonPts, spokes, rings, dots, labels) = BuildRadarParts(cap.Axes); }
            <svg aria-hidden="true" viewBox="0 0 220 220" class="h-auto w-full max-w-[240px]">
              <title>Radar chart</title>
              @* concentric axis grid *@
              @foreach (var ring in rings)
              {
                <circle cx="110" cy="110" r="@ring.R.ToString("F2")" fill="none" class="stroke-border" stroke-width="1" />
              }
              @* axis spokes *@
              @foreach (var spoke in spokes)
              {
                <line x1="110" y1="110" x2="@spoke.X2.ToString("F2")" y2="@spoke.Y2.ToString("F2")" class="stroke-border" stroke-width="1" />
              }
              @* data polygon *@
              <polygon points="@polygonPts" class="fill-foreground/10 stroke-foreground" stroke-width="1.5" stroke-linejoin="round" />
              @* vertex dots *@
              @foreach (var dot in dots)
              {
                <circle cx="@dot.Cx.ToString("F2")" cy="@dot.Cy.ToString("F2")" r="2.5" class="fill-foreground" />
              }
              @* axis labels *@
              @foreach (var lbl in labels)
              {
                @((MarkupString)$"<text x=\"{lbl.X:F2}\" y=\"{lbl.Y:F2}\" text-anchor=\"middle\" dominant-baseline=\"middle\" class=\"fill-muted-foreground font-medium text-[9px]\">{System.Net.WebUtility.HtmlEncode(lbl.Text)}</text>")
              }
            </svg>
          </div>
          <h3 class="mt-4 text-base font-semibold tracking-tight">@cap.Title</h3>
          <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
            @cap.Description
          </p>
        </div>
      }
    </div>

    @* CTA pair *@
    <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <ButtonCn Class="w-full sm:w-[210px]">View scorecard</ButtonCn>
      <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">Download report</ButtonCn>
    </div>
  </div>
</section>

@code {
    private const double Size = 220;
    private const double Center = Size / 2;
    private const double Radius = 82;
    private const int Rings = 4;
    private const int AxisCount = 5;

    private record CapabilityAxis(string Label, double Value);
    private record Capability(string Id, string Title, string Description, CapabilityAxis[] Axes);

    private static readonly Capability[] _capabilities =
    [
        new("runtime", "Runtime platform",
            "Edge-native compute with predictable latency and first-class observability out of the box.",
            [
                new("Speed", 92),
                new("Reliability", 96),
                new("Security", 84),
                new("Scalability", 90),
                new("DX", 88),
            ]),
        new("data", "Data layer",
            "Globally replicated primary store with strong consistency and tunable read replicas.",
            [
                new("Speed", 80),
                new("Reliability", 94),
                new("Security", 92),
                new("Scalability", 95),
                new("DX", 76),
            ]),
        new("tooling", "Developer tooling",
            "CLI, local emulator, typed SDKs, and inline docs that make day one feel like month six.",
            [
                new("Speed", 88),
                new("Reliability", 82),
                new("Security", 74),
                new("Scalability", 78),
                new("DX", 97),
            ]),
    ];

    private static (double X, double Y) PolarToCartesian(double angleDeg, double radius)
    {
        var angleRad = (angleDeg - 90) * Math.PI / 180;
        return (Center + radius * Math.Cos(angleRad), Center + radius * Math.Sin(angleRad));
    }

    private record RingData(double R);
    private record SpokeData(double X2, double Y2);
    private record DotData(double Cx, double Cy);
    private record LabelData(double X, double Y, string Text);

    private static (string PolygonPts, SpokeData[] Spokes, RingData[] RingList, DotData[] Dots, LabelData[] Labels)
        BuildRadarParts(CapabilityAxis[] axes)
    {
        var step = 360.0 / AxisCount;

        // polygon points
        var polygonParts = new string[axes.Length];
        for (var i = 0; i < axes.Length; i++)
        {
            var r = (axes[i].Value / 100.0) * Radius;
            var (x, y) = PolarToCartesian(i * step, r);
            polygonParts[i] = $"{x:F2},{y:F2}";
        }
        var polygonPts = string.Join(" ", polygonParts);

        // rings
        var ringList = new RingData[Rings];
        for (var ri = 0; ri < Rings; ri++)
            ringList[ri] = new RingData(Radius * ((ri + 1.0) / Rings));

        // spokes
        var spokes = new SpokeData[axes.Length];
        for (var i = 0; i < axes.Length; i++)
        {
            var (x, y) = PolarToCartesian(i * step, Radius);
            spokes[i] = new SpokeData(x, y);
        }

        // dots
        var dots = new DotData[axes.Length];
        for (var i = 0; i < axes.Length; i++)
        {
            var r = (axes[i].Value / 100.0) * Radius;
            var (x, y) = PolarToCartesian(i * step, r);
            dots[i] = new DotData(x, y);
        }

        // labels
        var labels = new LabelData[axes.Length];
        for (var i = 0; i < axes.Length; i++)
        {
            var (x, y) = PolarToCartesian(i * step, Radius + 16);
            labels[i] = new LabelData(x, y, axes[i].Label);
        }

        return (polygonPts, spokes, ringList, dots, labels);
    }
}
