@* ============================================================
   Block: features-split-browser-frame-list
   Title: FeaturesSplitBrowserFrameList
   Description: A split features section for React and Next.js with a large browser-chrome mockup on the left and an eyebrow, headline, subtitle, and four icon-labeled feature rows on the right built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-split-browser-frame-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">
        <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
            @* Left — Browser frame mockup *@
            <div aria-hidden="true" class="overflow-hidden rounded-xl border bg-card shadow-sm">
                @* Browser top bar *@
                <div class="flex items-center gap-3 border-b bg-muted/40 px-4 py-3">
                    <div class="flex items-center gap-1.5">
                        <span class="size-2.5 rounded-full bg-muted-foreground/25"></span>
                        <span class="size-2.5 rounded-full bg-muted-foreground/25"></span>
                        <span class="size-2.5 rounded-full bg-muted-foreground/25"></span>
                    </div>
                    <div class="flex h-6 flex-1 items-center rounded-md border bg-background px-3">
                        <span class="font-mono text-[10px] text-muted-foreground/70">
                            app.acme.io/workspace
                        </span>
                    </div>
                </div>

                @* Browser content area — crosshair placeholder *@
                <div class="flex aspect-[4/3] w-full items-center justify-center bg-muted">
                    <div class="relative flex items-center justify-center">
                        <div class="absolute size-24 rounded-full border border-muted-foreground/[0.06]"></div>
                        <div class="absolute size-14 rounded-full border border-muted-foreground/[0.08]"></div>
                        <div class="absolute h-px w-32 bg-muted-foreground/[0.06]"></div>
                        <div class="absolute h-32 w-px bg-muted-foreground/[0.06]"></div>
                        <div class="flex size-8 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
                        </div>
                    </div>
                </div>
            </div>

            @* Right — Headline + feature list + CTA *@
            <div>
                <div>
                    <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                        @_headline.Eyebrow
                    </p>
                    <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
                        @_headline.Title
                    </h2>
                    <p class="mt-5 max-w-lg text-base leading-relaxed text-muted-foreground">
                        @_headline.Subtitle
                    </p>
                </div>

                <div class="mt-8 space-y-5">
                    @foreach (var feature in _features)
                    {
                        <div class="flex items-start gap-3">
                            <span aria-hidden="true" class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg border bg-background">
                                <LucideIconCn Name="@feature.IconName" Size="16" Class="size-4 text-foreground" />
                            </span>
                            <div>
                                <h3 class="text-sm font-semibold text-foreground">@feature.Title</h3>
                                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                                    @feature.Description
                                </p>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="w-full sm:w-[230px]">Launch workspace</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[170px]">View demo</ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureData(string Id, string IconName, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        "Your workspace, in the browser",
        "Ship from any tab, on any machine",
        "A web-native workspace that loads in under a second, syncs across devices, and never asks your team to install a thing. Built for the way modern product teams actually work."
    );

    private static readonly FeatureData[] _features =
    [
        new("instant-load", "bolt", "Instant cold starts",
            "The entire app boots in under 800ms on a fresh tab, even on mid-range laptops over throttled connections."),
        new("zero-install", "workflow", "Zero install, zero update",
            "Every teammate is on the same version the moment you ship. No download prompts, no stale clients, no onboarding tickets."),
        new("encrypted-sync", "lock", "Encrypted cross-device sync",
            "Changes propagate through an end-to-end encrypted channel so a laptop, phone, and tablet always see the same workspace."),
        new("secure-by-default", "shield-check", "Secure by default",
            "CSP, HSTS, Trusted Types, and SameSite cookies are on out of the box — no flags to flip, no config to remember."),
    ];
}
