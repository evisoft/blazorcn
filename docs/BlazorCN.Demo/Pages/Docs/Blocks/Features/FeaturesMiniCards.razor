@* ============================================================
   Block: features-mini-cards
   Title: Features Mini Cards
   Description: A features block with compact feature cards in a dense connected grid layout
   Dependencies: None
   Source: original/blocks/features/features-mini-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">All Features</h2>
            <p class="mt-1 text-xs text-muted-foreground">Everything you need in one platform</p>
        </div>

        <div class="grid grid-cols-4 gap-px bg-border">
            @foreach (var feature in _features)
            {
                <div class="bg-card px-3 py-2.5 transition-colors hover:bg-muted/50">
                    <p class="text-xs font-medium">@feature.Title</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@feature.Description</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Feature(string Title, string Description);

    private static readonly Feature[] _features =
    [
        new("SSO Integration", "Connect with SAML, OAuth, and OpenID providers"),
        new("API Rate Limiting", "Automatic throttling and quota management"),
        new("Webhooks", "Real-time event notifications to your endpoints"),
        new("Custom Domains", "White-label with your own domain and SSL"),
        new("Audit Logs", "Complete activity history with export options"),
        new("Role-Based Access", "Granular permissions for teams and resources"),
        new("Two-Factor Auth", "TOTP and SMS verification for added security"),
        new("Data Encryption", "AES-256 encryption at rest and in transit"),
        new("Backup & Recovery", "Automated daily backups with point-in-time restore"),
        new("SLA Guarantees", "99.9% uptime with financial commitments"),
        new("Priority Support", "24/7 dedicated support with 1-hour response"),
        new("Advanced Analytics", "Custom dashboards and data export tools"),
        new("Team Workspaces", "Isolated environments for collaboration"),
        new("Version Control", "Track changes with full history and rollback"),
        new("Import & Export", "Bulk operations with CSV, JSON, and API"),
        new("Custom Workflows", "Automate processes with visual builder"),
    ];
}
