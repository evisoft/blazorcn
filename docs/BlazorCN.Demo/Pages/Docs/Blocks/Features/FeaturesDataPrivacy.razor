@* ============================================================
   Block: features-data-privacy
   Title: Features Data Privacy
   Description: Data privacy feature checklist organized by compliance categories. Built with Next.js, React, shadcn/ui, and Tailwind CSS.
   Long Description: Compliance certification matrix
   Dependencies: None
   Source: original/blocks/features/features-data-privacy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
          <span class="font-medium text-sm">Data Privacy Features</span>
          <p class="mt-0.5 text-muted-foreground text-xs">
            Comprehensive privacy controls and compliance measures
          </p>
        </div>

        <div class="divide-y">
          @foreach (var category in _privacyCategories)
          {
            <div class="px-4 py-3">
              <div class="mb-3 font-medium text-sm">@category.Name</div>

              <div class="space-y-3">
                @foreach (var feature in category.Features)
                {
                  <div class="flex gap-3">
                    <div class="shrink-0 pt-0.5">
                      <span class="@(Cn.Merge("size-1.5 rounded-full", GetStatusColor(feature.Status)))"></span>
                    </div>

                    <div class="min-w-0 flex-1">
                      <div class="flex items-start justify-between gap-2">
                        <span class="text-sm">@feature.Title</span>
                        <span class="shrink-0 text-muted-foreground text-xs">
                          @GetStatusLabel(feature.Status)
                        </span>
                      </div>
                      <p class="mt-0.5 text-muted-foreground text-xs">@feature.Description</p>
                    </div>
                  </div>
                }
              </div>
            </div>
          }
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
          <div class="flex items-center gap-4 text-xs">
            <div class="flex items-center gap-1.5">
              <span class="size-1.5 rounded-full bg-emerald-500"></span>
              <span class="text-muted-foreground">Fully compliant</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="size-1.5 rounded-full bg-amber-500"></span>
              <span class="text-muted-foreground">Partial implementation</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="size-1.5 rounded-full bg-blue-500"></span>
              <span class="text-muted-foreground">Planned</span>
            </div>
          </div>
        </div>
      </div>
    </section>

@code {
    private record PrivacyFeature(string Title, string Description, string Status);
    private record PrivacyCategory(string Name, PrivacyFeature[] Features);

    private static readonly PrivacyCategory[] _privacyCategories = new[]
    {
        new PrivacyCategory("Data Collection", new[]
        {
            new PrivacyFeature("Consent Management", "GDPR-compliant consent collection and management", "compliant"),
            new PrivacyFeature("Data Minimization", "Only collect data necessary for service operation", "compliant"),
            new PrivacyFeature("Cookie Controls", "Granular cookie preference management", "compliant"),
        }),
        new PrivacyCategory("Data Storage", new[]
        {
            new PrivacyFeature("Encryption at Rest", "AES-256 encryption for all stored data", "compliant"),
            new PrivacyFeature("Data Residency", "Choose where your data is stored geographically", "partial"),
            new PrivacyFeature("Retention Policies", "Configurable data retention and auto-deletion", "compliant"),
        }),
        new PrivacyCategory("User Rights", new[]
        {
            new PrivacyFeature("Data Portability", "Export all user data in standard formats", "compliant"),
            new PrivacyFeature("Right to Deletion", "Complete data erasure upon request", "compliant"),
            new PrivacyFeature("Access Requests", "Automated DSAR handling workflow", "partial"),
        }),
    };

    private static string GetStatusColor(string status) => status switch
    {
        "compliant" => "bg-emerald-500",
        "partial" => "bg-amber-500",
        "planned" => "bg-blue-500",
        _ => "bg-gray-500",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "compliant" => "Compliant",
        "partial" => "Partial",
        "planned" => "Planned",
        _ => status,
    };
}
