@* ============================================================
   Block: features-invoice-line-item-breakdown
   Title: FeaturesInvoiceLineItemBreakdown
   Description: A professional invoice features section for React and Next.js rendering a billing document with INVOICE header, bill-to/bill-from columns, itemized table, totals, terms block, and rotated PAID stamp watermark built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-invoice-line-item-breakdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Line-item breakdown
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Every feature, properly invoiced.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Hand this to procurement, CFO, or legal. Six capabilities, each with a description,
                quantity, and rate — and a total that lines up with what you expected.
            </p>
        </div>

        @* Invoice document *@
        <article aria-label="Invoice document with feature line items"
                 class="relative mt-10 overflow-hidden rounded-lg border bg-card shadow-sm">

            @* PAID watermark stamp *@
            <div aria-hidden="true"
                 class="pointer-events-none absolute right-8 top-40 z-10 rotate-[-14deg] select-none sm:right-24">
                <div class="rounded-sm border-[3px] border-double border-emerald-600/40 px-5 py-2">
                    <p class="font-serif text-3xl font-black tracking-[0.18em] text-emerald-600/40">
                        PAID
                    </p>
                    <p class="text-center font-mono text-[9px] tracking-[0.3em] text-emerald-600/40">
                        @_invoiceMeta.Issued.ToUpperInvariant()
                    </p>
                </div>
            </div>

            @* Document header *@
            <header class="relative border-b px-8 pt-10 pb-8 sm:px-12">
                <div class="flex items-start justify-between gap-6">
                    <div>
                        <h3 class="font-serif text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
                            INVOICE
                        </h3>
                        <p class="mt-2 font-mono text-xs text-muted-foreground">
                            @_invoiceMeta.Number
                        </p>
                    </div>
                    <div class="flex size-14 shrink-0 items-center justify-center rounded-md border bg-muted/40">
                        <LucideIconCn Name="building" Size="24" Class="size-6 text-muted-foreground" />
                    </div>
                </div>

                @* Bill-to / bill-from / meta grid *@
                <div class="mt-8 grid gap-6 sm:grid-cols-3">
                    @foreach (var party in _parties)
                    {
                        <div>
                            <p class="text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
                                @party.Label
                            </p>
                            <p class="mt-2 text-sm font-semibold text-foreground">@party.Name</p>
                            <p class="text-xs text-muted-foreground">@party.Line1</p>
                            <p class="text-xs text-muted-foreground">@party.Line2</p>
                            <p class="mt-1 font-mono text-[11px] text-muted-foreground">@party.Email</p>
                        </div>
                    }

                    <div class="sm:text-right">
                        <p class="text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
                            Details
                        </p>
                        <dl class="mt-2 space-y-1 text-xs">
                            <div class="flex justify-between gap-2 sm:justify-end sm:gap-4">
                                <dt class="text-muted-foreground">Issued</dt>
                                <dd class="font-mono text-foreground">@_invoiceMeta.Issued</dd>
                            </div>
                            <div class="flex justify-between gap-2 sm:justify-end sm:gap-4">
                                <dt class="text-muted-foreground">Due</dt>
                                <dd class="font-mono text-foreground">@_invoiceMeta.Due</dd>
                            </div>
                            <div class="flex justify-between gap-2 sm:justify-end sm:gap-4">
                                <dt class="text-muted-foreground">Status</dt>
                                <dd class="font-semibold text-emerald-600">@_invoiceMeta.Status</dd>
                            </div>
                        </dl>
                    </div>
                </div>
            </header>

            @* Line items table *@
            <div class="relative px-8 pt-8 sm:px-12">
                <table class="w-full border-collapse">
                    <thead>
                        <tr class="border-b-2 border-foreground/80">
                            <th scope="col"
                                class="pb-3 pr-4 text-left text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
                                Description
                            </th>
                            <th scope="col"
                                class="hidden w-16 pb-3 px-2 text-right text-[10px] font-semibold uppercase tracking-widest text-muted-foreground sm:table-cell">
                                Qty
                            </th>
                            <th scope="col"
                                class="hidden w-24 pb-3 px-2 text-right text-[10px] font-semibold uppercase tracking-widest text-muted-foreground sm:table-cell">
                                Rate
                            </th>
                            <th scope="col"
                                class="w-28 pb-3 pl-2 text-right text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
                                Amount
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _lineItems)
                        {
                            <tr class="border-b border-border/60">
                                <td class="py-4 pr-4 align-top">
                                    <p class="text-sm font-medium text-foreground">@item.Description</p>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@item.Detail</p>
                                </td>
                                <td class="hidden px-2 py-4 text-right align-top font-mono text-xs tabular-nums text-muted-foreground sm:table-cell">
                                    @item.Qty
                                </td>
                                <td class="hidden px-2 py-4 text-right align-top font-mono text-xs tabular-nums text-muted-foreground sm:table-cell">
                                    @item.Rate
                                </td>
                                <td class="py-4 pl-2 text-right align-top font-mono text-xs font-semibold tabular-nums text-foreground">
                                    @item.Amount
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Totals block *@
            <div class="relative px-8 pt-6 pb-8 sm:px-12">
                <div class="ml-auto w-full max-w-xs space-y-2 text-xs">
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground">Subtotal</span>
                        <span class="font-mono tabular-nums text-foreground">@_totals.Subtotal</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground">Launch discount</span>
                        <span class="font-mono tabular-nums text-emerald-600">@_totals.Discount</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground">Tax</span>
                        <span class="font-mono tabular-nums text-foreground">@_totals.Tax</span>
                    </div>
                    <div class="flex items-center justify-between border-t-2 border-foreground/80 pt-3">
                        <span class="text-sm font-semibold text-foreground">Total due</span>
                        <span class="font-mono text-xl font-bold tabular-nums text-foreground">
                            @_totals.Total
                        </span>
                    </div>
                </div>
            </div>

            @* Terms & notes footer *@
            <footer class="relative border-t bg-muted/30 px-8 py-6 sm:px-12">
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="file-text" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
                    <div>
                        <p class="text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
                            Terms &amp; notes
                        </p>
                        <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                            All listed capabilities are included at no additional charge during the standard
                            subscription term. Overage and premium support packages are billed separately on a
                            monthly basis. Please contact
                            <span class="font-mono text-foreground">billing@@platform.co</span> with
                            questions regarding this statement.
                        </p>
                    </div>
                </div>
            </footer>
        </article>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[190px]">
                <LucideIconCn Name="download" Size="16" Class="size-4" aria-hidden="true" />
                Download PDF
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                <LucideIconCn Name="mail" Size="16" Class="size-4" aria-hidden="true" />
                Email to finance
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record InvoiceLineItem(
        string Id,
        string Description,
        string Detail,
        int Qty,
        string Rate,
        string Amount
    );

    private record Party(
        string Label,
        string Name,
        string Line1,
        string Line2,
        string Email
    );

    private record InvoiceMeta(
        string Number,
        string Issued,
        string Due,
        string Status
    );

    private record Totals(
        string Subtotal,
        string Discount,
        string Tax,
        string Total
    );

    private static readonly Party[] _parties =
    [
        new("Billed from", "Platform Co., Inc.", "340 Terminal Avenue, Suite 200", "Edge City, CA 94016", "billing@platform.co"),
        new("Billed to", "Northwind Logistics, LLC", "88 Harbor Way, Warehouse 3", "Seattle, WA 98101", "ap@northwind.example"),
    ];

    private static readonly InvoiceMeta _invoiceMeta = new("INV-2026-0421", "Apr 09, 2026", "May 09, 2026", "PAID");

    private static readonly InvoiceLineItem[] _lineItems =
    [
        new("edge", "Edge network & caching", "34 global regions, automatic routing", 1, "$0.00", "$0.00"),
        new("observability", "Full-stack observability", "Logs, metrics, traces, continuous profiling", 1, "$0.00", "$0.00"),
        new("deploys", "Instant rollback deploys", "Blue-green strategy, < 80ms switchover", 1, "$0.00", "$0.00"),
        new("security", "Enterprise auth & audit", "SSO, MFA enforcement, SOC 2 audit log", 1, "$0.00", "$0.00"),
        new("scale", "Scale-to-zero autoscaler", "0 to 10k req/s, no cold-start penalty", 1, "$0.00", "$0.00"),
        new("support", "24/7 white-glove support", "Named on-call engineer, 15 min SLA", 1, "$0.00", "$0.00"),
    ];

    private static readonly Totals _totals = new("$0.00", "-$0.00", "$0.00", "$0.00");
}
