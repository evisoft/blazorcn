@* ============================================================
   Block: features-animated-reveal
   Title: FeaturesAnimatedReveal
   Description: A split image and icon list features section for React and Next.js with a large crosshair image placeholder, an eyebrow pill, and a staggered icon-row feature list built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-animated-reveal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">
        <div class="grid items-center gap-8 lg:grid-cols-[5fr_6fr] lg:gap-12">
            @* Image side *@
            <div>
                <div class="flex aspect-[4/5] w-full items-center justify-center rounded-xl bg-muted">
                    <div class="relative flex items-center justify-center">
                        <div aria-hidden="true" class="absolute size-36 rounded-full border border-muted-foreground/[0.06]"></div>
                        <div aria-hidden="true" class="absolute size-20 rounded-full border border-muted-foreground/[0.08]"></div>
                        <div aria-hidden="true" class="absolute h-px w-48 bg-muted-foreground/[0.06]"></div>
                        <div aria-hidden="true" class="absolute h-48 w-px bg-muted-foreground/[0.06]"></div>
                        <div class="flex size-12 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                            <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/40" />
                        </div>
                    </div>
                </div>
            </div>

            @* Text side *@
            <div>
                <span class="inline-flex items-center gap-2 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-foreground">
                    <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                    Platform
                </span>
                <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                    Built for teams that ship fast
                </h2>
                <p class="mt-3 max-w-md text-base leading-relaxed text-muted-foreground">
                    Everything you need to build, deploy, and scale production applications — unified on a
                    single control plane.
                </p>

                @* Feature list *@
                <div class="mt-8 space-y-5">
                    @foreach (var feature in _features)
                    {
                        <div class="flex items-start gap-4">
                            <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted">
                                <LucideIconCn Name="@feature.IconName" Size="20" Class="size-5 text-muted-foreground" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <h3 class="text-base font-semibold">@feature.Title</h3>
                                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                                    @feature.Description
                                </p>
                            </div>
                        </div>
                    }
                </div>

                @* CTA row *@
                <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
                    <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[170px]">Learn more</ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record FeatureItem(string Id, string IconName, string Title, string Description);

    private static readonly FeatureItem[] _features =
    [
        new("performance", "zap", "Lightning fast performance", "Ahead-of-time compilation delivers instant startup and sub-200ms response times at the 99th percentile."),
        new("edge", "globe", "Global edge distribution", "Deploy to 50+ regions with automatic geo-routing, intelligent failover, and built-in CDN acceleration."),
        new("security", "lock", "Zero-trust security", "Every request authenticated and authorized at the edge before reaching your application infrastructure."),
        new("infrastructure", "server", "Fully managed infrastructure", "We handle servers, scaling, and maintenance so your engineering team can focus on shipping features."),
        new("observability", "activity", "Real-time observability", "Track performance, errors, and usage with built-in analytics, traces, and custom metric dashboards."),
        new("teams", "users", "Enterprise team management", "Invite members, assign granular roles, and manage permissions with a full audit trail and SAML SSO."),
    ];
}
