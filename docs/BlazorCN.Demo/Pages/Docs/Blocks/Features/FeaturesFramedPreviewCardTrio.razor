@* ============================================================
   Block: features-framed-preview-card-trio
   Title: FeaturesFramedPreviewCardTrio
   Description: A single-row framed preview card trio feature section for React and Next.js with three large spacious cards each showing an inset-framed crosshair image placeholder with a corner Preview label and generous p-6 text below built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-framed-preview-card-trio.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">

        @* Centered headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_headline.Eyebrow
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_headline.Title
            </h2>
            <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>
        </div>

        @* Single row of 3 large framed-preview cards *@
        <div class="mt-10 grid grid-cols-1 gap-6 lg:mt-14 lg:grid-cols-3 lg:gap-7">
            @foreach (var feature in _features)
            {
                <article class="overflow-hidden rounded-2xl border bg-background p-0">

                    @* Framed preview area — top half *@
                    <div class="relative border-b bg-muted p-4">
                        @* Decorative inset border frame *@
                        <div class="relative flex aspect-[16/10] w-full items-center justify-center overflow-hidden rounded-lg border border-muted-foreground/10 bg-background/40">

                            @* Corner overlay label *@
                            <span class="absolute left-3 top-3 z-10 inline-flex items-center rounded-md border border-muted-foreground/15 bg-background/80 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider text-muted-foreground backdrop-blur-sm">
                                Preview
                            </span>

                            @* Crosshair placeholder *@
                            <div class="relative flex items-center justify-center">
                                <div aria-hidden="true" class="absolute size-28 rounded-full border border-muted-foreground/[0.06]"></div>
                                <div aria-hidden="true" class="absolute size-16 rounded-full border border-muted-foreground/[0.08]"></div>
                                <div aria-hidden="true" class="absolute h-px w-36 bg-muted-foreground/[0.06]"></div>
                                <div aria-hidden="true" class="absolute h-36 w-px bg-muted-foreground/[0.06]"></div>
                                <div class="flex size-9 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/70">
                                    <LucideIconCn Name="image" Size="16" StrokeWidth="2" Class="size-4 text-muted-foreground/40" aria-hidden="true" />
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Text area — bottom half, generous padding *@
                    <div class="p-6">
                        <h3 class="text-lg font-semibold text-foreground">@feature.Title</h3>
                        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                            @feature.Description
                        </p>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);

    private record FeatureData(string Id, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        Eyebrow: "Three pillars",
        Title: "Everything we built the platform around",
        Subtitle: "Not ten features we could hang a badge on. Three deliberate surfaces that handle the work most teams spend their week inside."
    );

    private static readonly FeatureData[] _features =
    [
        new("canvas", "Spatial canvas",
            "Zoom across every project surface on a single infinite canvas. Pin reference material, group related work, and never lose your place across weeks of iteration."),
        new("threads", "Threaded reviews",
            "Every comment lives on the exact pixel it references. Resolved threads collapse out of sight, open threads pin to the canvas, and nothing important ever gets buried in a Slack channel."),
        new("handoff", "Automatic handoff",
            "The moment a design is marked ready, tokens, specs, and assets publish to engineering in the format their stack expects. No exporter, no manual ceremony, no drift between design and code."),
    ];
}
