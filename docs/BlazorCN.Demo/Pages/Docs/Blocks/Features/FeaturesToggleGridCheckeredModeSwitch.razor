@* ============================================================
   Block: features-toggle-grid-checkered-mode-switch
   Title: FeaturesToggleGridCheckeredModeSwitch
   Description: A toggle grid checkered mode switch features section for React and Next.js with a segmented Free/Pro control, a six-cell comparison grid that crossfades all content, per-cell stagger, and animated metric deltas built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-toggle-grid-checkered-mode-switch.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Headline cluster *@
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
          Compare the plans
        </span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
          Flip the grid. Watch every feature move.
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          Every cell shows the same capability under two tiers. Toggle to see what you get when
          you upgrade — the delta pill keeps the difference in plain sight.
        </p>
      </div>

      @* Segmented control *@
      <div
        role="radiogroup"
        aria-label="Plan tier"
        class="relative flex items-center rounded-full border bg-muted/30 p-1"
      >
        @foreach (var mode in _planModes)
        {
          var modeItem = mode;
          var isActive = modeItem.Id == _activeMode;
          <button
            type="button"
            role="radio"
            aria-checked="@isActive.ToString().ToLower()"
            @onclick="@(() => _activeMode = modeItem.Id)"
            class="@(Cn.Merge(
              "relative z-10 flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-medium transition-colors",
              isActive ? "bg-background shadow-sm" : ""
            ))"
          >
            <span class="@(Cn.Merge("relative", isActive ? "text-foreground" : "text-muted-foreground"))">
              @modeItem.Label
            </span>
            <span class="@(Cn.Merge("relative font-mono text-[10px]", isActive ? "text-muted-foreground" : "text-muted-foreground/60"))">
              @modeItem.Sublabel
            </span>
          </button>
        }
      </div>
    </div>

    @* Comparison grid *@
    <div class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-3">
      @foreach (var cell in _comparisonCells)
      {
        var cellItem = cell;
        var state = _activeMode == "pro" ? cellItem.States.Pro : cellItem.States.Free;
        var accent = GetAccent(state.Accent);
        var cellIndex = System.Array.IndexOf(_comparisonCells, cellItem);
        <div class="relative overflow-hidden rounded-xl border bg-card">
          @* Static header *@
          <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
              <span class="flex size-7 items-center justify-center rounded-md border bg-background">
                <LucideIconCn Name="@cellItem.IconName" Size="14" Class="size-3.5 text-foreground" />
              </span>
              <span class="text-[11px] font-medium uppercase tracking-wider text-foreground">
                @cellItem.Label
              </span>
            </div>
            <span class="font-mono text-[10px] text-muted-foreground tabular-nums">
              @((cellIndex + 1).ToString("D2"))
            </span>
          </div>

          @* State body *@
          <div class="@(Cn.Merge("relative p-4", accent.Bg))">
            <div class="flex items-baseline justify-between gap-2">
              <span class="font-mono text-xl font-semibold text-foreground tabular-nums">
                @state.Value
              </span>
              @if (_activeMode == "pro")
              {
                <span class="@(Cn.Merge("rounded-full border bg-background px-2 py-0.5 text-[10px] font-medium", accent.Text))">
                  @cellItem.Delta
                </span>
              }
            </div>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
              @state.Description
            </p>
            <ul class="mt-3 space-y-1.5">
              @foreach (var capability in state.Capabilities)
              {
                <li class="flex items-center gap-1.5 text-[11px] text-foreground">
                  <span class="@(Cn.Merge("flex size-3 items-center justify-center rounded-full", accent.Bg))">
                    <LucideIconCn Name="check" Size="8" Class="@(Cn.Merge("size-2", accent.Text))" />
                  </span>
                  <span>@capability</span>
                </li>
              }
            </ul>
          </div>
        </div>
      }
    </div>

    @* Footer summary *@
    <div class="mt-6 flex flex-col gap-3 rounded-xl border bg-muted/30 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <div>
          <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
            Now showing
          </div>
          <div class="mt-0.5 text-sm font-medium text-foreground">
            @(_activeMode == "pro" ? "Pro · Scale" : "Free · Starter")
          </div>
        </div>
      </div>
      <div class="flex items-center gap-2 text-[11px]">
        <span class="text-muted-foreground">6 features compared</span>
        <span class="size-1 rounded-full bg-muted-foreground/40"></span>
        <span class="text-muted-foreground">Crossfade on toggle</span>
        <span class="size-1 rounded-full bg-muted-foreground/40"></span>
        <span class="@(Cn.Merge("font-medium", _activeMode == "pro" ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground"))">
          @(_activeMode == "pro" ? "All upgrades shown" : "Baseline tier")
        </span>
      </div>
    </div>
  </div>
</section>

@code {
    private string _activeMode = "pro";

    private record AccentClasses(string Bg, string Dot, string Text);

    private record CellStateData(
        string Value,
        string Description,
        string[] Capabilities,
        string Accent
    );

    private record CellStates(CellStateData Free, CellStateData Pro);

    private record ComparisonCellData(
        string Id,
        string IconName,
        string Label,
        string Delta,
        CellStates States
    );

    private record PlanMode(string Id, string Label, string Sublabel);

    private static readonly PlanMode[] _planModes =
    [
        new PlanMode("free", "Free", "Starter"),
        new PlanMode("pro", "Pro", "Scale"),
    ];

    private static readonly ComparisonCellData[] _comparisonCells =
    [
        new ComparisonCellData(
            "team",
            "users",
            "Team members",
            "+45 seats",
            new CellStates(
                new CellStateData("5 seats", "Invite up to five collaborators to a single workspace.", ["Single workspace", "Viewer roles only"], "muted"),
                new CellStateData("50 seats", "Invite up to fifty collaborators across multiple workspaces with SSO.", ["Unlimited workspaces", "Custom roles", "SAML SSO"], "emerald")
            )
        ),
        new ComparisonCellData(
            "storage",
            "hard-drive",
            "Storage",
            "500× more",
            new CellStates(
                new CellStateData("2 GB", "Two gigabytes of asset storage with a ten megabyte file size cap.", ["10 MB files", "7-day retention"], "muted"),
                new CellStateData("1 TB", "A full terabyte of asset storage with no per-file size cap.", ["No file cap", "Versioned history", "Edge CDN"], "emerald")
            )
        ),
        new ComparisonCellData(
            "analytics",
            "bar-chart-3",
            "Analytics",
            "Full history",
            new CellStates(
                new CellStateData("24 hours", "Basic traffic and event counts for the last twenty-four hours.", ["Pageviews", "Top referrers"], "muted"),
                new CellStateData("24 months", "Two years of granular event history with funnels and retention cohorts.", ["Funnels", "Retention", "Custom dashboards"], "blue")
            )
        ),
        new ComparisonCellData(
            "support",
            "headphones",
            "Support",
            "24/7 coverage",
            new CellStates(
                new CellStateData("Community", "Community forum and help center with best-effort responses.", ["Help center", "Forum"], "muted"),
                new CellStateData("4-min SLA", "A private Slack channel staffed by tier-three engineers around the clock.", ["Slack channel", "4-min first response", "Tier-3 engineers"], "emerald")
            )
        ),
        new ComparisonCellData(
            "api",
            "cloud",
            "API calls",
            "100× quota",
            new CellStates(
                new CellStateData("10k / mo", "Ten thousand API calls per month with a rate limit of sixty per minute.", ["60 req/min", "Shared pool"], "muted"),
                new CellStateData("1M / mo", "One million API calls per month with a rate limit of ten thousand per minute.", ["10k req/min", "Dedicated pool", "Webhook retries"], "blue")
            )
        ),
        new ComparisonCellData(
            "uptime",
            "shield-check",
            "Uptime SLA",
            "Contractual",
            new CellStates(
                new CellStateData("Best-effort", "No formal SLA. Status page and incident history available for transparency.", ["Status page", "Incident history"], "muted"),
                new CellStateData("99.99%", "Four-nines contractual SLA with service credits if the target is missed.", ["99.99% SLA", "Service credits", "Dedicated region"], "emerald")
            )
        ),
    ];

    private static AccentClasses GetAccent(string accent) => accent switch
    {
        "emerald" => new AccentClasses("bg-emerald-500/10", "bg-emerald-500", "text-emerald-600 dark:text-emerald-400"),
        "blue"    => new AccentClasses("bg-blue-500/10",    "bg-blue-500",    "text-blue-600 dark:text-blue-400"),
        _         => new AccentClasses("bg-muted/40",        "bg-muted-foreground/40", "text-muted-foreground"),
    };
}
