@* ============================================================
   Block: features-divided-three-column-card
   Title: FeaturesDividedThreeColumnCard
   Description: A divided three-column card feature section for React and Next.js with a single bordered container internally split into three equal columns each showing an icon, title, description, and inline arrow link built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-divided-three-column-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  @* Header *@
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
      @_headline.Eyebrow
    </p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
      @_headline.Title
    </h2>
    <p class="mt-4 text-base leading-relaxed text-muted-foreground">@_headline.Subtitle</p>
  </div>

  @* Single divided card *@
  <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
    <div class="grid grid-cols-1 divide-y divide-border md:grid-cols-3 md:divide-x md:divide-y-0">
      @foreach (var col in _columns)
      {
        <div class="group p-6 sm:p-8">
          <div aria-hidden="true" class="flex size-10 items-center justify-center rounded-lg border bg-background">
            <LucideIconCn Name="@col.Icon" Size="16" Class="size-4 text-foreground" />
          </div>
          <h3 class="mt-5 text-base font-semibold text-foreground">@col.Title</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            @col.Description
          </p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-foreground transition-colors group-hover:text-muted-foreground">
            @col.LinkLabel
            <LucideIconCn Name="arrow-up-right" Size="14" Class="size-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
          </span>
        </div>
      }
    </div>
  </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record ColumnItem(string Id, string Icon, string Title, string Description, string LinkLabel);

    private static readonly HeadlineData _headline = new(
        "Why teams switch",
        "Three reasons to move your stack this quarter",
        "The capabilities that matter most when the roadmap is full and the runway is tight."
    );

    private static readonly ColumnItem[] _columns =
    [
        new("velocity", "zap", "Ship in hours, not weeks",
            "Pre-built primitives, typed SDKs, and zero-config deployments collapse the gap between commit and production.",
            "See the quickstart"),
        new("reliability", "shield-check", "Built to stay up at 3am",
            "A triple-replicated data layer, regional failover, and a 99.99% uptime SLA keep paging quiet during peak load.",
            "Read the SLA"),
        new("scale", "rocket", "Grows with every release",
            "Elastic compute, usage-based pricing, and per-tenant isolation let you onboard an enterprise without a replatform.",
            "View the scale report"),
    ];
}
