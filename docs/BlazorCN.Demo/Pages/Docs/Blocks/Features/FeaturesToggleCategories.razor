@* ============================================================
   Block: features-toggle-categories
   Title: Features Toggle Categories
   Description: Features with interactive category filter using pill-style buttons to show/hide content
   Long Description: Features organized by user role
   Dependencies: None
   Source: original/blocks/features/features-toggle-categories.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
          <h2 class="text-sm font-medium">Features</h2>
          <p class="mt-1 text-muted-foreground text-xs">Filter by category</p>
        </div>

        <div class="border-b px-4 py-3">
          <div class="flex flex-wrap gap-2">
            @foreach (var category in _categories)
            {
              <button
                type="button"
                @onclick="@(() => _selectedCategory = category)"
                class="@(Cn.Merge(
                  "rounded-full px-3 py-1 text-xs font-medium transition-colors",
                  _selectedCategory == category
                    ? "bg-foreground text-background"
                    : "bg-muted text-muted-foreground hover:bg-muted/80"
                ))"
              >
                @category
              </button>
            }
          </div>
        </div>

        <div class="divide-y">
          @foreach (var feature in FilteredFeatures)
          {
            <div class="px-4 py-3">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <div class="text-sm font-medium">@feature.Name</div>
                  <div class="mt-0.5 text-muted-foreground text-xs">@feature.Description</div>
                </div>
                <span class="shrink-0 text-nowrap text-muted-foreground text-xs">
                  @feature.Category
                </span>
              </div>
            </div>
          }
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
          <p class="text-muted-foreground text-xs">
            Showing @FilteredFeatures.Length of @_allFeatures.Length features
          </p>
        </div>
      </div>
    </section>

@code {
    private string _selectedCategory = "All";

    private record FeatureData(string Name, string Description, string Category);

    private static readonly string[] _categories = new[] { "All", "Core", "Analytics", "Security", "Integration" };

    private static readonly FeatureData[] _allFeatures = new[]
    {
        new FeatureData("Issue Tracking", "Create, assign, and track issues with custom workflows", "Core"),
        new FeatureData("Sprint Planning", "Organize work into time-boxed iterations", "Core"),
        new FeatureData("Real-time Dashboard", "Live metrics and team performance insights", "Analytics"),
        new FeatureData("Custom Reports", "Build reports with drag-and-drop widgets", "Analytics"),
        new FeatureData("Role-based Access", "Granular permissions with custom roles", "Security"),
        new FeatureData("SSO Integration", "SAML 2.0 and OIDC support", "Security"),
        new FeatureData("API Access", "REST and GraphQL APIs", "Integration"),
        new FeatureData("Webhooks", "Real-time event notifications", "Integration"),
    };

    private FeatureData[] FilteredFeatures => _selectedCategory == "All"
        ? _allFeatures
        : _allFeatures.Where(f => f.Category == _selectedCategory).ToArray();
}
