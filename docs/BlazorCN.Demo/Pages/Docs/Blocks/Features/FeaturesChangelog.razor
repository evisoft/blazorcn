@* ============================================================
   Block: features-changelog
   Title: Features Changelog
   Description: Versioned feature updates with status indicators, perfect for product changelog pages and release notes in Next.js applications.
   Long Description: Horizontal feature carousel with navigation arrows and responsive card sizing for browsing many features in React
   Dependencies: None
   Source: original/blocks/features/features-changelog.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Product Changelog</h2>
            <p class="mt-1 text-xs text-muted-foreground">Latest features and improvements</p>
        </div>
        @for (var i = 0; i < _entries.Length; i++)
        {
            var entry = _entries[i];
            <div class="@(Cn.Merge("px-4 py-4", i < _entries.Length - 1 ? "border-b" : ""))">
                <div class="flex items-start gap-3">
                    <span class="@(Cn.Merge("mt-0.5 size-1.5 shrink-0 rounded-full", GetStatusBg(entry.Status)))"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-muted-foreground text-xs">@entry.Version</span>
                            <span class="text-muted-foreground text-xs">&#xB7;</span>
                            <span class="text-muted-foreground text-xs">@entry.Date</span>
                            <span class="text-muted-foreground text-xs">&#xB7;</span>
                            <span class="@(Cn.Merge("text-xs", GetStatusText(entry.Status)))">
                                @GetStatusLabel(entry.Status)
                            </span>
                        </div>
                        <h3 class="mt-1 text-sm font-medium">@entry.Title</h3>
                        <p class="mt-1 text-sm text-muted-foreground">@entry.Description</p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record ChangelogEntry(string Version, string Date, string Status, string Title, string Description);

    private static readonly ChangelogEntry[] _entries =
    [
        new("v2.8", "Mar 15, 2026", "new", "Multi-region Deployments",
            "Deploy your application to multiple geographic regions with automatic traffic routing and failover support."),
        new("v2.8", "Mar 15, 2026", "improved", "Edge Function Performance",
            "Cold start times reduced by 60% through optimized runtime initialization and dependency bundling."),
        new("v2.7", "Mar 8, 2026", "new", "Visual Workflow Builder",
            "Create complex automation workflows with a drag-and-drop interface. No code required for common patterns."),
        new("v2.7", "Mar 8, 2026", "fixed", "Webhook Retry Logic",
            "Webhooks now use exponential backoff with jitter for failed deliveries. Configurable retry limits per endpoint."),
        new("v2.6", "Mar 1, 2026", "new", "Custom Domain SSL",
            "Automatic SSL certificate provisioning and renewal for custom domains. Zero-downtime certificate updates."),
        new("v2.6", "Mar 1, 2026", "improved", "Analytics Dashboard",
            "Redesigned analytics with real-time data streaming. New metrics for Core Web Vitals and conversion funnels."),
        new("v2.5", "Feb 22, 2026", "new", "Team Collaboration",
            "Invite team members with role-based access control. Audit logs track all changes with user attribution."),
        new("v2.5", "Feb 22, 2026", "fixed", "Build Cache Invalidation",
            "Fixed edge case where build cache wasn't invalidated after environment variable changes."),
    ];

    private static string GetStatusBg(string status) => status switch
    {
        "new" => "bg-emerald-500",
        "improved" => "bg-blue-500",
        "fixed" => "bg-red-500",
        _ => "bg-gray-500",
    };

    private static string GetStatusText(string status) => status switch
    {
        "new" => "text-emerald-500",
        "improved" => "text-blue-500",
        "fixed" => "text-red-500",
        _ => "text-gray-500",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "new" => "New",
        "improved" => "Improved",
        "fixed" => "Fixed",
        _ => status,
    };
}
