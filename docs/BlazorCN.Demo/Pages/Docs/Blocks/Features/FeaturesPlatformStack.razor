@* ============================================================
   Block: features-platform-stack
   Title: Features Platform Stack
   Description: A visual representation of technology platform layers from infrastructure to UI with included technologies
   Dependencies: None
   Source: original/blocks/features/features-platform-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Platform Architecture</h2>
            <p class="mt-1 text-xs text-muted-foreground">Technology stack organized by layer</p>
        </div>

        <div class="flex flex-col-reverse">
            @for (var i = 0; i < _layers.Length; i++)
            {
                var layer = _layers[i];
                <div class="@(i < _layers.Length - 1 ? "border-t" : "")">
                    <div class="border-b bg-muted/30 px-4 py-2">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@layer.Name</span>
                            <span class="text-xs text-muted-foreground">&bull;</span>
                            <span class="text-xs text-muted-foreground">@layer.Description</span>
                        </div>
                    </div>
                    <div class="px-4 py-3">
                        <div class="flex flex-wrap gap-2">
                            @foreach (var tech in layer.Technologies)
                            {
                                <span class="rounded-md bg-muted/50 px-2 py-1 text-xs font-medium">@tech</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
            <p class="text-xs text-muted-foreground">Updated monthly &bull; Last update: March 2026</p>
        </div>
    </div>
</section>

@code {
    private record PlatformLayer(string Name, string Description, string[] Technologies);

    private static readonly PlatformLayer[] _layers =
    [
        new("UI Layer", "Frontend frameworks and component libraries", ["React 19", "Next.js 16", "Tailwind CSS 4", "shadcn/ui"]),
        new("API Layer", "Application programming interfaces and integrations", ["REST API", "GraphQL", "Webhooks", "Server Actions"]),
        new("Data Layer", "Database and caching infrastructure", ["PostgreSQL", "Redis", "Prisma ORM", "Drizzle"]),
        new("Infrastructure", "Cloud platform and runtime environment", ["Vercel Edge Network", "Docker", "Kubernetes", "GitHub Actions"]),
    ];
}
