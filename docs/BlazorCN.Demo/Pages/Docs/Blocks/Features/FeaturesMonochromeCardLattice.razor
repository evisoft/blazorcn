@* ============================================================
   Block: features-monochrome-card-lattice
   Title: FeaturesMonochromeCardLattice
   Description: A monochrome 3x3 card lattice features section for React and Next.js with a centered eyebrow and marketing headline and nine tight compact cells using gap-px on a bg-muted parent so gaps act as dividers without individual card borders seven with small icon plus title and two summary cells built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-monochrome-card-lattice.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div>
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        @_headline.Eyebrow
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        @_headline.Title
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
        @_headline.Subtitle
      </p>
    </div>

    <div class="mt-12 overflow-hidden rounded-2xl border">
      <div class="grid grid-cols-1 gap-px bg-border sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var cell in _cells)
        {
          if (cell.Kind == "summary")
          {
            <div class="flex flex-col justify-between bg-muted/30 p-4">
              <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @cell.Label
              </p>
              <p class="mt-6 text-sm leading-relaxed text-foreground">@cell.Body</p>
            </div>
          }
          else
          {
            <div class="flex items-center gap-3 bg-card p-4">
              <div aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                <LucideIconCn Name="@cell.IconName" Size="16" Class="size-4 text-foreground" />
              </div>
              <h3 class="text-sm font-semibold text-foreground">@cell.Title</h3>
            </div>
          }
        }
      </div>
    </div>
  </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);

    private record CellData(
        string Kind,
        string Id,
        string Title = "",
        string IconName = "",
        string Label = "",
        string Body = ""
    );

    private static readonly HeadlineData _headline = new(
        Eyebrow: "Under the hood",
        Title: "Nine building blocks, one coherent system",
        Subtitle: "A dense lattice of the primitives our platform is built on. Every cell is production-grade and composes with every other cell without adapters or glue code."
    );

    private static readonly CellData[] _cells =
    [
        new CellData(Kind: "feature", Id: "event-stream",   Title: "Event stream",       IconName: "radio"),
        new CellData(Kind: "feature", Id: "typed-schema",   Title: "Typed schema",        IconName: "layers"),
        new CellData(Kind: "summary", Id: "summary-seven",  Label: "Seven primitives",    Body: "Each cell is a production-grade service you can call, compose, or replace."),
        new CellData(Kind: "feature", Id: "row-security",   Title: "Row-level security",  IconName: "shield"),
        new CellData(Kind: "feature", Id: "live-metrics",   Title: "Live metrics",        IconName: "line-chart"),
        new CellData(Kind: "feature", Id: "connector-hub",  Title: "Connector hub",       IconName: "plug"),
        new CellData(Kind: "feature", Id: "data-warehouse", Title: "Data warehouse",      IconName: "database"),
        new CellData(Kind: "summary", Id: "summary-one",    Label: "One system",          Body: "No adapters, no glue code, no separate control planes to manage."),
        new CellData(Kind: "feature", Id: "health-checks",  Title: "Health checks",       IconName: "activity"),
    ];
}
