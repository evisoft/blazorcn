@* ============================================================
   Block: features-audio-mixer-slider-board
   Title: FeaturesAudioMixerSliderBoard
   Description: A mixer-inspired features section for React and Next.js with six vertical channel strips featuring knobs, faders, level meters, and mute/solo controls, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-audio-mixer-slider-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Header *@
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Fine-grained control
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Tune every channel of your platform, independently.
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        Six independent feature channels, each with their own knob, fader, and meter — no magic
        defaults, no hidden coupling between subsystems.
      </p>
    </div>

    @* Mixer board *@
    <div class="mt-10 rounded-xl border bg-muted/30 p-4">
      <div class="grid min-h-[400px] grid-cols-3 gap-2 sm:grid-cols-6">
        @foreach (var ch in _channels)
        {
          var channel = ch;
          @* Channel strip *@
          <div class="flex flex-col items-center gap-3 rounded-md border bg-card p-3">
            @* Label *@
            <span class="w-full truncate text-center text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
              @channel.Label
            </span>

            @* Knob *@
            <div class="relative size-12 rounded-full border-2 border-border bg-muted/40">
              <div class="absolute inset-0" style="@($"transform:rotate({channel.KnobAngle - 135}deg)")">
                <div class="absolute left-1/2 top-1 h-3 w-[2px] -translate-x-1/2 rounded-full bg-foreground"></div>
              </div>
              <div class="absolute left-1/2 top-1/2 size-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-foreground/40"></div>
            </div>

            @* Mute / Solo *@
            <div class="flex w-full gap-1">
              <div class="@(Cn.Merge("flex-1 rounded-sm border py-[3px] text-center text-[9px] font-bold uppercase tracking-wider", channel.Muted ? "border-red-500/40 bg-red-500/10 text-red-500" : "border-border bg-background text-muted-foreground"))">
                M
              </div>
              <div class="flex-1 rounded-sm border border-border bg-background py-[3px] text-center text-[9px] font-bold uppercase tracking-wider text-muted-foreground">
                S
              </div>
            </div>

            @* Fader + Meter *@
            <div class="flex h-40 w-full gap-2 py-1">
              @* Fader *@
              <div class="flex-1">
                <div class="relative mx-auto h-full w-6">
                  @* Track *@
                  <div class="absolute left-1/2 top-0 h-full w-[2px] -translate-x-1/2 rounded-full bg-border"></div>
                  @* Tick marks *@
                  <div class="absolute inset-0 flex flex-col justify-between py-1">
                    @for (int t = 0; t < 7; t++)
                    {
                      <div class="mx-auto h-[1px] w-3 bg-muted-foreground/40"></div>
                    }
                  </div>
                  @* Slider knob *@
                  <div class="absolute left-1/2 h-4 w-5 -translate-x-1/2 rounded-sm border border-border bg-foreground shadow-sm"
                       style="@($"top:calc({100 - channel.Fader}% - 8px)")">
                  </div>
                </div>
              </div>
              @* Level meter *@
              <div class="flex w-2 items-end">
                <div class="flex flex-col-reverse gap-[3px]">
                  @for (int i = 0; i < 8; i++)
                  {
                    var activeTicks = (int)Math.Round((channel.Level / 100.0) * 8);
                    var isActive = i < activeTicks;
                    var isHigh = i >= 6;
                    var isMid = i >= 4 && i < 6;
                    var meterClass = isActive
                      ? (isHigh ? "bg-red-500" : (isMid ? "bg-amber-500" : "bg-emerald-500"))
                      : "bg-muted";
                    <div class="@($"h-[3px] w-full rounded-[1px] {meterClass}")"></div>
                  }
                </div>
              </div>
            </div>

            @* Number *@
            <span class="font-mono text-[10px] text-muted-foreground">@channel.Number</span>
          </div>
        }
      </div>
    </div>

    @* CTA pair *@
    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <ButtonCn Class="w-full sm:w-[170px]">Open mixer</ButtonCn>
      <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">See all channels</ButtonCn>
    </div>
  </div>
</section>

@code {
    private record Channel(string Id, string Label, string Number, int Fader, int Level, int KnobAngle, bool Muted);

    private static readonly Channel[] _channels =
    [
        new("latency",    "Latency",    "01", 72, 65, 195, false),
        new("caching",    "Caching",    "02", 88, 82, 235, false),
        new("queues",     "Queues",     "03", 55, 48, 150, false),
        new("retries",    "Retries",    "04", 40, 30, 110, true),
        new("tracing",    "Tracing",    "05", 80, 75, 220, false),
        new("rate-limit", "Rate limit", "06", 62, 58, 175, false),
    ];
}
