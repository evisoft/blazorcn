@* ============================================================
   Block: features-segmented-accordion-mockup
   Title: FeaturesSegmentedAccordionMockup
   Description: A segmented accordion mockup feature section for React and Next.js with a top PillTabs category selector, a 40/60 accordion and image split, and a crosshair mockup that swaps via AnimatePresence when the accordion selection changes built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-segmented-accordion-mockup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10">

        @* Headline *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Platform
            </p>
            <h2 class="mx-auto mt-3 max-w-2xl text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
                One workflow from first commit to global rollout
            </h2>
            <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-muted-foreground">
                Switch stages, drill into any capability, and see the matching screen update beside it
                in real time.
            </p>
        </div>

        @* Segmented control (PillTabs rendered as styled tab buttons) *@
        <div class="mt-8 flex justify-center">
            <div class="inline-flex rounded-full border bg-muted p-1 gap-1">
                @foreach (var tab in _tabs)
                {
                    var t = tab;
                    <button
                        type="button"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _activeTab == t ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => HandleTabChange(t))">
                        @char.ToUpper(t[0])@t.Substring(1)
                    </button>
                }
            </div>
        </div>

        @* 40/60 accordion + mockup split *@
        <div class="mt-10 grid gap-6 lg:grid-cols-[2fr_3fr] lg:gap-8">

            @* Left — Accordion (40%) *@
            <div class="min-w-0">
                <div class="divide-y divide-border/60">
                    @foreach (var feature in _activeFeatures)
                    {
                        var feat = feature;
                        <div class="border-b-0">
                            <button
                                type="button"
                                class="flex w-full items-center justify-between py-3.5 text-left text-sm font-semibold hover:no-underline sm:text-base"
                                @onclick="@(() => SetActiveFeature(feat.Id))">
                                <span>@feat.Title</span>
                                <LucideIconCn Name="chevron-down" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground shrink-0 transition-transform duration-200", _activeFeatureId == feat.Id ? "rotate-180" : "")" />
                            </button>
                            @if (_activeFeatureId == feat.Id)
                            {
                                <div class="pb-4">
                                    <p class="text-sm leading-relaxed text-muted-foreground">
                                        @feat.Description
                                    </p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @* Right — Crosshair mockup (60%) *@
            <div aria-hidden="true" class="min-w-0">
                <div class="flex aspect-[4/3] w-full items-center justify-center rounded-xl bg-muted">
                    <div class="relative flex items-center justify-center">
                        <div class="absolute size-24 rounded-full border border-muted-foreground/[0.06]"></div>
                        <div class="absolute size-14 rounded-full border border-muted-foreground/[0.08]"></div>
                        <div class="absolute h-px w-32 bg-muted-foreground/[0.06]"></div>
                        <div class="absolute h-32 w-px bg-muted-foreground/[0.06]"></div>
                        <div class="flex size-8 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private static readonly string[] _tabs = ["build", "ship", "scale"];

    private record Feature(string Id, string Title, string Description);

    private static readonly Dictionary<string, Feature[]> _featureGroups = new()
    {
        ["build"] =
        [
            new Feature("build-editor", "Block-based editor",
                "Drag-and-drop rich text, code, tables, and embeds with a keyboard-first command palette that works like a native IDE."),
            new Feature("build-templates", "Template gallery",
                "Ship new pages from 60+ curated templates tuned for engineering briefs, design specs, and project trackers."),
            new Feature("build-ai", "AI co-author",
                "Generate outlines, rewrite sections, and summarize threads with a focus model that stays grounded in your workspace context."),
            new Feature("build-versioning", "Named checkpoints",
                "Tag any save as a named checkpoint, roll back with one click, and diff two revisions side by side without leaving the editor."),
        ],
        ["ship"] =
        [
            new Feature("ship-preview", "Preview deploys",
                "Every branch gets an isolated preview URL with immutable builds and automatic teardown after merge."),
            new Feature("ship-env", "Environment sync",
                "Promote environment variables across dev, staging, and production with a single click and encrypted audit trail."),
            new Feature("ship-rollback", "Instant rollbacks",
                "Revert to any previous deploy in under 5 seconds. Traffic drains to the previous build without dropping in-flight requests."),
            new Feature("ship-analytics", "Deploy analytics",
                "Track deployment frequency, lead time, and change failure rate inline on the dashboard with DORA metrics."),
        ],
        ["scale"] =
        [
            new Feature("scale-edge", "Global edge network",
                "Serve every request from the nearest of 190+ edge locations with automatic failover and smart DNS routing."),
            new Feature("scale-cache", "Stale-while-revalidate",
                "Cache dynamic routes at the edge with per-request revalidation tags that invalidate precisely what changed."),
            new Feature("scale-isolation", "Dedicated tenants",
                "Single-tenant deployments with isolated databases and private networking for regulated industries and enterprise customers."),
            new Feature("scale-observability", "Built-in observability",
                "Structured logs, request traces, and metrics flow to your dashboards out of the box with zero agent setup."),
        ],
    };

    private string _activeTab = "build";
    private string _activeFeatureId = "build-editor";

    private Feature[] _activeFeatures => _featureGroups[_activeTab];

    private void HandleTabChange(string tab)
    {
        _activeTab = tab;
        _activeFeatureId = _featureGroups[tab][0].Id;
    }

    private void SetActiveFeature(string id)
    {
        if (_activeFeatureId != id)
            _activeFeatureId = id;
    }
}
