@* ============================================================
   Block: features-ribbon-wave-timeline-scroll
   Title: FeaturesRibbonWaveTimelineScroll
   Description: A ribbon wave timeline features section for React and Next.js with an SVG sine-wave path, six feature nodes positioned along the curve, an animated drawing stroke, and a detail card for the selected capability built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-ribbon-wave-timeline-scroll.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Headline *@
    <div class="max-w-xl">
      <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
        Platform ribbon
      </span>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Follow the wave through six capabilities.
      </h2>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">
        A single ribbon connects every piece of the platform. Click a node to pull its detail
        into focus below — the curve holds your place while you read.
      </p>
    </div>

    @* Ribbon SVG *@
    <div class="mt-10 overflow-hidden rounded-2xl border bg-card p-6 md:p-8">
      <svg
        viewBox="0 0 1000 220"
        preserveAspectRatio="xMidYMid meet"
        class="h-auto w-full"
      >
        <title>Platform capability ribbon</title>

        @* The nodes are real buttons, so role="img" is scoped to the decorative subtree *@
        <g role="img" aria-label="Platform capability ribbon with six nodes">
          @* Grid dots — subtle texture *@
          @foreach (var row in Enumerable.Range(0, 5))
          {
            @foreach (var col in Enumerable.Range(0, 20))
            {
              <circle
                cx="@(col * 52 + 10)"
                cy="@(row * 44 + 12)"
                r="0.8"
                fill="currentColor"
                class="text-muted-foreground/20"
              />
            }
          }

          @* Ribbon path — dashed background *@
          <path
            d="M 40 110 Q 160 30 280 110 T 520 110 T 760 110 T 1000 110"
            stroke="currentColor"
            stroke-width="2"
            stroke-dasharray="6 4"
            stroke-linecap="round"
            fill="none"
            class="text-muted-foreground/30"
          />

          @* Ribbon path — solid foreground (static, no animation) *@
          <path
            d="M 40 110 Q 160 30 280 110 T 520 110 T 760 110 T 1000 110"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            fill="none"
            class="text-foreground"
          />
        </g>

        @* Nodes *@
        @foreach (var node in _nodes)
        {
          var nd = node;
          var isActive = nd.Id == _activeId;
          <g>
            @* Halo ring for active *@
            @if (isActive)
            {
              <circle
                cx="@nd.X"
                cy="@nd.Y"
                r="32"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                class="text-foreground/20"
              />
            }

            @* Node background circle *@
            <circle
              cx="@nd.X"
              cy="@nd.Y"
              r="@(isActive ? 22 : 18)"
              fill="currentColor"
              class="@Cn.Merge("transition-colors", isActive ? "text-foreground" : "text-background")"
              stroke="currentColor"
              stroke-width="1.5"
            />

            @* Click target via foreignObject *@
            <foreignObject
              x="@(nd.X - 26)"
              y="@(nd.Y - 26)"
              width="52"
              height="52"
            >
              <button
                type="button"
                aria-pressed="@(isActive ? "true" : "false")"
                aria-label="@($"Show {nd.Title}")"
                @onclick="@(() => _activeId = nd.Id)"
                class="flex size-full cursor-pointer items-center justify-center rounded-full"
              >
                <LucideIconCn Name="@nd.IconName" Size="16" Class="@Cn.Merge("size-4 transition-colors", isActive ? "text-background" : "text-foreground")" />
                <span class="sr-only">@nd.Title</span>
              </button>
            </foreignObject>

            @* Label below/above *@
            <text
              x="@nd.X"
              y="@(nd.Y > 110 ? nd.Y + 44 : nd.Y - 34)"
              text-anchor="middle"
              class="@Cn.Merge("font-mono text-[10px] uppercase tracking-widest transition-colors", isActive ? "fill-foreground" : "fill-muted-foreground")"
            >
              @nd.Eyebrow
            </text>
          </g>
        }
      </svg>
    </div>

    @* Active detail card *@
    @{
      var activeNode = _nodes.FirstOrDefault(n => n.Id == _activeId) ?? _nodes[0];
      var activeIndex = Array.FindIndex(_nodes, n => n.Id == _activeId);
      if (activeIndex < 0) activeIndex = 0;
    }
    <div class="mt-6 overflow-hidden rounded-2xl border bg-card">
      <div class="grid grid-cols-1 gap-6 p-6 md:grid-cols-[auto_1fr_auto] md:gap-8 md:p-8">
        @* Icon column *@
        <div class="flex items-start gap-3">
          <span class="flex size-12 items-center justify-center rounded-xl border bg-muted/40">
            <LucideIconCn Name="@activeNode.IconName" Size="20" Class="size-5 text-foreground" />
          </span>
          <div class="md:hidden">
            <div class="font-mono text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
              @activeNode.Eyebrow
            </div>
            <div class="font-mono text-xs text-muted-foreground">
              Node @((activeIndex + 1).ToString("D2")) of @_nodes.Length
            </div>
          </div>
        </div>

        @* Copy column *@
        <div>
          <div class="hidden items-center gap-2 md:flex">
            <span class="font-mono text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
              @activeNode.Eyebrow
            </span>
            <span class="text-muted-foreground">•</span>
            <span class="font-mono text-[10px] text-muted-foreground tabular-nums">
              Node @((activeIndex + 1).ToString("D2")) / @_nodes.Length
            </span>
          </div>
          <h3 class="mt-2 text-xl font-semibold leading-tight text-foreground md:text-2xl">
            @activeNode.Title
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            @activeNode.Description
          </p>
          <ul class="mt-5 space-y-2">
            @foreach (var bullet in activeNode.Bullets)
            {
              <li class="flex items-start gap-2 text-sm text-foreground">
                <span class="mt-[7px] size-1 rounded-full bg-foreground/70" />
                <span>@bullet</span>
              </li>
            }
          </ul>
        </div>

        @* Metric column *@
        <div class="flex flex-row items-end justify-between border-t pt-4 md:flex-col md:items-end md:border-t-0 md:pt-0">
          <div class="text-right">
            <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
              @activeNode.MetricLabel
            </div>
            <div class="mt-1 font-mono text-2xl font-semibold text-foreground tabular-nums">
              @activeNode.MetricValue
            </div>
          </div>
          <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="w-full sm:w-[170px]">
            View docs
          </ButtonCn>
        </div>
      </div>
    </div>
  </div>
</section>

@code {
    private string _activeId = "edge";

    private record RibbonNode(
        string Id,
        string IconName,
        string Eyebrow,
        string Title,
        string Description,
        string[] Bullets,
        string MetricLabel,
        string MetricValue,
        int X,
        int Y
    );

    private static readonly RibbonNode[] _nodes =
    [
        new RibbonNode(
            "auth",
            "key-round",
            "Auth",
            "Passwordless identity that ships on day one",
            "Magic links, passkeys, and enterprise SSO wired together in a single client. Session refresh is automatic and you can rotate signing keys without invalidating a single user.",
            ["Passkeys + SSO", "Automatic refresh", "Key rotation without downtime"],
            "Sign-in p95",
            "220 ms",
            80, 80
        ),
        new RibbonNode(
            "db",
            "database",
            "Database",
            "Serverless Postgres with branches that merge",
            "Spin up a full copy-on-write database branch for every preview deploy. Branches inherit schema and row-level security so previews mirror production exactly.",
            ["Branches per preview", "RLS inherited", "Point-in-time restore"],
            "Branch cold start",
            "0.9 s",
            240, 136
        ),
        new RibbonNode(
            "edge",
            "globe",
            "Edge",
            "Functions that run within 50ms of every user",
            "Deploy a function and it lands on 220 edge locations. The runtime is standard Web APIs, so your code runs unchanged in Node, the browser, or on the edge.",
            ["220 edge POPs", "Web-standard runtime", "Zero cold start"],
            "p95 cold start",
            "0 ms",
            400, 80
        ),
        new RibbonNode(
            "storage",
            "hard-drive",
            "Storage",
            "Object storage with signed URLs and image transforms",
            "Upload once and request any crop, format, or size as a URL parameter. Signed URLs expire on a schedule so you can hand out access without rotating credentials.",
            ["On-the-fly transforms", "Signed expiring URLs", "Resumable uploads"],
            "First byte",
            "38 ms",
            560, 136
        ),
        new RibbonNode(
            "compute",
            "server-cog",
            "Compute",
            "Background jobs that scale to zero between runs",
            "Enqueue any function as a background job and the scheduler auto-tunes concurrency to hit your latency SLO. Idle workers hibernate and wake on demand with no cold penalty.",
            ["Per-queue SLOs", "Hibernating workers", "Retry with jitter"],
            "Queue depth p95",
            "12",
            720, 80
        ),
        new RibbonNode(
            "obs",
            "eye",
            "Observability",
            "Traces, logs, and metrics stitched to source",
            "Every span links to the exact function and commit hash that produced it. Debug a regression from a trace view straight to the code — no context switching between tools.",
            ["Source-mapped spans", "Commit-linked diffs", "Retention up to 90 days"],
            "Trace sample",
            "100%",
            920, 136
        ),
    ];
}
