@* ============================================================
   Block: features-annotated-mockup-pin-tooltips
   Title: FeaturesAnnotatedMockupPinTooltips
   Description: An annotated mockup pin tooltips features section for React and Next.js with a simulated dashboard background, six numbered pin markers at absolute coordinates, hover and click tooltip cards, and a clickable legend list built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-annotated-mockup-pin-tooltips.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Headline *@
    <div class="max-w-xl">
      <div class="flex items-center gap-2">
        <span class="flex size-6 items-center justify-center rounded-md border bg-background">
          <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-muted-foreground" />
        </span>
        <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
          Dashboard tour
        </span>
      </div>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Six pins. One surface.
      </h2>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">
        Every annotation sits on the product where it actually lives. Hover a pin to peek, click
        to stick, or scan the legend to jump between highlights.
      </p>
    </div>

    @* Mockup with pins *@
    <div class="mt-10 overflow-hidden rounded-xl border bg-card">
      <div class="relative aspect-[16/9] w-full">

        @* Dashboard Mockup *@
        <div class="absolute inset-0 flex flex-col overflow-hidden bg-muted/20">
          @* Top chrome bar *@
          <div class="flex items-center justify-between border-b bg-background/70 px-4 py-2.5">
            <div class="flex items-center gap-2">
              <div class="size-2 rounded-full bg-muted-foreground/30"></div>
              <div class="size-2 rounded-full bg-muted-foreground/30"></div>
              <div class="size-2 rounded-full bg-muted-foreground/30"></div>
              <span class="ml-3 font-mono text-[9px] text-muted-foreground">
                dashboard.insights
              </span>
            </div>
            <div class="flex items-center gap-3">
              <div class="h-2 w-12 rounded-full bg-muted"></div>
              <div class="size-4 rounded-full bg-muted"></div>
            </div>
          </div>

          @* Dashboard body *@
          <div class="flex-1 p-4">
            <div class="grid h-full grid-cols-6 grid-rows-6 gap-3">
              @* Revenue chart card (large) *@
              <div class="col-span-3 row-span-3 flex flex-col rounded-lg border bg-background p-3">
                <div class="flex items-center justify-between">
                  <div class="h-1.5 w-16 rounded-full bg-foreground/80"></div>
                  <div class="h-1.5 w-8 rounded-full bg-muted"></div>
                </div>
                <div class="mt-2 flex flex-1 items-end gap-1">
                  @foreach (var barH in _barHeights)
                  {
                    <div class="flex-1 rounded-t-sm bg-foreground/60" style="@($"height:{barH}%")"></div>
                  }
                </div>
              </div>

              @* Funnel widget *@
              <div class="col-span-3 row-span-3 flex flex-col rounded-lg border bg-background p-3">
                <div class="flex items-center justify-between">
                  <div class="h-1.5 w-20 rounded-full bg-foreground/80"></div>
                  <div class="h-1.5 w-6 rounded-full bg-muted"></div>
                </div>
                <div class="mt-3 flex flex-1 flex-col gap-1.5">
                  @foreach (var funnelW in _funnelWidths)
                  {
                    <div class="flex items-center gap-2">
                      <div class="h-1.5 w-6 rounded-full bg-muted"></div>
                      <div class="h-3 rounded-sm bg-foreground/50" style="@($"width:{funnelW}%")"></div>
                    </div>
                  }
                </div>
              </div>

              @* Top events list *@
              <div class="col-span-2 row-span-3 flex flex-col rounded-lg border bg-background p-3">
                <div class="h-1.5 w-14 rounded-full bg-foreground/80"></div>
                <div class="mt-3 flex flex-1 flex-col gap-2">
                  @foreach (var evW in _eventWidths)
                  {
                    <div class="flex items-center justify-between gap-2">
                      <div class="h-1.5 rounded-full bg-muted" style="@($"width:{evW}%")"></div>
                      <div class="h-1.5 w-4 rounded-full bg-foreground/60"></div>
                    </div>
                  }
                </div>
              </div>

              @* Cohort grid *@
              <div class="col-span-3 row-span-3 flex flex-col rounded-lg border bg-background p-3">
                <div class="h-1.5 w-16 rounded-full bg-foreground/80"></div>
                <div class="mt-3 grid flex-1 grid-cols-7 grid-rows-4 gap-1">
                  @for (var i = 0; i < 28; i++)
                  {
                    var intensity = ((i * 37) % 100) / 100.0;
                    var opacity = 0.08 + intensity * 0.5;
                    <div class="rounded-sm bg-foreground" style="@($"opacity:{opacity:F2}")"></div>
                  }
                </div>
              </div>

              @* Export sidebar card *@
              <div class="col-span-1 row-span-3 flex flex-col justify-between rounded-lg border bg-background p-3">
                <div class="space-y-2">
                  <div class="h-1.5 w-6 rounded-full bg-foreground/80"></div>
                  <div class="h-1.5 w-8 rounded-full bg-muted"></div>
                  <div class="h-1.5 w-5 rounded-full bg-muted"></div>
                </div>
                <div class="h-5 w-full rounded-md border"></div>
              </div>
            </div>
          </div>
        </div>

        @* Pin markers *@
        @foreach (var pin in _pins)
        {
          var pinId = pin.Id;
          var isActive = pin.Id == _activeId;
          var isVisible = pin.Id == _visibleTooltipId;
          var aboveOrBelow = pin.PositionY < 30 ? "top-full mt-3" : "bottom-full mb-3";
          <div
            class="absolute z-10"
            style="@($"left:{pin.PositionX}%;top:{pin.PositionY}%;transform:translate(-50%,-50%)")"
          >
            <button
              type="button"
              @onclick="@(() => _activeId = pinId)"
              @onmouseenter="@(() => _hoverId = pinId)"
              @onmouseleave="@(() => _hoverId = null)"
              @onfocus="@(() => _hoverId = pinId)"
              @onblur="@(() => _hoverId = null)"
              aria-label="@($"Pin {pin.Number}: {pin.Title}")"
              aria-pressed="@(isActive ? "true" : "false")"
              class="@(Cn.Merge(
                "relative flex size-7 items-center justify-center rounded-full border-2 font-mono text-[10px] font-semibold tabular-nums shadow-md outline-none transition-all focus-visible:ring-2 focus-visible:ring-foreground/50",
                isActive
                  ? "border-foreground bg-foreground text-background"
                  : "border-foreground/70 bg-background text-foreground hover:scale-110 hover:border-foreground"
              ))"
            >
              @pin.Number
            </button>

            @* Tooltip card *@
            @if (isVisible)
            {
              <div class="@(Cn.Merge(
                "pointer-events-none absolute left-1/2 z-20 w-56 -translate-x-1/2 rounded-lg border bg-popover p-3 shadow-lg",
                aboveOrBelow
              ))">
                <div class="flex items-center gap-2">
                  <span class="flex size-5 items-center justify-center rounded-sm border bg-background">
                    <LucideIconCn Name="@pin.IconName" Size="12" Class="size-3 text-foreground" />
                  </span>
                  <span class="text-[9px] font-medium uppercase tracking-wider text-muted-foreground">
                    @pin.Category · #@pin.Number
                  </span>
                </div>
                <div class="mt-2 text-xs font-medium text-popover-foreground">
                  @pin.Title
                </div>
                <p class="mt-1 text-[11px] leading-relaxed text-muted-foreground">
                  @pin.Description
                </p>
              </div>
            }
          </div>
        }
      </div>

      @* Active pin summary bar *@
      <div class="flex items-center justify-between gap-4 border-t bg-muted/20 px-5 py-3">
        <div class="flex items-center gap-3">
          <span class="flex size-6 items-center justify-center rounded-full border bg-background font-mono text-[10px] font-semibold tabular-nums text-foreground">
            @_activePin.Number
          </span>
          <div class="text-xs">
            <span class="font-medium text-foreground">@_activePin.Title</span>
            <span class="mx-1.5 text-muted-foreground/40">·</span>
            <span class="text-muted-foreground">@_activePin.Category</span>
          </div>
        </div>
        <div class="font-mono text-[10px] text-muted-foreground tabular-nums">
          @(Array.FindIndex(_pins, p => p.Id == _activeId) + 1) / @_pins.Length
        </div>
      </div>
    </div>

    @* Legend list *@
    <ol class="mt-6 grid grid-cols-1 gap-2 md:grid-cols-2">
      @foreach (var pin in _pins)
      {
        var pinId = pin.Id;
        var isActive = pin.Id == _activeId;
        <li>
          <button
            type="button"
            @onclick="@(() => _activeId = pinId)"
            @onmouseenter="@(() => _hoverId = pinId)"
            @onmouseleave="@(() => _hoverId = null)"
            class="@(Cn.Merge(
              "flex w-full items-start gap-3 rounded-lg border p-3 text-left transition-all",
              isActive
                ? "border-foreground bg-background shadow-sm"
                : "border-border bg-muted/20 hover:border-foreground/40 hover:bg-muted/40"
            ))"
          >
            <span class="@(Cn.Merge(
              "flex size-6 shrink-0 items-center justify-center rounded-full border font-mono text-[10px] font-semibold tabular-nums",
              isActive
                ? "border-foreground bg-foreground text-background"
                : "border-border bg-background text-foreground"
            ))">
              @pin.Number
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5">
                <LucideIconCn Name="@pin.IconName" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-xs font-medium text-foreground">@pin.Title</span>
                <span class="font-mono text-[9px] text-muted-foreground">
                  @pin.Category
                </span>
              </div>
              <p class="mt-1 line-clamp-1 text-[11px] text-muted-foreground">
                @pin.Description
              </p>
            </div>
          </button>
        </li>
      }
    </ol>

    @* CTA row *@
    <div class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border bg-muted/30 px-5 py-3">
      <div class="text-xs text-muted-foreground">
        Annotated in context — no separate reference doc to maintain.
      </div>
      <div class="flex items-center gap-2">
        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[270px]">Open sample dashboard</ButtonCn>
        <ButtonCn Class="w-full sm:w-[180px]">Try it live</ButtonCn>
      </div>
    </div>
  </div>
</section>

@code {
    private string _activeId = "revenue-chart";
    private string? _hoverId = null;

    private string _visibleTooltipId => _hoverId ?? _activeId;
    private PinData _activePin => Array.Find(_pins, p => p.Id == _activeId) ?? _pins[0];

    private record PinData(
        string Id,
        int Number,
        double PositionX,
        double PositionY,
        string Title,
        string Description,
        string Category,
        string IconName
    );

    private static readonly PinData[] _pins =
    [
        new("revenue-chart", 1, 24, 28,
            "Revenue chart",
            "Weekly MRR broken into new, expansion, and contraction. Click any bar to drill into the account list that drove the movement.",
            "Chart", "bar-chart-3"),
        new("funnel-widget", 2, 76, 22,
            "Funnel widget",
            "Six-step funnel from visit to activation. The steps auto-detect from your event stream so you never hand-author stages.",
            "Widget", "target"),
        new("top-events", 3, 18, 62,
            "Top events",
            "Leaderboard of the fifty highest-volume events in the last 24 hours. Sort by volume, unique users, or p95 latency.",
            "List", "activity"),
        new("cohort-grid", 4, 54, 58,
            "Cohort grid",
            "Day-by-day retention matrix with conditional heat coloring. Hover any cell to see the underlying user count and churn reason.",
            "Grid", "users"),
        new("alerts-bell", 5, 88, 12,
            "Alert center",
            "Every threshold breach and anomaly lands here. Acknowledge, snooze, or assign to a teammate directly from the bell.",
            "Alert", "bell"),
        new("export-menu", 6, 92, 64,
            "Export menu",
            "Download any dashboard as CSV, JSON, or a scheduled email digest. Exports respect the active date range and filter set.",
            "Action", "download"),
    ];

    private static readonly int[] _barHeights = [40, 65, 52, 78, 88, 72, 94];
    private static readonly int[] _funnelWidths = [100, 82, 64, 48, 32, 18];
    private static readonly int[] _eventWidths = [70, 58, 42, 36, 28];
}
