@* ============================================================
   Block: features-role-based
   Title: Features Role Based
   Description: Features organized by user role with dedicated sections for developers, designers, and product managers
   Dependencies: None
   Source: original/blocks/features/features-role-based.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Features by Role</h2>
            <p class="mt-1 text-xs text-muted-foreground">Capabilities tailored to your team</p>
        </div>

        <div>
            @for (var i = 0; i < _roleFeatures.Length; i++)
            {
                var roleSection = _roleFeatures[i];
                <div class="@(i < _roleFeatures.Length - 1 ? "border-b" : "")">
                    <div class="border-b bg-muted/30 px-4 py-2.5">
                        <h3 class="text-sm font-medium">@roleSection.Role</h3>
                        <p class="mt-0.5 text-xs text-muted-foreground">@roleSection.Description</p>
                    </div>
                    <div class="px-4 py-3">
                        <ul class="space-y-2">
                            @foreach (var feature in roleSection.Features)
                            {
                                <li class="flex items-start gap-2">
                                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                                    <span class="text-sm">@feature</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record RoleFeature(string Role, string Description, string[] Features);

    private static readonly RoleFeature[] _roleFeatures =
    [
        new("Developer", "Tools and integrations for engineering teams", [
            "REST API with OpenAPI documentation",
            "SDK support for TypeScript, Python, and Go",
            "Webhook events for real-time notifications",
            "CLI for local development and testing",
        ]),
        new("Designer", "Design system and collaboration features", [
            "Figma plugin with auto-sync components",
            "Design token management and versioning",
            "Brand kit with colors and typography",
            "Component preview with live code editing",
        ]),
        new("Product Manager", "Analytics and workflow management", [
            "Usage analytics with custom dashboards",
            "Feature flag management and A/B testing",
            "User feedback collection and tracking",
            "Release notes and changelog automation",
        ]),
    ];
}
