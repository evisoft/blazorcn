@* ============================================================
   Block: features-pinned-headline-numbered-grid
   Title: FeaturesPinnedHeadlineNumberedGrid
   Description: A pinned headline split feature section for React and Next.js with a left eyebrow, marketing headline, subtitle, ghost CTA, and a right 2x2 grid of numbered feature items with circled 01-04 badges built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-pinned-headline-numbered-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-8 sm:p-12 lg:p-14">
        <div class="grid gap-10 lg:grid-cols-[5fr_6fr] lg:gap-14">
            @* Left — Pinned headline *@
            <div>
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    @_headline.Eyebrow
                </p>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
                    @_headline.Title
                </h2>
                <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground">
                    @_headline.Subtitle
                </p>
                <div class="mt-8">
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[190px]">View pricing</ButtonCn>
                </div>
            </div>

            @* Right — 2x2 numbered grid *@
            <ol class="grid grid-cols-1 gap-7 sm:grid-cols-2 sm:gap-8">
                @foreach (var feat in _features)
                {
                    <li>
                        <div class="flex items-center gap-3">
                            <span aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-full border text-sm font-semibold text-foreground">
                                @feat.Number
                            </span>
                            <h3 class="text-base font-semibold text-foreground">@feat.Title</h3>
                        </div>
                        <p class="mt-2.5 pl-11 text-sm leading-relaxed text-muted-foreground">
                            @feat.Description
                        </p>
                    </li>
                }
            </ol>
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record Feature(string Id, string Number, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        "What matters most",
        "Four capabilities that separate our platform from the rest",
        "Not a checklist of every table-stakes feature competitors also ship. These are the four decisions we obsess over so your team can focus on what it actually ships to customers."
    );

    private static readonly Feature[] _features =
    [
        new("speed", "01", "Sub-second deploy pipeline",
            "From git push to production in under 45 seconds with parallel test sharding and incremental builds that skip unchanged workspaces."),
        new("reliability", "02", "99.99% multi-region uptime",
            "Automatic failover across three regions with health checks every 500ms and a public status page backed by real synthetic probes."),
        new("security", "03", "SOC 2 Type II and ISO 27001",
            "Annual third-party audits, continuous compliance monitoring, and vendor reports available from the trust center on demand."),
        new("support", "04", "Engineers on call, not ticket queues",
            "Every paid plan includes a shared Slack channel staffed by the team that wrote the code — median first response under seven minutes."),
    ];
}
