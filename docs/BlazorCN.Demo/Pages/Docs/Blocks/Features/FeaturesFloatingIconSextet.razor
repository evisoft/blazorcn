@* ============================================================
   Block: features-floating-icon-sextet
   Title: FeaturesFloatingIconSextet
   Description: A borderless floating icon sextet feature section for React and Next.js with a centered headline and a six-item icon grid rendered on pure typography without cards, borders, or backgrounds built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-floating-icon-sextet.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="py-4">
        @* Top — centered eyebrow + headline + subtitle *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_headline.Eyebrow
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_headline.Title
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>
        </div>

        @* Bottom — borderless 6-item grid *@
        <div class="mt-14 grid grid-cols-2 gap-x-8 gap-y-10 md:grid-cols-3">
            @foreach (var feature in _features)
            {
                <div>
                    <LucideIconCn Name="@feature.IconName" Size="40" StrokeWidth="2" Class="size-10 text-foreground" aria-hidden="true" />
                    <h3 class="mt-4 text-base font-semibold text-foreground">@feature.Title</h3>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                        @feature.Description
                    </p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);

    private record FeatureData(string Id, string IconName, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        Eyebrow: "Under the hood",
        Title: "Six quiet decisions that change how you ship",
        Subtitle: "No boxes, no chrome, no gradient halos. Just the six things we refused to compromise on when we wrote the first line of this platform."
    );

    private static readonly FeatureData[] _features =
    [
        new("keyboard-first", "keyboard", "Keyboard-first command menu",
            "Every action reachable in two keystrokes from cmd-k. No mouse required to move a ticket, deploy a branch, or roll back a release."),
        new("branch-previews", "git-branch", "Preview per branch",
            "Every pull request gets its own fully-seeded preview environment within 40 seconds. Share a link in Slack before asking for review."),
        new("terminal-native", "terminal", "Terminal-native workflow",
            "A first-class CLI that wraps every action in the web dashboard. Pipe output, script deploys, and automate everything from your shell config."),
        new("workflows", "workflow", "Composable workflows",
            "Chain actions with conditional steps, retry policies, and typed outputs. No YAML pyramid, no proprietary DSL, just TypeScript functions."),
        new("realtime", "layers", "Real-time state everywhere",
            "Changes replicate across sessions, devices, and tabs in under 80 milliseconds. Collaboration stops being a feature and becomes an invariant."),
        new("notifications", "bell", "Notifications that respect focus",
            "Quiet hours, priority tiers, and a smart batching layer cut interruption volume by 80 percent without missing anything that actually matters."),
    ];
}
