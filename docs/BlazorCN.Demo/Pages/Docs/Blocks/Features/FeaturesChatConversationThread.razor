@* ============================================================
   Block: features-chat-conversation-thread
   Title: FeaturesChatConversationThread
   Description: A chat conversation thread features section for React and Next.js presenting capabilities as alternating message bubbles with a typing indicator, online dot, and message composer built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-chat-conversation-thread.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-muted-foreground">
                <LucideIconCn Name="message-circle" Size="12" Class="size-3" />
                Straight from the product team
            </span>
            <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Product updates, in conversation.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Capabilities explained the way you'd explain them to a teammate — short, specific, and
                honest about the details that actually matter.
            </p>
        </div>

        @* Chat mockup *@
        <div class="mx-auto mt-10 overflow-hidden rounded-xl border bg-card shadow-sm">
            @* Header *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="relative">
                    <span class="flex size-9 items-center justify-center rounded-full bg-muted font-mono text-xs font-semibold text-foreground">
                        @_contact.Initials
                    </span>
                    <span
                        aria-hidden="true"
                        class="absolute -bottom-0.5 -right-0.5 size-2.5 rounded-full border-2 border-card bg-emerald-500">
                    </span>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="truncate text-sm font-semibold text-foreground">@_contact.Name</div>
                    <div class="flex items-center gap-1.5 truncate text-xs text-muted-foreground">
                        <span class="size-1 rounded-full bg-emerald-500" aria-hidden="true"></span>
                        @_contact.Status
                    </div>
                </div>
            </div>

            @* Messages *@
            <ol class="flex flex-col gap-3 bg-muted/10 px-4 py-5">
                @foreach (var msg in _messages)
                {
                    var isLeft = msg.Side == "left";
                    <li class="@(isLeft ? "flex justify-start" : "flex justify-end")"
                        aria-label="@(msg.Typing ? $"{_contact.Name} is typing" : $"{(isLeft ? _contact.Name : "You")} at {msg.Time}: {msg.Text}")">
                        <div class="@Cn.Merge("max-w-[85%] px-4 py-2.5 text-sm leading-relaxed", isLeft ? "rounded-2xl rounded-bl-sm bg-muted text-foreground" : "rounded-2xl rounded-br-sm bg-foreground text-background")">
                            @if (msg.Typing)
                            {
                                @* Typing indicator — static three dots (no animation in Blazor SSR) *@
                                <div role="status" aria-label="typing" aria-live="polite" class="flex items-center gap-1">
                                    <span aria-hidden="true" class="size-1.5 rounded-full bg-muted-foreground/70"></span>
                                    <span aria-hidden="true" class="size-1.5 rounded-full bg-muted-foreground/70"></span>
                                    <span aria-hidden="true" class="size-1.5 rounded-full bg-muted-foreground/70"></span>
                                </div>
                            }
                            else
                            {
                                <p>@msg.Text</p>
                                <div class="@Cn.Merge("mt-1 text-right font-mono text-[10px]", isLeft ? "text-muted-foreground" : "text-background/60")">
                                    @msg.Time
                                </div>
                            }
                        </div>
                    </li>
                }
            </ol>

            @* Composer *@
            <div class="flex items-center gap-2 border-t px-3 py-2.5">
                <button
                    type="button"
                    aria-label="Attach file"
                    class="flex size-8 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:bg-muted/50">
                    <LucideIconCn Name="paperclip" Size="16" Class="size-4" />
                </button>
                <div class="flex min-w-0 flex-1 items-center gap-2 rounded-full border bg-background px-3 py-1.5">
                    <span class="flex-1 truncate text-sm text-muted-foreground">
                        Reply to Linear Product…
                    </span>
                    <LucideIconCn Name="smile" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                </div>
                <button
                    type="button"
                    aria-label="Send message"
                    class="flex size-9 shrink-0 items-center justify-center rounded-full bg-foreground text-background hover:bg-foreground/90">
                    <LucideIconCn Name="send-horizontal" Size="16" Class="size-4" />
                </button>
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[200px]">Join the beta</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[250px]">Read the blog post</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ContactInfo(string Name, string Role, string Initials, string Status);
    private record ChatMessage(string Id, string Side, string Text, string Time, bool Typing = false);

    private static readonly ContactInfo _contact = new("Linear Product", "Product team", "LP", "typing…");

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "left",  "Quick heads up — we shipped instant cycle planning this morning. You can now drag issues across cycles without waiting on a re-sync.", "9:41"),
        new("m2", "right", "Oh that's huge. Did the roadmap timeline pick it up automatically?", "9:42"),
        new("m3", "left",  "Yep. Roadmaps rebuild in <100ms and keep all your filters. Projects and initiatives both update in the same pass.", "9:42"),
        new("m4", "right", "Perfect. What about the new GitHub sync? Same release?", "9:43"),
        new("m5", "left",  "Yes — bi-directional PR linking is live for every workspace. Branch names auto-map to issues and we now import review state.", "9:44"),
        new("m6", "left",  "", "", true),
    ];
}
