@* ============================================================
   Block: features-bento-hero-cell-grid
   Title: FeaturesBentoHeroCellGrid
   Description: A bento hero cell grid features section for React and Next.js with one dominant lg:col-span-4 lg:row-span-2 flagship cell containing a mini browser mockup and four supporting cells built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-bento-hero-cell-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10">
        @* Headline cluster *@
        <div class="max-w-2xl">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_headline.Eyebrow
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_headline.Title
            </h2>
            <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>
        </div>

        @* Bento grid *@
        <div class="mt-10 grid grid-cols-6 gap-3">
            @* Hero cell — dominates *@
            <div class="col-span-6 flex flex-col rounded-xl border bg-muted/30 p-6 lg:col-span-4 lg:row-span-2 lg:p-8">
                @* Big icon *@
                <span class="flex size-12 items-center justify-center rounded-xl bg-foreground">
                    <LucideIconCn Name="users" Size="20" Class="size-5 text-background" />
                </span>

                <div class="mt-6">
                    <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                        @_heroCell.Eyebrow
                    </p>
                    <h3 class="mt-2 text-xl font-semibold tracking-tight text-foreground sm:text-2xl">
                        @_heroCell.Title
                    </h3>
                    <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted-foreground">
                        @_heroCell.Description
                    </p>
                </div>

                @* Mini browser mockup *@
                <div class="mt-6 overflow-hidden rounded-lg border bg-background shadow-sm lg:mt-auto">
                    @* Browser chrome *@
                    <div class="flex items-center gap-1.5 border-b bg-muted/50 px-3 py-2">
                        <span aria-hidden="true" class="size-2 rounded-full bg-muted-foreground/30"></span>
                        <span aria-hidden="true" class="size-2 rounded-full bg-muted-foreground/30"></span>
                        <span aria-hidden="true" class="size-2 rounded-full bg-muted-foreground/30"></span>
                        <div class="ml-3 flex-1 rounded-md border bg-background px-2 py-0.5 text-[10px] font-mono text-muted-foreground">
                            @_heroCell.MockupUrl
                        </div>
                    </div>
                    @* Crosshair placeholder *@
                    <div class="flex aspect-[16/6] items-center justify-center bg-muted/40">
                        <div aria-hidden="true" class="relative flex items-center justify-center">
                            <div class="absolute size-24 rounded-full border border-muted-foreground/[0.06]"></div>
                            <div class="absolute size-14 rounded-full border border-muted-foreground/[0.08]"></div>
                            <div class="absolute h-px w-40 bg-muted-foreground/[0.06]"></div>
                            <div class="absolute h-24 w-px bg-muted-foreground/[0.06]"></div>
                            <div class="flex size-8 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                                <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Supporting cells *@
            @foreach (var cell in _supportingCells)
            {
                <div class="@Cn.Merge("flex flex-col rounded-xl border bg-muted/30 p-6", cell.ColClass)">
                    <span class="flex size-9 items-center justify-center rounded-lg bg-muted">
                        <LucideIconCn Name="@cell.IconName" Size="16" Class="size-4 text-muted-foreground" />
                    </span>
                    <h3 class="mt-4 text-base font-semibold text-foreground">@cell.Title</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">@cell.Description</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record HeroCellData(string Eyebrow, string Title, string Description, string MockupUrl);
    private record SupportingCellData(string Id, string IconName, string Title, string Description, string ColClass);

    private static readonly HeadlineData _headline = new(
        "Platform",
        "One flagship, four reinforcements",
        "Real-time collaboration is the feature we ship the loudest — the rest of the platform is built to make it work at enterprise scale."
    );

    private static readonly HeroCellData _heroCell = new(
        "Flagship",
        "Real-time collaboration with zero merge conflicts",
        "CRDT-merged edits, presence cursors, inline comments, and offline reconnects keep every teammate in sync under 40ms — even when the network drops.",
        "app.acme.dev/docs/launch-plan"
    );

    private static readonly SupportingCellData[] _supportingCells =
    [
        new("git", "git-branch", "Git integration",
            "Link branches, PRs, and commits to tasks with live deploy status rendered inline.",
            "col-span-6 lg:col-span-2"),
        new("uptime", "gauge", "99.99% uptime SLA",
            "Regional failover and multi-AZ writes keep every request well inside your latency budget.",
            "col-span-6 lg:col-span-2"),
        new("sso", "shield-check", "Enterprise SSO",
            "SAML 2.0 and OIDC with SCIM provisioning, custom role inheritance, and per-team scoping.",
            "col-span-6 lg:col-span-3"),
        new("webhooks", "webhook", "Typed webhooks",
            "Subscribe to platform events with a fully typed SDK and automatic retries with exponential backoff.",
            "col-span-6 lg:col-span-3"),
    ];
}
