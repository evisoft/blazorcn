@* ============================================================
   Block: features-sankey-flow-diagram
   Title: FeaturesSankeyFlowDiagram
   Description: A horizontal Sankey flow diagram features section for React and Next.js with three input blocks routed through curved SVG paths to four output blocks, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-sankey-flow-diagram.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    @* Header *@
    <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Pipeline capabilities
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            Every event, routed everywhere it matters.
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted-foreground">
            One ingest surface fans out into every downstream workload — warehoused, alerted on,
            audited, and visualized — without a second pipeline to maintain.
        </p>
    </div>

    @* Sankey diagram *@
    <div class="mt-12 overflow-hidden rounded-xl border bg-card p-4 sm:p-6">
        <svg aria-hidden="true" viewBox="@($"0 0 {SvgWidth} {SvgHeight}")" class="h-auto w-full">
            <title>Sankey flow diagram</title>

            @* ribbons *@
            @foreach (var ribbon in _ribbons)
            {
                <path d="@ribbon.Path" class="fill-foreground" fill-opacity="@ribbon.Opacity.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)" />
            }

            @* input blocks *@
            @foreach (var input in _inputs)
            {
                var g = _inputGeom[input.Id];
                <g>
                    <rect x="@LeftX" y="@g.Y.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" width="@BlockWidth" height="@g.Height.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" class="fill-foreground" rx="2" />
                    <text x="@((LeftX - 8).ToString(System.Globalization.CultureInfo.InvariantCulture))" y="@((g.Y + g.Height / 2 - 4).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))" text-anchor="end" dominant-baseline="middle" class="fill-foreground font-semibold text-[11px]">
                        @input.Label
                    </text>
                    <text x="@((LeftX - 8).ToString(System.Globalization.CultureInfo.InvariantCulture))" y="@((g.Y + g.Height / 2 + 8).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))" text-anchor="end" dominant-baseline="middle" class="fill-muted-foreground text-[10px]">
                        @input.Volume
                    </text>
                </g>
            }

            @* output blocks *@
            @foreach (var output in _outputs)
            {
                var g = _outputGeom[output.Id];
                <g>
                    <rect x="@RightX.ToString(System.Globalization.CultureInfo.InvariantCulture)" y="@g.Y.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" width="@BlockWidth" height="@g.Height.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" class="fill-foreground" rx="2" />
                    <text x="@((RightX + BlockWidth + 8).ToString(System.Globalization.CultureInfo.InvariantCulture))" y="@((g.Y + g.Height / 2 - 4).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))" text-anchor="start" dominant-baseline="middle" class="fill-foreground font-semibold text-[11px]">
                        @output.Label
                    </text>
                    <text x="@((RightX + BlockWidth + 8).ToString(System.Globalization.CultureInfo.InvariantCulture))" y="@((g.Y + g.Height / 2 + 8).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))" text-anchor="start" dominant-baseline="middle" class="fill-muted-foreground text-[10px]">
                        @output.Summary
                    </text>
                </g>
            }
        </svg>
    </div>

    @* Output legend cards *@
    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        @foreach (var output in _outputs)
        {
            <div class="rounded-lg border bg-card p-3">
                <div class="flex items-center gap-2">
                    <span class="@($"size-1.5 rounded-full {output.Accent}")" />
                    <span class="text-xs font-semibold">@output.Label</span>
                </div>
                <p class="mt-1 text-[11px] text-muted-foreground">@output.Summary</p>
            </div>
        }
    </div>

    @* CTA pair *@
    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <ButtonCn Class="w-full sm:w-[230px]">Explore pipeline</ButtonCn>
        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">Read the docs</ButtonCn>
    </div>
</section>

@code {
    private record SankeyInput(string Id, string Label, string Volume, double Weight);
    private record SankeyOutput(string Id, string Label, string Summary, double Weight, string Accent);
    private record SankeyFlow(string Source, string Target, double Weight);
    private record BlockGeom(string Id, double Y, double Height);
    private record Ribbon(string Key, string Path, double Opacity);

    private const int SvgWidth = 720;
    private const int SvgHeight = 360;
    private const int BlockWidth = 14;
    private const int LeftX = 40;
    private static readonly int RightX = SvgWidth - 40 - BlockWidth;
    private const int TopPad = 20;
    private const int BottomPad = 20;
    private static readonly int UsableHeight = SvgHeight - TopPad - BottomPad;
    private const int Gap = 14;

    private static readonly SankeyInput[] _inputs =
    [
        new("events",  "Raw events",   "18.4M / day", 46),
        new("actions", "User actions", "9.1M / day",  24),
        new("api",     "API calls",    "11.3M / day", 30),
    ];

    private static readonly SankeyOutput[] _outputs =
    [
        new("analytics",  "Analytics",  "Warehouse + BI",   30, "bg-foreground"),
        new("alerts",     "Alerts",     "Realtime routing", 18, "bg-emerald-500"),
        new("audit",      "Audit log",  "Tamper-evident",   22, "bg-blue-500"),
        new("dashboards", "Dashboards", "Live widgets",     30, "bg-amber-500"),
    ];

    private static readonly SankeyFlow[] _flows =
    [
        new("events",  "analytics",  18),
        new("events",  "alerts",     10),
        new("events",  "audit",      10),
        new("events",  "dashboards",  8),
        new("actions", "analytics",   6),
        new("actions", "audit",        8),
        new("actions", "dashboards",  10),
        new("api",     "analytics",   6),
        new("api",     "alerts",      8),
        new("api",     "audit",       4),
        new("api",     "dashboards", 12),
    ];

    private static Dictionary<string, BlockGeom> ComputeGeometry(IEnumerable<(string Id, double Weight)> items)
    {
        var list = items.ToList();
        var totalWeight = list.Sum(it => it.Weight);
        var totalGap = Gap * (list.Count - 1);
        var availableHeight = UsableHeight - totalGap;
        var result = new Dictionary<string, BlockGeom>();
        double cursor = TopPad;
        foreach (var it in list)
        {
            var h = (it.Weight / totalWeight) * availableHeight;
            result[it.Id] = new BlockGeom(it.Id, cursor, h);
            cursor += h + Gap;
        }
        return result;
    }

    private static readonly Dictionary<string, BlockGeom> _inputGeom =
        ComputeGeometry(_inputs.Select(i => (i.Id, i.Weight)));

    private static readonly Dictionary<string, BlockGeom> _outputGeom =
        ComputeGeometry(_outputs.Select(o => (o.Id, o.Weight)));

    private static readonly Ribbon[] _ribbons = BuildRibbons();

    private static Ribbon[] BuildRibbons()
    {
        var inputCursor  = _inputs.ToDictionary(i => i.Id, _ => 0.0);
        var outputCursor = _outputs.ToDictionary(o => o.Id, _ => 0.0);

        var totalInputWeight  = _inputs.Sum(i => i.Weight);
        var totalOutputWeight = _outputs.Sum(o => o.Weight);

        var ribbons = new List<Ribbon>();
        foreach (var flow in _flows)
        {
            if (!_inputGeom.TryGetValue(flow.Source, out var src)) continue;
            if (!_outputGeom.TryGetValue(flow.Target, out var tgt)) continue;
            var srcItem = _inputs.FirstOrDefault(x => x.Id == flow.Source);
            var tgtItem = _outputs.FirstOrDefault(x => x.Id == flow.Target);
            if (srcItem is null || tgtItem is null) continue;

            var srcHeight = (flow.Weight / srcItem.Weight) * src.Height;
            var tgtHeight = (flow.Weight / tgtItem.Weight) * tgt.Height;

            var y0 = src.Y + inputCursor[flow.Source];
            var y1 = src.Y + inputCursor[flow.Source] + srcHeight;
            var y2 = tgt.Y + outputCursor[flow.Target];
            var y3 = tgt.Y + outputCursor[flow.Target] + tgtHeight;

            inputCursor[flow.Source]  += srcHeight;
            outputCursor[flow.Target] += tgtHeight;

            var x0   = LeftX + BlockWidth;
            var x1   = RightX;
            var midX = (x0 + x1) / 2.0;

            var ic = System.Globalization.CultureInfo.InvariantCulture;
            var path = string.Join(" ", new[]
            {
                $"M {x0.ToString(ic)} {y0.ToString("F2", ic)}",
                $"C {midX.ToString("F2", ic)} {y0.ToString("F2", ic)}, {midX.ToString("F2", ic)} {y2.ToString("F2", ic)}, {x1.ToString(ic)} {y2.ToString("F2", ic)}",
                $"L {x1.ToString(ic)} {y3.ToString("F2", ic)}",
                $"C {midX.ToString("F2", ic)} {y3.ToString("F2", ic)}, {midX.ToString("F2", ic)} {y1.ToString("F2", ic)}, {x0.ToString(ic)} {y1.ToString("F2", ic)}",
                "Z"
            });

            var relative = flow.Weight / Math.Max(totalInputWeight, totalOutputWeight);
            var opacity  = 0.08 + relative * 0.28;

            ribbons.Add(new Ribbon($"{flow.Source}-{flow.Target}", path, opacity));
        }
        return ribbons.ToArray();
    }
}
