@* ============================================================
   Block: features-podcast-episode-playlist
   Title: FeaturesPodcastEpisodePlaylist
   Description: A podcast player mockup features section for React and Next.js with show header, episode list, waveform SVGs, duration badges, and platform links built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-podcast-episode-playlist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div>
    @* Headline cluster *@
    <div class="text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Listen in
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Every capability, narrated.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-muted-foreground">
        We recorded a short episode for every platform primitive so your team can learn while
        they deploy.
      </p>
    </div>

    @* Podcast player mockup *@
    <div class="mt-10 overflow-hidden rounded-xl border bg-card">
      @* Show header *@
      <div class="flex items-center gap-4 border-b p-5">
        <div class="flex size-16 shrink-0 items-center justify-center rounded-lg border bg-muted/50">
          <span class="font-mono text-lg font-semibold tracking-tight">@_show.Mark</span>
        </div>
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-1.5">
            <LucideIconCn Name="radio" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
            <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
              Podcast
            </span>
          </div>
          <h3 class="mt-0.5 text-base font-semibold tracking-tight">@_show.Name</h3>
          <p class="text-xs text-muted-foreground">
            @_show.Host &middot; @_show.Subscribers
          </p>
        </div>
        <LucideIconCn Name="headphones" Size="20" Class="hidden size-5 text-muted-foreground sm:block" aria-hidden="true" />
      </div>

      @* Episode list *@
      <ul class="divide-y">
        @foreach (var ep in _episodes)
        {
          var episode = ep;
          <li class="flex items-center gap-3 px-5 py-3.5 hover:bg-muted/40">
            <button type="button"
                    aria-label="@($"Play episode {episode.Number}: {episode.Title}")"
                    class="flex size-9 shrink-0 items-center justify-center rounded-full border bg-background text-foreground transition-colors hover:bg-foreground hover:text-background">
              <LucideIconCn Name="play" Size="14" Class="size-3.5 fill-current" aria-hidden="true" />
            </button>
            <span class="w-6 shrink-0 font-mono text-xs tabular-nums text-muted-foreground">
              @episode.Number
            </span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-medium">@episode.Title</p>
              <p class="truncate text-xs text-muted-foreground">@episode.Description</p>
            </div>
            @* Waveform SVG *@
            @{
              var bars = episode.Waveform;
              const int svgWidth = 72;
              const int svgHeight = 24;
              const int gap = 2;
              var barWidth = (svgWidth - gap * (bars.Length - 1)) / (double)bars.Length;
            }
            <svg aria-hidden="true"
                 width="@svgWidth"
                 height="@svgHeight"
                 viewBox="@($"0 0 {svgWidth} {svgHeight}")"
                 class="shrink-0">
              @for (int i = 0; i < bars.Length; i++)
              {
                var value = bars[i];
                var barHeight = Math.Max(2.0, (value / 100.0) * svgHeight);
                var x = i * (barWidth + gap);
                var y = (svgHeight - barHeight) / 2.0;
                <rect x="@x.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                      y="@y.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                      width="@barWidth.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                      height="@barHeight.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                      rx="@((barWidth / 2).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))"
                      class="fill-muted-foreground/60" />
              }
            </svg>
            <span class="w-12 shrink-0 text-right font-mono text-[11px] tabular-nums text-muted-foreground">
              @episode.Duration
            </span>
          </li>
        }
      </ul>

      @* Listen on footer *@
      <div class="flex flex-wrap items-center justify-between gap-3 border-t bg-muted/30 px-5 py-3">
        <span class="text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
          Listen on
        </span>
        <div class="flex items-center gap-2">
          @foreach (var plat in _platforms)
          {
            var platform = plat;
            <span class="inline-flex items-center gap-1.5 rounded-full border bg-background px-2.5 py-1 text-[11px] font-medium">
              <span aria-hidden="true"
                    class="flex size-4 items-center justify-center rounded-full bg-foreground font-mono text-[9px] font-semibold text-background">
                @platform.Mark
              </span>
              @platform.Name
            </span>
          }
        </div>
      </div>
    </div>

    @* CTAs *@
    <div class="mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-center">
      <ButtonCn Class="w-full sm:w-[170px]">Subscribe</ButtonCn>
      <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">Browse episodes</ButtonCn>
    </div>
  </div>
</section>

@code {
    private record ShowInfo(string Name, string Tagline, string Host, string Subscribers, string Mark);
    private record Episode(string Number, string Title, string Description, string Duration, int[] Waveform);
    private record Platform(string Id, string Name, string Mark);

    private static readonly ShowInfo _show = new(
        "Platform Weekly",
        "A weekly deep-dive on how modern infrastructure actually works.",
        "Hosted by Nora Aldrich",
        "18.4k subscribers",
        "PW"
    );

    private static readonly Episode[] _episodes =
    [
        new("01", "Edge caching, explained",            "How stale-while-revalidate actually ships bytes faster.",             "42 min", [35, 62, 80, 55, 72, 45, 68, 30]),
        new("02", "Deploying to 34 regions",            "What changes when your build fans out across the globe.",             "38 min", [50, 40, 75, 88, 62, 70, 48, 55]),
        new("03", "The cold-start problem",             "Warm pools, snapshots, and the myth of the zero-ms boot.",            "51 min", [28, 55, 72, 46, 85, 60, 38, 70]),
        new("04", "Rolling back in three seconds",      "Instant aliases, atomic swaps, and why downtime is a choice.",        "34 min", [65, 42, 58, 78, 50, 82, 45, 62]),
        new("05", "Observability without the bill shock","Sampling, cardinality, and the invoice you never want.",             "47 min", [44, 70, 52, 65, 38, 78, 60, 48]),
    ];

    private static readonly Platform[] _platforms =
    [
        new("spotify", "Spotify",        "S"),
        new("apple",   "Apple Podcasts", "A"),
        new("overcast","Overcast",        "O"),
    ];
}
