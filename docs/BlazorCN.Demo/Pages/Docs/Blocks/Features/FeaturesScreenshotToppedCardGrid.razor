@* ============================================================
   Block: features-screenshot-topped-card-grid
   Title: FeaturesScreenshotToppedCardGrid
   Description: A screenshot topped card grid features section for React and Next.js with a centered eyebrow, headline, and subtitle above a three column grid of six cards each topped by a 16 by 9 crosshair image placeholder and a title plus description built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-screenshot-topped-card-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            @_headline.Eyebrow
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            @_headline.Title
        </h2>
        <p class="mt-5 text-base leading-relaxed text-muted-foreground">@_headline.Subtitle</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
        @foreach (var feature in _features)
        {
            <article class="overflow-hidden rounded-xl border bg-card">
                <div aria-hidden="true" class="flex aspect-[16/9] w-full items-center justify-center border-b bg-muted">
                    <div class="relative flex items-center justify-center">
                        <div class="absolute size-24 rounded-full border border-muted-foreground/[0.06]"></div>
                        <div class="absolute size-14 rounded-full border border-muted-foreground/[0.08]"></div>
                        <div class="absolute h-px w-32 bg-muted-foreground/[0.06]"></div>
                        <div class="absolute h-28 w-px bg-muted-foreground/[0.06]"></div>
                        <div class="flex size-8 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
                        </div>
                    </div>
                </div>
                <div class="p-5">
                    <h3 class="text-base font-semibold text-foreground">@feature.Title</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                        @feature.Description
                    </p>
                </div>
            </article>
        }
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureCard(string Id, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        Eyebrow: "The platform",
        Title: "Every surface of your product, ready out of the box",
        Subtitle: "Six pre-built modules that cover the capabilities customers expect on day one, from team management to billing to audit logs."
    );

    private static readonly FeatureCard[] _features =
    [
        new("team-workspace", "Team workspace", "Shared folders, threaded comments, and role-scoped permissions so every squad has the context they need without stepping on each other."),
        new("billing-portal", "Self-serve billing", "Customers upgrade, downgrade, and swap payment methods without opening a support ticket, backed by Stripe and usage-based metering."),
        new("audit-trail", "Immutable audit trail", "Every action across your workspace is stamped with a user, timestamp, and IP address and streamed to your SIEM in real time."),
        new("api-console", "API console", "Browse every endpoint, try live requests with scoped tokens, and copy runnable curl snippets straight from the interactive playground."),
        new("webhook-inspector", "Webhook inspector", "Replay any webhook delivery, inspect the exact payload your server received, and pinpoint signature mismatches in a single click."),
        new("usage-analytics", "Usage analytics", "Daily active users, seat utilization, and feature adoption broken down by workspace so customer success teams know where to focus."),
    ];
}
