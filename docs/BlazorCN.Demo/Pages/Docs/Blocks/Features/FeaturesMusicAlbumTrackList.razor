@* ============================================================
   Block: features-music-album-track-list
   Title: FeaturesMusicAlbumTrackList
   Description: A music album page mockup features section for React and Next.js with a square cover placeholder, album metadata header, and a track listing table where each track represents a capability built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-music-album-track-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Headline cluster *@
        <div>
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Now playing
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Six tracks. Six reasons to ship.
            </h2>
            <p class="mt-4 max-w-xl text-base text-muted-foreground">
                Each capability gets its own track. Play the whole thing on the flight home and you will
                know the platform cold.
            </p>
        </div>

        @* Album mockup *@
        <div class="mt-10 overflow-hidden rounded-xl border bg-card">
            @* Album header *@
            <div class="flex flex-col items-center gap-5 border-b p-6 sm:flex-row sm:items-end sm:gap-6">
                <div class="w-36 shrink-0 sm:w-40">
                    @* AlbumCover *@
                    <div class="relative aspect-square w-full overflow-hidden rounded-lg border bg-muted/40">
                        <svg aria-hidden="true" viewBox="0 0 200 200" class="absolute inset-0 h-full w-full">
                            <circle cx="100" cy="100" r="90" fill="none" stroke-dasharray="2 6" class="stroke-muted-foreground/30" />
                            <circle cx="100" cy="100" r="68" fill="none" stroke-dasharray="2 6" class="stroke-muted-foreground/30" />
                            <circle cx="100" cy="100" r="46" fill="none" stroke-dasharray="2 6" class="stroke-muted-foreground/30" />
                            <circle cx="100" cy="100" r="6" class="fill-muted-foreground/40" />
                        </svg>
                        <div class="absolute inset-0 flex items-center justify-center">
                            <span class="font-mono text-5xl font-bold tracking-tight text-foreground">@_album.Mark</span>
                        </div>
                        <div class="absolute top-3 left-3 rounded-sm bg-background/95 px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-widest shadow-sm ring-1 ring-border">
                            EP
                        </div>
                    </div>
                </div>
                <div class="flex-1 text-center sm:text-left">
                    <p class="text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
                        Album
                    </p>
                    <h3 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl">@_album.Title</h3>
                    <p class="mt-1 text-sm text-muted-foreground">@_album.Artist</p>
                    <p class="mt-1 font-mono text-[11px] tabular-nums text-muted-foreground">
                        @_album.Year &middot; @_album.TrackCount &middot; @_album.Length
                    </p>
                    <div class="mt-4 flex items-center justify-center gap-2 sm:justify-start">
                        <button type="button" aria-label="Play album"
                                class="flex size-10 items-center justify-center rounded-full bg-foreground text-background transition-transform hover:scale-105">
                            <LucideIconCn Name="play" Size="16" Class="size-4 translate-x-[1px] fill-current" />
                        </button>
                        <button type="button" aria-label="Shuffle album"
                                class="flex size-9 items-center justify-center rounded-full border text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground">
                            <LucideIconCn Name="shuffle" Size="14" Class="size-3.5" />
                        </button>
                        <button type="button" aria-label="Save album"
                                class="flex size-9 items-center justify-center rounded-full border text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground">
                            <LucideIconCn Name="heart" Size="14" Class="size-3.5" />
                        </button>
                    </div>
                </div>
            </div>

            @* Track table *@
            <div>
                <div class="grid grid-cols-[2rem_1fr_4rem_3rem] items-center gap-3 border-b px-5 py-2 text-[10px] font-semibold uppercase tracking-widest text-muted-foreground sm:grid-cols-[2rem_1fr_5rem_4rem_3rem]">
                    <span class="text-right">#</span>
                    <span>Title</span>
                    <span class="hidden text-right sm:block">Plays</span>
                    <span class="text-right">Length</span>
                    <span class="sr-only">Play</span>
                </div>
                <ul>
                    @foreach (var track in _tracks)
                    {
                        <li class="group grid grid-cols-[2rem_1fr_4rem_3rem] items-center gap-3 border-b px-5 py-3 last:border-b-0 hover:bg-muted/40 sm:grid-cols-[2rem_1fr_5rem_4rem_3rem]">
                            <span class="text-right font-mono text-xs tabular-nums text-muted-foreground group-hover:hidden">
                                @track.Number
                            </span>
                            <button type="button" aria-label="@($"Play {track.Title}")"
                                    class="hidden justify-end text-foreground group-hover:flex">
                                <LucideIconCn Name="play" Size="14" Class="size-3.5 translate-x-[1px] fill-current" />
                            </button>
                            <span class="truncate text-sm font-medium">@track.Title</span>
                            <span class="hidden text-right font-mono text-[11px] tabular-nums text-muted-foreground sm:block">
                                @track.Plays
                            </span>
                            <span class="text-right font-mono text-[11px] tabular-nums text-muted-foreground">
                                @track.Length
                            </span>
                            <span class="hidden justify-end text-muted-foreground group-hover:flex">
                                <LucideIconCn Name="heart" Size="14" Class="size-3.5" />
                            </span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
            <ButtonCn Class="w-full sm:w-[180px]">Play the EP</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">View liner notes</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record AlbumInfo(string Title, string Artist, string Year, string TrackCount, string Length, string Mark);

    private record TrackItem(string Number, string Title, string Length, string Plays);

    private static readonly AlbumInfo _album = new(
        Title: "The Platform EP",
        Artist: "By the engineering team",
        Year: "2026",
        TrackCount: "6 tracks",
        Length: "21 min",
        Mark: "TP"
    );

    private static readonly TrackItem[] _tracks =
    [
        new("1", "Global Edge (intro)", "2:14", "1.2M"),
        new("2", "Zero Downtime", "3:42", "890k"),
        new("3", "Rollback in 3s", "2:58", "642k"),
        new("4", "Preview URLs / feat. Git", "4:07", "515k"),
        new("5", "Observability, honestly", "3:31", "384k"),
        new("6", "Secrets rotation (outro)", "4:23", "271k"),
    ];
}
