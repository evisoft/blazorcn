@* ============================================================
   Block: features-minimal-outline-card-trio
   Title: FeaturesMinimalOutlineCardTrio
   Description: A minimal outline card trio feature section for React and Next.js with three large spacious numbered cards in a single horizontal row built with shadcn/ui, motion/react, and Tailwind CSS
   Source: original/blocks/features/features-minimal-outline-card-trio.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="max-w-2xl">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            @_headline.Eyebrow
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            @_headline.Title
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted-foreground">@_headline.Subtitle</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var feature in _features)
        {
            <article class="flex flex-col rounded-xl border bg-card p-8 sm:p-10">
                <span aria-hidden="true" class="text-5xl font-bold tracking-tight text-foreground/15 tabular-nums">
                    @feature.Number
                </span>
                <h3 class="mt-8 text-xl font-semibold leading-snug text-foreground">
                    @feature.Title
                </h3>
                <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
                    @feature.Description
                </p>
            </article>
        }
    </div>
</section>

@code {
    private record Headline(string Eyebrow, string Title, string Subtitle);

    private record Feature(string Id, string Number, string Title, string Description);

    private static readonly Headline _headline = new(
        "Three pillars",
        "A simpler way to build production software",
        "We stripped the platform down to the three things that actually move teams forward. Everything else is a distraction."
    );

    private static readonly Feature[] _features =
    [
        new(
            "ship-faster",
            "01",
            "Ship faster without breaking things",
            "Preview every change in isolation, promote with a single command, and roll back in seconds when something slips through. Zero configuration, zero waiting on infrastructure."
        ),
        new(
            "scale-quietly",
            "02",
            "Scale without a platform team",
            "Autoscale from a side project to a million requests a minute without tuning a single knob. The platform handles capacity, routing, and failover so your engineers can stay focused on the product."
        ),
        new(
            "sleep-easy",
            "03",
            "Sleep through the rollout",
            "Canary every deploy, watch the signals, and auto-pause when error rates drift. Get a digest the next morning instead of a 3 a.m. page about a bad release."
        ),
    ];
}
