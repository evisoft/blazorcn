@* ============================================================
   Block: features-venn-diagram-overlap
   Title: FeaturesVennDiagramOverlap
   Description: A three-circle Venn diagram features section for React and Next.js showing intersecting capability circles with labeled overlap zones and legend cards, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-venn-diagram-overlap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Positioning
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Where the three worlds finally meet.
            </h2>
            <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                Most platforms ask you to pick two. Ours is built in the small space where all three
                overlap — speed, security, and simplicity, running in production.
            </p>
        </div>

        @* Venn SVG *@
        <div class="mt-12 flex justify-center">
            <div class="w-full max-w-xl">
                <svg viewBox="0 0 520 420" class="h-auto w-full" aria-labelledby="venn-title venn-desc">
                    <title id="venn-title">Capability Venn diagram</title>
                    <desc id="venn-desc">
                        Three overlapping circles labeled Speed, Security, and Simplicity with intersection
                        zones highlighting combined capabilities.
                    </desc>

                    @* Center highlight (all three overlap) *@
                    <circle cx="260" cy="210" r="34" class="fill-foreground/[0.08]" />
                    <circle cx="260" cy="210" r="34" class="fill-none stroke-foreground/50" stroke-width="1" stroke-dasharray="3 3" />

                    @* Three circles *@
                    @foreach (var circ in _circles)
                    {
                        <circle cx="@circ.Cx" cy="@circ.Cy" r="120"
                                class="fill-foreground/[0.03] stroke-foreground/70"
                                stroke-width="1.25"
                                style="@($"transform-origin:{circ.Cx}px {circ.Cy}px")" />
                    }

                    @* Center label *@
                    <text x="260" y="207" text-anchor="middle" class="fill-foreground font-semibold" font-size="11">
                        Your platform
                    </text>
                    <text x="260" y="221" text-anchor="middle" class="fill-muted-foreground" font-size="10">
                        lives here
                    </text>

                    @* Circle labels *@
                    <text x="120" y="88" text-anchor="middle" class="fill-foreground font-bold uppercase tracking-widest" font-size="13">
                        Speed
                    </text>
                    <text x="400" y="88" text-anchor="middle" class="fill-foreground font-bold uppercase tracking-widest" font-size="13">
                        Security
                    </text>
                    <text x="260" y="408" text-anchor="middle" class="fill-foreground font-bold uppercase tracking-widest" font-size="13">
                        Simplicity
                    </text>

                    @* Intersection labels *@
                    @foreach (var inter in _intersections)
                    {
                        @((MarkupString)$"<text x=\"{inter.X}\" y=\"{inter.Y}\" text-anchor=\"{inter.Anchor}\" class=\"fill-foreground/65 font-medium\" font-size=\"10\">{inter.Label}</text>")
                    }
                </svg>
            </div>
        </div>

        @* Legend cards *@
        <div class="mt-10 grid gap-4 sm:grid-cols-3">
            @foreach (var circ in _circles)
            {
                <div class="rounded-lg border bg-card p-5">
                    <div class="flex size-9 items-center justify-center rounded-md border bg-muted/50">
                        <LucideIconCn Name="@circ.IconName" Size="16" Class="size-4" />
                    </div>
                    <h3 class="mt-4 text-sm font-semibold uppercase tracking-widest">@circ.Label</h3>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                        @circ.Description
                    </p>
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-center">
            <ButtonCn Class="w-full sm:w-[210px]">Start building</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[240px]">Compare platforms</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record VennCircle(string Id, string Label, string Description, string IconName, int Cx, int Cy);
    private record VennIntersection(string Id, string Label, int X, int Y, string Anchor);

    private static readonly VennCircle[] _circles =
    [
        new("speed",      "Speed",      "Sub-50ms cold starts, edge-deployed everywhere, instant rollbacks on every commit.",     "zap",            200, 170),
        new("security",   "Security",   "SOC 2 and HIPAA out of the box, signed builds, per-request policy evaluation.",          "lock",           320, 170),
        new("simplicity", "Simplicity", "One config file, one deploy command, zero YAML tuning required to go live.",             "circle-check-big", 260, 270),
    ];

    private static readonly VennIntersection[] _intersections =
    [
        new("i1", "Zero-config deploys", 260, 128, "middle"),
        new("i2", "Signed edge runs",    172, 260, "middle"),
        new("i3", "Audited one-liners",  348, 260, "middle"),
    ];
}
