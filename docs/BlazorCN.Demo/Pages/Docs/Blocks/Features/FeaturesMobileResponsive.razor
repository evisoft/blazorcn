@* ============================================================
   Block: features-mobile-responsive
   Title: Features Mobile Responsive
   Description: Mobile-first feature showcase with phone preview and feature list. Built with Next.js, React, shadcn/ui, and Tailwind CSS.
   Long Description: Side-by-side feature comparison
   Dependencies: None
   Source: original/blocks/features/features-mobile-responsive.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
          <span class="font-medium text-sm">Mobile-First Features</span>
          <p class="mt-0.5 text-muted-foreground text-xs">
            Optimized experience for mobile devices and small screens
          </p>
        </div>

        <div class="grid gap-6 p-6 md:grid-cols-2">
          <div class="flex items-center justify-center">
            <div class="relative aspect-[9/16] w-full max-w-[280px] overflow-hidden rounded-2xl border-4 border-foreground/10 bg-muted/30">
              <div class="absolute inset-x-0 top-0 flex h-8 items-center justify-center">
                <div class="h-4 w-24 rounded-full bg-foreground/10"></div>
              </div>

              <div class="flex h-full flex-col px-4 pb-4 pt-12">
                <div class="mb-4 h-12 rounded-lg bg-foreground/5"></div>

                <div class="flex-1 space-y-3">
                  <div class="h-20 rounded-lg bg-foreground/5"></div>
                  <div class="h-20 rounded-lg bg-foreground/5"></div>
                  <div class="h-20 rounded-lg bg-foreground/5"></div>
                </div>

                <div class="mt-4 flex gap-2">
                  <div class="h-12 flex-1 rounded-lg bg-foreground/5"></div>
                  <div class="h-12 flex-1 rounded-lg bg-foreground/5"></div>
                </div>
              </div>
            </div>
          </div>

          <div class="space-y-4">
            @foreach (var feature in _features)
            {
              <div class="flex gap-3">
                <div class="shrink-0 pt-0.5">
                  <span class="@(Cn.Merge("size-1.5 rounded-full", feature.Highlight ? "bg-emerald-500" : "bg-muted-foreground/40"))"></span>
                </div>

                <div class="min-w-0">
                  <div class="font-medium text-sm">@feature.Title</div>
                  <p class="mt-0.5 text-muted-foreground text-xs">@feature.Description</p>
                </div>
              </div>
            }
          </div>
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
          <div class="flex items-center justify-between text-xs">
            <span class="text-muted-foreground">
              Optimized for iOS, Android, and progressive web apps
            </span>
            <button type="button" class="transition-colors hover:text-foreground">
              View mobile demo
            </button>
          </div>
        </div>
      </div>
    </section>

@code {
    private record FeatureData(string Title, string Description, bool Highlight);

    private static readonly FeatureData[] _features = new[]
    {
        new FeatureData("Touch-optimized UI", "Larger tap targets and swipe gestures for natural mobile interaction", true),
        new FeatureData("Offline Support", "Continue working without connectivity with automatic sync when back online", true),
        new FeatureData("Push Notifications", "Real-time alerts for important events customizable per user", false),
        new FeatureData("Biometric Auth", "Face ID and fingerprint login for quick secure access", false),
        new FeatureData("Responsive Layouts", "Adaptive components that work perfectly on any screen size", true),
    };
}
