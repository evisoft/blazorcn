@* ============================================================
   Block: features-boarding-pass-ticket-stub
   Title: FeaturesBoardingPassTicketStub
   Description: A boarding pass features section for React and Next.js rendering each capability as an airline ticket with a perforated stub, flight metadata, and barcode built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-boarding-pass-ticket-stub.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-muted-foreground">
                <LucideIconCn Name="ticket" Size="12" Class="size-3" />
                Now boarding
            </span>
            <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Three tickets out of the old way of building.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Each capability is a direct flight — no layovers, no switching airlines. Board the pass,
                land in the modern stack, and never look back.
            </p>
        </div>

        @* Boarding passes *@
        <div class="mx-auto mt-10 flex max-w-2xl flex-col gap-5">
            @foreach (var pass in _passes)
            {
                var bars = BarcodeForFlight(pass.FlightNumber);
                <article aria-label="@($"Boarding pass from {pass.OriginLabel} to {pass.DestinationLabel}")"
                         class="flex flex-col overflow-hidden rounded-xl border bg-card shadow-sm sm:flex-row">
                    @* Main panel *@
                    <div class="relative flex-1 p-5">
                        @* Airline header *@
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2.5">
                                <span class="flex size-8 shrink-0 items-center justify-center rounded-md border bg-background">
                                    <LucideIconCn Name="@pass.IconName" Size="16" Class="size-4 text-foreground" />
                                </span>
                                <div>
                                    <div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted-foreground">
                                        SHADCN AIR
                                    </div>
                                    <div class="text-sm font-semibold text-foreground">@pass.Airline</div>
                                </div>
                            </div>
                            <span class="rounded-sm border px-1.5 py-0.5 font-mono text-[10px] font-medium uppercase text-muted-foreground">
                                @pass.Class
                            </span>
                        </div>

                        @* Origin → Destination *@
                        <div class="mt-5 flex items-end gap-3">
                            <div class="min-w-0 flex-1">
                                <div class="font-mono text-4xl font-bold tracking-tight text-foreground">
                                    @pass.OriginCode
                                </div>
                                <div class="mt-1 truncate text-[11px] uppercase tracking-wider text-muted-foreground">
                                    @pass.OriginLabel
                                </div>
                            </div>
                            <div class="mb-5 flex flex-col items-center gap-1 text-muted-foreground">
                                <LucideIconCn Name="plane" Size="16" Class="size-4 -rotate-45" />
                                <div class="h-px w-8 border-t border-dashed border-border"></div>
                            </div>
                            <div class="min-w-0 flex-1 text-right">
                                <div class="font-mono text-4xl font-bold tracking-tight text-foreground">
                                    @pass.DestinationCode
                                </div>
                                <div class="mt-1 truncate text-[11px] uppercase tracking-wider text-muted-foreground">
                                    @pass.DestinationLabel
                                </div>
                            </div>
                        </div>

                        <p class="mt-4 text-sm text-muted-foreground">@pass.Tagline</p>

                        @* Metadata grid *@
                        <div class="mt-5 grid grid-cols-2 gap-x-4 gap-y-3 border-t pt-4 sm:grid-cols-4">
                            @* Field: Flight *@
                            <div class="min-w-0">
                                <div class="text-[9px] font-medium uppercase tracking-[0.12em] text-muted-foreground">Flight</div>
                                <div class="truncate font-mono text-sm font-semibold text-foreground">@pass.FlightNumber</div>
                            </div>
                            @* Field: Gate *@
                            <div class="min-w-0">
                                <div class="text-[9px] font-medium uppercase tracking-[0.12em] text-muted-foreground">Gate</div>
                                <div class="truncate font-mono text-sm font-semibold text-foreground">@pass.Gate</div>
                            </div>
                            @* Field: Seat *@
                            <div class="min-w-0">
                                <div class="text-[9px] font-medium uppercase tracking-[0.12em] text-muted-foreground">Seat</div>
                                <div class="truncate font-mono text-sm font-semibold text-foreground">@pass.Seat</div>
                            </div>
                            @* Field: Terminal *@
                            <div class="min-w-0">
                                <div class="text-[9px] font-medium uppercase tracking-[0.12em] text-muted-foreground">Terminal</div>
                                <div class="truncate font-mono text-sm font-semibold text-foreground">@pass.Terminal</div>
                            </div>
                        </div>

                        @* Passenger + barcode *@
                        <div class="mt-4 flex items-end justify-between gap-4 border-t pt-4">
                            <div class="min-w-0">
                                <div class="flex items-center gap-1 text-[9px] font-medium uppercase tracking-[0.14em] text-muted-foreground">
                                    <LucideIconCn Name="user" Size="12" Class="size-3" />
                                    Passenger
                                </div>
                                <div class="mt-1 truncate font-mono text-sm font-semibold text-foreground">
                                    @pass.Passenger
                                </div>
                            </div>
                            <div class="w-32 shrink-0">
                                <svg aria-hidden="true" viewBox="0 0 200 32" class="h-7 w-full text-foreground" preserveAspectRatio="none">
                                    @{ var bx = 0; }
                                    @for (var bi = 0; bi < bars.Length; bi++)
                                    {
                                        var bw = bars[bi];
                                        var bxi = bx;
                                        var opacity = bi % 3 == 0 ? "0.9" : "0.7";
                                        <rect x="@bxi" y="0" width="@bw" height="32" fill="currentColor" opacity="@opacity" />
                                        bx += bw + 1;
                                    }
                                </svg>
                                <div class="mt-1 text-right font-mono text-[9px] text-muted-foreground">
                                    @pass.FlightNumber.Replace(" ", "")
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Perforation *@
                    <div aria-hidden="true" class="relative border-t-2 border-dashed border-border sm:border-l-2 sm:border-t-0">
                        @* Scalloped notches on the perforation line *@
                        <span class="absolute -top-2 left-1/2 size-4 -translate-x-1/2 rounded-full border bg-background sm:-left-2 sm:top-0 sm:translate-x-0 sm:-translate-y-1/2"></span>
                        <span class="absolute -bottom-2 left-1/2 size-4 -translate-x-1/2 rounded-full border bg-background sm:-left-2 sm:bottom-0 sm:translate-x-0 sm:translate-y-1/2"></span>
                    </div>

                    @* Stub *@
                    <div class="flex shrink-0 flex-col justify-between bg-muted/30 p-5 sm:w-48">
                        <div>
                            <div class="flex items-center justify-between">
                                <span class="text-[9px] font-semibold uppercase tracking-[0.14em] text-muted-foreground">
                                    Boarding Stub
                                </span>
                                <span class="rounded-sm bg-foreground px-1.5 py-0.5 font-mono text-[9px] font-medium uppercase text-background">
                                    @pass.BoardingGroup
                                </span>
                            </div>

                            <div class="mt-4 flex items-center gap-2 font-mono text-xs text-foreground">
                                <span>@pass.OriginCode</span>
                                <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground" />
                                <span>@pass.DestinationCode</span>
                            </div>

                            <div class="mt-4 space-y-2.5">
                                <div>
                                    <div class="flex items-center gap-1 text-[9px] uppercase tracking-[0.12em] text-muted-foreground">
                                        <LucideIconCn Name="calendar" Size="10" Class="size-2.5" />
                                        Date
                                    </div>
                                    <div class="font-mono text-xs font-semibold text-foreground">@pass.Date</div>
                                </div>
                                <div class="grid grid-cols-2 gap-2">
                                    <div>
                                        <div class="flex items-center gap-1 text-[9px] uppercase tracking-[0.12em] text-muted-foreground">
                                            <LucideIconCn Name="clock" Size="10" Class="size-2.5" />
                                            Depart
                                        </div>
                                        <div class="font-mono text-xs font-semibold text-foreground">@pass.Depart</div>
                                    </div>
                                    <div>
                                        <div class="text-[9px] uppercase tracking-[0.12em] text-muted-foreground">Arrive</div>
                                        <div class="font-mono text-xs font-semibold text-foreground">@pass.Arrive</div>
                                    </div>
                                </div>
                                <div>
                                    <div class="text-[9px] uppercase tracking-[0.12em] text-muted-foreground">Seat</div>
                                    <div class="font-mono text-xs font-semibold text-foreground">@pass.Seat · @pass.Duration</div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            @{ var stubBars = BarcodeForFlight(pass.FlightNumber); var sbx = 0; }
                            <svg aria-hidden="true" viewBox="0 0 200 32" class="h-7 w-full text-foreground" preserveAspectRatio="none">
                                @for (var sbi = 0; sbi < stubBars.Length; sbi++)
                                {
                                    var sbw = stubBars[sbi];
                                    var sbxi = sbx;
                                    var sopacity = sbi % 3 == 0 ? "0.9" : "0.7";
                                    <rect x="@sbxi" y="0" width="@sbw" height="32" fill="currentColor" opacity="@sopacity" />
                                    sbx += sbw + 1;
                                }
                            </svg>
                        </div>
                    </div>
                </article>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[230px]">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4" />
                Book your flight
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[260px]">
                See all destinations
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Pass(
        string Id,
        string IconName,
        string Airline,
        string Tagline,
        string OriginCode,
        string OriginLabel,
        string DestinationCode,
        string DestinationLabel,
        string FlightNumber,
        string Gate,
        string Seat,
        string Terminal,
        string BoardingGroup,
        string Passenger,
        string Date,
        string Depart,
        string Arrive,
        string Duration,
        string Class
    );

    private static readonly Pass[] _passes =
    [
        new("deploys", "rocket", "Instant Deploys", "Ship code the moment it compiles",
            "MAN", "Manual Releases", "AUT", "Automated Rollouts",
            "SH 001", "G12", "04A", "T1", "GROUP 1", "MORGAN HAYES",
            "APR 09 2026", "07:40", "07:42", "2 MIN", "FIRST"),
        new("observability", "gauge", "Live Observability", "Every request, every region, zero lag",
            "DRK", "Dark Launches", "INS", "Full Insights",
            "SH 014", "G04", "11C", "T2", "GROUP 2", "PRIYA NATARAJAN",
            "APR 09 2026", "09:15", "09:17", "2 MIN", "BUSINESS"),
        new("security", "shield-check", "Zero Trust Access", "SSO, SCIM, and audit trails out of the box",
            "VPN", "Legacy VPN", "ZTA", "Zero Trust",
            "SH 027", "G22", "01F", "T1", "GROUP 1", "DIEGO RAMIREZ",
            "APR 09 2026", "10:50", "10:51", "1 MIN", "FIRST"),
    ];

    private static int[] BarcodeForFlight(string flightNumber)
    {
        var widths = new[] { 1, 2, 3, 2, 1, 3 };
        var bars = new int[42];
        for (var i = 0; i < 42; i++)
        {
            var charCode = (int)flightNumber[i % flightNumber.Length];
            bars[i] = widths[(charCode + i) % widths.Length];
        }
        return bars;
    }
}
