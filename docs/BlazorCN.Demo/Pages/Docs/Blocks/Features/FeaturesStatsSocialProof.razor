@* ============================================================
   Block: features-stats-social-proof
   Title: Features Stats Social Proof
   Description: Feature grid combined with stat counters and testimonial that weaves credibility into the showcase
   Dependencies: None
   Source: original/blocks/features/features-stats-social-proof.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Trusted by data-driven teams</p>
            <p class="mt-0.5 text-xs text-muted-foreground">The event streaming platform built for scale, reliability, and developer experience</p>
        </div>

        <div class="grid grid-cols-2 gap-px border-b bg-border md:grid-cols-4">
            @foreach (var stat in _stats)
            {
                <div class="bg-card px-4 py-3 text-center">
                    <p class="text-2xl font-semibold tabular-nums">@stat.Value</p>
                    <p class="text-xs text-muted-foreground">@stat.Label</p>
                </div>
            }
        </div>

        <div class="grid gap-px border-b bg-border md:grid-cols-2 lg:grid-cols-3">
            @foreach (var feature in _features)
            {
                <div class="bg-card px-4 py-3">
                    <p class="text-sm font-medium">@feature.Title</p>
                    <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">@feature.Description</p>
                </div>
            }
        </div>

        <div class="border-b px-4 py-4">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-xs italic leading-relaxed text-muted-foreground">
                    &ldquo;We migrated our entire event pipeline in two weeks. The reliability and integration ecosystem saved our team months of build time.&rdquo;
                </p>
                <div class="mt-2">
                    <p class="text-xs font-medium">Marcus Rivera</p>
                    <p class="text-xs text-muted-foreground">VP of Engineering, ScaleOps</p>
                </div>
            </div>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-6 px-4 py-3">
            @foreach (var company in _companies)
            {
                <span class="text-xs font-medium text-muted-foreground/50">@company</span>
            }
        </div>
    </div>
</section>

@code {
    private record Stat(string Value, string Label);
    private record Feature(string Title, string Description);

    private static readonly Stat[] _stats =
    [
        new("10M+", "Events per second"),
        new("99.99%", "Uptime guarantee"),
        new("450+", "Integrations"),
        new("12K+", "Companies"),
    ];

    private static readonly Feature[] _features =
    [
        new("Real-Time Streaming", "Process millions of events per second with guaranteed ordering and exactly-once delivery."),
        new("Enterprise Security", "SOC 2 Type II, HIPAA, and GDPR compliant with end-to-end encryption."),
        new("Native Integrations", "Connect to 450+ destinations including warehouses, analytics, and marketing platforms."),
        new("Team Management", "Role-based access control, SSO, and audit logs for organizations of any size."),
        new("Auto-Scaling", "Infrastructure scales automatically from prototype to production with zero configuration."),
        new("Global Endpoints", "Ingest data from anywhere with regional endpoints in NA, Europe, and APAC."),
    ];

    private static readonly string[] _companies = ["Acme Corp", "Globex", "Initech", "Umbrella", "Stark Industries", "Wayne Enterprises"];
}
