@* ============================================================
   Block: features-receipt-itemized-printout
   Title: FeaturesReceiptItemizedPrintout
   Description: A thermal receipt features section for React and Next.js rendering an itemized POS printout with header metadata, monospaced line items, totals, barcode footer, and zigzag bottom edge built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-receipt-itemized-printout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Itemized receipt
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Everything rings up to zero.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The entire platform, printed like a POS receipt — every feature itemized, every line
                marked INCLUDED, and a total that never surprises you.
            </p>
        </div>

        @* Thermal receipt *@
        <article aria-label="Itemized feature receipt"
                 class="relative mx-auto mt-10 w-full max-w-sm bg-card font-mono text-foreground shadow-lg ring-1 ring-border"
                 style="clip-path: polygon(0 0, 100% 0, 100% calc(100% - 10px), 96% 100%, 92% calc(100% - 10px), 88% 100%, 84% calc(100% - 10px), 80% 100%, 76% calc(100% - 10px), 72% 100%, 68% calc(100% - 10px), 64% 100%, 60% calc(100% - 10px), 56% 100%, 52% calc(100% - 10px), 48% 100%, 44% calc(100% - 10px), 40% 100%, 36% calc(100% - 10px), 32% 100%, 28% calc(100% - 10px), 24% 100%, 20% calc(100% - 10px), 16% 100%, 12% calc(100% - 10px), 8% 100%, 4% calc(100% - 10px), 0 100%)">
            <div class="px-6 pt-6 pb-8">
                @* Header *@
                <header class="text-center">
                    <div class="flex items-center justify-center gap-2">
                        <LucideIconCn Name="receipt" Size="16" Class="size-4" aria-hidden="true" />
                        <span class="text-sm font-bold tracking-[0.2em]">@_storeInfo.Name</span>
                    </div>
                    <p class="mt-2 flex items-center justify-center gap-1.5 text-[10px] text-muted-foreground">
                        <LucideIconCn Name="map-pin" Size="10" Class="size-2.5" aria-hidden="true" />
                        @_storeInfo.Address
                    </p>
                    <p class="mt-1 flex items-center justify-center gap-1.5 text-[10px] text-muted-foreground">
                        <LucideIconCn Name="phone" Size="10" Class="size-2.5" aria-hidden="true" />
                        @_storeInfo.Phone
                    </p>
                </header>

                @* Dashed divider *@
                <div aria-hidden="true" class="my-4 border-t border-dashed border-muted-foreground/50"></div>

                @* Order metadata *@
                <div class="space-y-1 text-[10px] text-muted-foreground">
                    <div class="flex items-center justify-between">
                        <span>ORDER</span>
                        <span class="font-semibold text-foreground">@_storeInfo.Order</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span>DATE</span>
                        <span class="text-foreground">@_storeInfo.Date</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span>@_storeInfo.Cashier</span>
                        <span class="flex items-center gap-1 text-emerald-600">
                            <LucideIconCn Name="check-circle-2" Size="10" Class="size-2.5" aria-hidden="true" />
                            PAID
                        </span>
                    </div>
                </div>

                @* Dashed divider *@
                <div aria-hidden="true" class="my-4 border-t border-dashed border-muted-foreground/50"></div>

                @* Line items *@
                <dl class="space-y-2 text-[11px]">
                    @foreach (var lineItem in _lineItems)
                    {
                        <div class="flex items-baseline gap-3">
                            <dt class="flex min-w-0 flex-1 items-baseline gap-2">
                                <span class="shrink-0 tabular-nums text-muted-foreground">
                                    @lineItem.Qty ×
                                </span>
                                <span class="min-w-0 truncate uppercase text-foreground">@lineItem.Label</span>
                            </dt>
                            <dd class="@Cn.Merge("shrink-0 tabular-nums", lineItem.Price == "INCLUDED" ? "text-emerald-600 font-semibold" : "text-foreground")">
                                @lineItem.Price
                            </dd>
                        </div>
                    }
                </dl>

                @* Dashed divider *@
                <div aria-hidden="true" class="my-4 border-t border-dashed border-muted-foreground/50"></div>

                @* Totals *@
                <div class="space-y-1 text-[11px]">
                    <div class="flex items-center justify-between text-muted-foreground">
                        <span>SUBTOTAL</span>
                        <span class="tabular-nums">@_totals.Subtotal</span>
                    </div>
                    <div class="flex items-center justify-between text-muted-foreground">
                        <span>TAX</span>
                        <span class="tabular-nums">@_totals.Tax</span>
                    </div>
                    <div class="flex items-center justify-between pt-1 text-sm font-bold text-foreground">
                        <span>TOTAL</span>
                        <span class="tabular-nums">@_totals.Total</span>
                    </div>
                </div>

                @* Dashed divider *@
                <div aria-hidden="true" class="my-4 border-t border-dashed border-muted-foreground/50"></div>

                @* Footer with thank-you and barcode *@
                <footer class="text-center">
                    <p class="text-[10px] font-semibold tracking-[0.18em] text-foreground">
                        THANK YOU FOR SHIPPING
                    </p>

                    @* Barcode *@
                    <svg aria-hidden="true" viewBox="0 0 120 40" class="mx-auto mt-3 h-10 w-32">
                        @{ var bx = 2; }
                        @for (var bi = 0; bi < _barcodeBars.Length; bi++)
                        {
                            var bw = _barcodeBars[bi];
                            var bxi = bx;
                            <rect x="@bxi" y="0" width="@bw" height="30" fill="currentColor" />
                            bx += bw + 1;
                        }
                    </svg>
                    <p class="mt-1 font-mono text-[9px] tracking-[0.25em] text-muted-foreground">
                        @_storeInfo.Order
                    </p>

                    @* Customer copy stamp *@
                    <div class="mt-4 inline-flex rotate-[-3deg] border-2 border-double border-muted-foreground/60 px-3 py-1 text-[10px] font-bold tracking-[0.2em] text-muted-foreground/70">
                        CUSTOMER COPY
                    </div>
                </footer>
            </div>
        </article>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[230px]">
                <LucideIconCn Name="store" Size="16" Class="size-4" aria-hidden="true" />
                Start free trial
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">
                View full menu
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StoreInfo(
        string Name,
        string Address,
        string Phone,
        string Order,
        string Date,
        string Cashier
    );

    private record LineItem(string Id, int Qty, string Label, string Price);

    private record Totals(string Subtotal, string Tax, string Total);

    private static readonly StoreInfo _storeInfo = new(
        Name: "PLATFORM CO.",
        Address: "340 Terminal Ave, Edge City",
        Phone: "+1 (555) 018-2026",
        Order: "#A1-88420",
        Date: "APR 09 2026  10:42 AM",
        Cashier: "CASHIER: AUTO-DEPLOY"
    );

    private static readonly LineItem[] _lineItems =
    [
        new("edge",          1,  "Edge caching",           "INCLUDED"),
        new("regions",       34, "Global regions",          "INCLUDED"),
        new("observability", 1,  "Logs + metrics + traces", "INCLUDED"),
        new("rollback",      1,  "Instant rollback",        "INCLUDED"),
        new("sso",           1,  "SSO + MFA + audit log",   "$0.00"),
        new("scale",         1,  "Scale-to-zero autoscaler","$0.00"),
    ];

    private static readonly Totals _totals = new("$0.00", "$0.00", "$0.00");

    // 24 barcode bars with varying widths (deterministic)
    private static readonly int[] _barcodeBars = [2, 1, 3, 1, 2, 2, 1, 3, 1, 1, 2, 1, 3, 2, 1, 1, 2, 1, 3, 1, 2, 1, 1, 2];
}
