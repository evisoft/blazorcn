@* ============================================================
   Block: features-vending-machine-slot-grid
   Title: FeaturesVendingMachineSlotGrid
   Description: A vending machine slot grid features section for React and Next.js with a 4x3 product slot panel, coin slot entry, and numeric keypad selector built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-vending-machine-slot-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Headline cluster *@
    <div class="text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Pick a slot
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Capabilities behind the glass.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
        Every feature is a snack you can pick a-la-carte. Punch a slot code, get a capability —
        no contract negotiation required.
      </p>
    </div>

    @* Vending machine body *@
    <div class="mt-12 rounded-3xl border-2 border-foreground/20 bg-muted/40 p-5 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)] sm:p-8">
      @* Top brand strip *@
      <div class="mb-5 flex items-center justify-between border-b border-foreground/10 pb-4">
        <div class="flex items-center gap-2">
          <span class="size-2 rounded-full bg-emerald-500"></span>
          <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
            Stack-O-Matic · Mk III
          </span>
        </div>
        <span class="font-mono text-[10px] text-muted-foreground">SN · 0428-A</span>
      </div>

      @* Glass panel: 4 columns x 3 rows *@
      <div class="rounded-xl border border-foreground/15 bg-background/60 p-3">
        <ul class="grid grid-cols-4 gap-2">
          @foreach (var slot in _slots)
          {
            var isActive = slot.Code == ActiveCode;
            <li>
              <button
                type="button"
                aria-label="@($"Slot {slot.Code}: {slot.Name}")"
                class="@Cn.Merge("group relative flex aspect-[3/4] w-full flex-col items-center justify-between rounded-md border bg-card p-2 text-left transition-colors sm:p-3", isActive ? "border-foreground/40 ring-2 ring-foreground/10" : "border-border hover:border-foreground/30 hover:bg-muted/60")"
              >
                <span class="@Cn.Merge("font-mono text-[9px] font-semibold tracking-wider", isActive ? "text-foreground" : "text-muted-foreground")">
                  @slot.Code
                </span>
                <span class="@Cn.Merge("flex size-8 items-center justify-center rounded-full border bg-background sm:size-10", isActive ? "border-foreground/40" : "")">
                  <LucideIconCn Name="@slot.IconName" Size="14" Class="@Cn.Merge("size-3.5 sm:size-4", isActive ? "text-foreground" : "text-muted-foreground")" />
                </span>
                <div class="flex w-full flex-col items-center gap-0.5">
                  <span class="w-full truncate text-center text-[10px] font-medium leading-tight text-foreground sm:text-xs">
                    @slot.Name
                  </span>
                  <span class="text-[9px] font-medium text-muted-foreground sm:text-[10px]">
                    @slot.Tier
                  </span>
                </div>
              </button>
            </li>
          }
        </ul>
      </div>

      @* Lower console: display + coin slot + keypad *@
      <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-[1fr_auto]">
        @* Left: display window + coin slot input *@
        <div class="flex flex-col gap-3">
          @* Digital display *@
          <div
            aria-live="polite"
            class="rounded-md border border-foreground/20 bg-foreground/95 p-4 font-mono text-emerald-400 shadow-[inset_0_0_12px_rgba(0,0,0,0.4)]"
          >
            <div class="flex items-center justify-between text-[9px] uppercase tracking-[0.25em] opacity-70">
              <span>Display</span>
              <span class="inline-flex items-center gap-1">
                <span class="size-1 animate-pulse rounded-full bg-emerald-400"></span>
                ON
              </span>
            </div>
            <div class="mt-2 flex items-baseline gap-3">
              <span class="text-lg font-semibold tracking-[0.15em] sm:text-xl">READY</span>
              <span class="opacity-60">·</span>
              <span class="text-lg font-semibold tracking-[0.15em] sm:text-xl">
                @_activeSlot.Code
              </span>
            </div>
            <div class="mt-1 text-[10px] uppercase tracking-widest opacity-80">
              @_activeSlot.Name · @_activeSlot.Tier/req
            </div>
          </div>

          @* Insert code input *@
          <div class="rounded-md border border-foreground/15 bg-card p-3">
            <div class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
              Insert code
            </div>
            <div class="mt-2 flex items-center gap-2">
              <div class="flex-1 rounded border border-dashed border-foreground/20 bg-background/60 px-3 py-2 font-mono text-sm tracking-[0.3em] text-foreground">
                A<span class="text-muted-foreground">·</span>1
              </div>
              <span class="size-8 rounded-full border border-dashed border-foreground/20 bg-background/60"></span>
            </div>
          </div>
        </div>

        @* Right: 3x4 keypad *@
        <div class="flex flex-col gap-2">
          <div class="text-center text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
            Keypad
          </div>
          <div class="grid grid-cols-3 gap-1.5 rounded-md border border-foreground/15 bg-card p-2">
            @foreach (var key in _keypad)
            {
              var isAction = key == "C" || key == "E";
              <button
                type="button"
                aria-label="@(key == "C" ? "Clear" : key == "E" ? "Enter" : $"Number {key}")"
                class="@Cn.Merge("flex size-10 items-center justify-center rounded border border-border bg-background font-mono text-xs font-semibold text-foreground transition-colors hover:border-foreground/30 hover:bg-muted/70 sm:size-11 sm:text-sm", isAction ? "bg-muted/50 text-muted-foreground" : "", key == "E" ? "border-emerald-500/50 text-emerald-600" : "")"
              >
                @if (key == "C")
                {
                  <LucideIconCn Name="delete" Size="14" Class="size-3.5" aria-hidden="true" />
                }
                else
                {
                  @key
                }
              </button>
            }
          </div>
        </div>
      </div>
    </div>

    @* CTA pair *@
    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <ButtonCn Class="w-full sm:w-[230px]">Browse inventory</ButtonCn>
      <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[240px]">
        View pricing menu
      </ButtonCn>
    </div>
  </div>
</section>

@code {
    private const string ActiveCode = "A1";

    private record VendingSlot(string Code, string IconName, string Name, string Tier);

    private static readonly VendingSlot[] _slots =
    [
        new("A1", "zap",        "Edge Cache",  "$0.02"),
        new("A2", "shield",     "WAF Shield",  "$0.05"),
        new("A3", "cloud",      "Auto Scale",  "$0.03"),
        new("A4", "database",   "Vector DB",   "$0.08"),
        new("B1", "lock",       "SSO / SAML",  "$0.04"),
        new("B2", "git-branch", "Preview Env", "$0.02"),
        new("B3", "search",     "Full Search", "$0.06"),
        new("B4", "bell",       "Alerting",    "$0.01"),
        new("C1", "cpu",        "GPU Runner",  "$0.12"),
        new("C2", "globe",      "Geo Routing", "$0.03"),
        new("C3", "key-round",  "Vault",       "$0.04"),
        new("C4", "code",       "API Gateway", "$0.05"),
    ];

    private static readonly string[] _keypad =
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "C", "0", "E"];

    private static readonly VendingSlot _activeSlot =
        Array.Find(_slots, s => s.Code == ActiveCode) ?? _slots[0];
}
