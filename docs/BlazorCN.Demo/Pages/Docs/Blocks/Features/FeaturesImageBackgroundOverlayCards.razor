@* ============================================================
   Block: features-image-background-overlay-cards
   Title: FeaturesImageBackgroundOverlayCards
   Description: A media-forward features section for React and Next.js with a full-bleed 16:9 image background, three staircase-positioned overlay feature cards, a frosted eyebrow and headline pill, and a ShadcnioButton CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-image-background-overlay-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">

    @* Image background hero *@
    <div class="relative w-full bg-muted lg:aspect-[16/9]">

      @* Crosshair placeholder decoration *@
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 flex items-center justify-center">
        <div class="relative flex items-center justify-center">
          <div class="absolute size-56 rounded-full border border-muted-foreground/[0.06]"></div>
          <div class="absolute size-36 rounded-full border border-muted-foreground/[0.08]"></div>
          <div class="absolute h-px w-[28rem] bg-muted-foreground/[0.06]"></div>
          <div class="absolute h-[20rem] w-px bg-muted-foreground/[0.06]"></div>
          <div class="flex size-10 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
          </div>
        </div>
      </div>

      @* Legibility tint — sits above the image, below the cards *@
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-foreground/[0.04]"></div>

      @* Frosted headline pill *@
      <div class="absolute left-6 top-6 max-w-[19rem] rounded-2xl border border-border/60 bg-card/80 p-5 backdrop-blur-md sm:left-8 sm:top-8">
        <p class="text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
          @_headline.Eyebrow
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
          @_headline.Title
        </h2>
      </div>

      @* Desktop staircase overlay cards (absolutely positioned at lg+) *@
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden lg:block">
        @foreach (var card in _overlayCards)
        {
          <article class="@(Cn.Merge("pointer-events-auto absolute w-[17rem] rounded-xl border bg-card p-5 shadow-lg", card.Position))">
            <div class="flex size-9 items-center justify-center rounded-lg bg-muted">
              <LucideIconCn Name="@card.IconName" Size="16" Class="size-4 text-muted-foreground" />
            </div>
            <h3 class="mt-3 text-base font-semibold text-foreground">@card.Title</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
              @card.Description
            </p>
          </article>
        }
      </div>
    </div>

    @* Mobile stacked cards (hidden on lg+) *@
    <div class="grid grid-cols-1 gap-4 border-t border-border p-6 sm:p-8 lg:hidden">
      @foreach (var card in _overlayCards)
      {
        <article class="rounded-xl border bg-card p-5">
          <div class="flex size-9 items-center justify-center rounded-lg bg-muted">
            <LucideIconCn Name="@card.IconName" Size="16" aria-hidden="true" Class="size-4 text-muted-foreground" />
          </div>
          <h3 class="mt-3 text-base font-semibold text-foreground">@card.Title</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
            @card.Description
          </p>
        </article>
      }
    </div>

    @* CTA row *@
    <div class="flex flex-col items-start justify-between gap-4 border-t border-border px-6 py-6 sm:flex-row sm:items-center sm:px-8">
      <p class="text-sm text-muted-foreground">
        One workspace. Every surface your team touches.
      </p>
      <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
    </div>

  </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title);
    private record OverlayCardData(string Id, string Title, string Description, string IconName, string Position);

    private static readonly HeadlineData _headline = new("One canvas", "Everything lives in the same view");

    private static readonly OverlayCardData[] _overlayCards =
    [
        new("layered-workspace", "Layered workspace", "Flip between source, preview, and deploy without losing scroll position.", "layers", "lg:left-[6%] lg:top-[28%]"),
        new("instant-metrics", "Instant metrics", "Traffic, errors, and cache hit rate live next to the code that produced them.", "gauge", "lg:left-[36%] lg:top-[46%]"),
        new("locked-environments", "Locked environments", "Production tokens are scoped, rotated, and audit-logged by default.", "lock", "lg:left-[62%] lg:top-[30%]"),
    ];
}
