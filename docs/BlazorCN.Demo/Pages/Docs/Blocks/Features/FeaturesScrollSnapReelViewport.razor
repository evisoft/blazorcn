            "hero", "See the guided setup",
            [new("Setup time", "1m 48s"), new("Sample projects", "4"), new("Automations", "12")],
            []),
        new("collab", "02 — Collaborate", "users", "Presence, cursors, and comment threads in every view",
            "See where teammates are reading. Leave inline comments on any row, card, or cell. Mentions resolve to threaded discussions that survive archiving and never lose their anchor.",
            "split", "Watch the collab demo",
            [new("Online teammates", "14"), new("Open threads", "23"), new("Avg reply time", "6m")],
            []),
        new("report", "03 — Report", "bar-chart-3", "Dashboards that write their own executive summaries",
            "Drag any metric onto a canvas and the engine picks the right chart shape, time bucket, and comparison baseline. Export to PDF or schedule a weekly digest in one click.",
            "mockup", "Open a live dashboard",
            [new("Revenue MoM", "+18.4%"), new("Active users", "12,840"), new("Churn", "1.2%")],
            []),
        new("automate", "04 — Automate", "workflow", "Workflows that move work between tools without glue code",
            "Chain triggers, conditions, and actions across 120+ integrations. Every run leaves an audit trail you can replay, and failures retry with exponential backoff instead of silently dropping.",
            "ribbon", "Browse the recipe gallery",
            [new("Recipes", "240+"), new("Runs / day", "1.2M"), new("Success rate", "99.94%")],
            ["Trigger", "Enrich", "Route", "Notify", "Close"]),
        new("bill", "05 — Bill", "credit-card", "Usage metering that Stripe and your finance team actually trust",
            "Meter any event, then translate it into invoice line items with proration on plan changes. Every invoice links back to the exact events that produced it for painless dispute resolution.",
            "metrics", "Talk to finance",
            [new("Events / sec", "22k"), new("Accuracy", "99.99%"), new("Disputes", "0.03%")],
            []),
    ];

    private static readonly int[] _mockupBars = [42, 58, 71, 65, 82, 74, 88, 79, 94, 86, 92, 98];

    private record CollabRow(string Name, string Initials, string Role, string Time);

    private static readonly CollabRow[] _collabRows =
    [
        new("Avery Park", "AP", "Editing design brief", "now"),
        new("Chen Liu", "CL", "Commented on Q3 roadmap", "2m"),
        new("Priya R.", "PR", "Resolved thread in landing page", "5m"),
        new("Marcus K.", "MK", "Mentioned you in retro", "12m"),
    ];
}
