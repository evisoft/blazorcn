@* ============================================================
   Block: features-scroll-snap-reel-viewport
   Title: FeaturesScrollSnapReelViewport
   Description: A scroll snap reel viewport features section for React and Next.js with a fixed-height snapping scroll container, five full-slide capabilities, and a vertical dot navigator built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-scroll-snap-reel-viewport.tsx
   ============================================================ *@

@inject IJSRuntime JS

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Headline *@
    <div class="max-w-xl">
      <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
        Product tour
      </span>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Scroll the reel to tour the platform.
      </h2>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">
        Five capabilities, five snap points. Drag within the viewport and each slide locks into
        place. Use the dot rail to jump straight to whatever matters.
      </p>
    </div>

    @* Reel + dot rail *@
    <div class="relative mt-10">
      <div
        id="scroll-reel-viewport"
        role="group"
        tabindex="0"
        aria-label="Product tour reel"
        class="scrollbar-hide h-[600px] snap-y snap-mandatory overflow-y-auto rounded-xl border bg-card"
        style="scrollbar-width:none;-ms-overflow-style:none"
        @onscroll="HandleScroll"
        @ref="_viewportRef"
      >
        @foreach (var slideItem in _slides)
        {
          var idx = Array.IndexOf(_slides, slideItem);
          <div
            aria-labelledby="@($"slide-{slideItem.Id}-title")"
            class="@Cn.Merge("h-[600px] snap-start snap-always", idx < _slides.Length - 1 ? "border-b" : "")"
          >
            <h3 id="@($"slide-{slideItem.Id}-title")" class="sr-only">@slideItem.Title</h3>
            @RenderSlide(slideItem)
          </div>
        }
      </div>

      @* Vertical dot nav — desktop *@
      <div class="pointer-events-none absolute inset-y-0 right-3 hidden flex-col items-center justify-center gap-3 md:flex">
        <div class="pointer-events-auto flex flex-col items-center gap-1 rounded-full border bg-background/90 px-2 py-3 shadow-sm backdrop-blur">
          @foreach (var slideItem in _slides)
          {
            var navIdx = Array.IndexOf(_slides, slideItem);
            var isActive = navIdx == _activeIndex;
            var navItem = slideItem;
            <button
              type="button"
              aria-label="@($"Jump to {navItem.Title}")"
              aria-current="@(isActive ? "true" : null)"
              @onclick="@(() => JumpTo(navIdx))"
              class="@Cn.Merge("flex size-6 items-center justify-center transition-all", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")"
            >
              <span class="@Cn.Merge("rounded-full transition-all", isActive ? "size-2.5 bg-foreground" : "size-1.5 bg-muted-foreground/40")" />
            </button>
          }
        </div>
      </div>
    </div>

    @* Horizontal progress strip — mobile *@
    <div class="mt-4 flex items-center gap-0.5 md:hidden">
      @foreach (var slideItem in _slides)
      {
        var mobileIdx = Array.IndexOf(_slides, slideItem);
        var isActive = mobileIdx == _activeIndex;
        var mobileItem = slideItem;
        <button
          type="button"
          aria-label="@($"Jump to {mobileItem.Title}")"
          @onclick="@(() => JumpTo(mobileIdx))"
          class="inline-flex h-6 min-w-6 items-center justify-center"
        >
          <span class="@Cn.Merge("h-1 rounded-full transition-all", isActive ? "w-8 bg-foreground" : "w-3 bg-muted-foreground/30")"></span>
        </button>
      }
    </div>

    @* Footer meta row *@
    <div class="mt-6 flex flex-col gap-4 rounded-xl border bg-muted/30 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <div>
          <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
            On screen
          </div>
          <div class="mt-0.5 flex items-center gap-2 text-sm font-medium text-foreground">
            <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
            @_slides[_activeIndex].Eyebrow
            <span class="font-mono text-muted-foreground">
              @((_activeIndex + 1).ToString("D2"))/@(_slides.Length.ToString("D2"))
            </span>
          </div>
        </div>
      </div>
      <ButtonCn Class="w-full sm:w-[270px]">
        Start the guided tour
      </ButtonCn>
    </div>
  </div>
</section>

@code {
    private ElementReference _viewportRef;
    private int _activeIndex = 0;
    private const int SlideHeight = 600;

    private RenderFragment RenderSlide(SlideData slide)
    {
        return slide.Layout switch
        {
            "hero"    => RenderHero(slide),
            "split"   => RenderSplit(slide),
            "mockup"  => RenderMockup(slide),
            "metrics" => RenderMetrics(slide),
            "ribbon"  => RenderRibbon(slide),
            _         => (__builder) => { },
        };
    }

    private RenderFragment RenderHero(SlideData slide) =>
        @<div class="flex h-full flex-col items-center justify-center px-8 text-center">
          <span class="flex size-12 items-center justify-center rounded-xl border bg-background shadow-sm">
            <LucideIconCn Name="@slide.Icon" Size="20" Class="size-5 text-foreground" />
          </span>
          <span class="mt-5 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
            @slide.Eyebrow
          </span>
          <h3 class="mt-3 max-w-xl text-2xl font-semibold leading-tight text-foreground md:text-3xl">
            @slide.Title
          </h3>
          <p class="mt-4 max-w-lg text-sm leading-relaxed text-muted-foreground md:text-base">
            @slide.Description
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-6 border-t border-b py-4">
            @foreach (var m in slide.Metrics)
            {
              <div class="text-center">
                <div class="font-mono text-xl font-semibold text-foreground tabular-nums">@m.Value</div>
                <div class="mt-0.5 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">@m.Label</div>
              </div>
            }
          </div>
          <div class="mt-6 inline-flex items-center gap-1.5 text-xs font-medium text-foreground">
            @slide.Cta
            <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
          </div>
        </div>;

    private RenderFragment RenderSplit(SlideData slide) =>
        @<div class="grid h-full grid-cols-1 items-center gap-8 px-8 md:grid-cols-2 md:gap-12">
          <div>
            <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
              @slide.Eyebrow
            </span>
            <h3 class="mt-3 text-2xl font-semibold leading-tight text-foreground md:text-3xl">
              @slide.Title
            </h3>
            <p class="mt-4 text-sm leading-relaxed text-muted-foreground">@slide.Description</p>
            <div class="mt-6 inline-flex items-center gap-1.5 text-xs font-medium text-foreground">
              @slide.Cta
              <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </div>
          </div>
          <div class="hidden h-full max-h-[360px] flex-col overflow-hidden rounded-xl border bg-muted/40 md:flex">
            <div class="flex items-center gap-2 border-b bg-background/60 px-4 py-2.5">
              <span class="flex size-5 items-center justify-center rounded-md border bg-background">
                <LucideIconCn Name="@slide.Icon" Size="10" Class="size-2.5 text-foreground" />
              </span>
              <span class="font-mono text-[10px] text-muted-foreground">teamspace.live</span>
              <span class="ml-auto flex items-center gap-1 text-[10px] text-emerald-600 dark:text-emerald-400">
                <span class="size-1 rounded-full bg-emerald-500" />
                14 online
              </span>
            </div>
            <div class="flex flex-1 flex-col divide-y">
              @foreach (var row in _collabRows)
              {
                <div class="flex items-center gap-3 px-4 py-2.5">
                  <span class="flex size-7 items-center justify-center rounded-full border bg-background text-[10px] font-medium text-foreground">
                    @row.Initials
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="truncate text-xs font-medium text-foreground">@row.Name</div>
                    <div class="truncate text-[11px] text-muted-foreground">@row.Role</div>
                  </div>
                  <span class="font-mono text-[10px] text-muted-foreground">@row.Time</span>
                </div>
              }
            </div>
          </div>
        </div>;

    private RenderFragment RenderMockup(SlideData slide) =>
        @<div class="flex h-full flex-col justify-center px-8">
          <div class="max-w-xl">
            <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
              @slide.Eyebrow
            </span>
            <h3 class="mt-3 text-2xl font-semibold leading-tight text-foreground md:text-3xl">
              @slide.Title
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">@slide.Description</p>
          </div>
          <div class="mt-6 overflow-hidden rounded-xl border bg-muted/40">
            <div class="flex items-center justify-between border-b bg-background/60 px-4 py-2.5">
              <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-muted-foreground/30" />
                <span class="size-1.5 rounded-full bg-muted-foreground/30" />
                <span class="size-1.5 rounded-full bg-muted-foreground/30" />
              </div>
              <span class="font-mono text-[10px] text-muted-foreground">Executive view</span>
              <span class="text-[10px] text-muted-foreground">Weekly</span>
            </div>
            <div class="grid grid-cols-3 divide-x">
              @foreach (var m in slide.Metrics)
              {
                <div class="px-4 py-4">
                  <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">@m.Label</div>
                  <div class="mt-1 font-mono text-lg font-semibold text-foreground tabular-nums">@m.Value</div>
                  <div class="mt-2 h-1 rounded-full bg-muted">
                    <div class="h-full w-3/4 rounded-full bg-foreground/80" />
                  </div>
                </div>
              }
            </div>
            <div class="flex items-end gap-1 border-t bg-background/60 px-4 py-3">
              @foreach (var bar in _mockupBars)
              {
                <div
                  class="flex-1 rounded-sm bg-foreground/70"
                  style="@(FormattableString.Invariant($"height:{(bar * 0.32):F2}px"))"
                />
              }
            </div>
          </div>
        </div>;

    private RenderFragment RenderMetrics(SlideData slide) =>
        @<div class="flex h-full flex-col justify-center px-8">
          <div class="flex items-center gap-2">
            <span class="flex size-7 items-center justify-center rounded-md border bg-background">
              <LucideIconCn Name="@slide.Icon" Size="14" Class="size-3.5 text-foreground" />
            </span>
            <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
              @slide.Eyebrow
            </span>
          </div>
          <h3 class="mt-4 max-w-xl text-2xl font-semibold leading-tight text-foreground md:text-3xl">
            @slide.Title
          </h3>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground">
            @slide.Description
          </p>
          <div class="mt-8 grid grid-cols-3 gap-3">
            @foreach (var m in slide.Metrics)
            {
              <div class="rounded-xl border bg-muted/30 p-5">
                <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">@m.Label</div>
                <div class="mt-2 font-mono text-2xl font-semibold text-foreground tabular-nums">@m.Value</div>
                <div class="mt-3 flex items-center gap-1 text-[10px] text-emerald-600 dark:text-emerald-400">
                  <span class="size-1 rounded-full bg-emerald-500" />
                  Within SLO
                </div>
              </div>
            }
          </div>
        </div>;

    private RenderFragment RenderRibbon(SlideData slide) =>
        @<div class="flex h-full flex-col justify-center px-8">
          <div class="max-w-xl">
            <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
              @slide.Eyebrow
            </span>
            <h3 class="mt-3 text-2xl font-semibold leading-tight text-foreground md:text-3xl">
              @slide.Title
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">@slide.Description</p>
          </div>
          <div class="mt-8 flex items-center gap-2 overflow-hidden rounded-xl border bg-muted/30 p-4">
            @for (var si = 0; si < slide.Steps.Length; si++)
            {
              var step = slide.Steps[si];
              var stepIdx = si;
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-2 rounded-lg border bg-background px-3 py-2">
                  <span class="flex size-5 items-center justify-center rounded-full bg-foreground text-[10px] font-semibold text-background tabular-nums">
                    @(stepIdx + 1)
                  </span>
                  <span class="text-xs font-medium text-foreground">@step</span>
                </div>
                @if (stepIdx < slide.Steps.Length - 1)
                {
                  <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground" />
                }
              </div>
            }
          </div>
          <div class="mt-4 grid grid-cols-3 gap-3">
            @foreach (var m in slide.Metrics)
            {
              <div class="flex items-baseline justify-between rounded-lg border px-4 py-2.5">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">@m.Label</span>
                <span class="font-mono text-sm font-semibold text-foreground tabular-nums">@m.Value</span>
              </div>
            }
          </div>
        </div>;

    private async Task HandleScroll()
    {
        try
        {
            var scrollTop = await JS.InvokeAsync<double>("eval",
                "document.getElementById('scroll-reel-viewport')?.scrollTop ?? 0");
            var next = (int)Math.Round(scrollTop / SlideHeight);
            var clamped = Math.Max(0, Math.Min(_slides.Length - 1, next));
            if (clamped != _activeIndex)
            {
                _activeIndex = clamped;
            }
        }
        catch { }
    }

    private async Task JumpTo(int i)
    {
        _activeIndex = i;
        try
        {
            await JS.InvokeVoidAsync("eval",
                $"document.getElementById('scroll-reel-viewport')?.scrollTo({{top:{i * SlideHeight},behavior:'smooth'}})");
        }
        catch { }
    }

    private record SlideMetricData(string Label, string Value);

    private record SlideData(
        string Id,
        string Eyebrow,
        string Icon,
        string Title,
        string Description,
        string Layout,
        string Cta,
        SlideMetricData[] Metrics,
        string[] Steps
    );

    private static readonly SlideData[] _slides =
    [
        new("onboard", "01 — Onboard", "sparkles", "Kick off a workspace in under two minutes",
