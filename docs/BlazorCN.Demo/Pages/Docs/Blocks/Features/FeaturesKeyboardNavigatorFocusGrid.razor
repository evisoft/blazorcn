@* ============================================================
   Block: features-keyboard-navigator-focus-grid
   Title: FeaturesKeyboardNavigatorFocusGrid
   Description: A keyboard navigator focus grid features section for React and Next.js with arrow-key navigation across a six-cell grid, shared layout focus ring, Enter-to-select detail strip, and a live keystroke indicator built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-keyboard-navigator-focus-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline + keystroke indicator *@
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div class="max-w-xl">
                <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Built for keyboards
                </span>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                    Every feature is one keystroke away.
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                    Use your arrow keys to move the focus ring. Press Enter to open the detail strip
                    below.
                </p>
            </div>
            <div class="flex items-center gap-2 rounded-lg border bg-muted/30 px-3 py-2 font-mono text-xs">
                <span class="text-[10px] uppercase tracking-wider text-muted-foreground">keys</span>
                <div class="flex items-center gap-1">
                    @foreach (var key in _indicatorKeys)
                    {
                        var k = key;
                        <span class="@Cn.Merge("flex size-6 items-center justify-center rounded border bg-background text-[11px] text-muted-foreground transition-colors", _lastKey == k ? "border-foreground bg-foreground text-background" : "")">
                            @_keyIcons[k]
                        </span>
                    }
                </div>
            </div>
        </div>

        @* Keyboard grid *@
        <div
            role="grid"
            aria-label="Feature keyboard navigator"
            aria-activedescendant="@($"cell-{_navCells[_focusedIndex].Id}")"
            tabindex="0"
            @onkeydown="HandleKeyDown"
            @onfocus="OnGridFocus"
            class="mt-10 grid grid-cols-2 gap-3 rounded-2xl border bg-muted/20 p-3 outline-none focus-visible:ring-2 focus-visible:ring-foreground/20 md:grid-cols-3">
            @for (var ci = 0; ci < _navCells.Length; ci++)
            {
                var i = ci;
                var cell = _navCells[i];
                var isFocused = i == _focusedIndex;
                var isSelected = i == _selectedIndex;
                <button
                    id="@($"cell-{cell.Id}")"
                    type="button"
                    role="gridcell"
                    aria-selected="@isSelected.ToString().ToLower()"
                    @onclick="@(() => SelectCell(i))"
                    class="relative flex min-h-[144px] flex-col justify-between rounded-xl bg-card p-4 text-left transition-colors hover:bg-card/80">

                    @* Focus ring *@
                    @if (isFocused)
                    {
                        <div class="pointer-events-none absolute inset-0 rounded-xl border-2 border-foreground"></div>
                    }

                    <div class="flex items-start justify-between">
                        <span class="flex size-8 items-center justify-center rounded-md border bg-background">
                            <LucideIconCn Name="@cell.IconName" Size="16" Class="size-4 text-foreground" />
                        </span>
                        <div class="flex items-center gap-0.5">
                            @foreach (var mod in cell.Modifiers)
                            {
                                var m = mod;
                                <span class="flex h-5 min-w-5 items-center justify-center rounded border bg-background px-1 font-mono text-[10px] text-muted-foreground">
                                    @m
                                </span>
                            }
                        </div>
                    </div>

                    <div>
                        <div class="text-sm font-medium text-foreground">@cell.Label</div>
                        <div class="mt-0.5 font-mono text-[10px] text-muted-foreground">
                            @cell.Shortcut
                        </div>
                    </div>

                    @if (isSelected)
                    {
                        <span class="absolute right-2 top-2 flex size-5 items-center justify-center rounded-full bg-foreground text-background">
                            <LucideIconCn Name="corner-down-left" Size="10" Class="size-2.5" />
                        </span>
                    }
                </button>
            }
        </div>

        @* Hint + detail strip *@
        <div class="mt-3 flex items-center justify-between px-1">
            <span class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground">
                @(_hasInteracted ? $"Focused · {_navCells[_focusedIndex].Label}" : "Click the grid, then press arrow keys")
            </span>
            <span class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground">
                Selected · @_navCells[_selectedIndex].Label
            </span>
        </div>

        @* Detail strip *@
        @{
            var selected = _navCells[_selectedIndex];
        }
        <div class="mt-4 flex flex-col gap-4 rounded-xl border bg-card p-5 sm:flex-row sm:items-center sm:gap-6">
            <div class="flex size-12 items-center justify-center rounded-lg border bg-muted/40">
                <LucideIconCn Name="@selected.IconName" Size="20" Class="size-5 text-foreground" />
            </div>
            <div class="flex-1">
                <div class="flex items-center gap-2">
                    <h3 class="text-sm font-medium text-foreground">@selected.Label</h3>
                    <span class="font-mono text-[10px] text-muted-foreground">
                        @selected.Shortcut
                    </span>
                </div>
                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                    @selected.Description
                </p>
            </div>
            <div class="flex items-center gap-1 border-t pt-3 sm:border-l sm:border-t-0 sm:pl-5 sm:pt-0">
                @foreach (var mod in selected.Modifiers)
                {
                    var m = mod;
                    <span class="flex h-6 min-w-6 items-center justify-center rounded border bg-background px-1.5 font-mono text-xs text-foreground">
                        @m
                    </span>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record NavCell(string Id, string IconName, string Label, string Shortcut, string Description, string[] Modifiers);

    private static readonly NavCell[] _navCells =
    [
        new("navigate", "mouse-pointer-2", "Navigate", "G then H",
            "Jump to any page, file, or section with a pair of keystrokes. Remembers your five most recent destinations.",
            ["G", "H"]),
        new("search", "search", "Search", "/",
            "Full-text fuzzy search across every resource in your workspace. Supports filters, scopes, and history.",
            ["/"]),
        new("command", "command", "Command", "⌘ K",
            "Open the command palette from anywhere. Actions register themselves, so every feature is keyboard-reachable.",
            ["⌘", "K"]),
        new("edit", "pencil", "Edit", "E",
            "Enter inline edit mode on the focused item without reaching for the mouse. Esc returns without saving.",
            ["E"]),
        new("share", "share-2", "Share", "⌘ ⇧ S",
            "Copy a share link, assign a role, or open the invite dialog from a single three-key combination.",
            ["⌘", "⇧", "S"]),
        new("select", "square-dashed-mouse-pointer", "Select", "X",
            "Toggle multi-select on any list. Tap X repeatedly to extend the selection without holding a modifier.",
            ["X"]),
    ];

    private static readonly string[] _indicatorKeys = ["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Enter"];

    private static readonly Dictionary<string, string> _keyIcons = new()
    {
        ["ArrowUp"] = "↑",
        ["ArrowDown"] = "↓",
        ["ArrowLeft"] = "←",
        ["ArrowRight"] = "→",
        ["Enter"] = "↵",
        ["Escape"] = "Esc",
    };

    private int _focusedIndex = 0;
    private int _selectedIndex = 0;
    private string? _lastKey = null;
    private bool _hasInteracted = false;
    private CancellationTokenSource? _keyCts;

    private const int Columns = 3;

    private void SelectCell(int index)
    {
        _focusedIndex = index;
        _selectedIndex = index;
        _hasInteracted = true;
    }

    private void OnGridFocus()
    {
        _hasInteracted = true;
    }

    private void MoveFocus(int rowDelta, int colDelta)
    {
        var currentRow = _focusedIndex / Columns;
        var currentCol = _focusedIndex % Columns;
        var nextRow = ((currentRow + rowDelta) % 2 + 2) % 2;
        var nextCol = ((currentCol + colDelta) % Columns + Columns) % Columns;
        _focusedIndex = nextRow * Columns + nextCol;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        var keyHandled = true;
        switch (e.Key)
        {
            case "ArrowUp":
                SetLastKey("ArrowUp");
                MoveFocus(-1, 0);
                break;
            case "ArrowDown":
                SetLastKey("ArrowDown");
                MoveFocus(1, 0);
                break;
            case "ArrowLeft":
                SetLastKey("ArrowLeft");
                MoveFocus(0, -1);
                break;
            case "ArrowRight":
                SetLastKey("ArrowRight");
                MoveFocus(0, 1);
                break;
            case "Enter":
                SetLastKey("Enter");
                _selectedIndex = _focusedIndex;
                _hasInteracted = true;
                break;
            case "Home":
                _focusedIndex = 0;
                break;
            case "End":
                _focusedIndex = _navCells.Length - 1;
                break;
            default:
                keyHandled = false;
                break;
        }
        if (!_hasInteracted) _hasInteracted = true;
        if (keyHandled)
        {
            await Task.CompletedTask;
        }
    }

    private void SetLastKey(string key)
    {
        _lastKey = key;
        _keyCts?.Cancel();
        _keyCts = new CancellationTokenSource();
        var cts = _keyCts;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(1200, cts.Token);
                _lastKey = null;
                await InvokeAsync(StateHasChanged);
            }
            catch (TaskCanceledException) { }
        });
    }
}
