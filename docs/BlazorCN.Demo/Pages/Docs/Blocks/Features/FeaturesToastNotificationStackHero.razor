@* ============================================================
   Block: features-toast-notification-stack-hero
   Title: FeaturesToastNotificationStackHero
   Description: A split hero features section for React and Next.js with a headline cluster beside a layered stack of five offset toast notification cards each showing status icon, title, description, timestamp, and dismiss button, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-toast-notification-stack-hero.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-10">

        @* Left: headline cluster *@
        <div>
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Notifications
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Reach the right eyes the moment something happens.
            </h2>
            <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                A realtime notification stack your customers will actually read — with delivery
                receipts, auto-dismiss, and the context your team needs to act.
            </p>
            <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
                <ButtonCn Class="w-full sm:w-[200px]">Start sending</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[170px]">
                    View docs
                </ButtonCn>
            </div>
        </div>

        @* Right: layered toast stack *@
        <div class="relative mx-auto h-[440px] w-full max-w-sm lg:mx-0">
            @foreach (var toast in _toasts)
            {
                var meta = GetMeta(toast.Status);
                var i = _toasts.IndexOf(toast);
                var offset = i * 18;
                var scale = 1.0 - i * 0.035;
                var zIndex = _toasts.Count - i;
                var isTop = i == 0;
                <article
                    aria-label="@($"{toast.Status} notification: {toast.Title}")"
                    style="@($"position:absolute;inset-inline:0;top:0;z-index:{zIndex};transform:translateY({offset}px) scale({scale.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)});transform-origin:top;opacity:{(1.0 - i * 0.08).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}")"
                    class="overflow-hidden rounded-xl border bg-card shadow-sm">
                    <div class="flex items-start gap-3 p-4">
                        <div class="@Cn.Merge("flex size-9 shrink-0 items-center justify-center rounded-lg", meta.RingClass)">
                            <LucideIconCn Name="@meta.IconName" Size="20" Class="@Cn.Merge("size-5", meta.IconClass)" aria-hidden="true" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-2">
                                <h3 class="truncate text-sm font-semibold text-foreground">
                                    @toast.Title
                                </h3>
                                <span class="shrink-0 text-[10px] tabular-nums text-muted-foreground">
                                    @toast.Timestamp
                                </span>
                            </div>
                            <p class="mt-1 truncate text-xs text-muted-foreground">
                                @toast.Description
                            </p>
                        </div>
                        <button
                            type="button"
                            aria-label="@($"Dismiss {toast.Title}")"
                            class="-m-1 shrink-0 rounded-md p-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                            <LucideIconCn Name="x" Size="14" Class="size-3.5" aria-hidden="true" />
                        </button>
                    </div>
                    @if (isTop)
                    {
                        <div aria-hidden="true" class="h-0.5 w-full bg-muted">
                            <div class="h-full w-[62%] bg-foreground"></div>
                        </div>
                    }
                </article>
            }
        </div>

    </div>
</section>

@code {
    private record ToastNotification(string Id, string Status, string Title, string Description, string Timestamp);
    private record StatusMeta(string IconName, string IconClass, string RingClass);

    private static readonly List<ToastNotification> _toasts =
    [
        new("deploy-success",   "success", "Deployment succeeded",    "api-gateway v2.14.0 is live in eu-west-1",   "just now"),
        new("new-signup",       "info",    "New workspace created",   "acme-labs joined on the Team plan",          "2m ago"),
        new("quota-warning",    "warning", "Approaching rate limit",  "Project atlas at 82% of monthly quota",      "6m ago"),
        new("build-failure",    "error",   "Build failed on main",    "3 type errors in packages/ui/button.tsx",    "12m ago"),
        new("comment-mention",  "info",    "You were mentioned",      "Priya left a review on PR #482",             "21m ago"),
    ];

    private static StatusMeta GetMeta(string status) => status switch
    {
        "success" => new("circle-check-big", "text-emerald-600 dark:text-emerald-500", "bg-emerald-500/10"),
        "info"    => new("info",             "text-blue-600 dark:text-blue-500",       "bg-blue-500/10"),
        "warning" => new("triangle-alert",   "text-amber-600 dark:text-amber-500",     "bg-amber-500/10"),
        "error"   => new("x-circle",         "text-red-600 dark:text-red-500",         "bg-red-500/10"),
        _         => new("info",             "text-muted-foreground",                  "bg-muted"),
    };
}
