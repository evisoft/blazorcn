@* ============================================================
   Block: features-tree-hierarchy
   Title: Features Tree Hierarchy
   Description: Nested tree of features with expandable categories and indented sub-features
   Dependencies: LucideChevronRightCn
   Source: original/blocks/features/features-tree-hierarchy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Feature Hierarchy</h2>
            <p class="mt-1 text-xs text-muted-foreground">Expandable tree of capabilities</p>
        </div>

        <div class="divide-y divide-border/40">
            @foreach (var node in _featureTree)
            {
                @RenderTreeNode(node, 0)
            }
        </div>
    </div>
</section>

@code {
    private class FeatureNode
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public FeatureNode[]? Children { get; set; }
    }

    private HashSet<string> _expandedCategories = [];

    private void ToggleCategory(string id)
    {
        if (!_expandedCategories.Remove(id)) _expandedCategories.Add(id);
    }

    private RenderFragment RenderTreeNode(FeatureNode node, int level) => __builder =>
    {
        var hasChildren = node.Children is { Length: > 0 };
        var isExpanded = _expandedCategories.Contains(node.Id);

        <button type="button"
                class="@Cn.Merge("flex w-full items-start gap-2 px-4 py-2.5 text-left transition-colors", hasChildren ? "hover:bg-muted/50" : "cursor-default")"
                style="padding-left: @(level * 16 + 16)px"
                @onclick="@(() => { if (hasChildren) ToggleCategory(node.Id); })">
            @if (hasChildren)
            {
                <LucideChevronRightCn Class="@Cn.Merge("mt-0.5 h-4 w-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" Size="16" />
            }
            else
            {
                <span class="h-4 w-4 shrink-0"></span>
            }
            <div class="min-w-0 flex-1">
                <div class="@Cn.Merge("text-sm", hasChildren ? "font-medium" : "")">@node.Name</div>
                @if (node.Description != null)
                {
                    <div class="mt-0.5 text-xs text-muted-foreground">@node.Description</div>
                }
            </div>
        </button>

        @if (hasChildren && isExpanded)
        {
            @foreach (var child in node.Children!)
            {
                @RenderTreeNode(child, level + 1)
            }
        }
    };

    private static readonly FeatureNode[] _featureTree =
    [
        new()
        {
            Id = "collaboration", Name = "Collaboration",
            Children =
            [
                new() { Id = "real-time-editing", Name = "Real-time Editing", Description = "Multi-user simultaneous editing" },
                new() { Id = "comments", Name = "Comments & Mentions", Description = "In-line discussion threads" },
                new() { Id = "presence", Name = "Presence Indicators", Description = "See who's viewing and editing" },
            ],
        },
        new()
        {
            Id = "security", Name = "Security",
            Children =
            [
                new()
                {
                    Id = "authentication", Name = "Authentication",
                    Children =
                    [
                        new() { Id = "sso", Name = "Single Sign-On", Description = "SAML 2.0 and OAuth 2.0" },
                        new() { Id = "mfa", Name = "Multi-Factor Auth", Description = "TOTP and SMS verification" },
                    ],
                },
                new() { Id = "encryption", Name = "Encryption", Description = "AES-256 at rest and in transit" },
            ],
        },
        new()
        {
            Id = "integrations", Name = "Integrations",
            Children =
            [
                new() { Id = "slack", Name = "Slack", Description = "Notifications and commands" },
                new() { Id = "github", Name = "GitHub", Description = "Repository sync and webhooks" },
                new() { Id = "zapier", Name = "Zapier", Description = "1000+ app connections" },
            ],
        },
    ];
}
