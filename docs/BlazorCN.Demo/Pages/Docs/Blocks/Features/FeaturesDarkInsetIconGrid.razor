@* ============================================================
   Block: features-dark-inset-icon-grid
   Title: FeaturesDarkInsetIconGrid
   Description: A dark inset icon grid features section for React and Next.js with a light outer card wrapping a dramatic dark inset panel that holds a centered headline and a six-item 2x3 icon grid built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-dark-inset-icon-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="rounded-2xl border bg-card p-6 sm:p-8 lg:p-12">
    @* Dark inset panel *@
    <div class="rounded-2xl bg-foreground p-8 text-background sm:p-10 lg:p-14">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-background/60">
          @_headline.Eyebrow
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-background sm:text-4xl">
          @_headline.Title
        </h2>
        <p class="mt-4 text-base leading-relaxed text-background/60">@_headline.Subtitle</p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-10 lg:grid-cols-3">
        @foreach (var feature in _features)
        {
          <div>
            <span aria-hidden="true" class="flex size-10 items-center justify-center rounded-lg bg-background/10">
              <LucideIconCn Name="@feature.Icon" Size="20" Class="size-5 text-background" />
            </span>
            <h3 class="mt-4 text-base font-semibold text-background">@feature.Title</h3>
            <p class="mt-2 text-sm leading-relaxed text-background/60">
              @feature.Description
            </p>
          </div>
        }
      </div>
    </div>
  </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureItem(string Id, string Icon, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        "The platform",
        "Everything you need to ship in production",
        "Six capabilities that power the fastest teams. Built for developers who measure success in deploys per day, not planning meetings per week."
    );

    private static readonly FeatureItem[] _features =
    [
        new("edge-runtime", "zap", "Edge Runtime",
            "Deploy code to 18 global regions with sub-50ms cold starts and zero vendor lock-in on the runtime layer."),
        new("zero-config", "cloud-lightning", "Zero-config deploy",
            "Connect a Git repository and ship in under a minute. No YAML, no Dockerfiles, no infrastructure tickets."),
        new("realtime-collab", "users", "Real-time collaboration",
            "Multiplayer editing on every preview URL so designers, PMs, and engineers converge on a single source of truth."),
        new("git-native", "git-branch", "Git-native workflows",
            "Every branch becomes a preview environment with isolated databases, secrets, and feature flags out of the box."),
        new("global-network", "globe", "Global edge network",
            "A 280-city anycast network delivers assets from the closest PoP with automatic failover across regions."),
        new("soc2-ready", "shield-check", "SOC 2 Type II ready",
            "SAML SSO, SCIM provisioning, audit logs, and encryption at rest included on every paid plan with no enterprise surcharge."),
    ];
}
