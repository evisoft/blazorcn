@* ============================================================
   Block: features-periodic-table-element-grid
   Title: FeaturesPeriodicTableElementGrid
   Description: A periodic table element grid features section for React and Next.js with atomic number corners, oversized two-letter symbols, and asymmetric row offsets built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-periodic-table-element-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div>
    @* Headline cluster *@
    <div class="text-center">
      <p class="font-mono text-xs font-medium uppercase tracking-[0.25em] text-muted-foreground">
        The elements
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Eight primitives. One periodic system.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
        Every capability in the platform has an atomic number, a two-letter symbol, and a
        predictable place in the table — so engineers learn once and compose forever.
      </p>
    </div>

    @* Periodic table grid *@
    <div class="mt-12 grid grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-3 lg:grid-cols-8">
      @foreach (var element in _elements)
      {
        var figureClass = Cn.Merge(
          "group relative flex aspect-square flex-col justify-between rounded-md border-2 bg-card p-3 transition-colors hover:bg-muted/40 sm:p-4 lg:aspect-auto lg:min-h-[140px]",
          GetCategoryAccent(element.Category),
          "lg:" + element.GridClass
        );
        <figure id="@($"element-{element.Id}")" class="@figureClass">
          @* Top row: atomic number + icon *@
          <div class="flex items-start justify-between">
            <span class="font-mono text-[10px] font-medium tabular-nums text-muted-foreground">
              @element.AtomicNumber
            </span>
            <LucideIconCn Name="@element.IconName" Size="12" Class="size-3 text-muted-foreground/60" aria-hidden="true" />
          </div>

          @* Oversized symbol *@
          <div class="flex flex-1 items-center justify-center">
            <span aria-hidden="true" class="font-serif text-4xl font-semibold leading-none tracking-tight text-foreground sm:text-5xl">
              @element.Symbol
            </span>
          </div>

          @* Bottom: name + mass *@
          <figcaption class="flex flex-col items-center text-center">
            <h3 class="text-[11px] font-medium leading-tight text-foreground">
              @element.Name
            </h3>
            <span class="mt-0.5 font-mono text-[9px] tabular-nums text-muted-foreground">
              @element.AtomicMass
            </span>
          </figcaption>
        </figure>
      }
    </div>

    @* Legend *@
    <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 border-t pt-6">
      @foreach (var entry in _categoryLabels)
      {
        var cat = entry.Key;
        <div class="flex items-center gap-2">
          <span aria-hidden="true" class="@(Cn.Merge("size-3 rounded-sm border-2", GetCategoryAccent(cat)))"></span>
          <span class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
            @entry.Value
          </span>
        </div>
      }
    </div>

    @* CTA pair *@
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <ButtonCn Class="w-full sm:w-[250px]">Read the datasheet</ButtonCn>
      <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">Browse the SDK</ButtonCn>
    </div>
  </div>
</section>

@code {
    private record PeriodicElement(
        string Id,
        string AtomicNumber,
        string Symbol,
        string Name,
        string AtomicMass,
        string Category,
        string IconName,
        string GridClass
    );

    private static readonly PeriodicElement[] _elements =
    [
        new("globetrotter", "01", "Gt", "Globetrotter", "4.210", "core",  "atom",                "col-start-1 row-start-1"),
        new("scaler",       "02", "Sc", "Scaler",       "2.804", "core",  "zap",                 "col-start-2 row-start-1"),
        new("relay",        "03", "Rl", "Relay",        "6.117", "edge",  "magnet",              "col-start-7 row-start-1"),
        new("sentinel",     "04", "Sv", "Sentinel",     "1.918", "data",  "beaker",              "col-start-8 row-start-1"),
        new("ledger",       "05", "Ld", "Ledger",       "3.441", "data",  "dna",                 "col-start-1 row-start-2"),
        new("meridian",     "06", "Me", "Meridian",     "5.203", "core",  "microscope",          "col-start-3 row-start-2 col-span-2"),
        new("fulcrum",      "07", "Fc", "Fulcrum",      "2.007", "experiment", "flask-conical",  "col-start-6 row-start-2 col-span-2"),
        new("tractor",      "08", "Tr", "Tractor",      "7.882", "edge",  "test-tube-diagonal",  "col-start-8 row-start-2"),
    ];

    private static readonly (string Key, string Value)[] _categoryLabels =
    [
        ("core",       "Core"),
        ("data",       "Data"),
        ("edge",       "Edge"),
        ("experiment", "Experiment"),
    ];

    private static string GetCategoryAccent(string category) => category switch
    {
        "core"       => "border-foreground/60",
        "data"       => "border-foreground/30",
        "edge"       => "border-dashed border-foreground/40",
        "experiment" => "border-foreground/15",
        _            => "",
    };
}
