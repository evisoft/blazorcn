@* ============================================================
   Block: features-gauge-cluster-dashboard-row
   Title: FeaturesGaugeClusterDashboardRow
   Description: A dashboard-inspired features section for React and Next.js with a row of three semicircular SVG gauges, tick marks, and needle indicators visualizing capability metrics, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-gauge-cluster-dashboard-row.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div>
    @* Header *@
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Platform telemetry
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Live readings from the systems that run your product.
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        Three instruments your SRE team already checks every morning — now surfaced on the same
        page that closes deals.
      </p>
    </div>

    @* Gauge row *@
    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
      @foreach (var gauge in _gauges)
      {
        var dial = BuildDial(gauge.Value);
        <div class="rounded-xl border bg-card p-6">
          @* Title row *@
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <LucideIconCn Name="@gauge.IconName" Size="16" Class="size-4 text-muted-foreground" />
              <h3 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">
                @gauge.Title
              </h3>
            </div>
            <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
              Live
            </span>
          </div>

          @* Gauge dial *@
          <div class="mt-4">
            <svg
              aria-hidden="true"
              width="100%"
              height="@dial.SvgHeight"
              viewBox="@dial.ViewBox"
              class="block"
            >
              @* Background arc *@
              <path
                d="@dial.ArcPath"
                fill="none"
                stroke-width="10"
                stroke-linecap="round"
                class="stroke-muted"
              />
              @* Filled arc *@
              <path
                d="@dial.ArcPath"
                fill="none"
                stroke-width="10"
                stroke-linecap="round"
                stroke-dasharray="@dial.FilledDashArray"
                class="stroke-foreground"
              />
              @* Tick marks *@
              @foreach (var tick in dial.Ticks)
              {
                <line
                  x1="@tick.X1"
                  y1="@tick.Y1"
                  x2="@tick.X2"
                  y2="@tick.Y2"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  class="stroke-muted-foreground/50"
                />
              }
              @* Needle *@
              <line
                x1="@dial.Cx"
                y1="@dial.Cy"
                x2="@dial.NeedleX"
                y2="@dial.NeedleY"
                stroke-width="3"
                stroke-linecap="round"
                class="stroke-foreground"
              />
              @* Needle pivot *@
              <circle cx="@dial.Cx" cy="@dial.Cy" r="7" class="fill-background stroke-foreground" stroke-width="2" />
              <circle cx="@dial.Cx" cy="@dial.Cy" r="2.5" class="fill-foreground" />
            </svg>
          </div>

          @* Readout *@
          <div class="-mt-6 text-center">
            <div class="flex items-baseline justify-center gap-1.5">
              <span class="text-4xl font-bold tabular-nums tracking-tight">
                @gauge.Display
              </span>
              <span class="text-xs font-medium text-muted-foreground">@gauge.Unit</span>
            </div>
          </div>

          @* Description *@
          <p class="mt-4 text-center text-xs leading-relaxed text-muted-foreground">
            @gauge.Description
          </p>
        </div>
      }
    </div>

    @* CTA pair *@
    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <ButtonCn Class="w-full sm:w-[240px]">View live metrics</ButtonCn>
      <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">Read the report</ButtonCn>
    </div>
  </div>
</section>

@code {
    private record GaugeMetric(
        string Id,
        int Value,
        string Display,
        string Unit,
        string Title,
        string Description,
        string IconName
    );

    private record TickData(string X1, string Y1, string X2, string Y2);

    private record DialData(
        string SvgHeight,
        string ViewBox,
        string ArcPath,
        string FilledDashArray,
        string Cx,
        string Cy,
        string NeedleX,
        string NeedleY,
        TickData[] Ticks
    );

    private static readonly GaugeMetric[] _gauges =
    [
        new("throughput", 82, "4.2M", "req/min", "Throughput",
            "Sustained request volume across the global edge network with zero queue backpressure.",
            "gauge"),
        new("efficiency", 94, "94", "score", "Efficiency",
            "Compute-to-output ratio benchmarked against industry baselines for similar workloads.",
            "activity"),
        new("reliability", 99, "99.99", "% uptime", "Reliability",
            "Rolling 90-day availability measured from external probes in 38 regions worldwide.",
            "shield-check"),
    ];

    private static DialData BuildDial(int value)
    {
        const double size = 200;
        const double stroke = 10;
        const double cx = size / 2;
        const double cy = size / 2 + 20;
        const double radius = 80;
        const double startAngle = 180;
        const double endAngle = 0;
        const double sweep = startAngle - endAngle;
        double arcLength = Math.PI * radius * sweep / 180;
        double filledLength = (value / 100.0) * arcLength;

        double needleAngle = 180 - (value / 100.0) * 180;
        double needleRad = needleAngle * Math.PI / 180;
        double needleLength = radius - 6;
        double needleX = cx + needleLength * Math.Cos(needleRad);
        double needleY = cy - needleLength * Math.Sin(needleRad);

        const int tickCount = 11;
        var ticks = new TickData[tickCount];
        for (int i = 0; i < tickCount; i++)
        {
            double angle = 180 - (i / (double)(tickCount - 1)) * 180;
            double rad = angle * Math.PI / 180;
            double inner = radius + 6;
            double outer = radius + 14;
            ticks[i] = new TickData(
                F(cx + inner * Math.Cos(rad)),
                F(cy - inner * Math.Sin(rad)),
                F(cx + outer * Math.Cos(rad)),
                F(cy - outer * Math.Sin(rad))
            );
        }

        double startX = cx + radius * Math.Cos(startAngle * Math.PI / 180);
        double startY = cy - radius * Math.Sin(startAngle * Math.PI / 180);
        double endX = cx + radius * Math.Cos(endAngle * Math.PI / 180);
        double endY = cy - radius * Math.Sin(endAngle * Math.PI / 180);
        string arcPath = FormattableString.Invariant($"M {F(startX)} {F(startY)} A {F(radius)} {F(radius)} 0 0 1 {F(endX)} {F(endY)}");

        double svgHeight = size * 0.75;
        string viewBox = $"0 0 {F(size)} {F(size * 0.85)}";
        string filledDashArray = $"{F(filledLength)} {F(arcLength)}";

        return new DialData(
            F(svgHeight),
            viewBox,
            arcPath,
            filledDashArray,
            F(cx),
            F(cy),
            F(needleX),
            F(needleY),
            ticks
        );
    }

    private static string F(double v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
}
