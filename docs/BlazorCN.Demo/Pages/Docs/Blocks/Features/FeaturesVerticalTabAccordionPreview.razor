@* ============================================================
   Block: features-vertical-tab-accordion-preview
   Title: FeaturesVerticalTabAccordionPreview
   Description: A vertical tab tri-column feature section for React and Next.js with a left vertical tab rail, a middle shadcn/ui Accordion of feature items, and a right crosshair image preview built with Tailwind CSS
   Source: original/blocks/features/features-vertical-tab-accordion-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="rounded-2xl border bg-card p-6 sm:p-10">
    @* Headline *@
    <div class="mb-8 max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Capabilities
      </p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
        Navigate, expand, and preview in a single view
      </h2>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">
        Pick a category from the left rail, drill into a feature in the middle, and see what it
        looks like on the right — all without leaving the section.
      </p>
    </div>

    @* Tri-column layout *@
    <div class="grid gap-6 lg:grid-cols-[200px_1fr_1fr] lg:gap-8">
      @* Left — Vertical tab rail *@
      <div
        role="tablist"
        aria-label="Feature categories"
        class="flex gap-2 overflow-x-auto lg:flex-col lg:gap-1 lg:overflow-visible"
      >
        @foreach (var grp in _featureGroups)
        {
          var group = grp;
          var isActive = group.Id == _activeGroupId;
          <button
            type="button"
            role="tab"
            aria-selected="@(isActive ? "true" : "false")"
            @onclick="@(() => HandleGroupChange(group.Id))"
            class="@Cn.Merge(
              "flex shrink-0 items-center gap-2.5 rounded-lg px-3 py-2.5 text-left text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-ring lg:w-full",
              isActive
                ? "bg-muted text-foreground"
                : "text-muted-foreground hover:bg-muted/50 hover:text-foreground"
            )"
          >
            <LucideIconCn Name="@group.Icon" Size="16" Class="size-4 shrink-0" />
            <span>@group.Label</span>
          </button>
        }
      </div>

      @* Middle — Accordion *@
      <div class="min-w-0">
        @{
          var activeGroup = _featureGroups.FirstOrDefault(g => g.Id == _activeGroupId) ?? _featureGroups[0];
        }
        <div class="divide-y divide-border/60">
          @foreach (var feat in activeGroup.Features)
          {
            var feature = feat;
            var isOpen = feature.Id == _activeFeatureId;
            <div class="border-b-0">
              <h3 class="flex">
                <button
                  type="button"
                  class="group flex flex-1 items-start justify-between py-3 text-left text-sm font-semibold transition-all outline-none focus-visible:ring-2 focus-visible:ring-ring sm:text-base"
                  aria-expanded="@(isOpen ? "true" : "false")"
                  @onclick="@(() => ToggleFeature(feature.Id))"
                >
                  @feature.Title
                  @if (isOpen)
                  {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-muted-foreground" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
                  }
                  else
                  {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-muted-foreground" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                  }
                </button>
              </h3>
              @if (isOpen)
              {
                <div class="overflow-hidden pb-4">
                  <p class="text-sm leading-relaxed text-muted-foreground">
                    @feature.Description
                  </p>
                  <ul class="mt-3 space-y-1.5">
                    @foreach (var bullet in feature.Bullets)
                    {
                      <li class="flex items-start gap-2 text-xs text-muted-foreground">
                        <span
                          aria-hidden="true"
                          class="mt-1.5 size-1 shrink-0 rounded-full bg-foreground/30"
                        />
                        <span>@bullet</span>
                      </li>
                    }
                  </ul>
                </div>
              }
            </div>
          }
        </div>
      </div>

      @* Right — Crosshair preview *@
      <div class="min-w-0">
        <div class="flex aspect-[4/3] w-full items-center justify-center rounded-xl bg-muted">
          <div class="relative flex items-center justify-center">
            <div class="absolute size-24 rounded-full border border-muted-foreground/[0.06]" />
            <div class="absolute size-14 rounded-full border border-muted-foreground/[0.08]" />
            <div class="absolute h-px w-32 bg-muted-foreground/[0.06]" />
            <div class="absolute h-32 w-px bg-muted-foreground/[0.06]" />
            <div class="flex size-8 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
              <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
            </div>
          </div>
        </div>
        <div class="mt-3 flex items-center gap-2">
          <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-muted-foreground/60" />
          <p class="text-xs text-muted-foreground">Preview updates with each selection</p>
        </div>
      </div>
    </div>
  </div>
</section>

@code {
    private string _activeGroupId = "workspace";
    private string _activeFeatureId = "ws-multi";

    private void HandleGroupChange(string groupId)
    {
        var nextGroup = _featureGroups.FirstOrDefault(g => g.Id == groupId);
        if (nextGroup is null) return;
        _activeGroupId = groupId;
        _activeFeatureId = nextGroup.Features[0].Id;
    }

    private void ToggleFeature(string featureId)
    {
        if (_activeFeatureId == featureId) return;
        _activeFeatureId = featureId;
    }

    private record FeatureItem(string Id, string Title, string Description, string[] Bullets);
    private record FeatureGroup(string Id, string Label, string Icon, FeatureItem[] Features);

    private static readonly FeatureGroup[] _featureGroups =
    [
        new FeatureGroup("workspace", "Workspace", "layers",
        [
            new FeatureItem("ws-multi", "Multi-workspace context",
                "Switch between unlimited workspaces with isolated data, members, and billing while keeping a single sign-on session.",
                ["Per-workspace member roles", "Isolated billing and invoices", "Cross-workspace global search"]),
            new FeatureItem("ws-templates", "Starter templates",
                "Spin up a new workspace from a curated template gallery tuned for engineering, design, marketing, and ops teams.",
                ["60+ curated templates", "One-click clone with sample data", "Custom team template library"]),
            new FeatureItem("ws-import", "Bulk importers",
                "Move existing content from Notion, Confluence, or Google Docs with a guided wizard that preserves structure and history.",
                ["Guided mapping per field", "Preserves folder hierarchy", "Dry-run before commit"]),
        ]),
        new FeatureGroup("collab", "Collaboration", "users",
        [
            new FeatureItem("collab-live", "Live co-editing",
                "Every keystroke is synchronized through a CRDT engine that resolves conflicts without ever losing a keystroke.",
                ["Sub-40ms presence cursors", "Typing and selection indicators", "Offline edits replay on reconnect"]),
            new FeatureItem("collab-review", "Anchored review threads",
                "Drop inline comments that follow content as it moves. Threads resolve, reopen, and archive with searchable history.",
                ["Anchored to content blocks", "Slack notifications on mention", "Searchable thread archive"]),
            new FeatureItem("collab-share", "Granular share links",
                "Share view or edit access with links that expire, require passwords, or restrict to SSO domains without creating user accounts.",
                ["Password-protected links", "SSO domain allowlist", "Per-link analytics and revocation"]),
        ]),
        new FeatureGroup("automation", "Automation", "zap",
        [
            new FeatureItem("auto-flows", "Visual flow builder",
                "Drag triggers, conditions, and actions onto a canvas to automate repetitive work without writing a single line of code.",
                ["200+ triggers and actions", "Branching conditional logic", "Sandbox test runs"]),
            new FeatureItem("auto-cron", "Scheduled runs",
                "Run any workflow on a schedule defined in cron or natural-language phrases with timezone-aware execution.",
                ["Cron and natural-language syntax", "Timezone awareness", "Retry policies with backoff"]),
            new FeatureItem("auto-webhooks", "Webhook relays",
                "Transform and forward webhook payloads between systems with inline JavaScript expressions and signed requests.",
                ["Inline JS transformers", "Rotating signing secrets", "Replay failed deliveries"]),
        ]),
        new FeatureGroup("insights", "Insights", "bar-chart-3",
        [
            new FeatureItem("ins-dash", "Embedded dashboards",
                "Build charts against any table with SQL or a point-and-click query builder and embed them directly into workspace pages.",
                ["SQL and visual query modes", "Real-time refresh intervals", "Embed in any page or doc"]),
            new FeatureItem("ins-alerts", "Threshold alerts",
                "Trigger notifications when a metric crosses a threshold, delivered to Slack, email, or PagerDuty without extra tooling.",
                ["Multi-channel delivery", "Anomaly detection", "Snooze and acknowledge flow"]),
            new FeatureItem("ins-export", "Scheduled exports",
                "Push raw query results to S3, BigQuery, or Snowflake on a schedule so downstream pipelines always have fresh data.",
                ["S3, BigQuery, Snowflake sinks", "Cron-based scheduling", "Partial row retries"]),
        ]),
        new FeatureGroup("governance", "Governance", "shield-check",
        [
            new FeatureItem("gov-rbac", "Field-level RBAC",
                "Permission controls reach all the way down to individual fields with custom roles that inherit from workspace templates.",
                ["Field-level permissions", "Role inheritance", "Okta and SCIM group sync"]),
            new FeatureItem("gov-audit", "Immutable audit log",
                "Every action is captured with actor, timestamp, IP, and before/after state in an append-only ledger for compliance reporting.",
                ["Append-only ledger", "CSV and JSON export", "Stream to Splunk or Datadog"]),
            new FeatureItem("gov-residency", "Regional data residency",
                "Pin workspace data to US, EU, or APAC regions to satisfy GDPR, CCPA, and local compliance requirements.",
                ["US, EU, and APAC regions", "Region-locked backups", "Contract addendum available"]),
        ]),
    ];
}
