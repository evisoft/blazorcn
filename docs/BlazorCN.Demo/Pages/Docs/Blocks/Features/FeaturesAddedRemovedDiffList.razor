@* ============================================================
   Block: features-added-removed-diff-list
   Title: FeaturesAddedRemovedDiffList
   Description: A diff viewer features section for React and Next.js pairing removed and added rows inside a filename-labelled code frame with commit metadata footer built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-added-removed-diff-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                The upgrade
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The whole platform, in one diff.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                No migration matrix, no multi-week rewrite. Every improvement lands as a single-line
                swap in your config &mdash; here&apos;s exactly what changes.
            </p>
        </div>

        @* Diff viewer frame *@
        <div class="mx-auto mt-10 max-w-3xl overflow-hidden rounded-xl border bg-card shadow-sm">
            @* Filename tab header *@
            <div class="flex items-center gap-2 border-b bg-muted/40 px-4 py-2.5">
                <LucideIconCn Name="file-code-2" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" aria-hidden="true" />
                <span class="font-mono text-xs text-foreground">@_filename</span>
                <span aria-hidden="true" class="ml-auto flex items-center gap-1.5 text-[10px] font-medium text-muted-foreground">
                    <span class="flex items-center gap-0.5 tabular-nums">
                        <LucideIconCn Name="plus" Size="10" Class="size-2.5" />
                        @_insertions
                    </span>
                    <span class="flex items-center gap-0.5 tabular-nums">
                        <LucideIconCn Name="minus" Size="10" Class="size-2.5" />
                        @_deletions
                    </span>
                </span>
            </div>

            @* Diff hunks *@
            <ul class="divide-y">
                @foreach (var hunk in _diffHunks)
                {
                    var index = Array.IndexOf(_diffHunks, hunk);
                    <li>
                        <article aria-label="@($"Change {index + 1}: {hunk.Caption}")" class="flex flex-col">
                            @* Removed row *@
                            <div class="flex items-start gap-3 bg-muted/20 px-4 py-1.5">
                                <span aria-hidden="true" class="w-8 shrink-0 text-right font-mono text-[10px] tabular-nums text-muted-foreground/60">
                                    @hunk.Line
                                </span>
                                <span aria-hidden="true" class="w-3 shrink-0 text-center font-mono text-xs text-muted-foreground">
                                    -
                                </span>
                                <span class="min-w-0 flex-1 break-all font-mono text-xs text-muted-foreground line-through decoration-muted-foreground/40">
                                    @hunk.Removed
                                </span>
                            </div>
                            @* Added row *@
                            <div class="flex items-start gap-3 px-4 py-1.5">
                                <span aria-hidden="true" class="w-8 shrink-0 text-right font-mono text-[10px] tabular-nums text-muted-foreground/60">
                                    @hunk.Line
                                </span>
                                <span aria-hidden="true" class="w-3 shrink-0 text-center font-mono text-xs font-semibold text-foreground">
                                    +
                                </span>
                                <span class="min-w-0 flex-1 break-all font-mono text-xs font-semibold text-foreground">
                                    @hunk.Added
                                </span>
                            </div>
                            @* Caption *@
                            <div class="flex items-start gap-3 px-4 pb-3 pt-1">
                                <span aria-hidden="true" class="w-8 shrink-0"></span>
                                <span aria-hidden="true" class="w-3 shrink-0"></span>
                                <span class="text-[11px] leading-relaxed text-muted-foreground">
                                    @hunk.Caption
                                </span>
                            </div>
                        </article>
                    </li>
                }
            </ul>

            @* Commit metadata footer *@
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t bg-muted/30 px-4 py-3 text-[11px] text-muted-foreground">
                <span class="flex items-center gap-1.5 font-mono">
                    <LucideIconCn Name="git-commit-horizontal" Size="12" Class="size-3" aria-hidden="true" />
                    <span class="text-foreground">a1b4c9f</span>
                    upgrade: move platform to v3
                </span>
                <span class="ml-auto flex items-center gap-3">
                    <span class="tabular-nums">
                        <span class="font-semibold text-foreground">@_insertions</span> insertions
                    </span>
                    <span class="tabular-nums">
                        <span class="font-semibold text-foreground">@_deletions</span> deletions
                    </span>
                    <span class="tabular-nums">
                        <span class="font-semibold text-foreground">1</span> file
                    </span>
                </span>
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[200px]">Start upgrade</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[250px]">Read release notes</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record DiffHunk(string Id, int Line, string Removed, string Added, string Caption);

    private const string _filename = "app/platform/config.ts";

    private static readonly DiffHunk[] _diffHunks =
    [
        new("cache", 12, "cache: { layer: 'memory', ttl: 60 }", "cache: { layer: 'edge', ttl: 3600, swr: true }", "Edge cache replaces in-memory"),
        new("regions", 18, "regions: ['us-east-1']", "regions: ['global'], // 34 cities, auto-routed", "One region becomes the whole planet"),
        new("observability", 24, "logs: { level: 'info' }", "observability: { logs, metrics, traces, profiling }", "Logs become full observability"),
        new("deploys", 31, "deploy: { strategy: 'rolling' }", "deploy: { strategy: 'blue-green', rollback: 'instant' }", "Rolling deploys become instant rollback"),
        new("security", 38, "auth: { provider: 'password' }", "auth: { provider: 'sso', mfa: 'required', audit: true }", "Passwords become SSO + MFA + audit log"),
        new("scaling", 45, "scale: { min: 1, max: 4 }", "scale: { min: 0, max: Infinity, coldStart: '< 80ms' }", "Fixed capacity becomes scale-to-zero"),
    ];

    private static readonly int _insertions = _diffHunks.Length;
    private static readonly int _deletions = _diffHunks.Length;
}
