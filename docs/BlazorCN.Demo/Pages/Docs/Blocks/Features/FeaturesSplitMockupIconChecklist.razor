@* ============================================================
   Block: features-split-mockup-icon-checklist
   Title: FeaturesSplitMockupIconChecklist
   Description: A split mockup icon checklist features section for React and Next.js with a large square crosshair image placeholder on the left and an eyebrow headline subtitle icon row list and dual CTA row on the right built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-split-mockup-icon-checklist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">

        @* Left — crosshair image placeholder *@
        <div class="order-2 lg:order-1">
            <div class="flex aspect-square w-full items-center justify-center rounded-2xl border bg-muted">
                <div class="relative flex items-center justify-center">
                    <div aria-hidden="true" class="absolute size-52 rounded-full border border-muted-foreground/[0.06]"></div>
                    <div aria-hidden="true" class="absolute size-32 rounded-full border border-muted-foreground/[0.08]"></div>
                    <div aria-hidden="true" class="absolute h-px w-64 bg-muted-foreground/[0.06]"></div>
                    <div aria-hidden="true" class="absolute h-64 w-px bg-muted-foreground/[0.06]"></div>
                    <div class="flex size-12 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                        <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/40" />
                    </div>
                </div>
            </div>
        </div>

        @* Right — eyebrow, headline, subtitle, feature rows, CTA *@
        <div class="order-1 lg:order-2">
            <span class="inline-flex items-center rounded-full border bg-muted/50 px-2.5 py-1 text-[11px] font-medium text-foreground">
                @_headline.Eyebrow
            </span>
            <h2 class="mt-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
                @_headline.Title
            </h2>
            <p class="mt-5 max-w-lg text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>

            @* Feature mini-rows *@
            <ul class="mt-8 space-y-5">
                @foreach (var feature in _features)
                {
                    <li class="flex items-start gap-3.5">
                        <span aria-hidden="true" class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-muted">
                            <LucideIconCn Name="@feature.Icon" Size="16" Class="size-4 text-muted-foreground" />
                        </span>
                        <div class="min-w-0 flex-1">
                            <h3 class="text-base font-semibold text-foreground">@feature.Title</h3>
                            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">@feature.Description</p>
                        </div>
                    </li>
                }
            </ul>

            @* CTA row *@
            <div class="mt-10 flex flex-col gap-3 sm:flex-row">
                <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[170px]">Learn more</ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureRow(string Id, string Title, string Description, string Icon);

    private static readonly HeadlineData _headline = new(
        "Built for teams",
        "A single workspace that ships with you",
        "Replace the patchwork of standalone tools with one workspace that handles planning, shipping, and review without asking anyone to context-switch."
    );

    private static readonly FeatureRow[] _features =
    [
        new("planning", "Unified planning canvas", "Specs, roadmaps, and issues live on the same surface your team already reviews.", "layers"),
        new("workflows", "Automations that run themselves", "Branch, merge, and approve without leaving the issue you opened five minutes ago.", "workflow"),
        new("performance", "Sub-50ms interactions", "Local-first data keeps the interface responsive even on a spotty hotel Wi-Fi.", "gauge"),
        new("security", "Enterprise security by default", "SAML SSO, SCIM, audit logs, and signed webhooks shipped on every paid plan.", "shield-check"),
    ];
}
