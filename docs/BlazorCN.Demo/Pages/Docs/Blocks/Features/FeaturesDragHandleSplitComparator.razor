@* ============================================================
   Block: features-drag-handle-split-comparator
   Title: FeaturesDragHandleSplitComparator
   Description: A drag handle split comparator features section for React and Next.js with a draggable vertical divider revealing traditional versus modern panels and a synced before-after metric table built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-drag-handle-split-comparator.tsx
   ============================================================ *@

@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="flex flex-col gap-5 md:flex-row md:flex-wrap md:items-end md:justify-between">
            <div class="max-w-xl">
                <div class="flex items-center gap-2">
                    <span class="flex size-6 items-center justify-center rounded-md border bg-background">
                        <LucideIconCn Name="arrow-right" aria-hidden="true" Size="12" Class="size-3 text-muted-foreground" />
                    </span>
                    <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        From legacy to turbo
                    </span>
                </div>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                    Drag to see the difference.
                </h2>
                <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                    Grab the divider and wipe between the old pipeline and the new one. Both mockups stay
                    live on screen so the trade-off speaks for itself.
                </p>
            </div>
            <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:items-center">
                <ButtonCn Class="w-full sm:w-[480px]" Variant="ButtonVariant.Ghost" @onclick="@(() => _splitPercent = 50)">
                    Reset
                </ButtonCn>
                <ButtonCn Class="w-full sm:w-[300px]">
                    Read the migration guide
                </ButtonCn>
            </div>
        </div>

        @* Split comparator *@
        <div class="mt-10 overflow-hidden rounded-xl border bg-card">
            <div
                @ref="_trackRef"
                role="group"
                aria-label="Drag comparator between traditional and modern pipeline"
                class="relative h-[300px] w-full touch-none select-none overflow-hidden">

                @* Left (legacy) panel *@
                <div
                    role="group"
                    aria-label="Traditional pipeline"
                    class="absolute inset-y-0 left-0 overflow-hidden bg-red-500/[0.03]"
                    style="@($"width:{_splitPercent}%")">
                    <div class="absolute inset-y-0 left-0 w-[360px]">
                        @* Legacy Mockup *@
                        <div class="flex h-full flex-col">
                            <div class="flex items-center gap-1.5 border-b border-border/60 bg-background/60 px-3 py-2">
                                <span class="size-1.5 rounded-full bg-red-500/70"></span>
                                <span class="size-1.5 rounded-full bg-amber-500/70"></span>
                                <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                                <span class="ml-2 font-mono text-[9px] text-muted-foreground">legacy-ci.log</span>
                            </div>
                            <div class="flex flex-1 flex-col divide-y divide-border/60">
                                @foreach (var row in _legacyRows)
                                {
                                    var r = row;
                                    <div class="flex items-center justify-between px-4 py-2.5">
                                        <div class="flex items-center gap-2">
                                            @if (r.Status == "manual")
                                            {
                                                <LucideIconCn Name="triangle-alert" aria-hidden="true" Size="12" Class="size-3 text-amber-500" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="x-circle" aria-hidden="true" Size="12" Class="size-3 text-red-500" />
                                            }
                                            <span class="whitespace-nowrap text-[11px] text-foreground/80">@r.Label</span>
                                        </div>
                                        <span class="whitespace-nowrap font-mono text-[11px] text-red-600 tabular-nums dark:text-red-400">
                                            @r.Value
                                        </span>
                                    </div>
                                }
                            </div>
                            <div class="border-t border-border/60 bg-red-500/5 px-4 py-2">
                                <div class="flex items-center justify-between">
                                    <span class="text-[10px] font-medium uppercase tracking-wider text-red-600 dark:text-red-400">
                                        Total pipeline
                                    </span>
                                    <span class="font-mono text-xs font-semibold text-red-600 tabular-nums dark:text-red-400">
                                        11m 09s
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="pointer-events-none absolute left-3 top-3">
                        <span class="inline-flex items-center gap-1 rounded-full border border-red-500/20 bg-background/80 px-2 py-0.5 font-mono text-[9px] font-medium uppercase tracking-wider text-red-600 backdrop-blur dark:text-red-400">
                            <LucideIconCn Name="clock" aria-hidden="true" Size="10" Class="size-2.5" />
                            Traditional
                        </span>
                    </div>
                </div>

                @* Right (modern) panel *@
                <div
                    role="group"
                    aria-label="Modern pipeline"
                    class="absolute inset-y-0 right-0 overflow-hidden bg-emerald-500/[0.03]"
                    style="@($"width:{100 - _splitPercent}%")">
                    <div class="absolute inset-y-0 right-0 w-[360px]">
                        @* Modern Mockup *@
                        <div class="flex h-full flex-col">
                            <div class="flex items-center gap-1.5 border-b border-border/60 bg-background/60 px-3 py-2">
                                <span class="size-1.5 rounded-full bg-emerald-500/70"></span>
                                <span class="size-1.5 rounded-full bg-emerald-500/70"></span>
                                <span class="size-1.5 rounded-full bg-emerald-500/70"></span>
                                <span class="ml-2 font-mono text-[9px] text-muted-foreground">turbo-ci.log</span>
                            </div>
                            <div class="flex flex-1 flex-col divide-y divide-border/60">
                                @foreach (var row in _modernRows)
                                {
                                    var r = row;
                                    <div class="flex items-center justify-between px-4 py-2.5">
                                        <div class="flex items-center gap-2">
                                            @if (r.Status == "auto")
                                            {
                                                <LucideIconCn Name="zap" aria-hidden="true" Size="12" Class="size-3 text-emerald-500" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="check-circle-2" aria-hidden="true" Size="12" Class="size-3 text-emerald-500" />
                                            }
                                            <span class="whitespace-nowrap text-[11px] text-foreground/80">@r.Label</span>
                                        </div>
                                        <span class="whitespace-nowrap font-mono text-[11px] text-emerald-600 tabular-nums dark:text-emerald-400">
                                            @r.Value
                                        </span>
                                    </div>
                                }
                            </div>
                            <div class="border-t border-border/60 bg-emerald-500/5 px-4 py-2">
                                <div class="flex items-center justify-between">
                                    <span class="text-[10px] font-medium uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                                        Total pipeline
                                    </span>
                                    <span class="font-mono text-xs font-semibold text-emerald-600 tabular-nums dark:text-emerald-400">
                                        24.2s
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="pointer-events-none absolute right-3 top-3">
                        <span class="inline-flex items-center gap-1 rounded-full border border-emerald-500/20 bg-background/80 px-2 py-0.5 font-mono text-[9px] font-medium uppercase tracking-wider text-emerald-600 backdrop-blur dark:text-emerald-400">
                            <LucideIconCn Name="rocket" aria-hidden="true" Size="10" Class="size-2.5" />
                            Modern
                        </span>
                    </div>
                </div>

                @* Divider line *@
                <div
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-y-0 z-10 w-px bg-border"
                    style="@($"left:{_splitPercent}%")">
                </div>

                @* Drag handle *@
                <button
                    type="button"
                    role="slider"
                    tabindex="0"
                    aria-label="Split position between traditional and modern pipeline"
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow="@((int)Math.Round(_splitPercent))"
                    @onpointerdown="HandlePointerDown"
                    @onpointermove="HandlePointerMove"
                    @onpointerup="HandlePointerUp"
                    @onpointercancel="HandlePointerUp"
                    @onkeydown="HandleKeyDown"
                    style="@($"left:calc({_splitPercent}% - 14px)")"
                    class="group absolute top-0 z-20 flex h-full w-7 cursor-col-resize touch-none items-center justify-center focus:outline-none">
                    <div class="@Cn.Merge("relative flex h-10 w-6 items-center justify-center rounded-full border bg-background shadow-sm transition-transform group-focus-visible:ring-2 group-focus-visible:ring-foreground/30", _isDragging ? "scale-110" : "group-hover:scale-110")">
                        <LucideIconCn Name="grip-vertical" aria-hidden="true" Size="12" Class="size-3 text-foreground" />
                    </div>
                </button>
            </div>

            @* Comparison table *@
            <div class="border-t">
                <div class="grid grid-cols-[1fr_auto_auto_auto] items-center gap-x-4 border-b bg-muted/30 px-5 py-2.5 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    <span>Metric</span>
                    <span class="text-right">Before</span>
                    <span class="text-right">After</span>
                    <span class="text-right">Change</span>
                </div>
                <ul>
                    @foreach (var row in _comparison)
                    {
                        var r = row;
                        <li class="grid grid-cols-[1fr_auto_auto_auto] items-center gap-x-4 border-b px-5 py-3 last:border-b-0 hover:bg-muted/30">
                            <span class="text-sm text-foreground">@r.Metric</span>
                            <span class="text-right font-mono text-xs text-red-600 line-through tabular-nums dark:text-red-400">
                                @r.Before
                            </span>
                            <span class="text-right font-mono text-sm font-medium text-foreground tabular-nums">
                                @r.After
                            </span>
                            <span class="@Cn.Merge("text-right font-mono text-xs font-medium tabular-nums", r.DeltaTone == "positive" ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                @r.Delta
                            </span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* Footer readout *@
        <div class="mt-5 flex flex-col gap-3 rounded-lg border bg-muted/30 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" aria-hidden="true" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs text-muted-foreground">
                    Data from 412 production migrations (rolling 90 days)
                </span>
            </div>
            <div class="flex items-center gap-3 font-mono text-[11px] text-muted-foreground tabular-nums">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-red-500/70"></span>
                    Legacy @((int)Math.Round(_splitPercent))%
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Modern @((int)Math.Round(100 - _splitPercent))%
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private double _splitPercent = 50;
    private bool _isDragging = false;
    private ElementReference _trackRef;
    private double _trackLeft = 0;
    private double _trackWidth = 1;

    private record PanelRow(string Label, string Value, string Status);
    private record ComparisonRow(string Metric, string Before, string After, string Delta, string DeltaTone);

    private static readonly PanelRow[] _legacyRows =
    [
        new("Install deps",    "3m 42s",  "slow"),
        new("Build bundle",    "5m 18s",  "slow"),
        new("Run test suite",  "2m 09s",  "slow"),
        new("Deploy preview",  "Manual",  "manual"),
        new("Rollback window", "14 mins", "slow"),
    ];

    private static readonly PanelRow[] _modernRows =
    [
        new("Install deps",    "0.8s",      "instant"),
        new("Build bundle",    "11.2s",     "instant"),
        new("Run test suite",  "7.4s",      "instant"),
        new("Deploy preview",  "Automatic", "auto"),
        new("Rollback window", "Instant",   "instant"),
    ];

    private static readonly ComparisonRow[] _comparison =
    [
        new("Cold build time",            "5m 18s", "11.2s",  "28x faster",  "positive"),
        new("Preview deploy latency",     "4m 02s", "6s",     "40x faster",  "positive"),
        new("Failed deploys per week",    "11.4",   "0.3",    "97% fewer",   "positive"),
        new("Mean time to recovery",      "24 min", "42s",    "34x faster",  "positive"),
        new("Bundle size",                "3.8 MB", "612 KB", "84% smaller", "positive"),
        new("Lighthouse performance",     "54",     "98",     "+44 points",  "positive"),
    ];

    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./demo.js");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }

    private async Task HandlePointerDown(PointerEventArgs e)
    {
        _isDragging = true;
        try
        {
            if (_module is not null)
            {
                var rect = await _module.InvokeAsync<BoundingRect>("blazorcnGetBoundingRect", _trackRef);
                _trackLeft = rect.Left;
                _trackWidth = rect.Width > 0 ? rect.Width : 1;
            }
            UpdateSplit(e.ClientX);
        }
        catch
        {
            // fallback: keep current split
        }
    }

    private void HandlePointerMove(PointerEventArgs e)
    {
        if (!_isDragging) return;
        UpdateSplit(e.ClientX);
    }

    private void HandlePointerUp(PointerEventArgs e)
    {
        _isDragging = false;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowRight":
                _splitPercent = Math.Max(4, Math.Min(96, _splitPercent + 5));
                break;
            case "ArrowLeft":
                _splitPercent = Math.Max(4, Math.Min(96, _splitPercent - 5));
                break;
            case "PageUp":
                _splitPercent = Math.Max(4, Math.Min(96, _splitPercent + 20));
                break;
            case "PageDown":
                _splitPercent = Math.Max(4, Math.Min(96, _splitPercent - 20));
                break;
        }
    }

    private void UpdateSplit(double clientX)
    {
        var relativeX = clientX - _trackLeft;
        _splitPercent = Math.Max(4, Math.Min(96, (relativeX / _trackWidth) * 100));
    }

    private sealed class BoundingRect
    {
        [System.Text.Json.Serialization.JsonPropertyName("left")]   public double Left   { get; init; }
        [System.Text.Json.Serialization.JsonPropertyName("top")]    public double Top    { get; init; }
        [System.Text.Json.Serialization.JsonPropertyName("right")]  public double Right  { get; init; }
        [System.Text.Json.Serialization.JsonPropertyName("bottom")] public double Bottom { get; init; }
        [System.Text.Json.Serialization.JsonPropertyName("width")]  public double Width  { get; init; }
        [System.Text.Json.Serialization.JsonPropertyName("height")] public double Height { get; init; }
    }
}
