@* ============================================================
   Block: features-dark-inset-split-mockup
   Title: FeaturesDarkInsetSplitMockup
   Description: A dark inset split feature section for React and Next.js with an inverted bg-foreground panel containing a left headline and CheckIcon bullet list plus a right browser-chrome product mockup built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-dark-inset-split-mockup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="rounded-2xl border bg-card p-6 sm:p-10">

    @* Dark inset *@
    <div class="overflow-hidden rounded-xl bg-foreground text-background">
      <div class="grid gap-10 p-8 sm:p-12 lg:grid-cols-[5fr_6fr] lg:gap-12 lg:p-14">

        @* Left — headline + bullets + CTAs *@
        <div>
          <p class="text-xs font-medium uppercase tracking-widest text-background/40">
            @_headline.Eyebrow
          </p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-background sm:text-4xl">
            @_headline.Title
          </h2>
          <p class="mt-5 max-w-md text-base leading-relaxed text-background/60">
            @_headline.Subtitle
          </p>

          <ul class="mt-7 space-y-3">
            @foreach (var bullet in _bullets)
            {
              <li class="flex items-start gap-3">
                <span aria-hidden="true" class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-background/10">
                  <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-400" />
                </span>
                <span class="text-sm leading-relaxed text-background/80">@bullet</span>
              </li>
            }
          </ul>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <ButtonCn Class="w-full sm:w-[180px] bg-background text-foreground hover:bg-background/90">
              Get started
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px] border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background">
              Read the docs
            </ButtonCn>
          </div>
        </div>

        @* Right — browser chrome mockup *@
        <div aria-hidden="true" class="overflow-hidden rounded-xl border border-background/10 bg-background/[0.04]">

          @* Chrome strip *@
          <div class="flex h-9 items-center gap-2 border-b border-background/10 bg-background/[0.06] px-3">
            <div class="flex items-center gap-1.5">
              <span class="size-2.5 rounded-full bg-background/20"></span>
              <span class="size-2.5 rounded-full bg-background/15"></span>
              <span class="size-2.5 rounded-full bg-background/10"></span>
            </div>
            <div class="ml-2 flex h-5 flex-1 items-center gap-1.5 rounded-md border border-background/10 bg-background/[0.04] px-2">
              <LucideIconCn Name="layers" Size="10" Class="size-2.5 text-background/40" />
              <span class="font-mono text-[10px] text-background/50">app.acme.dev/deploys</span>
            </div>
            <div class="ml-auto flex items-center gap-1.5">
              <span class="size-1.5 rounded-full bg-emerald-400"></span>
              <span class="font-mono text-[10px] text-background/50">live</span>
            </div>
          </div>

          @* Mockup body *@
          <div class="space-y-4 p-5">

            @* Summary row *@
            <div class="flex items-center justify-between">
              <div class="space-y-1.5">
                <div class="h-1.5 w-24 rounded-full bg-background/15"></div>
                <div class="h-1 w-16 rounded-full bg-background/10"></div>
              </div>
              <div class="flex items-center gap-1.5 rounded-md border border-background/10 bg-background/[0.04] px-2 py-1">
                <span class="size-1.5 rounded-full bg-emerald-400"></span>
                <span class="font-mono text-[9px] text-background/60">healthy</span>
              </div>
            </div>

            @* Chart *@
            <div class="rounded-lg border border-background/10 bg-background/[0.04] p-3">
              <div class="mb-2 flex items-center justify-between">
                <div class="h-1 w-20 rounded-full bg-background/10"></div>
                <div class="flex gap-1.5">
                  <span class="h-1 w-6 rounded-full bg-background/15"></span>
                  <span class="h-1 w-4 rounded-full bg-background/10"></span>
                </div>
              </div>
              <div class="flex h-20 items-end gap-1.5">
                @foreach (var height in _chartBars)
                {
                  <div class="flex-1 rounded-sm bg-background/25" style="@($"height:{height}%")"></div>
                }
              </div>
            </div>

            @* Skeleton rows *@
            <div class="space-y-2">
              @foreach (var row in _skeletonRowIds)
              {
                <div class="flex items-center gap-3 rounded-md border border-background/10 bg-background/[0.03] px-3 py-2">
                  <span class="size-1.5 rounded-full bg-emerald-400"></span>
                  <div class="h-1 flex-1 rounded-full bg-background/10"></div>
                  <div class="h-1 w-10 rounded-full bg-background/15"></div>
                  <div class="h-1 w-6 rounded-full bg-background/10"></div>
                </div>
              }
            </div>

          </div>
        </div>

      </div>
    </div>

  </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);

    private static readonly HeadlineData _headline = new(
        "Under the hood",
        "Ship production-grade infrastructure in an afternoon",
        "One binary, one config file, zero YAML walls. The runtime takes care of rollouts, secrets, and edge caching so your team can focus on the product instead of the plumbing."
    );

    private static readonly string[] _bullets =
    [
        "Atomic rollouts with automatic canary and instant rollback",
        "Global edge network with sub-50ms p95 from 34 regions",
        "Scoped secrets, audit logs, and SSO on every paid plan",
    ];

    private static readonly int[] _chartBars = [42, 68, 55, 81, 73, 92, 64, 48];

    private static readonly string[] _skeletonRowIds = ["deploy-prod", "deploy-preview", "deploy-edge"];
}
