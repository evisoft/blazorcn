@* ============================================================
   Block: features-roadmap-kanban-columns
   Title: FeaturesRoadmapKanbanColumns
   Description: A roadmap kanban columns features section for React and Next.js with three status columns for shipped in progress and planned work colored status dots feature cards with tags progress bars and lock icons and a suggest a feature CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-roadmap-kanban-columns.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Header *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                The roadmap
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                What's shipped, building, and on the horizon
            </h2>
            <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                A transparent view of where the product is today and where it's heading. Every milestone is public so you know exactly what to expect before you commit.
            </p>
        </div>

        @* Kanban columns *@
        <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-3">
            @foreach (var col in _columns)
            {
                var column = col;
                var style = GetStatusStyle(column.Id);
                <div class="rounded-2xl border bg-muted/30 p-4">
                    <div class="flex items-center justify-between px-1 pb-3">
                        <div class="flex items-center gap-2">
                            <span aria-hidden="true" class="@($"size-2 rounded-full ring-4 {style.Dot} {style.Ring}")"></span>
                            <h3 class="@($"text-sm font-semibold {style.Label}")">@column.Label</h3>
                        </div>
                        <span class="rounded-full bg-background px-2 py-0.5 font-mono text-[10px] font-semibold tabular-nums text-muted-foreground">
                            @column.Items.Length
                        </span>
                    </div>
                    <div class="space-y-3">
                        @foreach (var crd in column.Items)
                        {
                            var card = crd;
                            <div class="rounded-xl border bg-card p-4">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex size-7 shrink-0 items-center justify-center rounded-md bg-muted">
                                        @if (column.Id == "shipped")
                                        {
                                            <LucideIconCn Name="check" Size="14" Class="size-3.5 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                                        }
                                        else if (column.Id == "planned")
                                        {
                                            <LucideIconCn Name="lock" Size="14" Class="size-3.5 text-muted-foreground" aria-hidden="true" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="zap" Size="14" Class="size-3.5 text-muted-foreground" aria-hidden="true" />
                                        }
                                    </div>
                                    <span class="inline-flex items-center rounded-full border bg-muted/50 px-2 py-0.5 font-mono text-[10px] font-medium text-muted-foreground">
                                        @card.Tag
                                    </span>
                                </div>
                                <h4 class="mt-3 text-sm font-semibold leading-snug text-foreground">@card.Title</h4>
                                <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">@card.Description</p>

                                @if (column.Id == "in-progress" && card.Progress.HasValue)
                                {
                                    <div class="mt-3.5">
                                        <div class="flex items-center justify-between text-[10px] font-medium text-muted-foreground">
                                            <span>Progress</span>
                                            <span class="tabular-nums">@(card.Progress)%</span>
                                        </div>
                                        <div class="mt-1 h-1 w-full overflow-hidden rounded-full bg-muted">
                                            <div class="h-full rounded-full bg-amber-500" style="@($"width:{card.Progress}%")"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t pt-8 sm:flex-row">
            <a href="#suggest" class="group inline-flex items-center gap-1.5 text-sm font-medium text-foreground">
                Suggest a feature for the backlog
                <LucideIconCn Name="chevron-right" Size="16" Class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
            </a>
            <ButtonCn Class="w-full sm:w-[240px]">View full roadmap</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StatusStyle(string Dot, string Ring, string Label);

    private record RoadmapCard(string Id, string Title, string Description, string Tag, int? Progress = null);

    private record RoadmapColumn(string Id, string Label, RoadmapCard[] Items);

    private static StatusStyle GetStatusStyle(string id) => id switch
    {
        "shipped" => new StatusStyle("bg-emerald-500", "ring-emerald-500/20", "text-foreground"),
        "in-progress" => new StatusStyle("bg-amber-500", "ring-amber-500/20", "text-foreground"),
        _ => new StatusStyle("bg-muted-foreground/40", "ring-muted-foreground/10", "text-foreground"),
    };

    private static readonly RoadmapColumn[] _columns =
    [
        new("shipped", "Shipped",
        [
            new("command-palette", "Global command palette",
                "Fuzzy search every action, doc, and board from a single keyboard shortcut.",
                "v2.0"),
            new("realtime-sync", "Real-time multi-device sync",
                "Local-first data layer keeps every tab and device in lockstep under 50ms.",
                "v1.9"),
            new("api-v2", "Public REST and GraphQL API",
                "Build integrations and automations on top of documented, versioned endpoints.",
                "v1.8"),
            new("sso-scim", "SSO and SCIM provisioning",
                "SAML 2.0 and automated user provisioning on every paid plan with no surcharge.",
                "v1.7"),
        ]),
        new("in-progress", "In Progress",
        [
            new("ai-assistant", "Inline AI writing assistant",
                "Context-aware suggestions that draft, summarize, and rewrite inside any document.",
                "beta", 72),
            new("mobile-apps", "Native iOS and Android apps",
                "Offline-capable native clients with push notifications and biometric unlock.",
                "v2.1", 48),
            new("automations", "Visual automation builder",
                "No-code workflow engine with triggers, conditions, and multi-step branching.",
                "alpha", 24),
        ]),
        new("planned", "Planned",
        [
            new("whiteboard", "Collaborative whiteboard",
                "Infinite canvas with sticky notes, shapes, and live cursors for async brainstorming.",
                "Q3 2026"),
            new("analytics", "Workspace analytics dashboard",
                "Team velocity charts, cycle time, and engagement metrics in one unified view.",
                "Q4 2026"),
            new("marketplace", "Third-party app marketplace",
                "Install and publish extensions built by the community with revenue share baked in.",
                "2027"),
        ]),
    ];
}
