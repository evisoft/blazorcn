@* ============================================================
   Block: features-zigzag-screenshot-rows
   Title: FeaturesZigzagScreenshotRows
   Description: A zigzag screenshot rows features section for React and Next.js with four alternating hero-scale crosshair image placeholders, eyebrow pills, and CheckIcon benefit lists built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-zigzag-screenshot-rows.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 sm:py-14 lg:py-16">
        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                What you get
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
                Four flagship capabilities, one connected workspace
            </h2>
            <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every row is a hero-scale visual paired with the proof points that matter, so visitors
                can scan and dive into the features that fit their workflow.
            </p>
        </div>

        @* Zigzag rows *@
        <div class="mt-14 space-y-16 sm:mt-20 sm:space-y-20">
            @foreach (var row in _rows)
            {
                var isReversed = Array.IndexOf(_rows, row) % 2 == 1;
                <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
                    @* Text side *@
                    <div class="@(isReversed ? "lg:order-2" : "")">
                        <span class="inline-flex items-center rounded-full border bg-muted/50 px-3 py-1 text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                            @row.Eyebrow
                        </span>
                        <h3 class="mt-4 text-2xl font-semibold tracking-tight text-foreground sm:text-[28px]">
                            @row.Title
                        </h3>
                        <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                            @row.Description
                        </p>
                        <ul class="mt-6 space-y-3">
                            @foreach (var benefit in row.Benefits)
                            {
                                <li class="flex items-start gap-3 text-sm leading-relaxed text-foreground">
                                    <span aria-hidden="true" class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                        <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                    </span>
                                    <span>@benefit</span>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Image side *@
                    <div class="@(isReversed ? "lg:order-1" : "")">
                        <div class="flex aspect-[3/2] w-full items-center justify-center rounded-xl bg-muted">
                            <div class="relative flex items-center justify-center">
                                <div aria-hidden="true" class="absolute size-28 rounded-full border border-muted-foreground/[0.08]"></div>
                                <div aria-hidden="true" class="absolute size-16 rounded-full border border-muted-foreground/[0.1]"></div>
                                <div aria-hidden="true" class="absolute h-px w-40 bg-muted-foreground/[0.08]"></div>
                                <div aria-hidden="true" class="absolute h-40 w-px bg-muted-foreground/[0.08]"></div>
                                <div class="flex size-10 items-center justify-center rounded-full border border-muted-foreground/[0.1] bg-background/60">
                                    <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/40" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FeatureRow(string Id, string Eyebrow, string Title, string Description, string[] Benefits);

    private static readonly FeatureRow[] _rows =
    [
        new(
            "workspace",
            "Workspace",
            "A single canvas for every artifact your team ships",
            "Bring docs, designs, tickets, and decisions into one live workspace so nothing gets lost across a dozen SaaS tools. Every object is searchable, linkable, and version-aware from the moment it is created.",
            [
                "Universal search across docs, boards, and files",
                "Backlinks and mentions stay live as you edit",
                "Version history with one-click restore",
            ]
        ),
        new(
            "automation",
            "Automation",
            "Automate the boring stuff without writing glue code",
            "Trigger workflows from any object change — a status flip, a new comment, a pull request merged — and route them through approvals, notifications, and third-party APIs with a visual builder that reads like plain English.",
            [
                "Visual triggers for any object or field change",
                "Approval chains with SLA timers",
                "Prebuilt actions for Slack, Linear, and GitHub",
            ]
        ),
        new(
            "insights",
            "Insights",
            "Dashboards that update the moment reality changes",
            "Build live dashboards on top of your workspace data with no extract, no warehouse, no stale nightly snapshots. Filter by team, project, or status and share read-only links that always reflect the current state.",
            [
                "Live queries over workspace data",
                "Drill-down filters on every chart",
                "Scheduled digests to email or Slack",
            ]
        ),
        new(
            "governance",
            "Governance",
            "Enterprise controls that ship enabled, not as an upsell",
            "SAML 2.0 single sign-on, SCIM provisioning, immutable audit logs, and field-level role permissions come standard on every paid plan. Define guardrails once and inherit them across workspaces, projects, and documents.",
