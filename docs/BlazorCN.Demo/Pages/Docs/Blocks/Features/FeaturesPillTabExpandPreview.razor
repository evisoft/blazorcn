@* ============================================================
   Block: features-pill-tab-expand-preview
   Title: FeaturesPillTabExpandPreview
   Description: A pill tab expandable accordion feature section for React and Next.js with a centered PillTabs category selector, a single full-width shadcn/ui Accordion, and inline crosshair preview panels rendered next to each expanded item built with Tailwind CSS
   Source: original/blocks/features/features-pill-tab-expand-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10">

        @* Headline *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                How it works
            </p>
            <h2 class="mx-auto mt-3 max-w-2xl text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
                Expand any capability to see how it fits your stack
            </h2>
            <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-muted-foreground">
                Pick a stage, open a feature, and get the explanation and a preview side by side without
                leaving the block.
            </p>
        </div>

        @* Centered pill tabs *@
        <div class="mt-8 flex justify-center">
            <div class="inline-flex items-center gap-1 rounded-full border bg-muted p-1" role="tablist" aria-label="Platform stages">
                @foreach (var tab in _tabs)
                {
                    var t = tab;
                    <button role="tab"
                            aria-selected="@(_activeTab == t ? "true" : "false")"
                            class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring", _activeTab == t ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => HandleTabChange(t))">
                        @_tabLabels[t]
                    </button>
                }
            </div>
        </div>

        @* Full-width accordion with inline previews *@
        <div class="mx-auto mt-10 max-w-4xl">
            <div class="divide-y divide-border/60">
                @foreach (var feat in _activeFeatures)
                {
                    var feature = feat;
                    var isOpen = _activeFeatureId == feature.Id;
                    <div class="border-b-0">
                        <button class="flex w-full items-center justify-between py-4 text-left text-base font-semibold hover:no-underline sm:text-lg"
                                aria-expanded="@(isOpen ? "true" : "false")"
                                @onclick="@(() => ToggleFeature(feature.Id))">
                            <span>@feature.Title</span>
                            <LucideIconCn Name="chevron-down" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground transition-transform duration-200", isOpen ? "rotate-180" : "")" />
                        </button>
                        @if (isOpen)
                        {
                            <div class="pb-5">
                                <div class="grid gap-5 sm:grid-cols-[1fr_200px] sm:items-start sm:gap-6">
                                    <div>
                                        <p class="text-sm leading-relaxed text-muted-foreground">
                                            @feature.Description
                                        </p>
                                        <ul class="mt-3 space-y-2">
                                            @foreach (var bullet in feature.Bullets)
                                            {
                                                <li class="flex items-start gap-2 text-xs text-muted-foreground">
                                                    <span aria-hidden="true" class="mt-1.5 size-1 shrink-0 rounded-full bg-foreground/30"></span>
                                                    <span>@bullet</span>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                    @* Inline crosshair mini preview *@
                                    <div aria-hidden="true" class="flex aspect-[4/3] w-full items-center justify-center rounded-lg bg-muted sm:w-[200px]">
                                        <div class="relative flex items-center justify-center">
                                            <div class="absolute size-16 rounded-full border border-muted-foreground/[0.06]"></div>
                                            <div class="absolute size-10 rounded-full border border-muted-foreground/[0.08]"></div>
                                            <div class="absolute h-px w-24 bg-muted-foreground/[0.06]"></div>
                                            <div class="absolute h-24 w-px bg-muted-foreground/[0.06]"></div>
                                            <div class="flex size-7 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                                                <LucideIconCn Name="image" Size="14" Class="size-3.5 text-muted-foreground/40" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private static readonly string[] _tabs = ["develop", "deploy", "monitor"];

    private static readonly Dictionary<string, string> _tabLabels = new()
    {
        ["develop"] = "Develop",
        ["deploy"] = "Deploy",
        ["monitor"] = "Monitor",
    };

    private record Feature(string Id, string Title, string Description, string[] Bullets);

    private static readonly Dictionary<string, Feature[]> _featureGroups = new()
    {
        ["develop"] =
        [
            new("dev-editor", "Unified code and prose editor",
                "Write documentation, design docs, and code snippets in the same surface with syntax highlighting that adapts to 80+ languages.",
                ["Inline code review and suggestions", "Syntax highlighting for 80+ languages", "Keyboard-first slash command palette"]),
            new("dev-branches", "Branch-scoped previews",
                "Every feature branch gets an isolated workspace where edits stay separate from main until a reviewer approves the merge.",
                ["Automatic preview per branch", "Reviewer approval before merge", "Clean branch teardown after merge"]),
            new("dev-sync", "Local-first sync",
                "Work offline with full-text search and then replay edits to the server when the network returns. Conflicts resolve via CRDT merge.",
                ["Offline full-text search", "CRDT-based conflict resolution", "Replay queue with progress indicator"]),
        ],
        ["deploy"] =
        [
            new("dep-preview", "Immutable preview URLs",
                "Each commit produces an immutable preview URL with deterministic builds so QA can verify exactly what production will receive.",
                ["Deterministic reproducible builds", "Immutable per-commit URLs", "Auto-teardown after 30 days"]),
            new("dep-rollback", "Five-second rollbacks",
                "Revert any deploy to a previous build in under five seconds. Traffic drains to the new target without dropping in-flight requests.",
                ["Sub-5s rollback trigger", "Zero dropped in-flight requests", "Audit trail for every rollback"]),
            new("dep-promote", "Environment promotion",
                "Promote an exact build artifact from staging to production with a single click and a signed approval audit entry.",
                ["Same-artifact promotion", "Signed approval audit trail", "Slack integration for approvals"]),
        ],
        ["monitor"] =
        [
            new("mon-logs", "Structured request logs",
                "Every request emits a structured log with trace ID, user context, and response timing that flows to your dashboards within 2 seconds.",
                ["Sub-2s log latency to dashboard", "Trace ID correlation across services", "Retention up to 30 days"]),
            new("mon-alerts", "Threshold-based alerts",
                "Configure alerts on any metric or log pattern with multi-channel delivery to Slack, PagerDuty, email, or webhooks of your choice.",
                ["Slack, PagerDuty, email, webhook", "Anomaly detection baseline", "Snooze and acknowledge workflow"]),
            new("mon-traces", "Distributed traces",
                "End-to-end tracing across services with OpenTelemetry compatibility and automatic span correlation for faster root cause analysis.",
                ["OpenTelemetry compatible", "Automatic span correlation", "Service dependency graph"]),
        ],
    };

    private string _activeTab = "develop";
    private string _activeFeatureId = "dev-editor";
    private Feature[] _activeFeatures = _featureGroups["develop"];

    private void HandleTabChange(string tab)
    {
        _activeTab = tab;
        _activeFeatures = _featureGroups[tab];
        _activeFeatureId = _activeFeatures[0].Id;
    }

    private void ToggleFeature(string id)
    {
        if (_activeFeatureId == id)
            return; // keep at least one open (non-collapsible single)
        _activeFeatureId = id;
    }
}
