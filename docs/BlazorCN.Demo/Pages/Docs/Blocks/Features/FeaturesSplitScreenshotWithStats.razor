@* ============================================================
   Block: features-split-screenshot-with-stats
   Title: FeaturesSplitScreenshotWithStats
   Description: A split features section for React and Next.js with a large crosshair screenshot placeholder, three floating stat cards overlaid at absolute positions, and a right-side headline, four feature rows, and CTA built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-split-screenshot-with-stats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">
        <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">

            @* Left — Screenshot placeholder with floating stats *@
            <div class="relative">
                <div aria-hidden="true"
                     class="flex aspect-[4/3] w-full items-center justify-center overflow-hidden rounded-xl border bg-muted">
                    <div class="relative flex items-center justify-center">
                        <div class="absolute size-24 rounded-full border border-muted-foreground/[0.06]"></div>
                        <div class="absolute size-14 rounded-full border border-muted-foreground/[0.08]"></div>
                        <div class="absolute h-px w-32 bg-muted-foreground/[0.06]"></div>
                        <div class="absolute h-32 w-px bg-muted-foreground/[0.06]"></div>
                        <div class="flex size-8 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
                        </div>
                    </div>
                </div>

                @* Floating stat cards *@
                @foreach (var stat in _stats)
                {
                    <div class="@($"absolute {stat.Position} rounded-lg border bg-card px-3 py-2 shadow-sm")">
                        <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">@stat.Label</p>
                        <p class="mt-0.5 text-sm font-semibold tabular-nums text-foreground">@stat.Value</p>
                    </div>
                }
            </div>

            @* Right — Headline + feature list + CTA *@
            <div>
                <div>
                    <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">@_headline.Eyebrow</p>
                    <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">@_headline.Title</h2>
                    <p class="mt-5 max-w-lg text-base leading-relaxed text-muted-foreground">@_headline.Subtitle</p>
                </div>

                <ul class="mt-8 space-y-5">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-start gap-3">
                            <span aria-hidden="true"
                                  class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                <LucideIconCn Name="check" Size="12" StrokeWidth="3" Class="size-3 text-emerald-600 dark:text-emerald-500" />
                            </span>
                            <div>
                                <h3 class="text-sm font-semibold text-foreground">@feature.Title</h3>
                                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">@feature.Description</p>
                            </div>
                        </li>
                    }
                </ul>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="w-full sm:w-[260px]">Review architecture</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[270px]">Download SOC 2 report</ButtonCn>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record Stat(string Id, string Label, string Value, string Position);
    private record Feature(string Id, string Title, string Description);
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);

    private static readonly HeadlineData _headline = new(
        "Built for reliability",
        "Infrastructure your auditors will sign off on",
        "A platform that treats uptime, latency, and compliance as first-class product requirements — not afterthoughts buried in a status page nobody checks."
    );

    private static readonly Stat[] _stats =
    [
        new("uptime",     "Uptime SLA",  "99.99%",       "top-4 left-4"),
        new("compliance", "Compliance",  "SOC 2 Type II", "top-4 right-4"),
        new("latency",    "p95 latency", "< 50ms",        "bottom-4 right-4"),
    ];

    private static readonly Feature[] _features =
    [
        new("multi-region",       "Multi-region failover",
            "Automatic regional failover with sub-second DNS swaps and zero-downtime read replicas across three geographies."),
        new("audit-trail",        "Immutable audit trail",
            "Every admin action is signed, appended to an append-only log, and exported nightly to your SIEM for retention."),
        new("encrypted-storage",  "Encrypted at rest and in flight",
            "AES-256 at rest with customer-managed keys, and TLS 1.3 everywhere else including internal service-to-service calls."),
        new("private-networking", "Private networking",
            "Deploy inside your VPC with private service connect, no public egress, and IP allowlists enforced at the edge."),
    ];
}
