@* ============================================================
   Block: features-use-case-scenarios
   Title: Features Use Case Scenarios
   Description: A features block showcasing capabilities grouped by use case scenarios for startups, enterprises, and agencies
   Dependencies: None
   Source: original/blocks/features/features-use-case-scenarios.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Features by Use Case</h2>
            <p class="mt-1 text-xs text-muted-foreground">Capabilities tailored for your needs</p>
        </div>

        @for (var si = 0; si < _scenarios.Length; si++)
        {
            var scenario = _scenarios[si];
            <div class="@(si < _scenarios.Length - 1 ? "border-b" : "")">
                <div class="px-4 py-3">
                    <h3 class="text-sm font-medium">@scenario.Title</h3>
                    <p class="mt-1 text-xs text-muted-foreground">@scenario.Description</p>
                </div>
                <div>
                    @for (var fi = 0; fi < scenario.Features.Length; fi++)
                    {
                        var feature = scenario.Features[fi];
                        <div class="@Cn.Merge("px-4 py-3", fi < scenario.Features.Length - 1 ? "border-b border-muted/50" : "")">
                            <div class="flex items-start gap-3">
                                <span class="mt-1 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium">@feature.Title</p>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@feature.Description</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Feature(string Title, string Description);
    private record Scenario(string Title, string Description, Feature[] Features);

    private static readonly Scenario[] _scenarios =
    [
        new("For Startups", "Fast, cost-effective features to launch and iterate quickly", [
            new("Rapid deployment pipeline", "Ship to production in minutes with automated CI/CD and preview environments for every pull request"),
            new("Usage-based pricing", "Pay only for what you use with granular metering and no minimum commitments or upfront costs"),
            new("Built-in analytics", "Track user behavior and conversion metrics without additional tooling or complex integrations"),
            new("Template library", "Start with production-ready templates for common use cases and customize as you grow"),
        ]),
        new("For Enterprise", "Enterprise-grade security, compliance, and scalability", [
            new("SSO and SAML integration", "Connect with your existing identity provider for centralized access control and user management"),
            new("SOC 2 Type II compliant", "Audited security controls and data protection practices that meet enterprise standards"),
            new("Dedicated infrastructure", "Isolated environments with guaranteed resources and custom SLAs for mission-critical workloads"),
            new("Advanced role permissions", "Fine-grained access control with custom roles, resource-level permissions, and audit logging"),
        ]),
        new("For Agencies", "Multi-client management with white-label capabilities", [
            new("Client workspaces", "Separate isolated environments for each client with independent billing and user management"),
            new("White-label options", "Custom branding, domains, and email templates to maintain your agency's identity"),
            new("Team collaboration", "Invite team members across projects with role-based access and activity tracking"),
            new("Bulk operations", "Manage multiple client accounts simultaneously with batch updates and unified reporting"),
        ]),
    ];
}
