@* ============================================================
   Block: features-layered-deck-shuffle-stack
   Title: FeaturesLayeredDeckShuffleStack
   Description: A layered deck shuffle stack features section for React and Next.js with a front active card, cascading peek cards offset behind it, click-to-promote animation, and a stacked progress dot rail built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-layered-deck-shuffle-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Headline cluster *@
    <div class="max-w-xl">
      <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
        Six in the hand
      </span>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Feature deck, one card up.
      </h2>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">
        Every feature is a card in the same hand. Promote any peek to the top — the rest slide
        back a step without losing their place.
      </p>
    </div>

    @* Deck container *@
    <div class="mt-12">
      <div class="relative h-[460px] w-full">
        @foreach (var cardItem in _cards)
        {
          var card = cardItem;
          var rel = GetRelativePosition(card.Index, _activeIndex, _cards.Length);
          var pos = _stackPositions[Math.Min(rel, _stackPositions.Length - 1)];
          var isFront = rel == 0;
          var zIdx = _cards.Length - rel;
          var filterStyle = pos.Blur > 0 ? $"blur({pos.Blur}px)" : "";
          var transformStyle = $"translateY({pos.Y}px) scale({pos.Scale.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)})";
          var cardStyle = $"position:absolute;inset-inline:0;bottom:0;height:360px;z-index:{zIdx};opacity:{pos.Opacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)};transform:{transformStyle};{(filterStyle != "" ? $"filter:{filterStyle};" : "")}transition:transform 0.35s cubic-bezier(0.34,1.56,0.64,1),opacity 0.35s ease,filter 0.35s ease;";
          <div
            class="overflow-hidden rounded-2xl border bg-card shadow-lg"
            style="@cardStyle"
          >
            @if (isFront)
            {
              @* Front card — full content *@
              <div class="flex h-full flex-col gap-5 p-6 md:flex-row md:gap-6 md:p-8">
                @* Copy column *@
                <div class="flex flex-1 flex-col">
                  <div class="flex items-center gap-2">
                    <span class="flex size-7 items-center justify-center rounded-md border bg-background">
                      <LucideIconCn Name="@card.IconName" Size="14" Class="size-3.5 text-foreground" aria-hidden="true" />
                    </span>
                    <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                      @card.Eyebrow
                    </span>
                  </div>
                  <h3 class="mt-4 text-xl font-semibold leading-tight text-foreground md:text-2xl">
                    @card.Title
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-muted-foreground">@card.Description</p>
                  <ul class="mt-5 space-y-2">
                    @foreach (var bullet in card.Bullets)
                    {
                      <li class="flex items-start gap-2 text-sm text-foreground">
                        <span class="mt-[7px] size-1 rounded-full bg-foreground/70"></span>
                        <span>@bullet</span>
                      </li>
                    }
                  </ul>
                  <div class="mt-auto flex items-end justify-between gap-4 pt-6">
                    <div>
                      <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        @card.MetricLabel
                      </div>
                      <div class="mt-1 font-mono text-2xl font-semibold text-foreground tabular-nums">
                        @card.MetricValue
                      </div>
                    </div>
                  </div>
                </div>

                @* Sample panel *@
                <div class="hidden w-[220px] shrink-0 md:block">
                  <div class="flex h-full flex-col overflow-hidden rounded-lg border bg-muted/40">
                    <div class="flex items-center justify-between border-b bg-background/50 px-3 py-2">
                      <span class="font-mono text-[9px] text-muted-foreground">@(card.Id).live</span>
                      <span class="flex items-center gap-1 text-[9px] text-emerald-600 dark:text-emerald-400">
                        <span class="size-1 rounded-full bg-emerald-500"></span>
                        live
                      </span>
                    </div>
                    <div class="flex flex-1 flex-col divide-y">
                      @foreach (var row in card.Sample)
                      {
                        <div class="flex items-center justify-between px-3 py-2.5">
                          <span class="font-mono text-[10px] text-muted-foreground">@row.Label</span>
                          <span class="font-mono text-xs font-medium text-foreground tabular-nums">
                            @row.Value
                          </span>
                        </div>
                      }
                    </div>
                    <div class="border-t bg-background/50 px-3 py-2">
                      <div class="flex items-center justify-between">
                        <span class="font-mono text-[9px] text-muted-foreground">updated</span>
                        <span class="font-mono text-[10px] text-foreground">2s ago</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            }
            else
            {
              @* Peek header — clickable to promote *@
              var capturedIndex = card.Index;
              <button
                type="button"
                @onclick="@(() => _activeIndex = capturedIndex)"
                aria-label="@($"Promote {card.Title} to front")"
                class="block w-full cursor-pointer text-left transition-colors hover:bg-muted/30"
              >
                <div class="flex items-center gap-2 px-6 py-4">
                  <span class="flex size-6 items-center justify-center rounded-md border bg-background">
                    <LucideIconCn Name="@card.IconName" Size="12" Class="size-3 text-muted-foreground" aria-hidden="true" />
                  </span>
                  <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    @card.Eyebrow
                  </span>
                  <span class="truncate text-xs font-medium text-foreground/70">@card.Title</span>
                  <span class="ml-auto font-mono text-[10px] text-muted-foreground tabular-nums">
                    +@rel
                  </span>
                </div>
              </button>
            }
          </div>
        }
      </div>
    </div>

    @* Controls row *@
    <div class="mt-8 flex flex-col gap-4 rounded-xl border bg-muted/30 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <div>
          <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
            On top
          </div>
          <div class="mt-0.5 text-sm font-medium text-foreground">
            @_cards[_activeIndex].Eyebrow
            @(" ")
            <span class="font-mono text-muted-foreground">
              @((_activeIndex + 1).ToString().PadLeft(2, '0'))/@(_cards.Length.ToString().PadLeft(2, '0'))
            </span>
          </div>
        </div>
      </div>

      @* Progress dots *@
      <div class="flex flex-wrap items-center gap-0.5">
        @foreach (var dotCard in _cards)
        {
          var dc = dotCard;
          var isActive = dc.Index == _activeIndex;
          <button
            type="button"
            aria-label="@($"Jump to {dc.Title}")"
            @onclick="@(() => _activeIndex = dc.Index)"
            class="inline-flex h-6 min-w-6 items-center justify-center"
          >
            <span class="@Cn.Merge("h-1.5 rounded-full transition-all", isActive ? "w-8 bg-foreground" : "w-2 bg-muted-foreground/30 hover:bg-muted-foreground/60")"></span>
          </button>
        }
      </div>

      <div class="flex items-center gap-2">
        <ButtonCn
          Class="w-full sm:w-[280px]"
          Variant="ButtonVariant.Ghost"
          OnClick="@(() => Advance(-1))"
        >
          Previous
        </ButtonCn>
        <ButtonCn
          Class="w-full sm:w-[280px]"
          OnClick="@(() => Advance(1))"
        >
          Next card
        </ButtonCn>
      </div>
    </div>
  </div>
</section>

@code {
    private int _activeIndex = 0;

    private record SampleRow(string Label, string Value);

    private record DeckCard(
        int Index,
        string Id,
        string Eyebrow,
        string IconName,
        string Title,
        string Description,
        string[] Bullets,
        string MetricLabel,
        string MetricValue,
        SampleRow[] Sample
    );

    private record StackPosition(int Y, double Scale, double Opacity, double Blur);

    private static readonly StackPosition[] _stackPositions =
    [
        new(0,    1.00, 1.00, 0.0),
        new(-28,  0.94, 0.88, 0.0),
        new(-52,  0.88, 0.70, 0.4),
        new(-72,  0.82, 0.50, 0.8),
        new(-88,  0.78, 0.30, 1.2),
        new(-100, 0.74, 0.15, 2.0),
    ];

    private static readonly DeckCard[] _cards =
    [
        new(0, "sync", "Realtime", "radio-tower",
            "Collaborative sync that never conflicts",
            "CRDT-backed documents keep every cursor in lockstep. Offline edits merge cleanly when the connection returns, no manual resolution ever.",
            ["CRDT conflict resolution", "Offline-first buffer", "Presence cursors"],
            "Merge conflicts", "0",
            [new("Peers", "14"), new("p95 sync", "38ms"), new("Offline queue", "2 edits")]),

        new(1, "infer", "Inference", "wand-sparkles",
            "Streaming completions tuned to your schema",
            "Generate structured output that validates against your Zod schemas before it ever reaches a user. Bad tokens are caught mid-stream.",
            ["Token-level validation", "Schema-guided decoding", "Cold-start free"],
            "First token", "64ms",
            [new("Model", "claude-opus"), new("Tokens/s", "312"), new("Valid JSON", "100%")]),

        new(2, "pipeline", "Data", "circuit-board",
            "Type-safe pipelines from source to sink",
            "Compose ingestion, transform, and egress as pure functions. The compiler tracks provenance so every row can be explained.",
            ["Lineage tracking", "Typed transforms", "Dry-run preview"],
            "Rows/sec", "1.2M",
            [new("Sources", "8"), new("Stages", "24"), new("Lineage depth", "6")]),

        new(3, "guard", "Security", "lock-keyhole",
            "Policy engine you can read on a plane",
            "Write authorization rules in a tiny DSL that compiles to SQL predicates. Decisions are logged with the exact rule that fired.",
            ["Readable DSL", "SQL predicate push-down", "Every decision explained"],
            "Eval time", "0.4ms",
            [new("Rules", "146"), new("Coverage", "98.2%"), new("Denies (24h)", "31")]),

        new(4, "meter", "Billing", "gauge",
            "Usage metering that Stripe understands",
            "Stream any metric as a usage event and the billing engine translates it into invoice line items — with proration on plan changes.",
            ["Stream any metric", "Proration built in", "Invoice previews"],
            "Event lag", "110ms",
            [new("Events/s", "22k"), new("Dimensions", "18"), new("Accuracy", "99.99%")]),

        new(5, "docs", "Knowledge", "book-open",
            "Docs that stay married to production",
            "Markdown in your repo becomes a searchable, versioned knowledge base. Code samples are type-checked against the SDK on every build.",
            ["Repo-driven docs", "Type-checked samples", "Version time-travel"],
            "Sample drift", "0 files",
            [new("Pages", "284"), new("Samples", "1,412"), new("Build time", "8s")]),
    ];

    private static int GetRelativePosition(int cardIndex, int activeIndex, int total)
        => (cardIndex - activeIndex + total) % total;

    private void Advance(int direction)
    {
        _activeIndex = (_activeIndex + direction + _cards.Length) % _cards.Length;
    }
}
