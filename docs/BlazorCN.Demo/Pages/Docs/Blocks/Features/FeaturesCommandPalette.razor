@* ============================================================
   Block: features-command-palette
   Title: Features Command Palette
   Description: Features styled as a command palette interface with keyboard shortcuts, perfect for developer tools and technical product pages
   Dependencies: None
   Source: original/blocks/features/features-command-palette.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Keyboard Shortcuts</h2>
            <p class="mt-1 text-xs text-muted-foreground">Power-user features accessible via keyboard</p>
        </div>

        @for (var i = 0; i < _features.Length; i++)
        {
            var feature = _features[i];
            <div class="@Cn.Merge("flex items-start gap-4 px-4 py-3", i < _features.Length - 1 ? "border-b" : "")">
                <span class="mt-0.5 shrink-0 rounded bg-muted px-2 py-1 font-mono text-xs text-muted-foreground">@feature.Shortcut</span>
                <div class="min-w-0 flex-1">
                    <h3 class="text-sm font-medium">@feature.Command</h3>
                    <p class="mt-0.5 text-sm text-muted-foreground">@feature.Description</p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Feature(string Shortcut, string Command, string Description);

    private static readonly Feature[] _features =
    [
        new("\u2318K", "Quick Search", "Search across all your projects, files, and documentation instantly."),
        new("\u2318\u21e7P", "Command Palette", "Access any action or setting without leaving the keyboard."),
        new("\u2318T", "New Terminal", "Open a terminal session with your project environment pre-configured."),
        new("\u2318B", "Toggle Sidebar", "Show or hide the file explorer and navigation sidebar."),
        new("\u2318\u21e7F", "Find in Files", "Search across your entire codebase with regex support."),
        new("\u2318\u21e7D", "Deploy Preview", "Create an instant preview deployment of your current branch."),
        new("\u2318\u21e7E", "Export Data", "Export your project data in JSON, CSV, or SQL format."),
        new("\u2318\u21e7L", "View Logs", "Open real-time application and build logs in a split pane."),
    ];
}
