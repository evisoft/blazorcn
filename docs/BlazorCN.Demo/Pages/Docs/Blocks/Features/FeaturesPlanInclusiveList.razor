@* ============================================================
   Block: features-plan-inclusive-list
   Title: FeaturesPlanInclusiveList
   Description: A plan inclusive list features section for React and Next.js with a centered headline, a long vertical list of grouped check icon feature items, three uppercase section headers, and a ShadcnioButton trial CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-plan-inclusive-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-14">

        @* Header *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_headline.Eyebrow
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
                @_headline.Title
            </h2>
            <p class="mt-5 text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>
        </div>

        @* Grouped inclusion list *@
        <div class="mt-12 sm:mt-14">
            @for (var gi = 0; gi < _groups.Length; gi++)
            {
                var grp = _groups[gi];
                var isLast = gi == _groups.Length - 1;
                <div class="@(gi == 0 ? "pb-8" : Cn.Merge("border-t pt-8 pb-8", isLast ? "last:pb-0" : ""))">
                    <h3 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-muted-foreground">
                        @grp.Label
                    </h3>
                    <ul class="mt-5 space-y-5">
                        @foreach (var item in grp.Items)
                        {
                            <li class="flex items-start gap-3.5">
                                <span aria-hidden="true" class="mt-0.5 flex size-5 shrink-0 items-center justify-center">
                                    <LucideIconCn Name="check" Size="20" Class="size-5 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                                </span>
                                <div class="min-w-0 flex-1">
                                    <h4 class="text-base font-semibold text-foreground">@item.Title</h4>
                                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                                        @item.Description
                                    </p>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* CTA footer *@
        <div class="mt-10 flex flex-col items-center gap-3 border-t pt-10 text-center">
            <ButtonCn Class="w-full sm:w-[230px]">Start your trial</ButtonCn>
            <p class="text-xs text-muted-foreground">
                No credit card required. Cancel anytime during the first fourteen days.
            </p>
        </div>

    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureItem(string Id, string Title, string Description);
    private record FeatureGroup(string Id, string Label, FeatureItem[] Items);

    private static readonly HeadlineData _headline = new(
        Eyebrow: "What's included",
        Title: "Everything you get, on every plan",
        Subtitle: "No locked tiers, no enterprise-only asterisks. Every capability below ships on day one for every team, regardless of seat count or billing cadence."
    );

    private static readonly FeatureGroup[] _groups =
    [
