@* ============================================================
   Block: features-aspect-ratio-mockup-cards
   Title: FeaturesAspectRatioMockupCards
   Description: An image-heavy 2x3 aspect ratio mockup card grid feature section for React and Next.js where each card gives 60 percent of its height to a crosshair screenshot placeholder and 40 percent to compact text built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-aspect-ratio-mockup-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">

        @* Centered headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_headline.Eyebrow
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_headline.Title
            </h2>
            <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>
        </div>

        @* 2x3 image-heavy card grid *@
        <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3">
            @foreach (var feature in _features)
            {
                <article class="group overflow-hidden rounded-xl border bg-background">
                    @* Image area — 60% of the visual weight via aspect-[4/3] *@
                    <div class="flex aspect-[4/3] w-full items-center justify-center border-b bg-muted">
                        <div class="relative flex items-center justify-center">
                            <div aria-hidden="true" class="absolute size-24 rounded-full border border-muted-foreground/[0.06]"></div>
                            <div aria-hidden="true" class="absolute size-14 rounded-full border border-muted-foreground/[0.08]"></div>
                            <div aria-hidden="true" class="absolute h-px w-32 bg-muted-foreground/[0.06]"></div>
                            <div aria-hidden="true" class="absolute h-32 w-px bg-muted-foreground/[0.06]"></div>
                            <div class="flex size-8 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                                <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
                            </div>
                        </div>
                    </div>

                    @* Text area — compact, ~40% weight *@
                    <div class="p-5">
                        <h3 class="text-base font-semibold text-foreground">@feature.Title</h3>
                        <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                            @feature.Description
                        </p>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureItem(string Id, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        "Product tour",
        "Six surfaces your team will live inside",
        "Each module ships with a dedicated workspace tuned for the task at hand. No context switching, no half-baked modals, no feature hidden three menus deep."
    );

    private static readonly FeatureItem[] _features =
    [
        new("workspace", "Unified workspace",
            "A single canvas for specs, tickets, and design reviews that auto-links across projects."),
        new("timeline", "Live project timeline",
            "Drag-to-reschedule Gantt view with dependencies that reflow in real time as dates shift."),
        new("reviews", "Inline design reviews",
            "Pin comments directly on mockups and resolve threads without leaving the canvas."),
        new("automations", "Workflow automations",
            "Trigger handoffs, status updates, and notifications the moment a field changes."),
        new("dashboards", "Executive dashboards",
            "Pre-built views that roll up every squad into a single weekly status snapshot."),
        new("integrations", "Deep integrations",
            "Two-way sync with GitHub, Figma, Linear, and Slack so every surface stays in lockstep."),
    ];
}
