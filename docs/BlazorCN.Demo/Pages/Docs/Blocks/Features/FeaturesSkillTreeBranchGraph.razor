@* ============================================================
   Block: features-skill-tree-branch-graph
   Title: FeaturesSkillTreeBranchGraph
   Description: A skill tree branch graph features section for React and Next.js with a central root node, six surrounding skill nodes, SVG connecting lines, and a skill point counter built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-skill-tree-branch-graph.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Platform skill tree
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Every capability unlocks the next.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Start with the core and branch outward. Each skill is a real production feature, each
                line is a prerequisite — the whole tree ships with your account.
            </p>
        </div>

        @* Graph container with SP counter *@
        <div class="relative mt-10 overflow-hidden rounded-lg border bg-card p-6">
            @* SP counter (top-right) *@
            <div class="absolute right-4 top-4 z-20 flex items-center gap-2 rounded-md border bg-background px-3 py-1.5">
                <LucideIconCn Name="zap" Size="14" Class="size-3.5 text-amber-500" StrokeWidth="2" aria-hidden="true" />
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    SP
                </span>
                <span class="text-sm font-semibold tabular-nums text-foreground">
                    @_unlockedCount / @_totalPoints
                </span>
            </div>

            @* Graph area *@
            <div class="relative mx-auto aspect-[5/4] w-full max-w-2xl sm:aspect-[3/2]">
                @* SVG connecting lines *@
                <svg
                    aria-hidden="true"
                    class="absolute inset-0 size-full"
                    viewBox="0 0 100 100"
                    preserveAspectRatio="none">
                    <title>Skill tree connections</title>
                    @foreach (var node in _skillNodes)
                    {
                        var midX = (50.0 + node.X) / 2.0;
                        var curveOffset = node.Index % 2 == 0 ? -6.0 : 6.0;
                        var controlY = (50.0 + node.Y) / 2.0 + curveOffset;
                        var strokeDash = node.Unlocked ? "0" : "2 2";
                        var strokeClass = node.Unlocked ? "text-foreground/40" : "text-muted-foreground/30";
                        <path
                            d="@($"M 50 50 Q {midX:F2} {controlY:F2} {node.X} {node.Y}")"
                            stroke="currentColor"
                            stroke-width="0.5"
                            fill="none"
                            stroke-dasharray="@strokeDash"
                            class="@strokeClass" />
                    }
                </svg>

                @* Root node (center) *@
                <div class="absolute left-1/2 top-1/2 z-10 -translate-x-1/2 -translate-y-1/2">
                    <div class="flex flex-col items-center">
                        <div class="flex size-16 items-center justify-center rounded-full border-2 border-amber-500/70 bg-amber-500/10 ring-4 ring-amber-500/10">
                            <LucideIconCn Name="sparkles" Size="24" Class="size-6 text-amber-600" StrokeWidth="2" aria-hidden="true" />
                        </div>
                        <h3 class="mt-2 whitespace-nowrap text-xs font-medium text-foreground">
                            Core Platform
                        </h3>
                        <span class="text-[9px] font-medium uppercase tracking-wider text-muted-foreground">
                            Root · Lv 5
                        </span>
                    </div>
                </div>

                @* Surrounding skill nodes *@
                @foreach (var node in _skillNodes)
                {
                    var nodeClass = node.Unlocked
                        ? "flex size-12 items-center justify-center rounded-full border-2 border-foreground/80 bg-card"
                        : "flex size-12 items-center justify-center rounded-full border-2 border-dashed border-muted-foreground/40 bg-muted";
                    var labelClass = node.Unlocked
                        ? "mt-1.5 whitespace-nowrap text-[11px] font-medium text-foreground"
                        : "mt-1.5 whitespace-nowrap text-[11px] font-medium text-muted-foreground";
                    var ariaLabel = node.Unlocked ? node.Name : $"{node.Name} (locked)";
                    <div
                        aria-label="@ariaLabel"
                        class="absolute z-10 -translate-x-1/2 -translate-y-1/2"
                        style="@($"left:{node.X}%;top:{node.Y}%")">
                        <div class="flex flex-col items-center">
                            <div class="@nodeClass">
                                @if (node.Unlocked)
                                {
                                    <LucideIconCn Name="@node.IconName" Size="20" Class="size-5 text-foreground" StrokeWidth="2" aria-hidden="true" />
                                }
                                else
                                {
                                    <LucideIconCn Name="lock" Size="16" Class="size-4 text-muted-foreground" StrokeWidth="2" aria-hidden="true" />
                                }
                            </div>
                            <h3 class="@labelClass">
                                @node.Name
                            </h3>
                        </div>
                    </div>
                }
            </div>

            @* Legend footer *@
            <div class="mt-4 flex items-center justify-center gap-4 border-t pt-4 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                <span class="flex items-center gap-1.5">
                    <span class="size-2 rounded-full border border-foreground/80 bg-card"></span>
                    Unlocked
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-2 rounded-full border border-dashed border-muted-foreground/40 bg-muted"></span>
                    Locked
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-2 rounded-full border-2 border-amber-500/70 bg-amber-500/10"></span>
                    Root skill
                </span>
            </div>
        </div>

        @* CTA pair *@
        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <ButtonCn Class="w-full sm:w-[250px]">Spend skill points</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">View full tree</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SkillNode(string Id, string IconName, string Name, double X, double Y, bool Unlocked, int Index);

    private static readonly SkillNode[] _skillNodes =
    [
        new("compute",  "cloud",          "Edge Compute", 50,  10,  true,  0),
        new("database", "database",       "Vector DB",    88,  28,  true,  1),
        new("auth",     "shield-check",   "Zero Trust",   88,  72,  true,  2),
        new("ai",       "brain-circuit",  "AI Runtime",   50,  90,  false, 3),
        new("cicd",     "rocket",         "CI/CD Forge",  12,  72,  true,  4),
        new("sdk",      "code",           "Typed SDKs",   12,  28,  true,  5),
    ];

    private static readonly int _totalPoints = 10;

    private int _unlockedCount = _skillNodes.Count(n => n.Unlocked) + 1; // +1 for root
}
