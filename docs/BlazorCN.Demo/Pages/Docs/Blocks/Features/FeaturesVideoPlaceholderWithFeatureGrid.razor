@* ============================================================
   Block: features-video-placeholder-with-feature-grid
   Title: FeaturesVideoPlaceholderWithFeatureGrid
   Description: A video-forward features section for React and Next.js with a 16:9 video placeholder hero, centered play button, bottom title overlay, scrubber, and a three-column supporting feature grid built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-video-placeholder-with-feature-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">

    @* Headline cluster *@
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        @_headline.Eyebrow
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        @_headline.Title
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
        @_headline.Subtitle
      </p>
    </div>

    @* Video placeholder hero *@
    <div class="mt-10 overflow-hidden rounded-xl border bg-muted">
      <div class="relative aspect-[16/9] w-full">

        @* Crosshair decoration (behind the play button) *@
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 flex items-center justify-center">
          <div class="relative flex items-center justify-center">
            <div class="absolute size-48 rounded-full border border-muted-foreground/[0.06]"></div>
            <div class="absolute size-32 rounded-full border border-muted-foreground/[0.08]"></div>
            <div class="absolute h-px w-64 bg-muted-foreground/[0.06]"></div>
            <div class="absolute h-64 w-px bg-muted-foreground/[0.06]"></div>
          </div>
        </div>

        @* Play button *@
        <div class="absolute inset-0 flex items-center justify-center">
          <button
            type="button"
            aria-label="@($"Play {_video.Label}, {_video.Duration}")"
            class="group relative flex size-14 items-center justify-center rounded-full border border-border bg-background/90 shadow-sm backdrop-blur-sm transition-transform hover:scale-[1.04] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
            <LucideIconCn Name="play" Size="20" Class="size-5 translate-x-[1px] fill-foreground text-foreground" />
          </button>
        </div>

        @* Bottom overlay: title + duration *@
        <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 p-4 sm:p-5">
          <div class="inline-flex items-center gap-2 rounded-full border border-border bg-background/80 px-3 py-1 backdrop-blur-sm">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-medium text-foreground">@_video.Label</span>
            <span aria-hidden="true" class="text-xs text-muted-foreground">·</span>
            <span class="font-mono text-[11px] text-muted-foreground">@_video.Duration</span>
          </div>
        </div>

        @* Timeline scrubber *@
        <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5 bg-muted-foreground/10">
          <div class="h-full bg-foreground/70" style="@(FormattableString.Invariant($"width:{_video.Progress * 100}%"))"></div>
        </div>

      </div>
    </div>

    @* Supporting feature grid *@
    <div class="mt-10 grid grid-cols-1 gap-6 border-t border-border pt-10 sm:grid-cols-3 sm:gap-8">
      @foreach (var feat in _supportFeatures)
      {
        <div>
          <div class="flex size-9 items-center justify-center rounded-lg bg-muted">
            <LucideIconCn Name="@feat.Icon" Size="16" Class="size-4 text-muted-foreground" />
          </div>
          <h3 class="mt-4 text-base font-semibold text-foreground">@feat.Title</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">@feat.Description</p>
        </div>
      }
    </div>

    @* CTA *@
    <div class="mt-10 flex justify-center">
      <ButtonCn Class="w-full sm:w-[220px]">Watch full demo</ButtonCn>
    </div>

  </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record VideoData(string Label, string Duration, double Progress);
    private record FeatureItem(string Id, string Title, string Description, string Icon);

    private static readonly HeadlineData _headline = new(
        Eyebrow: "See it in motion",
        Title: "Watch how teams ship in one flow",
        Subtitle: "A 2-minute walkthrough of the entire product, from first-time setup to shipping a production release. No slides, no voiceover fluff — just the actual interface."
    );

    private static readonly VideoData _video = new(
        Label: "Product overview",
        Duration: "2:34",
        Progress: 0.34
    );

    private static readonly FeatureItem[] _supportFeatures =
    [
        new("instant-setup",    "Instant setup",       "Sign in with your identity provider and the workspace provisions in under 60 seconds.",                                          "zap"),
        new("policy-guardrails","Policy guardrails",   "Role-based controls and audit logs are on by default, no enterprise tier required.",                                              "shield"),
        new("native-workflows", "Native workflows",    "Branching, review, and deployment all live in one keyboard-first surface with no tab switching.",                                 "workflow"),
    ];
}
