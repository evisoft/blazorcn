@* ============================================================
   Block: features-live-code-playground-showcase
   Title: FeaturesLiveCodePlaygroundShowcase
   Description: A live code playground showcase features section for React and Next.js with a language PillTabs selector, a dark terminal code editor panel with fake syntax highlighting and line numbers, and a right-side live preview pane rendering a miniature card with button toggle and chart mockup built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-live-code-playground-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10">

        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Live playground
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                Write the code, see the result, ship it
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every example on our docs runs end to end, so you can inspect the output before you paste anything into your project.
            </p>
        </div>

        @* Language tabs (PillTabs) *@
        <div class="mt-8 flex justify-center">
            <div class="inline-flex items-center gap-1 rounded-full border bg-muted/50 p-1" aria-label="Code sample language" role="tablist">
                @foreach (var lang in _languages)
                {
                    var language = lang;
                    <button
                        role="tab"
                        aria-selected="@(_activeTab == language ? "true" : "false")"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _activeTab == language ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                        type="button"
                        @onclick="@(() => _activeTab = language)">
                        @_languageLabels[language]
                    </button>
                }
            </div>
        </div>

        @* Split: editor + preview *@
        <div class="mt-8 grid gap-4 lg:grid-cols-[1.15fr_1fr]">

            @* Editor panel *@
            <div class="overflow-hidden rounded-xl border bg-foreground">
                @* Editor chrome *@
                <div class="flex items-center justify-between border-b border-background/10 px-3 py-2.5">
                    <div class="flex items-center gap-2">
                        <div class="flex items-center gap-1.5">
                            <span class="size-2.5 rounded-full bg-background/20"></span>
                            <span class="size-2.5 rounded-full bg-background/20"></span>
                            <span class="size-2.5 rounded-full bg-background/20"></span>
                        </div>
                        <span class="ml-2 font-mono text-[11px] text-background/50">
                            @_codeSamples[_activeTab].Filename
                        </span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="inline-flex items-center gap-1 rounded-full bg-background/10 px-2 py-0.5 text-[10px] font-medium text-background/70">
                            <span aria-hidden="true" class="relative flex size-1.5">
                                <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500/60"></span>
                                <span class="relative inline-flex size-1.5 rounded-full bg-emerald-500"></span>
                            </span>
                            Ready
                        </span>
                        <button
                            aria-label="Run code sample"
                            class="inline-flex items-center gap-1 rounded-md border border-background/20 bg-background/10 px-2 py-1 text-[11px] font-medium text-background transition-colors hover:bg-background/20"
                            type="button">
                            <LucideIconCn Name="play" Size="12" Class="size-3" />
                            Run
                        </button>
                    </div>
                </div>

                @* Code body *@
                <div class="relative overflow-x-auto">
                    <pre class="min-w-max px-0 py-4 font-mono text-[12px] leading-relaxed">
@{
    var sample = _codeSamples[_activeTab];
    for (var lineIdx = 0; lineIdx < sample.Lines.Length; lineIdx++)
    {
        var line = sample.Lines[lineIdx];
        var lineNumber = lineIdx + 1;
        <div class="flex whitespace-pre">
            <span class="sticky left-0 inline-block w-10 shrink-0 select-none bg-foreground pr-3 text-right font-mono text-[11px] text-background/30">@lineNumber</span>
            <code class="pr-6">
                @if (line.Length == 0)
                {
                    <span>&nbsp;</span>
                }
                else
                {
                    foreach (var token in line)
                    {
                        <span class="@TokenClass(token.Type)">@token.Text</span>
                    }
                }
            </code>
        </div>
    }
}
                    </pre>
                </div>

                @* Editor status bar *@
                <div class="flex items-center justify-between border-t border-background/10 px-3 py-2 font-mono text-[10px] text-background/40">
                    <span class="inline-flex items-center gap-1">
                        <LucideIconCn Name="dot" Size="12" Class="size-3 text-emerald-400" />
                        main
                    </span>
                    <span>UTF-8 · LF · @_languageLabels[_activeTab]</span>
                </div>
            </div>

            @* Preview panel *@
            <div class="flex flex-col overflow-hidden rounded-xl border bg-muted/30">
                @* Preview chrome *@
                <div class="flex items-center justify-between border-b bg-card/60 px-4 py-2.5">
                    <span class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                        Preview
                    </span>
                    <span class="font-mono text-[10px] text-muted-foreground/70">localhost:3000</span>
                </div>

                @* Preview body — a rendered illustrative card *@
                <div class="flex flex-1 items-center justify-center p-6">
                    <div class="w-full max-w-sm rounded-xl border bg-card p-5 shadow-sm">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                    Invoice #INV-8421
                                </p>
                                <h3 class="mt-1 text-lg font-semibold text-foreground">$49.00 USD</h3>
                            </div>
                            <span class="inline-flex items-center gap-1 rounded-full border bg-muted/50 px-2 py-0.5 text-[10px] font-medium text-foreground">
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                Paid
                            </span>
                        </div>

                        @* Mini chart *@
                        <div aria-hidden="true" class="mt-4 flex h-16 items-end gap-1.5">
                            @foreach (var bar in _previewChart)
                            {
                                var barVal = bar;
                                <div class="flex-1 rounded-sm bg-foreground/70" style="@($"height:{barVal}%")"></div>
                            }
                        </div>

                        @* Toggle row *@
                        <div class="mt-4 flex items-center justify-between border-t pt-3">
                            <span class="text-xs text-muted-foreground">Auto-charge on renewal</span>
                            <button
                                aria-label="Toggle auto-charge"
                                aria-pressed="@(_autoCharge ? "true" : "false")"
                                class="@Cn.Merge("relative inline-flex h-5 w-9 shrink-0 items-center rounded-full border transition-colors", _autoCharge ? "bg-foreground" : "bg-muted")"
                                type="button"
                                @onclick="@(() => _autoCharge = !_autoCharge)">
                                <span class="@Cn.Merge("inline-block size-3.5 rounded-full bg-background shadow transition-transform", _autoCharge ? "translate-x-4" : "translate-x-0.5")"></span>
                            </button>
                        </div>

                        @* Action row *@
                        <div class="mt-4 flex items-center gap-2">
                            <button
                                class="flex-1 rounded-md bg-foreground px-3 py-1.5 text-xs font-medium text-background transition-opacity hover:opacity-90"
                                type="button">
                                View receipt
                            </button>
                            <button
                                class="rounded-md border px-3 py-1.5 text-xs font-medium text-foreground transition-colors hover:bg-muted"
                                type="button">
                                Refund
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private enum Language { TypeScript, Python, Go }

    private record Token(string Type, string Text);

    private record CodeSample(string Filename, Token[][] Lines);

    private Language _activeTab = Language.TypeScript;
    private bool _autoCharge = true;

    private static readonly Language[] _languages = [Language.TypeScript, Language.Python, Language.Go];

    private static readonly Dictionary<Language, string> _languageLabels = new()
    {
        [Language.TypeScript] = "TypeScript",
        [Language.Python] = "Python",
        [Language.Go] = "Go",
    };

    private static readonly Dictionary<Language, CodeSample> _codeSamples = new()
    {
        [Language.TypeScript] = new CodeSample(
            Filename: "create-invoice.ts",
            Lines:
            [
                [new("keyword", "import"), new("plain", " { createClient } "), new("keyword", "from"), new("string", " \"@acme/sdk\"")],
                [],
                [new("keyword", "const"), new("plain", " client = "), new("fn", "createClient"), new("plain", "({")],
                [new("plain", "  apiKey: "), new("string", "process.env.ACME_KEY!")],
                [new("plain", "})")],
                [],
                [new("keyword", "const"), new("plain", " invoice = "), new("keyword", "await"), new("plain", " client.invoices."), new("fn", "create"), new("plain", "({")],
                [new("plain", "  customerId: "), new("string", "\"cus_8f2A\""), new("plain", ",")],
                [new("plain", "  amount: "), new("string", "4900"), new("plain", ",")],
                [new("plain", "  currency: "), new("string", "\"usd\"")],
                [new("plain", "})")],
            ]
        ),
        [Language.Python] = new CodeSample(
            Filename: "create_invoice.py",
            Lines:
            [
                [new("keyword", "from"), new("plain", " acme "), new("keyword", "import"), new("plain", " Client")],
                [],
                [new("plain", "client = "), new("fn", "Client"), new("plain", "(")],
                [new("plain", "    api_key=os.environ["), new("string", "\"ACME_KEY\""), new("plain", "]")],
                [new("plain", ")")],
                [],
                [new("plain", "invoice = client.invoices."), new("fn", "create"), new("plain", "(")],
                [new("plain", "    customer_id="), new("string", "\"cus_8f2A\""), new("plain", ",")],
                [new("plain", "    amount="), new("string", "4900"), new("plain", ",")],
                [new("plain", "    currency="), new("string", "\"usd\"")],
                [new("plain", ")")],
            ]
        ),
        [Language.Go] = new CodeSample(
            Filename: "create_invoice.go",
            Lines:
            [
                [new("keyword", "package"), new("plain", " main")],
                [],
                [new("keyword", "import"), new("string", " \"github.com/acme/sdk-go\"")],
                [],
                [new("plain", "client := acme."), new("fn", "NewClient"), new("plain", "(")],
                [new("plain", "    os.Getenv("), new("string", "\"ACME_KEY\""), new("plain", "),")],
                [new("plain", ")")],
                [],
                [new("plain", "invoice, err := client.Invoices."), new("fn", "Create"), new("plain", "(&acme.InvoiceParams{")],
                [new("plain", "    CustomerID: "), new("string", "\"cus_8f2A\""), new("plain", ",")],
                [new("plain", "    Amount:     "), new("string", "4900"), new("plain", ",")],
                [new("plain", "})")],
            ]
        ),
    };

    private static readonly int[] _previewChart = [42, 68, 55, 91, 74, 60, 82];

    private static string TokenClass(string tokenType) => tokenType switch
    {
        "keyword" => "text-amber-300",
        "string"  => "text-emerald-300",
        "fn"      => "text-blue-300",
        "comment" => "text-background/40",
        _         => "text-background/80",
    };
}
