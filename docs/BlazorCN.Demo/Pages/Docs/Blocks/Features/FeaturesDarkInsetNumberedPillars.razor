@* ============================================================
   Block: features-dark-inset-numbered-pillars
   Title: FeaturesDarkInsetNumberedPillars
   Description: A dark inset numbered pillars feature section for React and Next.js with a high-contrast editorial dark panel and three ghost-numeraled vertical pillars separated by dividers built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-dark-inset-numbered-pillars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10">
        <div class="rounded-xl bg-foreground p-8 sm:p-14">

            @* Top — centered eyebrow + headline + subtitle *@
            <div class="mx-auto max-w-2xl text-center">
                <p class="text-xs font-medium uppercase tracking-widest text-background/40">
                    @_headline.Eyebrow
                </p>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-background sm:text-4xl">
                    @_headline.Title
                </h2>
                <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-background/60">
                    @_headline.Subtitle
                </p>
            </div>

            @* Bottom — three pillar columns *@
            <div class="mt-12 grid grid-cols-1 md:mt-16 md:grid-cols-3 md:divide-x md:divide-background/10">
                @foreach (var pillar in _pillars)
                {
                    <div class="flex flex-col border-b border-background/10 px-0 py-10 first:pt-0 last:border-b-0 last:pb-0 md:border-b-0 md:px-8 md:py-0 md:first:pl-0 md:last:pr-0">
                        <div aria-hidden="true" class="text-5xl font-bold leading-none text-background/20">
                            @pillar.Numeral
                        </div>
                        <div aria-hidden="true" class="mt-6 flex size-10 items-center justify-center rounded-lg bg-background/10">
                            <LucideIconCn Name="@pillar.IconName" Size="20" Class="size-5 text-background/70" />
                        </div>
                        <h3 class="mt-5 text-lg font-semibold text-background">@pillar.Title</h3>
                        <p class="mt-2 text-sm leading-relaxed text-background/60">
                            @pillar.Description
                        </p>
                        <a href="#" class="group mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-background/40 focus-visible:ring-offset-2 focus-visible:ring-offset-foreground">
                            @pillar.LinkLabel
                            <LucideIconCn Name="arrow-right" Size="16" Class="size-4 transition-transform group-hover:translate-x-0.5" />
                        </a>
                    </div>
                }
            </div>

        </div>
    </div>
</section>

@code {
    private record Headline(string Eyebrow, string Title, string Subtitle);
    private record Pillar(string Id, string Numeral, string IconName, string Title, string Description, string LinkLabel);

    private static readonly Headline _headline = new(
        "The foundation",
        "Three pillars that hold the platform up",
        "Every other feature we ship rests on these three foundations. Get them right and the product sells itself."
    );

    private static readonly Pillar[] _pillars =
    [
        new("edge-runtime", "01", "zap", "Edge runtime",
            "V8 isolates boot in under 5 milliseconds across 310 points of presence. Cold starts stop being something you apologize for in the postmortem.",
            "Explore runtime"),
        new("zero-trust", "02", "shield", "Zero-trust access",
            "SAML, SCIM, and hardware key enforcement are included on every plan. No enterprise surcharge, no six-week setup call with a solutions engineer.",
            "Review security"),
        new("observability", "03", "cpu", "Observability built in",
            "Traces, metrics, and structured logs ship from the first deploy without an agent install. Your first incident is also your first debugging lesson.",
            "See telemetry"),
    ];
}
