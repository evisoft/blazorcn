@* ============================================================
   Block: features-alternating-code-block-rows
   Title: FeaturesAlternatingCodeBlockRows
   Description: An alternating code block rows features section for React and Next.js with three zigzag rows pairing developer-platform copy against dark terminal-style code mockups and inline View docs links built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-alternating-code-block-rows.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 sm:py-14 lg:py-16">

        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Developer platform
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
                Primitives your backend engineers will actually want to use
            </h2>
            <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-muted-foreground">
                Auth, APIs, and webhooks that read well in a code review — generated from your schema,
                typed end to end, and documented inline where you need them.
            </p>
        </div>

        @* Alternating rows *@
        <div class="mt-14 space-y-16 sm:mt-20 sm:space-y-20">
            @for (var i = 0; i < _rows.Length; i++)
            {
                var row = _rows[i];
                var isReversed = i % 2 == 1;
                <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-14">

                    @* Text side *@
                    <div class="@(isReversed ? "lg:order-2" : "")">
                        <span class="inline-flex items-center rounded-full border bg-muted/50 px-3 py-1 text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                            @row.Eyebrow
                        </span>
                        <h3 class="mt-4 text-2xl font-semibold tracking-tight text-foreground sm:text-[28px]">
                            @row.Title
                        </h3>
                        <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                            @row.Description
                        </p>
                        <a href="@row.DocsHref"
                           class="group mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-foreground transition-colors hover:text-foreground/80">
                            View docs
                            <LucideIconCn Name="arrow-right" Size="16" Class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                        </a>
                    </div>

                    @* Code block side *@
                    <div class="@(isReversed ? "lg:order-1" : "")">
                        <div class="overflow-hidden rounded-xl border bg-foreground shadow-sm">
                            <div class="flex items-center gap-1.5 border-b border-background/10 bg-background/5 px-4 py-2.5">
                                <span aria-hidden="true" class="size-2.5 rounded-full bg-background/20"></span>
                                <span aria-hidden="true" class="size-2.5 rounded-full bg-background/20"></span>
                                <span aria-hidden="true" class="size-2.5 rounded-full bg-background/20"></span>
                                <span class="ml-2 font-mono text-xs text-background/40">@row.Filename</span>
                            </div>
                            <pre class="overflow-x-auto p-5 font-mono text-xs leading-relaxed text-background/70">
@foreach (var line in row.CodeLines)
{
                                <div class="whitespace-pre">@(string.IsNullOrEmpty(line) ? " " : line)</div>
}
                            </pre>
                        </div>
                    </div>

                </div>
            }
        </div>

    </div>
</section>

@code {
    private record DeveloperRow(
        string Id,
        string Eyebrow,
        string Title,
        string Description,
        string Filename,
        string[] CodeLines,
        string DocsHref
    );

    private static readonly DeveloperRow[] _rows =
    [
        new(
            Id: "auth",
            Eyebrow: "Auth SDK",
            Title: "Drop-in auth with four lines and zero session plumbing",
            Description: "Ship email, OAuth, and passkey sign-in without standing up your own session store. The SDK handles token refresh, CSRF, and device fingerprinting so your app code stays focused on product logic, not login forms.",
            Filename: "sign-in.ts",
            CodeLines:
            [
                "import { createAuth } from \"@platform/auth\"",
                "",
                "const auth = createAuth({ domain: \"acme.com\" })",
                "await auth.signIn({ provider: \"passkey\" })",
            ],
            DocsHref: "#auth-docs"
        ),
        new(
            Id: "api",
            Eyebrow: "REST API",
            Title: "A typed API client generated from your live schema",
            Description: "Every endpoint ships with a matching TypeScript client compiled from the OpenAPI spec at deploy time. Autocomplete reaches into nested query params, responses are fully typed, and breaking changes surface as build errors instead of runtime 500s.",
            Filename: "users.ts",
            CodeLines:
            [
                "import { client } from \"@platform/api\"",
                "",
                "const { data, error } = await client.users.create({",
                "  body: { name: \"Sarah Chen\", role: \"admin\" },",
                "})",
            ],
            DocsHref: "#api-docs"
        ),
        new(
            Id: "webhooks",
            Eyebrow: "Webhooks",
            Title: "Verified webhooks with retries, dead-letter queues, and replay",
            Description: "Register an endpoint once and get guaranteed at-least-once delivery with automatic exponential backoff, signed payload verification, and a replay console for debugging. Failed deliveries land in a dead-letter queue you can inspect and requeue by hand.",
            Filename: "webhook-handler.ts",
            CodeLines:
            [
                "import { verifyWebhook } from \"@platform/webhooks\"",
                "",
                "export async function POST(req: Request) {",
                "  const event = await verifyWebhook(req)",
                "  if (event.type === \"order.paid\") await ship(event)",
                "  return new Response(null, { status: 200 })",
                "}",
            ],
            DocsHref: "#webhooks-docs"
        ),
    ];
}
