@* ============================================================
   Block: features-integration-logo-mark-grid
   Title: FeaturesIntegrationLogoMarkGrid
   Description: An integration logo mark grid features section for React and Next.js with a PillTabs category filter above a 4 column grid of 12 integration tiles each with a geometric brand mark name and category label built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-integration-logo-mark-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="rounded-2xl border bg-card p-8 sm:p-12">

    @* Headline cluster *@
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Integrations
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Works with your stack
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
        Connect in one click to the tools your team already uses for identity, analytics, workflows, and customer conversations. No glue code required, no custom webhook to maintain.
      </p>
    </div>

    @* Category filter *@
    <div class="mt-8 flex justify-center">
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Filter integrations by category">
        @foreach (var cat in _categories)
        {
          var category = cat;
          <button
            type="button"
            role="tab"
            aria-selected="@(_activeCategory == category ? "true" : "false")"
            @onclick="@(() => _activeCategory = category)"
            class="@(Cn.Merge(
              "rounded-full px-4 py-1.5 text-sm font-medium transition-colors",
              _activeCategory == category
                ? "bg-foreground text-background"
                : "bg-muted text-muted-foreground hover:bg-muted/80"
            ))"
          >
            @category
          </button>
        }
      </div>
    </div>

    @* Integration tile grid *@
    <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      @foreach (var integration in FilteredIntegrations)
      {
        <article class="flex items-center gap-3 rounded-xl border bg-card p-5 transition-colors hover:bg-muted/40">
          @* BrandMark *@
          @if (integration.Shape == "circle")
          {
            <div
              aria-hidden="true"
              class="@($"flex size-11 shrink-0 items-center justify-center rounded-full text-sm font-bold ring-1 ring-inset {_toneClasses[integration.Tone]}")"
            >
              @integration.Initial
            </div>
          }
          else if (integration.Shape == "square")
          {
            <div
              aria-hidden="true"
              class="@($"flex size-11 shrink-0 items-center justify-center rounded-md text-sm font-bold ring-1 ring-inset {_toneClasses[integration.Tone]}")"
            >
              @integration.Initial
            </div>
          }
          else if (integration.Shape == "triangle")
          {
            <div
              aria-hidden="true"
              class="@($"relative flex size-11 shrink-0 items-center justify-center rounded-md text-sm font-bold ring-1 ring-inset {_toneClasses[integration.Tone]}")"
              style="clip-path: polygon(50% 12%, 95% 88%, 5% 88%)"
            >
              <span class="mt-1">@integration.Initial</span>
            </div>
          }
          else
          {
            @* hexagon *@
            <div
              aria-hidden="true"
              class="@($"flex size-11 shrink-0 items-center justify-center text-sm font-bold ring-1 ring-inset {_toneClasses[integration.Tone]}")"
              style="clip-path: polygon(25% 5%, 75% 5%, 100% 50%, 75% 95%, 25% 95%, 0% 50%)"
            >
              @integration.Initial
            </div>
          }

          <div class="min-w-0 flex-1">
            <h3 class="truncate text-sm font-semibold text-foreground">
              @integration.Name
            </h3>
            <p class="mt-0.5 truncate text-xs text-muted-foreground">
              @integration.Label
            </p>
          </div>
        </article>
      }
    </div>

    @* Footer link *@
    <div class="mt-8 flex items-center justify-center">
      <a
        class="group inline-flex items-center gap-1.5 text-sm font-medium text-foreground hover:underline"
        href="#integrations"
      >
        +40 more integrations
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
          →
        </span>
      </a>
    </div>

  </div>
</section>

@code {
    private string _activeCategory = "All";

    private static readonly string[] _categories = ["All", "Auth", "Data", "Workflow", "Communication"];

    private static readonly Dictionary<string, string> _toneClasses = new()
    {
        ["blue"]    = "bg-blue-500/10 text-blue-600 dark:text-blue-500 ring-blue-500/20",
        ["emerald"] = "bg-emerald-500/10 text-emerald-600 dark:text-emerald-500 ring-emerald-500/20",
        ["amber"]   = "bg-amber-500/10 text-amber-600 dark:text-amber-500 ring-amber-500/20",
        ["rose"]    = "bg-rose-500/10 text-rose-600 dark:text-rose-500 ring-rose-500/20",
        ["violet"]  = "bg-violet-500/10 text-violet-600 dark:text-violet-500 ring-violet-500/20",
        ["cyan"]    = "bg-cyan-500/10 text-cyan-600 dark:text-cyan-500 ring-cyan-500/20",
    };

    private record Integration(string Id, string Name, string Category, string Label, string Shape, string Initial, string Tone);

    private static readonly Integration[] _integrations =
    [
        new("clerk",     "Clerk",     "Auth",          "Auth",          "circle",   "C", "violet"),
        new("workos",    "WorkOS",    "Auth",          "Auth",          "hexagon",  "W", "blue"),
        new("auth0",     "Auth0",     "Auth",          "Auth",          "square",   "A", "amber"),
        new("posthog",   "PostHog",   "Data",          "Analytics",     "triangle", "P", "rose"),
        new("segment",   "Segment",   "Data",          "CDP",           "circle",   "S", "emerald"),
        new("snowflake", "Snowflake", "Data",          "Warehouse",     "hexagon",  "S", "cyan"),
        new("linear",    "Linear",    "Workflow",      "Issue tracking","square",   "L", "violet"),
        new("zapier",    "Zapier",    "Workflow",      "Automation",    "circle",   "Z", "amber"),
        new("notion",    "Notion",    "Workflow",      "Docs",          "square",   "N", "blue"),
        new("slack",     "Slack",     "Communication", "Messaging",     "hexagon",  "S", "rose"),
        new("intercom",  "Intercom",  "Communication", "Support",       "circle",   "I", "emerald"),
        new("twilio",    "Twilio",    "Communication", "SMS and voice", "triangle", "T", "cyan"),
    ];

    private Integration[] FilteredIntegrations =>
        _activeCategory == "All"
            ? _integrations
            : _integrations.Where(i => i.Category == _activeCategory).ToArray();
}
