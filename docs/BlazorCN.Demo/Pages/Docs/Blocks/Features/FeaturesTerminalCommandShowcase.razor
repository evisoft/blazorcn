@* ============================================================
   Block: features-terminal-command-showcase
   Title: FeaturesTerminalCommandShowcase
   Description: A terminal command showcase features section for React and Next.js with a PillTabs category selector, a dark terminal window mockup displaying emerald command prompts with muted output, and a three-card value prop row built with shadcn/ui PillTabs and Tailwind CSS
   Source: original/blocks/features/features-terminal-command-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Command surface
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
                One CLI. Every workflow your team actually runs.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Deploy, build, test, and tail logs with a single binary. Every command is memorable,
                composable, and returns machine-readable output so automation stays trivial.
            </p>
        </div>

        @* Category selector *@
        <div class="mt-8 flex justify-center">
            <div aria-label="Select a command category" class="flex gap-1 rounded-full border bg-muted/50 p-1">
                @foreach (var cat in _categories)
                {
                    var catItem = cat;
                    <button
                        type="button"
                        @onclick="@(() => _activeCategory = catItem)"
                        class="@(Cn.Merge(
                            "rounded-full px-4 py-1.5 text-sm font-medium transition-colors",
                            _activeCategory == catItem
                                ? "bg-background text-foreground shadow-sm"
                                : "text-muted-foreground hover:text-foreground"
                        ))"
                    >
                        @_categoryLabels[catItem]
                    </button>
                }
            </div>
        </div>

        @* Terminal window *@
        <div class="mt-8 overflow-hidden rounded-lg border bg-foreground font-mono shadow-sm">
            @* Terminal chrome *@
            <div class="flex items-center justify-between border-b border-background/10 px-4 py-2.5">
                <div class="flex items-center gap-1.5">
                    <span aria-hidden="true" class="size-3 rounded-full bg-red-500/80"></span>
                    <span aria-hidden="true" class="size-3 rounded-full bg-amber-500/80"></span>
                    <span aria-hidden="true" class="size-3 rounded-full bg-emerald-500/80"></span>
                </div>
                <div class="flex items-center gap-2 text-[11px] text-background/60">
                    <LucideIconCn Name="terminal" Size="12" Class="size-3" />
                    <span>~/projects/api</span>
                </div>
                <span class="text-[11px] text-background/40">zsh</span>
            </div>

            @* Terminal body *@
            <div class="relative overflow-x-auto px-5 py-5 text-[13px] leading-relaxed">
                <div class="space-y-4">
                    @foreach (var block in _commandSets[_activeCategory])
                    {
                        var cmdBlock = block;
                        <div class="space-y-1">
                            <div class="flex items-center gap-2">
                                <span class="select-none text-emerald-400">$</span>
                                <span class="text-background">@cmdBlock.Cmd</span>
                                <span
                                    aria-hidden="true"
                                    class="@(Cn.Merge(
                                        "ml-auto size-1.5 shrink-0 rounded-full",
                                        cmdBlock.Status == "success" ? "bg-emerald-400" : "bg-blue-400"
                                    ))"
                                ></span>
                            </div>
                            <div class="space-y-0.5 pl-4">
                                @foreach (var line in cmdBlock.Output)
                                {
                                    <div class="whitespace-pre text-background/55">@line</div>
                                }
                            </div>
                        </div>
                    }
                    <div class="flex items-center gap-2 pt-1">
                        <span class="select-none text-emerald-400">$</span>
                        <span class="inline-block h-4 w-2 animate-pulse bg-background/70"></span>
                    </div>
                </div>
            </div>
        </div>

        @* Value props *@
        <div class="mt-8 grid gap-4 md:grid-cols-3">
            @foreach (var prop in _valueProps)
            {
                <div class="rounded-lg border bg-card p-5">
                    <div class="flex size-9 items-center justify-center rounded-md border bg-muted/50">
                        <LucideIconCn Name="@prop.IconName" Size="16" Class="size-4 text-foreground" />
                    </div>
                    <h3 class="mt-4 text-sm font-medium text-foreground">@prop.Title</h3>
                    <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                        @prop.Description
                    </p>
                    <div class="mt-4 flex items-center gap-1.5 text-[11px] font-medium text-emerald-600">
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Included in every plan</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
