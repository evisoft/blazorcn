@* ============================================================
   Block: features-before-after-visual
   Title: Features Before After Visual
   Description: A features block showing transformation from before to after states
   Dependencies: LucideArrowRightCn
   Source: original/blocks/features/features-before-after-visual.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">The Transformation</h2>
            <p class="mt-1 text-xs text-muted-foreground">See how teams work before and after</p>
        </div>

        @for (var i = 0; i < _transformations.Length; i++)
        {
            var transformation = _transformations[i];
            <div class="@(i < _transformations.Length - 1 ? "border-b" : "")">
                <div class="grid gap-3 px-4 py-3 sm:grid-cols-[1fr,auto,1fr]">
                    <div class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground/50"></span>
                        <p class="text-xs text-muted-foreground">@transformation.Before</p>
                    </div>
                    <div class="flex items-center justify-center">
                        <LucideArrowRightCn Class="h-4 w-4 text-muted-foreground/60" Size="16" />
                    </div>
                    <div class="flex items-start gap-2">
                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                        <p class="text-xs font-medium">@transformation.After</p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Transformation(string Before, string After);

    private static readonly Transformation[] _transformations =
    [
        new("Manually copying data between 5 different tools", "Single source of truth with automatic sync"),
        new("3-day deployment cycles with manual approvals", "Ship to production in 8 minutes with CI/CD"),
        new("Supporting 5 frameworks with separate codebases", "Universal components that work everywhere"),
        new("Spending 40% of time on infrastructure maintenance", "Fully managed with automatic scaling and updates"),
    ];
}
