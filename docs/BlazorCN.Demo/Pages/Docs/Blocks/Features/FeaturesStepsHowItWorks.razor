@* ============================================================
   Block: features-steps-how-it-works
   Title: Features Steps How It Works
   Description: Three-step how-it-works section with numbered steps, descriptions, and visual flow
   Dependencies: None
   Source: original/blocks/features/features-steps-how-it-works.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">How it works</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Get started in three simple steps -- no credit card required</p>
        </div>

        <div>
            @for (var i = 0; i < _steps.Length; i++)
            {
                var step = _steps[i];
                <div class="@Cn.Merge("flex gap-3 px-4 py-3", i < _steps.Length - 1 ? "border-b" : "")">
                    <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-medium text-primary-foreground">
                        @(i + 1)
                    </div>
                    <div class="min-w-0">
                        <p class="text-sm font-medium">@step.Title</p>
                        <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">@step.Description</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Step(string Title, string Description);

    private static readonly Step[] _steps =
    [
        new("Upload your files", "Drag and drop any file type\u2014documents, images, videos, or archives. We handle automatic processing and virus scanning."),
        new("Configure sharing", "Set permissions, expiration dates, and password protection. Generate a shareable link or invite collaborators directly."),
        new("Share instantly", "Your files are live in seconds with global CDN delivery. Recipients can preview, comment, and download without an account."),
    ];
}
