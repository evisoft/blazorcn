@* ============================================================
   Block: features-hover-accordion-mockup-split
   Title: FeaturesHoverAccordionMockupSplit
   Description: A hover-triggered accordion split feature section for React and Next.js with onMouseEnter row expansion and a synced crosshair mockup placeholder built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-hover-accordion-mockup-split.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">
    <div class="mb-10 max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Hover to explore
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Point at any capability, see it in action
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        No clicks required. Move your cursor down the list and each feature expands with a
        synced product mockup on the right.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
      @* Left — hover-triggered accordion list *@
      <ul class="flex flex-col">
        @foreach (var feat in _features)
        {
          var feature = feat;
          var isActive = feature.Id == _activeId;
          <li
            @onmouseenter="@(() => _activeId = feature.Id)"
            @onfocus="@(() => _activeId = feature.Id)"
            class="group cursor-pointer border-b border-border/60 py-4 last:border-b-0"
          >
            <div class="flex items-start gap-4">
              <span
                aria-hidden="true"
                class="@Cn.Merge(
                  "mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg border transition-colors duration-200",
                  isActive
                    ? "border-foreground/20 bg-foreground text-background"
                    : "border-border bg-muted/40 text-muted-foreground"
                )"
              >
                <LucideIconCn Name="@feature.IconName" Size="16" Class="size-4" />
              </span>
              <div class="min-w-0 flex-1">
                <h3 class="@Cn.Merge(
                  "text-base font-semibold transition-colors duration-200",
                  isActive ? "text-foreground" : "text-muted-foreground"
                )">
                  @feature.Title
                </h3>
                @if (isActive)
                {
                  <p class="mt-2 overflow-hidden text-sm leading-relaxed text-muted-foreground">
                    @feature.Description
                  </p>
                }
              </div>
            </div>
          </li>
        }
      </ul>

      @* Right — synced crosshair mockup *@
      <div class="flex aspect-[4/3] w-full items-center justify-center overflow-hidden rounded-xl bg-muted lg:aspect-auto lg:min-h-[420px]">
        @{ var activeFeature = _features.FirstOrDefault(f => f.Id == _activeId) ?? _features[0]; }
        <div class="relative flex size-full items-center justify-center">
          <div class="absolute size-32 rounded-full border border-muted-foreground/[0.06]" />
          <div class="absolute size-20 rounded-full border border-muted-foreground/[0.08]" />
          <div class="absolute h-px w-40 bg-muted-foreground/[0.06]" />
          <div class="absolute h-40 w-px bg-muted-foreground/[0.06]" />
          <div class="relative flex flex-col items-center gap-3">
            <div class="flex size-10 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
              <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/50" />
            </div>
            <span class="rounded-full border border-border/60 bg-background/80 px-3 py-1 font-mono text-[11px] text-muted-foreground">
              @activeFeature.Id
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

@code {
    private string _activeId = "realtime-sync";

    private record Feature(string Id, string Title, string Description, string IconName);

    private static readonly Feature[] _features =
    [
        new Feature("realtime-sync", "Real-time multiplayer sync",
            "Operational transforms keep every collaborator's cursor, selection, and edit in lockstep under 40 milliseconds, even across transatlantic connections.",
            "bolt"),
        new Feature("workflow-automation", "Event-driven workflows",
            "Trigger downstream actions from any field change with a visual rule builder that compiles to deterministic server-side handlers, not brittle client scripts.",
            "workflow"),
        new Feature("performance-budget", "Sub-100ms interactions",
            "An edge-resident cache and local-first data layer make every click feel instantaneous, with a hard performance budget enforced in CI on every pull request.",
            "gauge"),
        new Feature("granular-access", "Row-level access control",
            "Define permission rules per record, per field, or per relationship without writing policy code. SOC 2 audit logs capture every read and write automatically.",
            "lock"),
        new Feature("ai-suggestions", "In-context AI suggestions",
            "A private model trained on your workspace surfaces next-best actions inline, never leaving your data boundary and never needing a separate AI panel.",
            "sparkles"),
    ];
}
