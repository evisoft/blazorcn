@* ============================================================
   Block: features-index-card-file-rolodex
   Title: FeaturesIndexCardFileRolodex
   Description: A rolodex index card features section for React and Next.js with fanned paper cards, punch-hole icons, ruled line backgrounds, and card number stamps built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-index-card-file-rolodex.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">

  @* Headline cluster *@
  <div class="text-center">
    <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-muted-foreground">
      <LucideIconCn Name="library" Size="12" Class="size-3" />
      Catalog No. 001 – 063
    </span>
    <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
      Filed, indexed, and at your fingertips.
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
      Every capability lives on its own index card — fan through the rolodex to see how
      discovery, navigation, and archival weave together.
    </p>
  </div>

  @* Rolodex *@
  <div class="mt-14 flex flex-col items-center justify-center gap-6 sm:flex-row sm:items-start sm:gap-0">
    @foreach (var card in _cards)
    {
      var c = card;
      var i = Array.IndexOf(_cards, c);
      <article class="@Cn.Merge("relative h-64 w-56 shrink-0 rounded-md border bg-card shadow-md hover:z-10 hover:-translate-y-1 transition-transform", _rotations[i], _offsets[i])">

        @* Punch hole *@
        <div
          aria-hidden="true"
          class="absolute left-1/2 top-2 size-3 -translate-x-1/2 rounded-full border border-border bg-background"
        />

        @* Corner stamp *@
        <div
          aria-hidden="true"
          class="absolute right-2 top-2 flex size-8 items-center justify-center rounded-sm border border-dashed border-border/80 font-mono text-[9px] font-bold uppercase tracking-wider text-muted-foreground"
        >
          <div class="flex flex-col items-center leading-none">
            <LucideIconCn Name="stamp" Size="10" Class="mb-0.5 size-2.5" />
            <span>@c.Index</span>
          </div>
        </div>

        @* Category *@
        <div class="absolute left-4 top-7 text-[9px] font-semibold uppercase tracking-[0.18em] text-muted-foreground">
          @c.Category
        </div>

        @* Icon + title *@
        <div class="flex flex-col items-start gap-2 px-4 pt-12">
          <span class="flex size-8 items-center justify-center rounded-md border bg-background">
            <LucideIconCn Name="@c.IconName" Size="16" Class="size-4 text-foreground" />
          </span>
          <h3 class="font-serif text-lg font-semibold leading-tight text-foreground">
            @c.Title
          </h3>
        </div>

        @* Ruled body *@
        <div class="relative mt-4 h-20 px-4">
          @* Ruled lines *@
          <div aria-hidden="true" class="pointer-events-none absolute inset-x-4 top-20 space-y-3">
            <div class="h-px w-full bg-border/70"></div>
            <div class="h-px w-full bg-border/70"></div>
            <div class="h-px w-full bg-border/70"></div>
            <div class="h-px w-full bg-border/70"></div>
          </div>
          <p class="relative font-serif text-[11px] leading-[1.5rem] text-muted-foreground">
            @c.Description
          </p>
        </div>

        @* Bottom edge note *@
        <div class="absolute inset-x-4 bottom-3 flex items-center justify-between border-t border-dashed pt-2 font-mono text-[9px] uppercase tracking-wider text-muted-foreground">
          <span>Filed</span>
          <span>Rev. 04</span>
        </div>

      </article>
    }
  </div>

  @* CTAs *@
  <div class="mt-14 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
    <ButtonCn Class="w-full sm:w-[250px]">Browse the catalog</ButtonCn>
    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[250px]">Download the index</ButtonCn>
  </div>

</section>

@code {
    private record CardItem(string Id, string IconName, string Title, string Category, string Description, string Index);

    private static readonly CardItem[] _cards =
    [
        new("catalog", "library", "Catalog Search", "Discovery",
            "Index every file with full-text ranking across the whole workspace.", "001"),
        new("compass", "compass", "Smart Routing", "Navigation",
            "Shortest path between collaborators, suggestions, and saved views.", "014"),
        new("bookmarks", "bookmark", "Saved Sets", "Organize",
            "Persistent reading lists that sync across devices in real time.", "027"),
        new("scroll", "scroll-text", "Revision History", "Archive",
            "Every edit, every day — a signed scroll of your workspace.", "042"),
        new("quill", "feather", "Annotated Notes", "Craft",
            "Margin notes, highlights, and pinned quotes stitched into one thread.", "063"),
    ];

    private static readonly string[] _rotations =
    [
        "sm:-rotate-3",
        "sm:rotate-1",
        "sm:-rotate-1",
        "sm:rotate-2",
        "sm:-rotate-2",
    ];

    private static readonly string[] _offsets =
    [
        "sm:-ml-0",
        "sm:-ml-8",
        "sm:-ml-8",
        "sm:-ml-8",
        "sm:-ml-8",
    ];
}
