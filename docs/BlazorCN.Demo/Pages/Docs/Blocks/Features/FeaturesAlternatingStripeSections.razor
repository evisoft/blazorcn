@* ============================================================
   Block: features-alternating-stripe-sections
   Title: FeaturesAlternatingStripeSections
   Description: An alternating stripe sections features layout for React and Next.js with full-width magazine-style rhythm bands, no outer card wrapper, and a final centered tri-column mini-grid built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-alternating-stripe-sections.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border">

        @* Top headline band *@
        <div class="bg-card px-6 py-14 text-center sm:px-10 sm:py-16">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                The platform
            </p>
            <h2 class="mx-auto mt-3 max-w-2xl text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
                Three layers of infrastructure, read top to bottom
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Each stripe below is a separate layer of the platform. Skim the headlines or settle in
                and read — the rhythm is designed to reward both.
            </p>
        </div>

        @* Stripe 1 — icon-left text + image-right (bg-muted/30) *@
        <div class="bg-muted/30 px-6 py-14 sm:px-10 lg:px-14">
            <div class="grid gap-10 lg:grid-cols-[6fr_5fr] lg:items-center lg:gap-14">
                <div class="flex items-start gap-5">
                    <div aria-hidden="true" class="flex size-12 shrink-0 items-center justify-center rounded-xl border bg-card">
                        <LucideIconCn Name="rocket" Size="20" Class="size-5 text-foreground" />
                    </div>
                    <div>
                        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                            @_stripeOne.Eyebrow
                        </p>
                        <h3 class="mt-2 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
                            @_stripeOne.Title
                        </h3>
                        <p class="mt-4 max-w-md text-sm leading-relaxed text-muted-foreground sm:text-base">
                            @_stripeOne.Description
                        </p>
                    </div>
                </div>
                <ImagePlaceholder />
            </div>
        </div>

        @* Stripe 2 — image-left + text-right (bg-card) *@
        <div class="bg-card px-6 py-14 sm:px-10 lg:px-14">
            <div class="grid gap-10 lg:grid-cols-[5fr_6fr] lg:items-center lg:gap-14">
                <div class="lg:order-first">
                    <ImagePlaceholder />
                </div>
                <div class="flex items-start gap-5">
                    <div aria-hidden="true" class="flex size-12 shrink-0 items-center justify-center rounded-xl border bg-muted/50">
                        <LucideIconCn Name="git-branch" Size="20" Class="size-5 text-foreground" />
                    </div>
                    <div>
                        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                            @_stripeTwo.Eyebrow
                        </p>
                        <h3 class="mt-2 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
                            @_stripeTwo.Title
                        </h3>
                        <p class="mt-4 max-w-md text-sm leading-relaxed text-muted-foreground sm:text-base">
                            @_stripeTwo.Description
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @* Stripe 3 — centered layout + tri-column mini-grid (bg-muted/30) *@
        <div class="bg-muted/30 px-6 py-14 sm:px-10 sm:py-16 lg:px-14">
            <div class="text-center">
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    @_stripeThree.Eyebrow
                </p>
                <h3 class="mx-auto mt-3 max-w-xl text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
                    @_stripeThree.Title
                </h3>
                <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-muted-foreground sm:text-base">
                    @_stripeThree.Description
                </p>
            </div>

            <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-3 sm:gap-4">
                @foreach (var feat in _stripeThree.Features)
                {
                    <div class="rounded-xl border bg-card p-5">
                        <div aria-hidden="true" class="flex size-10 items-center justify-center rounded-lg bg-muted">
                            <LucideIconCn Name="@feat.IconName" Size="20" Class="size-5 text-foreground" />
                        </div>
                        <h4 class="mt-4 text-base font-semibold text-foreground">@feat.Title</h4>
                        <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                            @feat.Description
                        </p>
                    </div>
                }
            </div>

            @* Final CTA pair *@
            <div class="mt-12 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-center">
                <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">Read the docs</ButtonCn>
            </div>
        </div>

    </div>
</section>

@* Inline helper component *@
@code {
    private record StripeData(string Eyebrow, string Title, string Description);

    private record MiniFeature(string Id, string Title, string Description, string IconName);

    private record StripeThreeData(string Eyebrow, string Title, string Description, MiniFeature[] Features);

    private static readonly StripeData _stripeOne = new(
        "Shipping",
        "Push to main and be live before the CI badge turns green",
        "Every commit builds in parallel across 14 edge regions with immutable artifacts and one-click rollback. Preview URLs spin up per pull request in under eight seconds so reviewers test real behavior instead of local mocks."
    );

    private static readonly StripeData _stripeTwo = new(
        "Collaboration",
        "A branch is a fully isolated environment, not just a diff",
        "Feature branches inherit a copy-on-write database, queue workers, and edge caches cloned from production in seconds. Merge the PR and the environment tears down automatically — no leftover resources, no stale snapshots."
    );

    private static readonly StripeThreeData _stripeThree = new(
        "Under the hood",
        "Primitives that stay out of your way",
        "A core set of low-level capabilities you can compose or ignore. Each primitive is independently versioned, fully typed, and safe to adopt incrementally.",
        [
            new("speed", "Sub-50ms cold starts",
                "A runtime sliced for instant boot on every region, with warm pools for burst traffic.",
                "zap"),
            new("layers", "Composable layers",
                "Adopt one primitive or all of them — middleware, cache, queues, and CDN ship standalone.",
                "layers"),
            new("guarantees", "Enterprise guarantees",
                "SOC 2 Type II, SAML 2.0, SCIM, and a 99.99% uptime SLA included on every paid plan.",
                "shield-check"),
        ]
    );
}
