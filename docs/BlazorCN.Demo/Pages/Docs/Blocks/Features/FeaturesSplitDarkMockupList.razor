@* ============================================================
   Block: features-split-dark-mockup-list
   Title: FeaturesSplitDarkMockupList
   Description: A high-contrast split features section for React and Next.js with a dark inverted product mockup panel on the left and a light eyebrow, headline, four icon feature rows, and CTA on the right built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-split-dark-mockup-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">

      @* Left: Dark inverted mockup panel *@
      <div aria-hidden="true" class="overflow-hidden rounded-xl bg-foreground p-6 text-background shadow-sm">
        @* Mini UI hints *@
        <div class="mb-4 flex items-center gap-2">
          <div class="flex items-center gap-1.5">
            <span class="size-2.5 rounded-full bg-background/20"></span>
            <span class="size-2.5 rounded-full bg-background/20"></span>
            <span class="size-2.5 rounded-full bg-background/20"></span>
          </div>
          <div class="ml-2 h-1.5 w-20 rounded-full bg-background/15"></div>
          <div class="h-1.5 w-14 rounded-full bg-background/10"></div>
          <div class="ml-auto flex items-center gap-1">
            <span class="size-1.5 rounded-full bg-emerald-400"></span>
            <span class="font-mono text-[10px] text-background/50">live</span>
          </div>
        </div>

        @* Dark crosshair placeholder *@
        <div class="flex aspect-[4/3] w-full items-center justify-center rounded-lg bg-background/[0.06]">
          <div class="relative flex items-center justify-center">
            <div class="absolute size-24 rounded-full border border-background/[0.06]"></div>
            <div class="absolute size-14 rounded-full border border-background/[0.08]"></div>
            <div class="absolute h-px w-32 bg-background/[0.06]"></div>
            <div class="absolute h-32 w-px bg-background/[0.06]"></div>
            <div class="flex size-8 items-center justify-center rounded-full border border-background/[0.08] bg-background/10">
              <LucideIconCn Name="image" Size="16" Class="size-4 text-background/30" />
            </div>
          </div>
        </div>

        @* Footer hint row *@
        <div class="mt-4 flex items-center gap-3">
          <div class="h-1.5 flex-1 rounded-full bg-background/10"></div>
          <div class="h-1.5 w-10 rounded-full bg-background/15"></div>
          <div class="h-1.5 w-6 rounded-full bg-background/10"></div>
        </div>
      </div>

      @* Right: Light headline + feature list + CTA *@
      <div>
        <div>
          <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">@_headline.Eyebrow</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">@_headline.Title</h2>
          <p class="mt-5 max-w-lg text-base leading-relaxed text-muted-foreground">@_headline.Subtitle</p>
        </div>

        <div class="mt-8 space-y-5">
          @foreach (var feature in _features)
          {
            <div class="flex items-start gap-3">
              <span aria-hidden="true" class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg bg-muted">
                <LucideIconCn Name="@feature.IconName" Size="16" Class="size-4 text-foreground" />
              </span>
              <div>
                <h3 class="text-sm font-semibold text-foreground">@feature.Title</h3>
                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">@feature.Description</p>
              </div>
            </div>
          }
        </div>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <ButtonCn Class="w-full sm:w-[210px]">Start shipping</ButtonCn>
          <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[250px]">Read the changelog</ButtonCn>
        </div>
      </div>

    </div>
  </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureItem(string Id, string IconName, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        "For developer teams",
        "A product surface built by people who ship",
        "The details matter when you're staring at the same interface for eight hours a day. Every pixel of this product was tuned by the engineers who use it themselves."
    );

    private static readonly FeatureItem[] _features =
    [
        new("git-native",      "git-branch",  "Git-native workflows",        "Every change is a branch. Every review is a pull request. Roll forward, roll back, and diff against any point in history."),
        new("terminal-first",  "terminal",    "Terminal-first control",       "A scriptable CLI that mirrors every dashboard action, so you can automate what you used to click through manually."),
        new("instant-preview", "zap",         "Instant preview deploys",      "Every commit spins up a throwaway preview environment in under 30 seconds so reviewers can click, not imagine."),
        new("one-click-ship",  "rocket",      "One-click production ship",    "Promote a preview to production with a single command and a single audit log entry — no release checklist theater."),
    ];
}
