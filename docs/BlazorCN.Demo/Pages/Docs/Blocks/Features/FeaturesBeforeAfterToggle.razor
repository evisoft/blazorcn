@* ============================================================
   Block: features-before-after-toggle
   Title: FeaturesBeforeAfterToggle
   Description: A before after toggle features section for React and Next.js with a single large swapping mockup panel, a PillTabs state switch, and a dashboard redesign story built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-before-after-toggle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10">

        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Redesign
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                Before / After
            </h2>
            <p class="mx-auto mt-3 max-w-lg text-base text-muted-foreground leading-relaxed">
                Two years of Orbit dashboard feedback, rebuilt around one primary metric and a command
                menu. Toggle the switch to see what changed.
            </p>
        </div>

        @* PillTabs toggle *@
        <div class="mt-7 flex justify-center">
            <div role="tablist" aria-label="Before or after redesign" class="inline-flex items-center gap-1 rounded-full border bg-muted p-1">
                @foreach (var tab in _toggleStates)
                {
                    var t = tab;
                    <button
                        role="tab"
                        aria-selected="@(_state == t ? "true" : "false")"
                        class="@Cn.Merge("rounded-full px-4 py-1 text-sm font-medium transition-colors", _state == t ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _state = t)">
                        @_stateLabels[t]
                    </button>
                }
            </div>
        </div>

        @* Mockup panel *@
        <div class="relative mt-7 overflow-hidden rounded-xl border bg-muted/20">
            <div class="aspect-[16/10] w-full">
                @if (_state == "before")
                {
                    @* Before Mockup *@
                    <div aria-hidden="true" class="flex h-full w-full overflow-hidden bg-muted/40">
                        @* Cluttered sidebar *@
                        <div class="hidden w-36 shrink-0 flex-col gap-1.5 border-r bg-muted/60 p-2.5 sm:flex">
                            <div class="flex items-center gap-1.5">
                                <div class="size-4 rounded-sm bg-foreground/20"></div>
                                <div class="h-2 w-12 rounded-sm bg-foreground/15"></div>
                            </div>
                            <div class="mt-1 h-1.5 w-20 rounded-sm bg-foreground/10"></div>
                            @for (var i = 0; i < 11; i++)
                            {
                                var idx = i;
                                <div class="flex items-center gap-1.5 rounded-sm px-1 py-1">
                                    <div class="size-2 rounded-sm bg-foreground/15"></div>
                                    <div class="h-1.5 flex-1 rounded-sm bg-foreground/10"></div>
                                    @if (idx % 3 == 0)
                                    {
                                        <div class="size-1.5 rounded-full bg-foreground/25"></div>
                                    }
                                </div>
                            }
                            <div class="mt-auto h-4 rounded-sm bg-foreground/10"></div>
                        </div>

                        @* Main cluttered canvas *@
                        <div class="relative flex-1 p-3">
                            @* Top bar *@
                            <div class="flex items-center gap-2 border-b pb-2">
                                <div class="h-2 w-24 rounded-sm bg-foreground/20"></div>
                                <div class="ml-auto flex items-center gap-1.5">
                                    <div class="h-5 w-14 rounded-sm bg-foreground/10"></div>
                                    <div class="h-5 w-5 rounded-sm bg-foreground/10"></div>
                                    <div class="h-5 w-5 rounded-sm bg-foreground/15"></div>
                                    <div class="h-5 w-5 rounded-full bg-foreground/20"></div>
                                </div>
                            </div>

                            @* Warning toasts *@
                            <div class="absolute right-3 top-9 z-10 flex w-44 flex-col gap-1.5">
                                @for (var i = 0; i < 3; i++)
                                {
                                    <div class="flex items-center gap-1.5 rounded-md border bg-card px-2 py-1.5 shadow-sm">
                                        <LucideAlertTriangleCn Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                                        <div class="h-1.5 flex-1 rounded-sm bg-foreground/20"></div>
                                        <LucideXCn Size="10" Class="size-2.5 shrink-0 text-muted-foreground" />
                                    </div>
                                }
                            </div>

                            @* Dense stat grid *@
                            <div class="mt-3 grid grid-cols-4 gap-1.5">
                                @for (var i = 0; i < 8; i++)
                                {
                                    <div class="space-y-1 rounded-md border bg-card p-1.5">
                                        <div class="h-1 w-6 rounded-sm bg-foreground/15"></div>
                                        <div class="h-2 w-8 rounded-sm bg-foreground/30"></div>
                                        <div class="h-1 w-5 rounded-sm bg-foreground/10"></div>
                                    </div>
                                }
                            </div>

                            @* Chart placeholder *@
                            <div class="mt-2 flex h-14 items-end gap-1 rounded-md border bg-card p-1.5">
                                @for (var i = 0; i < 18; i++)
                                {
                                    var barIdx = i;
                                    <div class="flex-1 rounded-sm bg-foreground/15" style="@($"height:{20 + ((barIdx * 37) % 60)}%")"></div>
                                }
                            </div>

                            @* Row list *@
                            <div class="mt-2 space-y-1">
                                @for (var i = 0; i < 3; i++)
                                {
                                    <div class="flex items-center gap-1.5 rounded-sm border bg-card px-2 py-1.5">
                                        <div class="size-3 rounded-full bg-foreground/20"></div>
                                        <div class="h-1.5 w-24 rounded-sm bg-foreground/15"></div>
                                        <div class="ml-auto flex gap-1">
                                            <div class="h-3 w-6 rounded-sm bg-foreground/10"></div>
                                            <div class="h-3 w-6 rounded-sm bg-foreground/10"></div>
                                            <div class="h-3 w-3 rounded-sm bg-foreground/15"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    @* After Mockup *@
                    <div aria-hidden="true" class="flex h-full w-full overflow-hidden bg-background">
                        @* Calm sidebar *@
                        <div class="hidden w-40 shrink-0 flex-col gap-4 border-r bg-muted/20 p-4 sm:flex">
                            <div class="flex items-center gap-2">
                                <div class="size-5 rounded-md bg-foreground/80"></div>
                                <div class="h-2 w-14 rounded-sm bg-foreground/70"></div>
                            </div>

                            <div class="flex items-center gap-2 rounded-md border bg-background px-2 py-1.5">
                                <LucideSearchCn Size="12" Class="size-3 text-muted-foreground" />
                                <div class="h-1.5 flex-1 rounded-sm bg-foreground/15"></div>
                                <span class="text-[9px] font-mono text-muted-foreground">K</span>
                            </div>

                            <div class="space-y-1">
                                <div class="h-1.5 w-16 rounded-sm bg-foreground/80"></div>
                                <div class="h-1.5 w-12 rounded-sm bg-foreground/15"></div>
                                <div class="h-1.5 w-14 rounded-sm bg-foreground/15"></div>
                                <div class="h-1.5 w-10 rounded-sm bg-foreground/15"></div>
                            </div>
                        </div>

                        @* Main canvas *@
                        <div class="flex-1 p-5">
                            <div class="flex items-center gap-2 pb-1">
                                <div class="h-1.5 w-16 rounded-sm bg-foreground/30"></div>
                            </div>

                            @* Primary metric *@
                            <div class="mt-3">
                                <div class="h-2 w-20 rounded-sm bg-foreground/20"></div>
                                <div class="mt-2 flex items-baseline gap-2">
                                    <div class="h-6 w-24 rounded-sm bg-foreground/85"></div>
                                    <div class="h-2 w-10 rounded-sm bg-foreground/20"></div>
                                </div>
                            </div>

                            @* Minimal chart *@
                            <div class="mt-5 flex h-16 items-end gap-1.5">
                                @foreach (var h in _barHeights)
                                {
                                    <div class="flex-1 rounded-sm bg-foreground/80" style="@($"height:{h}%")"></div>
                                }
                            </div>

                            @* Two calm cards *@
                            <div class="mt-4 grid grid-cols-2 gap-2">
                                <div class="rounded-md border bg-card p-2.5">
                                    <div class="h-1.5 w-10 rounded-sm bg-foreground/15"></div>
                                    <div class="mt-1.5 h-3 w-16 rounded-sm bg-foreground/70"></div>
                                </div>
                                <div class="rounded-md border bg-card p-2.5">
                                    <div class="h-1.5 w-10 rounded-sm bg-foreground/15"></div>
                                    <div class="mt-1.5 h-3 w-16 rounded-sm bg-foreground/70"></div>
                                </div>
                            </div>
                        </div>

                        @* Calm right rail *@
                        <div class="hidden w-14 shrink-0 items-start justify-center border-l bg-muted/20 pt-5 md:flex">
                            <LucideBellCn Size="14" Class="size-3.5 text-muted-foreground" />
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Caption *@
        <h3 class="mt-6 text-center text-sm text-muted-foreground leading-relaxed sm:text-base">
            @_states[_state].Caption
        </h3>

        @* Bullet grid *@
        <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-x-6 sm:gap-y-3">
            @foreach (var bullet in _states[_state].Bullets)
            {
                <li class="flex items-start gap-2.5" style="list-style:none">
                    @if (_state == "after")
                    {
                        <LucideCheckCn aria-hidden="true" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                    }
                    else
                    {
                        <LucideXCn aria-hidden="true" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-muted-foreground" StrokeWidth="3" />
                    }
                    <span class="text-sm leading-relaxed text-muted-foreground">@bullet</span>
                </li>
            }
        </div>

        @* CTA row *@
        <div class="mt-9 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-center">
            <ButtonCn Class="w-full sm:w-[230px]">Start free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[260px]">Read the case study</ButtonCn>
        </div>

    </div>
</section>

@code {
    private string _state = "after";

    private static readonly string[] _toggleStates = ["before", "after"];

    private static readonly Dictionary<string, string> _stateLabels = new()
    {
        ["before"] = "Before",
        ["after"] = "After",
    };

    private static readonly int[] _barHeights = [48, 62, 55, 74, 68, 82, 78, 91, 85, 96, 89, 100];

    private record StateContent(string Caption, string[] Bullets);

    private static readonly Dictionary<string, StateContent> _states = new()
    {
        ["before"] = new StateContent(
            "Legacy Orbit dashboard, Q3 2025 — seven panels fighting for attention, three warning toasts, and a 94-item sidebar nobody could navigate.",
            [
                "Seven stat panels competing above the fold",
                "Three stacked warning toasts on every load",
                "94-item sidebar with no grouping or search",
                "Inline noise from badges, dots, and chips",
            ]
        ),
        ["after"] = new StateContent(
            "Orbit 3.0 dashboard, Q1 2026 — one primary metric, a calm two-column layout, and a command-menu sidebar that respects the scan.",
            [
                "Single primary metric at the top of the scan",
                "Warnings collapsed into one contextual card",
                "Sidebar reduced to 8 sections with command menu",
                "Typographic hierarchy replaces colored noise",
            ]
        ),
    };
}
