@* ============================================================
   Block: features-tabbed-hero-feature-split
   Title: FeaturesTabbedHeroFeatureSplit
   Description: A tabbed hero feature split section for React and Next.js with centered eyebrow headline, PillTabs navigation, and a large animated split card showing a feature title, description, benefit checklist, and CTA beside a crosshair image placeholder built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-tabbed-hero-feature-split.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Centered headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Capabilities
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                One platform, every workflow your team runs on
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Three pillars that replace a dozen single-purpose tools. Pick a capability to see what it unlocks for product, engineering, and operations teams.
            </p>
        </div>

        @* Tab navigation *@
        <div class="mt-8 flex justify-center">
            <div class="inline-flex items-center gap-1 rounded-full border bg-muted p-1" role="tablist" aria-label="Capability">
                @foreach (var tab in _tabs)
                {
                    var tabId = tab.Id;
                    <button
                        role="tab"
                        aria-selected="@(_activeTab == tabId ? "true" : "false")"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _activeTab == tabId ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => SetActiveTab(tabId))">
                        @tab.Label
                    </button>
                }
            </div>
        </div>

        @* Split card *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            <div class="grid lg:grid-cols-2">
                @* Left — text content *@
                @{
                    var active = _features[_activeTab];
                }
                <div class="flex flex-col justify-center p-6 sm:p-10 lg:p-12">
                    <h3 class="text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
                        @active.Title
                    </h3>
                    <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                        @active.Description
                    </p>
                    <ul class="mt-6 space-y-3">
                        @foreach (var benefit in active.Benefits)
                        {
                            <li class="flex items-start gap-2.5">
                                <span aria-hidden="true" class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                    <LucideIconCn Name="check" Size="12" StrokeWidth="3" Class="size-3 text-emerald-600 dark:text-emerald-500" />
                                </span>
                                <span class="text-sm leading-relaxed text-foreground">@benefit</span>
                            </li>
                        }
                    </ul>
                    <div class="mt-8">
                        <ButtonCn Class="w-full sm:w-[235px]">@active.Cta</ButtonCn>
                    </div>
                </div>

                @* Right — image placeholder *@
                <div class="relative flex aspect-square w-full items-center justify-center bg-muted lg:aspect-auto lg:border-l">
                    <div class="relative flex items-center justify-center">
                        <div aria-hidden="true" class="absolute size-40 rounded-full border border-muted-foreground/[0.06]"></div>
                        <div aria-hidden="true" class="absolute size-24 rounded-full border border-muted-foreground/[0.08]"></div>
                        <div aria-hidden="true" class="absolute h-px w-56 bg-muted-foreground/[0.06]"></div>
                        <div aria-hidden="true" class="absolute h-56 w-px bg-muted-foreground/[0.06]"></div>
                        <div class="flex size-10 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record TabItem(string Id, string Label);
    private record FeatureContent(string Title, string Description, string[] Benefits, string Cta);

    private static readonly TabItem[] _tabs =
    [
        new("platform", "Platform"),
        new("automation", "Automation"),
        new("insights", "Insights"),
    ];

    private static readonly Dictionary<string, FeatureContent> _features = new()
    {
        ["platform"] = new FeatureContent(
            "A unified workspace for every contributor",
            "Bring product, design, and engineering into the same canvas so decisions, specs, and review history live one click away from the work itself.",
            [
                "Real-time multiplayer cursors with granular permissions",
                "Nested projects with inheritable access control",
                "Slack and Linear sync with two-way status updates",
                "Audit log retained for seven years on every paid plan",
            ],
            "Explore the platform"),
        ["automation"] = new FeatureContent(
            "Automations that run before your team wakes up",
            "Trigger workflows from any field change, schedule nightly batches, and chain actions across tools without leaving the editor or writing a line of YAML.",
            [
                "Visual workflow builder with branch and merge nodes",
                "Built-in retries, rate limits, and dead-letter queues",
                "One hundred plus prebuilt connectors to SaaS tools",
                "Secrets stored in a FIPS 140-2 compliant vault",
            ],
            "See automations"),
        ["insights"] = new FeatureContent(
            "Insights your leadership actually reads",
            "Dashboards assembled from live data, not snapshots. Share a single URL that always reflects the latest truth and never breaks on a schema change.",
            [
                "Live dashboards with sub-second query latency",
                "Scheduled digests delivered to Slack and email",
                "Drill-down from any chart to the raw event stream",
                "Share publicly or gate with row-level permissions",
            ],
            "View insights demo"),
    };

    private string _activeTab = "platform";

    private void SetActiveTab(string tab)
    {
        _activeTab = tab;
    }
}
