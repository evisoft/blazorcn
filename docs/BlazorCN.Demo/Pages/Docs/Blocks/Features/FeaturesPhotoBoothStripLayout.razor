@* ============================================================
   Block: features-photo-booth-strip-layout
   Title: FeaturesPhotoBoothStripLayout
   Description: A vertical photo booth strip features section for React and Next.js with four polaroid style photos, tape corners, handwritten captions, and date stamp footer, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-photo-booth-strip-layout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Heading *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                <LucideIconCn Name="camera" Size="14" Class="mr-1.5 inline size-3.5" aria-hidden="true" />
                The memory strip
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Features worth keeping.
            </h2>
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                Some products feel like a moment you want to pin to the fridge. These are the four
                scenes we hear about most.
            </p>
        </div>

        @* Photo booth strip *@
        <div class="mt-12 flex justify-center">
            <div class="relative w-full max-w-xs">
                @* Drop shadow behind strip *@
                <div aria-hidden="true" class="absolute inset-x-2 top-3 bottom-0 -z-10 rounded-md bg-foreground/10 blur-lg"></div>

                @* Tape pieces at top *@
                <div aria-hidden="true" class="pointer-events-none absolute -top-3 left-0 right-0 h-5">
                    @foreach (var tape in _tapePieces)
                    {
                        <div class="absolute h-5 w-10 border border-foreground/20 bg-foreground/10 shadow-sm"
                             style="@($"left:{tape.Left};transform:rotate({tape.Rotate})")"></div>
                    }
                </div>

                @* The strip itself *@
                <div class="relative space-y-3 rounded-md border bg-card p-3 shadow-xl">
                    @* Vertical shadow stripe down the middle *@
                    <div aria-hidden="true" class="pointer-events-none absolute inset-y-3 left-1/2 w-px -translate-x-1/2 bg-foreground/[0.04]"></div>

                    @foreach (var photo in _photos)
                    {
                        var idx = System.Array.IndexOf(_photos, photo);
                        <div class="relative">
                            @* Polaroid frame *@
                            <div class="border border-border bg-background p-3 pb-5 shadow-sm">
                                @* "Photo" area *@
                                <div class="relative flex aspect-[4/3] items-center justify-center overflow-hidden border border-foreground/10 bg-muted/40">
                                    @* Grain dots *@
                                    <div aria-hidden="true" class="absolute inset-0 opacity-30">
                                        <div class="absolute left-2 top-2 size-0.5 rounded-full bg-foreground/40"></div>
                                        <div class="absolute right-3 top-4 size-0.5 rounded-full bg-foreground/40"></div>
                                        <div class="absolute bottom-3 left-4 size-0.5 rounded-full bg-foreground/40"></div>
                                        <div class="absolute bottom-5 right-2 size-0.5 rounded-full bg-foreground/40"></div>
                                        <div class="absolute left-1/2 top-1/3 size-0.5 rounded-full bg-foreground/40"></div>
                                    </div>
                                    <LucideIconCn Name="@photo.IconName" Size="32" Class="size-8 text-foreground/70" StrokeWidth="2" aria-hidden="true" />
                                    @* Timestamp corner *@
                                    <span class="absolute bottom-1 right-1.5 font-mono text-[8px] uppercase tracking-widest text-foreground/50">
                                        0@(idx + 1)/04
                                    </span>
                                </div>
                                @* Handwritten caption *@
                                <div class="mt-2.5 text-center">
                                    <p class="text-sm font-semibold text-foreground" style="font-family:'Caveat','Segoe Script',cursive">
                                        @photo.Title
                                    </p>
                                    <p class="mt-0.5 text-xs text-muted-foreground" style="font-family:'Caveat','Segoe Script',cursive">
                                        @photo.Caption
                                    </p>
                                </div>
                            </div>
                        </div>
                    }

                    @* Bottom perforation *@
                    <div aria-hidden="true" class="flex items-center justify-between pt-1">
                        @foreach (var perf in _perforations)
                        {
                            <span class="size-1 rounded-full bg-foreground/15"></span>
                        }
                    </div>
                </div>

                @* Date + location stamp *@
                <div class="mt-5 flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.2em] text-muted-foreground">
                    <div class="flex items-center gap-1.5">
                        <span>Apr 09 '26</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="map-pin" Size="10" Class="size-2.5" aria-hidden="true" />
                        <span>Studio 04</span>
                    </div>
                </div>
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-center">
            <ButtonCn Class="w-full sm:w-[230px]">Start your strip</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">Browse memories</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record PhotoItem(string Id, string IconName, string Title, string Caption);
    private record TapePiece(string Id, string Rotate, string Left);

    private static readonly PhotoItem[] _photos =
    [
        new("first-build",  "sparkles", "First build",    "the day it finally compiled"),
        new("team-launch",  "heart",    "Launch day",     "pressed ship at 3am, no regrets"),
        new("milestone",    "star",     "First 1k users", "screenshot saved forever"),
        new("on-tour",      "camera",   "On the road",    "meeting the people who use it"),
    ];

    private static readonly TapePiece[] _tapePieces =
    [
        new("tape-1", "-6deg", "6%"),
        new("tape-2", "4deg",  "32%"),
        new("tape-3", "-3deg", "56%"),
        new("tape-4", "7deg",  "80%"),
    ];

    private static readonly int[] _perforations = new int[10];
}
