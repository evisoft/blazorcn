@* ============================================================
   Block: features-scoreboard-split-flap-display
   Title: FeaturesScoreboardSplitFlapDisplay
   Description: A scoreboard split flap display features section for React and Next.js with a dark departures board, monospaced character cells, live indicator, and status column built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-scoreboard-split-flap-display.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline *@
        <div class="text-center">
            <p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-muted-foreground">
                <LucideIconCn Name="radio" Size="14" Class="size-3.5" aria-hidden="true" />
                Departures board
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Features, now boarding.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every capability on the schedule, live from the board. Flips update in real time as
                releases depart, arrive, and take their gates.
            </p>
        </div>

        @* Scoreboard *@
        <div class="mt-12 overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950 shadow-2xl shadow-zinc-950/30">
            @* Board header *@
            <div class="flex items-center justify-between border-b border-zinc-800 bg-zinc-900/60 px-5 py-3">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.2em] text-amber-400">
                        <LucideIconCn Name="circle" Size="8" Class="size-2 animate-pulse fill-red-500 text-red-500" aria-hidden="true" />
                        Live
                    </span>
                    <span class="hidden h-3 w-px bg-zinc-800 sm:block"></span>
                    <span class="hidden text-[10px] font-bold uppercase tracking-[0.2em] text-zinc-500 sm:inline">
                        Platform departures · Board A
                    </span>
                </div>
                <span class="font-mono text-[10px] tabular-nums text-zinc-500">
                    TRM 04 · @(_departures.Length) ROUTES
                </span>
            </div>

            @* Column headers *@
            <div class="grid grid-cols-[64px_1fr_auto_56px] items-center gap-3 border-b border-zinc-800 bg-zinc-900/30 px-5 py-2.5 font-mono text-[10px] font-bold uppercase tracking-[0.15em] text-zinc-500 sm:grid-cols-[72px_1fr_auto_72px] sm:gap-4">
                <span>Time</span>
                <span>Feature</span>
                <span class="text-right">Status</span>
                <span class="hidden text-right sm:block">Gate</span>
            </div>

            @* Rows *@
            <div class="divide-y divide-zinc-900">
                @foreach (var dep in _departures)
                {
                    <div class="grid grid-cols-[64px_1fr_auto_56px] items-center gap-3 px-5 py-3 sm:grid-cols-[72px_1fr_auto_72px] sm:gap-4">
                        @* Time *@
                        <span role="img" aria-label="@dep.Time" class="inline-flex items-center gap-[2px]">
                            @foreach (var ch in PadChars(dep.Time, 0))
                            {
                                <span aria-hidden="true" class="relative inline-flex h-7 w-[18px] items-center justify-center rounded-[2px] border border-zinc-800 bg-zinc-900 font-mono text-sm font-bold leading-none after:absolute after:inset-x-0 after:top-1/2 after:h-px after:bg-zinc-950/80 sm:h-8 sm:w-5 sm:text-base">@(ch == ' ' ? " " : ch.ToString())</span>
                            }
                        </span>
                        @* Feature *@
                        <div class="min-w-0 overflow-hidden">
                            <span role="img" aria-label="@dep.Feature" class="inline-flex flex-wrap items-center gap-[2px]">
                                @foreach (var ch in PadChars(dep.Feature, 13))
                                {
                                    <span aria-hidden="true" class="relative inline-flex h-7 w-[18px] items-center justify-center rounded-[2px] border border-zinc-800 bg-zinc-900 font-mono text-sm font-bold leading-none after:absolute after:inset-x-0 after:top-1/2 after:h-px after:bg-zinc-950/80 sm:h-8 sm:w-5 sm:text-base">@(ch == ' ' ? " " : ch.ToString())</span>
                                }
                            </span>
                        </div>
                        @* Status *@
                        <span class="@(Cn.Merge("text-right font-mono text-[10px] font-bold uppercase tracking-[0.15em] sm:text-xs", GetStatusStyle(dep.Status)))">
                            @dep.Status
                        </span>
                        @* Gate *@
                        <span class="hidden text-right font-mono text-xs font-bold tabular-nums text-amber-400 sm:inline">
                            @dep.Gate
                        </span>
                    </div>
                }
            </div>

            @* Board footer ticker *@
            <div class="flex items-center justify-between border-t border-zinc-800 bg-zinc-900/60 px-5 py-2.5">
                <span class="font-mono text-[10px] tabular-nums text-zinc-500">
                    LAST FLIP 09:47:12 UTC
                </span>
                <span class="font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-amber-400">
                    TRACK · QTR · 26
                </span>
            </div>
        </div>

        @* CTA *@
        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <ButtonCn Class="w-full sm:w-[250px]">View full schedule</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[250px]">Subscribe to flips</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Departure(string Id, string Time, string Feature, string Status, string Gate);

    private static readonly Departure[] _departures =
    [
        new("edge-runtime",   "09:14", "EDGE RUNTIME",   "DEPARTED", "A12"),
        new("streaming-ssr",  "10:02", "STREAMING SSR",  "ON TIME",  "B04"),
        new("image-optim",    "10:45", "IMAGE OPTIM",    "BOARDING", "B11"),
        new("smart-cache",    "11:30", "SMART CACHE",    "ON TIME",  "C07"),
        new("auth-vault",     "12:15", "AUTH VAULT",     "DELAYED",  "C22"),
        new("observability",  "13:00", "OBSERVABILITY",  "ON TIME",  "D09"),
    ];

    private static string GetStatusStyle(string status) => status switch
    {
        "ON TIME"  => "text-emerald-400",
        "DEPARTED" => "text-zinc-500",
        "DELAYED"  => "text-red-400",
        "BOARDING" => "text-amber-400",
        _          => "",
    };

    private static char[] PadChars(string text, int length)
    {
        var padded = length > 0 && text.Length < length
            ? text.PadRight(length)
            : text;
        return padded.ToCharArray();
    }
}
