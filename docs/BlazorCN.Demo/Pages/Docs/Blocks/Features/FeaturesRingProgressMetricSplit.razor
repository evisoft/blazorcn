@* ============================================================
   Block: features-ring-progress-metric-split
   Title: FeaturesRingProgressMetricSplit
   Description: A split layout features section for React and Next.js with a headline and benefit checklist on the left beside a 2x2 grid of SVG circular progress rings visualizing platform metrics, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-ring-progress-metric-split.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="grid gap-10 lg:grid-cols-[5fr_6fr] lg:items-center lg:gap-14">

        @* Left: headline + checklist + CTAs *@
        <div>
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Platform
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Numbers your platform team will actually trust.
            </h2>
            <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                Every capability ships with the hard metric behind it — no asterisks, no &ldquo;coming soon.&rdquo;
                Here&apos;s what runs in production today.
            </p>
            <ul class="mt-6 space-y-3">
                @foreach (var item in _benefits)
                {
                    <li class="flex items-start gap-2.5">
                        <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                        <span class="text-sm text-muted-foreground">@item</span>
                    </li>
                }
            </ul>
            <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
                <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">See pricing</ButtonCn>
            </div>
        </div>

        @* Right: 2x2 ring grid *@
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            @foreach (var metric in _metrics)
            {
                var size = 128;
                var stroke = 8;
                var radius = (size - stroke) / 2.0;
                var circumference = 2 * Math.PI * radius;
                var offset = circumference - (metric.Value / 100.0) * circumference;
                var viewBox = $"0 0 {size} {size}";
                var cx = size / 2.0;
                var cy = size / 2.0;
                var dashArray = circumference.ToString("F4", System.Globalization.CultureInfo.InvariantCulture);
                var dashOffset = offset.ToString("F4", System.Globalization.CultureInfo.InvariantCulture);

                <div class="flex flex-col items-center rounded-xl border bg-card p-6 text-center">
                    <div class="relative flex items-center justify-center">
                        <svg aria-hidden="true"
                             width="@size"
                             height="@size"
                             viewBox="@viewBox"
                             class="-rotate-90">
                            <circle cx="@cx.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)"
                                    cy="@cy.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)"
                                    r="@radius.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)"
                                    fill="none"
                                    stroke-width="@stroke"
                                    class="stroke-muted" />
                            <circle cx="@cx.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)"
                                    cy="@cy.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)"
                                    r="@radius.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)"
                                    fill="none"
                                    stroke-width="@stroke"
                                    stroke-linecap="round"
                                    stroke-dasharray="@dashArray"
                                    stroke-dashoffset="@dashOffset"
                                    class="stroke-foreground" />
                        </svg>
                        <div class="absolute inset-0 flex items-center justify-center">
                            <span class="text-lg font-semibold tabular-nums tracking-tight">
                                @metric.Display
                            </span>
                        </div>
                    </div>
                    <h3 class="mt-5 text-base font-semibold">@metric.Title</h3>
                    <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                        @metric.Description
                    </p>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record RingMetric(string Id, double Value, string Display, string Title, string Description);

    private static readonly RingMetric[] _metrics =
    [
        new("availability", 99.95, "99.95%", "Availability",      "Continuous uptime across every deployed region."),
        new("edge",         94,    "94%",    "Edge hit rate",      "Reads served from the edge without hitting origin."),
        new("headroom",     87,    "87%",    "Scale headroom",     "Burst capacity your workloads can claim on demand."),
        new("attestation",  100,   "100%",   "Attested builds",    "Signature-verified releases shipped to production."),
    ];

    private static readonly string[] _benefits =
    [
        "Ship to every region with one git push",
        "Detailed traces on every request, for free",
        "Zero-downtime blue/green deploys by default",
        "Fleet-wide key rotation on a one-click schedule",
    ];
}
