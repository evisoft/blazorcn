@* ============================================================
   Block: features-split-panel
   Title: Features Split Panel
   Description: Master-detail feature explorer with interactive selection, ideal for product tours and detailed feature showcases in Next.js apps.
   Long Description: Technical specifications displayed as key-value pairs in a clean table format
   Dependencies: LucideChevronRightCn
   Source: original/blocks/features/features-split-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
          <h2 class="text-sm font-medium">Platform Features</h2>
          <p class="mt-1 text-xs text-muted-foreground">Select a feature to learn more</p>
        </div>
        <div class="flex flex-col md:flex-row">
          <div class="w-full border-b md:w-2/5 md:border-b-0 md:border-r">
            @{ var btnIndex = 0; }
            @foreach (var feature in _features)
            {
              var idx = btnIndex;
              <button
                type="button"
                @onclick="@(() => _selected = idx)"
                class="@(Cn.Merge("flex w-full items-center justify-between gap-3 border-b px-4 py-3 text-left transition-colors last:border-b-0 hover:bg-muted/50", _selected == idx ? "bg-muted/50" : ""))"
              >
                <div class="min-w-0 flex-1">
                  <h3 class="text-sm font-medium">@feature.Title</h3>
                  <p class="mt-0.5 truncate text-xs text-muted-foreground">@feature.Summary</p>
                </div>
                <LucideChevronRightCn Size="16" Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform", _selected == idx ? "rotate-90" : ""))" />
              </button>
              btnIndex++;
            }
          </div>
          <div class="w-full p-4 md:w-3/5">
            <h3 class="text-sm font-medium">@(_features[_selected].Title)</h3>
            <p class="mt-2 text-sm text-muted-foreground">@(_features[_selected].Description)</p>
            <div class="mt-4 space-y-2">
              @foreach (var detail in _features[_selected].Details)
              {
                <div class="flex items-start gap-3">
                  <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                  <span class="text-sm">@detail</span>
                </div>
              }
            </div>
          </div>
        </div>
      </div>
    </section>

@code {
    private int _selected = 0;

    private record FeatureData(string Title, string Summary, string Description, string[] Details);

    private static readonly FeatureData[] _features = new[]
    {
        new FeatureData("Issue Tracking", "Plan and track work", "Create, assign, and track issues with full customization.", new[] { "Custom fields and workflows", "Sub-issues and dependencies", "Bulk operations", "Keyboard shortcuts" }),
        new FeatureData("Sprint Planning", "Organize iterations", "Time-boxed iterations with velocity tracking and carry-over.", new[] { "Automatic carry-over", "Velocity charts", "Capacity planning", "Sprint retrospectives" }),
        new FeatureData("CI/CD Pipelines", "Automate deployments", "Automated build, test, and deployment workflows.", new[] { "Parallel execution", "Multi-environment", "Rollback support", "Build caching" }),
        new FeatureData("Analytics", "Measure performance", "Real-time metrics and insights for your team.", new[] { "Cycle time tracking", "Custom dashboards", "Export capabilities", "Team comparisons" }),
    };
}
