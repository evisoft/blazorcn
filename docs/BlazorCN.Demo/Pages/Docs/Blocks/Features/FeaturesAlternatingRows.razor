@* ============================================================
   Block: features-alternating-rows
   Title: Features Alternating Rows
   Description: Zigzag feature layout with alternating text and image placement for landing pages
   Dependencies: None
   Source: original/blocks/features/features-alternating-rows.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Platform</p>
            <p class="mt-0.5 text-xs text-muted-foreground">A complete toolkit for modern teams who want to automate operations and stay aligned</p>
        </div>

        @for (var i = 0; i < _features.Length; i++)
        {
            var feature = _features[i];
            var isLast = i == _features.Length - 1;
            var isReversed = i % 2 == 1;
            <div class="@Cn.Merge("grid gap-4 px-4 py-4 md:grid-cols-2 md:gap-6", !isLast ? "border-b" : "")">
                <div class="@Cn.Merge("flex flex-col justify-center", isReversed ? "md:order-2" : "")">
                    <span class="text-xs font-medium text-muted-foreground">@feature.Label</span>
                    <p class="mt-1 text-sm font-medium">@feature.Title</p>
                    <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">@feature.Description</p>
                </div>
                <div class="@(isReversed ? "md:order-1" : "")">
                    <div class="flex aspect-[16/10] items-center justify-center rounded-md border bg-muted/50">
                        <span class="text-xs text-muted-foreground/50">Screenshot</span>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Feature(string Label, string Title, string Description);

    private static readonly Feature[] _features =
    [
        new("Automation", "Automate repetitive workflows in minutes",
            "Build multi-step workflows that connect your favorite tools without code. Trigger actions based on events, schedule recurring tasks, and let your team focus on what matters."),
        new("Data Sync", "Keep data in sync across every platform",
            "Bi-directional sync ensures your CRM, database, and spreadsheets always reflect the latest information. Resolve conflicts automatically and maintain a single source of truth."),
        new("Notifications", "Stay informed with intelligent alerts",
            "Smart filtering routes critical updates to the right people at the right time via Slack, email, or in-app notifications. No noise, no missed signals."),
    ];
}
