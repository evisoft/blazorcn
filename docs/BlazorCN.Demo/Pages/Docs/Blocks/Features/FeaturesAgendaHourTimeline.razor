@* ============================================================
   Block: features-agenda-hour-timeline
   Title: FeaturesAgendaHourTimeline
   Description: A vertical daily agenda timeline features section for React and Next.js with hour markers, positioned event cards, a now indicator line, and a ShadcnioButton CTA pair, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-agenda-hour-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Header *@
        <div class="text-center">
            <p class="inline-flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-muted-foreground">
                <LucideIconCn Name="clock" Size="14" Class="size-3.5" aria-hidden="true" />A day on the platform
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Every hour, a capability you did not have to build.
            </h2>
            <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                Deploys, drills, and retros all run on rails. Here is how a normal Wednesday unfolds for
                the teams already on the platform.
            </p>
            <div class="mt-7 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-center">
                <ButtonCn Class="w-full sm:w-[200px]">Start a trial</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[240px]">
                    See full playbook
                </ButtonCn>
            </div>
        </div>

        @* Agenda timeline *@
        <div class="relative mt-10 overflow-hidden rounded-xl border bg-card">
            <div class="relative">
                @for (var hIdx = 0; hIdx < _hours.Length; hIdx++)
                {
                    var hour = _hours[hIdx];
                    var hourIndex = hIdx;
                    var evt = System.Array.Find(_events, e => e.HourIndex == hourIndex);
                    var isCoveredByPrior = System.Array.Exists(_events, e => e.HourIndex < hourIndex && e.HourIndex + e.RowSpan > hourIndex);
                    <div class="@Cn.Merge("relative flex min-h-[84px]", hourIndex < _hours.Length - 1 ? "border-b" : "")">
                        @* Hour label column *@
                        <div class="w-16 shrink-0 border-r bg-muted/30 px-3 py-3 text-xs font-medium tabular-nums text-muted-foreground">
                            @hour
                        </div>

                        @* Event column *@
                        <div class="relative flex-1 p-3">
                            @if (evt != null)
                            {
                                <div class="@Cn.Merge("rounded-md border border-l-2 bg-muted/30 p-3", GetToneStyle(evt.Tone))"
                                     style="@($"min-height:{evt.RowSpan * 84 - 24}px")">
                                    <div class="flex items-start justify-between gap-3">
                                        <h3 class="text-sm font-semibold text-foreground">@evt.Title</h3>
                                        <span class="shrink-0 rounded-full bg-background px-2 py-0.5 text-[10px] font-medium tabular-nums text-muted-foreground">
                                            @evt.Duration
                                        </span>
                                    </div>
                                    <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                                        @evt.Description
                                    </p>
                                </div>
                            }
                            else if (!isCoveredByPrior)
                            {
                                <div class="h-full rounded-md bg-muted/20"></div>
                            }
                        </div>

                        @* Now indicator line *@
                        @if (hourIndex == _nowIndex)
                        {
                            <div class="pointer-events-none absolute left-0 right-0 z-10 flex items-center"
                                 style="top:40%"
                                 aria-hidden="true">
                                <div class="flex w-16 items-center justify-end pr-2">
                                    <span class="rounded-full bg-red-500 px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-widest text-white">
                                        Now
                                    </span>
                                </div>
                                <div class="relative h-px flex-1 bg-red-500">
                                    <span class="absolute -left-1 top-1/2 size-2 -translate-y-1/2 rounded-full bg-red-500"></span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private const int _nowIndex = 5;

    private static readonly string[] _hours = ["9 AM", "10 AM", "11 AM", "12 PM", "1 PM", "2 PM", "3 PM", "4 PM", "5 PM"];

    private record AgendaEvent(string Id, int HourIndex, int RowSpan, string Title, string Description, string Duration, string Tone);

    private static readonly AgendaEvent[] _events =
    [
        new("standup", 0, 1, "Fleet-wide health sync", "Auto-generated report from every region runs at open.", "15 min", "emerald"),
        new("deploy",  1, 2, "Canary deploy window",   "5% traffic shift with automatic rollback on SLO breach.", "2h watch", "blue"),
        new("review",  3, 1, "Design review",           "Async Loom walkthrough posted to #design-review by lunch.", "45 min", "neutral"),
        new("drill",   4, 2, "Failover drill",          "Staging only — rehearses the regional evacuation runbook.", "2h exercise", "amber"),
        new("ship",    6, 1, "Changelog published",     "Release notes auto-fan to blog, RSS, and the dashboard.", "Automated", "emerald"),
        new("retro",   7, 1, "Close-of-day retro",      "One-page summary of what shipped, what broke, what is next.", "30 min", "blue"),
    ];

    private static string GetToneStyle(string tone) => tone switch
    {
        "emerald" => "border-l-emerald-500",
        "blue"    => "border-l-blue-500",
        "amber"   => "border-l-amber-500",
        _         => "border-l-border",
    };
}
