@* ============================================================
   Block: features-sticky-headline-six-point
   Title: FeaturesStickyHeadlineSixPoint
   Description: A sticky headline split feature section for React and Next.js with a left-pinned marketing headline and a 2x3 numbered six-point feature grid on the right built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-sticky-headline-six-point.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-8 sm:p-12 lg:p-14">
        <div class="grid gap-10 lg:grid-cols-[5fr_6fr] lg:gap-14">
            @* Left — Sticky headline *@
            <div class="lg:sticky lg:top-8 lg:self-start">
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    @_headline.Eyebrow
                </p>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
                    @_headline.Title
                </h2>
                <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground">
                    @_headline.Subtitle
                </p>
            </div>

            @* Right — 2x3 numbered six-point grid *@
            <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2">
                @foreach (var feat in _features)
                {
                    var idx = System.Array.IndexOf(_features, feat);
                    var number = (idx + 1).ToString().PadLeft(2, '0');
                    <div>
                        <span class="inline-flex items-center rounded-full border bg-muted/50 px-2 py-0.5 font-mono text-[10px] font-medium tracking-widest text-muted-foreground">
                            @number
                        </span>
                        <h3 class="mt-3 text-base font-semibold text-foreground">@feat.Title</h3>
                        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                            @feat.Description
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record Feature(string Id, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        "Principles",
        "Six ideas we refuse to compromise on",
        "Every feature we ship is measured against these six principles. When a new idea cannot survive this gauntlet, we cut it — no matter how much engineering time has already gone into the prototype."
    );

    private static readonly Feature[] _features =
    [
        new("ownership", "You own your data",
            "Full exports in open formats are one click away. There is no lock-in tax and no waiting period when you decide to leave."),
        new("latency", "Latency is a first-class bug",
            "Every page load is tracked against a 150ms budget. Regressions page the team the same way an outage would."),
        new("privacy", "Private by construction",
            "No third-party analytics, no session replays, and no customer data ever touches a marketing pixel. Ever."),
        new("pricing", "Pricing you can predict",
            "Flat per-seat plans with no usage-based surprise invoices. You will never get a bill larger than what you expected."),
        new("support", "Humans answer your tickets",
            "Every support reply is written by an engineer on the product team. No AI deflection layers and no outsourced tier one."),
        new("openness", "Open by default",
            "Public changelogs, public roadmap, public status page. If we have shipped it or plan to ship it, you can read about it."),
    ];
}
