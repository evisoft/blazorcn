@* ============================================================
   Block: features-filmstrip-frame-row
   Title: FeaturesFilmstripFrameRow
   Description: A 35mm filmstrip features section for React and Next.js with sprocket hole borders, five numbered film frames, and a director credit stamp, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-filmstrip-frame-row.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Heading *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                <LucideIconCn Name="film" Size="14" Class="mr-1.5 inline size-3.5" aria-hidden="true" />
                Now Showing
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Your product, one frame at a time.
            </h2>
            <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                Every feature is a scene in the same reel. Watch the story build, frame by frame, from
                first cut to opening night.
            </p>
        </div>

        @* Filmstrip *@
        <div class="mt-12 overflow-hidden rounded-lg bg-zinc-950 shadow-2xl ring-1 ring-zinc-800">
            @* Top sprocket row *@
            <div aria-hidden="true" class="grid grid-cols-12 gap-2 border-b border-zinc-800 px-3 py-2.5">
                @foreach (var sprocket in _sprockets)
                {
                    <div class="aspect-square rounded-[3px] bg-zinc-900 ring-1 ring-inset ring-zinc-800"></div>
                }
            </div>

            @* Frame row *@
            <div class="grid grid-cols-2 gap-3 p-4 sm:grid-cols-3 sm:gap-4 sm:p-5 md:grid-cols-5">
                @foreach (var frame in _frames)
                {
                    <div class="group">
                        <div class="mb-2 font-mono text-[10px] font-semibold uppercase tracking-widest text-zinc-500">
                            @frame.Number
                        </div>
                        <div class="relative aspect-[4/5] overflow-hidden rounded-sm border border-zinc-700 bg-card p-4 transition-colors">
                            <div class="flex h-full flex-col">
                                <div class="flex size-9 items-center justify-center rounded-md border bg-muted/50">
                                    <LucideIconCn Name="@frame.IconName" Size="16" Class="size-4 text-foreground" aria-hidden="true" />
                                </div>
                                <h3 class="mt-4 text-sm font-semibold leading-snug">@frame.Title</h3>
                                <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                                    @frame.Description
                                </p>
                                <div class="mt-auto pt-3">
                                    <div class="h-px w-6 bg-foreground/30"></div>
                                </div>
                            </div>
                            @* Corner exposure marks *@
                            <span aria-hidden="true" class="pointer-events-none absolute left-1 top-1 size-1 rounded-full bg-foreground/20"></span>
                            <span aria-hidden="true" class="pointer-events-none absolute right-1 top-1 size-1 rounded-full bg-foreground/20"></span>
                            <span aria-hidden="true" class="pointer-events-none absolute bottom-1 left-1 size-1 rounded-full bg-foreground/20"></span>
                            <span aria-hidden="true" class="pointer-events-none absolute bottom-1 right-1 size-1 rounded-full bg-foreground/20"></span>
                        </div>
                    </div>
                }
            </div>

            @* Bottom sprocket row *@
            <div aria-hidden="true" class="grid grid-cols-12 gap-2 border-t border-zinc-800 px-3 py-2.5">
                @foreach (var sprocket in _sprockets)
                {
                    <div class="aspect-square rounded-[3px] bg-zinc-900 ring-1 ring-inset ring-zinc-800"></div>
                }
            </div>
        </div>

        @* Film grain divider + credit *@
        <div class="mt-5 flex flex-wrap items-center justify-between gap-3 text-[10px] font-mono uppercase tracking-[0.2em] text-muted-foreground">
            <div class="flex items-center gap-2">
                <span aria-hidden="true" class="flex gap-[3px]">
                    @foreach (var grain in _grains)
                    {
                        <span class="size-[3px] rounded-full bg-foreground/25"></span>
                    }
                </span>
                <span>Reel 01 / Take 04</span>
            </div>
            <div class="flex items-center gap-2">
                <span>Director: You</span>
                <span aria-hidden="true" class="size-1 rounded-full bg-foreground/40"></span>
                <span>Runtime 02:14</span>
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-center">
            <ButtonCn Class="w-full sm:w-[210px]">Watch the reel</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">Read the script</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FrameItem(string Id, string Number, string IconName, string Title, string Description);

    private static readonly FrameItem[] _frames =
    [
        new("script", "FRAME 01", "clapperboard", "Script the idea", "Draft the plot in plain English and lock the beats."),
        new("shoot",  "FRAME 02", "video",        "Shoot the scene",  "Ship your first build straight from the command line."),
        new("cut",    "FRAME 03", "scissors",     "Cut and refine",   "Trim the noise and tighten the pacing in review."),
        new("score",  "FRAME 04", "sparkles",     "Score the moment", "Polish with micro-animations and delight details."),
        new("release","FRAME 05", "megaphone",    "Release wide",     "Premiere to every audience with one production push."),
    ];

    private static readonly int[] _sprockets = new int[12];
    private static readonly int[] _grains = new int[14];
}
