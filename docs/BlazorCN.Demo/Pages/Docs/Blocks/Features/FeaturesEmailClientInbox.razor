@* ============================================================
   Block: features-email-client-inbox
   Title: FeaturesEmailClientInbox
   Description: An email client inbox features section for React and Next.js presenting capabilities as a realistic mail app mockup with a folder sidebar, sender avatars, unread dots, and search bar built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-email-client-inbox.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="text-center">
            <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-muted-foreground">
                <LucideIconCn Name="inbox" Size="12" Class="size-3" aria-hidden="true" />
                Straight to your inbox
            </span>
            <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Every launch, delivered like a letter.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Product updates, security advisories, and changelog digests arrive in one quiet thread —
                scannable, searchable, and easy to forward to the rest of your team.
            </p>
        </div>

        @* Email client mockup *@
        <div class="mt-10 overflow-hidden rounded-xl border bg-card shadow-sm">
            @* Top bar *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <span aria-hidden="true" class="size-2.5 rounded-full bg-red-500/70"></span>
                    <span aria-hidden="true" class="size-2.5 rounded-full bg-amber-500/70"></span>
                    <span aria-hidden="true" class="size-2.5 rounded-full bg-emerald-500/70"></span>
                </div>
                <div class="ml-2 flex flex-1 items-center gap-2 rounded-md border bg-background px-3 py-1.5">
                    <LucideIconCn Name="search" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" aria-hidden="true" />
                    <span class="truncate text-xs text-muted-foreground">
                        Search mail — sender, subject, or keyword
                    </span>
                </div>
                <button
                    type="button"
                    class="inline-flex shrink-0 items-center gap-1.5 rounded-md bg-foreground px-3 py-1.5 text-xs font-medium text-background hover:bg-foreground/90">
                    <LucideIconCn Name="pencil" Size="14" Class="size-3.5" aria-hidden="true" />
                    <span class="hidden sm:inline">New email</span>
                </button>
            </div>

            @* Inbox body *@
            <div class="flex">
                @* Sidebar *@
                <nav aria-label="Folders" class="w-14 shrink-0 border-r bg-muted/20 py-3 sm:w-44">
                    <div class="hidden px-4 pb-2 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground sm:block">
                        Folders
                    </div>
                    <ul class="space-y-0.5 px-2">
                        @foreach (var folder in _folders)
                        {
                            <li>
                                <button
                                    type="button"
                                    class="@Cn.Merge("flex w-full items-center gap-2.5 rounded-md px-2 py-1.5 text-left text-sm", folder.Active ? "bg-muted/60 text-foreground" : "text-muted-foreground hover:bg-muted/40")">
                                    <LucideIconCn Name="@folder.Icon" Size="16" Class="size-4 shrink-0" aria-hidden="true" />
                                    <span class="hidden flex-1 truncate text-xs font-medium sm:inline">
                                        @folder.Label
                                    </span>
                                    @if (folder.Count.HasValue)
                                    {
                                        <span class="hidden shrink-0 rounded bg-background px-1.5 font-mono text-[10px] font-medium text-muted-foreground sm:inline">
                                            @folder.Count
                                        </span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>
                </nav>

                @* Email list *@
                <ul class="min-w-0 flex-1">
                    @for (var i = 0; i < _emails.Length; i++)
                    {
                        var email = _emails[i];
                        var isFirst = i == 0;
                        var isLast = i == _emails.Length - 1;
                        <li class="@Cn.Merge("border-b", isLast ? "border-b-0" : "", isFirst ? "bg-muted/60" : "")">
                            <button
                                type="button"
                                aria-label="@((email.Unread ? "Unread " : "") + "email from " + email.Sender + ": " + email.Subject)"
                                class="flex w-full items-start gap-3 px-4 py-3 text-left hover:bg-muted/40">
                                <span class="@Cn.Merge("flex size-9 shrink-0 items-center justify-center rounded-full font-mono text-[11px] font-semibold", email.Accent)">
                                    @email.Initials
                                </span>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="@Cn.Merge("truncate text-sm", email.Unread ? "font-semibold text-foreground" : "font-medium text-muted-foreground")">
                                            @email.Sender
                                        </span>
                                        @if (email.Unread)
                                        {
                                            <span aria-hidden="true" class="size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                                        }
                                        <span class="ml-auto shrink-0 font-mono text-[10px] text-muted-foreground">
                                            @email.Time
                                        </span>
                                    </div>
                                    <div class="@Cn.Merge("mt-0.5 truncate text-sm", email.Unread ? "text-foreground" : "text-muted-foreground")">
                                        @email.Subject
                                    </div>
                                    <div class="mt-0.5 truncate text-xs text-muted-foreground">
                                        @email.Preview
                                    </div>
                                </div>
                            </button>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[270px]">Subscribe for updates</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">View changelog</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FolderItem(string Id, string Icon, string Label, int? Count, bool Active = false);
    private record EmailRow(string Id, string Initials, string Accent, string Sender, string Subject, string Preview, string Time, bool Unread);

    private static readonly FolderItem[] _folders =
    [
        new("inbox",   "inbox",        "Inbox",   24,   true),
        new("starred", "star",         "Starred",  6,   false),
        new("drafts",  "file-edit",    "Drafts",   2,   false),
        new("archive", "archive",      "Archive",  null, false),
        new("spam",    "shield-alert", "Spam",     null, false),
    ];

    private static readonly EmailRow[] _emails =
    [
        new("m1", "PL", "bg-blue-500/15 text-blue-600 dark:text-blue-400",    "platform@yours.co",    "New: Blue/green deployments shipping next week",        "Zero-downtime rollouts land on every plan. Here's how to opt in early, what stays the same, and",   "9:41 AM",   true),
        new("m2", "OB", "bg-emerald-500/15 text-emerald-600 dark:text-emerald-400", "observability@yours.co", "Live log streaming is now free on Hobby",          "Stream structured logs across every service with millisecond latency — no agent, no config file",  "8:02 AM",   true),
        new("m3", "SS", "bg-amber-500/15 text-amber-600 dark:text-amber-400",  "security@yours.co",   "Audit log search now covers 90 days by default",         "Signed trails for every production change, filterable by actor, resource, and IP in a single",      "Yesterday", false),
        new("m4", "DB", "bg-blue-500/15 text-blue-600 dark:text-blue-400",     "data@yours.co",       "Connect Postgres in two clicks — no SSH tunnels",        "We rebuilt the connector flow. Read replicas are auto-detected and PITR snapshots run nightly on",  "Yesterday", true),
        new("m5", "ED", "bg-red-500/15 text-red-600 dark:text-red-400",        "edge@yours.co",       "Edge functions now support streaming responses",          "Start responding in under 40ms and stream long-running LLM calls directly from the edge runtime",   "Mon",       false),
        new("m6", "TM", "bg-emerald-500/15 text-emerald-600 dark:text-emerald-400", "team@yours.co",  "SSO + SCIM is now available on every paid plan",         "Provision and deprovision teammates from Okta, Entra, and Google Workspace with role presets",      "Sun",       false),
    ];
}
