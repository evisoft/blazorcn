@* ============================================================
   Block: features-horizontal-marquee-band
   Title: FeaturesHorizontalMarqueeBand
   Description: A horizontal auto-scrolling marquee band feature section for React and Next.js with infinitely looping feature pills, a headline header, and a condensed three-column expansion grid built with motion/react, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-horizontal-marquee-band.tsx
   ============================================================ *@

<style>
    .blazorcn-marquee-track {
        display: flex;
        width: max-content;
        align-items: center;
        gap: 1.25rem;
        animation: blazorcn-marquee-scroll 32s linear infinite;
    }
    @@keyframes blazorcn-marquee-scroll {
        from { transform: translateX(0); }
        to   { transform: translateX(-50%); }
    }
</style>

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-2xl border bg-card">

        @* Header *@
        <div class="px-6 pt-10 pb-8 text-center sm:px-10 sm:pt-14 sm:pb-10">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Everything included
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
                One platform, every primitive you ship with
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Stop stitching together a dozen vendors. The runtime, the database, the queue, and the
                observability you already wanted, already wired up.
            </p>
        </div>

        @* Marquee band *@
        <div class="relative overflow-hidden border-y bg-muted/30 py-6">
            @* Fade edges *@
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-card to-transparent sm:w-24"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-card to-transparent sm:w-24"></div>

            <div aria-hidden="true" class="blazorcn-marquee-track">
                @foreach (var pill in _marqueePillsDoubled)
                {
                    <div class="flex shrink-0 items-center gap-2.5 rounded-full border bg-card px-4 py-2 shadow-sm">
                        <LucideIconCn Name="@pill.IconName" Size="16" Class="size-4 text-foreground" />
                        <span class="whitespace-nowrap text-sm font-medium text-foreground">
                            @pill.Label
                        </span>
                        <span aria-hidden="true" class="size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                        <span class="whitespace-nowrap text-xs font-medium tabular-nums text-muted-foreground">
                            @pill.Metric
                        </span>
                    </div>
                }
            </div>

            @* Accessible offscreen list *@
            <ul class="sr-only">
                @foreach (var pill in _marqueePills)
                {
                    <li>@pill.Label: @pill.Metric</li>
                }
            </ul>
        </div>

        @* Expansion grid *@
        <div class="grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var feature in _expansionFeatures)
            {
                <div class="flex flex-col gap-3 bg-card p-6 sm:p-8">
                    <span aria-hidden="true" class="flex size-9 items-center justify-center rounded-lg border bg-muted/50">
                        <LucideIconCn Name="@feature.IconName" Size="16" Class="size-4 text-foreground" />
                    </span>
                    <h3 class="text-base font-semibold text-foreground">@feature.Title</h3>
                    <p class="text-sm leading-relaxed text-muted-foreground">
                        @feature.Description
                    </p>
                </div>
            }
            @* Filler cell to keep the 3-col rhythm on sm *@
            <div class="hidden bg-card sm:block lg:hidden"></div>
        </div>

    </div>
</section>

@code {
