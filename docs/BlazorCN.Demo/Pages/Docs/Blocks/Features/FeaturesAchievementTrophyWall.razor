@* ============================================================
   Block: features-achievement-trophy-wall
   Title: FeaturesAchievementTrophyWall
   Description: An achievement trophy wall features section for React and Next.js with hexagon badges, rarity percentages, and XP rewards built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-achievement-trophy-wall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div>
    @* Headline cluster *@
    <div class="text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Achievement wall · Season 4
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Every milestone earns its place on the wall.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
        Ship, scale, and hit the rare ones. Your team's progress is visible to everyone in the
        org — the grind is the reward.
      </p>
    </div>

    @* Progress header bar *@
    <div class="mt-10 flex flex-col gap-3 rounded-lg border bg-card p-4 sm:flex-row sm:items-center sm:gap-6">
      <div class="flex items-center gap-3">
        <span class="flex size-9 items-center justify-center rounded-md border bg-background">
          <LucideIconCn Name="trophy" Size="16" Class="size-4 text-amber-500" />
        </span>
        <div>
          <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
            Progress
          </div>
          <div class="text-sm font-medium text-foreground">
            @_unlockedCount of @_totalCount unlocked
          </div>
        </div>
      </div>
      <div class="flex-1">
        <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
          <div class="h-full rounded-full bg-amber-500" style="@($"width:{_progressPct}%")"></div>
        </div>
        <div class="mt-1.5 flex justify-between text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
          <span>@_progressPct% complete</span>
          <span class="text-foreground">@_totalXp.ToString("N0") XP</span>
        </div>
      </div>
    </div>

    @* Achievement grid *@
    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      @foreach (var ach in _achievements)
      {
        var item = ach;
        <article aria-label="@(!item.Unlocked ? $"{item.Name} (locked)" : null)"
                 class="@(Cn.Merge("flex flex-col items-center rounded-lg border bg-card p-5 text-center", !item.Unlocked ? "opacity-40" : ""))">
          @* Hexagonal badge (rotated square) *@
          <div class="relative flex size-16 items-center justify-center">
            <div aria-hidden="true"
                 class="@(Cn.Merge("absolute inset-0 rotate-45 rounded-md border-2", item.Unlocked ? "border-amber-500/70 bg-amber-500/10" : "border-dashed border-muted-foreground/30 bg-muted/50"))">
            </div>
            <LucideIconCn Name="@item.IconName" Size="24" Class="@(Cn.Merge("relative size-6", item.Unlocked ? "text-amber-600" : "text-muted-foreground"))" />
          </div>

          @* Name *@
          <h3 class="mt-4 text-sm font-medium text-foreground">@item.Name</h3>

          @* Description *@
          <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
            @item.Description
          </p>

          @* Rarity + XP footer *@
          <div class="mt-4 flex w-full items-center justify-between border-t pt-3 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
            <span class="flex items-center gap-1">
              <LucideIconCn Name="award" Size="12" Class="size-3" />
              @item.Rarity%
            </span>
            <span class="tabular-nums text-foreground">+@item.Xp XP</span>
          </div>
        </article>
      }
    </div>

    @* CTA pair *@
    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <ButtonCn Class="w-full sm:w-[200px]">Claim rewards</ButtonCn>
      <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">View leaderboard</ButtonCn>
    </div>
  </div>
</section>

@code {
    private record Achievement(
        string Id,
        string IconName,
        string Name,
        string Description,
        double Rarity,
        int Xp,
        bool Unlocked);

    private static readonly Achievement[] _achievements =
    [
        new("first-deploy",    "rocket",  "First Deploy",      "Ship your first build to production.",                92.1, 50,   true),
        new("streak-seven",    "flame",   "Hot Streak",         "Deploy on seven consecutive days.",                   34.8, 150,  true),
        new("zero-downtime",   "zap",     "Zero Downtime",      "Run 30 days without a single incident.",              12.6, 300,  true),
        new("world-traveler",  "compass", "World Traveler",     "Serve traffic from all 320 edge regions.",             8.4, 400,  true),
        new("team-captain",    "medal",   "Team Captain",       "Invite and onboard ten collaborators.",               18.9, 200,  true),
        new("speed-demon",     "sword",   "Speed Demon",        "Hit sub-50ms p95 latency end to end.",                 6.2, 500,  true),
        new("legend",          "crown",   "Platform Legend",    "Reach one billion requests served.",                   2.4, 1000, false),
        new("grandmaster",     "trophy",  "Grandmaster",        "Unlock every other achievement on this wall.",         0.8, 2000, false),
    ];

    private int _unlockedCount = 0;
    private int _totalCount = 0;
    private int _progressPct = 0;
    private int _totalXp = 0;

    protected override void OnInitialized()
    {
        _unlockedCount = 0;
        _totalXp = 0;
        foreach (var a in _achievements)
        {
            if (a.Unlocked)
            {
                _unlockedCount++;
                _totalXp += a.Xp;
            }
        }
        _totalCount = _achievements.Length;
        _progressPct = (int)Math.Round((double)_unlockedCount / _totalCount * 100);
    }
}
