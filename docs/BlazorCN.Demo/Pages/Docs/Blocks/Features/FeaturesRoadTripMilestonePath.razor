@* ============================================================
   Block: features-road-trip-milestone-path
   Title: FeaturesRoadTripMilestonePath
   Description: A road trip milestone path features section for React and Next.js with a curvy dashed SVG road, five numbered milestone markers, start and finish flags, and staggered reveal animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-road-trip-milestone-path.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Header *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                The Journey
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Five milestones to the finish line.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every successful launch follows the same winding road. Pack your repo, buckle up, and
                we'll pull over at every checkpoint that matters.
            </p>
        </div>

        @* Desktop SVG road *@
        <div class="relative mt-12 hidden md:block">
            <div class="relative w-full rounded-xl border bg-card p-8">
                <div class="relative w-full" style="aspect-ratio: 108 / 72">
                    <svg
                        aria-hidden="true"
                        viewBox="0 0 108 72"
                        class="absolute inset-0 h-full w-full"
                        preserveAspectRatio="none">
                        @* Base road outline (wider, muted) *@
                        <path
                            d="@_roadPath"
                            fill="none"
                            stroke-width="3"
                            stroke-linecap="round"
                            class="stroke-muted" />
                        @* Dashed center stripe *@
                        <path
                            d="@_roadPath"
                            fill="none"
                            stroke-width="0.6"
                            stroke-dasharray="2 2"
                            stroke-linecap="round"
                            class="stroke-foreground" />
                    </svg>

                    @* Start flag *@
                    <div
                        class="absolute flex items-center gap-1.5"
                        style="left: 0%; top: 22%; transform: translate(-10%, -130%)">
                        <span class="inline-flex items-center gap-1 rounded-md border bg-background px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                            <LucideIconCn Name="flag" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-500" />
                            Start
                        </span>
                    </div>

                    @* Finish flag *@
                    <div
                        class="absolute flex items-center gap-1.5"
                        style="left: 100%; top: 34%; transform: translate(-90%, -130%)">
                        <span class="inline-flex items-center gap-1 rounded-md border bg-background px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                            <LucideIconCn Name="flag" Size="12" Class="size-3 text-foreground" />
                            Finish
                        </span>
                    </div>

                    @* Milestone markers *@
                    @foreach (var ms in _milestones)
                    {
                        var milestone = ms;
                        var i = Array.IndexOf(_milestones, milestone);
                        var isAbove = i % 2 == 0;
                        <div
                            class="absolute"
                            style="@($"left: {milestone.X}%; top: {milestone.Y}%; transform: translate(-50%, -50%)")">
                            @* Marker circle *@
                            <div class="relative flex size-7 items-center justify-center rounded-full border-2 border-background bg-foreground text-[11px] font-semibold text-background shadow-sm">
                                @(i + 1)
                            </div>

                            @* Floating label card *@
                            <div class="@(Cn.Merge("pointer-events-none absolute left-1/2 w-40 -translate-x-1/2", isAbove ? "bottom-full mb-2" : "top-full mt-2"))">
                                <div class="rounded-lg border bg-background/95 px-3 py-2 shadow-sm backdrop-blur">
                                    <p class="flex items-center gap-1.5 text-[11px] font-semibold">
                                        <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-foreground" />
                                        @milestone.Title
                                    </p>
                                    <p class="mt-0.5 text-[10px] leading-snug text-muted-foreground">
                                        @milestone.Description
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Mobile vertical dashed path *@
        <div class="mt-12 md:hidden">
            <div class="mb-4 flex justify-start">
                <span class="inline-flex items-center gap-1 rounded-md border bg-background px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                    <LucideIconCn Name="flag" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-500" />
                    Start
                </span>
            </div>
            <ol class="relative space-y-5 pl-10">
                @* Dashed vertical line *@
                <span
                    aria-hidden="true"
                    class="absolute left-3 top-1 bottom-1 w-px border-l-2 border-dashed border-foreground" />
                @foreach (var ms in _milestones)
                {
                    var milestone = ms;
                    var i = Array.IndexOf(_milestones, milestone);
                    <li class="relative">
                        <span class="absolute -left-[34px] top-0 flex size-7 items-center justify-center rounded-full border-2 border-background bg-foreground text-[11px] font-semibold text-background shadow-sm">
                            @(i + 1)
                        </span>
                        <p class="text-sm font-semibold">@milestone.Title</p>
                        <p class="mt-0.5 text-xs leading-snug text-muted-foreground">@milestone.Description</p>
                    </li>
                }
            </ol>
            <div class="mt-4 flex justify-end">
                <span class="inline-flex items-center gap-1 rounded-md border bg-background px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                    <LucideIconCn Name="flag" Size="12" Class="size-3 text-foreground" />
                    Finish
                </span>
            </div>
        </div>

        @* CTA pair *@
        <div class="mt-12 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <ButtonCn Class="w-full sm:w-[220px]">Start your trip</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[240px]">Preview the route</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record RoadMilestone(string Id, string Title, string Description, int X, int Y);

    private const string _roadPath = "M 4 24 C 18 8, 28 58, 40 46 S 56 14, 64 28 S 78 64, 88 52 S 96 28, 104 34";

    private static readonly RoadMilestone[] _milestones =
    [
        new("discover",    "Discover",    "Explore templates and pick the right starting point for your team.",       14, 22),
        new("configure",   "Configure",   "Connect integrations and dial in environment settings in minutes.",        36, 48),
        new("collaborate", "Collaborate", "Invite teammates with scoped roles and shared live previews.",             52, 28),
        new("launch",      "Launch",      "Ship to production with one-click rollouts and instant rollback.",         72, 56),
        new("iterate",     "Iterate",     "Gather insights, run experiments, and keep shipping improvements.",        88, 32),
    ];
}
