@* ============================================================
   Block: features-sequential-milestone-checklist
   Title: FeaturesSequentialMilestoneChecklist
   Description: A progressive numbered milestone checklist features section for React and Next.js with vertical timeline progress tracking, expandable milestone cards, nested requirement categories, and completion state built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-sequential-milestone-checklist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header Summary *@
        <div class="border-b p-6">
            <h2 class="text-sm font-medium">Product Launch Roadmap</h2>
            <p class="mt-2 text-sm text-muted-foreground">
                @_completedCount of @_totalCount milestones complete
            </p>
            <div class="mt-4 flex items-center gap-3">
                <div class="flex-1 overflow-hidden rounded-full bg-muted/50 h-2">
                    <div class="h-full bg-emerald-500" style="@($"width:{_overallProgress}%")" aria-hidden="true"></div>
                </div>
                <span class="text-sm font-medium tabular-nums text-muted-foreground">
                    @(_overallProgress)%
                </span>
            </div>
        </div>

        @* Milestones *@
        <div class="relative p-6">
            @* Vertical Timeline Line *@
            <svg class="absolute left-6 top-0 w-0.5 h-full" aria-hidden="true" width="2" height="100%" viewBox="0 0 2 100" preserveAspectRatio="none">
                <defs>
                    <linearGradient id="timelineGradient" x1="0" x2="0" y1="0" y2="1">
                        <stop offset="0%" stop-color="rgb(16, 185, 129)" />
                        @if (_inProgressIndex >= 0)
                        {
                            var pct = (int)Math.Round((_inProgressIndex + 0.3) / _milestones.Length * 100);
                            <stop offset="@($"{pct}%")" stop-color="rgb(16, 185, 129)" />
                            <stop offset="@($"{pct}%")" stop-color="rgb(59, 130, 246)" />
                            <stop offset="100%" stop-color="rgb(59, 130, 246)" />
                        }
                    </linearGradient>
                </defs>
                <line x1="1" y1="0" x2="1" y2="100%" stroke="url(#timelineGradient)" stroke-width="2" />
            </svg>

            <div class="space-y-6 pl-8">
                @foreach (var milestone in _milestones)
                {
                    var ms = milestone;
                    var isExpanded = _expandedMilestones.Contains(ms.Id);
                    var allItems = ms.Requirements.SelectMany(r => r.Items).ToArray();
                    var completedItems = allItems.Count(i => i.Completed);
                    var itemProgress = allItems.Length > 0 ? (int)Math.Round((double)completedItems / allItems.Length * 100) : 0;

                    var nodeColor = ms.Status switch
                    {
                        "completed" => "bg-emerald-500",
                        "in-progress" => "bg-blue-500",
                        _ => "bg-muted"
                    };
                    var borderColor = ms.Status switch
                    {
                        "completed" => "border-l-emerald-500",
                        "in-progress" => "border-l-blue-500",
                        _ => "border-l-muted"
                    };

                    @* Milestone Card *@
                    <div class="@(Cn.Merge("relative -ml-8 rounded-lg border-l-2 bg-card", borderColor, ms.Status == "locked" ? "opacity-50" : ""))">
                        @* Timeline Node *@
                        <div class="@(Cn.Merge("absolute -left-5 top-6 flex items-center justify-center size-8 sm:size-10 rounded-full border-4 border-card", nodeColor))">
                            @if (ms.Status == "completed")
                            {
                                <LucideIconCn Name="check" Size="16" Class="size-4 sm:size-5 text-white" />
                            }
                            @if (ms.Status == "in-progress")
                            {
                                <span class="size-3 rounded-full bg-white" aria-hidden="true"></span>
                            }
                            @if (ms.Status == "locked")
                            {
                                <LucideIconCn Name="lock" Size="16" Class="size-4 sm:size-5 text-muted-foreground" />
                            }
                        </div>

                        @* Card Content *@
                        <div class="p-4 sm:p-6">
                            @* Header button *@
                            <button type="button"
                                    @onclick="@(() => ToggleMilestone(ms.Id, ms.Status))"
                                    disabled="@(ms.Status == "locked" ? "disabled" : null)"
                                    class="@(Cn.Merge("w-full text-left flex items-start justify-between gap-4", ms.Status == "locked" ? "cursor-not-allowed" : ""))">
                                <div class="flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-xs font-medium text-muted-foreground">@ms.Number</span>
                                        <h3 class="text-sm font-medium">@ms.Title</h3>
                                    </div>
                                    <p class="mt-1 text-sm text-muted-foreground">@ms.Description</p>
                                    @if (ms.CompletedDate != null)
                                    {
                                        <p class="mt-2 text-xs text-muted-foreground">Completed @ms.CompletedDate</p>
                                    }
                                </div>

                                @if (ms.Status != "locked")
                                {
                                    <div class="@(Cn.Merge("mt-1 flex-shrink-0 transition-transform duration-200", isExpanded ? "rotate-180" : ""))">
                                        <LucideIconCn Name="chevron-down" Size="16" Class="size-4 text-muted-foreground" />
                                    </div>
                                }
                            </button>

                            @* Progress Bar (In-Progress Only) *@
                            @if (ms.Status == "in-progress")
                            {
                                <div class="mt-4 flex items-center gap-3">
                                    <div class="flex-1 overflow-hidden rounded-full bg-muted/50 h-1.5">
                                        <div class="h-full bg-blue-500" style="@($"width:{itemProgress}%")" aria-hidden="true"></div>
                                    </div>
                                    <span class="text-xs text-muted-foreground tabular-nums whitespace-nowrap">
                                        @completedItems/@allItems.Length
                                    </span>
                                </div>
                            }

                            @* Expandable Content *@
                            @if (isExpanded && ms.Status != "locked")
                            {
                                <div class="overflow-hidden">
                                    <div class="mt-6 space-y-6 border-t pt-6">
                                        @foreach (var req in ms.Requirements)
                                        {
                                            var requirement = req;
                                            <div>
                                                <h4 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">@requirement.Category</h4>
                                                <ul class="mt-3 space-y-2">
                                                    @foreach (var itm in requirement.Items)
                                                    {
                                                        var checkItem = itm;
                                                        <li class="flex items-start gap-3">
                                                            @if (checkItem.Completed)
                                                            {
                                                                <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 text-emerald-600 flex-shrink-0" />
                                                            }
                                                            else
                                                            {
                                                                <div class="mt-0.5 size-4 rounded-full border-2 border-muted flex-shrink-0" aria-hidden="true"></div>
                                                            }
                                                            <span class="@(Cn.Merge("text-sm", checkItem.Completed ? "text-muted-foreground line-through" : ""))">
                                                                @checkItem.Label
                                                            </span>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ChecklistItem(string Id, string Label, bool Completed);

    private record MilestoneRequirement(string Id, string Category, ChecklistItem[] Items);

    private record Milestone(string Id, string Number, string Title, string Description, string Status, string? CompletedDate, MilestoneRequirement[] Requirements);

    private static readonly Milestone[] _milestones =
    [
        new("beta", "01", "Beta Launch", "Initial release to early adopters", "completed", "Jan 15, 2026",
        [
            new("beta-tech", "Technical Setup",
            [
                new("beta-infra", "Infrastructure deployment", true),
                new("beta-monitoring", "Monitoring and logging", true),
                new("beta-testing", "QA testing suite", true),
            ]),
            new("beta-access", "Early Access",
            [
                new("beta-invite", "Invite 50 beta users", true),
                new("beta-feedback", "Collect initial feedback", true),
            ]),
        ]),
        new("ga", "02", "General Availability", "Public release for all users", "in-progress", null,
        [
            new("ga-legal", "Legal & Compliance",
            [
                new("ga-terms", "Finalize terms of service", true),
                new("ga-privacy", "Privacy policy review", true),
                new("ga-gdpr", "GDPR compliance audit", false),
            ]),
            new("ga-security", "Security",
            [
                new("ga-pentest", "Penetration testing", true),
                new("ga-ssl", "SSL/TLS certification", true),
                new("ga-secrets", "Secrets management review", false),
            ]),
            new("ga-support", "Support Infra",
            [
                new("ga-docs", "Complete user documentation", true),
                new("ga-helpdesk", "Support ticket system ready", false),
            ]),
        ]),
        new("enterprise", "03", "Enterprise Tier", "Advanced features for organizations", "locked", null,
        [
            new("ent-sso", "Enterprise Features",
            [
                new("ent-saml", "SAML/SSO integration", false),
                new("ent-scim", "SCIM user provisioning", false),
                new("ent-audit", "Audit logging", false),
            ]),
            new("ent-soc", "Compliance",
            [
                new("ent-soc2", "SOC 2 Type II certification", false),
                new("ent-hipaa", "HIPAA compliance", false),
            ]),
        ]),
        new("intl", "04", "International Expansion", "Global availability and localization", "locked", null,
        [
            new("intl-data", "Data & Compliance",
            [
                new("intl-eu", "EU data residency setup", false),
                new("intl-apac", "APAC region support", false),
            ]),
            new("intl-lang", "Localization",
            [
                new("intl-i18n", "Multi-language UI", false),
                new("intl-currency", "Multi-currency billing", false),
            ]),
        ]),
        new("platform", "05", "Platform API", "Developer API and integrations", "locked", null,
        [
            new("plat-api", "API Development",
            [
                new("plat-rest", "RESTful API v2", false),
                new("plat-graphql", "GraphQL endpoint", false),
                new("plat-webhooks", "Webhooks support", false),
            ]),
            new("plat-docs", "Developer Experience",
            [
                new("plat-apidocs", "API documentation", false),
                new("plat-sdk", "Official SDKs", false),
            ]),
        ]),
    ];

    private HashSet<string> _expandedMilestones = ["ga"];

    private int _completedCount => _milestones.Count(m => m.Status == "completed");
    private int _totalCount => _milestones.Length;
    private int _overallProgress => (int)Math.Round((double)_completedCount / _totalCount * 100);
    private int _inProgressIndex => Array.FindIndex(_milestones, m => m.Status == "in-progress");

    private void ToggleMilestone(string id, string status)
    {
        if (status == "locked") return;
        if (_expandedMilestones.Contains(id))
            _expandedMilestones.Remove(id);
        else
            _expandedMilestones.Add(id);
    }
}
