@* ============================================================
   Block: features-magnifier-lens-hover-scanner
   Title: FeaturesMagnifierLensHoverScanner
   Description: A magnifier lens hover scanner features section for React and Next.js with a twelve-tile integration grid, draggable circular lens that scales tiles under its radius, tooltip reveals, and a fading onboarding hint built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-magnifier-lens-hover-scanner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Headline *@
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
          Twelve integrations
        </span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
          Scan the marketplace.
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          Move the lens across the grid to inspect any integration. Tiles under the lens scale
          up and reveal their category.
        </p>
      </div>
      <div class="flex items-center gap-2 rounded-lg border bg-muted/30 px-3 py-2">
        <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground" />
        <span class="font-mono text-[11px] text-foreground">
          @(_closestIntegration != null ? _closestIntegration.Name : "aim the lens")
        </span>
      </div>
    </div>

    @* Scanner area *@
    <div class="mt-10 overflow-hidden rounded-2xl border bg-muted/10">
      <div
        @onpointermove="HandlePointerMove"
        @onpointerenter="HandlePointerEnter"
        @onpointerleave="HandlePointerLeave"
        class="relative h-[420px] touch-none select-none p-6"
        style="position:relative;"
      >
        @* Tile grid *@
        <div class="grid h-full grid-cols-3 gap-3 md:grid-cols-4">
          @foreach (var integration in _integrations)
          {
            var itg = integration;
            var isHighlighted = _highlightedIds.Contains(itg.Id);
            var isClosest = itg.Id == _closestId;
            <button
              type="button"
              aria-label="@($"{itg.Name} · {itg.Category}")"
              class="@Cn.Merge(
                "relative flex flex-col items-center justify-center gap-2 rounded-xl border bg-card p-3 transition-all duration-200",
                isClosest ? "border-foreground scale-[1.08]" : isHighlighted ? "border-foreground/40 scale-[1.02]" : "border-border opacity-55"
              )"
            >
              <span
                class="@Cn.Merge(
                  "flex size-8 items-center justify-center rounded-md border transition-colors",
                  isClosest ? "bg-foreground text-background" : "bg-background"
                )"
              >
                <LucideIconCn Name="@itg.IconName" Size="16" Class="size-4" />
              </span>
              <span
                class="@Cn.Merge(
                  "text-[11px] font-medium transition-colors",
                  isClosest || isHighlighted ? "text-foreground" : "text-muted-foreground"
                )"
              >
                @itg.Name
              </span>
            </button>
          }
        </div>

        @* Magnifier lens overlay *@
        @if (_isActive || _lensX > 0 || _lensY > 0)
        {
          <div
            class="pointer-events-none absolute rounded-full border-2 border-foreground backdrop-blur-[1px] transition-all duration-[50ms]"
            style="@(FormattableString.Invariant($"width:{LensDiameter}px;height:{LensDiameter}px;top:{_lensY - LensRadius}px;left:{_lensX - LensRadius}px;box-shadow:0 0 0 9999px rgba(0,0,0,0.04), inset 0 0 0 1px rgba(255,255,255,0.4);"))"
          >
            @* Crosshair *@
            <div class="absolute left-1/2 top-1/2 h-px w-3 -translate-x-1/2 -translate-y-1/2 bg-foreground/60" />
            <div class="absolute left-1/2 top-1/2 h-3 w-px -translate-x-1/2 -translate-y-1/2 bg-foreground/60" />
            @* Tooltip *@
            @if (_closestIntegration != null)
            {
              <div class="absolute -top-8 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md border bg-card px-2 py-1 text-[10px] font-medium text-foreground shadow-sm">
                @_closestIntegration.Name @("·")
                <span class="text-muted-foreground">@_closestIntegration.Category</span>
              </div>
            }
          </div>
        }

        @* Hover hint *@
        @if (_hintVisible && !_isActive)
        {
          <div class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
            <div class="rounded-full border bg-background/90 px-3 py-1.5 font-mono text-[10px] uppercase tracking-wider text-muted-foreground shadow-sm">
              hover here to scan
            </div>
          </div>
        }
      </div>

      @* Footer strip *@
      <div class="flex items-center justify-between border-t bg-background/40 px-5 py-3">
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
            Total integrations
          </span>
          <span class="font-mono text-xs font-medium text-foreground tabular-nums">
            @_integrations.Length
          </span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
            Under lens
          </span>
          <span class="font-mono text-xs font-medium text-foreground tabular-nums">
            @_highlightedIds.Count
          </span>
        </div>
        <div class="hidden items-center gap-2 sm:flex">
          <span class="size-1.5 rounded-full bg-emerald-500" />
          <span class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground">
            @(_isActive ? "scanning" : "idle")
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

@code {
    private const int LensRadius = 100;
    private const int LensDiameter = LensRadius * 2;
    private const int HighlightRadius = 110;

    private double _lensX = 0;
    private double _lensY = 0;
    private bool _hintVisible = true;
    private bool _isActive = false;

    private record Integration(string Id, string Name, string Category, string IconName);

    private static readonly Integration[] _integrations =
    [
        new("slack",    "Slack",    "Communication",     "slack"),
        new("stripe",   "Stripe",   "Payments",          "zap"),
        new("notion",   "Notion",   "Docs",              "bell"),
        new("github",   "GitHub",   "Source",            "github"),
        new("linear",   "Linear",   "Issues",            "trello"),
        new("figma",    "Figma",    "Design",            "figma"),
        new("aws",      "AWS",      "Cloud",             "triangle"),
        new("postgres", "Postgres", "Database",          "database"),
        new("sentry",   "Sentry",   "Errors",            "alert-circle"),
        new("datadog",  "Datadog",  "Monitoring",        "bar-chart-3"),
        new("posthog",  "PostHog",  "Product analytics", "line-chart"),
        new("vercel",   "Vercel",   "Hosting",           "circle-dashed"),
    ];

    // Tile layout: grid 3 cols on mobile, 4 cols on md.
    // We use a fixed 4-col layout approximation for highlight computation
    // based on offset coords from pointer events (OffsetX/OffsetY).
    private HashSet<string> _highlightedIds = new();
    private string? _closestId = null;
    private Integration? _closestIntegration = null;

    // Approximate tile centers based on a 4-column grid within h-[420px] with p-6 and gap-3.
    // Container: 420px height, padding 24px (p-6), so inner height ~372px.
    // Width is responsive; we approximate 4 cols using percentage math at render time.
    // Since we only have OffsetX/OffsetY we compute centers relative to the element.
    // We'll compute them lazily using the pointer position and known grid geometry.
    // Grid: cols=4, rows=3, gap=12px, padding=24px each side.
    // We store approximate tile centers as fractions of the container.
    // Actual position computed per-event using the element's offsetWidth/offsetHeight via OffsetX.
    // Since MouseEventArgs.OffsetX is relative to the target element, we use it directly.

    private void HandlePointerMove(PointerEventArgs e)
    {
        // OffsetX/OffsetY are relative to the event target (the container div)
        var containerWidth = e.ClientX - e.OffsetX; // not usable directly
        // Use OffsetX and OffsetY clamped to lens radius
        // We don't know element dimensions here without JS, so we use a fixed fallback of 600w x 420h
        // This is approximate but sufficient for the interactive highlight effect
        _lensX = Math.Max(LensRadius, Math.Min(600 - LensRadius, e.OffsetX));
        _lensY = Math.Max(LensRadius, Math.Min(420 - LensRadius, e.OffsetY));

        if (_hintVisible) _hintVisible = false;

        // Recompute highlights using approximate tile centers
        // Grid: 4 cols on md, p-6 = 24px, gap-3 = 12px
        // We approximate container width = 600px (demo viewport)
        ComputeHighlights(600, 420);
    }

    private void HandlePointerEnter(PointerEventArgs e)
    {
        _isActive = true;
    }

    private void HandlePointerLeave(PointerEventArgs e)
    {
        _isActive = false;
    }

    private void ComputeHighlights(double containerWidth, double containerHeight)
    {
        const double padding = 24.0;
        const double gap = 12.0;
        const int cols = 4;
        const int rows = 3;

        var innerWidth = containerWidth - padding * 2;
        var innerHeight = containerHeight - padding * 2;
        var tileWidth = (innerWidth - gap * (cols - 1)) / cols;
        var tileHeight = (innerHeight - gap * (rows - 1)) / rows;

        _highlightedIds = new HashSet<string>();
        string? closestId = null;
        double closestDist = double.MaxValue;

        for (var i = 0; i < _integrations.Length; i++)
        {
            var col = i % cols;
            var row = i / cols;
            var cx = padding + col * (tileWidth + gap) + tileWidth / 2.0;
            var cy = padding + row * (tileHeight + gap) + tileHeight / 2.0;
            var dx = cx - _lensX;
            var dy = cy - _lensY;
            var dist = Math.Sqrt(dx * dx + dy * dy);
            if (dist < HighlightRadius)
            {
                _highlightedIds.Add(_integrations[i].Id);
            }
            if (dist < closestDist)
            {
                closestDist = dist;
                closestId = _integrations[i].Id;
            }
        }

        _closestId = closestDist < HighlightRadius ? closestId : null;
        _closestIntegration = _closestId != null
            ? Array.Find(_integrations, itg => itg.Id == _closestId)
            : null;
    }
}
