@* ============================================================
   Block: features-performance-benchmarks
   Title: Features Performance Benchmarks
   Description: A features block comparing performance metrics against industry averages
   Dependencies: None
   Source: original/blocks/features/features-performance-benchmarks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Performance Benchmarks</h2>
            <p class="mt-1 text-xs text-muted-foreground">How we compare to industry standards</p>
        </div>

        @for (var i = 0; i < _benchmarks.Length; i++)
        {
            var benchmark = _benchmarks[i];
            <div class="@(i < _benchmarks.Length - 1 ? "border-b" : "")">
                <div class="px-4 py-3">
                    <div class="mb-2 flex items-baseline justify-between">
                        <p class="text-sm font-medium">@benchmark.Metric</p>
                        <div class="flex items-baseline gap-3">
                            <div class="text-right">
                                <span class="text-sm font-semibold tabular-nums">@benchmark.YourValue</span>
                                <span class="ml-1 text-xs text-muted-foreground">@benchmark.Unit</span>
                            </div>
                            <div class="text-right">
                                <span class="text-xs tabular-nums text-muted-foreground">@benchmark.IndustryAverage</span>
                                <span class="ml-1 text-xs text-muted-foreground">@benchmark.Unit</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="flex-1">
                            <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                                <div class="h-full bg-foreground" style="width: @(benchmark.YourPercentage)%"></div>
                            </div>
                        </div>
                        <div class="flex-1">
                            <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                                <div class="h-full bg-muted-foreground/50" style="width: @(benchmark.IndustryPercentage)%"></div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-1 flex justify-between text-xs text-muted-foreground">
                        <span>Our platform</span>
                        <span>Industry average</span>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Benchmark(string Metric, string YourValue, string IndustryAverage, int YourPercentage, int IndustryPercentage, string Unit);

    private static readonly Benchmark[] _benchmarks =
    [
        new("API response time", "45", "180", 25, 100, "ms"),
        new("Page load speed", "0.8", "2.4", 33, 100, "sec"),
        new("Uptime guarantee", "99.99", "99.5", 100, 95, "%"),
        new("Time to first byte", "120", "450", 27, 100, "ms"),
        new("Build time", "2.1", "8.5", 25, 100, "min"),
    ];
}
