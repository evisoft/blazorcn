@* ============================================================
   Block: features-card-carousel
   Title: FeaturesCardCarousel
   Description: A horizontal snap-scroll card carousel features section for React and Next.js with prev and next arrow navigation, multi-card visible layout, and crosshair image placeholder cards built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-card-carousel.tsx
   ============================================================ *@

@inject IJSRuntime JS

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="rounded-2xl border bg-card p-6 sm:p-10">

    @* Header row: headline on the left, arrow controls on the right *@
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
          Capabilities
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Swipe through the platform
        </h2>
        <p class="mt-3 max-w-md text-base leading-relaxed text-muted-foreground">
          Every flagship capability, arranged on a single scrollable shelf. Drag, swipe, or use
          the arrows to explore.
        </p>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <button
          aria-label="Scroll to previous cards"
          class="flex size-10 items-center justify-center rounded-full border bg-background text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
          @onclick="@(() => ScrollBy(_prev))"
          type="button"
        >
          <LucideIconCn Name="chevron-left" Size="20" Class="size-5" />
        </button>
        <button
          aria-label="Scroll to next cards"
          class="flex size-10 items-center justify-center rounded-full border bg-background text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
          @onclick="@(() => ScrollBy(_next))"
          type="button"
        >
          <LucideIconCn Name="chevron-right" Size="20" Class="size-5" />
        </button>
      </div>
    </div>

    @* Snap-scroll carousel shelf *@
    <div
      aria-label="Product capability cards"
      class="-mx-6 mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-6 pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:-mx-10 sm:px-10"
      @ref="_scrollerRef"
      role="region"
    >
      @foreach (var card in _featureCards)
      {
        <article
          data-carousel-card="true"
          class="group flex w-[85%] shrink-0 snap-start flex-col overflow-hidden rounded-xl border bg-card transition-colors hover:bg-muted/30 sm:w-[calc((100%-1rem)/2)] lg:w-[calc((100%-2rem)/3)]"
        >
          @* Image placeholder with crosshair *@
          <div class="relative flex aspect-[4/3] w-full items-center justify-center border-b bg-muted">
            <div class="relative flex items-center justify-center">
              <div class="absolute size-24 rounded-full border border-muted-foreground/[0.06]"></div>
              <div class="absolute size-14 rounded-full border border-muted-foreground/[0.08]"></div>
              <div class="absolute h-px w-32 bg-muted-foreground/[0.06]"></div>
              <div class="absolute h-32 w-px bg-muted-foreground/[0.06]"></div>
              <div class="flex size-9 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                <LucideIconCn Name="@card.IconName" Size="16" Class="size-4 text-muted-foreground/60" />
              </div>
            </div>
            <span class="absolute left-4 top-4 inline-flex items-center rounded-full border bg-background/80 px-2.5 py-0.5 text-[11px] font-medium text-muted-foreground backdrop-blur">
              @card.Tag
            </span>
          </div>

          @* Text area *@
          <div class="flex flex-1 flex-col p-5">
            <div class="flex items-center gap-2">
              <span
                aria-hidden="true"
                class="flex size-8 items-center justify-center rounded-lg bg-muted"
              >
                <LucideIconCn Name="@card.IconName" Size="16" Class="size-4 text-muted-foreground" />
              </span>
              <h3 class="text-base font-semibold text-foreground">@card.Title</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
              @card.Description
            </p>
          </div>
        </article>
      }
    </div>

    @* Hint + count *@
    <div class="mt-6 flex items-center justify-between text-xs text-muted-foreground">
      <span>Drag, swipe, or use the arrows above</span>
      <span class="tabular-nums">@_featureCards.Length capabilities</span>
    </div>

  </div>
</section>

@code {
    private ElementReference _scrollerRef;
    private const string _prev = "prev";
    private const string _next = "next";

    private record FeatureCard(string Id, string IconName, string Tag, string Title, string Description);

    private static readonly FeatureCard[] _featureCards =
    [
        new("edge-network",        "globe",          "Platform",     "Global edge network",
            "300+ edge locations across six continents route traffic under 50ms with automatic failover and built-in DDoS protection."),
        new("instant-builds",      "zap",            "Performance",  "Instant builds",
            "Incremental builds complete in seconds with content-addressed caching and parallel workers across every commit."),
        new("preview-deployments", "git-branch",     "Workflow",     "Preview deployments",
            "Every pull request gets an isolated URL with its own environment variables so teammates can review before merging."),
        new("observability",       "gauge",          "Observability","Live observability",
            "Trace requests end to end with structured logs, flamegraphs, and alerts that route to Slack or PagerDuty in seconds."),
        new("enterprise-sso",      "shield-check",   "Security",     "Enterprise SSO",
            "SAML 2.0 with Okta, Azure AD, and Google Workspace plus SCIM 2.0 just-in-time provisioning and enforced MFA."),
        new("serverless-runtime",  "cloud",          "Runtime",      "Serverless runtime",
            "Run Node, Bun, Deno, or Python handlers with per-request isolation and zero cold starts on the hot path."),
        new("ai-copilot",          "sparkles",       "AI",           "AI copilot",
            "Context-aware completions across your codebase with diff-aware suggestions trained on your own style guides."),
        new("cli-toolkit",         "code",           "Developer",    "Scriptable CLI",
            "A fully typed CLI mirrors every dashboard action so you can script deployments, rollbacks, and audits from CI."),
    ];

    private async Task ScrollBy(string direction)
    {
        var delta = direction == "next" ? 1 : -1;
        var script = "(function(){var c=document.querySelector('[aria-label=\"Product capability cards\"]');if(!c)return;var f=c.querySelector('[data-carousel-card]');var w=f?f.offsetWidth:320;c.scrollBy({left:" + delta + "*(w+16),behavior:'smooth'});})()";
        await JS.InvokeVoidAsync("eval", script);
    }
}
