@* ============================================================
   Block: features-minimal-text-divider-stack
   Title: FeaturesMinimalTextDividerStack
   Description: An ultra-minimalist text-only feature list section for React and Next.js with a typographic headline, thin hairline dividers, and right-aligned status descriptors built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-minimal-text-divider-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="py-10 sm:py-14">
        @* Header *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground">@_headline.Eyebrow</p>
            <h2 class="mt-4 text-4xl tracking-tight text-foreground sm:text-5xl">@_headline.Title</h2>
            <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-muted-foreground">@_headline.Subtitle</p>
        </div>

        @* Feature rows *@
        <div class="mt-12">
            @foreach (var feat in _features)
            {
                <div class="flex items-baseline justify-between border-t border-border/40 px-2 py-4 transition-colors hover:bg-muted/20">
                    <span class="text-base font-medium text-foreground">@feat.Name</span>
                    <span class="text-sm text-muted-foreground">@feat.Descriptor</span>
                </div>
            }
            @* Closing divider *@
            <div class="border-t border-border/40"></div>
        </div>

        @* Understated link *@
        <div class="mt-10 text-center">
            <a href="#learn-more" class="group inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground">
                Learn more
                <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5 transition-transform group-hover:translate-x-0.5" />
            </a>
        </div>
    </div>
</section>

@code {
    private record Headline(string Eyebrow, string Title, string Subtitle);
    private record Feature(string Id, string Name, string Descriptor);

    private static readonly Headline _headline = new(
        "Principles",
        "Less is more",
        "Six capabilities, zero ceremony. Everything you need to ship, nothing you have to learn twice."
    );

    private static readonly Feature[] _features =
    [
        new("zero-config-deploy", "Zero-config deploy", "Available on all plans"),
        new("edge-runtime", "Edge runtime", "Global by default"),
        new("realtime-collab", "Real-time collaboration", "Beta"),
        new("preview-environments", "Preview environments", "Per pull request"),
        new("automatic-scaling", "Automatic scaling", "Zero to millions"),
        new("builtin-observability", "Built-in observability", "New in v2.1"),
    ];
}
