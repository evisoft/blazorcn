@* ============================================================
   Block: features-toggle-switch-control-panel
   Title: FeaturesToggleSwitchControlPanel
   Description: A control panel features section for React and Next.js with a grid of labeled toggle switches, save configuration banner, and enabled counter, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-toggle-switch-control-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Header *@
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Configuration
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Every capability is a switch you control.
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        No tiers, no hidden unlocks — turn features on when your team is ready for them, and off
        when you are not.
      </p>
    </div>

    @* Save configuration banner *@
    <div class="mt-10 flex flex-col items-start gap-3 rounded-lg border bg-muted/40 p-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <div class="flex size-8 items-center justify-center rounded-md border bg-background">
          <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-500" />
        </div>
        <div>
          <p class="text-sm font-semibold">Save configuration</p>
          <p class="text-xs text-muted-foreground">
            <span class="font-mono tabular-nums">@_enabledCount</span> of
            <span class="font-mono tabular-nums">@_totalCount</span> enabled • unsaved
            changes
          </p>
        </div>
      </div>
      <span class="rounded-md border border-border bg-background px-3 py-1.5 text-xs font-medium text-muted-foreground">
        Autosaved 2 min ago
      </span>
    </div>

    @* Toggle grid *@
    <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      @foreach (var toggle in _toggles)
      {
        <div class="@Cn.Merge("rounded-lg border p-4 transition-colors", toggle.Enabled ? "bg-card" : "bg-muted/30")">
          <div class="flex items-start justify-between gap-3">
            <h3 class="text-sm font-semibold leading-tight">@toggle.Title</h3>
            @* ToggleSwitch *@
            <div
              aria-hidden="true"
              class="@Cn.Merge("relative h-6 w-11 shrink-0 rounded-full border transition-colors", toggle.Enabled ? "border-foreground bg-foreground" : "border-border bg-muted")"
            >
              <div
                class="@Cn.Merge("absolute top-1/2 size-4 -translate-y-1/2 rounded-full shadow-sm transition-all bg-background", toggle.Enabled ? "left-[calc(100%-1.125rem)]" : "left-[2px]")"
              ></div>
            </div>
          </div>
          <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
            @toggle.Description
          </p>
          <div class="mt-3 flex items-center gap-1.5">
            <span class="@Cn.Merge("size-1.5 rounded-full", toggle.Enabled ? "bg-emerald-500" : "bg-muted-foreground/40")"></span>
            <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
              @(toggle.Enabled ? "Enabled" : "Disabled")
            </span>
          </div>
        </div>
      }
    </div>

    @* CTA pair *@
    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <ButtonCn Class="w-full sm:w-[200px]">Open settings</ButtonCn>
      <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">
        See full list
      </ButtonCn>
    </div>
  </div>
</section>

@code {
    private record ToggleFeature(string Id, string Title, string Description, bool Enabled);

    private static readonly ToggleFeature[] _toggles =
    [
        new("sso", "Single sign-on", "SAML 2.0 and OIDC across Okta, Entra ID, and Google Workspace.", true),
        new("audit", "Audit logging", "Immutable event trail streamed to your SIEM every 15 seconds.", true),
        new("ip-allow", "IP allowlist", "Restrict dashboard and API access to a set of trusted CIDR ranges.", true),
        new("mfa", "Enforced MFA", "Require hardware keys or TOTP for every member, including owners.", true),
        new("scim", "SCIM provisioning", "Auto-sync user and group membership from your identity provider.", true),
        new("session", "Session timeout", "Force re-authentication after a configurable idle window.", false),
    ];

    private int _enabledCount => _toggles.Count(t => t.Enabled);
    private int _totalCount => _toggles.Length;
}
