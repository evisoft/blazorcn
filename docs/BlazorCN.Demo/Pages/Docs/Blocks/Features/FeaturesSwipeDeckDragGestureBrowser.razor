@* ============================================================
   Block: features-swipe-deck-drag-gesture-browser
   Title: FeaturesSwipeDeckDragGestureBrowser
   Description: A swipe deck drag gesture features section for React and Next.js with draggable horizontal cards, velocity-based fling dismissal, rotation on drag offset, and left/right arrow controls built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-swipe-deck-drag-gesture-browser.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline *@
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div class="max-w-xl">
                <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Six reasons to ship
                </span>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                    Swipe through the benefits.
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                    Drag any card left or right to send it to the back of the deck. Arrow keys and the
                    buttons below work too.
                </p>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground">
                    @((_activeIndex + 1).ToString("D2")) / @(_total.ToString("D2"))
                </span>
            </div>
        </div>

        @* Deck area *@
        <div class="mt-10 flex flex-col items-center gap-6">
            <div class="relative h-[380px] w-full max-w-md">
                @foreach (var card in _swipeCards)
                {
                    var i = Array.IndexOf(_swipeCards, card);
                    var rel = GetRelativePosition(i, _activeIndex, _total);
                    var isFront = rel == 0;
                    var isFirstPeek = rel == 1;
                    var isSecondPeek = rel == 2;

                    if (!isFront && !isFirstPeek && !isSecondPeek) { continue; }

                    var offsetY = isFront ? 0 : isFirstPeek ? 12 : 24;
                    var scaleVal = isFront ? 1.0 : isFirstPeek ? 0.96 : 0.92;
                    var opacityVal = isFront ? 1.0 : isFirstPeek ? 0.7 : 0.4;
                    var zIndex = _total - rel;
                    var inv = System.Globalization.CultureInfo.InvariantCulture;
                    var cardStyle = $"z-index:{zIndex}; transform: translateY({offsetY}px) scale({scaleVal.ToString("F2", inv)}); opacity:{opacityVal.ToString("F2", inv)}; transition: transform 0.3s ease, opacity 0.3s ease;";

                    var cardClass = Cn.Merge("absolute inset-0 overflow-hidden rounded-2xl border bg-card shadow-lg", isFront ? "cursor-grab" : "");
                    <div class="@cardClass"
                         style="@cardStyle">
                        <div class="flex h-full flex-col p-6">
                            @* Header *@
                            <div class="flex items-start justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="flex size-8 items-center justify-center rounded-md border bg-background">
                                        <LucideIconCn Name="@card.IconName" Size="16" Class="size-4 text-foreground" />
                                    </span>
                                    <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                                        @card.Eyebrow
                                    </span>
                                </div>
                                <span class="font-mono text-[10px] text-muted-foreground tabular-nums">
                                    @((i + 1).ToString("D2"))
                                </span>
                            </div>

                            @* Title + tagline *@
                            <h3 class="mt-5 text-xl font-semibold leading-tight text-foreground">
                                @card.Title
                            </h3>
                            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                                @card.Tagline
                            </p>

                            @* Details list *@
                            <div class="mt-5 space-y-2 border-t pt-4">
                                @foreach (var detail in card.Details)
                                {
                                    <div class="flex items-center justify-between text-xs">
                                        <span class="font-mono text-muted-foreground">@detail.Label</span>
                                        <span class="font-mono font-medium text-foreground tabular-nums">
                                            @detail.Value
                                        </span>
                                    </div>
                                }
                            </div>

                            @* Metric footer *@
                            <div class="mt-auto flex items-end justify-between pt-5">
                                <div>
                                    <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                        @card.MetricLabel
                                    </div>
                                    <div class="mt-1 font-mono text-2xl font-semibold text-foreground tabular-nums">
                                        @card.MetricValue
                                    </div>
                                </div>
                                @if (isFront)
                                {
                                    <span class="rounded-full border bg-muted/50 px-2.5 py-1 text-[10px] font-medium text-muted-foreground">
                                        Drag me
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* Direction indicator *@
            @if (_lastDirection != null)
            {
                <div class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground">
                    Swiped @_lastDirection · now showing @_swipeCards[_activeIndex].Eyebrow
                </div>
            }
        </div>

        @* Controls row *@
        <div class="mt-8 flex flex-col gap-4 rounded-xl border bg-muted/30 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" aria-label="Previous card" @onclick="@(() => Advance(-1))">
                    <LucideIconCn Name="arrow-left" Size="16" Class="size-4" />
                    Previous
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" aria-label="Next card" @onclick="@(() => Advance(1))">
                    Next
                    <LucideIconCn Name="arrow-right" Size="16" Class="size-4" />
                </ButtonCn>
            </div>

            <div class="flex items-center gap-0.5">
                @foreach (var card in _swipeCards)
                {
                    var dotCard = card;
                    var dotIndex = Array.IndexOf(_swipeCards, dotCard);
                    var isActive = dotIndex == _activeIndex;
                    var dotLabel = $"Jump to {dotCard.Eyebrow}";
                    var dotClass = Cn.Merge("h-1.5 rounded-full transition-all", isActive ? "w-8 bg-foreground" : "w-2 bg-muted-foreground/30 hover:bg-muted-foreground/60");
                    <button type="button"
                            aria-label="@dotLabel"
                            @onclick="@(() => JumpTo(dotIndex))"
                            class="inline-flex h-6 min-w-6 items-center justify-center">
                        <span class="@dotClass"></span>
                    </button>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record SwipeCardDetail(string Label, string Value);

    private record SwipeCard(
        string Id,
        string IconName,
        string Eyebrow,
        string Title,
        string Tagline,
        string MetricLabel,
        string MetricValue,
        SwipeCardDetail[] Details
    );

    private static readonly SwipeCard[] _swipeCards =
    [
        new("speed", "gauge", "Speed", "Sub-50ms page loads anywhere",
            "An edge runtime built on V8 isolates ships responses from the POP closest to every visitor, worldwide.",
            "p95 TTFB", "38 ms",
            [
                new("Edge POPs", "312"),
                new("Cold starts", "0"),
                new("Cache hit rate", "99.4%"),
            ]),
        new("security", "shield-check", "Security", "SOC 2 Type II guarantees, out of the box",
            "Every request is encrypted with TLS 1.3, every secret lives in a HSM, and every action lands in an append-only audit log.",
            "Audited", "SOC 2",
            [
                new("Encryption", "TLS 1.3"),
                new("Key rotation", "90 days"),
                new("Audit retention", "7 years"),
            ]),
        new("scale", "layers", "Scale", "From zero to a million without a pager",
            "Autoscaling responds to queue pressure every thirty seconds, absorbing traffic spikes without touching a config file.",
            "Peak RPS", "1.2M",
            [
                new("Scale unit", "30 s"),
                new("Max workers", "8,192"),
                new("Burst absorption", "14x"),
            ]),
        new("simplicity", "sparkles", "Simplicity", "One command from local to production",
            "No YAML. No pipelines. Just a single deploy command that ships your branch to a preview URL with every push.",
            "Setup time", "2 min",
            [
                new("CLI commands", "1"),
                new("Config files", "0"),
                new("Preview URLs", "∞"),
            ]),
        new("support", "heart-handshake", "Support", "Engineers answering engineers, 24/7",
            "Premium plans include a private Slack channel staffed by the same engineers who write the core runtime.",
            "Median response", "4 min",
            [
                new("Channels", "Slack + email"),
                new("Coverage", "24/7/365"),
                new("First responder", "Tier-3"),
            ]),
        new("savings", "banknote", "Savings", "Pay for what runs, never for what idles",
            "Per-request billing replaces reserved instances, and unused allowance rolls forward to the next month automatically.",
            "Avg bill cut", "−38%",
            [
                new("Pricing unit", "per request"),
                new("Rollover", "90 days"),
                new("Commit tiers", "4"),
            ]),
    ];

    private int _activeIndex = 0;
    private string? _lastDirection = null;
    private int _total => _swipeCards.Length;

    private static int GetRelativePosition(int cardIndex, int activeIndex, int total)
        => (cardIndex - activeIndex + total) % total;

    private void Advance(int direction)
    {
        _lastDirection = direction == 1 ? "left" : "right";
        _activeIndex = (_activeIndex + direction + _total) % _total;
    }

    private void JumpTo(int index)
    {
        if (index == _activeIndex) return;
        _lastDirection = index > _activeIndex ? "left" : "right";
        _activeIndex = index;
    }
}
