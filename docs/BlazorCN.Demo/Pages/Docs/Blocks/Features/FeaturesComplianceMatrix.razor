@* ============================================================
   Block: features-compliance-matrix
   Title: Features Compliance Matrix
   Description: A compliance certification matrix showing security standards and their implementation status with visual indicators
   Long Description: Technical specifications in key-value pairs
   Dependencies: None
   Source: original/blocks/features/features-compliance-matrix.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
          <h2 class="text-sm font-medium">Compliance &amp; Certifications</h2>
          <p class="mt-1 text-muted-foreground text-xs">
            Security standards and implementation status
          </p>
        </div>

        <div class="divide-y">
          @foreach (var standard in _standards)
          {
            <div class="grid grid-cols-[1fr_auto_auto] items-center gap-3 px-4 py-3">
              <div class="min-w-0">
                <div class="text-sm font-medium">@standard.Name</div>
                <div class="mt-0.5 text-muted-foreground text-xs">@standard.Description</div>
              </div>

              <div class="flex items-center gap-2">
                <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", GetStatusColor(standard.Status)))"></span>
                <span class="text-nowrap text-muted-foreground text-xs">@GetStatusLabel(standard.Status)</span>
              </div>

              <div class="text-right text-muted-foreground text-xs tabular-nums">
                @standard.Coverage
              </div>
            </div>
          }
        </div>

        <div class="bg-muted/50 px-4 py-3">
          <p class="text-muted-foreground text-xs">
            Last audit: January 15, 2026 &#x2022; Next review: April 15, 2026
          </p>
        </div>
      </div>
    </section>

@code {
    private record ComplianceStandard(string Name, string Description, string Status, string Coverage);

    private static readonly ComplianceStandard[] _standards = new[]
    {
        new ComplianceStandard("SOC 2 Type II", "Security, availability, and confidentiality", "certified", "100%"),
        new ComplianceStandard("GDPR", "EU data protection regulation", "certified", "100%"),
        new ComplianceStandard("HIPAA", "Healthcare data privacy and security", "in-progress", "85%"),
        new ComplianceStandard("ISO 27001", "Information security management", "certified", "100%"),
        new ComplianceStandard("PCI DSS", "Payment card data security", "in-progress", "92%"),
        new ComplianceStandard("CCPA", "California consumer privacy", "certified", "100%"),
        new ComplianceStandard("FedRAMP", "Federal cloud security authorization", "planned", "0%"),
    };

    private static string GetStatusColor(string status) => status switch
    {
        "certified" => "bg-emerald-500",
        "in-progress" => "bg-amber-500",
        "planned" => "bg-muted-foreground/40",
        _ => "bg-gray-500",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "certified" => "Certified",
        "in-progress" => "In Progress",
        "planned" => "Planned",
        _ => status,
    };
}
