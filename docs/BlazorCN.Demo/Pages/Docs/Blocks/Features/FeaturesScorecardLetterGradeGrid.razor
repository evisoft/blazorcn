@* ============================================================
   Block: features-scorecard-letter-grade-grid
   Title: FeaturesScorecardLetterGradeGrid
   Description: A scorecard grid features section for React and Next.js with oversized serif letter grades, category reports, and a GPA summary strip built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-scorecard-letter-grade-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div>
    @* Headline cluster *@
    <div class="text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        The report card
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Graded where it actually counts.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
        Independent audits, customer reviews, and our own honest self-assessment — no selective
        bullet points, no hand-picked testimonials.
      </p>
    </div>

    @* Scorecard grid *@
    <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      @foreach (var card in _scorecards)
      {
        <article class="group flex flex-col rounded-xl border bg-card p-6">
          <div class="flex items-start justify-between gap-4">
            <div class="flex flex-col">
              <span class="flex size-9 items-center justify-center rounded-lg border bg-background">
                <LucideIconCn Name="@card.IconName" Size="16" Class="size-4 text-muted-foreground" />
              </span>
              <h3 class="mt-5 text-sm font-medium uppercase tracking-wider text-muted-foreground">
                @card.Category
              </h3>
            </div>
            <span class="font-serif text-6xl font-semibold leading-none tracking-tight text-foreground">
              @card.Grade
            </span>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
            @card.Description
          </p>
          <div class="mt-auto flex items-center justify-between border-t pt-4">
            <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
              Proficiency
            </span>
            <div aria-hidden="true" class="flex items-center gap-1.5">
              @for (int i = 0; i < 5; i++)
              {
                var idx = i;
                <span class="@Cn.Merge("size-1.5 rounded-full", idx < card.Proficiency ? "bg-foreground" : "bg-muted-foreground/25")"></span>
              }
            </div>
          </div>
        </article>
      }
    </div>

    @* GPA summary strip *@
    <div class="mt-4 flex flex-col items-stretch gap-0 rounded-xl border bg-muted/30 sm:flex-row sm:items-center sm:divide-x">
      <div class="flex items-center gap-4 px-6 py-5">
        <span class="font-serif text-4xl font-semibold leading-none text-foreground">
          @_averageDisplay
        </span>
        <div>
          <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
            Overall GPA
          </div>
          <div class="text-sm font-medium text-foreground">out of 4.0</div>
        </div>
      </div>
      <div class="flex flex-1 items-center justify-between gap-6 px-6 py-5 text-sm">
        <div>
          <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
            Audits
          </div>
          <div class="mt-1 font-medium text-foreground">SOC 2 · ISO 27001</div>
        </div>
        <div>
          <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
            Reviews
          </div>
          <div class="mt-1 font-medium text-foreground">1,284 customers</div>
        </div>
        <div class="hidden sm:block">
          <div class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
            Last graded
          </div>
          <div class="mt-1 font-medium text-foreground">2 weeks ago</div>
        </div>
      </div>
    </div>
  </div>
</section>

@code {
    private record Scorecard(string Id, string IconName, string Category, string Grade, string Description, int Proficiency);

    private static readonly Scorecard[] _scorecards =
    [
        new("reliability", "gauge",           "Reliability",          "A+", "99.98% uptime across every region, 14 months running.",           5),
        new("security",    "shield-check",    "Security",             "A",  "SOC 2 Type II, ISO 27001, and signed-build attestation.",         5),
        new("performance", "zap",             "Performance",          "A+", "Sub-48ms p95 response time at the edge, end-to-end.",             5),
        new("support",     "headphones",      "Support",              "A",  "12-minute median reply time with a real senior engineer.",        4),
        new("dx",          "pencil-ruler",    "Developer experience", "A-", "Typed SDKs, local-first tooling, and generated docs.",            4),
        new("fairness",    "heart-handshake", "Fair pricing",         "A",  "No vendor lock-in, no surprise overage, no seat tax.",            5),
    ];

    private static readonly Dictionary<string, double> _gradePoints = new()
    {
        ["A+"] = 4.0,
        ["A"]  = 3.85,
        ["A-"] = 3.7,
        ["B+"] = 3.3,
        ["B"]  = 3.0,
        ["B-"] = 2.7,
    };

    private string _averageDisplay = ComputeAverage();

    private static string ComputeAverage()
    {
        double sum = 0;
        foreach (var card in _scorecards)
        {
            if (_gradePoints.TryGetValue(card.Grade, out var pts))
                sum += pts;
        }
        return (sum / _scorecards.Length).ToString("F2");
    }
}
