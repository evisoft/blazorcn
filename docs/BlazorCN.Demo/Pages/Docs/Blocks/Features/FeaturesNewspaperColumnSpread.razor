@* ============================================================
   Block: features-newspaper-column-spread
   Title: FeaturesNewspaperColumnSpread
   Description: A newspaper column spread features section for React and Next.js with a serif masthead, three-column article layout, and a boxed breaking feature built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-newspaper-column-spread.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Eyebrow + headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                The release edition
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Read all about this week's ship.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every release printed plainly, in three columns and one serif — no changelog blur, no
                marketing spin, no @("\"")miscellaneous improvements.@("\"")
            </p>
        </div>

        @* Newspaper spread *@
        <div class="mt-12 overflow-hidden rounded-xl border bg-card">
            @* Masthead *@
            <div class="border-t-4 border-b-4 border-double border-foreground bg-background px-6 py-5">
                <div class="flex items-center justify-between gap-4 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    <span>@_masthead.Volume</span>
                    <span class="hidden sm:inline">Four cents · Street edition</span>
                    <span>@_masthead.Dateline</span>
                </div>
                <div class="mt-2 flex items-center justify-center gap-3">
                    <LucideIconCn Name="newspaper" Size="24" Class="size-6 shrink-0 text-foreground sm:size-7" aria-hidden="true" />
                    <h3 class="font-serif text-3xl font-bold leading-none tracking-tight text-foreground sm:text-4xl lg:text-5xl">
                        @_masthead.Name
                    </h3>
                </div>
                <p class="mt-2 text-center font-serif text-xs italic text-muted-foreground">
                    @("\"")@_masthead.Tagline@("\"")
                </p>
            </div>

            @* Breaking feature box *@
            <div class="border-b-2 border-double border-foreground/60 bg-muted/30 px-6 py-6">
                <div class="flex items-start gap-4">
                    <span aria-hidden="true"
                          class="mt-1 shrink-0 border-2 border-foreground bg-foreground px-2 py-0.5 font-serif text-[10px] font-bold uppercase tracking-widest text-background">
                        @_breakingFeature.Tag
                    </span>
                    <div class="min-w-0 flex-1">
                        <h3 class="font-serif text-xl font-bold leading-tight tracking-tight text-foreground sm:text-2xl lg:text-3xl">
                            @_breakingFeature.Headline
                        </h3>
                        <p class="mt-3 font-serif text-sm leading-relaxed text-muted-foreground sm:text-base">
                            @_breakingFeature.Subhead
                        </p>
                        <p class="mt-3 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                            @_breakingFeature.Byline
                        </p>
                    </div>
                </div>
            </div>

            @* Three-column spread *@
            <div class="grid grid-cols-1 md:grid-cols-3 md:divide-x">
                @foreach (var article in _columnArticles)
                {
                    <article class="border-b px-6 py-6 last:border-b-0 md:border-b-0">
                        <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                            @article.Kicker
                        </p>
                        <h3 class="mt-2 font-serif text-lg font-bold leading-snug tracking-tight text-foreground">
                            @article.Headline
                        </h3>
                        <div aria-hidden="true" class="mt-3 h-px w-10 bg-foreground/40"></div>
                        <p class="mt-3 font-serif text-[11px] font-semibold uppercase tracking-wider text-foreground">
                            @article.Lead
                        </p>
                        <p class="mt-2 font-serif text-sm leading-relaxed text-muted-foreground">
                            @article.Body
                        </p>
                    </article>
                }
            </div>

            @* Footer dateline *@
            <div class="flex items-center justify-between border-t bg-background px-6 py-3 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                <span>Continued on A-2</span>
                <span class="hidden sm:inline">Printed nightly in Brooklyn, NY</span>
                <span>Page 1</span>
            </div>
        </div>

        @* CTA pair *@
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <ButtonCn Class="w-full sm:w-[170px]">Subscribe</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">
                Browse archive
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record MastheadData(string Name, string Volume, string Dateline, string Tagline);

    private record BreakingFeatureData(string Tag, string Headline, string Subhead, string Byline);

    private record ColumnArticle(string Id, string Kicker, string Headline, string Lead, string Body);

    private static readonly MastheadData _masthead = new(
        Name: "The Ship Herald",
        Volume: "Vol. XXIV · No. 118",
        Dateline: "Thursday, April 9, 2026",
        Tagline: "All the releases that are fit to ship"
    );

    private static readonly BreakingFeatureData _breakingFeature = new(
        Tag: "Breaking",
        Headline: "Edge runtime redeployed in every region before breakfast.",
        Subhead: "A rewritten scheduler, predictive warmup, and signed build attestation land together in this morning's release — cutting cold starts by 74% across the network.",
        Byline: "By the Platform Desk · 6 min read"
    );

    private static readonly ColumnArticle[] _columnArticles =
    [
        new(
            Id: "col-1",
            Kicker: "Observability",
            Headline: "Traces arrive at the dashboard before the request finishes.",
            Lead: "A NEW STREAMING PIPELINE REPLACES the old batch exporter.",
            Body: "Engineers can now follow a single request through every function, database call, and background job as it happens — no more refreshing a trace view and hoping the span landed. The new pipeline fans out to our storage layer in under forty milliseconds and keeps a two-week hot window for every team without an archive cost."
        ),
        new(
            Id: "col-2",
            Kicker: "Reliability",
            Headline: "Auto-failover now rehearses itself every Tuesday at noon.",
            Lead: "A GAME-DAY SCHEDULER RUNS quietly across the fleet.",
            Body: "Instead of waiting for a regional incident to prove that the failover plan works, the scheduler simulates the loss of one availability zone every week in production traffic. The drill is invisible to customers, and the full incident report lands in the trust center before anyone on the platform team has finished lunch."
        ),
        new(
            Id: "col-3",
            Kicker: "Developer experience",
            Headline: "Generated SDKs ship the moment the schema is merged.",
            Lead: "A ONE-CLICK PUBLISHER WATCHES every commit.",
            Body: "When an engineer merges a breaking change to the public API, our publisher tags a new version, regenerates eight language SDKs, signs the artifacts, and opens a pull request in every downstream example repo. Release notes are lifted from the commit body, and the version bump reaches npm within four minutes of the merge."
        ),
    ];
}
