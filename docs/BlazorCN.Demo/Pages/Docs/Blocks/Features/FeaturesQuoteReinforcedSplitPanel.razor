@* ============================================================
   Block: features-quote-reinforced-split-panel
   Title: FeaturesQuoteReinforcedSplitPanel
   Description: A split panel features section for React and Next.js with an eyebrow headline, four CheckIcon bullets, a testimonial quote card below the bullets, and a crosshair image placeholder built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-quote-reinforced-split-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">
        <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
            @* Left — Headline + bullets + testimonial card *@
            <div>
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    @_headline.Eyebrow
                </p>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
                    @_headline.Title
                </h2>
                <p class="mt-4 max-w-lg text-base leading-relaxed text-muted-foreground">
                    @_headline.Subtitle
                </p>

                <ul class="mt-7 space-y-4">
                    @foreach (var feature in _features)
                    {
                        <li class="flex gap-3">
                            <span aria-hidden="true" class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                <LucideIconCn Name="check" Size="12" Class="size-3 stroke-[3] text-emerald-600 dark:text-emerald-500" />
                            </span>
                            <div>
                                <h3 class="text-sm font-semibold text-foreground">@feature.Title</h3>
                                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">@feature.Description</p>
                            </div>
                        </li>
                    }
                </ul>

                <figure class="mt-7 rounded-xl border bg-muted/50 p-4 sm:p-5">
                    <blockquote class="text-sm italic leading-relaxed text-foreground">
                        &ldquo;@_testimonial.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-4 flex items-center gap-3">
                        <span aria-hidden="true" class="flex size-9 shrink-0 items-center justify-center rounded-full border bg-background text-xs font-semibold text-foreground">
                            @_testimonial.Initials
                        </span>
                        <div class="flex flex-col">
                            <span class="text-sm font-semibold text-foreground">@_testimonial.Name</span>
                            <span class="text-xs text-muted-foreground">@_testimonial.Role</span>
                        </div>
                    </figcaption>
                </figure>
            </div>

            @* Right — Crosshair image placeholder *@
            <div class="flex aspect-[4/3] w-full items-center justify-center rounded-xl bg-muted">
                <div aria-hidden="true" class="relative flex items-center justify-center">
                    <div class="absolute size-24 rounded-full border border-muted-foreground/[0.06]"></div>
                    <div class="absolute size-14 rounded-full border border-muted-foreground/[0.08]"></div>
                    <div class="absolute h-px w-32 bg-muted-foreground/[0.06]"></div>
                    <div class="absolute h-32 w-px bg-muted-foreground/[0.06]"></div>
                    <div class="flex size-8 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                        <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureItem(string Id, string Title, string Description);
    private record TestimonialData(string Quote, string Name, string Role, string Initials);

    private static readonly HeadlineData _headline = new(
        "Customer-loved",
        "Ship faster without breaking what already works",
        "Four capabilities that compound over time, trusted by engineering teams who measure velocity in weeks, not quarters."
    );

    private static readonly FeatureItem[] _features =
    [
        new("preview-environments",
            "Isolated preview environments per pull request",
            "Every branch gets its own ephemeral deployment with a shareable URL reviewers can click."),
        new("zero-downtime",
            "Zero-downtime migrations and instant rollbacks",
            "Schema changes apply online and bad deploys reverse in under ten seconds from the dashboard."),
        new("audit-trail",
            "Full audit trail across every environment",
            "Searchable history of who shipped what, when, and which feature flag was flipped along the way."),
        new("soc2-defaults",
            "SOC 2 compliant defaults with no extra setup",
            "Encryption at rest, encryption in transit, and access logging enabled from day one."),
    ];

    private static readonly TestimonialData _testimonial = new(
        "We cut our deploy cycle from three hours to eleven minutes in the first sprint. The preview environments alone paid for the year.",
        "Priya Raman",
        "Staff Engineer, Northwind Labs",
        "PR"
    );
}
