@* ============================================================
   Block: features-browser-chrome-card-grid
   Title: FeaturesBrowserChromeCardGrid
   Description: A six-card feature grid for React and Next.js where each card's image area is decorated as a mini browser window with traffic lights, URL bar, and crosshair placeholder content built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-browser-chrome-card-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">
        @* Header *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_headline.Eyebrow
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_headline.Title
            </h2>
            <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>
        </div>

        @* Grid *@
        <div class="mt-10 grid grid-cols-1 gap-5 sm:mt-12 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
            @foreach (var feat in _features)
            {
                var feature = feat;
                <article class="overflow-hidden rounded-xl border bg-background">
                    @* Browser chrome + image body *@
                    <div class="border-b">
                        @* Chrome strip *@
                        <div aria-hidden="true" class="flex h-8 items-center gap-2 rounded-t-xl border-b bg-muted/60 px-3">
                            <div class="flex items-center gap-1.5">
                                <span class="size-2.5 rounded-full bg-muted-foreground/25"></span>
                                <span class="size-2.5 rounded-full bg-muted-foreground/20"></span>
                                <span class="size-2.5 rounded-full bg-muted-foreground/15"></span>
                            </div>
                            <div class="flex h-4 flex-1 items-center justify-center rounded-sm border bg-background/60">
                                <span class="flex items-center gap-1 font-mono text-[10px] text-muted-foreground/70">
                                    <LucideIconCn Name="@feature.IconName" Size="10" Class="size-2.5" />
                                    @feature.Url
                                </span>
                            </div>
                        </div>

                        @* Body with crosshair placeholder *@
                        <div class="relative aspect-[16/10] w-full bg-muted">
                            @* ImagePlaceholder *@
                            <div aria-hidden="true" class="absolute inset-0 flex items-center justify-center">
                                <div class="relative flex items-center justify-center">
                                    <div class="absolute size-20 rounded-full border border-muted-foreground/[0.06]"></div>
                                    <div class="absolute size-12 rounded-full border border-muted-foreground/[0.08]"></div>
                                    <div class="absolute h-px w-28 bg-muted-foreground/[0.06]"></div>
                                    <div class="absolute h-24 w-px bg-muted-foreground/[0.06]"></div>
                                    <div class="flex size-7 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                                        <LucideIconCn Name="image" Size="14" Class="size-3.5 text-muted-foreground/40" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Text area *@
                    <div class="p-5">
                        <h3 class="text-base font-semibold text-foreground">@feature.Title</h3>
                        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                            @feature.Description
                        </p>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureItem(string Id, string IconName, string Url, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        "Developer surfaces",
        "Every workspace, framed like the browser tab it lives in",
        "Six web-first views developers actually leave open all day — the deploy console, the branch diff, the command bar, the live metrics panel — rendered with the chrome and URL bar they already recognize."
    );

    private static readonly FeatureItem[] _features =
    [
        new("deploy-console", "layout-dashboard", "app.acme.dev/deploys", "Live deploy console",
            "Stream build logs, cold-start durations, and region health into a single timeline. Promote a preview to production in one click, roll back in two."),
        new("branch-diff", "git-branch", "app.acme.dev/pull/4821", "Inline branch diff",
            "Review schema migrations, env var changes, and infra drift side by side. Comment on any line and block the merge until the thread resolves."),
        new("command-bar", "command", "app.acme.dev/cmd", "Cross-workspace command bar",
            "Jump between projects, environments, and secrets from a cmd+k palette that fuzzy-matches on every resource your account has touched in the last 30 days."),
        new("api-explorer", "code", "app.acme.dev/api/explorer", "Interactive API explorer",
            "Every endpoint ships with a live playground, a copy-as-curl button, and an auto-refreshing auth token so you never leave the docs to hit the real API."),
        new("terminal", "terminal", "app.acme.dev/shell", "Web-native terminal",
            "A full-featured bash shell attached to your runtime, with history sync across sessions and SSH-grade audit logging for every command executed."),
        new("workflow-canvas", "workflow", "app.acme.dev/workflows", "Workflow canvas",
            "Drag-and-drop orchestration for background jobs, cron triggers, and webhook fan-out. Every node streams execution traces into the live deploy console."),
    ];
}
