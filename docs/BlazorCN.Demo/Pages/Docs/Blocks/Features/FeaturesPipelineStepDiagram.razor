@* ============================================================
   Block: features-pipeline-step-diagram
   Title: FeaturesPipelineStepDiagram
   Description: A horizontal pipeline step diagram features section for React and Next.js with five numbered processing stages, animated chevron connectors, and before-after impact stats built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-pipeline-step-diagram.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">

        @* Headline *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                The pipeline
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                Your code, through our pipeline
            </h2>
            <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                Five stages from the moment you hit push to the moment real users see the change. Every
                step parallelized, cached, and observable.
            </p>
        </div>

        @* Pipeline stages *@
        <div class="mt-12 flex flex-col items-stretch gap-4 lg:flex-row lg:items-stretch lg:gap-2">
            @for (var i = 0; i < _stages.Length; i++)
            {
                var stage = _stages[i];
                var isLast = i == _stages.Length - 1;
                <div class="flex flex-col items-stretch lg:flex-1 lg:flex-row">
                    @* Stage tile *@
                    <div class="flex-1 rounded-xl border bg-background p-5">
                        <div class="flex items-center justify-between">
                            <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                                @stage.Number
                            </span>
                            <span aria-hidden="true" class="flex size-8 items-center justify-center rounded-lg bg-muted">
                                <LucideIconCn Name="@stage.IconName" Size="16" Class="size-4 text-foreground" />
                            </span>
                        </div>
                        <h3 class="mt-4 text-base font-semibold text-foreground">@stage.Title</h3>
                        <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                            @stage.Description
                        </p>
                    </div>

                    @* Connector chevron *@
                    @if (!isLast)
                    {
                        <div aria-hidden="true" class="flex items-center justify-center py-1 lg:px-1 lg:py-0">
                            <LucideIconCn Name="chevron-right" Size="20" Class="size-5 rotate-90 text-muted-foreground/60 lg:rotate-0" />
                        </div>
                    }
                </div>
            }
        </div>

        @* Impact stats — before vs after *@
        <div class="mt-12 rounded-xl border bg-muted/30 p-6 sm:p-8">
            <p class="text-center text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Measured impact
            </p>
            <dl class="mt-5 grid grid-cols-1 gap-6 sm:grid-cols-3 sm:gap-4">
                @foreach (var stat in _impactStats)
                {
                    <div class="flex flex-col items-center text-center">
                        <dt class="text-xs font-medium text-muted-foreground">@stat.Label</dt>
                        <dd class="mt-2 flex items-baseline gap-2">
                            <span class="text-sm text-muted-foreground line-through decoration-foreground/30">
                                @stat.Before
                            </span>
                            <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/60" />
                            <span class="text-xl font-bold tracking-tight text-foreground tabular-nums sm:text-2xl">
                                @stat.After
                            </span>
                        </dd>
                    </div>
                }
            </dl>
        </div>

        @* CTA *@
        <div class="mt-10 flex justify-center">
            <ButtonCn Class="w-full sm:w-[180px]">Book a demo</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Stage(string Id, string Number, string Title, string Description, string IconName);
    private record ImpactStat(string Id, string Label, string Before, string After);

    private static readonly Stage[] _stages =
    [
        new("commit",     "01", "Commit",     "Push to any branch",        "git-commit-horizontal"),
        new("build",      "02", "Build",      "Parallel compile & cache",  "box"),
        new("test",       "03", "Test",       "Unit, e2e, visual diff",    "circle-check"),
        new("preview",    "04", "Preview",    "Per-PR preview URL",        "eye"),
        new("production", "05", "Production", "Zero-downtime deploy",      "rocket"),
    ];

    private static readonly ImpactStat[] _impactStats =
    [
        new("cycle-time",    "Cycle time",       "8 hours", "8 minutes"),
        new("rollback-rate", "Rollback rate",    "14%",     "0.3%"),
        new("release-freq",  "Releases per day", "1.2",     "47"),
    ];
}
