@* ============================================================
   Block: features-video-playlist-sidebar
   Title: FeaturesVideoPlaylistSidebar
   Description: A video player with sidebar playlist features section for React and Next.js with a 16:9 main video placeholder, duration badge, and a scrollable sidebar of upcoming feature tutorials built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-video-playlist-sidebar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div>
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Watch &amp; learn
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                See every feature in under four minutes.
            </h2>
            <p class="mt-4 max-w-xl text-base text-muted-foreground">
                Short, focused tutorials filmed against the real product. No hype, no sales pitch — just
                the click path.
            </p>
        </div>

        @* Player + sidebar *@
        <div class="mt-10 grid gap-4 md:grid-cols-[3fr_2fr]">
            @* Main video *@
            <div class="overflow-hidden rounded-xl border bg-card">
                <div class="relative aspect-video w-full overflow-hidden bg-muted/60">
                    @* Pattern placeholder *@
                    <div class="absolute inset-0 flex items-center justify-center">
                        <span class="font-mono text-6xl font-bold tracking-tight text-muted-foreground/40">
                            @_current.Mark
                        </span>
                    </div>
                    @* Center play button *@
                    <button type="button" aria-label="@($"Play {_current.Title}")" class="absolute inset-0 flex items-center justify-center">
                        <span class="flex size-14 items-center justify-center rounded-full bg-background/95 shadow-sm ring-1 ring-border transition-transform hover:scale-105">
                            <LucideIconCn Name="play" Size="20" Class="size-5 translate-x-[1px] fill-foreground text-foreground" aria-hidden="true" />
                        </span>
                    </button>
                    @* Duration badge *@
                    <div class="absolute right-3 bottom-3 flex items-center gap-1 rounded-md bg-background/95 px-2 py-1 font-mono text-[11px] font-medium tabular-nums shadow-sm ring-1 ring-border">
                        <LucideIconCn Name="clock" Size="12" Class="size-3" aria-hidden="true" />
                        @_current.Duration
                    </div>
                    @* Chapter label *@
                    <div class="absolute top-3 left-3 rounded-md bg-background/95 px-2 py-1 text-[10px] font-medium uppercase tracking-widest shadow-sm ring-1 ring-border">
                        @_current.Chapter
                    </div>
                </div>
                <div class="border-t p-5">
                    <h3 class="text-base font-semibold tracking-tight">@_current.Title</h3>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                        @_current.Description
                    </p>
                </div>
            </div>

            @* Sidebar playlist *@
            <div class="flex flex-col overflow-hidden rounded-xl border bg-card">
                <div class="flex items-center justify-between border-b px-4 py-3">
                    <span class="text-xs font-semibold">Up next</span>
                    <span class="text-[11px] text-muted-foreground">@_playlist.Length videos</span>
                </div>
                <ul class="divide-y overflow-y-auto">
                    @foreach (var item in _playlist)
                    {
                        var active = item.Id == "preview-env";
                        <li>
                            <button
                                type="button"
                                aria-label="@($"Play {item.Title}")"
                                class="@Cn.Merge("flex w-full items-start gap-3 p-3 text-left transition-colors hover:bg-muted/40", active ? "bg-muted/50" : "")">
                                @* Video thumbnail *@
                                <div class="w-20 shrink-0">
                                    <div
                                        aria-hidden="true"
                                        class="@Cn.Merge("relative aspect-video w-full overflow-hidden rounded-md border", active ? "bg-foreground text-background" : "bg-muted/60")">
                                        <div class="absolute inset-0 flex items-center justify-center">
                                            <span class="@Cn.Merge("font-mono text-[10px] font-semibold tabular-nums", active ? "text-background/70" : "text-muted-foreground")">
                                                @item.Mark
                                            </span>
                                        </div>
                                        <div class="absolute right-1 bottom-1 flex size-4 items-center justify-center rounded-sm bg-background/80">
                                            <LucideIconCn Name="play" Size="8" Class="size-2 fill-foreground text-foreground" />
                                        </div>
                                    </div>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-start justify-between gap-2">
                                        <p class="line-clamp-2 text-xs font-medium leading-snug">
                                            @item.Title
                                        </p>
                                        @if (item.IsNew)
                                        {
                                            <span class="inline-flex shrink-0 items-center rounded-sm bg-emerald-500/10 px-1.5 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-widest text-emerald-700 dark:text-emerald-400">
                                                New
                                            </span>
                                        }
                                    </div>
                                    <div class="mt-1 flex items-center gap-1 font-mono text-[10px] tabular-nums text-muted-foreground">
                                        <LucideIconCn Name="clock" Size="10" Class="size-2.5" aria-hidden="true" />
                                        @item.Duration
                                    </div>
                                </div>
                            </button>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
            <ButtonCn Class="w-full sm:w-[190px]">Watch series</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">View transcripts</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record CurrentVideo(string Chapter, string Title, string Description, string Duration, string Mark);
    private record PlaylistItem(string Id, string Title, string Duration, string Mark, bool IsNew = false);

    private static readonly CurrentVideo _current = new(
        Chapter: "Chapter 02",
        Title: "Deploying a preview environment in 30 seconds",
        Description: "Watch how a single git push spins up an isolated preview URL with real data, real logs, and a rollback button that actually works.",
        Duration: "3:42",
        Mark: "02"
    );

    private static readonly PlaylistItem[] _playlist =
    [
        new("edge-cache",    "How edge caching routes your requests",  "2:58", "01"),
        new("preview-env",   "Deploying a preview environment",         "3:42", "02", IsNew: true),
        new("rollback",      "Rolling back a broken release",           "2:14", "03"),
        new("observability", "Tracing a slow request end to end",       "4:07", "04"),
        new("secrets",       "Rotating a leaked API key safely",        "2:31", "05"),
    ];
}
