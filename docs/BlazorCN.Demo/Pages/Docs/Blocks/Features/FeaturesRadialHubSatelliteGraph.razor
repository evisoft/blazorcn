@* ============================================================
   Block: features-radial-hub-satellite-graph
   Title: FeaturesRadialHubSatelliteGraph
   Description: A radial hub and satellite graph features section for React and Next.js with a central product hub, six orbiting integration nodes, and SVG connector lines built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-radial-hub-satellite-graph.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10">

        @* Headline *@
        <div class="mx-auto max-w-xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Integrations
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                One hub, every tool connected
            </h2>
            <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                Your product sits at the center of the stack. Everything your team already uses plugs in
                without a single custom integration.
            </p>
        </div>

        @* Radial graph *@
        <div class="relative mx-auto mt-10 aspect-square w-full max-w-md">

            @* Connector SVG overlay *@
            <svg
                aria-hidden="true"
                viewBox="0 0 100 100"
                preserveAspectRatio="none"
                class="absolute inset-0 h-full w-full">
                @foreach (var sat in _satellites)
                {
                    var coord = _satelliteCoords[sat.Position];
                    <line
                        x1="50"
                        y1="50"
                        x2="@coord.X"
                        y2="@coord.Y"
                        stroke="currentColor"
                        stroke-width="0.4"
                        stroke-dasharray="1.2 1.2"
                        class="text-foreground/20" />
                }
            </svg>

            @* Decorative orbit ring *@
            <div
                aria-hidden="true"
                class="absolute left-1/2 top-1/2 size-[72%] -translate-x-1/2 -translate-y-1/2 rounded-full border border-dashed border-foreground/10">
            </div>

            @* Central hub *@
            <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
                <div class="flex w-[168px] flex-col items-center gap-2 rounded-2xl border bg-background p-4 shadow-sm">
                    <div class="flex size-11 items-center justify-center rounded-xl bg-foreground">
                        <span class="text-lg font-bold text-background">@_hub.Mark</span>
                    </div>
                    <div class="text-center">
                        <p class="text-sm font-semibold text-foreground">@_hub.Label</p>
                        <p class="mt-0.5 text-[11px] text-muted-foreground">@_hub.Sublabel</p>
                    </div>
                </div>
            </div>

            @* Satellite nodes *@
            @foreach (var sat in _satellites)
            {
                var pos = _positionStyles[sat.Position];
                <div
                    style="@($"top:{pos.Top};left:{pos.Left}")"
                    class="@($"absolute {pos.Translate} -translate-y-1/2")">
                    <div class="flex items-center gap-2 rounded-xl border bg-background px-3 py-2 shadow-sm">
                        <span
                            aria-hidden="true"
                            class="flex size-7 items-center justify-center rounded-lg bg-muted">
                            <LucideIconCn Name="@sat.IconName" Size="14" Class="size-3.5 text-foreground" StrokeWidth="2" />
                        </span>
                        <span class="text-xs font-medium text-foreground">@sat.Label</span>
                    </div>
                </div>
            }

        </div>

        @* Footer row *@
        <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t pt-6 sm:flex-row">
            <div class="flex items-center gap-2 text-sm text-muted-foreground">
                <span
                    aria-hidden="true"
                    class="flex size-6 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="box" Size="14" Class="size-3.5 text-foreground" StrokeWidth="2" />
                </span>
                <span>
                    <span class="font-semibold text-foreground">+40 more integrations</span> available
                    today
                </span>
            </div>
            <ButtonCn Class="w-full sm:w-[170px]">Browse all</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record HubInfo(string Mark, string Label, string Sublabel);
    private record SatelliteItem(string Id, string Label, string IconName, string Position);
    private record PositionStyle(string Top, string Left, string Translate);
    private record SvgCoord(int X, int Y);

    private static readonly HubInfo _hub = new("A", "Your product", "The single source of truth");

    private static readonly SatelliteItem[] _satellites =
    [
        new("slack",   "Slack",    "slack",           "top"),
        new("github",  "GitHub",   "github",          "topRight"),
        new("linear",  "Linear",   "layers",          "bottomRight"),
        new("figma",   "Figma",    "figma",           "bottom"),
        new("zoom",    "Zoom",     "video",           "bottomLeft"),
        new("notion",  "Notion",   "message-square",  "topLeft"),
    ];

    private static readonly Dictionary<string, PositionStyle> _positionStyles = new()
    {
        ["top"]         = new("4%",  "50%", "-translate-x-1/2"),
        ["topRight"]    = new("20%", "84%", "-translate-x-1/2"),
        ["bottomRight"] = new("72%", "84%", "-translate-x-1/2"),
        ["bottom"]      = new("88%", "50%", "-translate-x-1/2"),
        ["bottomLeft"]  = new("72%", "16%", "-translate-x-1/2"),
        ["topLeft"]     = new("20%", "16%", "-translate-x-1/2"),
    };

    private static readonly Dictionary<string, SvgCoord> _satelliteCoords = new()
    {
        ["top"]         = new(50, 12),
        ["topRight"]    = new(82, 26),
        ["bottomRight"] = new(82, 74),
        ["bottom"]      = new(50, 88),
        ["bottomLeft"]  = new(18, 74),
        ["topLeft"]     = new(18, 26),
    };
}
