@* ============================================================
   Block: features-icon-grid
   Title: Features Icon Grid
   Description: A connected grid layout displaying features with colored indicators, perfect for Next.js landing pages and marketing sections.
   Long Description: Grouped feature list with categories
   Dependencies: None
   Source: original/blocks/features/features-icon-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
          <h2 class="text-sm font-medium">Platform Features</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Core capabilities included in every plan
          </p>
        </div>
        <div class="grid grid-cols-1 gap-px bg-border md:grid-cols-2 lg:grid-cols-3">
          @foreach (var feature in _features)
          {
            <div class="bg-card p-4">
              <div class="flex items-start gap-3">
                <span class="@(Cn.Merge("mt-0.5 size-1.5 shrink-0 rounded-full", GetCategoryColor(feature.Category)))"></span>
                <div class="min-w-0 flex-1">
                  <h3 class="text-sm font-medium">@feature.Title</h3>
                  <p class="mt-1 text-xs text-muted-foreground">@feature.Description</p>
                </div>
              </div>
            </div>
          }
        </div>
      </div>
    </section>

@code {
    private record FeatureData(string Title, string Description, string Category);

    private static readonly FeatureData[] _features = new[]
    {
        new FeatureData("Issue Tracking", "Create, assign, and track issues with custom workflows", "planning"),
        new FeatureData("Sprint Planning", "Organize work into time-boxed iterations", "planning"),
        new FeatureData("Roadmap", "Visualize your product roadmap and milestones", "planning"),
        new FeatureData("Git Integration", "Connect repos for automatic issue linking", "development"),
        new FeatureData("CI/CD Pipelines", "Automated build, test, and deploy workflows", "development"),
        new FeatureData("Code Review", "Collaborative pull request reviews", "development"),
        new FeatureData("Analytics", "Real-time metrics and team performance insights", "insights"),
        new FeatureData("Notifications", "Stay updated with customizable alerts", "insights"),
        new FeatureData("API Access", "REST and GraphQL APIs for custom integrations", "insights"),
    };

    private static string GetCategoryColor(string category) => category switch
    {
        "planning" => "bg-blue-500",
        "development" => "bg-emerald-500",
        "insights" => "bg-purple-500",
        _ => "bg-gray-500",
    };
}
