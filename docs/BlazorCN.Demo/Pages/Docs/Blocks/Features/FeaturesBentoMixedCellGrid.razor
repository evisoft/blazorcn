@* ============================================================
   Block: features-bento-mixed-cell-grid
   Title: FeaturesBentoMixedCellGrid
   Description: A bento mixed cell grid features section for React and Next.js with six visually distinct cells combining an image mockup cell a stat tile a quote cell icon cells and a dual-CTA footer built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-bento-mixed-cell-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10">

        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_headline.Eyebrow
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_headline.Title
            </h2>
            <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>
        </div>

        @* Bento grid *@
        <div class="mt-10 grid grid-cols-6 gap-3">

            @* Cell 1 — Image/mockup cell *@
            <div class="col-span-6 overflow-hidden rounded-xl border bg-muted/30 lg:col-span-4">
                @* Browser chrome *@
                <div class="flex items-center gap-1.5 border-b bg-background/60 px-4 py-2.5">
                    <span aria-hidden="true" class="size-2.5 rounded-full bg-muted-foreground/25"></span>
                    <span aria-hidden="true" class="size-2.5 rounded-full bg-muted-foreground/25"></span>
                    <span aria-hidden="true" class="size-2.5 rounded-full bg-muted-foreground/25"></span>
                    <div class="ml-3 flex-1 rounded-md border bg-background px-2 py-0.5 text-[10px] font-mono text-muted-foreground">
                        @_imageCell.MockupUrl
                    </div>
                </div>
                @* Mockup body *@
                <div class="relative flex aspect-[16/9] items-center justify-center bg-muted/50">
                    @* CrosshairPlaceholder *@
                    <div aria-hidden="true" class="relative flex items-center justify-center">
                        <div class="absolute size-28 rounded-full border border-muted-foreground/[0.06]"></div>
                        <div class="absolute size-16 rounded-full border border-muted-foreground/[0.08]"></div>
                        <div class="absolute h-px w-44 bg-muted-foreground/[0.06]"></div>
                        <div class="absolute h-32 w-px bg-muted-foreground/[0.06]"></div>
                        <div class="flex size-9 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
                        </div>
                    </div>
                </div>
                @* Caption *@
                <div class="border-t p-5">
                    <h3 class="text-base font-semibold text-foreground">@_imageCell.Title</h3>
                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                        @_imageCell.Description
                    </p>
                </div>
            </div>

            @* Cell 2 — Stat tile *@
            <div class="col-span-6 flex flex-col justify-between rounded-xl border bg-muted/30 p-6 lg:col-span-2">
                <span class="flex size-9 items-center justify-center rounded-lg bg-muted">
                    <LucideIconCn Name="gauge" Size="16" Class="size-4 text-muted-foreground" />
                </span>
                <div class="mt-8">
                    <p class="text-4xl font-bold tabular-nums tracking-tight text-foreground sm:text-5xl">
                        @_statCell.Metric
                    </p>
                    <p class="mt-1 text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                        @_statCell.MetricLabel
                    </p>
                    <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
                        @_statCell.Description
                    </p>
                </div>
            </div>

            @* Cell 3 — Icon + text (SSO) *@
            <div class="col-span-6 flex flex-col rounded-xl border bg-muted/30 p-6 lg:col-span-2">
                <span class="flex size-9 items-center justify-center rounded-lg bg-muted">
                    <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                </span>
                <h3 class="mt-4 text-base font-semibold text-foreground">@_iconCells[0].Title</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                    @_iconCells[0].Description
                </p>
            </div>

            @* Cell 4 — Quote testimonial *@
            <div class="col-span-6 flex flex-col justify-between rounded-xl border bg-muted/30 p-6 lg:col-span-2">
                <blockquote class="text-sm italic leading-relaxed text-foreground">
                    &ldquo;@_quoteCell.Quote&rdquo;
                </blockquote>
                <div class="mt-5 flex items-center gap-3">
                    <span
                        aria-hidden="true"
                        class="flex size-8 items-center justify-center rounded-full bg-foreground text-xs font-semibold text-background"
                    >
                        @_quoteCell.AvatarInitial
                    </span>
                    <div>
                        <p class="text-xs font-semibold text-foreground">@_quoteCell.Author</p>
                        <p class="text-[11px] text-muted-foreground">@_quoteCell.Role</p>
                    </div>
                </div>
            </div>

            @* Cell 5 — Icon + text (Webhooks) *@
            <div class="col-span-6 flex flex-col rounded-xl border bg-muted/30 p-6 lg:col-span-2">
                <span class="flex size-9 items-center justify-center rounded-lg bg-muted">
                    <LucideIconCn Name="webhook" Size="16" Class="size-4 text-muted-foreground" />
                </span>
                <h3 class="mt-4 text-base font-semibold text-foreground">@_iconCells[1].Title</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                    @_iconCells[1].Description
                </p>
            </div>

            @* Cell 6 — Full-width CTA *@
            <div class="col-span-6 flex flex-col items-start justify-between gap-5 rounded-xl border bg-muted/30 p-6 sm:flex-row sm:items-center sm:gap-8 sm:p-8">
                <div class="flex-1">
                    <h3 class="text-lg font-semibold tracking-tight text-foreground sm:text-xl">
                        @_ctaCell.Title
                    </h3>
                    <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-muted-foreground">
                        @_ctaCell.Description
                    </p>
                </div>
                <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
                    <ButtonCn Class="w-full sm:w-[180px]">Get started</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">See pricing</ButtonCn>
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record ImageCellData(string Title, string Description, string MockupUrl);
    private record StatCellData(string Metric, string MetricLabel, string Description);
    private record IconCellData(string Id, string Title, string Description);
    private record QuoteCellData(string Quote, string Author, string Role, string AvatarInitial);
    private record CtaCellData(string Title, string Description);

    private static readonly HeadlineData _headline = new(
        "The platform",
        "One frame, every kind of proof",
        "A screenshot, a benchmark, a quote, and two supporting capabilities — everything a prospect needs to decide, without scrolling."
    );

    private static readonly ImageCellData _imageCell = new(
        "See the product in action",
        "Real collaboration, real presence cursors, real offline reconnects — no scripted demo video.",
        "app.acme.dev/workspace"
    );

    private static readonly StatCellData _statCell = new(
        "99.99%",
        "Uptime SLA",
        "Over the last 18 months across all regions, no asterisks."
    );

    private static readonly IconCellData[] _iconCells =
    [
        new("sso", "Enterprise SSO", "SAML 2.0, OIDC, and SCIM provisioning on every paid plan."),
        new("webhooks", "Typed webhooks", "A fully typed event SDK with automatic retries and dead letters."),
    ];

    private static readonly QuoteCellData _quoteCell = new(
        "We cut deploy time from 40 minutes to under three. The team ships three times a day now.",
        "Priya Natarajan",
        "Staff Engineer, Northwind",
        "P"
    );

    private static readonly CtaCellData _ctaCell = new(
        "Ready to see it on your own data?",
        "Spin up a workspace in under a minute — no credit card, no sales call, no enterprise tier gate."
    );
}
