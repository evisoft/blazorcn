@* ============================================================
   Block: features-pill-driven-flagship-card
   Title: FeaturesPillDrivenFlagshipCard
   Description: A pill-driven flagship card features section for React and Next.js with a four-tab PillTabs selector above a single asymmetric 40/60 split card featuring a stylized window-chrome product mockup built with shadcn/ui PillTabs and Tailwind CSS
   Source: original/blocks/features/features-pill-driven-flagship-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Section headline *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                The platform
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                Four pillars, one flagship surface
            </h2>
            <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                Pick a pillar above — the flagship card below swaps its story, benefits, and product
                mockup without ever leaving the same focused container.
            </p>
        </div>

        @* Tab selector — pill buttons *@
        <div class="mt-8 flex justify-center">
            <div
                id="features-pill-driven-flagship-card"
                role="tablist"
                aria-label="Select a platform pillar"
                class="inline-flex items-center gap-1 rounded-full border bg-muted p-1">
                @foreach (var tab in _tabs)
                {
                    var tabName = tab;
                    <button
                        role="tab"
                        aria-selected="@(_activeTab == tabName ? "true" : "false")"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring", _activeTab == tabName ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _activeTab = tabName)">
                        @tab
                    </button>
                }
            </div>
        </div>

        @* Flagship card — asymmetric 40/60 split *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            <div class="grid lg:grid-cols-[2fr_3fr]">
                @* Text — 40% *@
                <div class="flex flex-col justify-center p-8 sm:p-10">
                    <span class="inline-flex w-fit items-center rounded-full border bg-muted/50 px-2.5 py-0.5 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                        @_active.Eyebrow
                    </span>
                    <h3 class="mt-4 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
                        @_active.Title
                    </h3>
                    <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:text-base">
                        @_active.Description
                    </p>
                    <ul class="mt-5 space-y-2.5">
                        @foreach (var benefit in _active.Benefits)
                        {
                            <li class="flex items-start gap-2.5">
                                <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                                <span class="text-sm text-muted-foreground">@benefit</span>
                            </li>
                        }
                    </ul>
                </div>

                @* Product mockup — 60% *@
                <div class="flex items-stretch bg-muted p-6 sm:p-8 lg:border-l">
                    @* Window chrome mockup *@
                    <div aria-hidden="true" class="flex h-full min-h-[320px] w-full flex-col overflow-hidden rounded-xl border bg-card shadow-sm">
                        @* Window chrome *@
                        <div class="flex items-center gap-1.5 border-b bg-muted/50 px-3 py-2">
                            <span class="size-2.5 rounded-full bg-muted-foreground/25"></span>
                            <span class="size-2.5 rounded-full bg-muted-foreground/20"></span>
                            <span class="size-2.5 rounded-full bg-muted-foreground/15"></span>
                            <span class="ml-3 font-mono text-[10px] text-muted-foreground/60">
                                @(_activeTab.ToLower()).platform
                            </span>
                        </div>
                        @* Window body — sidebar rail + content *@
                        <div class="grid flex-1 grid-cols-[64px_1fr]">
                            @* Sidebar rail *@
                            <div class="flex flex-col items-center gap-2 border-r bg-muted/30 py-3">
                                <div class="size-6 rounded-md bg-muted-foreground/20"></div>
                                <div class="size-6 rounded-md bg-muted-foreground/12"></div>
                                <div class="size-6 rounded-md bg-muted-foreground/12"></div>
                                <div class="size-6 rounded-md bg-muted-foreground/12"></div>
                                <div class="mt-auto size-6 rounded-full bg-muted-foreground/15"></div>
                            </div>
                            @* Content area *@
                            <div class="flex flex-col gap-3 p-4">
                                @* Toolbar *@
                                <div class="flex items-center gap-2">
                                    <div class="h-4 w-24 rounded bg-muted-foreground/20"></div>
                                    <div class="ml-auto h-4 w-12 rounded bg-muted-foreground/15"></div>
                                    <div class="h-4 w-12 rounded bg-muted-foreground/15"></div>
                                </div>
                                @* Hero row *@
                                <div class="h-14 rounded-md bg-muted-foreground/10"></div>
                                @* Two-column grid *@
                                <div class="grid flex-1 grid-cols-2 gap-2">
                                    <div class="space-y-2">
                                        <div class="h-3 w-2/3 rounded bg-muted-foreground/20"></div>
                                        <div class="h-2 w-full rounded bg-muted-foreground/12"></div>
                                        <div class="h-2 w-5/6 rounded bg-muted-foreground/12"></div>
                                        <div class="h-8 rounded-md bg-muted-foreground/10"></div>
                                    </div>
                                    <div class="space-y-2">
                                        <div class="h-3 w-1/2 rounded bg-muted-foreground/20"></div>
                                        <div class="h-2 w-full rounded bg-muted-foreground/12"></div>
                                        <div class="h-2 w-4/6 rounded bg-muted-foreground/12"></div>
                                        <div class="h-8 rounded-md bg-muted-foreground/10"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record TabContent(string Eyebrow, string Title, string Description, string[] Benefits);

    private static readonly string[] _tabs = ["Build", "Collaborate", "Deploy", "Observe"];

    private static readonly Dictionary<string, TabContent> _content = new()
    {
        ["Build"] = new TabContent(
            "Authoring",
            "A build environment that starts in under a second",
            "Local dev servers boot from a warm cache and rebuild only the modules you touched. Hot module reload is instant, type errors surface inline, and the whole thing runs on the same engine your production pipeline uses.",
            ["Sub-second cold start on any machine", "Incremental type checking in the background", "Shared engine with production"]),
        ["Collaborate"] = new TabContent(
            "Teamwork",
            "Review, comment, and merge without leaving the canvas",
            "Every teammate sees the same live state with cursor presence, inline threads, and per-selection emoji reactions. Code review happens inside the editor, not in a separate PR interface on another domain.",
            ["Live cursor presence on every surface", "Inline threads anchored to selections", "PR review without a context switch"]),
        ["Deploy"] = new TabContent(
            "Shipping",
            "Promote to production from a single command menu",
            "Push to a preview, promote to staging, ship to production — all from the same keyboard-first menu. Rollbacks take one shortcut, and every deploy is an immutable snapshot you can pin a URL to forever.",
            ["Keyboard-first promotion between envs", "One-shortcut atomic rollback", "Immutable, permalinked deploy snapshots"]),
        ["Observe"] = new TabContent(
            "Insight",
            "Logs, traces, and metrics linked to the code that produced them",
            "Click any log line and jump straight to the source function that emitted it. Traces thread through the same UI so a slow request shows its full call graph with one expand — no cross-referencing across three dashboards.",
            ["Log lines deep-link to source files", "Unified trace view across services", "No cross-tool dashboard stitching"]),
    };

    private string _activeTab = "Build";

    private TabContent _active => _content[_activeTab];
}
