@* ============================================================
   Block: features-command-center-metric-board
   Title: FeaturesCommandCenterMetricBoard
   Description: A command center metric board features section for React and Next.js with a dark inset 3x2 grid of glowing metric tiles, deltas, and sparklines built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-command-center-metric-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Headline *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Mission control
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Every signal, every second, in one place.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A single dark panel that gives every engineer on call the same source of truth as the
                SRE team at 3am.
            </p>
        </div>

        @* Dark inset command panel *@
        <div class="relative mt-12 overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-950 p-6 text-zinc-100 sm:p-8">
            @* Corner register marks *@
            <span aria-hidden="true" class="absolute size-3 border-zinc-700 left-4 top-4 border-l-2 border-t-2"></span>
            <span aria-hidden="true" class="absolute size-3 border-zinc-700 right-4 top-4 border-r-2 border-t-2"></span>
            <span aria-hidden="true" class="absolute size-3 border-zinc-700 bottom-4 left-4 border-b-2 border-l-2"></span>
            <span aria-hidden="true" class="absolute size-3 border-zinc-700 bottom-4 right-4 border-b-2 border-r-2"></span>

            @* Panel header *@
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-zinc-800 pb-5">
                <div class="flex items-center gap-3">
                    <span class="relative flex size-2">
                        <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-70"></span>
                        <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
                    </span>
                    <span class="font-mono text-[11px] uppercase tracking-widest text-zinc-400">
                        LIVE · SYS.MONITOR
                    </span>
                </div>
                <div class="flex items-center gap-4 font-mono text-[11px] uppercase tracking-widest text-zinc-500">
                    <span class="inline-flex items-center gap-1.5">
                        <LucideIconCn Name="radio" Size="12" Class="size-3" />
                        34 nodes
                    </span>
                    <span>T+ 14:32:08 UTC</span>
                </div>
            </div>

            @* Metric grid *@
            <div class="mt-6 grid grid-cols-1 gap-px bg-zinc-800 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var metric in _metrics)
                {
                    var deltaColor = metric.Intent == "positive" ? "text-emerald-400" : "text-red-400";
                    var sparkColor = metric.Intent == "positive" ? "text-emerald-400" : "text-red-400";
                    var deltaIconName = metric.DeltaDirection == "up" ? "arrow-up-right" : "arrow-down-right";
                    var sparkPath = BuildSparkPath(metric.Spark, 72, 22);
                    <div class="flex flex-col gap-3 bg-zinc-950 p-5">
                        <div class="flex items-center justify-between">
                            <h3 class="font-mono text-[10px] uppercase tracking-[0.18em] text-zinc-500">
                                @metric.Label
                            </h3>
                            <span class="@(Cn.Merge("inline-flex items-center gap-0.5 font-mono text-[11px] tabular-nums", deltaColor))">
                                <LucideIconCn Name="@deltaIconName" Size="12" Class="size-3" />
                                @metric.Delta
                            </span>
                        </div>
                        <div class="flex items-baseline gap-1.5">
                            <span class="font-mono text-4xl font-semibold tabular-nums tracking-tight text-zinc-50">
                                @metric.Value
                            </span>
                            <span class="font-mono text-xs text-zinc-500">@metric.Unit</span>
                        </div>
                        <div class="@(Cn.Merge("mt-auto", sparkColor))">
                            <svg aria-hidden="true" viewBox="0 0 72 22" class="h-5 w-full" preserveAspectRatio="none">
                                <path d="@sparkPath" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                    </div>
                }
            </div>

            @* Panel footer *@
            <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-zinc-800 pt-5 font-mono text-[10px] uppercase tracking-widest text-zinc-500">
                <span>FEED · 12ms refresh</span>
                <span>AUTH · attested</span>
                <span>CTRL · read-only</span>
            </div>
        </div>

        @* CTA pair *@
        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <ButtonCn Class="w-full sm:w-[260px]">Open mission control</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">Read the docs</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Metric(
        string Id,
        string Label,
        string Value,
        string Unit,
        string Delta,
        string DeltaDirection,
        string Intent,
        int[] Spark
    );

    private static readonly Metric[] _metrics =
    [
        new("throughput", "Throughput",     "48.3K", "rps",     "+12.4%", "up",   "positive", [22, 28, 24, 32, 30, 38, 44, 48]),
        new("latency",    "P95 Latency",    "42",    "ms",      "-3.1ms", "down", "positive", [58, 54, 52, 48, 46, 44, 42, 42]),
        new("errors",     "Error Rate",     "0.01",  "%",       "-0.02",  "down", "positive", [14, 12, 10,  8,  6,  4,  3,  2]),
        new("cache",      "Cache Hit",      "94",    "%",       "+1.8%",  "up",   "positive", [82, 84, 86, 88, 90, 92, 93, 94]),
        new("regions",    "Active Regions", "34",    "/ 34",    "+2",     "up",   "positive", [30, 30, 31, 32, 32, 33, 33, 34]),
        new("deploys",    "Deploys Today",  "127",   "shipped", "+18",    "up",   "positive", [60, 72, 84, 92, 100, 108, 118, 127]),
    ];

    private static string BuildSparkPath(int[] values, double width, double height)
    {
        if (values.Length == 0) return "";
        var max = (double)values[0];
        var min = (double)values[0];
        foreach (var v in values)
        {
            if (v > max) max = v;
            if (v < min) min = v;
        }
        var range = max - min;
        if (range == 0) range = 1;
        var step = width / (values.Length - 1);
        var parts = new System.Text.StringBuilder();
        for (var i = 0; i < values.Length; i++)
        {
            var x = i * step;
            var y = height - ((values[i] - min) / range) * height;
            parts.Append(i == 0 ? "M" : "L");
            parts.Append($" {x:F2} {y:F2}");
            if (i < values.Length - 1) parts.Append(' ');
        }
        return parts.ToString();
    }
}
