@* ============================================================
   Block: features-rounded-tile-card-grid
   Title: FeaturesRoundedTileCardGrid
   Description: A rounded tile card grid features section for React and Next.js with a centered marketing headline, an eyebrow tagline, and a 2x3 grid of spacious rounded-2xl tiles each with a soft bg-muted icon wrapper, a semantic h3 title, and a two-line description built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-rounded-tile-card-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div>
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        @_headline.Eyebrow
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        @_headline.Title
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
        @_headline.Subtitle
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      @foreach (var feature in _features)
      {
        <div class="rounded-2xl border bg-card p-6">
          <div aria-hidden="true" class="flex size-11 items-center justify-center rounded-xl bg-muted/50">
            <LucideIconCn Name="@feature.IconName" Size="20" Class="size-5 text-foreground" />
          </div>
          <h3 class="mt-5 text-base font-semibold text-foreground">@feature.Title</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            @feature.Description
          </p>
        </div>
      }
    </div>
  </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureData(string Id, string Title, string Description, string IconName);

    private static readonly HeadlineData _headline = new(
        "What you get",
        "Everything your team needs in one place",
        "Six capabilities designed to remove the friction between an idea and a shipped product. Built to feel effortless on day one and scale without rewrites."
    );

    private static readonly FeatureData[] _features =
    [
        new("realtime-collab", "Real-time collaboration",
            "Multiplayer cursors, live comments, and presence indicators so your team can move together without waiting on async threads.",
            "users"),
        new("edge-performance", "Edge performance",
            "A global edge network keeps interactions under fifty milliseconds anywhere in the world with zero configuration required.",
            "bolt"),
        new("privacy-first", "Privacy-first by default",
            "SOC 2 Type II, end-to-end encryption, and regional data residency controls available on every paid plan with no add-on fees.",
            "lock"),
        new("observability", "Deep observability",
            "Traces, logs, and metrics unified in a single view so you can find the root cause of any regression in under sixty seconds.",
            "gauge"),
        new("global-reach", "Deploy anywhere",
            "Run on your own cloud, our managed cloud, or an air-gapped environment with the same API and the same developer experience.",
            "globe"),
        new("ai-assist", "AI assistance, when useful",
            "Inline suggestions for the tedious parts of the workflow, tuned to stay quiet until they add value, never to interrupt your flow.",
            "sparkles"),
    ];
}
