@* ============================================================
   Block: features-borderless-compact-icon-grid
   Title: FeaturesBorderlessCompactIconGrid
   Description: A borderless compact icon grid features section for React and Next.js with a thin outer card wrapper and a dense 3x3 inner grid of nine small icon features built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-borderless-compact-icon-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card p-8 sm:p-12">

        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_headline.Eyebrow
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_headline.Title
            </h2>
            <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
                @_headline.Subtitle
            </p>
        </div>

        @* Borderless 3x3 compact grid *@
        <div class="mt-10 grid grid-cols-2 gap-8 md:grid-cols-3 md:gap-10">
            @foreach (var feature in _features)
            {
                <div>
                    <LucideIconCn Name="@feature.Icon" Size="32" StrokeWidth="2" Class="size-8 stroke-[1.5] text-foreground" aria-hidden="true" />
                    <h3 class="mt-3 text-sm font-semibold text-foreground">@feature.Title</h3>
                    <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                        @feature.Description
                    </p>
                </div>
            }
        </div>

        @* Ghost overflow hint *@
        <div class="mt-10 flex items-center justify-center gap-2 text-xs text-muted-foreground">
            <span aria-hidden="true" class="flex size-5 items-center justify-center rounded-full border border-dashed border-muted-foreground/30">
                <LucideIconCn Name="plus" Size="12" StrokeWidth="2" Class="size-3 text-muted-foreground/60" />
            </span>
            <span>and 42 more capabilities across the platform</span>
        </div>

    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureData(string Id, string Icon, string Title, string Description);

    private static readonly HeadlineData _headline = new(
        Eyebrow: "Under the hood",
        Title: "Everything your team reaches for, in one place",
        Subtitle: "Nine capabilities your engineers actually use every day — no bloat, no enterprise tier gate, no setup call."
    );

    private static readonly FeatureData[] _features =
    [
        new("command-menu",  "command",       "Command menu",    "Cmd+K palette reaches every action in two keystrokes."),
        new("git-sync",      "git-branch",    "Git sync",        "Branches, PRs, and deploy status linked inline to tasks."),
        new("edge-runtime",  "globe",         "Edge runtime",    "Sub-50ms responses from 37 regions with zero config."),
        new("typed-webhooks","webhook",       "Typed webhooks",  "Strongly typed event clients with offline retries built in."),
        new("sso-scim",      "shield-check",  "SSO and SCIM",    "SAML 2.0 and user provisioning on every paid plan."),
        new("secrets-vault", "key-round",     "Secrets vault",   "Encrypted variables with per-environment scoping and audit logs."),
        new("live-alerts",   "bell-ring",     "Live alerts",     "Threshold and anomaly pings routed to Slack, email, and PagerDuty."),
        new("perf-budgets",  "gauge",         "Perf budgets",    "CI-enforced performance budgets block slow PRs before merge."),
        new("ai-autocomplete","sparkles",     "AI autocomplete", "Context-aware inline suggestions trained on your codebase."),
    ];
}
