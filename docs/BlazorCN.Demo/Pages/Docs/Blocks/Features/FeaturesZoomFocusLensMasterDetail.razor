@* ============================================================
   Block: features-zoom-focus-lens-master-detail
   Title: FeaturesZoomFocusLensMasterDetail
   Description: A zoom focus lens master detail features section for React and Next.js with a thumbnail sidebar, a large focused panel with scale-in animation, a hover zoom indicator, and a detailed illustration swap built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-zoom-focus-lens-master-detail.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Headline *@
    <div class="max-w-xl">
      <div class="flex items-center gap-2">
        <span class="flex size-6 items-center justify-center rounded-md border bg-background">
          <LucideIconCn Name="zoom-in" Size="12" Class="size-3 text-muted-foreground" />
        </span>
        <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
          Design system primitives
        </span>
      </div>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Lean in on the primitives.
      </h2>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">
        Click any thumbnail to zoom the focus lens onto a primitive. The illustration expands to
        full detail so the work is visible instead of implied.
      </p>
    </div>

    @* Lens container *@
    <div class="mt-10 overflow-hidden rounded-xl border bg-card">
      <div class="flex flex-col md:flex-row">
        @* Thumbnail sidebar *@
        <div class="flex shrink-0 gap-2 overflow-x-auto border-b p-3 md:w-[180px] md:flex-col md:overflow-visible md:border-b-0 md:border-r">
          @foreach (var prim in _primitives)
          {
            var primitive = prim;
            var isActive = primitive.Id == _activeId;
            var isHover = primitive.Id == _hoverId;
            <button
              type="button"
              @onclick="@(() => _activeId = primitive.Id)"
              @onmouseenter="@(() => _hoverId = primitive.Id)"
              @onmouseleave="@(() => _hoverId = null)"
              aria-pressed="@(isActive ? "true" : "false")"
              aria-label="@($"Focus on {primitive.Label}")"
              class="@(Cn.Merge("group relative flex shrink-0 items-center gap-2 overflow-hidden rounded-lg border p-2.5 text-left transition-all md:gap-3", isActive ? "border-foreground bg-background shadow-sm" : "border-border bg-muted/20 hover:bg-muted/40"))"
            >
              <span class="@(Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-md border bg-background", isActive ? "border-foreground/20" : ""))">
                <LucideIconCn Name="@primitive.IconName" Size="14" Class="@(Cn.Merge("size-3.5 transition-colors", isActive ? "text-foreground" : "text-muted-foreground"))" />
              </span>
              <div class="min-w-0 flex-1">
                <div class="@(Cn.Merge("text-xs font-medium transition-colors", isActive ? "text-foreground" : "text-muted-foreground"))">
                  @primitive.Label
                </div>
                <div class="mt-0.5 truncate font-mono text-[9px] text-muted-foreground/70">
                  0@(primitive.Index + 1).primitive
                </div>
              </div>
              @* Zoom hint on hover *@
              <span class="@(Cn.Merge("hidden shrink-0 md:block", (isHover && !isActive) ? "opacity-100" : "opacity-0"))">
                <LucideIconCn Name="zoom-in" Size="12" Class="size-3 text-muted-foreground" />
              </span>
              @* Active left border accent *@
              @if (isActive)
              {
                <span class="absolute inset-y-2 left-0 w-[2px] rounded-full bg-foreground"></span>
              }
            </button>
          }
        </div>

        @* Focused panel *@
        <div class="flex-1">
          <div class="flex h-full flex-col">
            @* Header *@
            <div class="flex items-center justify-between gap-4 border-b px-5 py-4">
              <div class="flex items-center gap-3">
                <span class="flex size-8 items-center justify-center rounded-md border bg-background">
                  <LucideIconCn Name="@ActivePrimitive.IconName" Size="16" Class="size-4 text-foreground" />
                </span>
                <div>
                  <div class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Primitive · @ActivePrimitive.Label
                  </div>
                  <h3 class="mt-0.5 text-sm font-medium text-foreground">
                    @ActivePrimitive.Title
                  </h3>
                </div>
              </div>
              <div class="hidden items-center gap-1 text-[10px] font-medium text-muted-foreground md:flex">
                <LucideIconCn Name="zoom-in" Size="12" Class="size-3" />
                <span>Focused</span>
              </div>
            </div>

            @* Illustration zone *@
            <div class="relative h-[240px] border-b bg-muted/10">
              @RenderIllustration(ActivePrimitive)
            </div>

            @* Description + stats *@
            <div class="flex flex-col gap-4 px-5 py-4 md:flex-row md:gap-6">
              <p class="flex-1 text-sm leading-relaxed text-muted-foreground">
                @ActivePrimitive.Description
              </p>
              <div class="grid shrink-0 grid-cols-3 gap-3 md:w-[240px]">
                @foreach (var stat in ActivePrimitive.Stats)
                {
                  <div class="rounded-md border bg-background px-2.5 py-2">
                    <div class="text-[9px] font-medium uppercase tracking-wider text-muted-foreground">
                      @stat.Label
                    </div>
                    <div class="mt-1 font-mono text-xs font-semibold text-foreground tabular-nums">
                      @stat.Value
                    </div>
                  </div>
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    @* Footer *@
    <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
      <div class="text-xs text-muted-foreground">
        Focused on <span class="font-medium text-foreground">@ActivePrimitive.Label</span> ·
        <span class="font-mono">
          @(_primitives.FindIndex(p => p.Id == _activeId) + 1) of @(_primitives.Count)
        </span>
      </div>
      <div class="flex items-center gap-2">
        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[240px]">Browse all tokens</ButtonCn>
        <ButtonCn Class="w-full sm:w-[250px]">Install the system</ButtonCn>
      </div>
    </div>
  </div>
</section>

@code {
    private string _activeId = "color";
    private string? _hoverId = null;

    private PrimitiveItem ActivePrimitive =>
        _primitives.FirstOrDefault(p => p.Id == _activeId) ?? _primitives[0];

    private record StatItem(string Label, string Value);

    private record PrimitiveItem(string Id, string Label, string IconName, string Title, string Description, StatItem[] Stats, string[] Swatches, int Index, string? SampleText = null);

    private RenderFragment RenderIllustration(PrimitiveItem item) => item.Id switch
    {
        "color" => @<div class="flex h-full w-full items-center justify-center p-6">
            <div class="flex h-32 w-full max-w-md overflow-hidden rounded-xl border">
                @foreach (var swatch in item.Swatches)
                {
                    var bgStyle = "background-color:" + swatch;
                    <div class="flex-1" style="@bgStyle"></div>
                }
            </div>
        </div>,
        "type" => @<div class="flex h-full w-full items-center justify-center p-6">
            <div class="flex items-center gap-6">
                <div class="font-semibold text-[140px] leading-none tracking-tight text-foreground">
                    @(item.SampleText ?? "Ag")
                </div>
                <div class="flex flex-col gap-2 font-mono text-[10px] text-muted-foreground">
                    <span>400 regular</span>
                    <span>500 medium</span>
                    <span class="font-semibold">600 semibold</span>
                </div>
            </div>
        </div>,
        "space" => @<div class="flex h-full w-full items-center justify-center p-6">
            <div class="flex flex-col items-start gap-2">
                @foreach (var sz in new[] { 4, 8, 12, 16, 24, 32, 48 })
                {
                    var widthStyle = "width:" + (sz * 4) + "px";
                    <div class="flex items-center gap-3">
                        <div class="h-2 rounded-sm bg-foreground" style="@widthStyle"></div>
                        <span class="font-mono text-[10px] text-muted-foreground tabular-nums">@(sz)px</span>
                    </div>
                }
            </div>
        </div>,
        "motion" => @<div class="flex h-full w-full items-center justify-center p-6">
            <div class="flex w-full max-w-md flex-col gap-4">
                @foreach (var motionLabel in new[] { "ease-out 200ms", "ease-in-out 300ms", "spring 400ms" })
                {
                    <div class="space-y-1.5">
                        <div class="font-mono text-[10px] text-muted-foreground">@motionLabel</div>
                        <div class="relative h-1.5 overflow-hidden rounded-full bg-muted">
                            <div class="absolute inset-y-0 left-0 w-1/2 rounded-full bg-foreground"></div>
                        </div>
                    </div>
                }
            </div>
        </div>,
        "icons" => @<div class="flex h-full w-full items-center justify-center p-6">
            <div class="grid grid-cols-5 gap-3">
                @foreach (var iconName in new[] { "circle", "square-dashed", "palette", "type", "ruler", "waves", "component", "sparkles", "zoom-in", "circle" })
                {
                    <div class="flex size-12 items-center justify-center rounded-lg border bg-background">
                        <LucideIconCn Name="@iconName" Size="20" Class="size-5 text-foreground" />
                    </div>
                }
            </div>
        </div>,
        "components" => @<div class="flex h-full w-full items-center justify-center p-6">
            <div class="flex w-full max-w-md flex-col gap-3">
                <div class="rounded-lg border bg-background p-3">
                    <div class="h-2 w-24 rounded-full bg-foreground/80"></div>
                    <div class="mt-2 h-1.5 w-40 rounded-full bg-muted"></div>
                    <div class="mt-4 flex gap-2">
                        <div class="h-6 flex-1 rounded-md bg-foreground"></div>
                        <div class="h-6 w-16 rounded-md border"></div>
                    </div>
                </div>
                <div class="flex gap-3">
                    <div class="flex-1 rounded-lg border bg-background p-3">
                        <div class="flex items-center gap-2">
                            <div class="size-6 rounded-full bg-muted"></div>
                            <div class="flex-1 space-y-1">
                                <div class="h-1.5 w-16 rounded-full bg-foreground/80"></div>
                                <div class="h-1.5 w-24 rounded-full bg-muted"></div>
                            </div>
                        </div>
                    </div>
                    <div class="flex-1 rounded-lg border bg-background p-3">
                        <div class="h-1.5 w-12 rounded-full bg-muted"></div>
                        <div class="mt-2 h-5 w-20 rounded-full bg-foreground"></div>
                    </div>
                </div>
            </div>
        </div>,
        _ => @<div></div>,
    };

    private static readonly List<PrimitiveItem> _primitives =
    [
        new("color", "Color", "palette", "A ramp for every mode",
            "Thirteen steps from white to deep ink with a parallel dark-mode twin. Every surface, border, and accent maps to a token, not a hex. Contrast ratios are locked and audited per step so WCAG AA is a pre-commit check, not a hope.",
            [new("Ramp steps", "13"), new("WCAG AA", "Pass"), new("Modes", "Light + dark")],
            ["#f8fafc", "#e2e8f0", "#cbd5e1", "#94a3b8", "#64748b", "#475569", "#334155", "#1e293b", "#0f172a"],
            0),
        new("type", "Type", "type", "Typography tuned to content",
            "Six sizes, three weights, and one variable font that absorbs the whole system. Line height scales with size so long reads never feel cramped and display text never feels loose. Tabular figures keep numbers aligned.",
            [new("Font", "Inter var"), new("Sizes", "6 scale"), new("Weights", "400 / 500 / 600")],
            ["#0f172a", "#475569", "#94a3b8"],
            1, "Ag"),
        new("space", "Space", "ruler", "A spacing scale on four",
            "Every margin, padding, and gap steps in multiples of four pixels. The scale is geometric so jumps between sizes read as deliberate rather than noisy. Components compose cleanly because every spacing token is safely divisible.",
            [new("Base unit", "4px"), new("Scale steps", "11"), new("Pattern", "Geometric")],
            ["#0f172a"],
            2),
        new("motion", "Motion", "waves", "Motion that means something",
            "Four durations and three easing curves. Short transitions stay under 200 milliseconds so they feel responsive; long transitions stay under 400 milliseconds so they feel intentional. Every curve respects prefers-reduced-motion.",
            [new("Durations", "4 tokens"), new("Easings", "3 curves"), new("Reduced motion", "Honored")],
            ["#0f172a", "#475569"],
            3),
        new("icons", "Icons", "circle", "A glyph set that stays in step",
            "A stroke-based icon library with a consistent 24 by 24 grid and 1.5 pixel stroke width. Every glyph shares optical weight so rows of icons visually line up without manual spacing.",
            [new("Glyphs", "1,248"), new("Stroke", "1.5px"), new("Grid", "24x24")],
            ["#0f172a"],
            4),
        new("components", "Components", "component", "Components composed from the tokens",
            "Forty-seven base components draw exclusively from color, type, space, and motion tokens. Nothing is hard-coded. Theme the whole library by editing the token layer and every component updates in lockstep.",
            [new("Components", "47"), new("Tokens only", "100%"), new("Variants", "Per component")],
            ["#f8fafc", "#94a3b8", "#0f172a"],
            5),
    ];
}
