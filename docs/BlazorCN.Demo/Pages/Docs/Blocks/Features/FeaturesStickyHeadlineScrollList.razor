@* ============================================================
   Block: features-sticky-headline-scroll-list
   Title: FeaturesStickyHeadlineScrollList
   Description: A sticky headline scroll list feature section for React and Next.js with a pinned left headline column and a tall right-side scrolling list of eight numbered feature items with mini mockups built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-sticky-headline-scroll-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="min-h-[800px] rounded-2xl border bg-card p-6 sm:p-10 lg:p-14">
        <div class="grid gap-10 lg:grid-cols-[5fr_7fr] lg:gap-14">
            @* Left — Sticky headline *@
            <div class="w-full lg:w-5/12 lg:min-w-[320px]">
                <div class="lg:sticky lg:top-4">
                    <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                        @_headline.Eyebrow
                    </p>
                    <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
                        @_headline.Title
                    </h2>
                    <p class="mt-5 text-base leading-relaxed text-muted-foreground">
                        @_headline.Subtitle
                    </p>
                    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                        <ButtonCn Class="w-full sm:w-[180px]">@_headline.PrimaryCta</ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">@_headline.SecondaryCta</ButtonCn>
                    </div>
                    <div class="mt-10 hidden gap-6 border-t pt-6 lg:flex">
                        <div>
                            <div class="text-2xl font-semibold tabular-nums text-foreground">8</div>
                            <div class="text-xs text-muted-foreground">Capabilities</div>
                        </div>
                        <div>
                            <div class="text-2xl font-semibold tabular-nums text-foreground">0</div>
                            <div class="text-xs text-muted-foreground">Plugins required</div>
                        </div>
                        <div>
                            <div class="text-2xl font-semibold tabular-nums text-foreground">1</div>
                            <div class="text-xs text-muted-foreground">Platform bill</div>
                        </div>
                    </div>
                </div>
            </div>

            @* Right — Scrolling feature list *@
            <div class="space-y-8 lg:flex-1">
                @foreach (var feat in _features)
                {
                    var feature = feat;
                    var num = (Array.IndexOf(_features, feature) + 1).ToString("D2");
                    <div class="grid grid-cols-[auto_1fr] gap-4 sm:grid-cols-[auto_1fr_auto] sm:gap-5">
                        @* Number badge *@
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border bg-muted/50 font-mono text-xs font-semibold tabular-nums text-muted-foreground">
                            @num
                        </div>

                        @* Title + description *@
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="@feature.IconName" Size="16" Class="size-4 shrink-0 text-foreground" />
                                <h3 class="text-base font-semibold text-foreground">@feature.Title</h3>
                            </div>
                            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                                @feature.Description
                            </p>
                        </div>

                        @* Mini mockup *@
                        <div class="col-span-2 hidden h-20 w-36 shrink-0 sm:col-span-1 sm:block">
                            @if (feature.Mockup == "terminal" || feature.Mockup == "log")
                            {
                                <div class="flex h-full w-full flex-col gap-1.5 rounded-md border bg-muted/50 p-2.5 font-mono">
                                    <div class="flex items-center gap-1">
                                        <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                                        <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                                        <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                                    </div>
                                    <div class="flex flex-1 items-center">
                                        <span class="text-[10px] text-muted-foreground">
                                            <span class="text-foreground">$</span> @feature.MockupLabel
                                        </span>
                                    </div>
                                </div>
                            }
                            else if (feature.Mockup == "chart")
                            {
                                <div class="flex h-full w-full flex-col gap-2 rounded-md border bg-muted/50 p-2.5">
                                    <span class="text-[10px] font-medium text-muted-foreground">@feature.MockupLabel</span>
                                    <div class="flex flex-1 items-end gap-1">
                                        @foreach (var bar in _chartBars)
                                        {
                                            <div class="flex-1 rounded-sm bg-foreground/70" style="@($"height:{bar}%")"></div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="flex h-full w-full flex-col gap-1 rounded-md border bg-muted/50 p-2.5 font-mono">
                                    <div class="h-1.5 w-3/4 rounded-sm bg-foreground/20"></div>
                                    <div class="h-1.5 w-1/2 rounded-sm bg-foreground/15"></div>
                                    <div class="h-1.5 w-2/3 rounded-sm bg-foreground/15"></div>
                                    <div class="mt-auto text-[10px] text-muted-foreground">@feature.MockupLabel</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle, string PrimaryCta, string SecondaryCta);

    private record FeatureItem(string Id, string IconName, string Title, string Description, string Mockup, string MockupLabel);

    private static readonly HeadlineData _headline = new(
        Eyebrow: "Everything in the box",
        Title: "The developer platform, end to end",
        Subtitle: "Eight capabilities that cover the entire lifecycle from commit to production. No plugins to install, no third-party integrations to negotiate, no hidden tiers.",
        PrimaryCta: "Start free",
        SecondaryCta: "Read the docs"
    );

    private static readonly FeatureItem[] _features =
    [
        new("preview-deploys", "git-pull-request", "Preview deploys per pull request",
            "Every branch gets its own isolated preview URL with a real database snapshot, spun up in under 30 seconds and torn down on merge.",
            "terminal", "pr-1284.preview.app"),
        new("managed-postgres", "database", "Managed Postgres with branching",
            "Point-in-time recovery, automatic backups, and zero-copy database branches so every preview deploy sees its own full dataset.",
            "log", "branch: staging-1284"),
        new("edge-runtime", "rocket", "Edge runtime with instant rollback",
            "Deploys go live globally in under 90 seconds and atomic rollbacks return to any previous version with a single command.",
            "terminal", "deploy.sh --rollback"),
        new("observability", "bar-chart-3", "Built-in observability",
            "Request traces, structured logs, and runtime metrics for every endpoint, queryable with SQL and retained for 30 days on every plan.",
            "chart", "p95 latency"),
        new("incident-alerts", "bell-ring", "Incident alerts and on-call",
            "Error rate and latency thresholds page the right engineer via Slack, SMS, or PagerDuty with full request context attached.",
            "log", "alert: p99 > 800ms"),
        new("sdk-generation", "code", "Typed SDK generation",
            "Typescript, Python, and Go SDKs generated automatically from your OpenAPI spec on every deploy, published to npm and pypi.",
            "code", "api.users.list()"),
        new("zero-trust", "shield", "Zero-trust network policies",
            "Every service runs behind mTLS with per-route access policies, SOC 2 Type II certification, and optional private networking.",
            "log", "policy: deny-public"),
        new("local-dev", "terminal", "Local dev that mirrors production",
            "A single CLI command boots the full stack on your laptop with the same database, queues, and env vars as production.",
            "terminal", "platform dev"),
    ];

    private static readonly int[] _chartBars = [40, 65, 50, 80, 55, 90, 72];
}
