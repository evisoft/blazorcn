@* ============================================================
   Block: features-with-logos-trust-row
   Title: FeaturesWithLogosTrustRow
   Description: A features section for React and Next.js that pairs a 2x3 icon feature grid with an inline logo trust row for social proof built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-with-logos-trust-row.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">

    @* Headline cluster *@
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        @_headline.Eyebrow
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        @_headline.Title
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        @_headline.Subtitle
      </p>
    </div>

    @* 2x3 feature grid *@
    <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-10 lg:grid-cols-3">
      @foreach (var feature in _features)
      {
        <div>
          <div aria-hidden="true" class="flex size-10 items-center justify-center rounded-lg bg-muted">
            <LucideIconCn Name="@feature.IconName" Size="20" Class="size-5 text-foreground" />
          </div>
          <h3 class="mt-4 text-base font-semibold text-foreground">@feature.Title</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
            @feature.Description
          </p>
        </div>
      }
    </div>

    @* Divider *@
    <div class="mt-12 border-t"></div>

    @* Trust row *@
    <div class="mt-8">
      <p class="text-center text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
        Trusted by 500+ teams
      </p>
      <div class="mt-5 grid grid-cols-3 items-center gap-6 opacity-60 transition-opacity duration-300 hover:opacity-100 sm:grid-cols-6">
        @foreach (var logo in _logos)
        {
          <div class="flex items-center justify-center gap-2">
            @RenderLogoMark(logo.Shape, logo.Name)
            <span class="text-xs font-medium text-muted-foreground">@logo.Name</span>
          </div>
        }
      </div>
    </div>

  </div>
</section>

@code {
    private record HeadlineData(string Eyebrow, string Title, string Subtitle);
    private record FeatureData(string Id, string Title, string Description, string IconName);
    private record LogoData(string Id, string Name, string Shape);

    private static readonly HeadlineData _headline = new(
        "Everything you need",
        "A platform your whole team can rely on",
        "Six capabilities that cover collaboration, performance, security, and insight — trusted by product teams shipping every day."
    );

    private static readonly FeatureData[] _features =
    [
        new("realtime",     "Real-time sync",          "Changes propagate in under 80ms so collaborators always see the latest state without refreshing.",                         "zap"),
        new("collab",       "Team collaboration",      "Granular roles, inline comments, and multiplayer cursors keep cross-functional work in one place.",                        "users"),
        new("workflow",     "Workflow automation",     "Trigger actions from any event with a visual builder and 40+ pre-built integration steps.",                               "workflow"),
        new("insights",     "Usage insights",          "Funnel, retention, and cohort reports update hourly with no SQL or data team required.",                                  "bar-chart-3"),
        new("security",     "Enterprise security",     "SOC 2 Type II, SAML SSO, SCIM, and region-locked data residency on every paid tier.",                                    "lock"),
        new("intelligence", "Smart suggestions",       "Context-aware recommendations surface the next action so new teammates ramp up in minutes.",                             "sparkles"),
    ];

    private static readonly LogoData[] _logos =
    [
        new("acme",      "Acmecorp",    "circle"),
        new("vertex",    "Vertexly",    "square"),
        new("lumen",     "Lumenpath",   "triangle"),
        new("atlas",     "Atlascloud",  "pill"),
        new("northwind", "Northwind",   "diamond"),
        new("helio",     "Heliostack",  "hexagon"),
    ];

    private RenderFragment RenderLogoMark(string shape, string label) => shape switch
    {
        "circle" => @<svg class="size-5 shrink-0 text-foreground/70" viewBox="0 0 24 24" role="img" aria-label="@($"{label} brand mark")">
                        <title>@($"{label} brand mark")</title>
                        <circle cx="12" cy="12" r="8" fill="currentColor" />
                    </svg>,
        "square" => @<svg class="size-5 shrink-0 text-foreground/70" viewBox="0 0 24 24" role="img" aria-label="@($"{label} brand mark")">
                        <title>@($"{label} brand mark")</title>
                        <rect x="4" y="4" width="16" height="16" rx="2" fill="currentColor" />
                    </svg>,
        "triangle" => @<svg class="size-5 shrink-0 text-foreground/70" viewBox="0 0 24 24" role="img" aria-label="@($"{label} brand mark")">
                        <title>@($"{label} brand mark")</title>
                        <path d="M12 3L22 20H2L12 3Z" fill="currentColor" />
                    </svg>,
        "pill" => @<svg class="size-5 shrink-0 text-foreground/70" viewBox="0 0 24 24" role="img" aria-label="@($"{label} brand mark")">
                        <title>@($"{label} brand mark")</title>
                        <rect x="2" y="8" width="20" height="8" rx="4" fill="currentColor" />
                    </svg>,
        "diamond" => @<svg class="size-5 shrink-0 text-foreground/70" viewBox="0 0 24 24" role="img" aria-label="@($"{label} brand mark")">
                        <title>@($"{label} brand mark")</title>
                        <path d="M12 2L22 12L12 22L2 12L12 2Z" fill="currentColor" />
                    </svg>,
        "hexagon" => @<svg class="size-5 shrink-0 text-foreground/70" viewBox="0 0 24 24" role="img" aria-label="@($"{label} brand mark")">
                        <title>@($"{label} brand mark")</title>
                        <path d="M12 2L21 7V17L12 22L3 17V7L12 2Z" fill="currentColor" />
                    </svg>,
        _ => @<text></text>,
    };
}
