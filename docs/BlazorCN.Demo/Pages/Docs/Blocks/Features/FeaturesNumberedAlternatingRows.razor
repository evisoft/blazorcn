@* ============================================================
   Block: features-numbered-alternating-rows
   Title: FeaturesNumberedAlternatingRows
   Description: A numbered alternating rows features section for React and Next.js with four zigzag rows each anchored by an oversized text-6xl font-black ghost number, crosshair image placeholders, and descriptive copy built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-numbered-alternating-rows.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 sm:py-14 lg:py-16">

        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                How it works
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
                Four steps from scattered context to shipped decisions
            </h2>
            <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-muted-foreground">
                A sequenced walkthrough of how the platform turns raw inbound work into structured
                decisions your team can actually act on — in order, top to bottom.
            </p>
        </div>

        @* Numbered rows *@
        <div class="mt-14 space-y-20 sm:mt-20 sm:space-y-24">
            @for (var i = 0; i < _rows.Length; i++)
            {
                var row = _rows[i];
                var isReversed = i % 2 == 1;
                var displayNumber = (i + 1).ToString().PadLeft(2, '0');
                <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-14">

                    @* Text side *@
                    <div class="@(isReversed ? "lg:order-2" : "")">
                        <span aria-hidden="true"
                              class="block text-5xl font-black leading-none tracking-tighter text-foreground/10 sm:text-6xl lg:text-7xl">
                            @displayNumber
                        </span>
                        <p class="mt-4 text-xs font-medium uppercase tracking-widest text-muted-foreground">
                            @row.Eyebrow
                        </p>
                        <h3 class="mt-2 text-2xl font-semibold tracking-tight text-foreground sm:text-[28px]">
                            @row.Title
                        </h3>
                        <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                            @row.Description
                        </p>
                    </div>

                    @* Image side *@
                    <div class="@(isReversed ? "lg:order-1" : "")">
                        <div class="flex aspect-[3/2] w-full items-center justify-center rounded-xl bg-muted">
                            <div class="relative flex items-center justify-center">
                                <div aria-hidden="true"
                                     class="absolute size-28 rounded-full border border-muted-foreground/[0.08]" />
                                <div aria-hidden="true"
                                     class="absolute size-16 rounded-full border border-muted-foreground/[0.1]" />
                                <div aria-hidden="true" class="absolute h-px w-40 bg-muted-foreground/[0.08]" />
                                <div aria-hidden="true" class="absolute h-40 w-px bg-muted-foreground/[0.08]" />
                                <div class="flex size-10 items-center justify-center rounded-full border border-muted-foreground/[0.1] bg-background/60">
                                    <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/40" aria-hidden="true" />
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            }
        </div>

    </div>
</section>

@code {
    private record NumberedRow(string Id, string Eyebrow, string Title, string Description);

    private static readonly NumberedRow[] _rows =
    [
        new("capture", "Capture",
            "Pull signal from every tool your team already uses",
            "Connect Slack, Linear, GitHub, and Notion in under a minute and let the platform ingest threads, tickets, commits, and docs in real time. Nothing is copied or duplicated — we index in place and surface context when you ask for it."),
        new("organize", "Organize",
            "Auto-cluster incoming work into themes and owners",
            "Incoming tickets and threads get grouped by theme, priority, and likely owner using a model tuned on your workspace history. Reviewers confirm or reroute with a single click, and the model learns from every correction without leaving your workspace."),
        new("decide", "Decide",
            "Run decisions with a structured approval workflow",
            "Every proposal gets a decision doc with stakeholders, options, tradeoffs, and a clear owner. Approvers sign in-line with typed comments, and the decision becomes a permanent artifact linked from every related ticket and doc automatically."),
        new("measure", "Measure",
            "See the outcome of every shipped decision in one place",
            "After a decision ships, the platform tracks the metrics you said mattered — latency, churn, conversion — and posts a follow-up card 30 days later so the team can close the loop. Nothing falls through the cracks, and learnings feed back into the next cycle."),
    ];
}
