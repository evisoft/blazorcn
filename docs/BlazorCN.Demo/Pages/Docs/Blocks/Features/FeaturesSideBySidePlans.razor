@* ============================================================
   Block: features-side-by-side-plans
   Title: Features Side By Side Plans
   Description: Two subscription plans compared side by side with feature lists and visual indicators
   Dependencies: None
   Source: original/blocks/features/features-side-by-side-plans.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Plan Comparison</h2>
            <p class="mt-1 text-xs text-muted-foreground">Compare features across subscription tiers</p>
        </div>

        <div class="grid grid-cols-2 divide-x">
            @foreach (var plan in _plans)
            {
                <div>
                    <div class="border-b bg-muted/30 px-4 py-3">
                        <h3 class="text-sm font-medium">@plan.Name</h3>
                        <p class="mt-0.5 text-xs text-muted-foreground">@plan.Description</p>
                    </div>
                    <div class="px-4 py-4">
                        <ul class="space-y-2.5">
                            @foreach (var feature in plan.Features)
                            {
                                <li class="flex items-start gap-2">
                                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                                    <span class="text-sm">@feature</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
            <p class="text-xs text-muted-foreground">All plans include 99.9% uptime SLA and data encryption</p>
        </div>
    </div>
</section>

@code {
    private record Plan(string Name, string Description, string[] Features);

    private static readonly Plan[] _plans =
    [
        new("Starter", "For individuals and small teams", [
            "Up to 5 team members", "10 GB storage", "Basic analytics",
            "Email support", "API access", "Mobile apps",
        ]),
        new("Business", "For growing organizations", [
            "Up to 50 team members", "100 GB storage", "Advanced analytics with exports",
            "Priority support with SLA", "API access with webhooks", "Mobile apps",
            "Custom integrations", "SSO authentication", "Audit logs", "Advanced permissions",
        ]),
    ];
}
