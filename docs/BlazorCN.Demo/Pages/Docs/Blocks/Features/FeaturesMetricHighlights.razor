@* ============================================================
   Block: features-metric-highlights
   Title: Features Metric Highlights
   Description: Feature showcase with key performance metrics, perfect for data-driven landing pages and SaaS product pages built with Next.js.
   Long Description: A keyboard shortcut reference guide with kbd-styled key combinations and grouped categories
   Dependencies: None
   Source: original/blocks/features/features-metric-highlights.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
          <h2 class="text-sm font-medium">Performance at Scale</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Proven metrics from production workloads
          </p>
        </div>
        @{ var featureIdx = 0; }
        @foreach (var feature in _features)
        {
          <div class="@(Cn.Merge("grid grid-cols-[120px_1fr] gap-4 px-4 py-4", featureIdx < _features.Length - 1 ? "border-b" : ""))">
            <div class="flex items-start justify-start">
              <span class="@(Cn.Merge("font-semibold tabular-nums text-2xl", feature.MetricColor))">
                @feature.Metric
              </span>
            </div>
            <div class="min-w-0">
              <h3 class="text-sm font-medium">@feature.Title</h3>
              <p class="mt-1 text-sm text-muted-foreground">@feature.Description</p>
            </div>
          </div>
          featureIdx++;
        }
      </div>
    </section>

@code {
    private record FeatureData(string Title, string Description, string Metric, string MetricColor);

    private static readonly FeatureData[] _features = new[]
    {
        new FeatureData("Sub-millisecond Latency", "Edge-optimized infrastructure delivers responses faster than traditional cloud setups.", "<1ms", "text-emerald-600 dark:text-emerald-400"),
        new FeatureData("Massive Throughput", "Handle millions of concurrent connections with automatic horizontal scaling.", "10M+", "text-blue-600 dark:text-blue-400"),
        new FeatureData("Global Coverage", "Deploy to 40+ regions worldwide with automatic traffic routing.", "40+", "text-purple-600 dark:text-purple-400"),
        new FeatureData("Enterprise Uptime", "Industry-leading SLA backed by redundant infrastructure.", "99.99%", "text-amber-600 dark:text-amber-400"),
    };
}
