@* ============================================================
   Block: features-layered-stack-diagram
   Title: FeaturesLayeredStackDiagram
   Description: A vertical layered stack diagram feature section for React and Next.js showing five stacked tech layers with per-layer vendors and cross-cutting concern callouts built with ShadcnioButton, shadcn/ui, and Tailwind CSS
   Source: original/blocks/features/features-layered-stack-diagram.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-12">

    @* Headline *@
    <div class="mx-auto max-w-xl text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        The stack
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Built on a solid foundation
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        Every layer is boring, battle-tested, and replaceable. We let the teams we depend on focus on what they do best so we can focus on the layer our customers actually see.
      </p>
    </div>

    @* Layered stack *@
    <ol class="mt-12 flex flex-col items-center gap-2">
      @foreach (var layer in _stackLayers)
      {
        <li class="@Cn.Merge("flex items-center gap-4 rounded-lg border px-5 py-4", layer.WidthClass, layer.ToneClass)">
          <span aria-hidden="true" class="flex size-9 shrink-0 items-center justify-center rounded-md border bg-background">
            <LucideIconCn Name="@layer.IconName" Size="16" Class="size-4 text-foreground" />
          </span>
          <div class="flex min-w-0 flex-1 flex-col gap-0.5 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
            <div class="min-w-0">
              <h3 class="text-sm font-semibold text-foreground">@layer.Title</h3>
              <p class="truncate text-xs text-muted-foreground">@layer.Description</p>
            </div>
            <p class="shrink-0 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">
              Powered by @layer.PoweredBy
            </p>
          </div>
        </li>
      }
    </ol>

    @* Cross-cutting concerns *@
    <dl class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-3">
      @foreach (var concern in _crossCutting)
      {
        <div class="rounded-xl border bg-background p-5">
          <span aria-hidden="true" class="flex size-8 items-center justify-center rounded-md bg-muted">
            <LucideIconCn Name="@concern.IconName" Size="16" Class="size-4 text-foreground" />
          </span>
          <dt class="mt-3 text-sm font-semibold text-foreground">@concern.Title</dt>
          <dd class="mt-1.5 text-xs leading-relaxed text-muted-foreground">@concern.Description</dd>
        </div>
      }
    </dl>

  </div>
</section>

@code {
    private record StackLayer(string Id, string Title, string Description, string PoweredBy, string IconName, string WidthClass, string ToneClass);
    private record CrossCuttingConcern(string Id, string Title, string Description, string IconName);

    private static readonly StackLayer[] _stackLayers =
    [
        new("ui",             "UI",             "The surface your users touch every day",        "React 19 and Tailwind CSS", "layers",   "w-full sm:w-[60%]",  "bg-muted/20"),
        new("apis",           "APIs",           "Typed contracts between client and server",     "tRPC and OpenAPI",          "plug",     "w-full sm:w-[72%]",  "bg-muted/30"),
        new("services",       "Services",       "Business logic and domain workflows",           "Temporal and Inngest",      "code",     "w-full sm:w-[84%]",  "bg-muted/40"),
        new("runtime",        "Runtime",        "Where every function actually executes",        "Node 22 and Bun 1.3",       "terminal", "w-full sm:w-[92%]",  "bg-muted/60"),
        new("infrastructure", "Infrastructure", "The hardware and network beneath everything",   "AWS and Cloudflare",        "server",   "w-full sm:w-full",   "bg-muted/80"),
    ];

    private static readonly CrossCuttingConcern[] _crossCutting =
    [
        new("security",
            "Security at every layer",
            "SOC 2 Type II controls, end-to-end encryption, and zero-trust networking applied from the UI down to the metal.",
            "shield"),
        new("observability",
            "Observability baked in",
            "Structured logs, traces, and metrics flow from every layer into a single queryable timeline with no manual instrumentation.",
            "eye"),
        new("dx",
            "Developer experience",
            "Local dev matches production exactly, deploys are instant and atomic, and every layer exposes a typed interface to the one above it.",
            "wrench"),
    ];
}
