@* ============================================================
   Block: features-animated-icons
   Title: FeaturesAnimatedIcons
   Description: A dark inset icon grid features section for React and Next.js with a three-column layout, icon-first cards, and subtle hover scale animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-animated-icons.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl bg-foreground px-6 py-12 sm:px-10 sm:py-16">

        @* Headline cluster *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-background/40">
                Infrastructure
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-background sm:text-4xl">
                Everything you need to ship at scale
            </h2>
            <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-background/60">
                Nine production-ready capabilities that work on day one — no configuration, no
                surprises, no midnight pages.
            </p>
        </div>

        @* Icon grid *@
        <div class="mt-12 grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
            @foreach (var feat in _features)
            {
                <div class="group rounded-xl border border-background/10 bg-background/[0.05] p-5 transition-colors hover:bg-background/[0.08]">
                    <div class="flex size-10 items-center justify-center rounded-lg bg-background/10">
                        <LucideIconCn Name="@feat.IconName" Size="20" Class="size-5 text-background/70" />
                    </div>
                    <h3 class="mt-4 text-base font-semibold text-background">@feat.Title</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-background/60">
                        @feat.Description
                    </p>
                </div>
            }
        </div>

        @* CTA row *@
        <div class="mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-center">
            <ButtonCn Class="w-full sm:w-[180px] bg-background text-foreground hover:bg-background/90">
                Get started
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[170px] border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background">
                Learn more
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record FeatureData(string IconName, string Title, string Description);

    private static readonly FeatureData[] _features =
    [
        new("bolt", "Instant deploys",
            "Push to git and changes go live in under 3 seconds with zero-downtime rollouts and one-click rollback."),
        new("globe", "Edge network",
            "Serve content from 300+ edge locations worldwide for sub-50ms latency to every visitor on the planet."),
        new("rocket", "Auto-scaling",
            "Scale from zero to millions of requests per second with no manual capacity planning or infrastructure changes."),
        new("lock", "Zero-trust security",
            "Every request authenticated at the edge with TLS, DDoS protection, and WAF rules enabled by default."),
        new("activity", "Live observability",
            "Real-time logs, traces, and metrics with built-in alerting, dashboards, and anomaly detection."),
        new("database", "Managed databases",
            "Postgres, MySQL, and Redis with automated backups, replication, and point-in-time recovery included."),
        new("layers", "Preview deploys",
            "Every pull request gets its own preview URL with production-grade infrastructure and isolated data."),
        new("shield", "DDoS protection",
            "Enterprise-grade protection against volumetric and application-layer attacks with automatic mitigation."),
        new("server", "Managed compute",
            "Serverless functions, cron jobs, and long-running workers on a single control plane with unified billing."),
    ];
}
