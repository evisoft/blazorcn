@* ============================================================
   Block: features-spotlight-hover-mask-grid
   Title: FeaturesSpotlightHoverMaskGrid
   Description: A spotlight hover mask grid features section for React and Next.js with a cursor-tracking radial reveal, dimmed sibling cards, and a six-cell analytics feature grid built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-spotlight-hover-mask-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div>
    @* Headline cluster *@
    <div class="max-w-xl">
      <div class="flex items-center gap-2">
        <span class="flex size-6 items-center justify-center rounded-md border bg-background">
          <LucideIconCn Name="line-chart" Size="12" Class="size-3 text-muted-foreground" />
        </span>
        <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
          Analytics, lit from within
        </span>
      </div>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Every card, under the spotlight.
      </h2>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">
        Move your cursor across the grid and the nearest capability steps into the light. The
        others fade back so you can read one feature at a time without losing the set.
      </p>
    </div>

    @* Grid *@
    <div
      @onmousemove="HandleMouseMove"
      @onmouseleave="HandleMouseLeave"
      class="relative mt-10 overflow-hidden rounded-xl border bg-card"
    >
      <div class="relative grid grid-cols-1 gap-px bg-border sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var cap in _capabilities)
        {
          var capId = cap.Id;
          var isActive = _hoveredId == capId;
          <button
            type="button"
            aria-label="@($"{cap.Label}: {cap.Headline}")"
            @onmouseenter="@(() => _hoveredId = capId)"
            class="@Cn.Merge(
              "group relative flex flex-col gap-4 bg-card p-6 text-left transition-colors duration-300",
              isActive ? "bg-muted/40" : ""
            )"
          >
            <div class="flex items-center justify-between">
              <span
                class="@Cn.Merge(
                  "flex size-8 items-center justify-center rounded-md border bg-background transition-all duration-300",
                  isActive ? "border-foreground/30" : ""
                )"
              >
                <LucideIconCn
                  Name="@cap.IconName"
                  Size="16"
                  Class="@Cn.Merge(
                    "size-4 transition-colors duration-300",
                    isActive ? "text-foreground" : "text-muted-foreground"
                  )"
                />
              </span>
              <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                @cap.Label
              </span>
            </div>

            <div>
              <h3 class="text-sm font-semibold leading-tight text-foreground">
                @cap.Headline
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                @cap.Description
              </p>
            </div>

            <ul class="space-y-1">
              @foreach (var bullet in cap.Bullets)
              {
                <li class="flex items-center gap-2 text-[11px] text-foreground/80">
                  <span class="size-1 rounded-full bg-foreground/60"></span>
                  <span>@bullet</span>
                </li>
              }
            </ul>

            <div class="mt-auto flex items-end justify-between gap-3 pt-2">
              <div>
                <div class="text-[9px] font-medium uppercase tracking-wider text-muted-foreground">
                  @cap.MetricLabel
                </div>
                <div class="mt-0.5 font-mono text-lg font-semibold text-foreground tabular-nums">
                  @cap.MetricValue
                </div>
              </div>
              <div class="w-20">
                @* Sparkline *@
                <svg class="h-6 w-full" viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true">
                  <path
                    d="@BuildSparklinePath(cap.Trend)"
                    fill="none"
                    stroke-width="1.4"
                    stroke="currentColor"
                    class="@Cn.Merge(
                      "transition-colors duration-300",
                      isActive ? "text-foreground" : "text-muted-foreground/50"
                    )"
                  />
                </svg>
              </div>
            </div>
          </button>
        }
      </div>

      @* Spotlight overlay *@
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 transition-opacity duration-300"
        style="@_overlayStyle"
      ></div>
    </div>

    @* Legend + CTA row *@
    <div class="mt-6 flex flex-col gap-3 rounded-lg border bg-muted/30 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-2">
        <LucideIconCn Name="mouse-pointer-2" Size="14" Class="size-3.5 text-muted-foreground" />
        <span class="text-xs text-muted-foreground">
          @(_hoveredId != null
            ? $"Focused on {_capabilities.FirstOrDefault(c => c.Id == _hoveredId)?.Label}"
            : "Hover the grid to aim the beam")
        </span>
      </div>
      <div class="flex items-center gap-2">
        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">See pricing</ButtonCn>
        <ButtonCn Class="w-full sm:w-[200px]">Start a trial</ButtonCn>
      </div>
    </div>
  </div>
</section>

@code {
    private string? _hoveredId = null;
    private string _overlayStyle = "background:transparent;";

    private void HandleMouseMove(MouseEventArgs e)
    {
        var x = e.OffsetX;
        var y = e.OffsetY;
        _overlayStyle = $"background:radial-gradient(circle 260px at {x:F1}px {y:F1}px, transparent 0%, transparent 30%, rgba(0,0,0,0.55) 100%);";
    }

    private void HandleMouseLeave()
    {
        _overlayStyle = "background:transparent;";
        _hoveredId = null;
    }

    private static string BuildSparklinePath(int[] points)
    {
        if (points.Length == 0) return "";
        var max = points.Max();
        var min = points.Min();
        var range = Math.Max(1, max - min);
        var step = 100.0 / (points.Length - 1);
        var segments = new System.Text.StringBuilder();
        for (var i = 0; i < points.Length; i++)
        {
            var px = (i * step);
            var py = 24.0 - ((points[i] - min) / (double)range) * 22.0;
            segments.Append(i == 0 ? "M" : "L");
            segments.Append($"{px:F1},{py:F1}");
            if (i < points.Length - 1) segments.Append(' ');
        }
        return segments.ToString();
    }

    private record Capability(
        string Id,
        string IconName,
        string Label,
        string Headline,
        string Description,
        string[] Bullets,
        string MetricLabel,
        string MetricValue,
        int[] Trend
    );

    private static readonly Capability[] _capabilities =
    [
        new("funnel", "split", "Funnels",
            "Funnels that follow the user",
            "Track multi-step conversion paths across sessions without gluing identifiers by hand.",
            ["Cross-session stitch", "Step time deltas", "Drop-off reasons"],
