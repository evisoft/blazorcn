@* ============================================================
   Block: features-depth-layered-stack
   Title: FeaturesDepthLayeredStack
   Description: A depth layered stack feature section for React and Next.js with three feature cards arranged in a spatial 3D illusion and arrow navigation to cycle the front card built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-depth-layered-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
  <div class="rounded-2xl border bg-card p-6 sm:p-10">

    @* Headline above the stack *@
    <div class="text-center">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Three pillars
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Capabilities that stack, not compete
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
        Every product decision we made supports the next. Cycle through the three pillars that define how this platform actually feels to use.
      </p>
    </div>

    @* Layered card stack *@
    <div class="relative mx-auto mt-14 h-[360px] w-full max-w-sm sm:mt-16 sm:h-[400px]">
      @foreach (var feat in _features)
      {
        var featureItem = feat;
        var slot = GetSlotForFeature(featureItem.Index);
        var isFront = featureItem.Index == _activeIndex;
        <div
          aria-hidden="@(isFront ? null : "true")"
          class="@Cn.Merge("absolute inset-0 flex flex-col rounded-2xl border bg-card p-6 shadow-sm transition-all duration-500 ease-out sm:p-8", slot.Translate, slot.Scale, slot.Opacity, slot.Z, slot.Rotate)"
        >
          <div class="flex items-center justify-between">
            <span class="flex size-11 items-center justify-center rounded-xl border bg-muted/50">
              <LucideIconCn Name="@featureItem.IconName" Size="20" Class="size-5 text-foreground" aria-hidden="true" />
            </span>
            <span class="rounded-full border bg-muted/50 px-2.5 py-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
              @featureItem.Tag
            </span>
          </div>
          <h3 class="mt-6 text-xl font-semibold tracking-tight text-foreground sm:text-2xl">
            @featureItem.Title
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            @featureItem.Description
          </p>
          <div class="mt-auto flex items-center gap-2 pt-6 text-xs font-medium text-muted-foreground">
            <span class="font-mono tabular-nums text-foreground">
              @((featureItem.Index + 1).ToString("D2"))
            </span>
            <span class="h-px flex-1 bg-border"></span>
            <span class="font-mono uppercase tracking-widest">Pillar</span>
          </div>
        </div>
      }
    </div>

    @* Navigation row: dots + arrows *@
    <div class="mt-10 flex items-center justify-center gap-6">
      <button
        type="button"
        @onclick="@(() => CycleTo(_activeIndex - 1))"
        aria-label="Previous feature"
        class="flex size-10 items-center justify-center rounded-full border bg-card text-foreground transition-colors hover:bg-muted/50"
      >
        <LucideIconCn Name="chevron-left" Size="16" Class="size-4" aria-hidden="true" />
      </button>

      <div class="flex items-center gap-2">
        @foreach (var feat in _features)
        {
          var featureItem = feat;
          <button
            type="button"
            @onclick="@(() => CycleTo(featureItem.Index))"
            aria-label="@($"Show {featureItem.Title}")"
            class="@Cn.Merge("h-1.5 rounded-full transition-all duration-300", featureItem.Index == _activeIndex ? "w-8 bg-foreground" : "w-1.5 bg-muted-foreground/30 hover:bg-muted-foreground/60")"
          ></button>
        }
      </div>

      <button
        type="button"
        @onclick="@(() => CycleTo(_activeIndex + 1))"
        aria-label="Next feature"
        class="flex size-10 items-center justify-center rounded-full border bg-card text-foreground transition-colors hover:bg-muted/50"
      >
        <LucideIconCn Name="chevron-right" Size="16" Class="size-4" aria-hidden="true" />
      </button>
    </div>

  </div>
</section>

@code {
    private int _activeIndex = 0;

    private record Feature(int Index, string Id, string IconName, string Tag, string Title, string Description);

    private record SlotStyle(string Translate, string Scale, string Opacity, string Z, string Rotate);

    private static readonly SlotStyle[] _slotStyles =
    [
        // Front slot
        new("translate-x-0 translate-y-0", "scale-100", "opacity-100", "z-30", "rotate-0"),
        // Middle slot — offset to the top-right
        new("translate-x-8 -translate-y-6 sm:translate-x-12 sm:-translate-y-8", "scale-[0.94]", "opacity-70", "z-20", "rotate-2"),
        // Back slot — offset to the top-left
        new("-translate-x-8 -translate-y-10 sm:-translate-x-12 sm:-translate-y-14", "scale-[0.88]", "opacity-40", "z-10", "-rotate-2"),
    ];

    private static readonly Feature[] _features =
    [
        new(0, "speed",    "zap",      "Performance", "Sub-50ms interactions",
            "A local-first data layer keeps every keystroke under 50 milliseconds. The UI never blocks on a network round trip, even on transatlantic connections."),
        new(1, "security", "shield",   "Security",    "SOC 2 by default",
            "Single-tenant isolation, private networking, and SAML SSO on every paid plan. Audit logs stream to your SIEM in real time with zero manual wiring."),
        new(2, "workflow", "workflow", "Workflow",     "Composable automations",
            "Chain typed actions with conditional steps, retry policies, and scheduled triggers. No YAML pyramid, no proprietary DSL, just plain TypeScript functions."),
    ];

    private SlotStyle GetSlotForFeature(int featureIndex)
    {
        var distance = (featureIndex - _activeIndex + _features.Length) % _features.Length;
        return _slotStyles[distance];
    }

    private void CycleTo(int index)
    {
        var normalized = ((index % _features.Length) + _features.Length) % _features.Length;
        _activeIndex = normalized;
    }
}
