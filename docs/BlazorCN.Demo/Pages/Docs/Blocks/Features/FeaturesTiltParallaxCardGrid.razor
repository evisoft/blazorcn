@* ============================================================
   Block: features-tilt-parallax-card-grid
   Title: FeaturesTiltParallaxCardGrid
   Description: A tilt parallax card grid features section for React and Next.js with six 3D mouse-tilt cards, multi-layer parallax depth, and floating accent badges that lift on hover built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-tilt-parallax-card-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="max-w-xl">
            <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                The developer surface
            </span>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                Six tools, six tilts.
            </h2>
            <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                Move your cursor over any card. Each one rotates in three dimensions while its layers
                drift at different depths — because the best IDE features should feel like objects you
                can pick up.
            </p>
        </div>

        @* Grid *@
        <div class="mt-10 grid gap-4 sm:grid-cols-2 md:grid-cols-3" style="perspective: 1200px">
            @foreach (var card in _cards)
            {
                var toneDot = GetToneDot(card.Tone);
                var toneBadge = GetToneBadge(card.Tone);
                <div class="h-[240px]">
                    <div class="group relative h-full overflow-hidden rounded-xl border bg-card p-5 transition-colors hover:bg-card/80">
                        @* Layer -1: background watermark icon (sits behind title) *@
                        <div aria-hidden="true" class="pointer-events-none absolute -right-6 -top-6 opacity-[0.06] transition-opacity group-hover:opacity-[0.1]">
                            <LucideIconCn Name="@card.IconName" Size="144" StrokeWidth="1" Class="size-36" />
                        </div>

                        @* Layer 0: main content (flush to card surface) *@
                        <div class="relative flex h-full flex-col" style="transform: translateZ(0px)">
                            <div class="flex items-center gap-2">
                                <span class="flex size-7 items-center justify-center rounded-md border bg-background">
                                    <LucideIconCn Name="@card.IconName" Size="14" StrokeWidth="2" Class="size-3.5 text-foreground" />
                                </span>
                                <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                                    @card.Label
                                </span>
                            </div>

                            <h3 class="mt-4 text-sm font-medium leading-snug text-foreground">@card.Title</h3>
                            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">@card.Description</p>

                            @* Metric row at bottom *@
                            <div class="mt-auto flex items-end justify-between gap-2 pt-5">
                                <div>
                                    <div class="text-[9px] font-medium uppercase tracking-wider text-muted-foreground">
                                        @card.MetricLabel
                                    </div>
                                    <div class="mt-0.5 font-mono text-lg font-semibold text-foreground tabular-nums">
                                        @card.MetricValue
                                    </div>
                                </div>
                                <span class="flex items-center gap-1 text-[10px] font-medium text-muted-foreground">
                                    <span class="@Cn.Merge("size-1.5 rounded-full", toneDot)"></span>
                                    healthy
                                </span>
                            </div>
                        </div>

                        @* Layer +1: floating accent badge (lifts forward) *@
                        <div class="pointer-events-none absolute right-3 top-3">
                            <span class="@Cn.Merge("inline-flex items-center gap-1 rounded-full border bg-background/90 px-2 py-0.5 text-[9px] font-medium backdrop-blur", toneBadge)">
                                <span class="@Cn.Merge("size-1 rounded-full", toneDot)"></span>
                                Live
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer legend *@
        <div class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border bg-muted/30 px-4 py-3">
            <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                Move your cursor to tilt
            </span>
            <div class="flex items-center gap-3 text-[10px] text-muted-foreground">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Stable
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    Preview
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    Beta
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record TiltCardData(
        string Id,
        string IconName,
        string Label,
        string Title,
        string Description,
        string MetricLabel,
        string MetricValue,
        string Tone
    );

    private static readonly TiltCardData[] _cards =
    [
        new TiltCardData("editor", "sparkles", "Editor", "Monaco with language services wired up",
            "Full TypeScript, Go, Rust, and Python support with hover cards, refactors, and a structural multi-cursor that respects your AST, not your regexes.",
            "Languages", "38", "blue"),
        new TiltCardData("terminal", "terminal", "Terminal", "A real PTY in the browser, not a fake shell",
            "Interactive, color-accurate, and GPU-composited. Run vim, tmux, or k9s as if you were on the host. Sessions persist across reloads with zero flicker.",
            "Latency", "14ms", "emerald"),
        new TiltCardData("debugger", "bug", "Debugger", "Breakpoints that travel across processes",
            "Step from your frontend into an edge function, from there into a Postgres trigger, and back — one timeline, one paused state, one set of variables.",
            "Hops", "1→N", "amber"),
        new TiltCardData("profiler", "activity", "Profiler", "Flame graphs that map to source on click",
            "Capture CPU, allocations, and event loop stalls in one trace. Clicking any frame opens the exact file and line number that produced it, with git blame inline.",
            "Overhead", "1.4%", "blue"),
        new TiltCardData("linter", "shield-check", "Linter", "Rules you can read, fixes you can trust",
            "The rule engine is a transparent DSL compiled to a typed AST visitor. Every auto-fix is a diff you can approve before it touches the file. No mystery edits.",
            "Rules", "462", "emerald"),
        new TiltCardData("tests", "test-tube", "Tests", "Snapshot-free tests that run on every save",
            "Watch mode that only reruns tests whose dependencies actually changed. In-memory mock filesystem, deterministic clock, and DOM assertions without a browser.",
            "Suite time", "2.1s", "amber"),
    ];

    private static string GetToneDot(string tone) => tone switch
    {
        "emerald" => "bg-emerald-500",
        "blue" => "bg-blue-500",
        "amber" => "bg-amber-500",
        _ => "bg-gray-500",
    };

    private static string GetToneBadge(string tone) => tone switch
    {
        "emerald" => "border-emerald-500/40 text-emerald-600 dark:text-emerald-400",
        "blue" => "border-blue-500/40 text-blue-600 dark:text-blue-400",
        "amber" => "border-amber-500/40 text-amber-600 dark:text-amber-400",
        _ => "",
    };
}
