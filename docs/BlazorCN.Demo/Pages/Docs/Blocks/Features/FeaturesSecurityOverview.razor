@* ============================================================
   Block: features-security-overview
   Title: Features Security Overview
   Description: A features block displaying security and compliance features in an audit-style layout built with Next.js, React, shadcn/ui, and Tailwind CSS
   Long Description: Features organized by customer segment
   Dependencies: None
   Source: original/blocks/features/features-security-overview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
          <h2 class="text-sm font-medium">Security Overview</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Enterprise-grade security and compliance
          </p>
        </div>

        @foreach (var category in _securityCategories)
        {
          <div class="border-b">
            <div class="bg-muted/50 px-4 py-2">
              <h3 class="text-xs font-medium text-muted-foreground">@category.Category</h3>
            </div>

            <div class="space-y-0">
              @{ var featIdx = 0; }
              @foreach (var feature in category.Features)
              {
                <div class="@(Cn.Merge("px-4 py-3", featIdx < category.Features.Length - 1 ? "border-b border-muted/50" : ""))">
                  <div class="flex items-start gap-3">
                    <span class="@(Cn.Merge("mt-1 size-1.5 shrink-0 rounded-full", GetStatusColor(feature.Status)))"></span>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2">
                        <p class="text-sm font-medium">@feature.Name</p>
                        <span class="text-xs text-muted-foreground">
                          @GetStatusLabel(feature.Status)
                        </span>
                      </div>
                      <p class="mt-0.5 text-xs text-muted-foreground">@feature.Description</p>
                    </div>
                  </div>
                </div>
                featIdx++;
              }
            </div>
          </div>
        }
      </div>
    </section>

@code {
    private record SecurityFeature(string Name, string Description, string Status);
    private record SecurityCategory(string Category, SecurityFeature[] Features);

    private static readonly SecurityCategory[] _securityCategories = new[]
    {
        new SecurityCategory("Infrastructure", new[]
        {
            new SecurityFeature("End-to-end encryption", "All data encrypted in transit and at rest using AES-256", "active"),
            new SecurityFeature("DDoS protection", "Automatic threat detection and mitigation at network edge", "active"),
            new SecurityFeature("Network isolation", "VPC peering and private networking for enterprise deployments", "active"),
        }),
        new SecurityCategory("Access Control", new[]
        {
            new SecurityFeature("Role-based access", "Granular permissions with custom roles and policies", "active"),
            new SecurityFeature("SSO integration", "SAML 2.0 and OIDC support for enterprise identity providers", "active"),
            new SecurityFeature("Multi-factor authentication", "TOTP, WebAuthn, and SMS-based second factors", "active"),
        }),
        new SecurityCategory("Compliance", new[]
        {
            new SecurityFeature("SOC 2 Type II", "Annual audit by independent third-party auditor", "certified"),
            new SecurityFeature("GDPR compliance", "Full compliance with EU data protection regulations", "certified"),
            new SecurityFeature("HIPAA ready", "BAA available for healthcare data processing", "in-progress"),
        }),
    };

    private static string GetStatusColor(string status) => status switch
    {
        "active" => "bg-emerald-500",
        "certified" => "bg-blue-500",
        "in-progress" => "bg-amber-500",
        _ => "bg-gray-500",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "active" => "Active",
        "certified" => "Certified",
        "in-progress" => "In Progress",
        _ => status,
    };
}
