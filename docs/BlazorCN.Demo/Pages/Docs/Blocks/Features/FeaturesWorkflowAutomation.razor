@* ============================================================
   Block: features-workflow-automation
   Title: Features Workflow Automation
   Description: Showcase automation workflow features with trigger-action pairs in a connected flow layout
   Dependencies: None
   Source: original/blocks/features/features-workflow-automation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <span class="text-sm font-medium">Workflow Automation</span>
            <p class="mt-0.5 text-xs text-muted-foreground">Automate your development workflow with powerful triggers and actions</p>
        </div>

        <div class="divide-y">
            @foreach (var workflow in _workflows)
            {
                <div class="px-4 py-3">
                    <div class="mb-2 flex items-center gap-2">
                        <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                        <span class="font-mono text-xs text-muted-foreground">@workflow.Category</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="min-w-0 flex-1">
                            <span class="block text-sm">
                                When <span class="font-medium">@workflow.Trigger</span>
                            </span>
                        </div>
                        <div class="flex shrink-0 items-center gap-1 text-muted-foreground/40">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                            </svg>
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="block text-sm">@workflow.Action</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">@_workflows.Length automation workflows configured</span>
                <button type="button" class="text-xs transition-colors hover:text-foreground">View all workflows</button>
            </div>
        </div>
    </div>
</section>

@code {
    private record WorkflowItem(string Trigger, string Action, string Category);

    private static readonly WorkflowItem[] _workflows =
    [
        new("Pull request merged", "Deploy to staging environment", "Deployment"),
        new("New commit pushed", "Run test suite and linters", "Testing"),
        new("Build completes", "Send Slack notification to team", "Notifications"),
        new("Issue labeled 'bug'", "Assign to on-call engineer", "Issue Management"),
        new("Release tag created", "Generate changelog and publish docs", "Release"),
        new("Security scan fails", "Block deployment and notify security team", "Security"),
        new("Performance threshold exceeded", "Auto-scale infrastructure resources", "Infrastructure"),
        new("User signs up", "Send welcome email and create workspace", "Onboarding"),
    ];
}
