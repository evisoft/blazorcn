@* ============================================================
   Block: features-category-rail-detail-panel
   Title: FeaturesCategoryRailDetailPanel
   Description: A categorized sidebar rail feature section for React and Next.js with uppercase category headers grouping feature items and a detail panel showing a crosshair image placeholder with description and bullet list built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-category-rail-detail-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
  <div class="overflow-hidden rounded-2xl border bg-card">
    <div class="border-b px-6 py-8 sm:px-10 sm:py-10">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
        Full capability map
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Organized by area, detailed on demand
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground">
        Three categories, nine capabilities. Pick any item in the rail and the panel fills in
        with a description, a product view, and the exact things you get out of the box.
      </p>
    </div>

    <div class="grid lg:grid-cols-[240px_1fr]">
      @* Left — categorized rail *@
      <nav aria-label="Feature categories" class="border-b lg:border-b-0 lg:border-r">
        <div class="flex flex-col gap-6 p-5 lg:gap-7 lg:py-7">
          @foreach (var cat in _categories)
          {
            <div>
              <p class="mb-2 px-2 text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @cat.Label
              </p>
              <ul class="flex flex-col">
                @foreach (var item in cat.Items)
                {
                  var itm = item;
                  var isActive = itm.Id == _activeId;
                  <li>
                    <button
                      type="button"
                      aria-current="@(isActive ? "true" : null)"
                      @onclick="@(() => _activeId = itm.Id)"
                      class="@Cn.Merge(
                        "flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm transition-colors",
                        isActive
                          ? "bg-muted font-medium text-foreground"
                          : "text-muted-foreground hover:bg-muted/50 hover:text-foreground"
                      )"
                    >
                      <span
                        aria-hidden="true"
                        class="@Cn.Merge(
                          "size-1 rounded-full transition-colors",
                          isActive ? "bg-foreground" : "bg-muted-foreground/40"
                        )"
                      />
                      @itm.Title
                    </button>
                  </li>
                }
              </ul>
            </div>
          }
        </div>
      </nav>

      @* Right — detail panel with image placeholder *@
      <div class="p-6 sm:p-10" aria-live="polite">
        @{ var active = _allItems.FirstOrDefault(i => i.Id == _activeId) ?? _allItems[0]; }
        <div>
          @* Image placeholder *@
          <div class="flex aspect-[4/3] w-full items-center justify-center rounded-xl bg-muted sm:aspect-[16/9]">
            <div class="relative flex items-center justify-center">
              <div class="absolute size-24 rounded-full border border-muted-foreground/[0.06]" />
              <div class="absolute size-14 rounded-full border border-muted-foreground/[0.08]" />
              <div class="absolute h-px w-32 bg-muted-foreground/[0.06]" />
              <div class="absolute h-32 w-px bg-muted-foreground/[0.06]" />
              <div class="flex size-8 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
              </div>
            </div>
          </div>

          <h3 class="mt-6 text-xl font-semibold tracking-tight text-foreground sm:text-2xl">
            @active.Title
          </h3>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted-foreground">
            @active.Description
          </p>
          <ul class="mt-6 space-y-2">
            @foreach (var bullet in active.Bullets)
            {
              <li class="flex items-start gap-2.5 text-sm text-foreground">
                <span
                  aria-hidden="true"
                  class="mt-2 size-1 shrink-0 rounded-full bg-foreground"
                />
                <span class="leading-relaxed">@bullet</span>
              </li>
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

@code {
    private string _activeId = "workspaces";

    private record FeatureItem(string Id, string Title, string Description, string[] Bullets);
    private record Category(string Label, FeatureItem[] Items);

    private static readonly Category[] _categories =
    [
        new Category("Platform",
        [
            new FeatureItem("workspaces", "Isolated workspaces",
                "Give every team its own tenant with independent permissions, audit trails, and billing. Workspaces share infrastructure but never share data across the boundary.",
                ["Separate database schemas per workspace", "Cross-workspace sharing via signed links", "Per-workspace usage dashboards and quotas"]),
            new FeatureItem("automation", "Event-driven automation",
                "Trigger workflows on any field change, row insert, or external webhook. The visual rule builder compiles to typed server handlers with retries and dead-letter queues baked in.",
                ["Typed payloads validated with Zod schemas", "Retries with exponential backoff policies", "Dead-letter queue for replay and inspection"]),
            new FeatureItem("realtime-sync", "Real-time multiplayer sync",
                "Operational transforms keep collaborators in lockstep under forty milliseconds, with presence indicators, live cursors, and conflict-free merges handled automatically.",
                ["Sub-40ms latency across continents", "Presence avatars and live cursors", "Conflict-free replicated data types"]),
        ]),
        new Category("Security",
        [
            new FeatureItem("sso-scim", "SSO and SCIM provisioning",
                "SAML 2.0 and SCIM are available on every paid plan, not just enterprise. Connect to Okta, Azure AD, or any IdP in minutes with zero custom contracts.",
                ["SAML 2.0 on every paid plan", "SCIM user and group provisioning", "Just-in-time account creation"]),
            new FeatureItem("field-permissions", "Field-level access control",
                "Define who can read and write each field, row, or relationship with declarative policies. Policies inherit across records so you write each rule exactly once.",
                ["Declarative policy inheritance", "Row, column, and relationship scopes", "Policy simulator for dry runs"]),
            new FeatureItem("audit-logs", "Immutable audit logs",
                "Every read, write, and permission change is captured to an append-only log retained for seven years. Export to your SIEM or query inline via streaming SQL.",
                ["Seven-year retention by default", "Export to Splunk, Datadog, or S3", "Streaming SQL for inline analysis"]),
        ]),
        new Category("Developer tools",
        [
            new FeatureItem("typed-sdk", "Auto-generated typed SDK",
                "Every schema change regenerates a TypeScript client with typed methods, JSDoc comments, and Zod runtime validators. No manual bindings to drift from reality.",
                ["TypeScript client per workspace", "JSDoc on every generated method", "Zod validators for runtime safety"]),
            new FeatureItem("local-stack", "One-command local stack",
                "Spin up the full stack including database, queue, and search index with a single CLI command. Seed data loads from fixtures and resets on demand.",
                ["Docker-based local environment", "Fixture-driven seed data", "Reset and snapshot commands"]),
            new FeatureItem("webhooks", "Signed outbound webhooks",
                "Subscribe any endpoint to resource events with HMAC signatures, delivery retries, and a replay UI for investigating production issues without re-running jobs.",
                ["HMAC-SHA256 request signatures", "Delivery retry with idempotency keys", "Replay UI for production debugging"]),
        ]),
    ];

    private static readonly FeatureItem[] _allItems =
        _categories.SelectMany(c => c.Items).ToArray();
}
