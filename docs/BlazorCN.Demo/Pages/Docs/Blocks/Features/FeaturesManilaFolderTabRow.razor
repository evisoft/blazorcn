@* ============================================================
   Block: features-manila-folder-tab-row
   Title: FeaturesManilaFolderTabRow
   Description: A manila folder tab features section for React and Next.js with clickable folder tabs, active tab content panel, filed-under metadata tags, and paper file styling built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-manila-folder-tab-row.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div>
    @* Headline cluster *@
    <div class="text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-muted-foreground">
        <LucideIconCn Name="folder-open" Size="12" Class="size-3" aria-hidden="true" />
        Cabinet view
      </span>
      <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Every feature, neatly filed.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
        Flip between folder tabs to explore how contracts, records, and compliance stay
        organized in one legible archive.
      </p>
    </div>

    @* Folder cabinet *@
    <div class="mt-12">
      @* Tab row *@
      <div
        class="flex gap-1 overflow-x-auto pb-px scrollbar-none sm:gap-1.5"
        role="tablist"
        aria-label="Feature folders"
      >
        @foreach (var folder in _folders)
        {
          var f = folder;
          var isActive = f.Id == _activeId;
          <button
            type="button"
            role="tab"
            aria-selected="@isActive"
            @onclick="@(() => _activeId = f.Id)"
            class="@Cn.Merge(
              "relative flex shrink-0 items-center gap-1.5 rounded-t-md border border-b-0 px-3 py-2 text-xs font-medium transition-colors sm:px-4 sm:text-sm",
              isActive
                ? "z-10 border-border bg-card text-foreground"
                : "border-border/60 bg-muted text-muted-foreground hover:bg-muted/70"
            )"
          >
            <LucideIconCn Name="@f.IconName" Size="14" Class="size-3.5" aria-hidden="true" />
            <span>@f.Label</span>
          </button>
        }
        <div class="flex-1 border-b border-border" aria-hidden="true" />
      </div>

      @* Folder body *@
      @{
        var active = _folders.FirstOrDefault(f => f.Id == _activeId) ?? _folders[0];
      }
      <div class="relative -mt-px rounded-b-md rounded-tr-md border bg-card shadow-sm">
        @* Paper corner fold *@
        <div
          aria-hidden="true"
          class="absolute right-0 top-0 size-8 border-b border-l border-border/60 bg-muted/40"
          style="clip-path: polygon(100% 0, 0 0, 100% 100%)"
        />

        <div class="p-6 sm:p-8" aria-live="polite">
          @* Reference stamp *@
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="flex size-9 items-center justify-center rounded-md border bg-background">
                <LucideIconCn Name="@active.IconName" Size="16" Class="size-4 text-foreground" aria-hidden="true" />
              </span>
              <div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-muted-foreground">
                @active.Label · Folder
              </div>
            </div>
            <div class="flex items-center gap-1.5 rounded border border-dashed border-border/80 px-2 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-muted-foreground">
              <LucideIconCn Name="stamp" Size="10" Class="size-2.5" aria-hidden="true" />
              Ref. @active.Reference
            </div>
          </div>

          @* Title + description *@
          <h3 class="mt-5 text-lg font-semibold leading-tight text-foreground sm:text-xl">
            @active.Title
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            @active.Description
          </p>

          @* Filed under tags *@
          <div class="mt-5 flex flex-col gap-2 border-t border-dashed pt-4 sm:flex-row sm:items-center">
            <div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-muted-foreground">
              Filed under
            </div>
            <div class="flex flex-wrap gap-1.5">
              @foreach (var tag in active.Tags)
              {
                <span class="inline-flex items-center gap-1 rounded border bg-muted/50 px-2 py-0.5 text-[10px] font-medium text-muted-foreground">
                  <LucideIconCn Name="tag" Size="10" Class="size-2.5" aria-hidden="true" />
                  @tag
                </span>
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    @* CTAs *@
    <div class="mt-12 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <ButtonCn Class="w-full sm:w-[230px]">Open the cabinet</ButtonCn>
      <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[250px]">Browse all folders</ButtonCn>
    </div>
  </div>
</section>

@code {
    private string _activeId = "contracts";

    private record Folder(string Id, string IconName, string Label, string Title, string Description, string[] Tags, string Reference);

    private static readonly Folder[] _folders =
    [
        new Folder(
            "contracts",
            "briefcase",
            "Contracts",
            "Signature-ready templates",
            "Pull from a shared library of vetted contract templates — NDAs, MSAs, and SOWs — with merge fields that auto-populate from your workspace CRM.",
            ["Legal", "E-signature", "Merge fields"],
            "CX-014"
        ),
        new Folder(
            "records",
            "file-text",
            "Records",
            "Searchable document archive",
            "Full-text search across every file in your cabinet. OCR runs on scanned PDFs so even historical paperwork becomes instantly retrievable.",
            ["OCR", "Full-text", "Version history"],
            "RC-022"
        ),
        new Folder(
            "compliance",
            "scale",
            "Compliance",
            "Audit-ready retention",
            "Automatic retention schedules per document class, with legal hold, geo-fenced storage, and a signed export for regulators.",
            ["SOC 2", "HIPAA", "Retention"],
