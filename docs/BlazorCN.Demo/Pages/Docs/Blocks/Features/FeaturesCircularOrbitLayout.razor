@* ============================================================
   Block: features-circular-orbit-layout
   Title: FeaturesCircularOrbitLayout
   Description: A circular orbit feature layout for React and Next.js with a central brand hub and six feature nodes arranged in a 360 degree orbit built with shadcn/ui and Tailwind CSS
   Source: original/blocks/features/features-circular-orbit-layout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl border bg-card p-6 sm:p-10 lg:p-14">

        @* Headline *@
        <div class="mx-auto max-w-xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                One platform, six pillars
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                Features orbit your work
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:text-base">
                Every capability rotates around a single source of truth so your team never loses context switching between tools.
            </p>
        </div>

        @* Orbit container *@
        <div class="relative mx-auto mt-10 aspect-square w-full max-w-md sm:mt-12 sm:max-w-lg">

            @* Outer dashed guide ring *@
            <div
                aria-hidden="true"
                class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-dashed border-foreground/15"
                style="@($"width:{_orbitRadius * 2}%;height:{_orbitRadius * 2}%")">
            </div>

            @* Inner subtle ring *@
            <div
                aria-hidden="true"
                class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-foreground/5"
                style="@($"width:{_orbitRadius * 1.3}%;height:{_orbitRadius * 1.3}%")">
            </div>

            @* Central hub *@
            <div class="absolute left-1/2 top-1/2 flex size-24 -translate-x-1/2 -translate-y-1/2 flex-col items-center justify-center rounded-2xl border bg-background shadow-sm sm:size-32">
                <span class="flex size-10 items-center justify-center rounded-xl bg-foreground text-background sm:size-12">
                    <LucideIconCn Name="zap" Size="20" Class="size-5 sm:size-6" StrokeWidth="2" />
                </span>
                <p class="mt-2 text-[10px] font-semibold uppercase tracking-wider text-foreground sm:text-xs">
                    Core
                </p>
                <p class="text-[9px] text-muted-foreground sm:text-[10px]">Your work</p>
            </div>

            @* Orbit nodes *@
            @foreach (var node in _orbitNodes)
            {
                var pos = PolarToCartesian(node.Angle, _orbitRadius);
                <div
                    aria-label="@($"{node.Label} — {node.Sub}")"
                    class="absolute flex size-20 -translate-x-1/2 -translate-y-1/2 flex-col items-center justify-center gap-1 rounded-2xl border bg-background shadow-sm transition-colors hover:border-foreground/30 sm:size-24"
                    style="@($"left:{pos.X:F4}%;top:{pos.Y:F4}%")">
                    <span class="flex size-8 items-center justify-center rounded-lg bg-muted text-foreground sm:size-9">
                        <LucideIconCn Name="@node.IconName" Size="16" Class="size-4 sm:size-[18px]" StrokeWidth="2" />
                    </span>
                    <p class="text-[11px] font-semibold text-foreground sm:text-xs">@node.Label</p>
                    <p class="text-[9px] text-muted-foreground sm:text-[10px]">@node.Sub</p>
                </div>
            }

        </div>

        @* Tagline row *@
        <div class="mx-auto mt-10 grid max-w-xl grid-cols-3 gap-3 rounded-xl border bg-muted/30 p-4 sm:mt-12 sm:p-5">
            @foreach (var item in _tagline)
            {
                <div class="flex flex-col items-center text-center">
                    <p class="text-lg font-bold tabular-nums tracking-tight text-foreground sm:text-xl">
                        @item.Label
                    </p>
                    <p class="mt-0.5 text-[11px] text-muted-foreground sm:text-xs">@item.Caption</p>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private const double _orbitRadius = 38.0;

    private record OrbitNode(string Id, string IconName, string Label, string Sub, double Angle);
    private record TaglineStat(string Label, string Caption);
    private record CartesianPoint(double X, double Y);

    private static readonly OrbitNode[] _orbitNodes =
    [
        new("automate", "workflow",      "Automate",   "Workflows", 0),
        new("secure",   "shield-check",  "Secure",     "SOC 2",     60),
        new("notify",   "bell",          "Notify",     "Realtime",  120),
        new("accelerate","bolt",         "Accelerate", "Sub-50ms",  180),
        new("integrate","layers",        "Integrate",  "200+ apps", 240),
        new("refine",   "sparkles",      "Refine",     "AI polish", 300),
    ];

    private static readonly TaglineStat[] _tagline =
    [
        new("99.99%", "Platform uptime"),
        new("200+",   "Native integrations"),
        new("30s",    "Setup time"),
    ];

    private static CartesianPoint PolarToCartesian(double angleDeg, double radius)
    {
        // Angle measured from 12 o'clock, clockwise. radius is a percentage.
        var angleRad = (angleDeg - 90.0) * Math.PI / 180.0;
        var x = 50.0 + radius * Math.Cos(angleRad);
        var y = 50.0 + radius * Math.Sin(angleRad);
        return new CartesianPoint(x, y);
    }
}
