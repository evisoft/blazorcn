@* ============================================================
   Block: features-tab-swap-split-showcase
   Title: FeaturesTabSwapSplitShowcase
   Description: A centered tabs split showcase features section for React and Next.js with a PillTabs selector above a single large split card that swaps via AnimatePresence built with shadcn/ui PillTabs, Lucide React, and Tailwind CSS
   Source: original/blocks/features/features-tab-swap-split-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Section headline *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                What's inside
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                Three flagship capabilities, one prominent showcase
            </h2>
            <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                Pick a capability above to swap the split card below — each tab folds a full feature
                narrative into the same focused hero container.
            </p>
        </div>

        @* Tab selector *@
        <div class="mt-8 flex justify-center">
            <div class="inline-flex items-center gap-1 rounded-full border bg-muted p-1" role="tablist" aria-label="Select a flagship capability" id="features-tab-swap-split-showcase">
                @foreach (var tab in _tabs)
                {
                    var tabName = tab.Name;
                    <button role="tab"
                            aria-selected="@(_activeTab == tabName ? "true" : "false")"
                            class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-medium transition-colors", _activeTab == tabName ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _activeTab = tabName)">
                        @tab.Name
                    </button>
                }
            </div>
        </div>

        @* Split showcase card *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @{
                var active = _content[_activeTab];
            }
            <div class="grid lg:grid-cols-2">
                @* Text panel *@
                <div class="flex flex-col justify-center p-8 sm:p-10 lg:p-12">
                    <h3 class="text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
                        @active.Title
                    </h3>
                    <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                        @active.Description
                    </p>
                    <ul class="mt-6 space-y-3">
                        @foreach (var benefit in active.Benefits)
                        {
                            <li class="flex items-start gap-2.5">
                                <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-500" StrokeWidth="3" />
                                <span class="text-sm text-muted-foreground">@benefit</span>
                            </li>
                        }
                    </ul>
                </div>

                @* Image panel *@
                <div class="flex aspect-[4/3] items-center justify-center border-t bg-muted lg:aspect-auto lg:border-l lg:border-t-0">
                    <div aria-hidden="true" class="relative flex items-center justify-center">
                        <div class="absolute size-24 rounded-full border border-muted-foreground/[0.06]"></div>
                        <div class="absolute size-14 rounded-full border border-muted-foreground/[0.08]"></div>
                        <div class="absolute h-px w-32 bg-muted-foreground/[0.06]"></div>
                        <div class="absolute h-32 w-px bg-muted-foreground/[0.06]"></div>
                        <div class="flex size-8 items-center justify-center rounded-full border border-muted-foreground/[0.08] bg-background/60">
                            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _activeTab = "Workflow";

    private record TabItem(string Name);
    private record TabContent(string Title, string Description, string[] Benefits);

    private static readonly TabItem[] _tabs =
    [
        new("Workflow"),
        new("Analytics"),
        new("Security"),
    ];

    private static readonly Dictionary<string, TabContent> _content = new()
    {
        ["Workflow"] = new TabContent(
            "Ship work through stages without the meetings",
            "Kanban-style pipelines with automatic handoffs mean work never stalls waiting for someone to notice it. Every stage transition fires a webhook, a notification, and a status update so the next person already knows it's their turn.",
            [
                "Automatic stage transitions with webhooks",
                "Inline approval requests, no email chains",
                "SLA timers on every handoff boundary",
            ]
        ),
        ["Analytics"] = new TabContent(
            "Metrics the whole team can actually read",
            "A single dashboard maps product usage, funnel drop-off, and revenue impact on the same timeline. Charts default to weekly buckets, cohort comparisons stack on top, and any cell drills into the raw event stream that produced it.",
            [
                "Cohort comparisons on every chart",
                "Cell-level drill-down to raw events",
                "Weekly, monthly, and quarterly presets",
            ]
        ),
        ["Security"] = new TabContent(
            "Enterprise controls, on every plan tier",
            "SAML SSO, SCIM provisioning, audit logs, and role-based access are included in every paid plan with no enterprise surcharge. Sessions rotate every twelve hours, and exported audit logs stream directly to your SIEM of choice.",
            [
                "SAML 2.0 and SCIM included, not gated",
                "Audit log streaming to any SIEM endpoint",
                "Hardware-key gated admin operations",
            ]
        ),
    };
}
