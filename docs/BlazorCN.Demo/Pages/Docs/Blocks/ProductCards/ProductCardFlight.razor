@* ============================================================
   Block: product-card-flight
   Title: ProductCardFlight
   Description: Flight booking card with route display, flight times, layover info, and fare classes for React travel apps
   Source: original/blocks/product-cards/product-card-flight.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[380px] max-w-full">
        <CardCn Class="overflow-hidden">
            <CardContentCn Class="p-4">
                @* Airline header *@
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="flex h-8 w-8 items-center justify-center rounded-full border">
                            <LucideIconCn Name="plane" Size="16" Class="h-4 w-4 text-primary" />
                        </div>
                        <div>
                            <p class="text-sm font-medium">@_product.Airline</p>
                            <p class="text-xs text-muted-foreground">
                                @_product.FlightNumber • @_product.Aircraft
                            </p>
                        </div>
                    </div>
                    <BadgeCn Variant="@(_product.Stops == 0 ? BadgeVariant.Default : BadgeVariant.Secondary)">
                        @(_product.Stops == 0 ? "Nonstop" : $"{_product.Stops} stop")
                    </BadgeCn>
                </div>

                @* Flight route *@
                <div class="mt-4 flex items-center justify-between">
                    <div class="text-center">
                        <p class="text-2xl font-bold">@_product.DepartureTime</p>
                        <p class="font-semibold">@_product.DepartureCode</p>
                        <p class="text-xs text-muted-foreground">@_product.DepartureCity</p>
                    </div>

                    <div class="flex-1 px-4">
                        <div class="flex items-center justify-center gap-1 text-xs text-muted-foreground">
                            <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                            <span>@_product.Duration</span>
                        </div>
                        <div class="relative mt-1">
                            <div class="h-px bg-border"></div>
                            <LucideIconCn Name="plane" Size="16" Class="absolute top-1/2 left-1/2 h-4 w-4 -translate-x-1/2 -translate-y-1/2 rotate-90 text-primary" />
                        </div>
                        @if (_product.Stops > 0 && _product.StopCity != null)
                        {
                            <p class="mt-1 text-center text-xs text-muted-foreground">
                                via @_product.StopCity
                            </p>
                        }
                    </div>

                    <div class="text-center">
                        <p class="text-2xl font-bold">@_product.ArrivalTime</p>
                        <p class="font-semibold">@_product.ArrivalCode</p>
                        <p class="text-xs text-muted-foreground">@_product.ArrivalCity</p>
                    </div>
                </div>

                <SeparatorCn Class="my-4" />

                @* Fare selection *@
                <div>
                    <LabelCn Class="text-xs font-medium text-muted-foreground">SELECT FARE</LabelCn>
                    <div class="mt-2 space-y-2">
                        @foreach (var fareItem in _product.Fares)
                        {
                            var f = fareItem;
                            <label
                                class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-3 transition-colors hover:bg-muted/50", _selectedFare == f.Id ? "border-primary bg-muted/50" : "")"
                                for="@f.Id">
                                <div class="flex items-center gap-3">
                                    <input
                                        type="radio"
                                        id="@f.Id"
                                        name="fare-class"
                                        value="@f.Id"
                                        checked="@(_selectedFare == f.Id ? "checked" : null)"
                                        @onclick="@(() => _selectedFare = f.Id)"
                                        class="h-4 w-4 accent-primary" />
                                    <div>
                                        <p class="font-medium">@f.Name</p>
                                        <div class="mt-1 flex flex-wrap gap-2">
                                            @if (f.CarryOn)
                                            {
                                                <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                                    <LucideIconCn Name="briefcase" Size="12" Class="h-3 w-3" /> Carry-on
                                                </span>
                                            }
                                            @if (f.CheckedBag)
                                            {
                                                <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                                    <LucideIconCn Name="luggage" Size="12" Class="h-3 w-3" /> Checked bag
                                                </span>
                                            }
                                            @if (f.Refundable)
                                            {
                                                <span class="flex items-center gap-1 text-xs text-primary">
                                                    Refundable
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <p class="text-lg font-bold tabular-nums">$@f.Price</p>
                            </label>
                        }
                    </div>
                </div>

                @* Amenities *@
                <div class="mt-4 flex items-center gap-4 rounded-lg border p-2 text-xs text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="wifi" Size="12" Class="h-3 w-3" />
                        <span>Free WiFi</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="plane" Size="12" Class="h-3 w-3" />
                        <span>In-seat power</span>
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex items-center justify-between p-4 pt-0">
                <div>
                    <p class="text-xs text-muted-foreground">Total per person</p>
                    <p class="text-2xl font-bold tabular-nums">$@_currentFare.Price</p>
                </div>
                <ButtonCn>
                    <LucideIconCn Name="plane" Size="16" Class="mr-2 h-4 w-4" />
                    Select Flight
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record FareClass(
        string Id,
        string Name,
        int Price,
        bool CarryOn,
        bool CheckedBag,
        bool SeatSelection,
        bool Refundable);

    private record FlightProduct(
        string Airline,
        string FlightNumber,
        string DepartureCity,
        string DepartureCode,
        string DepartureTime,
        string ArrivalCity,
        string ArrivalCode,
        string ArrivalTime,
        string Duration,
        int Stops,
        string? StopCity,
        string Aircraft,
        FareClass[] Fares);

    private static readonly FlightProduct _product = new(
        "United Airlines",
        "UA 1542",
        "San Francisco",
        "SFO",
        "8:30 AM",
        "New York",
        "JFK",
        "5:15 PM",
        "5h 45m",
        0,
        null,
        "Boeing 737 MAX",
        [
            new("basic", "Basic Economy", 189, true, false, false, false),
            new("economy", "Economy", 249, true, true, true, false),
            new("business", "Business", 649, true, true, true, true),
        ]);

    private string _selectedFare = "economy";

    private FareClass _currentFare => Array.Find(_product.Fares, f => f.Id == _selectedFare) ?? _product.Fares[1];
}
