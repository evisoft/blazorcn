@* ============================================================
   Block: product-card-tv
   Title: ProductCardTv
   Description: Smart TV product card with screen size options and display technology specs for electronics stores
   Source: original/blocks/product-cards/product-card-tv.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[180px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="tv" Size="64" Class="size-16 text-muted-foreground/20" />
            <BadgeCn Class="absolute top-3 left-3">OLED</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="absolute top-3 right-3">
                2025 Model
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">LG</p>
            <h3 class="text-sm font-medium">C4 OLED evo 4K Smart TV</h3>
            <div class="mt-2 flex items-end justify-between">
                <p class="text-2xl font-semibold tabular-nums">$@_price.ToString("N0")</p>
                <p class="text-xs text-muted-foreground">Free delivery &amp; setup</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">SCREEN SIZE</p>
            <div class="grid grid-cols-4 gap-1.5">
                @foreach (var s in _sizes)
                {
                    var sz = s;
                    <button type="button"
                            class="@Cn.Merge("rounded-md border p-2 text-center transition-colors", _selectedSize == sz.Size ? "border-foreground bg-foreground text-background" : "hover:bg-muted/50")"
                            @onclick="@(() => SelectSize(sz.Size))">
                        <p class="text-xs font-medium">@sz.Size</p>
                        <p class="@Cn.Merge("text-xs", _selectedSize == sz.Size ? "text-background/70" : "text-muted-foreground")">
                            $@sz.Price.ToString("N0")
                        </p>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">DISPLAY</p>
            <div class="grid grid-cols-2 gap-x-4 gap-y-1.5">
                @foreach (var spec in _displaySpecs)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@spec.Label</span>
                        <span class="font-medium">@spec.Value</span>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-2">
                <div class="flex items-center gap-2 rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="monitor" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="text-xs font-medium">Gaming</p>
                        <p class="text-xs text-muted-foreground">VRR, ALLM</p>
                    </div>
                </div>
                <div class="flex items-center gap-2 rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="volume-2" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="text-xs font-medium">Audio</p>
                        <p class="text-xs text-muted-foreground">Dolby Atmos</p>
                    </div>
                </div>
                <div class="flex items-center gap-2 rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="wifi" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="text-xs font-medium">Wi-Fi</p>
                        <p class="text-xs text-muted-foreground">Wi-Fi 6E</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-1.5 text-xs font-medium text-muted-foreground">SMART PLATFORM</p>
            <div class="flex flex-wrap gap-1">
                @foreach (var feature in _smartFeatures)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@feature</BadgeCn>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TvSize(string Size, int Price);
    private record DisplaySpec(string Label, string Value);

    private static readonly TvSize[] _sizes =
    [
        new("55\"", 1299),
        new("65\"", 1799),
        new("75\"", 2499),
        new("83\"", 3499),
    ];

    private static readonly DisplaySpec[] _displaySpecs =
    [
        new("Panel",         "OLED Evo"),
        new("Resolution",    "4K (3840 x 2160)"),
        new("Refresh Rate",  "120Hz"),
        new("HDR",           "Dolby Vision, HDR10+"),
        new("Brightness",    "2,100 nits peak"),
        new("Response Time", "0.1ms"),
    ];

    private static readonly string[] _smartFeatures = ["AirPlay 2", "Google Cast", "Alexa", "HomeKit", "Bluetooth 5.2"];

    private string _selectedSize = "65\"";

    private int _price => _sizes.FirstOrDefault(s => s.Size == _selectedSize)?.Price ?? 1799;

    private void SelectSize(string size) => _selectedSize = size;
}
