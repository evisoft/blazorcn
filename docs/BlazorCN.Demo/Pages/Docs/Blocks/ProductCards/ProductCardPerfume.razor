@* ============================================================
   Block: product-card-perfume
   Title: ProductCardPerfume
   Description: Fragrance product card with scent pyramid notes and concentration options for beauty stores
   Source: original/blocks/product-cards/product-card-perfume.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[200px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Niche</BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Maison Lumière</p>
            <h3 class="text-sm font-medium">Oud Noir Absolu</h3>
            <p class="mt-1 text-xs text-muted-foreground italic">
                A dark, intoxicating blend of aged oud and smoky incense
            </p>
            <p class="mt-2 text-2xl font-semibold tabular-nums">$@_totalPrice</p>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">SCENT PYRAMID</p>
            <div class="space-y-2">
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="sparkles" Size="12" Class="mt-0.5 size-3 shrink-0 text-muted-foreground" />
                    <div>
                        <p class="text-xs text-muted-foreground">Top Notes</p>
                        <p class="text-xs font-medium">
                            Saffron &middot; Pink Pepper &middot; Bergamot
                        </p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="wind" Size="12" Class="mt-0.5 size-3 shrink-0 text-muted-foreground" />
                    <div>
                        <p class="text-xs text-muted-foreground">Heart Notes</p>
                        <p class="text-xs font-medium">
                            Oud Wood &middot; Bulgarian Rose &middot; Incense
                        </p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="clock" Size="12" Class="mt-0.5 size-3 shrink-0 text-muted-foreground" />
                    <div>
                        <p class="text-xs text-muted-foreground">Base Notes</p>
                        <p class="text-xs font-medium">
                            Amber &middot; Musk &middot; Sandalwood &middot; Vetiver
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">CONCENTRATION</p>
            <div class="grid grid-cols-3 gap-1.5">
                @foreach (var conc in _concentrations)
                {
                    var c = conc;
                    <button
                        type="button"
                        class="@Cn.Merge("rounded-md border p-2 text-center transition-colors", _selectedConcentration == c.Id ? "border-foreground bg-foreground/5" : "hover:bg-muted/50")"
                        @onclick="@(() => SelectConcentration(c.Id))">
                        <p class="text-xs font-medium">@c.ShortLabel</p>
                        <p class="text-xs text-muted-foreground">@c.Strength</p>
                    </button>
                }
            </div>
            @if (_activeConc != null)
            {
                <p class="mt-2 text-xs text-muted-foreground">Longevity: @_activeConc.Longevity</p>
            }
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">BOTTLE SIZE</p>
            <div class="flex gap-2">
                @foreach (var sz in _bottleSizes)
                {
                    var s = sz;
                    <button
                        type="button"
                        class="@Cn.Merge("flex-1 rounded-md border p-2 text-center transition-colors", _selectedSize == s.Id ? "border-foreground bg-foreground text-background" : "hover:bg-muted/50")"
                        @onclick="@(() => SelectSize(s.Id))">
                        <p class="text-xs font-medium">@s.Label</p>
                    </button>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record BottleSize(string Id, string Label, int Price);
    private record Concentration(string Id, string Label, string ShortLabel, string Strength, string Longevity);

    private static readonly BottleSize[] _bottleSizes =
    [
        new("30ml", "30ml", 95),
        new("50ml", "50ml", 145),
        new("100ml", "100ml", 215),
    ];

    private static readonly Concentration[] _concentrations =
    [
        new("edt", "Eau de Toilette", "Toilette", "5-8%", "4-6h"),
        new("edp", "Eau de Parfum", "Parfum", "15-20%", "8-12h"),
        new("parfum", "Parfum", "Parfum", "20-30%", "12-24h"),
    ];

    private string _selectedSize = "50ml";
    private string _selectedConcentration = "edp";

    private int _totalPrice => ComputePrice();

    private Concentration? _activeConc => Array.Find(_concentrations, c => c.Id == _selectedConcentration);

    private int ComputePrice()
    {
        var sizeItem = Array.Find(_bottleSizes, s => s.Id == _selectedSize);
        int sizePrice = sizeItem?.Price ?? 145;
        double multiplier = _selectedConcentration == "edt" ? 0.8 : _selectedConcentration == "parfum" ? 1.4 : 1.0;
        return (int)Math.Round(sizePrice * multiplier);
    }

    private void SelectSize(string id) => _selectedSize = id;
    private void SelectConcentration(string id) => _selectedConcentration = id;
}
