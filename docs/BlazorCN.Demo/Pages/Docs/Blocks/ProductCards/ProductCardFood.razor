@* ============================================================
   Block: product-card-food
   Title: ProductCardFood
   Description: Food delivery product card with nutrition info and customization for React food apps
   Source: original/blocks/product-cards/product-card-food.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <div class="absolute top-3 left-3 flex gap-1">
                    @if (_product.IsVegetarian)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary">
                            <LucideIconCn Name="leaf" Size="12" Class="mr-1 h-3 w-3" />
                            Vegetarian
                        </BadgeCn>
                    }
                    @if (_product.IsSpicy)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary">
                            <LucideIconCn Name="flame" Size="12" Class="mr-1 h-3 w-3" />
                            Spicy
                        </BadgeCn>
                    }
                </div>
            </div>

            <CardContentCn Class="p-4">
                <div class="flex items-start justify-between gap-2">
                    <h2 class="font-semibold">@_product.Name</h2>
                    <span class="text-lg font-bold tabular-nums">$@_product.Price.ToString("0.00")</span>
                </div>

                <p class="mt-1 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                @* Quick info *@
                <div class="mt-3 flex items-center gap-3 text-xs text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                        <span>@_product.PrepTime</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="flame" Size="12" Class="h-3 w-3" />
                        <span>@_product.Calories cal</span>
                    </div>
                </div>

                @* Nutrition *@
                <div class="mt-3 flex gap-3">
                    <div class="flex-1 rounded-md border p-2 text-center">
                        <p class="text-xs text-muted-foreground">Protein</p>
                        <p class="text-sm font-medium">@_product.Protein</p>
                    </div>
                    <div class="flex-1 rounded-md border p-2 text-center">
                        <p class="text-xs text-muted-foreground">Carbs</p>
                        <p class="text-sm font-medium">@_product.Carbs</p>
                    </div>
                    <div class="flex-1 rounded-md border p-2 text-center">
                        <p class="text-xs text-muted-foreground">Fat</p>
                        <p class="text-sm font-medium">@_product.Fat</p>
                    </div>
                </div>

                @* Add-ons *@
                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">ADD EXTRAS</p>
                    <div class="space-y-2">
                        @foreach (var addon in _product.Addons)
                        {
                            var addonItem = addon;
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <CheckboxCn
                                        Id="@addonItem.Id"
                                        Checked="@_selectedAddons.Contains(addonItem.Id)"
                                        CheckedChanged="@((bool v) => ToggleAddon(addonItem.Id))" />
                                    <label class="text-sm cursor-pointer" for="@addonItem.Id">
                                        @addonItem.Name
                                    </label>
                                </div>
                                <span class="text-sm text-muted-foreground tabular-nums">
                                    +$@addonItem.Price.ToString("0.00")
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideIconCn Name="plus" Size="16" Class="mr-2 h-4 w-4" />
                    Add to Order &mdash; $@TotalPrice.ToString("0.00")
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record Addon(string Id, string Name, double Price);

    private record Product(
        string Name,
        string Description,
        double Price,
        string Image,
        string PrepTime,
        int Calories,
        bool IsVegetarian,
        bool IsSpicy,
        string Protein,
        string Carbs,
        string Fat,
        Addon[] Addons
    );

    private static readonly Product _product = new(
        Name: "Grilled Salmon Bowl",
        Description: "Fresh Atlantic salmon with quinoa, avocado, edamame, and citrus ginger dressing.",
        Price: 16.99,
        Image: "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400&q=80",
        PrepTime: "15-20 min",
        Calories: 520,
        IsVegetarian: false,
        IsSpicy: false,
        Protein: "38g",
        Carbs: "42g",
        Fat: "18g",
        Addons:
        [
            new("extra-salmon", "Extra salmon", 4.99),
            new("extra-avocado", "Extra avocado", 2.49),
            new("spicy-mayo", "Spicy mayo", 0.99),
        ]
    );

    private List<string> _selectedAddons = [];

    private double TotalPrice =>
        _product.Price + _selectedAddons.Sum(id =>
            _product.Addons.FirstOrDefault(a => a.Id == id)?.Price ?? 0.0);

    private void ToggleAddon(string addonId)
    {
        if (_selectedAddons.Contains(addonId))
            _selectedAddons.Remove(addonId);
        else
            _selectedAddons.Add(addonId);
    }
}
