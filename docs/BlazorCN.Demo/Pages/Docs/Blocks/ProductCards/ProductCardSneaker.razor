@* ============================================================
   Block: product-card-sneaker
   Title: ProductCardSneaker
   Description: Limited edition sneaker product card with size selector and colorway options for ecommerce
   Source: original/blocks/product-cards/product-card-sneaker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[220px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Limited Edition</BadgeCn>
            <div class="absolute top-3 right-3 flex items-center gap-1 rounded-full bg-background/90 px-2 py-1">
                <LucideIconCn Name="star" Size="12" Class="size-3 fill-primary text-primary" />
                <span class="text-xs font-medium">4.9</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Jordan Brand</p>
            <h3 class="text-sm font-medium">Air Jordan 1 Retro High OG</h3>
            <p class="mt-1 text-xs text-muted-foreground">
                Style: 555088-063 &middot; Colorway: @_selectedColorway
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-end justify-between">
                <div>
                    <p class="text-xs text-muted-foreground">Retail Price</p>
                    <p class="text-2xl font-semibold tabular-nums">$180</p>
                </div>
                <div class="text-right">
                    <p class="text-xs text-muted-foreground">Resale Avg</p>
                    <p class="text-sm font-medium text-muted-foreground tabular-nums">$342</p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">COLORWAY</p>
            <div class="flex gap-2">
                @foreach (var cw in _colorways)
                {
                    var colorway = cw;
                    <button
                        type="button"
                        class="@Cn.Merge("flex size-8 items-center justify-center rounded-full border-2 transition-all", _selectedColorway == colorway.Name ? "border-foreground ring-2 ring-foreground/20" : "border-border")"
                        @onclick="@(() => _selectedColorway = colorway.Name)"
                        title="@colorway.Name">
                        <span
                            class="size-5 rounded-full"
                            style="@($"background: linear-gradient(135deg, {colorway.Primary} 50%, {colorway.Secondary} 50%)")">
                        </span>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">
                SIZE (US) &middot; <span class="text-foreground">@_selectedSize</span>
            </p>
            <div class="grid grid-cols-5 gap-1.5">
                @foreach (var sz in _sizes)
                {
                    var sizeItem = sz;
                    <button
                        type="button"
                        disabled="@(!sizeItem.Available)"
                        class="@Cn.Merge("rounded-md border px-2 py-1.5 text-xs font-medium transition-colors", _selectedSize == sizeItem.Size ? "border-foreground bg-foreground text-background" : sizeItem.Available ? "hover:bg-muted/50" : "cursor-not-allowed text-muted-foreground/40 line-through")"
                        @onclick="@(() => { if (sizeItem.Available) _selectedSize = sizeItem.Size; })">
                        @sizeItem.Size
                    </button>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SizeOption(string Size, bool Available);
    private record Colorway(string Name, string Primary, string Secondary);

    private static readonly SizeOption[] _sizes =
    [
        new("7", true),
        new("7.5", true),
        new("8", true),
        new("8.5", false),
        new("9", true),
        new("9.5", true),
        new("10", true),
        new("10.5", false),
        new("11", true),
        new("12", true),
    ];

    private static readonly Colorway[] _colorways =
    [
        new("Bred", "#dc2626", "#000000"),
        new("Royal", "#2563eb", "#000000"),
        new("Shadow", "#6b7280", "#000000"),
    ];

    private string _selectedSize = "9";
    private string _selectedColorway = "Bred";
}
