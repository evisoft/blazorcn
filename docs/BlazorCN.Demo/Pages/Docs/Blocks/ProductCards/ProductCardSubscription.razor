@* ============================================================
   Block: product-card-subscription
   Title: ProductCardSubscription
   Description: Subscription box product card with items preview and billing options for React ecommerce
   Source: original/blocks/product-cards/product-card-subscription.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <BadgeCn Class="absolute top-3 left-3">
                    <LucideIconCn Name="gift" Size="12" Class="mr-1 h-3 w-3" />
                    Subscription
                </BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h2 class="font-semibold">@_product.Name</h2>
                <p class="mt-1 text-sm text-muted-foreground">@_product.Description</p>

                <div class="mt-3 flex items-center gap-1 text-xs text-muted-foreground">
                    <LucideIconCn Name="users" Size="12" Class="h-3 w-3" />
                    <span>@_product.SubscriberCount.ToString("N0") subscribers</span>
                </div>

                <div class="mt-4">
                    <p class="mb-1.5 text-xs font-medium text-muted-foreground">WHAT'S INCLUDED</p>
                    <div class="space-y-1">
                        @foreach (var item in _product.ItemsIncluded)
                        {
                            <div class="flex items-start gap-1.5 text-xs">
                                <LucideIconCn Name="check" Size="12" Class="mt-0.5 h-3 w-3 shrink-0 text-primary" />
                                <span>@item</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">BILLING FREQUENCY</p>
                    <div class="grid grid-cols-3 gap-1">
                        @foreach (var opt in _product.BillingOptions)
                        {
                            var option = opt;
                            <button
                                class="@Cn.Merge("flex flex-col items-center h-auto py-2 text-xs rounded-md border transition-colors hover:bg-accent hover:text-accent-foreground", _selectedBilling == option.Id ? "border-foreground bg-foreground text-background" : "border-input bg-background text-foreground")"
                                @onclick="@(() => _selectedBilling = option.Id)">
                                <span>@option.Label</span>
                                @if (option.Savings != null)
                                {
                                    <span class="text-[10px] text-primary">@option.Savings</span>
                                }
                            </button>
                        }
                    </div>
                </div>

                <div class="mt-4 flex items-baseline justify-between">
                    <div>
                        <span class="text-2xl font-bold tabular-nums">$@_currentOption.Price</span>
                        <span class="text-sm text-muted-foreground">/@(_selectedBilling == "monthly" ? "mo" : _selectedBilling == "quarterly" ? "3mo" : "yr")</span>
                    </div>
                    @if (_currentOption.Savings != null)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary">@_currentOption.Savings</BadgeCn>
                    }
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideIconCn Name="box" Size="16" Class="mr-2 h-4 w-4" />
                    Subscribe Now
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record BillingOption(string Id, string Label, int Price, string? Savings = null);

    private record SubscriptionProduct(
        string Name,
        string Description,
        string Image,
        int SubscriberCount,
        string[] ItemsIncluded,
        BillingOption[] BillingOptions);

    private static readonly SubscriptionProduct _product = new(
        Name: "Artisan Coffee Box",
        Description: "Curated specialty coffees from around the world, delivered fresh to your door.",
        Image: "https://images.unsplash.com/photo-1559056199-641a0ac8b55e?w=400&q=80",
        SubscriberCount: 12500,
        ItemsIncluded:
        [
            "3 bags of specialty coffee (12oz each)",
            "Tasting notes & brewing guide",
            "Exclusive member discounts",
            "Free shipping always",
        ],
        BillingOptions:
        [
            new("monthly", "Monthly", 39),
            new("quarterly", "3 Months", 99, "Save 15%"),
            new("annual", "Annual", 349, "Save 25%"),
        ]
    );

    private string _selectedBilling = "monthly";

    private BillingOption _currentOption =>
        _product.BillingOptions.FirstOrDefault(o => o.Id == _selectedBilling) ?? _product.BillingOptions[0];
}
