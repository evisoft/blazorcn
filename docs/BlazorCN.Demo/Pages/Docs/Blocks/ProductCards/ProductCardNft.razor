@* ============================================================
   Block: product-card-nft
   Title: ProductCardNft
   Description: NFT artwork product card with blockchain details, ownership history, and bidding for marketplaces
   Source: original/blocks/product-cards/product-card-nft.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex aspect-square max-h-[260px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <div class="absolute top-3 left-3 flex gap-1">
                <BadgeCn>ERC-721</BadgeCn>
            </div>
            <div class="absolute top-3 right-3">
                <BadgeCn Variant="BadgeVariant.Secondary">#4,287</BadgeCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="size-5 rounded-full bg-muted"></div>
                <p class="text-xs font-medium text-muted-foreground">Neon Collective</p>
                <LucideIconCn Name="shield" Size="12" Class="size-3 text-primary" />
            </div>
            <h3 class="mt-1 text-sm font-medium">Ethereal Fragment #4287</h3>
            <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                <span>Ethereum</span>
                <span>&middot;</span>
                <span>Rarity Rank: #142 / 10,000</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex gap-4">
                <div>
                    <p class="text-xs text-muted-foreground">Current Price</p>
                    <p class="text-2xl font-semibold tabular-nums">2.4 ETH</p>
                    <p class="text-xs text-muted-foreground tabular-nums">~$7,824</p>
                </div>
                <div class="text-right">
                    <p class="text-xs text-muted-foreground">Highest Bid</p>
                    <p class="text-sm font-medium tabular-nums">2.1 ETH</p>
                    <div class="flex items-center gap-1 text-xs text-emerald-600">
                        <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                        <span>+34% floor</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">TRAITS</p>
            <div class="grid grid-cols-2 gap-1.5">
                @foreach (var trait in _traits)
                {
                    <div class="rounded-md bg-muted/50 p-2">
                        <p class="text-xs text-muted-foreground">@trait.Type</p>
                        <p class="text-xs font-medium">@trait.Value</p>
                        <p class="text-xs text-muted-foreground">@trait.Rarity have this</p>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">ACTIVITY</p>
            <div class="space-y-1.5">
                @foreach (var h in _history)
                {
                    <div class="flex items-center justify-between text-xs">
                        <div class="flex items-center gap-2">
                            <span class="font-medium">@h.Event</span>
                            <span class="flex items-center gap-1 font-mono text-muted-foreground">
                                <LucideIconCn Name="user" Size="10" Class="size-2.5" />
                                @h.From
                            </span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-medium tabular-nums">@h.Price</span>
                            <span class="text-muted-foreground">@h.Time</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="flex gap-2 px-4 py-3">
            <ButtonCn Class="flex-1">Buy Now</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1">Place Bid</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="shrink-0" aria-label="Open in new tab">
                <LucideIconCn Name="external-link" Size="16" Class="size-4" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Trait(string Type, string Value, string Rarity);
    private record HistoryEntry(string Event, string From, string Price, string Time);

    private static readonly Trait[] _traits =
    [
        new("Background", "Cosmic Purple", "8%"),
        new("Body", "Holographic", "3%"),
        new("Eyes", "Laser Red", "5%"),
        new("Accessory", "Crown", "2%"),
    ];

    private static readonly HistoryEntry[] _history =
    [
        new("Listed", "0x7a3...f82d", "2.4 ETH", "2 hours ago"),
        new("Transfer", "0x9c1...a47e", "--", "3 days ago"),
        new("Sale", "0x5b8...d91c", "1.8 ETH", "2 weeks ago"),
    ];
}
