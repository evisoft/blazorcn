@* ============================================================
   Block: product-card-phone
   Title: ProductCardPhone
   Description: Smartphone product card with color and storage options for electronics stores
   Source: original/blocks/product-cards/product-card-phone.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[220px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="smartphone" Size="64" Class="size-16 text-muted-foreground/20" />
            <BadgeCn Class="absolute top-3 left-3">New</BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Apple</p>
            <h3 class="text-sm font-medium">iPhone 16 Pro Max</h3>
            <div class="mt-2 flex items-end justify-between">
                <div>
                    <p class="text-2xl font-semibold tabular-nums">$@_price</p>
                    <p class="text-xs text-muted-foreground">
                        or $@((int)Math.Ceiling(_price / 24.0))/mo for 24 mo
                    </p>
                </div>
                <div class="text-right">
                    <p class="text-xs text-muted-foreground">Trade-in value</p>
                    <p class="text-xs font-medium text-emerald-600">Up to $620 credit</p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">
                COLOR &middot; <span class="text-foreground">@_selectedColor</span>
            </p>
            <div class="flex gap-2">
                @foreach (var c in _colors)
                {
                    var color = c;
                    <button
                        type="button"
                        class="@Cn.Merge("size-8 rounded-full border-2 transition-all", _selectedColor == color.Name ? "border-foreground ring-2 ring-foreground/20" : "border-border")"
                        style="@($"background-color:{color.Value}")"
                        @onclick="@(() => SelectColor(color.Name))"
                        title="@color.Name">
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">STORAGE</p>
            <div class="grid grid-cols-4 gap-1.5">
                @foreach (var opt in _storageOptions)
                {
                    var storage = opt;
                    <button
                        type="button"
                        class="@Cn.Merge("rounded-md border p-2 text-center transition-colors", _selectedStorage == storage.Size ? "border-foreground bg-foreground text-background" : "hover:bg-muted/50")"
                        @onclick="@(() => SelectStorage(storage.Size))">
                        <p class="text-xs font-medium">@storage.Size</p>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-2 gap-x-4 gap-y-1.5">
                @foreach (var spec in _keySpecs)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@spec.Label</span>
                        <span class="font-medium">@spec.Value</span>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-1.5 text-xs font-medium text-muted-foreground">CARRIER COMPATIBLE</p>
            <div class="flex gap-2">
                @foreach (var carrier in _carriers)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@carrier</BadgeCn>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ColorOption(string Name, string Value);
    private record StorageOption(string Size, int Price);
    private record KeySpec(string Label, string Value);

    private static readonly ColorOption[] _colors =
    [
        new("Titanium Black", "#1c1c1e"),
        new("Titanium Natural", "#b8b4a8"),
        new("Titanium Blue", "#394867"),
        new("Titanium White", "#f5f5f0"),
    ];

    private static readonly StorageOption[] _storageOptions =
    [
        new("128GB", 999),
        new("256GB", 1099),
        new("512GB", 1299),
        new("1TB", 1499),
    ];

    private static readonly KeySpec[] _keySpecs =
    [
        new("Display", "6.7\" OLED 120Hz"),
        new("Chip", "A18 Pro"),
        new("Camera", "48MP Triple"),
        new("Battery", "All-day (29h)"),
    ];

    private static readonly string[] _carriers = ["AT&T", "T-Mobile", "Verizon", "Unlocked"];

    private string _selectedColor = "Titanium Black";
    private string _selectedStorage = "256GB";

    private int _price => _storageOptions
        .FirstOrDefault(s => s.Size == _selectedStorage)?.Price ?? 999;

    private void SelectColor(string name) => _selectedColor = name;
    private void SelectStorage(string size) => _selectedStorage = size;
}
