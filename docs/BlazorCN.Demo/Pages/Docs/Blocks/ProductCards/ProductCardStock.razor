@* ============================================================
   Block: product-card-stock
   Title: ProductCardStock
   Description: Stock investment card with price chart, key metrics, and trade buttons for React finance apps
   Source: original/blocks/product-cards/product-card-stock.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[340px] max-w-full">
        <CardCn Class="overflow-hidden">
            <CardContentCn Class="p-4">
                @* Header *@
                <div class="flex items-start justify-between">
                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-lg border">
                            <LucideIconCn Name="building-2" Size="20" Class="h-5 w-5 text-muted-foreground" />
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-bold">@_product.Ticker</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@_ratingColor">
                                    @_product.AnalystRating
                                </BadgeCn>
                            </div>
                            <p class="text-sm text-muted-foreground">@_product.Name</p>
                        </div>
                    </div>
                    <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" OnClick="@(() => _isWatched = !_isWatched)">
                        <LucideIconCn Name="star" Size="16" Class="@Cn.Merge("h-4 w-4", _isWatched ? "fill-primary text-primary" : "")" />
                    </ButtonCn>
                </div>

                @* Price *@
                <div class="mt-4 flex items-baseline justify-between">
                    <span class="text-3xl font-bold tabular-nums">$@_product.Price.ToString("0.00")</span>
                    <div class="@Cn.Merge("flex items-center gap-1", _isPositive ? "text-primary" : "text-destructive")">
                        @if (_isPositive)
                        {
                            <LucideIconCn Name="arrow-up" Size="16" Class="h-4 w-4" />
                        }
                        else
                        {
                            <LucideIconCn Name="arrow-down" Size="16" Class="h-4 w-4" />
                        }
                        <span class="font-medium tabular-nums">
                            $@Math.Abs(_product.Change).ToString("0.00") (@Math.Abs(_product.ChangePercent).ToString("0.00")%)
                        </span>
                    </div>
                </div>

                @* Sparkline chart *@
                <div class="mt-4">
                    <TabsCn Value="@_timeframe" ValueChanged="@((string v) => _timeframe = v)">
                        <TabsListCn Class="grid w-full grid-cols-5">
                            <TabsTriggerCn Value="1D" Class="text-xs">1D</TabsTriggerCn>
                            <TabsTriggerCn Value="1W" Class="text-xs">1W</TabsTriggerCn>
                            <TabsTriggerCn Value="1M" Class="text-xs">1M</TabsTriggerCn>
                            <TabsTriggerCn Value="1Y" Class="text-xs">1Y</TabsTriggerCn>
                            <TabsTriggerCn Value="ALL" Class="text-xs">ALL</TabsTriggerCn>
                        </TabsListCn>
                    </TabsCn>

                    <div class="mt-3 flex h-10 items-center justify-center">
                        <svg aria-label="Price chart" class="overflow-visible" height="32" role="img" width="120">
                            <path class="@(_isPositive ? "text-primary" : "text-destructive")"
                                  d="@GenerateSparkline()"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.5" />
                        </svg>
                    </div>
                </div>

                @* Key metrics *@
                <div class="mt-4 grid grid-cols-3 gap-3 text-center">
                    <div class="rounded-lg border p-2">
                        <p class="text-xs text-muted-foreground">Market Cap</p>
                        <p class="font-semibold">@_product.MarketCap</p>
                    </div>
                    <div class="rounded-lg border p-2">
                        <p class="text-xs text-muted-foreground">P/E Ratio</p>
                        <p class="font-semibold tabular-nums">@_product.PeRatio</p>
                    </div>
                    <div class="rounded-lg border p-2">
                        <p class="text-xs text-muted-foreground">Volume</p>
                        <p class="font-semibold">@_product.Volume</p>
                    </div>
                </div>

                @* 52-week range *@
                <div class="mt-4">
                    <div class="flex items-center justify-between text-xs text-muted-foreground">
                        <span>52W Low: $@_product.Low52w</span>
                        <span>52W High: $@_product.High52w</span>
                    </div>
                    <div class="relative mt-1 h-2 rounded-full bg-muted">
                        <div class="absolute top-1/2 h-3 w-3 -translate-y-1/2 rounded-full border-2 border-primary bg-background"
                             style="@($"left: calc({_price52wPosition}% - 6px)")" />
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="gap-2 p-4 pt-0">
                <ButtonCn Class="flex-1">
                    <LucideIconCn Name="trending-up" Size="16" Class="mr-2 h-4 w-4" />
                    Buy
                </ButtonCn>
                <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline">
                    <LucideIconCn Name="bar-chart-3" Size="16" Class="mr-2 h-4 w-4" />
                    Sell
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record StockProduct(
        string Ticker,
        string Name,
        double Price,
        double Change,
        double ChangePercent,
        string MarketCap,
        double PeRatio,
        string Volume,
        double High52w,
        double Low52w,
        string AnalystRating,
        double[] Sparkline);

    private static readonly StockProduct _product = new(
        Ticker: "AAPL",
        Name: "Apple Inc.",
        Price: 178.52,
        Change: 3.24,
        ChangePercent: 1.85,
        MarketCap: "$2.8T",
        PeRatio: 28.4,
        Volume: "52.3M",
        High52w: 198.23,
        Low52w: 124.17,
        AnalystRating: "Buy",
        Sparkline: [165, 168, 172, 169, 175, 173, 178, 176, 180, 178, 182, 179]);

    private string _timeframe = "1D";
    private bool _isWatched = false;

    private bool _isPositive => _product.Change >= 0;

    private string _ratingColor => _product.AnalystRating switch
    {
        "Strong Buy" => "text-primary",
        "Buy" => "text-primary",
        "Hold" => "text-muted-foreground",
        "Sell" => "text-destructive",
        "Strong Sell" => "text-destructive",
        _ => ""
    };

    private double _price52wPosition =>
        (_product.Price - _product.Low52w) / (_product.High52w - _product.Low52w) * 100;

    private string GenerateSparkline()
    {
        var data = _product.Sparkline;
        var min = data.Min();
        var max = data.Max();
        var range = max - min > 0 ? max - min : 1;
        const int width = 120;
        const int height = 32;
        var points = data.Select((val, i) =>
        {
            var x = (i / (double)(data.Length - 1)) * width;
            var y = height - ((val - min) / range) * height;
            return $"{x},{y}";
        });
        return $"M{string.Join(" L", points)}";
    }
}
