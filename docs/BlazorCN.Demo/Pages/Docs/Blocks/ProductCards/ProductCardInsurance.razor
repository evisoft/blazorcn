@* ============================================================
   Block: product-card-insurance
   Title: ProductCardInsurance
   Description: Insurance plan card with coverage details, deductible options, and premium calculator for React insurance sites
   Source: original/blocks/product-cards/product-card-insurance.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            @* Header *@
            <div class="flex items-center justify-between border-b p-4">
                <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-full border">
                        <LucideIconCn Name="shield" Size="20" Class="h-5 w-5 text-primary" />
                    </div>
                    <div>
                        <h2 class="font-semibold">@_product.Name</h2>
                        <BadgeCn Class="@_tierColor">@_product.Tier</BadgeCn>
                    </div>
                </div>
            </div>

            <CardContentCn Class="p-4">
                <p class="text-sm text-muted-foreground">@_product.Description</p>

                @* Deductible selector *@
                <div class="mt-4">
                    <LabelCn Class="text-xs font-medium text-muted-foreground">ANNUAL DEDUCTIBLE</LabelCn>
                    <SelectCn @bind-Value="_selectedDeductible" Class="mt-1.5">
                        <SelectTriggerCn aria-label="Annual deductible">
                            <SelectValueCn Placeholder="Select deductible" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var option in _product.Deductibles)
                            {
                                var val = option.Amount.ToString();
                                <SelectItemCn Value="@val">
                                    $@(option.Amount.ToString("N0")) deductible
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>

                @* Coverage list *@
                <div class="mt-4">
                    <div class="mb-2 flex items-center justify-between">
                        <LabelCn Class="text-xs font-medium text-muted-foreground">COVERAGE</LabelCn>
                        <span class="text-xs text-muted-foreground">Max: @_product.MaxCoverage</span>
                    </div>
                    <div class="space-y-2">
                        @foreach (var coverage in _product.Coverages)
                        {
                            <div class="flex items-center justify-between text-sm">
                                <div class="flex items-center gap-2">
                                    @if (coverage.Included)
                                    {
                                        <LucideIconCn Name="check" Size="16" Class="h-4 w-4 text-primary" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="x" Size="16" Class="h-4 w-4 text-muted-foreground" />
                                    }
                                    <span class="@(coverage.Included ? "" : "text-muted-foreground")">@coverage.Name</span>
                                </div>
                                @if (!string.IsNullOrEmpty(coverage.Limit) && coverage.Included)
                                {
                                    <span class="text-xs text-muted-foreground">@coverage.Limit</span>
                                }
                            </div>
                        }
                    </div>
                </div>

                @* Premium display *@
                <div class="mt-4 rounded-lg border p-3">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs text-muted-foreground">Estimated Monthly Premium</p>
                            <p class="text-2xl font-bold tabular-nums">$@CurrentOption.Premium</p>
                        </div>
                        <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Help">
                            <LucideIconCn Name="help-circle" Size="16" Class="h-4 w-4" />
                        </ButtonCn>
                    </div>
                    <p class="mt-1 text-xs text-muted-foreground">
                        With $@(CurrentOption.Amount.ToString("N0")) deductible
                    </p>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full">Get Quote</ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">Compare Plans</ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record DeductibleOption(int Amount, int Premium);
    private record Coverage(string Name, bool Included, string? Limit = null);
    private record Product(
        string Name,
        string Tier,
        string Description,
        DeductibleOption[] Deductibles,
        Coverage[] Coverages,
        string MaxCoverage
    );

    private static readonly Product _product = new(
        Name: "Health Plus Plan",
        Tier: "Gold",
        Description: "Comprehensive coverage for individuals and families with low out-of-pocket costs.",
        Deductibles:
        [
            new(500, 450),
            new(1000, 350),
            new(2500, 250),
        ],
        Coverages:
        [
            new("Doctor visits", true, "Unlimited"),
            new("Hospital stays", true, "100% after deductible"),
            new("Prescription drugs", true, "$5k/year"),
            new("Mental health", true),
            new("Dental & Vision", false),
            new("International coverage", false),
        ],
        MaxCoverage: "$2,000,000"
    );

    private string _selectedDeductible = "1000";

    private string _tierColor => _product.Tier switch
    {
        "Bronze" => "bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-200",
        "Silver" => "bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200",
        "Gold" => "bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200",
        "Platinum" => "bg-violet-100 text-violet-800 dark:bg-violet-900 dark:text-violet-200",
        _ => ""
    };

    private DeductibleOption CurrentOption =>
        Array.Find(_product.Deductibles, d => d.Amount.ToString() == _selectedDeductible)
        ?? _product.Deductibles[1];
}
