@* ============================================================
   Block: product-card-pet
   Title: ProductCardPet
   Description: Pet product card with pet type filters and weight-based sizing for React pet stores
   Source: original/blocks/product-cards/product-card-pet.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <div class="absolute top-3 left-3 flex gap-1">
                    @foreach (var petType in _product.PetTypes)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary">@petType</BadgeCn>
                    }
                </div>
                <button
                    type="button"
                    class="absolute top-3 right-3 flex h-8 w-8 items-center justify-center rounded-full bg-background/90"
                    aria-label="Save to favorites" @onclick="@(() => _isFavorite = !_isFavorite)">
                    <LucideIconCn Name="heart" Size="16" Class="@Cn.Merge("h-4 w-4", _isFavorite ? "fill-primary text-primary" : "")" />
                </button>
            </div>

            <CardContentCn Class="p-4">
                <p class="text-xs font-medium text-muted-foreground">@_product.Brand</p>
                <h2 class="font-semibold leading-tight">@_product.Name</h2>

                <p class="mt-2 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                @* Benefits *@
                <div class="mt-3 grid grid-cols-2 gap-1">
                    @foreach (var benefit in _product.Benefits)
                    {
                        <div class="flex items-center gap-1.5 text-xs">
                            <LucideIconCn Name="check" Size="12" Class="h-3 w-3 text-primary" />
                            <span>@benefit</span>
                        </div>
                    }
                </div>

                @* Size selector *@
                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">SELECT SIZE</p>
                    <div class="grid grid-cols-3 gap-1">
                        @foreach (var size in _product.Sizes)
                        {
                            var sizeItem = size;
                            <button
                                type="button"
                                class="@Cn.Merge("flex flex-col h-auto py-2 text-xs items-center justify-center rounded-md border border-input bg-transparent hover:bg-accent hover:text-accent-foreground", _selectedSize == sizeItem.Id ? "bg-accent text-accent-foreground border-primary" : "")"
                                @onclick="@(() => _selectedSize = sizeItem.Id)">
                                <span class="font-medium">@sizeItem.Weight</span>
                                <span class="text-muted-foreground">$@sizeItem.Price</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="mt-4 flex items-baseline justify-between">
                    <span class="text-2xl font-bold tabular-nums">$@CurrentSize.Price.ToString("0.00")</span>
                    <span class="text-sm text-muted-foreground">@CurrentSize.Weight bag</span>
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 h-4 w-4" />
                    Add to Cart
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record SizeOption(string Id, string Weight, double Price);

    private record Product(
        string Name,
        string Brand,
        string Description,
        string Image,
        double Rating,
        string[] PetTypes,
        string[] Benefits,
        SizeOption[] Sizes
    );

    private static readonly Product _product = new(
        Name: "Premium Grain-Free Kibble",
        Brand: "Healthy Paws",
        Description: "High-protein formula with real chicken as the first ingredient. Supports healthy digestion and shiny coat.",
        Image: "https://images.unsplash.com/photo-1589924691995-400dc9ecc119?w=400&q=80",
        Rating: 4.8,
        PetTypes: ["Dogs"],
        Benefits: ["Grain-free formula", "Real chicken #1", "Omega fatty acids", "No artificial colors"],
        Sizes:
        [
            new("small", "5 lb", 24.99),
            new("medium", "15 lb", 54.99),
            new("large", "30 lb", 89.99),
        ]
    );

    private string _selectedSize = "medium";
    private bool _isFavorite = false;

    private SizeOption CurrentSize => Array.Find(_product.Sizes, s => s.Id == _selectedSize) ?? _product.Sizes[1];
}
