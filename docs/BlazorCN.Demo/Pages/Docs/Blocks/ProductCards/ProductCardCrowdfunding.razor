@* ============================================================
   Block: product-card-crowdfunding
   Title: ProductCardCrowdfunding
   Description: Crowdfunding project card with funding progress and reward tiers for React platforms
   Source: original/blocks/product-cards/product-card-crowdfunding.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[700px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="grid md:grid-cols-[280px_1fr]">
                <div class="relative h-[200px] md:h-full">
                    <img
                        alt="@_product.Name"
                        class="h-full w-full object-cover"
                        height="400"
                        src="@_product.Image"
                        width="400" />
                    <BadgeCn Class="absolute top-3 left-3">@_product.Category</BadgeCn>
                    @if (_isFullyFunded)
                    {
                        <BadgeCn Class="absolute top-3 right-3" Variant="BadgeVariant.Secondary">
                            <LucideIconCn Name="heart" Size="12" Class="mr-1 h-3 w-3 fill-current" />
                            Funded
                        </BadgeCn>
                    }
                </div>

                <CardContentCn Class="p-5">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <h3 class="text-lg font-semibold">@_product.Name</h3>
                            <p class="text-sm text-muted-foreground">by @_product.Creator</p>
                        </div>
                    </div>

                    <p class="mt-2 text-sm text-muted-foreground line-clamp-2">
                        @_product.Description
                    </p>

                    @* Funding progress *@
                    <div class="mt-4">
                        <div class="flex items-baseline justify-between">
                            <span class="text-2xl font-bold tabular-nums">
                                $@_product.RaisedAmount.ToString("N0")
                            </span>
                            <span class="text-sm text-muted-foreground">
                                of $@_product.GoalAmount.ToString("N0") goal
                            </span>
                        </div>
                        <ProgressCn Class="mt-2 h-2" Value="@(Math.Min(_fundingPercent, 100))" />
                        <div class="mt-2 flex items-center justify-between text-sm">
                            <span class="font-medium text-primary">@_fundingPercent% funded</span>
                            <div class="flex items-center gap-4 text-muted-foreground">
                                <div class="flex items-center gap-1">
                                    <LucideIconCn Name="users" Size="12" Class="h-3 w-3" />
                                    <span>@_product.BackersCount</span>
                                </div>
                                <div class="flex items-center gap-1">
                                    <LucideIconCn Name="calendar" Size="12" Class="h-3 w-3" />
                                    <span>@_product.DaysLeft days left</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Reward tiers preview *@
                    <div class="mt-4">
                        <p class="mb-2 text-xs font-medium text-muted-foreground">POPULAR REWARDS</p>
                        <div class="space-y-2">
                            @foreach (var reward in _product.Rewards)
                            {
                                <div class="flex items-center justify-between rounded-lg border p-2">
                                    <div class="flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="text-sm font-medium">@reward.Name</span>
                                            @if (reward.Limit.HasValue)
                                            {
                                                <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">
                                                    @(reward.Limit.Value - reward.Backers) left
                                                </BadgeCn>
                                            }
                                        </div>
                                        <p class="text-xs text-muted-foreground">@reward.Description</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="font-semibold tabular-nums">$@reward.Amount</p>
                                        <p class="text-xs text-muted-foreground">@reward.Backers backers</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mt-4 flex gap-2">
                        <ButtonCn Class="flex-1">
                            <LucideIconCn Name="trending-up" Size="16" Class="mr-2 h-4 w-4" />
                            Back This Project
                        </ButtonCn>
                        <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Outline">
                            <LucideIconCn Name="heart" Size="16" Class="h-4 w-4" />
                        </ButtonCn>
                    </div>
                </CardContentCn>
            </div>
        </CardCn>
    </div>
</section>

@code {
    private record RewardTier(string Name, int Amount, string Description, int Backers, int? Limit = null);

    private record Product(
        string Name,
        string Creator,
        string Image,
        string Category,
        string Description,
        int GoalAmount,
        int RaisedAmount,
        int BackersCount,
        int DaysLeft,
        RewardTier[] Rewards);

    private static readonly Product _product = new(
        "Modular Desk Organizer System",
        "Studio Workshop",
        "https://images.unsplash.com/photo-1593062096033-9a26b09da705?w=400&q=80",
        "Design",
        "A customizable magnetic desk organization system that adapts to your workflow.",
        50000,
        37840,
        892,
        12,
        [
            new("Early Supporter", 25, "Thank you pack + updates", 234),
            new("Starter Set", 79, "3-piece organizer set", 445, 500),
            new("Complete System", 149, "Full 7-piece collection", 213),
        ]);

    private int _fundingPercent => (int)Math.Round((double)_product.RaisedAmount / _product.GoalAmount * 100);
    private bool _isFullyFunded => _fundingPercent >= 100;
}
