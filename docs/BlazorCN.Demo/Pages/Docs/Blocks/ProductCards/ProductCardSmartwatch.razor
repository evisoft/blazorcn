@* ============================================================
   Block: product-card-smartwatch
   Title: ProductCardSmartwatch
   Description: Smartwatch product card with health features and band options for wearable tech stores
   Source: original/blocks/product-cards/product-card-smartwatch.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[200px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">New</BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Series 10</p>
            <h3 class="text-sm font-medium">Ultra Smart Watch</h3>
            <p class="mt-1 text-2xl font-semibold tabular-nums">$@_totalPrice</p>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">CASE SIZE</p>
            <div class="flex gap-2">
                @foreach (var sz in _caseSizes)
                {
                    var size = sz;
                    <button
                        type="button"
                        class="@Cn.Merge("rounded-md border px-3 py-1.5 text-xs font-medium transition-colors", _selectedSize == size ? "border-foreground bg-foreground text-background" : "hover:bg-muted/50")"
                        @onclick="@(() => SelectSize(size))">
                        @size
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">
                BAND &middot; <span class="text-foreground">@_selectedBand</span>
            </p>
            <div class="flex gap-2">
                @foreach (var bd in _bands)
                {
                    var band = bd;
                    <button
                        type="button"
                        class="@Cn.Merge("size-8 rounded-full border-2 transition-all", _selectedBand == band.Name ? "border-foreground ring-2 ring-foreground/20" : "border-border")"
                        style="@($"background-color:{band.Color}")"
                        title="@(band.Name + (band.Price > 0 ? $" (+${band.Price})" : ""))"
                        @onclick="@(() => SelectBand(band.Name))">
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">KEY FEATURES</p>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var feat in _features)
                {
                    <div class="flex items-center gap-2 rounded-md bg-muted/50 p-2">
                        <LucideIconCn Name="@feat.Icon" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                        <div>
                            <p class="text-xs font-medium">@feat.Label</p>
                            <p class="text-xs text-muted-foreground">@feat.Detail</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="battery" Size="14" Class="size-3.5 text-muted-foreground" />
                <div class="flex-1">
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Battery Life</span>
                        <span class="font-medium">Up to 36 hours</span>
                    </div>
                    <div class="mt-1 h-1.5 rounded-full bg-muted">
                        <div class="h-full w-3/4 rounded-full bg-emerald-500"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart &mdash; $@_totalPrice
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record BandItem(string Name, string Color, int Price);
    private record FeatureItem(string Icon, string Label, string Detail);

    private static readonly string[] _caseSizes = ["41mm", "45mm"];

    private static readonly BandItem[] _bands =
    [
        new("Sport Band", "#000000", 0),
        new("Braided Solo", "#4b5563", 49),
        new("Leather Link", "#92400e", 99),
        new("Milanese Loop", "#9ca3af", 99),
    ];

    private static readonly FeatureItem[] _features =
    [
        new("heart", "Heart Rate", "24/7 monitoring"),
        new("activity", "Blood Oxygen", "SpO2 sensor"),
        new("watch", "Always-On", "LTPO OLED display"),
        new("smartphone", "Compatible", "iOS & Android"),
    ];

    private string _selectedSize = "45mm";
    private string _selectedBand = "Sport Band";

    private int _bandPrice => _bands.FirstOrDefault(b => b.Name == _selectedBand)?.Price ?? 0;
    private int _basePrice => _selectedSize == "45mm" ? 429 : 399;
    private int _totalPrice => _basePrice + _bandPrice;

    private void SelectSize(string size) => _selectedSize = size;
    private void SelectBand(string name) => _selectedBand = name;
}
