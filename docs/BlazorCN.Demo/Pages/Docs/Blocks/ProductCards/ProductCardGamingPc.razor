@* ============================================================
   Block: product-card-gaming-pc
   Title: ProductCardGamingPc
   Description: Custom gaming PC build product card with hardware specs and configuration for tech stores
   Source: original/blocks/product-cards/product-card-gaming-pc.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[200px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Custom Build</BadgeCn>
            <div class="absolute bottom-3 right-3">
                <BadgeCn Variant="BadgeVariant.Secondary">Ships in 5-7 days</BadgeCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Apex Series</p>
            <h3 class="text-sm font-medium">Titan X Gaming Desktop</h3>
            <div class="mt-2 flex items-end justify-between">
                <p class="text-2xl font-semibold tabular-nums">$4,299</p>
                <p class="text-xs text-muted-foreground">or $179/mo for 24 months</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">SPECIFICATIONS</p>
            <div class="space-y-2">
                @foreach (var spec in _specs)
                {
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="@spec.Icon" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                        <span class="w-14 shrink-0 text-xs text-muted-foreground">@spec.Label</span>
                        <span class="text-xs font-medium">@spec.Value</span>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">GAMING PERFORMANCE</p>
            <div class="space-y-1.5">
                @foreach (var b in _benchmarks)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@b.Game</span>
                        <div class="flex items-center gap-2">
                            <span class="text-muted-foreground">@b.Resolution</span>
                            <span class="font-medium tabular-nums">@b.Fps</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="flex gap-2 px-4 py-3">
            <ButtonCn Class="flex-1">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Buy Now
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1">
                Customize Build
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SpecItem(string Icon, string Label, string Value);
    private record BenchmarkItem(string Game, string Fps, string Resolution);

    private static readonly SpecItem[] _specs =
    [
        new("cpu", "CPU", "AMD Ryzen 9 7950X"),
        new("monitor", "GPU", "RTX 4090 24GB"),
        new("hard-drive", "RAM", "64GB DDR5-6000"),
        new("hard-drive", "Storage", "2TB NVMe Gen5"),
        new("fan", "Cooling", "360mm AIO Liquid"),
        new("zap", "PSU", "1000W 80+ Platinum"),
    ];

    private static readonly BenchmarkItem[] _benchmarks =
    [
        new("Cyberpunk 2077", "120+ FPS", "4K Ultra"),
        new("Fortnite", "240+ FPS", "1440p Epic"),
        new("Valorant", "400+ FPS", "1080p High"),
    ];
}
