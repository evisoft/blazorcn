   Block: product-card-simple
   Title: Product Card Simple
   Description: Simple product card component with image, title, price, and add to cart for React ecommerce
   Long Description: Service package card with duration, what's included, and booking for React service businesses
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideShoppingCartCn, LucideStarCn
   Source: original/blocks/product-cards/product-card-simple.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[280px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[200px]">
                <img alt="Wireless Bluetooth Headphones"
                     class="h-full w-full object-cover"
                     height="200"
                     src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=400&q=80"
                     width="400" />
                <BadgeCn Class="absolute top-3 left-3">New</BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h3 class="font-semibold leading-tight">Wireless Bluetooth Headphones</h3>

                <div class="mt-2 flex items-center gap-1">
                    <LucideStarCn Size="16" Class="h-4 w-4 fill-primary text-primary" />
                    <span class="text-sm font-medium">4.5</span>
                    <span class="text-sm text-muted-foreground">(128 reviews)</span>
                </div>

                <p class="mt-3 text-2xl font-bold tabular-nums">$149.99</p>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideShoppingCartCn Size="16" Class="mr-2 h-4 w-4" />
                    Add to Cart
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

