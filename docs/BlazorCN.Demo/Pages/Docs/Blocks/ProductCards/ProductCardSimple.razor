@* ============================================================
   Block: product-card-simple
   Title: ProductCardSimple
   Description: Simple product card component with image, title, price, and add to cart for React ecommerce
   Source: original/blocks/product-cards/product-card-simple.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[280px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[200px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="200"
                    src="@_product.Image"
                    width="400" />
                @if (_product.Badge != null)
                {
                    <BadgeCn Class="absolute top-3 left-3">@_product.Badge</BadgeCn>
                }
            </div>

            <CardContentCn Class="p-4">
                <h3 class="font-semibold leading-tight">@_product.Name</h3>

                <div class="mt-2 flex items-center gap-1">
                    <LucideIconCn Name="star" Size="16" Class="h-4 w-4 fill-primary text-primary" />
                    <span class="text-sm font-medium">@_product.Rating</span>
                    <span class="text-sm text-muted-foreground">(@(_product.ReviewCount) reviews)</span>
                </div>

                <p class="mt-3 text-2xl font-bold tabular-nums">$@(_product.Price.ToString("F2"))</p>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 h-4 w-4" />
                    Add to Cart
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record Product(string Name, double Price, string Image, double Rating, int ReviewCount, string? Badge);

    private static readonly Product _product = new(
        "Wireless Bluetooth Headphones",
        149.99,
        "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=400&q=80",
        4.5,
        128,
        "New"
    );
}
