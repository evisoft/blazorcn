@* ============================================================
   Block: product-card-laptop
   Title: ProductCardLaptop
   Description: Laptop product card with configuration comparison and spec tiers for tech stores
   Source: original/blocks/product-cards/product-card-laptop.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[180px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">2025 Model</BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Apple</p>
            <h3 class="text-sm font-medium">MacBook Pro 16-inch</h3>
            <p class="mt-1 text-xs text-muted-foreground">
                Liquid Retina XDR &middot; 3456 x 2234
            </p>
            <p class="mt-2 text-2xl font-semibold tabular-nums">
                $@_config.Price.ToString("N0")
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">CONFIGURATION</p>
            <div class="grid grid-cols-3 gap-1.5">
                @foreach (var cfg in _configs)
                {
                    var cfgItem = cfg;
                    <button type="button"
                            class="@Cn.Merge("rounded-md border p-2 text-center transition-colors", _selectedConfig == cfgItem.Id ? "border-foreground bg-foreground/5" : "hover:bg-muted/50")"
                            @onclick="@(() => SelectConfig(cfgItem.Id))">
                        <p class="text-xs font-medium">@cfgItem.Label</p>
                        <p class="font-mono text-xs text-muted-foreground">$@cfgItem.Price.ToString("N0")</p>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">SPECS</p>
            <div class="space-y-2">
                <div class="flex items-center gap-3">
                    <LucideIconCn Name="cpu" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <span class="w-16 shrink-0 text-xs text-muted-foreground">Chip</span>
                    <span class="text-xs font-medium">@_config.Cpu</span>
                </div>
                <div class="flex items-center gap-3">
                    <LucideIconCn Name="memory-stick" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <span class="w-16 shrink-0 text-xs text-muted-foreground">Memory</span>
                    <span class="text-xs font-medium">@_config.Ram Unified</span>
                </div>
                <div class="flex items-center gap-3">
                    <LucideIconCn Name="hard-drive" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <span class="w-16 shrink-0 text-xs text-muted-foreground">Storage</span>
                    <span class="text-xs font-medium">@_config.Storage SSD</span>
                </div>
                <div class="flex items-center gap-3">
                    <LucideIconCn Name="battery" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <span class="w-16 shrink-0 text-xs text-muted-foreground">Battery</span>
                    <span class="text-xs font-medium">Up to @_config.Battery</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-1.5 text-xs font-medium text-muted-foreground">PORTS</p>
            <p class="text-xs text-muted-foreground">@string.Join(" · ", _ports)</p>
        </div>

        <div class="flex gap-2 px-4 py-3">
            <ButtonCn Class="flex-1">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1">
                Custom Config
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record LaptopConfig(string Id, string Label, string Cpu, string Ram, string Storage, int Price, string Battery);

    private static readonly LaptopConfig[] _configs =
    [
        new("base",  "Base",     "M4",     "16GB", "256GB", 1299, "18h"),
        new("mid",   "Enhanced", "M4 Pro", "24GB", "512GB", 1799, "22h"),
        new("max",   "Ultimate", "M4 Max", "48GB", "1TB",   2799, "20h"),
    ];

    private static readonly string[] _ports = ["Thunderbolt 5 x3", "MagSafe 3", "HDMI 2.1", "SD Card", "3.5mm Audio"];

    private string _selectedConfig = "mid";

    private LaptopConfig _config => _configs.FirstOrDefault(c => c.Id == _selectedConfig) ?? _configs[1];

    private void SelectConfig(string id) => _selectedConfig = id;
}
