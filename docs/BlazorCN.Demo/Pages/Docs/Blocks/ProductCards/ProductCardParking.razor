@* ============================================================
   Block: product-card-parking
   Title: ProductCardParking
   Description: Parking spot card with location map, hourly rates, and time selector for React parking apps
   Source: original/blocks/product-cards/product-card-parking.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            @* Map/Image preview *@
            <div class="relative h-[140px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <BadgeCn Class="absolute top-3 left-3">@_product.Type</BadgeCn>
                @if (_product.HasEVCharging)
                {
                    <BadgeCn Class="absolute top-3 right-3" Variant="BadgeVariant.Secondary">
                        <LucideIconCn Name="zap" Size="12" Class="mr-1 h-3 w-3" />
                        EV Charging
                    </BadgeCn>
                }
                <div class="absolute bottom-3 left-3 flex items-center gap-1 rounded-full bg-background/90 px-2 py-1 text-xs font-medium backdrop-blur-sm">
                    <LucideIconCn Name="navigation" Size="12" Class="h-3 w-3" />
                    @_product.Distance
                </div>
            </div>

            <CardContentCn Class="p-4">
                @* Location info *@
                <h2 class="font-semibold">@_product.Name</h2>
                <div class="mt-1 flex items-center gap-1 text-sm text-muted-foreground">
                    <LucideIconCn Name="map-pin" Size="12" Class="h-3 w-3" />
                    <span>@_product.Address</span>
                </div>

                @* Availability *@
                <div class="mt-3 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="car" Size="16" Class="h-4 w-4 text-muted-foreground" />
                        <span class="text-sm">
                            <span class="@_availabilityColor font-semibold">@_product.SpotsAvailable</span>
                            <span class="text-muted-foreground"> / @_product.TotalSpots spots</span>
                        </span>
                    </div>
                    <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">$@_product.HourlyRate/hr</BadgeCn>
                </div>

                @* Duration selector *@
                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">SELECT DURATION</p>
                    <div class="grid grid-cols-5 gap-1">
                        @foreach (var opt in _durationOptions)
                        {
                            var option = opt;
                            <button
                                class="@(_duration == option.Value ? "border border-input bg-accent text-accent-foreground" : "border border-input bg-background hover:bg-accent hover:text-accent-foreground") inline-flex items-center justify-center rounded-md px-2 py-1 text-xs font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                                @onclick="@(() => SetDuration(option.Value))">
                                @option.Label
                            </button>
                        }
                    </div>
                </div>

                @* Amenities *@
                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">AMENITIES</p>
                    <div class="grid grid-cols-2 gap-1">
                        @foreach (var amenity in _product.Amenities)
                        {
                            <div class="flex items-center gap-1.5 text-xs">
                                <LucideIconCn Name="check" Size="12" Class="h-3 w-3 text-primary" />
                                <span>@amenity</span>
                            </div>
                        }
                    </div>
                </div>

                @* Price summary *@
                <div class="mt-4 flex items-center justify-between rounded-lg border p-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="clock" Size="16" Class="h-4 w-4 text-muted-foreground" />
                        <div>
                            <p class="text-sm font-medium">@_hours hour@(_hours > 1 ? "s" : "")</p>
                            @if (_useDaily && _hours < 24)
                            {
                                <p class="text-xs text-muted-foreground">Daily max applied</p>
                            }
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-xl font-bold tabular-nums">$@_totalPrice.ToString("F2")</p>
                        @if (_hours < 8)
                        {
                            <p class="text-xs text-muted-foreground">Max $@_product.DailyRate/day</p>
                        }
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full" Disabled="@(_product.SpotsAvailable == 0)">
                    <LucideIconCn Name="shield" Size="16" Class="mr-2 h-4 w-4" />
                    Reserve Spot
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    <LucideIconCn Name="navigation" Size="16" Class="mr-2 h-4 w-4" />
                    Get Directions
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record Product(
        string Name,
        string Address,
        string Distance,
        string Type,
        int HourlyRate,
        int DailyRate,
        int SpotsAvailable,
        int TotalSpots,
        string[] Amenities,
        bool HasEVCharging,
        string Image
    );

    private record DurationOption(string Value, string Label);

    private static readonly Product _product = new(
        Name: "Central Plaza Garage",
        Address: "123 Main Street, Downtown",
        Distance: "0.3 mi",
        Type: "Covered",
        HourlyRate: 4,
        DailyRate: 25,
        SpotsAvailable: 47,
        TotalSpots: 200,
        Amenities: ["24/7 Access", "Security cameras", "Well lit", "Elevator"],
        HasEVCharging: true,
        Image: "https://images.unsplash.com/photo-1506521781263-d8422e82f27a?w=400&q=80"
    );

    private static readonly DurationOption[] _durationOptions =
    [
        new("1", "1 hr"),
        new("2", "2 hrs"),
        new("4", "4 hrs"),
        new("8", "8 hrs"),
        new("24", "24 hrs"),
    ];

    private string _duration = "2";

    private int _hours => int.Parse(_duration);
    private bool _useDaily => _hours >= 8;
    private double _totalPrice => _useDaily
        ? (_hours >= 24
            ? _product.DailyRate
            : Math.Min(_product.HourlyRate * _hours, _product.DailyRate))
        : _product.HourlyRate * _hours;

    private double _availabilityPercent => ((double)_product.SpotsAvailable / _product.TotalSpots) * 100;
    private string _availabilityColor => _availabilityPercent > 30
        ? "text-primary"
        : _availabilityPercent > 10
            ? "text-amber-600"
            : "text-destructive";

    private void SetDuration(string value) => _duration = value;
}
