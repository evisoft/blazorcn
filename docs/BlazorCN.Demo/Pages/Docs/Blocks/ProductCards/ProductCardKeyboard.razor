@* ============================================================
   Block: product-card-keyboard
   Title: ProductCardKeyboard
   Description: Mechanical keyboard product card with switch type selector and layout options for tech stores
   Source: original/blocks/product-cards/product-card-keyboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[180px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Hot-Swappable</BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Keychron</p>
            <h3 class="text-sm font-medium">Q1 Max Wireless Mechanical Keyboard</h3>
            <p class="mt-2 text-2xl font-semibold tabular-nums">$@_price</p>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">LAYOUT</p>
            <div class="grid grid-cols-3 gap-1.5">
                @foreach (var layout in _layouts)
                {
                    var lay = layout;
                    <button
                        type="button"
                        class="@Cn.Merge("rounded-md border p-2 text-center transition-colors", _selectedLayout == lay.Id ? "border-foreground bg-foreground/5" : "hover:bg-muted/50")"
                        @onclick="@(() => _selectedLayout = lay.Id)">
                        <p class="text-xs font-medium">@lay.Label</p>
                        <p class="text-xs text-muted-foreground">@lay.Keys</p>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">
                SWITCH &middot; <span class="text-foreground">Gateron @_selectedSwitch</span>
            </p>
            <div class="grid grid-cols-3 gap-1.5">
                @foreach (var sw in _switches)
                {
                    var swItem = sw;
                    <button
                        type="button"
                        class="@Cn.Merge("rounded-md border p-2 transition-colors", _selectedSwitch == swItem.Name ? "border-foreground bg-foreground/5" : "hover:bg-muted/50")"
                        @onclick="@(() => _selectedSwitch = swItem.Name)">
                        <div class="mb-1 flex items-center justify-center">
                            <span class="size-3 rounded-full" style="@($"background-color:{swItem.Color}")"></span>
                        </div>
                        <p class="text-xs font-medium">@swItem.Name</p>
                        <p class="text-xs text-muted-foreground">@swItem.Type</p>
                    </button>
                }
            </div>
            @if (_activeSwitch != null)
            {
                <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                    <span>Force: @_activeSwitch.Force</span>
                    <span>&middot;</span>
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="volume-2" Size="12" Class="size-3" />
                        <span>@_activeSwitch.Sound</span>
                    </div>
                </div>
            }
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">CONNECTIVITY</p>
            <div class="flex gap-3">
                <div class="flex items-center gap-1.5 text-xs">
                    <LucideIconCn Name="bluetooth" Size="12" Class="size-3 text-muted-foreground" />
                    <span>Bluetooth 5.1</span>
                </div>
                <div class="flex items-center gap-1.5 text-xs">
                    <LucideIconCn Name="zap" Size="12" Class="size-3 text-muted-foreground" />
                    <span>2.4GHz Wireless</span>
                </div>
                <div class="flex items-center gap-1.5 text-xs">
                    <LucideIconCn Name="usb" Size="12" Class="size-3 text-muted-foreground" />
                    <span>USB-C Wired</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Keycaps</span>
                <span class="font-medium">Double-shot PBT</span>
            </div>
            <div class="mt-1 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Backlight</span>
                <span class="font-medium">RGB South-facing</span>
            </div>
            <div class="mt-1 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Gasket Mount</span>
                <span class="font-medium">Yes</span>
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SwitchOption(string Name, string Type, string Force, string Sound, string Color);
    private record LayoutOption(string Id, string Label, string Keys, int Price);

    private static readonly SwitchOption[] _switches =
    [
        new("Red", "Linear", "45g", "Quiet", "#dc2626"),
        new("Brown", "Tactile", "55g", "Moderate", "#92400e"),
        new("Blue", "Clicky", "60g", "Loud", "#2563eb"),
    ];

    private static readonly LayoutOption[] _layouts =
    [
        new("full", "Full Size", "104 keys", 169),
        new("tkl", "TKL", "87 keys", 149),
        new("65", "65%", "68 keys", 139),
    ];

    private string _selectedSwitch = "Red";
    private string _selectedLayout = "tkl";

    private int _price => _layouts.FirstOrDefault(l => l.Id == _selectedLayout)?.Price ?? 149;
    private SwitchOption? _activeSwitch => _switches.FirstOrDefault(s => s.Name == _selectedSwitch);
}
