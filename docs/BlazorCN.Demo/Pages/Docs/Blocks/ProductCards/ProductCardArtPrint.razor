@* ============================================================
   Block: product-card-art-print
   Title: ProductCardArtPrint
   Description: Art print product card with frame options and size selector for art galleries
   Source: original/blocks/product-cards/product-card-art-print.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex aspect-[4/3] max-h-[240px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Limited Edition</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="absolute top-3 right-3">
                #42 / 250
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="size-5 rounded-full bg-muted"></div>
                <p class="text-xs font-medium text-muted-foreground">Maya Chen</p>
            </div>
            <h3 class="mt-1 text-sm font-medium">Morning Light on the Coast</h3>
            <p class="mt-1 text-xs text-muted-foreground">
                Giclée print &middot; Signed &amp; numbered
            </p>
            <p class="mt-2 text-2xl font-semibold tabular-nums">$@_totalPrice</p>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">SIZE</p>
            <div class="grid grid-cols-3 gap-1.5">
                @foreach (var s in _sizes)
                {
                    var size = s;
                    <button
                        type="button"
                        class="@Cn.Merge("rounded-md border p-2 text-center transition-colors", _selectedSize == size.Id ? "border-foreground bg-foreground text-background" : "hover:bg-muted/50")"
                        @onclick="@(() => _selectedSize = size.Id)">
                        <p class="text-xs font-medium">@size.Label</p>
                        <p class="@Cn.Merge("text-xs", _selectedSize == size.Id ? "text-background/70" : "text-muted-foreground")">
                            $@size.Price
                        </p>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">
                FRAME &middot; <span class="text-foreground">@(_frames.Length > 0 ? (_frames.FirstOrDefault(f => f.Id == _selectedFrame)?.Label ?? "") : "")</span>
            </p>
            <div class="flex gap-2">
                @foreach (var f in _frames)
                {
                    var frame = f;
                    var isSelected = _selectedFrame == frame.Id;
                    var isNone = frame.Id == "none";
                    var title = frame.Price > 0 ? $"{frame.Label} (+${frame.Price})" : frame.Label;
                    <button
                        type="button"
                        class="@Cn.Merge("size-8 rounded-md border-2 transition-all", isSelected ? "border-foreground ring-2 ring-foreground/20" : "border-border", isNone ? "flex items-center justify-center" : "")"
                        style="@(isNone ? "" : $"background-color:{frame.Color}")"
                        title="@title"
                        @onclick="@(() => _selectedFrame = frame.Id)">
                        @if (isNone)
                        {
                            <LucideIconCn Name="frame" Size="16" Class="size-4 text-muted-foreground" />
                        }
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">PAPER</p>
            <div class="space-y-1.5">
                @foreach (var p in _papers)
                {
                    var paper = p;
                    var isPaperSelected = _selectedPaper == paper.Id;
                    <label class="@Cn.Merge("flex cursor-pointer items-center gap-2 rounded-md border p-2 transition-colors", isPaperSelected ? "border-foreground bg-foreground/5" : "hover:bg-muted/50")">
                        <div class="@Cn.Merge("size-3.5 rounded-full border-2", isPaperSelected ? "border-foreground bg-foreground" : "border-muted-foreground/40")"></div>
                        <div>
                            <p class="text-xs font-medium">@paper.Label</p>
                            <p class="text-xs text-muted-foreground">@paper.Desc</p>
                        </div>
                        <input
                            type="radio"
                            name="paper"
                            value="@paper.Id"
                            checked="@isPaperSelected"
                            @onchange="@(() => _selectedPaper = paper.Id)"
                            class="sr-only" />
                    </label>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart &mdash; $@_totalPrice
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SizeOption(string Id, string Label, int Price);
    private record FrameOption(string Id, string Label, string Color, int Price);
    private record PaperOption(string Id, string Label, string Desc);

    private static readonly SizeOption[] _sizes =
    [
        new("sm", "12\" x 16\"", 45),
        new("md", "18\" x 24\"", 75),
        new("lg", "24\" x 36\"", 120),
    ];

    private static readonly FrameOption[] _frames =
    [
        new("none", "No Frame", "transparent", 0),
        new("black", "Black", "#1a1a1a", 45),
        new("white", "White", "#f5f5f5", 45),
        new("natural", "Natural Oak", "#c4a77d", 65),
        new("walnut", "Walnut", "#5c3d2e", 75),
    ];

    private static readonly PaperOption[] _papers =
    [
        new("matte", "Museum Matte", "Archival cotton rag"),
        new("lustre", "Lustre Photo", "Semi-gloss finish"),
        new("canvas", "Canvas", "Gallery-wrapped edges"),
    ];

    private string _selectedSize = "md";
    private string _selectedFrame = "none";
    private string _selectedPaper = "matte";

    private int _totalPrice =>
        (_sizes.FirstOrDefault(s => s.Id == _selectedSize)?.Price ?? 75)
        + (_frames.FirstOrDefault(f => f.Id == _selectedFrame)?.Price ?? 0);
}
