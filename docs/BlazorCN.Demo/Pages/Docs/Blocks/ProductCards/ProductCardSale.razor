@* ============================================================
   Block: product-card-sale
   Title: ProductCardSale
   Description: Product card with sale pricing showing original and discounted price for React ecommerce
   Source: original/blocks/product-cards/product-card-sale.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[280px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[200px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <BadgeCn Class="absolute top-3 left-3">
                    <LucideIconCn Name="tag" Size="12" Class="mr-1 h-3 w-3" />
                    @_savingsPercent% Off
                </BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h2 class="font-semibold leading-tight">@_product.Name</h2>

                <div class="mt-2 flex items-center gap-1">
                    <LucideIconCn Name="star" Size="16" Class="h-4 w-4 fill-primary text-primary" />
                    <span class="text-sm font-medium">@_product.Rating</span>
                    <span class="text-sm text-muted-foreground">(@_product.ReviewCount reviews)</span>
                </div>

                <div class="mt-3 flex items-baseline gap-2">
                    <span class="text-2xl font-bold tabular-nums">
                        $@_product.SalePrice.ToString("F2")
                    </span>
                    <span class="text-sm text-muted-foreground line-through tabular-nums">
                        $@_product.OriginalPrice.ToString("F2")
                    </span>
                </div>

                <p class="mt-2 text-sm text-muted-foreground">
                    You save $@((_product.OriginalPrice - _product.SalePrice).ToString("F2"))
                </p>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 h-4 w-4" />
                    Add to Cart
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record Product(
        string Name,
        double OriginalPrice,
        double SalePrice,
        string Image,
        double Rating,
        int ReviewCount);

    private static readonly Product _product = new(
        "Running Shoes Pro",
        159.99,
        99.99,
        "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=400&q=80",
        4.8,
        256);

    private int _savingsPercent =>
        (int)Math.Round((_product.OriginalPrice - _product.SalePrice) / _product.OriginalPrice * 100);
}
