@* ============================================================
   Block: product-card-headphones
   Title: ProductCardHeadphones
   Description: Premium headphones product card with audio specs and noise cancellation details for audio stores
   Source: original/blocks/product-cards/product-card-headphones.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[200px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Best Seller</BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Studio Pro Series</p>
            <h3 class="text-sm font-medium">WH-1000XM6 Wireless Headphones</h3>
            <div class="mt-2 flex items-end justify-between">
                <p class="text-2xl font-semibold tabular-nums">$349</p>
                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <LucideIconCn Name="bluetooth" Size="12" Class="size-3" />
                    <span>Bluetooth 5.4</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">
                COLOR &middot; <span class="text-foreground">@_selectedColor</span>
            </p>
            <div class="flex gap-2">
                @foreach (var c in _colors)
                {
                    var color = c;
                    <button
                        type="button"
                        class="@Cn.Merge("size-8 rounded-full border-2 transition-all", _selectedColor == color.Name ? "border-foreground ring-2 ring-foreground/20" : "border-border")"
                        style="@($"background-color:{color.Value}")"
                        @onclick="@(() => _selectedColor = color.Name)"
                        title="@color.Name">
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">AUDIO SPECIFICATIONS</p>
            <div class="grid grid-cols-2 gap-x-4 gap-y-1.5">
                @foreach (var spec in _audioSpecs)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@spec.Label</span>
                        <span class="font-medium">@spec.Value</span>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">NOISE CANCELLATION</p>
            <div class="grid grid-cols-4 gap-1.5">
                @foreach (var level in _ancLevels)
                {
                    var lv = level;
                    <button
                        type="button"
                        class="@Cn.Merge("rounded-md border p-2 text-center transition-colors", _ancLevel == lv.Label ? "border-foreground bg-foreground/5" : "hover:bg-muted/50")"
                        @onclick="@(() => _ancLevel = lv.Label)">
                        <div class="mb-1 flex items-end justify-center gap-0.5">
                            @for (int i = 0; i < 5; i++)
                            {
                                var idx = i;
                                <div
                                    class="@Cn.Merge("w-1 rounded-full", idx < lv.Bars ? "bg-foreground" : "bg-muted")"
                                    style="@($"height:{(idx + 1) * 3}px")">
                                </div>
                            }
                        </div>
                        <p class="text-xs font-medium">@lv.Label</p>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="battery" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">40h battery</span>
                </div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="volume-2" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">Hi-Res Audio</span>
                </div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="waves" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">Spatial Audio</span>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ColorOption(string Name, string Value);
    private record AudioSpec(string Label, string Value);
    private record AncLevel(string Label, string Desc, int Bars);

    private static readonly ColorOption[] _colors =
    [
        new("Midnight Black", "#1a1a1a"),
        new("Silver White", "#e5e5e5"),
        new("Navy Blue", "#1e3a5f"),
    ];

    private static readonly AudioSpec[] _audioSpecs =
    [
        new("Driver", "40mm Dynamic"),
        new("Frequency", "4Hz - 40kHz"),
        new("Impedance", "32 Ohm"),
        new("Codec", "LDAC, aptX HD"),
    ];

    private static readonly AncLevel[] _ancLevels =
    [
        new("Max", "Full isolation", 5),
        new("High", "Most noise blocked", 4),
        new("Mid", "Balanced", 3),
        new("Aware", "Hear surroundings", 1),
    ];

    private string _selectedColor = "Midnight Black";
    private string _ancLevel = "Max";
}
