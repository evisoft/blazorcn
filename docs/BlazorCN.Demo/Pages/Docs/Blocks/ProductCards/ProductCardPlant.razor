@* ============================================================
   Block: product-card-plant
   Title: ProductCardPlant
   Description: Plant product card with care requirements and growing conditions for React nurseries
   Source: original/blocks/product-cards/product-card-plant.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[280px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[200px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <div class="absolute top-3 left-3 flex gap-1">
                    <BadgeCn>@_product.Difficulty Care</BadgeCn>
                </div>
                @if (_product.PetSafe)
                {
                    <BadgeCn Class="absolute top-3 right-3" Variant="BadgeVariant.Secondary">
                        <LucideIconCn Name="heart" Size="12" Class="mr-1 h-3 w-3" />
                        Pet Safe
                    </BadgeCn>
                }
                else
                {
                    <BadgeCn Class="absolute top-3 right-3 bg-background/90" Variant="BadgeVariant.Outline">
                        Not Pet Safe
                    </BadgeCn>
                }
            </div>

            <CardContentCn Class="p-4">
                <h3 class="font-semibold">@_product.Name</h3>
                <p class="text-sm text-muted-foreground italic">@_product.ScientificName</p>

                @* Care requirements *@
                <div class="mt-4 space-y-2">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-sm">
                            <LucideIconCn Name="sun" Size="16" Class="h-4 w-4 text-muted-foreground" />
                            <span>Light</span>
                        </div>
                        <div class="flex items-center gap-1">
                            @foreach (var i in new[] { 1, 2, 3, 4 })
                            {
                                var idx = i;
                                <div class="@Cn.Merge("h-2 w-4 rounded-sm", idx <= GetLightBars(_product.Light) ? "bg-primary" : "bg-muted")"></div>
                            }
                            <span class="ml-2 text-xs text-muted-foreground">@_product.Light</span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-sm">
                            <LucideIconCn Name="droplets" Size="16" Class="h-4 w-4 text-muted-foreground" />
                            <span>Water</span>
                        </div>
                        <div class="flex items-center gap-1">
                            @foreach (var i in new[] { 1, 2, 3 })
                            {
                                var idx = i;
                                <div class="@Cn.Merge("h-2 w-4 rounded-sm", idx <= GetWaterBars(_product.Water) ? "bg-primary" : "bg-muted")"></div>
                            }
                            <span class="ml-2 text-xs text-muted-foreground">@_product.Water</span>
                        </div>
                    </div>
                </div>

                @* Size info *@
                <div class="mt-4 flex items-center gap-4 text-sm text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="ruler" Size="12" Class="h-3 w-3" />
                        <span>Grows to @_product.MatureSize</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="leaf" Size="12" Class="h-3 w-3" />
                        <span>@_product.PotSize</span>
                    </div>
                </div>

                <div class="mt-4 flex items-center justify-between">
                    <span class="text-2xl font-bold tabular-nums">$@_product.Price</span>
                    @if (_product.InStock)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary">In Stock</BadgeCn>
                    }
                    else
                    {
                        <BadgeCn Variant="BadgeVariant.Outline">Sold Out</BadgeCn>
                    }
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full" Disabled="@(!_product.InStock)">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 h-4 w-4" />
                    Add to Cart
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record Product(
        string Name,
        string ScientificName,
        int Price,
        string Image,
        string Difficulty,
        string Light,
        string Water,
        bool PetSafe,
        string MatureSize,
        string PotSize,
        bool InStock
    );

    private static readonly Product _product = new(
        Name: "Monstera Deliciosa",
        ScientificName: "Swiss Cheese Plant",
        Price: 45,
        Image: "https://images.unsplash.com/photo-1614594975525-e45190c55d0b?w=400&q=80",
        Difficulty: "Easy",
        Light: "Bright indirect",
        Water: "Moderate",
        PetSafe: false,
        MatureSize: "6-8 ft",
        PotSize: "6\" pot",
        InStock: false
    );

    private static int GetLightBars(string light) => light switch
    {
        "Low" => 1,
        "Medium" => 2,
        "Bright indirect" => 3,
        "Direct sun" => 4,
        _ => 2
    };

    private static int GetWaterBars(string water) => water switch
    {
        "Low" => 1,
        "Moderate" => 2,
        "Frequent" => 3,
        _ => 2
    };
}
