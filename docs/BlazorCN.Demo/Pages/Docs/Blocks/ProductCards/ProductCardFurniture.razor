@* ============================================================
   Block: product-card-furniture
   Title: ProductCardFurniture
   Description: Furniture product card with dimensions, materials, and delivery estimate for React home stores
   Source: original/blocks/product-cards/product-card-furniture.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <BadgeCn Class="absolute top-3 left-3">@_product.Collection</BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h2 class="font-semibold">@_product.Name</h2>
                <p class="mt-1 text-sm text-muted-foreground">@_product.Material</p>

                @* Dimensions *@
                <div class="mt-3 flex items-center gap-2 rounded-lg border p-2">
                    <LucideIconCn Name="ruler" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    <div class="flex gap-3 text-xs">
                        <span>W: @_product.DimensionWidth</span>
                        <span>D: @_product.DimensionDepth</span>
                        <span>H: @_product.DimensionHeight</span>
                    </div>
                </div>

                @* Color selector *@
                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">
                        COLOR: <span class="text-foreground">@_selectedColor</span>
                    </p>
                    <div class="flex gap-2">
                        @foreach (var color in _product.Colors)
                        {
                            var c = color;
                            <button
                                type="button"
                                class="@Cn.Merge("h-8 w-8 rounded-full border-2 transition-all", _selectedColor == c.Name ? "border-primary ring-2 ring-primary ring-offset-2" : "border-border")"
                                @onclick="@(() => _selectedColor = c.Name)"
                                style="@($"background-color:{c.Value}")"
                                title="@c.Name">
                            </button>
                        }
                    </div>
                </div>

                @* Delivery *@
                <div class="mt-4 flex items-center gap-2 text-sm">
                    <LucideIconCn Name="truck" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    <span class="text-muted-foreground">Delivery in @_product.DeliveryDays days</span>
                </div>

                <div class="mt-4 flex items-center justify-between">
                    <span class="text-2xl font-bold tabular-nums">$@_product.Price</span>
                    @if (_product.InStock)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary">
                            <LucideIconCn Name="package" Size="12" Class="mr-1 h-3 w-3" />
                            In Stock
                        </BadgeCn>
                    }
                    else
                    {
                        <BadgeCn Variant="BadgeVariant.Outline">Made to Order</BadgeCn>
                    }
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 h-4 w-4" />
                    Add to Cart
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    View in Room
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record ColorOption(string Name, string Value);
    private record ProductData(
        string Name,
        string Collection,
        int Price,
        string Image,
        string DimensionWidth,
        string DimensionDepth,
        string DimensionHeight,
        string Material,
        int DeliveryDays,
        ColorOption[] Colors,
        bool InStock
    );

    private static readonly ProductData _product = new(
        Name: "Minimalist Lounge Chair",
        Collection: "Nordic Collection",
        Price: 899,
        Image: "https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=400&q=80",
        DimensionWidth: "32\"",
        DimensionDepth: "34\"",
        DimensionHeight: "33\"",
        Material: "Oak wood, Premium fabric",
        DeliveryDays: 14,
        Colors:
        [
            new("Charcoal", "#374151"),
            new("Cream", "#fef3c7"),
            new("Forest", "#065f46"),
            new("Navy", "#1e3a5f"),
        ],
        InStock: true
    );

    private string _selectedColor = _product.Colors[0].Name;
}
