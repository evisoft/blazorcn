@* ============================================================
   Block: product-card-saas
   Title: ProductCardSaas
   Description: Software product card with pricing tiers and feature comparison for React SaaS sites
   Source: original/blocks/product-cards/product-card-saas.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn Class="@Cn.Merge("overflow-hidden", _product.IsPopular ? "ring-2 ring-primary" : "")">
            @if (_product.IsPopular)
            {
                <div class="bg-primary px-4 py-1 text-center text-xs font-medium text-primary-foreground">
                    Most Popular
                </div>
            }

            <CardContentCn Class="p-5">
                <div class="flex items-center gap-2">
                    <div class="flex h-10 w-10 items-center justify-center rounded-lg border">
                        <LucideIconCn Name="zap" Size="20" Class="h-5 w-5 text-primary" />
                    </div>
                    <div>
                        <h3 class="font-semibold">@_product.Name</h3>
                    </div>
                </div>

                <p class="mt-2 text-sm text-muted-foreground">@_product.Description</p>

                @* Billing toggle *@
                <div class="mt-4 flex items-center justify-between rounded-lg border p-3">
                    <div class="flex items-center gap-2">
                        <span class="@Cn.Merge("text-sm", _isYearly ? "text-muted-foreground" : "font-medium")">
                            Monthly
                        </span>
                        <SwitchCn Checked="@_isYearly" CheckedChanged="@((bool v) => { _isYearly = v; })" />
                        <span class="@Cn.Merge("text-sm", _isYearly ? "font-medium" : "text-muted-foreground")">
                            Yearly
                        </span>
                    </div>
                    @if (_isYearly)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                            <LucideIconCn Name="sparkles" Size="12" Class="mr-1 h-3 w-3" />
                            Save @_savings%
                        </BadgeCn>
                    }
                </div>

                @* Price *@
                <div class="mt-4">
                    <div class="flex items-baseline gap-1">
                        <span class="text-3xl font-bold tabular-nums">$@_currentPrice</span>
                        <span class="text-muted-foreground">/@(_isYearly ? "year" : "month")</span>
                    </div>
                    @if (_isYearly)
                    {
                        <p class="text-xs text-muted-foreground">
                            $@((_product.YearlyPrice / 12.0).ToString("0.00"))/month billed annually
                        </p>
                    }
                </div>

                @* Features *@
                <div class="mt-5">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">WHAT'S INCLUDED</p>
                    <div class="space-y-2">
                        @foreach (var feature in _product.Features)
                        {
                            <div class="flex items-center gap-2">
                                @if (feature.Included)
                                {
                                    <LucideIconCn Name="check" Size="16" Class="h-4 w-4 text-primary" />
                                }
                                else
                                {
                                    <LucideIconCn Name="x" Size="16" Class="h-4 w-4 text-muted-foreground" />
                                }
                                <span class="@Cn.Merge("text-sm", feature.Included ? "" : "text-muted-foreground")">
                                    @feature.Name
                                    @if (feature.Limit != null)
                                    {
                                        <span class="text-muted-foreground"> (@feature.Limit)</span>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-5 pt-0">
                <ButtonCn Class="w-full">Start Free Trial</ButtonCn>
                <p class="text-xs text-center text-muted-foreground">
                    14-day free trial • No credit card required
                </p>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record Feature(string Name, bool Included, string? Limit = null);

    private record Product(
        string Name,
        string Description,
        int MonthlyPrice,
        int YearlyPrice,
        bool IsPopular,
        Feature[] Features);

    private static readonly Product _product = new(
        Name: "Pro Plan",
        Description: "For growing teams that need more power and flexibility.",
        MonthlyPrice: 29,
        YearlyPrice: 290,
        IsPopular: true,
        Features:
        [
            new("Unlimited projects", true),
            new("Team members", true, "Up to 10"),
            new("Storage", true, "100 GB"),
            new("API access", true),
            new("Priority support", true),
            new("Custom integrations", false),
        ]);

    private bool _isYearly = false;

    private int _currentPrice => _isYearly ? _product.YearlyPrice : _product.MonthlyPrice;
    private int _savings => (int)Math.Round((1.0 - (double)_product.YearlyPrice / (_product.MonthlyPrice * 12)) * 100);
}
