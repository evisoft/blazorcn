@* ============================================================
   Block: product-card-beauty
   Title: ProductCardBeauty
   Description: Skincare product card with ingredients and benefits for React beauty stores
   Source: original/blocks/product-cards/product-card-beauty.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[200px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <BadgeCn Class="absolute top-3 left-3">
                    <LucideIconCn Name="tag" Size="12" Class="mr-1 h-3 w-3" />
                    @_savingsPercent% Off
                </BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h2 class="font-semibold">@_product.Name</h2>
                <p class="mt-1 text-xs text-muted-foreground">
                    @_product.Volume · @_product.SkinType
                </p>

                <p class="mt-2 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                <div class="mt-4 grid grid-cols-2 gap-2">
                    <div>
                        <p class="mb-1.5 text-xs font-medium text-muted-foreground">BENEFITS</p>
                        <div class="space-y-1">
                            @foreach (var benefit in _product.Benefits)
                            {
                                <div class="flex items-center gap-1.5 text-xs">
                                    <LucideIconCn Name="check" Size="12" Class="h-3 w-3 text-primary" />
                                    <span>@benefit</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div>
                        <p class="mb-1.5 text-xs font-medium text-muted-foreground">INGREDIENTS</p>
                        <div class="flex flex-wrap gap-1">
                            @foreach (var ingredient in _product.Ingredients)
                            {
                                <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">@ingredient</BadgeCn>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-4 flex items-baseline gap-2">
                    <span class="text-xl font-bold tabular-nums">
                        $@_product.SalePrice.ToString("F2")
                    </span>
                    <span class="text-sm text-muted-foreground line-through tabular-nums">
                        $@_product.OriginalPrice.ToString("F2")
                    </span>
                </div>
            </CardContentCn>

            <CardFooterCn Class="gap-2 p-4 pt-0">
                <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 h-4 w-4" />
                    Add to Bag
                </ButtonCn>
                <ButtonCn Class="flex-1">Buy Now</ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record Product(
        string Name,
        string Description,
        double OriginalPrice,
        double SalePrice,
        string Image,
        string Volume,
        string SkinType,
        string[] Benefits,
        string[] Ingredients
    );

    private static readonly Product _product = new(
        Name: "Intensive Hand Cream",
        Description: "Ultra-hydrating formula with shea butter and vitamin E. Absorbs quickly for immediate relief of dry skin.",
        OriginalPrice: 29.99,
        SalePrice: 24.99,
        Image: "https://images.unsplash.com/photo-1556228720-195a672e8a03?w=400&q=80",
        Volume: "75ml",
        SkinType: "All skin types",
        Benefits: ["24h Hydration", "Non-greasy", "Repairs skin", "Dermatologist tested"],
        Ingredients: ["Shea Butter", "Aloe Vera", "Vitamin E", "Jojoba Oil"]
    );

    private static readonly int _savingsPercent = (int)Math.Round(
        (_product.OriginalPrice - _product.SalePrice) / _product.OriginalPrice * 100
    );
}
