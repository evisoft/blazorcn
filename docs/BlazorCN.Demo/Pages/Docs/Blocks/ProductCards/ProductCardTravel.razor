@* ============================================================
   Block: product-card-travel
   Title: ProductCardTravel
   Description: Travel package product card with departure info and testimonial for React booking sites
   Source: original/blocks/product-cards/product-card-travel.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[340px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <BadgeCn Class="absolute top-3 left-3">
                    <LucideIconCn Name="map-pin" Size="12" Class="mr-1 h-3 w-3" />
                    @_product.Location
                </BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h2 class="font-semibold">@_product.Name</h2>

                <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                    <LucideIconCn Name="calendar" Size="12" Class="h-3 w-3" />
                    <span>@_product.DepartureDate</span>
                    <span>•</span>
                    <span>@_product.Duration</span>
                </div>

                <p class="mt-2 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                <div class="mt-3 grid grid-cols-2 gap-1">
                    @foreach (var feature in _product.Features)
                    {
                        <div class="flex items-center gap-1.5 text-xs">
                            <LucideIconCn Name="check" Size="12" Class="h-3 w-3 text-primary" />
                            <span>@feature</span>
                        </div>
                    }
                </div>

                @* Testimonial *@
                <div class="mt-4 rounded-lg border p-3">
                    <div class="flex items-start gap-2">
                        <AvatarCn Class="h-8 w-8">
                            <AvatarImageCn Src="@_product.Testimonial.Avatar" Alt="" />
                            <AvatarFallbackCn>@_product.Testimonial.Name[0]</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="flex-1">
                            <div class="flex items-center gap-1">
                                @for (int i = 0; i < _product.Testimonial.Rating; i++)
                                {
                                    <LucideIconCn Name="star" Size="12" Class="h-3 w-3 fill-primary text-primary" />
                                }
                            </div>
                            <p class="mt-1 text-xs text-muted-foreground line-clamp-2">"@_product.Testimonial.Text"</p>
                            <p class="mt-1 text-xs font-medium">— @_product.Testimonial.Name</p>
                        </div>
                    </div>
                </div>

                <div class="mt-4 flex items-center justify-between">
                    <div>
                        <p class="text-xs text-muted-foreground">per person</p>
                        <p class="text-xl font-bold tabular-nums">$@_product.Price</p>
                    </div>
                    @if (_isLowAvailability)
                    {
                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                            <LucideIconCn Name="users" Size="12" Class="h-3 w-3" />
                            <span>Only @_product.SpotsLeft spots left</span>
                        </div>
                    }
                </div>

                <div class="mt-4 flex gap-2">
                    <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline">Details</ButtonCn>
                    <ButtonCn Class="flex-1">Book Now</ButtonCn>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private record TestimonialData(string Name, string Avatar, int Rating, string Text);

    private record Product(
        string Name,
        string Description,
        int Price,
        string Image,
        string Location,
        string DepartureDate,
        string Duration,
        int SpotsLeft,
        string[] Features,
        TestimonialData Testimonial
    );

    private static readonly Product _product = new(
        Name: "Tropical Paradise Getaway",
        Description: "All-inclusive beach resort with activities for all ages and premium dining experiences.",
        Price: 1299,
        Image: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=400&q=80",
        Location: "Maldives",
        DepartureDate: "Mar 15, 2025",
        Duration: "7 days / 6 nights",
        SpotsLeft: 4,
        Features: ["All meals included", "Airport transfers", "Snorkeling tours", "Spa credit"],
        Testimonial: new(
            Name: "Sarah M.",
            Avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&q=80",
            Rating: 5,
            Text: "Best vacation we've ever had! The resort exceeded all expectations."
        )
    );

    private static readonly bool _isLowAvailability = _product.SpotsLeft <= 5;
}
