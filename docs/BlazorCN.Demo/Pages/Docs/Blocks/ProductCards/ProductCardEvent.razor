@* ============================================================
   Block: product-card-event
   Title: ProductCardEvent
   Description: Event ticket card with seat selection and availability for React ticketing platforms
   Source: original/blocks/product-cards/product-card-event.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[340px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[160px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <BadgeCn Class="absolute top-3 left-3">
                    <LucideIconCn Name="ticket" Size="12" Class="mr-1 h-3 w-3" />
                    On Sale
                </BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h2 class="font-semibold">@_product.Name</h2>
                <p class="text-sm text-muted-foreground">@_product.Artist</p>

                <div class="mt-3 space-y-1 text-sm">
                    <div class="flex items-center gap-2 text-muted-foreground">
                        <LucideIconCn Name="calendar" Size="12" Class="h-3 w-3" />
                        <span>@_product.Date</span>
                        <LucideIconCn Name="clock" Size="12" Class="ml-2 h-3 w-3" />
                        <span>@_product.Time</span>
                    </div>
                    <div class="flex items-center gap-2 text-muted-foreground">
                        <LucideIconCn Name="map-pin" Size="12" Class="h-3 w-3" />
                        <span>@_product.Venue, @_product.City</span>
                    </div>
                </div>

                @* Ticket tiers *@
                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">SELECT TICKETS</p>
                    <div class="space-y-2">
                        @foreach (var tier in _product.Tiers)
                        {
                            var t = tier;
                            <div class="flex items-center">
                                <input
                                    type="radio"
                                    id="@($"event-{t.Id}")"
                                    name="ticket-tier"
                                    value="@t.Id"
                                    checked="@(_selectedTier == t.Id ? "checked" : null)"
                                    @onclick="@(() => _selectedTier = t.Id)"
                                    class="peer sr-only" />
                                <label
                                    class="@Cn.Merge("flex flex-1 cursor-pointer items-center justify-between rounded-lg border p-3 peer-data-[state=checked]:border-primary peer-data-[state=checked]:ring-1 peer-data-[state=checked]:ring-primary", _selectedTier == t.Id ? "border-primary ring-1 ring-primary" : "")"
                                    for="@($"event-{t.Id}")">
                                    <div>
                                        <p class="text-sm font-medium">@t.Name</p>
                                        <p class="text-xs text-muted-foreground">@t.Description</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="font-semibold tabular-nums">$@t.Price</p>
                                        @if (t.Available <= 20)
                                        {
                                            <p class="text-xs text-muted-foreground">@t.Available left</p>
                                        }
                                    </div>
                                </label>
                            </div>
                        }
                    </div>
                </div>

                @* Quantity *@
                <div class="mt-4 flex items-center justify-between">
                    <p class="text-sm font-medium">Quantity</p>
                    <div class="flex items-center gap-2">
                        <ButtonCn
                            Class="h-8 w-8"
                            Disabled="@(_quantity <= 1)"
                            Size="ButtonSize.Icon"
                            Variant="ButtonVariant.Outline"
                            OnClick="@(() => _quantity = Math.Max(1, _quantity - 1))" aria-label="Remove">
                            <LucideIconCn Name="minus" Size="12" Class="h-3 w-3" />
                        </ButtonCn>
                        <span class="w-8 text-center font-medium tabular-nums">@_quantity</span>
                        <ButtonCn
                            Class="h-8 w-8"
                            Disabled="@(_quantity >= 8)"
                            Size="ButtonSize.Icon"
                            Variant="ButtonVariant.Outline"
                            OnClick="@(() => _quantity = Math.Min(8, _quantity + 1))" aria-label="Add">
                            <LucideIconCn Name="plus" Size="12" Class="h-3 w-3" />
                        </ButtonCn>
                    </div>
                </div>

                @if (_isLowAvailability)
                {
                    <div class="mt-3 flex items-center gap-1 text-xs text-muted-foreground">
                        <LucideIconCn Name="users" Size="12" Class="h-3 w-3" />
                        <span>Only @_currentTier.Available tickets remaining</span>
                    </div>
                }
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <div class="flex w-full items-center justify-between">
                    <span class="text-sm text-muted-foreground">Total</span>
                    <span class="text-xl font-bold tabular-nums">$@_total</span>
                </div>
                <ButtonCn Class="w-full">
                    <LucideIconCn Name="ticket" Size="16" Class="mr-2 h-4 w-4" />
                    Get Tickets
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record TicketTier(string Id, string Name, int Price, int Available, string Description);

    private record Product(
        string Name,
        string Artist,
        string Image,
        string Date,
        string Time,
        string Venue,
        string City,
        TicketTier[] Tiers);

    private static readonly Product _product = new(
        "Summer Music Festival",
        "Multiple Artists",
        "https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?w=400&q=80",
        "Aug 15, 2025",
        "6:00 PM",
        "Madison Square Garden",
        "New York, NY",
        [
            new("ga", "General Admission", 75, 250, "Standing room"),
            new("reserved", "Reserved Seating", 125, 45, "Assigned seat"),
            new("vip", "VIP Experience", 299, 8, "Premium view + perks"),
        ]);

    private string _selectedTier = "ga";
    private int _quantity = 2;

    private TicketTier _currentTier => Array.Find(_product.Tiers, t => t.Id == _selectedTier) ?? _product.Tiers[0];
    private int _total => _currentTier.Price * _quantity;
    private bool _isLowAvailability => _currentTier.Available <= 20;
}
