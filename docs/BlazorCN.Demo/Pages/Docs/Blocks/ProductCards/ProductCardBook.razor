@* ============================================================
   Block: product-card-book
   Title: ProductCardBook
   Description: Book product card with author, ratings, and format options for React bookstores
   Source: original/blocks/product-cards/product-card-book.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[280px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[200px] p-4">
                <img
                    alt="@_product.Title"
                    class="mx-auto h-full w-auto rounded object-cover shadow-lg"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <BadgeCn Class="absolute top-3 left-3">@_product.Category</BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h2 class="font-semibold leading-tight">@_product.Title</h2>
                <p class="mt-1 text-sm text-muted-foreground">by @_product.Author</p>

                <div class="mt-2 flex items-center gap-1">
                    <LucideIconCn Name="star" Size="16" Class="h-4 w-4 fill-primary text-primary" />
                    <span class="text-sm font-medium">@_product.Rating</span>
                    <span class="text-sm text-muted-foreground">(@_product.ReviewCount.ToString("N0") reviews)</span>
                </div>

                <p class="mt-2 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
                    <span>@_product.Pages pages</span>
                    <span>•</span>
                    <span>@_product.PublishDate</span>
                </div>

                @* Format selector *@
                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">FORMAT</p>
                    <div class="grid grid-cols-3 gap-1">
                        @foreach (var fmt in _product.Formats)
                        {
                            var fmtId = fmt.Id;
                            var isSelected = _selectedFormat == fmtId;
                            <button
                                class="@Cn.Merge("flex flex-col items-center justify-center h-auto py-2 text-xs gap-1 rounded-md border px-2 transition-colors", isSelected ? "bg-accent text-accent-foreground border-accent" : "border-border bg-background text-muted-foreground hover:bg-accent hover:text-accent-foreground")"
                                type="button"
                                @onclick="@(() => _selectedFormat = fmtId)">
                                <LucideIconCn Name="@fmt.IconName" Size="16" Class="h-4 w-4" />
                                <span>@fmt.Name</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="mt-4 flex items-baseline justify-between">
                    <span class="text-2xl font-bold tabular-nums">$@_currentFormat.Price.ToString("F2")</span>
                    <span class="text-sm text-muted-foreground">@_currentFormat.Name</span>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 h-4 w-4" />
                    Add to Cart
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    Read Sample
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record Format(string Id, string Name, double Price, string IconName);

    private record Product(
        string Title,
        string Author,
        string Image,
        double Rating,
        int ReviewCount,
        string Category,
        int Pages,
        string PublishDate,
        string Description,
        Format[] Formats
    );

    private static readonly Product _product = new(
        Title: "The Design of Everyday Things",
        Author: "Don Norman",
        Image: "https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=400&q=80",
        Rating: 4.6,
        ReviewCount: 2847,
        Category: "Design",
        Pages: 368,
        PublishDate: "2013",
        Description: "A powerful primer on how—and why—some products satisfy customers while others only frustrate them.",
        Formats: [
            new Format("hardcover", "Hardcover", 29.99, "book"),
            new Format("paperback", "Paperback", 18.99, "book-open"),
            new Format("ebook", "eBook", 12.99, "tablet"),
        ]
    );

    private string _selectedFormat = "paperback";

    private Format _currentFormat => _product.Formats.FirstOrDefault(f => f.Id == _selectedFormat) ?? _product.Formats[1];
}
