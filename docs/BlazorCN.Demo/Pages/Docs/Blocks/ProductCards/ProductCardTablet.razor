@* ============================================================
   Block: product-card-tablet
   Title: ProductCardTablet
   Description: Tablet product card with accessory bundles and configuration options for electronics stores
   Source: original/blocks/product-cards/product-card-tablet.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[180px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="monitor" Size="64" Class="size-16 text-muted-foreground/20" />
            <BadgeCn Class="absolute top-3 left-3">M4 Chip</BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Apple</p>
            <h3 class="text-sm font-medium">iPad Pro 13-inch</h3>
            <p class="mt-1 text-xs text-muted-foreground">
                Ultra Retina XDR &middot; ProMotion &middot; 120Hz
            </p>
            <p class="mt-2 text-2xl font-semibold tabular-nums">$@_totalPrice</p>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">STORAGE</p>
            <div class="grid grid-cols-4 gap-1.5">
                @foreach (var opt in _storage)
                {
                    var storageOpt = opt;
                    <button type="button"
                            class="@Cn.Merge("rounded-md border p-2 text-center transition-colors", _selectedStorage == storageOpt.Size ? "border-foreground bg-foreground text-background" : "hover:bg-muted/50")"
                            @onclick="@(() => SelectStorage(storageOpt.Size))">
                        <p class="text-xs font-medium">@storageOpt.Size</p>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">CONNECTIVITY</p>
            <div class="flex gap-2">
                @foreach (var opt in _connectivity)
                {
                    var connOpt = opt;
                    <button type="button"
                            class="@Cn.Merge("flex flex-1 items-center justify-center gap-2 rounded-md border p-2 text-center transition-colors", _selectedConnectivity == connOpt.Id ? "border-foreground bg-foreground/5" : "hover:bg-muted/50")"
                            @onclick="@(() => SelectConnectivity(connOpt.Id))">
                        <LucideIconCn Name="wifi" Size="12" Class="size-3 text-muted-foreground" />
                        <div>
                            <p class="text-xs font-medium">@connOpt.Label</p>
                            @if (connOpt.Price > 0)
                            {
                                <p class="text-xs text-muted-foreground">+$@connOpt.Price</p>
                            }
                        </div>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">ADD ACCESSORIES</p>
            <div class="space-y-2">
                @foreach (var acc in _accessories)
                {
                    var accItem = acc;
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <CheckboxCn Id="@($"acc-{accItem.Id}")"
                                        Checked="@(_selectedAccessories.Contains(accItem.Id))"
                                        CheckedChanged="@((bool _) => ToggleAccessory(accItem.Id))" />
                            <label for="@($"acc-{accItem.Id}")" class="cursor-pointer text-xs font-medium">@accItem.Name</label>
                        </div>
                        <span class="text-xs text-muted-foreground tabular-nums">+$@accItem.Price</span>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart &mdash; $@_totalPrice
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record StorageOption(string Size, int Price);
    private record ConnectivityOption(string Id, string Label, int Price);
    private record AccessoryOption(string Id, string Name, int Price);

    private static readonly StorageOption[] _storage =
    [
        new("128GB", 799),
        new("256GB", 899),
        new("512GB", 1099),
        new("1TB",   1299),
    ];

    private static readonly ConnectivityOption[] _connectivity =
    [
        new("wifi",     "Wi-Fi",            0),
        new("cellular", "Wi-Fi + Cellular", 150),
    ];

    private static readonly AccessoryOption[] _accessories =
    [
        new("pencil",   "Smart Pencil Pro",   129),
        new("keyboard", "Magic Keyboard",     299),
        new("case",     "Smart Folio Case",    79),
    ];

    private string _selectedStorage = "256GB";
    private string _selectedConnectivity = "wifi";
    private List<string> _selectedAccessories = [];

    private int _basePrice => _storage.FirstOrDefault(s => s.Size == _selectedStorage)?.Price ?? 799;
    private int _connPrice => _connectivity.FirstOrDefault(c => c.Id == _selectedConnectivity)?.Price ?? 0;
    private int _accPrice => _selectedAccessories.Sum(id => _accessories.FirstOrDefault(a => a.Id == id)?.Price ?? 0);
    private int _totalPrice => _basePrice + _connPrice + _accPrice;

    private void SelectStorage(string size) => _selectedStorage = size;
    private void SelectConnectivity(string id) => _selectedConnectivity = id;

    private void ToggleAccessory(string id)
    {
        if (_selectedAccessories.Contains(id))
            _selectedAccessories.Remove(id);
        else
            _selectedAccessories.Add(id);
    }
}
