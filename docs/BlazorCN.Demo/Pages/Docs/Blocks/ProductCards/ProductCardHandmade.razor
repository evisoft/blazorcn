@* ============================================================
   Block: product-card-handmade
   Title: ProductCardHandmade
   Description: Handmade artisan product card with maker profile, craft process, and customization for React stores
   Source: original/blocks/product-cards/product-card-handmade.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Image *@
        <div class="relative flex h-[220px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="hammer" Size="64" Class="size-16 text-muted-foreground/30" />
            <BadgeCn Class="absolute top-3 left-3">
                <LucideIconCn Name="heart" Size="12" Class="mr-1 size-3" />
                Handmade
            </BadgeCn>
            @if (_product.MadeToOrder)
            {
                <BadgeCn Class="absolute top-3 right-3" Variant="BadgeVariant.Secondary">
                    Made to order
                </BadgeCn>
            }
        </div>

        @* Product info *@
        <div class="border-t px-4 py-3">
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <p class="mt-1 text-2xl font-semibold tabular-nums">$@_product.Price</p>
        </div>

        @* Maker profile *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted/50 text-sm font-medium">
                    @_makerInitials
                </div>
                <div>
                    <p class="text-sm font-medium">@_product.Maker.Name</p>
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <div class="flex items-center gap-1">
                            <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                            <span>@_product.Maker.Location</span>
                        </div>
                        <span>·</span>
                        <span>@_product.Maker.YearsExperience years</span>
                    </div>
                </div>
            </div>
            <p class="mt-1.5 text-xs text-muted-foreground">
                @_product.Maker.ItemsMade.ToString("N0") items crafted
            </p>
        </div>

        @* Craft process *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">CRAFT PROCESS</p>
            <div class="flex flex-wrap gap-1">
                @for (var i = 0; i < _product.Process.Length; i++)
                {
                    var step = _product.Process[i];
                    var idx = i;
                    <div class="flex items-center">
                        <span class="rounded-full bg-muted/50 px-2 py-0.5 text-xs">@step</span>
                        @if (idx < _product.Process.Length - 1)
                        {
                            <span class="mx-0.5 text-xs text-muted-foreground/40">@("→")</span>
                        }
                    </div>
                }
            </div>
        </div>

        @* Materials *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">MATERIALS</p>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var material in _product.Materials)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@material</BadgeCn>
                }
            </div>
        </div>

        @* Timing *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-4 text-xs text-muted-foreground">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                    <span>@_product.CraftTime</span>
                </div>
                <span>·</span>
                <span>Ships in @_product.LeadTime</span>
            </div>
        </div>

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Order Now
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record MakerInfo(string Name, string Location, int YearsExperience, int ItemsMade);
    private record HandmadeProduct(string Name, int Price, MakerInfo Maker, string CraftTime, string LeadTime, string[] Materials, string[] Process, bool MadeToOrder);

    private static readonly HandmadeProduct _product = new(
        Name: "Hand-Thrown Ceramic Mug",
        Price: 45,
        Maker: new MakerInfo(
            Name: "Elena Vasquez",
            Location: "Oaxaca, Mexico",
            YearsExperience: 12,
            ItemsMade: 3400
        ),
        CraftTime: "3–4 hours per piece",
        LeadTime: "7–10 days",
        Materials: ["Local stoneware clay", "Food-safe glaze", "Natural pigments"],
        Process: ["Wedging clay", "Wheel throwing", "Trimming", "Bisque firing", "Glazing", "Final firing"],
        MadeToOrder: true
    );

    private string _makerInitials => string.Concat(
        _product.Maker.Name.Split(' ', System.StringSplitOptions.RemoveEmptyEntries)
            .Select(n => n[0])
    );
}
