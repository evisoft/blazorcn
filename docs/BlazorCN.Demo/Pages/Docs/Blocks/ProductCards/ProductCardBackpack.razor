@* ============================================================
   Block: product-card-backpack
   Title: ProductCardBackpack
   Description: Travel backpack product card with compartment details and capacity specs for outdoor stores
   Source: original/blocks/product-cards/product-card-backpack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[200px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Travel Ready</BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Peak Design</p>
            <h3 class="text-sm font-medium">Travel Backpack @_selectedSizeObj.Volume</h3>
            <div class="mt-2 flex items-end justify-between">
                <p class="text-2xl font-semibold tabular-nums">$@_selectedSizeObj.Price</p>
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <LucideIconCn Name="weight" Size="12" Class="size-3" />
                    <span>1.56 kg</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">
                COLOR &middot; <span class="text-foreground">@_selectedColor</span>
            </p>
            <div class="flex gap-2">
                @foreach (var c in _colors)
                {
                    var color = c;
                    <button
                        type="button"
                        class="@Cn.Merge("size-7 rounded-full border-2 transition-all", _selectedColor == color.Name ? "border-foreground ring-2 ring-foreground/20" : "border-border")"
                        style="@($"background-color:{color.Value}")"
                        @onclick="@(() => _selectedColor = color.Name)"
                        title="@color.Name">
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">CAPACITY</p>
            <div class="grid grid-cols-3 gap-1.5">
                @foreach (var s in _sizes)
                {
                    var sz = s;
                    <button
                        type="button"
                        class="@Cn.Merge("rounded-md border p-2 text-center transition-colors", _selectedSize == sz.Id ? "border-foreground bg-foreground/5" : "hover:bg-muted/50")"
                        @onclick="@(() => _selectedSize = sz.Id)">
                        <p class="text-xs font-medium">@sz.Volume</p>
                        <p class="text-xs text-muted-foreground">@sz.Label</p>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">COMPARTMENTS</p>
            <div class="space-y-1.5">
                @foreach (var comp in _compartments)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="font-medium">@comp.Name</span>
                        <span class="text-muted-foreground">@comp.Fits</span>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex gap-3">
                <div class="flex items-center gap-1.5 text-xs">
                    <LucideIconCn Name="plane" Size="12" Class="size-3 text-muted-foreground" />
                    <span>Carry-on approved</span>
                </div>
                <div class="flex items-center gap-1.5 text-xs">
                    <LucideIconCn Name="laptop" Size="12" Class="size-3 text-muted-foreground" />
                    <span>16" laptop</span>
                </div>
                <div class="flex items-center gap-1.5 text-xs">
                    <LucideIconCn Name="shield" Size="12" Class="size-3 text-muted-foreground" />
                    <span>Lifetime warranty</span>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SizeOption(string Id, string Label, string Volume, int Price);
    private record CompartmentItem(string Name, string Fits);
    private record ColorOption(string Name, string Value);

    private static readonly SizeOption[] _sizes =
    [
        new("25L", "Day Pack", "25L", 129),
        new("35L", "Weekend", "35L", 169),
        new("45L", "Travel", "45L", 199),
    ];

    private static readonly CompartmentItem[] _compartments =
    [
        new("Main", "Clothes, gear, shoes"),
        new("Laptop Sleeve", "Up to 16\" laptop"),
        new("Tech Organizer", "Cables, chargers, mouse"),
        new("Quick Access", "Passport, phone, wallet"),
        new("Water Bottle", "2x side pockets"),
    ];

    private static readonly ColorOption[] _colors =
    [
        new("Black", "#1a1a1a"),
        new("Navy", "#1e3a5f"),
        new("Forest", "#2d4a3e"),
    ];

    private string _selectedSize = "35L";
    private string _selectedColor = "Black";

    private SizeOption _selectedSizeObj => Array.Find(_sizes, s => s.Id == _selectedSize) ?? _sizes[1];
}
