@* ============================================================
   Block: product-card-course
   Title: ProductCardCourse
   Description: Course product card with curriculum preview and instructor info for React education sites
   Source: original/blocks/product-cards/product-card-course.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <div class="absolute inset-0 flex items-center justify-center bg-black/20">
                    <button
                        type="button"
                        class="flex h-12 w-12 items-center justify-center rounded-full bg-background/90" aria-label="Play course preview">
                        <LucideIconCn Name="play" Size="20" Class="h-5 w-5 fill-current" />
                    </button>
                </div>
                <BadgeCn Class="absolute top-3 left-3">@_product.Level</BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h2 class="font-semibold leading-tight">@_product.Name</h2>
                <p class="mt-1 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                @* Instructor *@
                <div class="mt-3 flex items-center gap-2">
                    <AvatarCn Class="h-8 w-8">
                        <AvatarImageCn Src="@_product.Instructor.Avatar" Alt="" />
                        <AvatarFallbackCn>@_product.Instructor.Name[0]</AvatarFallbackCn>
                    </AvatarCn>
                    <div>
                        <p class="text-sm font-medium">@_product.Instructor.Name</p>
                        <p class="text-xs text-muted-foreground">@_product.Instructor.Title</p>
                    </div>
                </div>

                @* Stats *@
                <div class="mt-3 flex items-center gap-3 text-xs text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="star" Size="12" Class="h-3 w-3 fill-primary text-primary" />
                        <span class="font-medium text-foreground">@_product.Rating</span>
                        <span>(@(_product.ReviewCount))</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="users" Size="12" Class="h-3 w-3" />
                        <span>@(_product.StudentsEnrolled.ToString("N0"))</span>
                    </div>
                </div>

                <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                        <span>@_product.Duration</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="book-open" Size="12" Class="h-3 w-3" />
                        <span>@(_product.LessonsCount) lessons</span>
                    </div>
                </div>

                @* Curriculum preview *@
                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">CURRICULUM PREVIEW</p>
                    <div class="space-y-1.5">
                        @for (int i = 0; i < _product.Curriculum.Length; i++)
                        {
                            var index = i;
                            var item = _product.Curriculum[i];
                            <div class="flex items-center gap-2" key="@index">
                                <div class="flex h-5 w-5 items-center justify-center rounded-full border text-xs">
                                    @(index + 1)
                                </div>
                                <span class="text-xs">@item</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4 flex items-baseline justify-between">
                    <span class="text-2xl font-bold tabular-nums">$@_product.Price</span>
                    <span class="text-xs text-muted-foreground">Lifetime access</span>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full">Enroll Now</ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">Preview Course</ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record InstructorInfo(string Name, string Avatar, string Title);

    private record ProductInfo(
        string Name,
        string Description,
        int Price,
        string Image,
        double Rating,
        int ReviewCount,
        int StudentsEnrolled,
        string Duration,
        int LessonsCount,
        string Level,
        InstructorInfo Instructor,
        string[] Curriculum
    );

    private static readonly ProductInfo _product = new(
        Name: "Complete React Development",
        Description: "Master React from basics to advanced patterns with real-world projects.",
        Price: 89,
        Image: "https://images.unsplash.com/photo-1633356122544-f134324a6cee?w=400&q=80",
        Rating: 4.8,
        ReviewCount: 1247,
        StudentsEnrolled: 15420,
        Duration: "24 hours",
        LessonsCount: 156,
        Level: "All Levels",
        Instructor: new InstructorInfo(
            Name: "Alex Chen",
            Avatar: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&q=80",
            Title: "Senior Software Engineer"
        ),
        Curriculum: [
            "React Fundamentals & JSX",
            "Hooks & State Management",
            "Advanced Patterns",
            "Testing & Deployment",
        ]
    );
}
