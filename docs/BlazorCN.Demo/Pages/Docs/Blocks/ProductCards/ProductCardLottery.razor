@* ============================================================
   Block: product-card-lottery
   Title: ProductCardLottery
   Description: Lottery ticket card with number picker, draw countdown, and jackpot display for React gaming sites
   Source: original/blocks/product-cards/product-card-lottery.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            @* Jackpot header *@
            <div class="border-b p-4 text-center">
                <div class="flex items-center justify-center gap-2">
                    <LucideIconCn Name="sparkles" Size="20" Class="h-5 w-5 text-primary" />
                    <span class="text-sm font-medium text-muted-foreground">ESTIMATED JACKPOT</span>
                </div>
                <p class="mt-1 text-4xl font-bold tracking-tight tabular-nums">
                    @FormatJackpot(_jackpot)
                </p>
                <p class="text-sm text-muted-foreground">@_name</p>
            </div>

            <CardContentCn Class="p-4">
                @* Countdown *@
                <div class="flex items-center justify-center gap-1 text-sm">
                    <LucideIconCn Name="timer" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    <span class="text-muted-foreground">Next draw in</span>
                    <span class="font-medium tabular-nums">
                        @_timeLeft.Days d @_timeLeft.Hours h @_timeLeft.Minutes m
                    </span>
                </div>

                <hr class="my-4 border-t" />

                @* Number picker *@
                <div>
                    <div class="mb-2 flex items-center justify-between">
                        <p class="text-xs font-medium text-muted-foreground">
                            SELECT @_numbersToSelect NUMBERS
                        </p>
                        <BadgeCn Class="text-xs tabular-nums" Variant="BadgeVariant.Outline">
                            @_selectedNumbers.Count/@_numbersToSelect
                        </BadgeCn>
                    </div>

                    <div class="grid grid-cols-7 gap-1">
                        @foreach (var num in Enumerable.Range(1, _maxNumber))
                        {
                            var n = num;
                            var isSelected = _selectedNumbers.Contains(n);
                            var isDisabled = !isSelected && _selectedNumbers.Count >= _numbersToSelect;
                            <button
                                type="button"
                                class="@Cn.Merge("flex h-8 w-8 items-center justify-center rounded-full text-xs font-medium transition-colors", isSelected ? "bg-primary text-primary-foreground" : "border hover:border-primary hover:text-primary disabled:opacity-50 disabled:hover:border-border disabled:hover:text-foreground")"
                                disabled="@(isDisabled ? "disabled" : null)"
                                @onclick="@(() => ToggleNumber(n))">
                                @n
                            </button>
                        }
                    </div>

                    @* Selected numbers display *@
                    <div class="mt-3 flex items-center justify-center gap-2">
                        @foreach (var i in Enumerable.Range(0, _numbersToSelect))
                        {
                            var idx = i;
                            var hasNum = idx < _selectedNumbers.Count;
                            <div class="@Cn.Merge("flex h-9 w-9 items-center justify-center rounded-full border-2 text-sm font-semibold", hasNum ? "border-primary bg-primary/10" : "border-dashed")">
                                @(hasNum ? _selectedNumbers[idx].ToString() : "")
                            </div>
                        }
                    </div>
                </div>

                @* Quick pick *@
                <ButtonCn Class="mt-3 w-full" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="QuickPick">
                    <LucideIconCn Name="zap" Size="12" Class="mr-2 h-3 w-3" />
                    Quick Pick
                </ButtonCn>

                @* Last winning numbers *@
                <div class="mt-4 rounded-lg border p-2">
                    <p class="text-xs text-muted-foreground">Last winning numbers</p>
                    <div class="mt-1 flex gap-1">
                        @foreach (var num in _lastWinningNumbers)
                        {
                            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                @num
                            </span>
                        }
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <div class="flex w-full items-center justify-between text-sm">
                    <span class="text-muted-foreground">Ticket price</span>
                    <span class="font-semibold">$@_ticketPrice.ToString("0.00")</span>
                </div>
                <ButtonCn Class="w-full" Disabled="@(_selectedNumbers.Count < _numbersToSelect)">
                    <LucideIconCn Name="ticket" Size="16" Class="mr-2 h-4 w-4" />
                    Buy Ticket
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record TimeLeft(int Days, int Hours, int Minutes);

    // Product constants
    private const string _name = "Mega Millions";
    private const int _jackpot = 425_000_000;
    private const int _ticketPrice = 2;
    private const int _numbersToSelect = 6;
    private const int _maxNumber = 49;
    private static readonly int[] _lastWinningNumbers = [7, 14, 21, 35, 42, 49];

    private List<int> _selectedNumbers = [];
    private TimeLeft _timeLeft = new(2, 5, 0);

    private static string FormatJackpot(long amount)
    {
        if (amount >= 1_000_000_000)
            return $"${(amount / 1_000_000_000.0):0.0}B";
        return $"${(amount / 1_000_000.0):0}M";
    }

    private void ToggleNumber(int num)
    {
        if (_selectedNumbers.Contains(num))
        {
            _selectedNumbers.Remove(num);
        }
        else if (_selectedNumbers.Count < _numbersToSelect)
        {
            _selectedNumbers.Add(num);
            _selectedNumbers.Sort();
        }
    }

    private void QuickPick()
    {
        var rng = new Random();
        var numbers = new List<int>();
        while (numbers.Count < _numbersToSelect)
        {
            var n = rng.Next(1, _maxNumber + 1);
            if (!numbers.Contains(n))
                numbers.Add(n);
        }
        numbers.Sort();
        _selectedNumbers = numbers;
    }
}
