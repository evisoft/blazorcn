@* ============================================================
   Block: product-card-concert-ticket
   Title: ProductCardConcertTicket
   Description: Concert ticket card with seat selection, venue map preview, and pricing tiers for React ticketing apps
   Source: original/blocks/product-cards/product-card-concert-ticket.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[340px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[160px]">
                <img
                    alt="@_product.Artist"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                <div class="absolute bottom-3 left-3 right-3">
                    <BadgeCn Class="mb-1">
                        <LucideIconCn Name="music" Size="12" Class="mr-1 h-3 w-3" />
                        Concert
                    </BadgeCn>
                    <h3 class="font-bold text-white">@_product.Artist</h3>
                    <p class="text-sm text-white/80">@_product.Tour</p>
                </div>
            </div>

            <CardContentCn Class="p-4">
                @* Event details *@
                <div class="flex flex-wrap gap-3 text-sm">
                    <div class="flex items-center gap-1.5 text-muted-foreground">
                        <LucideIconCn Name="calendar" Size="16" Class="h-4 w-4" />
                        <span>@_product.Date</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-muted-foreground">
                        <LucideIconCn Name="clock" Size="16" Class="h-4 w-4" />
                        <span>@_product.Time</span>
                    </div>
                </div>
                <div class="mt-2 flex items-center gap-1.5 text-sm text-muted-foreground">
                    <LucideIconCn Name="map-pin" Size="16" Class="h-4 w-4 shrink-0" />
                    <span>@_product.Venue, @_product.City</span>
                </div>

                <SeparatorCn Class="my-4" />

                @* Seating tier selection *@
                <div>
                    <LabelCn Class="text-xs font-medium text-muted-foreground">SELECT SECTION</LabelCn>
                    <div class="mt-2 space-y-2">
                        @foreach (var tier in _product.Tiers)
                        {
                            var t = tier;
                            <label
                                class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-lg border p-3 transition-colors hover:bg-muted/50", _selectedTier == t.Id ? "border-primary bg-muted/50" : "")"
                                for="@t.Id">
                                <div class="flex items-center gap-3">
                                    <input
                                        type="radio"
                                        id="@t.Id"
                                        name="seating-tier"
                                        value="@t.Id"
                                        checked="@(_selectedTier == t.Id ? "checked" : null)"
                                        @onclick="@(() => _selectedTier = t.Id)"
                                        class="h-4 w-4 accent-primary" />
                                    <div>
                                        <p class="font-medium">@t.Name</p>
                                        <p class="text-xs text-muted-foreground">@t.Description</p>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <p class="font-semibold tabular-nums">$@t.Price</p>
                                    <p class="text-xs text-muted-foreground">@t.Available left</p>
                                </div>
                            </label>
                        }
                    </div>
                </div>

                @* Quantity selector *@
                <div class="mt-4 flex items-center justify-between">
                    <LabelCn Class="text-sm font-medium">Tickets</LabelCn>
                    <div class="flex items-center gap-2">
                        <ButtonCn
                            Class="h-8 w-8"
                            Disabled="@(_quantity <= 1)"
                            Size="ButtonSize.Icon"
                            Variant="ButtonVariant.Outline"
                            OnClick="@(() => _quantity = Math.Max(1, _quantity - 1))">
                            <LucideIconCn Name="minus" Size="12" Class="h-3 w-3" />
                        </ButtonCn>
                        <span class="w-8 text-center font-medium tabular-nums">@_quantity</span>
                        <ButtonCn
                            Class="h-8 w-8"
                            Disabled="@(_quantity >= 8 || _quantity >= _currentTier.Available)"
                            Size="ButtonSize.Icon"
                            Variant="ButtonVariant.Outline"
                            OnClick="@(() => _quantity = Math.Min(8, _quantity + 1))">
                            <LucideIconCn Name="plus" Size="12" Class="h-3 w-3" />
                        </ButtonCn>
                    </div>
                </div>

                @* Price breakdown *@
                <div class="mt-4 space-y-1 rounded-lg border p-3 text-sm">
                    <div class="flex justify-between">
                        <span class="text-muted-foreground">@_quantity @("×") $@_currentTier.Price</span>
                        <span class="tabular-nums">$@_subtotal.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-muted-foreground">Service fee</span>
                        <span class="tabular-nums">$@_serviceFee.ToString("F2")</span>
                    </div>
                    <SeparatorCn Class="my-2" />
                    <div class="flex justify-between font-semibold">
                        <span>Total</span>
                        <span class="tabular-nums">$@_total.ToString("F2")</span>
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full" Disabled="@(_currentTier.Available == 0)">
                    <LucideIconCn Name="ticket" Size="16" Class="mr-2 h-4 w-4" />
                    Get Tickets
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record SeatingTier(string Id, string Name, int Price, int Available, string Description);

    private record Product(
        string Artist,
        string Tour,
        string Image,
        string Date,
        string Time,
        string Venue,
        string City,
        SeatingTier[] Tiers,
        int ServiceFeePercent);

    private static readonly Product _product = new(
        "Arctic Monkeys",
        "The Car World Tour",
        "https://images.unsplash.com/photo-1540039155733-5bb30b53aa14?w=400&q=80",
        "Mar 15, 2025",
        "8:00 PM",
        "Madison Square Garden",
        "New York, NY",
        [
            new("floor", "Floor", 250, 12, "Standing, closest to stage"),
            new("lower", "Lower Bowl", 175, 48, "Sections 101-120"),
            new("upper", "Upper Bowl", 85, 156, "Sections 201-220"),
        ],
        15);

    private string _selectedTier = "lower";
    private int _quantity = 2;

    private SeatingTier _currentTier => Array.Find(_product.Tiers, t => t.Id == _selectedTier) ?? _product.Tiers[0];
    private double _subtotal => _currentTier.Price * _quantity;
    private double _serviceFee => _subtotal * (_product.ServiceFeePercent / 100.0);
    private double _total => _subtotal + _serviceFee;
}
