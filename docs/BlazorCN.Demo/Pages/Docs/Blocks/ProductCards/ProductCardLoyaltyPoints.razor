@* ============================================================
   Block: product-card-loyalty-points
   Title: ProductCardLoyaltyPoints
   Description: Product card showing loyalty points earned, points balance, and redeem option for React ecommerce
   Source: original/blocks/product-cards/product-card-loyalty-points.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Image *@
        <div class="relative flex h-[200px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="shopping-cart" Size="64" Class="size-16 text-muted-foreground/30" />
            <BadgeCn Class="absolute top-3 left-3">
                <LucideIconCn Name="star" Size="12" Class="mr-1 size-3" />
                @_product.PointsMultiplier@("x") Points
            </BadgeCn>
        </div>

        @* Product info *@
        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">@_product.Brand</p>
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <p class="mt-1 text-2xl font-semibold tabular-nums">$@_product.Price</p>
        </div>

        @* Points earned *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="award" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <p class="text-xs font-medium">Earn @_product.PointsEarned points</p>
                        <p class="text-xs text-muted-foreground">
                            @_product.PointsMultiplier@("x") multiplier — @_product.Tier tier
                        </p>
                    </div>
                </div>
                <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground" />
            </div>
        </div>

        @* Points balance *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-muted-foreground">Your points balance</p>
                    <p class="text-sm font-medium tabular-nums">
                        @_userLoyalty.Balance.ToString("N0") pts
                    </p>
                    <p class="text-xs text-muted-foreground">
                        Worth $@(((double)(_userLoyalty.Balance * _userLoyalty.PointsValue) / 100).ToString("F2"))
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                    @_product.Tier
                </BadgeCn>
            </div>
        </div>

        @* Redeem points toggle *@
        <div class="border-t px-4 py-3">
            <div class="flex cursor-pointer items-center justify-between">
                <span class="text-xs font-medium">Pay with points</span>
                <div
                    @onclick="HandlePointsToggle"
                    role="switch"
                    tabindex="0"
                    aria-checked="@_usePoints.ToString().ToLower()"
                    class="@Cn.Merge("relative h-5 w-9 cursor-pointer rounded-full transition-colors", _usePoints ? "bg-foreground" : "bg-muted")">
                    <div class="@Cn.Merge("absolute top-0.5 size-4 rounded-full bg-background transition-transform", _usePoints ? "translate-x-4" : "translate-x-0.5")"></div>
                </div>
            </div>

            @if (_usePoints)
            {
                <div class="mt-3">
                    <input
                        type="range"
                        min="0"
                        max="@_maxRedeemablePoints"
                        step="100"
                        value="@_pointsToUse"
                        @oninput="@((ChangeEventArgs e) => _pointsToUse = int.Parse(e.Value?.ToString() ?? "0"))"
                        class="w-full accent-foreground" />
                    <div class="mt-1 flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">0 pts</span>
                        <span class="font-medium tabular-nums">
                            @_pointsToUse.ToString("N0") pts = $@PointsDollarValue.ToString("F2")
                        </span>
                        <span class="text-muted-foreground">
                            @_maxRedeemablePoints.ToString("N0") pts
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Pricing summary *@
        @if (_usePoints && _pointsToUse > 0)
        {
            <div class="border-t px-4 py-3">
                <div class="space-y-1">
                    <div class="flex justify-between text-xs">
                        <span class="text-muted-foreground">Product price</span>
                        <span class="tabular-nums">$@((decimal)_product.Price).ToString("F2")</span>
                    </div>
                    <div class="flex justify-between text-xs">
                        <span class="text-muted-foreground">Points discount</span>
                        <span class="font-medium text-emerald-600 tabular-nums">
                            -$@PointsDollarValue.ToString("F2")
                        </span>
                    </div>
                    <div class="flex justify-between border-t pt-1 text-sm font-medium">
                        <span>You pay</span>
                        <span class="tabular-nums">$@CashPrice.ToString("F2")</span>
                    </div>
                </div>
            </div>
        }

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                @if (_usePoints && _pointsToUse > 0)
                {
                    @($"Add to Cart — ${CashPrice:F2} + {_pointsToUse:N0} pts")
                }
                else
                {
                    @("Add to Cart")
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record LoyaltyProduct(
        string Name,
        string Brand,
        int Price,
        int PointsEarned,
        int PointsMultiplier,
        string Tier);

    private record UserLoyalty(
        int Balance,
        int PointsValue);

    private static readonly LoyaltyProduct _product = new(
        "Premium Running Shoes",
        "StrideMax",
        149,
        298,
        2,
        "Gold");

    private static readonly UserLoyalty _userLoyalty = new(
        Balance: 4520,
        PointsValue: 1);

    private bool _usePoints = false;
    private int _pointsToUse = 0;

    private int _maxRedeemablePoints =>
        Math.Min(_userLoyalty.Balance, _product.Price * (100 / _userLoyalty.PointsValue));

    private double PointsDollarValue =>
        (_pointsToUse * (double)_userLoyalty.PointsValue) / 100;

    private double CashPrice =>
        _product.Price - PointsDollarValue;

    private void HandlePointsToggle()
    {
        _usePoints = !_usePoints;
        if (!_usePoints)
        {
            _pointsToUse = 0;
        }
    }
}
