@* ============================================================
   Block: product-card-refurbished
   Title: ProductCardRefurbished
   Description: Certified refurbished product card with condition grade, warranty info, and savings for React stores
   Source: original/blocks/product-cards/product-card-refurbished.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Image *@
        <div class="relative flex h-[200px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="recycle" Size="64" Class="size-16 text-muted-foreground/30" />
            <BadgeCn Class="absolute top-3 left-3">Certified Refurbished</BadgeCn>
            <BadgeCn Class="absolute top-3 right-3" Variant="BadgeVariant.Secondary">
                Save @_savingsPercent%
            </BadgeCn>
        </div>

        @* Title and price *@
        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">@_product.Brand</p>
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <div class="mt-1 flex items-baseline gap-2">
                <span class="text-2xl font-semibold tabular-nums">$@_product.RefurbPrice</span>
                <span class="text-sm text-muted-foreground line-through tabular-nums">
                    $@_product.NewPrice
                </span>
            </div>
            <p class="mt-0.5 text-xs text-emerald-600 font-medium">Save $@_savings vs new</p>
        </div>

        @* Condition *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-muted-foreground">CONDITION</p>
                    <p class="text-sm font-medium">@_product.ConditionGrade</p>
                </div>
                <div class="text-right">
                    <p class="text-xs text-muted-foreground">Cosmetic</p>
                    <p class="text-sm font-medium tabular-nums">
                        @_product.CosmeticRating/@_product.MaxCosmeticRating
                    </p>
                </div>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">@_product.ConditionDescription</p>
        </div>

        @* Inspection checklist *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">INSPECTION REPORT</p>
            <div class="space-y-1.5">
                @foreach (var point in _product.InspectionPoints)
                {
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600" />
                            <span class="text-xs">@point.Label</span>
                        </div>
                        <span class="text-xs text-muted-foreground">@point.Status</span>
                    </div>
                }
            </div>
        </div>

        @* Warranty and certification *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium">@_product.Warranty</span>
                </div>
                <span class="text-xs text-muted-foreground">by @_product.CertifiedBy</span>
            </div>
        </div>

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record InspectionPoint(string Label, string Status);

    private record RefurbishedProduct(
        string Name,
        string Brand,
        int RefurbPrice,
        int NewPrice,
        string ConditionGrade,
        string ConditionDescription,
        string Warranty,
        InspectionPoint[] InspectionPoints,
        int CosmeticRating,
        int MaxCosmeticRating,
        string CertifiedBy
    );

    private static readonly RefurbishedProduct _product = new(
        Name: "MacBook Pro 14\" M2 Pro",
        Brand: "Apple",
        RefurbPrice: 1399,
        NewPrice: 1999,
        ConditionGrade: "Excellent",
        ConditionDescription: "Minor signs of use. Fully tested and factory reset.",
        Warranty: "12-month warranty",
        InspectionPoints:
        [
            new("Display", "Flawless"),
            new("Battery health", "92%"),
            new("Keyboard", "Fully functional"),
            new("Ports", "All working"),
            new("Speakers", "Fully functional"),
        ],
        CosmeticRating: 9,
        MaxCosmeticRating: 10,
        CertifiedBy: "TechRenew Labs"
    );

    private int _savings => _product.NewPrice - _product.RefurbPrice;
    private int _savingsPercent => (int)Math.Round((double)_savings / _product.NewPrice * 100);
}
