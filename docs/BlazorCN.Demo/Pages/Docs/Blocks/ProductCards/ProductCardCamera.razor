@* ============================================================
   Block: product-card-camera
   Title: ProductCardCamera
   Description: Camera product card with sensor specs, ISO range, and sample images for photography stores
   Source: original/blocks/product-cards/product-card-camera.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[200px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Mirrorless</BadgeCn>
            <div class="absolute bottom-3 right-3">
                <BadgeCn Variant="BadgeVariant.Secondary">Body Only</BadgeCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Nikon Z Series</p>
            <h3 class="text-sm font-medium">Z8 Mirrorless Camera</h3>
            <div class="mt-2 flex items-end justify-between">
                <p class="text-2xl font-semibold tabular-nums">$3,999</p>
                <p class="text-xs text-muted-foreground">Z Mount &middot; 2024 Release</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">SPECIFICATIONS</p>
            <div class="space-y-2">
                @foreach (var spec in _specs)
                {
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="@spec.Icon" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                        <span class="w-16 shrink-0 text-xs text-muted-foreground">@spec.Label</span>
                        <span class="text-xs font-medium">@spec.Value</span>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">SAMPLE SHOTS</p>
            <div class="grid grid-cols-3 gap-2">
                @foreach (var shot in _sampleShots)
                {
                    <div class="text-center">
                        <div class="flex aspect-square items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/30" />
                        </div>
                        <p class="mt-1 text-xs font-medium">@shot.Label</p>
                        <p class="font-mono text-xs text-muted-foreground">@shot.Settings</p>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Weather Sealed</span>
                <span class="font-medium">Yes</span>
            </div>
            <div class="mt-1 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Weight (body)</span>
                <span class="font-medium">910g</span>
            </div>
            <div class="mt-1 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Viewfinder</span>
                <span class="font-medium">3.69M-dot OLED EVF</span>
            </div>
        </div>

        <div class="flex gap-2 px-4 py-3">
            <ButtonCn Class="flex-1">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1">
                Add Kit Lens +$599
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SpecItem(string Icon, string Label, string Value);
    private record SampleShot(string Label, string Settings);

    private static readonly SpecItem[] _specs =
    [
        new("aperture", "Sensor", "45.7MP Full-Frame CMOS"),
        new("focus", "AF Points", "493 Phase-Detect"),
        new("zap", "ISO Range", "64 - 25,600 (exp. 32 - 102,400)"),
        new("film", "Burst", "20 fps electronic shutter"),
        new("video", "Video", "8K 30p / 4K 120p"),
    ];

    private static readonly SampleShot[] _sampleShots =
    [
        new("Portrait", "f/1.8 · 1/250s · ISO 100"),
        new("Landscape", "f/11 · 1/60s · ISO 200"),
        new("Action", "f/4 · 1/2000s · ISO 800"),
    ];
}
