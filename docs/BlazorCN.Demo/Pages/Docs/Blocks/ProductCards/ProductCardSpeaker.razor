@* ============================================================
   Block: product-card-speaker
   Title: ProductCardSpeaker
   Description: Bluetooth speaker product card with audio profile and waterproof rating for audio stores
   Source: original/blocks/product-cards/product-card-speaker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Image placeholder *@
        <div class="relative flex h-[180px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Best Seller</BadgeCn>
        </div>

        @* Brand, name, price *@
        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">JBL</p>
            <h3 class="text-sm font-medium">Charge 6 Portable Speaker</h3>
            <p class="mt-2 text-2xl font-semibold tabular-nums">$179</p>
        </div>

        @* Color selector *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">
                COLOR &middot; <span class="text-foreground">@_selectedColor</span>
            </p>
            <div class="flex gap-2">
                @foreach (var c in _colors)
                {
                    var color = c;
                    <button
                        type="button"
                        class="@Cn.Merge("size-7 rounded-full border-2 transition-all", _selectedColor == color.Name ? "border-foreground ring-2 ring-foreground/20" : "border-border")"
                        style="@($"background-color:{color.Value}")"
                        @onclick="@(() => _selectedColor = color.Name)"
                        title="@color.Name">
                    </button>
                }
            </div>
        </div>

        @* Audio profile EQ bars *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">AUDIO PROFILE</p>
            <div class="flex items-end justify-center gap-3 py-1">
                @foreach (var bar in _eqBars)
                {
                    <div class="flex flex-col items-center gap-1">
                        <div class="w-4 rounded-sm bg-foreground/80" style="@($"height:{bar.Height * 0.4}px")"></div>
                        <span class="text-xs text-muted-foreground">@bar.Label</span>
                    </div>
                }
            </div>
        </div>

        @* Specs icons *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-2">
                <div class="flex flex-col items-center gap-1 rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="battery" Size="16" Class="size-4 text-muted-foreground" />
                    <p class="text-xs font-medium">24h</p>
                    <p class="text-xs text-muted-foreground">Battery</p>
                </div>
                <div class="flex flex-col items-center gap-1 rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="droplets" Size="16" Class="size-4 text-muted-foreground" />
                    <p class="text-xs font-medium">IP67</p>
                    <p class="text-xs text-muted-foreground">Waterproof</p>
                </div>
                <div class="flex flex-col items-center gap-1 rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="bluetooth" Size="16" Class="size-4 text-muted-foreground" />
                    <p class="text-xs font-medium">BT 5.3</p>
                    <p class="text-xs text-muted-foreground">Wireless</p>
                </div>
            </div>
        </div>

        @* Technical specs list *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Output Power</span>
                <span class="font-medium">30W RMS</span>
            </div>
            <div class="mt-1 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Frequency Range</span>
                <span class="font-medium">60Hz - 20kHz</span>
            </div>
            <div class="mt-1 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Pairing</span>
                <span class="font-medium">PartyBoost (100+ speakers)</span>
            </div>
            <div class="mt-1 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Weight</span>
                <span class="font-medium">955g</span>
            </div>
        </div>

        @* Add to cart *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ColorOption(string Name, string Value);
    private record EqBar(string Label, int Height);

    private static readonly ColorOption[] _colors =
    [
        new("Black", "#1a1a1a"),
        new("Blue",  "#2563eb"),
        new("Green", "#16a34a"),
        new("Red",   "#dc2626"),
        new("Sand",  "#d4a574"),
    ];

    private static readonly EqBar[] _eqBars =
    [
        new("Bass",   85),
        new("Low",    70),
        new("Mid",    55),
        new("High",   65),
        new("Treble", 50),
    ];

    private string _selectedColor = "Black";
}
