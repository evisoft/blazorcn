@* ============================================================
   Block: product-card-yoga-mat
   Title: ProductCardYogaMat
   Description: Yoga mat product card with material details and thickness options for wellness stores
   Source: original/blocks/product-cards/product-card-yoga-mat.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[180px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Eco-Friendly</BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Manduka</p>
            <h3 class="text-sm font-medium">eKO Superlite Yoga Mat</h3>
            <p class="mt-1 text-xs text-muted-foreground">
                Natural tree rubber &middot; Non-toxic &middot; Closed-cell surface
            </p>
            <p class="mt-2 text-2xl font-semibold tabular-nums">$@_currentThickness.Price</p>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">
                COLOR &middot; <span class="text-foreground">@_selectedColor</span>
            </p>
            <div class="flex gap-2">
                @foreach (var c in _colors)
                {
                    var color = c;
                    <button
                        type="button"
                        class="@Cn.Merge("size-7 rounded-full border-2 transition-all", _selectedColor == color.Name ? "border-foreground ring-2 ring-foreground/20" : "border-border")"
                        style="@($"background-color:{color.Value}")"
                        @onclick="@(() => _selectedColor = color.Name)"
                        title="@color.Name">
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">THICKNESS</p>
            <div class="grid grid-cols-3 gap-1.5">
                @foreach (var t in _thickness)
                {
                    var thick = t;
                    <button
                        type="button"
                        class="@Cn.Merge("rounded-md border p-2 text-center transition-colors", _selectedThickness == thick.Id ? "border-foreground bg-foreground/5" : "hover:bg-muted/50")"
                        @onclick="@(() => _selectedThickness = thick.Id)">
                        <p class="text-xs font-medium">@thick.Label</p>
                        <p class="text-xs text-muted-foreground">@thick.Type</p>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">GRIP RATING</p>
            <div class="flex items-center gap-2">
                <div class="flex gap-0.5">
                    @for (var i = 0; i < 5; i++)
                    {
                        var idx = i;
                        <div class="@Cn.Merge("h-3 w-6 rounded-sm", idx < 4 ? "bg-foreground/70" : "bg-muted")"></div>
                    }
                </div>
                <span class="text-xs text-muted-foreground">Excellent (wet &amp; dry)</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="ruler" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">71" x 26"</span>
                </div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="weight" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">@_currentThickness.Weight</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap gap-1">
                @foreach (var tag in _tags)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                        <LucideIconCn Name="leaf" Size="10" Class="mr-1 size-2.5" />
                        @tag
                    </BadgeCn>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ColorOption(string Name, string Value);
    private record ThicknessOption(string Id, string Label, string Type, int Price, string Weight);

    private static readonly ColorOption[] _colors =
    [
        new("Deep Ocean", "#1e3a5f"),
        new("Sage Green", "#6b8f71"),
        new("Dusty Rose", "#c4727f"),
        new("Charcoal", "#374151"),
        new("Sand", "#d4b896"),
    ];

    private static readonly ThicknessOption[] _thickness =
    [
        new("3mm", "3mm", "Travel", 68, "1.5 lbs"),
        new("5mm", "5mm", "Standard", 89, "2.5 lbs"),
        new("6mm", "6mm", "Comfort", 98, "3.0 lbs"),
    ];

    private static readonly string[] _tags = ["OEKO-TEX Certified", "Natural Rubber", "Zero Waste", "Biodegradable"];

    private string _selectedColor = "Deep Ocean";
    private string _selectedThickness = "5mm";

    private ThicknessOption _currentThickness => Array.Find(_thickness, t => t.Id == _selectedThickness) ?? _thickness[1];
}
