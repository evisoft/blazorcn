@* ============================================================
   Block: product-card-flash-sale
   Title: ProductCardFlashSale
   Description: Flash sale product card with countdown timer, original price, stock depletion bar for React ecommerce
   Source: original/blocks/product-cards/product-card-flash-sale.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Flash sale banner *@
        <div class="flex items-center justify-between bg-foreground px-4 py-2 text-background">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="zap" Size="14" Class="size-3.5" />
                <span class="text-xs font-semibold tracking-wider">FLASH SALE</span>
            </div>
            <div class="flex items-center gap-1">
                <span class="text-xs font-medium">Ends in</span>
                <span class="font-mono text-xs font-semibold tabular-nums">
                    @($"{_timeLeft.Hours:D2}:{_timeLeft.Minutes:D2}:{_timeLeft.Seconds:D2}")
                </span>
            </div>
        </div>

        @* Image *@
        <div class="relative flex h-[200px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="flame" Size="64" Class="size-16 text-muted-foreground/30" />
            <BadgeCn Class="absolute top-3 left-3">
                <LucideIconCn Name="tag" Size="12" Class="mr-1 size-3" />
                @_savingsPercent% off
            </BadgeCn>
        </div>

        @* Product info *@
        <div class="border-t px-4 py-3">
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <div class="mt-1 flex items-baseline gap-2">
                <span class="text-2xl font-semibold tabular-nums">$@_product.SalePrice</span>
                <span class="text-sm text-muted-foreground line-through tabular-nums">
                    $@_product.OriginalPrice
                </span>
            </div>
            <p class="mt-0.5 text-xs text-emerald-600 font-medium">
                You save $@(_product.OriginalPrice - _product.SalePrice)
            </p>
        </div>

        @* Stock depletion *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="font-medium">@_remaining left</span>
                <span class="text-muted-foreground">@_product.SoldCount sold</span>
            </div>
            <div class="mt-1.5 h-2 w-full rounded-full bg-muted">
                <div
                    class="h-full rounded-full bg-red-500 transition-all"
                    style="@($"width:{_soldPercent}%")" />
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                @(_soldPercent >= 75 ? "Selling fast — almost gone!" : "Limited stock available")
            </p>
        </div>

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Buy Now — $@_product.SalePrice
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FlashSaleProduct(
        string Name,
        int OriginalPrice,
        int SalePrice,
        int TotalStock,
        int SoldCount,
        int SaleEndHours);

    private static readonly FlashSaleProduct _product = new(
        "Smart Home Speaker Hub",
        199,
        89,
        200,
        156,
        3);

    private (int Hours, int Minutes, int Seconds) _timeLeft = (3, 0, 0);
    private System.Threading.Timer? _timer;
    private DateTime _endTime;

    protected override void OnInitialized()
    {
        _endTime = DateTime.UtcNow.AddHours(_product.SaleEndHours);
        UpdateTimer();
        _timer = new System.Threading.Timer(_ =>
        {
            UpdateTimer();
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void UpdateTimer()
    {
        var diff = _endTime - DateTime.UtcNow;
        if (diff <= TimeSpan.Zero)
        {
            _timeLeft = (0, 0, 0);
            return;
        }
        _timeLeft = ((int)diff.TotalHours, diff.Minutes, diff.Seconds);
    }

    private int _savingsPercent =>
        (int)Math.Round(((double)(_product.OriginalPrice - _product.SalePrice) / _product.OriginalPrice) * 100);

    private int _remaining => _product.TotalStock - _product.SoldCount;

    private double _soldPercent =>
        ((double)_product.SoldCount / _product.TotalStock) * 100;

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
