@* ============================================================
   Block: product-card-variants
   Title: ProductCardVariants
   Description: Product card with color and size variant selectors for React ecommerce stores
   Source: original/blocks/product-cards/product-card-variants.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="h-[200px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
            </div>

            <CardContentCn Class="p-4">
                <h2 class="font-semibold leading-tight">@_product.Name</h2>

                <div class="mt-2 flex items-center gap-1">
                    <LucideIconCn Name="star" Size="16" Class="h-4 w-4 fill-primary text-primary" />
                    <span class="text-sm font-medium">@_product.Rating</span>
                    <span class="text-sm text-muted-foreground">(@(_product.ReviewCount))</span>
                </div>

                <p class="mt-3 text-2xl font-bold tabular-nums">$@(_product.Price.ToString("F2"))</p>

                @* Color selector *@
                <div class="mt-4">
                    <p class="mb-2 text-sm font-medium">
                        Color: <span class="text-muted-foreground">@_selectedColor</span>
                    </p>
                    <div class="flex gap-2">
                        @foreach (var color in _product.Colors)
                        {
                            var colorItem = color;
                            <button
                                type="button"
                                class="@Cn.Merge("h-8 w-8 rounded-full border-2 transition-all", _selectedColor == colorItem.Name ? "border-primary ring-2 ring-primary ring-offset-2" : "border-border")"
                                @onclick="@(() => _selectedColor = colorItem.Name)"
                                style="@($"background-color:{colorItem.Value}")"
                                title="@colorItem.Name">
                            </button>
                        }
                    </div>
                </div>

                @* Size selector *@
                <div class="mt-4">
                    <p class="mb-2 text-sm font-medium">Size</p>
                    <div class="flex justify-start gap-1">
                        @foreach (var sz in _product.Sizes)
                        {
                            var size = sz;
                            <button
                                type="button"
                                class="@Cn.Merge("inline-flex h-9 w-9 items-center justify-center rounded-md border text-sm font-medium transition-colors", _selectedSize == size ? "bg-primary text-primary-foreground border-primary" : "bg-background text-foreground border-input hover:bg-accent hover:text-accent-foreground")"
                                @onclick="@(() => _selectedSize = size)">
                                @size
                            </button>
                        }
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 h-4 w-4" />
                    Add to Cart
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record ProductColor(string Name, string Value);

    private record Product(
        string Name,
        double Price,
        string Image,
        double Rating,
        int ReviewCount,
        ProductColor[] Colors,
        string[] Sizes
    );

    private static readonly Product _product = new(
        "Cotton Crew T-Shirt",
        39.99,
        "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=400&q=80",
        4.6,
        189,
        [
            new("Black", "#000000"),
            new("White", "#FFFFFF"),
            new("Navy", "#1e3a5f"),
            new("Gray", "#6b7280"),
        ],
        ["XS", "S", "M", "L", "XL"]
    );

    private string _selectedColor = "Black";
    private string _selectedSize = "M";
}
