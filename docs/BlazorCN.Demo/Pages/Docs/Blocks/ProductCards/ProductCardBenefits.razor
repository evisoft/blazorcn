@* ============================================================
   Block: product-card-benefits
   Title: ProductCardBenefits
   Description: Product card with benefits grid and warranty info for React appliance stores
   Source: original/blocks/product-cards/product-card-benefits.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[700px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="grid md:grid-cols-[200px_1fr]">
                <div class="relative aspect-square md:aspect-square md:h-[200px]">
                    <img
                        alt="@_product.Name"
                        class="h-full w-full object-cover"
                        height="400"
                        src="@_product.Image"
                        width="400" />
                </div>

                <CardContentCn Class="flex flex-col p-5">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <h3 class="text-lg font-semibold">@_product.Name</h3>
                            <div class="mt-1 flex items-center gap-1">
                                <LucideIconCn Name="star" Size="16" Class="h-4 w-4 fill-primary text-primary" />
                                <span class="text-sm font-medium">@_product.Rating</span>
                                <span class="text-sm text-muted-foreground">
                                    (@(_product.ReviewCount) reviews)
                                </span>
                            </div>
                        </div>
                        <p class="text-xl font-bold tabular-nums">$@_product.Price.ToString("F2")</p>
                    </div>

                    <p class="mt-2 text-sm text-muted-foreground">@_product.Description</p>

                    <hr class="my-4 border-border" />

                    @* Benefits grid *@
                    <div class="grid grid-cols-3 gap-3">
                        @foreach (var benefit in _product.Benefits)
                        {
                            <div class="flex flex-col items-center text-center rounded-lg border p-3">
                                <div class="text-primary">
                                    <LucideIconCn Name="@benefit.IconName" Size="20" Class="h-5 w-5" />
                                </div>
                                <p class="mt-2 text-sm font-medium">@benefit.Title</p>
                                <p class="text-xs text-muted-foreground">@benefit.Description</p>
                            </div>
                        }
                    </div>

                    <div class="mt-4 flex items-center justify-between">
                        <BadgeCn Class="gap-1" Variant="BadgeVariant.Secondary">
                            <LucideIconCn Name="shield" Size="12" Class="h-3 w-3" />
                            @_product.Warranty
                        </BadgeCn>

                        <div class="flex gap-2">
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 h-4 w-4" />
                                Add to Cart
                            </ButtonCn>
                            <ButtonCn Size="ButtonSize.Sm">Buy Now</ButtonCn>
                        </div>
                    </div>
                </CardContentCn>
            </div>
        </CardCn>
    </div>
</section>

@code {
    private record Benefit(string IconName, string Title, string Description);

    private record Product(
        string Name,
        string Description,
        double Price,
        string Image,
        double Rating,
        int ReviewCount,
        string Warranty,
        Benefit[] Benefits
    );

    private static readonly Product _product = new(
        Name: "BrewMaster Pro Coffee Machine",
        Description: "Premium espresso machine with 15-bar pressure, built-in grinder and milk frother.",
        Price: 399.99,
        Image: "https://images.unsplash.com/photo-1517668808822-9ebb02f2a0e6?w=400&q=80",
        Rating: 4.8,
        ReviewCount: 256,
        Warranty: "2 Year Warranty",
        Benefits:
        [
            new("zap", "Fast Brewing", "Ready in 30 seconds"),
            new("droplets", "Self-Cleaning", "Auto clean function"),
            new("settings", "Customizable", "Multiple brew options"),
        ]
    );
}
