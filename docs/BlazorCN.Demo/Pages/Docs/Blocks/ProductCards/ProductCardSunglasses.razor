@* ============================================================
   Block: product-card-sunglasses
   Title: ProductCardSunglasses
   Description: Sunglasses product card with lens technology and UV protection details for eyewear stores
   Source: original/blocks/product-cards/product-card-sunglasses.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Image placeholder *@
        <div class="relative flex h-[180px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Polarized</BadgeCn>
        </div>

        @* Brand / name / price *@
        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Ray-Ban</p>
            <h3 class="text-sm font-medium">Aviator Classic RB3025</h3>
            <p class="mt-2 text-2xl font-semibold tabular-nums">$@_totalPrice</p>
        </div>

        @* Lens color selector *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">
                LENS &middot; <span class="text-foreground">@_selectedLens</span>
            </p>
            <div class="flex gap-2">
                @foreach (var lens in _lensColors)
                {
                    var lensItem = lens;
                    <button
                        type="button"
                        class="@Cn.Merge("size-8 rounded-full border-2 transition-all", _selectedLens == lensItem.Name ? "border-foreground ring-2 ring-foreground/20" : "border-border")"
                        style="@($"background-color:{lensItem.Value}")"
                        @onclick="@(() => SelectLens(lensItem.Name))"
                        title="@($"{lensItem.Name}{(lensItem.Price > 0 ? $" (+${lensItem.Price})" : "")}")">
                    </button>
                }
            </div>
        </div>

        @* Lens technology *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">LENS TECHNOLOGY</p>
            <div class="grid grid-cols-3 gap-2">
                <div class="flex flex-col items-center gap-1 rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="sun" Size="16" Class="size-4 text-muted-foreground" />
                    <p class="text-xs font-medium">UV400</p>
                    <p class="text-xs text-muted-foreground">Protection</p>
                </div>
                <div class="flex flex-col items-center gap-1 rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="eye" Size="16" Class="size-4 text-muted-foreground" />
                    <p class="text-xs font-medium">Polarized</p>
                    <p class="text-xs text-muted-foreground">Anti-glare</p>
                </div>
                <div class="flex flex-col items-center gap-1 rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                    <p class="text-xs font-medium">Scratch</p>
                    <p class="text-xs text-muted-foreground">Resistant</p>
                </div>
            </div>
        </div>

        @* Measurements *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">MEASUREMENTS</p>
            <div class="grid grid-cols-3 gap-x-4 gap-y-1.5">
                @foreach (var spec in _specs)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@spec.Label</span>
                        <span class="font-medium">@spec.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Tags *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap gap-1">
                @foreach (var tag in _tags)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@tag</BadgeCn>
                }
            </div>
        </div>

        @* Actions *@
        <div class="flex gap-2 px-4 py-3">
            <ButtonCn Class="flex-1">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Class="shrink-0">
                Virtual Try-On
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record LensColor(string Name, string Value, int Price);
    private record Spec(string Label, string Value);

    private static readonly LensColor[] _lensColors =
    [
        new("Green G-15", "#2d4a2d", 0),
        new("Brown B-15", "#6b4c3b", 0),
        new("Blue Mirror", "#3b82f6", 30),
        new("Rose Gold", "#d4a574", 30),
    ];

    private static readonly Spec[] _specs =
    [
        new("Frame", "Titanium"),
        new("Lens", "Crystal Glass"),
        new("Weight", "31g"),
        new("Bridge", "14mm"),
        new("Temple", "145mm"),
        new("Lens Width", "55mm"),
    ];

    private static readonly string[] _tags = ["Case included", "Cleaning cloth", "2-year warranty", "Free returns"];

    private string _selectedLens = "Green G-15";

    private int _totalPrice => 289 + (_lensColors.FirstOrDefault(l => l.Name == _selectedLens)?.Price ?? 0);

    private void SelectLens(string name)
    {
        _selectedLens = name;
    }
}
