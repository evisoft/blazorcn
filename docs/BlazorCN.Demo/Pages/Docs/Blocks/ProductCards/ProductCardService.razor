@* ============================================================
   Block: product-card-service
   Title: ProductCardService
   Description: Service package card with duration, what's included, and booking for React service businesses
   Source: original/blocks/product-cards/product-card-service.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[160px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <BadgeCn Class="absolute top-3 left-3">@_product.Category</BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <div class="flex items-start justify-between gap-2">
                    <h2 class="font-semibold">@_product.Name</h2>
                    <div class="text-right">
                        <p class="text-lg font-bold tabular-nums">$@_product.Price</p>
                    </div>
                </div>

                <p class="mt-1 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                        <span>@_product.Duration</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="h-3 w-3" />
                        <span>@_product.Location</span>
                    </div>
                </div>

                @* What's included *@
                <div class="mt-4">
                    <p class="mb-1.5 text-xs font-medium text-muted-foreground">INCLUDES</p>
                    <div class="space-y-1">
                        @foreach (var item in _product.Included)
                        {
                            <div class="flex items-center gap-1.5 text-xs">
                                <LucideIconCn Name="check" Size="12" Class="h-3 w-3 text-primary" />
                                <span>@item</span>
                            </div>
                        }
                    </div>
                </div>

                @* Provider *@
                <div class="mt-4 flex items-center justify-between rounded-lg border p-3">
                    <div class="flex items-center gap-2">
                        <AvatarCn Class="h-9 w-9">
                            <AvatarImageCn Src="@_product.Provider.Avatar" Alt="" />
                            <AvatarFallbackCn>@_product.Provider.Name[0]</AvatarFallbackCn>
                        </AvatarCn>
                        <div>
                            <p class="text-sm font-medium">@_product.Provider.Name</p>
                            <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                <LucideIconCn Name="star" Size="12" Class="h-3 w-3 fill-primary text-primary" />
                                <span>@_product.Provider.Rating</span>
                                <span>(@_product.Provider.Reviews)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full">Book Appointment</ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">View Provider</ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record ProviderInfo(string Name, string Avatar, double Rating, int Reviews);

    private record Product(
        string Name,
        string Description,
        int Price,
        string Duration,
        string Image,
        string Category,
        string Location,
        string[] Included,
        ProviderInfo Provider);

    private static readonly Product _product = new(
        Name: "Deep Tissue Massage",
        Description: "Therapeutic massage targeting muscle tension and chronic pain relief.",
        Price: 120,
        Duration: "90 min",
        Image: "https://images.unsplash.com/photo-1544161515-4ab6ce6db874?w=400&q=80",
        Category: "Massage",
        Location: "Downtown Spa",
        Included:
        [
            "Aromatherapy oils included",
            "Hot stone add-on available",
            "Private treatment room",
            "Complimentary refreshments",
        ],
        Provider: new ProviderInfo(
            Name: "Sarah Chen",
            Avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&q=80",
            Rating: 4.9,
            Reviews: 156));
}
