@* ============================================================
   Block: product-card-service
   Title: Product Card Service
   Description: Service package card with duration, what's included, and booking for React service businesses
   Long Description: Product card with sale pricing showing original and discounted price for React ecommerce
   Dependencies: AvatarCn, BadgeCn, ButtonCn, CardCn, LucideCheckCn, LucideClockCn, LucideMapPinCn, LucideStarCn
   Source: original/blocks/product-cards/product-card-service.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn class="overflow-hidden">
            <div class="relative h-[160px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <BadgeCn class="absolute top-3 left-3">@_product.Category</BadgeCn>
            </div>

            <CardContentCn class="p-4">
                <div class="flex items-start justify-between gap-2">
                    <h3 class="font-semibold">@_product.Name</h3>
                    <div class="text-right">
                        <p class="text-lg font-bold tabular-nums">$@_product.Price</p>
                    </div>
                </div>

                <p class="mt-1 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideClockCn Size="12" />
                        <span>@_product.Duration</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideMapPinCn Size="12" />
                        <span>@_product.Location</span>
                    </div>
                </div>

                <div class="mt-4">
                    <p class="mb-1.5 text-xs font-medium text-muted-foreground">INCLUDES</p>
                    <div class="space-y-1">
                        @foreach (var item in _product.Included)
                        {
                            <div class="flex items-center gap-1.5 text-xs">
                                <LucideCheckCn Size="12" Class="text-primary" />
                                <span>@item</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4 flex items-center justify-between rounded-lg border p-3">
                    <div class="flex items-center gap-2">
                        <AvatarCn class="h-9 w-9">
                            <AvatarImageCn Src="@_product.ProviderAvatar" />
                            <AvatarFallbackCn>@_product.ProviderName[0]</AvatarFallbackCn>
                        </AvatarCn>
                        <div>
                            <p class="text-sm font-medium">@_product.ProviderName</p>
                            <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                <LucideStarCn Size="12" Class="fill-primary text-primary" />
                                <span>@_product.ProviderRating</span>
                                <span>(@_product.ProviderReviews)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn class="flex-col gap-2 p-4 pt-0">
                <ButtonCn class="w-full">Book Appointment</ButtonCn>
                <ButtonCn class="w-full" Variant="ButtonVariant.Outline">
                    View Provider
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record ProductData(string Name, string Description, int Price, string Duration, string Image, string Category, string Location, string[] Included, string ProviderName, string ProviderAvatar, double ProviderRating, int ProviderReviews);

    private static readonly ProductData _product = new(
        "Deep Tissue Massage",
        "Therapeutic massage targeting muscle tension and chronic pain relief.",
        120,
        "90 min",
        "https://images.unsplash.com/photo-1544161515-4ab6ce6db874?w=400&q=80",
        "Massage",
        "Downtown Spa",
        [
            "Aromatherapy oils included",
            "Hot stone add-on available",
            "Private treatment room",
            "Complimentary refreshments",
        ],
        "Sarah Chen",
        "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&q=80",
        4.9,
        156
    );
}
