@* ============================================================
   Block: product-card-podcast
   Title: ProductCardPodcast
   Description: Podcast episode card with play controls, duration, and show notes for React podcast apps
   Source: original/blocks/product-cards/product-card-podcast.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[400px] max-w-full">
        <CardCn Class="overflow-hidden">
            <CardContentCn Class="p-4">
                <div class="flex gap-4">
                    @* Artwork with play button *@
                    <div class="relative h-24 w-24 shrink-0">
                        <img
                            alt="@_product.Title"
                            class="h-full w-full rounded-lg object-cover"
                            height="400"
                            src="@_product.Image"
                            width="400" />
                        <button
                            type="button"
                            class="absolute inset-0 flex items-center justify-center rounded-lg bg-black/40 transition-opacity hover:bg-black/50"
                            aria-label="@(_isPlaying ? $"pause {_product.Title}" : $"play {_product.Title}")"
                            @onclick="@(() => _isPlaying = !_isPlaying)">
                            @if (_isPlaying)
                            {
                                <LucideIconCn Name="pause" Size="32" Class="h-8 w-8 fill-white text-white" />
                            }
                            else
                            {
                                <LucideIconCn Name="play" Size="32" Class="h-8 w-8 fill-white text-white" />
                            }
                        </button>
                    </div>

                    <div class="flex-1 min-w-0">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">Ep. @_product.EpisodeNumber</BadgeCn>
                                <p class="mt-1 text-xs text-muted-foreground">@_product.ShowName</p>
                            </div>
                            <ButtonCn Class="h-8 w-8 shrink-0" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Bookmark">
                                <LucideIconCn Name="bookmark" Size="16" Class="h-4 w-4" />
                            </ButtonCn>
                        </div>

                        <h2 class="mt-1 font-semibold leading-tight line-clamp-2">@_product.Title</h2>

                        <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                            <div class="flex items-center gap-1">
                                <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                                <span>@_product.Duration</span>
                            </div>
                            <span>@_product.PublishDate</span>
                        </div>
                    </div>
                </div>

                @* Progress bar *@
                <div class="mt-4">
                    <ProgressCn Class="h-1" Value="@_progressPercent" aria-label="Progress" />
                    <div class="mt-1 flex items-center justify-between text-xs text-muted-foreground">
                        <span>@_playedFormatted</span>
                        <span>@_remainingMinutes min left</span>
                    </div>
                </div>

                @* Guest info *@
                @if (_product.Guest != null)
                {
                    <div class="mt-4 flex items-center gap-3 rounded-lg border p-3">
                        <AvatarCn Class="h-10 w-10">
                            <AvatarImageCn Src="@_product.Guest.Avatar" Alt="" />
                            <AvatarFallbackCn>@_product.Guest.Name[0]</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium">Featuring @_product.Guest.Name</p>
                            <p class="text-xs text-muted-foreground truncate">@_product.Guest.Title</p>
                        </div>
                    </div>
                }

                <p class="mt-3 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                @* Actions *@
                <div class="mt-4 flex gap-2">
                    <ButtonCn Class="flex-1" @onclick="@(() => _isPlaying = !_isPlaying)">
                        @if (_isPlaying)
                        {
                            <LucideIconCn Name="pause" Size="16" Class="mr-2 h-4 w-4" />
                            @:Pause
                        }
                        else
                        {
                            <LucideIconCn Name="headphones" Size="16" Class="mr-2 h-4 w-4" />
                            @(_product.PlayedSeconds > 0 ? "Continue" : "Play")
                        }
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" aria-label="Download">
                        <LucideIconCn Name="download" Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" aria-label="Share">
                        <LucideIconCn Name="share-2" Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private record Guest(string Name, string Avatar, string Title);

    private record Product(
        string Title,
        string ShowName,
        int EpisodeNumber,
        string Image,
        string Duration,
        int DurationSeconds,
        string PublishDate,
        string Description,
        Guest? Guest,
        int PlayedSeconds
    );

    private static readonly Product _product = new(
        Title: "The Future of AI in Creative Industries",
        ShowName: "Tech Horizons",
        EpisodeNumber: 147,
        Image: "https://images.unsplash.com/photo-1478737270239-2f02b77fc618?w=400&q=80",
        Duration: "58:24",
        DurationSeconds: 3504,
        PublishDate: "Dec 4, 2025",
        Description: "We explore how artificial intelligence is transforming creative work, from design to music production, with insights from industry leaders.",
        Guest: new Guest(
            Name: "Dr. Sarah Chen",
            Avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&q=80",
            Title: "AI Research Lead, Creative Labs"
        ),
        PlayedSeconds: 1240
    );

    private bool _isPlaying = false;

    private double _progressPercent => (_product.PlayedSeconds / (double)_product.DurationSeconds) * 100.0;
    private int _remainingMinutes => (int)Math.Ceiling((_product.DurationSeconds - _product.PlayedSeconds) / 60.0);
    private string _playedFormatted => $"{_product.PlayedSeconds / 60}:{(_product.PlayedSeconds % 60).ToString().PadLeft(2, '0')}";
}
