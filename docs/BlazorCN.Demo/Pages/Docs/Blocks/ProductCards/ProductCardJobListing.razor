@* ============================================================
   Block: product-card-job-listing
   Title: ProductCardJobListing
   Description: Job listing card with salary, requirements, and quick apply for React job boards
   Source: original/blocks/product-cards/product-card-job-listing.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[600px] max-w-full">
        <CardCn Class="overflow-hidden">
            <CardContentCn Class="p-5">
                <div class="flex gap-4">
                    <AvatarCn Class="h-14 w-14 rounded-lg">
                        <AvatarImageCn Src="@_product.Logo" />
                        <AvatarFallbackCn Class="rounded-lg">@(_product.Company[0].ToString())</AvatarFallbackCn>
                    </AvatarCn>

                    <div class="flex-1">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <h3 class="text-lg font-semibold">@_product.Title</h3>
                                <p class="text-sm text-muted-foreground">@_product.Company</p>
                            </div>
                            <button
                                type="button"
                                class="flex h-9 w-9 items-center justify-center rounded-full border"
                                @onclick="@(() => _isSaved = !_isSaved)">
                                <LucideIconCn Name="bookmark" Size="16" Class="@Cn.Merge("h-4 w-4", _isSaved ? "fill-primary text-primary" : "")" />
                            </button>
                        </div>

                        @* Key details *@
                        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
                            <div class="flex items-center gap-1">
                                <LucideIconCn Name="map-pin" Size="12" Class="h-3 w-3" />
                                <span>@_product.Location</span>
                                @if (_product.IsRemote)
                                {
                                    <BadgeCn Class="ml-1 text-xs" Variant="BadgeVariant.Secondary">Remote</BadgeCn>
                                }
                            </div>
                            <div class="flex items-center gap-1">
                                <LucideIconCn Name="dollar-sign" Size="12" Class="h-3 w-3" />
                                <span>@FormatSalary(_product.SalaryMin) - @FormatSalary(_product.SalaryMax)</span>
                            </div>
                            <div class="flex items-center gap-1">
                                <LucideIconCn Name="briefcase" Size="12" Class="h-3 w-3" />
                                <span>@_product.Type</span>
                            </div>
                        </div>

                        <p class="mt-3 text-sm text-muted-foreground line-clamp-2">
                            @_product.Description
                        </p>

                        @* Skills *@
                        <div class="mt-3 flex flex-wrap gap-1">
                            @foreach (var skill in _product.Skills)
                            {
                                <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">@skill</BadgeCn>
                            }
                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">@_product.Experience</BadgeCn>
                        </div>

                        @* Footer *@
                        <div class="mt-4 flex items-center justify-between">
                            <div class="flex items-center gap-4 text-xs text-muted-foreground">
                                <div class="flex items-center gap-1">
                                    <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                                    <span>@(_product.PostedDays)d ago</span>
                                </div>
                                <div class="flex items-center gap-1">
                                    <LucideIconCn Name="users" Size="12" Class="h-3 w-3" />
                                    <span>@(_product.Applicants) applicants</span>
                                </div>
                            </div>
                            <div class="flex gap-2">
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">View Details</ButtonCn>
                                <ButtonCn Size="ButtonSize.Sm">Quick Apply</ButtonCn>
                            </div>
                        </div>
                    </div>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private record JobProduct(
        string Title,
        string Company,
        string Logo,
        string Location,
        bool IsRemote,
        int SalaryMin,
        int SalaryMax,
        string Type,
        string Experience,
        int PostedDays,
        int Applicants,
        string[] Skills,
        string Description
    );

    private static readonly JobProduct _product = new(
        Title: "Senior Frontend Engineer",
        Company: "TechFlow Inc",
        Logo: "https://images.unsplash.com/photo-1611162617474-5b21e879e113?w=100&q=80",
        Location: "San Francisco, CA",
        IsRemote: true,
        SalaryMin: 150000,
        SalaryMax: 200000,
        Type: "Full-time",
        Experience: "5+ years",
        PostedDays: 2,
        Applicants: 47,
        Skills: ["React", "TypeScript", "Next.js", "Tailwind CSS"],
        Description: "Join our team to build the next generation of developer tools. You'll work on challenging problems with a talented team."
    );

    private bool _isSaved = false;

    private static string FormatSalary(int amount) => $"${amount / 1000}k";
}
