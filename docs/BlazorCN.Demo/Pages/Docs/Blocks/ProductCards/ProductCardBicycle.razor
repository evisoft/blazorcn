@* ============================================================
   Block: product-card-bicycle
   Title: ProductCardBicycle
   Description: Bicycle product card with component details and frame size selector for bike shops
   Source: original/blocks/product-cards/product-card-bicycle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[200px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Road</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="absolute top-3 right-3">2025</BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Canyon</p>
            <h3 class="text-sm font-medium">Ultimate CF SLX 8 Disc</h3>
            <div class="mt-2 flex items-end justify-between">
                <p class="text-2xl font-semibold tabular-nums">$4,499</p>
                <div class="flex items-center gap-3 text-xs text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="weight" Size="12" Class="size-3" />
                        <span>7.2 kg</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="cog" Size="12" Class="size-3" />
                        <span>Carbon</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">FRAME SIZE</p>
            <div class="grid grid-cols-4 gap-1.5">
                @foreach (var fs in _frameSizes)
                {
                    var frameSize = fs;
                    <button
                        type="button"
                        class="@Cn.Merge("rounded-md border p-2 text-center transition-colors", _selectedSize == frameSize.Size ? "border-foreground bg-foreground/5" : "hover:bg-muted/50")"
                        @onclick="@(() => _selectedSize = frameSize.Size)">
                        <p class="text-xs font-medium">@frameSize.Size</p>
                        <p class="text-xs text-muted-foreground">@frameSize.Label</p>
                    </button>
                }
            </div>
            <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="ruler" Size="12" Class="size-3" />
                <span>Recommended for @_selectedFrameObj.Height</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">COMPONENTS</p>
            <div class="space-y-1.5">
                @foreach (var comp in _components)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@comp.Label</span>
                        <span class="font-medium">@comp.Value</span>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>UCI Approved</span>
                <span>&middot;</span>
                <span>Lifetime Frame Warranty</span>
                <span>&middot;</span>
                <span>Free Assembly</span>
            </div>
        </div>

        <div class="flex gap-2 px-4 py-3">
            <ButtonCn Class="flex-1">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Class="shrink-0">
                Book Test Ride
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FrameSizeOption(string Size, string Label, string Height);
    private record ComponentItem(string Label, string Value);

    private static readonly FrameSizeOption[] _frameSizes =
    [
        new("S", "Small", "5'2\" - 5'6\""),
        new("M", "Medium", "5'6\" - 5'10\""),
        new("L", "Large", "5'10\" - 6'2\""),
        new("XL", "X-Large", "6'2\" - 6'5\""),
    ];

    private static readonly ComponentItem[] _components =
    [
        new("Groupset", "Shimano 105 Di2 12-speed"),
        new("Wheels", "700c Carbon Tubeless"),
        new("Brakes", "Hydraulic Disc 160mm"),
        new("Tires", "Continental GP5000 28c"),
        new("Handlebar", "Carbon Aero Drop"),
        new("Saddle", "Fizik Argo Vento R3"),
    ];

    private string _selectedSize = "M";

    private FrameSizeOption _selectedFrameObj => Array.Find(_frameSizes, f => f.Size == _selectedSize) ?? _frameSizes[1];
}
