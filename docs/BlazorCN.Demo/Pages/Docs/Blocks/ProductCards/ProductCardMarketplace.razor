@* ============================================================
   Block: product-card-marketplace
   Title: ProductCardMarketplace
   Description: Marketplace seller product card with seller rating, shipping info, and buyer protection for React platforms
   Source: original/blocks/product-cards/product-card-marketplace.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Image *@
        <div class="relative flex h-[200px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="shopping-cart" Size="64" Class="size-16 text-muted-foreground/30" />
            <BadgeCn Class="absolute top-3 left-3" Variant="BadgeVariant.Secondary">
                @_product.Condition
            </BadgeCn>
        </div>

        @* Product info *@
        <div class="border-t px-4 py-3">
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <div class="mt-1 flex items-baseline gap-2">
                <span class="text-2xl font-semibold tabular-nums">$@_product.Price</span>
                <span class="text-xs text-muted-foreground">
                    + $@_product.ShippingCost shipping
                </span>
            </div>
        </div>

        @* Seller info *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex size-8 items-center justify-center rounded-full bg-muted/50 text-xs font-medium">
                        @_product.Seller.Name[0]
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="text-sm font-medium">@_product.Seller.Name</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs px-1.5 py-0">
                                @_product.Seller.Badge
                            </BadgeCn>
                        </div>
                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                            <LucideIconCn Name="star" Size="12" Class="size-3 fill-foreground text-foreground" />
                            <span class="font-medium text-foreground">@_product.Seller.Rating</span>
                            <span>· @_product.Seller.SalesCount.ToString("N0") sales</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                <div class="flex items-center gap-1">
                    <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                    <span>@_product.Seller.Location</span>
                </div>
                <div class="flex items-center gap-1">
                    <LucideIconCn Name="message-circle" Size="12" Class="size-3" />
                    <span>@_product.Seller.ResponseTime</span>
                </div>
            </div>
        </div>

        @* Shipping and protection *@
        <div class="border-t px-4 py-3">
            <div class="space-y-2">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="truck" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs">Est. delivery: @_product.EstimatedDelivery</span>
                </div>
                @if (_product.BuyerProtection)
                {
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs">Buyer protection — money-back guarantee</span>
                    </div>
                }
            </div>
        </div>

        @* Actions *@
        <div class="border-t px-4 py-3">
            <div class="flex gap-2">
                <ButtonCn Class="flex-1" Size="ButtonSize.Sm">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                    Buy Now
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="px-3" aria-label="Message seller">
                    <LucideIconCn Name="message-circle" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record SellerInfo(
        string Name,
        double Rating,
        int SalesCount,
        string Badge,
        string Location,
        string ResponseTime);

    private record MarketplaceProduct(
        string Name,
        int Price,
        int ShippingCost,
        string Condition,
        string EstimatedDelivery,
        SellerInfo Seller,
        bool BuyerProtection);

    private static readonly MarketplaceProduct _product = new(
        "Vintage Polaroid SX-70 Camera",
        289,
        12,
        "Used — Like New",
        "5–7 business days",
        new SellerInfo(
            "RetroTech Finds",
            4.9,
            1843,
            "Top Seller",
            "Portland, OR",
            "Usually within 2 hours"),
        true);
}
