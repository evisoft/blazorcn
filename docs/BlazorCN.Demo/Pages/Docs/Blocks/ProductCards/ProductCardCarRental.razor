@* ============================================================
   Block: product-card-car-rental
   Title: ProductCardCarRental
   Description: Car rental product card with specs, features, and daily pricing for React rental sites
   Source: original/blocks/product-cards/product-card-car-rental.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[160px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <BadgeCn Class="absolute top-3 left-3">
                    <LucideIconCn Name="car" Size="12" Class="mr-1 h-3 w-3" />
                    @_product.Category
                </BadgeCn>
                @if (_product.IsAvailable)
                {
                    <BadgeCn Class="absolute top-3 right-3" Variant="BadgeVariant.Secondary">Available</BadgeCn>
                }
            </div>

            <CardContentCn Class="p-4">
                <div class="flex items-start justify-between gap-2">
                    <h2 class="font-semibold">@_product.Name</h2>
                    <div class="text-right">
                        <p class="text-lg font-bold tabular-nums">$@_product.PricePerDay</p>
                        <p class="text-xs text-muted-foreground">/day</p>
                    </div>
                </div>

                @* Specs *@
                <div class="mt-3 flex items-center justify-between text-sm">
                    <div class="flex items-center gap-1 text-muted-foreground">
                        <LucideIconCn Name="users" Size="16" Class="h-4 w-4" />
                        <span>@_product.Seats seats</span>
                    </div>
                    <div class="flex items-center gap-1 text-muted-foreground">
                        <LucideIconCn Name="gauge" Size="16" Class="h-4 w-4" />
                        <span>@_product.Transmission</span>
                    </div>
                    <div class="flex items-center gap-1 text-muted-foreground">
                        <LucideIconCn Name="fuel" Size="16" Class="h-4 w-4" />
                        <span>@_product.FuelType</span>
                    </div>
                </div>

                <SeparatorCn Class="my-3" />

                @* Features *@
                <div class="grid grid-cols-2 gap-1">
                    @foreach (var feature in _product.Features)
                    {
                        <div class="flex items-center gap-1.5 text-xs">
                            <LucideIconCn Name="check" Size="12" Class="h-3 w-3 text-primary" />
                            <span>@feature</span>
                        </div>
                    }
                </div>

                <SeparatorCn Class="my-3" />

                @* Estimate *@
                <div class="flex items-center justify-between text-sm">
                    <span class="text-muted-foreground">Est. @_estimatedDays days</span>
                    <span class="font-semibold tabular-nums">$@_totalEstimate total</span>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full">Select Vehicle</ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">View Details</ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record Product(
        string Name,
        string Category,
        string Image,
        int PricePerDay,
        int Seats,
        string Transmission,
        string FuelType,
        int Mpg,
        string[] Features,
        bool IsAvailable
    );

    private static readonly Product _product = new(
        Name: "Tesla Model 3",
        Category: "Electric Sedan",
        Image: "https://images.unsplash.com/photo-1560958089-b8a1929cea89?w=400&q=80",
        PricePerDay: 89,
        Seats: 5,
        Transmission: "Automatic",
        FuelType: "Electric",
        Mpg: 134,
        Features: ["Free cancellation", "Unlimited mileage", "Insurance included", "GPS navigation"],
        IsAvailable: true
    );

    private const int _estimatedDays = 3;
    private static readonly int _totalEstimate = _product.PricePerDay * _estimatedDays;
}
