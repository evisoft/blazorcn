@* ============================================================
   Block: product-card-comparison
   Title: ProductCardComparison
   Description: Side-by-side product comparison card with specs, pricing, and winner indicators for React ecommerce
   Source: original/blocks/product-cards/product-card-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">COMPARE</p>
        </div>

        @* Product headers *@
        <div class="grid grid-cols-2 border-t">
            <div class="border-r px-4 py-3">
                <div class="flex h-[100px] items-center justify-center rounded-md bg-muted/50">
                    <span class="text-xs text-muted-foreground">Product A</span>
                </div>
                <h3 class="mt-2 text-sm font-medium">@_productA.Name</h3>
                <p class="text-xl font-semibold tabular-nums">$@_productA.Price</p>
            </div>
            <div class="px-4 py-3">
                <div class="relative flex h-[100px] items-center justify-center rounded-md bg-muted/50">
                    <span class="text-xs text-muted-foreground">Product B</span>
                    <BadgeCn Class="absolute -top-1.5 -right-1.5 text-xs">Popular</BadgeCn>
                </div>
                <h3 class="mt-2 text-sm font-medium">@_productB.Name</h3>
                <p class="text-xl font-semibold tabular-nums">$@_productB.Price</p>
            </div>
        </div>

        @* Specs comparison *@
        <div class="border-t">
            <div class="px-4 py-2">
                <p class="text-xs font-medium text-muted-foreground">SPECIFICATIONS</p>
            </div>
            @foreach (var spec in _specs)
            {
                <div class="grid grid-cols-[1fr_1fr] border-t">
                    <div class="@(spec.Winner == "a" ? "border-r px-4 py-2 bg-muted/30" : "border-r px-4 py-2")">
                        <p class="text-xs text-muted-foreground">@spec.Label</p>
                        <div class="flex items-center gap-1.5">
                            <span class="text-sm font-medium">@spec.ProductA</span>
                            @if (spec.Winner == "a")
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600" />
                            }
                        </div>
                    </div>
                    <div class="@(spec.Winner == "b" ? "px-4 py-2 bg-muted/30" : "px-4 py-2")">
                        <p class="text-xs text-muted-foreground">@spec.Label</p>
                        <div class="flex items-center gap-1.5">
                            <span class="text-sm font-medium">@spec.ProductB</span>
                            @if (spec.Winner == "b")
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600" />
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Actions *@
        <div class="grid grid-cols-2 border-t">
            <div class="border-r px-4 py-3">
                <ButtonCn Class="w-full" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                    Add to Cart
                </ButtonCn>
            </div>
            <div class="px-4 py-3">
                <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                    Add to Cart
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record CompareProduct(string Name, int Price, double Rating);
    private record CompareSpec(string Label, string ProductA, string ProductB, string Winner);

    private static readonly CompareProduct _productA = new("MacBook Air M3", 1099, 4.7);
    private static readonly CompareProduct _productB = new("MacBook Pro M3", 1599, 4.9);

    private static readonly CompareSpec[] _specs =
    [
        new("Chip", "M3", "M3 Pro", "b"),
        new("RAM", "8 GB", "18 GB", "b"),
        new("Storage", "256 GB SSD", "512 GB SSD", "b"),
        new("Display", "13.6\" Liquid Retina", "14.2\" Liquid Retina XDR", "b"),
        new("Battery", "18 hours", "17 hours", "a"),
        new("Weight", "1.24 kg", "1.55 kg", "a"),
        new("Ports", "2x USB-C", "3x TB4 + HDMI + SD", "b"),
    ];
}
