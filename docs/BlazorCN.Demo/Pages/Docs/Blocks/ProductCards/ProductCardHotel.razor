@* ============================================================
   Block: product-card-hotel
   Title: ProductCardHotel
   Description: Hotel booking card with amenities, offers, and availability for React travel sites
   Source: original/blocks/product-cards/product-card-hotel.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[700px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="grid md:grid-cols-[200px_1fr]">
                <div class="relative aspect-square md:aspect-square md:h-[200px]">
                    <img
                        alt="@_product.Name"
                        class="h-full w-full object-cover"
                        height="400"
                        src="@_product.Image"
                        width="400" />
                    <BadgeCn Class="absolute top-3 left-3">Top-rated</BadgeCn>
                    <button
                        type="button"
                        class="absolute top-3 right-3 flex h-8 w-8 items-center justify-center rounded-full bg-background/90"
                        aria-label="Save hotel to favorites" @onclick="@(() => _isFavorite = !_isFavorite)">
                        <LucideIconCn Name="heart" Size="16" Class="@Cn.Merge("h-4 w-4", _isFavorite ? "fill-primary text-primary" : "")" />
                    </button>
                </div>

                <CardContentCn Class="flex flex-col p-5">
                    <div class="flex-1">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <h2 class="text-lg font-semibold">@_product.Name</h2>
                                <div class="mt-1 flex items-center gap-2 text-sm text-muted-foreground">
                                    <LucideIconCn Name="map-pin" Size="12" Class="h-3 w-3" />
                                    <span>@_product.Location</span>
                                    <span>•</span>
                                    <span>@_product.Distance</span>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="flex items-center gap-1">
                                    <LucideIconCn Name="star" Size="16" Class="h-4 w-4 fill-primary text-primary" />
                                    <span class="font-medium">@_product.Rating</span>
                                </div>
                                <p class="text-xs text-muted-foreground">@_product.ReviewCount reviews</p>
                            </div>
                        </div>

                        <p class="mt-2 text-sm text-muted-foreground line-clamp-2">
                            @_product.Description
                        </p>

                        @* Limited deal banner *@
                        @if (_isLowAvailability)
                        {
                            <div class="mt-3 flex items-center gap-2 rounded-md border p-2">
                                <LucideIconCn Name="shield" Size="16" Class="h-4 w-4 text-primary" />
                                <div>
                                    <p class="text-xs font-medium">Limited availability</p>
                                    <p class="text-xs text-muted-foreground">
                                        Only @_product.RoomsLeft rooms at this price
                                    </p>
                                </div>
                            </div>
                        }

                        @* Amenities and offers *@
                        <div class="mt-3 grid grid-cols-2 gap-4">
                            <div>
                                <p class="mb-1 text-xs font-medium text-muted-foreground">AMENITIES</p>
                                <div class="space-y-0.5">
                                    @foreach (var amenity in _product.Amenities.Take(3))
                                    {
                                        <div class="flex items-center gap-1.5 text-xs">
                                            <LucideIconCn Name="check" Size="12" Class="h-3 w-3 text-primary" />
                                            <span>@amenity</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div>
                                <p class="mb-1 text-xs font-medium text-muted-foreground">OFFERS</p>
                                <div class="space-y-0.5">
                                    @foreach (var offer in _product.Offers)
                                    {
                                        <div class="flex items-center gap-1.5 text-xs">
                                            <LucideIconCn Name="check" Size="12" Class="h-3 w-3 text-primary" />
                                            <span>@offer</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 flex items-end justify-between gap-4">
                        <div>
                            <p class="text-xs text-muted-foreground">per night</p>
                            <div class="flex items-baseline gap-2">
                                <span class="text-xl font-bold tabular-nums">$@_product.Price</span>
                                @if (_hasDiscount)
                                {
                                    <span class="text-sm text-muted-foreground line-through tabular-nums">
                                        $@_product.OriginalPrice
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                                View Details
                            </ButtonCn>
                            <ButtonCn Size="ButtonSize.Sm">
                                Book — $@_product.Price
                            </ButtonCn>
                        </div>
                    </div>
                </CardContentCn>
            </div>
        </CardCn>
    </div>
</section>

@code {
    private record Product(
        string Name,
        string Description,
        int OriginalPrice,
        int Price,
        string Image,
        string Location,
        string Distance,
        double Rating,
        int ReviewCount,
        int RoomsLeft,
        string[] Amenities,
        string[] Offers
    );

    private static readonly Product _product = new(
        Name: "Grand Azure Hotel & Spa",
        Description: "Contemporary hotel with elegant rooms, rooftop restaurant, and panoramic city views.",
        OriginalPrice: 249,
        Price: 199,
        Image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?w=400&q=80",
        Location: "Downtown, New York",
        Distance: "1.2 km from center",
        Rating: 4.5,
        ReviewCount: 386,
        RoomsLeft: 3,
        Amenities: ["Free Wi-Fi", "Breakfast included", "Swimming pool", "Fitness center"],
        Offers: ["Free cancellation", "Pay at property"]
    );

    private bool _isFavorite = false;
    private bool _isLowAvailability => _product.RoomsLeft <= 5;
    private bool _hasDiscount => _product.OriginalPrice > _product.Price;
}
