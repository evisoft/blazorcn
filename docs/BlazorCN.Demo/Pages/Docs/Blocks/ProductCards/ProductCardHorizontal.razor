@* ============================================================
   Block: product-card-horizontal
   Title: Product Card Horizontal
   Description: Horizontal product card with side-by-side image and details for React product listings
   Long Description: Responsive product grid layout with multiple product cards for React category pages
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, LucideShoppingCartCn, LucideStarCn, LucideTruckCn
   Source: original/blocks/product-cards/product-card-horizontal.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[700px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="grid md:grid-cols-[200px_1fr]">
                <div class="aspect-square md:aspect-square md:h-[200px]">
                    <img alt="@ProductName"
                         class="h-full w-full object-cover"
                         height="400"
                         src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=400&q=80"
                         width="400" />
                </div>

                <CardContentCn Class="flex flex-col p-6">
                    <div class="flex-1">
                        <div class="flex items-start justify-between gap-4">
                            <h3 class="text-xl font-semibold">@ProductName</h3>
                            <BadgeCn Variant="BadgeVariant.Secondary">In Stock</BadgeCn>
                        </div>

                        <div class="mt-2 flex items-center gap-1">
                            <LucideStarCn Size="16" Class="h-4 w-4 fill-primary text-primary" />
                            <span class="text-sm font-medium">4.7</span>
                            <span class="text-sm text-muted-foreground">(342 reviews)</span>
                        </div>

                        <p class="mt-4 text-sm text-muted-foreground line-clamp-3">
                            Experience crystal-clear audio with advanced noise cancellation technology.
                            30-hour battery life, comfortable memory foam ear cushions, and premium build quality.
                        </p>

                        <div class="mt-4 flex items-center gap-2 text-sm text-muted-foreground">
                            <LucideTruckCn Size="16" Class="h-4 w-4" />
                            <span>Free shipping</span>
                        </div>
                    </div>

                    <div class="mt-6 flex items-end justify-between gap-4">
                        <p class="text-3xl font-bold tabular-nums">$249.99</p>
                        <div class="flex gap-2">
                            <ButtonCn Variant="ButtonVariant.Outline">
                                <LucideShoppingCartCn Size="16" Class="mr-2 h-4 w-4" />
                                Add to Cart
                            </ButtonCn>
                            <ButtonCn>Buy Now</ButtonCn>
                        </div>
                    </div>
                </CardContentCn>
            </div>
        </CardCn>
    </div>
</section>

@code {
    private const string ProductName = "Premium Noise-Cancelling Headphones";
}
