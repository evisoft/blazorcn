@* ============================================================
   Block: product-card-horizontal
   Title: ProductCardHorizontal
   Description: Horizontal product card with side-by-side image and details for React product listings
   Source: original/blocks/product-cards/product-card-horizontal.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[700px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="grid md:grid-cols-[200px_1fr]">
                <div class="aspect-square md:aspect-square md:h-[200px]">
                    <img
                        alt="@_product.Name"
                        class="h-full w-full object-cover"
                        height="400"
                        src="@_product.Image"
                        width="400" />
                </div>

                <CardContentCn Class="flex flex-col p-6">
                    <div class="flex-1">
                        <div class="flex items-start justify-between gap-4">
                            <h2 class="text-xl font-semibold">@_product.Name</h2>
                            @if (_product.InStock)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary">In Stock</BadgeCn>
                            }
                        </div>

                        <div class="mt-2 flex items-center gap-1">
                            <LucideIconCn Name="star" Size="16" Class="h-4 w-4 fill-primary text-primary" />
                            <span class="text-sm font-medium">@_product.Rating</span>
                            <span class="text-sm text-muted-foreground">(@(_product.ReviewCount) reviews)</span>
                        </div>

                        <p class="mt-4 text-sm text-muted-foreground line-clamp-3">@_product.Description</p>

                        @if (_product.FreeShipping)
                        {
                            <div class="mt-4 flex items-center gap-2 text-sm text-muted-foreground">
                                <LucideIconCn Name="truck" Size="16" Class="h-4 w-4" />
                                <span>Free shipping</span>
                            </div>
                        }
                    </div>

                    <div class="mt-6 flex items-end justify-between gap-4">
                        <p class="text-3xl font-bold tabular-nums">$@(_product.Price.ToString("F2"))</p>

                        <div class="flex gap-2">
                            <ButtonCn Variant="ButtonVariant.Outline">
                                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 h-4 w-4" />
                                Add to Cart
                            </ButtonCn>
                            <ButtonCn>Buy Now</ButtonCn>
                        </div>
                    </div>
                </CardContentCn>
            </div>
        </CardCn>
    </div>
</section>

@code {
    private record Product(
        string Name,
        string Description,
        double Price,
        string Image,
        double Rating,
        int ReviewCount,
        bool InStock,
        bool FreeShipping);

    private static readonly Product _product = new(
        Name: "Premium Noise-Cancelling Headphones",
        Description: "Experience crystal-clear audio with advanced noise cancellation technology. 30-hour battery life, comfortable memory foam ear cushions, and premium build quality.",
        Price: 249.99,
        Image: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=400&q=80",
        Rating: 4.7,
        ReviewCount: 342,
        InStock: true,
        FreeShipping: true);
}
