@* ============================================================
   Block: product-card-skincare
   Title: ProductCardSkincare
   Description: Skincare product card with ingredient list, skin type badges, and routine step for React beauty stores
   Source: original/blocks/product-cards/product-card-skincare.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Image *@
        <div class="relative flex h-[220px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="droplets" Size="64" Class="size-16 text-muted-foreground/30" />
            <BadgeCn Class="absolute top-3 left-3" Variant="BadgeVariant.Secondary">
                @_product.RoutineStep
            </BadgeCn>
        </div>

        @* Title and price *@
        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">@_product.Brand</p>
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <div class="mt-1 flex items-baseline gap-2">
                <span class="text-2xl font-semibold tabular-nums">$@_product.Price</span>
                <span class="text-xs text-muted-foreground">@_product.Volume</span>
            </div>
        </div>

        @* Skin types *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">SUITABLE FOR</p>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var skinType in _product.SkinTypes)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@skinType</BadgeCn>
                }
            </div>
        </div>

        @* Key ingredients *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">KEY INGREDIENTS</p>
            <div class="space-y-2">
                @foreach (var ingredient in _product.KeyIngredients)
                {
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-sm font-medium">@ingredient.Name</span>
                        </div>
                        <span class="text-xs text-muted-foreground">@ingredient.Benefit</span>
                    </div>
                }
            </div>
        </div>

        @* Certifications *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                @if (_product.IsCrueltyFree)
                {
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="leaf" Size="12" Class="size-3" />
                        <span>Cruelty-free</span>
                    </div>
                }
                @if (_product.IsVegan)
                {
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="leaf" Size="12" Class="size-3" />
                        <span>Vegan</span>
                    </div>
                }
            </div>
        </div>

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Ingredient(string Name, string Benefit);

    private record SkincareProduct(
        string Name,
        string Brand,
        int Price,
        string Volume,
        string RoutineStep,
        string[] SkinTypes,
        Ingredient[] KeyIngredients,
        bool IsCrueltyFree,
        bool IsVegan
    );

    private static readonly SkincareProduct _product = new(
        Name: "Hyaluronic Acid Serum",
        Brand: "GlowLab",
        Price: 38,
        Volume: "30ml / 1 fl oz",
        RoutineStep: "Step 3 — Serum",
        SkinTypes: ["Dry", "Normal", "Combination"],
        KeyIngredients: [
            new("Hyaluronic Acid", "Deep hydration"),
            new("Niacinamide 5%", "Pore refinement"),
            new("Vitamin C", "Brightening"),
            new("Ceramides", "Barrier repair"),
        ],
        IsCrueltyFree: true,
        IsVegan: true
    );
}
