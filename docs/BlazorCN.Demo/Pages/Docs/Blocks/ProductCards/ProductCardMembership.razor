@* ============================================================
   Block: product-card-membership
   Title: Product Card Membership
   Description: Membership pass card with access levels, validity period, and perks for React membership sites
   Long Description: Recipe meal kit card with servings adjuster, cook time, and ingredients for React food sites
   Dependencies: BadgeCn, ButtonCn, CardCn, LucideAwardCn, LucideCalendarCn, LucideCheckCn, LucideUsersCn
   Source: original/blocks/product-cards/product-card-membership.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn class="overflow-hidden ring-2 ring-primary">
            <div class="relative flex items-center justify-between bg-gradient-to-r from-primary/10 via-primary/5 to-transparent p-4">
                <div class="flex items-center gap-3">
                    <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-primary bg-background">
                        <LucideAwardCn Size="20" />
                    </div>
                    <div>
                        <h3 class="font-semibold">@_product.Name</h3>
                        <p class="text-sm text-muted-foreground">@_product.Tier Tier</p>
                    </div>
                </div>
                <BadgeCn>Most Popular</BadgeCn>
            </div>

            <CardContentCn class="p-4">
                <p class="text-sm text-muted-foreground">@_product.Description</p>

                <div class="mt-4 flex items-center gap-2 rounded-lg border p-2">
                    <LucideCalendarCn Size="16" Class="text-muted-foreground" />
                    <span class="text-sm">
                        Valid for @_product.ValidityMonths months from purchase
                    </span>
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">MEMBERSHIP INCLUDES</p>
                    <div class="space-y-1.5">
                        @foreach (var perk in _product.Perks)
                        {
                            <div class="flex items-center gap-2 text-sm">
                                <LucideCheckCn Size="16" Class="text-primary" />
                                <span>@perk</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4 flex items-center gap-2 text-sm text-muted-foreground">
                    <LucideUsersCn Size="16" />
                    <span>Join @_product.MemberCount.ToString("N0")+ members</span>
                </div>

                <div class="mt-4 flex items-baseline gap-1">
                    <span class="text-3xl font-bold tabular-nums">$@_product.Price</span>
                    <span class="text-muted-foreground">/@_product.Period</span>
                </div>
                <p class="text-xs text-muted-foreground">
                    $@((_product.Price / 12.0).ToString("F2"))/month billed annually
                </p>
            </CardContentCn>

            <CardFooterCn class="flex-col gap-2 p-4 pt-0">
                <ButtonCn class="w-full">Become a Member</ButtonCn>
                <ButtonCn class="w-full" Variant="ButtonVariant.Outline">
                    Gift Membership
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record ProductData(string Name, string Tier, int Price, string Period, string Description, int ValidityMonths, int MemberCount, string[] Perks);

    private static readonly ProductData _product = new(
        "Premium Membership",
        "Premium",
        99,
        "year",
        "Full access to all exhibits, events, and exclusive member experiences.",
        12,
        2847,
        [
            "Unlimited museum entry",
            "Free guest passes (4/year)",
            "Members-only events",
            "10% shop discount",
            "Early exhibition access",
            "Quarterly magazine",
        ]
    );
}
