@* ============================================================
   Block: product-card-bundle
   Title: ProductCardBundle
   Description: Product bundle card with individual items, savings callout, and bundle pricing for React ecommerce
   Source: original/blocks/product-cards/product-card-bundle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="relative flex h-[160px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="package" Size="64" Class="size-16 text-muted-foreground/30" />
            <BadgeCn Class="absolute top-3 left-3">Bundle</BadgeCn>
            @if (_savingsPercent > 0)
            {
                <BadgeCn Class="absolute top-3 right-3" Variant="BadgeVariant.Secondary">
                    Save @_savingsPercent%
                </BadgeCn>
            }
        </div>

        @* Title *@
        <div class="border-t px-4 py-3">
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">@_product.Description</p>
        </div>

        @* Bundle items *@
        <div class="border-t">
            <div class="px-4 py-2">
                <p class="text-xs font-medium text-muted-foreground">INCLUDED ITEMS</p>
            </div>
            @foreach (var entry in _product.Items.Select((item, idx) => (item, idx)))
            {
                var item = entry.item;
                var index = entry.idx;
                <div class="flex cursor-pointer items-center gap-3 border-t px-4 py-2.5 transition-colors hover:bg-muted/50">
                    <div
                        class="@Cn.Merge("flex size-5 shrink-0 items-center justify-center rounded border transition-colors", _selectedItems[index] ? "border-foreground bg-foreground text-background" : "border-muted-foreground/30")"
                        @onclick="@(() => ToggleItem(index))"
                        role="checkbox"
                        tabindex="0"
                        aria-checked="@_selectedItems[index].ToString().ToLower()">
                        @if (_selectedItems[index])
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                        }
                    </div>
                    <span class="flex-1 text-sm">@item.Name</span>
                    <span class="text-xs text-muted-foreground tabular-nums">$@item.Price</span>
                </div>
            }
        </div>

        @* Pricing summary *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
                <span>Individual total</span>
                <span class="tabular-nums line-through">$@_individualTotal</span>
            </div>
            @if (_savings > 0)
            {
                <div class="mt-1 flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Bundle savings</span>
                    <span class="font-medium text-emerald-600 tabular-nums">-$@_savings</span>
                </div>
            }
            <div class="mt-2 flex items-center justify-between">
                <span class="text-sm font-medium">Bundle price</span>
                <span class="text-2xl font-semibold tabular-nums">
                    $@(_allSelected ? _product.BundlePrice : _individualTotal)
                </span>
            </div>
        </div>

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add Bundle to Cart
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record BundleItem(string Name, int Price, bool Included);

    private record BundleProduct(string Name, string Description, int BundlePrice, BundleItem[] Items);

    private static readonly BundleProduct _product = new(
        Name: "Complete Skincare Starter Kit",
        Description: "Everything you need for a full morning routine",
        BundlePrice: 89,
        Items:
        [
            new("Gentle Cleanser (150ml)", 28, true),
            new("Vitamin C Serum (30ml)", 42, true),
            new("Daily Moisturizer (50ml)", 35, true),
            new("SPF 50 Sunscreen (40ml)", 24, true),
        ]
    );

    private bool[] _selectedItems = _product.Items.Select(i => i.Included).ToArray();

    private int _individualTotal => _product.Items
        .Select((item, i) => _selectedItems[i] ? item.Price : 0)
        .Sum();

    private bool _allSelected => _selectedItems.All(x => x);

    private int _savings => _allSelected ? _individualTotal - _product.BundlePrice : 0;

    private int _savingsPercent => _allSelected
        ? (int)Math.Round((double)_savings / _individualTotal * 100)
        : 0;

    private void ToggleItem(int index)
    {
        _selectedItems[index] = !_selectedItems[index];
    }
}
