@* ============================================================
   Block: product-card-recommendation
   Title: ProductCardRecommendation
   Description: AI-recommended product card with match score, reasoning, and personalization indicators for React stores
   Source: original/blocks/product-cards/product-card-recommendation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* AI recommendation header *@
        <div class="flex items-center gap-2 px-4 py-2.5">
            <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-muted-foreground" />
            <span class="text-xs font-medium text-muted-foreground">Recommended for you</span>
        </div>

        @* Image *@
        <div class="relative flex h-[200px] items-center justify-center border-t bg-muted/50">
            <LucideIconCn Name="shopping-cart" Size="64" Class="size-16 text-muted-foreground/30" />
            <div class="absolute top-3 right-3 rounded-full bg-background/90 px-2.5 py-1">
                <span class="text-xs font-semibold tabular-nums">@_product.MatchScore% match</span>
            </div>
        </div>

        @* Product info *@
        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">@_product.Brand</p>
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <p class="mt-1 text-2xl font-semibold tabular-nums">$@_product.Price</p>
        </div>

        @* Match score bar *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Match score</span>
                <span class="font-medium tabular-nums">@_product.MatchScore%</span>
            </div>
            <div class="mt-1.5 h-1.5 w-full rounded-full bg-muted">
                <div
                    class="h-full rounded-full bg-foreground"
                    style="@($"width:{_product.MatchScore}%")">
                </div>
            </div>
        </div>

        @* Recommendation reason *@
        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">@_product.Reason</p>
            <div class="mt-2 flex flex-wrap gap-1.5">
                @foreach (var tag in _product.Tags)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@tag</BadgeCn>
                }
            </div>
        </div>

        @* Based on *@
        <div class="border-t px-4 py-3">
            <p class="mb-1.5 text-xs font-medium text-muted-foreground">BASED ON</p>
            <div class="space-y-1">
                @foreach (var item in _product.BasedOn)
                {
                    <div class="flex items-center gap-2">
                        <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                        <span class="text-xs text-muted-foreground">@item</span>
                    </div>
                }
            </div>
        </div>

        @* Feedback *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">Is this relevant?</span>
                <div class="flex gap-1">
                    <button
                        type="button"
                        class="@Cn.Merge("flex size-7 items-center justify-center rounded-md transition-colors", _feedback == "up" ? "bg-foreground text-background" : "hover:bg-muted/50")"
                        @onclick="@(() => _feedback = _feedback == "up" ? null : "up")"
                        aria-label="Good recommendation">
                        <LucideIconCn Name="thumbs-up" Size="14" Class="size-3.5" />
                    </button>
                    <button
                        type="button"
                        class="@Cn.Merge("flex size-7 items-center justify-center rounded-md transition-colors", _feedback == "down" ? "bg-foreground text-background" : "hover:bg-muted/50")"
                        @onclick="@(() => _feedback = _feedback == "down" ? null : "down")"
                        aria-label="Not relevant">
                        <LucideIconCn Name="thumbs-down" Size="14" Class="size-3.5" />
                    </button>
                </div>
            </div>
        </div>

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record RecommendedProduct(
        string Name,
        string Brand,
        int Price,
        int MatchScore,
        string Reason,
        string[] BasedOn,
        string[] Tags);

    private static readonly RecommendedProduct _product = new(
        Name: "Noise-Cancelling Headphones",
        Brand: "AudioTech",
        Price: 249,
        MatchScore: 94,
        Reason: "Based on your interest in audio gear and work-from-home setup",
        BasedOn: ["Wireless Earbuds Pro", "Standing Desk Mat"],
        Tags: ["Audio", "Work from home", "Premium"]);

    private string? _feedback = null;
}
