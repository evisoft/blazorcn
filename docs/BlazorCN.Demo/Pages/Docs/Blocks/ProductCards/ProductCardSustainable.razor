@* ============================================================
   Block: product-card-sustainable
   Title: ProductCardSustainable
   Description: Eco-friendly product card with sustainability certifications, carbon footprint, and impact metrics for React stores
   Source: original/blocks/product-cards/product-card-sustainable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Image *@
        <div class="relative flex h-[200px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="leaf" Size="64" Class="size-16 text-muted-foreground/30" />
            <BadgeCn Class="absolute top-3 left-3">
                <LucideIconCn Name="leaf" Size="12" Class="mr-1 size-3" />
                Eco-friendly
            </BadgeCn>
        </div>

        @* Product info *@
        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">@_product.Brand</p>
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <p class="mt-1 text-2xl font-semibold tabular-nums">$@_product.Price</p>
        </div>

        @* Sustainability score *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="text-xs font-medium text-muted-foreground">SUSTAINABILITY SCORE</p>
                <span class="text-xs font-semibold tabular-nums">@_product.SustainabilityScore/@_product.MaxScore</span>
            </div>
            <div class="mt-1.5 h-1.5 w-full rounded-full bg-muted">
                <div
                    class="h-full rounded-full bg-emerald-500"
                    style="@($"width:{_product.SustainabilityScore}%")">
                </div>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                Carbon footprint: @_product.CarbonFootprint
            </p>
        </div>

        @* Impact metrics *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">YOUR IMPACT</p>
            <div class="grid grid-cols-3 gap-2">
                @foreach (var metric in _product.ImpactMetrics)
                {
                    <div class="rounded-md bg-muted/50 px-2 py-2 text-center">
                        <div class="mx-auto mb-1 flex size-6 items-center justify-center">
                            @if (metric.Icon == "recycle")
                            {
                                <LucideIconCn Name="recycle" Size="16" Class="size-4 text-muted-foreground" />
                            }
                            @if (metric.Icon == "water")
                            {
                                <LucideIconCn Name="droplets" Size="16" Class="size-4 text-muted-foreground" />
                            }
                            @if (metric.Icon == "tree")
                            {
                                <LucideIconCn Name="tree-pine" Size="16" Class="size-4 text-muted-foreground" />
                            }
                        </div>
                        <p class="text-sm font-semibold tabular-nums">@metric.Value</p>
                        <p class="text-xs text-muted-foreground leading-tight">@metric.Label</p>
                    </div>
                }
            </div>
        </div>

        @* Materials *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">MATERIALS</p>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var material in _product.Materials)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@material</BadgeCn>
                }
            </div>
        </div>

        @* Certifications *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">CERTIFICATIONS</p>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var cert in _product.Certifications)
                {
                    <div class="flex items-center gap-1 rounded-full border px-2.5 py-1">
                        <LucideIconCn Name="leaf" Size="12" Class="size-3 text-emerald-600" />
                        <span class="text-xs font-medium">@cert</span>
                    </div>
                }
            </div>
        </div>

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record ImpactMetric(string Label, string Value, string Icon);

    private record SustainableProduct(
        string Name,
        string Brand,
        int Price,
        int SustainabilityScore,
        int MaxScore,
        string CarbonFootprint,
        string[] Materials,
        string[] Certifications,
        ImpactMetric[] ImpactMetrics
    );

    private static readonly SustainableProduct _product = new(
        Name: "Recycled Ocean Plastic Backpack",
        Brand: "EarthLoop",
        Price: 89,
        SustainabilityScore: 92,
        MaxScore: 100,
        CarbonFootprint: "2.1 kg CO2e",
        Materials:
        [
            "Recycled ocean plastic",
            "Organic cotton lining",
            "Bio-based zippers",
            "Vegetable-tanned leather",
        ],
        Certifications: ["B Corp", "Fair Trade", "GOTS Certified", "1% for the Planet"],
        ImpactMetrics:
        [
            new("Plastic bottles diverted", "12", "recycle"),
            new("Water saved vs conventional", "340L", "water"),
            new("Trees planted per purchase", "1", "tree"),
        ]
    );
}
