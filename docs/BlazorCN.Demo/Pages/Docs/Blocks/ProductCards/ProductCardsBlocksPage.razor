        </div>

        <div class=""border-b px-4 py-3"">
            <p class=""text-xs font-medium text-muted-foreground"">Manduka</p>
            <h3 class=""text-sm font-medium"">eKO Superlite Yoga Mat</h3>
            <p class=""mt-1 text-xs text-muted-foreground"">
                Natural tree rubber &middot; Non-toxic &middot; Closed-cell surface
            </p>
            <p class=""mt-2 text-2xl font-semibold tabular-nums"">$@_currentThickness.Price</p>
        </div>

        <div class=""border-b px-4 py-3"">
            <p class=""mb-2 text-xs font-medium text-muted-foreground"">
