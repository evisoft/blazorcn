@page "/docs/blocks/product-cards"
@layout DocsLayout

<PageTitle>ProductCards Blocks — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">ProductCards</h1>
        <p class="mt-2 text-lg text-muted-foreground">Product card grids, catalogs, and collection display blocks.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Product Card Auction" Description="Auction product card with current bid, time remaining, and bid history for React auction sites" Code="@ProductCardAuctionCode">
        <ProductCardAuction />
    </ComponentPreview>

    <ComponentPreview Title="Product Card Digital" Description="Digital download product card with file info and instant delivery for React stores" Code="@ProductCardDigitalCode">
        <ProductCardDigital />
    </ComponentPreview>

    <ComponentPreview Title="Product Card Horizontal" Description="Horizontal product card with side-by-side image and details for React product listings" Code="@ProductCardHorizontalCode">
        <ProductCardHorizontal />
    </ComponentPreview>

    <ComponentPreview Title="Product Card Membership" Description="Membership pass card with access levels, validity period, and perks for React membership sites" Code="@ProductCardMembershipCode">
        <ProductCardMembership />
    </ComponentPreview>

    <ComponentPreview Title="Product Card Service" Description="Service package card with duration, what's included, and booking for React service businesses" Code="@ProductCardServiceCode">
        <ProductCardService />
    </ComponentPreview>

    <ComponentPreview Title="Product Card Simple" Description="Simple product card component with image, title, price, and add to cart for React ecommerce" Code="@ProductCardSimpleCode">
        <ProductCardSimple />
    </ComponentPreview>

    <ComponentPreview Title="Product Card Subscription" Description="Subscription box product card with items preview and billing options for React ecommerce" Code="@ProductCardSubscriptionCode">
        <ProductCardSubscription />
    </ComponentPreview>

</div>

@code {
    private const string ProductCardAuctionCode = @"<section class=""container mx-auto px-4 py-6"">
    <div class=""mb-6 text-center"">
        <h1 class=""text-3xl font-bold tracking-tight"">Product Card</h1>
    </div>

    <div class=""mx-auto w-[300px] max-w-full"">
        <CardCn class=""overflow-hidden"">
            <div class=""relative h-[180px]"">
                <img
                    alt=""@_product.Name""
                    class=""h-full w-full object-cover""
                    height=""400""
                    src=""@_product.Image""
                    width=""400"" />
                <BadgeCn class=""absolute top-3 left-3"">
                    <LucideGavelCn Size=""12"" Class=""mr-1"" />
                    Live Auction
                </BadgeCn>
                <button
                    type=""button""
                    class=""@Cn.Merge(""absolute top-3 right-3 flex h-8 w-8 items-center justify-center rounded-full"", _isWatching ? ""bg-primary text-primary-foreground"" : ""bg-background/90"")""
                    @onclick=""() => _isWatching = !_isWatching"">
                    <LucideBellCn Size=""16"" />
                </button>
            </div>

            <CardContentCn class=""p-4"">
                <h3 class=""font-semibold"">@_product.Name</h3>
                <p class=""mt-1 text-sm text-muted-foreground line-clamp-2"">@_product.Description</p>

                <div class=""mt-3 flex items-center justify-between rounded-lg border p-2"">
                    <div class=""flex items-center gap-2"">
                        <LucideClockCn Size=""16"" Class=""text-muted-foreground"" />
                        <span class=""text-sm font-medium"">@_timeLeft</span>
                    </div>
                    <div class=""flex items-center gap-1 text-xs text-muted-foreground"">
                        <LucideUsersCn Size=""12"" />
                        <span>@_product.Watchers watching</span>
                    </div>
                </div>

                <div class=""mt-4"">
                    <div class=""flex items-baseline justify-between"">
                        <div>
                            <p class=""text-xs text-muted-foreground"">Current Bid</p>
                            <p class=""text-2xl font-bold tabular-nums"">$@_product.CurrentBid.ToString(""N0"")</p>
                        </div>
                        <div class=""text-right"">
                            <p class=""text-xs text-muted-foreground"">Est. Value</p>
                            <p class=""text-sm font-medium tabular-nums"">$@_product.EstimatedValue.ToString(""N0"")</p>
                        </div>
                    </div>

                    <ProgressCn class=""mt-2 h-1.5"" Value=""@Math.Min(_bidProgress, 100)"" />

                    <div class=""mt-2 flex items-center justify-between text-xs text-muted-foreground"">
                        <div class=""flex items-center gap-1"">
                            <LucideTrendingUpCn Size=""12"" />
                            <span>@_product.BidCount bids</span>
                        </div>
                        <span>Min increment: $@_product.BidIncrement</span>
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn class=""flex-col gap-2 p-4 pt-0"">
                <ButtonCn class=""w-full"">
                    <LucideGavelCn Size=""16"" Class=""mr-2"" />
                    Bid $@_nextBid.ToString(""N0"")
                </ButtonCn>
                <ButtonCn class=""w-full"" Variant=""ButtonVariant.Outline"">
                    Place Custom Bid
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record ProductData(string Name, string Description, string Image, int CurrentBid, int StartingBid, int EstimatedValue, int BidCount, int BidIncrement, int Watchers);

    private bool _isWatching;
    private string _timeLeft = ""4h 0m 0s"";

    private static readonly ProductData _product = new(
        ""Vintage Rolex Submariner"",
        ""1967 Rolex Submariner ref. 5513, excellent condition with original box and papers."",
        ""https://images.unsplash.com/photo-1587836374828-4dbafa94cf0e?w=400&q=80"",
        12500, 8000, 18000, 23, 250, 47
    );

    private int _nextBid => _product.CurrentBid + _product.BidIncrement;
    private double _bidProgress => (double)(_product.CurrentBid - _product.StartingBid) / (_product.EstimatedValue - _product.StartingBid) * 100;
}";
