    private record StockProduct(
        string Ticker,
        string Name,
        double Price,
        double Change,
        double ChangePercent,
        string MarketCap,
        double PeRatio,
        string Volume,
        double High52w,
        double Low52w,
        string AnalystRating,
        double[] Sparkline);

    private static readonly StockProduct _product = new(
        Ticker: ""AAPL"",
        Name: ""Apple Inc."",
        Price: 178.52,
        Change: 3.24,
        ChangePercent: 1.85,
        MarketCap: ""$2.8T"",
        PeRatio: 28.4,
        Volume: ""52.3M"",
        High52w: 198.23,
        Low52w: 124.17,
        AnalystRating: ""Buy"",
        Sparkline: [165, 168, 172, 169, 175, 173, 178, 176, 180, 178, 182, 179]);

    private string _timeframe = ""1D"";
    private bool _isWatched = false;

    private bool _isPositive => _product.Change >= 0;

    private string _ratingColor => _product.AnalystRating switch
    {
        ""Strong Buy"" => ""text-primary"",
        ""Buy"" => ""text-primary"",
        ""Hold"" => ""text-muted-foreground"",
        ""Sell"" => ""text-destructive"",
        ""Strong Sell"" => ""text-destructive"",
        _ => """"
    };

    private double _price52wPosition =>
        (_product.Price - _product.Low52w) / (_product.High52w - _product.Low52w) * 100;

    private string GenerateSparkline()
    {
        var data = _product.Sparkline;
        var min = data.Min();
        var max = data.Max();
        var range = max - min > 0 ? max - min : 1;
        const int width = 120;
        const int height = 32;
        var points = data.Select((val, i) =>
        {
            var x = (i / (double)(data.Length - 1)) * width;
            var y = height - ((val - min) / range) * height;
            return $""{x},{y}"";
        });
        return $""M{string.Join("" L"", points)}"";
    }
}";

