    );

    private record DurationOption(string Value, string Label);

    private static readonly Product _product = new(
        Name: ""Central Plaza Garage"",
        Address: ""123 Main Street, Downtown"",
        Distance: ""0.3 mi"",
        Type: ""Covered"",
        HourlyRate: 4,
        DailyRate: 25,
        SpotsAvailable: 47,
        TotalSpots: 200,
        Amenities: [""24/7 Access"", ""Security cameras"", ""Well lit"", ""Elevator""],
