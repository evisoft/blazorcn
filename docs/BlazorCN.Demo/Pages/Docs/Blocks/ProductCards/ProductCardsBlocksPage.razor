}";

    private const string ProductCardWishlistCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @* Image with wishlist toggle *@
        <div class=""relative flex h-[220px] items-center justify-center bg-muted/50"">
            <LucideIconCn Name=""heart"" Size=""64"" Class=""@Cn.Merge(""size-16 transition-colors"", _isWishlisted ? ""fill-red-500 text-red-500"" : ""text-muted-foreground/30"")"" />
