            {
                <BadgeCn Class=""absolute top-3 left-3"" Variant=""BadgeVariant.Secondary"">
                    Price dropped @_savingsPercent%
                </BadgeCn>
            }
            <button
                type=""button""
                @onclick=""@(() => _isWishlisted = !_isWishlisted)""
                class=""absolute top-3 right-3 flex size-9 items-center justify-center rounded-full bg-background/90 transition-colors hover:bg-background""
                aria-label=""@(_isWishlisted ? ""Remove from wishlist"" : ""Add to wishlist"")"">
                <LucideIconCn Name=""heart"" Size=""16"" Class=""@Cn.Merge(""size-4 transition-colors"", _isWishlisted ? ""fill-red-500 text-red-500"" : ""text-foreground"")"" />
            </button>
        </div>

        @* Product info *@
        <div class=""border-t px-4 py-3"">
            <p class=""text-xs text-muted-foreground"">@_product.Brand</p>
            <h3 class=""text-sm font-medium"">@_product.Name</h3>
            <div class=""mt-1 flex items-center gap-1"">
                <LucideIconCn Name=""star"" Size=""12"" Class=""size-3 fill-foreground text-foreground"" />
                <span class=""text-xs font-medium"">@_product.Rating</span>
                <span class=""text-xs text-muted-foreground"">(@_product.ReviewCount)</span>
            </div>
        </div>

        @* Price *@
        <div class=""border-t px-4 py-3"">
            <div class=""flex items-baseline gap-2"">
                <span class=""text-2xl font-semibold tabular-nums"">$@_product.Price</span>
                @if (_hasDiscount)
                {
                    <span class=""text-sm text-muted-foreground line-through tabular-nums"">
                        $@_product.OriginalPrice
                    </span>
                }
            </div>
            <p class=""mt-0.5 text-xs text-muted-foreground"">Added @_product.AddedDate</p>
        </div>

        @* Price alert toggle *@
        <div class=""border-t px-4 py-3"">
            <div class=""flex cursor-pointer items-center justify-between"">
                <div class=""flex items-center gap-2"">
                    <LucideIconCn Name=""bell"" Size=""14"" Class=""size-3.5 text-muted-foreground"" />
                    <span class=""text-xs font-medium"">Price drop alert</span>
                </div>
                <div
                    @onclick=""@(() => _priceAlert = !_priceAlert)""
                    role=""switch""
                    tabindex=""0""
                    aria-checked=""@_priceAlert.ToString().ToLower()""
                    class=""@Cn.Merge(""relative h-5 w-9 cursor-pointer rounded-full transition-colors"", _priceAlert ? ""bg-foreground"" : ""bg-muted"")"">
                    <div class=""@Cn.Merge(""absolute top-0.5 size-4 rounded-full bg-background transition-transform"", _priceAlert ? ""translate-x-4"" : ""translate-x-0.5"")"" />
                </div>
            </div>
        </div>

        @* Actions *@
        <div class=""border-t px-4 py-3"">
            <div class=""flex gap-2"">
                <ButtonCn Class=""flex-1"" Size=""ButtonSize.Sm"">
                    <LucideIconCn Name=""shopping-cart"" Size=""16"" Class=""mr-2 size-4"" />
                    Move to Cart
                </ButtonCn>
                <ButtonCn Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Outline"" Class=""px-3"">
                    <LucideIconCn Name=""share-2"" Size=""16"" Class=""size-4"" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record WishlistProduct(
        string Name,
        string Brand,
        int Price,
        int OriginalPrice,
        double Rating,
        int ReviewCount,
        string AddedDate,
        bool InStock);

    private static readonly WishlistProduct _product = new(
        ""Merino Wool Cardigan"",
        ""Norse Projects"",
        185,
        220,
        4.6,
        89,
        ""2 weeks ago"",
        true);

    private bool _isWishlisted = true;
    private bool _priceAlert = false;

    private bool _hasDiscount => _product.Price < _product.OriginalPrice;

    private int _savingsPercent =>
        _hasDiscount
            ? (int)Math.Round(((double)(_product.OriginalPrice - _product.Price) / _product.OriginalPrice) * 100)
            : 0;
}";

    private const string ProductCardYogaMatCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        <div class=""relative flex h-[180px] items-center justify-center bg-muted/50"">
            <LucideIconCn Name=""image"" Size=""48"" Class=""size-12 text-muted-foreground/40"" />
