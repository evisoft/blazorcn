@code {
    private const string ProductCardAppointmentCode = @"<section class=""container mx-auto px-4 py-6"">
    <div class=""mb-6 text-center"">
        <h1 class=""text-3xl font-bold tracking-tight"">Product Card</h1>
    </div>

    <div class=""mx-auto w-[320px] max-w-full"">
        <CardCn Class=""overflow-hidden"">
            <div class=""relative h-[140px]"">
                <img
                    alt=""@_product.Name""
                    class=""h-full w-full object-cover""
                    height=""400""
                    src=""@_product.Image""
                    width=""400"" />
                <BadgeCn Class=""absolute top-3 left-3"">
                    <LucideIconCn Name=""clock"" Size=""12"" Class=""mr-1 h-3 w-3"" />
                    @_product.Duration
                </BadgeCn>
            </div>

            <CardContentCn Class=""p-4"">
                <div class=""flex items-start justify-between gap-2"">
                    <div>
                        <h3 class=""font-semibold"">@_product.Name</h3>
                        <p class=""mt-1 text-sm text-muted-foreground"">@_product.Description</p>
                    </div>
                    <span class=""text-lg font-bold tabular-nums"">$@_product.Price</span>
                </div>

                @* Provider selector *@
                <div class=""mt-4"">
                    <p class=""mb-2 text-xs font-medium text-muted-foreground"">SELECT PROVIDER</p>
                    <div class=""flex gap-2"">
                        @foreach (var prov in _product.Providers)
                        {
                            var provider = prov;
                            <button
                                type=""button""
                                class=""@Cn.Merge(""flex flex-col items-center gap-1 rounded-lg border p-2 transition-all"", _selectedProvider == provider.Id ? ""border-primary ring-1 ring-primary"" : ""border-border"")""
                                @onclick=""@(() => _selectedProvider = provider.Id)"">
                                <AvatarCn Class=""h-10 w-10"">
                                    <AvatarImageCn Src=""@provider.Avatar"" />
                                    <AvatarFallbackCn>@provider.Name[0]</AvatarFallbackCn>
                                </AvatarCn>
                                <span class=""text-xs font-medium"">@GetLastName(provider.Name)</span>
                            </button>
                        }
                    </div>
                    @{
                        var currentProvider = _product.Providers.FirstOrDefault(p => p.Id == _selectedProvider);
                    }
                    @if (currentProvider != null)
                    {
                        <p class=""mt-2 text-xs text-muted-foreground"">
                            <LucideIconCn Name=""user"" Size=""12"" Class=""mr-1 inline h-3 w-3"" />
                            @currentProvider.Name • @currentProvider.Specialty
                        </p>
                    }
                </div>

                @* Date display *@
                <div class=""mt-4 flex items-center gap-2 text-sm"">
                    <LucideIconCn Name=""calendar"" Size=""16"" Class=""h-4 w-4 text-muted-foreground"" />
                    <span class=""font-medium"">@_product.SelectedDate</span>
                    <ButtonCn Class=""h-auto p-0 text-xs"" Variant=""ButtonVariant.Link"">Change</ButtonCn>
                </div>

                @* Time slots *@
                <div class=""mt-3"">
                    <p class=""mb-2 text-xs font-medium text-muted-foreground"">
                        AVAILABLE TIMES (@(_product.TimeSlots.Count(s => s.Available)) slots)
                    </p>
                    <div class=""flex flex-wrap gap-1"">
                        @foreach (var sl in _product.TimeSlots)
                        {
                            var slot = sl;
                            <button
                                type=""button""
                                class=""@Cn.Merge(""inline-flex h-8 items-center justify-center rounded-md border px-3 text-xs font-medium transition-colors"", _selectedTime == slot.Id ? ""bg-primary text-primary-foreground border-primary"" : ""bg-background text-foreground border-border hover:bg-accent hover:text-accent-foreground"", !slot.Available ? ""pointer-events-none opacity-50"" : """")""
                                disabled=""@(!slot.Available)""
                                @onclick=""@(() => { if (slot.Available) _selectedTime = _selectedTime == slot.Id ? """" : slot.Id; })"">
                                @slot.Time
                            </button>
                        }
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class=""p-4 pt-0"">
                <ButtonCn Class=""w-full"" Disabled=""@(string.IsNullOrEmpty(_selectedTime))"">
                    @(string.IsNullOrEmpty(_selectedTime) ? ""Select a Time"" : ""Book Appointment"")
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record Provider(string Id, string Name, string Avatar, string Specialty);
    private record TimeSlot(string Id, string Time, bool Available);
    private record Product(string Name, string Description, int Price, string Duration, string Image, string SelectedDate, Provider[] Providers, TimeSlot[] TimeSlots);

    private string _selectedProvider = ""dr-smith"";
    private string _selectedTime = """";

    private static readonly Product _product = new(
        Name: ""General Consultation"",
        Description: ""Comprehensive health assessment with your physician."",
        Price: 150,
        Duration: ""30 min"",
        Image: ""https://images.unsplash.com/photo-1631217868264-e5b90bb7e133?w=400&q=80"",
        SelectedDate: ""Dec 10, 2025"",
        Providers:
        [
            new(""dr-smith"", ""Dr. Smith"", ""https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?w=100&q=80"", ""Primary Care""),
            new(""dr-jones"", ""Dr. Jones"", ""https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=100&q=80"", ""Internal Medicine""),
            new(""dr-patel"", ""Dr. Patel"", ""https://images.unsplash.com/photo-1537368910025-700350fe46c7?w=100&q=80"", ""Family Medicine""),
        ],
        TimeSlots:
        [
            new(""9am"", ""9:00 AM"", true),
            new(""930am"", ""9:30 AM"", false),
            new(""10am"", ""10:00 AM"", true),
            new(""1030am"", ""10:30 AM"", true),
            new(""11am"", ""11:00 AM"", false),
            new(""2pm"", ""2:00 PM"", true),
            new(""230pm"", ""2:30 PM"", true),
            new(""3pm"", ""3:00 PM"", false),
        ]
    );

    private static string GetLastName(string fullName)
    {
        var parts = fullName.Split(' ');
        return parts.Length > 1 ? parts[1] : fullName;
    }
}";

    private const string ProductCardArtPrintCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        <div class=""relative flex aspect-[4/3] max-h-[240px] items-center justify-center bg-muted/50"">
            <LucideIconCn Name=""image"" Size=""48"" Class=""size-12 text-muted-foreground/40"" />
            <BadgeCn Class=""absolute top-3 left-3"">Limited Edition</BadgeCn>
            <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""absolute top-3 right-3"">
                #42 / 250
            </BadgeCn>
        </div>

        <div class=""border-b px-4 py-3"">
            <div class=""flex items-center gap-2"">
                <div class=""size-5 rounded-full bg-muted""></div>
