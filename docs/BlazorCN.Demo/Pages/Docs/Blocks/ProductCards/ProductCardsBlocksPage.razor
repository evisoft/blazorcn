@code {
    private record FlashSaleProduct(
        string Name,
        int OriginalPrice,
        int SalePrice,
        int TotalStock,
        int SoldCount,
        int SaleEndHours);

    private static readonly FlashSaleProduct _product = new(
        ""Smart Home Speaker Hub"",
        199,
        89,
        200,
        156,
        3);

    private (int Hours, int Minutes, int Seconds) _timeLeft = (3, 0, 0);
    private System.Threading.Timer? _timer;
    private DateTime _endTime;

    protected override void OnInitialized()
    {
        _endTime = DateTime.UtcNow.AddHours(_product.SaleEndHours);
        UpdateTimer();
        _timer = new System.Threading.Timer(_ =>
        {
            UpdateTimer();
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void UpdateTimer()
    {
        var diff = _endTime - DateTime.UtcNow;
        if (diff <= TimeSpan.Zero)
        {
            _timeLeft = (0, 0, 0);
            return;
        }
        _timeLeft = ((int)diff.TotalHours, diff.Minutes, diff.Seconds);
    }

    private int _savingsPercent =>
        (int)Math.Round(((double)(_product.OriginalPrice - _product.SalePrice) / _product.OriginalPrice) * 100);

    private int _remaining => _product.TotalStock - _product.SoldCount;

    private double _soldPercent =>
        ((double)_product.SoldCount / _product.TotalStock) * 100;

    public void Dispose()
    {
        _timer?.Dispose();
    }
}";

