        new(""24"", ""24 hrs""),
    ];

    private string _duration = ""2"";

    private int _hours => int.Parse(_duration);
    private bool _useDaily => _hours >= 8;
    private double _totalPrice => _useDaily
        ? (_hours >= 24
            ? _product.DailyRate
            : Math.Min(_product.HourlyRate * _hours, _product.DailyRate))
        : _product.HourlyRate * _hours;

    private double _availabilityPercent => ((double)_product.SpotsAvailable / _product.TotalSpots) * 100;
    private string _availabilityColor => _availabilityPercent > 30
        ? ""text-primary""
        : _availabilityPercent > 10
            ? ""text-amber-600""
            : ""text-destructive"";

    private void SetDuration(string value) => _duration = value;
}";

