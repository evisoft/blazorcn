@code {
    private record TimeLeft(int Days, int Hours, int Minutes);

    // Product constants
    private const string _name = ""Mega Millions"";
    private const int _jackpot = 425_000_000;
    private const int _ticketPrice = 2;
    private const int _numbersToSelect = 6;
    private const int _maxNumber = 49;
    private static readonly int[] _lastWinningNumbers = [7, 14, 21, 35, 42, 49];

    private List<int> _selectedNumbers = [];
    private TimeLeft _timeLeft = new(2, 5, 0);

    private static string FormatJackpot(long amount)
    {
        if (amount >= 1_000_000_000)
            return $""${(amount / 1_000_000_000.0):0.0}B"";
        return $""${(amount / 1_000_000.0):0}M"";
    }

    private void ToggleNumber(int num)
    {
        if (_selectedNumbers.Contains(num))
        {
            _selectedNumbers.Remove(num);
        }
        else if (_selectedNumbers.Count < _numbersToSelect)
        {
            _selectedNumbers.Add(num);
            _selectedNumbers.Sort();
        }
    }

    private void QuickPick()
    {
        var rng = new Random();
        var numbers = new List<int>();
        while (numbers.Count < _numbersToSelect)
        {
            var n = rng.Next(1, _maxNumber + 1);
            if (!numbers.Contains(n))
                numbers.Add(n);
        }
        numbers.Sort();
        _selectedNumbers = numbers;
    }
}";

