@* ============================================================
   Block: product-card-chocolate
   Title: ProductCardChocolate
   Description: Artisan chocolate product card with origin details and cacao percentage for gourmet stores
   Source: original/blocks/product-cards/product-card-chocolate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[180px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Single Origin</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="absolute top-3 right-3">
                72% Cacao
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Maison du Chocolat</p>
            <h3 class="text-sm font-medium">Madagascar Grand Cru Collection</h3>
            <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                <span>Sambirano Valley, Madagascar</span>
            </div>
            <p class="mt-2 text-2xl font-semibold tabular-nums">$42</p>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">CACAO INTENSITY</p>
            <div class="flex items-center gap-2">
                <div class="flex-1">
                    <div class="flex h-2 rounded-full bg-muted">
                        <div class="w-[72%] rounded-full bg-amber-900"></div>
                    </div>
                    <div class="mt-1 flex justify-between text-xs text-muted-foreground">
                        <span>Mild</span>
                        <span>72%</span>
                        <span>Intense</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">FLAVOR PROFILE</p>
            <div class="space-y-1.5">
                @foreach (var f in _flavorProfile)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-12 text-xs text-muted-foreground">@f.Label</span>
                        <div class="flex-1">
                            <div class="h-1.5 rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground/60" style="@($"width:{f.Value}%")"></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">IN THIS BOX</p>
            <div class="space-y-1">
                @foreach (var item in _collection)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="font-medium">@item.Name</span>
                        <div class="flex items-center gap-2 text-muted-foreground">
                            <span>@item.Weight</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                @item.Type
                            </BadgeCn>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap gap-1">
                @foreach (var tag in _tags)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                        <LucideIconCn Name="leaf" Size="10" Class="mr-1 size-2.5" />
                        @tag
                    </BadgeCn>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FlavorItem(string Label, int Value);
    private record CollectionItem(string Name, string Weight, string Type);

    private static readonly FlavorItem[] _flavorProfile =
    [
        new("Fruity", 70),
        new("Floral", 40),
        new("Nutty", 55),
        new("Earthy", 30),
        new("Roasted", 60),
    ];

    private static readonly CollectionItem[] _collection =
    [
        new("Madagascar 72%", "70g", "Dark"),
        new("Ecuador 65%", "70g", "Dark"),
        new("Peru 55%", "70g", "Dark Milk"),
        new("Tanzania 80%", "70g", "Extra Dark"),
    ];

    private static readonly string[] _tags = ["Vegan", "Organic", "Fair Trade", "Gluten-Free"];
}
