@* ============================================================
   Block: product-card-ebook
   Title: ProductCardEbook
   Description: Digital ebook product card with preview chapters and format options for bookstores
   Source: original/blocks/product-cards/product-card-ebook.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex border-b">
            <div class="flex w-[120px] shrink-0 items-center justify-center bg-muted/50">
                <LucideIconCn Name="image" Size="40" Class="size-10 text-muted-foreground/40" />
            </div>
            <div class="flex-1 px-4 py-3">
                <p class="text-xs font-medium text-muted-foreground">Elena Vasquez</p>
                <h3 class="text-sm font-medium">The Architecture of Light</h3>
                <div class="mt-1 flex items-center gap-1">
                    <LucideIconCn Name="star" Size="12" Class="size-3 fill-primary text-primary" />
                    <span class="text-xs font-medium">4.8</span>
                    <span class="text-xs text-muted-foreground">(2,341 ratings)</span>
                </div>
                <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="book-open" Size="12" Class="size-3" />
                        <span>342 pages</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="clock" Size="12" Class="size-3" />
                        <span>~6h read</span>
                    </div>
                </div>
                <p class="mt-2 text-lg font-semibold tabular-nums">$14.99</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">FORMAT</p>
            <div class="flex gap-2">
                @foreach (var f in _formats)
                {
                    var fmt = f;
                    <button
                        type="button"
                        class="@Cn.Merge("flex-1 rounded-md border p-2 text-center transition-colors", _selectedFormat == fmt.Id ? "border-foreground bg-foreground/5" : "hover:bg-muted/50")"
                        @onclick="@(() => _selectedFormat = fmt.Id)">
                        <p class="text-xs font-medium">@fmt.Label</p>
                        <p class="text-xs text-muted-foreground">@fmt.Size</p>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">PREVIEW CHAPTERS</p>
            <div class="space-y-1">
                @foreach (var ch in _chapters)
                {
                    var chapter = ch;
                    <div class="flex items-center justify-between text-xs">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="file-text" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="font-medium">Ch. @chapter.Number: @chapter.Title</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-muted-foreground">pp. @chapter.Pages</span>
                            @if (chapter.Free)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">Free</BadgeCn>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs italic text-muted-foreground">
                &ldquo;A luminous debut that redefines the boundaries of literary fiction. Vasquez
                writes with precision and heart.&rdquo;
            </p>
            <p class="mt-1 text-xs font-medium text-muted-foreground">
                &mdash; The Literary Review
            </p>
        </div>

        <div class="flex gap-2 px-4 py-3">
            <ButtonCn Class="flex-1">
                <LucideIconCn Name="download" Size="16" Class="mr-2 size-4" />
                Buy &amp; Download
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Class="shrink-0">
                Preview
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record EbookFormat(string Id, string Label, string Size);
    private record Chapter(int Number, string Title, string Pages, bool Free);

    private static readonly EbookFormat[] _formats =
    [
        new("epub", "EPUB", "2.4 MB"),
        new("pdf", "PDF", "8.1 MB"),
        new("mobi", "MOBI", "3.2 MB"),
    ];

    private static readonly Chapter[] _chapters =
    [
        new(1, "The Awakening", "1-24", true),
        new(2, "Into the Unknown", "25-52", true),
        new(3, "Crossing Borders", "53-78", false),
        new(4, "The Revelation", "79-112", false),
    ];

    private string _selectedFormat = "epub";
}
