@* ============================================================
   Block: product-card-gift-card
   Title: ProductCardGiftCard
   Description: Gift card product card with denomination selector and delivery options for React stores
   Source: original/blocks/product-cards/product-card-gift-card.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[340px] max-w-full">
        <CardCn Class="overflow-hidden">
            @* Gift card preview *@
            <div class="relative flex h-[160px] items-center justify-center bg-gradient-to-br from-primary/10 via-primary/5 to-transparent">
                <div class="rounded-xl border bg-background p-6 shadow-lg">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="gift" Size="24" Class="h-6 w-6 text-primary" />
                        <span class="text-lg font-semibold">Gift Card</span>
                    </div>
                    <p class="mt-2 text-2xl font-bold tabular-nums">$@_finalAmount.ToString("F2")</p>
                </div>
                <LucideIconCn Name="sparkles" Size="20" Class="absolute top-4 right-4 h-5 w-5 text-primary/40" />
                <LucideIconCn Name="sparkles" Size="16" Class="absolute bottom-4 left-4 h-4 w-4 text-primary/30" />
            </div>

            <CardContentCn Class="p-4">
                @* Amount selector *@
                <div>
                    <LabelCn Class="text-xs font-medium text-muted-foreground">SELECT AMOUNT</LabelCn>
                    <div class="mt-2 grid grid-cols-3 gap-2">
                        @foreach (var amt in _denominations)
                        {
                            var amount = amt;
                            <ButtonCn Class="tabular-nums"
                                      Size="ButtonSize.Sm"
                                      Variant="@(_selectedAmount == amount ? ButtonVariant.Default : ButtonVariant.Outline)"
                                      @onclick="@(() => SelectAmount(amount))">
                                $@amount
                            </ButtonCn>
                        }
                    </div>

                    <div class="mt-3">
                        <ButtonCn Class="w-full"
                                  Size="ButtonSize.Sm"
                                  Variant="@(_isCustom ? ButtonVariant.Default : ButtonVariant.Outline)"
                                  @onclick="SelectCustom">
                            Custom Amount
                        </ButtonCn>
                        @if (_isCustom)
                        {
                            <div class="mt-2 relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">
                                    $
                                </span>
                                <InputCn Class="pl-7 tabular-nums"
                                         type="number"
                                         min="10"
                                         max="500"
                                         Placeholder="Enter amount"
                                         @bind-Value="_customAmount" />
                                <p class="mt-1 text-xs text-muted-foreground">Min $10 • Max $500</p>
                            </div>
                        }
                    </div>
                </div>

                @* Delivery method *@
                <div class="mt-4">
                    <LabelCn Class="text-xs font-medium text-muted-foreground">DELIVERY METHOD</LabelCn>
                    <ToggleGroupCn Class="mt-2 grid grid-cols-2 gap-2"
                                   Value="@_deliveryMethod"
                                   ValueChanged="@((string? v) => SetDelivery(v))">
                        <ToggleGroupItemCn Class="flex-col h-auto py-3 gap-1" Value="email">
                            <LucideIconCn Name="mail" Size="16" Class="h-4 w-4" />
                            <span class="text-xs">Email</span>
                            <span class="text-xs text-muted-foreground">Instant</span>
                        </ToggleGroupItemCn>
                        <ToggleGroupItemCn Class="flex-col h-auto py-3 gap-1" Value="physical">
                            <LucideIconCn Name="package" Size="16" Class="h-4 w-4" />
                            <span class="text-xs">Physical</span>
                            <span class="text-xs text-muted-foreground">3-5 days</span>
                        </ToggleGroupItemCn>
                    </ToggleGroupCn>
                </div>

                <ButtonCn Class="mt-4 w-full" Disabled="@(_finalAmount < 10)">
                    <LucideIconCn Name="gift" Size="16" Class="mr-2 h-4 w-4" />
                    Purchase Gift Card
                </ButtonCn>

                <p class="mt-2 text-center text-xs text-muted-foreground">
                    Never expires • No fees
                </p>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private static readonly int[] _denominations = [25, 50, 75, 100, 150, 200];

    private int _selectedAmount = 50;
    private bool _isCustom = false;
    private string _customAmount = "";
    private string _deliveryMethod = "email";

    private double _finalAmount =>
        _isCustom ? (double.TryParse(_customAmount, out var v) ? v : 0) : _selectedAmount;

    private void SelectAmount(int amount)
    {
        _selectedAmount = amount;
        _isCustom = false;
    }

    private void SelectCustom()
    {
        _isCustom = true;
    }

    private void SetDelivery(string? v)
    {
        if (v is not null)
            _deliveryMethod = v;
    }
}
