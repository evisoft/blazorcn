@* ============================================================
   Block: product-card-supplement
   Title: ProductCardSupplement
   Description: Health supplement product card with nutrition facts, serving info, and dosage for React wellness stores
   Source: original/blocks/product-cards/product-card-supplement.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Image *@
        <div class="relative flex h-[200px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="pill" Size="64" Class="size-16 text-muted-foreground/30" />
            <BadgeCn Class="absolute top-3 left-3">@_product.CapsuleType</BadgeCn>
        </div>

        @* Title and price *@
        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">@_product.Brand</p>
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <div class="mt-1 flex items-baseline gap-2">
                <span class="text-2xl font-semibold tabular-nums">
                    $@(_isSubscribe ? _subscribePrice : _product.Price.ToString("F2"))
                </span>
                @if (_isSubscribe)
                {
                    <span class="text-xs text-muted-foreground line-through tabular-nums">
                        $@_product.Price.ToString("F2")
                    </span>
                }
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_product.ServingsPerContainer servings — @_product.ServingSize
            </p>
        </div>

        @* Benefits *@
        <div class="border-t px-4 py-3">
            <div class="flex flex-wrap gap-1.5">
                @foreach (var benefit in _product.Benefits)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@benefit</BadgeCn>
                }
            </div>
        </div>

        @* Nutrition facts *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">NUTRITION FACTS</p>
            <div class="rounded-md border">
                <div class="border-b bg-muted/50 px-3 py-1.5">
                    <p class="text-xs font-medium">Serving size: @_product.ServingSize</p>
                </div>
                @foreach (var (fact, index) in _product.NutritionFacts.Select((f, i) => (f, i)))
                {
                    <div class="@Cn.Merge("flex items-center justify-between px-3 py-1.5", index < _product.NutritionFacts.Length - 1 ? "border-b" : "")">
                        <span class="text-xs">@fact.Nutrient</span>
                        <div class="flex items-center gap-3">
                            <span class="text-xs font-medium tabular-nums">@fact.Amount</span>
                            <span class="w-10 text-right text-xs text-muted-foreground tabular-nums">
                                @fact.DailyValue
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Dosage *@
        <div class="border-t px-4 py-3">
            <div class="flex items-start gap-2">
                <LucideIconCn Name="info" Size="12" Class="mt-0.5 size-3 shrink-0 text-muted-foreground" />
                <p class="text-xs text-muted-foreground">@_product.Dosage</p>
            </div>
        </div>

        @* Purchase options *@
        <div class="border-t px-4 py-3">
            <div class="flex gap-2">
                <button type="button"
                        @onclick="@(() => _isSubscribe = false)"
                        class="@Cn.Merge("flex-1 rounded-md border px-3 py-2 text-xs font-medium transition-colors", !_isSubscribe ? "border-foreground bg-foreground text-background" : "hover:bg-muted/50")">
                    One-time
                </button>
                <button type="button"
                        @onclick="@(() => _isSubscribe = true)"
                        class="@Cn.Merge("flex-1 rounded-md border px-3 py-2 text-xs font-medium transition-colors", _isSubscribe ? "border-foreground bg-foreground text-background" : "hover:bg-muted/50")">
                    Subscribe — 15% off
                </button>
            </div>
        </div>

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record NutritionFact(string Nutrient, string Amount, string DailyValue);

    private record SupplementProduct(
        string Name,
        string Brand,
        double Price,
        string ServingSize,
        int ServingsPerContainer,
        string CapsuleType,
        NutritionFact[] NutritionFacts,
        string[] Benefits,
        string Dosage
    );

    private static readonly SupplementProduct _product = new(
        Name: "Omega-3 Fish Oil",
        Brand: "PureVita Labs",
        Price: 29.99,
        ServingSize: "2 softgels",
        ServingsPerContainer: 60,
        CapsuleType: "Enteric-coated softgels",
        NutritionFacts: [
            new("Total Omega-3", "1200 mg", "—"),
            new("EPA", "720 mg", "—"),
            new("DHA", "480 mg", "—"),
            new("Vitamin D3", "1000 IU", "125%"),
        ],
        Benefits: ["Heart health", "Brain function", "Joint support", "Eye health"],
        Dosage: "Take 2 softgels daily with a meal"
    );

    private bool _isSubscribe = false;
    private string _subscribePrice => (_product.Price * 0.85).ToString("F2");
}
