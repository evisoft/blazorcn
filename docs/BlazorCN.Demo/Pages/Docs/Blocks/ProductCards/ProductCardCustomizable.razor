@* ============================================================
   Block: product-card-customizable
   Title: ProductCardCustomizable
   Description: Build-your-own customizable product card with options, live preview, and dynamic pricing for React stores
   Source: original/blocks/product-cards/product-card-customizable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Preview *@
        <div class="relative flex h-[180px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="palette" Size="64" Class="size-16 text-muted-foreground/30" />
        </div>

        @* Title *@
        <div class="border-t px-4 py-3">
            <h3 class="text-sm font-medium">Custom Crewneck Sweatshirt</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Build your own — starting at $@_basePrice
            </p>
        </div>

        @* Option selectors *@
        @foreach (var opt in _options)
        {
            var option = opt;
            var optionIndex = Array.IndexOf(_options, option);
            var selectedChoiceIndex = _selections[optionIndex];
            var selectedPriceAdd = option.Choices[selectedChoiceIndex].PriceAdd;
            <div class="border-t px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">
                    @option.Label.ToUpper()
                    @if (selectedPriceAdd > 0)
                    {
                        <span class="ml-1 text-foreground">(+$@selectedPriceAdd)</span>
                    }
                </p>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var ch in option.Choices)
                    {
                        var choice = ch;
                        var choiceIndex = Array.IndexOf(option.Choices, choice);
                        var isSelected = _selections[optionIndex] == choiceIndex;
                        var capturedOptionIndex = optionIndex;
                        var capturedChoiceIndex = choiceIndex;
                        <button
                            type="button"
                            class="@Cn.Merge("rounded-md border px-3 py-1.5 text-xs font-medium transition-colors", isSelected ? "border-foreground bg-foreground text-background" : "hover:bg-muted/50")"
                            @onclick="@(() => HandleSelect(capturedOptionIndex, capturedChoiceIndex))">
                            @choice.Name
                            @if (choice.PriceAdd > 0)
                            {
                                <span class="ml-1 opacity-60">+$@choice.PriceAdd</span>
                            }
                        </button>
                    }
                </div>
            </div>
        }

        @* Configuration summary *@
        <div class="border-t px-4 py-3">
            <p class="mb-1.5 text-xs font-medium text-muted-foreground">YOUR CONFIGURATION</p>
            <div class="flex flex-wrap gap-x-3 gap-y-0.5">
                @foreach (var opt in _options)
                {
                    var option = opt;
                    var idx = Array.IndexOf(_options, option);
                    <span class="text-xs text-muted-foreground">
                        @option.Label: <span class="text-foreground">@option.Choices[_selections[idx]].Name</span>
                    </span>
                }
            </div>
        </div>

        @* Price and action *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-muted-foreground">Total</p>
                    <p class="text-2xl font-semibold tabular-nums">$@_totalPrice</p>
                </div>
                <ButtonCn Size="ButtonSize.Sm">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                    Add to Cart
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Choice(string Name, int PriceAdd);
    private record CustomOption(string Label, Choice[] Choices);

    private const int _basePrice = 65;

    private static readonly CustomOption[] _options =
    [
        new("Material", [
            new("Cotton", 0),
            new("Organic Cotton", 12),
            new("Linen Blend", 18),
        ]),
        new("Color", [
            new("Natural", 0),
            new("Midnight", 0),
            new("Sage", 0),
            new("Rust", 0),
        ]),
        new("Size", [
            new("S", 0),
            new("M", 0),
            new("L", 0),
            new("XL", 5),
            new("XXL", 10),
        ]),
        new("Add-ons", [
            new("None", 0),
            new("Monogram", 15),
            new("Custom patch", 20),
        ]),
    ];

    private int[] _selections = _options.Select(_ => 0).ToArray();

    private int _totalPrice =>
        _selections.Select((choiceIdx, optIdx) => _options[optIdx].Choices[choiceIdx].PriceAdd)
                   .Sum() + _basePrice;

    private void HandleSelect(int optionIndex, int choiceIndex)
    {
        _selections[optionIndex] = choiceIndex;
    }
}
