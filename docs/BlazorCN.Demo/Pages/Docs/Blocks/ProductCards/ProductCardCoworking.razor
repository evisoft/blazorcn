@* ============================================================
   Block: product-card-coworking
   Title: ProductCardCoworking
   Description: Coworking space card with desk type, amenities, and hourly/daily booking for React workspace apps
   Source: original/blocks/product-cards/product-card-coworking.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[340px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[160px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                @if (_product.AvailableToday)
                {
                    <BadgeCn Class="absolute top-3 left-3">
                        <LucideIconCn Name="zap" Size="12" Class="mr-1 h-3 w-3" />
                        Available Today
                    </BadgeCn>
                }
                <div class="absolute top-3 right-3 flex items-center gap-1 rounded-full bg-background/90 px-2 py-1 text-xs font-medium backdrop-blur-sm">
                    <span class="text-primary">★</span>
                    <span>@_product.Rating</span>
                    <span class="text-muted-foreground">(@(_product.ReviewCount))</span>
                </div>
            </div>

            <CardContentCn Class="p-4">
                @* Header *@
                <h2 class="font-semibold">@_product.Name</h2>
                <div class="mt-1 flex items-center gap-1 text-sm text-muted-foreground">
                    <LucideIconCn Name="map-pin" Size="12" Class="h-3 w-3" />
                    <span>@_product.Location</span>
                </div>
                <div class="mt-1 flex items-center gap-1 text-sm text-muted-foreground">
                    <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                    <span>@_product.OpenHours</span>
                </div>

                @* Amenities *@
                <div class="mt-3 flex flex-wrap gap-3">
                    @foreach (var amenity in _product.Amenities)
                    {
                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                            <LucideIconCn Name="@amenity.Icon" Size="12" Class="h-3 w-3" />
                            <span>@amenity.Name</span>
                        </div>
                    }
                </div>

                @* Desk type selector *@
                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">WORKSPACE TYPE</p>
                    <div class="space-y-2">
                        @foreach (var deskType in _product.DeskTypes)
                        {
                            var dt = deskType;
                            <button
                                type="button"
                                class="@Cn.Merge("flex w-full items-center justify-between rounded-lg border p-3 text-left transition-colors hover:bg-muted/50", _selectedDesk == dt.Id ? "border-primary bg-muted/50" : "")"
                                @onclick="@(() => _selectedDesk = dt.Id)">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <p class="font-medium">@dt.Name</p>
                                        @if (dt.Capacity > 1)
                                        {
                                            <span class="flex items-center gap-0.5 text-xs text-muted-foreground">
                                                <LucideIconCn Name="users" Size="12" Class="h-3 w-3" />
                                                @dt.Capacity
                                            </span>
                                        }
                                    </div>
                                    <p class="text-xs text-muted-foreground">@dt.Description</p>
                                </div>
                                <div class="text-right">
                                    <p class="font-semibold tabular-nums">$@dt.DailyRate</p>
                                    <p class="text-xs text-muted-foreground">/day</p>
                                </div>
                            </button>
                        }
                    </div>
                </div>

                @* Booking type toggle *@
                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">BOOKING TYPE</p>
                    <div class="grid grid-cols-2 gap-1 rounded-lg border p-1">
                        <button
                            type="button"
                            class="@Cn.Merge("rounded-md px-3 py-1.5 text-sm font-medium transition-colors", _bookingType == "hourly" ? "bg-background shadow-sm" : "text-muted-foreground hover:bg-muted/50")"
                            @onclick="@(() => _bookingType = "hourly")">
                            $@_currentDesk.HourlyRate/hour
                        </button>
                        <button
                            type="button"
                            class="@Cn.Merge("rounded-md px-3 py-1.5 text-sm font-medium transition-colors", _bookingType == "daily" ? "bg-background shadow-sm" : "text-muted-foreground hover:bg-muted/50")"
                            @onclick="@(() => _bookingType = "daily")">
                            $@_currentDesk.DailyRate/day
                        </button>
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex items-center justify-between p-4 pt-0">
                <div>
                    <p class="text-xs text-muted-foreground">Starting from</p>
                    <p class="text-xl font-bold tabular-nums">
                        $@_currentRate<span class="text-sm font-normal text-muted-foreground">/@(_bookingType == "hourly" ? "hr" : "day")</span>
                    </p>
                </div>
                <ButtonCn>
                    <LucideIconCn Name="calendar" Size="16" Class="mr-2 h-4 w-4" />
                    Book Now
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record DeskType(
        string Id,
        string Name,
        string Description,
        int HourlyRate,
        int DailyRate,
        int Capacity
    );

    private record Amenity(string Icon, string Name);

    private record Product(
        string Name,
        string Location,
        string Image,
        double Rating,
        int ReviewCount,
        string OpenHours,
        DeskType[] DeskTypes,
        Amenity[] Amenities,
        bool AvailableToday
    );

    private static readonly Product _product = new(
        Name: "The Hive Downtown",
        Location: "123 Innovation Blvd, Floor 12",
        Image: "https://images.unsplash.com/photo-1497366216548-37526070297c?w=400&q=80",
        Rating: 4.8,
        ReviewCount: 124,
        OpenHours: "7 AM - 10 PM",
        DeskTypes:
        [
            new("hot", "Hot Desk", "Any available desk", 8, 35, 1),
            new("dedicated", "Dedicated", "Your own desk", 12, 55, 1),
            new("private", "Private Office", "4-person room", 35, 150, 4),
        ],
        Amenities:
        [
            new("wifi", "High-speed WiFi"),
            new("coffee", "Free coffee"),
            new("printer", "Printing"),
            new("monitor", "Monitors"),
        ],
        AvailableToday: true
    );

    private string _selectedDesk = _product.DeskTypes[0].Id;
    private string _bookingType = "daily";

    private DeskType _currentDesk => _product.DeskTypes.FirstOrDefault(d => d.Id == _selectedDesk) ?? _product.DeskTypes[0];
    private int _currentRate => _bookingType == "hourly" ? _currentDesk.HourlyRate : _currentDesk.DailyRate;
}
