@* ============================================================
   Block: product-card-wellness
   Title: ProductCardWellness
   Description: Essential oil product card with aromatherapy benefits for React wellness stores
   Source: original/blocks/product-cards/product-card-wellness.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[200px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                @if (_product.IsOrganic)
                {
                    <BadgeCn Class="absolute top-3 left-3">100% Organic</BadgeCn>
                }
            </div>

            <CardContentCn Class="p-4">
                <h2 class="font-semibold">@_product.Name</h2>
                <p class="mt-1 text-xs text-muted-foreground">
                    @_product.Volume · @_product.AromaType
                </p>

                <p class="mt-2 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                <div class="mt-4">
                    <p class="mb-1.5 text-xs font-medium text-muted-foreground">KEY BENEFITS</p>
                    <div class="grid grid-cols-2 gap-1">
                        @foreach (var benefit in _product.Benefits)
                        {
                            <div class="flex items-center gap-1.5 text-xs">
                                <LucideIconCn Name="check" Size="12" Class="h-3 w-3 text-primary" />
                                <span>@benefit</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-3">
                    <p class="mb-1.5 text-xs font-medium text-muted-foreground">INGREDIENTS</p>
                    <div class="flex flex-wrap gap-1">
                        @foreach (var ingredient in _product.Ingredients)
                        {
                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">@ingredient</BadgeCn>
                        }
                    </div>
                </div>

                <div class="mt-4 flex items-baseline gap-2">
                    <span class="text-xl font-bold tabular-nums">
                        $@_product.SalePrice.ToString("F2")
                    </span>
                    <span class="text-sm text-muted-foreground line-through tabular-nums">
                        $@_product.OriginalPrice.ToString("F2")
                    </span>
                    <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                        <LucideIconCn Name="tag" Size="12" Class="mr-1 h-3 w-3" />
                        Save @_savingsPercent%
                    </BadgeCn>
                </div>

                <div class="mt-2 flex items-center gap-1 text-xs text-muted-foreground">
                    <LucideIconCn Name="clock" Size="12" Class="h-3 w-3" />
                    <span>Ships within 24 hours</span>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 h-4 w-4" />
                    Add to Cart
                </ButtonCn>
                <ButtonCn Class="w-full">Buy Now</ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record Product(
        string Name,
        string Description,
        double OriginalPrice,
        double SalePrice,
        string Image,
        string Volume,
        string AromaType,
        bool IsOrganic,
        string[] Benefits,
        string[] Ingredients
    );

    private static readonly Product _product = new(
        Name: "Lavender Serenity Oil",
        Description: "100% pure essential oil from organic lavender flowers. Promotes relaxation and better sleep.",
        OriginalPrice: 24.99,
        SalePrice: 18.99,
        Image: "https://images.unsplash.com/photo-1608571423902-eed4a5ad8108?w=400&q=80",
        Volume: "15ml",
        AromaType: "Floral, Herbaceous",
        IsOrganic: true,
        Benefits: ["Promotes relaxation", "Reduces stress", "Improves sleep", "Soothes skin"],
        Ingredients: ["Pure Lavender Oil", "Lavandula angustifolia"]
    );

    private int _savingsPercent =>
        (int)Math.Round((_product.OriginalPrice - _product.SalePrice) / _product.OriginalPrice * 100);
}
