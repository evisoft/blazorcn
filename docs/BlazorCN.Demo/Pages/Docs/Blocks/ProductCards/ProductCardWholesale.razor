@* ============================================================
   Block: product-card-wholesale
   Title: ProductCardWholesale
   Description: Wholesale product card with tier pricing, minimum order quantity, and bulk discounts for React B2B stores
   Source: original/blocks/product-cards/product-card-wholesale.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Image *@
        <div class="relative flex h-[180px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="package" Size="64" Class="size-16 text-muted-foreground/30" />
            <BadgeCn Class="absolute top-3 left-3">Wholesale</BadgeCn>
        </div>

        @* Product info *@
        <div class="border-t px-4 py-3">
            <p class="font-mono text-xs text-muted-foreground">@_product.Sku</p>
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">
                MOQ: @_product.Moq units · @_product.InStock.ToString("N0") in stock
            </p>
        </div>

        @* Tier pricing table *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">TIER PRICING</p>
            <div class="rounded-md border">
                <div class="grid grid-cols-3 border-b bg-muted/50 px-3 py-1.5">
                    <span class="text-xs font-medium text-muted-foreground">Quantity</span>
                    <span class="text-xs font-medium text-muted-foreground">Unit price</span>
                    <span class="text-right text-xs font-medium text-muted-foreground">Discount</span>
                </div>
                @foreach (var tier in _product.PriceTiers)
                {
                    var discount = (int)Math.Round((_product.RetailPrice - tier.UnitPrice) / _product.RetailPrice * 100);
                    var isActive = _quantity >= tier.MinQty && (tier.MaxQty == null || _quantity <= tier.MaxQty);
                    var rowClass = Cn.Merge("grid grid-cols-3 px-3 py-1.5", isActive ? "bg-muted/30" : "", tier.MaxQty != null ? "border-b" : "");
                    <div class="@rowClass">
                        <span class="text-xs tabular-nums">
                            @tier.MinQty–@(tier.MaxQty.HasValue ? tier.MaxQty.Value.ToString() : "∞")
                        </span>
                        <span class="@Cn.Merge("text-xs tabular-nums", isActive ? "font-medium" : "")">
                            $@tier.UnitPrice.ToString("F2")
                        </span>
                        <span class="text-right text-xs text-muted-foreground tabular-nums">
                            @discount% off
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Quantity selector *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">QUANTITY</p>
            <div class="flex items-center gap-3">
                <div class="flex items-center rounded-md border">
                    <button
                        type="button"
                        @onclick="@(() => SetQuantity(Math.Max(_product.Moq, _quantity - 50)))" aria-label="Decrease quantity"
                        class="flex size-8 items-center justify-center transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="minus" Size="12" Class="size-3" />
                    </button>
                    <span class="w-16 text-center text-sm font-medium tabular-nums">@_quantity</span>
                    <button
                        type="button"
                        @onclick="@(() => SetQuantity(Math.Min(_product.InStock, _quantity + 50)))" aria-label="Increase quantity"
                        class="flex size-8 items-center justify-center transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    </button>
                </div>
                <div class="flex-1 text-right">
                    <p class="text-xs text-muted-foreground">
                        $@GetCurrentTier().UnitPrice.ToString("F2")/unit
                    </p>
                </div>
            </div>
        </div>

        @* Order summary *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-muted-foreground">Order total</p>
                    <p class="text-2xl font-semibold tabular-nums">
                        $@TotalPrice().ToString("N2")
                    </p>
                </div>
                <div class="text-right">
                    <p class="text-xs text-muted-foreground">vs retail</p>
                    <p class="text-xs font-medium text-emerald-600">Save @SavingsPercent()%</p>
                </div>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">Lead time: @_product.LeadTime</p>
        </div>

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Order
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record PriceTier(int MinQty, int? MaxQty, double UnitPrice);

    private record WholesaleProduct(
        string Name,
        string Sku,
        double RetailPrice,
        int Moq,
        PriceTier[] PriceTiers,
        int InStock,
        string LeadTime
    );

    private static readonly WholesaleProduct _product = new(
        Name: "Organic Cotton T-Shirt (Blank)",
        Sku: "OCT-BLK-001",
        RetailPrice: 28,
        Moq: 50,
        PriceTiers:
        [
            new(50, 99, 12.5),
            new(100, 499, 9.8),
            new(500, 999, 7.5),
            new(1000, null, 5.9),
        ],
        InStock: 2400,
        LeadTime: "3–5 business days"
    );

    private int _quantity = _product.Moq;

    private PriceTier GetCurrentTier()
    {
        for (var i = _product.PriceTiers.Length - 1; i >= 0; i--)
        {
            if (_quantity >= _product.PriceTiers[i].MinQty)
                return _product.PriceTiers[i];
        }
        return _product.PriceTiers[0];
    }

    private double TotalPrice() => _quantity * GetCurrentTier().UnitPrice;

    private double RetailTotal() => _quantity * _product.RetailPrice;

    private double Savings() => RetailTotal() - TotalPrice();

    private int SavingsPercent() => (int)Math.Round(Savings() / RetailTotal() * 100);

    private void SetQuantity(int qty) => _quantity = qty;
}
