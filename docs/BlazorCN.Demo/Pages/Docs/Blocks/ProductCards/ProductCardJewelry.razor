@* ============================================================
   Block: product-card-jewelry
   Title: ProductCardJewelry
   Description: Jewelry product card with material, stone details, and size selector for React ecommerce
   Source: original/blocks/product-cards/product-card-jewelry.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Image *@
        <div class="relative flex h-[240px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="gem" Size="64" Class="size-16 text-muted-foreground/30" />
            <BadgeCn Class="absolute top-3 left-3">@_product.Collection</BadgeCn>
        </div>

        @* Details *@
        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">@_product.Metal</p>
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <p class="mt-1 text-2xl font-semibold tabular-nums">$@_product.Price.ToString("N0")</p>
        </div>

        @* Stone details *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">STONE DETAILS</p>
            <div class="grid grid-cols-2 gap-2">
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs text-muted-foreground">Stone</p>
                    <p class="text-sm font-medium">@_product.Stone</p>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs text-muted-foreground">Carat</p>
                    <p class="text-sm font-medium">@_product.Carat</p>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs text-muted-foreground">Clarity</p>
                    <p class="text-sm font-medium">@_product.Clarity</p>
                </div>
                <div class="rounded-md bg-muted/50 px-3 py-2">
                    <p class="text-xs text-muted-foreground">Cut</p>
                    <p class="text-sm font-medium">@_product.Cut</p>
                </div>
            </div>
        </div>

        @* Certification *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-xs font-medium">@_product.Certification</p>
            </div>
        </div>

        @* Ring size selector *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">RING SIZE</p>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var s in _product.Sizes)
                {
                    var sz = s;
                    <button
                        type="button"
                        class="@Cn.Merge("flex h-8 min-w-[2.5rem] items-center justify-center rounded-md border px-2 text-xs font-medium transition-colors", _selectedSize == sz ? "border-foreground bg-foreground text-background" : "hover:bg-muted/50")"
                        @onclick="@(() => _selectedSize = sz)">
                        @sz
                    </button>
                }
            </div>
        </div>

        @* Actions *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm" Disabled="@(_selectedSize == null)">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record JewelryProduct(
        string Name,
        string Collection,
        int Price,
        string Metal,
        string Stone,
        string Carat,
        string Clarity,
        string Cut,
        string Certification,
        double[] Sizes);

    private static readonly JewelryProduct _product = new(
        Name: "Solitaire Diamond Ring",
        Collection: "Eternal Collection",
        Price: 4250,
        Metal: "18K White Gold",
        Stone: "Natural Diamond",
        Carat: "1.02 ct",
        Clarity: "VS1",
        Cut: "Excellent",
        Certification: "GIA Certified",
        Sizes: [5, 5.5, 6, 6.5, 7, 7.5, 8]);

    private double? _selectedSize = null;
}
