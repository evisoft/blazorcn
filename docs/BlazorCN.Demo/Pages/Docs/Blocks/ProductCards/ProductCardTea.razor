@* ============================================================
   Block: product-card-tea
   Title: ProductCardTea
   Description: Tea collection product card with brewing instructions and flavor notes for tea shops
   Source: original/blocks/product-cards/product-card-tea.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[180px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">First Flush</BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">
                Darjeeling, India &middot; 2,000m
            </p>
            <h3 class="text-sm font-medium">Margaret&apos;s Hope Estate SFTGFOP1</h3>
            <p class="mt-1 text-xs text-muted-foreground">
                Second flush muscatel with honey-sweet character
            </p>
            <p class="mt-2 text-2xl font-semibold tabular-nums">$@_currentFormat.Price</p>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">FORMAT</p>
            <div class="grid grid-cols-3 gap-1.5">
                @foreach (var fmt in _formats)
                {
                    var f = fmt;
                    <button
                        type="button"
                        class="@Cn.Merge("rounded-md border p-2 text-center transition-colors", _selectedFormat == f.Id ? "border-foreground bg-foreground/5" : "hover:bg-muted/50")"
                        @onclick="@(() => _selectedFormat = f.Id)">
                        <p class="text-xs font-medium">@f.Label</p>
                        <p class="text-xs text-muted-foreground">@f.Weight</p>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">BREWING GUIDE</p>
            <div class="grid grid-cols-2 gap-2">
                <div class="flex items-center gap-2 rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="thermometer" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <div>
                        <p class="text-xs font-medium">175°F / 80°C</p>
                        <p class="text-xs text-muted-foreground">Water Temp</p>
                    </div>
                </div>
                <div class="flex items-center gap-2 rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="clock" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <div>
                        <p class="text-xs font-medium">2-3 minutes</p>
                        <p class="text-xs text-muted-foreground">Steep Time</p>
                    </div>
                </div>
                <div class="flex items-center gap-2 rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="droplets" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <div>
                        <p class="text-xs font-medium">3-4 infusions</p>
                        <p class="text-xs text-muted-foreground">Re-steeps</p>
                    </div>
                </div>
                <div class="flex items-center gap-2 rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="leaf" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <div>
                        <p class="text-xs font-medium">1 tsp per 8 oz</p>
                        <p class="text-xs text-muted-foreground">Leaf Ratio</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">TASTING NOTES</p>
            <div class="flex flex-wrap gap-1">
                @foreach (var note in _flavorNotes)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@note</BadgeCn>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-1 text-xs font-medium text-muted-foreground">CAFFEINE LEVEL</p>
            <div class="flex items-center gap-2">
                <div class="flex-1">
                    <div class="flex h-1.5 rounded-full bg-muted">
                        <div class="w-[45%] rounded-full bg-foreground/60"></div>
                    </div>
                </div>
                <span class="text-xs text-muted-foreground">Moderate</span>
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart &mdash; $@_currentFormat.Price
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FormatOption(string Id, string Label, string Weight, int Price);

    private static readonly FormatOption[] _formats =
    [
        new("loose", "Loose Leaf", "100g", 28),
        new("bags", "Tea Bags", "20 bags", 22),
        new("tin", "Gift Tin", "150g", 42),
    ];

    private static readonly string[] _flavorNotes = ["Floral", "Honey", "Apricot", "Muscatel"];

    private string _selectedFormat = "loose";

    private FormatOption _currentFormat => Array.Find(_formats, f => f.Id == _selectedFormat) ?? _formats[0];
}
