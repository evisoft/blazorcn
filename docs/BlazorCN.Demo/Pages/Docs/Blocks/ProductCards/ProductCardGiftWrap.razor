@* ============================================================
   Block: product-card-gift-wrap
   Title: ProductCardGiftWrap
   Description: Product card with gift wrap option, message input, and wrapping style selector for React ecommerce
   Source: original/blocks/product-cards/product-card-gift-wrap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Image *@
        <div class="relative flex h-[200px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="gift" Size="64" Class="size-16 text-muted-foreground/30" />
        </div>

        @* Product info *@
        <div class="border-t px-4 py-3">
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <p class="mt-1 text-2xl font-semibold tabular-nums">$@_product.Price</p>
        </div>

        @* Gift wrap toggle *@
        <div class="border-t px-4 py-3">
            <div class="flex cursor-pointer items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="gift" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-sm font-medium">Add gift wrapping</span>
                </div>
                <div role="switch"
                     tabindex="0"
                     aria-label="Add gift wrapping" aria-checked="@_addGiftWrap.ToString().ToLower()"
                     class="@Cn.Merge("relative h-5 w-9 cursor-pointer rounded-full transition-colors", _addGiftWrap ? "bg-foreground" : "bg-muted")"
                     @onclick="@(() => _addGiftWrap = !_addGiftWrap)">
                    <div class="@Cn.Merge("absolute top-0.5 size-4 rounded-full bg-background transition-transform", _addGiftWrap ? "translate-x-4" : "translate-x-0.5")" />
                </div>
            </div>
        </div>

        @if (_addGiftWrap)
        {
            @* Wrap style selection *@
            <div class="border-t px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">WRAPPING STYLE</p>
                <div class="space-y-1.5">
                    @foreach (var opt in _product.WrapOptions)
                    {
                        var idx = Array.IndexOf(_product.WrapOptions, opt);
                        <div class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-md border px-3 py-2 transition-colors", _selectedWrap == idx ? "border-foreground bg-muted/30" : "hover:bg-muted/50")">
                            <div class="flex items-center gap-2">
                                <div role="radio"
                                     tabindex="0"
                                     aria-checked="@(_selectedWrap == idx).ToString().ToLower()"
                                     class="@Cn.Merge("flex size-4 items-center justify-center rounded-full border", _selectedWrap == idx ? "border-foreground" : "border-muted-foreground/30")"
                                     @onclick="@(() => _selectedWrap = idx)">
                                    @if (_selectedWrap == idx)
                                    {
                                        <div class="size-2 rounded-full bg-foreground" />
                                    }
                                </div>
                                <span class="text-xs font-medium">@opt.Name</span>
                            </div>
                            <span class="text-xs text-muted-foreground tabular-nums">
                                @(opt.Price == 0 ? "Free" : $"+${opt.Price}")
                            </span>
                        </div>
                    }
                </div>
            </div>

            @* Gift message *@
            <div class="border-t px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="message-square" Size="12" Class="size-3 text-muted-foreground" />
                        <p class="text-xs font-medium text-muted-foreground">GIFT MESSAGE</p>
                    </div>
                    <span class="text-xs text-muted-foreground tabular-nums">
                        @_giftMessage.Length/@_product.MaxMessageLength
                    </span>
                </div>
                <textarea class="mt-2 w-full resize-none rounded-md border bg-transparent px-3 py-2 text-xs placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                          placeholder="Write your gift message..."
                          rows="3"
                          maxlength="@_product.MaxMessageLength"
                          value="@_giftMessage"
                          @oninput="@((ChangeEventArgs e) => _giftMessage = e.Value?.ToString() ?? "")"></textarea>
            </div>

            @* Gift receipt *@
            <div class="border-t px-4 py-3">
                <div class="flex cursor-pointer items-center justify-between">
                    <span class="text-xs font-medium">Include gift receipt (no price shown)</span>
                    <div role="switch"
                         tabindex="0"
                         aria-label="Include gift receipt" aria-checked="@_includeReceipt.ToString().ToLower()"
                         class="@Cn.Merge("relative h-5 w-9 cursor-pointer rounded-full transition-colors", _includeReceipt ? "bg-foreground" : "bg-muted")"
                         @onclick="@(() => _includeReceipt = !_includeReceipt)">
                        <div class="@Cn.Merge("absolute top-0.5 size-4 rounded-full bg-background transition-transform", _includeReceipt ? "translate-x-4" : "translate-x-0.5")" />
                    </div>
                </div>
            </div>
        }

        @* Total and action *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    @if (_addGiftWrap && _wrapPrice > 0)
                    {
                        <p class="text-xs text-muted-foreground">
                            Product $@_product.Price + wrap $@_wrapPrice
                        </p>
                    }
                    <p class="text-2xl font-semibold tabular-nums">$@_totalPrice</p>
                </div>
                <ButtonCn Size="ButtonSize.Sm">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                    Add to Cart
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record WrapOption(string Name, int Price);
    private record GiftWrapProduct(string Name, int Price, WrapOption[] WrapOptions, int MaxMessageLength);

    private static readonly GiftWrapProduct _product = new(
        "Cashmere Scarf",
        120,
        [
            new("Classic kraft", 0),
            new("Premium box", 8),
            new("Luxury ribbon box", 15),
        ],
        150
    );

    private bool _addGiftWrap = false;
    private int _selectedWrap = 0;
    private string _giftMessage = "";
    private bool _includeReceipt = false;

    private int _wrapPrice => _addGiftWrap ? _product.WrapOptions[_selectedWrap].Price : 0;
    private int _totalPrice => _product.Price + _wrapPrice;
}
