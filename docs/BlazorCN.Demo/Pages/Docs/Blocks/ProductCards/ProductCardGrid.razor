@* ============================================================
   Block: product-card-grid
   Title: ProductCardGrid
   Description: Responsive product grid layout with multiple product cards for React category pages
   Source: original/blocks/product-cards/product-card-grid.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Products</h1>
        <p class="mt-2 text-sm text-muted-foreground">@_products.Length products</p>
    </div>

    <div class="mx-auto max-w-6xl">
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
            @foreach (var product in _products)
            {
                <CardCn Class="group overflow-hidden">
                    <div class="relative">
                        <div class="relative w-full" style="padding-bottom:100%">
                            <img
                                alt="@product.Name"
                                class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                                height="400"
                                src="@product.Image"
                                width="400" />
                        </div>
                        @if (product.Badge != null)
                        {
                            <BadgeCn Class="absolute top-2 left-2" Variant="BadgeVariant.Secondary">@product.Badge</BadgeCn>
                        }
                        <ButtonCn Class="absolute right-2 bottom-2 h-8 w-8 opacity-0 transition-opacity group-hover:opacity-100"
                                  Size="ButtonSize.Icon"
                                  Variant="ButtonVariant.Secondary">
                            <LucideIconCn Name="plus" Size="16" Class="h-4 w-4" />
                        </ButtonCn>
                    </div>

                    <CardContentCn Class="p-3">
                        <h3 class="text-sm font-medium truncate">@product.Name</h3>

                        <div class="mt-1 flex items-center gap-1">
                            <LucideIconCn Name="star" Size="12" Class="h-3 w-3 fill-primary text-primary" />
                            <span class="text-xs">@product.Rating</span>
                            <span class="text-xs text-muted-foreground">(@product.ReviewCount)</span>
                        </div>

                        <p class="mt-2 font-semibold tabular-nums">$@product.Price.ToString("F2")</p>
                    </CardContentCn>
                </CardCn>
            }
        </div>
    </div>
</section>

@code {
    private record Product(int Id, string Name, double Price, string Image, double Rating, int ReviewCount, string? Badge = null);

    private static readonly Product[] _products =
    [
        new(1, "Wireless Headphones", 149.99, "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=400&q=80", 4.5, 128, "Bestseller"),
