@* ============================================================
   Block: product-card-cloud-storage
   Title: ProductCardCloudStorage
   Description: Cloud storage plan card with storage meter, usage breakdown, and upgrade prompt for React SaaS apps
   Source: original/blocks/product-cards/product-card-cloud-storage.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            <CardContentCn Class="p-4">
                @* Plan header *@
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-full border">
                            <LucideIconCn Name="cloud" Size="20" Class="h-5 w-5 text-primary" />
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="font-semibold">Cloud Storage</h2>
                                <BadgeCn Variant="BadgeVariant.Secondary">@_product.PlanName</BadgeCn>
                            </div>
                            <p class="text-sm text-muted-foreground">$@_product.Price.ToString("0.00")/month</p>
                        </div>
                    </div>
                </div>

                @* Main storage meter *@
                <div class="mt-6">
                    <div class="flex items-end justify-between">
                        <div>
                            <p class="text-3xl font-bold tabular-nums">@FormatSize(_product.UsedStorage)</p>
                            <p class="text-sm text-muted-foreground">of @FormatSize(_product.TotalStorage) used</p>
                        </div>
                        <p class="@Cn.Merge("text-2xl font-semibold tabular-nums", _isNearLimit ? "text-destructive" : "text-muted-foreground")">
                            @((int)Math.Round(_usagePercent))%
                        </p>
                    </div>
                    <ProgressCn Class="@Cn.Merge("mt-3 h-3", _isNearLimit ? "[&>div]:bg-destructive" : "")" Value="@_usagePercent" aria-label="Storage usage" />
                    <p class="mt-2 text-xs text-muted-foreground">@FormatSize(_remainingStorage) remaining</p>
                </div>

                @* Storage breakdown *@
                <div class="mt-6">
                    <p class="mb-3 text-xs font-medium text-muted-foreground">STORAGE BREAKDOWN</p>
                    <div class="space-y-3">
                        @foreach (var item in _product.Breakdown)
                        {
                            var itemPercent = (item.Size / _product.UsedStorage) * 100;
                            <div class="flex items-center gap-3" key="@item.Type">
                                <div class="flex h-8 w-8 items-center justify-center rounded-lg border">
                                    <LucideIconCn Name="@item.Icon" Size="16" Class="h-4 w-4 text-muted-foreground" />
                                </div>
                                <div class="flex-1">
                                    <div class="flex items-center justify-between text-sm">
                                        <span>@item.Type</span>
                                        <span class="tabular-nums text-muted-foreground">@FormatSize(item.Size)</span>
                                    </div>
                                    <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                        <div class="@Cn.Merge("h-full rounded-full", item.Color)" style="@(FormattableString.Invariant($"width:{itemPercent:F1}%"))"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* Upgrade prompt *@
                @if (_isNearLimit)
                {
                    <div class="mt-4 rounded-lg border border-dashed p-3">
                        <div class="flex items-start gap-2">
                            <LucideIconCn Name="sparkles" Size="16" Class="h-4 w-4 shrink-0 text-primary" />
                            <div>
                                <p class="text-sm font-medium">Running low on space?</p>
                                <p class="text-xs text-muted-foreground">
                                    Upgrade to @_product.NextTier for @FormatSize(_product.NextTierStorage) at $@_product.NextTierPrice.ToString("0.00")/mo
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideIconCn Name="hard-drive" Size="16" Class="mr-2 h-4 w-4" />
                    Upgrade Storage
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    Manage Files
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record StorageBreakdown(string Type, string Icon, double Size, string Color);

    private record Product(
        string PlanName,
        double TotalStorage,
        double UsedStorage,
        double Price,
        string NextTier,
        double NextTierStorage,
        double NextTierPrice,
        StorageBreakdown[] Breakdown);

    private static readonly Product _product = new(
        PlanName: "Pro",
        TotalStorage: 100,
        UsedStorage: 78.4,
        Price: 9.99,
        NextTier: "Business",
        NextTierStorage: 500,
        NextTierPrice: 19.99,
        Breakdown:
        [
            new("Images", "file-image", 32.1, "bg-blue-500"),
            new("Videos", "file-video", 28.7, "bg-purple-500"),
            new("Documents", "file", 12.4, "bg-green-500"),
            new("Archives", "folder-archive", 5.2, "bg-orange-500"),
        ]);

    private double _usagePercent => (_product.UsedStorage / _product.TotalStorage) * 100;
    private double _remainingStorage => _product.TotalStorage - _product.UsedStorage;
    private bool _isNearLimit => _usagePercent >= 80;

    private static string FormatSize(double gb)
    {
        if (gb >= 1000)
            return $"{(gb / 1000):F1} TB";
        return $"{gb:F1} GB";
    }
}
