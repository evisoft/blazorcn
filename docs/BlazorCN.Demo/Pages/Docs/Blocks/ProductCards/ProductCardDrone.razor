@* ============================================================
   Block: product-card-drone
   Title: ProductCardDrone
   Description: Drone product card with flight time, range specs, and camera capabilities for drone shops
   Source: original/blocks/product-cards/product-card-drone.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[200px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Pro</BadgeCn>
            <div class="absolute top-3 right-3 flex items-center gap-1 rounded-full bg-background/90 px-2 py-1">
                <LucideIconCn Name="battery" Size="12" Class="size-3 text-emerald-500" />
                <span class="text-xs font-medium">46 min</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">DJI Air Series</p>
            <h3 class="text-sm font-medium">Air 3S Fly More Combo</h3>
            <div class="mt-2 flex items-end justify-between">
                <p class="text-2xl font-semibold tabular-nums">$1,549</p>
                <p class="text-xs text-muted-foreground">249g &middot; No FAA registration</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">FLIGHT PERFORMANCE</p>
            <div class="grid grid-cols-4 gap-2">
                @foreach (var spec in _flightSpecs)
                {
                    <div class="text-center">
                        <LucideIconCn Name="@spec.Icon" Size="16" Class="mx-auto size-4 text-muted-foreground" />
                        <p class="mt-1 text-xs font-medium">@spec.Value</p>
                        <p class="text-xs text-muted-foreground">@spec.Label</p>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="camera" Size="14" Class="size-3.5 text-muted-foreground" />
                <p class="text-xs font-medium text-muted-foreground">CAMERA</p>
            </div>
            <div class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1.5">
                @foreach (var spec in _cameraSpecs)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@spec.Label</span>
                        <span class="font-medium">@spec.Value</span>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">INTELLIGENT FEATURES</p>
            <div class="flex flex-wrap gap-1">
                @foreach (var feature in _smartFeatures)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@feature</BadgeCn>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-1 text-xs font-medium text-muted-foreground">WHAT&apos;S INCLUDED</p>
            <p class="text-xs text-muted-foreground">
                Drone &middot; RC Controller &middot; 3 Batteries &middot; Charging Hub &middot; ND
                Filters &middot; Shoulder Bag
            </p>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FlightSpec(string Icon, string Label, string Value);
    private record CameraSpec(string Label, string Value);

    private static readonly FlightSpec[] _flightSpecs =
    [
        new("timer", "Flight Time", "46 min"),
        new("ruler", "Max Range", "15 km"),
        new("wind", "Wind Resist", "Level 5"),
        new("compass", "Max Speed", "72 km/h"),
    ];

    private static readonly CameraSpec[] _cameraSpecs =
    [
        new("Sensor", "1\" CMOS 20MP"),
        new("Video", "5.1K 50fps"),
        new("Slow Motion", "4K 120fps"),
        new("HDR", "10-bit D-Log M"),
    ];

    private static readonly string[] _smartFeatures =
    [
        "ActiveTrack 5.0",
        "MasterShots",
        "Hyperlapse",
        "Waypoint Flight",
        "Return to Home",
        "Obstacle Sensing",
    ];
}
