@* ============================================================
   Block: product-card-quick-view
   Title: ProductCardQuickView
   Description: Quick view product card with popup preview, size selector, and instant add to cart for React ecommerce
   Source: original/blocks/product-cards/product-card-quick-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Product image with quick view trigger *@
        <div class="relative flex h-[240px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="eye" Size="64" Class="size-16 text-muted-foreground/30" />
            <BadgeCn Class="absolute top-3 left-3">New</BadgeCn>
        </div>

        @* Compact info *@
        <div class="border-t px-4 py-3">
            <div class="flex items-start justify-between">
                <div>
                    <p class="text-xs text-muted-foreground">@_product.Brand</p>
                    <h3 class="text-sm font-medium">@_product.Name</h3>
                </div>
                <span class="text-sm font-semibold tabular-nums">$@_product.Price</span>
            </div>
            <div class="mt-1 flex items-center gap-1">
                <LucideIconCn Name="star" Size="12" Class="size-3 fill-foreground text-foreground" />
                <span class="text-xs font-medium">@_product.Rating</span>
                <span class="text-xs text-muted-foreground">(@_product.ReviewCount)</span>
            </div>
        </div>

        @* Quick view toggle *@
        <div class="border-t">
            <button
                type="button"
                @onclick="@(() => _isOpen = !_isOpen)"
                class="flex w-full items-center justify-center gap-2 px-4 py-2.5 text-xs font-medium transition-colors hover:bg-muted/50">
                <span>@(_isOpen ? "Close" : "Quick view")</span>
                <LucideIconCn Name="chevron-down" Size="14" Class="@Cn.Merge("size-3.5 transition-transform duration-200", _isOpen ? "rotate-180" : "")" />
            </button>
        </div>

        @* Expandable quick view panel *@
        @if (_isOpen)
        {
            @* Description *@
            <div class="border-t px-4 py-3">
                <p class="text-xs text-muted-foreground">@_product.Description</p>
            </div>

            @* Color selector *@
            <div class="border-t px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">
                    COLOR — @_product.Colors[_selectedColor].Name
                </p>
                <div class="flex gap-2">
                    @foreach (var colorItem in _product.Colors)
                    {
                        var idx = Array.IndexOf(_product.Colors, colorItem);
                        <button
                            type="button"
                            @onclick="@(() => _selectedColor = idx)"
                            class="@Cn.Merge("size-7 rounded-full border-2 transition-all", _selectedColor == idx ? "border-foreground scale-110" : "border-transparent")"
                            style="@($"background-color:{colorItem.Hex}")"
                            aria-label="@colorItem.Name" />
                    }
                </div>
            </div>

            @* Size selector *@
            <div class="border-t px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">SIZE</p>
                <div class="flex gap-1.5">
                    @foreach (var sz in _product.Sizes)
                    {
                        var size = sz;
                        <button
                            type="button"
                            @onclick="@(() => _selectedSize = size)"
                            class="@Cn.Merge("flex h-8 min-w-[2.5rem] items-center justify-center rounded-md border px-2 text-xs font-medium transition-colors", _selectedSize == size ? "border-foreground bg-foreground text-background" : "hover:bg-muted/50")">
                            @size
                        </button>
                    }
                </div>
            </div>

            @* Quantity and add to cart *@
            <div class="border-t px-4 py-3">
                <div class="flex items-center gap-3">
                    <div class="flex items-center rounded-md border">
                        <button
                            type="button"
                            @onclick="@(() => _quantity = Math.Max(1, _quantity - 1))"
                            class="flex size-8 items-center justify-center transition-colors hover:bg-muted/50">
                            <LucideIconCn Name="minus" Size="12" Class="size-3" />
                        </button>
                        <span class="w-8 text-center text-sm font-medium tabular-nums">@_quantity</span>
                        <button
                            type="button"
                            @onclick="@(() => _quantity = _quantity + 1)"
                            class="flex size-8 items-center justify-center transition-colors hover:bg-muted/50">
                            <LucideIconCn Name="plus" Size="12" Class="size-3" />
                        </button>
                    </div>
                    <ButtonCn Class="flex-1" Size="ButtonSize.Sm" Disabled="@(_selectedSize == null)">
                        <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                        Add to Cart
                    </ButtonCn>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record ProductColor(string Name, string Hex);

    private record QuickViewProduct(
        string Name,
        string Brand,
        int Price,
        double Rating,
        int ReviewCount,
        ProductColor[] Colors,
        string[] Sizes,
        string Description
    );

    private static readonly QuickViewProduct _product = new(
        Name: "Essential Crewneck Tee",
        Brand: "Baseline Studio",
        Price: 48,
        Rating: 4.5,
        ReviewCount: 312,
        Colors:
        [
            new("Black", "#1a1a1a"),
            new("White", "#fafafa"),
            new("Navy", "#1e3a5f"),
            new("Olive", "#4a5a3a"),
        ],
        Sizes: ["XS", "S", "M", "L", "XL"],
        Description: "Premium organic cotton crewneck with a relaxed fit. Garment-dyed for a lived-in look. Pre-shrunk for true-to-size wear."
    );

    private bool _isOpen = false;
    private int _selectedColor = 0;
    private string? _selectedSize = null;
    private int _quantity = 1;
}
