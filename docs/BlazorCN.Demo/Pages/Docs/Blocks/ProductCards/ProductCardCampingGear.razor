@* ============================================================
   Block: product-card-camping-gear
   Title: ProductCardCampingGear
   Description: Outdoor camping equipment product card with weather rating and packability specs for outdoor stores
   Source: original/blocks/product-cards/product-card-camping-gear.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[180px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">3-Season</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="absolute top-3 right-3">Ultralight</BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">REI Co-op</p>
            <h3 class="text-sm font-medium">Magma 15 Down Sleeping Bag</h3>
            <div class="mt-2 flex items-end justify-between">
                <p class="text-2xl font-semibold tabular-nums">$349</p>
                <div class="flex items-center gap-1 text-xs text-muted-foreground">
                    <span>Regular &middot; Fits up to 6&apos;0&quot;</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">SPECIFICATIONS</p>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var spec in _specs)
                {
                    <div class="flex items-center gap-2 rounded-md bg-muted/50 p-2">
                        <LucideIconCn Name="@spec.IconName" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                        <div>
                            <p class="text-xs font-medium">@spec.Value</p>
                            <p class="text-xs text-muted-foreground">@spec.Label</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">SEASON RATING</p>
            <div class="grid grid-cols-4 gap-2">
                @foreach (var season in _seasons)
                {
                    <div class="@Cn.Merge("flex flex-col items-center gap-1 rounded-md p-2", season.Suitable ? "bg-muted/50" : "opacity-40")">
                        <LucideIconCn Name="@season.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">@season.Label</span>
                        <span class="@Cn.Merge("size-1.5 rounded-full", season.Suitable ? "bg-emerald-500" : "bg-muted-foreground/40")"></span>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">FEATURES</p>
            <div class="flex flex-wrap gap-1">
                @foreach (var feature in _features)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@feature</BadgeCn>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Spec(string IconName, string Label, string Value);
    private record Season(string IconName, string Label, bool Suitable);

    private static readonly Spec[] _specs =
    [
        new Spec("weight", "Weight", "1.82 kg (4 lbs)"),
        new Spec("layers", "Packed Size", "6\" x 20\" roll"),
        new Spec("thermometer", "Temp Rating", "15°F / -9°C"),
        new Spec("cloud-rain", "Waterproof", "3000mm HH"),
    ];

    private static readonly Season[] _seasons =
    [
        new Season("sun", "Summer", true),
        new Season("mountain", "Spring", true),
        new Season("cloud-rain", "Fall", true),
        new Season("snowflake", "Winter", false),
    ];

    private static readonly string[] _features =
    [
        "Ripstop nylon shell",
        "650-fill down insulation",
        "YKK zippers",
        "Draft collar",
        "Compression sack included",
        "EN/ISO certified",
    ];
}
