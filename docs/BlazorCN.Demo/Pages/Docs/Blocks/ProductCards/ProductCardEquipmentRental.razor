@* ============================================================
   Block: product-card-equipment-rental
   Title: ProductCardEquipmentRental
   Description: Equipment rental card with hourly/daily rates and availability calendar for React rental sites
   Source: original/blocks/product-cards/product-card-equipment-rental.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <BadgeCn Class="absolute top-3 left-3">@_product.Category</BadgeCn>
                <BadgeCn Class="@($"absolute top-3 right-3 {_conditionColor}")" Variant="BadgeVariant.Secondary">@_product.Condition</BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <p class="text-xs font-medium text-muted-foreground">@_product.Brand</p>
                <h2 class="font-semibold leading-tight">@_product.Name</h2>

                @* Availability *@
                <div class="mt-3 flex items-center gap-2">
                    @if (_product.IsAvailable)
                    {
                        <div class="h-2 w-2 rounded-full bg-primary"></div>
                        <span class="text-sm text-primary font-medium">Available Now</span>
                    }
                    else
                    {
                        <div class="h-2 w-2 rounded-full bg-muted-foreground"></div>
                        <span class="text-sm text-muted-foreground">Available @_product.NextAvailable</span>
                    }
                </div>

                @* Rate selector *@
                <div class="mt-4">
                    <TabsCn Value="@_rateType" ValueChanged="@((string v) => SetRateType(v))">
                        <TabsListCn Class="grid w-full grid-cols-3">
                            <TabsTriggerCn Class="text-xs" Value="hourly">Hourly</TabsTriggerCn>
                            <TabsTriggerCn Class="text-xs" Value="daily">Daily</TabsTriggerCn>
                            <TabsTriggerCn Class="text-xs" Value="weekly">Weekly</TabsTriggerCn>
                        </TabsListCn>
                    </TabsCn>

                    <div class="mt-3 flex items-baseline justify-between">
                        <div>
                            <span class="text-2xl font-bold tabular-nums">$@_currentRate</span>
                            <span class="text-muted-foreground">/@_rateLabel</span>
                        </div>
                        @if (_rateType == "weekly")
                        {
                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">Save @_weeklySavingsPct%</BadgeCn>
                        }
                    </div>
                </div>

                @* Deposit info *@
                <div class="mt-3 flex items-center gap-2 rounded-lg border p-2">
                    <LucideIconCn Name="shield-check" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    <div class="flex-1">
                        <p class="text-xs font-medium">Security Deposit</p>
                        <p class="text-xs text-muted-foreground">$@_product.Deposit (refundable)</p>
                    </div>
                </div>

                @* Included items *@
                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">INCLUDED IN RENTAL</p>
                    <div class="space-y-1">
                        @foreach (var item in _product.Included)
                        {
                            <div class="flex items-center gap-2 text-xs">
                                <LucideIconCn Name="check" Size="12" Class="h-3 w-3 text-primary" />
                                <span>@item</span>
                            </div>
                        }
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full" Disabled="@(!_product.IsAvailable)">
                    <LucideIconCn Name="calendar" Size="16" Class="mr-2 h-4 w-4" />
                    Reserve Now
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    <LucideIconCn Name="package" Size="16" Class="mr-2 h-4 w-4" />
                    Add Accessories
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record RentalRates(int Hourly, int Daily, int Weekly);

    private record Product(
        string Name,
        string Brand,
        string Category,
        string Image,
        string Condition,
        RentalRates Rates,
        int Deposit,
        bool IsAvailable,
        string? NextAvailable,
        string[] Included
    );

    private static readonly Product _product = new(
        Name: "Canon EOS R5 Mirrorless Camera",
        Brand: "Canon",
        Category: "Cameras",
        Image: "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=400&q=80",
        Condition: "Excellent",
        Rates: new RentalRates(Hourly: 25, Daily: 150, Weekly: 750),
        Deposit: 500,
        IsAvailable: true,
        NextAvailable: null,
        Included: ["Camera body", "Battery & charger", "Strap", "Memory card (64GB)", "Carrying case"]
    );

    private string _rateType = "daily";

    private int _currentRate => _rateType switch
    {
        "hourly" => _product.Rates.Hourly,
        "weekly" => _product.Rates.Weekly,
        _ => _product.Rates.Daily,
    };

    private string _rateLabel => _rateType switch
    {
        "hourly" => "hour",
        "weekly" => "week",
        _ => "day",
    };

    private int _weeklySavingsPct =>
        (int)Math.Round((1.0 - (double)_product.Rates.Weekly / (_product.Rates.Daily * 7.0)) * 100);

    private string _conditionColor => _product.Condition switch
    {
        "Fair" => "text-muted-foreground",
        _ => "text-primary",
    };

    private void SetRateType(string v)
    {
        _rateType = v;
    }
}
