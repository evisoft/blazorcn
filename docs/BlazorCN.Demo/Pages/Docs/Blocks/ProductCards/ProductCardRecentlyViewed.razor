@* ============================================================
   Block: product-card-recently-viewed
   Title: ProductCardRecentlyViewed
   Description: Recently viewed product strip with horizontal scroll, timestamps, and quick add for React ecommerce
   Source: original/blocks/product-cards/product-card-recently-viewed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-sm font-medium">Recently viewed</span>
            </div>
            <span class="text-xs text-muted-foreground">@_items.Count items</span>
        </div>

        @* Product list *@
        @if (_items.Count > 0)
        {
            <div>
                @foreach (var product in _items)
                {
                    var prod = product;
                    <div class="flex items-center gap-3 border-t px-4 py-2.5 transition-colors hover:bg-muted/50">
                        @* Thumbnail *@
                        <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="shopping-cart" Size="16" Class="size-4 text-muted-foreground/40" />
                        </div>

                        @* Info *@
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-medium">@prod.Name</p>
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-medium tabular-nums">$@prod.Price</span>
                                <span class="text-xs text-muted-foreground">·</span>
                                <span class="text-xs text-muted-foreground">@prod.ViewedAt</span>
                            </div>
                        </div>

                        @* Actions *@
                        <div class="flex items-center gap-1">
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 px-2 text-xs">
                                Add
                            </ButtonCn>
                            <button
                                type="button"
                                @onclick="@(() => RemoveItem(prod.Id))"
                                class="flex size-6 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground"
                                aria-label="@($"Remove {prod.Name}")">
                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="border-t px-4 py-8 text-center">
                <p class="text-xs text-muted-foreground">No recently viewed items</p>
            </div>
        }

        @* Footer *@
        @if (_items.Count > 0)
        {
            <div class="border-t px-4 py-2.5">
                <button
                    type="button"
                    @onclick="@(() => _items.Clear())"
                    class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                    Clear history
                </button>
            </div>
        }
    </div>
</section>

@code {
    private record RecentProduct(int Id, string Name, int Price, string ViewedAt);

    private List<RecentProduct> _items = [
        new(1, "Wireless Earbuds Pro", 129, "5 min ago"),
        new(2, "Leather Weekender Bag", 245, "12 min ago"),
        new(3, "Ceramic Pour-Over Set", 64, "1 hr ago"),
        new(4, "Merino Wool Beanie", 38, "2 hrs ago"),
        new(5, "Titanium Water Bottle", 52, "Yesterday"),
    ];

    private void RemoveItem(int id)
    {
        _items = _items.Where(item => item.Id != id).ToList();
    }
}
