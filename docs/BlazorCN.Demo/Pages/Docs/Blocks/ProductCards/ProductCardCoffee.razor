@* ============================================================
   Block: product-card-coffee
   Title: ProductCardCoffee
   Description: Coffee subscription product card with roast profile and brewing details for coffee shops
   Source: original/blocks/product-cards/product-card-coffee.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[180px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Single Origin</BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                <span>Huila, Colombia &middot; 1,800m elevation</span>
            </div>
            <h3 class="mt-1 text-sm font-medium">La Esperanza Natural Process</h3>
            <p class="mt-1 text-xs text-muted-foreground">
                Finca La Esperanza &middot; 12 oz bag
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">ROAST LEVEL</p>
            <div class="flex items-center gap-2">
                <LucideIconCn Name="thermometer" Size="14" Class="size-3.5 text-muted-foreground" />
                <div class="flex-1">
                    <div class="flex h-2 rounded-full bg-muted">
                        <div class="w-[65%] rounded-full bg-amber-800"></div>
                    </div>
                    <div class="mt-1 flex justify-between text-xs text-muted-foreground">
                        <span>Light</span>
                        <span>Medium-Dark</span>
                        <span>Dark</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">TASTING NOTES</p>
            <div class="flex flex-wrap gap-1">
                @foreach (var note in _flavorNotes)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                        <LucideIconCn Name="bean" Size="10" Class="mr-1 size-2.5" />
                        @note
                    </BadgeCn>
                }
            </div>
            <div class="mt-2 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">SCA Score</span>
                <span class="font-medium">87 pts</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">GRIND</p>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var grind in _grinds)
                {
                    var g = grind;
                    <button
                        type="button"
                        class="@Cn.Merge("rounded-md border px-2.5 py-1 text-xs font-medium transition-colors", _selectedGrind == g ? "border-foreground bg-foreground text-background" : "hover:bg-muted/50")"
                        @onclick="@(() => _selectedGrind = g)">
                        @grind
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">DELIVERY</p>
            <div class="space-y-1.5">
                @foreach (var freq in _frequencies)
                {
                    var f = freq;
                    <label
                        class="@Cn.Merge("flex cursor-pointer items-center justify-between rounded-md border p-2 transition-colors", _selectedFrequency == f.Id ? "border-foreground bg-foreground/5" : "hover:bg-muted/50")"
                        @onclick="@(() => _selectedFrequency = f.Id)">
                        <div class="flex items-center gap-2">
                            <div class="@Cn.Merge("size-3.5 rounded-full border-2", _selectedFrequency == f.Id ? "border-foreground bg-foreground" : "border-muted-foreground/40")"></div>
                            <span class="text-xs font-medium">@f.Label</span>
                        </div>
                        <span class="text-xs font-medium tabular-nums">$@f.Price/bag</span>
                        <input
                            type="radio"
                            name="frequency"
                            value="@f.Id"
                            checked="@(_selectedFrequency == f.Id)"
                            class="sr-only"
                            @onchange="@(() => _selectedFrequency = f.Id)" />
                    </label>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart &mdash; $@_currentPrice
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FrequencyOption(string Id, string Label, int Price);

    private static readonly string[] _grinds = ["Whole Bean", "Coarse", "Medium", "Fine", "Espresso"];
    private static readonly string[] _flavorNotes = ["Dark Chocolate", "Caramel", "Dried Cherry", "Walnut"];
    private static readonly FrequencyOption[] _frequencies =
    [
        new("once", "One-time", 22),
        new("biweekly", "Every 2 weeks", 19),
        new("monthly", "Monthly", 20),
    ];

    private string _selectedGrind = "Whole Bean";
    private string _selectedFrequency = "biweekly";

    private int _currentPrice => _frequencies.FirstOrDefault(f => f.Id == _selectedFrequency)?.Price ?? 22;
}
