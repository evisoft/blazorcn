@* ============================================================
   Block: product-card-meal-kit
   Title: ProductCardMealKit
   Description: Recipe meal kit card with servings adjuster, cook time, and ingredients for React food sites
   Source: original/blocks/product-cards/product-card-meal-kit.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <BadgeCn Class="absolute top-3 left-3">@_product.Cuisine</BadgeCn>
                <BadgeCn Class="absolute top-3 right-3" Variant="BadgeVariant.Secondary">@_product.Difficulty</BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h2 class="font-semibold">@_product.Name</h2>

                @* Dietary tags *@
                <div class="mt-2 flex flex-wrap gap-1">
                    @foreach (var tag in _product.Dietary)
                    {
                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">@tag</BadgeCn>
                    }
                </div>

                @* Time and calories *@
                <div class="mt-3 flex items-center gap-4 text-sm text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="clock" Size="16" Class="h-4 w-4" />
                        <span>@_product.PrepTime prep</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="chef-hat" Size="16" Class="h-4 w-4" />
                        <span>@_product.CookTime cook</span>
                    </div>
                </div>

                <SeparatorCn Class="my-3" />

                @* Servings selector *@
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="users" Size="16" Class="h-4 w-4 text-muted-foreground" />
                        <span class="text-sm font-medium">Servings</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <ButtonCn Class="h-8 w-8" Disabled="@(_servings <= 1)" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline"
                            OnClick="@(() => _servings = Math.Max(1, _servings - 1))" aria-label="Remove">
                            <LucideIconCn Name="minus" Size="12" Class="h-3 w-3" />
                        </ButtonCn>
                        <span class="w-8 text-center font-medium tabular-nums">@_servings</span>
                        <ButtonCn Class="h-8 w-8" Disabled="@(_servings >= 8)" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline"
                            OnClick="@(() => _servings = Math.Min(8, _servings + 1))" aria-label="Add">
                            <LucideIconCn Name="plus" Size="12" Class="h-3 w-3" />
                        </ButtonCn>
                    </div>
                </div>

                @* Calories per serving *@
                <div class="mt-2 flex items-center justify-between text-sm text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideIconCn Name="flame" Size="16" Class="h-4 w-4" />
                        <span>@_product.Calories cal/serving</span>
                    </div>
                    <span>@TotalCalories cal total</span>
                </div>

                <SeparatorCn Class="my-3" />

                @* Key ingredients *@
                <div>
                    <p class="mb-2 text-xs font-medium text-muted-foreground">KEY INGREDIENTS</p>
                    <div class="flex flex-wrap gap-1">
                        @foreach (var ingredient in _product.Ingredients)
                        {
                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">@ingredient</BadgeCn>
                        }
                    </div>
                </div>

                @* Price *@
                <div class="mt-4 flex items-baseline justify-between">
                    <div>
                        <span class="text-2xl font-bold tabular-nums">$@TotalPrice.ToString("0.00")</span>
                        <p class="text-xs text-muted-foreground">$@_product.PricePerServing.ToString("0.00")/serving</p>
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideIconCn Name="shopping-basket" Size="16" Class="mr-2 h-4 w-4" />
                    Add to Box
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record Product(
        string Name,
        string Cuisine,
        string Image,
        double BasePrice,
        int BaseServings,
        double PricePerServing,
        string PrepTime,
        string CookTime,
        string Difficulty,
        int Calories,
        string[] Ingredients,
        string[] Dietary
    );

    private static readonly Product _product = new(
        Name: "Thai Basil Chicken Stir-Fry",
        Cuisine: "Thai",
        Image: "https://images.unsplash.com/photo-1562967916-eb82221dfb92?w=400&q=80",
        BasePrice: 24.99,
        BaseServings: 2,
        PricePerServing: 12.5,
        PrepTime: "15 min",
        CookTime: "20 min",
        Difficulty: "Easy",
        Calories: 480,
        Ingredients: ["Chicken thigh", "Thai basil", "Garlic", "Chili", "Jasmine rice", "Fish sauce"],
        Dietary: ["High Protein", "Dairy-Free"]
    );

    private int _servings = _product.BaseServings;

    private double TotalPrice => _product.PricePerServing * _servings;
    private int TotalCalories => _product.Calories * _servings;
}
