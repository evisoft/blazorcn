@* ============================================================
   Block: product-card-rental
   Title: ProductCardRental
   Description: Equipment rental product card with daily rate, availability calendar, and deposit info for React stores
   Source: original/blocks/product-cards/product-card-rental.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Image *@
        <div class="relative flex h-[200px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="camera" Size="64" Class="size-16 text-muted-foreground/30" />
            <BadgeCn Class="absolute top-3 left-3">@_product.Category</BadgeCn>
            <div class="absolute top-3 right-3 flex items-center gap-1 rounded-full bg-background/90 px-2 py-1">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs font-medium">@_product.Availability</span>
            </div>
        </div>

        @* Title and rates *@
        <div class="border-t px-4 py-3">
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <div class="mt-1 flex items-baseline gap-3">
                <div>
                    <span class="text-2xl font-semibold tabular-nums">$@_product.DailyRate</span>
                    <span class="text-xs text-muted-foreground">/day</span>
                </div>
                <div class="text-xs text-muted-foreground">$@_product.WeeklyRate/week</div>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">Condition: @_product.Condition</p>
        </div>

        @* Rental duration *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">RENTAL PERIOD</p>
            <div class="flex gap-1.5">
                @foreach (var dur in _product.Durations)
                {
                    var duration = dur;
                    var idx = Array.IndexOf(_product.Durations, duration);
                    <button
                        type="button"
                        @onclick="@(() => _selectedDuration = idx)"
                        class="@Cn.Merge("flex-1 rounded-md border px-2 py-2 text-xs font-medium transition-colors", _selectedDuration == idx ? "border-foreground bg-foreground text-background" : "hover:bg-muted/50")">
                        @duration.Label
                    </button>
                }
            </div>
        </div>

        @* Kit includes *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">KIT INCLUDES</p>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var item in _product.Includes)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@item</BadgeCn>
                }
            </div>
        </div>

        @* Insurance option *@
        <div class="border-t px-4 py-3">
            <div class="flex cursor-pointer items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="text-xs font-medium">Damage protection</p>
                        <p class="text-xs text-muted-foreground">$12/day — covers accidental damage</p>
                    </div>
                </div>
                <div
                    @onclick="@(() => _addInsurance = !_addInsurance)"
                    role="switch"
                    tabindex="0"
                    aria-label="Damage protection" aria-checked="@(_addInsurance ? "true" : "false")"
                    class="@Cn.Merge("relative h-5 w-9 cursor-pointer rounded-full transition-colors", _addInsurance ? "bg-foreground" : "bg-muted")">
                    <div class="@Cn.Merge("absolute top-0.5 size-4 rounded-full bg-background transition-transform", _addInsurance ? "translate-x-4" : "translate-x-0.5")"></div>
                </div>
            </div>
        </div>

        @* Pricing summary *@
        <div class="border-t px-4 py-3">
            <div class="space-y-1">
                <div class="flex justify-between text-xs">
                    <span class="text-muted-foreground">Rental (@_product.Durations[_selectedDuration].Label)</span>
                    <span class="tabular-nums">$@_rentalCost</span>
                </div>
                @if (_addInsurance)
                {
                    <div class="flex justify-between text-xs">
                        <span class="text-muted-foreground">Insurance</span>
                        <span class="tabular-nums">$@_insuranceCost</span>
                    </div>
                }
                <div class="flex justify-between text-xs">
                    <span class="text-muted-foreground">Refundable deposit</span>
                    <span class="tabular-nums">$@_product.Deposit</span>
                </div>
            </div>
            <div class="mt-2 flex items-center justify-between border-t pt-2">
                <span class="text-sm font-medium">Total due today</span>
                <span class="text-lg font-semibold tabular-nums">$@(_total + _product.Deposit)</span>
            </div>
        </div>

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                <LucideIconCn Name="calendar" Size="16" Class="mr-2 size-4" />
                Reserve Now
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Duration(string Label, int Days);

    private record RentalProduct(
        string Name,
        string Category,
        int DailyRate,
        int WeeklyRate,
        int Deposit,
        string Availability,
        string Condition,
        string[] Includes,
        Duration[] Durations
    );

    private static readonly RentalProduct _product = new(
        Name: "Sony A7 IV Camera Kit",
        Category: "Photography",
        DailyRate: 75,
        WeeklyRate: 375,
        Deposit: 500,
        Availability: "Available now",
        Condition: "Excellent",
        Includes: ["Camera body", "24-70mm f/2.8 lens", "2x batteries", "64GB SD card", "Carry case"],
        Durations: [
            new Duration("1 day", 1),
            new Duration("3 days", 3),
            new Duration("1 week", 7),
            new Duration("2 weeks", 14),
        ]
    );

    private int _selectedDuration = 0;
    private bool _addInsurance = false;

    private double _dailyRate => _product.Durations[_selectedDuration].Days >= 7
        ? (double)_product.WeeklyRate / 7
        : _product.DailyRate;

    private int _rentalCost => (int)Math.Round(_dailyRate * _product.Durations[_selectedDuration].Days);

    private int _insuranceCost => _addInsurance ? (int)Math.Round(_product.Durations[_selectedDuration].Days * 12.0) : 0;

    private int _total => _rentalCost + _insuranceCost;
}
