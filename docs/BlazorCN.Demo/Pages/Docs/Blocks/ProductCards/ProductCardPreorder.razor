@* ============================================================
   Block: product-card-preorder
   Title: ProductCardPreorder
   Description: Pre-order product card with estimated shipping date, deposit option, and progress tracker for React stores
   Source: original/blocks/product-cards/product-card-preorder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Image *@
        <div class="relative flex h-[220px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="package" Size="64" Class="size-16 text-muted-foreground/30" />
            <BadgeCn Class="absolute top-3 left-3">Pre-order</BadgeCn>
            <BadgeCn Class="absolute top-3 right-3" Variant="BadgeVariant.Secondary">
                Save $@_savingsAmount
            </BadgeCn>
        </div>

        @* Title *@
        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">@_product.Brand</p>
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <div class="mt-1 flex items-baseline gap-2">
                <span class="text-2xl font-semibold tabular-nums">$@_product.EarlyBirdPrice</span>
                <span class="text-sm text-muted-foreground line-through tabular-nums">$@_product.Price</span>
            </div>
        </div>

        @* Shipping estimate *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs">Ships @_product.EstimatedShip</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="truck" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs">Free shipping</span>
                </div>
            </div>
        </div>

        @* Progress milestones *@
        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">PRODUCTION STATUS</p>
            <div class="flex items-center gap-1">
                @foreach (var ms in _product.Milestones)
                {
                    var milestone = ms;
                    var idx = Array.IndexOf(_product.Milestones, milestone);
                    <div class="flex flex-1 flex-col items-center">
                        <div class="flex w-full items-center">
                            <div class="@Cn.Merge("flex size-5 shrink-0 items-center justify-center rounded-full", milestone.Completed ? "bg-foreground text-background" : "border border-muted-foreground/30")">
                                @if (milestone.Completed)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                }
                            </div>
                            @if (idx < _product.Milestones.Length - 1)
                            {
                                <div class="@Cn.Merge("h-0.5 flex-1", milestone.Completed ? "bg-foreground" : "bg-muted")"></div>
                            }
                        </div>
                        <span class="mt-1 text-center text-xs text-muted-foreground">@milestone.Label</span>
                    </div>
                }
            </div>
        </div>

        @* Features *@
        <div class="border-t px-4 py-3">
            <div class="space-y-1.5">
                @foreach (var feature in _product.Features)
                {
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="check" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs">@feature</span>
                    </div>
                }
            </div>
        </div>

        @* Pre-orders count *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                <span>@_product.PreordersPlaced.ToString("N0") pre-orders placed</span>
            </div>
        </div>

        @* Actions *@
        <div class="border-t px-4 py-3 space-y-2">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                Pre-order — $@_product.Deposit deposit
            </ButtonCn>
            <p class="text-center text-xs text-muted-foreground">
                $@_balanceRemaining charged when shipped
            </p>
        </div>
    </div>
</section>

@code {
    private record Milestone(string Label, bool Completed);

    private record PreorderProduct(
        string Name,
        string Brand,
        int Price,
        int EarlyBirdPrice,
        string EstimatedShip,
        int Deposit,
        int PreordersPlaced,
        Milestone[] Milestones,
        string[] Features);

    private static readonly PreorderProduct _product = new(
        "AirPods Max 2nd Gen",
        "TechForward",
        549,
        479,
        "June 2026",
        99,
        1247,
        [
            new("Announced", true),
            new("In production", true),
            new("Quality testing", false),
            new("Shipping", false),
        ],
        [
            "Adaptive noise cancellation",
            "Spatial audio with head tracking",
            "USB-C charging",
            "40-hour battery",
        ]);

    private int _savingsAmount => _product.Price - _product.EarlyBirdPrice;
    private int _balanceRemaining => _product.EarlyBirdPrice - _product.Deposit;
}
