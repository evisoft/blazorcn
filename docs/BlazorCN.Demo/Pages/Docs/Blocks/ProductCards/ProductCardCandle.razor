@* ============================================================
   Block: product-card-candle
   Title: ProductCardCandle
   Description: Scented candle product card with burn time and fragrance notes for home decor stores
   Source: original/blocks/product-cards/product-card-candle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[180px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Hand-Poured</BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Lumiere &amp; Co</p>
            <h3 class="text-sm font-medium">Midnight Rose</h3>
            <p class="mt-1 text-xs text-muted-foreground">
                A warm, floral blend with spicy undertones and a velvety base
            </p>
            <p class="mt-2 text-2xl font-semibold tabular-nums">$@_selectedSize.Price</p>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">SIZE</p>
            <div class="grid grid-cols-3 gap-1.5">
                @foreach (var s in _sizes)
                {
                    var size = s;
                    <button type="button"
                            class="@Cn.Merge("rounded-md border p-2 text-center transition-colors", _selectedSizeId == size.Id ? "border-foreground bg-foreground/5" : "hover:bg-muted/50")"
                            @onclick="@(() => SelectSize(size.Id))">
                        <p class="text-xs font-medium">@size.Label</p>
                        <p class="text-xs text-muted-foreground">@size.Weight</p>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">FRAGRANCE NOTES</p>
            <div class="space-y-2">
                <div>
                    <p class="text-xs text-muted-foreground">Top</p>
                    <p class="text-xs font-medium">@string.Join(" · ", _scentNotes.Top)</p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Heart</p>
                    <p class="text-xs font-medium">@string.Join(" · ", _scentNotes.Middle)</p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Base</p>
                    <p class="text-xs font-medium">@string.Join(" · ", _scentNotes.Base)</p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="text-xs font-medium">@_selectedSize.Burn</p>
                        <p class="text-xs text-muted-foreground">Burn time</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="flame" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="text-xs font-medium">Cotton</p>
                        <p class="text-xs text-muted-foreground">Wick type</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="leaf" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <p class="text-xs font-medium">Soy Wax</p>
                        <p class="text-xs text-muted-foreground">100% natural</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap gap-1">
                @foreach (var tag in _tags)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@tag</BadgeCn>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record CandleSize(string Id, string Label, string Weight, string Burn, int Price);
    private record ScentNotes(string[] Top, string[] Middle, string[] Base);

    private static readonly CandleSize[] _sizes =
    [
        new("mini", "Mini", "4 oz", "25h", 18),
        new("classic", "Classic", "9 oz", "55h", 34),
        new("large", "Large", "16 oz", "90h", 52),
    ];

    private static readonly ScentNotes _scentNotes = new(
        Top: ["Bergamot", "Black Pepper"],
        Middle: ["Rose", "Sandalwood"],
        Base: ["Amber", "Musk", "Vanilla"]
    );

    private static readonly string[] _tags = ["Phthalate-free", "Cruelty-free", "Hand-poured", "Reusable vessel"];

    private string _selectedSizeId = "classic";

    private CandleSize _selectedSize => Array.Find(_sizes, s => s.Id == _selectedSizeId) ?? _sizes[1];

    private void SelectSize(string id) => _selectedSizeId = id;
}
