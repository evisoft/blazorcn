@* ============================================================
   Block: product-card-vinyl-record
   Title: ProductCardVinylRecord
   Description: Vinyl record product card with tracklist, format details, and playback preview for React music stores
   Source: original/blocks/product-cards/product-card-vinyl-record.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Album art *@
        <div class="relative flex aspect-square max-h-[280px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="disc-3" Size="80" Class="size-20 text-muted-foreground/30" />
            <BadgeCn Class="absolute top-3 left-3">@_product.Format</BadgeCn>
            <BadgeCn Class="absolute top-3 right-3" Variant="BadgeVariant.Secondary">@_product.Weight</BadgeCn>
        </div>

        @* Title and artist *@
        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">@_product.Artist</p>
            <h3 class="text-sm font-medium">@_product.Title</h3>
            <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                <span>@_product.Label</span>
                <span>·</span>
                <span>@_product.Year</span>
                <span>·</span>
                <span>@_product.Genre</span>
            </div>
        </div>

        @* Condition and price *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs text-muted-foreground">Condition</p>
                    <p class="text-sm font-medium">@_product.Condition</p>
                </div>
                <span class="text-2xl font-semibold tabular-nums">$@_product.Price</span>
            </div>
        </div>

        @* Tracklist toggle *@
        <div class="border-t">
            <button
                type="button"
                @onclick="@(() => _showTracklist = !_showTracklist)"
                class="flex w-full items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <span class="text-xs font-medium text-muted-foreground">
                    TRACKLIST (@(_product.Tracks.Length) tracks)
                </span>
                <LucideIconCn Name="chevron-down" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground transition-transform duration-200", _showTracklist ? "rotate-180" : "")" />
            </button>

            @if (_showTracklist)
            {
                <div class="border-t">
                    @for (int i = 0; i < _product.Tracks.Length; i++)
                    {
                        var track = _product.Tracks[i];
                        var prevTrack = i > 0 ? _product.Tracks[i - 1] : null;
                        var showSideHeader = prevTrack == null || prevTrack.Side != track.Side;
                        <div>
                            @if (showSideHeader)
                            {
                                <div class="bg-muted/50 px-4 py-1">
                                    <span class="text-xs font-medium text-muted-foreground">Side @track.Side</span>
                                </div>
                            }
                            <div class="flex items-center justify-between px-4 py-1.5">
                                <div class="flex items-center gap-2">
                                    <span class="w-4 text-right font-mono text-xs text-muted-foreground">@track.Number</span>
                                    <span class="text-xs">@track.Title</span>
                                </div>
                                <span class="font-mono text-xs text-muted-foreground tabular-nums">@track.Duration</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Track(string Side, int Number, string Title, string Duration);

    private record VinylProduct(
        string Title,
        string Artist,
        string Label,
        int Year,
        double Price,
        string Format,
        string Weight,
        string Genre,
        string Condition,
        Track[] Tracks
    );

    private static readonly VinylProduct _product = new(
        Title: "In Rainbows",
        Artist: "Radiohead",
        Label: "XL Recordings",
        Year: 2007,
        Price: 32.99,
        Format: "12\" LP",
        Weight: "180g",
        Genre: "Alternative Rock",
        Condition: "New / Sealed",
        Tracks: [
            new Track("A", 1, "15 Step", "3:57"),
            new Track("A", 2, "Bodysnatchers", "4:02"),
            new Track("A", 3, "Nude", "4:15"),
            new Track("A", 4, "Weird Fishes/Arpeggi", "5:18"),
            new Track("A", 5, "All I Need", "3:48"),
            new Track("B", 6, "Faust Arp", "2:09"),
            new Track("B", 7, "Reckoner", "4:50"),
            new Track("B", 8, "House of Cards", "5:28"),
            new Track("B", 9, "Jigsaw Falling Into Place", "4:09"),
            new Track("B", 10, "Videotape", "4:39"),
        ]
    );

    private bool _showTracklist = false;
}
