@* ============================================================
   Block: product-card-watch-luxury
   Title: ProductCardWatchLuxury
   Description: Luxury watch product card with movement details, case material, and water resistance for luxury stores
   Source: original/blocks/product-cards/product-card-watch-luxury.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Image placeholder *@
        <div class="relative flex h-[220px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="image" Size="48" Class="size-12 text-muted-foreground/40" />
            <BadgeCn Class="absolute top-3 left-3">Authorized Dealer</BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="absolute top-3 right-3">
                Ref. 126334
            </BadgeCn>
        </div>

        @* Title & price *@
        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Rolex</p>
            <h3 class="text-sm font-medium">Datejust 41</h3>
            <p class="mt-1 text-xs text-muted-foreground">
                Oystersteel &middot; Black Dial &middot; Jubilee Bracelet
            </p>
            <p class="mt-2 text-2xl font-semibold tabular-nums">$10,550</p>
        </div>

        @* Key specs icons *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-2">
                <div class="flex flex-col items-center gap-1 rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                    <p class="text-xs font-medium">70h</p>
                    <p class="text-xs text-muted-foreground">Power Reserve</p>
                </div>
                <div class="flex flex-col items-center gap-1 rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="droplets" Size="16" Class="size-4 text-muted-foreground" />
                    <p class="text-xs font-medium">100m</p>
                    <p class="text-xs text-muted-foreground">Water Resist</p>
                </div>
                <div class="flex flex-col items-center gap-1 rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                    <p class="text-xs font-medium">COSC</p>
                    <p class="text-xs text-muted-foreground">Certified</p>
                </div>
            </div>
        </div>

        @* Specifications list *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">SPECIFICATIONS</p>
            <div class="space-y-1.5">
                @foreach (var spec in _specs)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@spec.Label</span>
                        <span class="font-medium">@spec.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Authenticity guarantee *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="shield" Size="14" Class="size-3.5 text-primary" />
                    <p class="text-xs font-medium">Authenticity Guaranteed</p>
                </div>
                <p class="mt-1 text-xs text-muted-foreground">
                    Includes original box, papers, and 5-year international warranty from Rolex.
                </p>
            </div>
        </div>

        @* Actions *@
        <div class="flex gap-2 px-4 py-3">
            <ButtonCn Class="flex-1">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Purchase
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1">
                Schedule Viewing
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record WatchSpec(string Label, string Value);

    private static readonly WatchSpec[] _specs =
    [
        new("Movement", "Automatic (Caliber 3235)"),
        new("Power Reserve", "70 hours"),
        new("Case Material", "Oystersteel"),
        new("Case Diameter", "41mm"),
        new("Crystal", "Sapphire, Cyclops lens"),
        new("Dial", "Black, luminescent indices"),
        new("Bracelet", "Jubilee, 5-piece links"),
        new("Clasp", "Oysterclasp, Easylink"),
    ];
}
