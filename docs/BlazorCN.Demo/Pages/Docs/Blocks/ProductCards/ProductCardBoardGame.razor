@* ============================================================
   Block: product-card-board-game
   Title: ProductCardBoardGame
   Description: Board game product card with player count, play duration, and complexity rating for React game stores
   Source: original/blocks/product-cards/product-card-board-game.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Image *@
        <div class="relative flex h-[220px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="dice-5" Size="64" Class="size-16 text-muted-foreground/30" />
            @if (_product.InStock)
            {
                <BadgeCn Class="absolute top-3 left-3" Variant="BadgeVariant.Secondary">
                    In Stock
                </BadgeCn>
            }
        </div>

        @* Title and price *@
        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">by @_product.Designer</p>
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <div class="mt-1 flex items-center gap-2">
                <span class="text-2xl font-semibold tabular-nums">$@_product.Price</span>
                <div class="flex items-center gap-1">
                    <LucideIconCn Name="star" Size="12" Class="size-3 fill-foreground text-foreground" />
                    <span class="text-xs font-medium">@_product.Rating</span>
                    <span class="text-xs text-muted-foreground">(@_product.ReviewCount)</span>
                </div>
            </div>
        </div>

        @* Game specs *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium">@_product.PlayerCount players</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs font-medium">@_product.PlayTime</span>
                </div>
                <span class="text-xs text-muted-foreground">Ages @_product.Age</span>
            </div>
        </div>

        @* Complexity *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="text-xs font-medium text-muted-foreground">COMPLEXITY</p>
                <span class="text-xs font-medium tabular-nums">
                    @_product.Complexity / @_product.MaxComplexity
                </span>
            </div>
            <div class="mt-1.5 h-1.5 w-full rounded-full bg-muted">
                <div
                    class="h-full rounded-full bg-foreground"
                    style="@(FormattableString.Invariant($"width:{_complexityPercent:F1}%"))" />
            </div>
            <div class="mt-1 flex justify-between text-xs text-muted-foreground">
                <span>Light</span>
                <span>Heavy</span>
            </div>
        </div>

        @* Categories *@
        <div class="border-t px-4 py-3">
            <div class="flex flex-wrap gap-1.5">
                @foreach (var cat in _product.Categories)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@cat</BadgeCn>
                }
            </div>
        </div>

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record BoardGameProduct(
        string Name,
        string Designer,
        double Price,
        string PlayerCount,
        string PlayTime,
        string Age,
        double Complexity,
        int MaxComplexity,
        double Rating,
        int ReviewCount,
        string[] Categories,
        bool InStock
    );

    private static readonly BoardGameProduct _product = new(
        Name: "Architects of the West Kingdom",
        Designer: "Shem Phillips",
        Price: 49.99,
        PlayerCount: "1–5",
        PlayTime: "60–80 min",
        Age: "12+",
        Complexity: 3.1,
        MaxComplexity: 5,
        Rating: 4.6,
        ReviewCount: 842,
        Categories: ["Worker Placement", "Strategy", "Medieval"],
        InStock: true
    );

    private static readonly double _complexityPercent = (_product.Complexity / _product.MaxComplexity) * 100;
}
