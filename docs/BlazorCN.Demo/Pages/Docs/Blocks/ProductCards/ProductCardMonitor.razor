@* ============================================================
   Block: product-card-monitor
   Title: ProductCardMonitor
   Description: Monitor product card with display specs, panel type, and resolution for electronics stores
   Source: original/blocks/product-cards/product-card-monitor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative flex h-[180px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="monitor" Size="64" Class="size-16 text-muted-foreground/20" />
            <BadgeCn Class="absolute top-3 left-3">Professional</BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">LG UltraFine</p>
            <h3 class="text-sm font-medium">@_option.Size @_option.Resolution Studio Display</h3>
            <div class="mt-2 flex items-end justify-between">
                <p class="text-2xl font-semibold tabular-nums">$@_option.Price</p>
                <p class="text-xs text-muted-foreground">
                    Factory calibrated &middot; Delta E &lt; 2
                </p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">SIZE</p>
            <div class="grid grid-cols-3 gap-1.5">
                @foreach (var opt in _sizeOptions)
                {
                    var item = opt;
                    <button
                        type="button"
                        class="@Cn.Merge("rounded-md border p-2 text-center transition-colors", _selectedSize == item.Size ? "border-foreground bg-foreground text-background" : "hover:bg-muted/50")"
                        @onclick="@(() => _selectedSize = item.Size)">
                        <p class="text-xs font-medium">@item.Size</p>
                        <p class="@Cn.Merge("text-xs", _selectedSize == item.Size ? "text-background/70" : "text-muted-foreground")">@item.Resolution</p>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">DISPLAY SPECS</p>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var spec in _specs)
                {
                    <div class="flex items-center gap-2 rounded-md bg-muted/50 p-2">
                        <LucideIconCn Name="@spec.Icon" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                        <div>
                            <p class="text-xs font-medium">@spec.Value</p>
                            <p class="text-xs text-muted-foreground">@spec.Label</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">CONNECTIVITY</p>
            <div class="space-y-1">
                @foreach (var port in _ports)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@port.Name</span>
                        <span class="font-medium">&times;@port.Count</span>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="mb-1.5 text-xs font-medium text-muted-foreground">ERGONOMICS</p>
            <p class="text-xs text-muted-foreground">
                Height (150mm) &middot; Tilt (-5&deg; to 35&deg;) &middot; Swivel (280&deg;) &middot;
                Pivot (90&deg;) &middot; VESA 100x100
            </p>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                <LucideIconCn Name="shopping-cart" Size="16" Class="mr-2 size-4" />
                Add to Cart
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SizeOption(string Size, string Resolution, int Price);
    private record SpecItem(string Icon, string Label, string Value);
    private record PortItem(string Name, int Count);

    private static readonly SizeOption[] _sizeOptions =
    [
        new("27\"", "4K", 799),
        new("32\"", "4K", 999),
        new("34\" UW", "UWQHD", 1199),
    ];

    private static readonly SpecItem[] _specs =
    [
        new("monitor", "Panel", "Nano IPS Black"),
        new("timer", "Response", "1ms GtG"),
        new("zap", "Refresh", "165Hz"),
        new("palette", "Color", "98% DCI-P3"),
    ];

    private static readonly PortItem[] _ports =
    [
        new("HDMI 2.1", 2),
        new("DisplayPort 2.1", 1),
        new("USB-C 96W PD", 1),
        new("USB-A 3.2", 3),
    ];

    private string _selectedSize = "32\"";

    private SizeOption _option => _sizeOptions.FirstOrDefault(s => s.Size == _selectedSize) ?? _sizeOptions[1];
}
