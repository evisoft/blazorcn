@* ============================================================
   Block: product-card-limited-edition
   Title: ProductCardLimitedEdition
   Description: Limited edition product card with countdown timer, stock counter, and edition numbering for React stores
   Source: original/blocks/product-cards/product-card-limited-edition.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Image *@
        <div class="relative flex h-[240px] items-center justify-center bg-muted/50">
            <LucideIconCn Name="hash" Size="64" Class="size-16 text-muted-foreground/30" />
            <BadgeCn Class="absolute top-3 left-3">Limited Edition</BadgeCn>
            <div class="absolute top-3 right-3 rounded-full bg-background/90 px-2 py-1">
                <span class="font-mono text-xs font-medium">
                    #@(_product.EditionNumber)/@(_product.TotalEditions)
                </span>
            </div>
        </div>

        @* Title *@
        <div class="border-t px-4 py-3">
            <p class="text-xs font-medium tracking-wider text-muted-foreground">
                @_product.Brand
            </p>
            <h3 class="text-sm font-medium">@_product.Name</h3>
            <p class="mt-1 text-2xl font-semibold tabular-nums">$@_product.Price</p>
        </div>

        @* Countdown *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="timer" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">DROP ENDS IN</span>
            </div>
            <div class="mt-2 flex gap-2">
                @foreach (var unit in _timeUnits)
                {
                    <div class="flex flex-col items-center rounded-md bg-muted/50 px-4 py-2">
                        <span class="text-xl font-semibold tabular-nums">@unit.Value.ToString("D2")</span>
                        <span class="text-xs text-muted-foreground">@unit.Label</span>
                    </div>
                }
            </div>
        </div>

        @* Stock *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="font-medium">@_product.Remaining remaining</span>
                <span class="text-muted-foreground">@(_product.TotalEditions - _product.Remaining) sold</span>
            </div>
            <div class="mt-1.5 h-1.5 w-full rounded-full bg-muted">
                <div
                    class="h-full rounded-full bg-foreground transition-all"
                    style="@($"width:{_soldPercent:F1}%")"
                ></div>
            </div>
        </div>

        @* Features *@
        <div class="border-t px-4 py-3">
            <div class="flex flex-wrap gap-1.5">
                @foreach (var feature in _product.Features)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@feature</BadgeCn>
                }
            </div>
        </div>

        @* Authentication *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-xs text-muted-foreground">
                    Includes Certificate of Authenticity
                </span>
            </div>
        </div>

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                Buy Now — $@_product.Price
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record LimitedProduct(
        string Name,
        string Brand,
        int Price,
        int EditionNumber,
        int TotalEditions,
        int Remaining,
        int DropEndHours,
        string[] Features);

    private record TimeUnit(int Value, string Label);

    private static readonly LimitedProduct _product = new(
        "Midnight Obsidian Sneaker",
        "ARTISAN COLLECTIVE",
        299,
        437,
        1000,
        83,
        6,
        ["Hand-numbered", "Premium leather", "Signed box", "COA included"]);

    private int _hours = 6;
    private int _minutes = 0;
    private int _seconds = 0;

    private IEnumerable<TimeUnit> _timeUnits =>
    [
        new TimeUnit(_hours, "HRS"),
        new TimeUnit(_minutes, "MIN"),
        new TimeUnit(_seconds, "SEC"),
    ];

    private double _soldPercent =>
        ((double)(_product.TotalEditions - _product.Remaining) / _product.TotalEditions) * 100;

    private System.Threading.Timer? _timer;
    private long _endTicks;

    protected override void OnInitialized()
    {
        _endTicks = DateTime.UtcNow.AddHours(_product.DropEndHours).Ticks;
        _timer = new System.Threading.Timer(_ =>
        {
            var diff = new TimeSpan(_endTicks - DateTime.UtcNow.Ticks);
            if (diff <= TimeSpan.Zero)
            {
                _hours = 0; _minutes = 0; _seconds = 0;
            }
            else
            {
                _hours = (int)diff.TotalHours;
                _minutes = diff.Minutes;
                _seconds = diff.Seconds;
            }
            InvokeAsync(StateHasChanged);
        }, null, 0, 1000);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
