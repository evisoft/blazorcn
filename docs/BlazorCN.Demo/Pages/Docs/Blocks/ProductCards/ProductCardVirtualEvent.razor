@* ============================================================
   Block: product-card-virtual-event
   Title: ProductCardVirtualEvent
   Description: Virtual event ticket card with timezone converter, platform badge, and calendar sync for React event apps
   Source: original/blocks/product-cards/product-card-virtual-event.tsx
   ============================================================ *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[360px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[140px]">
                <img
                    alt="@_product.Title"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                <div class="absolute top-3 left-3 flex gap-2">
                    <BadgeCn>@_product.Category</BadgeCn>
                    @if (_product.IsLive)
                    {
                        <BadgeCn Class="gap-1" Variant="BadgeVariant.Secondary">
                            <LucideIconCn Name="radio" Size="12" Class="h-3 w-3 animate-pulse" />
                            Live
                        </BadgeCn>
                    }
                </div>
                <div class="absolute bottom-3 left-3 right-3">
                    <h3 class="font-semibold text-white line-clamp-2">@_product.Title</h3>
                </div>
            </div>

            <CardContentCn Class="p-4">
                @* Date, time, platform *@
                <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
                    <div class="flex items-center gap-1.5 text-muted-foreground">
                        <LucideIconCn Name="calendar" Size="16" Class="h-4 w-4" />
                        <span>@_product.Date</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-muted-foreground">
                        <LucideIconCn Name="clock" Size="16" Class="h-4 w-4" />
                        <span>@_product.Time @_product.Timezone</span>
                    </div>
                </div>
                <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                    <div class="flex items-center gap-1.5 text-muted-foreground">
                        <LucideIconCn Name="globe" Size="16" Class="h-4 w-4" />
                        <span>@_product.Duration</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-muted-foreground">
                        <LucideIconCn Name="video" Size="16" Class="h-4 w-4" />
                        <span>@_product.Platform</span>
                    </div>
                </div>

                @* Speakers *@
                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">SPEAKERS</p>
                    <div class="flex items-center gap-3">
                        <div class="flex -space-x-2">
                            @foreach (var spk in _product.Speakers)
                            {
                                <AvatarCn Class="h-8 w-8 border-2 border-background">
                                    <AvatarImageCn Src="@spk.Avatar" />
                                    <AvatarFallbackCn>@spk.Name[0]</AvatarFallbackCn>
                                </AvatarCn>
                            }
                        </div>
                        <div class="text-sm">
                            <p class="font-medium">@string.Join(", ", Array.ConvertAll(_product.Speakers, s => s.Name.Split(' ')[0]))</p>
                            <p class="text-xs text-muted-foreground">+@_product.Speakers.Length speakers</p>
                        </div>
                    </div>
                </div>

                @* Attendance *@
                <div class="mt-3 flex items-center gap-2">
                    <LucideIconCn Name="users" Size="16" Class="h-4 w-4 text-muted-foreground" />
                    <span class="text-sm">
                        <span class="font-medium">@_product.Attendees.ToString("N0")</span>
                        <span class="text-muted-foreground"> registered</span>
                    </span>
                    @if (_almostFull)
                    {
                        <BadgeCn Class="text-xs text-destructive" Variant="BadgeVariant.Outline">@_spotsLeft spots left</BadgeCn>
                    }
                </div>

                <hr class="my-4 border-border" />

                @* Ticket tiers *@
                <div>
                    <p class="text-xs font-medium text-muted-foreground">SELECT TICKET</p>
                    <div class="mt-2 space-y-2">
                        @foreach (var tier in _product.Tiers)
                        {
                            var t = tier;
                            var featPreview = string.Join(" • ", t.Features[..Math.Min(2, t.Features.Length)]);
                            var moreText = t.Features.Length > 2 ? $" +{t.Features.Length - 2} more" : "";
                            <div class="flex items-start">
                                <input
                                    type="radio"
                                    id="@t.Id"
                                    name="ticket-tier"
                                    value="@t.Id"
                                    checked="@(_selectedTier == t.Id ? "checked" : null)"
                                    @onclick="@(() => _selectedTier = t.Id)"
                                    class="sr-only" />
                                <label
                                    class="@Cn.Merge("flex flex-1 cursor-pointer items-start justify-between rounded-lg border p-3 transition-colors hover:bg-muted/50", _selectedTier == t.Id ? "border-primary bg-muted/50" : "")"
                                    for="@t.Id">
                                    <div class="flex items-start gap-3">
                                        <div class="mt-0.5 h-4 w-4 shrink-0 rounded-full border border-primary flex items-center justify-center">
                                            @if (_selectedTier == t.Id)
                                            {
                                                <div class="h-2 w-2 rounded-full bg-primary"></div>
                                            }
                                        </div>
                                        <div>
                                            <p class="font-medium">@t.Name</p>
                                            <p class="text-xs text-muted-foreground">@featPreview@moreText</p>
                                        </div>
                                    </div>
                                    <p class="font-semibold tabular-nums">@(t.Price == 0 ? "Free" : $"${t.Price}")</p>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full" Disabled="@(_spotsLeft == 0)">
                    <LucideIconCn Name="monitor" Size="16" Class="mr-2 h-4 w-4" />
                    @(_selectedTierObj.Price == 0 ? "Register Free" : $"Register - ${_selectedTierObj.Price}")
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    <LucideIconCn Name="calendar-plus" Size="16" Class="mr-2 h-4 w-4" />
                    Add to Calendar
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record Speaker(string Name, string Role, string Avatar);
    private record TicketTier(string Id, string Name, int Price, string[] Features);
    private record Product(
        string Title,
        string Category,
        string Image,
        bool IsLive,
        string Date,
        string Time,
        string Timezone,
        string Duration,
        string Platform,
        Speaker[] Speakers,
        int Attendees,
        int MaxAttendees,
        TicketTier[] Tiers);

    private static readonly Product _product = new(
        "Design Systems at Scale: Building for the Future",
        "Design Conference",
        "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=400&q=80",
        true,
        "January 18, 2025",
        "10:00 AM",
        "PST",
        "3 hours",
        "Zoom Webinar",
        [
            new("Sarah Chen", "Design Lead, Figma", "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&q=80"),
            new("Marcus Johnson", "VP Design, Stripe", "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&q=80"),
            new("Elena Rodriguez", "Design Systems, Airbnb", "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100&q=80"),
        ],
        847,
        1000,
        [
            new("free", "Free", 0, ["Live access", "Q&A participation"]),
            new("standard", "Standard", 49, ["Live access", "Q&A participation", "Recording access", "Slides PDF"]),
            new("vip", "VIP", 149, ["Live access", "Q&A participation", "Recording access", "Slides PDF", "1-on-1 speaker session", "Certificate"]),
        ]);

    private string _selectedTier = "standard";

    private TicketTier _selectedTierObj => Array.Find(_product.Tiers, t => t.Id == _selectedTier) ?? _product.Tiers[1];
    private int _spotsLeft => _product.MaxAttendees - _product.Attendees;
    private bool _almostFull => _spotsLeft < 100;
}
