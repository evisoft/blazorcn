@* ============================================================
   Block: about-podcast-episodes
   Title: About Podcast Episodes
   Description: A company podcast section showing recent episodes with guest names and duration for about pages
   Long Description: Promote your company podcast with recent episode highlights. Displays episode titles, guest names, duration, and episode numbers to drive podcast subscriptions and showcase industry conversations.
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/about/about-podcast-episodes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-start gap-3">
                <div class="rounded-md bg-muted/50 p-2">
                    <LucideIconCn Name="mic" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <div>
                    <h2 class="text-xl font-semibold tracking-tight">The Build Podcast</h2>
                    <p class="mt-1 text-sm text-muted-foreground">
                        Conversations with builders, makers, and founders
                    </p>
                </div>
            </div>
        </div>

        <div class="p-6">
            <p class="text-sm text-muted-foreground">
                Weekly conversations exploring how teams build and scale products. New episodes every
                Thursday.
            </p>

            <div class="mt-6 space-y-3">
                @foreach (var episode in _episodes)
                {
                    <div class="flex items-start gap-3 rounded-md border bg-muted/50 p-4">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-10 shrink-0 rounded-full" aria-label="Play">
                            <LucideIconCn Name="play" Size="16" Class="size-4" />
                        </ButtonCn>

                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 font-mono text-xs">
                                    #@episode.Number
                                </BadgeCn>
                                <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                    <span>@episode.Duration</span>
                                </div>
                            </div>

                            <h3 class="mt-2 text-sm font-medium">@episode.Title</h3>
                            <p class="mt-1 text-xs text-muted-foreground">with @episode.Guest</p>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-6 rounded-md border bg-muted/50 p-4">
                <p class="text-sm font-medium">Subscribe</p>
                <p class="mt-1 text-sm text-muted-foreground">
                    Listen on Spotify, Apple Podcasts, Google Podcasts, or wherever you get your podcasts.
                </p>
                <div class="mt-3 flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                        Spotify
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                        Apple Podcasts
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                        RSS
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Episode(int Number, string Title, string Guest, string Duration);

    private readonly List<Episode> _episodes =
    [
        new(47, "Building Developer Tools That Developers Love", "Sarah Chen", "42 min"),
        new(46, "The State of Open Source in 2026", "Marcus Rodriguez", "38 min"),
        new(45, "Scaling Engineering Teams from 10 to 100", "Jessica Park", "51 min"),
        new(44, "Design Systems and Component Libraries", "Alex Thompson", "45 min"),
    ];
}
