@* ============================================================
   Block: about-journey-steps
   Title: AboutJourneySteps
   Description: A customer journey stepper block for React and Next.js with numbered step badges, vertical connecting lines, typical durations, key actions, alternating background accents, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-journey-steps.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between">
                <div>
                    <h2 class="text-sm font-medium">Customer Journey</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @(_steps.Length) stages from first touch to advocacy
                    </p>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500/70" />
                    <span class="text-[10px] text-muted-foreground">94% retention</span>
                </div>
            </div>
        </div>

        @* Steps *@
        <div class="px-4 py-3">
            @for (int i = 0; i < _steps.Length; i++)
            {
                var step = _steps[i];
                bool isLast = i == _steps.Length - 1;
                bool isEven = i % 2 == 0;

                <div class="flex gap-4">
                    @* Left: number + connecting line *@
                    <div class="flex flex-col items-center">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full border bg-foreground text-background">
                            <span class="font-mono text-xs font-medium">@step.Number</span>
                        </div>
                        @if (!isLast)
                        {
                            <div class="my-1 w-px flex-1 bg-border"></div>
                        }
                    </div>

                    @* Right: step content *@
                    <div class="@Cn.Merge("mb-3 flex-1 rounded-md px-3 py-2.5", isEven ? "bg-muted/30" : "")">
                        @* Title + duration *@
                        <div class="flex items-center justify-between gap-2">
                            <h3 class="text-sm font-medium">@step.Title</h3>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 text-[10px] font-normal">
                                <LucideIconCn Name="clock" Size="10" Class="size-2.5" />
                                @step.Duration
                            </BadgeCn>
                        </div>

                        @* Description *@
                        <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                            @step.Description
                        </p>

                        @* Detail *@
                        <p class="mt-2 text-xs leading-relaxed text-muted-foreground/70">
                            @step.Detail
                        </p>

                        @* Key action *@
                        <div class="mt-2.5 inline-flex items-center gap-1.5 rounded bg-muted/60 px-2 py-1">
                            <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground/50" />
                            <span class="text-[10px] font-medium text-muted-foreground">
                                @step.KeyAction
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center gap-2 border-t px-4 py-2.5">
            <span class="text-xs tabular-nums text-muted-foreground">@(_steps.Length) stages</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span class="text-xs text-muted-foreground">~6 months end-to-end</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span class="text-xs text-muted-foreground">142% net revenue retention</span>
        </div>
    </div>
</section>

@code {
    private record Step(string Id, int Number, string Title, string Description, string Duration, string KeyAction, string Detail);

    private static readonly Step[] _steps =
    [
        new("discovery", 1, "Discovery",
            "Prospects find us through developer content, open-source contributions, or peer recommendations.",
            "1-2 weeks", "Sign up for free tier",
            "Most customers discover us through a blog post or conference talk. The average prospect visits 4.2 pages before signing up. Our docs-first approach means developers can evaluate the product before talking to anyone."),
        new("evaluation", 2, "Evaluation",
            "Teams explore the product with a free workspace, run proof-of-concept projects, and assess fit.",
            "2-4 weeks", "Create first project",
            "Evaluation teams typically involve 2-3 developers and 1 decision-maker. We provide sandbox environments with sample data pre-loaded. 68% of evaluators connect their first integration within 48 hours."),
        new("onboarding", 3, "Onboarding",
            "Dedicated onboarding specialist helps migrate data, configure integrations, and train the team.",
            "1-2 weeks", "Complete setup checklist",
            "Every customer gets a personalized onboarding plan with a 12-step checklist. We handle data migration for datasets up to 10M records. Average time to first production deploy: 4.5 days."),
        new("adoption", 4, "Adoption",
            "Teams integrate the product into daily workflows and establish internal best practices.",
            "1-3 months", "Reach 80% team adoption",
            "We track adoption through weekly active usage per seat. Customer success managers conduct bi-weekly check-ins during this phase. Teams that hit 80% adoption within 60 days have 94% retention at 12 months."),
        new("expansion", 5, "Expansion",
            "Usage grows across departments. Teams request additional seats, features, and integrations.",
            "3-6 months", "Add second department",
            "The average customer expands from 1 team to 3 within the first year. Expansion is driven by internal word-of-mouth — teams see what others built and want the same. Net revenue retention: 142%."),
        new("advocacy", 6, "Advocacy",
            "Power users become champions who contribute to the community and refer new customers.",
            "Ongoing", "Publish a case study",
            "Our referral program generates 23% of new pipeline. Advocates speak at community events, contribute to our open-source repos, and participate in our customer advisory board. NPS from advocates: 78."),
    ];
}
