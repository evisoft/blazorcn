@* ============================================================
   Block: about-careers-cta
   Title: About Careers Cta
   Description: Careers CTA section with open positions teaser for React hiring pages
   Long Description: Company statistics and key metrics in a dense, scannable grid format
   Dependencies: ButtonCn
   Source: original/blocks/about/about-careers-cta.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid gap-8 lg:grid-cols-2">
            @* Left - Content *@
            <div class="border-b px-6 py-5 lg:border-b-0 lg:border-r">
                <h2 class="mb-3 text-xl font-semibold tracking-tight">
                    Help us build the future of work
                </h2>

                <p class="mb-5 text-sm text-muted-foreground leading-relaxed">
                    We're a team of 45 across 12 countries, united by a shared mission to make work
                    simpler. We value impact over hours, autonomy over micromanagement, and growth over
                    comfort zones.
                </p>

                <div class="mb-5 space-y-3">
                    <div class="flex items-center gap-3 text-sm">
                        <LucideIconCn Name="users" Size="16" Class="h-4 w-4 text-muted-foreground" />
                        <span>Remote-first with optional co-working</span>
                    </div>
                    <div class="flex items-center gap-3 text-sm">
                        <LucideIconCn Name="briefcase" Size="16" Class="h-4 w-4 text-muted-foreground" />
                        <span>Competitive equity packages</span>
                    </div>
                    <div class="flex items-center gap-3 text-sm">
                        <LucideIconCn Name="map-pin" Size="16" Class="h-4 w-4 text-muted-foreground" />
                        <span>Quarterly team retreats worldwide</span>
                    </div>
                </div>

                <ButtonCn Class="gap-2">
                    View All Positions
                    <LucideIconCn Name="arrow-right" Size="16" Class="h-4 w-4" />
                </ButtonCn>
            </div>

            @* Right - Open roles *@
            <div class="px-6 py-5">
                <h3 class="mb-4 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Featured Openings
                </h3>

                <div class="divide-y">
                    @foreach (var role in _openRoles)
                    {
                        <div class="flex items-center justify-between py-3 first:pt-0 last:pb-0">
                            <div>
                                <h4 class="text-sm font-medium">@role.Title</h4>
                                <p class="text-sm text-muted-foreground">
                                    @role.Location &middot; @role.Type
                                </p>
                            </div>
                            <LucideIconCn Name="arrow-right" Size="16" Class="h-4 w-4 text-muted-foreground" />
                        </div>
                    }
                </div>

                <p class="mt-4 text-center text-sm text-muted-foreground">
                    + 8 more positions available
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record OpenRole(string Title, string Location, string Type);

    private readonly List<OpenRole> _openRoles =
    [
        new("Senior Frontend Engineer", "Remote", "Full-time"),
        new("Product Designer", "Remote", "Full-time"),
        new("Customer Success Manager", "New York", "Full-time"),
    ];
}
