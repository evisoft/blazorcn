@* ============================================================
   Block: about-team-mosaic
   Title: About Team Mosaic
   Description: A visual team size display showing a mosaic of employee avatars with a team count message.
   Long Description: Showcase team scale with visual impact. This component displays a dense grid of team member avatars that conveys organizational size and growth at a glance, perfect for career pages and investor decks.
   Dependencies: AvatarCn, ButtonCn
   Source: original/blocks/about/about-team-mosaic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-6 py-8 text-center">
            <h2 class="font-semibold text-xl tracking-tight">
                Join our team of 150+ talented people
            </h2>
            <p class="mt-2 text-muted-foreground text-sm">
                We're building the future of developer tools with passionate engineers, designers, and
                operators from around the world
            </p>
        </div>

        <div class="border-t px-6 py-8">
            <div class="grid grid-cols-10 gap-3">
                @foreach (var member in _teamMembers)
                {
                    <AvatarCn Class="size-10">
                        <AvatarFallbackCn Class="bg-muted text-xs">@member</AvatarFallbackCn>
                    </AvatarCn>
                }
            </div>
        </div>

        <div class="border-t px-6 py-5">
            <div class="flex items-center justify-center gap-4">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                    <span>View open positions</span>
                    <LucideIconCn Name="arrow-right" Size="16" Class="ml-2 size-4" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm">
                    <span>Meet the team</span>
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private readonly string[] _teamMembers =
    [
        "SC", "MR", "EW", "DP", "LK", "JS", "AM", "KT", "RH", "NP",
        "BW", "CF", "TL", "VG", "ZM", "HS", "IJ", "QR", "XY", "OB",
        "UA", "PD", "WK", "YC", "GN", "FE", "JQ", "AV", "SZ", "DR",
    ];
}
