@* ============================================================
   Block: about-architecture-overview
   Title: About Architecture Overview
   Description: High-level system architecture showing technology stack organized by infrastructure layers
   Long Description: Communicate technical credibility through architecture transparency. This component displays your system architecture at a high level, showing prospects and technical evaluators the quality of your technical foundation.
   Dependencies: None
   Source: original/blocks/about/about-architecture-overview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">System Architecture</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Built on modern, scalable infrastructure
            </p>
        </div>

        <div class="p-6">
            <div class="space-y-0">
                @for (var i = 0; i < _layers.Count; i++)
                {
                    var layer = _layers[i];
                    var isLast = i == _layers.Count - 1;
                    <div class="@(isLast ? "" : "border-b")">
                        <div class="flex items-start gap-4 px-6 py-5">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-baseline gap-3">
                                    <h3 class="text-sm font-medium">@layer.Layer</h3>
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var tech in layer.Technologies)
                                        {
                                            <span class="rounded-md bg-muted/50 px-2 py-0.5 font-mono text-xs">
                                                @tech
                                            </span>
                                        }
                                    </div>
                                </div>
                                <p class="mt-2 text-sm text-muted-foreground">@layer.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-6 py-4">
            <p class="text-sm text-muted-foreground">
                All components monitored 24/7 with automated alerts. Infrastructure changes reviewed and
                deployed via GitOps workflow. Security patches applied within 24 hours of disclosure.
            </p>
        </div>
    </div>
</section>

@code {
    private record ArchLayer(string Layer, string[] Technologies, string Description);

    private readonly List<ArchLayer> _layers =
    [
        new("CDN & Edge", ["Cloudflare", "Vercel Edge", "Redis Cache"],
            "Global edge network with 200+ locations. Static assets cached at edge. API responses cached with intelligent invalidation."),
        new("Frontend", ["Next.js 15", "React 19", "TypeScript", "Tailwind CSS"],
            "Server-side rendered React application. Optimistic UI updates. Progressive enhancement for core features."),
        new("API Layer", ["Node.js", "tRPC", "Zod", "Rate Limiting"],
            "Type-safe API with end-to-end TypeScript. Request validation and sanitization. Per-user and per-IP rate limiting."),
        new("Services", ["Workers", "Queues", "Pub/Sub", "Webhooks"],
            "Asynchronous job processing. Background workers for heavy tasks. Event-driven architecture for real-time updates."),
        new("Database", ["PostgreSQL", "Prisma", "Read Replicas", "Backups"],
            "Primary PostgreSQL database with read replicas. Automated backups every 6 hours. Point-in-time recovery for 7 days."),
        new("Infrastructure", ["AWS", "Kubernetes", "Terraform", "Datadog"],
            "Container orchestration with Kubernetes. Infrastructure as code via Terraform. Real-time monitoring and alerting."),
    ];
}
