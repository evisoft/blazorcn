@* ============================================================
   Block: about-transparency-report
   Title: About Transparency Report
   Description: An annual transparency report showcasing key operational metrics like data requests, uptime, security incidents, and response times.
   Long Description: Build trust through radical transparency. This about block displays annual transparency metrics including data requests, content moderation, uptime, security incidents, and customer support response times.
   Dependencies: None
   Source: original/blocks/about/about-transparency-report.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center gap-2">
                <h2 class="font-semibold text-xl tracking-tight">Transparency Report</h2>
                <span class="rounded-md bg-muted/50 px-2 py-1 font-medium text-muted-foreground text-xs">
                    2024
                </span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Annual metrics on data requests, security, and operational transparency
            </p>
        </div>
        <div class="grid gap-4 p-6 sm:grid-cols-2">
            @foreach (var metric in _metrics)
            {
                <div class="rounded-md border bg-muted/50 p-4">
                    <div class="flex items-start gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-background">
                            <LucideIconCn Name="shield-check" Size="20" Class="size-5 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                                @metric.Label
                            </p>
                            <p class="mt-1 font-semibold text-2xl tabular-nums">@metric.Value</p>
                            <p class="mt-2 text-muted-foreground text-sm">@metric.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MetricItem(string Label, string Value, string Description);

    private readonly List<MetricItem> _metrics =
    [
        new("Data Requests Received", "127",
            "Government and law enforcement data requests, 89% complied with valid legal orders"),
        new("Content Removed", "1,843",
            "Pieces of content removed for policy violations, primarily spam and abuse"),
        new("Platform Uptime", "99.97%",
            "System availability excluding scheduled maintenance windows"),
        new("Security Incidents", "0",
            "Zero data breaches or unauthorized access incidents reported"),
        new("Average Response Time", "2.3 hours",
            "Median time to first response for customer support inquiries"),
        new("Transparency Score", "A+",
            "Rated by Electronic Frontier Foundation for disclosure practices"),
    ];
}
