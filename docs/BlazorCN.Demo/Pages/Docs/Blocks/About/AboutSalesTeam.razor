@* ============================================================
   Block: about-sales-team
   Title: About Sales Team
   Description: Meet the sales team with regional coverage and direct booking options for personalized customer outreach.
   Long Description: A professional sales team showcase that connects prospects with the right representative based on region. Features direct booking links for seamless lead qualification.
   Dependencies: AvatarCn, ButtonCn
   Source: original/blocks/about/about-sales-team.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Meet our sales team</h2>
            <p class="mt-2 text-sm text-muted-foreground">
                Connect with a sales representative in your region for personalized guidance and pricing
                information.
            </p>
        </div>

        <div class="p-6">
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var rep in _salesTeam)
                {
                    <div class="overflow-hidden rounded-md border bg-card">
                        <div class="p-4">
                            <div class="flex items-start gap-3">
                                <AvatarCn Class="size-12">
                                    <AvatarFallbackCn Class="text-sm">@rep.Initials</AvatarFallbackCn>
                                </AvatarCn>
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium">@rep.Name</div>
                                    <div class="mt-0.5 text-xs text-muted-foreground">@rep.Role</div>
                                    <div class="mt-2 inline-flex items-center rounded bg-muted/50 px-2 py-1 text-xs text-muted-foreground">
                                        @rep.Region
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 w-full gap-2">
                                    <LucideIconCn Name="calendar" Size="14" Class="size-3.5" />
                                    Book a call
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-6 py-4">
            <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Not sure who to contact?</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8">
                    Contact general sales
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record SalesRep(string Name, string Role, string Region, string Initials);

    private readonly List<SalesRep> _salesTeam =
    [
        new("Sarah Mitchell", "Enterprise Sales", "North America", "SM"),
        new("James Chen", "Growth Sales", "APAC", "JC"),
        new("Emma Rodriguez", "Strategic Accounts", "EMEA", "ER"),
    ];
}
