@* ============================================================
   Block: about-competitor-table
   Title: About Competitor Table
   Description: Feature comparison table showing your product versus competitors with clear visual indicators.
   Long Description: A competitive advantage section that clearly demonstrates your product's superior features. Uses clean checkmarks and X marks for quick scanning and decision-making.
   Dependencies: None
   Source: original/blocks/about/about-competitor-table.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">How we compare</h2>
            <p class="mt-2 text-sm text-muted-foreground">
                See how our features stack up against leading alternatives in the market.
            </p>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b bg-muted/50">
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted-foreground">
                            Feature
                        </th>
                        <th class="px-6 py-3 text-center text-xs font-medium uppercase tracking-wider text-muted-foreground">
                            Us
                        </th>
                        <th class="px-6 py-3 text-center text-xs font-medium uppercase tracking-wider text-muted-foreground">
                            Competitor A
                        </th>
                        <th class="px-6 py-3 text-center text-xs font-medium uppercase tracking-wider text-muted-foreground">
                            Competitor B
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _features.Count; i++)
                    {
                        var feature = _features[i];
                        <tr class="@(i != _features.Count - 1 ? "border-b" : "")">
                            <td class="px-6 py-4 text-sm font-medium">@feature.Name</td>
                            <td class="px-6 py-4 text-center">
                                @if (feature.Us)
                                {
                                    <LucideIconCn Name="check" Size="20" Class="mx-auto size-5 text-emerald-600" />
                                }
                                else
                                {
                                    <LucideIconCn Name="x" Size="20" Class="mx-auto size-5 text-muted-foreground/40" />
                                }
                            </td>
                            <td class="px-6 py-4 text-center">
                                @if (feature.CompetitorA)
                                {
                                    <LucideIconCn Name="check" Size="20" Class="mx-auto size-5 text-emerald-600" />
                                }
                                else
                                {
                                    <LucideIconCn Name="x" Size="20" Class="mx-auto size-5 text-muted-foreground/40" />
                                }
                            </td>
                            <td class="px-6 py-4 text-center">
                                @if (feature.CompetitorB)
                                {
                                    <LucideIconCn Name="check" Size="20" Class="mx-auto size-5 text-emerald-600" />
                                }
                                else
                                {
                                    <LucideIconCn Name="x" Size="20" Class="mx-auto size-5 text-muted-foreground/40" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="border-t px-6 py-4 text-center">
            <p class="text-xs text-muted-foreground">
                Comparison accurate as of March 2026. Feature availability may vary by plan.
            </p>
        </div>
    </div>
</section>

@code {
    private record FeatureItem(string Name, bool Us, bool CompetitorA, bool CompetitorB);

    private readonly List<FeatureItem> _features =
    [
        new("Advanced analytics dashboard", true, true, false),
        new("Real-time collaboration", true, false, true),
        new("API access on all plans", true, false, false),
        new("White-label support", true, true, false),
        new("Unlimited team members", true, false, false),
        new("24/7 customer support", true, true, true),
    ];
}
