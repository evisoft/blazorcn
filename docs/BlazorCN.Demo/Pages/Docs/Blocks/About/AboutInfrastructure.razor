@* ============================================================
   Block: about-infrastructure
   Title: AboutInfrastructure
   Description: A split-panel infrastructure stack block for React and Next.js with interactive layer selection, vertical connecting lines, provider specs grid, redundancy badges, uptime stats, and AnimatePresence content transitions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-infrastructure.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-5 py-3">
            <div>
                <h2 class="text-sm font-medium">Infrastructure Stack</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_layers.Length layers powering the platform
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-emerald-500/70" />
                <span class="text-[10px] text-muted-foreground">SOC 2 Type II</span>
            </div>
        </div>

        @* Split Panel *@
        <div class="flex min-h-[460px]">

            @* Left panel — vertical stack with connecting lines *@
            <div class="w-52 shrink-0 border-r bg-muted/20 py-4">
                <div class="flex flex-col items-center">
                    @foreach (var (layer, index) in _layers.Select((l, i) => (l, i)))
                    {
                        var isActive = _activeLayer == layer.Id;
                        var isLast = index == _layers.Length - 1;

                        <div class="flex flex-col items-center">
                            @if (index > 0)
                            {
                                <div class="h-3 w-px bg-border"></div>
                            }

                            <button
                                type="button"
                                @onclick="@(() => _activeLayer = layer.Id)"
                                aria-current="@(isActive ? "true" : null)"
                                class="@Cn.Merge("flex w-40 items-center gap-3 rounded-md px-3 py-2.5 text-left transition-colors", isActive ? "bg-background shadow-sm ring-1 ring-border" : "hover:bg-muted/50")"
                            >
                                <div class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-md border", isActive ? "bg-foreground text-background" : "bg-muted/40")">
                                    <LucideIconCn Name="@layer.IconName" Size="14" Class="@Cn.Merge("size-3.5", isActive ? "" : "text-muted-foreground/60")" />
                                </div>
                                <div class="min-w-0">
                                    <span class="@(isActive ? "text-xs font-medium text-foreground" : "text-xs text-muted-foreground")">
                                        @layer.ShortName
                                    </span>
                                    <p class="truncate text-[10px] text-muted-foreground/60">
                                        @layer.Provider.Split(' ')[0]
                                    </p>
                                </div>
                            </button>

                            @if (!isLast)
                            {
                                <div class="h-3 w-px bg-border"></div>
                            }
                        </div>
                    }
                </div>

                <div class="mt-4 flex items-center justify-center gap-1.5 px-4">
                    <LucideIconCn Name="cloud" Size="12" Class="size-3 text-muted-foreground/40" />
                    <span class="text-[10px] text-muted-foreground/50">AWS + Cloudflare</span>
                </div>
            </div>

            @* Right panel — layer details *@
            <div class="flex-1 overflow-y-auto">
                @{
                    var selected = Array.Find(_layers, l => l.Id == _activeLayer) ?? _layers[0];
                }
                <div class="p-5">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <h3 class="text-sm font-medium">@selected.Name</h3>
                            <p class="mt-0.5 text-xs text-muted-foreground">@selected.Provider</p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("shrink-0 text-[10px] font-normal", RedundancyColor(selected.Redundancy))">
                            @selected.Redundancy.Replace("-", " ")
                        </BadgeCn>
                    </div>

                    <p class="mt-2 font-mono text-[10px] text-muted-foreground/60">
                        @selected.Region
                    </p>

                    <div class="mt-4 inline-flex items-baseline gap-2 rounded-md bg-muted/50 px-3 py-2">
                        <span class="text-2xl font-semibold tabular-nums tracking-tight">
                            @selected.UptimePercent%
                        </span>
                        <span class="text-[10px] text-muted-foreground">
                            uptime (@selected.UptimeSla SLA)
                        </span>
                    </div>

                    <SeparatorCn Class="my-4" />

                    <div class="grid grid-cols-2 gap-3">
                        @foreach (var spec in selected.Specs)
                        {
                            <div class="rounded-md border bg-muted/20 px-3 py-2">
                                <span class="text-[10px] text-muted-foreground">@spec.Label</span>
                                <p class="mt-0.5 font-mono text-xs font-medium">@spec.Value</p>
                            </div>
                        }
                    </div>

                    <SeparatorCn Class="my-4" />

                    <p class="text-sm leading-relaxed text-muted-foreground">
                        @selected.Description
                    </p>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center gap-2 border-t px-5 py-2.5">
            <span class="text-xs tabular-nums text-muted-foreground">@_layers.Length layers</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span class="text-xs text-muted-foreground">3 regions</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span class="text-xs text-muted-foreground">99.97% composite uptime</span>
        </div>
    </div>
</section>

@code {
    private record Spec(string Label, string Value);

    private record Layer(
        string Id,
        string Name,
        string ShortName,
        string IconName,
        string Provider,
        string Region,
        Spec[] Specs,
        string Redundancy,
        string UptimePercent,
        string UptimeSla,
        string Description);

    private string _activeLayer = "cdn";

    private static string RedundancyColor(string redundancy) => redundancy switch
    {
        "active-active" => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        "active-passive" => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        "multi-region"  => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        "replicated"    => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        _               => ""
    };

    private static readonly Layer[] _layers =
    [
        new("cdn", "CDN & Edge Network", "CDN", "globe",
            "Cloudflare Enterprise", "200+ PoPs globally",
            new Spec[] { new("Cache hit ratio", "94.2%"), new("Avg edge latency", "12ms"), new("DDoS mitigation", "Layer 3-7"), new("TLS termination", "Edge-level") },
            "multi-region", "99.999", "5 nines",
            "All static assets and API responses cached at edge with intelligent purging. Anycast routing ensures users hit the nearest PoP. Workers handle geo-routing and A/B test assignment before requests reach origin."),

        new("lb", "Load Balancer", "LB", "network",
            "AWS ALB + NLB", "us-east-1, eu-west-1, ap-southeast-1",
            new Spec[] { new("Health check interval", "5s"), new("Draining timeout", "30s"), new("Algorithm", "Least connections"), new("SSL policy", "TLS 1.3 only") },
            "active-active", "99.99", "4 nines",
            "Application and network load balancers run in active-active across three availability zones. Automatic failover within 15 seconds. Connection draining ensures zero-downtime deploys with graceful shutdown."),

        new("app", "Application Servers", "App", "server",
            "AWS EKS (Kubernetes)", "3 regions, 9 AZs",
            new Spec[] { new("Pod count", "48 replicas"), new("CPU per pod", "2 vCPU"), new("Memory per pod", "4 GiB"), new("Auto-scale trigger", "70% CPU") },
            "multi-region", "99.98", "3.5 nines",
            "Containerized Node.js application running on Kubernetes with horizontal pod autoscaling. Blue-green deployments with automated canary analysis. Each region maintains independent capacity to handle full global traffic."),

        new("db", "Database Cluster", "DB", "database",
            "AWS RDS PostgreSQL 16", "Multi-AZ with read replicas",
            new Spec[] { new("Instance class", "db.r6g.2xlarge"), new("Read replicas", "3 per region"), new("Backup retention", "30 days PITR"), new("Connection pooling", "PgBouncer") },
            "replicated", "99.97", "3 nines",
            "Primary PostgreSQL cluster with synchronous replication to standby. Read replicas handle analytics and reporting queries. Automated failover completes within 60 seconds. Daily snapshots plus continuous WAL archiving for point-in-time recovery."),

        new("storage", "Object Storage", "Storage", "hard-drive",
            "AWS S3 + CloudFront", "Cross-region replication",
            new Spec[] { new("Storage class", "S3 Intelligent-Tiering"), new("Encryption", "AES-256 SSE-KMS"), new("Versioning", "Enabled (90-day)"), new("Lifecycle rules", "Archive at 180d") },
            "multi-region", "99.999", "5 nines",
            "User uploads, generated reports, and backup archives stored with cross-region replication. Intelligent tiering automatically moves infrequently accessed objects to cheaper storage classes. All objects encrypted at rest with customer-managed KMS keys."),
    ];
}
