@* ============================================================
   Block: about-employee-spotlights
   Title: About Employee Spotlights
   Description: Featured employee stories with quotes about working at the company, showcasing culture and employee experience.
   Long Description: Bring your culture to life through employee voices. This component highlights team members with authentic quotes that give candidates and stakeholders insight into your company's day-to-day reality.
   Dependencies: AvatarCn
   Source: original/blocks/about/about-employee-spotlights.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Employee Spotlights</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Hear from our team about what it's like to work here
            </p>
        </div>

        <div class="divide-y">
            @foreach (var employee in _employees)
            {
                <div class="px-6 py-5">
                    <div class="flex items-start gap-4">
                        <AvatarCn Class="size-12 shrink-0">
                            <AvatarFallbackCn Class="bg-muted text-sm">@employee.Initials</AvatarFallbackCn>
                        </AvatarCn>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-start gap-2">
                                <div class="min-w-0 flex-1">
                                    <h3 class="font-medium text-sm">@employee.Name</h3>
                                    <p class="text-muted-foreground text-sm">@employee.Role</p>
                                    <p class="text-muted-foreground text-xs">@employee.Tenure</p>
                                </div>
                                <LucideIconCn Name="quote" Size="20" Class="size-5 shrink-0 text-muted-foreground/40" />
                            </div>

                            <blockquote class="mt-3 text-muted-foreground text-sm leading-relaxed">
                                "@employee.Quote"
                            </blockquote>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-6 py-4">
            <p class="text-muted-foreground text-xs">
                Want to share your own story? We feature different team members each quarter. Reach out
                to the People team to participate.
            </p>
        </div>
    </div>
</section>

@code {
    private record Employee(string Name, string Role, string Tenure, string Initials, string Quote);

    private readonly List<Employee> _employees =
    [
        new("Alex Kim", "Senior Software Engineer", "2 years at company", "AK",
            "I've shipped more impactful features here in 18 months than I did in 4 years at my previous company. The autonomy and trust given to engineers is unmatched. We own features end-to-end, from design to production monitoring."),
        new("Priya Sharma", "Product Designer", "1 year at company", "PS",
            "Coming from a big tech company, I was worried about resources and tooling. Instead, I found a design team that's deeply embedded in engineering sprints. We prototype in Figma on Monday and see it in production by Friday. The pace is energizing."),
        new("Jordan Taylor", "Engineering Manager", "3 years at company", "JT",
            "What keeps me here is the people. My team has grown from 3 to 15 engineers, and we've maintained the same collaborative, no-ego culture. We do weekly architecture reviews where junior engineers regularly challenge senior decisions. It's how great ideas surface."),
    ];
}
