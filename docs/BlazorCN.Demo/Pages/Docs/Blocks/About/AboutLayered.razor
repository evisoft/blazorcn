@* ============================================================
   Block: about-layered
   Title: AboutLayered
   Description: A layered about section block for React and Next.js with stacked mission statement, value pills, numbered approach list, and proof stats row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-layered.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Section 1: Mission *@
        <div class="px-6 py-8 text-center">
            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Our mission
            </span>
            <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-foreground">
                @_missionText
            </p>
        </div>

        <SeparatorCn />

        @* Section 2: Values as pills *@
        <div class="flex flex-wrap items-center justify-center gap-2 px-6 py-6">
            <span class="mr-2 text-xs text-muted-foreground">We value:</span>
            @foreach (var value in _values)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"border-0 font-normal {GetValueColorClass(value.Color)}")">
                    @value.Label
                </BadgeCn>
            }
        </div>

        <SeparatorCn />

        @* Section 3: Numbered approach *@
        <div class="px-6 py-6">
            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                How we work
            </span>
            <div class="mt-4 space-y-4">
                @foreach (var approach in _approaches)
                {
                    <div class="flex gap-4">
                        <span class="mt-0.5 shrink-0 font-mono text-xs text-muted-foreground">
                            @approach.Step
                        </span>
                        <div>
                            <h3 class="text-sm font-medium">@approach.Title</h3>
                            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                                @approach.Description
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <SeparatorCn />

        @* Section 4: Proof stats row *@
        <div class="grid grid-cols-2 gap-px bg-muted/50 sm:grid-cols-4">
            @foreach (var point in _proofPoints)
            {
                <div class="bg-card px-4 py-5 text-center">
                    <div class="text-2xl font-semibold tabular-nums">@point.Metric</div>
                    <div class="mt-1 text-xs text-muted-foreground">@point.Label</div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private const string _missionText =
        "We exist to make complex infrastructure invisible. Every engineer deserves tools that stay out of the way and let them focus on what matters: building products that solve real problems for real people.";

    private record ValueItem(string Id, string Label, string Color);
    private record ApproachItem(string Id, string Step, string Title, string Description);
    private record ProofPointItem(string Id, string Metric, string Label);

    private static readonly ValueItem[] _values =
    [
        new("v1", "Clarity over cleverness", "blue"),
        new("v2", "Ship, then iterate", "emerald"),
        new("v3", "Defaults matter", "amber"),
    ];

    private static readonly ApproachItem[] _approaches =
    [
        new("a1", "01", "Listen to the friction",
            "We start every project by mapping where engineers lose time. Not feature requests — actual workflow pain points observed in production environments."),
        new("a2", "02", "Prototype in the open",
            "Working prototypes ship to internal dogfooders within 72 hours. We test with real codebases, not contrived demos."),
        new("a3", "03", "Measure what matters",
            "Success is time-to-deploy dropping, not feature count rising. Every release is measured against the workflows it was designed to improve."),
        new("a4", "04", "Document first, code second",
            "If we cannot explain it in a paragraph, we do not build it. Documentation is the design artifact, not an afterthought."),
    ];

    private static readonly ProofPointItem[] _proofPoints =
    [
        new("p1", "4,200+", "Teams using our tools"),
        new("p2", "99.97%", "Uptime since 2022"),
        new("p3", "18ms", "Median API latency"),
        new("p4", "2.3M", "Deploys processed"),
    ];

    private static string GetValueColorClass(string color) => color switch
    {
        "emerald" => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        "blue"    => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        "amber"   => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        _         => string.Empty,
    };
}
