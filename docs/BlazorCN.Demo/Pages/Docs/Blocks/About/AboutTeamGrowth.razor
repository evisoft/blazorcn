@* ============================================================
   Block: about-team-growth
   Title: About Team Growth
   Description: Team size growth visualization using simple bar chart showing employee count over time.
   Long Description: Visualize your growth trajectory. This component shows team expansion over time with a clean bar chart that demonstrates momentum and scale to investors, candidates, and partners.
   Dependencies: None
   Source: original/blocks/about/about-team-growth.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Team Growth</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                How our team has expanded over the past 6 years
            </p>
        </div>

        <div class="px-6 py-8">
            <div class="space-y-6">
                @foreach (var data in _growthData)
                {
                    var percentage = (int)((double)data.Employees / _maxEmployees * 100);
                    <div class="space-y-2">
                        <div class="flex items-baseline justify-between">
                            <span class="font-medium text-sm">@data.Year</span>
                            <span class="font-semibold tabular-nums text-sm">
                                @data.Employees employees
                            </span>
                        </div>
                        <div class="h-8 w-full overflow-hidden rounded-md bg-muted">
                            <div class="h-full bg-foreground transition-all duration-500"
                                 style="@($"width: {percentage}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t bg-muted/50 px-6 py-4">
            <div class="flex items-center justify-between text-xs">
                <p class="text-muted-foreground">21x growth since founding in 2020</p>
                <p class="text-muted-foreground">Currently hiring across 8 departments</p>
            </div>
        </div>
    </div>
</section>

@code {
    private record GrowthData(string Year, int Employees);

    private readonly List<GrowthData> _growthData =
    [
        new("2020", 12),
        new("2021", 28),
        new("2022", 65),
        new("2023", 118),
        new("2024", 187),
        new("2025", 256),
    ];

    private int _maxEmployees => _growthData.Max(d => d.Employees);
}
