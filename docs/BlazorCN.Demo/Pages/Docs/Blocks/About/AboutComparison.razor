@* ============================================================
   Block: about-comparison
   Title: About Comparison
   Description: Side-by-side before/after comparison section for React product pages
   Long Description: Company DNA and founding principles section for React startup about pages
   Dependencies: None
   Source: original/blocks/about/about-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Life before vs. after</h2>
        </div>

        <div class="grid sm:grid-cols-2">
            @* Before *@
            <div class="border-b px-6 py-5 sm:border-b-0 sm:border-r">
                <p class="mb-4 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Before
                </p>
                <ul class="space-y-3">
                    @foreach (var item in _before)
                    {
                        <li class="flex gap-3 text-sm">
                            <LucideIconCn Name="x" Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                            <span class="text-muted-foreground">@item</span>
                        </li>
                    }
                </ul>
            </div>

            @* After *@
            <div class="px-6 py-5">
                <p class="mb-4 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    After
                </p>
                <ul class="space-y-3">
                    @foreach (var item in _after)
                    {
                        <li class="flex gap-3 text-sm">
                            <LucideIconCn Name="check" Size="16" Class="h-4 w-4 shrink-0 text-emerald-500" />
                            <span>@item</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</section>

@code {
    private readonly string[] _before =
    [
        "Hours wasted on manual data entry",
        "Scattered tools and siloed teams",
        "Decisions based on gut feeling",
        "Slow, painful deployment process",
    ];

    private readonly string[] _after =
    [
        "Automated workflows save 10+ hrs/week",
        "One platform, complete visibility",
        "Real-time data drives every decision",
        "Deploy in minutes, not days",
    ];
}
