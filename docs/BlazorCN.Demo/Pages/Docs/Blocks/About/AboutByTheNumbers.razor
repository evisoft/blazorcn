@* ============================================================
   Block: about-by-the-numbers
   Title: About By The Numbers
   Description: Company statistics and key metrics in a dense, scannable grid format
   Long Description: Showcase company credibility through numbers. This component displays key company metrics in a dense, scannable format that quickly communicates scale, reliability, and customer satisfaction without overwhelming detail.
   Dependencies: None
   Source: original/blocks/about/about-by-the-numbers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">By The Numbers</h2>
            <p class="mt-1 text-sm text-muted-foreground">Company at a glance</p>
        </div>

        <div class="p-6">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
                @foreach (var stat in _stats)
                {
                    <div class="rounded-md border p-4">
                        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                            @stat.Label
                        </p>
                        <div class="mt-2 flex items-baseline gap-1">
                            <span class="text-2xl font-semibold tabular-nums">@stat.Value</span>
                            @if (!string.IsNullOrEmpty(stat.Suffix))
                            {
                                <span class="text-xs text-muted-foreground">@stat.Suffix</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-6 py-4">
            <p class="text-sm text-muted-foreground">
                All metrics updated monthly. Customer count includes active paid and free tier users.
                Uptime calculated monthly excluding scheduled maintenance windows.
            </p>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, string Value, string? Suffix = null);

    private readonly List<StatItem> _stats =
    [
        new("Founded", "2019"),
        new("Team Size", "47", "people"),
        new("Customers", "12,000", "companies"),
        new("Countries", "89"),
        new("Uptime", "99.99", "%"),
        new("Avg Response", "47", "minutes"),
        new("NPS Score", "72"),
        new("G2 Rating", "4.8", "/ 5.0"),
        new("Funding", "$15", "M"),
        new("API Requests", "2.4", "B/month"),
    ];
}
