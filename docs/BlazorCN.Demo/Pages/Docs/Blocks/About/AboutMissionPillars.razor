@* ============================================================
   Block: about-mission-pillars
   Title: About Mission Pillars
   Description: Mission statement section with three supporting pillars for React purpose-driven about pages
   Long Description: Mission statement section with founder quote and avatar for React startup about pages
   Dependencies: ButtonCn
   Source: original/blocks/about/about-mission-pillars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Mission statement *@
        <div class="border-b px-6 py-5">
            <h2 class="mb-2 text-xl font-semibold tracking-tight">
                To give every team the tools to do their best work
            </h2>
            <p class="text-sm text-muted-foreground">
                We believe that when teams have the right tools, they don't just work better — they feel
                better. That's the future we're building.
            </p>
        </div>

        @* Pillars *@
        <div class="border-b px-6 py-5">
            <div class="grid gap-6 sm:grid-cols-3">
                @foreach (var pillar in _pillars)
                {
                    <div class="text-center">
                        <div class="mx-auto mb-3 flex size-10 items-center justify-center rounded-full border">
                            <LucideIconCn Name="@pillar.Icon" Size="20" Class="size-5 text-muted-foreground" />
                        </div>
                        <h3 class="mb-1 text-sm font-medium">@pillar.Title</h3>
                        <p class="text-sm text-muted-foreground">@pillar.Description</p>
                    </div>
                }
            </div>
        </div>

        @* CTA *@
        <div class="px-6 py-5 text-center">
            <ButtonCn Class="gap-2" Variant="ButtonVariant.Outline">
                See How We Work
                <LucideIconCn Name="arrow-right" Size="16" Class="size-4" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Pillar(string Icon, string Title, string Description);

    private readonly List<Pillar> _pillars =
    [
        new("heart", "People First", "Every decision starts with asking: how does this help our users succeed?"),
        new("lightbulb", "Radical Simplicity", "We remove complexity, not add features. Less is more, always."),
        new("shield", "Earned Trust", "We protect your data like it's our own. Security isn't a feature — it's foundational."),
    ];
}
