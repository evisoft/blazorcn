@* ============================================================
   Block: about-testimonial-carousel
   Title: About Testimonial Carousel
   Description: Featured testimonial carousel with navigation to cycle through customer quotes
   Long Description: Highlight impactful customer testimonials one at a time. This carousel format draws attention to detailed quotes and creates a focused reading experience—perfect for hero sections or prominent about page placements.
   Dependencies: AvatarCn, ButtonCn
   Source: original/blocks/about/about-testimonial-carousel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Customer Stories</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Hear from teams using our platform daily
            </p>
        </div>
        <div class="p-6">
            <div class="mb-6 flex items-start gap-4">
                <LucideIconCn Name="quote" Size="32" Class="mt-1 size-8 shrink-0 text-muted-foreground/40" />
                <p class="text-base leading-relaxed">@_testimonials[_currentIndex].Quote</p>
            </div>
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <AvatarCn Class="size-10">
                        <AvatarFallbackCn>@_testimonials[_currentIndex].Initials</AvatarFallbackCn>
                    </AvatarCn>
                    <div>
                        <p class="font-medium text-sm">@_testimonials[_currentIndex].Name</p>
                        <p class="text-muted-foreground text-xs">
                            @_testimonials[_currentIndex].Role, @_testimonials[_currentIndex].Company
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-8"
                              OnClick="HandlePrevious" aria-label="Previous testimonial">
                        <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                    </ButtonCn>
                    <span class="tabular-nums text-muted-foreground text-xs">
                        @(_currentIndex + 1) / @_testimonials.Count
                    </span>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-8"
                              OnClick="HandleNext" aria-label="Next testimonial">
                        <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Quote, string Name, string Role, string Company, string Initials);

    private int _currentIndex;

    private readonly List<Testimonial> _testimonials =
    [
        new("We were spending 15 hours a week on manual data reconciliation. This platform reduced that to under an hour. The accuracy improvements alone justified the cost, but the time savings transformed how our team operates. We can finally focus on analysis instead of data cleanup.",
            "Rachel Morrison", "Director of Analytics", "Metric Solutions", "RM"),
        new("After evaluating eight different platforms, this was the only one that met our security requirements without compromising on usability. The SOC 2 compliance, granular permissions, and audit logs gave our security team confidence while keeping the developer experience smooth.",
            "Alex Thompson", "Head of Security", "SecureBase", "AT"),
        new("Our customer support team was drowning in tickets about account setup. The new onboarding flow reduced support volume by 68% in the first month. More importantly, user activation rates went from 42% to 79%. It's rare to see wins for both customers and internal teams.",
            "Jordan Lee", "VP of Customer Success", "GrowthEngine", "JL"),
        new("The integration took three days instead of the projected three weeks. Documentation was clear, the API was intuitive, and support was responsive when we had questions. Six months in, we haven't had a single outage or data sync issue.",
            "Samira Patel", "Senior Engineering Manager", "CloudSync", "SP"),
    ];

    private void HandlePrevious() =>
        _currentIndex = _currentIndex == 0 ? _testimonials.Count - 1 : _currentIndex - 1;

    private void HandleNext() =>
        _currentIndex = _currentIndex == _testimonials.Count - 1 ? 0 : _currentIndex + 1;
}
