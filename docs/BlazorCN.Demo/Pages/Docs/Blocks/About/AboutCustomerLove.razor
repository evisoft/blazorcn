@* ============================================================
   Block: about-customer-love
   Title: About Customer Love
   Description: Detailed customer success stories with company context, challenges, and measurable outcomes
   Long Description: Build credibility through detailed customer stories. This component showcases in-depth testimonials that explain the business context, specific challenges, how your product helped, and measurable outcomes.
   Dependencies: None
   Source: original/blocks/about/about-customer-love.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Customer Success Stories</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                How teams are building better products with us
            </p>
        </div>

        <div class="divide-y">
            @foreach (var story in _stories)
            {
                <div class="p-6">
                    <div class="flex items-baseline gap-3">
                        <h3 class="font-medium text-sm">@story.Company</h3>
                        <span class="text-muted-foreground text-xs">@story.Industry</span>
                    </div>

                    <div class="mt-4 space-y-4">
                        <div class="rounded-md bg-muted/50 p-3">
                            <p class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                                Challenge
                            </p>
                            <p class="mt-1.5 text-sm">@story.Challenge</p>
                        </div>

                        <div class="rounded-md bg-muted/50 p-3">
                            <p class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                                Solution
                            </p>
                            <p class="mt-1.5 text-sm">@story.Solution</p>
                        </div>

                        <div class="rounded-md bg-muted/50 p-3">
                            <p class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                                Outcome
                            </p>
                            <p class="mt-1.5 text-sm">@story.Outcome</p>
                        </div>
                    </div>

                    <div class="mt-4 border-t pt-4">
                        <p class="text-sm italic">@story.Quote</p>
                        <div class="mt-2">
                            <p class="font-medium text-sm">@story.Author</p>
                            <p class="text-muted-foreground text-xs">@story.Role</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CustomerStory(string Company, string Industry, string Challenge, string Solution, string Outcome, string Quote, string Author, string Role);

    private readonly List<CustomerStory> _stories =
    [
        new("TechFlow", "SaaS Platform",
            "Spending 60% of development time rebuilding basic UI components for each new feature. Inconsistent design patterns across 5 different products. No design system in place.",
            "Adopted our component library as the foundation for all new development. Gradually migrated legacy code to use shared components. Established design system based on our patterns.",
            "Reduced feature development time by 45%. Shipped 3 major product updates in 6 months that previously would have taken 12+ months. Design consistency improved across all products.",
            "We went from rebuilding the same components over and over to shipping features in days instead of weeks. The ROI was immediate.",
            "Sarah Chen", "VP of Engineering"),
        new("DataScale", "Analytics Platform",
            "Dashboard performance degrading as customer data grew. Charts taking 5-10 seconds to render. Users complaining about sluggish interface. Previous vendor couldn't scale.",
            "Replaced charting library with our optimized components. Implemented progressive loading for large datasets. Added intelligent caching layer for frequently accessed data.",
            "Dashboard load time reduced from 8.5s to 1.2s. Charts now render in under 300ms even with 100K+ data points. Customer satisfaction scores increased 34% within 2 months.",
            "The performance difference was night and day. Our customers immediately noticed how much faster everything felt.",
            "Michael Roberts", "CTO"),
        new("CloudPro", "DevOps Tools",
            "Supporting 12 different authentication providers with custom implementations for each. Security vulnerabilities discovered in 3 different auth implementations. Taking weeks to add new SSO providers.",
            "Integrated our unified authentication system. Migrated all 12 providers to our standardized implementation. Enabled self-service SSO configuration for enterprise customers.",
            "Reduced auth-related code by 70%. Closed all auth security issues within 2 weeks. Now add new SSO providers in hours instead of weeks. Enterprise deals closing 40% faster.",
            "Authentication went from our biggest maintenance burden to something we never think about. It just works.",
            "Jessica Park", "Head of Product"),
    ];
}
