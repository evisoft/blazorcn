@* ============================================================
   Block: about-speaking-engagements
   Title: About Speaking Engagements
   Description: A showcase of conference talks and speaking engagements demonstrating thought leadership and industry expertise.
   Long Description: Build authority with your speaking track record. This about block displays conference talks, keynotes, and presentations with speaker names, conference details, and dates.
   Dependencies: None
   Source: original/blocks/about/about-speaking-engagements.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Speaking Engagements</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Conferences and events where our team has shared insights
            </p>
        </div>
        <div class="divide-y">
            @foreach (var talk in _talks)
            {
                <div class="px-6 py-5">
                    <div class="flex items-start gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="mic" Size="20" Class="size-5 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <h3 class="font-medium text-sm">@talk.Title</h3>
                            <div class="mt-1 flex flex-wrap items-center gap-2">
                                <span class="rounded-md bg-muted/50 px-2 py-1 font-medium text-muted-foreground text-xs">
                                    @talk.Conference
                                </span>
                                <span class="text-muted-foreground text-xs tabular-nums">@talk.Date</span>
                            </div>
                            <p class="mt-2 text-muted-foreground text-xs">@talk.Speaker</p>
                            <p class="mt-3 text-muted-foreground text-sm">@talk.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Talk(string Title, string Conference, string Speaker, string Date, string Description);

    private readonly List<Talk> _talks =
    [
        new("Building Real-Time Collaborative Systems at Scale", "React Advanced 2024", "Sarah Chen, CTO", "October 2024",
            "Deep dive into operational transformation, conflict resolution, and state synchronization patterns"),
        new("Privacy-First Analytics: Balancing Insights and User Trust", "Data Engineering Summit 2024", "David Kim, Head of Security", "September 2024",
            "Implementing differential privacy and federated learning for user analytics without compromising data"),
        new("The Future of Developer Tools: AI-Assisted Workflows", "DevTools Conference 2024", "Elena Rodriguez, VP Product", "June 2024",
            "How AI copilots and automated code review are transforming developer productivity"),
        new("Scaling from Zero to Millions: Database Performance Lessons", "QCon San Francisco 2023", "Marcus Johnson, Staff Engineer", "November 2023",
            "Real-world lessons on query optimization, sharding strategies, and read replica management"),
        new("Design Systems for AI-Powered Products", "Config 2023 (Figma Conference)", "Priya Patel, Design Lead", "June 2023",
            "Creating consistent UX patterns for AI features, loading states, and conversational interfaces"),
    ];
}
