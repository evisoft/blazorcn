@* ============================================================
   Block: about-blog-highlights
   Title: About Blog Highlights
   Description: A featured blog posts section showing recent articles with metadata for about pages
   Long Description: Drive content engagement with featured blog highlights. Displays recent articles with reading time, categories, and excerpts to showcase thought leadership and encourage content consumption.
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/about/about-blog-highlights.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">From Our Blog</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Technical insights and product thinking
            </p>
        </div>

        <div class="p-6">
            <div class="space-y-4">
                @foreach (var article in _articles)
                {
                    <div class="rounded-md border bg-muted/50 p-4">
                        <div class="flex flex-wrap items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 text-xs">
                                @article.Category
                            </BadgeCn>
                            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                                <span>@article.Date</span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                    @article.ReadingTime
                                </span>
                            </div>
                        </div>

                        <h3 class="mt-3 text-sm font-medium">@article.Title</h3>
                        <p class="mt-2 text-sm text-muted-foreground">@article.Excerpt</p>

                        <ButtonCn Variant="ButtonVariant.Ghost" Class="mt-3 h-7 gap-1 px-2 text-xs">
                            Read article
                            <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>
                }
            </div>

            <div class="mt-6 flex justify-center">
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-8 text-xs">
                    View All Posts
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Article(string Title, string Excerpt, string Date, string ReadingTime, string Category);

    private readonly List<Article> _articles =
    [
        new("Building Scalable Component Systems",
            "How we designed a component architecture that scales from small teams to enterprise organizations.",
            "Mar 10, 2026", "8 min read", "Engineering"),
        new("The Future of Web Performance",
            "Exploring new performance optimization techniques and their impact on user experience metrics.",
            "Feb 28, 2026", "6 min read", "Performance"),
        new("Accessibility-First Design Process",
            "Why we put accessibility at the center of our design system and how it improved product quality.",
            "Feb 15, 2026", "5 min read", "Design"),
    ];
}
