@* ============================================================
   Block: about-philosophy
   Title: About Philosophy
   Description: Company philosophy section with numbered belief statements for React brand about pages
   Long Description: Share your worldview with this philosophy component for Next.js about pages. Features a 2x2 grid of numbered belief statements with explanations that reveal how you think and build. Built with Tailwind CSS. Philosophy attracts aligned customers and repels mismatched ones—that's the point. Perfect for opinionated product companies, design studios, and brands where philosophy is a competitive advantage.
   Dependencies: None
   Source: original/blocks/about/about-philosophy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="mb-2 text-xl font-semibold tracking-tight">What we believe</h2>
            <p class="text-sm text-muted-foreground">
                These beliefs shape every decision we make, from product design to how we treat
                customers.
            </p>
        </div>

        @* Beliefs *@
        <div class="p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                @foreach (var item in _beliefs)
                {
                    <div class="rounded-lg border p-5">
                        <span class="mb-2 inline-block font-mono text-xs text-muted-foreground">
                            @item.Number
                        </span>
                        <h3 class="mb-2 text-sm font-medium">@item.Belief</h3>
                        <p class="text-sm text-muted-foreground">@item.Explanation</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record BeliefItem(string Number, string Belief, string Explanation);

    private readonly List<BeliefItem> _beliefs =
    [
        new("01", "Simplicity is the ultimate sophistication",
            "Every feature we cut makes the product better. Complexity is easy; simplicity takes courage."),
        new("02", "Speed is a feature",
            "Fast software respects your time. We obsess over milliseconds because they add up to hours."),
        new("03", "Defaults matter more than options",
            "Great software works out of the box. Configuration is a tax on users."),
        new("04", "Transparency builds trust",
            "We share our roadmap, our pricing logic, even our mistakes. Secrets erode relationships."),
    ];
}
