@* ============================================================
   Block: about-image-overlay
   Title: AboutImageOverlay
   Description: An image overlay card block for React and Next.js with a placeholder visual area, overlaid tagline and description text, a CTA button, and smooth fade entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-image-overlay.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Image area with overlay *@
        <div class="relative">
            @* Placeholder visual area *@
            <div class="flex aspect-[16/9] items-center justify-center bg-muted"
                 aria-hidden="true">
                <LucideIconCn Name="image" Size="40" Class="size-10 text-muted-foreground/30" />
            </div>

            @* Bottom overlay fade *@
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/70 via-black/40 to-transparent" />

            @* Overlay content *@
            <div class="absolute inset-x-0 bottom-0 px-5 pb-5">
                <h2 class="text-sm font-medium text-white">@_tagline</h2>
                <p class="mt-2 max-w-md text-xs leading-relaxed text-white/80">@_description</p>
                <div class="mt-3">
                    <ButtonCn Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Learn our story
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Bottom bar with context *@
        <div class="flex items-center justify-between border-t px-5 py-3">
            <span class="text-xs text-muted-foreground">Founded 2019 in San Francisco</span>
            <span class="text-xs text-muted-foreground">120+ team members across 14 countries</span>
        </div>
    </div>
</section>

@code {
    private const string _tagline = "We build tools that respect your craft";
    private const string _description =
        "Every decision we make starts with one question: does this help our customers do their best work? No feature bloat, no dark patterns — just software that earns its place in your workflow.";
}
