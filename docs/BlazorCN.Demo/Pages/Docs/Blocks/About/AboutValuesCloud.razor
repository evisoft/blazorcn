@* ============================================================
   Block: about-values-cloud
   Title: About Values Cloud
   Description: About section with animated floating value tags
   Long Description: About section with bento-style values grid
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/about/about-values-cloud.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                What We Stand For
            </BadgeCn>
            <h2 class="mb-2 text-xl font-semibold tracking-tight">Our guiding principles</h2>
            <p class="text-sm text-muted-foreground">
                These aren't just words on a wall. They guide every decision we make.
            </p>
        </div>

        @* Values cloud *@
        <div class="px-6 py-8">
            <div class="mb-6 flex flex-wrap items-center justify-center gap-3">
                @foreach (var item in _values)
                {
                    var sizeClass = item.Size switch
                    {
                        "lg" => "text-lg md:text-xl",
                        "md" => "text-base md:text-lg",
                        _ => "text-sm md:text-base",
                    };

                    <span class="@($"inline-flex items-center rounded-full border bg-background px-4 py-2 font-medium transition-all hover:border-muted-foreground hover:text-foreground {sizeClass}")">
                        @item.Word
                    </span>
                }
            </div>

            @* CTA *@
            <div class="text-center">
                <ButtonCn Class="gap-2" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    Learn More About Us
                    <LucideIconCn Name="arrow-right" Size="16" Class="h-4 w-4" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ValueWord(string Word, string Size);

    private readonly List<ValueWord> _values =
    [
        new("Innovation", "lg"),
        new("Simplicity", "md"),
        new("Quality", "lg"),
        new("Speed", "sm"),
        new("Trust", "lg"),
        new("Craft", "md"),
        new("Care", "sm"),
        new("Excellence", "md"),
    ];
}
