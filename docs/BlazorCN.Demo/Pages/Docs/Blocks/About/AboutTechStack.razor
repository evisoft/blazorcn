@* ============================================================
   Block: about-tech-stack
   Title: About Tech Stack
   Description: About section with technology stack and tools showcase
   Long Description: About section with team quote carousel and company intro
   Dependencies: BadgeCn
   Source: original/blocks/about/about-tech-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                Our Stack
            </BadgeCn>
            <h2 class="mb-2 text-xl font-semibold tracking-tight">
                Built with modern technology
            </h2>
            <p class="text-sm text-muted-foreground">
                We use the best tools available to build fast, reliable, and scalable software.
            </p>
        </div>

        @* Tech stack grid *@
        <div class="grid gap-4 p-6 sm:grid-cols-2">
            @foreach (var category in _categories)
            {
                <div class="rounded-lg border bg-muted/50 p-5">
                    <h3 class="mb-3 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @category.Name
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var tool in category.Tools)
                        {
                            <span class="rounded-full border bg-background px-3 py-1 text-sm font-medium">
                                @tool
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Category(string Name, string[] Tools);

    private readonly List<Category> _categories =
    [
        new("Frontend", ["React", "Next.js", "TypeScript", "Tailwind CSS"]),
        new("Backend", ["Node.js", "PostgreSQL", "Redis", "GraphQL"]),
        new("Infrastructure", ["AWS", "Vercel", "Docker", "Kubernetes"]),
        new("Integrations", ["Stripe", "Auth0", "SendGrid", "Segment"]),
    ];
}
