@* ============================================================
   Block: about-open-positions
   Title: About Open Positions
   Description: Open positions job listings section with departments and locations for React careers pages
   Long Description: A transparent business metrics dashboard showing revenue, growth, and customer satisfaction for about pages
   Dependencies: ButtonCn
   Source: original/blocks/about/about-open-positions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="mb-2 text-xl font-semibold tracking-tight">Open positions</h2>
            <p class="text-sm text-muted-foreground">
                Join our team and help us build the future. We're hiring across multiple roles.
            </p>
        </div>

        @* Positions by department *@
        <div class="px-6 py-5">
            <div class="space-y-6">
                @foreach (var dept in _positions)
                {
                    <div>
                        <h3 class="mb-3 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                            @dept.Name
                        </h3>
                        <div class="space-y-2">
                            @foreach (var role in dept.Roles)
                            {
                                <div class="flex items-center justify-between rounded-lg border p-4">
                                    <div class="flex-1">
                                        <h4 class="text-sm font-medium">@role.Title</h4>
                                        <div class="mt-1 flex items-center gap-3 text-xs text-muted-foreground">
                                            <span class="flex items-center gap-1">
                                                <LucideIconCn Name="map-pin" Size="14" Class="size-3.5" />
                                                @role.Location
                                            </span>
                                            <span>@role.Type</span>
                                        </div>
                                    </div>
                                    <ButtonCn Class="gap-1.5" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                        Apply
                                        <LucideIconCn Name="arrow-right" Size="16" Class="size-4" />
                                    </ButtonCn>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer note *@
        <div class="border-t px-6 py-4">
            <p class="text-center text-sm text-muted-foreground">
                Don't see the right role?
                <a class="font-medium text-foreground hover:underline" href="#">
                    Send us your resume
                </a>
                and we'll keep you in mind.
            </p>
        </div>
    </div>
</section>

@code {
    private record Role(string Title, string Location, string Type);
    private record Department(string Name, Role[] Roles);

    private readonly List<Department> _positions =
    [
        new("Engineering",
            [new("Senior Frontend Engineer", "Remote", "Full-time"), new("Backend Engineer", "San Francisco", "Full-time"), new("DevOps Engineer", "Remote", "Full-time")]),
        new("Design",
            [new("Product Designer", "Remote", "Full-time"), new("Design Systems Lead", "New York", "Full-time")]),
        new("Product",
            [new("Product Manager", "San Francisco", "Full-time")]),
    ];
}
