   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid gap-8 p-6 lg:grid-cols-2 lg:gap-10">
          @* Left - Video placeholder *@
          <div class="relative aspect-video overflow-hidden rounded-lg bg-muted lg:aspect-[4/3]">
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-muted/50">
              <ButtonCn
                Type="button"
                Variant="ButtonVariant.Outline"
                Size="ButtonSize.IconLg"
                Class="group rounded-full shadow-sm hover:scale-110"
               aria-label="Play">
                <LucidePlayCn Size="20" Class="h-5 w-5 translate-x-0.5" />
              </ButtonCn>
              <p class="mt-3 text-xs font-medium text-muted-foreground">
                Watch our story (2:30)
              </p>
            </div>
          </div>

          @* Right - Content *@
          <div class="flex flex-col justify-center">
            <BadgeCn Class="mb-3 w-fit" Variant="BadgeVariant.Secondary">
              Our Story
            </BadgeCn>

            <h2 class="mb-4 text-xl font-semibold tracking-tight">
              Built by practitioners, for practitioners
            </h2>

            <div class="mb-6 space-y-3 text-sm leading-relaxed text-muted-foreground">
              <p>
                We spent a decade in the trenches—managing projects, leading teams, and wrestling
                with tools that promised much but delivered little.
              </p>
              <p>
                In 2019, we decided to build what we couldn't find: software that actually
                understands how modern teams work. No bloat. No learning curve. Just tools that make
                sense.
              </p>
              <p>
                Today, we're proud to serve over 20,000 teams who share our belief that work should
                be simpler.
              </p>
            </div>

            <div class="flex flex-wrap gap-3">
              <ButtonCn Class="gap-2" Size="ButtonSize.Sm">
                Start Free Trial
                <LucideArrowRightCn Size="16" Class="h-4 w-4" />
              </ButtonCn>
              <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                Meet the Team
              </ButtonCn>
            </div>
          </div>
        </div>
      </div>
    </section>

