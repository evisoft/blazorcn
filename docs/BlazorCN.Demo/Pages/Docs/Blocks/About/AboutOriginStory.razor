@* ============================================================
   Block: about-origin-story
   Title: About Origin Story
   Description: A founding story narrative with key dates, the aha moment, and company origins told as a flowing story
   Long Description: Share your company's founding story in a narrative format. Highlights key moments, the founding team, and the insight that sparked the company.
   Dependencies: None
   Source: original/blocks/about/about-origin-story.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Origin Story</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                How a late-night debugging session in a San Francisco apartment sparked a new way to
                build UI components
            </p>
        </div>

        <div class="p-6">
            <div class="space-y-6">
                <div class="rounded-md bg-muted/50 p-4">
                    <div class="mb-3 flex items-center gap-2 text-muted-foreground text-xs">
                        <LucideIconCn Name="calendar" Size="14" Class="size-3.5" />
                        <span class="font-medium uppercase tracking-wider">Founded 2021</span>
                    </div>
                    <div class="mb-2 flex items-center gap-2 text-muted-foreground text-xs">
                        <LucideIconCn Name="map-pin" Size="14" Class="size-3.5" />
                        <span>San Francisco, CA</span>
                    </div>
                    <p class="text-muted-foreground text-sm">
                        Started by Sarah Chen and Michael Torres, two engineers who spent a decade watching
                        development teams reinvent the same wheels.
                    </p>
                </div>

                <div>
                    <div class="mb-4 flex items-center gap-2">
                        <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                        <h3 class="font-medium text-sm">The Journey</h3>
                    </div>

                    <div class="space-y-5">
                        @for (var i = 0; i < _milestones.Count; i++)
                        {
                            var milestone = _milestones[i];
                            <div>
                                <div class="flex items-start gap-4">
                                    <div class="flex size-16 shrink-0 flex-col items-center justify-center rounded-lg bg-muted/50">
                                        <div class="font-semibold text-sm tabular-nums">@milestone.Year</div>
                                        <div class="text-muted-foreground text-xs">@milestone.Month</div>
                                    </div>

                                    <div class="min-w-0 flex-1">
                                        <h4 class="font-medium text-sm">@milestone.Title</h4>
                                        <p class="mt-2 text-muted-foreground text-sm">
                                            @milestone.Description
                                        </p>
                                    </div>
                                </div>

                                @if (i < _milestones.Count - 1)
                                {
                                    <div class="ml-8 mt-4 h-8 border-l-2 border-dashed border-muted-foreground/20"></div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="border-t px-6 py-5">
            <h3 class="mb-3 font-medium text-sm">The Founding Team</h3>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="rounded-md bg-muted/50 p-4">
                    <div class="font-medium text-sm">Sarah Chen</div>
                    <div class="mt-1 text-muted-foreground text-xs">Co-Founder, CEO</div>
                    <p class="mt-2 text-muted-foreground text-sm">
                        Previously led design systems at Stripe. Built component libraries used by 1,000+
                        engineers. Stanford CS '14.
                    </p>
                </div>

                <div class="rounded-md bg-muted/50 p-4">
                    <div class="font-medium text-sm">Michael Torres</div>
                    <div class="mt-1 text-muted-foreground text-xs">Co-Founder, CTO</div>
                    <p class="mt-2 text-muted-foreground text-sm">
                        Early engineer at Vercel and Airbnb. Open source contributor with 2M+ weekly npm
                        downloads. MIT '15.
                    </p>
                </div>
            </div>
        </div>

        <div class="border-t bg-muted/30 px-6 py-4">
            <p class="text-muted-foreground text-sm">
                We're not building a component library. We're building a better way for developers to
                build — one where you own your code, not rent it from a package.
            </p>
        </div>
    </div>
</section>

@code {
    private record Milestone(string Year, string Month, string Title, string Description);

    private readonly List<Milestone> _milestones =
    [
        new("2019", "MAR", "The Problem Surfaces",
            "After years in enterprise software, our founders watched countless development teams rebuild the same UI components over and over. Every project started from scratch. Every team solved identical problems differently."),
        new("2020", "AUG", "The Aha Moment",
            "During a late-night debugging session, Sarah realized component libraries weren't the solution — they were too opinionated and locked teams in. What if developers could copy and own their components instead?"),
        new("2021", "JAN", "First 100 Components",
            "Built in a San Francisco apartment, the initial registry launched with 100 components. No framework lock-in. No npm package. Just copy, paste, and customize. Developers immediately got it."),
        new("2022", "JUN", "Community Takes Over",
            "The community started contributing more components than we built internally. GitHub went from 20 stars to 20,000 in six months. We knew we were onto something bigger than ourselves."),
    ];
}
