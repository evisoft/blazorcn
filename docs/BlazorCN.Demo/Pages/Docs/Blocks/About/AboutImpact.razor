@* ============================================================
   Block: about-impact
   Title: AboutImpact
   Description: An asymmetric bento grid impact metrics block for React and Next.js with featured stat cells, semantic color categories, context lines, computed totals, and staggered scale entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-impact.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-5 py-4">
            <h2 class="text-sm font-medium">Our Impact</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Measurable outcomes across environment, community, and business.
            </p>
            @* Category legend *@
            <div class="mt-3 flex gap-4">
                @foreach (var entry in _categoryConfig)
                {
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full @entry.Value.DotClass"></span>
                        <span class="text-[10px] text-muted-foreground">@entry.Value.Label</span>
                    </div>
                }
            </div>
        </div>

        @* Bento grid *@
        <div class="p-3">
            @* Featured row — two wide cells *@
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                @foreach (var metric in _featuredMetrics)
                {
                    var config = _categoryConfig[metric.Category];
                    <div class="rounded-md border p-4 @config.BgClass">
                        <div class="flex items-center gap-1.5">
                            <span class="size-1.5 rounded-full @config.DotClass"></span>
                            <span class="text-[10px] text-muted-foreground">@config.Label</span>
                        </div>
                        <p class="mt-2 text-2xl font-semibold tabular-nums">@metric.Value</p>
                        <p class="mt-0.5 text-sm font-medium">@metric.Label</p>
                        <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                            @metric.Context
                        </p>
                    </div>
                }
            </div>

            @* Standard row — smaller cells *@
            <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-3 lg:grid-cols-5">
                @foreach (var metric in _standardMetrics)
                {
                    var config = _categoryConfig[metric.Category];
                    <div class="rounded-md border p-3">
                        <div class="flex items-center gap-1.5">
                            <span class="size-1.5 rounded-full @config.DotClass"></span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 text-[10px] font-normal">
                                @config.Label
                            </BadgeCn>
                        </div>
                        <p class="mt-2 text-lg font-semibold tabular-nums">@metric.Value</p>
                        <p class="mt-0.5 text-xs font-medium">@metric.Label</p>
                        <p class="mt-1.5 text-[10px] leading-relaxed text-muted-foreground">
                            @metric.Context
                        </p>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-5 py-3">
            <p class="text-xs text-muted-foreground">
                All metrics verified annually. Last audit: January 2026.
            </p>
        </div>
    </div>
</section>

@code {
    private record Metric(string Id, string Value, string Label, string Context, string Category, bool Featured);
    private record CategoryEntry(string Label, string DotClass, string BgClass);

    private static readonly Metric[] _metrics =
    [
        new("carbon",      "2,400 tons", "Carbon offset annually",        "Equivalent to removing 520 cars from the road. Verified by Gold Standard.",                              "environment", true),
        new("education",   "$3.2M",      "Education funding since 2021",  "Scholarships for 840 students in underrepresented communities across 12 countries.",                    "community",   true),
        new("jobs",        "1,200+",     "Jobs created",                  "Direct hires and contractor positions across 14 countries.",                                             "business",    false),
        new("open-source", "47",         "Open-source projects",          "Maintained libraries with 280K+ combined monthly downloads.",                                            "community",   false),
        new("community",   "92,000",     "Community members",             "Active developers in our Discord, forums, and meetup groups.",                                           "community",   false),
        new("uptime",      "99.98%",     "Platform uptime",               "Trailing 12-month average across all production services.",                                              "business",    false),
        new("savings",     "$18M+",      "Customer cost savings",         "Estimated annual savings versus building equivalent tooling in-house.",                                  "business",    false),
    ];

    private static readonly Dictionary<string, CategoryEntry> _categoryConfig = new()
    {
        ["environment"] = new("Environment", "bg-emerald-500", "bg-emerald-500/5"),
        ["community"]   = new("Community",   "bg-blue-500",    "bg-blue-500/5"),
        ["business"]    = new("Business",    "bg-amber-500",   "bg-amber-500/5"),
    };

    private IEnumerable<Metric> _featuredMetrics => _metrics.Where(m => m.Featured);
    private IEnumerable<Metric> _standardMetrics => _metrics.Where(m => !m.Featured);
}
