@* ============================================================
   Block: about-approach
   Title: About Approach
   Description: Company approach methodology section with numbered process steps for React agency sites
   Long Description: Display API performance metrics including uptime, latency, request volume, and error rates
   Dependencies: None
   Source: original/blocks/about/about-approach.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">A proven process for results</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                We've refined our methodology over hundreds of projects.
            </p>
        </div>

        <div class="grid gap-px bg-muted sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var item in _steps)
            {
                <div class="bg-card p-6">
                    <div class="mb-4 flex items-center justify-between">
                        <div class="flex h-10 w-10 items-center justify-center rounded-full border">
                            <LucideIconCn Name="@item.Icon" Size="20" Class="h-5 w-5 text-muted-foreground" />
                        </div>
                        <span class="font-mono text-2xl text-muted-foreground/60">@item.Step</span>
                    </div>
                    <h3 class="mb-2 text-sm font-medium">@item.Title</h3>
                    <p class="text-sm text-muted-foreground leading-relaxed">@item.Description</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StepItem(string Icon, string Step, string Title, string Description);

    private readonly List<StepItem> _steps =
    [
        new("search", "01", "Discover", "We start by deeply understanding your problem, users, and goals."),
        new("lightbulb", "02", "Design", "We explore solutions, prototype rapidly, and validate with real users."),
        new("code", "03", "Develop", "We build in short sprints, shipping working software every week."),
        new("rocket", "04", "Deliver", "We launch, measure results, and iterate based on real-world data."),
    ];
}
