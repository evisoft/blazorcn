@* ============================================================
   Block: about-split-logos
   Title: About Split Logos
   Description: About section with split intro and scrolling logos
   Long Description: About section with team expertise and specializations
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/about/about-split-logos.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid gap-0 lg:grid-cols-2">
            @* Left - Story *@
            <div class="border-b px-6 py-8 lg:border-b-0 lg:border-r lg:py-12">
                <BadgeCn Class="mb-4" Variant="BadgeVariant.Secondary">
                    About Us
                </BadgeCn>

                <h2 class="mb-4 text-xl font-semibold tracking-tight">
                    From frustration to innovation
                </h2>

                <div class="mb-6 space-y-3 text-sm text-muted-foreground">
                    <p>
                        We spent years watching teams struggle with fragmented tools and manual processes.
                        In 2018, we decided to build the solution we wished existed.
                    </p>
                    <p>
                        Today, we're a team of 60+ spread across the globe, serving thousands of
                        companies—from early-stage startups to public enterprises.
                    </p>
                    <p>
                        Our platform has processed over $2B in transactions and saved our customers an
                        estimated 1M+ hours of manual work.
                    </p>
                </div>

                <ButtonCn Class="gap-2" Variant="ButtonVariant.Outline">
                    Read Our Full Story
                    <LucideIconCn Name="arrow-right" Size="16" Class="h-4 w-4" />
                </ButtonCn>
            </div>

            @* Right - Logo stack *@
            <div class="flex items-center justify-center px-6 py-8 lg:py-12">
                <div class="grid w-full max-w-xs grid-cols-2 gap-3">
                    @foreach (var logo in _logos)
                    {
                        <div class="flex h-20 items-center justify-center rounded-lg border bg-muted/30">
                            <span class="font-semibold text-muted-foreground/70">@logo</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private readonly string[] _logos = ["Stripe", "Vercel", "Linear", "Notion", "Figma", "Slack"];
}
