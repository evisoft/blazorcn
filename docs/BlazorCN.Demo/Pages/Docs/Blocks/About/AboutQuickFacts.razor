@* ============================================================
   Block: about-quick-facts
   Title: About Quick Facts
   Description: Quick facts grid with company stats and fun metrics for React about pages
   Long Description: Share your story in numbers with this quick facts component for Next.js about pages. Features an 8-cell grid of facts mixing business metrics with fun team stats. Built with Tailwind CSS. The combination of serious numbers and playful facts humanizes your brand while proving traction. Perfect for startups wanting to show personality, companies with impressive metrics, and about pages that need to feel approachable.
   Dependencies: None
   Source: original/blocks/about/about-quick-facts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5 text-center">
            <h2 class="text-xl font-semibold tracking-tight">The numbers that define us</h2>
        </div>

        @* Facts grid *@
        <div class="p-6">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                @foreach (var fact in _facts)
                {
                    <div class="rounded-lg border bg-muted/50 p-4 text-center">
                        <p class="text-2xl font-semibold tabular-nums tracking-tight">@fact.Value</p>
                        <p class="mt-1 text-sm text-muted-foreground">@fact.Label</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Fact(string Value, string Label);

    private readonly List<Fact> _facts =
    [
        new("2019", "Founded"),
        new("47", "Team members"),
        new("15", "Countries"),
        new("25K+", "Customers"),
        new("4.9\u2605", "Rating"),
        new("99.9%", "Uptime"),
        new("12", "Office dogs"),
        new("\u221E", "Coffee consumed"),
    ];
}
