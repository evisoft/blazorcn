@* ============================================================
   Block: about-data-centers
   Title: About Data Centers
   Description: Infrastructure locations and redundancy information showing data center regions and reliability measures
   Long Description: Build trust through infrastructure transparency. This component displays your data center locations, cloud providers, and redundancy measures, helping customers understand where their data lives and how it's protected.
   Dependencies: None
   Source: original/blocks/about/about-data-centers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Global Infrastructure</h2>
            <p class="mt-1 text-muted-foreground text-sm">Data center locations and redundancy</p>
        </div>

        <div class="border-b p-6">
            <div class="space-y-4">
                @foreach (var dc in _dataCenters)
                {
                    <div class="rounded-md border p-4">
                        <div class="flex items-start justify-between gap-4">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-baseline gap-3">
                                    <h3 class="font-medium text-sm">@dc.Region</h3>
                                    <span class="text-muted-foreground text-xs">@dc.Location</span>
                                </div>
                                <p class="mt-2 text-muted-foreground text-sm">@dc.Details</p>
                            </div>
                            <div class="flex shrink-0 flex-col items-end gap-1">
                                <span class="rounded-md bg-muted/50 px-2 py-1 font-mono text-xs">
                                    @dc.Provider
                                </span>
                                <span class="text-muted-foreground text-xs">@dc.Redundancy</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="p-6">
            <div class="grid gap-4 sm:grid-cols-3">
                @foreach (var feature in _features)
                {
                    <div class="rounded-md bg-muted/50 p-4">
                        <div class="flex flex-col gap-2">
                            <LucideIconCn Name="@feature.Icon" Size="20" Class="size-5 text-muted-foreground" />
                            <div>
                                <h3 class="font-medium text-sm">@feature.Title</h3>
                                <p class="mt-1 text-muted-foreground text-sm">@feature.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record DataCenter(string Region, string Location, string Provider, string Redundancy, string Details);
    private record FeatureItem(string Icon, string Title, string Description);

    private readonly List<DataCenter> _dataCenters =
    [
        new("US East", "Virginia, USA", "AWS", "Multi-AZ",
            "Primary production region. Triple redundancy across 3 availability zones. Automatic failover within 30 seconds."),
        new("EU West", "Ireland, EU", "AWS", "Multi-AZ",
            "European data residency for GDPR compliance. Real-time replication from US East. Sub-50ms latency across Europe."),
        new("Asia Pacific", "Singapore", "AWS", "Multi-AZ",
            "Serves APAC customers with low-latency access. Synchronized with US and EU regions. Full data sovereignty support."),
        new("US West", "Oregon, USA", "AWS", "Hot Standby",
            "Disaster recovery site. Full database replication with 5-minute lag. Can handle 100% traffic if US East fails."),
    ];

    private readonly List<FeatureItem> _features =
    [
        new("refresh-cw", "Automatic Failover",
            "If any data center experiences issues, traffic automatically routes to healthy regions within seconds."),
        new("server", "Daily Backups",
            "Automated daily backups with 30-day retention. Point-in-time recovery available for last 7 days."),
        new("shield-check", "Physical Security",
            "SOC 2 Type II certified data centers with 24/7 monitoring, biometric access, and redundant power systems."),
    ];
}
