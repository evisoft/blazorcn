@* ============================================================
   Block: about-features-grid
   Title: AboutFeaturesGrid
   Description: A features grid block for React and Next.js with 9 icon-free feature cards in a 3-column gap-px border layout, learn-more links, responsive column collapsing, and scale entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-features-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-5 py-4">
            <h2 class="text-sm font-medium">Platform capabilities</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Everything you need to build, maintain, and scale a design system
            </p>
        </div>

        @* Grid with gap-px borders *@
        <div class="grid grid-cols-1 gap-px bg-muted/50 sm:grid-cols-2 md:grid-cols-3">
            @foreach (var feature in _features)
            {
                <div class="flex flex-col justify-between bg-card p-4">
                    <div>
                        <h3 class="text-sm font-medium">@feature.Title</h3>
                        <p class="mt-1.5 text-xs leading-5 text-muted-foreground">
                            @feature.Description
                        </p>
                    </div>
                    <span class="group mt-3 inline-flex cursor-pointer items-center gap-1 text-[10px] font-medium text-muted-foreground transition-colors hover:text-foreground">
                        Learn more
                        <LucideIconCn Name="arrow-right" Size="10" Class="size-2.5 transition-transform group-hover:translate-x-0.5" />
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Feature(string Id, string Title, string Description, string LearnMoreHref);

    private static readonly Feature[] _features =
    [
        new("type-safety", "End-to-end type safety",
            "TypeScript types generated from your schema and shared across frontend, backend, and API clients. No more type mismatches in production.",
            "/docs/type-safety"),
        new("incremental-adoption", "Incremental adoption",
            "Start with a single component and expand at your own pace. No big-bang migration required — works alongside your existing setup.",
            "/docs/migration"),
        new("instant-preview", "Instant preview",
            "See changes in real time as you edit. Hot module replacement with state preservation means you never lose context while iterating.",
            "/docs/preview"),
        new("version-control", "Version-controlled tokens",
            "Design tokens live in Git alongside your code. Branch, diff, review, and merge design changes with the same workflow engineers already use.",
            "/docs/tokens"),
        new("figma-sync", "Bidirectional Figma sync",
            "Changes flow both ways between Figma and code. Designers update a color in Figma, engineers see it in their next pull request automatically.",
            "/docs/figma"),
        new("a11y-checks", "Built-in accessibility checks",
            "Every component is tested against WCAG 2.1 AA automatically. Color contrast, focus management, and screen reader compatibility verified on each commit.",
            "/docs/accessibility"),
        new("bundle-analysis", "Bundle size tracking",
            "Automated bundle analysis on every PR. Get warned before merging if a change increases your bundle size beyond the configured threshold.",
            "/docs/performance"),
        new("api-generation", "API documentation generation",
            "Props, variants, and usage examples extracted from your source code and published as searchable, versioned documentation automatically.",
            "/docs/api-docs"),
        new("team-workflows", "Team review workflows",
            "Design review and code review in one place. Comment on visual diffs, approve component changes, and track adoption metrics per team.",
            "/docs/workflows"),
    ];
}
