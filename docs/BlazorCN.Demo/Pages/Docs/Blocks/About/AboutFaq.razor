@* ============================================================
   Block: about-faq
   Title: About Faq
   Description: About section with FAQ accordion
   Long Description: About section with card grid showing team expertise areas
   Dependencies: AccordionCn
   Source: original/blocks/about/about-faq.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Common questions</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Everything you might want to know about us.
            </p>
        </div>

        @* Accordion *@
        <div class="p-6">
            <AccordionCn Class="grid w-full">
                @for (var i = 0; i < _faqs.Count; i++)
                {
                    var faq = _faqs[i];
                    <AccordionItemCn>
                        <AccordionTriggerCn Class="text-left text-sm">@faq.Question</AccordionTriggerCn>
                        <AccordionContentCn Class="text-sm text-muted-foreground leading-relaxed">
                            @faq.Answer
                        </AccordionContentCn>
                    </AccordionItemCn>
                }
            </AccordionCn>
        </div>
    </div>
</section>

@code {
    private record FaqItem(string Question, string Answer);

    private readonly List<FaqItem> _faqs =
    [
        new("When was the company founded?",
            "We started in 2018 as a side project and went full-time in 2019 after closing our seed round."),
        new("How big is the team?",
            "We're currently 62 people across 15 countries. About 70% of the team is in engineering and design."),
        new("Are you profitable?",
            "We've been profitable since Q2 2023. We prioritize sustainable growth over growth at all costs."),
        new("What's your business model?",
            "We're a SaaS company with monthly and annual subscription plans. We also offer enterprise contracts for larger organizations."),
        new("Are you hiring?",
            "Always! We're particularly focused on engineering and product design roles. Check our careers page for current openings."),
    ];
}
