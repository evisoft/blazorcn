@* ============================================================
   Block: about-team-avatars
   Title: About Team Avatars
   Description: About section with centered intro and team member avatars
   Long Description: A team culture section highlighting social activities, events, and team building with frequency and descriptions
   Dependencies: AvatarCn, BadgeCn
   Source: original/blocks/about/about-team-avatars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5 text-center">
            <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                Our Team
            </BadgeCn>

            <h2 class="mb-4 text-xl font-semibold tracking-tight">Small team, big ambitions</h2>

            <p class="text-sm text-muted-foreground">
                We're a tight-knit group of designers, engineers, and dreamers building the future of
                work. Every voice matters here.
            </p>
        </div>

        <div class="px-6 py-6">
            <div class="flex flex-wrap items-center justify-center gap-4">
                @foreach (var member in _team)
                {
                    <div class="group text-center">
                        <AvatarCn Class="mx-auto h-16 w-16 border-2 border-background shadow-md transition-transform group-hover:-translate-y-1">
                            <AvatarFallbackCn Class="bg-muted/50 text-sm font-medium">
                                @member.Initials
                            </AvatarFallbackCn>
                        </AvatarCn>
                        <div class="mt-2 opacity-0 transition-opacity group-hover:opacity-100">
                            <p class="text-sm font-medium">@member.Name</p>
                            <p class="text-xs text-muted-foreground">@member.Role</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-6 py-4 text-center">
            <p class="text-sm text-muted-foreground">
                Want to join us?
                <a class="font-medium text-foreground hover:underline" href="#">
                    We're hiring
                </a>
            </p>
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Name, string Role, string Initials);

    private readonly List<TeamMember> _team =
    [
        new("Sarah Chen", "CEO", "SC"),
        new("Marcus Johnson", "CTO", "MJ"),
        new("Emily Park", "Design", "EP"),
        new("David Kim", "Engineering", "DK"),
        new("Lisa Wang", "Product", "LW"),
    ];
}
