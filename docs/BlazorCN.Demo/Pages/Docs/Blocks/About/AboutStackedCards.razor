@* ============================================================
   Block: about-stacked-cards
   Title: About Stacked Cards
   Description: About section with stacked cards and gradient background
   Long Description: About section with split intro and scrolling logos
   Dependencies: BadgeCn
   Source: original/blocks/about/about-stacked-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b bg-muted/50 px-6 py-5 text-center">
            <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                How We Work
            </BadgeCn>
            <h2 class="text-xl font-semibold tracking-tight">Our approach</h2>
        </div>

        @* Stacked cards *@
        <div class="px-6 py-5">
            <div class="space-y-3">
                @foreach (var card in _cards)
                {
                    <div class="rounded-lg border bg-muted/50 p-4">
                        <div class="flex gap-4">
                            <span class="text-2xl font-semibold tabular-nums text-muted-foreground/30">
                                @card.Number
                            </span>
                            <div>
                                <h3 class="mb-1 text-sm font-medium">@card.Title</h3>
                                <p class="text-sm text-muted-foreground">@card.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record CardItem(string Number, string Title, string Description);

    private readonly List<CardItem> _cards =
    [
        new("01", "We start with why",
            "Every project begins with understanding the problem deeply before writing a single line of code."),
        new("02", "We ship relentlessly",
            "Small, frequent releases beat big, delayed launches. Our users see improvements weekly."),
        new("03", "We listen obsessively",
            "Our roadmap is shaped by real feedback from real users, not hunches or trends."),
    ];
}
