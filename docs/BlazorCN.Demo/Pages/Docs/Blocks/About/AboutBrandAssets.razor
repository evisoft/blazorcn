@* ============================================================
   Block: about-brand-assets
   Title: About Brand Assets
   Description: Brand guidelines preview showing logo usage, color palette, typography, and downloadable brand kit for press and partners.
   Long Description: Make it easy for press and partners to use your brand correctly. This block displays logo variations, brand colors, typography, and offers a downloadable brand kit. Perfect for press pages and partner resource centers.
   Dependencies: ButtonCn
   Source: original/blocks/about/about-brand-assets.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <h2 class="text-xl font-semibold tracking-tight">Brand Assets</h2>
                    <p class="mt-1 text-sm text-muted-foreground">
                        Logo, colors, and typography for press and partners
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-2">
                    <LucideIconCn Name="download" Size="16" Class="size-4" />
                    Download Brand Kit
                </ButtonCn>
            </div>
        </div>

        @* Logo Variations *@
        <div class="border-b px-6 py-5">
            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Logo Variations
            </span>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
                @foreach (var logo in _logoVariations)
                {
                    <div class="rounded-md border p-4">
                        <div class="flex h-16 items-center justify-center rounded-md bg-muted/50">
                            <div class="text-sm font-semibold">LOGO</div>
                        </div>
                        <div class="mt-3">
                            <h3 class="text-sm font-medium">@logo.Name</h3>
                            <p class="mt-0.5 text-xs text-muted-foreground">@logo.Usage</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Color Palette *@
        <div class="border-b px-6 py-5">
            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Color Palette
            </span>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
                @foreach (var color in _colorPalette)
                {
                    <div class="rounded-md border p-4">
                        <div class="flex items-start gap-3">
                            <div class="size-12 shrink-0 rounded-md border"
                                 style="@($"background-color: {color.Hex}")"></div>
                            <div class="min-w-0 flex-1">
                                <h4 class="text-sm font-medium">@color.Name</h4>
                                <p class="mt-0.5 font-mono text-xs text-muted-foreground">@color.Hex</p>
                                <p class="mt-1 text-xs text-muted-foreground">@color.Usage</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Typography *@
        <div class="border-b px-6 py-5">
            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Typography
            </span>
            <div class="mt-4 space-y-3">
                @foreach (var type in _typography)
                {
                    <div class="rounded-md bg-muted/50 p-4">
                        <div class="flex flex-wrap items-baseline justify-between gap-2">
                            <div>
                                <h4 class="text-sm font-medium">@type.Name</h4>
                                <p class="mt-0.5 text-xs text-muted-foreground">
                                    @type.Font — Weights: @type.Weights
                                </p>
                            </div>
                            <div class="text-lg font-medium" style="@($"font-family: {type.Font}")">
                                Aa
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Usage Guidelines *@
        <div class="px-6 py-5">
            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Usage Guidelines
            </span>
            <div class="mt-4 space-y-2 text-sm">
                @foreach (var guideline in _guidelines)
                {
                    <div class="flex items-start gap-2">
                        <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                        <p class="text-muted-foreground">@guideline</p>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t bg-muted/30 px-6 py-4">
            <p class="text-xs text-muted-foreground">
                Questions about brand usage?
                <button type="button" class="text-foreground underline-offset-2 hover:underline">
                    Contact our brand team
                </button>
            </p>
        </div>
    </div>
</section>

@code {
    private record LogoVariation(string Name, string Usage);
    private record ColorItem(string Name, string Hex, string Usage);
    private record TypographyItem(string Name, string Font, string Weights);

    private readonly List<LogoVariation> _logoVariations =
    [
        new("Wordmark", "Primary logo for light backgrounds"),
        new("Wordmark (Dark)", "Primary logo for dark backgrounds"),
        new("Icon", "Social media, favicons, small spaces"),
        new("Icon (Monochrome)", "Single-color applications"),
    ];

    private readonly List<ColorItem> _colorPalette =
    [
        new("Primary", "#000000", "Text, borders, primary UI"),
        new("Secondary", "#6B7280", "Muted text, secondary elements"),
        new("Accent", "#3B82F6", "Links, active states"),
        new("Background", "#FFFFFF", "Page backgrounds, cards"),
    ];

    private readonly List<TypographyItem> _typography =
    [
        new("Headings", "Inter", "600, 700"),
        new("Body", "Inter", "400, 500"),
        new("Code", "JetBrains Mono", "400, 500"),
    ];

    private readonly string[] _guidelines =
    [
        "Always use official logo files. Don't recreate, modify, or distort.",
        "Maintain minimum clear space of 1x the height of the logo on all sides.",
        "Use wordmark for most applications. Icon only when space is limited.",
        "Don't place logo on busy backgrounds or low-contrast colors.",
    ];
}
