@* ============================================================
   Block: about-culture-behaviors
   Title: About Culture Behaviors
   Description: Company culture behaviors do and don't section for React employer branding pages
   Long Description: Showcase your company culture through specific behaviors with this do/don't component for Next.js about pages. Features a clean two-column layout with check and X icons contrasting positive behaviors against anti-patterns. Built with Tailwind CSS and Lucide icons. Concrete behaviors are more believable than abstract values—perfect for employer branding, career pages, and companies recruiting talent who want to attract the right cultural fits.
   Dependencies: None
   Source: original/blocks/about/about-culture-behaviors.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">What we do (and don't do)</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Culture isn't what we say — it's what we do every day.
            </p>
        </div>

        @* Two columns *@
        <div class="grid gap-8 p-6 sm:grid-cols-2">
            @* We do *@
            <div>
                <h3 class="mb-4 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    What we do
                </h3>
                <ul class="space-y-3">
                    @foreach (var item in _weDo)
                    {
                        <li class="flex items-center gap-3 text-sm">
                            <LucideIconCn Name="check" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            @item
                        </li>
                    }
                </ul>
            </div>

            @* We don't *@
            <div>
                <h3 class="mb-4 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    What we don't do
                </h3>
                <ul class="space-y-3">
                    @foreach (var item in _weDont)
                    {
                        <li class="flex items-center gap-3 text-sm text-muted-foreground">
                            <LucideIconCn Name="x" Size="16" Class="size-4 shrink-0" />
                            @item
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</section>

@code {
    private readonly string[] _weDo =
    [
        "Ship fast, iterate faster",
        "Default to transparency",
        "Give direct feedback kindly",
        "Take ownership, not blame",
        "Celebrate others' wins loudly",
    ];

    private readonly string[] _weDont =
    [
        "Wait for permission to act",
        "Hoard information",
        "Sugarcoat problems",
        "Point fingers when things break",
        "Compete with teammates",
    ];
}
