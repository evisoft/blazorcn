@* ============================================================
   Block: about-team-grid
   Title: About Team Grid
   Description: About section with team grid and department filters
   Long Description: About section with team roles breakdown
   Dependencies: AvatarCn, BadgeCn, ButtonCn
   Source: original/blocks/about/about-team-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5 text-center">
            <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                Our Team
            </BadgeCn>

            <h2 class="mb-2 text-xl font-semibold tracking-tight">
                The people behind the product
            </h2>

            <p class="text-sm text-muted-foreground">
                A diverse team of makers, thinkers, and doers committed to building something
                meaningful.
            </p>
        </div>

        <div class="border-b p-6">
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var member in _team)
                {
                    <div class="group flex flex-col items-center text-center">
                        <AvatarCn Class="mb-3 h-20 w-20 border-2 border-background shadow-lg transition-transform group-hover:scale-105">
                            <AvatarFallbackCn Class="bg-muted/50 text-sm font-medium">
                                @member.Initials
                            </AvatarFallbackCn>
                        </AvatarCn>
                        <h3 class="text-sm font-medium">@member.Name</h3>
                        <p class="text-sm text-muted-foreground">@member.Role</p>
                    </div>
                }
            </div>
        </div>

        <div class="px-6 py-5 text-center">
            <ButtonCn Class="gap-2" Variant="ButtonVariant.Outline">
                View Full Team
                <LucideIconCn Name="arrow-right" Size="16" Class="h-4 w-4" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Name, string Role, string Initials);

    private readonly List<TeamMember> _team =
    [
        new("Alex Chen", "CEO & Co-founder", "AC"),
        new("Maria Santos", "CTO & Co-founder", "MS"),
        new("James Wilson", "Head of Design", "JW"),
        new("Priya Patel", "Lead Engineer", "PP"),
        new("David Kim", "Product Manager", "DK"),
        new("Sophie Brown", "Head of Marketing", "SB"),
    ];
}
