@* ============================================================
   Block: about-expertise-grid
   Title: AboutExpertiseGrid
   Description: An expertise grid block for React and Next.js with asymmetric bento layout, nested skill data with years and project counts, semantic color coding by domain, and scale-up entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-expertise-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-5 py-4">
            <h2 class="text-sm font-medium">Areas of expertise</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                12+ years of delivery across 8 disciplines, 1,073 projects shipped
            </p>
        </div>

        @* Bento grid *@
        <div class="grid grid-cols-1 gap-px bg-muted/50 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var area in _expertiseAreas)
            {
                <div class="@Cn.Merge("border-l-2 bg-card p-4", _domainAccents[area.Domain], area.IsFeatured ? "sm:col-span-2" : "")">
                    <div class="flex items-start justify-between gap-2">
                        <h3 class="text-sm font-medium">@area.Name</h3>
                        <span class="shrink-0 text-[10px] tabular-nums text-muted-foreground">
                            @(area.Years)yr
                        </span>
                    </div>

                    <p class="mt-1.5 text-xs leading-5 text-muted-foreground">@area.Description</p>

                    @* Stats *@
                    <div class="mt-3 flex items-center gap-3">
                        <span class="text-xs text-muted-foreground">
                            <span class="font-medium tabular-nums text-foreground">@area.ProjectCount</span> projects
                        </span>
                    </div>

                    @* Skills *@
                    <div class="mt-2.5 flex flex-wrap gap-1">
                        @foreach (var skill in area.Skills)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="px-1.5 py-0 text-[10px] font-normal">
                                @skill
                            </BadgeCn>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer summary *@
        <div class="border-t px-5 py-3">
            <div class="flex items-center gap-4 text-xs text-muted-foreground">
                <span>
                    <span class="font-medium tabular-nums text-foreground">8</span> disciplines
                </span>
                <span class="size-0.5 rounded-full bg-muted-foreground/50"></span>
                <span>
                    <span class="font-medium tabular-nums text-foreground">77</span> combined years
                </span>
                <span class="size-0.5 rounded-full bg-muted-foreground/50"></span>
                <span>
                    <span class="font-medium tabular-nums text-foreground">1,073</span> projects
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record ExpertiseArea(
        string Id, string Name, string Domain, int Years,
        int ProjectCount, string Description, string[] Skills, bool IsFeatured);

    private static readonly Dictionary<string, string> _domainAccents = new()
    {
        ["engineering"]    = "border-l-blue-500",
