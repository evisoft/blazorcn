@* ============================================================
   Block: about-sla-commitments
   Title: About Sla Commitments
   Description: Service level agreement commitments showing uptime guarantees, response times, and support hours with measurable targets
   Long Description: Build confidence with clear service level agreements. This component displays your uptime guarantees, support response times, and resolution commitments, helping customers understand exactly what they can expect from your service.
   Dependencies: None
   Source: original/blocks/about/about-sla-commitments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Service Level Agreements</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Our commitments to reliability and support
            </p>
        </div>

        <div class="p-6">
            <div class="space-y-4">
                @foreach (var commitment in _commitments)
                {
                    <div class="rounded-md border p-4">
                        <div class="flex items-start gap-4">
                            <div class="mt-1">
                                <LucideIconCn Name="@commitment.Icon" Size="20" Class="size-5 text-muted-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-baseline gap-3">
                                    <h3 class="font-medium text-sm">@commitment.Metric</h3>
                                    <span class="font-semibold text-2xl tabular-nums">
                                        @commitment.Target
                                    </span>
                                </div>
                                <p class="mt-2 text-muted-foreground text-sm">@commitment.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-6 rounded-md bg-muted/50 p-4">
                <div class="flex items-start gap-3">
                    <div class="min-w-0 flex-1">
                        <h3 class="font-medium text-sm">SLA Credit Policy</h3>
                        <p class="mt-1 text-muted-foreground text-sm">
                            If we fail to meet our uptime guarantee, you'll receive service credits
                            automatically applied to your next invoice. 99.9% uptime = 10% credit, 99% uptime
                            = 25% credit, below 99% = 50% credit.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SlaCommitment(string Icon, string Metric, string Target, string Description);

    private readonly List<SlaCommitment> _commitments =
    [
        new("activity", "Uptime Guarantee", "99.99%",
            "Guaranteed monthly uptime with SLA credits for any downtime. Monitored 24/7 across multiple data centers with automatic failover."),
        new("clock", "Initial Response Time", "< 1 hour",
            "First response from support team for priority tickets. Enterprise customers receive dedicated Slack channel with sub-15-minute response."),
        new("check-circle", "Issue Resolution Time", "< 24 hours",
            "Average time to resolve critical issues. We prioritize bugs affecting availability and data integrity. Non-critical issues resolved within 72 hours."),
        new("headphones", "Support Coverage", "24/7/365",
            "Round-the-clock support for all customers. Live chat and email support always available. Phone support for Enterprise tier during business hours."),
    ];
}
