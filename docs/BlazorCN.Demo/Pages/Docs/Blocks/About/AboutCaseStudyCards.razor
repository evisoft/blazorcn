@* ============================================================
   Block: about-case-study-cards
   Title: About Case Study Cards
   Description: Display customer case studies with challenges, solutions, and measurable results in a clean card layout
   Long Description: Showcase real-world success stories with detailed case study cards. Each card presents the customer's challenge, your solution approach, and quantifiable business impact—perfect for building credibility and demonstrating proven results.
   Dependencies: BadgeCn
   Source: original/blocks/about/about-case-study-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Case Studies</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Real results from companies we've partnered with
            </p>
        </div>

        <div class="grid gap-6 p-6 md:grid-cols-1">
            @foreach (var study in _caseStudies)
            {
                <div class="overflow-hidden rounded-md border bg-card">
                    <div class="border-b px-4 py-3">
                        <div class="flex items-center justify-between">
                            <h3 class="text-sm font-medium">@study.Company</h3>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                @study.Industry
                            </BadgeCn>
                        </div>
                    </div>
                    <div class="space-y-4 px-4 py-4">
                        <div>
                            <p class="mb-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                Challenge
                            </p>
                            <p class="text-sm">@study.Challenge</p>
                        </div>
                        <div>
                            <p class="mb-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                Solution
                            </p>
                            <p class="text-sm">@study.Solution</p>
                        </div>
                        <div class="flex items-center justify-between rounded-md bg-muted/50 p-3">
                            <div>
                                <p class="mb-0.5 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                    @study.ResultMetric
                                </p>
                                <p class="text-2xl font-semibold tabular-nums">@study.ResultValue</p>
                            </div>
                            <LucideIconCn Name="arrow-right" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CaseStudy(string Company, string Industry, string Challenge, string Solution, string ResultMetric, string ResultValue);

    private readonly List<CaseStudy> _caseStudies =
    [
        new("CloudScale Systems", "Enterprise SaaS",
            "Database queries were taking 8+ seconds during peak hours, causing customer complaints and support tickets. Their monolithic architecture couldn't scale with growth.",
            "Implemented read replicas with intelligent query routing, introduced Redis caching layer, and optimized N+1 queries across the application.",
            "Query response time", "92% faster"),
        new("RetailHub", "E-commerce",
            "Cart abandonment rate was 73% due to slow checkout experience and mobile performance issues. Revenue was plateauing despite increased traffic.",
            "Redesigned checkout flow with progressive form validation, optimized image delivery with WebP and lazy loading, and reduced JavaScript bundle by 64%.",
            "Conversion rate", "+127% increase"),
        new("FinTech Insights", "Financial Services",
            "Manual report generation was taking analysts 6-8 hours daily. Data inconsistencies across departments led to conflicting metrics and delayed decisions.",
            "Built automated data pipeline with real-time syncing, created unified dashboard with role-based views, and implemented scheduled report generation.",
            "Time saved per week", "34 hours"),
    ];
}
