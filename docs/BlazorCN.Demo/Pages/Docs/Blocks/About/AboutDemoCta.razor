@* ============================================================
   Block: about-demo-cta
   Title: About Demo Cta
   Description: Book a demo call-to-action with value propositions and next available slot social proof for increased conversions.
   Long Description: A conversion-optimized demo booking section that highlights key benefits and builds urgency with next available slot information. Ideal for SaaS products and B2B services.
   Dependencies: ButtonCn
   Source: original/blocks/about/about-demo-cta.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-6 py-8">
            <div class="mx-auto max-w-2xl text-center">
                <h2 class="text-xl font-semibold tracking-tight">See it in action</h2>
                <p class="mt-2 text-sm text-muted-foreground">
                    Schedule a personalized demo with our team. We'll walk you through the platform and
                    answer all your questions.
                </p>

                <div class="mt-6 space-y-3">
                    @foreach (var benefit in _benefits)
                    {
                        <div class="flex items-start gap-3 text-left text-sm">
                            <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                            <span>@benefit</span>
                        </div>
                    }
                </div>

                <div class="mt-8">
                    <ButtonCn Size="ButtonSize.Lg" Class="h-10">
                        <LucideIconCn Name="calendar" Size="16" Class="mr-2 size-4" />
                        Schedule Demo
                    </ButtonCn>
                </div>

                <div class="mt-6 flex items-center justify-center gap-2 text-xs text-muted-foreground">
                    <div class="size-2 rounded-full bg-emerald-500"></div>
                    <span>Next available slot: Tomorrow at 2:00 PM EST</span>
                </div>
            </div>
        </div>

        <div class="border-t bg-muted/50 px-6 py-4">
            <div class="mx-auto grid max-w-2xl gap-6 text-center sm:grid-cols-3">
                <div>
                    <div class="text-2xl font-semibold tabular-nums">30 min</div>
                    <div class="mt-1 text-xs text-muted-foreground">Average demo time</div>
                </div>
                <div>
                    <div class="text-2xl font-semibold tabular-nums">1,200+</div>
                    <div class="mt-1 text-xs text-muted-foreground">Demos completed</div>
                </div>
                <div>
                    <div class="text-2xl font-semibold tabular-nums">4.9/5</div>
                    <div class="mt-1 text-xs text-muted-foreground">Average rating</div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private readonly string[] _benefits =
    [
        "See the platform in action with your use case",
        "Get answers to technical and pricing questions",
        "Receive a personalized implementation roadmap",
    ];
}
