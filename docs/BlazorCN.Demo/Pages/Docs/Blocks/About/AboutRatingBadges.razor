@* ============================================================
   Block: about-rating-badges
   Title: About Rating Badges
   Description: Display third-party review platform ratings with scores and review counts
   Long Description: Build instant credibility with verified third-party ratings. This badge layout showcases your reputation across multiple review platforms—essential social proof for converting visitors who research before they buy.
   Dependencies: None
   Source: original/blocks/about/about-rating-badges.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Trusted by Thousands</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Rated highly across independent review platforms
            </p>
        </div>
        <div class="grid gap-4 p-6 sm:grid-cols-2">
            @foreach (var rating in _ratings)
            {
                <div class="flex items-center gap-4 rounded-md border bg-card p-4">
                    <div class="flex-1">
                        <div class="mb-2 flex items-center justify-between">
                            <p class="font-medium text-sm">@rating.Platform</p>
                            @if (!string.IsNullOrEmpty(rating.Badge))
                            {
                                <div class="flex items-center gap-1 text-amber-600">
                                    <LucideTrophyCn Size="12" Class="size-3" />
                                    <span class="text-xs">@rating.Badge</span>
                                </div>
                            }
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="flex items-center gap-0.5">
                                @{
                                    var fullStars = (int)Math.Floor(rating.Score);
                                    var hasHalf = rating.Score % 1 >= 0.3 && rating.Score % 1 < 0.8;
                                    var emptyStars = rating.MaxScore - fullStars - (hasHalf ? 1 : 0);
                                }
                                @for (var s = 0; s < fullStars; s++)
                                {
                                    <LucideStarCn Size="16" Class="size-4 fill-amber-500 text-amber-500" />
                                }
                                @if (hasHalf)
                                {
                                    <div class="relative">
                                        <LucideStarCn Size="16" Class="size-4 text-muted-foreground/30" />
                                        <div class="absolute inset-0 overflow-hidden" style="width: 50%">
                                            <LucideStarCn Size="16" Class="size-4 fill-amber-500 text-amber-500" />
                                        </div>
                                    </div>
                                }
                                @for (var s = 0; s < emptyStars; s++)
                                {
                                    <LucideStarCn Size="16" Class="size-4 text-muted-foreground/30" />
                                }
                            </div>
                            <span class="font-semibold tabular-nums text-sm">
                                @rating.Score.ToString("F1")
                            </span>
                        </div>
                        @if (rating.ReviewCount > 0)
                        {
                            <p class="mt-1 text-muted-foreground text-xs">
                                @rating.ReviewCount.ToString("N0") reviews
                            </p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record RatingItem(string Platform, double Score, int MaxScore, int ReviewCount, string? Badge = null);

    private readonly List<RatingItem> _ratings =
    [
        new("G2", 4.8, 5, 342),
        new("Capterra", 4.7, 5, 218),
        new("Trustpilot", 4.9, 5, 1247),
        new("Product Hunt", 5, 5, 0, "#1 Product of the Day"),
    ];
}
