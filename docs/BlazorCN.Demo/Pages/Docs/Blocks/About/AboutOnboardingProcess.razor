@* ============================================================
   Block: about-onboarding-process
   Title: About Onboarding Process
   Description: A new hire onboarding timeline showing week-by-week activities, buddy system, and milestone checks
   Long Description: Set clear expectations for new hires with this comprehensive onboarding timeline. Shows weekly activities, support systems, and progression from setup to full productivity.
   Dependencies: None
   Source: original/blocks/about/about-onboarding-process.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Onboarding Process</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Your first four weeks: from setup to full productivity with structured activities and
                support systems
            </p>
        </div>

        <div class="divide-y">
            @for (var i = 0; i < _weeks.Count; i++)
            {
                var week = _weeks[i];
                <div class="px-6 py-5">
                    <div class="flex items-start gap-4">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted/50 font-semibold text-sm tabular-nums">
                            W@(week.WeekNum)
                        </div>

                        <div class="min-w-0 flex-1">
                            <h3 class="font-medium text-sm">@week.Title</h3>

                            <div class="mt-3 space-y-2">
                                @foreach (var activity in week.Activities)
                                {
                                    <div class="flex items-start gap-2">
                                        <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                                        <span class="text-muted-foreground text-sm">@activity</span>
                                    </div>
                                }
                            </div>

                            <div class="mt-3 rounded-md bg-muted/50 px-3 py-2">
                                <div class="flex items-center gap-2">
                                    <LucideIconCn Name="rocket" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                                        Milestone
                                    </span>
                                </div>
                                <div class="mt-1 font-medium text-sm">@week.Milestone</div>
                            </div>
                        </div>
                    </div>

                    @if (i < _weeks.Count - 1)
                    {
                        <div class="ml-5 mt-4 h-6 border-l-2 border-dashed border-muted-foreground/20"></div>
                    }
                </div>
            }
        </div>

        <div class="border-t p-6">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <h3 class="font-medium text-sm">Support Systems</h3>
            </div>

            <div class="grid gap-3 sm:grid-cols-3">
                @foreach (var system in _supportSystems)
                {
                    <div class="rounded-md bg-muted/50 p-4">
                        <div class="font-medium text-sm">@system.Title</div>
                        <div class="mt-1 text-muted-foreground text-sm">@system.Description</div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-6 py-5">
            <h3 class="mb-3 font-medium text-sm">Before You Start</h3>

            <div class="space-y-2">
                <div class="flex items-start gap-3">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                    <div class="text-muted-foreground text-sm">
                        <span class="font-medium text-foreground">Welcome package ships:</span> Laptop,
                        monitor, accessories, and swag arrive at your address before day 1
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                    <div class="text-muted-foreground text-sm">
                        <span class="font-medium text-foreground">Access provisioned:</span> Email,
                        Slack, GitHub, and core tools ready on your first morning
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                    <div class="text-muted-foreground text-sm">
                        <span class="font-medium text-foreground">Buddy assigned:</span> You'll meet
                        your onboarding buddy in your first hour
                    </div>
                </div>
            </div>
        </div>

        <div class="border-t bg-muted/30 px-6 py-4">
            <p class="text-muted-foreground text-sm">
                Onboarding doesn't end at 30 days. Structured support continues through 90 days with
                regular check-ins and feedback loops.
            </p>
        </div>
    </div>
</section>

@code {
    private record WeekItem(int WeekNum, string Title, string[] Activities, string Milestone);
    private record SupportSystem(string Title, string Description);

    private readonly List<WeekItem> _weeks =
    [
        new(1, "Setup & Orientation",
            ["Hardware and accounts provisioned", "Team introductions and org chart walkthrough", "Codebase tour and local development setup", "First commit: Fix a good first issue", "Lunch with your onboarding buddy"],
            "Development environment running"),
        new(2, "Context Building",
            ["Product walkthrough and user personas", "Architecture deep dive sessions", "Shadow customer support calls", "Ship your first small feature", "1:1 with manager to review progress"],
            "Understand product and customers"),
        new(3, "Independent Contributions",
            ["Own a feature from design to deployment", "Participate in code reviews", "Attend sprint planning and retrospective", "Documentation improvement task", "Coffee chats with cross-functional partners"],
            "Ship end-to-end feature independently"),
        new(4, "Full Team Integration",
            ["Lead a feature planning discussion", "On-call shadowing with senior engineer", "Present learnings to team", "30-day feedback session with manager", "Propose first improvement to process or code"],
            "Operating at full team velocity"),
    ];

    private readonly List<SupportSystem> _supportSystems =
    [
        new("Onboarding Buddy", "Peer mentor assigned for first 90 days. Daily check-ins week 1, weekly after that."),
        new("Manager 1:1s", "Weekly sessions focused on questions, feedback, and removing blockers."),
        new("New Hire Cohort", "Join other recent hires for shared learning sessions and peer support."),
    ];
}
