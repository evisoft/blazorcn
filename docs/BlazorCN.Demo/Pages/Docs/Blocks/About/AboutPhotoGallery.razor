@* ============================================================
   Block: about-photo-gallery
   Title: About Photo Gallery
   Description: Team and office photo grid with captions showing company culture, events, and workspace in a clean gallery layout.
   Long Description: Bring your team and culture to life. This block displays photos from team events, office spaces, and company moments in a responsive grid with captions. Perfect for humanizing your about page and showing what life at your company looks like.
   Dependencies: None
   Source: original/blocks/about/about-photo-gallery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Team &amp; Culture</h2>
            <p class="mt-1 text-muted-foreground text-sm">Moments from our journey together</p>
        </div>

        @* Photo Grid *@
        <div class="p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                @for (var i = 0; i < _photos.Count; i++)
                {
                    var photo = _photos[i];
                    <div class="overflow-hidden rounded-md border">
                        @* Photo Placeholder *@
                        <div class="flex aspect-[4/3] items-center justify-center bg-muted/50">
                            <div class="text-center">
                                <div class="font-mono text-muted-foreground text-xs">Photo @(i + 1)</div>
                                <div class="mt-1 font-medium text-muted-foreground text-sm">
                                    @photo.Caption
                                </div>
                            </div>
                        </div>

                        @* Caption *@
                        <div class="border-t px-4 py-3">
                            <h3 class="font-medium text-sm">@photo.Caption</h3>
                            <div class="mt-1 flex flex-wrap items-center gap-2 text-muted-foreground text-xs">
                                <span>@photo.Location</span>
                                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                                <span>@photo.Date</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t bg-muted/30 px-6 py-4">
            <p class="text-muted-foreground text-xs">
                Want to see more?
                <button type="button" class="text-foreground underline-offset-2 hover:underline">
                    Follow us on social media
                </button>
                for regular updates.
            </p>
        </div>
    </div>
</section>

@code {
    private record Photo(string Caption, string Location, string Date);

    private readonly List<Photo> _photos =
    [
        new("Team Retreat 2025", "Lake Tahoe, California", "September 2025"),
        new("Office Opening Ceremony", "Austin, Texas", "March 2024"),
        new("Hackathon Finals", "San Francisco HQ", "November 2025"),
        new("Series A Celebration", "Virtual", "September 2024"),
        new("Community Meetup", "New York City", "June 2025"),
        new("Product Launch Party", "San Francisco HQ", "January 2026"),
    ];
}
