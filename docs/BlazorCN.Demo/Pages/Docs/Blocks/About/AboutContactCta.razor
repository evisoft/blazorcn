@* ============================================================
   Block: about-contact-cta
   Title: About Contact Cta
   Description: Clean contact section with multiple contact methods including email, phone, address, and social media links in a two-column layout.
   Long Description: A professional contact section that presents multiple communication channels in a clean, accessible format. Perfect for about pages that need to provide comprehensive contact information without overwhelming visitors.
   Dependencies: ButtonCn
   Source: original/blocks/about/about-contact-cta.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid gap-0 md:grid-cols-2">
            <div class="border-b px-6 py-8 md:border-b-0 md:border-r">
                <h2 class="text-xl font-semibold tracking-tight">Get in touch</h2>
                <p class="mt-2 text-sm text-muted-foreground">
                    Have questions? We're here to help. Reach out through any of these channels and we'll
                    get back to you within 24 hours.
                </p>
                <div class="mt-6 space-y-4">
                    @foreach (var method in _contactMethods)
                    {
                        <a href="@method.Href"
                           class="flex items-start gap-3 rounded-md p-3 transition-colors hover:bg-muted/50">
                            <LucideIconCn Name="@method.Icon" Size="20" Class="mt-0.5 size-5 shrink-0 text-muted-foreground" />
                            <div class="min-w-0">
                                <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                    @method.Label
                                </div>
                                <div class="mt-1 text-sm font-medium">@method.Value</div>
                            </div>
                        </a>
                    }
                </div>
            </div>

            <div class="px-6 py-8">
                <h3 class="text-sm font-medium">Follow us</h3>
                <p class="mt-2 text-sm text-muted-foreground">
                    Stay updated with our latest news and updates.
                </p>
                <div class="mt-4 flex flex-wrap gap-2">
                    @foreach (var link in _socialLinks)
                    {
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8">
                            @link.Name
                        </ButtonCn>
                    }
                </div>

                <div class="mt-8">
                    <h3 class="text-sm font-medium">Business hours</h3>
                    <div class="mt-3 space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-muted-foreground">Monday - Friday</span>
                            <span class="font-medium tabular-nums">9:00 - 18:00</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-muted-foreground">Saturday</span>
                            <span class="font-medium tabular-nums">10:00 - 16:00</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-muted-foreground">Sunday</span>
                            <span class="font-medium">Closed</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ContactMethod(string Icon, string Label, string Value, string Href);
    private record SocialLink(string Name, string Href);

    private readonly List<ContactMethod> _contactMethods =
    [
        new("mail", "Email", "hello@@company.com", "mailto:hello@@company.com"),
        new("phone", "Phone", "+1 (555) 123-4567", "tel:+15551234567"),
        new("map-pin", "Office", "123 Market St, San Francisco, CA 94103", "https://maps.google.com/?q=123+Market+St+San+Francisco+CA"),
    ];

    private readonly List<SocialLink> _socialLinks =
    [
        new("Twitter", "https://twitter.com/company"),
        new("LinkedIn", "https://linkedin.com/company/company"),
        new("GitHub", "https://github.com/company"),
    ];
}
