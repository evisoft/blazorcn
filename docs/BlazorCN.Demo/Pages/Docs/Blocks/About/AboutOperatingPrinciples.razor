@* ============================================================
   Block: about-operating-principles
   Title: About Operating Principles
   Description: Numbered operating principles section with actionable guidelines for React company pages
   Long Description: Define how you work with this operating principles component for Next.js about pages. Features a numbered list of principles with titles and descriptions that guide daily decisions. Built with Tailwind CSS. Explicit principles create alignment across teams and help candidates self-select during hiring. Perfect for fast-growing startups establishing culture, remote teams needing shared norms, and companies that want decision-making clarity.
   Dependencies: None
   Source: original/blocks/about/about-operating-principles.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="mb-2 text-xl font-semibold tracking-tight">The rules we live by</h2>
            <p class="text-sm text-muted-foreground">
                These principles guide every decision, from product features to hiring.
            </p>
        </div>

        @* Principles *@
        <div class="px-6 py-5">
            <div class="space-y-4">
                @foreach (var principle in _principles)
                {
                    <div class="flex items-start gap-4">
                        <span class="flex size-8 shrink-0 items-center justify-center rounded-full border font-mono text-xs">
                            @principle.Number
                        </span>
                        <div class="flex-1 pt-0.5">
                            <h3 class="text-sm font-medium">@principle.Title</h3>
                            <p class="mt-1 text-sm text-muted-foreground">@principle.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record PrincipleItem(string Number, string Title, string Description);

    private readonly List<PrincipleItem> _principles =
    [
        new("01", "Customers over metrics", "When in doubt, do what's right for the customer, even if it hurts short-term numbers."),
        new("02", "Progress over perfection", "Ship early, learn fast. A good solution today beats a perfect solution next month."),
        new("03", "Clarity over consensus", "Disagree openly, then commit fully. Endless debate is worse than imperfect decisions."),
        new("04", "Ownership over territory", "If you see a problem, fix it. Don't wait for someone else or ask whose job it is."),
        new("05", "Learning over knowing", "The best ideas come from curiosity, not expertise. Stay humble, stay hungry."),
    ];
}
