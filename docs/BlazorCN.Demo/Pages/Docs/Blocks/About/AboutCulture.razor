@* ============================================================
   Block: about-culture
   Title: About Culture
   Description: Company culture and work environment section for React career pages
   Long Description: Showcase your craftsmanship principles and attention to detail with specific examples of how you build
   Dependencies: ButtonCn
   Source: original/blocks/about/about-culture.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">
                Built for people who do their best work their way
            </h2>
            <p class="mt-1 text-sm text-muted-foreground">
                We've designed our culture around trust, flexibility, and outcomes over hours.
            </p>
        </div>

        @* Culture grid *@
        <div class="grid gap-6 p-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var point in _culturePoints)
            {
                <div class="flex gap-4">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-full border">
                        <LucideIconCn Name="@point.Icon" Size="20" Class="size-5 text-muted-foreground" />
                    </div>
                    <div>
                        <h3 class="text-sm font-medium">@point.Title</h3>
                        <p class="mt-1 text-sm text-muted-foreground leading-relaxed">
                            @point.Description
                        </p>
                    </div>
                </div>
            }
        </div>

        @* CTA *@
        <div class="border-t px-6 py-5 text-center">
            <ButtonCn Variant="ButtonVariant.Outline">View Open Positions</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record CulturePoint(string Icon, string Title, string Description);

    private readonly List<CulturePoint> _culturePoints =
    [
        new("globe", "Remote-first", "Work from anywhere. We're distributed across 15 countries."),
        new("clock", "Async by default", "No mandatory meetings. Deep work is protected time."),
        new("heart", "Generous benefits", "Health, dental, vision, plus mental health support."),
        new("laptop", "Your setup, funded", "$3,000 equipment budget to build your ideal workspace."),
        new("users", "Team offsites", "Quarterly gatherings to connect in person."),
        new("trending-up", "Growth focus", "$2,000/year learning budget plus promotion paths."),
    ];
}
