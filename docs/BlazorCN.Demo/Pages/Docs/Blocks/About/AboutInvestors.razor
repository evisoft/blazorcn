@* ============================================================
   Block: about-investors
   Title: About Investors
   Description: Investor logos and funding rounds section for React startup about pages
   Long Description: Build credibility with this investors component for Next.js about pages. Features investor names, total funding raised, and a funding timeline showing round progression. Built with Tailwind CSS. Investor logos and funding milestones signal traction and validation to visitors, customers, and potential hires. Perfect for venture-backed startups wanting to leverage social proof from well-known VCs and angels.
   Dependencies: None
   Source: original/blocks/about/about-investors.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">$50M+ raised from the best</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                We're proud to be backed by world-class investors who share our vision.
            </p>
        </div>

        @* Investor names *@
        <div class="border-b px-6 py-5">
            <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
                @foreach (var investor in _investors)
                {
                    <span class="text-sm font-medium text-foreground/80">@investor</span>
                }
            </div>
        </div>

        @* Funding timeline *@
        <div class="px-6 py-5">
            <div class="grid grid-cols-3 gap-6">
                @foreach (var round in _rounds)
                {
                    <div class="text-center">
                        <p class="text-2xl font-semibold tabular-nums">@round.Amount</p>
                        <p class="mt-1 text-sm text-muted-foreground">
                            @round.Round · @round.Year
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record FundingRound(string Amount, string Round, string Year);

    private readonly string[] _investors = ["Sequoia", "a16z", "Accel", "Index", "Greylock"];

    private readonly List<FundingRound> _rounds =
    [
        new("$2M", "Seed", "2019"),
        new("$15M", "Series A", "2021"),
        new("$35M", "Series B", "2023"),
    ];
}
