@* ============================================================
   Block: about-team-breakdown
   Title: About Team Breakdown
   Description: About section with team roles breakdown
   Long Description: About section with centered intro and team member avatars
   Dependencies: BadgeCn
   Source: original/blocks/about/about-team-breakdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5 text-center">
            <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                Our Team
            </BadgeCn>

            <h2 class="mb-2 text-xl font-semibold tracking-tight">62 people, one mission</h2>

            <p class="text-sm text-muted-foreground">
                A lean team punching above its weight, distributed across 15 countries.
            </p>
        </div>

        <div class="p-6">
            <div class="space-y-5">
                @foreach (var dept in _departments)
                {
                    <div>
                        <div class="mb-2 flex items-center justify-between text-sm">
                            <span class="font-medium">@dept.Name</span>
                            <span class="text-muted-foreground">@dept.Count people</span>
                        </div>
                        <div class="h-2 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground transition-all"
                                 style="@($"width: {dept.Percentage}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Department(string Name, int Count, int Percentage);

    private readonly List<Department> _departments =
    [
        new("Engineering", 28, 45),
        new("Design", 12, 20),
        new("Product", 8, 13),
        new("Operations", 8, 13),
        new("Sales", 6, 9),
    ];
}
