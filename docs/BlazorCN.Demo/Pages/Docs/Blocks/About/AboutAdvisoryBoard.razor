@* ============================================================
   Block: about-advisory-board
   Title: About Advisory Board
   Description: A professional advisory board section showcasing advisors with their roles, companies, and expertise in a clean grid layout.
   Long Description: Display your advisory board with confidence. This component presents board members in a clean, professional grid layout with avatars, titles, companies, and concise bios that establish credibility.
   Dependencies: AvatarCn
   Source: original/blocks/about/about-advisory-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Advisory Board</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Industry leaders guiding our strategic direction
            </p>
        </div>

        <div class="grid gap-6 p-6 sm:grid-cols-2">
            @foreach (var advisor in _advisors)
            {
                <div class="flex gap-4">
                    <AvatarCn Class="size-12 shrink-0">
                        <AvatarFallbackCn Class="bg-muted text-sm">@advisor.Initials</AvatarFallbackCn>
                    </AvatarCn>

                    <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0">
                                <h3 class="text-sm font-medium">@advisor.Name</h3>
                                <p class="text-sm text-muted-foreground">@advisor.Title</p>
                                <p class="text-xs text-muted-foreground">@advisor.Company</p>
                            </div>
                            @if (!string.IsNullOrEmpty(advisor.Linkedin))
                            {
                                <a href="@advisor.Linkedin"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="shrink-0 text-muted-foreground transition-colors hover:text-foreground">
                                    <LucideIconCn Name="linkedin" Size="16" Class="size-4" />
                                    <span class="sr-only">LinkedIn profile</span>
                                </a>
                            }
                        </div>
                        <p class="mt-2 text-sm text-muted-foreground">@advisor.Bio</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Advisor(string Name, string Title, string Company, string Bio, string Initials, string? Linkedin = null);

    private readonly List<Advisor> _advisors =
    [
        new("Sarah Chen", "Former VP Engineering", "Stripe",
            "Led engineering teams of 200+ developers, advisor to 15 high-growth startups", "SC",
            "https://linkedin.com/in/sarahchen"),
        new("Marcus Rodriguez", "Chief Product Officer", "Notion",
            "20+ years building developer tools, former founding engineer at Heroku", "MR",
            "https://linkedin.com/in/marcusrodriguez"),
        new("Emily Watson", "Partner", "Andreessen Horowitz",
            "Invested in 40+ companies including Figma, Linear, and Vercel", "EW",
            "https://linkedin.com/in/emilywatson"),
        new("David Park", "Co-founder & CTO", "Cloudflare",
            "Built infrastructure serving 20M+ requests per second, security expert", "DP",
            "https://linkedin.com/in/davidpark"),
        new("Lisa Kumar", "Head of Design", "Linear",
            "Former design lead at GitHub, shaped product experiences for millions of developers", "LK",
            "https://linkedin.com/in/lisakumar"),
        new("James Sullivan", "General Partner", "Sequoia Capital",
            "Early investor in Zoom, WhatsApp, and GitHub, 15 years in venture capital", "JS",
            "https://linkedin.com/in/jamessullivan"),
    ];
}
