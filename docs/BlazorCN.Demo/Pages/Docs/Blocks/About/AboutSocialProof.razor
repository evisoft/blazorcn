@* ============================================================
   Block: about-social-proof
   Title: About Social Proof
   Description: Social proof section with stats and trust badges for React SaaS landing pages
   Long Description: Build trust quickly with this social proof component for Next.js about pages. Features a row of key metrics with icons, plus a section of industry trust badges like G2 and Capterra awards. Built with Tailwind CSS and Lucide icons. Multiple proof points reinforce credibility from different angles—numbers show scale, badges show recognition. Perfect for conversion-focused landing pages, pricing pages, and anywhere trust is a purchase barrier.
   Dependencies: None
   Source: original/blocks/about/about-social-proof.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5 text-center">
            <h2 class="text-xl font-semibold tracking-tight">
                Join thousands of teams who trust us
            </h2>
        </div>

        @* Stats row *@
        <div class="border-b px-6 py-5">
            <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
                @foreach (var stat in _stats)
                {
                    <div class="text-center">
                        <LucideIconCn Name="@stat.Icon" Size="20" Class="mx-auto mb-2 h-5 w-5 text-muted-foreground" />
                        <p class="text-2xl font-semibold tabular-nums tracking-tight">@stat.Value</p>
                        <p class="text-sm text-muted-foreground">@stat.Label</p>
                    </div>
                }
            </div>
        </div>

        @* Trust badges *@
        <div class="px-6 py-5">
            <p class="mb-4 text-center text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Recognized by industry leaders
            </p>
            <div class="flex flex-wrap items-center justify-center gap-3">
                @foreach (var badge in _trustBadges)
                {
                    <span class="rounded-full border px-3 py-1.5 text-sm font-medium">
                        @badge
                    </span>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Icon, string Value, string Label);

    private readonly List<StatItem> _stats =
    [
        new("users", "50K+", "Active users"),
        new("building", "2,000+", "Companies"),
        new("star", "4.9/5", "Rating"),
        new("shield", "SOC 2", "Certified"),
    ];

    private readonly string[] _trustBadges = ["G2 Leader 2024", "Capterra Top Rated", "GetApp Category Leader", "TrustRadius Top Rated"];
}
