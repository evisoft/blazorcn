@* ============================================================
   Block: about-workflow
   Title: About Workflow
   Description: A visual workflow showing how work flows through the company from ideation to shipping, with team involvement at each stage.
   Long Description: Show transparency in your development process. This workflow about block displays how work moves through stages from ideation to shipping, highlighting cross-functional collaboration.
   Dependencies: None
   Source: original/blocks/about/about-workflow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">How We Work</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Our collaborative workflow from idea to production
            </p>
        </div>
        <div class="p-6">
            <div class="space-y-4">
                @for (var i = 0; i < _stages.Count; i++)
                {
                    var stage = _stages[i];
                    var stageNumber = i + 1;
                    <div>
                        <div class="rounded-md border bg-muted/50 p-4">
                            <div class="flex items-start gap-3">
                                <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-background">
                                    <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-muted-foreground" />
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <h3 class="font-medium text-sm">@stage.Title</h3>
                                        <span class="font-medium text-muted-foreground text-xs tabular-nums">
                                            Stage @stageNumber
                                        </span>
                                    </div>
                                    <p class="mt-1 text-muted-foreground text-sm">@stage.Description</p>
                                    <div class="mt-3 flex flex-wrap gap-2">
                                        @foreach (var role in stage.Involved)
                                        {
                                            <span class="rounded-md bg-background px-2 py-1 font-medium text-muted-foreground text-xs">
                                                @role
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (i < _stages.Count - 1)
                        {
                            <div class="flex justify-center py-2">
                                <LucideIconCn Name="arrow-right" Size="16" Class="size-4 rotate-90 text-muted-foreground/60 sm:rotate-0" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Stage(string Title, string Description, string[] Involved);

    private readonly List<Stage> _stages =
    [
        new("Ideation", "Gather customer feedback, market research, and team ideas",
            ["Product", "Design", "Engineering"]),
        new("Specification", "Write detailed specs, create designs, and define success metrics",
            ["Product", "Design"]),
        new("Build", "Develop features with continuous integration and automated testing",
            ["Engineering", "QA"]),
        new("Review", "Internal testing, stakeholder feedback, and iteration",
            ["Product", "Design", "Engineering", "QA"]),
        new("Ship", "Deploy to production, monitor metrics, and communicate with users",
            ["Engineering", "Product", "Marketing"]),
    ];
}
