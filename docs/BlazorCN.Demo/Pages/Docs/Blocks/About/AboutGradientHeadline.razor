@* ============================================================
   Block: about-gradient-headline
   Title: AboutGradientHeadline
   Description: A bold company statement block for React and Next.js with large editorial quote, attribution line, supporting metric stats, and scale-fade entrance animation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-gradient-headline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Quote *@
        <div class="px-6 py-10">
            <figure>
                <blockquote>
                    <p class="text-2xl font-semibold leading-snug tracking-tight">
                        &ldquo;@_statement&rdquo;
                    </p>
                </blockquote>
                <figcaption class="mt-5">
                    <div class="flex items-center gap-2">
                        <div class="size-1 rounded-full bg-foreground/30"></div>
                        <span class="text-sm font-medium">@_attribution.Name</span>
                        <span class="text-xs text-muted-foreground">@_attribution.Role</span>
                    </div>
                    <p class="mt-1.5 pl-3 text-[10px] text-muted-foreground">@_attribution.Context</p>
                </figcaption>
            </figure>
        </div>

        <SeparatorCn />

        @* Supporting stats *@
        <div class="grid grid-cols-3 divide-x px-6 py-5">
            @foreach (var stat in _supportingStats)
            {
                <div class="px-3 text-center first:pl-0 last:pr-0">
                    <div class="text-lg font-semibold tabular-nums">@stat.Value</div>
                    <div class="mt-0.5 text-[10px] text-muted-foreground">@stat.Label</div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private const string _statement =
        "We believe the best software is built by small teams who care deeply about craft — not by committees optimizing for consensus.";

    private record AttributionItem(string Name, string Role, string Context);

    private static readonly AttributionItem _attribution = new(
        "Elena Vasquez",
        "CEO & Co-founder",
        "From our Series C investor letter, February 2026"
    );

    private record StatItem(string Value, string Label);

    private static readonly StatItem[] _supportingStats =
    [
        new("48", "team members"),
        new("5,200+", "components shipped"),
        new("94", "NPS score"),
    ];
}
