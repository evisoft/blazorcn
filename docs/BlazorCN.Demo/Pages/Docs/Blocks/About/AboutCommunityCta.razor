@* ============================================================
   Block: about-community-cta
   Title: About Community Cta
   Description: Join our community call-to-action with member stats, benefits, and social proof to drive community engagement.
   Long Description: A compelling community invitation section that showcases member count, activity level, and key benefits. Perfect for building engaged user communities around your product or service.
   Dependencies: AvatarCn, ButtonCn
   Source: original/blocks/about/about-community-cta.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-6 py-8">
            <div class="mx-auto max-w-2xl text-center">
                <h2 class="text-xl font-semibold tracking-tight">Join our community</h2>
                <p class="mt-2 text-sm text-muted-foreground">
                    Connect with thousands of developers, share ideas, and get support from our vibrant
                    community.
                </p>

                <div class="mt-6 grid gap-4 sm:grid-cols-3">
                    @foreach (var stat in _stats)
                    {
                        <div class="rounded-md bg-muted/50 p-4 text-center">
                            <LucideIconCn Name="@stat.Icon" Size="20" Class="mx-auto size-5 text-muted-foreground" />
                            <div class="mt-2 text-2xl font-semibold tabular-nums">@stat.Value</div>
                            <div class="mt-1 text-xs text-muted-foreground">@stat.Label</div>
                        </div>
                    }
                </div>

                <div class="mt-6 space-y-2 text-left text-sm">
                    @foreach (var benefit in _benefits)
                    {
                        <div class="flex items-start gap-2">
                            <div class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground"></div>
                            <span class="text-muted-foreground">@benefit</span>
                        </div>
                    }
                </div>

                <div class="mt-8">
                    <ButtonCn Size="ButtonSize.Lg" Class="h-10 gap-2">
                        Join community
                        <LucideIconCn Name="arrow-right" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>

                <div class="mt-6 flex items-center justify-center gap-3">
                    <div class="flex -space-x-2">
                        @foreach (var initials in _memberInitials)
                        {
                            <AvatarCn Class="size-8 border-2 border-background">
                                <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                            </AvatarCn>
                        }
                    </div>
                    <span class="text-xs text-muted-foreground">and 12,394 other members</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Icon, string Label, string Value);

    private readonly List<StatItem> _stats =
    [
        new("users", "Active members", "12,400+"),
        new("message-square", "Messages this week", "3,200+"),
        new("lightbulb", "Solutions shared", "850+"),
    ];

    private readonly string[] _benefits =
    [
        "Get help from experienced community members",
        "Share your knowledge and learn from others",
        "Early access to new features and beta programs",
        "Connect with the team and influence the roadmap",
    ];

    private readonly string[] _memberInitials = ["AK", "JM", "SC", "RT", "MN", "LK"];
}
