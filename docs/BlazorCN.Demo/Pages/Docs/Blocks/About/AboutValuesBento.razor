@* ============================================================
   Block: about-values-bento
   Title: About Values Bento
   Description: About section with bento-style values grid
   Long Description: Mission with supporting pillars
   Dependencies: BadgeCn
   Source: original/blocks/about/about-values-bento.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                Our Values
            </BadgeCn>
            <h2 class="mb-2 text-xl font-semibold tracking-tight">What we believe in</h2>
        </div>

        @* Bento grid *@
        <div class="grid gap-4 p-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var value in _values)
            {
                var colSpan = value.Featured ? "p-6 md:col-span-2 lg:col-span-2" : "p-5";
                var iconSize = value.Featured ? "h-12 w-12" : "h-10 w-10";
                var iconClass = value.Featured ? "h-6 w-6" : "h-5 w-5";
                var titleClass = value.Featured ? "text-base" : "text-sm";

                <div class="@($"rounded-lg border bg-muted/50 {colSpan}")">
                    <div class="@($"mb-3 flex items-center justify-center rounded-full bg-background {iconSize}")">
                        <LucideIconCn Name="@value.Icon" Size="@(value.Featured ? 24 : 20)" Class="@($"text-muted-foreground {iconClass}")" />
                    </div>
                    <h3 class="@($"mb-2 font-medium {titleClass}")">@value.Title</h3>
                    <p class="text-sm text-muted-foreground">@value.Description</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ValueItem(string Icon, string Title, string Description, bool Featured);

    private readonly List<ValueItem> _values =
    [
        new("heart", "Customer Obsessed", "Every decision starts with 'How does this help our users?'", true),
        new("zap", "Ship Fast", "Done is better than perfect. We iterate quickly.", false),
        new("users", "Win Together", "No egos. We succeed as a team or not at all.", false),
        new("target", "Stay Focused", "We say no to good so we can say yes to great.", false),
    ];
}
