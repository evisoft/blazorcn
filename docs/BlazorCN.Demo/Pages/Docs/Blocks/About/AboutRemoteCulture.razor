@* ============================================================
   Block: about-remote-culture
   Title: About Remote Culture
   Description: Remote-first work culture showcase with timezone coverage, async practices, tools, and team meetup information.
   Long Description: A comprehensive remote culture section that demonstrates your distributed team's working practices. Highlights timezone coverage, communication tools, and team connection opportunities.
   Dependencies: None
   Source: original/blocks/about/about-remote-culture.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Remote-first culture</h2>
            <p class="mt-2 text-sm text-muted-foreground">
                We're a fully distributed team working across three continents, building amazing
                products asynchronously.
            </p>
        </div>

        <div class="border-b p-6">
            <div class="flex items-center gap-2 text-sm font-medium">
                <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                Timezone coverage
            </div>
            <div class="mt-4 space-y-3">
                @foreach (var tz in _timezones)
                {
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="text-sm font-medium">@tz.Region</div>
                            <div class="mt-0.5 font-mono text-xs text-muted-foreground">@tz.Offset</div>
                        </div>
                        <div class="text-sm">
                            <span class="tabular-nums">@tz.Count</span>
                            <span class="text-muted-foreground"> team members</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b p-6">
            <div class="flex items-center gap-2 text-sm font-medium">
                <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
                Our practices
            </div>
            <div class="mt-4 space-y-4">
                @foreach (var practice in _practices)
                {
                    <div class="rounded-md bg-muted/50 p-4">
                        <div class="text-sm font-medium">@practice.Title</div>
                        <p class="mt-1 text-sm text-muted-foreground">@practice.Description</p>
                    </div>
                }
            </div>
        </div>

        <div class="p-6">
            <div class="flex items-center gap-2 text-sm font-medium">
                <LucideIconCn Name="video" Size="16" Class="size-4 text-muted-foreground" />
                Tools we use
            </div>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
                @foreach (var tool in _tools)
                {
                    <div class="flex items-center justify-between rounded-md border bg-card p-3">
                        <div class="text-sm font-medium">@tool.Name</div>
                        <div class="text-xs text-muted-foreground">@tool.Purpose</div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t bg-muted/50 px-6 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-sm">
                    <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium">Next team meetup</span>
                </div>
                <span class="text-sm text-muted-foreground">Barcelona, June 2026</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record TimezoneInfo(string Region, int Count, string Offset);
    private record ToolInfo(string Name, string Purpose);
    private record PracticeInfo(string Title, string Description);

    private readonly List<TimezoneInfo> _timezones =
    [
        new("Americas", 18, "UTC-8 to UTC-5"),
        new("Europe & Africa", 24, "UTC+0 to UTC+3"),
        new("Asia Pacific", 12, "UTC+8 to UTC+11"),
    ];

    private readonly List<ToolInfo> _tools =
    [
        new("Slack", "Team communication"),
        new("Notion", "Documentation & knowledge base"),
        new("Linear", "Project management"),
        new("Zoom", "Video meetings"),
        new("Loom", "Async video updates"),
        new("Tuple", "Pair programming"),
    ];

    private readonly List<PracticeInfo> _practices =
    [
        new("Async-first communication",
            "We default to written updates and recorded videos to respect everyone's time and timezone."),
        new("Overlap hours",
            "Core hours from 2-5 PM UTC ensure real-time collaboration when needed."),
        new("Annual team meetups",
            "We gather twice a year for week-long offsites to build connections and plan together."),
    ];
}
