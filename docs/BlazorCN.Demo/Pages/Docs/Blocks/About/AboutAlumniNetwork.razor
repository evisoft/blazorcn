@* ============================================================
   Block: about-alumni-network
   Title: About Alumni Network
   Description: Notable company alumni showcase displaying former employees and their current roles at top companies.
   Long Description: Demonstrate career trajectory impact. This component showcases where alumni have gone after leaving your company, proving that time at your organization accelerates careers and builds valuable networks.
   Dependencies: AvatarCn
   Source: original/blocks/about/about-alumni-network.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Alumni Network</h2>
            <p class="mt-1 text-sm text-muted-foreground">Where our team members go next</p>
        </div>

        <div class="divide-y">
            @foreach (var person in _alumni)
            {
                <div class="px-6 py-4">
                    <div class="flex items-center gap-4">
                        <AvatarCn Class="size-10 shrink-0">
                            <AvatarFallbackCn Class="bg-muted text-sm">@person.Initials</AvatarFallbackCn>
                        </AvatarCn>

                        <div class="flex min-w-0 flex-1 items-center gap-3">
                            <div class="min-w-0">
                                <p class="text-sm font-medium">@person.Name</p>
                                <p class="text-xs text-muted-foreground">@person.PreviousRole</p>
                            </div>

                            <LucideIconCn Name="arrow-right" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />

                            <div class="min-w-0">
                                <p class="text-sm font-medium">@person.CurrentRole</p>
                                <p class="text-xs text-muted-foreground">@person.CurrentCompany</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-6 py-4">
            <p class="text-xs text-muted-foreground">
                Our alumni network includes 200+ former employees at companies like Stripe, Vercel,
                Linear, Notion, and Anthropic. We maintain an active Slack community for networking and
                referrals.
            </p>
        </div>
    </div>
</section>

@code {
    private record Alumnus(string Name, string PreviousRole, string CurrentRole, string CurrentCompany, string Initials);

    private readonly List<Alumnus> _alumni =
    [
        new("Sarah Chen", "Senior Engineer", "VP Engineering", "Stripe", "SC"),
        new("Marcus Johnson", "Product Manager", "Head of Product", "Notion", "MJ"),
        new("Emily Rodriguez", "Engineering Manager", "Director of Engineering", "Vercel", "ER"),
        new("David Park", "Staff Engineer", "Co-founder & CTO", "Axiom", "DP"),
        new("Lisa Thompson", "Design Lead", "Head of Design", "Linear", "LT"),
    ];
}
