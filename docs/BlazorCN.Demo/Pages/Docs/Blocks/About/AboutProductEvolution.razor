@* ============================================================
   Block: about-product-evolution
   Title: About Product Evolution
   Description: Product version history section with release features for React SaaS about pages
   Long Description: Show your product journey with this evolution component for Next.js about pages. Features a grid of version cards with release year, title, and key features, with visual emphasis on the current version. Built with Tailwind CSS. Version history demonstrates momentum and continuous improvement—visitors see you're actively building. Perfect for SaaS products, developer tools, and platforms with a strong development history to showcase.
   Dependencies: None
   Source: original/blocks/about/about-product-evolution.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5 text-center">
            <h2 class="mb-2 text-xl font-semibold tracking-tight">Four years of innovation</h2>
            <p class="text-sm text-muted-foreground">
                From simple tool to comprehensive platform—see how we've grown.
            </p>
        </div>

        @* Version cards *@
        <div class="p-6">
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                @foreach (var item in _versions)
                {
                    <div class="@($"rounded-lg border p-4 {(item.Current ? "border-emerald-500 bg-emerald-500/10" : "bg-muted/50")}")">
                        <div class="mb-3 flex items-start justify-between">
                            <div>
                                <span class="text-2xl font-semibold tabular-nums tracking-tight">
                                    v@item.Version
                                </span>
                                <p class="text-xs text-muted-foreground">@item.Year</p>
                            </div>
                            @if (item.Current)
                            {
                                <span class="rounded-full border border-emerald-500 px-2 py-0.5 text-xs font-medium text-emerald-500">
                                    Current
                                </span>
                            }
                        </div>
                        <h3 class="mb-2 text-sm font-medium">@item.Title</h3>
                        <ul class="space-y-1">
                            @foreach (var feature in item.Features)
                            {
                                <li class="text-sm text-muted-foreground leading-relaxed">
                                    &bull; @feature
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record VersionItem(string Version, string Year, string Title, string[] Features, bool Current);

    private readonly List<VersionItem> _versions =
    [
        new("1.0", "2020", "The Beginning", ["Core platform", "Basic integrations", "Team collaboration"], false),
        new("2.0", "2021", "Enterprise Ready", ["SSO & SAML", "Advanced permissions", "Audit logs"], false),
        new("3.0", "2023", "AI-Powered", ["Smart automation", "Predictive insights", "Natural language"], false),
        new("4.0", "2024", "Platform", ["Developer API", "Custom workflows", "Marketplace"], true),
    ];
}
