@* ============================================================
   Block: about-learning-development
   Title: AboutLearningDevelopment
   Description: A numbered steps learning and development card for React and Next.js with vertical connecting line, program offerings, key budget stats, participation metrics, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-learning-development.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-5 py-4">
            <h2 class="text-sm font-medium">Learning &amp; Development</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_totalInvestment average investment per employee across @_programs.Length programs
            </p>
        </div>

        @* Steps *@
        <div class="px-5 py-5">
            <div class="relative">
                @for (int i = 0; i < _programs.Length; i++)
                {
                    var program = _programs[i];
                    var isLast = i == _programs.Length - 1;
                    <div class="relative flex gap-4 pb-6 last:pb-0">
                        @* Number circle + connecting line *@
                        <div class="relative flex shrink-0 flex-col items-center">
                            <div class="flex size-7 items-center justify-center rounded-full border bg-card text-xs font-medium tabular-nums">
                                @program.Step
                            </div>
                            @if (!isLast)
                            {
                                <div class="absolute top-7 w-px flex-1 bg-border"
                                     style="bottom:-24px"
                                     aria-hidden="true"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1 pt-0.5">
                            <div class="flex items-start justify-between gap-3">
                                <h3 class="text-sm font-medium">@program.Name</h3>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px] font-medium tabular-nums">
                                    @program.KeyStatValue
                                </BadgeCn>
                            </div>
                            <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                                @program.Description
                            </p>
                            <div class="mt-2 flex items-center gap-3 text-[10px] text-muted-foreground">
                                <span>
                                    <span class="font-medium tabular-nums text-foreground">@program.Participants</span>@(" ")participants
                                </span>
                                <span class="size-0.5 rounded-full bg-muted-foreground/50"></span>
                                <span>@program.KeyStatLabel</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-5 py-3">
            <span class="text-[10px] text-muted-foreground">
                Budgets reset on hire-date anniversary. Unused amounts do not roll over.
            </span>
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span class="font-medium tabular-nums text-foreground">@_totalParticipants</span>
                <span>active participants</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record Program(int Step, string Name, string Description, string KeyStatValue, string KeyStatLabel, int Participants);

    private static readonly Program[] _programs =
    [
        new(1, "Engineering Guild",
            "Weekly deep-dives into architecture patterns, code reviews of open-source projects, and rotating tech talks by senior engineers. Each quarter focuses on a different domain: distributed systems, frontend performance, or security.",
            "$3,500", "per engineer / year", 142),
        new(2, "Conference Budget",
            "Every engineer gets two sponsored conference attendances per year, plus travel and accommodation. Attendees present a lightning talk to the team within two weeks of returning to share key takeaways.",
            "$4,000", "per person / year", 89),
        new(3, "Book Club",
            "A monthly reading group alternating between technical books (Designing Data-Intensive Applications, Staff Engineer) and leadership books (The Manager's Path, An Elegant Puzzle). $500 annual book stipend for any title.",
            "$500", "book stipend / year", 67),
        new(4, "Mentorship Pairs",
            "Six-month structured mentorship cycles pairing senior and junior engineers across teams. Pairs meet biweekly with guided discussion topics, quarterly check-ins with People Ops, and optional cross-functional shadowing weeks.",
            "6 mo", "cycle length", 38),
        new(5, "Sabbatical Program",
            "After four years of tenure, every employee earns a paid six-week sabbatical. Use it for travel, personal projects, open-source contributions, or simply rest. No laptop required. Fully paid, no questions asked.",
            "6 wks", "paid leave", 14),
    ];

    private const string _totalInvestment = "$13,000";
    private static readonly int _totalParticipants = 350; // 142 + 89 + 67 + 38 + 14
}
