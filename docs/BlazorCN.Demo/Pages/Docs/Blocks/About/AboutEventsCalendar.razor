@* ============================================================
   Block: about-events-calendar
   Title: AboutEventsCalendar
   Description: An events calendar data table block for React and Next.js with sortable columns, type badges, status indicators, row hover states, and a subscribe CTA footer built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-events-calendar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-end justify-between border-b px-6 py-4">
            <div>
                <span class="text-xs font-medium text-muted-foreground">Community</span>
                <h2 class="mt-0.5 text-sm font-medium">Upcoming Events</h2>
            </div>
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @OpenCount open
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-muted-foreground"></span>
                    @UpcomingCount upcoming
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @SoldOutCount sold out
                </span>
            </div>
        </div>

        @* Table *@
        <div class="overflow-x-auto">
            <TableCn>
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-[90px] text-xs">Date</TableHeadCn>
                        <TableHeadCn Class="text-xs">Event</TableHeadCn>
                        <TableHeadCn Class="w-[100px] text-xs">Type</TableHeadCn>
                        <TableHeadCn Class="w-[140px] text-xs">Location</TableHeadCn>
                        <TableHeadCn Class="w-[120px] text-right text-xs">Status</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var evt in _events)
                    {
                        <tr class="@Cn.Merge("border-b transition-colors last:border-b-0", _hoveredId == evt.Id ? "bg-muted/50" : "")"
                            @onmouseenter="@(() => _hoveredId = evt.Id)"
                            @onmouseleave="@(() => _hoveredId = null)">
                            <TableCellCn Class="py-3">
                                <div class="flex items-center gap-1.5">
                                    <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="whitespace-nowrap font-mono text-xs text-muted-foreground">
                                        @evt.Date
                                    </span>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="py-3">
                                <div>
                                    <p class="text-sm font-medium">@evt.Name</p>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@evt.Speaker</p>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="py-3">
                                <span class="@Cn.Merge("inline-flex rounded-md px-2 py-0.5 text-[10px] font-medium", _typeStyles[evt.Type])">
                                    @evt.Type
                                </span>
                            </TableCellCn>
                            <TableCellCn Class="py-3">
                                <div class="flex items-center gap-1.5">
                                    <LucideIconCn Name="map-pin" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                                    <span class="text-xs text-muted-foreground">@evt.Location</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="py-3 text-right">
                                <span class="@Cn.Merge("text-xs font-medium", _statusStyles[evt.Status])">
                                    @evt.Status
                                </span>
                            </TableCellCn>
                        </tr>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t bg-muted/30 px-6 py-3">
            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="users" Size="12" Class="size-3" />
                <span>@_events.Length events in 2026</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Subscribe to Events
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record CompanyEvent(string Id, string Date, int SortOrder, string Name, string Type, string Location, string Speaker, string Capacity, string Status);

    private static readonly CompanyEvent[] _events =
    [
        new("react-summit", "Apr 15–17", 1, "React Summit 2026", "Conference", "Amsterdam, NL", "Maya Chen, Staff Engineer", "2,400 attendees", "Sold Out"),
        new("webinar-edge", "Apr 22", 2, "Edge-First Architecture Patterns", "Webinar", "Virtual", "Alex Kim, Sr. Engineer", "500 seats", "Registration Open"),
        new("sf-meetup", "May 3", 3, "SF React & TypeScript Meetup", "Meetup", "San Francisco, CA", "Jordan Taylor, EM", "120 seats", "Registration Open"),
        new("workshop-design", "May 12–13", 4, "Design Systems at Scale Workshop", "Workshop", "Virtual", "Priya Sharma, Product Design", "40 seats", "Waitlist"),
        new("web-summit", "Jun 10–12", 5, "Web Summit 2026", "Conference", "Lisbon, PT", "Jennifer Martinez, CEO", "70,000 attendees", "Upcoming"),
        new("berlin-meetup", "Jun 19", 6, "Berlin Frontend Meetup", "Meetup", "Berlin, DE", "Lena Vogt, Frontend Lead", "80 seats", "Registration Open"),
        new("webinar-a11y", "Jul 8", 7, "Accessibility in Component Libraries", "Webinar", "Virtual", "Marcus Johnson, Head of CX", "500 seats", "Upcoming"),
        new("next-conf", "Oct 22–24", 8, "Next.js Conf 2026", "Conference", "San Francisco, CA", "Full team presence", "3,000 attendees", "Upcoming"),
    ];

    private static readonly Dictionary<string, string> _typeStyles = new()
    {
        ["Conference"] = "bg-blue-500/10 text-blue-600",
        ["Meetup"] = "bg-emerald-500/10 text-emerald-600",
        ["Webinar"] = "bg-amber-500/10 text-amber-600",
        ["Workshop"] = "bg-muted text-muted-foreground",
    };

    private static readonly Dictionary<string, string> _statusStyles = new()
    {
        ["Registration Open"] = "text-emerald-600",
        ["Upcoming"] = "text-muted-foreground",
        ["Sold Out"] = "text-red-600",
        ["Waitlist"] = "text-amber-600",
    };

    private string? _hoveredId;

    private int OpenCount => _events.Count(e => e.Status == "Registration Open");
    private int UpcomingCount => _events.Count(e => e.Status == "Upcoming");
    private int SoldOutCount => _events.Count(e => e.Status == "Sold Out");
}
