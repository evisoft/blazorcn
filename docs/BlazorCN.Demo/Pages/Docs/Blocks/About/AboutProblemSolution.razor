@* ============================================================
   Block: about-problem-solution
   Title: About Problem Solution
   Description: A problem-solution section showing the problem you solve with clear before/after framing and pain points resolved
   Long Description: Clearly communicate the problem you solve with this before/after section. Shows pain points, your solution, and specific improvements customers experience.
   Dependencies: None
   Source: original/blocks/about/about-problem-solution.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">The Problem We Solve</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Why developers waste weeks building the same UI components over and over, and how we fix
                it
            </p>
        </div>

        <div class="border-b p-6">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="alert-circle" Size="16" Class="size-4 text-muted-foreground" />
                <h3 class="font-medium text-sm">The Old Way</h3>
            </div>

            <div class="space-y-3">
                @foreach (var pain in _painPoints)
                {
                    <div class="rounded-md border bg-card p-4">
                        <div class="flex items-start gap-3">
                            <LucideIconCn Name="x-circle" Size="16" Class="mt-0.5 size-4 shrink-0 text-red-500" />
                            <div class="min-w-0 flex-1">
                                <div class="font-medium text-sm">@pain.Problem</div>
                                <div class="mt-1 text-muted-foreground text-sm">@pain.Impact</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b bg-muted/30 px-6 py-4">
            <div class="text-center">
                <div class="mx-auto w-fit rounded-full bg-card px-4 py-2">
                    <span class="font-medium text-sm">Our Solution</span>
                </div>
            </div>
        </div>

        <div class="p-6">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="check-circle" Size="16" Class="size-4 text-emerald-500" />
                <h3 class="font-medium text-sm">How We Fix It</h3>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
                @foreach (var resolution in _resolutions)
                {
                    <div class="rounded-md bg-muted/50 p-4">
                        <div class="font-medium text-sm">@resolution.Title</div>
                        <div class="mt-1 text-muted-foreground text-sm">@resolution.Description</div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-6 py-5">
            <h3 class="mb-3 font-medium text-sm">Before vs After</h3>

            <div class="grid gap-3 sm:grid-cols-2">
                <div class="space-y-2">
                    <div class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                        Before
                    </div>
                    <div class="space-y-1.5">
                        @foreach (var item in _before)
                        {
                            <div class="flex items-start gap-2 text-sm">
                                <span class="mt-1 size-1 shrink-0 rounded-full bg-red-500"></span>
                                <span class="text-muted-foreground">@item</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="space-y-2">
                    <div class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                        After
                    </div>
                    <div class="space-y-1.5">
                        @foreach (var item in _after)
                        {
                            <div class="flex items-start gap-2 text-sm">
                                <span class="mt-1 size-1 shrink-0 rounded-full bg-emerald-500"></span>
                                <span class="text-muted-foreground">@item</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="border-t bg-muted/30 px-6 py-4">
            <p class="text-muted-foreground text-sm">
                The problem isn't that components are hard to build. It's that they're tedious to build
                well. We handle the tedious parts so you can focus on what makes your product unique.
            </p>
        </div>
    </div>
</section>

@code {
    private record PainPoint(string Problem, string Impact);
    private record Resolution(string Title, string Description);

    private readonly List<PainPoint> _painPoints =
    [
        new("Rebuilding the same components for every project",
            "2-3 weeks per project spent reinventing buttons, modals, and forms"),
        new("Inconsistent accessibility and design across projects",
            "Failed WCAG audits, poor user experience, expensive remediation"),
        new("Component libraries lock you into outdated patterns",
            "Breaking changes on updates, or staying stuck on old versions"),
        new("Fighting opinionated libraries to match your design",
            "Hacky CSS overrides, forking packages, or giving up on brand"),
    ];

    private readonly List<Resolution> _resolutions =
    [
        new("Copy, Don't Install",
            "Components live in your codebase. No package dependencies, no breaking changes, full control."),
        new("Production-Ready Out of the Box",
            "Accessible, responsive, and tested. Skip weeks of polish and ship immediately."),
        new("Customize Without Fighting",
            "Full source code you own. Modify anything without workarounds or CSS hacks."),
        new("Always Modern",
            "Built with latest React patterns. Update on your schedule, not when a maintainer decides."),
    ];

    private readonly string[] _before =
    [
        "2-3 weeks building components",
        "Accessibility as an afterthought",
        "Package dependency hell",
        "Breaking changes on updates",
    ];

    private readonly string[] _after =
    [
        "Ship in hours, not weeks",
        "WCAG 2.1 AA out of the box",
        "Code you own and control",
        "Update on your schedule",
    ];
}
