@* ============================================================
   Block: about-timeline-vertical
   Title: About Timeline Vertical
   Description: About section with timeline showing company milestones vertically
   Long Description: About section with horizontal timeline and milestones
   Dependencies: BadgeCn
   Source: original/blocks/about/about-timeline-vertical.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                Our Journey
            </BadgeCn>
            <h2 class="mb-2 text-xl font-semibold tracking-tight">
                From idea to industry leader
            </h2>
            <p class="text-sm text-muted-foreground">Key moments that shaped who we are today.</p>
        </div>

        @* Timeline *@
        <div class="px-6 py-5">
            <div class="relative">
                @* Vertical line *@
                <div class="absolute left-4 top-0 h-full w-px bg-border"></div>

                @* Milestones *@
                <div class="space-y-6">
                    @foreach (var milestone in _milestones)
                    {
                        <div class="relative flex items-start gap-4">
                            @* Circle marker *@
                            <div class="relative z-10 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 border-muted-foreground bg-background">
                                <LucideIconCn Name="circle" Size="12" Class="h-3 w-3 fill-muted-foreground text-muted-foreground" />
                            </div>

                            @* Content *@
                            <div class="pb-2 pt-1">
                                <span class="text-sm font-medium text-muted-foreground">
                                    @milestone.Year
                                </span>
                                <h3 class="mt-1 text-sm font-medium">@milestone.Title</h3>
                                <p class="mt-1 text-sm text-muted-foreground">@milestone.Description</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Milestone(string Year, string Title, string Description);

    private readonly List<Milestone> _milestones =
    [
        new("2024", "Series B Funding", "Raised $45M to accelerate global expansion and product development."),
        new("2023", "Enterprise Launch", "Launched enterprise tier with SSO, advanced security, and dedicated support."),
        new("2022", "10,000 Customers", "Reached milestone of 10K paying customers across 50 countries."),
        new("2021", "Series A Funding", "Secured $12M Series A to scale engineering and go-to-market teams."),
        new("2020", "Product Launch", "Launched publicly after 18 months of development and beta testing."),
        new("2019", "Founded", "Started in a garage with a vision to simplify how teams collaborate."),
    ];
}
