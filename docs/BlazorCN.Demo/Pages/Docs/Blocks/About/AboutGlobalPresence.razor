@* ============================================================
   Block: about-global-presence
   Title: AboutGlobalPresence
   Description: A compact global presence card for React and Next.js with stacked office rows, flag emojis, team size badges, timezone labels, role breakdown dots, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-global-presence.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-5 py-4">
            <h2 class="text-sm font-medium">Where we are</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_totalHeadcount people across @_offices.Length offices worldwide
            </p>
        </div>

        @* Office rows *@
        <div class="divide-y">
            @foreach (var office in _offices)
            {
                <div class="flex items-center gap-3 px-5 py-3">
                    @* Flag *@
                    <span class="text-base leading-none" aria-hidden="true">
                        @office.Flag
                    </span>

                    @* City + country *@
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@office.City</span>
                        <span class="ml-1.5 text-xs text-muted-foreground">@office.Country</span>
                    </div>

                    @* Role breakdown dots *@
                    <div class="flex items-center gap-1">
                        @foreach (var role in _roleLegend)
                        {
                            var count = role.Selector(office.Roles);
                            if (count > 0)
                            {
                                <div class="flex items-center gap-0.5">
                                    <span class="@($"size-1.5 rounded-full {role.Color}")" title="@($"{role.Label}: {count}")"></span>
                                    <span class="text-[10px] tabular-nums text-muted-foreground">
                                        @count
                                    </span>
                                </div>
                            }
                        }
                    </div>

                    @* Timezone *@
                    <span class="hidden font-mono text-[10px] text-muted-foreground sm:inline">
                        @office.Timezone
                    </span>

                    @* Team size badge *@
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-1 shrink-0 text-[10px] font-medium tabular-nums">
                        @office.TeamSize
                    </BadgeCn>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-5 py-3">
            <div class="flex items-center gap-3">
                @foreach (var role in _roleLegend)
                {
                    <div class="flex items-center gap-1">
                        <span class="@($"size-1.5 rounded-full {role.Color}")"></span>
                        <span class="text-[10px] text-muted-foreground">@role.Label</span>
                    </div>
                }
            </div>
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span class="font-medium tabular-nums text-foreground">@_offices.Length</span>
                <span>offices</span>
                <span class="size-1 rounded-full bg-muted-foreground/30"></span>
                <span class="font-medium tabular-nums text-foreground">@_totalHeadcount</span>
                <span>people</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record OfficeRoles(int Engineering, int Design, int Sales);
    private record Office(string Flag, string City, string Country, string Timezone, int TeamSize, OfficeRoles Roles);
    private record RoleLegendItem(string Key, string Label, string Color, Func<OfficeRoles, int> Selector);

    private static readonly Office[] _offices = [
        new("🇺🇸", "San Francisco", "US", "UTC-8",  85, new(52, 18, 15)),
        new("🇺🇸", "New York",      "US", "UTC-5",  42, new(14,  8, 20)),
        new("🇧🇳", "Sao Paulo",     "BR", "UTC-3",  18, new(12,  4,  2)),
        new("🇬🇧", "London",        "GB", "UTC+0",  36, new(20,  6, 10)),
        new("🇩🇪", "Berlin",        "DE", "UTC+1",  28, new(22,  4,  2)),
        new("🇳🇱", "Amsterdam",     "NL", "UTC+1",  15, new( 8,  5,  2)),
        new("🇸🇬", "Singapore",     "SG", "UTC+8",  24, new(16,  3,  5)),
        new("🇦🇺", "Sydney",        "AU", "UTC+11", 16, new(10,  2,  4)),
        new("🇯🇵", "Tokyo",         "JP", "UTC+9",  12, new( 8,  2,  2)),
    ];

    private static readonly RoleLegendItem[] _roleLegend = [
        new("engineering", "Eng",    "bg-blue-500",    r => r.Engineering),
        new("design",      "Design", "bg-amber-500",   r => r.Design),
        new("sales",       "Sales",  "bg-emerald-500", r => r.Sales),
    ];

    private static readonly int _totalHeadcount = _offices.Sum(o => o.TeamSize);
}
