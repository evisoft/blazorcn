@* ============================================================
   Block: about-open-metrics
   Title: About Open Metrics
   Description: A transparent business metrics dashboard showing revenue, growth, and customer satisfaction for about pages
   Long Description: Demonstrate radical transparency with open business metrics. Displays key performance indicators including revenue, customer count, and satisfaction scores to build trust through public accountability.
   Dependencies: None
   Source: original/blocks/about/about-open-metrics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Transparent Metrics</h2>
            <p class="mt-1 text-sm text-muted-foreground">Real business data updated monthly</p>
        </div>

        <div class="p-6">
            <div class="rounded-md border bg-muted/50 p-4">
                <p class="text-sm font-medium">Radical Transparency</p>
                <p class="mt-1 text-sm text-muted-foreground">
                    We believe in open communication with our community. These metrics are updated monthly
                    and reflect our actual business performance. Last updated March 2026.
                </p>
            </div>

            <div class="mt-6 grid gap-4 sm:grid-cols-2">
                @foreach (var metric in _metrics)
                {
                    var changeColor = metric.ChangeDirection switch
                    {
                        "up" => "text-emerald-600",
                        "down" => "text-red-600",
                        _ => "text-muted-foreground",
                    };
                    <div class="rounded-md border bg-muted/50 p-4">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="@metric.Icon" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                @metric.Label
                            </span>
                        </div>
                        <div class="mt-3 flex items-baseline justify-between">
                            <p class="font-semibold tabular-nums text-2xl">@metric.Value</p>
                            <span class="@($"text-sm {changeColor}")">@metric.Change</span>
                        </div>
                    </div>
                }
            </div>

            <p class="mt-6 text-xs text-muted-foreground">
                Data is rounded to protect customer privacy. Full methodology available in our
                transparency report.
            </p>
        </div>
    </div>
</section>

@code {
    private record MetricItem(string Icon, string Label, string Value, string Change, string ChangeDirection);

    private readonly List<MetricItem> _metrics =
    [
        new("dollar-sign", "Annual Recurring Revenue", "$8.4M", "+127% YoY", "up"),
        new("trending-up", "Monthly Recurring Revenue", "$720K", "+11% MoM", "up"),
        new("users", "Active Customers", "2,847", "+340 this month", "up"),
        new("smile", "Net Promoter Score", "68", "+5 pts", "up"),
        new("percent", "Monthly Churn Rate", "2.3%", "-0.4% MoM", "down"),
    ];
}
