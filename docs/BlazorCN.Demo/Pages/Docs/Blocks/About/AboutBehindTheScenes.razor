@* ============================================================
   Block: about-behind-the-scenes
   Title: About Behind The Scenes
   Description: Behind the scenes section showing team rituals and work culture for React company pages
   Long Description: Customer transformation stories showing before state, after state, and specific metrics for 3 different journeys
   Dependencies: None
   Source: original/blocks/about/about-behind-the-scenes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">A peek behind the curtain</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Great products come from great teams. Here's how we stay connected and creative.
            </p>
        </div>

        <div class="grid gap-px bg-muted sm:grid-cols-2">
            @foreach (var item in _rituals)
            {
                <div class="flex items-start gap-4 bg-card p-5">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border">
                        <LucideIconCn Name="@item.Icon" Size="20" Class="h-5 w-5 text-muted-foreground" />
                    </div>
                    <div>
                        <h3 class="text-sm font-medium">@item.Title</h3>
                        <p class="mt-1 text-sm text-muted-foreground leading-relaxed">
                            @item.Description
                        </p>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-6 py-5">
            <div class="flex items-start gap-4">
                <LucideIconCn Name="quote" Size="24" Class="h-6 w-6 shrink-0 text-muted-foreground/40" />
                <div>
                    <p class="text-sm leading-relaxed">
                        Culture isn't ping pong tables. It's how we treat each other when things get hard.
                    </p>
                    <p class="mt-2 text-xs text-muted-foreground">Our founding principle</p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record RitualItem(string Icon, string Title, string Description);

    private readonly List<RitualItem> _rituals =
    [
        new("coffee", "Monday kickoffs", "We start each week with a 15-minute all-hands to align on priorities."),
        new("video", "Show & tell Fridays", "Team members demo what they built. Wins celebrated, learnings shared."),
        new("zap", "Hack days", "Once a month, we build whatever we want. Some of our best features started here."),
        new("message-square", "Open Slack", "No private channels for work discussions. Transparency by default."),
    ];
}
