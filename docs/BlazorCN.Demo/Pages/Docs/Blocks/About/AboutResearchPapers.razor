@* ============================================================
   Block: about-research-papers
   Title: About Research Papers
   Description: A collection of published research papers and thought leadership demonstrating technical depth and academic contributions.
   Long Description: Establish technical credibility with published research. This about block showcases academic papers, conference publications, and thought leadership articles with authors and publication venues.
   Dependencies: None
   Source: original/blocks/about/about-research-papers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Research &amp; Publications</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Academic contributions and thought leadership from our team
            </p>
        </div>
        <div class="divide-y">
            @foreach (var paper in _papers)
            {
                <div class="px-6 py-5">
                    <div class="flex items-start gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="file-text" Size="20" Class="size-5 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <h3 class="font-medium text-sm">@paper.Title</h3>
                            <p class="mt-1 text-muted-foreground text-xs">@(string.Join(", ", paper.Authors))</p>
                            <div class="mt-2 flex flex-wrap items-center gap-2">
                                <span class="rounded-md bg-muted/50 px-2 py-1 font-medium text-muted-foreground text-xs">
                                    @paper.Venue
                                </span>
                                <span class="font-medium text-muted-foreground text-xs tabular-nums">
                                    @paper.Year
                                </span>
                            </div>
                            <p class="mt-3 text-muted-foreground text-sm">@paper.Abstract</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Paper(string Title, string[] Authors, string Venue, int Year, string Abstract);

    private readonly List<Paper> _papers =
    [
        new("Efficient Real-Time Collaborative Editing with Operational Transformation",
            ["Sarah Chen", "Michael Park", "Alex Thompson"],
            "ACM Conference on Human-Computer Interaction (CHI)", 2024,
            "Novel approach to conflict resolution in real-time collaborative text editing systems"),
        new("Privacy-Preserving Analytics for Large-Scale Distributed Systems",
            ["David Kim", "Elena Rodriguez"],
            "IEEE Symposium on Security and Privacy", 2023,
            "Differential privacy techniques for user analytics without compromising data security"),
        new("Optimizing Database Query Performance with Machine Learning",
            ["Marcus Johnson", "Priya Patel", "Robert Chen"],
            "International Conference on Very Large Data Bases (VLDB)", 2023,
            "Learned query optimization that adapts to workload patterns and data distribution"),
        new("Scalable Vector Search for Semantic Similarity",
            ["Alex Thompson", "Sarah Chen"],
            "ACM SIGMOD International Conference", 2022,
            "Approximate nearest neighbor search with sub-linear complexity for billion-scale datasets"),
        new("Adaptive Rate Limiting in Distributed API Gateways",
            ["Elena Rodriguez", "Michael Park"],
            "USENIX Symposium on Networked Systems Design", 2022,
            "Dynamic rate limiting strategies based on traffic patterns and system health metrics"),
    ];
}
