@* ============================================================
   Block: about-awards
   Title: About Awards
   Description: Company awards and recognition section with certification badges for React credibility pages
   Long Description: High-level system architecture showing technology stack organized by infrastructure layers
   Dependencies: None
   Source: original/blocks/about/about-awards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Award-winning excellence</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Industry recognition for our commitment to quality and innovation.
            </p>
        </div>

        <div class="grid gap-px bg-muted sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var award in _awards)
            {
                <div class="flex items-center gap-4 bg-card p-5">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border">
                        <LucideIconCn Name="@award.Icon" Size="20" Class="h-5 w-5 text-muted-foreground" />
                    </div>
                    <div>
                        <h3 class="text-sm font-medium">@award.Title</h3>
                        <p class="text-sm text-muted-foreground">@award.Source</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record AwardItem(string Icon, string Title, string Source);

    private readonly List<AwardItem> _awards =
    [
        new("trophy", "Best SaaS Product", "SaaS Awards 2024"),
        new("star", "Top 100 Startups", "Forbes 2024"),
        new("shield", "SOC 2 Type II", "Certified"),
        new("award", "Product of the Year", "Product Hunt"),
        new("badge-check", "G2 Leader", "Winter 2024"),
        new("medal", "Best Workplace", "Glassdoor 2024"),
    ];
}
