@* ============================================================
   Block: about-vision-statement
   Title: About Vision Statement
   Description: A future-focused vision section with ambitious vision statement, strategic pillars, and where we're headed
   Long Description: Communicate your long-term vision with this forward-looking section. Features bold vision statement, strategic pillars, and concrete next steps that inspire and align teams.
   Dependencies: None
   Source: original/blocks/about/about-vision-statement.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Our Vision</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Where we're headed and what drives our decisions
            </p>
        </div>

        <div class="border-b p-6">
            <div class="rounded-md border bg-muted/30 p-6">
                <div class="mb-3 flex items-center gap-2">
                    <LucideIconCn Name="target" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                        Vision
                    </span>
                </div>
                <p class="font-medium text-lg leading-relaxed">
                    Every developer should have instant access to production-ready UI components they can
                    own, customize, and ship with confidence.
                </p>
                <p class="mt-3 text-muted-foreground text-sm">
                    We're building the component registry that becomes the first place developers look
                    when building any interface—from landing pages to complex dashboards to AI chat
                    experiences.
                </p>
            </div>
        </div>

        <div class="border-b p-6">
            <h3 class="mb-4 font-medium text-sm">Strategic Pillars</h3>

            <div class="space-y-3">
                @foreach (var pillar in _pillars)
                {
                    <div class="rounded-md bg-muted/50 p-4">
                        <h4 class="font-medium text-sm">@pillar.Title</h4>
                        <p class="mt-1 text-muted-foreground text-sm">@pillar.Description</p>
                    </div>
                }
            </div>
        </div>

        <div class="p-6">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-muted-foreground" />
                <h3 class="font-medium text-sm">Where We're Headed</h3>
            </div>

            <div class="space-y-3">
                @foreach (var direction in _directions)
                {
                    <div class="flex items-start gap-3 rounded-md border bg-card p-4">
                        <LucideIconCn Name="arrow-right" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="font-medium text-sm">@direction.Area</div>
                            <div class="mt-1 text-muted-foreground text-sm">@direction.Goal</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-6 py-5">
            <h3 class="mb-3 font-medium text-sm">What Success Looks Like</h3>

            <div class="space-y-2">
                <div class="flex items-start gap-3">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                    <div class="text-muted-foreground text-sm">
                        <span class="font-medium text-foreground">Developer default:</span> First place
                        developers check when building any UI, before writing custom code or searching npm
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                    <div class="text-muted-foreground text-sm">
                        <span class="font-medium text-foreground">Production everywhere:</span> Our
                        components power millions of production applications across every industry
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <span class="mt-1 size-1.5 shrink-0 rounded-full bg-muted-foreground"></span>
                    <div class="text-muted-foreground text-sm">
                        <span class="font-medium text-foreground">Community owned:</span> The community
                        contributes more value than the core team, making this truly developer-driven
                    </div>
                </div>
            </div>
        </div>

        <div class="border-t bg-muted/30 px-6 py-4">
            <p class="text-muted-foreground text-sm">
                This isn't a 5-year plan. It's a 20-year commitment to changing how developers build
                interfaces. We're just getting started.
            </p>
        </div>
    </div>
</section>

@code {
    private record Pillar(string Title, string Description);
    private record Direction(string Area, string Goal);

    private readonly List<Pillar> _pillars =
    [
        new("Quality Over Quantity",
            "Every component must be production-ready, accessible, and thoughtfully designed. We'd rather have 100 excellent components than 1,000 mediocre ones."),
        new("Developers Own Their Code",
            "Copy and customize, don't install and pray. You control your components, not a package maintainer who might abandon the project."),
        new("Community-Driven Evolution",
            "The best components come from real-world use, not ivory tower design. Our community shapes what we build and how we build it."),
    ];

    private readonly List<Direction> _directions =
    [
        new("AI-Native Components",
            "100+ production-ready AI interface patterns for chat, agents, and multimodal experiences"),
        new("Design System Tooling",
            "Tools that make maintaining component libraries 10x easier for teams of all sizes"),
        new("Framework Expansion",
            "First-class support for Vue, Svelte, and Solid while maintaining our React foundation"),
        new("Developer Education",
            "Free courses and workshops teaching modern UI patterns and best practices"),
    ];
}
