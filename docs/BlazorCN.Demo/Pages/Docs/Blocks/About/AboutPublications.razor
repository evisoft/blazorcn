@* ============================================================
   Block: about-publications
   Title: About Publications
   Description: A collection of published articles, whitepapers, and industry reports showcasing expertise and thought leadership.
   Long Description: Establish credibility with published content. This about block displays articles, whitepapers, and industry reports with publication names, dates, and category badges.
   Dependencies: None
   Source: original/blocks/about/about-publications.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Publications &amp; Whitepapers</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Published articles, reports, and thought leadership from our team
            </p>
        </div>
        <div class="divide-y">
            @foreach (var pub in _publications)
            {
                <div class="px-6 py-5">
                    <div class="flex items-start gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="file-text" Size="20" Class="size-5 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <h3 class="font-medium text-sm">@pub.Title</h3>
                            <div class="mt-1 flex flex-wrap items-center gap-2">
                                <span class="rounded-md bg-muted/50 px-2 py-1 font-medium text-muted-foreground text-xs">
                                    @pub.Category
                                </span>
                                <span class="text-muted-foreground text-xs">&bull;</span>
                                <span class="text-muted-foreground text-xs">@pub.Publication</span>
                                <span class="text-muted-foreground text-xs">&bull;</span>
                                <span class="text-muted-foreground text-xs tabular-nums">@pub.Date</span>
                            </div>
                            <p class="mt-3 text-muted-foreground text-sm">@pub.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PublicationItem(string Title, string Publication, string Date, string Category, string Description);

    private readonly List<PublicationItem> _publications =
    [
        new("The State of Real-Time Collaboration: 2024 Industry Report", "Internal Research", "December 2024", "Report",
            "Comprehensive analysis of collaboration software trends, user expectations, and technical challenges"),
        new("Building Privacy-First Analytics Platforms", "IEEE Software Magazine", "October 2024", "Article",
            "Technical deep-dive on implementing differential privacy and encrypted analytics at scale"),
        new("Enterprise Migration to Modern Collaboration Tools", "Acme Corp Case Study", "August 2024", "Case Study",
            "How a Fortune 500 company migrated 10,000 users to our platform in 90 days"),
        new("Database Performance Optimization: A Practical Guide", "Internal Whitepaper", "June 2024", "Whitepaper",
            "Best practices for query optimization, indexing strategies, and connection pool management"),
        new("The Future of Work: Async-First Communication", "Harvard Business Review Online", "March 2024", "Article",
            "Why distributed teams are adopting asynchronous workflows and what it means for productivity"),
        new("Security Architecture for Multi-Tenant SaaS", "Internal Whitepaper", "January 2024", "Whitepaper",
            "Comprehensive guide to tenant isolation, encryption, and compliance for enterprise SaaS applications"),
    ];
}
