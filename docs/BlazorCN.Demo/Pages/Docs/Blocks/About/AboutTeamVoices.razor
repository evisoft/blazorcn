@* ============================================================
   Block: about-team-voices
   Title: About Team Voices
   Description: About section with team quote carousel and company intro
   Long Description: Customer testimonial integrated
   Dependencies: AvatarCn, BadgeCn, ButtonCn
   Source: original/blocks/about/about-team-voices.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid lg:grid-cols-2">
            <div class="border-b px-6 py-6 lg:border-b-0 lg:border-r">
                <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                    About Us
                </BadgeCn>

                <h2 class="mb-4 text-xl font-semibold tracking-tight">
                    We believe work should feel effortless
                </h2>

                <div class="mb-6 space-y-3 text-sm text-muted-foreground">
                    <p>
                        Founded in 2020, we set out to eliminate the friction that slows teams down. Today,
                        we're a team of 45 working across three continents, united by a simple belief: great
                        tools should feel invisible.
                    </p>
                    <p>
                        Our platform serves over 15,000 teams—from two-person startups to Fortune 500
                        enterprises—all looking for a better way to get things done.
                    </p>
                </div>

                <ButtonCn Class="gap-2" Variant="ButtonVariant.Outline">
                    Our Story
                    <LucideIconCn Name="arrow-right" Size="16" Class="h-4 w-4" />
                </ButtonCn>
            </div>

            <div class="flex flex-col justify-center gap-3 px-6 py-6">
                @foreach (var item in _quotes)
                {
                    <div class="rounded-md bg-muted/50 p-4">
                        <LucideIconCn Name="quote" Size="16" Class="mb-2 h-4 w-4 text-muted-foreground" />
                        <p class="mb-3 text-sm italic">@item.Quote</p>
                        <div class="flex items-center gap-2">
                            <AvatarCn Class="h-7 w-7">
                                <AvatarFallbackCn Class="bg-background text-xs font-medium">
                                    @item.Initials
                                </AvatarFallbackCn>
                            </AvatarCn>
                            <div>
                                <p class="text-sm font-medium">@item.Name</p>
                                <p class="text-xs text-muted-foreground">@item.Role</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record QuoteItem(string Quote, string Name, string Role, string Initials);

    private readonly List<QuoteItem> _quotes =
    [
        new("We're building the tool we always wished existed. That's what gets me out of bed.",
            "Sarah Chen", "CEO", "SC"),
        new("Every line of code we write is in service of making someone's day a little easier.",
            "Marcus Lee", "CTO", "ML"),
        new("Our users aren't just customers—they're collaborators shaping the product.",
            "Priya Sharma", "Head of Product", "PS"),
    ];
}
