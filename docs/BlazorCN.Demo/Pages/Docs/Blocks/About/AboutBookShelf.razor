@* ============================================================
   Block: about-book-shelf
   Title: About Book Shelf
   Description: A curated reading list showcasing books that influence company culture and team thinking, with author names and personal notes on why each book matters.
   Long Description: Build trust and show intellectual culture with a team reading list. This about block displays recommended books with titles, authors, and personal notes on why they matter to your team.
   Dependencies: None
   Source: original/blocks/about/about-book-shelf.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Team Book Shelf</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Books that shaped our thinking and culture
            </p>
        </div>

        <div class="grid gap-4 p-6 sm:grid-cols-2">
            @foreach (var book in _books)
            {
                <div class="rounded-md border bg-muted/50 p-4">
                    <div class="flex items-start gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-background">
                            <LucideIconCn Name="book-open" Size="20" Class="size-5 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <h3 class="text-sm font-medium">@book.Title</h3>
                            <p class="mt-0.5 text-xs text-muted-foreground">by @book.Author</p>
                            <p class="mt-2 text-sm text-muted-foreground">@book.Note</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record BookItem(string Title, string Author, string Note);

    private readonly List<BookItem> _books =
    [
        new("The Pragmatic Programmer", "David Thomas & Andrew Hunt",
            "Timeless advice on craftsmanship and pragmatic thinking in software development"),
        new("Team Topologies", "Matthew Skelton & Manuel Pais",
            "Shaped how we organize teams and optimize for fast flow of change"),
        new("An Elegant Puzzle", "Will Larson",
            "Our guide to systems thinking in engineering management and organizational design"),
        new("The Mom Test", "Rob Fitzpatrick",
            "Changed how we talk to customers and validate product ideas before building"),
        new("Accelerate", "Nicole Forsgren, Jez Humble & Gene Kim",
            "Data-driven insights on high-performing teams that informed our DevOps culture"),
        new("Shape Up", "Ryan Singer",
            "Influenced our product development cycles and how we scope projects"),
    ];
}
