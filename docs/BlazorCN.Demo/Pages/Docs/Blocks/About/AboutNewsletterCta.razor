@* ============================================================
   Block: about-newsletter-cta
   Title: About Newsletter Cta
   Description: An email newsletter signup section with subscriber count social proof for about pages
   Long Description: Convert about page visitors into subscribers with an integrated newsletter signup. Shows subscriber count for social proof and includes brief value proposition to drive email list growth.
   Dependencies: ButtonCn, InputCn
   Source: original/blocks/about/about-newsletter-cta.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Stay Updated</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Get product updates, engineering insights, and company news
            </p>
        </div>

        <div class="p-6">
            <div class="flex items-start gap-4">
                <div class="rounded-md bg-muted/50 p-3">
                    <LucideMailCn Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <div class="flex-1">
                    <h3 class="text-sm font-medium">Monthly Newsletter</h3>
                    <p class="mt-1 text-sm text-muted-foreground">
                        Behind-the-scenes updates on product development, technical deep dives, and early
                        access to new features. No spam, unsubscribe anytime.
                    </p>
                </div>
            </div>

            <div class="mt-6">
                <div class="flex gap-2">
                    <InputCn Type="email" Placeholder="@("you@example.com")" Value="@_email" Class="h-9 flex-1" />
                    <ButtonCn Class="h-9">
                        Subscribe
                    </ButtonCn>
                </div>
            </div>

            <div class="mt-4 flex items-center gap-2">
                <div class="size-2 rounded-full bg-emerald-500"></div>
                <p class="text-xs text-muted-foreground">Join 14,230 subscribers</p>
            </div>

            <div class="mt-6 rounded-md border bg-muted/50 p-4">
                <p class="text-sm font-medium">What to Expect</p>
                <ul class="mt-2 space-y-1 text-sm text-muted-foreground">
                    <li>&#x2022; Feature announcements and product updates</li>
                    <li>&#x2022; Engineering blog posts and technical tutorials</li>
                    <li>&#x2022; Early access to beta features</li>
                    <li>&#x2022; One email per month, sent first Friday</li>
                </ul>
            </div>
        </div>
    </div>
</section>

@code {
    private string _email = "";
}
