@* ============================================================
   Block: about-team-activities
   Title: About Team Activities
   Description: A team culture section highlighting social activities, events, and team building with frequency and descriptions
   Long Description: Build a transparent view of your team culture with this activities showcase. Displays regular events, social gatherings, and team building initiatives that keep teams connected.
   Dependencies: None
   Source: original/blocks/about/about-team-activities.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Team Activities &amp; Events</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Regular gatherings and activities that keep our distributed team connected, from weekly
                coffee chats to annual retreats
            </p>
        </div>

        <div class="divide-y">
            @foreach (var activity in _activities)
            {
                <div class="px-6 py-5">
                    <div class="flex items-start gap-4">
                        <div class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-muted/50 text-2xl">
                            @activity.Emoji
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <h3 class="font-medium text-sm">@activity.Title</h3>
                                <span class="inline-flex items-center gap-1 rounded-full bg-muted px-2 py-0.5 text-muted-foreground text-xs">
                                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                    @activity.Frequency
                                </span>
                            </div>

                            <p class="mt-2 text-muted-foreground text-sm">@activity.Description</p>

                            <div class="mt-3 flex items-center gap-1.5 text-muted-foreground text-xs">
                                <LucideIconCn Name="map-pin" Size="14" Class="size-3.5" />
                                <span>@activity.Format</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-6 py-5">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <h3 class="font-medium text-sm">Participation &amp; Inclusivity</h3>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
                @foreach (var item in _inclusivityItems)
                {
                    <div class="rounded-md bg-muted/50 p-4">
                        <div class="font-medium text-sm">@item.Title</div>
                        <div class="mt-1 text-muted-foreground text-sm">@item.Description</div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t bg-muted/30 px-6 py-4">
            <p class="text-muted-foreground text-sm">
                Remote-first doesn't mean remote-only. We balance virtual connection with intentional
                in-person time to build lasting relationships.
            </p>
        </div>
    </div>
</section>

@code {
    private record Activity(string Emoji, string Title, string Frequency, string Description, string Format);
    private record InclusivityItem(string Title, string Description);

    private readonly List<Activity> _activities =
    [
        new("\u2615", "Coffee Chats", "Weekly",
            "Random pairing of team members for casual 30-minute video chats. Great for cross-team connections.",
            "Virtual or in-person"),
        new("\uD83C\uDFAE", "Game Nights", "Monthly",
            "Team game sessions ranging from board games to online multiplayer. Pizza and drinks provided.",
            "Hybrid (virtual + office)"),
        new("\uD83C\uDF55", "Lunch & Learn", "Bi-weekly",
            "Educational sessions where team members share expertise over catered lunch. Topics from tech to hobbies.",
            "Virtual with meal stipend"),
        new("\u26F0\uFE0F", "Team Offsites", "Quarterly",
            "Two-day gathering for strategic planning, team building, and socializing. Includes activities and dinners.",
            "In-person at retreat location"),
        new("\u2708\uFE0F", "Annual Company Retreat", "Yearly",
            "Week-long all-hands gathering at destination location. Mix of strategy sessions, workshops, and leisure.",
            "All-inclusive travel package"),
    ];

    private readonly List<InclusivityItem> _inclusivityItems =
    [
        new("Opt-in by Default",
            "All activities are optional. We encourage participation but respect personal time and boundaries."),
        new("Inclusive Activities",
            "Activities designed to accommodate different time zones, abilities, and preferences."),
        new("Budget Transparency",
            "Company covers all costs. Travel, meals, and activities fully expensed for team events."),
        new("Feedback Welcome",
            "Suggest new activities or improvements. We evolve events based on team input."),
    ];
}
