@* ============================================================
   Block: about-skills-matrix
   Title: About Skills Matrix
   Description: About section with team skills and capabilities matrix
   Long Description: Detailed security measures overview showing encryption, access control, monitoring, and incident response capabilities.
   Dependencies: BadgeCn
   Source: original/blocks/about/about-skills-matrix.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5 text-center">
            <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                Our Skills
            </BadgeCn>
            <h2 class="mb-2 text-xl font-semibold tracking-tight">
                Capabilities that deliver results
            </h2>
            <p class="text-sm text-muted-foreground">
                Deep expertise where it matters, built through years of real projects.
            </p>
        </div>

        @* Skills matrix *@
        <div class="px-6 py-5">
            <div class="space-y-4">
                @foreach (var skill in _skills)
                {
                    <div class="flex items-center gap-4">
                        <span class="w-40 shrink-0 text-sm font-medium sm:w-48">@skill.Name</span>
                        <div class="flex flex-1 gap-1">
                            @for (var level = 1; level <= 3; level++)
                            {
                                <div class="@Cn.Merge("h-2 flex-1 rounded-full", level <= skill.Level ? "bg-foreground" : "bg-muted")"></div>
                            }
                        </div>
                        <span class="w-20 text-right text-xs text-muted-foreground">
                            @(skill.Level == 3 ? "Expert" : skill.Level == 2 ? "Proficient" : "Competent")
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Legend *@
        <div class="border-t px-6 py-4">
            <div class="flex items-center justify-center gap-6 text-xs text-muted-foreground">
                <div class="flex items-center gap-2">
                    <div class="h-2 w-8 rounded-full bg-muted"></div>
                    <span>Learning</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="h-2 w-8 rounded-full bg-foreground/50"></div>
                    <span>Proficient</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="h-2 w-8 rounded-full bg-foreground"></div>
                    <span>Expert</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SkillItem(string Name, int Level);

    private readonly List<SkillItem> _skills =
    [
        new("React / Next.js", 3),
        new("TypeScript", 3),
        new("Node.js", 3),
        new("Python", 2),
        new("PostgreSQL", 3),
        new("AWS", 2),
        new("Figma", 3),
        new("UI/UX Design", 3),
        new("DevOps", 2),
        new("Mobile (React Native)", 2),
    ];
}
