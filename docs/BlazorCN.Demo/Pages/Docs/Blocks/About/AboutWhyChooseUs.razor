@* ============================================================
   Block: about-why-choose-us
   Title: About Why Choose Us
   Description: Key differentiators and reasons to choose your product over alternatives with clear value propositions
   Long Description: Make your competitive advantages crystal clear. This component highlights the specific reasons customers choose you over alternatives, helping prospects quickly understand your unique value proposition.
   Dependencies: None
   Source: original/blocks/about/about-why-choose-us.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Why Teams Choose Us</h2>
            <p class="mt-1 text-muted-foreground text-sm">What sets us apart from alternatives</p>
        </div>

        <div class="p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                @foreach (var diff in _differentiators)
                {
                    <div class="rounded-md border p-4">
                        <div class="flex items-start gap-3">
                            <div class="mt-0.5">
                                <LucideIconCn Name="@diff.Icon" Size="20" Class="size-5 text-muted-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <h3 class="font-medium text-sm">@diff.Title</h3>
                                <p class="mt-1.5 text-muted-foreground text-sm">@diff.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Differentiator(string Icon, string Title, string Description);

    private readonly List<Differentiator> _differentiators =
    [
        new("rocket", "Ship Faster",
            "Get from idea to production in days, not months. Pre-built components, patterns, and integrations eliminate weeks of repetitive development work."),
        new("shield-check", "Actually Reliable",
            "99.99% uptime backed by SLA credits. Battle-tested by thousands of production applications. Multi-region redundancy and automatic failover built in."),
        new("heart-handshake", "Support That Helps",
            "Real engineers respond to tickets, not bots or scripts. Average 47-minute response time. We fix issues, not just acknowledge them."),
        new("zap", "Scales With You",
            "Handle 10 users or 10 million without re-architecting. Same API, same code. Performance optimized from day one, not a paid add-on later."),
        new("users", "Built for Teams",
            "Collaboration features that actually work. Granular permissions, audit logs, and team workspaces. Not a single-player tool with 'teams' bolted on."),
        new("brain", "Developer-First DNA",
            "Built by developers who use this daily. API-first design. TypeScript throughout. Documentation that assumes you're smart and busy, not incompetent."),
    ];
}
