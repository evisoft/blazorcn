@* ============================================================
   Block: about-growth-trajectory
   Title: AboutGrowthTrajectory
   Description: A year-over-year growth data table block for React and Next.js with revenue, customer, employee, and NPS metrics, YoY change badges, CAGR footer calculations, and staggered row entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-growth-trajectory.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-5 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Growth Trajectory</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Year-over-year metrics from launch to present
                    </p>
                </div>
                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    All metrics trending up
                </div>
            </div>
        </div>

        @* Table *@
        <div class="overflow-x-auto">
            <TableCn>
                <TableHeaderCn>
                    <TableRowCn Class="hover:bg-transparent">
                        <TableHeadCn Class="w-[80px] text-[10px] font-medium uppercase tracking-wider">
                            Year
                        </TableHeadCn>
                        <TableHeadCn Class="text-[10px] font-medium uppercase tracking-wider">
                            Revenue
                        </TableHeadCn>
                        <TableHeadCn Class="text-[10px] font-medium uppercase tracking-wider">
                            Customers
                        </TableHeadCn>
                        <TableHeadCn Class="text-[10px] font-medium uppercase tracking-wider">
                            Employees
                        </TableHeadCn>
                        <TableHeadCn Class="text-right text-[10px] font-medium uppercase tracking-wider">
                            NPS Score
                        </TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var row in _growthData)
                    {
                        <TableRowCn Class="border-b transition-colors hover:bg-muted/50">
                            <TableCellCn Class="font-mono text-xs font-medium">@row.Year</TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <span class="font-mono text-sm tabular-nums">@row.Revenue.Display</span>
                                    @RenderChangeIndicator(row.Revenue.Change, row.Revenue.Direction)
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <span class="font-mono text-sm tabular-nums">@row.Customers.Display</span>
                                    @RenderChangeIndicator(row.Customers.Change, row.Customers.Direction)
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <span class="font-mono text-sm tabular-nums">@row.Employees.Display</span>
                                    @RenderChangeIndicator(row.Employees.Change, row.Employees.Direction)
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <span class="font-mono text-sm tabular-nums">@row.Nps.Display</span>
                                    @RenderChangeIndicator(row.Nps.Change, row.Nps.Direction)
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
                <TableFooterCn>
                    <TableRowCn Class="bg-muted/30 hover:bg-muted/30">
                        <TableCellCn Class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            CAGR
                        </TableCellCn>
                        <TableCellCn>
                            <span class="font-mono text-xs font-medium text-emerald-600">@_cagr.Revenue</span>
                        </TableCellCn>
                        <TableCellCn>
                            <span class="font-mono text-xs font-medium text-emerald-600">@_cagr.Customers</span>
                        </TableCellCn>
                        <TableCellCn>
                            <span class="font-mono text-xs font-medium text-emerald-600">@_cagr.Employees</span>
                        </TableCellCn>
                        <TableCellCn Class="text-right">
                            <span class="font-mono text-xs font-medium text-emerald-600">@_cagr.Nps</span>
                        </TableCellCn>
                    </TableRowCn>
                </TableFooterCn>
            </TableCn>
        </div>

        @* Footer *@
        <div class="border-t px-5 py-3">
            <p class="text-[10px] text-muted-foreground">
                Revenue figures are ARR. Customer and employee counts as of year-end. CAGR calculated
                over the 4-year period 2022-2026. NPS measured via quarterly surveys.
            </p>
        </div>
    </div>
</section>

@code {
    private record MetricValue(string Display, string Change, string Direction);
    private record YearData(string Year, MetricValue Revenue, MetricValue Customers, MetricValue Employees, MetricValue Nps);
    private record CagrRow(string Revenue, string Customers, string Employees, string Nps);

    private static readonly YearData[] _growthData =
    [
        new("2022",
            new("$1.2M",   "--",    "flat"),
            new("2,400",   "--",    "flat"),
            new("12",      "--",    "flat"),
            new("72",      "--",    "flat")),
        new("2023",
            new("$3.8M",   "+217%", "up"),
            new("8,600",   "+258%", "up"),
            new("18",      "+50%",  "up"),
            new("78",      "+8%",   "up")),
        new("2024",
            new("$8.2M",   "+116%", "up"),
            new("24,100",  "+180%", "up"),
            new("32",      "+78%",  "up"),
            new("84",      "+8%",   "up")),
        new("2025",
            new("$15.4M",  "+88%",  "up"),
            new("52,300",  "+117%", "up"),
            new("48",      "+50%",  "up"),
            new("91",      "+8%",   "up")),
        new("2026",
            new("$28.6M",  "+86%",  "up"),
            new("95,000",  "+82%",  "up"),
            new("78",      "+63%",  "up"),
            new("94",      "+3%",   "up")),
    ];

    private static readonly CagrRow _cagr = new("120%", "148%", "60%", "7%");

    private RenderFragment RenderChangeIndicator(string change, string direction)
    {
        if (direction == "flat")
        {
            return @<span class="inline-flex items-center gap-0.5 text-[10px] text-muted-foreground">
                <LucideIconCn Name="minus" Size="10" Class="size-2.5" />
                base
            </span>;
        }

        bool isUp = direction == "up";
        string badgeClass = Cn.Merge("gap-0.5 text-[10px] font-normal",
            isUp ? "bg-emerald-500/10 text-emerald-600" : "bg-red-500/10 text-red-600");

        if (isUp)
        {
            return @<BadgeCn Variant="BadgeVariant.Secondary" Class="@badgeClass">
                <LucideIconCn Name="arrow-up-right" Size="10" Class="size-2.5" />
                @change
            </BadgeCn>;
        }
        else
        {
            return @<BadgeCn Variant="BadgeVariant.Secondary" Class="@badgeClass">
                <LucideIconCn Name="arrow-down-right" Size="10" Class="size-2.5" />
                @change
            </BadgeCn>;
        }
    }
}
