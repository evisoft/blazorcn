@* ============================================================
   Block: about-differentiators
   Title: About Differentiators
   Description: About section with company differentiators and unique selling points
   Long Description: Product design philosophy showcasing core design principles with explanations for each guiding belief.
   Dependencies: ButtonCn
   Source: original/blocks/about/about-differentiators.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid gap-8 p-6 lg:grid-cols-2">
            @* Left - Content *@
            <div class="flex flex-col justify-center">
                <h2 class="text-xl font-semibold tracking-tight">Built different, on purpose</h2>

                <p class="mt-3 text-sm text-muted-foreground leading-relaxed">
                    We made deliberate choices that set us apart. Not because different is better, but
                    because these choices serve you better.
                </p>

                <div class="mt-6">
                    <ButtonCn Class="gap-2" Variant="ButtonVariant.Outline">
                        See Product Demo
                        <LucideIconCn Name="arrow-right" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>

            @* Right - Differentiators *@
            <div class="space-y-6">
                @foreach (var item in _differentiators)
                {
                    <div class="flex gap-4">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-full border">
                            <LucideIconCn Name="@item.Icon" Size="20" Class="size-5 text-muted-foreground" />
                        </div>
                        <div>
                            <h3 class="text-sm font-medium">@item.Title</h3>
                            <p class="mt-1 text-sm text-muted-foreground leading-relaxed">
                                @item.Description
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Differentiator(string Icon, string Title, string Description);

    private readonly List<Differentiator> _differentiators =
    [
        new("zap", "10x faster setup", "Get started in minutes, not weeks. No consultants required."),
        new("shield", "Enterprise security, startup pricing", "SOC 2, GDPR, and HIPAA compliant without the enterprise cost."),
        new("heart", "Human support, always", "Real people respond in under 2 hours. No chatbots, no runaround."),
        new("clock", "No long-term contracts", "Month-to-month flexibility. We earn your business every day."),
    ];
}
