@* ============================================================
   Block: about-tabs
   Title: About Tabs
   Description: About section with tabbed content for different topics
   Long Description: An environmental commitments section showing carbon neutral status and green initiatives for about pages
   Dependencies: BadgeCn, ButtonCn, TabsCn
   Source: original/blocks/about/about-tabs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5 text-center">
          <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
            About Us
          </BadgeCn>

          <h2 class="text-xl font-semibold tracking-tight">Get to know us</h2>
        </div>

        <div class="p-6">
          <TabsCn Class="w-full" Value="story">
            <TabsListCn Class="mb-6 grid w-full grid-cols-3">
              <TabsTriggerCn Value="story">Our Story</TabsTriggerCn>
              <TabsTriggerCn Value="mission">Mission</TabsTriggerCn>
              <TabsTriggerCn Value="values">Values</TabsTriggerCn>
            </TabsListCn>

            <TabsContentCn Class="space-y-4" Value="story">
              <p class="text-sm text-muted-foreground">
                It started with a frustration. In 2019, our founders were tired of cobbling together
                dozens of tools just to get basic work done. There had to be a better way.
              </p>
              <p class="text-sm text-muted-foreground">
                Six months later, the first version launched. It was rough around the edges, but it
                worked. More importantly, people loved it. Today, we're a team of 40 serving
                thousands of companies worldwide.
              </p>
              <ButtonCn Class="h-auto gap-1 p-0" Variant="ButtonVariant.Link">
                Read the full story
                <LucideArrowRightCn Size="12" Class="h-3 w-3" />
              </ButtonCn>
            </TabsContentCn>

            <TabsContentCn Class="space-y-4" Value="mission">
              <p class="text-sm font-medium">
                To make professional tools accessible to everyone, regardless of technical skill or
                budget.
              </p>
              <p class="text-sm text-muted-foreground">
                We believe powerful software shouldn't require a computer science degree or
                enterprise budget. Every feature we build is tested against this principle: would a
                first-time user understand it?
              </p>
              <ButtonCn Class="h-auto gap-1 p-0" Variant="ButtonVariant.Link">
                See our roadmap
                <LucideArrowRightCn Size="12" Class="h-3 w-3" />
              </ButtonCn>
            </TabsContentCn>

            <TabsContentCn Class="space-y-4" Value="values">
              <ul class="space-y-3">
                <li class="flex gap-3">
                  <span class="text-sm font-medium text-muted-foreground">01</span>
                  <div>
                    <span class="text-sm font-medium">Simplicity first</span>
                    <p class="text-sm text-muted-foreground">
                      If it's not simple, it's not done.
                    </p>
                  </div>
                </li>
                <li class="flex gap-3">
                  <span class="text-sm font-medium text-muted-foreground">02</span>
                  <div>
                    <span class="text-sm font-medium">Users over metrics</span>
                    <p class="text-sm text-muted-foreground">
                      We optimize for happiness, not engagement.
                    </p>
                  </div>
                </li>
                <li class="flex gap-3">
                  <span class="text-sm font-medium text-muted-foreground">03</span>
                  <div>
                    <span class="text-sm font-medium">Ship and iterate</span>
                    <p class="text-sm text-muted-foreground">Perfect is the enemy of good.</p>
                  </div>
                </li>
              </ul>
            </TabsContentCn>
          </TabsCn>
        </div>
      </div>
    </section>

@code {
}
