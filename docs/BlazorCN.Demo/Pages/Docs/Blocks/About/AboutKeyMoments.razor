@* ============================================================
   Block: about-key-moments
   Title: AboutKeyMoments
   Description: A vertical timeline key moments block for React and Next.js with left-rail timeline, impact-sized dot nodes, monospace year labels, impact badges, event descriptions, and alternating entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-key-moments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between">
                <div>
                    <h2 class="text-sm font-medium">Key Moments</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_moments.Length pivotal moments that shaped the company
                    </p>
                </div>
                <span class="font-mono text-[10px] text-muted-foreground/50">
                    @_moments[0].Year&ndash;@_moments[^1].Year
                </span>
            </div>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            @for (var i = 0; i < _moments.Length; i++)
            {
                var moment = _moments[i];
                var isLast = i == _moments.Length - 1;

                <div class="flex gap-4">
                    @* Left rail: year + dot + line *@
                    <div class="flex w-14 shrink-0 flex-col items-center">
                        @* Year label *@
                        <span class="font-mono text-xs font-medium tabular-nums text-foreground">
                            @moment.Year
                        </span>

                        @* Dot sized by importance *@
                        <div class="my-1.5 flex items-center justify-center">
                            <div class="@Cn.Merge(DotSize(moment.Importance), "rounded-full bg-foreground")" />
                        </div>

                        @* Connecting line *@
                        @if (!isLast)
                        {
                            <div class="w-px flex-1 bg-border" />
                        }
                    </div>

                    @* Right: content card *@
                    <div class="mb-4 flex-1 pb-1">
                        @* Title + impact badge *@
                        <div class="flex items-start justify-between gap-2">
                            <h3 class="text-sm font-medium leading-snug">@moment.Title</h3>
                            <BadgeCn Variant="BadgeVariant.Secondary"
                                     Class="@Cn.Merge("shrink-0 text-[10px] font-normal", ImpactColor(moment.Importance))">
                                @moment.Impact
                            </BadgeCn>
                        </div>

                        @* Description *@
                        <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                            @moment.Description
                        </p>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center gap-2 border-t px-4 py-2.5">
            <span class="text-xs tabular-nums text-muted-foreground">
                @_moments.Length moments
            </span>
            <span class="size-1 rounded-full bg-muted-foreground/40" />
            <span class="text-xs text-muted-foreground">@_moments[^1].Year</span>
            <span class="size-1 rounded-full bg-muted-foreground/40" />
            <span class="text-xs text-muted-foreground">Still writing the next chapter</span>
        </div>
    </div>
</section>

@code {
    private record Moment(string Id, string Year, string Title, string Description, string Impact, int Importance);

    private static readonly Moment[] _moments =
    [
        new("founding", "2019", "Founded in a Brooklyn apartment",
            "Two engineers tired of rebuilding the same UI patterns at every company. First commit: a Button component with 14 variants.",
            "Day zero", 3),
        new("open-source", "2020", "Open-sourced the component library",
            "Put the entire codebase on GitHub. Within a month, 50 contributors submitted pull requests. The community started shaping the product direction.",
            "500 GitHub stars", 2),
        new("first-enterprise", "2021", "First enterprise client",
            "A Fortune 500 bank adopted the library for their internal tools platform. Validated that enterprise teams trust community-driven components for production workloads.",
            "First enterprise client", 3),
        new("seed-round", "2021", "Raised seed round",
            "Closed $2.5M from developer-tool-focused angels including the former GitHub CEO. Capital used to hire the first 5 full-time engineers.",
            "$2.5M raised", 2),
        new("ten-thousand", "2022", "10,000 projects using the library",
            "Crossed the 10K npm dependent threshold. The component registry idea — letting anyone publish components — proved to be the growth accelerator.",
            "10x growth", 3),
        new("series-a", "2023", "Series A and team expansion",
            "Raised $12M led by Benchmark. Grew from 8 to 28 people across engineering, design, and developer relations. Opened applications for the first community advisory board.",
            "$12M Series A", 2),
        new("registry-launch", "2024", "Launched the public registry",
            "Opened the component registry to all creators. 800+ components published in the first quarter. Revenue from Pro subscriptions exceeded expectations by 3x.",
            "800+ components", 3),
        new("today", "2025", "5,000+ components, 200K+ developers",
            "The registry now hosts components from individual creators and companies alike. Used by teams at Stripe, Vercel, Linear, and thousands of startups building their next product.",
            "200K+ developers", 3),
    ];

    private static string DotSize(int importance) => importance switch
    {
        1 => "size-2",
        2 => "size-2.5",
        3 => "size-3.5",
        _ => "size-2",
    };

    private static string ImpactColor(int importance) => importance switch
    {
        1 => "bg-muted text-muted-foreground",
        2 => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        3 => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        _ => "bg-muted text-muted-foreground",
    };
}
