@* ============================================================
   Block: about-guarantee
   Title: AboutGuarantee
   Description: A trust-building guarantee block for React and Next.js with checkmark-verified promises, fine-print detail lines, expandable terms section, and fade entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-guarantee.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-5 py-4">
            <h2 class="text-sm font-medium">Our Guarantee</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Four commitments we stand behind, in writing.
            </p>
        </div>

        @* Guarantee items *@
        <div class="divide-y">
            @foreach (var item in _guarantees)
            {
                <div class="px-5 py-4">
                    <div class="flex items-start gap-3">
                        <div class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <h3 class="text-sm font-medium">@item.Title</h3>
                            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                                @item.Detail
                            </p>
                            <p class="mt-2 text-[10px] leading-relaxed text-muted-foreground/70">
                                @item.FinePrint
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t bg-muted/30 px-5 py-3">
            <span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground transition-colors hover:text-foreground">
                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                Read full terms and conditions
            </span>
        </div>
    </div>
</section>

@code {
    private record Guarantee(string Id, string Title, string Detail, string FinePrint);

    private static readonly Guarantee[] _guarantees =
    [
        new("money-back",
            "30-day money-back guarantee",
            "Try the full platform risk-free. If it doesn't meet your needs within 30 days, we'll issue a complete refund — no questions, no hoops.",
            "Refund processed within 5 business days to original payment method. Applies to annual and monthly plans."),
        new("uptime",
            "99.95% uptime SLA",
            "Our infrastructure runs across three availability zones with automated failover. If we fall below 99.95% in any calendar month, you receive service credits.",
            "Credits calculated as 10x the downtime duration against monthly fee. Scheduled maintenance windows excluded."),
        new("portability",
            "Full data portability",
            "Your data belongs to you. Export everything — projects, configurations, history, attachments — in standard formats at any time, with no waiting period.",
            "Exports available in JSON, CSV, and ZIP archive formats. API access included for automated migrations."),
        new("no-lock-in",
            "Zero lock-in, cancel anytime",
            "No annual contracts required. Cancel your subscription at any time and retain access through the end of your billing period. We earn your business every month.",
            "Prepaid annual plans refunded pro-rata for unused months. Account data retained for 90 days after cancellation."),
    ];
}
