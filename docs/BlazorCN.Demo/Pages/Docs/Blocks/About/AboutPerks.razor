@* ============================================================
   Block: about-perks
   Title: About Perks
   Description: Employee perks grid with careers CTA card for React hiring and careers pages
   Long Description: A portfolio of granted patents showcasing innovation and intellectual property in key technology areas.
   Dependencies: ButtonCn
   Source: original/blocks/about/about-perks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Perks that matter</h2>
        </div>

        @* Content grid *@
        <div class="p-6">
            <div class="grid gap-6 lg:grid-cols-3">
                @* Perks list *@
                <div class="lg:col-span-2">
                    <div class="grid gap-3 sm:grid-cols-2">
                        @foreach (var perk in _perks)
                        {
                            <div class="flex items-start gap-3 rounded-lg border p-4">
                                <div class="flex size-9 shrink-0 items-center justify-center rounded-full border">
                                    <LucideIconCn Name="@perk.Icon" Size="16" Class="size-4 text-muted-foreground" />
                                </div>
                                <div>
                                    <p class="text-sm font-medium">@perk.Title</p>
                                    <p class="text-sm text-muted-foreground">@perk.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* CTA card *@
                <div class="h-fit rounded-lg bg-muted/50 p-6">
                    <h3 class="mb-2 text-sm font-medium">Join our team</h3>
                    <p class="mb-4 text-sm text-muted-foreground">
                        We're always looking for talented people who want to do their best work.
                    </p>
                    <ButtonCn Class="w-full gap-2" Variant="ButtonVariant.Outline">
                        View Open Roles
                        <LucideIconCn Name="arrow-right" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Perk(string Icon, string Title, string Description);

    private readonly List<Perk> _perks =
    [
        new("laptop", "Remote-first", "Work from anywhere"),
        new("plane", "Unlimited PTO", "We mean it—take time off"),
        new("heart", "Full health coverage", "Medical, dental, vision"),
        new("book-open", "$2K learning budget", "Courses, books, conferences"),
        new("coffee", "Team retreats", "Twice yearly, somewhere fun"),
        new("dollar-sign", "Competitive equity", "Own a piece of what we build"),
    ];
}
