@* ============================================================
   Block: about-customer-wall
   Title: About Customer Wall
   Description: A dense grid of customer quotes providing high-density social proof in a masonry-like layout
   Long Description: Build trust through customer voices. This component displays a wall of short customer testimonials in a dense, scannable format that provides immediate social proof without overwhelming the page.
   Dependencies: None
   Source: original/blocks/about/about-customer-wall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">What Customers Say</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Real feedback from teams using our platform
            </p>
        </div>

        <div class="p-6">
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var quote in _quotes)
                {
                    <div class="rounded-md border p-4">
                        <p class="text-sm">@quote.Text</p>
                        <div class="mt-3 border-t pt-3">
                            <p class="font-medium text-sm">@quote.Author</p>
                            <p class="text-muted-foreground text-xs">@quote.Company</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record CustomerQuote(string Text, string Author, string Company);

    private readonly List<CustomerQuote> _quotes =
    [
        new("Cut our development time in half. Game changer for our team.", "Sarah Chen", "TechFlow"),
        new("The best investment we made this year. ROI within the first month.", "Michael Roberts", "DataScale"),
        new("Support team is incredibly responsive. Issues resolved same day.", "Jessica Park", "CloudPro"),
        new("Finally, a tool that just works. No complicated setup or learning curve.", "David Kumar", "BuildFast"),
        new("Our customers love the new features we shipped using this.", "Emma Thompson", "UserFirst"),
        new("Scales effortlessly from MVP to millions of users.", "James Liu", "ScaleUp"),
        new("Documentation is actually good. Everything we needed was there.", "Ana Martinez", "DevTools Inc"),
        new("Switched from our old solution and never looked back.", "Tom Anderson", "NextGen"),
        new("The team behind this clearly cares about developer experience.", "Rachel Green", "CodeCraft"),
        new("Best-in-class reliability. 99.99% uptime without any babysitting.", "Kevin Zhang", "StableOps"),
    ];
}
