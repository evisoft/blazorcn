@* ============================================================
   Block: about-mentorship-program
   Title: About Mentorship Program
   Description: Company mentorship program overview with stats and program features for employee development.
   Long Description: Showcase your investment in employee growth. This component highlights mentorship program impact with key metrics and program features that demonstrate commitment to career development.
   Dependencies: None
   Source: original/blocks/about/about-mentorship-program.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Mentorship Program</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Accelerating career growth through peer mentorship
            </p>
        </div>

        <div class="border-b px-6 py-5">
            <div class="grid gap-6 sm:grid-cols-3">
                @foreach (var stat in _stats)
                {
                    <div class="space-y-2">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="@stat.Icon" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                                @stat.Label
                            </span>
                        </div>
                        <p class="font-semibold tabular-nums text-2xl">@stat.Value</p>
                    </div>
                }
            </div>
        </div>

        <div class="px-6 py-5">
            <h3 class="font-medium text-sm">How it works</h3>
            <div class="mt-4 space-y-4">
                @foreach (var feature in _features)
                {
                    <div class="rounded-md bg-muted/50 p-4">
                        <h4 class="font-medium text-sm">@feature.Title</h4>
                        <p class="mt-1.5 text-muted-foreground text-sm">@feature.Description</p>
                    </div>
                }
            </div>
        </div>

        <div class="border-t bg-muted/50 px-6 py-4">
            <p class="text-muted-foreground text-xs">
                78% of employees participate in the program. New hires are automatically matched with a
                mentor in their first month.
            </p>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Icon, string Label, string Value);
    private record FeatureItem(string Title, string Description);

    private readonly List<StatItem> _stats =
    [
        new("users", "Mentor-mentee pairs", "142"),
        new("clock", "Hours invested monthly", "580+"),
        new("star", "Program satisfaction", "4.8/5"),
    ];

    private readonly List<FeatureItem> _features =
    [
        new("Structured matching process",
            "Our People team matches mentors and mentees based on career goals, expertise areas, and personality fit. You can also request a specific mentor."),
        new("Bi-weekly 1-on-1 sessions",
            "Pairs meet for 30-minute sessions every two weeks to discuss career development, technical skills, and navigating company culture. Flexible scheduling."),
        new("Topic guides and resources",
            "We provide conversation guides, goal-setting templates, and a library of technical resources. Mentors receive training on effective coaching techniques."),
    ];
}
