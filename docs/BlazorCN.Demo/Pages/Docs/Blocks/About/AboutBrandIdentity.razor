@* ============================================================
   Block: about-brand-identity
   Title: About Brand Identity
   Description: A modern about section showcasing brand story, values, and personality traits with clean typography and minimal design.
   Long Description: Perfect for companies that want to articulate their brand essence and values in a clear, compelling format. This block presents brand origin, core values, and personality traits in an organized, scannable layout.
   Dependencies: None
   Source: original/blocks/about/about-brand-identity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Brand Identity</h2>
            <p class="mt-1 text-sm text-muted-foreground">What we stand for and why we exist</p>
        </div>

        @* Brand Story *@
        <div class="border-b px-6 py-5">
            <div class="space-y-3">
                <div>
                    <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        Origin Story
                    </span>
                    <h3 class="mt-2 text-lg font-semibold">Why "Acme"?</h3>
                </div>
                <p class="text-sm text-muted-foreground leading-relaxed">
                    The name comes from the Greek word "akme" meaning peak or zenith. We chose it because
                    we believe in reaching the highest point of quality and craftsmanship in everything we
                    build. It's a nod to the builders and makers who never settle for good enough.
                </p>
            </div>
        </div>

        @* Core Values *@
        <div class="border-b px-6 py-5">
            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Core Values
            </span>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
                @foreach (var value in _brandValues)
                {
                    <div class="rounded-md bg-muted/50 p-4">
                        <div class="flex items-start gap-3">
                            <LucideIconCn Name="@value.Icon" Size="20" Class="size-5 shrink-0 text-muted-foreground" />
                            <div class="min-w-0">
                                <h4 class="text-sm font-medium">@value.Title</h4>
                                <p class="mt-1 text-sm text-muted-foreground">@value.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Brand Personality *@
        <div class="px-6 py-5">
            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Brand Personality
            </span>
            <div class="mt-4 space-y-3">
                @for (var i = 0; i < _personalityTraits.Count; i++)
                {
                    var item = _personalityTraits[i];
                    var index = i;
                    <div class="@Cn.Merge("flex items-start gap-4 border-b pb-3", index == _personalityTraits.Count - 1 ? "border-0 pb-0" : "")">
                        <span class="font-mono text-xs text-muted-foreground">@(index + 1)</span>
                        <div class="min-w-0 flex-1">
                            <h4 class="text-sm font-medium">@item.Trait</h4>
                            <p class="mt-0.5 text-sm text-muted-foreground">@item.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record BrandValue(string Icon, string Title, string Description);
    private record PersonalityTrait(string Trait, string Description);

    private readonly List<BrandValue> _brandValues =
    [
        new("heart", "Customer Obsessed", "Every decision starts with the customer. We build for real people solving real problems."),
        new("lightbulb", "Radically Transparent", "We share our thinking, our roadmap, and our challenges openly with our community."),
        new("rocket", "Ship Fast, Learn Faster", "We believe in rapid iteration and learning from real-world usage over perfection."),
        new("users", "Built by Builders", "We're developers building for developers. We use our own tools every single day."),
    ];

    private readonly List<PersonalityTrait> _personalityTraits =
    [
        new("Practical", "No buzzwords. No hype. Just tools that work."),
        new("Opinionated", "We have strong beliefs, loosely held."),
        new("Community-First", "Built with and for our community."),
        new("Relentlessly Focused", "We do one thing exceptionally well."),
    ];
}
