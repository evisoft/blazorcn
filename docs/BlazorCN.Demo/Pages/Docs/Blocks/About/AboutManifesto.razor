@* ============================================================
   Block: about-manifesto
   Title: About Manifesto
   Description: Company manifesto section with bold declarative statements for React brand about pages
   Long Description: Make a statement with this manifesto component for Next.js about pages. Features a vertical list of bold, declarative belief statements with left border accent, plus a team signature at the bottom. Built with Tailwind CSS. Manifestos attract like-minded customers and repel the wrong ones—that's the point. Perfect for opinionated brands, mission-driven companies, and startups that want to stand for something beyond their product.
   Dependencies: None
   Source: original/blocks/about/about-manifesto.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">What we believe</h2>
        </div>

        @* Statements *@
        <div class="px-6 py-5">
            <div class="space-y-6">
                @foreach (var statement in _statements)
                {
                    <p class="border-l-2 border-foreground pl-6 text-sm font-medium leading-relaxed">
                        @statement
                    </p>
                }
            </div>
        </div>

        @* Signature *@
        <div class="border-t px-6 py-4 text-center">
            <p class="text-sm text-muted-foreground">— The team at Company, since 2019</p>
        </div>
    </div>
</section>

@code {
    private readonly string[] _statements =
    [
        "We believe software should feel like magic, not homework.",
        "We believe speed is a feature, not a nice-to-have.",
        "We believe transparency beats perfection every time.",
        "We believe small teams beat big teams when they're focused.",
        "We believe profit and purpose aren't mutually exclusive.",
        "We believe the best marketing is a great product.",
    ];
}
