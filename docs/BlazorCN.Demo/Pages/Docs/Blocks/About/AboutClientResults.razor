@* ============================================================
   Block: about-client-results
   Title: About Client Results
   Description: Display before and after metrics showing measurable client outcomes and improvements
   Long Description: Demonstrate real impact with concrete before/after comparisons. This results-focused layout makes performance improvements immediately visible—perfect for proving value and building credibility with data-driven decision makers.
   Dependencies: None
   Source: original/blocks/about/about-client-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Client Results</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Measurable outcomes from our customer partnerships
            </p>
        </div>

        <div class="grid gap-4 p-6 sm:grid-cols-2">
            @foreach (var result in _results)
            {
                <div class="overflow-hidden rounded-md border bg-card">
                    <div class="border-b bg-muted/50 px-4 py-2.5">
                        <p class="text-sm font-medium">@result.Company</p>
                    </div>
                    <div class="p-4">
                        <p class="mb-3 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                            @result.Metric
                        </p>
                        <div class="mb-4 flex items-center gap-3">
                            <div class="flex-1">
                                <p class="mb-0.5 text-xs text-muted-foreground">Before</p>
                                <p class="text-lg font-semibold tabular-nums">@result.Before</p>
                            </div>
                            <LucideIconCn Name="arrow-right" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            <div class="flex-1">
                                <p class="mb-0.5 text-xs text-muted-foreground">After</p>
                                <p class="text-lg font-semibold tabular-nums">@result.After</p>
                            </div>
                        </div>
                        <div class="flex items-center justify-between rounded-md bg-emerald-500/10 px-3 py-2">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-emerald-600" />
                                <span class="text-sm font-semibold text-emerald-600">
                                    @result.Improvement
                                </span>
                            </div>
                            <span class="text-xs text-muted-foreground">@result.Timeframe</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ClientResult(string Company, string Metric, string Before, string After, string Improvement, string Timeframe);

    private readonly List<ClientResult> _results =
    [
        new("TechFlow Solutions", "API Response Time", "4.2s", "0.3s", "93% faster", "First 30 days"),
        new("eCommerce Plus", "Conversion Rate", "2.1%", "8.7%", "+314%", "After 60 days"),
        new("DataStream Analytics", "Infrastructure Cost", "$12,400/mo", "$4,100/mo", "67% reduction", "Quarterly average"),
        new("CloudScale", "Deploy Frequency", "2x/week", "18x/day", "63x increase", "After migration"),
    ];
}
