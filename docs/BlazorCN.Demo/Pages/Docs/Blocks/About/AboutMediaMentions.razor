@* ============================================================
   Block: about-media-mentions
   Title: About Media Mentions
   Description: Display press and publication mentions in a clean as-seen-in section
   Long Description: Leverage media credibility with a clean showcase of publication mentions. This text-based layout maintains brand consistency while building authority—perfect for establishing legitimacy with new visitors.
   Dependencies: None
   Source: original/blocks/about/about-media-mentions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">As Seen In</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Featured in leading technology publications
            </p>
        </div>
        <div class="p-6">
            <div class="grid gap-px overflow-hidden rounded-md border bg-border">
                @foreach (var mention in _mentions)
                {
                    <div class="flex items-start gap-3 bg-card p-4 transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="newspaper" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="mb-1 flex items-center gap-2">
                                <p class="font-medium text-sm">@mention.Publication</p>
                                <span class="text-muted-foreground text-xs">@mention.Date</span>
                            </div>
                            <p class="text-muted-foreground text-sm">@mention.Headline</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record MediaMention(string Publication, string Date, string Headline);

    private readonly List<MediaMention> _mentions =
    [
        new("TechCrunch", "March 2026", "Raises $12M to expand developer platform"),
        new("The Verge", "February 2026", "The tool reshaping how teams build software"),
        new("Wired", "January 2026", "Inside the platform powering modern web apps"),
        new("VentureBeat", "December 2025", "Why developers are switching from legacy tools"),
        new("Fast Company", "November 2025", "Named to 'Most Innovative Companies' list"),
        new("Forbes", "October 2025", "The startup making enterprise software human"),
    ];
}
