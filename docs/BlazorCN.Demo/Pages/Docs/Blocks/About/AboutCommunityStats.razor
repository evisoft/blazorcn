@* ============================================================
   Block: about-community-stats
   Title: About Community Stats
   Description: A developer community metrics section showing GitHub stars, Discord members, and downloads for about pages
   Long Description: Display community engagement with key developer metrics. Shows GitHub stars, Discord members, npm downloads, and contributor count to demonstrate active open-source community and ecosystem health.
   Dependencies: None
   Source: original/blocks/about/about-community-stats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Developer Community</h2>
            <p class="mt-1 text-sm text-muted-foreground">Trusted by developers worldwide</p>
        </div>

        <div class="p-6">
            <p class="text-sm text-muted-foreground">
                Our open-source community drives innovation and helps shape the future of the platform.
                Join thousands of developers building with our tools and contributing to the ecosystem.
            </p>

            <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                @foreach (var stat in _stats)
                {
                    <div class="rounded-md bg-muted/50 p-4">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="@stat.Icon" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                @stat.Label
                            </span>
                        </div>
                        <p class="mt-2 font-semibold tabular-nums text-2xl">@stat.Value</p>
                    </div>
                }
            </div>

            <div class="mt-6 rounded-md border bg-muted/50 p-4">
                <p class="text-sm font-medium">Get Involved</p>
                <p class="mt-1 text-sm text-muted-foreground">
                    Contribute code, report issues, join discussions, or help improve our documentation.
                    Every contribution makes a difference.
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Icon, string Label, string Value);

    private readonly List<StatItem> _stats =
    [
        new("github", "GitHub Stars", "42.3k"),
        new("message-square", "Discord Members", "18.5k"),
        new("download", "Weekly Downloads", "2.1M"),
        new("users", "Contributors", "847"),
    ];
}
