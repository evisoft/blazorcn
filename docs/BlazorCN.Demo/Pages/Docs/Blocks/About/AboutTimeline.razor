@* ============================================================
   Block: about-timeline
   Title: About Timeline
   Description: About section with horizontal timeline and milestones
   Long Description: Display customer testimonials in a clean, scannable grid layout with quotes, names, and roles
   Dependencies: BadgeCn
   Source: original/blocks/about/about-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                Our Journey
            </BadgeCn>
            <h2 class="mb-2 text-xl font-semibold tracking-tight">
                From idea to industry leader
            </h2>
        </div>

        @* Horizontal timeline *@
        <div class="p-6">
            <div class="relative">
                @* Line *@
                <div class="absolute left-0 right-0 top-4 hidden h-px bg-border md:block"></div>

                @* Milestones *@
                <div class="flex gap-4 overflow-x-auto pb-2 md:grid md:grid-cols-5 md:gap-6 md:overflow-visible">
                    @foreach (var milestone in _milestones)
                    {
                        <div class="relative min-w-[200px] flex-shrink-0 md:min-w-0">
                            @* Dot *@
                            <div class="mb-3 flex items-center gap-3 md:flex-col md:items-start">
                                <div class="relative z-10 flex h-8 w-8 items-center justify-center rounded-full border-2 border-muted-foreground bg-background">
                                    <div class="h-2 w-2 rounded-full bg-muted-foreground"></div>
                                </div>
                                <span class="text-sm font-medium text-muted-foreground md:mt-2">
                                    @milestone.Year
                                </span>
                            </div>

                            @* Content *@
                            <div class="md:pr-4">
                                <h3 class="mb-1 text-sm font-medium">@milestone.Title</h3>
                                <p class="text-sm text-muted-foreground">@milestone.Description</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Milestone(string Year, string Title, string Description);

    private readonly List<Milestone> _milestones =
    [
        new("2018", "Founded", "Started in a garage with 3 people and a big dream"),
        new("2019", "Seed Round", "Raised $2M to build out the core product"),
        new("2021", "Series A", "Secured $15M and grew to 25 team members"),
        new("2023", "10K Users", "Hit our biggest milestone with global reach"),
        new("2024", "Series B", "Raised $40M to accelerate growth"),
    ];
}
