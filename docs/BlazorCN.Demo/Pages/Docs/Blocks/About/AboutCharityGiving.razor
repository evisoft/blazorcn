@* ============================================================
   Block: about-charity-giving
   Title: About Charity Giving
   Description: A charitable giving overview section showing donations, causes, and volunteer hours for about pages
   Long Description: Display corporate philanthropy with charitable giving metrics. Shows total donations, supported causes, volunteer hours, and matching programs to demonstrate social impact and community commitment.
   Dependencies: None
   Source: original/blocks/about/about-charity-giving.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Charitable Giving</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Supporting causes that matter to our community
            </p>
        </div>

        <div class="p-6">
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                @foreach (var stat in _stats)
                {
                    <div class="rounded-md bg-muted/50 p-4">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="@stat.Icon" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                @stat.Label
                            </span>
                        </div>
                        <p class="mt-2 text-2xl font-semibold tabular-nums">@stat.Value</p>
                    </div>
                }
            </div>

            <div class="mt-6">
                <h3 class="text-sm font-medium">Featured Causes</h3>
                <p class="mt-1 text-sm text-muted-foreground">
                    Organizations we have supported this year through corporate giving and employee
                    donations
                </p>

                <div class="mt-4 space-y-3">
                    @foreach (var cause in _causes)
                    {
                        <div class="flex items-center justify-between rounded-md border bg-muted/50 p-4">
                            <div>
                                <p class="text-sm font-medium">@cause.Name</p>
                                <p class="text-xs text-muted-foreground">@cause.Category</p>
                            </div>
                            <span class="text-sm font-semibold tabular-nums">@cause.Amount</span>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-6 rounded-md border bg-muted/50 p-4">
                <p class="text-sm font-medium">Employee Matching Program</p>
                <p class="mt-1 text-sm text-muted-foreground">
                    We match employee donations up to $5,000 per year to eligible charitable
                    organizations. All employees receive 16 hours of paid volunteer time annually.
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, string Value, string Icon);
    private record CauseItem(string Name, string Category, string Amount);

    private readonly List<StatItem> _stats =
    [
        new("Total Donated", "$2.4M", "heart"),
        new("Causes Supported", "47", "trending-up"),
        new("Volunteer Hours", "8,340", "clock"),
        new("Employees Participating", "89%", "users"),
    ];

    private readonly List<CauseItem> _causes =
    [
        new("Code.org", "Education", "$250K"),
        new("GiveDirectly", "Poverty Relief", "$180K"),
        new("Electronic Frontier Foundation", "Digital Rights", "$150K"),
    ];
}
