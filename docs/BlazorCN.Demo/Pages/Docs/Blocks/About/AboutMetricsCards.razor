@* ============================================================
   Block: about-metrics-cards
   Title: About Metrics Cards
   Description: Company metrics cards section with icons and descriptions for React SaaS about pages
   Long Description: Showcase your traction with this metrics cards component for Next.js about pages. Features a 2x2 grid of metric cards with icons, large numbers, labels, and brief descriptions. Built with Tailwind CSS and Lucide icons. Large typography makes numbers pop while descriptions add context that raw stats lack. Perfect for investor pages, SaaS companies showing growth, and startups wanting to communicate scale and reliability.
   Dependencies: None
   Source: original/blocks/about/about-metrics-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="mb-2 text-xl font-semibold tracking-tight">
                Built for scale, proven by results
            </h2>
            <p class="text-sm text-muted-foreground">
                The metrics behind our mission to transform how teams work.
            </p>
        </div>

        @* Metrics grid *@
        <div class="p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                @foreach (var metric in _metrics)
                {
                    <div class="flex items-center gap-4 rounded-lg border p-4">
                        <div class="flex size-12 shrink-0 items-center justify-center rounded-full border">
                            <LucideIconCn Name="@metric.Icon" Size="20" Class="size-5 text-muted-foreground" />
                        </div>
                        <div>
                            <p class="text-2xl font-semibold tabular-nums">@metric.Value</p>
                            <p class="text-sm font-medium">@metric.Label</p>
                            <p class="text-xs text-muted-foreground">@metric.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record MetricItem(string Icon, string Value, string Label, string Description);

    private readonly List<MetricItem> _metrics =
    [
        new("users", "50,000+", "Active users", "Teams trusting us daily"),
        new("trending-up", "300%", "YoY growth", "Consistent acceleration"),
        new("globe", "120+", "Countries", "Global reach"),
        new("zap", "99.9%", "Uptime", "Enterprise reliability"),
    ];
}
