@* ============================================================
   Block: about-roadmap
   Title: About Roadmap
   Description: Product roadmap section with quarterly milestones and status for React SaaS about pages
   Long Description: Show where you're headed with this roadmap component for Next.js about pages. Features a 2x2 grid of quarterly cards with status indicators (completed, in progress, planned) and feature lists. Built with Tailwind CSS and Lucide icons. Public roadmaps build excitement and show momentum—customers invest in products that are actively improving. Perfect for SaaS products, startups in active development, and companies that want to signal they're shipping.
   Dependencies: None
   Source: original/blocks/about/about-roadmap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5 text-center">
            <h2 class="mb-2 text-xl font-semibold tracking-tight">
                Building the future, one quarter at a time
            </h2>
            <p class="text-sm text-muted-foreground">
                Here's what we're working on and where we're headed next.
            </p>
        </div>

        @* Roadmap *@
        <div class="p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                @foreach (var phase in _roadmap)
                {
                    var cardClass = phase.Status == "current" ? "border-blue-500 bg-blue-500/10" : "bg-muted/50";
                    var badgeClass = phase.Status == "current" ? "border-blue-500 text-blue-500" : "text-muted-foreground";
                    var statusLabel = phase.Status switch
                    {
                        "completed" => "Done",
                        "current" => "In Progress",
                        _ => "Planned",
                    };
                    var iconName = phase.Status == "completed" ? "check-circle-2" : "circle";

                    <div class="@($"rounded-lg border p-4 {cardClass}")">
                        <div class="mb-4 flex items-center justify-between">
                            <h3 class="text-sm font-medium">@phase.Quarter</h3>
                            <span class="@($"rounded-full border px-2 py-0.5 text-xs font-medium {badgeClass}")">
                                @statusLabel
                            </span>
                        </div>

                        <ul class="space-y-2">
                            @foreach (var item in phase.Items)
                            {
                                <li class="flex items-center gap-2 text-sm">
                                    <LucideIconCn Name="@iconName" Size="16" Class="h-4 w-4 shrink-0 text-muted-foreground" />
                                    <span class="@(phase.Status == "completed" ? "text-muted-foreground" : "leading-relaxed")">
                                        @item
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record RoadmapPhase(string Quarter, string Status, string[] Items);

    private readonly List<RoadmapPhase> _roadmap =
    [
        new("Q1 2024", "completed", ["Core platform launch", "Mobile app beta", "API v2 release"]),
        new("Q2 2024", "current", ["Team collaboration features", "Advanced analytics", "Enterprise SSO"]),
        new("Q3 2024", "upcoming", ["AI-powered insights", "Custom workflows", "Marketplace launch"]),
        new("Q4 2024", "upcoming", ["International expansion", "White-label solution", "Desktop apps"]),
    ];
}
