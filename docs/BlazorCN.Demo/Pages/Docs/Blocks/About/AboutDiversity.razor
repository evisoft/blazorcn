@* ============================================================
   Block: about-diversity
   Title: About Diversity
   Description: About section with team diversity and inclusion commitment
   Long Description: About section with company differentiators and unique selling points
   Dependencies: None
   Source: original/blocks/about/about-diversity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">
                Different perspectives, shared purpose
            </h2>
            <p class="mt-1 text-sm text-muted-foreground">
                We're building a team that reflects the diversity of the world we serve.
            </p>
        </div>

        @* Stats *@
        <div class="border-b px-6 py-5">
            <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
                @foreach (var stat in _stats)
                {
                    <div class="text-center">
                        <p class="text-2xl font-semibold tabular-nums tracking-tight">@stat.Value</p>
                        <p class="mt-1 text-xs text-muted-foreground">@stat.Label</p>
                    </div>
                }
            </div>
        </div>

        @* Initiatives *@
        <div class="grid gap-6 p-6 sm:grid-cols-2">
            @foreach (var item in _initiatives)
            {
                <div class="flex gap-4">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-full border">
                        <LucideIconCn Name="@item.Icon" Size="20" Class="size-5 text-muted-foreground" />
                    </div>
                    <div>
                        <h3 class="text-sm font-medium">@item.Title</h3>
                        <p class="mt-1 text-sm text-muted-foreground leading-relaxed">
                            @item.Description
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StatItem(string Value, string Label);
    private record Initiative(string Icon, string Title, string Description);

    private readonly List<StatItem> _stats =
    [
        new("52%", "Women in leadership"),
        new("38%", "Underrepresented groups"),
        new("15", "Countries represented"),
        new("100%", "Pay equity audited"),
    ];

    private readonly List<Initiative> _initiatives =
    [
        new("users", "Inclusive hiring", "Blind resume reviews and diverse interview panels"),
        new("heart", "Employee resource groups", "Funded ERGs for underrepresented communities"),
        new("globe", "Global perspectives", "Remote-first culture embracing all time zones"),
        new("sparkles", "Growth programs", "Mentorship and sponsorship for career advancement"),
    ];
}
