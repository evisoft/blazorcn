@* ============================================================
   Block: about-customer-segments
   Title: About Customer Segments
   Description: Customer breakdown by segment with visual percentage bars and detailed descriptions for each category.
   Long Description: A data-driven customer segmentation display that showcases your market reach across different company sizes. Uses horizontal bars for clear visual hierarchy.
   Dependencies: None
   Source: original/blocks/about/about-customer-segments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Our customers</h2>
            <p class="mt-2 text-sm text-muted-foreground">
                Serving <span class="font-medium tabular-nums">@_totalCustomers</span> companies
                worldwide, from fast-growing startups to Fortune 500 enterprises.
            </p>
        </div>

        <div class="p-6">
            <div class="space-y-6">
                @foreach (var segment in _segments)
                {
                    <div>
                        <div class="flex items-baseline justify-between">
                            <div class="min-w-0 flex-1">
                                <div class="text-sm font-medium">@segment.Name</div>
                                <div class="mt-1 text-xs text-muted-foreground">@segment.Description</div>
                            </div>
                            <div class="ml-4 shrink-0 text-right">
                                <div class="text-2xl font-semibold tabular-nums">@(segment.Percentage)%</div>
                                <div class="mt-0.5 text-xs text-muted-foreground">
                                    @segment.Count customers
                                </div>
                            </div>
                        </div>
                        <div class="mt-3 h-2 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground transition-all duration-500"
                                 style="@($"width: {segment.Percentage}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t bg-muted/50 px-6 py-4">
            <div class="grid gap-6 sm:grid-cols-3">
                <div>
                    <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        Average team size
                    </div>
                    <div class="mt-2 text-2xl font-semibold tabular-nums">127</div>
                    <div class="mt-0.5 text-xs text-muted-foreground">employees</div>
                </div>
                <div>
                    <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        Year-over-year growth
                    </div>
                    <div class="mt-2 text-2xl font-semibold tabular-nums">142%</div>
                    <div class="mt-0.5 text-xs text-muted-foreground">new customers</div>
                </div>
                <div>
                    <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        Customer retention
                    </div>
                    <div class="mt-2 text-2xl font-semibold tabular-nums">94%</div>
                    <div class="mt-0.5 text-xs text-muted-foreground">annual rate</div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Segment(string Name, string Description, int Percentage, int Count);

    private readonly List<Segment> _segments =
    [
        new("Startups", "Early-stage companies with 1-50 employees", 35, 1820),
        new("Small & Medium Business", "Growing companies with 51-500 employees", 40, 2080),
        new("Enterprise", "Large organizations with 500+ employees", 25, 1300),
    ];

    private int _totalCustomers => _segments.Sum(s => s.Count);
}
