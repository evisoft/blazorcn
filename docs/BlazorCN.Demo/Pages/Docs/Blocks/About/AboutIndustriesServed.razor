@* ============================================================
   Block: about-industries-served
   Title: AboutIndustriesServed
   Description: A multi-column industry grid block for React and Next.js with six industry cards, customer counts, key use cases, featured customer names, hover states, and staggered scale entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-industries-served.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-5 py-4">
            <h2 class="text-sm font-medium">Industries We Serve</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Trusted by
                <span class="font-medium tabular-nums text-foreground">@_totalCustomers.ToString("N0")+</span>
                organizations across six core verticals.
            </p>
        </div>

        @* Industry grid *@
        <div class="p-4">
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var industry in _industries)
                {
                    <div class="rounded-md border p-4 transition-colors hover:border-foreground/20">
                        <div class="flex items-center justify-between">
                            <h3 class="text-sm font-medium">@industry.Name</h3>
                            <span class="text-xs font-medium tabular-nums text-muted-foreground">
                                @industry.CustomerCount.ToString("N0")
                            </span>
                        </div>

                        <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                            @industry.Description
                        </p>

                        @* Use case *@
                        <div class="mt-3 rounded bg-muted/50 px-2.5 py-1.5">
                            <p class="text-[10px] text-muted-foreground">
                                <span class="font-medium text-foreground">Key use case:</span>
                                @industry.UseCase
                            </p>
                        </div>

                        @* Featured customer *@
                        <div class="mt-3 flex items-center justify-between border-t pt-2.5">
                            <span class="text-[10px] text-muted-foreground">Featured customer</span>
                            <span class="text-[10px] font-medium">@industry.FeaturedCustomer</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t bg-muted/30 px-5 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-muted-foreground">Don't see your industry?</span>
                <span class="text-xs font-medium">We work with all sectors</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record Industry(string Id, string Name, string Description, int CustomerCount, string UseCase, string FeaturedCustomer);

    private static readonly Industry[] _industries =
    [
        new("saas", "SaaS & Technology",
            "Product teams use our platform to ship faster without sacrificing quality. From startups to public companies, we power dashboards, admin panels, and internal tools.",
            1240,
            "Internal admin dashboards and customer-facing portals",
            "Meridian Cloud"),
        new("healthcare", "Healthcare",
            "HIPAA-compliant workflows for patient portals, scheduling systems, and clinical dashboards. Our components meet accessibility standards required in medical software.",
            680,
            "Patient intake forms and provider scheduling",
            "Veridian Health Systems"),
        new("fintech", "Financial Services",
            "Banks, fintechs, and insurance companies rely on our data-dense table and chart components. Built for accuracy, audit trails, and compliance-grade UIs.",
            520,
            "Transaction monitoring and risk assessment dashboards",
            "Apex Capital Partners"),
        new("education", "Education",
            "Learning platforms, university portals, and EdTech products use our components for course management, grading interfaces, and student engagement tools.",
            890,
            "Learning management systems and student dashboards",
            "Brightpath Academy"),
        new("ecommerce", "Retail & E-commerce",
            "Storefronts, inventory management, and order fulfillment UIs. Our product card and checkout components are optimized for conversion and mobile-first experiences.",
            1100,
            "Product catalog and checkout flow optimization",
            "Nomad Goods Co."),
        new("logistics", "Logistics & Supply Chain",
            "Fleet tracking, warehouse management, and delivery coordination interfaces. Real-time data display components handle high-frequency updates without flickering.",
            450,
            "Fleet tracking and warehouse management consoles",
            "Routemaster Logistics"),
    ];

    private static readonly int _totalCustomers = _industries.Sum(i => i.CustomerCount);
}
