@* ============================================================
   Block: about-stats-large
   Title: About Stats Large
   Description: About section with large animated counter stats
   Long Description: About section with centered stats in colored boxes
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/about/about-stats-large.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-6">
            <div class="grid grid-cols-3 gap-4 text-center">
                @foreach (var stat in _stats)
                {
                    <div>
                        <div class="text-2xl font-semibold tabular-nums tracking-tight">
                            @stat.Value
                        </div>
                        <p class="mt-2 text-sm text-muted-foreground">@stat.Label</p>
                    </div>
                }
            </div>
        </div>

        <div class="px-6 py-6 text-center">
            <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                About Us
            </BadgeCn>

            <h2 class="mb-4 text-xl font-semibold tracking-tight">Trusted by teams worldwide</h2>

            <p class="mx-auto mb-6 max-w-2xl text-sm text-muted-foreground">
                Since 2018, we've been the backbone of modern businesses. From scrappy startups to
                Fortune 500 enterprises, teams rely on us for speed, reliability, and scale.
            </p>

            <div class="flex flex-wrap justify-center gap-3">
                <ButtonCn Class="gap-2">
                    Get Started
                    <LucideIconCn Name="arrow-right" Size="16" Class="h-4 w-4" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline">Read Case Studies</ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Value, string Label);

    private readonly List<StatItem> _stats =
    [
        new("50K+", "Active users"),
        new("$2B", "Processed"),
        new("99.9%", "Uptime"),
    ];
}
