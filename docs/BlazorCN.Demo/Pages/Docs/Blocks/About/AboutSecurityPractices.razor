@* ============================================================
   Block: about-security-practices
   Title: About Security Practices
   Description: Detailed security measures overview showing encryption, access control, monitoring, and incident response capabilities.
   Long Description: Demonstrate security rigor. This component outlines your technical security measures with specific details that satisfy security teams during vendor reviews and build buyer confidence.
   Dependencies: None
   Source: original/blocks/about/about-security-practices.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Security Practices</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                How we protect your data and infrastructure
            </p>
        </div>

        <div class="divide-y">
            @foreach (var practice in _practices)
            {
                <div class="px-6 py-5">
                    <div class="flex gap-4">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted">
                            <LucideIconCn Name="@practice.Icon" Size="20" Class="size-5 text-muted-foreground" />
                        </div>

                        <div class="min-w-0 flex-1">
                            <h3 class="font-medium text-sm">@practice.Title</h3>
                            <p class="mt-0.5 text-muted-foreground text-sm">@practice.Description</p>
                            <p class="mt-3 text-muted-foreground text-sm leading-relaxed">
                                @practice.Details
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-6 py-4">
            <p class="text-muted-foreground text-xs">
                Security concerns? Contact our security team at security@@company.com or report
                vulnerabilities through our bug bounty program.
            </p>
        </div>
    </div>
</section>

@code {
    private record SecurityPractice(string Icon, string Title, string Description, string Details);

    private readonly List<SecurityPractice> _practices =
    [
        new("lock", "End-to-end encryption", "Data encrypted in transit and at rest",
            "All data is encrypted using AES-256 encryption at rest and TLS 1.3 in transit. Encryption keys are managed using AWS KMS with automatic rotation every 90 days."),
        new("shield-check", "Access control & authentication", "Multi-factor authentication and role-based access",
            "Mandatory 2FA for all accounts. SSO support via SAML 2.0. Role-based access control (RBAC) with least-privilege principles. Session tokens expire after 24 hours of inactivity."),
        new("activity", "Infrastructure monitoring", "24/7 automated threat detection and logging",
            "Real-time security monitoring using AWS GuardDuty and CloudWatch. All API requests logged and retained for 1 year. Automated alerts for suspicious activity patterns."),
        new("alert-triangle", "Incident response", "Documented procedures for security events",
            "Dedicated security team with 2-hour response SLA for critical incidents. Quarterly incident response drills. Post-incident reviews and customer notification within 72 hours."),
        new("search-check", "Penetration testing", "Annual third-party security assessments",
            "Annual penetration testing by certified security firms. Quarterly internal security audits. Bug bounty program with responsible disclosure process and rewards up to $10,000."),
    ];
}
