@* ============================================================
   Block: about-partnerships
   Title: About Partnerships
   Description: Partner logos and security certifications section for React B2B about pages
   Long Description: A founding story narrative with key dates, the aha moment, and company origins told as a flowing story
   Dependencies: ButtonCn
   Source: original/blocks/about/about-partnerships.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="mb-2 text-xl font-semibold tracking-tight">Backed by the best in tech</h2>
            <p class="text-sm text-muted-foreground">
                We partner with industry leaders and maintain the highest security standards.
            </p>
        </div>

        @* Partners *@
        <div class="border-b px-6 py-5">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                @foreach (var partner in _partnerships)
                {
                    <div class="rounded-lg border p-4 text-center">
                        <p class="text-sm font-medium">@partner.Name</p>
                        <p class="text-xs text-muted-foreground">@partner.Type</p>
                    </div>
                }
            </div>
        </div>

        @* Certifications *@
        <div class="border-b px-6 py-5">
            <p class="mb-4 text-center text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Security &amp; Compliance
            </p>
            <div class="flex flex-wrap items-center justify-center gap-4">
                @foreach (var cert in _certifications)
                {
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="badge-check" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="text-sm font-medium">@cert</span>
                    </div>
                }
            </div>
        </div>

        @* CTA *@
        <div class="px-6 py-5 text-center">
            <ButtonCn Class="gap-2" Variant="ButtonVariant.Outline">
                View Security Documentation
                <LucideIconCn Name="arrow-right" Size="16" Class="size-4" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Partner(string Name, string Type);

    private readonly List<Partner> _partnerships =
    [
        new("AWS", "Advanced Partner"),
        new("Salesforce", "AppExchange Partner"),
        new("Google Cloud", "Partner"),
        new("Microsoft", "Gold Partner"),
    ];

    private readonly string[] _certifications = ["SOC 2 Type II", "GDPR Compliant", "ISO 27001", "HIPAA Ready"];
}
