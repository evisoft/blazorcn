@* ============================================================
   Block: about-integrations
   Title: AboutIntegrations
   Description: A bento grid integrations block for React and Next.js with featured integration cards, category badges, connection status indicators, usage stats for featured items, and staggered scale entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-integrations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-5 py-3">
            <div>
                <h2 class="text-sm font-medium">Integration Ecosystem</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_integrations.Length integrations across @_categoryCount categories
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-[10px] text-muted-foreground">
                    @_connectedCount/@_integrations.Length connected
                </span>
            </div>
        </div>

        @* Bento Grid *@
        <div class="grid gap-px bg-muted p-px sm:grid-cols-2">
            @foreach (var integration in _integrations)
            {
                <div class="@Cn.Merge("flex flex-col justify-between bg-card p-4", integration.Featured ? "sm:col-span-2" : "")">
                    @* Top: name + category + status *@
                    <div>
                        <div class="flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@integration.Name</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"text-[10px] font-normal {CategoryColor(integration.Category)}")">
                                    @integration.Category
                                </BadgeCn>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <span class="@Cn.Merge("size-1.5 rounded-full", integration.Connected ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                                <span class="text-[10px] text-muted-foreground">
                                    @(integration.Connected ? "Connected" : "Available")
                                </span>
                            </div>
                        </div>

                        <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                            @integration.Description
                        </p>

                        @* Usage stats for featured integrations *@
                        @if (integration.Featured && integration.UsageStats != null)
                        {
                            <div class="mt-3 flex items-center gap-3">
                                @foreach (var stat in integration.UsageStats)
                                {
                                    <div class="rounded-md bg-muted/50 px-2.5 py-1.5">
                                        <span class="font-mono text-xs font-medium tabular-nums">
                                            @stat.Value
                                        </span>
                                        <span class="ml-1.5 text-[10px] text-muted-foreground">
                                            @stat.Label
                                        </span>
                                    </div>
                                }
                                @if (integration.WebhookEvents != null)
                                {
                                    <div class="rounded-md bg-muted/50 px-2.5 py-1.5">
                                        <span class="font-mono text-[10px] text-muted-foreground">
                                            @integration.WebhookEvents
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center gap-2 border-t px-5 py-2.5">
            <span class="text-xs tabular-nums text-muted-foreground">
                @_integrations.Length integrations
            </span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span class="text-xs text-muted-foreground">@_categoryCount categories</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span class="text-xs text-muted-foreground">REST + webhook APIs</span>
        </div>
    </div>
</section>

@code {
    private record UsageStat(string Label, string Value);

    private record Integration(
        string Id,
        string Name,
        string Category,
        string Description,
        bool Connected,
        bool Featured,
        UsageStat[]? UsageStats = null,
        string? WebhookEvents = null
    );

    private static readonly Integration[] _integrations =
    [
        new("salesforce", "Salesforce", "CRM",
            "Bi-directional sync of contacts, deals, and activities. Custom field mapping with conflict resolution. Supports Salesforce Enterprise and Unlimited editions.",
            true, true,
            [new("Synced records", "2.4M"), new("Avg sync latency", "1.2s"), new("Field mappings", "47")],
            "12 event types"),
        new("datadog", "Datadog", "Analytics",
            "Forward application metrics, custom events, and distributed traces. Auto-instrumented dashboards with alert routing to on-call channels.",
            true, true,
            [new("Metrics/min", "18K"), new("Custom dashboards", "23"), new("Alert rules", "86")],
            "8 event types"),
        new("slack", "Slack", "Communication",
            "Real-time notifications for deploys, incidents, and team mentions. Slash commands for quick actions.",
            true, false),
        new("github", "GitHub", "DevOps",
            "PR status checks, auto-deploy on merge, and issue linking. Supports GitHub Actions workflow triggers.",
            true, false),
        new("stripe", "Stripe", "Payments",
            "Subscription billing, usage-based metering, and invoice sync. Webhook-driven payment lifecycle events.",
            true, false),
        new("hubspot", "HubSpot", "CRM",
            "Contact enrichment, deal pipeline sync, and marketing event tracking. OAuth 2.0 authentication.",
            true, false),
        new("pagerduty", "PagerDuty", "DevOps",
            "Incident escalation, on-call rotation sync, and postmortem linking. Bi-directional status updates.",
            true, false),
        new("s3", "AWS S3", "Storage",
            "Export reports, backups, and audit logs to S3 buckets. Configurable retention policies and encryption.",
            true, false),
        new("amplitude", "Amplitude", "Analytics",
            "Product analytics event forwarding with user identity resolution. Cohort sync for targeted campaigns.",
            false, false),
        new("teams", "Microsoft Teams", "Communication",
            "Channel notifications, adaptive cards for approvals, and meeting scheduling via Graph API.",
            false, false),
    ];

    private static readonly Dictionary<string, string> _categoryColors = new()
    {
        ["CRM"]           = "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        ["Analytics"]     = "bg-violet-500/10 text-violet-700 dark:text-violet-400",
        ["DevOps"]        = "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        ["Communication"] = "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        ["Payments"]      = "bg-rose-500/10 text-rose-700 dark:text-rose-400",
        ["Storage"]       = "bg-sky-500/10 text-sky-700 dark:text-sky-400",
    };

    private static string CategoryColor(string category) =>
        _categoryColors.TryGetValue(category, out var color) ? color : "";

    private static readonly int _connectedCount = _integrations.Count(i => i.Connected);
    private static readonly int _categoryCount = _integrations.Select(i => i.Category).Distinct().Count();
}
