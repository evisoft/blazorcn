@* ============================================================
   Block: about-methodology
   Title: About Methodology
   Description: Display your delivery process with numbered steps, descriptions, and timeframes
   Long Description: Build confidence by showing exactly how you work. This step-by-step methodology layout sets clear expectations and demonstrates process maturity—essential for high-consideration purchases and enterprise sales.
   Dependencies: None
   Source: original/blocks/about/about-methodology.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Our Methodology</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                A proven five-phase approach to successful delivery
            </p>
        </div>
        <div class="p-6">
            <div class="space-y-4">
                @foreach (var step in _steps)
                {
                    <div class="overflow-hidden rounded-md border bg-card">
                        <div class="flex items-start gap-4 border-b bg-muted/50 px-4 py-3">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-background font-semibold tabular-nums text-sm">
                                @step.Number
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center justify-between">
                                    <h3 class="font-medium text-sm">@step.Title</h3>
                                    <span class="text-muted-foreground text-xs">@step.Duration</span>
                                </div>
                            </div>
                        </div>
                        <div class="px-4 py-4">
                            <p class="mb-3 text-sm leading-relaxed">@step.Description</p>
                            <div>
                                <p class="mb-2 font-medium text-muted-foreground text-xs uppercase tracking-wider">
                                    Deliverables
                                </p>
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var deliverable in step.Deliverables)
                                    {
                                        <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2 py-1">
                                            <LucideIconCn Name="circle-check-big" Size="12" Class="size-3 text-muted-foreground" />
                                            <span class="text-xs">@deliverable</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record MethodologyStep(int Number, string Title, string Description, string Duration, string[] Deliverables);

    private readonly List<MethodologyStep> _steps =
    [
        new(1, "Discover",
            "Deep dive into your current setup, pain points, and goals. We audit existing systems, interview stakeholders, and document technical requirements.",
            "1-2 weeks", ["Technical audit", "Requirements doc", "Success metrics"]),
        new(2, "Design",
            "Architecture planning and UX design based on discovery findings. We create detailed specs, wireframes, and a phased implementation roadmap.",
            "2-3 weeks", ["System architecture", "UI/UX mockups", "Project timeline"]),
        new(3, "Build",
            "Iterative development with weekly progress reviews. Code is written to production standards with comprehensive testing throughout the process.",
            "6-10 weeks", ["Working software", "Test coverage", "Documentation"]),
        new(4, "Test",
            "QA testing, performance optimization, and security review. We validate against success metrics defined in discovery phase.",
            "1-2 weeks", ["QA report", "Performance audit", "Security scan"]),
        new(5, "Launch",
            "Deployment to production with monitoring, team training, and handoff documentation. We stay engaged through the first two weeks of operation.",
            "1 week + support", ["Production deploy", "Team training", "Runbook"]),
    ];
}
