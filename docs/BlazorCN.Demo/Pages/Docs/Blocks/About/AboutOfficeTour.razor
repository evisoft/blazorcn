@* ============================================================
   Block: about-office-tour
   Title: About Office Tour
   Description: Virtual office tour showcasing different workspace areas with descriptions for company culture transparency.
   Long Description: A visual office tour section that gives prospects and candidates a glimpse into your workplace culture. Features multiple office areas with descriptions and placeholder images.
   Dependencies: None
   Source: original/blocks/about/about-office-tour.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Virtual office tour</h2>
            <p class="mt-2 text-sm text-muted-foreground">
                Take a look inside our workspace. We've designed an environment that promotes
                creativity, collaboration, and wellbeing.
            </p>
        </div>

        <div class="p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                @for (var i = 0; i < _officeAreas.Count; i++)
                {
                    var area = _officeAreas[i];
                    <div class="@($"overflow-hidden rounded-md border bg-card{(i == 0 ? " sm:col-span-2" : "")}")">
                        <div class="aspect-video bg-muted">
                            <div class="flex size-full items-center justify-center">
                                <span class="text-sm text-muted-foreground">@area.Name</span>
                            </div>
                        </div>
                        <div class="p-4">
                            <h3 class="text-sm font-medium">@area.Name</h3>
                            <p class="mt-2 text-sm text-muted-foreground">@area.Description</p>
                            <div class="mt-3 flex flex-wrap gap-2">
                                @foreach (var feature in area.Features)
                                {
                                    <span class="inline-flex items-center rounded bg-muted/50 px-2 py-1 text-xs text-muted-foreground">
                                        @feature
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t bg-muted/50 px-6 py-4">
            <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Want to visit?</span>
                <span class="font-medium">Office hours: Mon-Fri, 9:00 AM - 6:00 PM</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record OfficeArea(string Name, string Description, string[] Features);

    private readonly List<OfficeArea> _officeAreas =
    [
        new("Open Workspace", "Our collaborative workspace designed for focused work and spontaneous collaboration.",
            ["Standing desks", "Dual monitors", "Ergonomic chairs"]),
        new("Kitchen & Cafe", "A fully stocked kitchen with complimentary snacks, drinks, and espresso bar.",
            ["Fresh fruit daily", "Premium coffee", "Lunch catering"]),
        new("Meeting Rooms", "Modern conference rooms equipped with video conferencing and whiteboards.",
            ["4K displays", "Noise cancellation", "Wireless casting"]),
        new("Rooftop Deck", "An outdoor space for breaks, casual meetings, and team events.",
            ["City views", "Outdoor seating", "BBQ area"]),
        new("Game Room", "Unwind with ping pong, foosball, and video games during breaks.",
            ["Ping pong table", "Gaming console", "Board games"]),
    ];
}
