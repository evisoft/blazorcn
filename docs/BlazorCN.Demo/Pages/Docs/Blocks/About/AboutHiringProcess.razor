@* ============================================================
   Block: about-hiring-process
   Title: AboutHiringProcess
   Description: A vertical stepper hiring process block for React and Next.js with numbered steps, connecting lines, duration badges, candidate tips, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-hiring-process.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-5 py-4">
            <h2 class="text-sm font-medium">Our Hiring Process</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Five steps, full transparency. Here's exactly what to expect.
            </p>
        </div>

        @* Steps *@
        <div class="px-5 py-4">
            <div class="relative">
                @for (int i = 0; i < _steps.Length; i++)
                {
                    var step = _steps[i];
                    var isLast = i == _steps.Length - 1;
                    <div class="relative flex gap-4 pb-6 @(isLast ? "pb-0" : "")">
                        @* Timeline column *@
                        <div class="flex flex-col items-center">
                            @* Number circle *@
                            <div class="relative z-10 flex size-7 shrink-0 items-center justify-center rounded-full border bg-card text-xs font-medium tabular-nums">
                                @step.Number
                            </div>
                            @* Connecting line *@
                            @if (!isLast)
                            {
                                <div class="mt-1 w-px flex-1 bg-border" aria-hidden="true"></div>
                            }
                        </div>

                        @* Content column *@
                        <div class="min-w-0 flex-1 pt-0.5">
                            <div class="flex items-center gap-2">
                                <h3 class="text-sm font-medium">@step.Title</h3>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@step.Duration</BadgeCn>
                            </div>
                            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                                @step.Description
                            </p>
                            <div class="mt-2 rounded-md bg-muted/50 px-3 py-2">
                                <p class="text-xs leading-relaxed text-muted-foreground">
                                    <span class="font-medium text-foreground">Tip:</span> @step.Tip
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t bg-muted/30 px-5 py-3">
            <p class="text-xs text-muted-foreground">
                Total timeline: @_totalTimeline. We provide feedback at every stage and are happy to
                answer questions throughout.
            </p>
        </div>
    </div>
</section>

@code {
    private record Step(string Id, int Number, string Title, string Duration, string Description, string Tip);

    private static readonly Step[] _steps =
    [
        new("application", 1, "Application Review", "~2 days",
            "Our recruiting team reviews every application by hand. We look at your experience, portfolio or open-source contributions, and alignment with the role requirements. No keyword filters — a human reads your submission.",
            "Tailor your resume to the specific role. Mention projects or contributions relevant to the team you're applying to join."),
        new("phone-screen", 2, "Phone Screen", "~30 min",
            "A casual conversation with a recruiter to discuss your background, career goals, and what excites you about the role. We'll share details about team structure, compensation range, and growth opportunities.",
            "Prepare 2-3 questions about the team's current challenges. It shows genuine interest and helps you evaluate fit."),
        new("technical", 3, "Technical Assessment", "~90 min",
            "A focused technical session with a senior engineer. For engineering roles, you'll work through a realistic problem — no whiteboard trivia. For design roles, expect a portfolio deep-dive and a short design exercise.",
            "Think out loud. We evaluate your problem-solving approach as much as the final answer. Asking clarifying questions is encouraged."),
        new("team-interview", 4, "Team Interview", "~3 hours",
            "Meet 3-4 team members in back-to-back sessions covering system design, collaboration scenarios, and values alignment. Each interviewer evaluates a different dimension. Virtual option available for all candidates.",
            "Be yourself. We're evaluating mutual fit — you should be interviewing us too. Ask each person what they'd change about the team."),
        new("offer", 5, "Offer", "~2 days",
            "We move fast after final interviews. Expect a written offer within two business days covering base salary, equity, benefits, and start date. We provide 5 business days to review and encourage candidates to ask questions.",
            "Don't hesitate to negotiate. We build in room for discussion and respect candidates who advocate for themselves."),
    ];

    private const string _totalTimeline = "2-3 weeks from application to offer";
}
