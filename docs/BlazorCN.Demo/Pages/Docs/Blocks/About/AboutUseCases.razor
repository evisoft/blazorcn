@* ============================================================
   Block: about-use-cases
   Title: About Use Cases
   Description: Industry use cases showcase demonstrating how different verticals benefit from your product or service.
   Long Description: A comprehensive use cases section that highlights how your product serves different industries. Helps prospects quickly identify relevant applications for their specific needs.
   Dependencies: None
   Source: original/blocks/about/about-use-cases.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Use cases</h2>
            <p class="mt-2 text-sm text-muted-foreground">
                Discover how teams across industries use our platform to solve their unique challenges.
            </p>
        </div>

        <div class="p-6">
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var useCase in _useCases)
                {
                    <div class="rounded-md border bg-card p-4">
                        <LucideIconCn Name="@useCase.Icon" Size="20" Class="size-5 text-muted-foreground" />
                        <h3 class="mt-3 text-sm font-medium">@useCase.Industry</h3>
                        <p class="mt-2 text-sm text-muted-foreground">@useCase.Description</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record UseCase(string Icon, string Industry, string Description);

    private readonly List<UseCase> _useCases =
    [
        new("building-2", "SaaS Companies",
            "Streamline customer onboarding and reduce churn with automated workflows and personalized experiences."),
        new("shopping-cart", "E-commerce",
            "Increase conversion rates with intelligent product recommendations and cart abandonment recovery."),
        new("wallet", "Financial Services",
            "Enhance compliance and security while delivering seamless digital banking experiences."),
        new("heart-pulse", "Healthcare",
            "Improve patient engagement and care coordination with HIPAA-compliant communication tools."),
        new("graduation-cap", "Education",
            "Create engaging learning experiences with interactive content and real-time collaboration features."),
        new("briefcase", "Professional Services",
            "Automate client communication and project management to scale your service delivery."),
    ];
}
