@* ============================================================
   Block: about-customer-logos
   Title: About Customer Logos
   Description: Customer logo grid section for React B2B social proof pages
   Long Description: Build trust with this customer logos component for Next.js landing pages. Features a clean grid of client logos with subtle styling. Built with Tailwind CSS. The minimal design keeps focus on the logos—perfect for B2B companies, SaaS products, agencies, and any business wanting to leverage brand recognition for social proof.
   Dependencies: None
   Source: original/blocks/about/about-customer-logos.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-6 py-5">
            <p class="text-center text-sm text-muted-foreground">Trusted by industry leaders</p>
        </div>

        <div class="grid grid-cols-2 gap-12 px-6 pb-6 sm:grid-cols-3 md:grid-cols-6">
            @foreach (var logo in _logos)
            {
                <div class="flex items-center justify-center">
                    <span class="text-sm font-medium text-foreground/80">@logo</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private readonly string[] _logos = ["Vercel", "Stripe", "GitHub", "Spotify", "Shopify", "Figma"];
}
