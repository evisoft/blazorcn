@* ============================================================
   Block: about-changelog-summary
   Title: About Changelog Summary
   Description: A changelog summary section showing recent product updates for about pages
   Long Description: Showcase active development with a clean changelog summary. Displays recent product updates with version badges and release dates to demonstrate continuous improvement and feature velocity.
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/about/about-changelog-summary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Recent Updates</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                We ship new features and improvements every week
            </p>
        </div>

        <div class="divide-y">
            @foreach (var entry in _changelog)
            {
                <div class="px-6 py-5">
                    <div class="flex flex-wrap items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 font-mono text-xs">
                            @entry.Version
                        </BadgeCn>
                        <span class="text-xs text-muted-foreground">@entry.Date</span>
                    </div>
                    <h3 class="mt-2 text-sm font-medium">@entry.Title</h3>
                    <p class="mt-1 text-sm text-muted-foreground">@entry.Description</p>
                </div>
            }
        </div>

        <div class="border-t px-6 py-4">
            <ButtonCn Variant="ButtonVariant.Outline" Class="h-8 text-xs">
                View Full Changelog
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ChangelogEntry(string Date, string Version, string Title, string Description);

    private readonly List<ChangelogEntry> _changelog =
    [
        new("Mar 12, 2026", "2.4.0", "Advanced Analytics Dashboard", "New real-time analytics with custom metrics and automated reports"),
        new("Feb 28, 2026", "2.3.1", "Performance Improvements", "40% faster page loads and optimized database queries"),
        new("Feb 15, 2026", "2.3.0", "Team Collaboration Features", "Real-time co-editing, mentions, and integrated chat for teams"),
        new("Jan 30, 2026", "2.2.0", "Mobile App Launch", "Native iOS and Android apps with offline support"),
        new("Jan 18, 2026", "2.1.0", "API v2 Release", "Complete API rewrite with improved documentation and SDKs"),
    ];
}
