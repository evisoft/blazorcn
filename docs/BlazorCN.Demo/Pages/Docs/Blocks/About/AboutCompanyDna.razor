@* ============================================================
   Block: about-company-dna
   Title: About Company Dna
   Description: Company DNA and founding principles section for React startup about pages
   Long Description: A developer community metrics section showing GitHub stars, Discord members, and downloads for about pages
   Dependencies: None
   Source: original/blocks/about/about-company-dna.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Our founding principles</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Written in 2019. Unchanged since. These are the truths we build everything on.
            </p>
        </div>

        <div class="grid gap-px bg-muted sm:grid-cols-2">
            @foreach (var item in _dna)
            {
                <div class="flex gap-4 bg-card p-6">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border font-mono text-xs">
                        @item.Code
                    </span>
                    <div>
                        <h3 class="text-sm font-medium">@item.Principle</h3>
                        <p class="mt-1 text-sm text-muted-foreground leading-relaxed">
                            @item.Explanation
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record DnaItem(string Code, string Principle, string Explanation);

    private readonly List<DnaItem> _dna =
    [
        new("01", "Users over metrics",
            "We optimize for user happiness, not engagement metrics. If something helps users but hurts our numbers, we do it anyway."),
        new("02", "Simple beats complete",
            "We'd rather ship something simple that works perfectly than something complete that works adequately."),
        new("03", "Defaults are decisions",
            "Every default is a choice we make for millions of users. We sweat the defaults because most people never change them."),
        new("04", "Profit enables mission",
            "We're a business, not a charity. Sustainable profit lets us invest in our mission for the long term."),
    ];
}
