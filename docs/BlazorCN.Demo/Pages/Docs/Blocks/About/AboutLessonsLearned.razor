@* ============================================================
   Block: about-lessons-learned
   Title: AboutLessonsLearned
   Description: A lessons learned card stack block for React and Next.js with colored left-accent borders, expandable situation-insight-outcome sections, monospace numbering, and slide-from-left entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-lessons-learned.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-4">
            <h2 class="text-sm font-medium">Lessons Learned</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                The mistakes, pivots, and hard-won insights that shaped how we build today
            </p>
        </div>

        @* Lesson cards *@
        <div class="space-y-2 p-4">
            @foreach (var lesson in _lessons)
            {
                var isExpanded = _expandedId == lesson.Id;
                <div class="@($"overflow-hidden rounded-md border border-l-2 bg-card {AccentBorderClass(lesson.AccentColor)}")">
                    <button type="button"
                            @onclick="@(() => Toggle(lesson.Id))"
                            aria-expanded="@isExpanded.ToString().ToLower()"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="shrink-0 font-mono text-xs text-muted-foreground">
                            @lesson.Code
                        </span>
                        <div class="min-w-0 flex-1">
                            <div class="text-sm font-medium">@lesson.Title</div>
                            <div class="mt-0.5 text-xs text-muted-foreground">@lesson.Year</div>
                        </div>
                        <div class="@($"transition-transform duration-150 {(isExpanded ? "rotate-90" : "")}")">
                            <LucideIconCn Name="chevron-right" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-3 border-t px-4 py-4">
                                @* Situation *@
                                <div>
                                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                        The Situation
                                    </span>
                                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                                        @lesson.Situation
                                    </p>
                                </div>

                                @* Insight *@
                                <div>
                                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                        What We Learned
                                    </span>
                                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                                        @lesson.Insight
                                    </p>
                                </div>

                                @* What changed *@
                                <div class="rounded-md bg-muted/50 p-3">
                                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                        What Changed
                                    </span>
                                    <p class="mt-1 text-sm leading-relaxed text-foreground">
                                        @lesson.Changed
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-6 py-3">
            <p class="text-center text-xs text-muted-foreground">
                6 lessons from 3 years of building. Updated quarterly as we learn more.
            </p>
        </div>
    </div>
</section>

@code {
    private string? _expandedId = null;

    private void Toggle(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private static string AccentBorderClass(string accentColor) => accentColor switch
    {
        "blue"    => "border-l-blue-500",
        "amber"   => "border-l-amber-500",
        "emerald" => "border-l-emerald-500",
        "red"     => "border-l-red-500",
        _         => ""
    };

    private record Lesson(string Id, string Code, string Title, string Year, string AccentColor, string Situation, string Insight, string Changed);

    private static readonly Lesson[] _lessons =
    [
        new("l1", "L.01", "Built for everyone, resonated with no one", "2022", "amber",
            "We launched trying to serve both enterprise and indie developers simultaneously. Our messaging was generic, our pricing confused everyone, and we struggled to gain traction in either segment. Six months in, neither audience considered us their tool.",
            "You cannot serve two masters at the start. We picked indie developers as our sole focus and rebuilt everything — messaging, pricing, onboarding — around their specific constraints and workflows.",
            "Revenue grew 4x in six months. We eventually expanded to teams, but only after dominating the individual developer segment. Every new audience expansion now requires a dedicated discovery phase."),
        new("l2", "L.02", "Raised too early, built for investors instead of users", "2022", "red",
            "Closed a seed round and immediately started building features that looked good in pitch decks: AI integrations, marketplace, enterprise SSO. None of it matched what our existing users actually needed. Churn doubled in three months.",
            "Investor excitement is not product-market fit. We paused feature development for eight weeks and talked to 40 churned users. The pattern was clear: core workflows were broken while we chased shiny features.",
            "Killed 40% of in-progress features. Now every roadmap item requires ten customer conversations and a written brief before any code gets written. Features ship with user quotes justifying why they exist."),
        new("l3", "L.03", "Underpriced to grow fast, burned out trying to keep up", "2023", "blue",
            "Set prices at $9/month to maximize adoption. Got 8,000 users in four months but support tickets overwhelmed the three-person team. Response times went from hours to days. Quality of the product suffered because engineers were doing support.",
            "Low prices attract users who value price over product. When we raised to $29/month we lost 60% of users — but the remaining 40% were serious builders who valued stability, documentation, and responsiveness.",
            "Support burden dropped 70%. Engineers returned to building. We now model unit economics before any pricing decision and price for the customer we want, not the volume we think we need."),
        new("l4", "L.04", "Copied competitors instead of listening to users", "2023", "emerald",
            "Saw three competitors ship AI-powered code generation features within the same month. Panicked and spent six months building our version without validating demand. The feature launched to 4% adoption and stayed there.",
            "Competitor launches create urgency, not strategy. Our users wanted better debugging tools and faster deploys — unglamorous improvements that would never make a Product Hunt launch, but mattered deeply to daily workflows.",
            "We now maintain a 'competitor noise log' that we review monthly — separate from the roadmap. Features get built based on user evidence, not competitive anxiety. Usage rates on new features jumped from 4% to 38%."),
        new("l5", "L.05", "Went remote-first without the operating system for it", "2024", "amber",
            "Hired across six time zones to access talent. Had no async communication norms. Meetings multiplied as people tried to sync across continents. Decision-making slowed. Shipping velocity dropped 45% over two quarters.",
            "Remote is not about location — it is about communication architecture. Without written decision records, async-first defaults, and explicit availability windows, remote work becomes an endless meeting schedule.",
            "Implemented strict async-first policies: written RFCs for decisions, no-meeting Tuesdays and Thursdays, recorded demo videos instead of live walkthroughs. Shipping velocity recovered and team satisfaction scores hit an all-time high."),
        new("l6", "L.06", "Hired for credentials, should have hired for craft", "2024", "red",
            "Brought on three senior engineers from well-known companies. On paper, the team was exceptional. In practice, they were used to large-team infrastructure and struggled with the ambiguity and pace of a 15-person startup.",
            "Big-company experience does not transfer linearly to startups. The skills that make someone successful at a 500-person org — navigating politics, managing up, writing proposals — are different from the raw building ability a startup needs.",
            "Our interview process now includes a paid 3-day trial project using our actual codebase. We evaluate for shipping speed, communication clarity, and comfort with incomplete information. Mis-hires dropped from 30% to under 5%."),
    ];
}
