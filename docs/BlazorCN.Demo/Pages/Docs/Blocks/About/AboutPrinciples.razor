@* ============================================================
   Block: about-principles
   Title: About Principles
   Description: Numbered principles list section with titles and descriptions for React company pages
   Long Description: Define how you operate with this principles component for Next.js about pages. Features a numbered vertical list of principles with bold titles and supporting descriptions. Built with Tailwind CSS. The numbered format creates hierarchy and makes principles memorable and quotable. Perfect for companies with strong operating philosophies, startups establishing culture, and teams that want decision-making clarity.
   Dependencies: None
   Source: original/blocks/about/about-principles.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">How we operate</h2>
        </div>

        @* Principles list *@
        <div class="px-6 py-5">
            <div class="space-y-6">
                @for (var i = 0; i < _principles.Count; i++)
                {
                    var principle = _principles[i];
                    <div class="flex gap-4">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border font-mono text-sm text-muted-foreground">
                            @(i + 1)
                        </span>
                        <div class="flex-1 pt-0.5">
                            <h3 class="mb-1 text-sm font-medium">@principle.Title</h3>
                            <p class="text-sm text-muted-foreground leading-relaxed">
                                @principle.Description
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record PrincipleItem(string Title, string Description);

    private readonly List<PrincipleItem> _principles =
    [
        new("Customers over metrics",
            "We optimize for customer success, not vanity metrics. Happy customers create sustainable growth."),
        new("Clarity over cleverness",
            "Simple solutions that everyone understands beat clever ones that only experts can maintain."),
        new("Progress over perfection",
            "Ship early, learn fast, iterate. A good solution today beats a perfect one next quarter."),
        new("Ownership over handoffs",
            "See problems through from discovery to resolution. No throwing things over the wall."),
    ];
}
