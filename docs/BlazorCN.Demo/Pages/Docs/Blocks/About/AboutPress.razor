@* ============================================================
   Block: about-press
   Title: About Press
   Description: Press mentions section with media quotes and outlet logos for React company pages
   Long Description: Build credibility with this press component for Next.js about pages. Features a grid of press quotes with outlet names, plus a row of media outlet names below. Built with Tailwind CSS. Third-party validation from recognizable publications creates instant trust—visitors believe TechCrunch more than your marketing copy. Perfect for startups with notable coverage, funded companies, and products that have earned media attention.
   Dependencies: None
   Source: original/blocks/about/about-press.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">What people are saying</h2>
        </div>

        @* Press quotes *@
        <div class="border-b px-6 py-5">
            <div class="grid gap-4 sm:grid-cols-3">
                @foreach (var item in _press)
                {
                    <div class="rounded-lg border p-5 text-center">
                        <p class="mb-3 text-sm font-medium text-muted-foreground">@item.Outlet</p>
                        <p class="text-sm text-muted-foreground">"@item.Quote"</p>
                    </div>
                }
            </div>
        </div>

        @* Media logos *@
        <div class="px-6 py-5">
            <p class="mb-4 text-center text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Featured In
            </p>
            <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
                @foreach (var outlet in _outlets)
                {
                    <span class="text-sm font-medium text-muted-foreground">@outlet</span>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record PressItem(string Outlet, string Quote);

    private readonly List<PressItem> _press =
    [
        new("TechCrunch", "A game-changer for modern teams"),
        new("Forbes", "The future of work, today"),
        new("Wired", "Elegantly simple, deceptively powerful"),
    ];

    private readonly string[] _outlets = ["TechCrunch", "Forbes", "Wired", "The Verge", "Fast Company"];
}
