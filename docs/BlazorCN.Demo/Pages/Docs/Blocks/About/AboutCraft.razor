@* ============================================================
   Block: about-craft
   Title: About Craft
   Description: Showcase your craftsmanship principles and attention to detail with specific examples of how you build
   Long Description: Differentiate through craftsmanship. This component communicates your commitment to quality by highlighting specific principles you follow and concrete examples of how they manifest in your work.
   Dependencies: None
   Source: original/blocks/about/about-craft.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Our Craft Principles</h2>
            <p class="mt-1 text-muted-foreground text-sm">How we build products that last</p>
        </div>

        <div class="p-6">
            <div class="space-y-6">
                @for (var i = 0; i < _principles.Count; i++)
                {
                    var principle = _principles[i];
                    <div>
                        <div class="flex items-start gap-3">
                            <div class="mt-1">
                                <LucideIconCn Name="@principle.Icon" Size="20" Class="size-5 text-muted-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <h3 class="font-medium text-sm">@principle.Title</h3>
                                <p class="mt-1 text-muted-foreground text-sm">@principle.Description</p>
                                <div class="mt-3 rounded-md bg-muted/50 p-3">
                                    <p class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                                        In Practice
                                    </p>
                                    <p class="mt-1.5 text-sm">@principle.Example</p>
                                </div>
                            </div>
                        </div>
                        @if (i != _principles.Count - 1)
                        {
                            <div class="mt-6 border-t"></div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record CraftPrinciple(string Icon, string Title, string Description, string Example);

    private readonly List<CraftPrinciple> _principles =
    [
        new("scan-eye", "Attention to Detail",
            "Every pixel matters. We obsess over the small things that users notice but can't quite articulate.",
            "Hover states, loading transitions, and micro-interactions all receive the same care as major features. 8px grid system enforced across all components."),
        new("zap", "Performance Obsessed",
            "Fast isn't fast enough. We optimize for perceived performance and actual speed at every layer.",
            "Core Web Vitals score 99/100. Average page load under 1.2s. Code splitting and lazy loading by default. Performance budgets enforced in CI."),
        new("eye", "Pixel Perfect",
            "Design isn't complete until implementation matches exactly. No 'close enough' compromises.",
            "Side-by-side design comparisons in PR reviews. Cross-browser testing on 6 browsers. Typography scales match design specs to 0.5px precision."),
        new("check-circle", "Tested Thoroughly",
            "Ship with confidence. Every component, every edge case, every user flow gets tested before release.",
            "85% code coverage minimum. E2E tests for critical paths. Visual regression testing catches unintended changes. Automated accessibility audits."),
    ];
}
