@* ============================================================
   Block: about-day-in-life
   Title: About Day In Life
   Description: A timeline showing a typical day at the company, highlighting work-life balance and team culture through daily activities from morning standup to evening wrap-up.
   Long Description: Show candidates and customers what a typical workday looks like at your company. This timeline-based about block displays daily activities from standup to demo, emphasizing work-life balance and collaborative culture.
   Dependencies: None
   Source: original/blocks/about/about-day-in-life.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">A Day in the Life</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                A typical workday at our company, balancing focus time and collaboration
            </p>
        </div>
        <div class="p-6">
            <div class="relative space-y-6">
                @for (var i = 0; i < _activities.Count; i++)
                {
                    var activity = _activities[i];
                    var iconClass = activity.Type switch
                    {
                        "meeting" => "border-blue-500/20 bg-blue-500/10 text-blue-600",
                        "break" => "border-emerald-500/20 bg-emerald-500/10 text-emerald-600",
                        "team" => "border-amber-500/20 bg-amber-500/10 text-amber-600",
                        _ => "border-muted bg-muted/50 text-muted-foreground",
                    };
                    <div class="relative flex gap-4">
                        <div class="flex w-24 shrink-0 items-start justify-end pt-1">
                            <span class="font-medium text-muted-foreground text-sm tabular-nums">
                                @activity.Time
                            </span>
                        </div>
                        <div class="relative flex flex-col items-center">
                            <div class="@($"flex size-8 shrink-0 items-center justify-center rounded-full border-2 bg-card {iconClass}")">
                                <LucideIconCn Name="@activity.Icon" Size="16" Class="size-4" />
                            </div>
                            @if (i < _activities.Count - 1)
                            {
                                <div class="mt-2 h-full w-px bg-border"></div>
                            }
                        </div>
                        <div class="flex-1 pb-6">
                            <div class="rounded-md border bg-muted/50 p-4">
                                <h3 class="font-medium text-sm">@activity.Title</h3>
                                <p class="mt-1 text-muted-foreground text-sm">@activity.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Activity(string Time, string Title, string Description, string Type, string Icon);

    private readonly List<Activity> _activities =
    [
        new("9:00 AM", "Daily Standup", "15-minute sync with the team to align on priorities and blockers", "meeting", "users"),
        new("9:30 AM", "Deep Work Block", "Uninterrupted focus time for feature development and code reviews", "work", "code"),
        new("12:00 PM", "Lunch Break", "Team lunch in the office or nearby cafes, fully paid", "break", "coffee"),
        new("1:00 PM", "1:1 with Manager", "Weekly check-in for career growth, feedback, and support", "meeting", "message-square"),
        new("2:00 PM", "Collaborative Work", "Pair programming, design reviews, or cross-team collaboration", "work", "code"),
        new("4:00 PM", "Weekly Demo", "Show and tell: teams demo shipped features to the whole company", "team", "presentation"),
        new("5:00 PM", "Wrap Up", "Plan tomorrow, update tickets, and head home with a clear mind", "work", "clock"),
    ];
}
