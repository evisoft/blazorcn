@* ============================================================
   Block: about-founders
   Title: About Founders
   Description: Co-founders section with avatars, bios, and social links for React startup about pages
   Long Description: About section with founder letter or CEO message
   Dependencies: AvatarCn
   Source: original/blocks/about/about-founders.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Meet the founders</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                We met at Stanford in 2015 and have been building together ever since.
            </p>
        </div>

        @* Founders grid *@
        <div class="grid gap-8 p-6 sm:grid-cols-2">
            @foreach (var founder in _founders)
            {
                <div class="flex gap-4">
                    <AvatarCn Class="size-16 shrink-0">
                        <AvatarFallbackCn Class="border text-lg font-medium">
                            @founder.Initials
                        </AvatarFallbackCn>
                    </AvatarCn>
                    <div>
                        <h3 class="text-sm font-medium">@founder.Name</h3>
                        <p class="text-xs text-muted-foreground">@founder.Role</p>
                        <p class="mt-2 text-sm text-muted-foreground leading-relaxed">@founder.Bio</p>
                        <div class="mt-3 flex gap-3">
                            <a class="text-muted-foreground transition-colors hover:text-foreground"
                               href="@founder.Twitter"
                               aria-label="@($"{founder.Name} on Twitter")">
                                <LucideIconCn Name="twitter" Size="16" Class="size-4" />
                            </a>
                            <a class="text-muted-foreground transition-colors hover:text-foreground"
                               href="@founder.Linkedin"
                               aria-label="@($"{founder.Name} on LinkedIn")">
                                <LucideIconCn Name="linkedin" Size="16" Class="size-4" />
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Founder(string Name, string Role, string Initials, string Bio, string Twitter, string Linkedin);

    private readonly List<Founder> _founders =
    [
        new("Sarah Chen", "CEO & Co-founder", "SC",
            "Former product lead at Stripe. Stanford CS. Passionate about making complex tools feel simple.",
            "#", "#"),
        new("Marcus Johnson", "CTO & Co-founder", "MJ",
            "Ex-Google engineer. Built systems serving billions of requests. Believes great code is invisible.",
            "#", "#"),
    ];
}
