@* ============================================================
   Block: about-sustainability
   Title: About Sustainability
   Description: An environmental commitments section showing carbon neutral status and green initiatives for about pages
   Long Description: Showcase environmental responsibility with sustainability metrics. Displays carbon neutral status, renewable energy usage, and eco-friendly policies to demonstrate corporate social responsibility and climate action.
   Dependencies: ProgressCn
   Source: original/blocks/about/about-sustainability.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Environmental Commitment</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Building a sustainable future for technology
            </p>
        </div>

        <div class="p-6">
            <p class="text-sm text-muted-foreground">
                We take responsibility for our environmental impact. Through carbon offsets, renewable
                energy, and operational efficiency, we are working toward a net-zero future.
            </p>

            <div class="mt-6 space-y-4">
                @foreach (var commitment in _commitments)
                {
                    <div class="rounded-md border bg-muted/50 p-4">
                        <div class="flex items-start gap-3">
                            <div class="rounded-md bg-background p-2">
                                <LucideIconCn Name="@commitment.Icon" Size="16" Class="size-4 text-muted-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-baseline justify-between gap-2">
                                    <h3 class="text-sm font-medium">@commitment.Title</h3>
                                    <span class="font-semibold tabular-nums text-sm">
                                        @commitment.Progress%
                                    </span>
                                </div>
                                <p class="mt-1 text-sm text-muted-foreground">@commitment.Description</p>
                                <ProgressCn Value="@commitment.Progress" Class="mt-3 h-1.5" />
                            </div>
                        </div>
                    </div>
                }
            </div>

            <p class="mt-6 text-xs text-muted-foreground">
                Certified carbon neutral by Climate Neutral. Annual sustainability report available on
                request.
            </p>
        </div>
    </div>
</section>

@code {
    private record Commitment(string Icon, string Title, string Description, int Progress);

    private readonly List<Commitment> _commitments =
    [
        new("leaf", "Carbon Neutral", "100% carbon offset for all operations and employee travel", 100),
        new("zap", "Renewable Energy", "Data centers powered by renewable energy sources", 87),
        new("file-text", "Paperless Office", "Digital-first operations with minimal paper usage", 95),
        new("home", "Remote First", "Distributed team reducing commute carbon footprint", 100),
    ];
}
