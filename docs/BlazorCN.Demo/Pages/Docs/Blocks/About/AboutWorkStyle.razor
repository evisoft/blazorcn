@* ============================================================
   Block: about-work-style
   Title: About Work Style
   Description: Work style section showing async communication and collaboration approach for React remote teams
   Long Description: About section with testimonial integrated into company intro
   Dependencies: ButtonCn
   Source: original/blocks/about/about-work-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="mb-2 text-xl font-semibold tracking-tight">How we work</h2>
            <p class="text-sm leading-relaxed text-muted-foreground">
                Remote-first since day one. We've built our processes around deep work and asynchronous
                collaboration.
            </p>
        </div>

        @* Work practices *@
        <div class="border-b p-6">
            <div class="grid gap-4 sm:grid-cols-3">
                @foreach (var item in _workPractices)
                {
                    <div class="rounded-lg border bg-muted/50 p-4">
                        <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-full border bg-background">
                            <LucideIconCn Name="@item.Icon" Size="16" Class="h-4 w-4 text-muted-foreground" />
                        </div>
                        <h3 class="mb-2 text-sm font-medium">@item.Title</h3>
                        <p class="text-sm leading-relaxed text-muted-foreground">
                            @item.Description
                        </p>
                    </div>
                }
            </div>
        </div>

        @* Quick stats *@
        <div class="p-6">
            <div class="grid divide-y rounded-lg border sm:grid-cols-3 sm:divide-x sm:divide-y-0">
                @foreach (var stat in _quickStats)
                {
                    <div class="flex items-center gap-3 p-4">
                        <LucideIconCn Name="@stat.Icon" Size="16" Class="h-4 w-4 text-muted-foreground" />
                        <div>
                            <p class="text-base font-semibold">@stat.Value</p>
                            <p class="text-xs text-muted-foreground">@stat.Label</p>
                        </div>
                    </div>
                }
            </div>

            @* CTA *@
            <div class="mt-6 text-center">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    Learn more about our culture
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record WorkPractice(string Icon, string Title, string Description);
    private record QuickStat(string Icon, string Label, string Value);

    private readonly List<WorkPractice> _workPractices =
    [
        new("message-circle", "Async by default",
            "We write things down. Decisions happen in documents, not meetings. Everyone can contribute regardless of timezone."),
        new("video", "Meeting-light culture",
            "Most weeks have under 4 hours of meetings. We protect focus time and batch synchronous work when possible."),
        new("globe", "Timezone-friendly",
            "Core overlap hours are 10am-2pm ET. Outside that, work when you're most productive. No midnight calls."),
    ];

    private readonly List<QuickStat> _quickStats =
    [
        new("clock", "Avg. focus time", "6+ hrs/day"),
        new("calendar", "Meeting hours", "<4 hrs/week"),
        new("zap", "Response time", "Within 24h"),
    ];
}
