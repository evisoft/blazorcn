@* ============================================================
   Block: about-customer-advisory
   Title: About Customer Advisory
   Description: A customer advisory board showcasing key advisors from partner companies who guide product direction and strategy.
   Long Description: Build credibility by showcasing customer involvement in your product roadmap. This advisory board block displays key customer advisors with their companies and roles, demonstrating customer-driven development.
   Dependencies: None
   Source: original/blocks/about/about-customer-advisory.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Customer Advisory Board</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Leaders from our customer companies who guide our product direction
            </p>
        </div>
        <div class="grid gap-4 p-6 sm:grid-cols-2">
            @foreach (var advisor in _advisors)
            {
                <div class="rounded-md border bg-muted/50 p-4">
                    <div class="flex items-start gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-background">
                            <LucideIconCn Name="building" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <h3 class="font-medium text-sm">@advisor.Name</h3>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @advisor.Role at @advisor.Company
                            </p>
                            <p class="mt-2 text-muted-foreground text-sm">@advisor.Bio</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Advisor(string Name, string Company, string Role, string Bio);

    private readonly List<Advisor> _advisors =
    [
        new("Sarah Chen", "Stripe", "Head of Product, Payments",
            "Advises on payment infrastructure and developer experience for financial products"),
        new("Marcus Johnson", "Shopify", "VP Engineering",
            "Guides technical architecture and scaling strategies for high-traffic platforms"),
        new("Elena Rodriguez", "Atlassian", "Director of Product Design",
            "Provides insights on collaboration tools and enterprise user experience"),
        new("David Kim", "Notion", "Head of Growth",
            "Shares expertise on product-led growth and customer onboarding strategies"),
        new("Priya Patel", "Figma", "Principal Product Manager",
            "Advises on collaborative design tools and real-time multiplayer experiences"),
    ];
}
