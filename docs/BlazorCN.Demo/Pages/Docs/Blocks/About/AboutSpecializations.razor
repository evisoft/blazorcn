@* ============================================================
   Block: about-specializations
   Title: About Specializations
   Description: About section with team expertise and specializations
   Long Description: A showcase of conference talks and speaking engagements demonstrating thought leadership and industry expertise.
   Dependencies: BadgeCn
   Source: original/blocks/about/about-specializations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5 text-center">
            <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                Our Expertise
            </BadgeCn>
            <h2 class="mb-2 text-xl font-semibold tracking-tight">
                Specialized skills, proven results
            </h2>
            <p class="text-sm text-muted-foreground">
                We go deep in a few areas rather than shallow in many.
            </p>
        </div>

        @* Specializations grid *@
        <div class="p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                @foreach (var spec in _specializations)
                {
                    <div class="rounded-lg border bg-muted/50 p-4">
                        <div class="mb-3 flex items-center justify-between">
                            <h3 class="text-sm font-medium">@spec.Area</h3>
                            <span class="text-xs text-muted-foreground">@spec.Projects projects</span>
                        </div>

                        <div class="flex flex-wrap gap-2">
                            @foreach (var skill in spec.Skills)
                            {
                                <BadgeCn Class="font-normal" Variant="BadgeVariant.Secondary">
                                    @skill
                                </BadgeCn>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Specialization(string Area, string[] Skills, string Projects);

    private readonly List<Specialization> _specializations =
    [
        new("Product Strategy", ["User Research", "Roadmapping", "Go-to-Market"], "120+"),
        new("UX/UI Design", ["Design Systems", "Prototyping", "User Testing"], "200+"),
        new("Engineering", ["React/Next.js", "Node.js", "Cloud Infrastructure"], "150+"),
        new("Growth", ["Analytics", "Experimentation", "SEO/Content"], "80+"),
    ];
}
