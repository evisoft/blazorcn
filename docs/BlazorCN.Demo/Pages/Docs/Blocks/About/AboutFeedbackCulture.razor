@* ============================================================
   Block: about-feedback-culture
   Title: AboutFeedbackCulture
   Description: A feedback culture block for React and Next.js with a horizontal stepper showing 5 feedback stages, connecting lines between numbered steps, active step highlighting, stage descriptions with real examples, and entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-feedback-culture.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-5 py-4">
            <div>
                <h2 class="text-sm font-medium">How we give and receive feedback</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    A five-stage process for continuous improvement
                </p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                5 stages
            </BadgeCn>
        </div>

        @* Horizontal stepper *@
        <div class="border-b px-5 py-5">
            <div class="flex items-center justify-between">
                @for (int i = 0; i < _stages.Length; i++)
                {
                    var stage = _stages[i];
                    var index = i;
                    <div class="flex flex-1 items-center">
                        <button
                            type="button"
                            @onclick="@(() => _activeStep = index)"
                            class="@Cn.Merge("relative flex size-8 shrink-0 items-center justify-center rounded-full border text-xs font-medium transition-colors",
                                index == _activeStep ? "border-foreground bg-foreground text-background" :
                                index < _activeStep ? "border-emerald-500 bg-emerald-500/10 text-emerald-600" :
                                "border-muted-foreground/30 text-muted-foreground hover:border-muted-foreground/50")">
                            @if (index < _activeStep)
                            {
                                <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                            }
                            else
                            {
                                @stage.Step
                            }
                        </button>

                        @* Connecting line *@
                        @if (index < _stages.Length - 1)
                        {
                            <div class="mx-1.5 h-px flex-1">
                                <div class="@Cn.Merge("h-full transition-colors", index < _activeStep ? "bg-emerald-500/40" : "bg-border")"></div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Step labels (visible on sm+) *@
            <div class="mt-2 hidden items-start justify-between sm:flex">
                @for (int i = 0; i < _stages.Length; i++)
                {
                    var stage = _stages[i];
                    var index = i;
                    <div class="flex flex-1 justify-start">
                        <span class="@Cn.Merge("text-[10px] leading-tight", index == _activeStep ? "font-medium text-foreground" : "text-muted-foreground")">
                            @stage.Title
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Active step detail *@
        <div class="px-5 py-4">
            <div class="flex items-center gap-2">
                <h3 class="text-sm font-medium">@_stages[_activeStep].Title</h3>
                <span class="rounded-full bg-muted px-2 py-0.5 text-[10px] text-muted-foreground">
                    @_stages[_activeStep].Principle
                </span>
            </div>

            <p class="mt-2 text-sm leading-6 text-muted-foreground">
                @_stages[_activeStep].Description
            </p>

            @* Example *@
            <div class="mt-3 rounded-md bg-muted/50 p-3">
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Example
                </span>
                <p class="mt-1 text-xs italic leading-5 text-muted-foreground">
                    @_stages[_activeStep].Example
                </p>
            </div>
        </div>

        @* Footer navigation *@
        <div class="flex items-center justify-between border-t px-5 py-3">
            <button
                type="button"
                @onclick="@(() => _activeStep = Math.Max(0, _activeStep - 1))"
                disabled="@(_activeStep == 0)"
                class="text-xs font-medium text-muted-foreground transition-colors hover:text-foreground disabled:opacity-40">
                Previous
            </button>
            <span class="text-[10px] tabular-nums text-muted-foreground">
                Step @(_activeStep + 1) of @_stages.Length
            </span>
            <button
                type="button"
                @onclick="@(() => _activeStep = Math.Min(_stages.Length - 1, _activeStep + 1))"
                disabled="@(_activeStep == _stages.Length - 1)"
                class="text-xs font-medium text-muted-foreground transition-colors hover:text-foreground disabled:opacity-40">
                Next
            </button>
        </div>
    </div>
</section>

@code {
    private int _activeStep = 0;

    private record FeedbackStage(int Step, string Title, string Description, string Example, string Principle);

    private static readonly FeedbackStage[] _stages =
    [
        new(1, "Give Feedback",
            "Share observations within 48 hours while context is fresh. Focus on specific behaviors, not personality traits. Use the SBI framework: Situation, Behavior, Impact.",
            "\"In yesterday's design review, when you walked through the edge cases before showing the happy path, it helped the team catch two critical issues early.\"",
            "Be timely and specific"),
        new(2, "Receive Feedback",
            "Listen without defending. Ask clarifying questions to understand the observation fully. Thank the person for sharing — it takes courage to give honest feedback.",
            "\"Thank you for flagging that. Can you give me an example of when my pull request descriptions were unclear so I know exactly what to improve?\"",
            "Listen to understand, not to respond"),
        new(3, "Discuss Together",
            "Schedule a 1:1 within a week to discuss the feedback in depth. Both parties should come prepared with specific observations and proposed solutions. Keep it collaborative, not adversarial.",
            "\"I've thought about your feedback on code review turnaround. I think the root cause is context-switching — can we discuss batching reviews into focused blocks?\"",
            "Collaborate on solutions"),
        new(4, "Take Action",
            "Create concrete, measurable commitments. Write them down in your shared document. Small consistent changes beat ambitious plans that never happen. Start with one thing this week.",
            "\"Starting Monday, I'll review PRs in a dedicated 9-10am block daily and leave comments within 4 hours of assignment during working hours.\"",
            "Commit to specific changes"),
        new(5, "Follow Up",
            "Check in after 2-3 weeks. Acknowledge progress, adjust approach if needed. Feedback without follow-up signals it wasn't important. Close the loop to build trust for future conversations.",
            "\"I've noticed your review turnaround dropped from 18 hours to 5 hours this month. The team mentioned it's made async work much smoother. Great improvement.\"",
            "Close the loop"),
    ];
}
