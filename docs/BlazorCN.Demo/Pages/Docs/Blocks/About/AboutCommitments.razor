@* ============================================================
   Block: about-commitments
   Title: About Commitments
   Description: Company commitments and pledges section for React purpose-driven brand pages
   Long Description: Display before and after metrics showing measurable client outcomes and improvements
   Dependencies: None
   Source: original/blocks/about/about-commitments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Promises we make and keep</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                These aren't aspirations — they're commitments we're held accountable to, publicly and
                permanently.
            </p>
        </div>

        <div class="grid gap-px bg-muted sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var item in _commitments)
            {
                <div class="flex gap-4 bg-card p-5">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border">
                        <LucideIconCn Name="@item.Icon" Size="20" Class="h-5 w-5 text-muted-foreground" />
                    </div>
                    <div>
                        <h3 class="text-sm font-medium">@item.Title</h3>
                        <p class="mt-1 text-sm text-muted-foreground leading-relaxed">
                            @item.Description
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CommitmentItem(string Icon, string Title, string Description);

    private readonly List<CommitmentItem> _commitments =
    [
        new("leaf", "Carbon neutral by 2025",
            "We offset 100% of our emissions and are working to eliminate them entirely."),
        new("users", "1% of revenue to education",
            "Every year, we donate 1% of revenue to coding education nonprofits."),
        new("lock", "Your data stays yours",
            "We never sell data. Never have, never will. It's in our terms, permanently."),
        new("heart", "Living wage guarantee",
            "Every employee and contractor earns at least 150% of local living wage."),
        new("globe", "Remote-first, forever",
            "Work from anywhere. We'll never mandate return to office."),
        new("sparkles", "Transparent pricing",
            "No hidden fees, no surprise charges. What you see is what you pay."),
    ];
}
