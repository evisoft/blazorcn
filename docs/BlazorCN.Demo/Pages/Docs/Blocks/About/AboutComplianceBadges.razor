@* ============================================================
   Block: about-compliance-badges
   Title: About Compliance Badges
   Description: Security and regulatory compliance certifications grid displaying standards adherence and audit status.
   Long Description: Build trust through transparency. This component displays your security certifications and compliance status in a clean grid that reassures enterprise customers and security-conscious buyers.
   Dependencies: None
   Source: original/blocks/about/about-compliance-badges.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Compliance &amp; Certifications</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Our commitment to security and regulatory standards
            </p>
        </div>

        <div class="grid gap-4 p-6 sm:grid-cols-2">
            @foreach (var cert in _certifications)
            {
                <div class="flex gap-4 rounded-md border bg-card p-4">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted">
                        <LucideIconCn Name="@cert.Icon" Size="20" Class="size-5 text-muted-foreground" />
                    </div>

                    <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-2">
                            <h3 class="font-medium text-sm">@cert.Name</h3>
                            <div class="flex shrink-0 items-center gap-1">
                                @if (cert.Status == "active")
                                {
                                    <LucideIconCn Name="circle-check-big" Size="14" Class="size-3.5 text-emerald-600" />
                                    <span class="text-xs text-emerald-600">Active</span>
                                }
                                else
                                {
                                    <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-amber-600" />
                                    <span class="text-xs text-amber-600">In progress</span>
                                }
                            </div>
                        </div>
                        <p class="mt-1 text-muted-foreground text-sm">@cert.Description</p>
                        @if (!string.IsNullOrEmpty(cert.LastAudit))
                        {
                            <p class="mt-2 text-muted-foreground text-xs">
                                Last audit: @cert.LastAudit
                            </p>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-6 py-4">
            <p class="text-muted-foreground text-xs">
                SOC 2 and ISO 27001 audit reports available under NDA for enterprise customers. Contact
                security@@company.com for access.
            </p>
        </div>
    </div>
</section>

@code {
    private record CertificationItem(string Icon, string Name, string Description, string Status, string? LastAudit = null);

    private readonly List<CertificationItem> _certifications =
    [
        new("shield-check", "SOC 2 Type II", "Annual security and availability audit", "active", "Dec 2025"),
        new("lock", "ISO 27001", "Information security management system", "active", "Oct 2025"),
        new("globe", "GDPR Compliant", "EU data protection regulation adherence", "active"),
        new("file-check", "HIPAA Compliant", "Healthcare data protection standards", "active"),
        new("activity", "ISO 27701", "Privacy information management", "in-progress"),
        new("activity", "PCI DSS", "Payment card industry data security", "in-progress"),
    ];
}
