@* ============================================================
   Block: about-decision-framework
   Title: About Decision Framework
   Description: A transparent decision-making framework showing how decisions are made, who decides, and speed commitments
   Long Description: Build trust through operational transparency with this decision framework. Shows decision types, ownership structure, and commitment to decisiveness.
   Dependencies: None
   Source: original/blocks/about/about-decision-framework.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Decision-Making Framework</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                How we make decisions, who decides, and our commitment to speed without sacrificing
                thoughtfulness
            </p>
        </div>

        <div class="border-b p-6">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="zap" Size="16" Class="size-4 text-muted-foreground" />
                <h3 class="font-medium text-sm">Decision Types</h3>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                @foreach (var type in _decisionTypes)
                {
                    <div class="rounded-md border bg-card p-4">
                        <div class="flex items-start justify-between gap-2">
                            <h4 class="font-medium text-sm">@type.Title</h4>
                            <div class="flex items-center gap-1 text-muted-foreground text-xs">
                                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                <span>@type.Speed</span>
                            </div>
                        </div>
                        <p class="mt-2 text-muted-foreground text-sm">@type.Description</p>
                        <div class="mt-3 space-y-1.5">
                            @foreach (var example in type.Examples)
                            {
                                <div class="flex items-start gap-2">
                                    <LucideIconCn Name="check" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                    <span class="text-muted-foreground text-sm">@example</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-b p-6">
            <div class="mb-4 flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <h3 class="font-medium text-sm">Who Decides</h3>
            </div>

            <div class="rounded-md bg-muted/50 p-4">
                <div class="grid gap-4 sm:grid-cols-2">
                    @foreach (var role in _roles)
                    {
                        <div class="space-y-1">
                            <div class="font-medium text-sm">@role.Title</div>
                            <div class="text-muted-foreground text-sm">@role.Description</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="p-6">
            <h3 class="mb-4 font-medium text-sm">Decision-Making Principles</h3>

            <div class="space-y-3">
                @foreach (var principle in _principles)
                {
                    <div class="rounded-md bg-muted/50 p-4">
                        <h4 class="font-medium text-sm">@principle.Title</h4>
                        <p class="mt-1 text-muted-foreground text-sm">@principle.Description</p>
                    </div>
                }
            </div>
        </div>

        <div class="border-t bg-muted/30 px-6 py-4">
            <p class="text-muted-foreground text-sm">
                Speed and quality aren't trade-offs when you categorize decisions correctly. Most
                choices are reversible and should be made quickly.
            </p>
        </div>
    </div>
</section>

@code {
    private record DecisionType(string Title, string Description, string Speed, string[] Examples);
    private record RoleItem(string Title, string Description);
    private record Principle(string Title, string Description);

    private readonly List<DecisionType> _decisionTypes =
    [
        new("Reversible Decisions", "Fast, experimental choices that can be undone. Most decisions fall here.", "24-48 hours",
            ["Feature flags and A/B tests", "UI changes and design iterations", "Process experiments", "Tool trials"]),
        new("Irreversible Decisions", "One-way doors requiring careful consideration and broad input.", "1-2 weeks",
            ["Architecture and tech stack choices", "Hiring and team structure", "Major product pivots", "Legal and compliance commitments"]),
    ];

    private readonly List<RoleItem> _roles =
    [
        new("Individual Contributors", "Own execution decisions within their domain. Architecture, implementation, tooling."),
        new("Team Leads", "Decide team processes, sprint planning, and cross-team coordination."),
        new("Product", "Final say on roadmap, feature prioritization, and user-facing changes."),
        new("Leadership", "Company strategy, hiring, budget, and cross-functional initiatives."),
    ];

    private readonly List<Principle> _principles =
    [
        new("Clear Ownership", "Every decision has a directly responsible individual (DRI). They gather input but own the final call."),
        new("Bias Toward Action", "We default to making decisions quickly. Delay is often more costly than being wrong on reversible choices."),
        new("Disagree & Commit", "Voice concerns during discussion, but once decided, everyone commits fully regardless of initial position."),
        new("Document & Share", "Major decisions documented with reasoning. Team understands context even if they weren't in the room."),
    ];
}
