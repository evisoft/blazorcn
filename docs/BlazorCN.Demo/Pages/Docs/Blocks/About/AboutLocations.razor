@* ============================================================
   Block: about-locations
   Title: AboutLocations
   Description: A multi-column office locations grid block for React and Next.js with city cards, office type badges, team size indicators, timezone labels, hiring status, and staggered scale entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-locations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="building" Size="16" Class="size-4 text-muted-foreground" />
                        <h2 class="text-sm font-medium">Office Locations</h2>
                    </div>
                    <p class="mt-1 text-xs text-muted-foreground">
                        @_offices.Length offices across @_offices.Length cities &middot; @_totalTeamSize team members &middot; @_hiringCount locations hiring
                    </p>
                </div>
            </div>
        </div>

        @* Location grid *@
        <div class="grid gap-3 p-4 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var office in _offices)
            {
                <div class="relative overflow-hidden rounded-md border bg-card">
                    <div class="p-4">
                        @* Top row: type badge + hiring *@
                        <div class="flex items-center justify-between">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"border-0 text-[10px] font-normal {_officeTypeBadgeColor[office.OfficeType]}")">
                                @office.OfficeType
                            </BadgeCn>
                            @if (office.Hiring)
                            {
                                <span class="flex items-center gap-1">
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                    <span class="text-[10px] text-emerald-600 dark:text-emerald-400">
                                        Hiring
                                    </span>
                                </span>
                            }
                        </div>

                        @* City + Country *@
                        <h3 class="mt-3 text-sm font-medium">@office.City</h3>
                        <p class="text-xs text-muted-foreground">@office.Country</p>

                        @* Details *@
                        <div class="mt-3 space-y-1.5">
                            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                <LucideIconCn Name="map-pin" Size="12" Class="size-3 shrink-0" />
                                <span>@office.Address</span>
                            </div>
                            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                <LucideIconCn Name="users" Size="12" Class="size-3 shrink-0" />
                                <span>@office.TeamSize team members</span>
                            </div>
                        </div>

                        @* Timezone *@
                        <div class="mt-3 rounded-md bg-muted/50 px-2.5 py-1.5">
                            <span class="font-mono text-[10px] text-muted-foreground">
                                @office.Timezone
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-6 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Plus 35+ remote team members across 12 additional countries
            </p>
        </div>
    </div>
</section>

@code {
    private record Office(string Id, string City, string Country, string OfficeType, int TeamSize, string Address, string Timezone, bool Hiring);

    private static readonly Office[] _offices =
    [
        new("sf",        "San Francisco", "United States", "HQ",          85, "548 Market St, Suite 300",       "UTC-8 (PST)", true),
        new("london",    "London",        "United Kingdom","Engineering",  42, "14 Soho Square, W1D 3QG",        "UTC+0 (GMT)", true),
        new("berlin",    "Berlin",        "Germany",       "Design",       18, "Torstrasse 68, 10119",           "UTC+1 (CET)", false),
        new("singapore", "Singapore",     "Singapore",     "Sales",        24, "71 Robinson Road, Level 14",     "UTC+8 (SGT)", true),
        new("sao-paulo", "Sao Paulo",     "Brazil",        "Support",      16, "Av. Paulista, 1578, Bela Vista", "UTC-3 (BRT)", false),
    ];

    private static readonly Dictionary<string, string> _officeTypeBadgeColor = new()
    {
        ["HQ"]          = "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        ["Engineering"] = "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        ["Sales"]       = "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        ["Support"]     = "bg-red-500/10 text-red-700 dark:text-red-400",
        ["Design"]      = "bg-blue-500/10 text-blue-700 dark:text-blue-400",
    };

    private int _totalTeamSize => _offices.Sum(o => o.TeamSize);
    private int _hiringCount   => _offices.Count(o => o.Hiring);
}
