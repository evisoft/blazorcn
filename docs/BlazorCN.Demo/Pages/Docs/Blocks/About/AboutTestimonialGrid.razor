@* ============================================================
   Block: about-testimonial-grid
   Title: About Testimonial Grid
   Description: Display customer testimonials in a clean, scannable grid layout with quotes, names, and roles
   Long Description: Present social proof through authentic customer voices. This grid layout makes testimonials easy to scan while maintaining visual hierarchy—ideal for building trust and credibility on about pages or landing pages.
   Dependencies: AvatarCn
   Source: original/blocks/about/about-testimonial-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">What Our Customers Say</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Trusted by teams at forward-thinking companies
            </p>
        </div>
        <div class="grid gap-4 p-6 sm:grid-cols-2">
            @foreach (var testimonial in _testimonials)
            {
                <div class="rounded-md border bg-card p-4">
                    <LucideIconCn Name="quote" Size="20" Class="mb-3 size-5 text-muted-foreground/40" />
                    <p class="mb-4 text-sm leading-relaxed">@testimonial.Quote</p>
                    <div class="flex items-center gap-3">
                        <AvatarCn Class="size-9">
                            <AvatarFallbackCn Class="text-xs">@testimonial.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div>
                            <p class="font-medium text-sm">@testimonial.Name</p>
                            <p class="text-muted-foreground text-xs">
                                @testimonial.Role, @testimonial.Company
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Quote, string Name, string Role, string Company, string Initials);

    private readonly List<Testimonial> _testimonials =
    [
        new("The migration was seamless. Our team was up and running in less than a day, and the performance improvements were immediately noticeable.",
            "Sarah Chen", "VP of Engineering", "DataFlow", "SC"),
        new("Best decision we made this year. Support response time is under 10 minutes, and they actually understand our technical requirements.",
            "Marcus Rodriguez", "CTO", "StreamWorks", "MR"),
        new("We evaluated five platforms before choosing this one. The API documentation alone saved us weeks of integration work.",
            "Emily Watson", "Lead Developer", "BuildRight", "EW"),
        new("Our deployment frequency went from weekly to daily. The CI/CD integration is exactly what we needed for our growing team.",
            "James Park", "DevOps Lead", "CloudNative Co", "JP"),
        new("The analytics dashboard finally gives us the metrics that matter. No more exporting to spreadsheets for basic reporting.",
            "Priya Sharma", "Product Manager", "InsightLabs", "PS"),
        new("ROI was positive within the first quarter. The time saved on manual processes paid for itself immediately.",
            "David Kim", "Head of Operations", "ScaleUp Systems", "DK"),
    ];
}
