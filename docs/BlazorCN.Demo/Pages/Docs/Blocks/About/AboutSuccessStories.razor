@* ============================================================
   Block: about-success-stories
   Title: About Success Stories
   Description: About section with customer success stories highlight
   Long Description: About section with centered story and decorative lines
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/about/about-success-stories.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="text-center">
                <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                    Customer Success
                </BadgeCn>

                <h2 class="mb-2 text-xl font-semibold tracking-tight">
                    Real results from real customers
                </h2>

                <p class="text-sm text-muted-foreground">
                    Don't take our word for it—see what our customers have achieved.
                </p>
            </div>
        </div>

        <div class="border-b p-6">
            <div class="grid gap-4 md:grid-cols-3">
                @foreach (var story in _stories)
                {
                    <div class="rounded-md border bg-muted/50 p-4">
                        <div class="mb-3">
                            <span class="text-2xl font-semibold tabular-nums">@story.Metric</span>
                            <p class="text-sm font-medium">@story.Result</p>
                        </div>
                        <p class="mb-3 text-sm italic text-muted-foreground">"@story.Quote"</p>
                        <div class="border-t pt-3">
                            <p class="text-sm font-medium">@story.Company</p>
                            <p class="text-xs text-muted-foreground">@story.Industry</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="px-6 py-5 text-center">
            <ButtonCn Class="gap-2">
                Read All Case Studies
                <LucideIconCn Name="arrow-right" Size="16" Class="h-4 w-4" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Story(string Company, string Industry, string Metric, string Result, string Quote);

    private readonly List<Story> _stories =
    [
        new("TechStart Inc.", "SaaS", "3x", "faster product launches",
            "We shipped more in 3 months than the previous year."),
        new("Global Retail Co.", "E-commerce", "40%", "reduction in support tickets",
            "Our team finally has time for strategic work."),
        new("FinanceHub", "Fintech", "$2M", "saved annually",
            "The ROI was evident within the first quarter."),
    ];
}
