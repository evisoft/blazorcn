@* ============================================================
   Block: about-funding-timeline
   Title: AboutFundingTimeline
   Description: A vertical funding timeline block for React and Next.js with progressive round nodes, investor details, fund allocation breakdowns, valuation badges, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-funding-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-5 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Funding History</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Five rounds from pre-seed to Series C
                    </p>
                </div>
                <div class="text-right">
                    <div class="text-lg font-semibold tabular-nums">@_totalRaised</div>
                    <div class="text-[10px] text-muted-foreground">
                        total raised across @_totalInvestors investors
                    </div>
                </div>
            </div>
        </div>

        @* Timeline *@
        <div class="relative px-5 py-5">
            @* Vertical rail *@
            <div class="absolute bottom-5 left-[29px] top-5 w-px bg-border" aria-hidden="true"></div>

            <div class="space-y-5">
                @foreach (var round in _fundingRounds)
                {
                    <div class="relative flex gap-4">
                        @* Timeline node *@
                        <div class="relative z-10 flex w-[18px] shrink-0 items-start justify-center pt-3">
                            <div class="@Cn.Merge("rounded-full", GetRoundSize(round.Type), GetRoundColor(round.Type))"></div>
                        </div>

                        @* Content card *@
                        <div class="min-w-0 flex-1 rounded-md border bg-card p-3.5">
                            @* Round header *@
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <h3 class="text-sm font-medium">@round.Round</h3>
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal">
                                            @round.Valuation val.
                                        </BadgeCn>
                                    </div>
                                    <p class="mt-0.5 font-mono text-[10px] text-muted-foreground">
                                        @round.Date
                                    </p>
                                </div>
                                <div class="text-right">
                                    <div class="text-base font-semibold tabular-nums">@round.Amount</div>
                                </div>
                            </div>

                            @* Lead investor *@
                            <div class="mt-3">
                                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                    Lead
                                </span>
                                <p class="mt-0.5 text-xs font-medium">@round.LeadInvestor</p>
                            </div>

                            @* Participants *@
                            <div class="mt-2.5">
                                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                    Participants
                                </span>
                                <div class="mt-1 flex flex-wrap gap-1">
                                    @foreach (var p in round.Participants)
                                    {
                                        <span class="rounded bg-muted/50 px-1.5 py-0.5 text-[10px] text-muted-foreground">
                                            @p
                                        </span>
                                    }
                                </div>
                            </div>

                            @* Fund allocation *@
                            <div class="mt-3 border-t pt-3">
                                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                                    Fund Allocation
                                </span>
                                <div class="mt-2 space-y-1.5">
                                    @foreach (var a in round.Allocation)
                                    {
                                        <div class="flex items-center gap-2">
                                            <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                                                <div
                                                    class="h-full rounded-full bg-foreground/20"
                                                    style="@($"width:{a.Percentage}%")">
                                                </div>
                                            </div>
                                            <span class="w-20 text-right text-[10px] text-muted-foreground">
                                                @a.Category
                                            </span>
                                            <span class="w-7 text-right font-mono text-[10px] text-muted-foreground">
                                                @(a.Percentage)%
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-5 py-3">
            <p class="text-[10px] text-muted-foreground">
                Valuations are post-money. Participation details reflect publicly disclosed information
                as of February 2026.
            </p>
        </div>
    </div>
</section>

@code {
    private record FundAllocation(string Category, int Percentage);

    private record FundingRound(
        string Id,
        string Round,
        string Type,
        string Amount,
        string Date,
        string LeadInvestor,
        string Valuation,
        string[] Participants,
        FundAllocation[] Allocation);

    private static string GetRoundSize(string type) => type switch
    {
        "pre-seed" => "size-2.5",
        "seed"     => "size-3",
        "series-a" => "size-3.5",
        "series-b" => "size-4",
        "series-c" => "size-5",
        _          => "size-3",
    };

    private static string GetRoundColor(string type) => type switch
    {
        "pre-seed" => "bg-muted-foreground/60",
        "seed"     => "bg-muted-foreground/80",
        "series-a" => "bg-blue-500",
        "series-b" => "bg-blue-600",
        "series-c" => "bg-blue-700",
        _          => "bg-muted-foreground/80",
    };

    private const string _totalRaised = "$169.7M";
    private const int _totalInvestors = 14;

    private static readonly FundingRound[] _fundingRounds =
