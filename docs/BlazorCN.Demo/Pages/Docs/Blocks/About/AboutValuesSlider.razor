@* ============================================================
   Block: about-values-slider
   Title: About Values Slider
   Description: About section with interactive company values slider
   Long Description: About section with animated floating value tags
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/about/about-values-slider.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                Our Values
            </BadgeCn>
            <h2 class="mb-2 text-xl font-semibold tracking-tight">What drives us every day</h2>
            <p class="text-sm text-muted-foreground">
                These aren't just words on a wall—they're the principles that guide every decision.
            </p>
        </div>

        @* Value card *@
        <div class="p-6">
            <div class="rounded-lg bg-muted/50 p-8 text-center md:p-10">
                <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-background">
                    <LucideIconCn Name="@_values[_activeIndex].Icon" Size="28" Class="h-7 w-7 text-muted-foreground" />
                </div>

                <h3 class="mb-3 text-lg font-semibold">@_values[_activeIndex].Title</h3>

                <p class="text-sm text-muted-foreground">@_values[_activeIndex].Description</p>
            </div>

            @* Navigation *@
            <div class="mt-6 flex items-center justify-center gap-4">
                <ButtonCn Class="h-9 w-9 rounded-full" OnClick="GoToPrev" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Previous">
                    <LucideIconCn Name="chevron-left" Size="20" Class="h-5 w-5" />
                </ButtonCn>

                @* Dots *@
                <div class="flex gap-0.5">
                    @for (var i = 0; i < _values.Count; i++)
                    {
                        var index = i;
                        <button type="button"
                                aria-label="@($"Go to slide {index + 1}")"
                                class="inline-flex size-6 items-center justify-center"
                                @onclick="() => _activeIndex = index">
                            <span class="@($"h-2 w-2 rounded-full transition-colors {(index == _activeIndex ? "bg-foreground" : "bg-muted-foreground/30")}")"></span>
                        </button>
                    }
                </div>

                <ButtonCn Class="h-9 w-9 rounded-full" OnClick="GoToNext" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Next">
                    <LucideIconCn Name="chevron-right" Size="20" Class="h-5 w-5" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ValueItem(string Icon, string Title, string Description);

    private int _activeIndex;

    private readonly List<ValueItem> _values =
    [
        new("heart", "Customer Obsession",
            "Every decision we make starts with one question: how does this help our customers succeed? We don't just listen to feedback—we actively seek it out and act on it."),
        new("zap", "Bias for Action",
            "Speed matters. We'd rather make a decision with 70% of the information than wait for 100%. We learn by doing, iterate quickly, and course-correct as needed."),
        new("shield", "Trust & Transparency",
            "We share information openly, admit mistakes quickly, and never hide behind corporate speak. Trust is earned through consistent, honest communication."),
        new("users", "Win Together",
            "Individual brilliance is great, but collective success is better. We celebrate team wins, share credit generously, and lift each other up."),
    ];

    private void GoToPrev() =>
        _activeIndex = (_activeIndex - 1 + _values.Count) % _values.Count;

    private void GoToNext() =>
        _activeIndex = (_activeIndex + 1) % _values.Count;
}
