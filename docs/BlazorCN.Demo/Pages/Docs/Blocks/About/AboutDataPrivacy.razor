@* ============================================================
   Block: about-data-privacy
   Title: About Data Privacy
   Description: A data privacy practices section showing what data is collected, how it's stored, and user rights with clear commitments
   Long Description: Build trust with transparent data privacy practices. This component clearly communicates your data handling policies, storage practices, retention periods, and user rights, helping users understand how their information is protected.
   Dependencies: ButtonCn
   Source: original/blocks/about/about-data-privacy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Data Privacy &amp; Protection</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                How we collect, store, and protect your data
            </p>
        </div>

        <div class="p-6">
            <div class="grid gap-4 sm:grid-cols-2">
                @foreach (var commitment in _commitments)
                {
                    <div class="rounded-md bg-muted/50 p-4">
                        <div class="flex items-start gap-3">
                            <div class="mt-0.5">
                                <LucideIconCn Name="@commitment.Icon" Size="20" Class="size-5 text-muted-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <h3 class="font-medium text-sm">@commitment.Title</h3>
                                <p class="mt-1 text-muted-foreground text-sm">@commitment.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-6 rounded-md border p-4">
                <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0 flex-1">
                        <h3 class="font-medium text-sm">Questions about your data?</h3>
                        <p class="mt-1 text-muted-foreground text-sm">
                            Read our full privacy policy or contact our data protection officer for specific
                            inquiries.
                        </p>
                    </div>
                    <div class="flex shrink-0 gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                            Privacy Policy
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">
                            Contact DPO
                        </ButtonCn>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record PrivacyCommitment(string Icon, string Title, string Description);

    private readonly List<PrivacyCommitment> _commitments =
    [
        new("lock", "End-to-End Encryption",
            "All data is encrypted in transit using TLS 1.3 and at rest using AES-256 encryption. Your data is protected at every stage."),
        new("database", "Minimal Data Collection",
            "We only collect data necessary to provide our service. Email, name, and usage analytics. No third-party tracking or advertising pixels."),
        new("clock", "Clear Retention Policy",
            "Active accounts: data retained indefinitely. Deleted accounts: all personal data purged within 30 days. Logs retained for 90 days."),
        new("user-check", "Your Rights Protected",
            "Request data export, deletion, or correction at any time. GDPR and CCPA compliant. Full data portability in standard formats."),
        new("shield-check", "Third-Party Audited",
            "Annual SOC 2 Type II audits. ISO 27001 certified. Regular penetration testing by independent security firms."),
    ];
}
