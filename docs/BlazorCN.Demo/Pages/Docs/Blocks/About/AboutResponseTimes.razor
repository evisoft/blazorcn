@* ============================================================
   Block: about-response-times
   Title: About Response Times
   Description: Support response time guarantees organized by priority tier with clear descriptions and targets
   Long Description: Set clear support expectations with tiered response times. This component displays response time guarantees for different priority levels, helping customers understand when they can expect help based on issue severity.
   Dependencies: None
   Source: original/blocks/about/about-response-times.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Support Response Times</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Guaranteed response times by priority level
            </p>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b">
                        <th class="px-6 py-3 text-left font-medium text-muted-foreground text-xs uppercase tracking-wider">
                            Priority
                        </th>
                        <th class="px-6 py-3 text-left font-medium text-muted-foreground text-xs uppercase tracking-wider">
                            Response Time
                        </th>
                        <th class="px-6 py-3 text-left font-medium text-muted-foreground text-xs uppercase tracking-wider">
                            Description
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @foreach (var tier in _tiers)
                    {
                        <tr class="hover:bg-muted/50">
                            <td class="px-6 py-4">
                                <span class="font-medium text-sm">@tier.Priority</span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="font-semibold tabular-nums text-sm">@tier.ResponseTime</span>
                            </td>
                            <td class="px-6 py-4">
                                <p class="text-muted-foreground text-sm">@tier.Description</p>
                                <ul class="mt-2 space-y-1">
                                    @foreach (var example in tier.Examples)
                                    {
                                        <li class="flex items-center gap-2 text-muted-foreground text-xs">
                                            <span class="size-1 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                            @example
                                        </li>
                                    }
                                </ul>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="border-t px-6 py-4">
            <div class="flex items-start gap-3">
                <div class="min-w-0 flex-1">
                    <p class="text-muted-foreground text-sm">
                        Response times apply to all support channels: email, live chat, and in-app
                        messaging. Enterprise customers have access to dedicated Slack channels with faster
                        response times. All times measured during business hours (Mon-Fri, 9am-6pm local
                        time) unless otherwise specified.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ResponseTier(string Id, string Priority, string ResponseTime, string Description, string[] Examples);

    private readonly List<ResponseTier> _tiers =
    [
        new("critical", "Critical", "15 minutes",
            "Service outage, data loss, security breach, or issue affecting all users",
            ["Complete service unavailability", "Data breach or security vulnerability", "Payment processing failure"]),
        new("high", "High", "1 hour",
            "Major feature broken, significant performance degradation, or many users affected",
            ["Core feature not working", "Major performance issues", "Integration failures"]),
        new("medium", "Medium", "4 hours",
            "Minor feature issues, moderate performance problems, or small subset of users affected",
            ["Non-critical feature bug", "UI display issues", "Minor API inconsistencies"]),
        new("low", "Low", "24 hours",
            "General questions, feature requests, documentation issues, or cosmetic problems",
            ["How-to questions", "Feature enhancement requests", "Documentation clarifications"]),
    ];
}
