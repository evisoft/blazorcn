@* ============================================================
   Block: about-accessibility-pledge
   Title: About Accessibility Pledge
   Description: Accessibility commitment statement showing WCAG compliance level, screen reader support, keyboard navigation, and other a11y standards.
   Long Description: Demonstrate your commitment to inclusive design. This block shows your accessibility standards with compliance status for WCAG level, screen reader compatibility, keyboard navigation, and color contrast. Perfect for companies serious about accessibility.
   Dependencies: None
   Source: original/blocks/about/about-accessibility-pledge.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Accessibility Commitment</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Our standards for inclusive, accessible design
            </p>
        </div>

        @* Mission Statement *@
        <div class="border-b px-6 py-5">
            <p class="text-sm leading-relaxed">
                We believe the web should be accessible to everyone, regardless of ability or assistive
                technology. Accessibility isn't a feature or compliance checkbox — it's foundational to
                how we design and build.
            </p>
        </div>

        @* Standards *@
        <div class="divide-y">
            @foreach (var standard in _standards)
            {
                <div class="px-6 py-5">
                    <div class="flex items-start gap-4">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            @if (standard.Status == "compliant")
                            {
                                <LucideIconCn Name="circle-check-big" Size="20" Class="size-5 text-emerald-600" />
                            }
                            else
                            {
                                <LucideIconCn Name="circle-dot" Size="20" Class="size-5 text-amber-600" />
                            }
                        </div>

                        <div class="min-w-0 flex-1 space-y-3">
                            <div>
                                <div class="flex flex-wrap items-baseline gap-2">
                                    <h3 class="text-sm font-semibold">@standard.Category</h3>
                                    <span class="rounded-md bg-muted/50 px-2 py-0.5 font-mono text-xs text-muted-foreground">
                                        @standard.Level
                                    </span>
                                </div>
                                <p class="mt-1.5 text-sm text-muted-foreground leading-relaxed">
                                    @standard.Description
                                </p>
                            </div>

                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                    Implementation
                                </span>
                                <ul class="mt-2 space-y-1">
                                    @foreach (var detail in standard.Details)
                                    {
                                        <li class="flex items-start gap-2 text-sm">
                                            <span class="mt-1.5 size-1 shrink-0 rounded-full bg-muted-foreground"></span>
                                            <span>@detail</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Ongoing Commitment *@
        <div class="border-t px-6 py-5">
            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                Ongoing Improvement
            </span>
            <div class="mt-3 space-y-2 text-sm">
                <p class="text-muted-foreground">
                    Accessibility is never finished. We continuously test, iterate, and improve based on
                    user feedback and evolving standards.
                </p>
                <p class="text-muted-foreground">
                    Found an accessibility issue?
                    <button type="button" class="text-foreground underline-offset-2 hover:underline">
                        Report it here
                    </button>
                    and we'll prioritize a fix.
                </p>
            </div>
        </div>

        @* Footer *@
        <div class="border-t bg-muted/30 px-6 py-4">
            <p class="text-xs text-muted-foreground">
                Last accessibility audit: January 2026. Next audit: April 2026.
            </p>
        </div>
    </div>
</section>

@code {
    private record StandardItem(string Category, string Level, string Status, string Description, string[] Details);

    private readonly List<StandardItem> _standards =
    [
        new("WCAG Compliance", "AA", "compliant",
            "We meet WCAG 2.1 Level AA standards across all pages and components. This includes perceivable, operable, understandable, and robust content.",
            ["Automated testing on every deploy", "Manual audits quarterly", "Third-party audit completed Jan 2026"]),
        new("Screen Reader Support", "Full", "compliant",
            "Tested and optimized for NVDA, JAWS, and VoiceOver. All interactive elements have proper ARIA labels, landmarks, and live regions.",
            ["Semantic HTML structure throughout", "Descriptive alt text for all images", "Proper heading hierarchy on all pages"]),
        new("Keyboard Navigation", "Full", "compliant",
            "Every interactive element is keyboard accessible with visible focus indicators. Logical tab order, skip links, and keyboard shortcuts for common actions.",
            ["Focus indicators meet 3:1 contrast ratio", "No keyboard traps", "Skip to content link on all pages"]),
        new("Color Contrast", "Enhanced", "compliant",
            "All text meets WCAG AAA contrast ratios (7:1 for normal text, 4.5:1 for large text). Never rely on color alone to convey information.",
            ["Contrast validated in design system", "Pattern indicators supplement color", "High contrast mode supported"]),
    ];
}
