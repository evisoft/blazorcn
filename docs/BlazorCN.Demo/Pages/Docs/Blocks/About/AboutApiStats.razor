@* ============================================================
   Block: about-api-stats
   Title: About Api Stats
   Description: Display API performance metrics including uptime, latency, request volume, and error rates
   Long Description: Build confidence in your infrastructure with transparent performance metrics. This stats dashboard shows real operational data—essential for technical decision-makers evaluating platform reliability.
   Dependencies: None
   Source: original/blocks/about/about-api-stats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-xl font-semibold tracking-tight">API Performance</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Real-time infrastructure metrics</p>
                </div>
                <div class="flex items-center gap-2">
                    <span class="size-2 animate-pulse rounded-full bg-emerald-500"></span>
                    <span class="text-xs text-muted-foreground">All systems operational</span>
                </div>
            </div>
        </div>

        <div class="grid gap-4 p-6 sm:grid-cols-2">
            @foreach (var metric in _metrics)
            {
                <div class="@Cn.Merge("rounded-md p-4", metric.Status == "success" ? "bg-emerald-500/10" : metric.Status == "warning" ? "bg-amber-500/10" : "bg-muted/50")">
                    <div class="mb-3 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("size-1.5 rounded-full", metric.Status == "success" ? "bg-emerald-500" : metric.Status == "warning" ? "bg-amber-500" : "bg-muted-foreground")"></span>
                            <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                @metric.Label
                            </p>
                        </div>
                        <LucideIconCn Name="@metric.Icon" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <p class="@Cn.Merge("mb-1 text-2xl font-semibold tabular-nums", metric.Status == "success" ? "text-emerald-600" : metric.Status == "warning" ? "text-amber-600" : "text-foreground")">
                        @metric.Value
                    </p>
                    <p class="text-xs text-muted-foreground">@metric.Subtext</p>
                </div>
            }
        </div>

        <div class="border-t px-6 py-4">
            <div class="grid grid-cols-3 gap-4 text-center">
                <div>
                    <p class="mb-0.5 text-lg font-semibold tabular-nums">15</p>
                    <p class="text-xs text-muted-foreground">Global regions</p>
                </div>
                <div>
                    <p class="mb-0.5 text-lg font-semibold tabular-nums">&lt;100ms</p>
                    <p class="text-xs text-muted-foreground">p99 latency</p>
                </div>
                <div>
                    <p class="mb-0.5 text-lg font-semibold tabular-nums">24/7</p>
                    <p class="text-xs text-muted-foreground">Monitoring</p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record MetricItem(string Label, string Value, string Subtext, string Icon, string Status);

    private readonly List<MetricItem> _metrics =
    [
        new("Uptime", "99.99%", "Last 30 days", "activity", "success"),
        new("Avg Latency", "42ms", "p50 response time", "clock", "success"),
        new("Requests/Day", "2.4M", "+18% from last month", "trending-up", "neutral"),
        new("Error Rate", "0.01%", "Below SLA target", "alert-circle", "success"),
    ];
}
