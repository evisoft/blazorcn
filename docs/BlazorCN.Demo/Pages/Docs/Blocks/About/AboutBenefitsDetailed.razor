@* ============================================================
   Block: about-benefits-detailed
   Title: About Benefits Detailed
   Description: A comprehensive employee benefits section with expandable categories showing health, financial, time off, and growth perks
   Long Description: Build transparency around your total compensation package with this detailed benefits explorer. Organized into clear categories with expandable sections for easy navigation.
   Dependencies: None
   Source: original/blocks/about/about-benefits-detailed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Comprehensive Benefits Package</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Your total compensation includes competitive salary plus extensive benefits across
                health, financial, time off, and professional growth
            </p>
        </div>

        <div class="divide-y">
            @foreach (var category in _categories)
            {
                var catId = category.Id;
                var isExpanded = _expandedCategories.Contains(catId);
                <div>
                    <button type="button"
                            @onclick="() => ToggleCategory(catId)"
                            class="flex w-full items-center gap-3 px-6 py-4 text-left transition-colors hover:bg-muted/50">
                        <span class="text-2xl">@category.IconEmoji</span>
                        <span class="flex-1 text-sm font-medium">@category.Title</span>
                        <span class="text-xs text-muted-foreground">
                            @category.Benefits.Length benefits
                        </span>
                        <LucideIconCn Name="chevron-right" Size="16"
                                      Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-muted/30 px-6 py-4">
                            <div class="grid gap-4 sm:grid-cols-2">
                                @foreach (var benefit in category.Benefits)
                                {
                                    <div class="rounded-md bg-card p-4">
                                        <h3 class="text-sm font-medium">@benefit.Name</h3>
                                        <p class="mt-1 text-sm text-muted-foreground">
                                            @benefit.Description
                                        </p>
                                        @if (!string.IsNullOrEmpty(benefit.Coverage))
                                        {
                                            <div class="mt-2 rounded bg-muted/50 px-2 py-1">
                                                <p class="text-xs font-medium text-muted-foreground">
                                                    @benefit.Coverage
                                                </p>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t bg-muted/30 px-6 py-4">
            <p class="text-sm text-muted-foreground">
                Benefits effective immediately upon hire. Some benefits may have eligibility
                requirements or waiting periods. Contact HR for detailed plan documents.
            </p>
        </div>
    </div>
</section>

@code {
    private record BenefitItem(string Name, string Description, string? Coverage = null);
    private record CategoryItem(string Id, string Title, string IconEmoji, BenefitItem[] Benefits);

    private HashSet<string> _expandedCategories = ["health"];

    private void ToggleCategory(string categoryId)
    {
        if (!_expandedCategories.Remove(categoryId))
        {
            _expandedCategories.Add(categoryId);
        }
    }

    private readonly List<CategoryItem> _categories =
    [
        new("health", "Health & Wellness", "\u2764\uFE0F",
            [
                new("Medical Insurance", "Comprehensive health coverage for you and your family", "100% premium coverage for employees, 75% for dependents"),
                new("Dental & Vision", "Complete dental and vision care plans", "Preventive care fully covered"),
                new("Mental Health Support", "Therapy sessions and wellness apps", "12 free sessions per year + Headspace subscription"),
                new("Fitness Stipend", "Monthly wellness allowance for gym or fitness activities", "$100/month wellness credit"),
            ]),
        new("financial", "Financial Benefits", "\uD83D\uDCB0",
            [
                new("401(k) Retirement Plan", "Company-matched retirement savings", "5% match on contributions up to IRS limits"),
                new("Equity Grants", "Stock options with 4-year vesting schedule", "Grants based on role and performance"),
                new("HSA Contribution", "Health Savings Account with employer contribution", "$1,200 annual employer contribution"),
                new("Commuter Benefits", "Pre-tax transit and parking benefits", "Up to $300/month tax-free"),
            ]),
        new("time", "Time Off & Flexibility", "\uD83C\uDFD6\uFE0F",
            [
                new("Unlimited PTO", "Take time off when you need it with manager approval", "Minimum 3 weeks recommended per year"),
                new("Parental Leave", "Paid leave for new parents", "16 weeks primary caregiver, 8 weeks secondary"),
                new("Remote Work", "Work from anywhere with flexible hours", "Fully remote with optional office access"),
                new("Sabbatical Program", "Extended paid leave after tenure milestones", "4 weeks paid after 5 years of service"),
            ]),
        new("growth", "Learning & Growth", "\uD83D\uDCDA",
            [
                new("Learning Budget", "Annual allowance for courses, books, and conferences", "$2,000 per year per employee"),
                new("Conference Attendance", "Attend industry conferences with full coverage", "1-2 conferences per year + travel expenses"),
                new("Mentorship Program", "Paired with senior leaders for career guidance", "Quarterly mentor matching"),
                new("Tuition Reimbursement", "Support for continued education and degree programs", "Up to $5,000 per year for approved programs"),
            ]),
    ];
}
