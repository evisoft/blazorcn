@* ============================================================
   Block: about-alternating
   Title: About Alternating
   Description: Alternating about section with image placeholders and story chapters for React company pages
   Long Description: A professional advisory board section showcasing advisors with their roles, companies, and expertise in a clean grid layout.
   Dependencies: None
   Source: original/blocks/about/about-alternating.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Our Story</h2>
            <p class="mt-1 text-sm text-muted-foreground">A journey told in chapters</p>
        </div>

        @for (var i = 0; i < _sections.Count; i++)
        {
            var item = _sections[i];
            var index = i;
            <div class="border-b px-6 py-5 last:border-0">
                <div class="grid items-center gap-6 md:grid-cols-2">
                    @* Text - alternates sides *@
                    <div class="@(index % 2 == 1 ? "md:order-2" : "")">
                        <div class="mb-2 flex items-center gap-2">
                            <LucideIconCn Name="@item.Icon" Size="16" Class="h-4 w-4 text-muted-foreground" />
                            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                @item.Label
                            </span>
                        </div>
                        <h3 class="mb-2 text-sm font-medium">@item.Title</h3>
                        <p class="text-sm text-muted-foreground leading-relaxed">
                            @item.Description
                        </p>
                    </div>

                    @* Image placeholder *@
                    <div class="@Cn.Merge("aspect-[4/3] overflow-hidden rounded-md border bg-muted/50", index % 2 == 1 ? "md:order-1" : "")">
                        <div class="flex h-full w-full items-center justify-center">
                            <LucideIconCn Name="@item.Icon" Size="48" Class="h-12 w-12 text-muted-foreground/20" />
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record SectionItem(string Label, string Title, string Description, string Icon);

    private readonly List<SectionItem> _sections =
    [
        new("The Origin", "It started with frustration",
            "We spent years watching teams drown in tools that promised to help but only added complexity. In 2018, we decided to build something better.",
            "lightbulb"),
        new("The Mission", "Simplicity is the ultimate sophistication",
            "We believe powerful software doesn't have to be complicated. Every feature we build must pass one test: does it make life simpler?",
            "target"),
        new("The Future", "We're just getting started",
            "What you see today is 1% of our vision. We're building a platform that will fundamentally change how teams work together.",
            "rocket"),
    ];
}
