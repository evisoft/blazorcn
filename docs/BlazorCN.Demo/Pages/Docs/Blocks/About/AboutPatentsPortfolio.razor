@* ============================================================
   Block: about-patents-portfolio
   Title: About Patents Portfolio
   Description: A portfolio of granted patents showcasing innovation and intellectual property in key technology areas.
   Long Description: Demonstrate innovation depth with your patent portfolio. This about block displays granted patents with patent numbers, grant dates, and descriptions, building credibility in technical innovation.
   Dependencies: None
   Source: original/blocks/about/about-patents-portfolio.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Patents &amp; Intellectual Property</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Granted patents protecting our core innovations
            </p>
        </div>
        <div class="divide-y">
            @foreach (var patent in _patents)
            {
                <div class="px-6 py-5">
                    <div class="flex items-start gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="award" Size="20" Class="size-5 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <h3 class="font-medium text-sm">@patent.Title</h3>
                            <div class="mt-1 flex items-center gap-2">
                                <span class="font-mono text-muted-foreground text-xs">
                                    @patent.PatentNumber
                                </span>
                                <span class="text-muted-foreground text-xs">•</span>
                                <span class="font-medium text-muted-foreground text-xs tabular-nums">
                                    Granted @patent.Year
                                </span>
                            </div>
                            <p class="mt-3 text-muted-foreground text-sm">@patent.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Patent(string Title, string PatentNumber, int Year, string Description);

    private readonly List<Patent> _patents =
    [
        new("Method for Real-Time Conflict Resolution in Distributed Databases", "US 11,234,567 B2", 2024,
            "System and method for resolving write conflicts in distributed databases with eventual consistency guarantees"),
        new("Secure Multi-Party Computation for Privacy-Preserving Analytics", "US 11,198,432 B1", 2023,
            "Cryptographic protocols enabling analytics on encrypted data without exposing sensitive information"),
        new("Adaptive Query Optimization Using Machine Learning", "US 11,145,789 B2", 2023,
            "Database query optimizer that learns from execution patterns to improve performance over time"),
        new("Scalable Vector Similarity Search with Hierarchical Indexing", "US 10,987,654 B1", 2022,
            "Hierarchical indexing structure for approximate nearest neighbor search in high-dimensional spaces"),
        new("Dynamic Rate Limiting Based on System Health Metrics", "US 10,876,543 B2", 2022,
            "Adaptive rate limiting system that adjusts quotas based on real-time infrastructure health signals"),
    ];
}
