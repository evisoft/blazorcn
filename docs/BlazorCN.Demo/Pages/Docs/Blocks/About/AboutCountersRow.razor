@* ============================================================
   Block: about-counters-row
   Title: About Counters Row
   Description: Horizontal stats counters row with large numbers for React metrics displays
   Long Description: Display key metrics in a clean horizontal layout with this counters component for Next.js sites. Features large numbers with suffixes and labels arranged side-by-side for maximum impact. Built with Tailwind CSS. The horizontal arrangement creates a ticker-tape effect while keeping numbers front and center—perfect for data-driven companies, SaaS dashboards, and landing pages where metrics make an immediate impression.
   Dependencies: None
   Source: original/blocks/about/about-counters-row.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid grid-cols-2 gap-px bg-muted sm:grid-cols-4">
            @foreach (var counter in _counters)
            {
                <div class="bg-card px-6 py-8 text-center">
                    <div class="text-2xl font-semibold tabular-nums tracking-tight">
                        @counter.Value
                    </div>
                    <p class="mt-1 text-sm text-muted-foreground">@counter.Label</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CounterItem(string Value, string Label);

    private readonly List<CounterItem> _counters =
    [
        new("8+", "Years"),
        new("50K+", "Users"),
        new("99.9%", "Uptime"),
        new("4.9", "Rating"),
    ];
}
