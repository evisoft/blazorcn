@* ============================================================
   Block: about-before-after
   Title: About Before After
   Description: Customer transformation stories showing before state, after state, and specific metrics for 3 different journeys
   Long Description: Showcase customer transformations with this before/after section. Features real customer journeys with specific metrics showing the impact of your product.
   Dependencies: None
   Source: original/blocks/about/about-before-after.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="text-xl font-semibold tracking-tight">Customer Transformations</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                Real stories from teams who transformed how they build interfaces
            </p>
        </div>

        <div class="divide-y">
            @foreach (var transformation in _transformations)
            {
                <div class="p-6">
                    <div class="mb-4">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-muted-foreground" />
                            <h3 class="text-sm font-medium">@transformation.Customer</h3>
                        </div>
                        <div class="mt-1 text-sm text-muted-foreground">@transformation.Role</div>
                    </div>

                    <div class="mb-4 rounded-md bg-muted/50 p-4">
                        <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                            Challenge
                        </div>
                        <p class="mt-1 text-sm">@transformation.Scenario</p>
                    </div>

                    <div class="space-y-3">
                        @foreach (var metric in transformation.Metrics)
                        {
                            <div class="rounded-md border bg-card p-4">
                                <div class="mb-3 text-sm font-medium">@metric.Label</div>

                                <div class="grid gap-3 sm:grid-cols-2">
                                    <div class="space-y-1">
                                        <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                            Before
                                        </div>
                                        <div class="flex items-start gap-2">
                                            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-red-500"></span>
                                            <span class="text-sm text-muted-foreground">@metric.Before</span>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-3">
                                        <LucideIconCn Name="arrow-right" Size="16" Class="hidden size-4 shrink-0 text-muted-foreground sm:block" />
                                        <div class="space-y-1">
                                            <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                                After
                                            </div>
                                            <div class="flex items-start gap-2">
                                                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                                                <span class="text-sm">@metric.After</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/30 px-6 py-4">
            <p class="text-sm text-muted-foreground">
                These are real transformations from teams across startups, agencies, and enterprises.
                Your results may vary, but the pattern is consistent: less time on UI, more time on what
                matters.
            </p>
        </div>
    </div>
</section>

@code {
    private record MetricItem(string Label, string Before, string After);
    private record Transformation(string Customer, string Role, string Scenario, MetricItem[] Metrics);

    private readonly List<Transformation> _transformations =
    [
        new("Early-Stage SaaS Startup", "Solo founder building MVP",
            "Needed a production-ready dashboard in two weeks to close first customers",
            [
                new("Time to MVP", "6 weeks building from scratch", "10 days using pre-built components"),
                new("Accessibility Score", "42/100 (manual build)", "95/100 (WCAG 2.1 AA compliant)"),
                new("Component Quality", "Basic functionality only", "Dark mode, responsive, polished"),
            ]),
        new("Digital Agency", "Design and development team",
            "Client projects required consistent components across 5 websites per quarter",
            [
                new("Development Cost", "$12k per project rebuilding UI", "$3k per project with reusable code"),
                new("Design Consistency", "Every project looked different", "Cohesive brand across all sites"),
                new("Maintenance Time", "8 hours/week fixing UI bugs", "1 hour/week with stable components"),
            ]),
        new("Enterprise Company", "Platform engineering team",
            "Needed to modernize internal tools used by 500+ employees without disrupting work",
            [
                new("Migration Speed", "18 months estimated timeline", "6 months actual completion"),
                new("Developer Satisfaction", "3.2/5 (old component library)", "4.7/5 (components they own)"),
                new("Update Friction", "Breaking changes quarterly", "Update on their schedule"),
            ]),
    ];
}
