@* ============================================================
   Block: about-two-column
   Title: About Two Column
   Description: Two-column about section with company story and stats grid for React landing pages
   Long Description: An annual transparency report showcasing key operational metrics like data requests, uptime, security incidents, and response times.
   Dependencies: ButtonCn
   Source: original/blocks/about/about-two-column.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid gap-8 p-6 lg:grid-cols-2 lg:gap-12">
            @* Left column - Content *@
            <div class="space-y-4">
                <h2 class="text-xl font-semibold tracking-tight">
                    We're building the tools we wished existed
                </h2>

                <div class="space-y-3 text-sm leading-relaxed text-muted-foreground">
                    <p>
                        What started as a side project in 2018 has grown into a platform trusted by
                        thousands of teams worldwide. We saw how much time people wasted on repetitive tasks
                        and decided to fix it.
                    </p>
                    <p>
                        Today, we're a team of 50+ designers, engineers, and operators spread across the
                        globe—united by a belief that software should feel like magic, not work.
                    </p>
                </div>

                <div class="flex flex-wrap gap-3 pt-2">
                    <ButtonCn Class="gap-2" Size="ButtonSize.Sm">
                        Our Story
                        <LucideIconCn Name="arrow-right" Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                        Meet the Team
                    </ButtonCn>
                </div>
            </div>

            @* Right column - Stats with accent *@
            <div class="relative">
                <div class="absolute left-0 top-4 bottom-4 w-1 rounded-full bg-muted"></div>
                <div class="grid grid-cols-2 gap-4 pl-6">
                    @foreach (var stat in _stats)
                    {
                        <div class="rounded-lg border bg-muted/50 p-4">
                            <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-full border bg-background">
                                <LucideIconCn Name="@stat.Icon" Size="16" Class="h-4 w-4 text-muted-foreground" />
                            </div>
                            <div class="text-2xl font-semibold tabular-nums tracking-tight">
                                @stat.Value
                            </div>
                            <div class="mt-1 text-xs text-muted-foreground">@stat.Label</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Value, string Label, string Icon);

    private readonly List<StatItem> _stats =
    [
        new("2018", "Founded", "building-2"),
        new("50+", "Team members", "users"),
        new("10K+", "Customers", "sparkles"),
        new("30+", "Countries", "globe"),
    ];
}
