<section class="mx-auto w-full max-w-4xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid gap-8 p-6 lg:grid-cols-2 lg:gap-10">
          @* Left - About content *@
          <div>
            <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
              About Us
            </BadgeCn>

            <h2 class="mb-4 text-xl font-semibold tracking-tight">
              We help teams do their best work
            </h2>

            <div class="space-y-3 text-sm leading-relaxed text-muted-foreground">
              <p>
                Since 2019, we've been on a mission to eliminate the friction that slows teams down.
                No more context switching. No more lost information. No more busy work.
              </p>
              <p>
                Our platform brings everything together in one place, so you can focus on what
                actually matters: building great products and serving your customers.
              </p>
              <p>
                Today, over 5,000 companies trust us to keep their teams aligned and productive.
              </p>
            </div>
          </div>

          @* Right - Testimonial *@
          <div class="flex items-center">
            <div class="rounded-lg bg-muted/50 p-6">
              <LucideQuoteCn Class="mb-3 h-7 w-7 text-muted-foreground/30" />

              <blockquote class="mb-5 text-sm leading-relaxed">
                We cut our meeting time in half and shipped 40% more features last quarter. This
                isn't just a tool—it's how we work now.
              </blockquote>

              <div class="flex items-center gap-3">
                <AvatarCn Class="h-11 w-11">
                  <AvatarFallbackCn Class="bg-background font-medium">JM</AvatarFallbackCn>
                </AvatarCn>

                <div>
                  <p class="text-sm font-medium">Jessica Martinez</p>
                  <p class="text-xs text-muted-foreground">VP Engineering, TechCorp</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

