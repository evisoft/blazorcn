        <div class=""border-b px-5 py-5"">
            <div class=""flex items-center justify-between"">
                @for (int i = 0; i < _stages.Length; i++)
                {
                    var stage = _stages[i];
                    var index = i;
                    <div class=""flex flex-1 items-center"">
                        <button
                            type=""button""
                            @onclick=""@(() => _activeStep = index)""
                            class=""@Cn.Merge(""relative flex size-8 shrink-0 items-center justify-center rounded-full border text-xs font-medium transition-colors"",
                                index == _activeStep ? ""border-foreground bg-foreground text-background"" :
                                index < _activeStep ? ""border-emerald-500 bg-emerald-500/10 text-emerald-600"" :
                                ""border-muted-foreground/30 text-muted-foreground hover:border-muted-foreground/50"")"">
                            @if (index < _activeStep)
                            {
                                <LucideIconCn Name=""check"" Size=""14"" Class=""size-3.5"" />
                            }
                            else
                            {
                                @stage.Step
                            }
                        </button>

                        @* Connecting line *@
                        @if (index < _stages.Length - 1)
                        {
                            <div class=""mx-1.5 h-px flex-1"">
                                <div class=""@Cn.Merge(""h-full transition-colors"", index < _activeStep ? ""bg-emerald-500/40"" : ""bg-border"")""></div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Step labels (visible on sm+) *@
            <div class=""mt-2 hidden items-start justify-between sm:flex"">
                @for (int i = 0; i < _stages.Length; i++)
                {
                    var stage = _stages[i];
                    var index = i;
                    <div class=""flex flex-1 justify-start"">
                        <span class=""@Cn.Merge(""text-[10px] leading-tight"", index == _activeStep ? ""font-medium text-foreground"" : ""text-muted-foreground"")"">
                            @stage.Title
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Active step detail *@
        <div class=""px-5 py-4"">
            <div class=""flex items-center gap-2"">
                <h3 class=""text-sm font-medium"">@_stages[_activeStep].Title</h3>
                <span class=""rounded-full bg-muted px-2 py-0.5 text-[10px] text-muted-foreground"">
                    @_stages[_activeStep].Principle
                </span>
            </div>

            <p class=""mt-2 text-sm leading-6 text-muted-foreground"">
                @_stages[_activeStep].Description
            </p>

            @* Example *@
            <div class=""mt-3 rounded-md bg-muted/50 p-3"">
                <span class=""text-[10px] font-medium uppercase tracking-wider text-muted-foreground"">
                    Example
                </span>
                <p class=""mt-1 text-xs italic leading-5 text-muted-foreground"">
                    @_stages[_activeStep].Example
                </p>
            </div>
        </div>

        @* Footer navigation *@
        <div class=""flex items-center justify-between border-t px-5 py-3"">
            <button
                type=""button""
                @onclick=""@(() => _activeStep = Math.Max(0, _activeStep - 1))""
                disabled=""@(_activeStep == 0)""
                class=""text-xs font-medium text-muted-foreground transition-colors hover:text-foreground disabled:opacity-40"">
                Previous
            </button>
            <span class=""text-[10px] tabular-nums text-muted-foreground"">
                Step @(_activeStep + 1) of @_stages.Length
            </span>
            <button
                type=""button""
                @onclick=""@(() => _activeStep = Math.Min(_stages.Length - 1, _activeStep + 1))""
                disabled=""@(_activeStep == _stages.Length - 1)""
                class=""text-xs font-medium text-muted-foreground transition-colors hover:text-foreground disabled:opacity-40"">
                Next
            </button>
        </div>
    </div>
</section>

