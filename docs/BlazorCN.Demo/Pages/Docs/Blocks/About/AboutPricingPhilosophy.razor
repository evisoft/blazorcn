@* ============================================================
   Block: about-pricing-philosophy
   Title: About Pricing Philosophy
   Description: Transparent pricing principles explaining why you price the way you do with clear explanations for each principle.
   Long Description: Build trust through pricing transparency. This block explains your pricing philosophy with clear principles like transparency, fairness, and value-based pricing. Perfect for SaaS companies that want to justify their pricing decisions and reduce friction.
   Dependencies: None
   Source: original/blocks/about/about-pricing-philosophy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Pricing Philosophy</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Why we price the way we do—and what that means for you
            </p>
        </div>

        @* Introduction *@
        <div class="border-b px-6 py-5">
            <p class="text-sm leading-relaxed">
                Pricing is a reflection of values. Ours is built on transparency, fairness, and
                alignment with customer success. Here's what that means in practice.
            </p>
        </div>

        @* Principles *@
        <div class="divide-y">
            @foreach (var principle in _principles)
            {
                <div class="px-6 py-5">
                    <div class="flex gap-4">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="@principle.Icon" Size="20" Class="size-5 text-muted-foreground" />
                        </div>

                        <div class="min-w-0 flex-1 space-y-2">
                            <h3 class="font-semibold text-sm">@principle.Title</h3>
                            <p class="text-muted-foreground text-sm leading-relaxed">
                                @principle.Description
                            </p>

                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                                    Our Commitment
                                </span>
                                <p class="mt-1 text-sm">@principle.Commitment</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t bg-muted/30 px-6 py-4">
            <p class="text-muted-foreground text-xs">
                Questions about pricing?
                <button type="button" class="text-foreground underline-offset-2 hover:underline">
                    Read our pricing FAQ
                </button>
                or
                <button type="button" class="text-foreground underline-offset-2 hover:underline">
                    contact us
                </button>.
            </p>
        </div>
    </div>
</section>

@code {
    private record Principle(string Icon, string Title, string Description, string Commitment);

    private readonly List<Principle> _principles =
    [
        new("scale", "Transparent & Fair",
            "Our pricing is public and the same for everyone. No enterprise 'call us' pricing, no negotiation games. What you see is what you pay—whether you're a solo developer or a Fortune 500 company.",
            "We publish all price changes 60 days in advance."),
        new("dollar-sign", "Value-Based, Not Cost-Plus",
            "We price based on the value we deliver—time saved, quality improved, speed to market—not our internal costs. If we can deliver 10x more value, we invest in doing that, not raising prices.",
            "Pricing reflects customer outcomes, not our margins."),
        new("shield-check", "No Hidden Fees",
            "No setup fees, no surprise charges, no 'contact sales for API access.' Every feature in a tier is included. We make money when you succeed long-term, not from gotcha fees.",
            "If it's not listed in the pricing, it's free."),
        new("check-circle-2", "Customer-Aligned Incentives",
            "We charge based on seats and usage, not on your revenue. We grow when you grow your team, not when you grow your business. Your success is your success—we're just here to help.",
            "We'll never ask for a percentage of your revenue."),
    ];
}
