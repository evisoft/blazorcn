@* ============================================================
   Block: about-open-source
   Title: About Open Source
   Description: Showcase open source contributions with repository stats and aggregate metrics
   Long Description: Demonstrate your commitment to open source and developer community. This layout highlights your public repositories with key metrics—perfect for building credibility with technical audiences and attracting developer talent.
   Dependencies: BadgeCn
   Source: original/blocks/about/about-open-source.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Open Source</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Contributing to the developer community
            </p>
        </div>
        <div class="border-b p-6">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                @foreach (var stat in _aggregateStats)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="mb-1 flex items-center gap-1.5">
                            <LucideIconCn Name="@stat.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                            <p class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                                @stat.Label
                            </p>
                        </div>
                        <p class="font-semibold tabular-nums text-2xl">@stat.Value</p>
                    </div>
                }
            </div>
        </div>
        <div class="space-y-3 p-6">
            @foreach (var repo in _repositories)
            {
                <div class="rounded-md border bg-card p-4 transition-colors hover:bg-muted/50">
                    <div class="mb-2 flex items-start justify-between gap-4">
                        <h3 class="font-medium font-mono text-sm">@repo.Name</h3>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs">
                            <span class="mr-1.5 size-2 rounded-full" style="@($"background-color: {repo.LanguageColor}")"></span>
                            @repo.Language
                        </BadgeCn>
                    </div>
                    <p class="mb-3 text-muted-foreground text-sm">@repo.Description</p>
                    <div class="flex items-center gap-4 text-muted-foreground text-xs">
                        <div class="flex items-center gap-1">
                            <LucideIconCn Name="star" Size="14" Class="size-3.5" />
                            <span class="tabular-nums">@repo.Stars.ToString("N0")</span>
                        </div>
                        <div class="flex items-center gap-1">
                            <LucideIconCn Name="git-fork" Size="14" Class="size-3.5" />
                            <span class="tabular-nums">@repo.Forks.ToString("N0")</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StatItem(string Icon, string Label, string Value);
    private record Repository(string Name, string Description, int Stars, int Forks, string Language, string LanguageColor);

    private readonly List<StatItem> _aggregateStats =
    [
        new("git-commit-horizontal", "Commits", "24,800"),
        new("users", "Contributors", "342"),
        new("star", "Total Stars", "45,000"),
        new("activity", "Projects", "12"),
    ];

    private readonly List<Repository> _repositories =
    [
        new("react-hooks-toolkit", "Production-ready React hooks for authentication, data fetching, and state management. Zero dependencies.", 12400, 842, "TypeScript", "#3178c6"),
        new("api-rate-limiter", "Distributed rate limiting for Node.js APIs with Redis backend. Handles millions of requests per second.", 8200, 510, "TypeScript", "#3178c6"),
        new("deploy-automation", "CLI tool for zero-downtime deployments with automatic rollback. Works with AWS, GCP, and Azure.", 5800, 320, "Go", "#00ADD8"),
        new("ui-components", "Accessible React component library built on Radix UI. Fully customizable with Tailwind CSS.", 18600, 1240, "TypeScript", "#3178c6"),
    ];
}
