@* ============================================================
   Block: about-executive-team
   Title: AboutExecutiveTeam
   Description: An executive team multi-column grid block for React and Next.js with responsive card layout, hover-reveal quotes, tenure badges, brief bios, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/about/about-executive-team.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="px-6 py-4">
            <span class="text-xs font-medium text-muted-foreground">Leadership</span>
            <h2 class="mt-0.5 text-sm font-medium">Executive Team</h2>
        </div>

        <SeparatorCn />

        @* Grid *@
        <div class="grid gap-px bg-muted sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var exec in _executives)
            {
                <div class="relative bg-card p-5"
                     tabindex="0"
                     @onmouseenter="@(() => _hoveredId = exec.Id)"
                     @onmouseleave="@(() => _hoveredId = null)"
                     @onfocus="@(() => _hoveredId = exec.Id)"
                     @onblur="@(() => _hoveredId = null)">

                    <div class="flex items-start gap-3">
                        <AvatarCn Class="size-10 shrink-0">
                            <AvatarFallbackCn Class="bg-muted text-xs">@exec.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <h3 class="text-sm font-medium">@exec.Name</h3>
                            <p class="text-xs text-muted-foreground">@exec.Title</p>
                        </div>
                    </div>

                    <p class="mt-3 text-xs text-muted-foreground leading-relaxed">@exec.Bio</p>

                    <div class="mt-3 flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px]">
                            @exec.Tenure
                        </BadgeCn>
                        <span class="text-[10px] text-muted-foreground">@exec.PreviousRole</span>
                    </div>

                    @* Hover-reveal quote *@
                    <div class="@Cn.Merge("mt-3 overflow-hidden transition-all duration-200", _hoveredId == exec.Id ? "max-h-20 opacity-100" : "max-h-0 opacity-0")">
                        <SeparatorCn Class="mb-3" />
                        <p class="text-xs text-muted-foreground italic leading-relaxed">
                            &ldquo;@exec.Quote&rdquo;
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _hoveredId = null;

    private record Executive(string Id, string Name, string Title, string Initials, string Bio, string Tenure, string Quote, string PreviousRole);

    private static readonly Executive[] _executives =
    [
        new("jennifer-martinez", "Jennifer Martinez", "Chief Executive Officer", "JM",
            "Led product at Salesforce for 8 years before joining as CEO in 2022. Under her leadership, the company grew from 120 to 500+ employees across 12 countries.",
            "4 years", "Great products come from teams that argue well and ship fast.", "VP of Engineering, Adobe"),
        new("michael-chang", "Michael Chang", "Chief Technology Officer", "MC",
            "Former Distinguished Engineer at Google where he architected Cloud Run. Holds a PhD in distributed systems from MIT. Published 40+ papers on fault-tolerant systems.",
            "3 years", "Simplicity is the ultimate sophistication in system design.", "Distinguished Engineer, Google"),
        new("rachel-foster", "Rachel Foster", "Chief Financial Officer", "RF",
            "15 years of financial leadership at Morgan Stanley and Goldman Sachs. Led the Series C round of $120M and established the financial infrastructure for global expansion.",
            "3 years", "Disciplined growth beats hypergrowth every time.", "VP of Finance, Goldman Sachs"),
        new("david-thompson", "David Thompson", "Chief Operating Officer", "DT",
            "Spent 10 years scaling operations at Amazon across AWS and retail. Oversees global operations, customer success, and business development. MBA from Harvard Business School.",
            "2 years", "Operations should be invisible to customers and engineers alike.", "Director of Operations, AWS"),
        new("sarah-okonkwo", "Sarah Okonkwo", "Chief People Officer", "SO",
            "Built people operations at Stripe during their growth from 200 to 8,000 employees. Pioneered the remote-first compensation framework adopted industry-wide.",
            "2 years", "Culture is not what you say — it is what you tolerate.", "Head of People, Stripe"),
        new("alex-novak", "Alex Novak", "Chief Revenue Officer", "AN",
            "Scaled revenue at Datadog from $50M to $500M ARR. Built the PLG-to-enterprise motion that now drives 70% of new revenue. Former McKinsey engagement manager.",
            "1 year", "The best sales motion is a product people cannot stop using.", "VP of Sales, Datadog"),
    ];
}
