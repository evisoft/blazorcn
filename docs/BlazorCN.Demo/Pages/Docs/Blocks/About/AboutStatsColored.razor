@* ============================================================
   Block: about-stats-colored
   Title: About Stats Colored
   Description: About section with centered stats in colored boxes
   Long Description: About section with bold statement and signature style
   Dependencies: BadgeCn
   Source: original/blocks/about/about-stats-colored.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <div class="text-center">
                <BadgeCn Class="mb-3" Variant="BadgeVariant.Secondary">
                    By the Numbers
                </BadgeCn>

                <h2 class="mb-2 text-xl font-semibold tracking-tight">
                    Enterprise-grade reliability
                </h2>

                <p class="text-sm text-muted-foreground">
                    We don't just promise performance—we guarantee it.
                </p>
            </div>
        </div>

        <div class="p-6">
            <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
                @foreach (var stat in _stats)
                {
                    <div class="rounded-md bg-muted/50 p-4 text-center">
                        <p class="text-2xl font-semibold tabular-nums">@stat.Value</p>
                        <p class="mt-1 text-xs text-muted-foreground">@stat.Label</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Value, string Label);

    private readonly List<StatItem> _stats =
    [
        new("99.9%", "Uptime SLA"),
        new("150ms", "Avg response"),
        new("50M+", "API calls/day"),
        new("24/7", "Support"),
    ];
}
