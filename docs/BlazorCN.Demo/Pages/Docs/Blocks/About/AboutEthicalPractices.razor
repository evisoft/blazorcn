@* ============================================================
   Block: about-ethical-practices
   Title: About Ethical Practices
   Description: A showcase of ethical business commitments including fair wages, sustainable sourcing, data ethics, and diversity targets with progress indicators.
   Long Description: Build trust through ethical transparency. This about block displays business ethics commitments with status indicators, covering fair labor, sustainability, data privacy, and diversity goals.
   Dependencies: None
   Source: original/blocks/about/about-ethical-practices.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Ethical Business Practices</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Our commitments to ethical operations and social responsibility
            </p>
        </div>
        <div class="grid gap-4 p-6 sm:grid-cols-2">
            @foreach (var practice in _practices)
            {
                var statusIcon = practice.Status switch
                {
                    "achieved" => "circle-check-big",
                    "in-progress" => "circle-dot",
                    _ => "circle-dashed",
                };
                var statusColor = practice.Status switch
                {
                    "achieved" => "text-emerald-600",
                    "in-progress" => "text-amber-600",
                    _ => "text-muted-foreground",
                };
                var badgeClass = practice.Status switch
                {
                    "achieved" => "bg-emerald-500/10 text-emerald-600",
                    "in-progress" => "bg-amber-500/10 text-amber-600",
                    _ => "bg-muted text-muted-foreground",
                };
                var statusLabel = practice.Status switch
                {
                    "achieved" => "Achieved",
                    "in-progress" => "In Progress",
                    _ => "Planned",
                };
                <div class="rounded-md border bg-muted/50 p-4">
                    <div class="flex items-start gap-3">
                        <div class="mt-0.5 shrink-0">
                            <LucideIconCn Name="@statusIcon" Size="20" Class="@($"size-5 {statusColor}")" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <h3 class="font-medium text-sm">@practice.Title</h3>
                                <span class="@($"rounded-md px-2 py-0.5 font-medium text-xs {badgeClass}")">
                                    @statusLabel
                                </span>
                            </div>
                            <p class="mt-1 text-muted-foreground text-sm">@practice.Description</p>
                            <p class="mt-2 font-medium text-muted-foreground text-xs">
                                Target: @practice.Target
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Practice(string Title, string Description, string Status, string Target);

    private readonly List<Practice> _practices =
    [
        new("Fair Living Wages", "All employees and contractors paid at or above local living wage standards", "achieved", "100% compliance globally"),
        new("Sustainable Supply Chain", "Carbon-neutral data centers and renewable energy for all infrastructure", "in-progress", "100% renewable by 2027"),
        new("Data Ethics & Privacy", "Zero data selling, minimal tracking, and transparent privacy policies", "achieved", "GDPR & CCPA compliant"),
        new("Anti-Corruption Standards", "Strict anti-bribery policies and transparent financial reporting", "achieved", "Zero tolerance policy"),
        new("Diversity & Representation", "Underrepresented groups in tech leadership and decision-making roles", "in-progress", "40% by end of 2026"),
        new("Ethical AI Development", "Bias testing, explainability standards, and human oversight for AI systems", "in-progress", "Full audit framework by Q3 2026"),
    ];
}
