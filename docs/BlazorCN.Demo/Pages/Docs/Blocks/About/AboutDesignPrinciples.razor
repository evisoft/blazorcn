@* ============================================================
   Block: about-design-principles
   Title: About Design Principles
   Description: Product design philosophy showcasing core design principles with explanations for each guiding belief.
   Long Description: Share your design philosophy. This block articulates your product design principles—the beliefs that guide every design decision. Perfect for design-focused companies, design systems, and products that want to communicate their UX philosophy.
   Dependencies: None
   Source: original/blocks/about/about-design-principles.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-5">
            <h2 class="font-semibold text-xl tracking-tight">Design Principles</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                The philosophy behind every design decision we make
            </p>
        </div>

        @* Introduction *@
        <div class="border-b px-6 py-5">
            <p class="text-sm leading-relaxed">
                These principles guide how we design, build, and evolve our product. They're not
                aspirational — they're the trade-offs we make every day.
            </p>
        </div>

        @* Principles List *@
        <div class="divide-y">
            @for (var i = 0; i < _principles.Count; i++)
            {
                var principle = _principles[i];
                <div class="px-6 py-5">
                    <div class="flex items-start gap-4">
                        <span class="font-mono text-muted-foreground text-xs">
                            @((i + 1).ToString("D2"))
                        </span>
                        <div class="min-w-0 flex-1 space-y-2">
                            <h3 class="font-semibold text-sm">@principle.Title</h3>
                            <p class="text-muted-foreground text-sm leading-relaxed">
                                @principle.Explanation
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t bg-muted/30 px-6 py-4">
            <p class="text-muted-foreground text-xs">
                These principles evolve as we learn. Last updated March 2026.
            </p>
        </div>
    </div>
</section>

@code {
    private record PrincipleItem(string Title, string Explanation);

    private readonly List<PrincipleItem> _principles =
    [
        new("Clarity over cleverness",
            "We choose straightforward solutions over clever ones. A simple button beats a magical gesture. Obvious wins over delightful when there's a trade-off. Users should never wonder how something works."),
        new("Speed over perfection",
            "Fast interfaces feel smarter. We optimize for perceived performance obsessively — instant feedback, optimistic updates, skeleton states. A good experience now beats a perfect one later."),
        new("Consistency builds trust",
            "Every button, every input, every pattern should feel familiar. Users shouldn't relearn the interface on each page. Predictability reduces cognitive load and builds confidence."),
        new("Content first, chrome second",
            "The UI exists to serve the content, not compete with it. We strip away anything that doesn't help users accomplish their goals. Decoration must justify its existence."),
        new("Accessible by default, not as an afterthought",
            "Accessibility isn't a feature or a compliance checkbox — it's foundational. Keyboard navigation, screen readers, color contrast, and focus states are considered from the first design mockup."),
        new("Opinionated, but escapable",
            "We have strong defaults that work for 90% of use cases, but we never lock users in. Advanced users can customize, override, or opt out. Opinions guide, they don't constrain."),
    ];
}
