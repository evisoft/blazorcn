@page "/examples/tasks"
@layout ExampleLayout

<div class="flex flex-col gap-6 p-6">
    <!-- Header -->
    <div>
        <h2 class="text-3xl font-bold tracking-tight">Tasks</h2>
        <p class="text-muted-foreground">Here&rsquo;s a list of your tasks for this month!</p>
    </div>

    <!-- Filter bar -->
    <div class="flex items-center gap-2">
        <InputCn Placeholder="Filter tasks..." Class="max-w-sm" Value="@_filter" ValueChanged="OnFilterChanged" />
        <DropdownMenuCn>
            <DropdownMenuTriggerCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">Status</ButtonCn>
            </DropdownMenuTriggerCn>
            <DropdownMenuContentCn>
                <DropdownMenuLabelCn>Filter by status</DropdownMenuLabelCn>
                <DropdownMenuSeparatorCn />
                <DropdownMenuItemCn>Todo</DropdownMenuItemCn>
                <DropdownMenuItemCn>In Progress</DropdownMenuItemCn>
                <DropdownMenuItemCn>Done</DropdownMenuItemCn>
                <DropdownMenuItemCn>Canceled</DropdownMenuItemCn>
                <DropdownMenuItemCn>Backlog</DropdownMenuItemCn>
            </DropdownMenuContentCn>
        </DropdownMenuCn>
        <DropdownMenuCn>
            <DropdownMenuTriggerCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">Priority</ButtonCn>
            </DropdownMenuTriggerCn>
            <DropdownMenuContentCn>
                <DropdownMenuLabelCn>Filter by priority</DropdownMenuLabelCn>
                <DropdownMenuSeparatorCn />
                <DropdownMenuItemCn>High</DropdownMenuItemCn>
                <DropdownMenuItemCn>Medium</DropdownMenuItemCn>
                <DropdownMenuItemCn>Low</DropdownMenuItemCn>
            </DropdownMenuContentCn>
        </DropdownMenuCn>
    </div>

    <!-- Data table -->
    <div class="rounded-md border">
        <TableCn>
            <TableHeaderCn>
                <TableRowCn>
                    <TableHeadCn Class="w-[100px]">Task</TableHeadCn>
                    <TableHeadCn>Title</TableHeadCn>
                    <TableHeadCn Class="w-[120px]">Status</TableHeadCn>
                    <TableHeadCn Class="w-[100px]">Priority</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var task in FilteredTasks)
                {
                    <TableRowCn>
                        <TableCellCn Class="font-medium">@task.Id</TableCellCn>
                        <TableCellCn Class="max-w-[400px] truncate">@task.Title</TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="@GetStatusVariant(task.Status)">@task.Status</BadgeCn>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="@GetPriorityVariant(task.Priority)">@task.Priority</BadgeCn>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>

    <!-- Count -->
    <div class="text-sm text-muted-foreground">
        Showing @FilteredTasks.Length of @MockData.Tasks.Length tasks.
    </div>
</div>

@code {
    private string _filter = "";

    private TaskItem[] FilteredTasks => string.IsNullOrWhiteSpace(_filter)
        ? MockData.Tasks
        : MockData.Tasks.Where(t =>
            t.Id.Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
            t.Title.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToArray();

    private void OnFilterChanged(string value)
    {
        _filter = value;
    }

    private static BadgeVariant GetStatusVariant(string status) => status switch
    {
        "Done" => BadgeVariant.Default,
        "In Progress" => BadgeVariant.Secondary,
        "Canceled" => BadgeVariant.Destructive,
        _ => BadgeVariant.Outline,
    };

    private static BadgeVariant GetPriorityVariant(string priority) => priority switch
    {
        "High" => BadgeVariant.Destructive,
        "Medium" => BadgeVariant.Secondary,
        "Low" => BadgeVariant.Outline,
        _ => BadgeVariant.Outline,
    };
}
