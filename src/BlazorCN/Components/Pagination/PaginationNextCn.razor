@namespace BlazorCN
@inherits ComponentBaseCn
<PaginationLinkCn Href="@Href"
                  Size="ButtonSize.Default"
                  Class="@Cn.Merge("cn-pagination-next", Class)"
                  Style="@Style"
                  aria-label="Go to next page"
                  @attributes="AdditionalAttributes">
    <span class="hidden sm:block">@Text</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-rtl-flip" data-icon="inline-end"><path d="m9 18 6-6-6-6"/></svg>
</PaginationLinkCn>
@code {
    [Parameter] public string? Href { get; set; }
    [Parameter] public string Text { get; set; } = "Next";
}
