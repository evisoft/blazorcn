@namespace BlazorCN
@inherits ComponentBaseCn
<a class="@CssClass"
   style="@Style"
   href="@Href"
   aria-current="@(IsActive ? "page" : null)"
   data-slot="pagination-link"
   data-active="@(IsActive ? "true" : null)"
   data-variant="@(IsActive ? "outline" : "ghost")"
   data-size="@SizeData"
   @attributes="AdditionalAttributes">
    @ChildContent
</a>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Icon;

    private string SizeData => Size switch
    {
        ButtonSize.Default => "default",
        ButtonSize.Sm => "sm",
        ButtonSize.Lg => "lg",
        ButtonSize.Xs => "xs",
        ButtonSize.IconXs => "icon-xs",
        ButtonSize.IconSm => "icon-sm",
        ButtonSize.IconLg => "icon-lg",
        _ => "icon"
    };

    private string SizeClass => Size switch
    {
        ButtonSize.Default => "cn-button-size-default",
        ButtonSize.Sm => "cn-button-size-sm",
        ButtonSize.Lg => "cn-button-size-lg",
        ButtonSize.Xs => "cn-button-size-xs",
        ButtonSize.IconXs => "cn-button-size-icon-xs",
        ButtonSize.IconSm => "cn-button-size-icon-sm",
        ButtonSize.IconLg => "cn-button-size-icon-lg",
        _ => "cn-button-size-icon"
    };

    private string VariantClass => IsActive ? "cn-button-variant-outline" : "cn-button-variant-ghost";

    private string CssClass => Cn.Merge(
        "cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
        IsActive ? "border bg-background" : "",
        VariantClass,
        SizeClass,
        Class);
}
