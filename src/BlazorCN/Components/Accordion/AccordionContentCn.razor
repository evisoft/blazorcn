@namespace BlazorCN
@inherits ComponentBaseCn

@if (Item?.IsOpen == true)
{
    <div class="@Cn.Merge("overflow-hidden text-sm transition-all", Class)"
         style="@Style"
         role="region"
         data-slot="accordion-content"
         data-state="open"
         @attributes="AdditionalAttributes">
        <div class="pb-4 pt-0">
            @ChildContent
        </div>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private AccordionItemCn? Item { get; set; }
}
