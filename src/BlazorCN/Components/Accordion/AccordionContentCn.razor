@namespace BlazorCN
@inherits ComponentBaseCn

@if (Item?.IsOpen == true)
{
    <div class="@Cn.Merge("cn-accordion-content overflow-hidden transition-all", Class)"
         style="@Style"
         role="region"
         id="@(Item?.PanelId)"
         aria-labelledby="@(Item?.TriggerId)"
         data-slot="accordion-content"
         data-state="open"
         @attributes="AdditionalAttributes">
        <div class="cn-accordion-content-inner">
            @ChildContent
        </div>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private AccordionItemCn? Item { get; set; }
}
