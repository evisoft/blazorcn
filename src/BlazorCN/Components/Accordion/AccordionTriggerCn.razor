@namespace BlazorCN
@inherits ComponentBaseCn

<h3 class="flex" data-slot="accordion-trigger-wrapper">
    <button @ref="_buttonRef"
            class="@Cn.Merge("cn-accordion-trigger group/accordion-trigger flex flex-1 items-start justify-between outline-none transition-all disabled:pointer-events-none disabled:opacity-50", Class)"
            style="@Style"
            type="button"
            id="@(Item?.TriggerId)"
            data-slot="accordion-trigger"
            data-state="@(Item?.IsOpen == true ? "open" : "closed")"
            aria-expanded="@(Item?.IsOpen == true ? "true" : "false")"
            aria-controls="@(Item?.PanelId)"
            disabled="@(Item?.Disabled == true)"
            @onclick="HandleClick"
            @onkeydown="HandleKeyDown"
            @attributes="AdditionalAttributes">
        @ChildContent
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-slot="accordion-trigger-icon" class="pointer-events-none shrink-0 group-aria-expanded/accordion-trigger:hidden" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-slot="accordion-trigger-icon" class="pointer-events-none hidden shrink-0 group-aria-expanded/accordion-trigger:inline" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
    </button>
</h3>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private AccordionItemCn? Item { get; set; }

    private ElementReference _buttonRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (Item is not null)
            Item.TriggerElement = _buttonRef;
    }

    private void HandleClick() => Item?.Toggle();

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (Item?.Accordion is null) return;
        if (e.Key is "ArrowDown" or "ArrowUp" or "Home" or "End")
            await Item.Accordion.MoveFocusAsync(Item, e.Key);
    }
}
