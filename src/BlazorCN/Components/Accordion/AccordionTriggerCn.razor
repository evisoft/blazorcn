@namespace BlazorCN
@inherits ComponentBaseCn

<h3 class="flex" data-slot="accordion-trigger-wrapper">
    <button class="@Cn.Merge("cn-accordion-trigger flex flex-1 items-start justify-between gap-4 outline-none transition-all disabled:pointer-events-none disabled:opacity-50 [&[data-state=open]>svg]:rotate-180", Class)"
            style="@Style"
            type="button"
            id="@(Item?.TriggerId)"
            data-slot="accordion-trigger"
            data-state="@(Item?.IsOpen == true ? "open" : "closed")"
            aria-expanded="@(Item?.IsOpen == true ? "true" : "false")"
            disabled="@(Item?.Disabled == true)"
            @onclick="HandleClick"
            @attributes="AdditionalAttributes">
        @ChildContent
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 translate-y-0.5 text-muted-foreground transition-transform duration-200" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </button>
</h3>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private AccordionItemCn? Item { get; set; }

    private void HandleClick() => Item?.Toggle();
}
