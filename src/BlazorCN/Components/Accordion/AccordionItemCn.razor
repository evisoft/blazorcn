@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("border-b", Class)" style="@Style" data-slot="accordion-item" data-state="@(IsOpen ? "open" : "closed")" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool DefaultOpen { get; set; }

    internal bool IsOpen { get; private set; }

    protected override void OnInitialized() => IsOpen = DefaultOpen;

    internal void Toggle()
    {
        IsOpen = !IsOpen;
        StateHasChanged();
    }
}
