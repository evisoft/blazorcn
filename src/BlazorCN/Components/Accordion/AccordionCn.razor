@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable
<div @ref="_rootRef" class="@Cn.Merge("flex w-full flex-col", Class)" style="@Style" data-slot="accordion" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>When true, several items may be open at once. Default matches the
    /// shadcn reference: single-open — expanding an item collapses its siblings.</summary>
    [Parameter] public bool Multiple { get; set; }

    [Inject] private JsInteropCn JsInterop { get; set; } = default!;

    private ElementReference _rootRef;
    private readonly string _preventKeysId = $"accordion-nav-{Guid.NewGuid():N}";
    private bool _jsInitialized;

    private readonly List<AccordionItemCn> _items = new();

    internal void Register(AccordionItemCn item) => _items.Add(item);
    internal void Unregister(AccordionItemCn item) => _items.Remove(item);

    internal void NotifyOpened(AccordionItemCn opened)
    {
        if (Multiple) return;
        foreach (var item in _items)
        {
            if (!ReferenceEquals(item, opened) && item.IsOpen)
                item.Close();
        }
    }

    /// <summary>APG accordion keyboard support: ArrowDown/ArrowUp move focus between
    /// headers (wrapping), Home/End jump to first/last. Invoked from the trigger's
    /// @onkeydown, so arrows pressed inside panel content are never hijacked.</summary>
    internal async Task MoveFocusAsync(AccordionItemCn from, string key)
    {
        var index = _items.IndexOf(from);
        if (index < 0 || _items.Count == 0) return;

        switch (key)
        {
            case "ArrowDown":
                await FocusFirstEnabledAsync(Enumerable.Range(1, _items.Count - 1)
                    .Select(offset => (index + offset) % _items.Count));
                break;
            case "ArrowUp":
                await FocusFirstEnabledAsync(Enumerable.Range(1, _items.Count - 1)
                    .Select(offset => (index - offset + _items.Count) % _items.Count));
                break;
            case "Home":
                await FocusFirstEnabledAsync(Enumerable.Range(0, _items.Count));
                break;
            case "End":
                await FocusFirstEnabledAsync(Enumerable.Range(0, _items.Count).Reverse());
                break;
        }
    }

    private async Task FocusFirstEnabledAsync(IEnumerable<int> indices)
    {
        foreach (var i in indices)
        {
            if (!_items[i].Disabled)
            {
                await _items[i].FocusTriggerAsync();
                return;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Blazor's @onkeydown cannot conditionally preventDefault, so the keys
                // handled by MoveFocusAsync would also scroll the page; one root-level
                // guard swallows just their browser default, only on the triggers.
                await JsInterop.PreventKeyDefaultsAsync(_rootRef, _preventKeysId,
                    new[] { "ArrowDown", "ArrowUp", "Home", "End" },
                    "[data-slot=\"accordion-trigger\"]");
                _jsInitialized = true;
            }
            catch { /* Prerendering without JS — scroll suppression is progressive enhancement */ }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsInitialized)
        {
            try { await JsInterop.CleanupAsync(_preventKeysId); }
            catch { /* Circuit may already be gone */ }
        }
    }
}
