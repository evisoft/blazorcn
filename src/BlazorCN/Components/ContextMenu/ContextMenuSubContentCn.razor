@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

@if (Sub?.IsOpen == true)
{
    <div @ref="_contentRef"
         class="@Cn.Merge("z-50 min-w-[8rem] overflow-hidden rounded-md border bg-popover p-1 text-popover-foreground shadow-md", Class)"
         style="@Style"
         data-slot="context-menu-sub-content"
         data-state="open"
         data-side="@Side.ToString().ToLowerInvariant()"
         data-align="@Align.ToString().ToLowerInvariant()"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}
