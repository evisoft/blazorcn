@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

@if (ContextMenu?.IsOpen == true)
{
    <div @ref="_contentRef"
         class="@Cn.Merge("cn-context-menu-content z-50 overflow-hidden", Class)"
         style="@($"position:fixed;left:{ContextMenu.ClientX}px;top:{ContextMenu.ClientY}px;{Style}")"
         data-slot="context-menu-content"
         data-state="open"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}
