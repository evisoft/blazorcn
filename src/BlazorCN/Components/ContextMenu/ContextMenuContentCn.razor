@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

@if (ContextMenu?.IsOpen == true)
{
    <div @ref="_contentRef"
         class="@Cn.Merge("z-50 min-w-[8rem] overflow-hidden rounded-md border bg-popover p-1 text-popover-foreground shadow-md", Class)"
         style="@($"position:fixed;left:{ContextMenu.ClientX}px;top:{ContextMenu.ClientY}px;{Style}")"
         data-slot="context-menu-content"
         data-state="open"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}
