@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("select-none", Class)"
     style="@Style"
     data-slot="context-menu-trigger"
     @oncontextmenu="HandleContextMenu"
     @oncontextmenu:preventDefault="true"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public ContextMenuCn? ContextMenu { get; set; }

    private async Task HandleContextMenu(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        if (ContextMenu is not null)
        {
            await ContextMenu.OpenAtPosition(e.ClientX, e.ClientY);
        }
    }
}
