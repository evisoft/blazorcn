@namespace BlazorCN
@inherits ComponentBaseCn

<div @ref="_triggerRef"
     class="@CssClass"
     style="@Style"
     data-slot="context-menu-sub-trigger"
     data-menu-item
     data-state="@(Sub?.IsOpen == true ? "open" : "closed")"
     tabindex="-1"
     @onclick="Toggle"
     @attributes="AdditionalAttributes">
    @ChildContent
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-auto size-4"><path d="m9 18 6-6-6-6"/></svg>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Inset { get; set; }
    [CascadingParameter] public ContextMenuSubCn? Sub { get; set; }

    private ElementReference _triggerRef;

    private string CssClass => Cn.Merge(
        "flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none focus:bg-accent focus:text-accent-foreground",
        Inset ? "pl-8" : null,
        Class);

    protected override void OnAfterRender(bool firstRender)
    {
        if (Sub is not null) Sub.TriggerElement = _triggerRef;
    }

    private void Toggle()
    {
        Sub?.ToggleOpen();
    }
}
