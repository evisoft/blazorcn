@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("relative inline-block", Class)" style="@Style" data-slot="context-menu" data-state="@(IsOpen ? "open" : "closed")" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    internal bool IsOpen { get; private set; }
    internal double ClientX { get; private set; }
    internal double ClientY { get; private set; }

    protected override void OnInitialized() => IsOpen = Open;
    protected override void OnParametersSet() => IsOpen = Open;

    internal async Task SetOpen(bool open)
    {
        IsOpen = open;
        await OpenChanged.InvokeAsync(IsOpen);
        StateHasChanged();
    }

    internal async Task OpenAtPosition(double clientX, double clientY)
    {
        ClientX = clientX;
        ClientY = clientY;
        await SetOpen(true);
    }
}
