@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@CssClass"
     style="@Style"
     data-slot="context-menu-checkbox-item"
     data-menu-item
     data-disabled="@(Disabled ? "true" : null)"
     data-state="@(Checked ? "checked" : "unchecked")"
     role="menuitemcheckbox"
     aria-checked="@Checked.ToString().ToLowerInvariant()"
     tabindex="-1"
     @onclick="HandleClick"
     @attributes="AdditionalAttributes">
    <span class="pointer-events-none absolute left-2 flex size-3.5 items-center justify-center">
        @if (Checked)
        {
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M20 6 9 17l-5-5"/></svg>
        }
    </span>
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private string CssClass => Cn.Merge(
        "cn-context-menu-checkbox-item relative flex cursor-default select-none items-center pl-8 outline-hidden data-[disabled]:pointer-events-none data-[disabled]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
        Class);

    private async Task HandleClick()
    {
        if (Disabled) return;
        Checked = !Checked;
        await CheckedChanged.InvokeAsync(Checked);
        await OnClick.InvokeAsync();
    }
}
