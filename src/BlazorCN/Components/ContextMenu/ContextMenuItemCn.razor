@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@CssClass"
     style="@Style"
     data-slot="context-menu-item"
     data-menu-item
     data-disabled="@(Disabled ? "true" : null)"
     role="menuitem"
     tabindex="-1"
     @onclick="HandleClick"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public bool Inset { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string CssClass => Cn.Merge(
        "relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none transition-colors focus:bg-accent focus:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50",
        Variant == "destructive" ? "text-destructive focus:bg-destructive/10 focus:text-destructive" : null,
        Inset ? "pl-8" : null,
        Class);

    private async Task HandleClick()
    {
        if (!Disabled) await OnClick.InvokeAsync();
    }
}
