@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@CssClass"
     style="@Style"
     data-slot="context-menu-item"
     data-menu-item
     data-disabled="@(Disabled ? "true" : null)"
     data-variant="@(Variant != "default" ? Variant : null)"
     data-inset="@(Inset ? "" : null)"
     role="menuitem"
     aria-disabled="@(Disabled ? "true" : null)"
     tabindex="-1"
     @onclick="HandleClick"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public bool Inset { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    /// <summary>Whether activating the item closes the menu (Radix default). Set false to keep it open.</summary>
    [Parameter] public bool CloseOnSelect { get; set; } = true;
    [CascadingParameter] private ContextMenuCn? ContextMenu { get; set; }

    private string CssClass => Cn.Merge(
        "cn-context-menu-item relative flex cursor-default select-none items-center outline-hidden data-[disabled]:pointer-events-none data-[disabled]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
        Class);

    private async Task HandleClick()
    {
        if (Disabled) return;
        await OnClick.InvokeAsync();
        if (CloseOnSelect && ContextMenu is not null) await ContextMenu.SetOpen(false);
    }
}
