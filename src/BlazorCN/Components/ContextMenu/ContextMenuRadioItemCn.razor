@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@CssClass"
     style="@Style"
     data-slot="context-menu-radio-item"
     data-menu-item
     data-disabled="@(Disabled ? "true" : null)"
     data-state="@(IsSelected ? "checked" : "unchecked")"
     role="menuitemradio"
     aria-checked="@IsSelected.ToString().ToLowerInvariant()"
     tabindex="-1"
     @onclick="HandleClick"
     @attributes="AdditionalAttributes">
    <span class="cn-context-menu-item-indicator pointer-events-none flex items-center justify-center">
        @if (IsSelected)
        {
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M20 6 9 17l-5-5"/></svg>
        }
    </span>
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [CascadingParameter] private ContextMenuRadioGroupCn? RadioGroup { get; set; }

    private bool IsSelected => RadioGroup?.IsSelected(Value) ?? false;

    private string CssClass => Cn.Merge(
        "cn-context-menu-radio-item relative flex cursor-default select-none items-center outline-hidden data-[disabled]:pointer-events-none data-[disabled]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
        Class);

    private async Task HandleClick()
    {
        if (Disabled || RadioGroup is null) return;
        await RadioGroup.SelectValue(Value);
    }
}
