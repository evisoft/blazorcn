@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("cn-chart-tooltip-item", Color is not null ? "items-center" : null, Class)"
     style="@Style"
     data-slot="chart-tooltip-item"
     @attributes="AdditionalAttributes">
    @if (Color is not null)
    {
        <div class="h-2.5 w-2.5 shrink-0 rounded-[2px]" style="background-color: @Color"></div>
    }
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Series color for the dot indicator (reference indicator="dot").
    /// Omit it and place an svg icon in ChildContent for an icon indicator.</summary>
    [Parameter] public string? Color { get; set; }
}
