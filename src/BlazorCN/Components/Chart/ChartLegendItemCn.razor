@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("cn-chart-legend-item", Class)"
     style="@Style"
     data-slot="chart-legend-item"
     @attributes="AdditionalAttributes">
    @if (Color is not null)
    {
        <div class="h-2 w-2 shrink-0 rounded-[2px]" style="background-color: @Color"></div>
    }
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Series color for the swatch. Omit it and place an svg icon in
    /// ChildContent instead to get the reference's icon legend ([&gt;svg] sizing).</summary>
    [Parameter] public string? Color { get; set; }
}
