@namespace BlazorCN
@inherits ComponentBaseCn

<button @ref="_triggerRef"
        type="button"
        class="@Cn.Merge("cn-navigation-menu-trigger group inline-flex h-9 w-max items-center justify-center outline-none disabled:pointer-events-none", Class)"
        style="@Style"
        data-slot="navigation-menu-trigger"
        data-state="@(NavItem?.IsOpen == true ? "open" : "closed")"
        aria-expanded="@(NavItem?.IsOpen == true ? "true" : "false")"
        @onclick="HandleClick"
        @onkeydown="HandleTriggerKeyDown"
        @attributes="AdditionalAttributes">
    @ChildContent
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="relative top-px ml-1 size-3 transition-transform duration-200 group-data-[state=open]:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public NavigationMenuItemCn? NavItem { get; set; }

    private ElementReference _triggerRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (NavItem is not null) NavItem.TriggerElement = _triggerRef;
    }

    private async Task HandleClick()
    {
        if (NavItem is not null)
        {
            if (NavItem.IsOpen)
                await NavItem.RequestClose();
            else
                await NavItem.RequestOpen();
        }
    }

    private void HandleTriggerKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        // WCAG 1.4.13 / APG: Escape dismisses the open panel while the trigger has focus.
        if (e.Key == "Escape") NavItem?.CloseNow();
    }
}
