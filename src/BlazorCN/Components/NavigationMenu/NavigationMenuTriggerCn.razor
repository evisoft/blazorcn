@namespace BlazorCN
@inherits ComponentBaseCn

<button @ref="_triggerRef"
        type="button"
        class="@Cn.Merge("group inline-flex h-9 w-max items-center justify-center rounded-md bg-background px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground focus:outline-none disabled:pointer-events-none disabled:opacity-50 data-[state=open]:bg-accent/50", Class)"
        style="@Style"
        data-slot="navigation-menu-trigger"
        data-state="@(NavItem?.IsOpen == true ? "open" : "closed")"
        @onclick="HandleClick"
        @attributes="AdditionalAttributes">
    @ChildContent
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="relative top-px ml-1 size-3 transition-transform duration-200 group-data-[state=open]:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public NavigationMenuItemCn? NavItem { get; set; }

    private ElementReference _triggerRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (NavItem is not null) NavItem.TriggerElement = _triggerRef;
    }

    private async Task HandleClick()
    {
        if (NavItem is not null)
        {
            if (NavItem.IsOpen)
                await NavItem.RequestClose();
            else
                await NavItem.RequestOpen();
        }
    }
}
