@namespace BlazorCN
@inherits ComponentBaseCn

<nav class="@Cn.Merge("cn-navigation-menu group/navigation-menu relative flex flex-1 items-center justify-center", Class)" style="@Style" data-slot="navigation-menu" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</nav>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
