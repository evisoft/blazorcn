@namespace BlazorCN
@inherits ComponentBaseCn
@implements IDisposable

<li class="@Cn.Merge("relative", Class)"
    style="@Style"
    data-slot="navigation-menu-item"
    data-state="@(IsOpen ? "open" : "closed")"
    @onmouseenter="HandleMouseEnter"
    @onmouseleave="HandleMouseLeave"
    @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</li>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int OpenDelay { get; set; } = 100;
    [Parameter] public int CloseDelay { get; set; } = 150;

    internal bool IsOpen { get; private set; }
    internal ElementReference TriggerElement { get; set; }

    private CancellationTokenSource? _openCts;
    private CancellationTokenSource? _closeCts;

    internal async Task RequestOpen()
    {
        _closeCts?.Cancel();
        _closeCts = null;

        if (IsOpen) return;

        _openCts?.Cancel();
        _openCts = new CancellationTokenSource();
        var token = _openCts.Token;

        try
        {
            await Task.Delay(OpenDelay, token);
            if (!token.IsCancellationRequested)
            {
                IsOpen = true;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

    internal async Task RequestClose()
    {
        _openCts?.Cancel();
        _openCts = null;

        if (!IsOpen) return;

        _closeCts?.Cancel();
        _closeCts = new CancellationTokenSource();
        var token = _closeCts.Token;

        try
        {
            await Task.Delay(CloseDelay, token);
            if (!token.IsCancellationRequested)
            {
                IsOpen = false;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

    internal void CancelClose()
    {
        _closeCts?.Cancel();
        _closeCts = null;
    }

    private async Task HandleMouseEnter()
    {
        await RequestOpen();
    }

    private async Task HandleMouseLeave()
    {
        await RequestClose();
    }

    public void Dispose()
    {
        _openCts?.Cancel();
        _openCts?.Dispose();
        _closeCts?.Cancel();
        _closeCts?.Dispose();
    }
}
