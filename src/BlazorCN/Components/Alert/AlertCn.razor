@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@CssClass" style="@Style" role="alert" data-slot="alert" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public AlertVariant Variant { get; set; } = AlertVariant.Default;

    private static readonly Cva<AlertVariant> Variants = new(
        "cn-alert group/alert w-full items-start",
        new()
        {
            [AlertVariant.Default] = "cn-alert-variant-default",
            [AlertVariant.Destructive] = "cn-alert-variant-destructive",
        });

    private string CssClass => Variants.Apply(Variant, Class);
}
