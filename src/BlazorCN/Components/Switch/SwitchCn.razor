@namespace BlazorCN
@inherits ComponentBaseCn

<button type="button"
        role="switch"
        aria-checked="@Checked.ToString().ToLowerInvariant()"
        data-slot="switch"
        data-size="@SizeValue"
        data-state="@(Checked ? "checked" : "unchecked")"
        class="@CssClass"
        style="@Style"
        disabled="@Disabled"
        @onclick="HandleClick"
        @attributes="AdditionalAttributes">
    <span class="@ThumbClass" data-slot="switch-thumb" data-state="@(Checked ? "checked" : "unchecked")"></span>
</button>

@code {
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public SwitchSize Size { get; set; } = SwitchSize.Default;

    private string SizeValue => Size == SwitchSize.Sm ? "sm" : "default";

    private string CssClass => Cn.Merge(
        "cn-switch peer group/switch relative inline-flex items-center transition-all outline-none disabled:cursor-not-allowed disabled:opacity-50",
        Class);

    private string ThumbClass => "cn-switch-thumb pointer-events-none block ring-0 transition-transform";

    private async Task HandleClick()
    {
        if (Disabled) return;
        Checked = !Checked;
        await CheckedChanged.InvokeAsync(Checked);
    }
}
