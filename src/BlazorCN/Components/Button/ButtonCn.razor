@namespace BlazorCN
@inherits ComponentBaseCn

@if (!string.IsNullOrEmpty(Href))
{
    <a href="@(Disabled ? null : Href)"
       class="@AnchorCssClass"
       style="@Style"
       aria-disabled="@(Disabled ? "true" : null)"
       tabindex="@(Disabled ? "-1" : null)"
       data-slot="button"
       data-variant="@Variant.ToString().ToLowerInvariant()"
       data-size="@Size.ToString().ToLowerInvariant()"
       @attributes="AdditionalAttributes">
        @ChildContent
    </a>
}
else
{
    <button class="@CssClass"
            style="@Style"
            type="@Type"
            disabled="@Disabled"
            data-slot="button"
            data-variant="@Variant.ToString().ToLowerInvariant()"
            data-size="@Size.ToString().ToLowerInvariant()"
            @attributes="AdditionalAttributes"
            @onclick="OnClick">
        @ChildContent
    </button>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Default;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Default;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? Href { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private static readonly Cva<ButtonVariant, ButtonSize> Variants = new(
        "cn-button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
        new()
        {
            [ButtonVariant.Default] = "cn-button-variant-default",
            [ButtonVariant.Destructive] = "cn-button-variant-destructive",
            [ButtonVariant.Outline] = "cn-button-variant-outline",
            [ButtonVariant.Secondary] = "cn-button-variant-secondary",
            [ButtonVariant.Ghost] = "cn-button-variant-ghost",
            [ButtonVariant.Link] = "cn-button-variant-link",
        },
        new()
        {
            [ButtonSize.Default] = "cn-button-size-default",
            [ButtonSize.Xs] = "cn-button-size-xs",
            [ButtonSize.Sm] = "cn-button-size-sm",
            [ButtonSize.Lg] = "cn-button-size-lg",
            [ButtonSize.Icon] = "cn-button-size-icon",
            [ButtonSize.IconXs] = "cn-button-size-icon-xs",
            [ButtonSize.IconSm] = "cn-button-size-icon-sm",
            [ButtonSize.IconLg] = "cn-button-size-icon-lg",
        });

    private string CssClass => Variants.Apply(Variant, Size, Class);
    private string AnchorCssClass => Disabled
        ? Cn.Merge(Variants.Apply(Variant, Size, Class), "pointer-events-none opacity-50")
        : CssClass;
}
