@namespace BlazorCN
@inherits ComponentBaseCn

@if (Sheet?.IsOpen == true)
{
    <div class="@Cn.Merge("fixed inset-0 z-50 bg-black/50", Class)"
         style="@Style"
         data-slot="sheet-overlay"
         data-state="open"
         @onclick="HandleClick"
         @attributes="AdditionalAttributes">
    </div>
}

@code {
    [CascadingParameter] private SheetCn? Sheet { get; set; }

    private async Task HandleClick()
    {
        if (Sheet is not null) await Sheet.SetOpen(false);
    }
}
