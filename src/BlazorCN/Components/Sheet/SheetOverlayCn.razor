@namespace BlazorCN
@inherits ComponentBaseCn

@if (Sheet?.IsOpen == true)
{
    <div class="@Cn.Merge("cn-sheet-overlay fixed inset-0 z-50 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=closed]:animate-out data-[state=closed]:fade-out-0", Class)"
         style="@Style"
         data-slot="sheet-overlay"
         data-state="open"
         @onclick="HandleClick"
         @attributes="AdditionalAttributes">
    </div>
}

@code {
    [CascadingParameter] private SheetCn? Sheet { get; set; }

    private async Task HandleClick()
    {
        if (Sheet is not null) await Sheet.SetOpen(false);
    }
}
