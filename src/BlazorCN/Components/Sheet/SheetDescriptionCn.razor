@namespace BlazorCN
@inherits ComponentBaseCn

<p id="@(DescriptionLink?.Id)" class="@Cn.Merge("cn-sheet-description", Class)" style="@Style" data-slot="sheet-description" @attributes="AdditionalAttributes">
    @ChildContent
</p>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter(Name = "ContentDescriptionLink")] private TitleLink? DescriptionLink { get; set; }

    protected override void OnInitialized()
    {
        if (DescriptionLink is not null) DescriptionLink.IsLinked = true;
    }
}
