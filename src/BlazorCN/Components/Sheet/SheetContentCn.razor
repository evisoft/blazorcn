@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

@if (Sheet?.IsOpen == true)
{
    <div @ref="_element"
         class="@Cn.Merge(GetClasses(), Class)"
         style="@Style"
         data-slot="sheet-content"
         data-state="open"
         data-side="@Side.ToString().ToLowerInvariant()"
         role="dialog"
         aria-modal="true"
         aria-labelledby="@(_titleLink.IsLinked ? _titleLink.Id : null)"
         aria-label="@(!_titleLink.IsLinked ? "Sheet" : null)"
         tabindex="-1"
         @onkeydown="HandleKeyDown"
         @attributes="AdditionalAttributes">
        <CascadingValue Value="@_titleLink" Name="ContentTitleLink" IsFixed="true">
            @ChildContent
        </CascadingValue>
        <button type="button"
                class="cn-sheet-close rounded-xs opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:ring-2 focus:ring-ring focus:ring-offset-2 focus:outline-hidden disabled:pointer-events-none"
                data-slot="sheet-close"
                @onclick="HandleClose">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
            </svg>
            <span class="sr-only">Close</span>
        </button>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public SheetSide Side { get; set; } = SheetSide.Right;
    [CascadingParameter] private SheetCn? Sheet { get; set; }
    [Inject] private JsInteropCn JsInterop { get; set; } = default!;

    private ElementReference _element;
    private string _id = $"sheet-content-{Guid.NewGuid():N}";
    private TitleLink _titleLink = new($"sheet-title-{Guid.NewGuid():N}");
    private bool _titleLinked;
    private bool _jsInitialized;

    private string GetClasses()
    {
        var sideAnimations = Side switch
        {
            SheetSide.Top => "data-[state=open]:slide-in-from-top data-[state=closed]:slide-out-to-top",
            SheetSide.Right => "data-[state=open]:slide-in-from-right data-[state=closed]:slide-out-to-right",
            SheetSide.Bottom => "data-[state=open]:slide-in-from-bottom data-[state=closed]:slide-out-to-bottom",
            SheetSide.Left => "data-[state=open]:slide-in-from-left data-[state=closed]:slide-out-to-left",
            _ => ""
        };
        return $"cn-sheet-content data-[state=open]:animate-in data-[state=open]:duration-500 data-[state=closed]:animate-out data-[state=closed]:duration-300 {sideAnimations}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_titleLink.IsLinked && !_titleLinked)
        {
            _titleLinked = true;
            StateHasChanged();
            return;
        }

        if (Sheet?.IsOpen == true && !_jsInitialized)
        {
            _jsInitialized = true;
            try
            {
                await JsInterop.TrapFocusAsync(_element, _id);
                await JsInterop.LockScrollAsync(_id);
            }
            catch
            {
                _jsInitialized = false;
            }
        }
        else if (Sheet?.IsOpen != true && _jsInitialized)
        {
            _jsInitialized = false;
            try { await JsInterop.CleanupAsync(_id); } catch { }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && Sheet is not null)
        {
            await Sheet.SetOpen(false);
        }
    }

    private async Task HandleClose()
    {
        if (Sheet is not null) await Sheet.SetOpen(false);
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsInitialized)
        {
            _jsInitialized = false;
            try { await JsInterop.CleanupAsync(_id); } catch { }
        }
    }
}
