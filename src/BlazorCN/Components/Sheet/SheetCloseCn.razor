@namespace BlazorCN
@inherits ComponentBaseCn

<button class="@Class" style="@Style" type="button" data-slot="sheet-close" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private SheetCn? Sheet { get; set; }

    private async Task HandleClick()
    {
        if (Sheet is not null) await Sheet.SetOpen(false);
    }
}
