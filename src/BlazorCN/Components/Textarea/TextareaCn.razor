@namespace BlazorCN
@inherits ComponentBaseCn

@* Value is bound via the `value` attribute (which Blazor applies as the .value property), NOT as child
   content. A textarea's child content is only its DEFAULT value: once the user types, the HTML "dirty value
   flag" is set and changing the child text no longer updates what's shown — so a programmatic reset (e.g.
   clearing a chat composer after send) would silently fail to clear. Binding `value` reflects resets reliably. *@
<textarea class="@CssClass"
          style="@Style"
          placeholder="@Placeholder"
          disabled="@Disabled"
          data-slot="textarea"
          value="@Value"
          @oninput="HandleInput"
          @attributes="AdditionalAttributes"></textarea>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private static readonly string BaseClasses =
        "cn-textarea flex field-sizing-content min-h-16 w-full outline-none placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50";

    private string CssClass => Cn.Merge(BaseClasses, Class);

    private async Task HandleInput(ChangeEventArgs e)
    {
        await ValueChanged.InvokeAsync(e.Value?.ToString());
    }
}
