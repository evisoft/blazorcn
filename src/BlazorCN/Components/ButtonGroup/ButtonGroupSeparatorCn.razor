@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@CssClass"
     style="@Style"
     role="separator"
     aria-orientation="@Orientation.ToString().ToLowerInvariant()"
     data-slot="button-group-separator"
     data-orientation="@Orientation.ToString().ToLowerInvariant()"
     @attributes="AdditionalAttributes">
</div>

@code {
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Vertical;

    private string CssClass => Cn.Merge(
        "cn-button-group-separator shrink-0",
        Orientation == Orientation.Horizontal ? "h-px w-full" : "h-full w-px",
        "relative self-stretch data-[orientation=horizontal]:mx-px data-[orientation=horizontal]:w-auto data-[orientation=vertical]:my-px data-[orientation=vertical]:h-auto",
        Class);
}
