@namespace BlazorCN
@inherits ComponentBaseCn

@* Shown only when a non-empty search matches zero items (Base UI Empty behavior).
   The nova cn-combobox-empty rule also drives visibility via the content group's
   data-empty attribute; the hidden toggle covers non-CSS contexts the same way
   CommandEmptyCn does. py-6 (over nova's py-2) preserves this component's original spacing. *@
<div class="@Cn.Merge("cn-combobox-empty py-6 text-center text-sm", IsShown ? null : "hidden", Class)" style="@Style" data-slot="combobox-empty" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public ComboboxCn? Combobox { get; set; }

    private bool IsShown => Combobox is null || Combobox.IsEmpty;
}
