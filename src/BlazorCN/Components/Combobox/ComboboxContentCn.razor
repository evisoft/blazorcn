@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

@if (Combobox?.IsOpen == true)
{
    <div @ref="_contentRef"
         class="@Cn.Merge("cn-combobox-content z-50 w-(--anchor-width) max-w-(--available-width) min-w-[calc(var(--anchor-width)+--spacing(7))] origin-(--transform-origin) p-1", Class)"
         style="@Style"
         role="listbox"
         aria-label="Suggestions"
         data-slot="combobox-content"
         data-state="open"
         data-side="@Side.ToString().ToLowerInvariant()"
         data-align="@Align.ToString().ToLowerInvariant()"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}
