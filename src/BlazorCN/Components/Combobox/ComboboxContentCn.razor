@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

@if (Combobox?.IsOpen == true)
{
    <div @ref="_contentRef"
         id="@Combobox.ContentId"
         class="@Cn.Merge("cn-combobox-content group/combobox-content z-50 w-(--anchor-width) max-w-(--available-width) max-h-(--available-height) min-w-[calc(var(--anchor-width)+--spacing(7))] origin-(--transform-origin) p-1", Class)"
         style="@Style"
         role="listbox"
         aria-label="@AriaLabel"
         aria-labelledby="@(AriaLabel is null ? Combobox.TriggerId : null)"
         aria-multiselectable="@(Combobox.Multiple ? "true" : null)"
         data-slot="combobox-content"
         data-state="open"
         data-empty="@(Combobox.IsEmpty ? "" : null)"
         data-side="@Side.ToString().ToLowerInvariant()"
         data-align="@Align.ToString().ToLowerInvariant()"
         @onkeydown="HandleKeyDown"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}
