@namespace BlazorCN
@inherits ComponentBaseCn

@* Reference combobox.tsx ComboboxClear: ghost icon-xs InputGroupButton with data-slot="combobox-clear".
   A real <button> rendered as a SIBLING of ComboboxTriggerCn's button (never nested inside it),
   so it gets native Enter/Space activation. Like Base UI's Clear primitive, it only renders
   while a value is selected. *@
@if (HasSelection)
{
    <button type="button"
            aria-label="Clear selection"
            class="@Cn.Merge("cn-combobox-clear cn-button cn-button-variant-ghost cn-button-size-default cn-input-group-button cn-input-group-button-size-icon-xs group/button flex shrink-0 cursor-pointer items-center justify-center whitespace-nowrap shadow-none transition-all outline-none select-none [&_svg]:pointer-events-none [&_svg]:shrink-0", Class)"
            style="@Style"
            data-slot="combobox-clear"
            data-size="icon-xs"
            @onclick="HandleClear"
            @onclick:stopPropagation="true"
            @attributes="AdditionalAttributes">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-combobox-clear-icon pointer-events-none" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
}

@code {
    [CascadingParameter] public ComboboxCn? Combobox { get; set; }

    private bool HasSelection => Combobox is not null &&
        (Combobox.Multiple ? Combobox.SelectedItems.Count > 0 : Combobox.SelectedValue is not null);

    private async Task HandleClear()
    {
        if (Combobox is not null)
        {
            await Combobox.ClearSelection();
            // The clear button unmounts once the selection is gone — hand focus
            // back to the trigger so keyboard users keep their place.
            await Combobox.FocusTriggerAsync();
        }
    }
}
