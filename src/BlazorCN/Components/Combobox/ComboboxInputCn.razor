@namespace BlazorCN
@inherits ComponentBaseCn

<div class="flex items-center border-b px-3">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 size-4 shrink-0 opacity-50"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <input type="text"
           class="@Cn.Merge("flex h-9 w-full rounded-md bg-transparent px-3 py-2 text-sm outline-none placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50", Class)"
           style="@Style"
           data-slot="combobox-input"
           placeholder="@Placeholder"
           value="@SearchValue"
           @oninput="HandleInput"
           @attributes="AdditionalAttributes" />
</div>

@code {
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? SearchValue { get; set; }
    [Parameter] public EventCallback<string> SearchValueChanged { get; set; }

    private async Task HandleInput(ChangeEventArgs e)
    {
        SearchValue = e.Value?.ToString() ?? "";
        await SearchValueChanged.InvokeAsync(SearchValue);
    }
}
