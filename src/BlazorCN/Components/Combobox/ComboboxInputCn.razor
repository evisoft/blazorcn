@namespace BlazorCN
@inherits ComponentBaseCn

@* Mirrors reference combobox.tsx ComboboxInput: an InputGroup (data-slot="input-group") so the
   .cn-combobox-content *:data-[slot=input-group] inset styling (m-1/mb-0/h-8/shadow-none/bg-input/30)
   applies. Class="cn-input" on the inner input restores the Input component classes the reference
   composes via <InputGroupInput> (which wraps Input). No trigger/clear addon buttons are rendered:
   this component is only used inside the popup, matching the reference's
   <ComboboxInput showTrigger={false} /> usage (empty inline-end addon included, as the reference renders it). *@
<InputGroupCn Class="@Cn.Merge("cn-combobox-input w-auto", Class)" Style="@Style">
    <InputGroupInputCn Class="cn-input"
                       Placeholder="@Placeholder"
                       Value="@SearchValue"
                       ValueChanged="HandleValueChanged"
                       data-slot="combobox-input"
                       @attributes="AdditionalAttributes" />
    <InputGroupAddonCn Align="InputGroupAddonAlign.InlineEnd" />
    @ChildContent
</InputGroupCn>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? SearchValue { get; set; }
    [Parameter] public EventCallback<string> SearchValueChanged { get; set; }

    private async Task HandleValueChanged(string value)
    {
        SearchValue = value;
        await SearchValueChanged.InvokeAsync(value);
    }
}
