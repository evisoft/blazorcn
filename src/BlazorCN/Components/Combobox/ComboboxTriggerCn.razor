@namespace BlazorCN
@inherits ComponentBaseCn

<button @ref="_triggerRef"
        type="button"
        id="@Combobox?.TriggerId"
        class="@Cn.Merge("cn-combobox-trigger flex h-9 w-full items-center justify-between whitespace-nowrap rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm ring-offset-background focus:outline-hidden focus:ring-1 focus:ring-ring disabled:cursor-not-allowed disabled:opacity-50", Class)"
        style="@Style"
        data-slot="combobox-trigger"
        aria-haspopup="listbox"
        aria-expanded="@(Combobox?.IsOpen == true ? "true" : "false")"
        aria-controls="@(Combobox?.IsOpen == true ? Combobox.ContentId : null)"
        @onclick="Toggle"
        @onkeydown="HandleKeyDown"
        @attributes="AdditionalAttributes">
    @ChildContent
    @if (ShowClear && HasSelection)
    {
        @* Reserves the clear button's footprint; the real clear <button> renders as a
           sibling below — a button nested inside the trigger button would be invalid
           HTML and unreachable by keyboard. *@
        <span class="pointer-events-none size-6 shrink-0" aria-hidden="true"></span>
    }
    else
    {
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-combobox-trigger-icon pointer-events-none shrink-0" aria-hidden="true"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
    }
</button>
@if (ShowClear && HasSelection)
{
    <ComboboxClearCn Class="absolute top-1/2 right-3 -translate-y-1/2" />
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowClear { get; set; }
    [CascadingParameter] public ComboboxCn? Combobox { get; set; }

    private ElementReference _triggerRef;

    private bool HasSelection => Combobox is not null &&
        (Combobox.Multiple ? Combobox.SelectedItems.Count > 0 : Combobox.SelectedValue is not null);

    protected override void OnAfterRender(bool firstRender)
    {
        if (Combobox is not null) Combobox.TriggerElement = _triggerRef;
    }

    private async Task Toggle()
    {
        if (Combobox is not null) await Combobox.ToggleOpen();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // APG combobox: ArrowDown/ArrowUp on the closed trigger open the popup
        // (focus then lands in the search input via ComboboxContentCn).
        if (Combobox is not null && !Combobox.IsOpen && e.Key is "ArrowDown" or "ArrowUp")
            await Combobox.SetOpen(true);
    }
}
