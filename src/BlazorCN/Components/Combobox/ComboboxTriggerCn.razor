@namespace BlazorCN
@inherits ComponentBaseCn

<button @ref="_triggerRef"
        type="button"
        class="@Cn.Merge("cn-combobox-trigger flex h-9 w-full items-center justify-between whitespace-nowrap rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm ring-offset-background focus:outline-hidden focus:ring-1 focus:ring-ring disabled:cursor-not-allowed disabled:opacity-50", Class)"
        style="@Style"
        data-slot="combobox-trigger"
        aria-haspopup="listbox"
        aria-expanded="@(Combobox?.IsOpen == true ? "true" : "false")"
        @onclick="Toggle"
        @attributes="AdditionalAttributes">
    @ChildContent
    <span class="flex items-center gap-1 shrink-0">
        @if (ShowClear && HasSelection)
        {
            <span class="inline-flex items-center justify-center size-4 rounded-sm opacity-50 hover:opacity-100 cursor-pointer" data-slot="combobox-clear" @onclick="HandleClear" @onclick:stopPropagation="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </span>
        }
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 opacity-50 shrink-0" aria-hidden="true"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
    </span>
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowClear { get; set; }
    [CascadingParameter] public ComboboxCn? Combobox { get; set; }

    private ElementReference _triggerRef;

    private bool HasSelection => Combobox is not null &&
        (Combobox.Multiple ? Combobox.SelectedItems.Count > 0 : Combobox.SelectedValue is not null);

    protected override void OnAfterRender(bool firstRender)
    {
        if (Combobox is not null) Combobox.TriggerElement = _triggerRef;
    }

    private async Task Toggle()
    {
        if (Combobox is not null) await Combobox.ToggleOpen();
    }

    private async Task HandleClear()
    {
        if (Combobox is not null) await Combobox.ClearSelection();
    }
}
