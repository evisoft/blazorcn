@namespace BlazorCN
@inherits ComponentBaseCn

<button @ref="_triggerRef"
        type="button"
        class="@Cn.Merge("flex h-9 w-full items-center justify-between whitespace-nowrap rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm ring-offset-background focus:outline-none focus:ring-1 focus:ring-ring disabled:cursor-not-allowed disabled:opacity-50", Class)"
        style="@Style"
        data-slot="combobox-trigger"
        @onclick="Toggle"
        @attributes="AdditionalAttributes">
    @ChildContent
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 opacity-50 shrink-0"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public ComboboxCn? Combobox { get; set; }

    private ElementReference _triggerRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (Combobox is not null) Combobox.TriggerElement = _triggerRef;
    }

    private async Task Toggle()
    {
        if (Combobox is not null) await Combobox.ToggleOpen();
    }
}
