@namespace BlazorCN
@inherits ComponentBaseCn

@* Scrollable option region (reference combobox.tsx ComboboxList): the nova
   cn-combobox-list rule clamps its height to --available-height and scrolls
   overflow, so the search input pinned above never scrolls away. *@
<div class="@Cn.Merge("cn-combobox-list", Class)"
     style="@Style"
     data-slot="combobox-list"
     data-empty="@(Combobox?.IsEmpty == true ? "" : null)"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public ComboboxCn? Combobox { get; set; }
}
