@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("relative inline-block", Class)" style="@Style" data-slot="combobox" data-state="@(IsOpen ? "open" : "closed")" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public List<string> SelectedValues { get; set; } = [];
    [Parameter] public EventCallback<List<string>> SelectedValuesChanged { get; set; }

    internal bool IsOpen { get; private set; }
    internal ElementReference TriggerElement { get; set; }
    internal string ContentId { get; } = $"combobox-content-{Guid.NewGuid():N}";
    internal string TriggerId { get; } = $"combobox-trigger-{Guid.NewGuid():N}";
    internal string? SelectedValue { get; private set; }
    internal string? SelectedText { get; private set; }
    internal IReadOnlyList<string> SelectedItems => _selectedItems;

    private List<string> _selectedItems = [];
    private readonly List<ComboboxItemCn> _items = [];

    /// <summary>Current filter text, set by ComboboxInputCn as the user types (cmdk behavior).</summary>
    internal string Search { get; private set; } = string.Empty;

    internal void SetSearch(string value)
    {
        Search = value;
        StateHasChanged();
    }

    internal void RegisterItem(ComboboxItemCn item) => _items.Add(item);
    internal void UnregisterItem(ComboboxItemCn item) => _items.Remove(item);

    /// <summary>True while at least one item matches the filter — drives ComboboxEmptyCn.</summary>
    internal bool HasVisibleItems => _items.Count == 0 || _items.Any(i => i.IsVisible);

    /// <summary>True when a non-empty search matches no items (mirrors Base UI's data-empty).</summary>
    internal bool IsEmpty => Search.Length > 0 && !HasVisibleItems;

    /// <summary>Returns focus to the trigger (Radix behavior on close via keyboard or select).</summary>
    internal async Task FocusTriggerAsync()
    {
        if (!string.IsNullOrEmpty(TriggerElement.Id))
        {
            try { await TriggerElement.FocusAsync(); }
            catch { /* Circuit gone or element detached */ }
        }
    }

    // Registered by ComboboxInputCn so the content can move focus into the search
    // input when the popup opens (Base UI keeps DOM focus in the input on open).
    private Func<Task>? _focusInput;

    internal void RegisterInputFocus(Func<Task> focusInput) => _focusInput = focusInput;

    internal void UnregisterInputFocus(Func<Task> focusInput)
    {
        if (ReferenceEquals(_focusInput, focusInput)) _focusInput = null;
    }

    /// <summary>Moves focus into the popup's search input, if one is rendered.</summary>
    internal async Task FocusInputAsync()
    {
        if (_focusInput is not null)
        {
            try { await _focusInput(); }
            catch { /* Circuit gone or element detached */ }
        }
    }

    protected override void OnInitialized()
    {
        IsOpen = Open;
        SelectedValue = Value;
        _selectedItems = [..SelectedValues];
    }

    protected override void OnParametersSet()
    {
        if (Open != IsOpen)
            IsOpen = Open;
        SelectedValue = Value;
        _selectedItems = [..SelectedValues];
    }

    internal async Task SetOpen(bool open)
    {
        IsOpen = open;
        if (!open) Search = string.Empty;
        await OpenChanged.InvokeAsync(IsOpen);
        StateHasChanged();
    }

    internal async Task ToggleOpen()
    {
        await SetOpen(!IsOpen);
    }

    internal async Task SelectItem(string value, string? text)
    {
        if (Multiple)
        {
            if (_selectedItems.Contains(value))
                _selectedItems.Remove(value);
            else
                _selectedItems.Add(value);
            await SelectedValuesChanged.InvokeAsync([.._selectedItems]);
            StateHasChanged();
        }
        else
        {
            SelectedValue = value;
            SelectedText = text;
            await ValueChanged.InvokeAsync(value);
            await SetOpen(false);
            await FocusTriggerAsync();
        }
    }

    internal async Task ClearSelection()
    {
        if (Multiple)
        {
            _selectedItems.Clear();
            await SelectedValuesChanged.InvokeAsync([.._selectedItems]);
        }
        else
        {
            SelectedValue = null;
            SelectedText = null;
            await ValueChanged.InvokeAsync(null);
        }
        StateHasChanged();
    }

    internal bool IsItemSelected(string value)
    {
        if (Multiple)
            return _selectedItems.Contains(value);
        return SelectedValue == value;
    }

    internal void RegisterItemText(string value, string? text)
    {
        if (SelectedValue == value)
        {
            SelectedText = text;
        }
    }
}
