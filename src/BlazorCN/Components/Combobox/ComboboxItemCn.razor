@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("relative flex w-full cursor-default select-none items-center rounded-sm py-1.5 pl-8 pr-2 text-sm outline-none focus:bg-accent focus:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50", Class)"
     style="@Style"
     data-slot="combobox-item"
     data-menu-item
     data-disabled="@(Disabled ? "true" : null)"
     tabindex="-1"
     @onclick="HandleClick"
     @attributes="AdditionalAttributes">
    <span class="pointer-events-none absolute left-2 flex size-3.5 items-center justify-center">
        @if (IsSelected)
        {
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M20 6 9 17l-5-5"/></svg>
        }
    </span>
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [CascadingParameter] public ComboboxCn? Combobox { get; set; }

    private bool IsSelected => Combobox?.SelectedValue == Value;

    protected override void OnInitialized()
    {
        Combobox?.RegisterItemText(Value, Value);
    }

    private async Task HandleClick()
    {
        if (Disabled) return;
        if (Combobox is not null)
        {
            await Combobox.SelectItem(Value, Value);
        }
    }
}
