@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("relative", Class)" style="@Style" data-slot="dropdown-menu-sub" data-state="@(IsOpen ? "open" : "closed")" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    internal bool IsOpen { get; private set; }
    internal ElementReference TriggerElement { get; set; }

    internal void SetOpen(bool open)
    {
        IsOpen = open;
        StateHasChanged();
    }

    internal void ToggleOpen()
    {
        SetOpen(!IsOpen);
    }
}
