@namespace BlazorCN
@inherits ComponentBaseCn

<button @ref="_triggerRef" type="button" class="@Class" style="@Style" data-slot="dropdown-menu-trigger" aria-haspopup="menu" aria-expanded="@(DropdownMenu?.IsOpen == true ? "true" : "false")" aria-controls="@(DropdownMenu?.IsOpen == true ? DropdownMenu.ContentId : null)" @onclick="Toggle" @onkeydown="HandleKeyDown" @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public DropdownMenuCn? DropdownMenu { get; set; }

    private ElementReference _triggerRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (DropdownMenu is not null) DropdownMenu.TriggerElement = _triggerRef;
    }

    private async Task Toggle()
    {
        if (DropdownMenu is not null) await DropdownMenu.ToggleOpen();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // APG menu-button: ArrowDown/ArrowUp open the menu (focus lands via keyboard-nav autofocus).
        if (DropdownMenu is not null && !DropdownMenu.IsOpen && e.Key is "ArrowDown" or "ArrowUp")
            await DropdownMenu.SetOpen(true);
    }
}
