@namespace BlazorCN
@inherits ComponentBaseCn

<button @ref="_triggerRef" type="button" class="@Class" style="@Style" data-slot="dropdown-menu-trigger" @onclick="Toggle" @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public DropdownMenuCn? DropdownMenu { get; set; }

    private ElementReference _triggerRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (DropdownMenu is not null) DropdownMenu.TriggerElement = _triggerRef;
    }

    private async Task Toggle()
    {
        if (DropdownMenu is not null) await DropdownMenu.ToggleOpen();
    }
}
