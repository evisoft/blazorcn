@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("relative inline-block", Class)" style="@Style" data-slot="dropdown-menu" data-state="@(IsOpen ? "open" : "closed")" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    internal bool IsOpen { get; private set; }
    internal ElementReference TriggerElement { get; set; }
    internal string ContentId { get; } = $"dropdown-menu-content-{Guid.NewGuid():N}";

    // The Open last passed in. Without OpenChanged the component owns its state and Open is only a
    // starting value: it is applied again only when the consumer changes it, so an unrelated parent
    // re-render cannot close what the user opened. With OpenChanged bound the consumer owns the state
    // and every render syncs to it, which is also how a consumer refuses a close.
    private bool _lastOpenParam;

    protected override void OnInitialized() => IsOpen = _lastOpenParam = Open;
    protected override void OnParametersSet()
    {
        var changed = Open != _lastOpenParam;
        _lastOpenParam = Open;
        if ((changed || OpenChanged.HasDelegate) && Open != IsOpen)
            IsOpen = Open;
    }


    internal async Task SetOpen(bool open)
    {
        IsOpen = open;
        await OpenChanged.InvokeAsync(IsOpen);
        StateHasChanged();
    }

    internal async Task ToggleOpen()
    {
        await SetOpen(!IsOpen);
    }
}
