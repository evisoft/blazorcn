@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

@if (DropdownMenu?.IsOpen == true)
{
    <div @ref="_contentRef"
         class="@Cn.Merge("cn-dropdown-menu-content z-50 max-h-(--available-height) w-(--anchor-width) origin-(--transform-origin) overflow-x-hidden overflow-y-auto", Class)"
         style="@Style"
         data-slot="dropdown-menu-content"
         data-state="open"
         data-side="@Side.ToString().ToLowerInvariant()"
         data-align="@Align.ToString().ToLowerInvariant()"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}
