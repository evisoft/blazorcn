@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@CssClass"
     style="@Style"
     data-slot="dropdown-menu-checkbox-item"
     data-menu-item
     data-disabled="@(Disabled ? "true" : null)"
     data-state="@(Checked ? "checked" : "unchecked")"
     role="menuitemcheckbox"
     aria-checked="@Checked.ToString().ToLowerInvariant()"
     aria-disabled="@(Disabled ? "true" : null)"
     tabindex="-1"
     @onclick="HandleClick"
     @attributes="AdditionalAttributes">
    <span class="cn-dropdown-menu-item-indicator pointer-events-none">
        @if (Checked)
        {
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        }
    </span>
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    /// <summary>Whether activating the item closes the menu (Radix default). Set false to keep it open.</summary>
    [Parameter] public bool CloseOnSelect { get; set; } = true;
    [CascadingParameter] private DropdownMenuCn? DropdownMenu { get; set; }

    private string CssClass => Cn.Merge(
        "cn-dropdown-menu-checkbox-item relative flex cursor-default select-none items-center outline-hidden data-[disabled]:pointer-events-none data-[disabled]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
        Class);

    private async Task HandleClick()
    {
        if (Disabled) return;
        Checked = !Checked;
        await CheckedChanged.InvokeAsync(Checked);
        await OnClick.InvokeAsync();
        if (CloseOnSelect && DropdownMenu is not null) await DropdownMenu.SetOpen(false);
    }
}
