@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@CssClass"
     style="@Style"
     data-slot="dropdown-menu-radio-item"
     data-menu-item
     data-disabled="@(Disabled ? "true" : null)"
     data-state="@(IsSelected ? "checked" : "unchecked")"
     role="menuitemradio"
     aria-checked="@IsSelected.ToString().ToLowerInvariant()"
     tabindex="-1"
     @onclick="HandleClick"
     @attributes="AdditionalAttributes">
    <span class="pointer-events-none absolute left-2 flex size-3.5 items-center justify-center">
        @if (IsSelected)
        {
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="size-2.5"><circle cx="12" cy="12" r="6"/></svg>
        }
    </span>
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [CascadingParameter] private DropdownMenuRadioGroupCn? RadioGroup { get; set; }

    private bool IsSelected => RadioGroup?.IsSelected(Value) ?? false;

    private string CssClass => Cn.Merge(
        "relative flex cursor-default select-none items-center gap-2 rounded-sm py-1.5 pl-8 pr-2 text-sm outline-none transition-colors focus:bg-accent focus:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50",
        Class);

    private async Task HandleClick()
    {
        if (Disabled || RadioGroup is null) return;
        await RadioGroup.SelectValue(Value);
    }
}
