@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@CssClass" style="@Style" data-slot="dropdown-menu-label" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Inset { get; set; }

    private string CssClass => Cn.Merge(
        "px-2 py-1.5 text-sm font-semibold",
        Inset ? "pl-8" : null,
        Class);
}
