@namespace BlazorCN
@inherits ComponentBaseCn

<div @ref="_triggerRef"
     class="@CssClass"
     style="@Style"
     data-slot="dropdown-menu-sub-trigger"
     data-menu-item
     data-state="@(Sub?.IsOpen == true ? "open" : "closed")"
     aria-haspopup="menu"
     aria-expanded="@(Sub?.IsOpen == true ? "true" : "false")"
     tabindex="-1"
     @onclick="Toggle"
     data-inset="@(Inset ? "" : null)"
     @attributes="AdditionalAttributes">
    @ChildContent
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-auto size-4" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Inset { get; set; }
    [CascadingParameter] public DropdownMenuSubCn? Sub { get; set; }

    private ElementReference _triggerRef;

    private string CssClass => Cn.Merge(
        "cn-dropdown-menu-sub-trigger flex cursor-default select-none items-center outline-hidden [&_svg]:pointer-events-none [&_svg]:shrink-0",
        Class);

    protected override void OnAfterRender(bool firstRender)
    {
        if (Sub is not null) Sub.TriggerElement = _triggerRef;
    }

    private void Toggle()
    {
        Sub?.ToggleOpen();
    }
}
