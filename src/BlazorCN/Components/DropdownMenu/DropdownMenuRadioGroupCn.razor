@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge(Class)" style="@Style" data-slot="dropdown-menu-radio-group" role="group" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    internal bool IsSelected(string value) => Value == value;

    internal async Task SelectValue(string value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(Value);
        StateHasChanged();
    }
}
