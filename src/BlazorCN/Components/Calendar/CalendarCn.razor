@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("cn-calendar group/calendar bg-background [[data-slot=card-content]_&]:bg-transparent [[data-slot=popover-content]_&]:bg-transparent", Class)" style="@Style" data-slot="calendar" @attributes="AdditionalAttributes">
    <div class="relative flex flex-col gap-4">
        <div class="flex w-full flex-col gap-4">
            <div class="flex items-center justify-between">
                <button type="button"
                        class="cn-calendar-nav-button"
                        aria-label="Previous month"
                        disabled="@(!CanGoPrev)"
                        aria-disabled="@(!CanGoPrev ? "true" : null)"
                        @onclick="PreviousMonth">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-rtl-flip size-4" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <div class="text-sm font-medium select-none">
                    @MonthCaption
                </div>
                <button type="button"
                        class="cn-calendar-nav-button"
                        aria-label="Next month"
                        disabled="@(!CanGoNext)"
                        aria-disabled="@(!CanGoNext ? "true" : null)"
                        @onclick="NextMonth">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-rtl-flip size-4" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            </div>
            @* role=grid + explicit row/cell roles: the flex-styled rows strip the
               implicit table semantics, so we restore them the way react-day-picker
               does. Keyboard nav is pure Blazor (@onkeydown bubbles up from the day
               buttons); arrows can't preventDefault page scroll without JS — accepted
               tradeoff for staying JS-free here. *@
            <table class="w-full border-collapse" role="grid" aria-label="@MonthCaption" @onkeydown="HandleGridKeyDown">
                <thead>
                    <tr class="flex" role="row">
                        @if (ShowWeekNumbers)
                        {
                            <th class="w-(--cell-size) cn-calendar-week-number select-none" role="columnheader"><span class="sr-only">Week Number</span></th>
                        }
                        @for (var i = 0; i < DayNames.Length; i++)
                        {
                            <th @key="DayNames[i]" class="cn-calendar-weekday" role="columnheader" scope="col" aria-label="@FullDayNames[i]">@DayNames[i]</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var week in GetWeeks())
                    {
                        <tr @key="week" class="mt-2 flex w-full" role="row">
                            @if (ShowWeekNumbers)
                            {
                                <td class="flex items-center justify-center w-(--cell-size) cn-calendar-week-number" role="gridcell" aria-label="@($"Week {GetIsoWeekNumber(week)}")">
                                    @GetIsoWeekNumber(week)
                                </td>
                            }
                            @foreach (var date in week)
                            {
                                <td @key="date" class="@GetCellClass(date)" role="gridcell" aria-selected="@(date.HasValue ? (IsAnySelected(date) ? "true" : "false") : null)" data-selected="@(IsAnySelected(date) ? "true" : null)">
                                    @if (date.HasValue)
                                    {
                                        var d = date.Value;
                                        <button type="button"
                                                @ref="_dayRefs[d.Date]"
                                                class="@GetDayClass(d)"
                                                disabled="@IsDayDisabled(d)"
                                                aria-label="@GetDayAriaLabel(d)"
                                                tabindex="@(d.Date == _focusedDate ? 0 : -1)"
                                                data-selected-single="@(IsSelectedSingle(d) ? "true" : null)"
                                                data-range-start="@(IsRangeStart(d) ? "true" : null)"
                                                data-range-end="@(IsRangeEnd(d) ? "true" : null)"
                                                data-range-middle="@(IsRangeMiddle(d) ? "true" : null)"
                                                @onclick="() => OnDayClick(d)">
                                            @d.Day
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    // --- Single mode ---
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }

    // --- Multiple mode ---
    [Parameter] public List<DateTime>? SelectedDates { get; set; }
    [Parameter] public EventCallback<List<DateTime>> SelectedDatesChanged { get; set; }

    // --- Range mode ---
    [Parameter] public DateTime? RangeStart { get; set; }
    [Parameter] public EventCallback<DateTime?> RangeStartChanged { get; set; }
    [Parameter] public DateTime? RangeEnd { get; set; }
    [Parameter] public EventCallback<DateTime?> RangeEndChanged { get; set; }

    // --- Common ---
    [Parameter] public CalendarSelectionMode Mode { get; set; } = CalendarSelectionMode.Single;
    [Parameter] public DateTime? MinDate { get; set; }
    [Parameter] public DateTime? MaxDate { get; set; }
    [Parameter] public IReadOnlyCollection<DateTime>? DisabledDates { get; set; }
    [Parameter] public bool ShowWeekNumbers { get; set; }

    // Optional two-way bindable control of the visible month (normalized to the
    // first of the month). Null = the calendar manages the month itself, seeded
    // from the selected value; internal navigation reports via DisplayMonthChanged.
    [Parameter] public DateTime? DisplayMonth { get; set; }
    [Parameter] public EventCallback<DateTime?> DisplayMonthChanged { get; set; }

    private DateTime _displayMonth;

    // Last DisplayMonth parameter value we saw or reported — lets OnParametersSet
    // distinguish a real external month change from the parent echoing our own
    // DisplayMonthChanged back (or from an unrelated re-render).
    private DateTime? _lastDisplayMonthParam;

    // Deliberately InvariantCulture (English) rather than CurrentCulture: the
    // weekday headers and Sunday-first grid are hardcoded English to match
    // react-day-picker's default locale in shadcn-ui, so the caption and day
    // aria-labels must not switch language with the thread culture.
    private string MonthCaption => _displayMonth.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture);

    // Month nav stops at Min/MaxDate: prev is allowed while any day before the
    // displayed month can still be in range, next while any day after can be.
    private bool CanGoPrev => !MinDate.HasValue
        || new DateTime(_displayMonth.Year, _displayMonth.Month, 1) > MinDate.Value.Date;
    private bool CanGoNext => !MaxDate.HasValue
        || new DateTime(_displayMonth.Year, _displayMonth.Month, 1).AddMonths(1).AddDays(-1) < MaxDate.Value.Date;

    private static readonly string[] DayNames = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"];
    private static readonly string[] FullDayNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

    // Track range click state: false = next click sets start, true = next click sets end
    private bool _rangeHasStart;

    // Roving tabindex (APG date-picker grid): only _focusedDate is a Tab stop;
    // arrows/Home/End/PageUp/PageDown move it. Day button refs are keyed by date
    // so OnAfterRenderAsync can FocusAsync the new target. Stale entries for
    // previously displayed months are harmless (~42 per viewed month).
    private DateTime _focusedDate;
    private bool _pendingFocus;
    private readonly Dictionary<DateTime, ElementReference> _dayRefs = new();

    protected override void OnInitialized()
    {
        var seed = Mode switch
        {
            CalendarSelectionMode.Range => RangeStart ?? DateTime.Today,
            CalendarSelectionMode.Multiple => (SelectedDates?.Count > 0 ? SelectedDates.First() : DateTime.Today),
            _ => Value ?? DateTime.Today
        };
        _displayMonth = new DateTime(seed.Year, seed.Month, 1);
        // A disabled day button is unfocusable, so a disabled seed (e.g. today
        // before MinDate) would leave the grid with no reachable Tab stop.
        _focusedDate = NearestEnabledInMonth(seed.Date);
    }

    protected override void OnParametersSet()
    {
        // Only react when the incoming DisplayMonth actually differs from what we
        // last saw/reported — an unrelated parent re-render must not reset the month.
        var incoming = DisplayMonth.HasValue
            ? new DateTime(DisplayMonth.Value.Year, DisplayMonth.Value.Month, 1)
            : (DateTime?)null;
        if (incoming == _lastDisplayMonthParam) return;
        _lastDisplayMonthParam = incoming;
        if (incoming.HasValue && incoming.Value != _displayMonth)
        {
            _displayMonth = incoming.Value;
            _focusedDate = NearestEnabledInMonth(ClampToMonth(_focusedDate, _displayMonth));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocus)
        {
            _pendingFocus = false;
            if (_dayRefs.TryGetValue(_focusedDate, out var button))
            {
                try { await button.FocusAsync(); }
                catch { /* Prerendering without JS — focus is progressive enhancement */ }
            }
        }
    }

    private Task PreviousMonth() => SetDisplayMonthInternalAsync(_displayMonth.AddMonths(-1));

    private Task NextMonth() => SetDisplayMonthInternalAsync(_displayMonth.AddMonths(1));

    /// <summary>Applies an internally initiated month change: clamps the roving Tab stop into the
    /// new month (skipping disabled days), and reports the change so @bind-DisplayMonth stays in sync.</summary>
    private async Task SetDisplayMonthInternalAsync(DateTime month)
    {
        _displayMonth = new DateTime(month.Year, month.Month, 1);
        _focusedDate = NearestEnabledInMonth(ClampToMonth(_focusedDate, _displayMonth));
        DisplayMonth = _displayMonth;
        _lastDisplayMonthParam = _displayMonth;
        await DisplayMonthChanged.InvokeAsync(_displayMonth);
    }

    /// <summary>Same day-of-month within <paramref name="month"/>, clamped to that month's length —
    /// keeps the roving Tab stop on a visible day after month navigation.</summary>
    private static DateTime ClampToMonth(DateTime date, DateTime month) =>
        new(month.Year, month.Month, Math.Min(date.Day, DateTime.DaysInMonth(month.Year, month.Month)));

    /// <summary>Nearest enabled day to <paramref name="candidate"/> within its own month,
    /// searching outward — a disabled day button is unfocusable, so the roving Tab stop must
    /// never land on one. Returns the candidate unchanged when the whole month is disabled
    /// (nothing is focusable then, which is correct).</summary>
    private DateTime NearestEnabledInMonth(DateTime candidate)
    {
        if (!IsDayDisabled(candidate)) return candidate;
        var daysInMonth = DateTime.DaysInMonth(candidate.Year, candidate.Month);
        for (var offset = 1; offset < daysInMonth; offset++)
        {
            var after = candidate.Day + offset;
            if (after <= daysInMonth && !IsDayDisabled(new DateTime(candidate.Year, candidate.Month, after)))
                return new DateTime(candidate.Year, candidate.Month, after);
            var before = candidate.Day - offset;
            if (before >= 1 && !IsDayDisabled(new DateTime(candidate.Year, candidate.Month, before)))
                return new DateTime(candidate.Year, candidate.Month, before);
        }
        return candidate;
    }

    private async Task HandleGridKeyDown(KeyboardEventArgs e)
    {
        DateTime? target = e.Key switch
        {
            "ArrowLeft" => _focusedDate.AddDays(-1),
            "ArrowRight" => _focusedDate.AddDays(1),
            "ArrowUp" => _focusedDate.AddDays(-7),
            "ArrowDown" => _focusedDate.AddDays(7),
            "Home" => _focusedDate.AddDays(-(int)_focusedDate.DayOfWeek),
            "End" => _focusedDate.AddDays(6 - (int)_focusedDate.DayOfWeek),
            "PageUp" => ClampToMonth(_focusedDate, _focusedDate.AddMonths(-1)),
            "PageDown" => ClampToMonth(_focusedDate, _focusedDate.AddMonths(1)),
            _ => null
        };
        if (!target.HasValue || target.Value == _focusedDate) return;

        // Disabled day buttons can't receive focus. Hop over disabled days in
        // the direction of travel (react-day-picker does the same) so a booked
        // date mid-month doesn't strand the roving Tab stop; give up at the
        // Min/MaxDate bounds (or a huge disabled span) without moving at all.
        if (IsDayDisabled(target.Value))
        {
            var step = target.Value > _focusedDate ? 1 : -1;
            var probe = target.Value;
            while (IsDayDisabled(probe))
            {
                probe = probe.AddDays(step);
                if (MinDate.HasValue && probe.Date < MinDate.Value.Date) return;
                if (MaxDate.HasValue && probe.Date > MaxDate.Value.Date) return;
                if (Math.Abs((probe - _focusedDate).TotalDays) > 366) return;
            }
            target = probe;
        }

        _focusedDate = target.Value.Date;
        _pendingFocus = true;
        if (_focusedDate.Month != _displayMonth.Month || _focusedDate.Year != _displayMonth.Year)
            await SetDisplayMonthInternalAsync(new DateTime(_focusedDate.Year, _focusedDate.Month, 1));
    }

    /// <summary>Full accessible day name, mirroring react-day-picker's labelDayButton
    /// (e.g. "Today, Friday, June 5, 2026, selected"). InvariantCulture on purpose —
    /// see <see cref="MonthCaption"/>.</summary>
    private string GetDayAriaLabel(DateTime date) =>
        (IsToday(date) ? "Today, " : "") + date.ToString("dddd, MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture) + (IsAnySelected(date) ? ", selected" : "");

    // --- Click handler ---
    private async Task OnDayClick(DateTime date)
    {
        _focusedDate = date.Date;
        switch (Mode)
        {
            case CalendarSelectionMode.Single:
                Value = date;
                await ValueChanged.InvokeAsync(date);
                break;

            case CalendarSelectionMode.Multiple:
                var list = SelectedDates != null ? new List<DateTime>(SelectedDates) : new List<DateTime>();
                var existing = list.FindIndex(d => d.Date == date.Date);
                if (existing >= 0)
                    list.RemoveAt(existing);
                else
                    list.Add(date);
                SelectedDates = list;
                await SelectedDatesChanged.InvokeAsync(list);
                break;

            case CalendarSelectionMode.Range:
                if (!_rangeHasStart)
                {
                    // First click: set start, clear end
                    RangeStart = date;
                    RangeEnd = null;
                    _rangeHasStart = true;
                    await RangeStartChanged.InvokeAsync(date);
                    await RangeEndChanged.InvokeAsync(null);
                }
                else
                {
                    // Second click: set end (swap if before start). Capture the new
                    // start/end in locals BEFORE any await — if the parent's
                    // RangeStartChanged handler yields, the parent re-renders
                    // mid-flight and SetParametersAsync resets the mutable
                    // RangeStart/RangeEnd parameters to their stale values before
                    // RangeEndChanged fires.
                    DateTime? newStart = RangeStart;
                    DateTime? newEnd;
                    if (date < newStart)
                    {
                        newEnd = newStart;
                        newStart = date;
                    }
                    else
                    {
                        newEnd = date;
                    }
                    RangeStart = newStart;
                    RangeEnd = newEnd;
                    _rangeHasStart = false;
                    await RangeStartChanged.InvokeAsync(newStart);
                    await RangeEndChanged.InvokeAsync(newEnd);
                }
                break;
        }
    }

    // --- Disabled check ---
    private bool IsDayDisabled(DateTime date)
    {
        if (MinDate.HasValue && date.Date < MinDate.Value.Date) return true;
        if (MaxDate.HasValue && date.Date > MaxDate.Value.Date) return true;
        if (DisabledDates != null)
        {
            foreach (var d in DisabledDates)
            {
                if (d.Date == date.Date) return true;
            }
        }
        return false;
    }

    // --- Selection state helpers ---
    private bool IsSelected(DateTime date) => Value.HasValue && Value.Value.Date == date.Date;
    private bool IsMultiSelected(DateTime date) => SelectedDates?.Any(d => d.Date == date.Date) == true;
    private bool IsToday(DateTime date) => date.Date == DateTime.Today;
    private bool IsOutsideMonth(DateTime date) => date.Month != _displayMonth.Month;

    private bool IsRangeStart(DateTime date) => Mode == CalendarSelectionMode.Range && RangeStart.HasValue && RangeStart.Value.Date == date.Date;
    private bool IsRangeEnd(DateTime date) => Mode == CalendarSelectionMode.Range && RangeEnd.HasValue && RangeEnd.Value.Date == date.Date;
    private bool IsRangeMiddle(DateTime date)
    {
        if (Mode != CalendarSelectionMode.Range || !RangeStart.HasValue || !RangeEnd.HasValue) return false;
        return date.Date > RangeStart.Value.Date && date.Date < RangeEnd.Value.Date;
    }

    private bool IsSelectedSingle(DateTime date)
    {
        return Mode switch
        {
            CalendarSelectionMode.Single => IsSelected(date),
            CalendarSelectionMode.Multiple => IsMultiSelected(date),
            _ => false
        };
    }

    private bool IsAnySelected(DateTime? date)
    {
        if (!date.HasValue) return false;
        return IsSelectedSingle(date.Value) || IsRangeStart(date.Value) || IsRangeEnd(date.Value) || IsRangeMiddle(date.Value);
    }

    // --- Cell class (td) for range highlighting ---
    private string GetCellClass(DateTime? date)
    {
        var baseClass = "group/day relative aspect-square h-full w-full rounded-(--cell-radius) p-0 text-center select-none [&:last-child[data-selected=true]_button]:rounded-r-(--cell-radius) [&:first-child[data-selected=true]_button]:rounded-l-(--cell-radius)";
        if (!date.HasValue) return baseClass;
        var d = date.Value;

        if (IsRangeStart(d) && IsRangeEnd(d))
            return Cn.Merge(baseClass);

        if (IsRangeStart(d))
            return Cn.Merge(baseClass, "relative isolate z-0 rounded-l-(--cell-radius) bg-muted after:absolute after:inset-y-0 after:right-0 after:w-4 after:bg-muted");

        if (IsRangeEnd(d))
            return Cn.Merge(baseClass, "relative isolate z-0 rounded-r-(--cell-radius) bg-muted after:absolute after:inset-y-0 after:left-0 after:w-4 after:bg-muted");

        if (IsRangeMiddle(d))
            return Cn.Merge(baseClass, "rounded-none bg-muted");

        if (IsToday(d) && !IsSelectedSingle(d))
            return Cn.Merge(baseClass, "cn-calendar-day-today");

        if (IsOutsideMonth(d))
            return Cn.Merge(baseClass, "cn-calendar-day-outside");

        return baseClass;
    }

    // --- Day button class ---
    private string GetDayClass(DateTime date)
    {
        var disabled = IsDayDisabled(date);
        var booked = DisabledDates != null && DisabledDates.Any(dd => dd.Date == date.Date);

        return Cn.Merge(
            "cn-calendar-day",
            "group-data-[focused=true]/day:relative group-data-[focused=true]/day:z-10 group-data-[focused=true]/day:border-ring group-data-[focused=true]/day:ring-[3px] group-data-[focused=true]/day:ring-ring/50",
            disabled ? "text-muted-foreground opacity-50 pointer-events-none" : "",
            booked ? "line-through" : "");
    }

    // --- Week grid ---
    private List<DateTime?[]> GetWeeks()
    {
        var weeks = new List<DateTime?[]>();
        var firstDay = new DateTime(_displayMonth.Year, _displayMonth.Month, 1);
        var lastDay = firstDay.AddMonths(1).AddDays(-1);

        var current = firstDay.AddDays(-(int)firstDay.DayOfWeek);

        while (current <= lastDay || current.DayOfWeek != DayOfWeek.Sunday)
        {
            var week = new DateTime?[7];
            for (var i = 0; i < 7; i++)
            {
                week[i] = current;
                current = current.AddDays(1);
            }
            weeks.Add(week);

            if (current > lastDay && current.DayOfWeek == DayOfWeek.Sunday)
                break;
        }

        return weeks;
    }

    // --- ISO week number ---
    private static int GetIsoWeekNumber(DateTime?[] week)
    {
        // Use the Thursday of the week to determine ISO week number
        var thursday = week.FirstOrDefault(d => d.HasValue && d.Value.DayOfWeek == DayOfWeek.Thursday);
        var refDate = thursday ?? week.FirstOrDefault(d => d.HasValue);
        if (!refDate.HasValue) return 0;
        return System.Globalization.ISOWeek.GetWeekOfYear(refDate.Value);
    }
}
