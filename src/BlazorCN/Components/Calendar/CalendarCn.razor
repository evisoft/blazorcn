@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("cn-calendar group/calendar bg-background [[data-slot=card-content]_&]:bg-transparent [[data-slot=popover-content]_&]:bg-transparent", Class)" style="@Style" data-slot="calendar" @attributes="AdditionalAttributes">
    <div class="relative flex flex-col gap-4">
        <div class="flex w-full flex-col gap-4">
            <div class="flex items-center justify-between">
                <button type="button"
                        class="inline-flex items-center justify-center size-7 rounded-md hover:bg-accent hover:text-accent-foreground select-none"
                        aria-label="Previous month"
                        @onclick="PreviousMonth">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <div class="text-sm font-medium select-none">
                    @DisplayMonth.ToString("MMMM yyyy")
                </div>
                <button type="button"
                        class="inline-flex items-center justify-center size-7 rounded-md hover:bg-accent hover:text-accent-foreground select-none"
                        aria-label="Next month"
                        @onclick="NextMonth">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            </div>
            <table class="w-full border-collapse">
                <thead>
                    <tr class="flex">
                        @if (ShowWeekNumbers)
                        {
                            <th class="w-9 text-[0.8rem] font-normal text-muted-foreground select-none"></th>
                        }
                        @foreach (var day in DayNames)
                        {
                            <th @key="day" class="flex-1 rounded-md text-muted-foreground text-[0.8rem] font-normal select-none">@day</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var week in GetWeeks())
                    {
                        <tr @key="week" class="mt-2 flex w-full">
                            @if (ShowWeekNumbers)
                            {
                                <td class="flex items-center justify-center w-9 text-[0.8rem] text-muted-foreground select-none">
                                    @GetIsoWeekNumber(week)
                                </td>
                            }
                            @foreach (var date in week)
                            {
                                <td @key="date" class="@GetCellClass(date)" data-selected="@IsAnySelected(date)">
                                    @if (date.HasValue)
                                    {
                                        var d = date.Value;
                                        <button type="button"
                                                class="@GetDayClass(d)"
                                                disabled="@IsDayDisabled(d)"
                                                data-selected-single="@IsSelectedSingle(d)"
                                                data-range-start="@IsRangeStart(d)"
                                                data-range-end="@IsRangeEnd(d)"
                                                data-range-middle="@IsRangeMiddle(d)"
                                                @onclick="() => OnDayClick(d)">
                                            @d.Day
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    // --- Single mode ---
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }

    // --- Multiple mode ---
    [Parameter] public List<DateTime>? SelectedDates { get; set; }
    [Parameter] public EventCallback<List<DateTime>> SelectedDatesChanged { get; set; }

    // --- Range mode ---
    [Parameter] public DateTime? RangeStart { get; set; }
    [Parameter] public EventCallback<DateTime?> RangeStartChanged { get; set; }
    [Parameter] public DateTime? RangeEnd { get; set; }
    [Parameter] public EventCallback<DateTime?> RangeEndChanged { get; set; }

    // --- Common ---
    [Parameter] public CalendarSelectionMode Mode { get; set; } = CalendarSelectionMode.Single;
    [Parameter] public DateTime? MinDate { get; set; }
    [Parameter] public DateTime? MaxDate { get; set; }
    [Parameter] public IReadOnlyCollection<DateTime>? DisabledDates { get; set; }
    [Parameter] public bool ShowWeekNumbers { get; set; }

    private DateTime DisplayMonth { get; set; }
    private static readonly string[] DayNames = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"];

    // Track range click state: false = next click sets start, true = next click sets end
    private bool _rangeHasStart;

    protected override void OnInitialized()
    {
        var seed = Mode switch
        {
            CalendarSelectionMode.Range => RangeStart ?? DateTime.Today,
            CalendarSelectionMode.Multiple => (SelectedDates?.Count > 0 ? SelectedDates.First() : DateTime.Today),
            _ => Value ?? DateTime.Today
        };
        DisplayMonth = new DateTime(seed.Year, seed.Month, 1);
    }

    private void PreviousMonth() => DisplayMonth = DisplayMonth.AddMonths(-1);
    private void NextMonth() => DisplayMonth = DisplayMonth.AddMonths(1);

    // --- Click handler ---
    private async Task OnDayClick(DateTime date)
    {
        switch (Mode)
        {
            case CalendarSelectionMode.Single:
                Value = date;
                await ValueChanged.InvokeAsync(date);
                break;

            case CalendarSelectionMode.Multiple:
                var list = SelectedDates != null ? new List<DateTime>(SelectedDates) : new List<DateTime>();
                var existing = list.FindIndex(d => d.Date == date.Date);
                if (existing >= 0)
                    list.RemoveAt(existing);
                else
                    list.Add(date);
                SelectedDates = list;
                await SelectedDatesChanged.InvokeAsync(list);
                break;

            case CalendarSelectionMode.Range:
                if (!_rangeHasStart)
                {
                    // First click: set start, clear end
                    RangeStart = date;
                    RangeEnd = null;
                    _rangeHasStart = true;
                    await RangeStartChanged.InvokeAsync(date);
                    await RangeEndChanged.InvokeAsync(null);
                }
                else
                {
                    // Second click: set end (swap if before start)
                    if (date < RangeStart)
                    {
                        RangeEnd = RangeStart;
                        RangeStart = date;
                    }
                    else
                    {
                        RangeEnd = date;
                    }
                    _rangeHasStart = false;
                    await RangeStartChanged.InvokeAsync(RangeStart);
                    await RangeEndChanged.InvokeAsync(RangeEnd);
                }
                break;
        }
    }

    // --- Disabled check ---
    private bool IsDayDisabled(DateTime date)
    {
        if (MinDate.HasValue && date.Date < MinDate.Value.Date) return true;
        if (MaxDate.HasValue && date.Date > MaxDate.Value.Date) return true;
        if (DisabledDates != null)
        {
            foreach (var d in DisabledDates)
            {
                if (d.Date == date.Date) return true;
            }
        }
        return false;
    }

    // --- Selection state helpers ---
    private bool IsSelected(DateTime date) => Value.HasValue && Value.Value.Date == date.Date;
    private bool IsMultiSelected(DateTime date) => SelectedDates?.Any(d => d.Date == date.Date) == true;
    private bool IsToday(DateTime date) => date.Date == DateTime.Today;
    private bool IsOutsideMonth(DateTime date) => date.Month != DisplayMonth.Month;

    private bool IsRangeStart(DateTime date) => Mode == CalendarSelectionMode.Range && RangeStart.HasValue && RangeStart.Value.Date == date.Date;
    private bool IsRangeEnd(DateTime date) => Mode == CalendarSelectionMode.Range && RangeEnd.HasValue && RangeEnd.Value.Date == date.Date;
    private bool IsRangeMiddle(DateTime date)
    {
        if (Mode != CalendarSelectionMode.Range || !RangeStart.HasValue || !RangeEnd.HasValue) return false;
        return date.Date > RangeStart.Value.Date && date.Date < RangeEnd.Value.Date;
    }

    private bool IsSelectedSingle(DateTime date)
    {
        return Mode switch
        {
            CalendarSelectionMode.Single => IsSelected(date),
            CalendarSelectionMode.Multiple => IsMultiSelected(date),
            _ => false
        };
    }

    private bool IsAnySelected(DateTime? date)
    {
        if (!date.HasValue) return false;
        return IsSelectedSingle(date.Value) || IsRangeStart(date.Value) || IsRangeEnd(date.Value) || IsRangeMiddle(date.Value);
    }

    // --- Cell class (td) for range highlighting ---
    private string GetCellClass(DateTime? date)
    {
        var baseClass = "relative p-0 text-center text-sm";
        if (!date.HasValue) return baseClass;
        var d = date.Value;

        if (IsRangeStart(d) && IsRangeEnd(d))
            return Cn.Merge(baseClass);

        if (IsRangeStart(d))
            return Cn.Merge(baseClass, "rounded-l-md bg-accent");

        if (IsRangeEnd(d))
            return Cn.Merge(baseClass, "rounded-r-md bg-accent");

        if (IsRangeMiddle(d))
            return Cn.Merge(baseClass, "bg-accent");

        return baseClass;
    }

    // --- Day button class ---
    private string GetDayClass(DateTime date)
    {
        var isToday = IsToday(date);
        var outside = IsOutsideMonth(date);
        var disabled = IsDayDisabled(date);
        var booked = DisabledDates != null && DisabledDates.Any(dd => dd.Date == date.Date);

        return Cn.Merge(
            "inline-flex items-center justify-center size-9 rounded-md text-sm font-normal transition-colors",
            "hover:bg-accent hover:text-accent-foreground",
            "focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50",
            "disabled:pointer-events-none disabled:opacity-50",
            // Single / Multiple selected
            IsSelectedSingle(date) ? "bg-primary text-primary-foreground hover:bg-primary hover:text-primary-foreground" : "",
            // Range endpoints
            IsRangeStart(date) ? "bg-primary text-primary-foreground rounded-l-md hover:bg-primary hover:text-primary-foreground" : "",
            IsRangeEnd(date) ? "bg-primary text-primary-foreground rounded-r-md hover:bg-primary hover:text-primary-foreground" : "",
            // Range middle
            IsRangeMiddle(date) ? "bg-accent text-foreground rounded-none" : "",
            // Today highlight (when not selected)
            isToday && !IsSelectedSingle(date) && !IsRangeStart(date) && !IsRangeEnd(date) ? "bg-accent text-accent-foreground" : "",
            // Outside month
            outside ? "text-muted-foreground opacity-50" : "",
            // Booked dates get line-through
            booked ? "line-through" : "");
    }

    // --- Week grid ---
    private List<DateTime?[]> GetWeeks()
    {
        var weeks = new List<DateTime?[]>();
        var firstDay = new DateTime(DisplayMonth.Year, DisplayMonth.Month, 1);
        var lastDay = firstDay.AddMonths(1).AddDays(-1);

        var current = firstDay.AddDays(-(int)firstDay.DayOfWeek);

        while (current <= lastDay || current.DayOfWeek != DayOfWeek.Sunday)
        {
            var week = new DateTime?[7];
            for (var i = 0; i < 7; i++)
            {
                week[i] = current;
                current = current.AddDays(1);
            }
            weeks.Add(week);

            if (current > lastDay && current.DayOfWeek == DayOfWeek.Sunday)
                break;
        }

        return weeks;
    }

    // --- ISO week number ---
    private static int GetIsoWeekNumber(DateTime?[] week)
    {
        // Use the Thursday of the week to determine ISO week number
        var thursday = week.FirstOrDefault(d => d.HasValue && d.Value.DayOfWeek == DayOfWeek.Thursday);
        var refDate = thursday ?? week.FirstOrDefault(d => d.HasValue);
        if (!refDate.HasValue) return 0;
        return System.Globalization.ISOWeek.GetWeekOfYear(refDate.Value);
    }
}
