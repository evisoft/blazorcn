@namespace BlazorCN
@inherits ComponentBaseCn

<optgroup data-slot="native-select-optgroup" class="@Cn.Merge(Class)" label="@Label" @attributes="AdditionalAttributes">
    @ChildContent
</optgroup>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Label { get; set; }
}
