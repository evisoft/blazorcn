@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@WrapperCssClass"
     style="@Style"
     data-slot="native-select-wrapper"
     data-size="@SizeValue">
    <select data-slot="native-select"
            data-size="@SizeValue"
            class="@SelectCssClass"
            value="@Value"
            disabled="@Disabled"
            @onchange="HandleChange"
            @attributes="AdditionalAttributes">
        @ChildContent
    </select>
    <svg class="cn-native-select-icon pointer-events-none absolute select-none"
         aria-hidden="true"
         data-slot="native-select-icon"
         xmlns="http://www.w3.org/2000/svg"
         width="16"
         height="16"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round">
        <path d="m6 9 6 6 6-6" />
    </svg>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public NativeSelectSize Size { get; set; } = NativeSelectSize.Default;

    private string SizeValue => Size == NativeSelectSize.Sm ? "sm" : "default";

    private static readonly string WrapperBaseClasses =
        "group/native-select relative w-fit has-[select:disabled]:opacity-50";

    private static readonly string SelectBaseClasses =
        "cn-native-select disabled:pointer-events-none disabled:cursor-not-allowed outline-none";

    private string WrapperCssClass => Cn.Merge(WrapperBaseClasses, Class);
    private string SelectCssClass => SelectBaseClasses;

    private async Task HandleChange(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }
}
