@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

@* pointer-events-none: the popup + arrow straddle the trigger gap (and the enter
   animation slides them across it), so a hit-testable tooltip steals hover from
   the trigger → instant mouseleave → open/close loop. Our port has no
   hoverable-content grace logic, so the popup must be inert. *@
@if (Tooltip?.IsOpen == true)
{
    <div @ref="_contentRef"
         id="@(Tooltip?.ContentId)"
         class="@Cn.Merge("cn-tooltip-content z-50 w-fit max-w-xs origin-(--transform-origin) pointer-events-none bg-foreground text-background text-balance", Class)"
         style="@Style"
         role="tooltip"
         data-slot="tooltip-content"
         data-state="open"
         data-side="@Side.ToString().ToLowerInvariant()"
         data-align="@Align.ToString().ToLowerInvariant()"
         @attributes="AdditionalAttributes">
        @ChildContent
        <div class="cn-tooltip-arrow" data-slot="tooltip-arrow"></div>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public FloatingSide Side { get; set; } = FloatingSide.Top;
    [Parameter] public int SideOffset { get; set; } = 4;
    [Parameter] public FloatingAlign Align { get; set; } = FloatingAlign.Center;
    [Parameter] public int AlignOffset { get; set; }
    [CascadingParameter] public TooltipCn? Tooltip { get; set; }
    [Inject] private JsInteropCn JsInterop { get; set; } = default!;

    private ElementReference _contentRef;
    private readonly string _id = $"tooltip-{Guid.NewGuid():N}";
    private bool _jsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Tooltip?.IsOpen == true && !_jsInitialized)
        {
            _jsInitialized = true;
            try
            {
                await JsInterop.CreateFloatingAsync(Tooltip.TriggerElement, _contentRef, _id,
                    new FloatingOptions
                    {
                        Side = Side,
                        SideOffset = SideOffset,
                        Align = Align,
                        AlignOffset = AlignOffset
                    });
            }
            catch
            {
                _jsInitialized = false;
            }
        }
        else if (Tooltip?.IsOpen != true && _jsInitialized)
        {
            await CleanupJs();
        }
    }

    private async Task CleanupJs()
    {
        if (_jsInitialized)
        {
            try
            {
                await JsInterop.DestroyFloatingAsync(_id);
            }
            catch { /* Component may be disposed after circuit */ }
            _jsInitialized = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await CleanupJs();
    }
}
