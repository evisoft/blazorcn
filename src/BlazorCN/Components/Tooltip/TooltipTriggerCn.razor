@namespace BlazorCN
@inherits ComponentBaseCn

<span @ref="_triggerRef"
      class="@Class"
      style="@Style"
      data-slot="tooltip-trigger"
      @onmouseenter="HandleMouseEnter"
      @onmouseleave="HandleMouseLeave"
      @onfocus="HandleFocus"
      @onblur="HandleBlur"
      @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public TooltipCn? Tooltip { get; set; }

    private ElementReference _triggerRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (Tooltip is not null) Tooltip.TriggerElement = _triggerRef;
    }

    private void HandleMouseEnter()
    {
        Tooltip?.SetOpen(true);
    }

    private void HandleMouseLeave()
    {
        Tooltip?.SetOpen(false);
    }

    private void HandleFocus()
    {
        Tooltip?.SetOpen(true);
    }

    private void HandleBlur()
    {
        Tooltip?.SetOpen(false);
    }
}
