@namespace BlazorCN
@inherits ComponentBaseCn

<span @ref="_triggerRef"
      class="@Cn.Merge("cursor-default", Class)"
      tabindex="@(Tabbable ? "0" : null)"
      style="@Style"
      data-slot="tooltip-trigger"
      aria-describedby="@(Tooltip?.IsOpen == true ? Tooltip.ContentId : null)"
      @onmouseenter="HandleMouseEnter"
      @onmouseleave="HandleMouseLeave"
      @onfocus="HandleFocus"
      @onblur="HandleBlur"
      @onkeydown="HandleKeyDown"
      @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Set false when the trigger wraps an interactive element (e.g. a button)
    /// to avoid a duplicate tab stop; focus-open still works because Blazor delegates
    /// @onfocus in the capture phase, so the inner element's focus reaches this span.</summary>
    [Parameter] public bool Tabbable { get; set; } = true;

    [CascadingParameter] public TooltipCn? Tooltip { get; set; }

    private ElementReference _triggerRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (Tooltip is not null) Tooltip.TriggerElement = _triggerRef;
    }

    private async Task HandleMouseEnter()
    {
        if (Tooltip is not null) await Tooltip.RequestOpen();
    }

    private async Task HandleMouseLeave()
    {
        if (Tooltip is not null) await Tooltip.RequestClose();
    }

    private async Task HandleFocus()
    {
        if (Tooltip is not null) await Tooltip.RequestOpen();
    }

    private async Task HandleBlur()
    {
        if (Tooltip is not null) await Tooltip.RequestClose();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        // WCAG 1.4.13: content on hover/focus must be dismissable without moving
        // pointer or focus. Keydown from a wrapped interactive child bubbles here.
        if (e.Key == "Escape") Tooltip?.ForceClose();
    }
}
