@namespace BlazorCN
@inherits ComponentBaseCn

@* Renders NO DOM element, matching shadcn/Radix where TooltipProvider is a context provider
   (original/.../ui/tooltip.tsx:6). Wrapping the children in a div would inject a stray box
   into every layout that uses it. *@
<CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Default open delay in milliseconds for descendant tooltips that do not set their own
    /// <see cref="TooltipCn.OpenDelay"/>. Matches shadcn's <c>TooltipProvider delay</c> prop.
    /// </summary>
    [Parameter] public int Delay { get; set; }

    /// <summary>
    /// Default close delay in milliseconds for descendant tooltips that do not set their own
    /// <see cref="TooltipCn.CloseDelay"/>.
    /// </summary>
    [Parameter] public int CloseDelay { get; set; }
}
