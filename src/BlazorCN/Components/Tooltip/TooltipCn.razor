@namespace BlazorCN
@inherits ComponentBaseCn
@implements IDisposable

<div class="@Cn.Merge("relative inline-block", Class)" style="@Style" data-slot="tooltip" data-state="@(IsOpen ? "open" : "closed")" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    // shadcn's TooltipProvider sets delayDuration=0; Radix's primitive default of 700 is opt-in.
    [Parameter] public int OpenDelay { get; set; }
    [Parameter] public int CloseDelay { get; set; }

    /// <summary>Optional ancestor provider supplying default delays (shadcn's TooltipProvider).</summary>
    [CascadingParameter] public TooltipProviderCn? Provider { get; set; }

    // A tooltip's own delay wins; otherwise inherit the provider's. Both default to 0, so
    // behaviour is unchanged unless a consumer opts in.
    private int EffectiveOpenDelay => OpenDelay > 0 ? OpenDelay : (Provider?.Delay ?? 0);
    private int EffectiveCloseDelay => CloseDelay > 0 ? CloseDelay : (Provider?.CloseDelay ?? 0);

    internal bool IsOpen { get; private set; }
    internal ElementReference TriggerElement { get; set; }
    internal string ContentId { get; } = $"tooltip-content-{Guid.NewGuid():N}";

    private CancellationTokenSource? _openCts;
    private CancellationTokenSource? _closeCts;

    internal async Task RequestOpen()
    {
        _closeCts?.Cancel();
        _closeCts?.Dispose();
        _closeCts = null;

        if (IsOpen) return;

        _openCts?.Cancel();
        _openCts?.Dispose();
        _openCts = new CancellationTokenSource();
        var token = _openCts.Token;

        try
        {
            await Task.Delay(EffectiveOpenDelay, token);
            if (!token.IsCancellationRequested)
            {
                IsOpen = true;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

    internal async Task RequestClose()
    {
        _openCts?.Cancel();
        _openCts?.Dispose();
        _openCts = null;

        if (!IsOpen) return;

        if (EffectiveCloseDelay <= 0)
        {
            IsOpen = false;
            StateHasChanged();
            return;
        }

        _closeCts?.Cancel();
        _closeCts?.Dispose();
        _closeCts = new CancellationTokenSource();
        var token = _closeCts.Token;

        try
        {
            await Task.Delay(EffectiveCloseDelay, token);
            if (!token.IsCancellationRequested)
            {
                IsOpen = false;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

    /// <summary>Immediately hides the tooltip (WCAG 1.4.13 Escape dismissal), bypassing CloseDelay.</summary>
    internal void ForceClose()
    {
        _openCts?.Cancel();
        _openCts?.Dispose();
        _openCts = null;
        _closeCts?.Cancel();
        _closeCts?.Dispose();
        _closeCts = null;

        if (!IsOpen) return;
        IsOpen = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        _openCts?.Cancel();
        _openCts?.Dispose();
        _closeCts?.Cancel();
        _closeCts?.Dispose();
    }
}
