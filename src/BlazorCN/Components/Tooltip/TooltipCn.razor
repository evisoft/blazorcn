@namespace BlazorCN
@inherits ComponentBaseCn
@implements IDisposable

<div class="@Cn.Merge("relative inline-block", Class)" style="@Style" data-slot="tooltip" data-state="@(IsOpen ? "open" : "closed")" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int OpenDelay { get; set; } = 700;
    [Parameter] public int CloseDelay { get; set; } = 0;

    internal bool IsOpen { get; private set; }
    internal ElementReference TriggerElement { get; set; }

    private CancellationTokenSource? _openCts;
    private CancellationTokenSource? _closeCts;

    internal async Task RequestOpen()
    {
        _closeCts?.Cancel();
        _closeCts?.Dispose();
        _closeCts = null;

        if (IsOpen) return;

        _openCts?.Cancel();
        _openCts?.Dispose();
        _openCts = new CancellationTokenSource();
        var token = _openCts.Token;

        try
        {
            await Task.Delay(OpenDelay, token);
            if (!token.IsCancellationRequested)
            {
                IsOpen = true;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

    internal async Task RequestClose()
    {
        _openCts?.Cancel();
        _openCts?.Dispose();
        _openCts = null;

        if (!IsOpen) return;

        if (CloseDelay <= 0)
        {
            IsOpen = false;
            StateHasChanged();
            return;
        }

        _closeCts?.Cancel();
        _closeCts?.Dispose();
        _closeCts = new CancellationTokenSource();
        var token = _closeCts.Token;

        try
        {
            await Task.Delay(CloseDelay, token);
            if (!token.IsCancellationRequested)
            {
                IsOpen = false;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

    public void Dispose()
    {
        _openCts?.Cancel();
        _openCts?.Dispose();
        _closeCts?.Cancel();
        _closeCts?.Dispose();
    }
}
