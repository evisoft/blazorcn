@namespace BlazorCN
@inherits ComponentBaseCn

<button @ref="_triggerRef" type="button" class="@Cn.Merge("inline-flex", Class)" style="@Style" data-slot="popover-trigger" aria-expanded="@(Popover?.IsOpen == true ? "true" : "false")" @onclick="Toggle" @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public PopoverCn? Popover { get; set; }

    private ElementReference _triggerRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (Popover is not null) Popover.TriggerElement = _triggerRef;
    }

    private async Task Toggle()
    {
        if (Popover is not null) await Popover.ToggleOpen();
    }
}
