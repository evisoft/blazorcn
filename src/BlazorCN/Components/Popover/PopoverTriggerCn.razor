@namespace BlazorCN
@inherits ComponentBaseCn

<span @ref="_triggerRef" class="@Class" style="@Style" data-slot="popover-trigger" @onclick="Toggle" @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public PopoverCn? Popover { get; set; }

    private ElementReference _triggerRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (Popover is not null) Popover.TriggerElement = _triggerRef;
    }

    private async Task Toggle()
    {
        if (Popover is not null) await Popover.ToggleOpen();
    }
}
