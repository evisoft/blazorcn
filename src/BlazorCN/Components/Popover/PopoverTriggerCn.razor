@namespace BlazorCN
@inherits ComponentBaseCn

<button @ref="_triggerRef" type="button" class="@Cn.Merge("inline-flex", Class)" style="@Style" data-slot="popover-trigger" data-state="@(Popover?.IsOpen == true ? "open" : "closed")" aria-haspopup="dialog" aria-expanded="@(Popover?.IsOpen == true ? "true" : "false")" aria-controls="@(Popover?.IsOpen == true ? Popover.ContentId : null)" @onclick="Toggle" @onkeydown="HandleKeyDown" @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public PopoverCn? Popover { get; set; }

    private ElementReference _triggerRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (Popover is not null) Popover.TriggerElement = _triggerRef;
    }

    private async Task Toggle()
    {
        if (Popover is not null) await Popover.ToggleOpen();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Escape must work even when focus never left the trigger (default keyboard flow).
        if (e.Key == "Escape" && Popover?.IsOpen == true)
            await Popover.SetOpen(false);
    }
}
