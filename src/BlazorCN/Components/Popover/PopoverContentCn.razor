@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

@if (Popover?.IsOpen == true)
{
    <div @ref="_contentRef"
         id="@(Popover?.ContentId)"
         class="@Cn.Merge("cn-popover-content z-50 w-72 outline-hidden", Class)"
         style="@Style"
         data-slot="popover-content"
         data-state="open"
         data-side="@Side.ToString().ToLowerInvariant()"
         data-align="@Align.ToString().ToLowerInvariant()"
         role="dialog"
         tabindex="-1"
         @onkeydown="HandleKeyDown"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public FloatingSide Side { get; set; } = FloatingSide.Bottom;
    [Parameter] public int SideOffset { get; set; } = 4;
    [Parameter] public FloatingAlign Align { get; set; } = FloatingAlign.Center;
    [Parameter] public int AlignOffset { get; set; }
    [CascadingParameter] public PopoverCn? Popover { get; set; }
    [Inject] private JsInteropCn JsInterop { get; set; } = default!;

    private ElementReference _contentRef;
    private readonly string _id = $"popover-{Guid.NewGuid():N}";
    private readonly string _outsideClickId = $"popover-outside-{Guid.NewGuid():N}";
    private DotNetObjectReference<PopoverContentCn>? _dotnetRef;
    private bool _jsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Popover?.IsOpen == true && !_jsInitialized)
        {
            _jsInitialized = true;
            try
            {
                _dotnetRef = DotNetObjectReference.Create(this);
                await JsInterop.CreateFloatingAsync(Popover.TriggerElement, _contentRef, _id,
                    new FloatingOptions
                    {
                        Side = Side,
                        SideOffset = SideOffset,
                        Align = Align,
                        AlignOffset = AlignOffset
                    });
                await JsInterop.OnOutsideClickAsync(_contentRef, _outsideClickId, _dotnetRef, "OnOutsideClick", Popover?.TriggerElement);
            }
            catch
            {
                _jsInitialized = false;
                _dotnetRef?.Dispose();
                _dotnetRef = null;
            }
            if (_jsInitialized)
            {
                // Radix onOpenAutoFocus parity: move focus into the popup so Escape
                // (handled on the content) works immediately after opening.
                try { await _contentRef.FocusAsync(); } catch { }
            }
        }
        else if (Popover?.IsOpen != true && _jsInitialized)
        {
            await CleanupJs();
        }
    }

    [JSInvokable]
    public async Task OnOutsideClick()
    {
        if (Popover is not null) await Popover.SetOpen(false);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && Popover is not null)
        {
            await Popover.SetOpen(false);
            // Focus was inside the popup; return it to the trigger (Radix parity).
            // Deliberately NOT done on outside-click close, which would steal focus
            // from whatever the user clicked.
            try { await Popover.TriggerElement.FocusAsync(); } catch { }
        }
    }

    private async Task CleanupJs()
    {
        if (_jsInitialized)
        {
            try
            {
                await JsInterop.DestroyFloatingAsync(_id);
                await JsInterop.CleanupAsync(_outsideClickId);
            }
            catch { /* Component may be disposed after circuit */ }
            _jsInitialized = false;
            _dotnetRef?.Dispose();
            _dotnetRef = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await CleanupJs();
    }
}
