@namespace BlazorCN
@inherits ComponentBaseCn

@* role=alert (assertive) is reserved for Error/Warning; routine toasts announce
   politely as role=status — mirrors sonner. Hover/focus pause the auto-dismiss
   countdown via the Toaster-supplied callbacks (WCAG 2.2.1). *@
<div class="@Cn.Merge(DefaultClasses, Class)"
     style="@Style"
     data-slot="toast"
     data-variant="@Message.Variant.ToString().ToLowerInvariant()"
     role="@(IsImportant ? "alert" : "status")"
     aria-live="@(IsImportant ? "assertive" : "polite")"
     aria-atomic="true"
     @onmouseenter="() => OnPause.InvokeAsync(Message.Id)"
     @onmouseleave="() => OnResume.InvokeAsync(Message.Id)"
     @onfocusin="() => OnFocusIn.InvokeAsync(Message.Id)"
     @onfocusout="() => OnFocusOut.InvokeAsync(Message.Id)"
     @attributes="AdditionalAttributes">
    @switch (Message.Variant)
    {
        case ToastVariant.Success:
            <LucideCircleCheckCn Size="16" Class="size-4 shrink-0" />
            break;
        case ToastVariant.Info:
            <LucideInfoCn Size="16" Class="size-4 shrink-0" />
            break;
        case ToastVariant.Warning:
            <LucideTriangleAlertCn Size="16" Class="size-4 shrink-0" />
            break;
        case ToastVariant.Error:
            <LucideOctagonXCn Size="16" Class="size-4 shrink-0" />
            break;
        case ToastVariant.Loading:
            <SpinnerCn Class="size-4 shrink-0 animate-spin" />
            break;
    }
    <div class="@(CloseButton ? "flex-1 pr-6" : "flex-1")">
        @if (Message.Title is not null)
        {
            <div class="text-sm font-semibold" data-slot="toast-title">@Message.Title</div>
        }
        <div class="text-sm" data-slot="toast-description">@Message.Message</div>
    </div>
    @if (CloseButton)
    {
        <button type="button"
                class="absolute top-2 right-2 rounded-md p-1 opacity-0 transition-opacity group-hover:opacity-100 focus:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                data-slot="toast-close"
                @onclick="HandleDismiss">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 6 18"/>
                <path d="m6 6 12 12"/>
            </svg>
            <span class="sr-only">Close</span>
        </button>
    }
</div>

@code {
    [Parameter] public ToastMessage Message { get; set; } = default!;
    [Parameter] public EventCallback<string> OnDismiss { get; set; }

    /// <summary>Invoked with the toast id when the pointer enters the toast —
    /// the Toaster pauses the auto-dismiss countdown.</summary>
    [Parameter] public EventCallback<string> OnPause { get; set; }

    /// <summary>Invoked with the toast id when the pointer leaves the toast —
    /// the Toaster resumes the auto-dismiss countdown.</summary>
    [Parameter] public EventCallback<string> OnResume { get; set; }

    /// <summary>Invoked with the toast id when focus enters the toast — pauses
    /// the countdown and lets the Toaster track where keyboard focus lives.</summary>
    [Parameter] public EventCallback<string> OnFocusIn { get; set; }

    /// <summary>Invoked with the toast id when focus leaves the toast.</summary>
    [Parameter] public EventCallback<string> OnFocusOut { get; set; }

    private bool IsImportant => Message.Variant is ToastVariant.Error or ToastVariant.Warning;

    /// <summary>
    /// Shows a hover-revealed close button. Off by default to match the shadcn
    /// Toaster, which never enables Sonner's closeButton option.
    /// </summary>
    [Parameter] public bool CloseButton { get; set; }

    // All toast types share the popover surface (.cn-toast supplies bg-popover/
    // text-popover-foreground/border-border), matching shadcn's sonner without
    // richColors. Type is conveyed by the leading icon only — no tinted backgrounds.
    private const string DefaultClasses =
        "cn-toast group pointer-events-auto relative flex w-full items-center justify-between gap-3 overflow-hidden border p-4 shadow-lg transition-all";

    private async Task HandleDismiss()
    {
        await OnDismiss.InvokeAsync(Message.Id);
    }
}
