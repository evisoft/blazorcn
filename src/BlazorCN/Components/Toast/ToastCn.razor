@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge(DefaultClasses, VariantClasses, Class)"
     style="@Style"
     data-slot="toast"
     data-variant="@Message.Variant.ToString().ToLowerInvariant()"
     role="alert"
     @attributes="AdditionalAttributes">
    <div class="flex-1">
        @if (Message.Title is not null)
        {
            <div class="text-sm font-semibold" data-slot="toast-title">@Message.Title</div>
        }
        <div class="text-sm" data-slot="toast-description">@Message.Message</div>
    </div>
    <button type="button"
            class="absolute top-2 right-2 rounded-md p-1 opacity-0 transition-opacity group-hover:opacity-100 focus:opacity-100 focus:outline-none"
            data-slot="toast-close"
            @onclick="HandleDismiss">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18"/>
            <path d="m6 6 12 12"/>
        </svg>
        <span class="sr-only">Close</span>
    </button>
</div>

@code {
    [Parameter] public ToastMessage Message { get; set; } = default!;
    [Parameter] public EventCallback<string> OnDismiss { get; set; }

    private const string DefaultClasses =
        "cn-toast group pointer-events-auto relative flex w-full items-center justify-between gap-4 overflow-hidden border p-4 shadow-lg transition-all";

    private string VariantClasses => Message.Variant switch
    {
        ToastVariant.Success => "border-green-500/50 bg-green-50 text-green-900 dark:bg-green-950 dark:text-green-100",
        ToastVariant.Error => "border-destructive/50 bg-destructive text-destructive-foreground",
        ToastVariant.Warning => "border-yellow-500/50 bg-yellow-50 text-yellow-900 dark:bg-yellow-950 dark:text-yellow-100",
        ToastVariant.Info => "border-blue-500/50 bg-blue-50 text-blue-900 dark:bg-blue-950 dark:text-blue-100",
        _ => "border bg-background text-foreground"
    };

    private async Task HandleDismiss()
    {
        await OnDismiss.InvokeAsync(Message.Id);
    }
}
