@namespace BlazorCN
@inherits ComponentBaseCn
@implements IDisposable
@inject ToastService ToastService

<div class="@Cn.Merge("fixed top-0 right-0 z-[100] flex max-h-screen w-full flex-col-reverse p-4 sm:right-0 sm:top-auto sm:bottom-0 sm:flex-col md:max-w-[420px]", Class)"
     style="@Style"
     data-slot="toaster"
     @attributes="AdditionalAttributes">
    @foreach (var toast in _toasts)
    {
        <ToastCn @key="toast.Id" Message="@toast" OnDismiss="RemoveToast" />
    }
</div>

@code {
    private readonly List<ToastMessage> _toasts = new();
    private readonly Dictionary<string, CancellationTokenSource> _timers = new();

    protected override void OnInitialized()
    {
        ToastService.OnShow += HandleShow;
    }

    private void HandleShow(ToastMessage message)
    {
        InvokeAsync(() =>
        {
            _toasts.Add(message);
            StateHasChanged();
            _ = AutoDismissAsync(message);
        });
    }

    private async Task AutoDismissAsync(ToastMessage message)
    {
        var cts = new CancellationTokenSource();
        _timers[message.Id] = cts;
        try
        {
            await Task.Delay(message.DurationMs, cts.Token);
            await InvokeAsync(() => RemoveToast(message.Id));
        }
        catch (TaskCanceledException) { }
    }

    internal void RemoveToast(string id)
    {
        _toasts.RemoveAll(t => t.Id == id);
        if (_timers.Remove(id, out var cts))
        {
            cts.Cancel();
            cts.Dispose();
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        ToastService.OnShow -= HandleShow;
        foreach (var cts in _timers.Values)
        {
            cts.Cancel();
            cts.Dispose();
        }
        _timers.Clear();
    }
}
