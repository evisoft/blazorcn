@namespace BlazorCN
@inherits ComponentBaseCn

@if (Drawer?.IsOpen == true)
{
    <div class="@Cn.Merge("cn-drawer-overlay fixed inset-0 z-50", Class)"
         style="@Style"
         data-slot="drawer-overlay"
         data-state="open"
         @onclick="HandleClick"
         @attributes="AdditionalAttributes">
    </div>
}

@code {
    [CascadingParameter] private DrawerCn? Drawer { get; set; }

    private async Task HandleClick()
    {
        if (Drawer is not null) await Drawer.SetOpen(false);
    }
}
