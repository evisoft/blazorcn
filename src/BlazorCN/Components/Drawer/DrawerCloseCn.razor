@namespace BlazorCN
@inherits ComponentBaseCn

<button class="@Class" style="@Style" type="button" data-slot="drawer-close" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private DrawerCn? Drawer { get; set; }

    private async Task HandleClick()
    {
        if (Drawer is not null) await Drawer.SetOpen(false);
    }
}
