@namespace BlazorCN
@inherits ComponentBaseCn

<button class="@Class" style="@Style" type="button" data-slot="drawer-trigger" data-state="@(Drawer?.IsOpen == true ? "open" : "closed")" aria-haspopup="dialog" aria-expanded="@(Drawer?.IsOpen == true ? "true" : "false")" aria-controls="@(Drawer?.IsOpen == true ? Drawer.ContentId : null)" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private DrawerCn? Drawer { get; set; }

    private async Task HandleClick()
    {
        if (Drawer is not null) await Drawer.SetOpen(true);
    }
}
