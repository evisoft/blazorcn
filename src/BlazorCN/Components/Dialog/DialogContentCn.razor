@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

@if (Dialog?.IsOpen == true)
{
    <div @ref="_element"
         class="@Cn.Merge("fixed top-1/2 left-1/2 z-50 grid w-full max-w-lg -translate-x-1/2 -translate-y-1/2 gap-4 border bg-background p-6 shadow-lg sm:rounded-lg", Class)"
         style="@Style"
         data-slot="dialog-content"
         data-state="open"
         role="dialog"
         aria-modal="true"
         tabindex="-1"
         @onkeydown="HandleKeyDown"
         @attributes="AdditionalAttributes">
        @ChildContent
        <button type="button"
                class="absolute top-4 right-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:ring-2 focus:ring-ring focus:ring-offset-2 focus:outline-none disabled:pointer-events-none"
                data-slot="dialog-close"
                @onclick="HandleClose">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
            </svg>
            <span class="sr-only">Close</span>
        </button>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private DialogCn? Dialog { get; set; }
    [Inject] private JsInteropCn JsInterop { get; set; } = default!;

    private ElementReference _element;
    private string _id = $"dialog-content-{Guid.NewGuid():N}";
    private bool _jsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Dialog?.IsOpen == true && !_jsInitialized)
        {
            _jsInitialized = true;
            try
            {
                await JsInterop.TrapFocusAsync(_element, _id);
                await JsInterop.LockScrollAsync(_id);
            }
            catch
            {
                _jsInitialized = false;
            }
        }
        else if (Dialog?.IsOpen != true && _jsInitialized)
        {
            _jsInitialized = false;
            try { await JsInterop.CleanupAsync(_id); } catch { }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && Dialog is not null)
        {
            await Dialog.SetOpen(false);
        }
    }

    private async Task HandleClose()
    {
        if (Dialog is not null) await Dialog.SetOpen(false);
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsInitialized)
        {
            _jsInitialized = false;
            try { await JsInterop.CleanupAsync(_id); } catch { }
        }
    }
}
