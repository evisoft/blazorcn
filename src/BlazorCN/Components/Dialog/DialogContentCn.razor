@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

@if (Dialog?.IsOpen == true)
{
    <div class="cn-dialog-overlay fixed inset-0 z-50"
         data-slot="dialog-overlay"
         data-state="open"
         @onclick="HandleOverlayClick">
    </div>
    <div @ref="_element"
         class="@Cn.Merge("cn-dialog-content fixed top-1/2 left-1/2 z-50 w-full -translate-x-1/2 -translate-y-1/2", Class)"
         style="@Style"
         data-slot="dialog-content"
         data-state="open"
         role="dialog"
         aria-modal="true"
         aria-labelledby="@(_titleLink.IsLinked ? _titleLink.Id : null)"
         aria-label="@(!_titleLink.IsLinked ? "Dialog" : null)"
         tabindex="-1"
         @onkeydown="HandleKeyDown"
         @attributes="AdditionalAttributes">
        <CascadingValue Value="@_titleLink" Name="ContentTitleLink" IsFixed="true">
            @ChildContent
        </CascadingValue>
        @if (ShowCloseButton)
        {
            <button type="button"
                    class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon-sm cn-dialog-close"
                    data-slot="dialog-close"
                    @onclick="HandleClose">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                </svg>
                <span class="sr-only">Close</span>
            </button>
        }
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [CascadingParameter] private DialogCn? Dialog { get; set; }
    [Inject] private JsInteropCn JsInterop { get; set; } = default!;

    private ElementReference _element;
    private string _id = $"dialog-content-{Guid.NewGuid():N}";
    private TitleLink _titleLink = new($"dialog-title-{Guid.NewGuid():N}");
    private bool _titleLinked;
    private bool _jsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_titleLink.IsLinked && !_titleLinked)
        {
            _titleLinked = true;
            StateHasChanged();
            return;
        }

        if (Dialog?.IsOpen == true && !_jsInitialized)
        {
            _jsInitialized = true;
            try
            {
                await JsInterop.TrapFocusAsync(_element, _id);
                await JsInterop.LockScrollAsync(_id);
            }
            catch
            {
                _jsInitialized = false;
            }
        }
        else if (Dialog?.IsOpen != true && _jsInitialized)
        {
            _jsInitialized = false;
            try { await JsInterop.CleanupAsync(_id); } catch { }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && Dialog is not null)
        {
            await Dialog.SetOpen(false);
        }
    }

    private async Task HandleClose()
    {
        if (Dialog is not null) await Dialog.SetOpen(false);
    }

    private async Task HandleOverlayClick()
    {
        if (Dialog is not null) await Dialog.SetOpen(false);
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsInitialized)
        {
            _jsInitialized = false;
            try { await JsInterop.CleanupAsync(_id); } catch { }
        }
    }
}
