@namespace BlazorCN
@inherits ComponentBaseCn

@if (Dialog?.IsOpen == true)
{
    <div class="@Cn.Merge("fixed inset-0 z-50 bg-black/50 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=closed]:animate-out data-[state=closed]:fade-out-0", Class)"
         style="@Style"
         data-slot="dialog-overlay"
         data-state="open"
         @onclick="HandleClick"
         @attributes="AdditionalAttributes">
    </div>
}

@code {
    [CascadingParameter] private DialogCn? Dialog { get; set; }

    private async Task HandleClick()
    {
        if (Dialog is not null) await Dialog.SetOpen(false);
    }
}
