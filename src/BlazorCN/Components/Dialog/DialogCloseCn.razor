@namespace BlazorCN
@inherits ComponentBaseCn

<button class="@Class" style="@Style" type="button" data-slot="dialog-close" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private DialogCn? Dialog { get; set; }

    private async Task HandleClick()
    {
        if (Dialog is not null) await Dialog.SetOpen(false);
    }
}
