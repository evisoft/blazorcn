@namespace BlazorCN
@inherits ComponentBaseCn

<button class="@Class" style="@Style" type="button" data-slot="dialog-trigger" data-state="@(Dialog?.IsOpen == true ? "open" : "closed")" aria-haspopup="dialog" aria-expanded="@(Dialog?.IsOpen == true ? "true" : "false")" aria-controls="@(Dialog?.IsOpen == true ? Dialog.ContentId : null)" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private DialogCn? Dialog { get; set; }

    private async Task HandleClick()
    {
        if (Dialog is not null) await Dialog.SetOpen(true);
    }
}
