@namespace BlazorCN
@inherits ComponentBaseCn

@if (Variant == EmptyMediaVariant.Icon)
{
    <div class="@Cn.Merge("cn-empty-media cn-empty-media-icon", Class)"
         style="@Style"
         data-slot="empty-icon"
         data-variant="icon"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}
else
{
    <div class="@Cn.Merge("cn-empty-media cn-empty-media-default flex items-center justify-center", Class)"
         style="@Style"
         data-slot="empty-icon"
         data-variant="default"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EmptyMediaVariant Variant { get; set; } = EmptyMediaVariant.Default;
}
