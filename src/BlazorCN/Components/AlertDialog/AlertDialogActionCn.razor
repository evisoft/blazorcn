@namespace BlazorCN
@inherits ComponentBaseCn

<button class="@Class" style="@Style" type="button" data-slot="alert-dialog-action" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [CascadingParameter] private AlertDialogCn? AlertDialog { get; set; }

    private async Task HandleClick()
    {
        await OnClick.InvokeAsync();
        if (AlertDialog is not null) await AlertDialog.SetOpen(false);
    }
}
