@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Class" style="@Style" data-slot="alert-dialog" data-state="@(IsOpen ? "open" : "closed")" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    internal bool IsOpen { get; private set; }
    internal string ContentId { get; } = $"alert-dialog-content-{Guid.NewGuid():N}";
    internal bool HasExplicitOverlay { get; set; }

    protected override void OnInitialized() => IsOpen = Open;
    protected override void OnParametersSet()
    {
        if (Open != IsOpen)
            IsOpen = Open;
    }

    internal async Task SetOpen(bool open)
    {
        IsOpen = open;
        await OpenChanged.InvokeAsync(IsOpen);
        StateHasChanged();
    }
}
