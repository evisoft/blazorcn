@namespace BlazorCN
@inherits ComponentBaseCn

<button class="@Class" style="@Style" type="button" data-slot="alert-dialog-trigger" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private AlertDialogCn? AlertDialog { get; set; }

    private async Task HandleClick()
    {
        if (AlertDialog is not null) await AlertDialog.SetOpen(true);
    }
}
