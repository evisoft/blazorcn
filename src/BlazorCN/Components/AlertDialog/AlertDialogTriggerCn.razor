@namespace BlazorCN
@inherits ComponentBaseCn

<button class="@Class" style="@Style" type="button" data-slot="alert-dialog-trigger" data-state="@(AlertDialog?.IsOpen == true ? "open" : "closed")" aria-haspopup="dialog" aria-expanded="@(AlertDialog?.IsOpen == true ? "true" : "false")" aria-controls="@(AlertDialog?.IsOpen == true ? AlertDialog.ContentId : null)" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private AlertDialogCn? AlertDialog { get; set; }

    private async Task HandleClick()
    {
        if (AlertDialog is not null) await AlertDialog.SetOpen(true);
    }
}
