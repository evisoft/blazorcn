@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

@if (AlertDialog?.IsOpen == true)
{
    <div @ref="_element"
         class="@Cn.Merge("fixed top-1/2 left-1/2 z-50 grid w-full max-w-lg -translate-x-1/2 -translate-y-1/2 gap-4 border bg-background p-6 shadow-lg sm:rounded-lg", Class)"
         style="@Style"
         data-slot="alert-dialog-content"
         data-state="open"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private AlertDialogCn? AlertDialog { get; set; }
    [Inject] private JsInteropCn JsInterop { get; set; } = default!;

    private ElementReference _element;
    private string _id = $"alert-dialog-content-{Guid.NewGuid():N}";
    private bool _jsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (AlertDialog?.IsOpen == true && !_jsInitialized)
        {
            await JsInterop.TrapFocusAsync(_element, _id);
            await JsInterop.LockScrollAsync(_id);
            _jsInitialized = true;
        }
        else if (AlertDialog?.IsOpen != true && _jsInitialized)
        {
            await JsInterop.CleanupAsync(_id);
            _jsInitialized = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsInitialized)
        {
            try { await JsInterop.CleanupAsync(_id); } catch { /* Component may be disposed after circuit */ }
        }
    }
}
