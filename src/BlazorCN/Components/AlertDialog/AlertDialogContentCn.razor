@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

@if (AlertDialog?.IsOpen == true)
{
    <div @ref="_element"
         class="@Cn.Merge("cn-alert-dialog-content fixed top-1/2 left-1/2 z-50 w-full -translate-x-1/2 -translate-y-1/2 group/alert-dialog-content", Class)"
         style="@Style"
         data-slot="alert-dialog-content"
         data-state="open"
         role="alertdialog"
         aria-modal="true"
         aria-labelledby="@(_titleLink.IsLinked ? _titleLink.Id : null)"
         aria-label="@(!_titleLink.IsLinked ? "Alert" : null)"
         tabindex="-1"
         @attributes="AdditionalAttributes">
        <CascadingValue Value="@_titleLink" Name="ContentTitleLink" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private AlertDialogCn? AlertDialog { get; set; }
    [Inject] private JsInteropCn JsInterop { get; set; } = default!;

    private ElementReference _element;
    private string _id = $"alert-dialog-content-{Guid.NewGuid():N}";
    private TitleLink _titleLink = new($"alert-dialog-title-{Guid.NewGuid():N}");
    private bool _titleLinked;
    private bool _jsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_titleLink.IsLinked && !_titleLinked)
        {
            _titleLinked = true;
            StateHasChanged();
            return;
        }

        if (AlertDialog?.IsOpen == true && !_jsInitialized)
        {
            _jsInitialized = true;
            try
            {
                await JsInterop.TrapFocusAsync(_element, _id);
                await JsInterop.LockScrollAsync(_id);
            }
            catch
            {
                _jsInitialized = false;
            }
        }
        else if (AlertDialog?.IsOpen != true && _jsInitialized)
        {
            _jsInitialized = false;
            try { await JsInterop.CleanupAsync(_id); } catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsInitialized)
        {
            _jsInitialized = false;
            try { await JsInterop.CleanupAsync(_id); } catch { }
        }
    }
}
