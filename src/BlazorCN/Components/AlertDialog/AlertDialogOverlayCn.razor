@namespace BlazorCN
@inherits ComponentBaseCn

@if (AlertDialog?.IsOpen == true)
{
    <div class="@Cn.Merge("fixed inset-0 z-50 bg-black/50", Class)"
         style="@Style"
         data-slot="alert-dialog-overlay"
         data-state="open"
         @attributes="AdditionalAttributes">
    </div>
}

@code {
    [CascadingParameter] private AlertDialogCn? AlertDialog { get; set; }
}
