@namespace BlazorCN
@inherits ComponentBaseCn

@if (AlertDialog?.IsOpen == true)
{
    <div class="@Cn.Merge("cn-alert-dialog-overlay fixed inset-0 z-50", Class)"
         style="@Style"
         data-slot="alert-dialog-overlay"
         data-state="open"
         @attributes="AdditionalAttributes">
    </div>
}

@code {
    [CascadingParameter] private AlertDialogCn? AlertDialog { get; set; }

    protected override void OnInitialized()
    {
        // Tell the content not to render its built-in backdrop — this one replaces it.
        if (AlertDialog is not null) AlertDialog.HasExplicitOverlay = true;
    }
}
