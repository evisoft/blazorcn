@namespace BlazorCN
@inherits ComponentBaseCn

<button class="@CssClass" style="@Style" type="button" data-slot="alert-dialog-cancel" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private AlertDialogCn? AlertDialog { get; set; }

    private static readonly string BaseClasses = "cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-outline cn-button-size-default";
    private string CssClass => Cn.Merge(BaseClasses, Class);

    private async Task HandleClick()
    {
        if (AlertDialog is not null) await AlertDialog.SetOpen(false);
    }
}
