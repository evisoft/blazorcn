@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("cn-item-content flex flex-1 flex-col [&+[data-slot=item-content]]:flex-none", Class)"
     style="@Style"
     data-slot="item-content"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
