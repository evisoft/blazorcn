@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@CssClass"
     style="@Style"
     data-slot="item"
     data-variant="@Variant.ToString().ToLowerInvariant()"
     data-size="@Size.ToString().ToLowerInvariant()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public ItemVariant Variant { get; set; } = ItemVariant.Default;
    [Parameter] public ItemSize Size { get; set; } = ItemSize.Default;

    private static readonly Cva<ItemVariant, ItemSize> Variants = new(
        @"cn-item group/item flex w-full flex-wrap items-center transition-colors duration-100 outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 [a]:transition-colors",
        new()
        {
            [ItemVariant.Default] = "cn-item-variant-default",
            [ItemVariant.Outline] = "cn-item-variant-outline",
            [ItemVariant.Muted] = "cn-item-variant-muted",
        },
        new()
        {
            [ItemSize.Default] = "cn-item-size-default",
            [ItemSize.Sm] = "cn-item-size-sm",
            [ItemSize.Xs] = "cn-item-size-xs",
        });

    private string CssClass => Variants.Apply(Variant, Size, Class);
}
