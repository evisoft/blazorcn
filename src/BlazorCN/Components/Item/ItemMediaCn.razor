@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@CssClass"
     style="@Style"
     data-slot="item-media"
     data-variant="@Variant.ToString().ToLowerInvariant()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public ItemMediaVariant Variant { get; set; } = ItemMediaVariant.Default;

    private static readonly Cva<ItemMediaVariant> Variants = new(
        @"cn-item-media flex shrink-0 items-center justify-center [&_svg]:pointer-events-none",
        new()
        {
            [ItemMediaVariant.Default] = "cn-item-media-variant-default",
            [ItemMediaVariant.Icon] = "cn-item-media-variant-icon",
            [ItemMediaVariant.Image] = "cn-item-media-variant-image overflow-hidden",
        });

    private string CssClass => Variants.Apply(Variant, Class);
}
