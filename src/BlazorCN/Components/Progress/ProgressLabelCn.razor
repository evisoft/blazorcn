@namespace BlazorCN
@inherits ComponentBaseCn

<span class="@Cn.Merge("cn-progress-label", Class)"
      style="@Style"
      id="@(Progress?.LabelId)"
      data-slot="progress-label"
      @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private ProgressCn? Progress { get; set; }

    // Tells the root to stamp aria-labelledby (mirrors Base UI's automatic wiring).
    protected override void OnInitialized() => Progress?.RegisterLabel();
}
