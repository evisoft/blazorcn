@namespace BlazorCN
@inherits ComponentBaseCn

<span class="@Cn.Merge("cn-progress-value", Class)"
      style="@Style"
      data-slot="progress-value"
      @attributes="AdditionalAttributes">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else if (Progress is not null)
    {
        @($"{Math.Round(Progress.Percent)}%")
    }
</span>

@code {
    /// <summary>Custom value text; when omitted, renders the current percentage
    /// (Base UI ProgressValue's default format).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private ProgressCn? Progress { get; set; }
}
