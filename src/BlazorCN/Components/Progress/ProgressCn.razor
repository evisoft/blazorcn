@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("relative h-4 w-full overflow-hidden rounded-full bg-secondary", Class)"
     style="@Style"
     role="progressbar"
     aria-valuenow="@Value"
     aria-valuemin="0"
     aria-valuemax="@Max"
     data-slot="progress"
     @attributes="AdditionalAttributes">
    <div class="h-full bg-primary transition-all"
         style="width: @(Math.Clamp((double)Value / Max * 100, 0, 100))%">
    </div>
</div>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public double Max { get; set; } = 100;
}
