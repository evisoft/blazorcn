@namespace BlazorCN
@inherits ComponentBaseCn
@using System.Globalization

<div class="@Cn.Merge("cn-progress-root flex flex-wrap gap-3", Class)"
     style="@Style"
     role="progressbar"
     aria-valuenow="@Value.ToString(CultureInfo.InvariantCulture)"
     aria-valuemin="0"
     aria-valuemax="@Max.ToString(CultureInfo.InvariantCulture)"
     aria-labelledby="@(_hasLabel ? LabelId : null)"
     data-slot="progress"
     @attributes="AdditionalAttributes">
    @* IsFixed=false so ProgressValueCn's default percent text re-renders when Value changes. *@
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
    <div class="cn-progress-track relative flex w-full items-center overflow-x-hidden" data-slot="progress-track">
        <div class="cn-progress-indicator h-full transition-all"
             style="@FormattableString.Invariant($"width: {Percent}%")">
        </div>
    </div>
</div>

@code {
    /// <summary>Optional label/value children (ProgressLabelCn / ProgressValueCn),
    /// rendered above the track — mirrors the Base UI Root &gt; children + Track
    /// composition of progress.tsx.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public double Value { get; set; }
    [Parameter] public double Max { get; set; } = 100;

    // Max=0 is a normal transient state ("0 of 0 files"); 0/0 is NaN, and NaN
    // propagates through Math.Clamp — the indicator would get `width: NaN%` and
    // ProgressValueCn would print a literal "NaN%".
    internal double Percent => Max > 0 ? Math.Clamp(Value / Max * 100, 0, 100) : 0;

    internal string LabelId { get; } = $"progress-label-{Guid.NewGuid():N}";
    private bool _hasLabel;

    internal void RegisterLabel()
    {
        if (_hasLabel) return;
        _hasLabel = true;
        StateHasChanged();
    }
}
