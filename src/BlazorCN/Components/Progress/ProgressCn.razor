@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("cn-progress relative w-full overflow-hidden", Class)"
     style="@Style"
     role="progressbar"
     aria-valuenow="@Value"
     aria-valuemin="0"
     aria-valuemax="@Max"
     data-slot="progress"
     @attributes="AdditionalAttributes">
    <div class="cn-progress-indicator h-full transition-all"
         style="width: @(Math.Clamp((double)Value / Max * 100, 0, 100))%">
    </div>
</div>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public double Max { get; set; } = 100;
}
