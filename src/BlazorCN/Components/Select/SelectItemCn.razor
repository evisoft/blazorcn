@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("cn-select-item relative flex w-full cursor-default select-none items-center outline-hidden data-[disabled]:pointer-events-none data-[disabled]:opacity-50", Class)"
     style="@Style"
     role="option"
     aria-selected="@(IsSelected ? "true" : "false")"
     data-slot="select-item"
     data-menu-item
     data-disabled="@(Disabled ? "true" : null)"
     tabindex="-1"
     @onclick="HandleClick"
     @attributes="AdditionalAttributes">
    <span class="absolute right-2 flex size-3.5 items-center justify-center">
        @if (IsSelected)
        {
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M20 6 9 17l-5-5"/></svg>
        }
    </span>
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [CascadingParameter] public SelectCn? Select { get; set; }

    private bool IsSelected => Select?.SelectedValue == Value;

    protected override void OnInitialized()
    {
        // Register our visible ChildContent (not Value) so the trigger renders e.g.
        // "Friday" / "Dry Van" when Value is "5" / "DryVan". If the item happens
        // to match the current SelectedValue, the parent caches this fragment so
        // SelectValueCn can re-render it inside the trigger.
        Select?.RegisterItem(Value, ChildContent);
    }

    protected override void OnParametersSet()
    {
        // ChildContent can change (e.g. localized labels, dynamic counts) — keep the
        // selected display in sync without waiting for the dropdown to reopen.
        Select?.RegisterItem(Value, ChildContent);
    }

    private async Task HandleClick()
    {
        if (Disabled) return;
        if (Select is not null)
        {
            await Select.SelectItem(Value, ChildContent);
        }
    }
}
