@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("relative inline-block", Class)" style="@Style" data-slot="select" data-state="@(IsOpen ? "open" : "closed")" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    internal bool IsOpen { get; private set; }
    internal ElementReference TriggerElement { get; set; }
    internal string? SelectedValue { get; private set; }

    // Display content for the currently-selected item, captured from SelectItemCn.ChildContent
    // (so the trigger renders e.g. "Friday" while Value="5"). null until at least one item with
    // a matching Value has registered; consumers fall back to SelectedValue then Placeholder.
    internal RenderFragment? SelectedContent { get; private set; }

    protected override void OnInitialized()
    {
        IsOpen = Open;
        SelectedValue = Value;
    }

    protected override void OnParametersSet()
    {
        if (Open != IsOpen)
            IsOpen = Open;
        // If the consumer's Value changed (e.g. via Fluxor state push), the cached
        // SelectedContent now points to the wrong item — drop it and let RegisterItem
        // re-populate on the next item-render pass.
        if (SelectedValue != Value)
        {
            SelectedValue = Value;
            SelectedContent = null;
        }
    }

    internal async Task SetOpen(bool open)
    {
        if (Disabled && open) return;
        IsOpen = open;
        await OpenChanged.InvokeAsync(IsOpen);
        StateHasChanged();
    }

    internal async Task ToggleOpen()
    {
        await SetOpen(!IsOpen);
    }

    internal async Task SelectItem(string value, RenderFragment? content)
    {
        SelectedValue = value;
        SelectedContent = content;
        await ValueChanged.InvokeAsync(value);
        await SetOpen(false);
    }

    internal void RegisterItem(string value, RenderFragment? content)
    {
        if (SelectedValue == value)
        {
            SelectedContent = content;
        }
    }
}
