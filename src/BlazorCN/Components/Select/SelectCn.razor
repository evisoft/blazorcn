@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("relative inline-block", Class)" style="@Style" data-slot="select" data-state="@(IsOpen ? "open" : "closed")" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    internal bool IsOpen { get; private set; }
    internal ElementReference TriggerElement { get; set; }
    internal string? SelectedValue { get; private set; }
    internal string? SelectedText { get; private set; }

    protected override void OnInitialized()
    {
        IsOpen = Open;
        SelectedValue = Value;
    }

    protected override void OnParametersSet()
    {
        IsOpen = Open;
        SelectedValue = Value;
    }

    internal async Task SetOpen(bool open)
    {
        if (Disabled && open) return;
        IsOpen = open;
        await OpenChanged.InvokeAsync(IsOpen);
        StateHasChanged();
    }

    internal async Task ToggleOpen()
    {
        await SetOpen(!IsOpen);
    }

    internal async Task SelectItem(string value, string? text)
    {
        SelectedValue = value;
        SelectedText = text;
        await ValueChanged.InvokeAsync(value);
        await SetOpen(false);
    }

    internal void RegisterItemText(string value, string? text)
    {
        if (SelectedValue == value)
        {
            SelectedText = text;
        }
    }
}
