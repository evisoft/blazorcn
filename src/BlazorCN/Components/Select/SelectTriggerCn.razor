@namespace BlazorCN
@inherits ComponentBaseCn

@* w-full (not w-fit) so the trigger fills its container and doesn't resize as
   the selected text length changes — the parent layout (grid cell, flex column,
   explicit width div) controls the size. Consumers that explicitly want shrink-
   to-content can override with Class="w-fit". *@
<button @ref="_triggerRef"
        type="button"
        class="@Cn.Merge("cn-select-trigger flex w-full items-center justify-between whitespace-nowrap outline-none disabled:cursor-not-allowed disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='text-'])]:text-muted-foreground", Class)"
        style="@Style"
        data-slot="select-trigger"
        data-size="@Size"
        disabled="@(Select?.Disabled == true)"
        aria-haspopup="listbox"
        aria-expanded="@(Select?.IsOpen == true ? "true" : "false")"
        @onclick="Toggle"
        @attributes="AdditionalAttributes">
    @ChildContent
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 opacity-50 shrink-0" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Trigger size: "default" (h-8) or "sm" (h-7). Drives the data-size height rule.</summary>
    [Parameter] public string Size { get; set; } = "default";
    [CascadingParameter] public SelectCn? Select { get; set; }

    private ElementReference _triggerRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (Select is not null) Select.TriggerElement = _triggerRef;
    }

    private async Task Toggle()
    {
        if (Select is not null) await Select.ToggleOpen();
    }
}
