@namespace BlazorCN
@inherits ComponentBaseCn

<button @ref="_triggerRef"
        type="button"
        class="@Cn.Merge("cn-select-trigger flex w-fit items-center justify-between whitespace-nowrap outline-hidden disabled:cursor-not-allowed disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='text-'])]:text-muted-foreground", Class)"
        style="@Style"
        data-slot="select-trigger"
        disabled="@(Select?.Disabled == true)"
        aria-haspopup="listbox"
        aria-expanded="@(Select?.IsOpen == true ? "true" : "false")"
        @onclick="Toggle"
        @attributes="AdditionalAttributes">
    @ChildContent
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 opacity-50 shrink-0" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public SelectCn? Select { get; set; }

    private ElementReference _triggerRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (Select is not null) Select.TriggerElement = _triggerRef;
    }

    private async Task Toggle()
    {
        if (Select is not null) await Select.ToggleOpen();
    }
}
