@namespace BlazorCN
@inherits ComponentBaseCn

@if (Select?.SelectedContent is not null)
{
    <span class="@Cn.Merge("cn-select-value truncate", Class)" style="@Style" data-slot="select-value" @attributes="AdditionalAttributes">@Select.SelectedContent</span>
}
else if (!string.IsNullOrEmpty(Select?.SelectedValue))
{
    @* No item has registered yet (e.g. dropdown never opened, items render lazily).
       Fall back to the raw value so the trigger isn't misleadingly showing the
       placeholder over a real selection. Will swap to the rich content as soon
       as the matching SelectItemCn renders. *@
    <span class="@Cn.Merge("cn-select-value truncate", Class)" style="@Style" data-slot="select-value" @attributes="AdditionalAttributes">@Select.SelectedValue</span>
}
else
{
    <span class="@Cn.Merge("cn-select-value truncate text-muted-foreground", Class)" style="@Style" data-slot="select-value" @attributes="AdditionalAttributes">@Placeholder</span>
}

@code {
    [Parameter] public string? Placeholder { get; set; }
    [CascadingParameter] public SelectCn? Select { get; set; }
}
