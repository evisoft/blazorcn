@namespace BlazorCN
@inherits ComponentBaseCn

<span class="@Cn.Merge("truncate", Class)" style="@Style" data-slot="select-value" @attributes="AdditionalAttributes">@DisplayText</span>

@code {
    [Parameter] public string? Placeholder { get; set; }
    [CascadingParameter] public SelectCn? Select { get; set; }

    private string? DisplayText => string.IsNullOrEmpty(Select?.SelectedText)
        ? Placeholder
        : Select.SelectedText;
}
