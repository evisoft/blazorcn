@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

@* Always render the content so child SelectItemCn instances can register their
   display text on first mount (otherwise the trigger has nothing to render until
   the user opens the dropdown). When closed, hide via `hidden` so it's removed
   from layout and the a11y tree. The Floating-UI JS positioning is still gated
   by IsOpen in OnAfterRenderAsync, so no layout-shift cost when closed. *@
<div @ref="_contentRef"
     class="@Cn.Merge("cn-select-content z-50 overflow-hidden p-1", Class)"
     style="@Style"
     role="listbox"
     aria-label="Options"
     data-slot="select-content"
     data-state="@(Select?.IsOpen == true ? "open" : "closed")"
     data-side="@Side.ToString().ToLowerInvariant()"
     data-align="@Align.ToString().ToLowerInvariant()"
     hidden="@(Select?.IsOpen != true)"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>
