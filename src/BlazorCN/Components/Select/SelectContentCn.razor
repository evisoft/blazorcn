@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

@if (Select?.IsOpen == true)
{
    <div @ref="_contentRef"
         class="@Cn.Merge("cn-select-content z-50 overflow-hidden p-1", Class)"
         style="@Style"
         role="listbox"
         aria-label="Options"
         data-slot="select-content"
         data-state="open"
         data-side="@Side.ToString().ToLowerInvariant()"
         data-align="@Align.ToString().ToLowerInvariant()"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}
