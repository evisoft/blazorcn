@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("grid gap-2", Class)" style="@Style" data-slot="form-item" @attributes="AdditionalAttributes">
    <CascadingValue Value="_context" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Marks the field as invalid. Flows to <see cref="FormLabelCn"/> (destructive text via
    /// <c>data-error</c>) and to the cascaded <see cref="FormFieldContext"/> so the control
    /// can render <c>aria-invalid</c> and include the message id in <c>aria-describedby</c>.
    /// </summary>
    [Parameter] public bool HasError { get; set; }

    private readonly string _id = $"form-item-{Guid.NewGuid().ToString("N")[..8]}";
    private FormFieldContext _context = default!;

    protected override void OnParametersSet()
    {
        // Recreate only when the error state flips so cascading consumers
        // re-render exactly when the context content actually changed.
        if (_context is null || _context.HasError != HasError)
        {
            _context = new FormFieldContext
            {
                FormItemId = _id,
                DescriptionId = $"{_id}-description",
                MessageId = $"{_id}-message",
                HasError = HasError,
            };
        }
    }
}
