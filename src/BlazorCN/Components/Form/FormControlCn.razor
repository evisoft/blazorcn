@namespace BlazorCN
@inherits ComponentBaseCn

@* Blazor has no Slot, so the reference FormControl's id/aria-describedby/aria-invalid
   cannot be stamped onto the child automatically. Instead the cascaded FormFieldContext
   is handed to the child content, so consumers wire the control themselves:
   <FormControlCn>
       <InputCn id="@context.FormItemId" aria-describedby="@context.AriaDescribedBy"
                aria-invalid="@context.HasError" ... />
   </FormControlCn>
   Plain markup children (ignoring the context) keep compiling unchanged. *@
<div class="@Class" style="@Style" data-slot="form-control" @attributes="AdditionalAttributes">
    @ChildContent?.Invoke(Context ?? EmptyContext)
</div>

@code {
    [Parameter] public RenderFragment<FormFieldContext>? ChildContent { get; set; }
    [CascadingParameter] private FormFieldContext? Context { get; set; }

    // Used when FormControlCn is rendered outside a FormFieldCn.
    private static readonly FormFieldContext EmptyContext = new();
}
