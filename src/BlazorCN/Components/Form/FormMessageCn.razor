@namespace BlazorCN
@inherits ComponentBaseCn

<p class="@Cn.Merge("text-sm text-destructive", Class)"
   style="@Style"
   role="alert"
   data-slot="form-message"
   @attributes="AdditionalAttributes">
    @ChildContent
</p>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
