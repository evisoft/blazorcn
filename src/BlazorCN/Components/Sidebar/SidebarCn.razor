@namespace BlazorCN
@inherits ComponentBaseCn

@if (Collapsible == SidebarCollapsible.None)
{
    <div class="@Cn.Merge("flex h-full w-(--sidebar-width) flex-col bg-sidebar text-sidebar-foreground", Class)"
         style="@Style"
         data-slot="sidebar"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}
else if (Provider?.IsMobile == true)
{
    <SheetCn Open="@(Provider?.OpenMobile == true)" OpenChanged="HandleMobileOpenChanged">
        <SheetOverlayCn />
        <SheetContentCn Side="@(Side == SidebarSide.Left ? SheetSide.Left : SheetSide.Right)"
                        Class="w-(--sidebar-width) bg-sidebar p-0 text-sidebar-foreground [&>button]:hidden"
                        Style="--sidebar-width: 18rem;"
                        data-sidebar="sidebar"
                        data-slot="sidebar"
                        data-mobile="true">
            <SheetHeaderCn Class="sr-only">
                <SheetTitleCn>Sidebar</SheetTitleCn>
                <SheetDescriptionCn>Displays the mobile sidebar.</SheetDescriptionCn>
            </SheetHeaderCn>
            <div class="flex h-full w-full flex-col">@ChildContent</div>
        </SheetContentCn>
    </SheetCn>
}
else
{
    <div class="group peer hidden text-sidebar-foreground md:block"
         data-state="@(Provider?.State ?? "expanded")"
         data-collapsible="@(Provider?.State == "collapsed" ? Collapsible.ToString().ToLowerInvariant() : "")"
         data-variant="@Variant.ToString().ToLowerInvariant()"
         data-side="@Side.ToString().ToLowerInvariant()"
         data-slot="sidebar">
        @* Gap div *@
        <div data-slot="sidebar-gap"
             class="@GapCssClass" />
        @* Container div *@
        <div data-slot="sidebar-container"
             data-side="@Side.ToString().ToLowerInvariant()"
             class="@Cn.Merge(ContainerCssClass, Class)"
             style="@Style"
             @attributes="AdditionalAttributes">
            <div data-sidebar="sidebar"
                 data-slot="sidebar-inner"
                 class="cn-sidebar-inner flex size-full flex-col">
                @ChildContent
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public SidebarSide Side { get; set; } = SidebarSide.Left;
    [Parameter] public SidebarVariant Variant { get; set; } = SidebarVariant.Sidebar;
    [Parameter] public SidebarCollapsible Collapsible { get; set; } = SidebarCollapsible.Offcanvas;
    [CascadingParameter] private SidebarProviderCn? Provider { get; set; }

    private bool IsFloatingOrInset => Variant is SidebarVariant.Floating or SidebarVariant.Inset;

    private string GapCssClass => Cn.Merge(
        "cn-sidebar-gap relative w-(--sidebar-width) bg-transparent",
        "group-data-[collapsible=offcanvas]:w-0",
        "group-data-[side=right]:rotate-180",
        IsFloatingOrInset
            ? "group-data-[collapsible=icon]:w-[calc(var(--sidebar-width-icon)+(--spacing(4)))]"
            : "group-data-[collapsible=icon]:w-(--sidebar-width-icon)");

    private string ContainerCssClass => Cn.Merge(
        "fixed inset-y-0 z-10 hidden h-svh w-(--sidebar-width) transition-[left,right,width] duration-200 ease-linear md:flex",
        "data-[side=left]:left-0 data-[side=left]:group-data-[collapsible=offcanvas]:left-[calc(var(--sidebar-width)*-1)]",
        "data-[side=right]:right-0 data-[side=right]:group-data-[collapsible=offcanvas]:right-[calc(var(--sidebar-width)*-1)]",
        IsFloatingOrInset
            ? "p-2 group-data-[collapsible=icon]:w-[calc(var(--sidebar-width-icon)+(--spacing(4))+2px)]"
            : "group-data-[collapsible=icon]:w-(--sidebar-width-icon) group-data-[side=left]:border-r group-data-[side=right]:border-l");

    private void HandleMobileOpenChanged(bool open)
    {
        Provider?.SetOpenMobile(open);
    }
}
