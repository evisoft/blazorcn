@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@CssClass"
     style="@GetStyle()"
     data-slot="sidebar-wrapper"
     @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool DefaultOpen { get; set; } = true;
    [Parameter] public bool? Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    internal bool IsOpen { get; private set; } = true;
    internal bool IsMobile { get; set; }
    internal bool OpenMobile { get; private set; }

    internal string State => IsOpen ? "expanded" : "collapsed";

    protected override void OnInitialized()
    {
        IsOpen = Open ?? DefaultOpen;
    }

    protected override void OnParametersSet()
    {
        if (Open.HasValue && Open.Value != IsOpen)
            IsOpen = Open.Value;
    }

    internal async Task SetOpen(bool open)
    {
        IsOpen = open;
        await OpenChanged.InvokeAsync(IsOpen);
        StateHasChanged();
    }

    internal void SetOpenMobile(bool open)
    {
        OpenMobile = open;
        StateHasChanged();
    }

    internal async Task ToggleSidebar()
    {
        if (IsMobile)
        {
            OpenMobile = !OpenMobile;
            StateHasChanged();
        }
        else
        {
            await SetOpen(!IsOpen);
        }
    }

    private string CssClass => Cn.Merge(
        "group/sidebar-wrapper flex min-h-svh w-full has-data-[variant=inset]:bg-sidebar",
        Class);

    private string GetStyle()
    {
        var vars = "--sidebar-width: 16rem; --sidebar-width-icon: 3rem;";
        return string.IsNullOrEmpty(Style) ? vars : $"{vars} {Style}";
    }
}
