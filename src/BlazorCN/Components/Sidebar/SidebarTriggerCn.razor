@namespace BlazorCN
@inherits ComponentBaseCn

<button class="@CssClass"
        style="@Style"
        type="button"
        data-sidebar="trigger"
        data-slot="sidebar-trigger"
        @onclick="HandleClick"
        @attributes="AdditionalAttributes">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-rtl-flip size-4">
        <rect width="18" height="18" x="3" y="3" rx="2"/>
        <path d="M9 3v18"/>
    </svg>
    <span class="sr-only">Toggle Sidebar</span>
</button>

@code {
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [CascadingParameter] private SidebarProviderCn? Provider { get; set; }

    // Mirrors reference SidebarTrigger: Button variant="ghost" size="icon-sm" + cn-sidebar-trigger hook.
    private string CssClass => Cn.Merge(
        "cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-icon-sm cn-sidebar-trigger",
        Class);

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync();
        if (Provider is not null)
            await Provider.ToggleSidebar();
    }
}
