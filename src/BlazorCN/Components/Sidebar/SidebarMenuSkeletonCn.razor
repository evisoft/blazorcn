@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("cn-sidebar-menu-skeleton flex items-center", Class)"
     style="@Style"
     data-slot="sidebar-menu-skeleton"
     data-sidebar="menu-skeleton"
     @attributes="AdditionalAttributes">
    @if (ShowIcon)
    {
        <SkeletonCn Class="cn-sidebar-menu-skeleton-icon" data-sidebar="menu-skeleton-icon" />
    }
    <SkeletonCn Class="cn-sidebar-menu-skeleton-text flex-1" Style="@($"max-width: {_width}%;")" data-sidebar="menu-skeleton-text" />
</div>

@code {
    [Parameter] public bool ShowIcon { get; set; }

    private int _width;

    protected override void OnInitialized()
    {
        _width = Random.Shared.Next(50, 91);
    }
}
