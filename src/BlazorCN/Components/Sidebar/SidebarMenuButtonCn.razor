@namespace BlazorCN
@inherits ComponentBaseCn

@if (!string.IsNullOrEmpty(Href))
{
    <a href="@Href"
       class="@CssClass"
       style="@Style"
       data-slot="sidebar-menu-button"
       data-sidebar="menu-button"
       data-size="@Size.ToString().ToLowerInvariant()"
       data-active="@(IsActive ? "true" : null)"
       @attributes="AdditionalAttributes">
        @ChildContent
    </a>
}
else
{
    <button class="@CssClass"
            style="@Style"
            type="button"
            data-slot="sidebar-menu-button"
            data-sidebar="menu-button"
            data-size="@Size.ToString().ToLowerInvariant()"
            data-active="@(IsActive ? "true" : null)"
            @onclick="OnClick"
            @attributes="AdditionalAttributes">
        @ChildContent
    </button>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public SidebarMenuButtonVariant Variant { get; set; } = SidebarMenuButtonVariant.Default;
    [Parameter] public SidebarMenuButtonSize Size { get; set; } = SidebarMenuButtonSize.Default;
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public string? Tooltip { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private static readonly Cva<SidebarMenuButtonVariant, SidebarMenuButtonSize> Variants = new(
        "cn-sidebar-menu-button peer/menu-button group/menu-button flex w-full items-center overflow-hidden outline-hidden disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none aria-disabled:opacity-50 [&_svg]:shrink-0 [&>span:last-child]:truncate",
        new()
        {
            [SidebarMenuButtonVariant.Default] = "cn-sidebar-menu-button-variant-default",
            [SidebarMenuButtonVariant.Outline] = "cn-sidebar-menu-button-variant-outline",
        },
        new()
        {
            [SidebarMenuButtonSize.Default] = "cn-sidebar-menu-button-size-default",
            [SidebarMenuButtonSize.Sm] = "cn-sidebar-menu-button-size-sm",
            [SidebarMenuButtonSize.Lg] = "cn-sidebar-menu-button-size-lg",
        });

    private string CssClass => Variants.Apply(Variant, Size, Class);
}
