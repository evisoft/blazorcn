@namespace BlazorCN
@inherits ComponentBaseCn
<li class="@Cn.Merge("cn-breadcrumb-separator", Class)" style="@Style" role="presentation" aria-hidden="true" data-slot="breadcrumb-separator" @attributes="AdditionalAttributes">
    @if (ChildContent != null) { @ChildContent } else { <LucideChevronRightCn Class="cn-rtl-flip" /> }
</li>
@code { [Parameter] public RenderFragment? ChildContent { get; set; } }
