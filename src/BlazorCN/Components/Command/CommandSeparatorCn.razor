@namespace BlazorCN
@inherits ComponentBaseCn

@* aria-hidden: a listbox may only own group/option children (axe aria-required-children);
   the separator is purely decorative, so it is removed from the accessibility tree. *@
<div class="@Cn.Merge("cn-command-separator", Class)" style="@Style" data-slot="command-separator" role="separator" aria-hidden="true" @attributes="AdditionalAttributes"></div>
