@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("cn-command-group", HasVisibleItems ? null : "hidden", Class)" style="@Style" data-slot="command-group" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Heading))
    {
        <div class="px-2 py-1.5 text-xs font-medium text-muted-foreground">@Heading</div>
    }
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Heading { get; set; }

    private readonly List<CommandItemCn> _items = new();

    internal void RegisterItem(CommandItemCn item) => _items.Add(item);
    internal void UnregisterItem(CommandItemCn item) => _items.Remove(item);

    /// <summary>The whole group (incl. heading) hides when the filter matches none of its items.</summary>
    private bool HasVisibleItems => _items.Count == 0 || _items.Any(i => i.IsVisible);
}
