@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("cn-command-group", Class)" style="@Style" data-slot="command-group" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Heading))
    {
        <div class="px-2 py-1.5 text-xs font-medium text-muted-foreground">@Heading</div>
    }
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Heading { get; set; }
}
