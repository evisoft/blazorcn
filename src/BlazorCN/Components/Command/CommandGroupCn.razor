@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("cn-command-group", HasVisibleItems ? null : "hidden", Class)" style="@Style" data-slot="command-group" role="group" aria-labelledby="@(string.IsNullOrEmpty(Heading) ? null : _headingId)" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Heading))
    {
        @* cmdk-group-heading activates the nova **:[[cmdk-group-heading]] styles; aria-hidden
           because the group is named via aria-labelledby (cmdk renders exactly this). *@
        <div id="@_headingId" cmdk-group-heading="" aria-hidden="true" class="px-2 py-1.5 text-xs font-medium text-muted-foreground">@Heading</div>
    }
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Heading { get; set; }

    private readonly string _headingId = $"command-group-heading-{Guid.NewGuid():N}";

    private readonly List<CommandItemCn> _items = new();

    internal void RegisterItem(CommandItemCn item) => _items.Add(item);
    internal void UnregisterItem(CommandItemCn item) => _items.Remove(item);

    /// <summary>The whole group (incl. heading) hides when the filter matches none of its items.</summary>
    private bool HasVisibleItems => _items.Count == 0 || _items.Any(i => i.IsVisible);
}
