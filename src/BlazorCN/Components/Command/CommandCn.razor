@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

<div @ref="_rootRef" class="@Cn.Merge("cn-command flex h-full w-full flex-col overflow-hidden border", Class)" style="@Style" data-slot="command" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private ElementReference _rootRef;
    private ElementReference _listRef;
    private bool _hasListRef;
    private IJSObjectReference? _module;

    private readonly List<CommandItemCn> _items = new();

    /// <summary>Id of the CommandListCn listbox — referenced by the input's aria-controls.</summary>
    internal string ListId { get; } = $"command-list-{Guid.NewGuid():N}";

    /// <summary>Current filter text, set by CommandInputCn as the user types (cmdk behavior).</summary>
    internal string Search { get; private set; } = string.Empty;

    /// <summary>The virtually highlighted item (cmdk model): DOM focus stays in the input while
    /// arrow keys move this highlight; the input's aria-activedescendant tracks it.</summary>
    internal CommandItemCn? HighlightedItem { get; private set; }

    internal void SetSearch(string value)
    {
        Search = value;
        // cmdk resets the highlight to the first matching item whenever the filter changes.
        HighlightedItem = EligibleItems.FirstOrDefault();
        StateHasChanged();
    }

    internal void RegisterItem(CommandItemCn item) => _items.Add(item);

    internal void UnregisterItem(CommandItemCn item)
    {
        _items.Remove(item);
        if (ReferenceEquals(HighlightedItem, item)) HighlightedItem = null;
    }

    /// <summary>Called by CommandListCn so the highlight can be scrolled within the list.</summary>
    internal void SetListElement(ElementReference element)
    {
        _listRef = element;
        _hasListRef = true;
    }

    /// <summary>True while at least one item matches the filter — drives CommandEmptyCn.</summary>
    internal bool HasVisibleItems => _items.Count == 0 || _items.Any(i => i.IsVisible);

    /// <summary>Re-evaluates visibility after an item resolves its filter text asynchronously.</summary>
    internal void NotifyItemTextResolved()
    {
        if (Search.Length > 0) StateHasChanged();
    }

    /// <summary>Items the highlight can land on: enabled and not filtered out, in render order.</summary>
    private List<CommandItemCn> EligibleItems => _items.Where(i => i is { Disabled: false, IsVisible: true }).ToList();

    internal void SetHighlight(CommandItemCn item)
    {
        if (ReferenceEquals(HighlightedItem, item)) return;
        HighlightedItem = item;
        StateHasChanged();
    }

    internal void ClearHighlight(CommandItemCn item)
    {
        if (!ReferenceEquals(HighlightedItem, item)) return;
        HighlightedItem = null;
        StateHasChanged();
    }

    /// <summary>Moves the highlight up/down without wrapping (cmdk clamps at the ends).</summary>
    internal async Task MoveHighlightAsync(int direction)
    {
        var eligible = EligibleItems;
        if (eligible.Count == 0) return;
        var current = HighlightedItem is null ? -1 : eligible.IndexOf(HighlightedItem);
        var next = current < 0
            ? (direction > 0 ? 0 : eligible.Count - 1)
            : Math.Clamp(current + direction, 0, eligible.Count - 1);
        await HighlightAsync(eligible[next]);
    }

    internal async Task HighlightFirstAsync()
    {
        var eligible = EligibleItems;
        if (eligible.Count > 0) await HighlightAsync(eligible[0]);
    }

    internal async Task HighlightLastAsync()
    {
        var eligible = EligibleItems;
        if (eligible.Count > 0) await HighlightAsync(eligible[^1]);
    }

    /// <summary>Activates the highlighted item, falling back to the first eligible item so
    /// Enter-while-typing selects the top match (cmdk behavior).</summary>
    internal async Task ActivateHighlightedAsync()
    {
        var eligible = EligibleItems;
        var target = HighlightedItem is not null && eligible.Contains(HighlightedItem)
            ? HighlightedItem
            : eligible.FirstOrDefault();
        if (target is not null) await target.SelectAsync();
    }

    private async Task HighlightAsync(CommandItemCn item)
    {
        SetHighlight(item);
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/BlazorCN/blazorcn.js");
            await _module.InvokeVoidAsync(
                "scrollItemIntoView", _hasListRef ? _listRef : _rootRef, item.ItemId);
        }
        catch { /* Prerendering without JS — scrolling is progressive enhancement */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch { /* Circuit may already be gone */ }
        }
    }
}
