@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("cn-command flex h-full w-full flex-col overflow-hidden border", Class)" style="@Style" data-slot="command" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
