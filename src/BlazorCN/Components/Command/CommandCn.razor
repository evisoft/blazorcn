@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("flex h-full w-full flex-col overflow-hidden rounded-md border bg-popover text-popover-foreground", Class)" style="@Style" data-slot="command" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
