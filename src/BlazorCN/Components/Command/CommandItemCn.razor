@namespace BlazorCN
@inherits ComponentBaseCn
@implements IDisposable

@* Visibility uses the `hidden` utility class (not the hidden attribute): the
   cn-command-item rule sets display, and any author display beats the UA's
   [hidden] { display:none }. *@
<div @ref="_itemRef"
     class="@Cn.Merge("cn-command-item group/command-item data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0", IsVisible ? null : "hidden", Class)"
     style="@Style"
     id="@ItemId"
     role="option"
     aria-selected="@(Highlighted ? "true" : "false")"
     aria-disabled="@(Disabled ? "true" : null)"
     data-slot="command-item"
     data-disabled="@(Disabled ? "true" : null)"
     data-selected="@(Highlighted ? "true" : null)"
     data-value="@Value"
     @onmouseenter="HandleMouseEnter"
     @onmouseleave="HandleMouseLeave"
     @onclick="HandleClick"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }
    [CascadingParameter] public CommandCn? Command { get; set; }
    [CascadingParameter] public CommandGroupCn? Group { get; set; }
    [Inject] private JsInteropCn JsInterop { get; set; } = default!;

    private ElementReference _itemRef;
    private bool _selected;
    private string? _resolvedText;

    /// <summary>Element id — referenced by the input's aria-activedescendant (cmdk model).</summary>
    internal string ItemId { get; } = $"command-item-{Guid.NewGuid():N}";

    /// <summary>Whether this item carries the highlight (keyboard or hover) — drives
    /// data-selected/aria-selected. The root tracks a single highlight; the local flag
    /// only serves items used without a CommandCn ancestor.</summary>
    private bool Highlighted =>
        !Disabled && (Command is not null ? ReferenceEquals(Command.HighlightedItem, this) : _selected);

    /// <summary>Text the item is matched against: explicit Value, else its rendered text (cmdk behavior).</summary>
    private string FilterText => Value ?? _resolvedText ?? string.Empty;

    /// <summary>Whether the item matches the current Command search filter.</summary>
    internal bool IsVisible =>
        Command is null
        || Command.Search.Length == 0
        || FilterText.Contains(Command.Search, StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Command?.RegisterItem(this);
        Group?.RegisterItem(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Value is null && Command is not null)
        {
            try
            {
                _resolvedText = await JsInterop.GetTextContentAsync(_itemRef);
                Command.NotifyItemTextResolved();
            }
            catch { /* Prerendering without JS — falls back to always-visible */ }
        }
    }

    private void HandleMouseEnter()
    {
        if (Disabled) return;
        if (Command is not null) Command.SetHighlight(this);
        else _selected = true;
    }

    private void HandleMouseLeave()
    {
        if (Command is not null) Command.ClearHighlight(this);
        else _selected = false;
    }

    private async Task HandleClick()
    {
        if (!Disabled) await OnSelect.InvokeAsync();
    }

    /// <summary>Activates the item as if clicked — used by the root's Enter handling.</summary>
    internal Task SelectAsync() => HandleClick();

    public void Dispose()
    {
        Command?.UnregisterItem(this);
        Group?.UnregisterItem(this);
    }
}
