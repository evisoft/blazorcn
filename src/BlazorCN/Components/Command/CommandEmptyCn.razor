@namespace BlazorCN
@inherits ComponentBaseCn

@* Rendered only when a search filter matches nothing (cmdk behavior). *@
<div class="@Cn.Merge("cn-command-empty", IsShown ? null : "hidden", Class)" style="@Style" data-slot="command-empty" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public CommandCn? Command { get; set; }

    private bool IsShown =>
        Command is not null && Command.Search.Length > 0 && !Command.HasVisibleItems;
}
