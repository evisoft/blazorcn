@namespace BlazorCN
@inherits ComponentBaseCn

<div @ref="_listRef"
     class="@Cn.Merge("cn-command-list overflow-y-auto overflow-x-hidden", Class)"
     style="@Style"
     id="@(Command?.ListId)"
     role="listbox"
     aria-label="@AriaLabel"
     data-slot="command-list"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Accessible name for the listbox (cmdk default: "Suggestions").</summary>
    [Parameter] public string AriaLabel { get; set; } = "Suggestions";
    [CascadingParameter] public CommandCn? Command { get; set; }

    private ElementReference _listRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) Command?.SetListElement(_listRef);
    }
}
