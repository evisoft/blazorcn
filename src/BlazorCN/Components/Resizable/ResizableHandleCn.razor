@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge(DefaultClasses, Class)"
     style="@Style"
     data-slot="resizable-handle"
     tabindex="0"
     role="separator"
     aria-label="Resize"
     @attributes="AdditionalAttributes">
    @if (WithHandle)
    {
        <div class="cn-resizable-handle-icon z-10 flex items-center justify-center rounded-xs border">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24"
                 fill="currentColor" stroke="none">
                <circle cx="4" cy="4" r="2"/>
                <circle cx="4" cy="12" r="2"/>
                <circle cx="4" cy="20" r="2"/>
                <circle cx="12" cy="4" r="2"/>
                <circle cx="12" cy="12" r="2"/>
                <circle cx="12" cy="20" r="2"/>
            </svg>
        </div>
    }
</div>

@code {
    [CascadingParameter] public ResizablePanelGroupCn? PanelGroup { get; set; }
    [Parameter] public bool WithHandle { get; set; }

    private bool IsVertical => PanelGroup?.Direction == ResizableDirection.Vertical;

    private string DefaultClasses => IsVertical
        ? "relative flex w-full h-px items-center justify-center bg-border after:absolute after:inset-y-0 after:left-1/2 after:w-1 after:-translate-x-1/2 focus-visible:outline-hidden focus-visible:ring-1 focus-visible:ring-ring h-px after:left-0 after:h-1 after:w-full after:translate-x-0 after:-translate-y-1/2"
        : "relative flex w-px items-center justify-center bg-border after:absolute after:inset-y-0 after:left-1/2 after:w-1 after:-translate-x-1/2 focus-visible:outline-hidden focus-visible:ring-1 focus-visible:ring-ring";
}
