@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge(Class)"
     style="@PanelStyle"
     data-slot="resizable-panel"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [CascadingParameter] public ResizablePanelGroupCn? PanelGroup { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public double? DefaultSize { get; set; }
    [Parameter] public double? MinSize { get; set; }
    [Parameter] public double? MaxSize { get; set; }

    private string PanelStyle
    {
        get
        {
            var styles = new List<string>();
            if (DefaultSize.HasValue)
                styles.Add($"flex: {DefaultSize.Value} {DefaultSize.Value} 0%");
            else
                styles.Add("flex: 1 1 0%");

            if (MinSize.HasValue)
                styles.Add($"min-{SizeProp}: {MinSize.Value}%");

            if (MaxSize.HasValue)
                styles.Add($"max-{SizeProp}: {MaxSize.Value}%");

            if (!string.IsNullOrWhiteSpace(Style))
                styles.Add(Style);

            return string.Join("; ", styles);
        }
    }

    private string SizeProp => PanelGroup?.Direction == ResizableDirection.Vertical ? "height" : "width";
}
