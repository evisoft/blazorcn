@namespace BlazorCN
@inherits ComponentBaseCn

@if (Collapsible?.IsOpen == true)
{
    <div class="@Class" style="@Style" id="@(Collapsible?.PanelId)" data-slot="collapsible-content" data-state="open" @attributes="AdditionalAttributes">@ChildContent</div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private CollapsibleCn? Collapsible { get; set; }
}
