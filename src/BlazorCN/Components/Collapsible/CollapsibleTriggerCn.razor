@namespace BlazorCN
@inherits ComponentBaseCn
<button class="group @Class" style="@Style" type="button" data-slot="collapsible-trigger" data-state="@(Collapsible?.IsOpen == true ? "open" : "closed")" aria-expanded="@(Collapsible?.IsOpen == true ? "true" : "false")" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</button>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private CollapsibleCn? Collapsible { get; set; }
    private async Task HandleClick() { if (Collapsible is not null) await Collapsible.Toggle(); }
}
