@namespace BlazorCN
@inherits ComponentBaseCn
<button class="@Class" style="@Style" type="button" data-slot="collapsible-trigger" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</button>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private CollapsibleCn? Collapsible { get; set; }
    private async Task HandleClick() { if (Collapsible is not null) await Collapsible.Toggle(); }
}
