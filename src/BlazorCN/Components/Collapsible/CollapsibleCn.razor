@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Class" style="@Style" data-slot="collapsible" data-state="@(IsOpen ? "open" : "closed")" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Controlled open state. Leave unset for uncontrolled usage (with
    /// <see cref="DefaultOpen"/>) so parent re-renders don't reset the state.</summary>
    [Parameter] public bool? Open { get; set; }

    /// <summary>Initial open state for uncontrolled usage.</summary>
    [Parameter] public bool DefaultOpen { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    internal bool IsOpen { get; private set; }
    internal string PanelId { get; } = $"collapsible-content-{Guid.NewGuid():N}";

    protected override void OnInitialized() => IsOpen = Open ?? DefaultOpen;
    protected override void OnParametersSet()
    {
        if (Open.HasValue && Open.Value != IsOpen)
            IsOpen = Open.Value;
    }

    internal async Task Toggle()
    {
        IsOpen = !IsOpen;
        await OpenChanged.InvokeAsync(IsOpen);
        StateHasChanged();
    }
}
