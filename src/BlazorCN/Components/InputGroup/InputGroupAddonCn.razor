@namespace BlazorCN
@inherits ComponentBaseCn

@* Clicking the addon (styled cursor-text, reads as part of the field) focuses the
   group's control — matching the reference addon's onClick focus. Clicks on buttons
   inside the addon are suppressed via InputGroupCn (button handlers run first). *@
<div role="group"
     class="@CssClass"
     style="@Style"
     data-slot="input-group-addon"
     data-align="@AlignValue"
     @onclick="HandleClick"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public InputGroupAddonAlign Align { get; set; } = InputGroupAddonAlign.InlineStart;
    [CascadingParameter] private InputGroupCn? Group { get; set; }

    private static readonly Cva<InputGroupAddonAlign> Variants = new(
        "cn-input-group-addon flex items-center justify-center cursor-text select-none",
        new()
        {
            [InputGroupAddonAlign.InlineStart] = "cn-input-group-addon-align-inline-start order-first",
            [InputGroupAddonAlign.InlineEnd] = "cn-input-group-addon-align-inline-end order-last",
            [InputGroupAddonAlign.BlockStart] = "cn-input-group-addon-align-block-start order-first w-full justify-start",
            [InputGroupAddonAlign.BlockEnd] = "cn-input-group-addon-align-block-end order-last w-full justify-start",
        });

    private string AlignValue => Align switch
    {
        InputGroupAddonAlign.InlineStart => "inline-start",
        InputGroupAddonAlign.InlineEnd => "inline-end",
        InputGroupAddonAlign.BlockStart => "block-start",
        InputGroupAddonAlign.BlockEnd => "block-end",
        _ => "inline-start"
    };

    private string CssClass => Variants.Apply(Align, Class);

    private async Task HandleClick()
    {
        if (Group is not null)
            await Group.FocusControlAsync();
    }
}
