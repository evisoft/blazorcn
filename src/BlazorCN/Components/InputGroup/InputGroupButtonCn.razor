@namespace BlazorCN
@inherits ComponentBaseCn

<ButtonCn Type="@Type"
          Variant="@Variant"
          Class="@CssClass"
          Style="@Style"
          Disabled="@Disabled"
          OnClick="@OnClick"
          data-size="@SizeValue"
          @attributes="AdditionalAttributes">
    @ChildContent
</ButtonCn>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Ghost;
    [Parameter] public InputGroupButtonSize Size { get; set; } = InputGroupButtonSize.Xs;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private static readonly Cva<InputGroupButtonSize> SizeVariants = new(
        "cn-input-group-button flex items-center shadow-none",
        new()
        {
            [InputGroupButtonSize.Xs] = "cn-input-group-button-size-xs",
            [InputGroupButtonSize.Sm] = "",
            [InputGroupButtonSize.IconXs] = "cn-input-group-button-size-icon-xs",
            [InputGroupButtonSize.IconSm] = "cn-input-group-button-size-icon-sm",
        });

    private string SizeValue => Size switch
    {
        InputGroupButtonSize.Xs => "xs",
        InputGroupButtonSize.Sm => "sm",
        InputGroupButtonSize.IconXs => "icon-xs",
        InputGroupButtonSize.IconSm => "icon-sm",
        _ => "xs"
    };

    private string CssClass => SizeVariants.Apply(Size, Class);
}
