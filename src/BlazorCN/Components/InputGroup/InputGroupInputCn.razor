@namespace BlazorCN
@inherits ComponentBaseCn

<input type="@Type"
       class="@CssClass"
       style="@Style"
       value="@Value"
       placeholder="@Placeholder"
       disabled="@Disabled"
       data-slot="input-group-control"
       @oninput="HandleInput"
       @attributes="AdditionalAttributes" />

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private static readonly string BaseClasses =
        "cn-input-group-input flex-1 w-full min-w-0 outline-none disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50";

    private string CssClass => Cn.Merge(BaseClasses, Class);

    private async Task HandleInput(ChangeEventArgs e)
    {
        await ValueChanged.InvokeAsync(e.Value?.ToString());
    }
}
