@namespace BlazorCN
@inherits ComponentBaseCn

<input type="@Type"
       class="@CssClass"
       style="@Style"
       value="@Value"
       placeholder="@Placeholder"
       disabled="@Disabled"
       data-slot="input-group-control"
       @ref="_inputRef"
       @oninput="HandleInput"
       @attributes="AdditionalAttributes" />

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [CascadingParameter] private InputGroupCn? Group { get; set; }

    private ElementReference _inputRef;

    // cn-input restores the base input styling the React version inherits by composing
    // <Input>; cn-input-group-input (later in the same layer) then strips the border/
    // background for in-group rendering. disabled:bg-transparent overrides cn-input's
    // disabled background (nova keeps group inputs transparent when disabled).
    private static readonly string BaseClasses =
        "cn-input cn-input-group-input flex-1 w-full min-w-0 outline-none selection:bg-primary selection:text-primary-foreground file:inline-flex file:border-0 file:bg-transparent file:text-foreground placeholder:text-muted-foreground disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 disabled:bg-transparent dark:disabled:bg-transparent";

    private string CssClass => Cn.Merge(BaseClasses, Class);

    protected override void OnInitialized()
    {
        Group?.RegisterControl(() => _inputRef.FocusAsync());
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        await ValueChanged.InvokeAsync(e.Value?.ToString());
    }
}
