@namespace BlazorCN
@inherits ComponentBaseCn

@* Value is bound via the `value` attribute (which Blazor applies as the .value property), NOT as child
   content. A textarea's child content is only its DEFAULT value: once the user types, the HTML "dirty value
   flag" is set and changing the child text no longer updates what's shown — so a programmatic reset (e.g.
   clearing a comment composer after post) would silently fail to clear. Binding `value` reflects resets reliably. *@
<textarea class="@CssClass"
          style="@Style"
          placeholder="@Placeholder"
          disabled="@Disabled"
          data-slot="input-group-control"
          value="@Value"
          @ref="_textareaRef"
          @oninput="HandleInput"
          @attributes="AdditionalAttributes"></textarea>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [CascadingParameter] private InputGroupCn? Group { get; set; }

    private ElementReference _textareaRef;

    // cn-textarea restores the base textarea styling the React version inherits by
    // composing <Textarea>; cn-input-group-textarea (later in the same layer) then
    // strips the border/background for in-group rendering. disabled:bg-transparent
    // overrides cn-textarea's disabled background (nova parity).
    private static readonly string BaseClasses =
        "cn-textarea cn-input-group-textarea flex flex-1 field-sizing-content min-h-16 w-full resize-none outline-none placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50 disabled:bg-transparent dark:disabled:bg-transparent";

    private string CssClass => Cn.Merge(BaseClasses, Class);

    protected override void OnInitialized()
    {
        Group?.RegisterControl(() => _textareaRef.FocusAsync());
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        await ValueChanged.InvokeAsync(e.Value?.ToString());
    }
}
