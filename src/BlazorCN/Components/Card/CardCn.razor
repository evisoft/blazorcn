@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("cn-card group/card flex flex-col", Class)"
     style="@Style"
     data-slot="card"
     data-size="@Size"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
