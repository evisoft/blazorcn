@namespace BlazorCN
@inherits ComponentBaseCn

@if (IsActive)
{
    <div class="@Cn.Merge("cn-tabs-content flex-1 outline-none", Class)"
         style="@Style"
         role="tabpanel"
         id="@($"{Tabs?.BaseId}-content-{Value}")"
         aria-labelledby="@($"{Tabs?.BaseId}-trigger-{Value}")"
         tabindex="0"
         data-slot="tabs-content"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@implements IDisposable

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [CascadingParameter] private TabsCn? Tabs { get; set; }

    private bool IsActive => Tabs?.IsActive(Value) ?? false;

    protected override void OnInitialized() => Tabs?.RegisterPanel(Value);

    public void Dispose() => Tabs?.UnregisterPanel(Value);
}
