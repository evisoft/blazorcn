@namespace BlazorCN
@inherits ComponentBaseCn

@if (IsActive)
{
    <div class="@Cn.Merge("mt-2 ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2", Class)"
         style="@Style"
         role="tabpanel"
         data-slot="tabs-content"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [CascadingParameter] private TabsCn? Tabs { get; set; }

    private bool IsActive => Tabs?.IsActive(Value) ?? false;
}
