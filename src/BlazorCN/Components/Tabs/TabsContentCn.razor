@namespace BlazorCN
@inherits ComponentBaseCn

@if (IsActive)
{
    <div class="@Cn.Merge("cn-tabs-content flex-1 outline-none", Class)"
         style="@Style"
         role="tabpanel"
         data-slot="tabs-content"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [CascadingParameter] private TabsCn? Tabs { get; set; }

    private bool IsActive => Tabs?.IsActive(Value) ?? false;
}
