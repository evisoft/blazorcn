@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@CssClass" style="@Style" data-slot="tabs" data-orientation="@OrientationValue" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? DefaultValue { get; set; }
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;

    private string? _activeTab;

    // Stable id prefix for wiring trigger id/aria-controls to panel id/aria-labelledby.
    internal string BaseId { get; } = $"tabs-{Guid.NewGuid():N}";

    private string OrientationValue => Orientation == Orientation.Vertical ? "vertical" : "horizontal";

    private string CssClass => Cn.Merge(
        "cn-tabs group/tabs flex",
        Orientation == Orientation.Vertical ? "flex-row" : "flex-col",
        Class);

    protected override void OnInitialized()
    {
        _activeTab = Value ?? DefaultValue;
    }

    protected override void OnParametersSet()
    {
        if (Value is not null)
            _activeTab = Value;
    }

    internal string? ActiveTab => _activeTab;

    internal async Task SelectTab(string value)
    {
        _activeTab = value;
        await ValueChanged.InvokeAsync(value);
        StateHasChanged();
    }

    internal bool IsActive(string value) => _activeTab == value;

    // Panels register on init so triggers only emit aria-controls when a matching
    // TabsContentCn actually exists (list-only tabs are a legitimate composition;
    // pointing aria-controls at a nonexistent id fails axe aria-valid-attr-value).
    private readonly HashSet<string> _panelValues = new();
    internal void RegisterPanel(string value) => _panelValues.Add(value);
    internal void UnregisterPanel(string value) => _panelValues.Remove(value);
    internal bool HasPanel(string value) => _panelValues.Contains(value);
}
