@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge(DefaultClasses, Class)"
     style="@Style"
     data-slot="scroll-area-scrollbar"
     data-orientation="@OrientationString"
     @attributes="AdditionalAttributes">
    <div class="relative flex-1 rounded-full bg-border"></div>
</div>

@code {
    [Parameter] public ScrollOrientation Orientation { get; set; } = ScrollOrientation.Vertical;

    private string OrientationString => Orientation == ScrollOrientation.Horizontal ? "horizontal" : "vertical";

    private string DefaultClasses => Orientation == ScrollOrientation.Horizontal
        ? "flex touch-none select-none transition-colors p-px h-2.5 flex-col border-t border-t-transparent"
        : "flex touch-none select-none transition-colors p-px h-full w-2.5 border-l border-l-transparent";
}
