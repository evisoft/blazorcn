@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge(DefaultClasses, Class)"
     style="@Style"
     data-slot="scroll-area-scrollbar"
     data-orientation="@OrientationString"
     @attributes="AdditionalAttributes">
    <div class="cn-scroll-area-thumb relative flex-1"></div>
</div>

@code {
    [Parameter] public ScrollOrientation Orientation { get; set; } = ScrollOrientation.Vertical;

    private string OrientationString => Orientation == ScrollOrientation.Horizontal ? "horizontal" : "vertical";

    private string DefaultClasses => "cn-scroll-area-scrollbar flex touch-none select-none transition-colors p-px";
}
