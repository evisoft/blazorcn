@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("relative overflow-hidden", Class)"
     style="@Style"
     data-slot="scroll-area"
     @attributes="AdditionalAttributes">
    <div class="@ViewportClasses">
        @ChildContent
    </div>
    @if (Orientation is ScrollOrientation.Vertical or ScrollOrientation.Both)
    {
        <ScrollBarCn Orientation="ScrollOrientation.Vertical" />
    }
    @if (Orientation is ScrollOrientation.Horizontal or ScrollOrientation.Both)
    {
        <ScrollBarCn Orientation="ScrollOrientation.Horizontal" />
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public ScrollOrientation Orientation { get; set; } = ScrollOrientation.Vertical;

    private const string ViewportFocusClasses = "transition-[color,box-shadow] outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-1";

    private string ViewportClasses => Orientation switch
    {
        ScrollOrientation.Vertical => $"h-full w-full rounded-[inherit] overflow-y-auto overflow-x-hidden {ViewportFocusClasses}",
        ScrollOrientation.Horizontal => $"h-full w-full rounded-[inherit] overflow-x-auto overflow-y-hidden {ViewportFocusClasses}",
        ScrollOrientation.Both => $"h-full w-full rounded-[inherit] overflow-auto {ViewportFocusClasses}",
        _ => $"h-full w-full rounded-[inherit] overflow-y-auto overflow-x-hidden {ViewportFocusClasses}"
    };
}
