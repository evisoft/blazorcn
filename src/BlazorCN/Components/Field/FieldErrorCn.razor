@namespace BlazorCN
@inherits ComponentBaseCn

@if (_hasContent)
{
    <div role="alert"
         class="@CssClass"
         style="@Style"
         data-slot="field-error"
         @attributes="AdditionalAttributes">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else if (Errors is not null && Errors.Count > 0)
        {
            var unique = Errors.Where(e => !string.IsNullOrEmpty(e)).Distinct().ToList();
            if (unique.Count == 1)
            {
                @unique[0]
            }
            else
            {
                <ul class="ml-4 flex list-disc flex-col gap-1">
                    @foreach (var error in unique)
                    {
                        <li>@error</li>
                    }
                </ul>
            }
        }
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public IReadOnlyList<string>? Errors { get; set; }

    private static readonly string BaseClasses =
        "cn-field-error font-normal";

    private string CssClass => Cn.Merge(BaseClasses, Class);

    private bool _hasContent => ChildContent is not null || (Errors is not null && Errors.Any(e => !string.IsNullOrEmpty(e)));
}
