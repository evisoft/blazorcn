@namespace BlazorCN
@inherits ComponentBaseCn

<LabelCn Class="@CssClass"
         Style="@Style"
         For="@For"
         data-slot="field-label"
         @attributes="AdditionalAttributes">
    @ChildContent
</LabelCn>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? For { get; set; }

    private static readonly string BaseClasses =
        "cn-field-label group/field-label peer/field-label flex w-fit leading-snug has-[>[data-slot=field]]:w-full has-[>[data-slot=field]]:flex-col";

    private string CssClass => Cn.Merge(BaseClasses, Class);
}
