@namespace BlazorCN
@inherits ComponentBaseCn

<p class="@CssClass"
   style="@Style"
   data-slot="field-description"
   @attributes="AdditionalAttributes">
    @ChildContent
</p>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static readonly string BaseClasses =
        "cn-field-description leading-normal font-normal group-has-data-horizontal/field:text-balance last:mt-0 nth-last-2:-mt-1 [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary";

    private string CssClass => Cn.Merge(BaseClasses, Class);
}
