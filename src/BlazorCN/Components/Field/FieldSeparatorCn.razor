@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@CssClass"
     style="@Style"
     data-slot="field-separator"
     data-content="@(ChildContent is not null ? "true" : "false")"
     @attributes="AdditionalAttributes">
    <SeparatorCn Class="absolute inset-0 top-1/2" />
    @if (ChildContent is not null)
    {
        <span class="cn-field-separator-content relative mx-auto block w-fit bg-background"
              data-slot="field-separator-content">
            @ChildContent
        </span>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static readonly string BaseClasses =
        "cn-field-separator relative";

    private string CssClass => Cn.Merge(BaseClasses, Class);
}
