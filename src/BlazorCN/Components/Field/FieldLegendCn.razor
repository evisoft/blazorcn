@namespace BlazorCN
@inherits ComponentBaseCn

<legend class="@CssClass"
        style="@Style"
        data-slot="field-legend"
        data-variant="@Variant.ToString().ToLowerInvariant()"
        @attributes="AdditionalAttributes">
    @ChildContent
</legend>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public FieldLegendVariant Variant { get; set; } = FieldLegendVariant.Legend;

    private static readonly string BaseClasses =
        "cn-field-legend";

    private string CssClass => Cn.Merge(BaseClasses, Class);
}
