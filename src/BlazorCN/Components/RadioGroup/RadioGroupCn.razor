@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

<div @ref="_groupRef"
     class="@Cn.Merge("cn-radio-group grid", Class)"
     style="@Style"
     role="radiogroup"
     data-slot="radio-group"
     @onkeydown="HandleKeyDown"
     @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Inject] private JsInteropCn JsInterop { get; set; } = default!;

    private ElementReference _groupRef;
    private readonly string _preventKeysId = $"radio-nav-{Guid.NewGuid():N}";
    private bool _jsInitialized;

    // Items register in render order for the APG roving-tabindex model: one tab
    // stop for the whole group, arrows move focus AND select (wrapping), Home/End
    // jump to the first/last enabled radio.
    private readonly List<RadioGroupItemCn> _items = new();

    internal bool IsSelected(string value) => Value == value;

    internal async Task SelectValue(string value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
        StateHasChanged();
    }

    internal void RegisterItem(RadioGroupItemCn item)
    {
        if (!_items.Contains(item))
            _items.Add(item);
    }

    internal void UnregisterItem(RadioGroupItemCn item) => _items.Remove(item);

    internal bool IsTabStop(RadioGroupItemCn item)
    {
        // The checked radio is the single tab stop; with none checked (or the
        // checked one disabled) the first enabled radio takes it.
        var selected = _items.FirstOrDefault(i => !i.Disabled && IsSelected(i.Value));
        var stop = selected ?? _items.FirstOrDefault(i => !i.Disabled);
        return ReferenceEquals(stop, item);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        var enabled = _items.Where(i => !i.Disabled).ToList();
        if (enabled.Count == 0) return;

        var currentIndex = enabled.FindIndex(i => IsSelected(i.Value));
        if (currentIndex < 0) currentIndex = 0;

        var targetIndex = e.Key switch
        {
            "ArrowDown" or "ArrowRight" => (currentIndex + 1) % enabled.Count,
            "ArrowUp" or "ArrowLeft" => (currentIndex - 1 + enabled.Count) % enabled.Count,
            "Home" => 0,
            "End" => enabled.Count - 1,
            _ => -1
        };
        if (targetIndex < 0) return;

        await enabled[targetIndex].SelectAndFocusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Items register while the first render is in flight, so an item rendered
            // before the checked one may have claimed the tab stop; re-render once with
            // the full registry so exactly one radio has tabindex="0".
            if (_items.Count > 0)
                StateHasChanged();
            try
            {
                // Blazor's @onkeydown cannot conditionally preventDefault, so the keys
                // handled above would also scroll the page; swallow just their browser
                // default, only when a radio itself is the event target.
                await JsInterop.PreventKeyDefaultsAsync(_groupRef, _preventKeysId,
                    new[] { "ArrowDown", "ArrowUp", "ArrowLeft", "ArrowRight", "Home", "End" },
                    "[role=\"radio\"]");
                _jsInitialized = true;
            }
            catch { /* Prerendering without JS — scroll suppression is progressive enhancement */ }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsInitialized)
        {
            try { await JsInterop.CleanupAsync(_preventKeysId); }
            catch { /* Circuit may already be gone */ }
        }
    }
}
