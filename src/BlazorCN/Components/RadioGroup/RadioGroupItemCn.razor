@namespace BlazorCN
@inherits ComponentBaseCn

<button type="button"
        role="radio"
        aria-checked="@IsSelected.ToString().ToLowerInvariant()"
        data-slot="radio-group-item"
        data-state="@(IsSelected ? "checked" : "unchecked")"
        class="@CssClass"
        style="@Style"
        disabled="@Disabled"
        @onclick="HandleClick"
        @attributes="AdditionalAttributes">
    @if (IsSelected)
    {
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="size-2 fill-primary"><circle cx="12" cy="12" r="6"/></svg>
    }
</button>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [CascadingParameter] private RadioGroupCn? Group { get; set; }

    private bool IsSelected => Group?.IsSelected(Value) ?? false;

    private string CssClass => Cn.Merge(
        "cn-radio-group-item aspect-square shrink-0 border transition-[color,box-shadow] outline-none disabled:cursor-not-allowed disabled:opacity-50",
        Class);

    private async Task HandleClick()
    {
        if (Disabled || Group is null) return;
        await Group.SelectValue(Value);
    }
}
