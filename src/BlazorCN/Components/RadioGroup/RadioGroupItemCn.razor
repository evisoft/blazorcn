@namespace BlazorCN
@inherits ComponentBaseCn
@implements IDisposable

<button type="button"
        role="radio"
        aria-checked="@IsSelected.ToString().ToLowerInvariant()"
        data-slot="radio-group-item"
        data-state="@(IsSelected ? "checked" : "unchecked")"
        class="@CssClass"
        style="@Style"
        disabled="@Disabled"
        tabindex="@(Group is null || Group.IsTabStop(this) ? 0 : -1)"
        @ref="_buttonRef"
        @onclick="HandleClick"
        @attributes="AdditionalAttributes">
    @if (IsSelected)
    {
        <span class="cn-radio-group-indicator-icon absolute top-1/2 left-1/2 size-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary-foreground"></span>
    }
</button>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [CascadingParameter] private RadioGroupCn? Group { get; set; }

    private ElementReference _buttonRef;

    private bool IsSelected => Group?.IsSelected(Value) ?? false;

    private string CssClass => Cn.Merge(
        "cn-radio-group-item peer group/radio-group-item shrink-0 outline-none disabled:cursor-not-allowed disabled:opacity-50",
        Class);

    protected override void OnInitialized()
    {
        Group?.RegisterItem(this);
    }

    public void Dispose()
    {
        Group?.UnregisterItem(this);
    }

    private async Task HandleClick()
    {
        if (Disabled || Group is null) return;
        await Group.SelectValue(Value);
    }

    internal async Task SelectAndFocusAsync()
    {
        if (Disabled || Group is null) return;
        if (!IsSelected)
            await Group.SelectValue(Value);
        await _buttonRef.FocusAsync();
    }
}
