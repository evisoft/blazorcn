@namespace BlazorCN
@inherits ComponentBaseCn

<span class="@Cn.Merge("cn-avatar group/avatar relative flex shrink-0 select-none after:absolute after:inset-0 after:border after:border-border after:mix-blend-darken dark:after:mix-blend-lighten", Class)"
      style="@Style"
      data-slot="avatar"
      data-size="@Size.ToString().ToLowerInvariant()"
      @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Size variant — emitted as data-size, which the avatar CSS keys off
    /// (sm = size-6, default = size-8, lg = size-10, plus badge/group-count icon sizing).</summary>
    [Parameter] public AvatarSize Size { get; set; } = AvatarSize.Default;
}
