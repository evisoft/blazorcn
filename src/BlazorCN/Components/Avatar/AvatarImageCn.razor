@namespace BlazorCN
@inherits ComponentBaseCn

@* No Src means no image to load, so don't emit one: `<img src="">` resolves to the
   page URL, making the browser re-download the document before firing onerror.
   Radix's Avatar.Image behaves the same way — the fallback simply stays. *@
@if (State?.ImageFailed != true && !string.IsNullOrWhiteSpace(Src))
{
    <img class="@Cn.Merge("cn-avatar-image aspect-square size-full", Class)"
         style="@Style"
         src="@Src"
         alt="@Alt"
         data-slot="avatar-image"
         @onload="() => State?.SetLoaded()"
         @onerror="() => State?.SetFailed()"
         @attributes="AdditionalAttributes" />
}

@code {
    [Parameter] public string? Src { get; set; }
    [Parameter] public string? Alt { get; set; }
    [CascadingParameter] private AvatarLoadState? State { get; set; }
}
