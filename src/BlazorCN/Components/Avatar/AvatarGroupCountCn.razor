@namespace BlazorCN
@inherits ComponentBaseCn

<span class="@Cn.Merge("cn-avatar-group-count relative flex shrink-0 items-center justify-center ring-2 ring-background", Class)"
      style="@Style"
      data-slot="avatar-group-count"
      @attributes="AdditionalAttributes">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <text>+@Count</text>
    }
</span>

@code {
    /// <summary>Custom content for the count cell (e.g. an icon or localized text).
    /// When null, falls back to rendering +<see cref="Count"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public int Count { get; set; }
}
