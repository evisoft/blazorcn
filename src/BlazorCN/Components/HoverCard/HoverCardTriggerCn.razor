@namespace BlazorCN
@inherits ComponentBaseCn

<span @ref="_triggerRef"
      class="@Class"
      style="@Style"
      data-slot="hover-card-trigger"
      @onmouseenter="HandleMouseEnter"
      @onmouseleave="HandleMouseLeave"
      @onfocus="HandleFocus"
      @onblur="HandleBlur"
      @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public HoverCardCn? HoverCard { get; set; }

    private ElementReference _triggerRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (HoverCard is not null) HoverCard.TriggerElement = _triggerRef;
    }

    private async Task HandleMouseEnter()
    {
        if (HoverCard is not null) await HoverCard.RequestOpen();
    }

    private async Task HandleMouseLeave()
    {
        if (HoverCard is not null) await HoverCard.RequestClose();
    }

    private async Task HandleFocus()
    {
        if (HoverCard is not null) await HoverCard.RequestOpen();
    }

    private async Task HandleBlur()
    {
        if (HoverCard is not null) await HoverCard.RequestClose();
    }
}
