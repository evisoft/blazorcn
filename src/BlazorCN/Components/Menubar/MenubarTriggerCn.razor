@namespace BlazorCN
@inherits ComponentBaseCn

<button @ref="_triggerRef"
        type="button"
        class="@Cn.Merge("cn-menubar-trigger flex items-center outline-hidden select-none", Class)"
        style="@Style"
        data-slot="menubar-trigger"
        data-state="@(Menu?.IsOpen == true ? "open" : "closed")"
        role="menuitem"
        aria-haspopup="menu"
        aria-expanded="@(Menu?.IsOpen == true ? "true" : "false")"
        aria-controls="@(Menu?.IsOpen == true ? Menu.ContentId : null)"
        @onclick="Toggle"
        @onkeydown="HandleKeyDown"
        @onmouseenter="HandleMouseEnter"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public MenubarMenuCn? Menu { get; set; }
    [CascadingParameter] public MenubarCn? Menubar { get; set; }

    private ElementReference _triggerRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (Menu is not null) Menu.TriggerElement = _triggerRef;
    }

    private void Toggle()
    {
        Menu?.ToggleOpen();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        // APG menubar: ArrowDown/ArrowUp on a closed trigger opens its menu
        // (focus lands on the first item via keyboard-nav autofocus).
        if (Menu is not null && !Menu.IsOpen && e.Key is "ArrowDown" or "ArrowUp")
            Menu.SetOpen(true);
    }

    private void HandleMouseEnter()
    {
        // Radix menubar: while any menu is open, hovering a sibling trigger
        // switches the open menu to this one.
        if (Menu is not null && !Menu.IsOpen && Menubar?.AnyOpen == true)
            Menu.SetOpen(true);
    }
}
