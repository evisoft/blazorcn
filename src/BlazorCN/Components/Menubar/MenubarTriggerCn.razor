@namespace BlazorCN
@inherits ComponentBaseCn

<button @ref="_triggerRef"
        type="button"
        class="@Cn.Merge("flex items-center rounded-sm px-3 py-1 text-sm font-medium outline-none select-none focus:bg-accent focus:text-accent-foreground data-[state=open]:bg-accent data-[state=open]:text-accent-foreground", Class)"
        style="@Style"
        data-slot="menubar-trigger"
        data-state="@(Menu?.IsOpen == true ? "open" : "closed")"
        @onclick="Toggle"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public MenubarMenuCn? Menu { get; set; }

    private ElementReference _triggerRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (Menu is not null) Menu.TriggerElement = _triggerRef;
    }

    private void Toggle()
    {
        Menu?.ToggleOpen();
    }
}
