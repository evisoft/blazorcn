@namespace BlazorCN
@inherits ComponentBaseCn

<button @ref="_triggerRef"
        type="button"
        class="@Cn.Merge("cn-menubar-trigger flex items-center outline-hidden select-none", Class)"
        style="@Style"
        data-slot="menubar-trigger"
        data-state="@(Menu?.IsOpen == true ? "open" : "closed")"
        aria-haspopup="menu"
        aria-expanded="@(Menu?.IsOpen == true ? "true" : "false")"
        @onclick="Toggle"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public MenubarMenuCn? Menu { get; set; }

    private ElementReference _triggerRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (Menu is not null) Menu.TriggerElement = _triggerRef;
    }

    private void Toggle()
    {
        Menu?.ToggleOpen();
    }
}
