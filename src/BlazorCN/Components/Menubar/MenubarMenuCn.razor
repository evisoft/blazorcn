@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("relative", Class)" style="@Style" data-slot="menubar-menu" data-state="@(IsOpen ? "open" : "closed")" role="none" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private MenubarCn? Menubar { get; set; }

    internal bool IsOpen { get; private set; }
    internal ElementReference TriggerElement { get; set; }
    internal string ContentId { get; } = $"menubar-content-{Guid.NewGuid():N}";

    internal void SetOpen(bool open)
    {
        IsOpen = open;
        Menubar?.NotifyMenuOpenChanged(this, open);
        StateHasChanged();
    }

    internal void ToggleOpen()
    {
        SetOpen(!IsOpen);
    }
}
