@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

@if (Menu?.IsOpen == true)
{
    <div @ref="_contentRef"
         class="@Cn.Merge("cn-menubar-content z-50 max-h-(--available-height) origin-(--transform-origin) overflow-x-hidden overflow-y-auto", Class)"
         style="@Style"
         id="@(Menu?.ContentId)"
         role="menu"
         aria-orientation="vertical"
         data-slot="menubar-content"
         data-state="open"
         data-side="@Side.ToString().ToLowerInvariant()"
         data-align="@Align.ToString().ToLowerInvariant()"
         @onkeydown="HandleContentKeyDown"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}
