@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("flex h-9 items-center gap-1 rounded-lg border bg-background p-1 shadow-sm", Class)" style="@Style" data-slot="menubar" role="menubar" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
