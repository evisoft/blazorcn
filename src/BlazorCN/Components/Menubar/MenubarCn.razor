@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("cn-menubar flex items-center bg-background", Class)" style="@Style" data-slot="menubar" role="menubar" aria-label="Menu" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
