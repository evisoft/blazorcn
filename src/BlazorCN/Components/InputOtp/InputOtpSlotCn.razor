@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge(DefaultClasses, ActiveClasses, Class)"
     style="@Style"
     data-slot="input-otp-slot"
     data-active="@(IsActive ? "true" : "false")"
     @attributes="AdditionalAttributes">
    @if (Character.HasValue)
    {
        @Character.Value
    }
    else if (IsActive)
    {
        <div class="cn-input-otp-caret pointer-events-none absolute inset-0 flex items-center justify-center">
            <div class="cn-input-otp-caret-line"></div>
        </div>
    }
</div>

@code {
    [CascadingParameter] public InputOtpCn? InputOtp { get; set; }
    [Parameter] public int Index { get; set; }

    private char? Character => InputOtp?.GetCharAt(Index);
    private bool IsActive => InputOtp?.IsActiveSlot(Index) ?? false;

    private const string DefaultClasses =
        "cn-input-otp-slot relative flex items-center justify-center";

    private string ActiveClasses => IsActive
        ? "z-10"
        : string.Empty;
}
