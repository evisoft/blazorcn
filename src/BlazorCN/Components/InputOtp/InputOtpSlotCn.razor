@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge(DefaultClasses, ActiveClasses, Class)"
     style="@Style"
     data-slot="input-otp-slot"
     data-active="@(IsActive ? "true" : "false")"
     @attributes="AdditionalAttributes">
    @if (Character.HasValue)
    {
        @Character.Value
    }
    else if (IsActive)
    {
        <span class="pointer-events-none absolute inset-0 flex items-center justify-center animate-pulse">|</span>
    }
</div>

@code {
    [CascadingParameter] public InputOtpCn? InputOtp { get; set; }
    [Parameter] public int Index { get; set; }

    private char? Character => InputOtp?.GetCharAt(Index);
    private bool IsActive => InputOtp?.IsActiveSlot(Index) ?? false;

    private const string DefaultClasses =
        "relative flex h-9 w-9 items-center justify-center border-y border-r text-sm shadow-sm transition-all first:rounded-l-md first:border-l last:rounded-r-md";

    private string ActiveClasses => IsActive
        ? "z-10 ring-1 ring-ring"
        : string.Empty;
}
