@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("flex items-center gap-2", Class)"
     style="@Style"
     data-slot="input-otp"
     @attributes="AdditionalAttributes">
    <input type="text"
           class="sr-only"
           maxlength="@MaxLength"
           value="@Value"
           disabled="@Disabled"
           @oninput="HandleInput"
           @onfocus="HandleFocus"
           @onblur="HandleBlur"
           @ref="_inputRef"
           autocomplete="one-time-code"
           inputmode="numeric" />
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int MaxLength { get; set; } = 6;
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private ElementReference _inputRef;
    internal bool IsFocused { get; private set; }
    internal int ActiveIndex { get; private set; }

    internal char? GetCharAt(int index)
    {
        if (Value is null || index < 0 || index >= Value.Length)
            return null;
        return Value[index];
    }

    internal bool IsActiveSlot(int index) => IsFocused && index == ActiveIndex;

    private async Task HandleInput(ChangeEventArgs e)
    {
        var newValue = e.Value?.ToString() ?? string.Empty;
        // Only allow digits, limit to MaxLength
        var filtered = new string(newValue.Where(char.IsDigit).Take(MaxLength).ToArray());
        Value = filtered;
        ActiveIndex = Math.Min(filtered.Length, MaxLength - 1);
        await ValueChanged.InvokeAsync(Value);
    }

    private void HandleFocus()
    {
        IsFocused = true;
        ActiveIndex = Math.Min(Value?.Length ?? 0, MaxLength - 1);
    }

    private void HandleBlur()
    {
        IsFocused = false;
    }
}
