@namespace BlazorCN
@inherits ComponentBaseCn
@using System.Text.RegularExpressions

@* The real input is sr-only; clicking/tapping the visible slots must focus it,
   and consumer attributes (id, name, aria-*) must land on the input — not the
   container — so labels and accessible names reach the actual control. *@
<div class="@Cn.Merge("cn-input-otp flex items-center", Class)"
     style="@Style"
     data-slot="input-otp"
     @onclick="FocusInputAsync">
    <input type="text"
           class="sr-only"
           aria-label="@AriaLabelDefault"
           maxlength="@MaxLength"
           value="@Value"
           disabled="@Disabled"
           @oninput="HandleInput"
           @onkeydown="HandleKeyDown"
           @onfocus="HandleFocus"
           @onblur="HandleBlur"
           @ref="_inputRef"
           autocomplete="one-time-code"
           inputmode="@ResolvedInputMode"
           @attributes="AdditionalAttributes" />
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    /// <summary>Well-known pattern constant: digits only (0-9).</summary>
    public const string RegexpOnlyDigits = "[0-9]";

    /// <summary>Well-known pattern constant: digits and letters (alphanumeric).</summary>
    public const string RegexpOnlyDigitsAndChars = "[0-9a-zA-Z]";

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int MaxLength { get; set; } = 6;

    // Default accessible name for the sr-only input when the consumer wired none.
    // Suppressed if they passed aria-label/aria-labelledby, or an id (aria-label
    // would override an associated <label for> otherwise).
    private string? AriaLabelDefault =>
        HasAttribute("aria-label") || HasAttribute("aria-labelledby") || HasAttribute("id")
            ? null : "One-time code";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Regex pattern that each character must match. Defaults to <c>[0-9]</c> (digits only).
    /// Use <see cref="RegexpOnlyDigitsAndChars"/> for alphanumeric input.
    /// </summary>
    [Parameter] public string Pattern { get; set; } = RegexpOnlyDigits;

    /// <summary>
    /// Override the HTML inputmode attribute. When null, it is inferred from the <see cref="Pattern"/>:
    /// <c>numeric</c> for digit-only patterns, <c>text</c> otherwise.
    /// </summary>
    [Parameter] public string? InputMode { get; set; }

    [Inject] private JsInteropCn JsInterop { get; set; } = default!;

    private ElementReference _inputRef;
    internal bool IsFocused { get; private set; }
    internal int ActiveIndex { get; private set; }

    private Regex? _patternRegex;

    private Regex PatternRegex => _patternRegex ??= new Regex("^" + Pattern + "$", RegexOptions.Compiled);

    private string ResolvedInputMode =>
        InputMode ?? (Pattern == RegexpOnlyDigits ? "numeric" : "text");

    internal char? GetCharAt(int index)
    {
        if (Value is null || index < 0 || index >= Value.Length)
            return null;
        return Value[index];
    }

    internal bool IsActiveSlot(int index) => IsFocused && index == ActiveIndex;

    private bool MatchesPattern(char c) => PatternRegex.IsMatch(c.ToString());

    private async Task HandleInput(ChangeEventArgs e)
    {
        var oldLength = Value?.Length ?? 0;
        var newValue = e.Value?.ToString() ?? string.Empty;
        var filtered = new string(newValue.Where(MatchesPattern).Take(MaxLength).ToArray());
        Value = filtered;
        // Approximate the DOM caret: characters are inserted/removed at the tracked
        // position, so shift the highlight by the length delta instead of snapping it
        // to the end (which lies after Backspace/typing mid-string). Delete removes
        // AFTER the caret, so the caret — and the highlight — stay put.
        var delta = filtered.Length - oldLength;
        if (delta < 0 && _lastKey == "Delete")
            delta = 0;
        ActiveIndex = Math.Clamp(ActiveIndex + delta, 0, Math.Min(filtered.Length, MaxLength - 1));
        await ValueChanged.InvokeAsync(Value);

        if (filtered != newValue)
        {
            // Rejected characters stay in the DOM: Blazor only patches `value` when the
            // rendered attribute changes, and rejection leaves Value as-is (no diff).
            // Left alone, junk accumulates until maxlength and the input goes dead —
            // force-sync the DOM back to the filtered value. Safe here: HandleInput
            // only fires from a real DOM event, never during prerender.
            try { await JsInterop.SetInputValueAsync(_inputRef, Value ?? ""); }
            catch { /* Circuit may already be gone — DOM sync is best-effort */ }
        }
    }

    private string? _lastKey;

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        _lastKey = e.Key;
        // Selection (Shift/Ctrl) desyncs a keydown-based caret model; leave the
        // highlight alone rather than guess wrong.
        if (e.ShiftKey || e.CtrlKey || e.MetaKey || e.AltKey)
            return;

        var caretMax = Math.Min(Value?.Length ?? 0, MaxLength - 1);
        ActiveIndex = e.Key switch
        {
            "ArrowLeft" => Math.Max(0, ActiveIndex - 1),
            "ArrowRight" => Math.Min(caretMax, ActiveIndex + 1),
            "Home" => 0,
            "End" => caretMax,
            _ => ActiveIndex
        };
    }

    private void HandleFocus()
    {
        IsFocused = true;
        ActiveIndex = Math.Min(Value?.Length ?? 0, MaxLength - 1);
    }

    private void HandleBlur()
    {
        IsFocused = false;
    }

    private async Task FocusInputAsync()
    {
        if (!Disabled)
            await _inputRef.FocusAsync();
    }

    protected override void OnParametersSet()
    {
        // Reset compiled regex when Pattern changes
        _patternRegex = null;
    }
}
