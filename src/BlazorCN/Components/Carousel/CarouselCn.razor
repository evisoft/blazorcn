@namespace BlazorCN
@inherits ComponentBaseCn

@* No default aria-label: aria-roledescription already announces "carousel", so a
   hardcoded label would double up ("Carousel, carousel"). Consumers should pass a
   content-describing aria-label via the attribute splat. *@
<div class="@Cn.Merge("relative", Class)"
     style="@Style"
     role="region"
     aria-roledescription="carousel"
     data-slot="carousel"
     @onkeydown="HandleKeyDown"
     tabindex="0"
     @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public CarouselOrientation Orientation { get; set; } = CarouselOrientation.Horizontal;
    [Parameter] public int CurrentIndex { get; set; }
    [Parameter] public EventCallback<int> CurrentIndexChanged { get; set; }

    /// <summary>Set to true when the carousel is rendered inside a dir="rtl" context.
    /// In RTL flex rows later slides sit to the LEFT of the first one, so the track
    /// translation and swipe direction flip for horizontal carousels.</summary>
    [Parameter] public bool Rtl { get; set; }

    internal int Index { get; private set; }
    internal int ItemCount { get; private set; }

    internal bool CanScrollPrev => Index > 0;
    internal bool CanScrollNext => Index < ItemCount - 1;

    protected override void OnInitialized()
    {
        Index = CurrentIndex;
    }

    protected override void OnParametersSet()
    {
        if (CurrentIndex != Index)
            Index = CurrentIndex;
    }

    /// <summary>Registers an item and returns its zero-based slide index. The
    /// StateHasChanged re-render lets earlier items refresh their "Slide N of M"
    /// labels once the final count is known.</summary>
    internal int RegisterItem()
    {
        var index = ItemCount;
        ItemCount++;
        StateHasChanged();
        return index;
    }

    internal void UnregisterItem()
    {
        ItemCount = Math.Max(0, ItemCount - 1);
    }

    internal void RegisterItemCount(int count)
    {
        ItemCount = count;
        StateHasChanged();
    }

    internal async Task ScrollPrev()
    {
        if (CanScrollPrev)
        {
            Index--;
            await CurrentIndexChanged.InvokeAsync(Index);
            StateHasChanged();
        }
    }

    internal async Task ScrollNext()
    {
        if (CanScrollNext)
        {
            Index++;
            await CurrentIndexChanged.InvokeAsync(Index);
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (Orientation == CarouselOrientation.Horizontal)
        {
            if (e.Key == "ArrowLeft") await ScrollPrev();
            else if (e.Key == "ArrowRight") await ScrollNext();
        }
        else
        {
            if (e.Key == "ArrowUp") await ScrollPrev();
            else if (e.Key == "ArrowDown") await ScrollNext();
        }
    }
}
