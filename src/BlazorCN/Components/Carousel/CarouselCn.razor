@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("relative", Class)"
     style="@Style"
     role="region"
     aria-roledescription="carousel"
     data-slot="carousel"
     @onkeydown="HandleKeyDown"
     tabindex="0"
     @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public CarouselOrientation Orientation { get; set; } = CarouselOrientation.Horizontal;

    internal int CurrentIndex { get; private set; }
    internal int ItemCount { get; private set; }

    internal bool CanScrollPrev => CurrentIndex > 0;
    internal bool CanScrollNext => CurrentIndex < ItemCount - 1;

    internal void RegisterItemCount(int count)
    {
        ItemCount = count;
        StateHasChanged();
    }

    internal void ScrollPrev()
    {
        if (CanScrollPrev)
        {
            CurrentIndex--;
            StateHasChanged();
        }
    }

    internal void ScrollNext()
    {
        if (CanScrollNext)
        {
            CurrentIndex++;
            StateHasChanged();
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (Orientation == CarouselOrientation.Horizontal)
        {
            if (e.Key == "ArrowLeft") ScrollPrev();
            else if (e.Key == "ArrowRight") ScrollNext();
        }
        else
        {
            if (e.Key == "ArrowUp") ScrollPrev();
            else if (e.Key == "ArrowDown") ScrollNext();
        }
    }
}
