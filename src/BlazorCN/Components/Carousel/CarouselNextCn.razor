@namespace BlazorCN
@inherits ComponentBaseCn

<button class="@Cn.Merge(DefaultClasses, Class)"
        style="@Style"
        type="button"
        disabled="@(!CanScroll)"
        data-slot="carousel-next"
        @onclick="HandleClick"
        @attributes="AdditionalAttributes">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 18 6-6-6-6"/>
    </svg>
    <span class="sr-only">Next slide</span>
</button>

@code {
    [CascadingParameter] public CarouselCn? Carousel { get; set; }

    private bool CanScroll => Carousel?.CanScrollNext ?? false;

    private string DefaultClasses => Carousel?.Orientation == CarouselOrientation.Vertical
        ? "absolute touch-manipulation -top-12 left-1/2 -translate-x-1/2 rotate-90"
        : "absolute touch-manipulation top-1/2 -right-12 translate-y-1/2";

    private void HandleClick()
    {
        Carousel?.ScrollNext();
    }
}
