@namespace BlazorCN
@inherits ComponentBaseCn
@implements IDisposable

<div class="@Cn.Merge(DefaultClasses, Class)"
     style="@Style"
     role="group"
     aria-roledescription="slide"
     aria-label="@SlideLabel"
     aria-hidden="@(IsHiddenSlide ? "true" : null)"
     inert="@IsHiddenSlide"
     data-slot="carousel-item"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [CascadingParameter] public CarouselCn? Carousel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private int _index;

    private string DefaultClasses => Carousel?.Orientation == CarouselOrientation.Vertical
        ? "min-w-0 shrink-0 grow-0 basis-full pt-4"
        : "min-w-0 shrink-0 grow-0 basis-full pl-4";

    private string? SlideLabel => Carousel is null ? null : $"Slide {_index + 1} of {Carousel.ItemCount}";

    // Off-screen slides are fully occluded (overflow-hidden + translate), so hide
    // them from AT and the Tab order (WCAG 2.4.3). Only safe with the default
    // basis-full single-slide layout — custom basis-* classes keep several slides
    // visible at once, so skip hiding there.
    private bool IsHiddenSlide =>
        Carousel is not null
        && _index != Carousel.Index
        && (Class is null || !Class.Contains("basis-"));

    protected override void OnInitialized()
    {
        _index = Carousel?.RegisterItem() ?? 0;
    }

    public void Dispose()
    {
        Carousel?.UnregisterItem();
    }
}
