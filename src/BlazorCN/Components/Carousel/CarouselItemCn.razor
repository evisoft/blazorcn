@namespace BlazorCN
@inherits ComponentBaseCn
@implements IDisposable

<div class="@Cn.Merge(DefaultClasses, Class)"
     style="@Style"
     role="group"
     aria-roledescription="slide"
     data-slot="carousel-item"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [CascadingParameter] public CarouselCn? Carousel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string DefaultClasses => Carousel?.Orientation == CarouselOrientation.Vertical
        ? "min-w-0 shrink-0 grow-0 basis-full pt-4"
        : "min-w-0 shrink-0 grow-0 basis-full pl-4";

    protected override void OnInitialized()
    {
        Carousel?.RegisterItem();
    }

    public void Dispose()
    {
        Carousel?.UnregisterItem();
    }
}
