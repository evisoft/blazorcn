@namespace BlazorCN
@inherits ComponentBaseCn

<button class="@Cn.Merge(DefaultClasses, Class)"
        style="@Style"
        type="button"
        disabled="@(!CanScroll)"
        data-slot="carousel-previous"
        @onclick="HandleClick"
        @attributes="AdditionalAttributes">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-rtl-flip">
        <path d="m15 18-6-6 6-6"/>
    </svg>
    <span class="sr-only">Previous slide</span>
</button>

@code {
    [CascadingParameter] public CarouselCn? Carousel { get; set; }

    private bool CanScroll => Carousel?.CanScrollPrev ?? false;

    private string DefaultClasses => Carousel?.Orientation == CarouselOrientation.Vertical
        ? "cn-carousel-previous absolute -top-12 left-1/2 -translate-x-1/2 rotate-90"
        : "cn-carousel-previous absolute top-1/2 -left-12 -translate-y-1/2";

    private async Task HandleClick()
    {
        if (Carousel is not null) await Carousel.ScrollPrev();
    }
}
