@namespace BlazorCN
@inherits ComponentBaseCn
@implements IAsyncDisposable

<div @ref="_groupRef"
     class="@CssClass"
     style="@($"{SpacingStyle}{Style}")"
     role="group"
     data-slot="toggle-group"
     data-variant="@VariantValue"
     data-size="@SizeValue"
     data-spacing="@Spacing"
     data-orientation="@OrientationValue"
     @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public ToggleVariant Variant { get; set; } = ToggleVariant.Default;
    [Parameter] public ToggleSize Size { get; set; } = ToggleSize.Default;
    [Parameter] public string Orientation { get; set; } = "horizontal";
    [Parameter] public int Spacing { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Inject] private JsInteropCn JsInterop { get; set; } = default!;

    private ElementReference _groupRef;
    private readonly string _keyboardNavId = $"toggle-group-{Guid.NewGuid():N}";
    private bool _jsInitialized;

    // Items register in render order for the roving tabindex (one tab stop for the
    // whole group); arrow-key focus movement is wired via SetupKeyboardNavigationAsync.
    private readonly List<ToggleGroupItemCn> _items = new();

    private string OrientationValue => Orientation == "vertical" ? "vertical" : "horizontal";
    private string VariantValue => Variant == ToggleVariant.Outline ? "outline" : "default";
    private string SizeValue => Size switch
    {
        ToggleSize.Sm => "sm",
        ToggleSize.Lg => "lg",
        _ => "default"
    };

    private string SpacingStyle => $"--gap: {Spacing}; ";

    private string CssClass => Cn.Merge(
        "cn-toggle-group group/toggle-group flex w-fit items-center gap-[--spacing(var(--gap))]",
        Orientation == "vertical" ? "flex-col items-stretch" : "flex-row",
        Class);

    internal async Task SelectItem(string value)
    {
        Value = Value == value ? null : value;
        await ValueChanged.InvokeAsync(Value);
        StateHasChanged();
    }

    internal bool IsSelected(string value) => Value == value;

    internal void RegisterItem(ToggleGroupItemCn item)
    {
        if (!_items.Contains(item))
            _items.Add(item);
    }

    internal void UnregisterItem(ToggleGroupItemCn item) => _items.Remove(item);

    internal bool IsTabStop(ToggleGroupItemCn item)
    {
        // The pressed item is the single tab stop; with none pressed (or the pressed
        // one disabled) the first enabled item takes it.
        var pressed = _items.FirstOrDefault(i => !i.Disabled && IsSelected(i.Value));
        var stop = pressed ?? _items.FirstOrDefault(i => !i.Disabled);
        return ReferenceEquals(stop, item);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Items register while the first render is in flight; re-render once with
            // the full registry so exactly one item has tabindex="0".
            if (_items.Count > 0)
                StateHasChanged();
            try
            {
                // Arrow keys (plus Home/End) move focus between items — unlike tabs,
                // focus does NOT toggle; Space/Enter do, via the native button click.
                await JsInterop.SetupKeyboardNavigationAsync(_groupRef, _keyboardNavId,
                    "[data-slot=toggle-group-item]", OrientationValue);
                _jsInitialized = true;
            }
            catch { /* Prerendering without JS — keyboard nav is progressive enhancement */ }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsInitialized)
        {
            try { await JsInterop.CleanupKeyboardNavigationAsync(_keyboardNavId); }
            catch { /* Circuit may already be gone */ }
        }
    }
}
