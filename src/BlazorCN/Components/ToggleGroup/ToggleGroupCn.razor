@namespace BlazorCN
@inherits ComponentBaseCn

<div class="@Cn.Merge("flex items-center gap-1", Class)"
     style="@Style"
     role="group"
     data-slot="toggle-group"
     @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public ToggleVariant Variant { get; set; } = ToggleVariant.Default;
    [Parameter] public ToggleSize Size { get; set; } = ToggleSize.Default;
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    internal async Task SelectItem(string value)
    {
        Value = Value == value ? null : value;
        await ValueChanged.InvokeAsync(Value);
    }

    internal bool IsSelected(string value) => Value == value;
}
