@namespace BlazorCN
@inherits ComponentBaseCn

<button class="@CssClass"
        style="@Style"
        type="button"
        data-slot="toggle-group-item"
        data-state="@(IsPressed ? "on" : "off")"
        data-variant="@VariantValue"
        data-size="@SizeValue"
        data-spacing="@SpacingValue"
        aria-pressed="@IsPressed.ToString().ToLowerInvariant()"
        disabled="@Disabled"
        @onclick="HandleClick"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [CascadingParameter] private ToggleGroupCn? Group { get; set; }

    private bool IsPressed => Group?.IsSelected(Value) ?? false;

    private string VariantValue => (Group?.Variant ?? ToggleVariant.Default) == ToggleVariant.Outline ? "outline" : "default";
    private string SizeValue => (Group?.Size ?? ToggleSize.Default) switch
    {
        ToggleSize.Sm => "sm",
        ToggleSize.Lg => "lg",
        _ => "default"
    };
    private string SpacingValue => (Group?.Spacing ?? 0).ToString();

    private string CssClass
    {
        get
        {
            var variant = Group?.Variant ?? ToggleVariant.Default;
            var size = Group?.Size ?? ToggleSize.Default;
            var variantClass = variant == ToggleVariant.Outline ? "cn-toggle-variant-outline" : "cn-toggle-variant-default";
            var sizeClass = size switch
            {
                ToggleSize.Sm => "cn-toggle-size-sm",
                ToggleSize.Lg => "cn-toggle-size-lg",
                _ => "cn-toggle-size-default",
            };
            return Cn.Merge(
                "cn-toggle cn-toggle-group-item group/toggle inline-flex shrink-0 items-center justify-center whitespace-nowrap outline-none focus:z-10 focus-visible:z-10 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
                variantClass, sizeClass, Class);
        }
    }

    private async Task HandleClick()
    {
        if (Group is not null)
            await Group.SelectItem(Value);
    }
}
